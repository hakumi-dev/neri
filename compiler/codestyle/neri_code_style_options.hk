use host

class NeriCodeStyleOptions
  public assertionHelpers: StringBuffer = new StringBuffer()
  private firstSetting: NeriCodeStyleSetting?
  private firstSeverity: NeriCodeStyleSeveritySetting?
  private indentWithTabs: Bool?
  private indentation: NeriIndentWidth?
  private tabColumns: Int?

  def init(): Void
    this.assertionHelpers.add("test.assert*")
    this.assertionHelpers.add("assert")
  end

  def setBoolean(key: String, value: Bool?): Void
    var current = this.firstSetting

    while current != null
      if current.key == key
        current.value = value
        return
      end
      current = current.next
    end
    let setting = new NeriCodeStyleSetting(key, value)

    setting.next = this.firstSetting
    this.firstSetting = setting
  end

  def boolean(key: String, fallback: Bool): Bool
    var current = this.firstSetting

    while current != null
      if current.key == key
        let value = current.value

        if value != null
          return value
        end
        return fallback
      end
      current = current.next
    end
    return fallback
  end

  def setSeverity(key: String, value: readonly NeriCodeStyleSeverity?): Void
    var current = this.firstSeverity

    while current != null
      if current.key == key
        current.value = value
        return
      end
      current = current.next
    end
    let setting = new NeriCodeStyleSeveritySetting(key, value)

    setting.next = this.firstSeverity
    this.firstSeverity = setting
  end

  def severity(rule: NeriCodeStyleRule): readonly NeriCodeStyleSeverity
    let key = "neri_diagnostic." + codeStyleLower(rule.ruleId) + ".severity"
    var current = this.firstSeverity

    while current != null
      if current.key == key
        let value = current.value

        if value != null
          return value
        end
        return rule.defaultSeverity
      end
      current = current.next
    end
    return rule.defaultSeverity
  end

  def setIndentWithTabs(value: Bool?): Void
    this.indentWithTabs = value
  end

  def usesTabs(fallback: Bool = false): Bool
    let value = this.indentWithTabs

    if value != null
      return value
    end
    return fallback
  end

  def setIndentWidth(value: NeriIndentWidth?): Bool
    if value != null
      match value
        case NeriIndentWidth.Columns(width)
          if width <= 0
            return false
          end
        case NeriIndentWidth.TabWidth()
          this.indentation = value
          return true
      end
    end
    this.indentation = value
    return true
  end

  def indentWidth(fallback: Int): Int
    let value = this.indentation

    if value == null
      return fallback
    end
    match value
      case NeriIndentWidth.Columns(width)
        return width
      case NeriIndentWidth.TabWidth()
        return this.tabWidth(2)
    end
  end

  def setTabWidth(value: Int?): Bool
    if value != null && value <= 0
      return false
    end
    this.tabColumns = value
    return true
  end

  def tabWidth(fallback: Int): Int
    let value = this.tabColumns

    if value != null
      return value
    end
    return fallback
  end
end
