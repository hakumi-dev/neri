use host

class NeriCodeStyleLineLengthRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE008"
    this.optionKey = "neri_line_length"
    this.category = "style.wrapping"
  end

  def enabled(options: NeriCodeStyleOptions): Bool
    return options.boolean(this.optionKey, true) && options.maxLineLength() > 0
  end

  private def gap(context: NeriCodeStyleContext, start: Int, finish: Int): Bool
    let map = context.sourceMap

    return map != null && neriCodeStyleWhitespace(host::stringSlice(
        context.text,
        map.offsetAt(start),
        map.offsetAt(finish) - map.offsetAt(start)
      ))
  end

  private def breakAt(
    context: NeriCodeStyleContext,
    options: NeriCodeStyleOptions,
    result: NeriCodeStyleResult,
    start: Int,
    length: Int,
    replacement: String
  ): Void
    var edit = result.edits

    while edit != null
      if edit.start == start && edit.length == length
        edit.replacement = replacement
        let finding = new NeriCodeStyleFinding(this, options.severity(this))

        finding.start = start
        finding.length = length
        finding.message = "Place long list entries on separate lines."
        finding.edit = edit
        neriCodeStyleInsertFinding(result, finding)
        return
      end
      edit = edit.next
    end
    neriCodeStyleAddLayoutFinding(
      this,
      context,
      options,
      result,
      start,
      length,
      replacement,
      "Place long list entries on separate lines."
    )
  end

  private def projectedWidth(
    context: NeriCodeStyleContext,
    options: NeriCodeStyleOptions,
    result: NeriCodeStyleResult,
    start: Int,
    finish: Int,
    initial: Int
  ): Int
    let map = context.sourceMap

    if map == null
      return 0
    end
    let first = map.offsetAt(start)
    let last = map.offsetAt(finish)
    var text = host::stringSlice(context.text, first, last - first)
    var edit = result.edits

    while edit != null
      if edit.start >= start && edit.start < finish && edit.start + edit.length <= finish
        let before = map.offsetAt(edit.start) - first
        let after = map.offsetAt(edit.start + edit.length) - first

        text = host::stringSlice(
          text,
          0,
          before
        ) + edit.replacement + host::stringSlice(
          text,
          after,
          host::stringByteLength(text) - after
        )
      end
      edit = edit.next
    end
    var columns = initial
    var byte = 0

    while byte < host::stringByteLength(text)
      let value = host::stringByteAt(text, byte) as Int

      if value == 10 || value == 13
        columns = 0
      else if value == 9
        let width = options.tabWidth(2)

        columns = (columns / width + 1) * width
      else
        columns = columns + 1
      end
      byte = byte + utf8Width(value)
    end
    return columns
  end

  private def wrap(
    context: NeriCodeStyleContext,
    options: NeriCodeStyleOptions,
    result: NeriCodeStyleResult,
    opening: Int,
    lineStart: Int,
    lineEnd: Int
  ): Int
    let tokens = context.tokens

    if tokens == null
      return -1
    end
    var depth = 1
    var angles = 0
    var index = opening + 1
    let commas = new IntBuffer()

    while index < tokens.count() && tokens.startAt(index) < lineEnd
      let kind = tokens.kindAt(index)

      if kind.isLParen() || kind.isLBracket()
        depth = depth + 1
      else if kind.isRParen() || kind.isRBracket()
        depth = depth - 1
        if depth == 0
          break
        end
      else if kind.isLess()
        angles = angles + 1
      else if kind.isGreater() && angles > 0
        angles = angles - 1
      else if kind.isComma() && depth == 1 && angles == 0
        commas.add(index)
      end
      index = index + 1
    end
    if depth != 0 || commas.size == 0
      return -1
    end
    let closing = index
    let start = tokens.startAt(opening) + tokens.lengthAt(opening)
    let finish = tokens.startAt(closing)
    let beforeClose = tokens.startAt(closing - 1) + tokens.lengthAt(closing - 1)

    if !this.gap(context, start, tokens.startAt(opening + 1)) || !this.gap(context, beforeClose, finish)
      return -1
    end
    index = 0
    while index < commas.size
      let comma = commas.get(index)

      if !this.gap(context, tokens.startAt(comma) + tokens.lengthAt(comma), tokens.startAt(comma + 1))
        return -1
      end
      index = index + 1
    end
    var nesting = neriCodeStyleIndentBlockDepth(context.blocks, tokens.startAt(opening), lineEnd)
    var prior = 0

    while prior < opening
      let kind = tokens.kindAt(prior)

      if kind.isLParen() || kind.isLBracket()
        nesting = nesting + 1
      else if kind.isRParen() || kind.isRBracket()
        nesting = nesting - 1
      end
      prior = prior + 1
    end
    let newline = neriCodeStyleNewline(context)
    let indentation = newline + neriCodeStyleIndentText(options, nesting + 1)

    this.breakAt(context, options, result, start, tokens.startAt(opening + 1) - start, indentation)
    index = 0
    while index < commas.size
      let comma = commas.get(index)
      let after = tokens.startAt(comma) + tokens.lengthAt(comma)

      this.breakAt(context, options, result, after, tokens.startAt(comma + 1) - after, indentation)
      index = index + 1
    end
    this.breakAt(
      context,
      options,
      result,
      beforeClose,
      finish - beforeClose,
      newline + neriCodeStyleIndentText(options, nesting)
    )
    var segment = opening + 1

    index = 0
    while index <= commas.size
      let endToken = index < commas.size ? commas.get(index) : closing
      let endPosition = tokens.startAt(endToken)
      let contentEnd = tokens.startAt(endToken - 1) + tokens.lengthAt(endToken - 1)

      let separatorWidth = index < commas.size ? tokens.lengthAt(endToken) : 0
      let indentationWidth = (nesting + 1) * neriCodeStyleIndentSize(options)
      let segmentWidth = this.projectedWidth(
        context,
        options,
        result,
        tokens.startAt(segment),
        contentEnd,
        indentationWidth
      ) + separatorWidth

      if segmentWidth > options.maxLineLength()
        var nested = segment

        while nested < endToken
          let kind = tokens.kindAt(nested)

          if kind.isLParen() || kind.isLBracket()
            let wrapped = this.wrap(context, options, result, nested, lineStart, endPosition)

            nested = wrapped if wrapped >= 0
          end
          nested = nested + 1
        end
      end
      segment = endToken + 1
      index = index + 1
    end
    return closing
  end

  private def line(
    context: NeriCodeStyleContext,
    options: NeriCodeStyleOptions,
    result: NeriCodeStyleResult,
    start: Int,
    finish: Int,
    columns: Int
  ): Void
    let projected = result.edits == null ? columns : this.projectedWidth(context, options, result, start, finish, 0)

    if projected <= options.maxLineLength()
      return
    end
    let tokens = context.tokens

    if tokens == null
      return
    end
    var index = neriCodeStyleTokenAtOrAfter(context, start)
    var scan = index
    var depth = 0

    while scan < tokens.count() && tokens.startAt(scan) < finish
      let kind = tokens.kindAt(scan)

      if kind.isIf() && depth == 0 && scan > index
        return
      end
      if kind.isLParen() || kind.isLBracket()
        depth = depth + 1
      else if kind.isRParen() || kind.isRBracket()
        depth = depth - 1
      end
      scan = scan + 1
    end

    while index < tokens.count() && tokens.startAt(index) < finish
      let kind = tokens.kindAt(index)

      if kind.isLParen() || kind.isLBracket()
        let wrapped = this.wrap(context, options, result, index, start, finish)

        index = wrapped if wrapped >= 0
      end
      index = index + 1
    end
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    var byte = 0
    var position = 0
    var start = 0
    var columns = 0
    let length = host::stringByteLength(context.text)

    while byte < length
      let value = host::stringByteAt(context.text, byte) as Int
      let point = codePointAt(context.text, byte)

      if value == 10 || value == 13
        this.line(context, options, result, start, position, columns)
        columns = 0
        start = position + 1
      else if value == 9
        let width = options.tabWidth(2)

        columns = (columns / width + 1) * width
      else
        columns = columns + 1
      end
      byte = byte + utf8Width(value)
      position = position + utf16Width(point)
    end
    this.line(context, options, result, start, position, columns)
  end
end
