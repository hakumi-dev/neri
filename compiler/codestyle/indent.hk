use host

# Indentation follows parser-recorded block bodies and lexer-recorded
# delimiters. Source spelling is consulted only for physical line boundaries
# and the whitespace prefix that may be replaced.

def neriCodeStyleIndentSize(options: NeriCodeStyleOptions): Int
  return options.indentWidth(options.usesTabs() ? options.tabWidth(2) : 2)
end

def neriCodeStyleIndentText(options: NeriCodeStyleOptions, depth: Int): String
  var result = ""
  let size = neriCodeStyleIndentSize(options)
  var spaces = depth * size

  if options.usesTabs()
    let width = options.tabWidth(size)
    var tabs = spaces / width

    spaces = spaces - tabs * width
    while tabs > 0
      result = result + "\t"
      tabs = tabs - 1
    end
  end
  while spaces > 0
    result = result + " "
    spaces = spaces - 1
  end
  return result
end

def neriCodeStyleIndentBlockActive(block: SyntaxBlock, position: Int): Bool
  return block.headerEnd >= 0 && block.headerEnd < position && (block.closing < 0 || position < block.closing)
end

def neriCodeStyleIndentBlockDepth(blocks: SyntaxBlock?, position: Int, lineEnd: Int): Int
  var depth = 0
  var block = blocks

  while block != null
    if neriCodeStyleIndentBlockActive(block, position)
      depth = depth + 1
    end
    let shared = block.sharedEnd

    if shared != null && neriCodeStyleIndentBlockActive(shared, position) && (neriCodeStyleIndentBlockActive(block, position) || (block.start >= position && block.start < lineEnd))
      depth = depth - 1
    end
    block = block.next
  end
  return depth
end

def neriCodeStyleIndentLeadingCloser(tokens: TokenBuffer, index: Int, lineEnd: Int): Bool
  if index >= tokens.count() || tokens.startAt(index) >= lineEnd
    return false
  end
  let kind = tokens.kindAt(index)

  return kind.isRParen() || kind.isRBracket()
end

def neriCodeStyleIndentLine(rule: NeriCodeStyleRule, context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult, lineStart: Int, lineStartByte: Int, lineEndByte: Int, tokenIndex: Int, delimiterDepth: Int, literalEnd: Int): Void
  let map = context.sourceMap
  let tokens = context.tokens

  if map == null || tokens == null
    return
  end
  var contentByte = lineStartByte

  while contentByte < lineEndByte
    let value = host::stringByteAt(context.text, contentByte) as Int

    if value != 32 && value != 9
      break
    end
    contentByte = contentByte + 1
  end
  if contentByte == lineEndByte
    return
  end
  let prefixLength = contentByte - lineStartByte
  let content = lineStart + prefixLength
  var lineEnd = lineStart

  while lineEnd < map.utf16Length() && map.offsetAt(lineEnd) < lineEndByte
    lineEnd = lineEnd + 1
  end

  if literalEnd > content
    return
  end
  var continuation = delimiterDepth

  if continuation > 0 && neriCodeStyleIndentLeadingCloser(tokens, tokenIndex, lineEnd)
    continuation = continuation - 1
  end
  let expected = neriCodeStyleIndentText(options, neriCodeStyleIndentBlockDepth(context.blocks, content, lineEnd) + continuation)
  let actual = host::stringSlice(context.text, lineStartByte, prefixLength)

  if actual != expected
    neriCodeStyleAddLayoutFinding(rule, context, options, result, lineStart, prefixLength, expected, "Indent this line according to its syntax nesting.")
  end
end

class NeriCodeStyleIndentationRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE005"
    this.optionKey = "neri_indentation"
    this.category = "style.layout"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let map = context.sourceMap
    let tokens = context.tokens

    if map == null || tokens == null
      return
    end
    var lineStartByte = 0
    var lineStart = 0
    var tokenIndex = 0
    var delimiterDepth = 0
    var literalEnd = -1
    let length = host::stringByteLength(context.text)

    while lineStartByte < length
      var lineEndByte = lineStartByte

      while lineEndByte < length && (host::stringByteAt(context.text, lineEndByte) as Int) != 10 && (host::stringByteAt(context.text, lineEndByte) as Int) != 13
        lineEndByte = lineEndByte + 1
      end
      var prefixByte = lineStartByte

      while prefixByte < lineEndByte && ((host::stringByteAt(context.text, prefixByte) as Int) == 32 || (host::stringByteAt(context.text, prefixByte) as Int) == 9)
        prefixByte = prefixByte + 1
      end
      let content = lineStart + prefixByte - lineStartByte

      while tokenIndex < tokens.count() && tokens.startAt(tokenIndex) < content
        let kind = tokens.kindAt(tokenIndex)

        if kind.isLParen() || kind.isLBracket()
          delimiterDepth = delimiterDepth + 1
        else if (kind.isRParen() || kind.isRBracket()) && delimiterDepth > 0
          delimiterDepth = delimiterDepth - 1
        end
        if kind.isStringLiteral()
          literalEnd = tokens.startAt(tokenIndex) + tokens.lengthAt(tokenIndex)
        end
        tokenIndex = tokenIndex + 1
      end
      neriCodeStyleIndentLine(this, context, options, result, lineStart, lineStartByte, lineEndByte, tokenIndex, delimiterDepth, literalEnd)
      var nextByte = lineEndByte

      if nextByte < length && (host::stringByteAt(context.text, nextByte) as Int) == 13
        nextByte = nextByte + 1
      end
      if nextByte < length && (host::stringByteAt(context.text, nextByte) as Int) == 10
        nextByte = nextByte + 1
      end
      while lineStart < map.utf16Length() && map.offsetAt(lineStart) < nextByte
        lineStart = lineStart + 1
      end
      lineStartByte = nextByte
    end
  end
end
