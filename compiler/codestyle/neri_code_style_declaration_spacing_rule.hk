use host

class NeriCodeStyleDeclarationSpacingRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE001"
    this.optionKey = "neri_blank_line_after_declarations"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    neriCodeStyleEvaluateDeclarationSiblings(this, context, options, result, context.root)
  end
end
