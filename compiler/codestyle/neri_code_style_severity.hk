sealed class NeriCodeStyleSeverity
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def none(): NeriCodeStyleSeverity
    return new NeriCodeStyleSeverity(0)
  end

  readonly def isNone(): Bool
    return this.tag == 0
  end

  static def suggestion(): NeriCodeStyleSeverity
    return new NeriCodeStyleSeverity(1)
  end

  readonly def isSuggestion(): Bool
    return this.tag == 1
  end

  static def warning(): NeriCodeStyleSeverity
    return new NeriCodeStyleSeverity(2)
  end

  readonly def isWarning(): Bool
    return this.tag == 2
  end

  static def error(): NeriCodeStyleSeverity
    return new NeriCodeStyleSeverity(3)
  end

  readonly def isError(): Bool
    return this.tag == 3
  end

  static def parse(value: String): NeriCodeStyleSeverity?
    return NeriCodeStyleSeverity.none() if value == "none"
    return NeriCodeStyleSeverity.suggestion() if value == "suggestion"
    return NeriCodeStyleSeverity.warning() if value == "warning"
    return NeriCodeStyleSeverity.error() if value == "error"
    return null
  end

  readonly def name(): String
    return "none" if this.isNone()
    return "suggestion" if this.isSuggestion()
    return "warning" if this.isWarning()
    return "error"
  end
end
