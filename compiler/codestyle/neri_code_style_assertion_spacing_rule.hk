use host

class NeriCodeStyleAssertionSpacingRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE002"
    this.optionKey = "neri_blank_line_before_assertions"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    neriCodeStyleEvaluateAssertionSiblings(this, context, options, result, context.root)
  end
end
