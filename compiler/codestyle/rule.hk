abstract class NeriCodeStyleRule
  public ruleId: String = ""
  public optionKey: String = ""
  public defaultSeverity: readonly NeriCodeStyleSeverity = NeriCodeStyleSeverity.warning()
  public category: String = "style"
  public safeFix: Bool = true
  public next: NeriCodeStyleRule?

  def enabled(options: NeriCodeStyleOptions): Bool
    return options.boolean(this.optionKey, true)
  end

  def validateOption(value: String): Bool
    return value == "true" || value == "false" || value == "unset"
  end

  abstract def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
end
