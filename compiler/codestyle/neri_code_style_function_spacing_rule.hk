class NeriCodeStyleFunctionSpacingRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE009"
    this.optionKey = "neri_blank_line_around_functions"
    this.category = "style.spacing"
  end

  def startsFunction(context: NeriCodeStyleContext, position: Int): Bool
    var block = context.blocks

    while block != null
      if block.kind.isFunction() && block.start == position && block.closing >= 0
        return true
      end
      block = block.next
    end
    return false
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let tokens = context.tokens

    if tokens == null
      return
    end
    var block = context.blocks

    while block != null
      if block.kind.isFunction() && block.closing >= 0
        var previous = neriCodeStyleTokenAtOrAfter(context, block.start) - 1

        while previous >= 0 && tokens.kindAt(previous).isNewLine()
          previous = previous - 1
        end
        let parent = block.parent

        if previous >= 0 && (parent == null || tokens.startAt(previous) > parent.headerEnd)
          neriCodeStyleAddFinding(
            this,
            context,
            options,
            result,
            tokens.startAt(previous),
            block.start,
            "Insert a blank line before the function or method block."
          )
        end
        var next = neriCodeStyleTokenAtOrAfter(context, block.closing) + 1

        while next < tokens.count() && tokens.kindAt(next).isNewLine()
          next = next + 1
        end
        if next < tokens.count() && !tokens.kindAt(next).isEnd() && !tokens.kindAt(next).isEndOfFile() && !this.startsFunction(
          context,
          tokens.startAt(next)
        )
          neriCodeStyleAddFinding(
            this,
            context,
            options,
            result,
            block.closing,
            tokens.startAt(next),
            "Insert a blank line after the function or method block."
          )
        end
      end
      block = block.next
    end
  end
end
