use host

class NeriCodeStyleFinding
  public ruleId: String = ""
  public category: String = "style"
  public severity: readonly NeriCodeStyleSeverity
  public message: String = ""
  public start: Int = 0
  public length: Int = 0
  public safeFix: Bool = true
  public edit: NeriCodeStyleEdit?
  public next: NeriCodeStyleFinding?

  def init(rule: NeriCodeStyleRule, severity: readonly NeriCodeStyleSeverity): Void
    this.ruleId = rule.ruleId
    this.category = rule.category
    this.safeFix = rule.safeFix
    this.severity = severity
  end
end
