def neriCodeStyleWhitespace(text: String): Bool
  var byte = 0

  while byte < host.stringByteLength(text)
    let value = host.stringByteAt(text, byte) as Int

    if value != 32 && value != 9 && value != 10 && value != 13
      return false
    end
    byte = byte + 1
  end
  return true
end

def neriCodeStyleSyntaxEquivalent(left: SyntaxArena, leftNode: Int, right: SyntaxArena, rightNode: Int): Bool
  if left.kindAt(leftNode) != right.kindAt(rightNode) || left.dataAt(leftNode) != right.dataAt(rightNode) || left.valueAt(leftNode) != right.valueAt(rightNode) || left.childCountAt(leftNode) != right.childCountAt(rightNode)
    return false
  end
  var child = 0

  while child < left.childCountAt(leftNode)
    if !neriCodeStyleSyntaxEquivalent(left, left.childAt(leftNode, child), right, right.childAt(rightNode, child))
      return false
    end
    child = child + 1
  end
  return true
end

# Comments live in gaps between lexer tokens. Their order and content remain
# stable; trailing horizontal whitespace follows the same policy as code lines.
def neriCodeStyleComments(context: NeriCodeStyleContext): String
  let tokens = context.tokens
  let map = context.sourceMap
  let comments = new StringBuffer()

  if tokens == null || map == null
    return ""
  end
  var previous = 0
  var index = 0

  while index < tokens.count()
    let start = map.offsetAt(tokens.startAt(index))
    var byte = previous

    while byte < start
      if (host.stringByteAt(context.text, byte) as Int) == 35
        var finish = start

        while finish > byte && ((host.stringByteAt(context.text, finish - 1) as Int) == 32 || (host.stringByteAt(context.text, finish - 1) as Int) == 9)
          finish = finish - 1
        end
        let comment = host.stringSlice(context.text, byte, finish - byte)

        comments.add((host.stringByteLength(comment) as String) + ":" + comment)
        byte = start
      else
        byte = byte + 1
      end
    end
    previous = map.offsetAt(tokens.startAt(index) + tokens.lengthAt(index))
    index = index + 1
  end
  return lspJoin(comments, 0, comments.size)
end

def neriCodeStyleAddLayoutFinding(rule: NeriCodeStyleRule, context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult, start: Int, length: Int, replacement: String, message: String): Void
  let map = context.sourceMap

  if map == null
    return
  end
  let first = map.offsetAt(start)
  let finish = map.offsetAt(start + length)

  if host.stringSlice(context.text, first, finish - first) == replacement
    return
  end
  let finding = new NeriCodeStyleFinding()

  finding.ruleId = rule.ruleId
  finding.category = rule.category
  finding.severity = options.severity(rule)
  finding.message = message
  finding.start = start
  finding.length = length
  finding.safeFix = rule.safeFix
  if rule.safeFix
    finding.edit = neriCodeStyleAddEdit(result, start, replacement, length)
  end
  neriCodeStyleInsertFinding(result, finding)
end

class NeriCodeStyleTrailingWhitespaceRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE003"
    this.optionKey = "trim_trailing_whitespace"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let map = context.sourceMap

    if map == null
      return
    end
    var byte = 0
    var position = 0
    var trailing = -1
    let size = host.stringByteLength(context.text)

    while byte <= size
      let value = byte < size ? host.stringByteAt(context.text, byte) as Int : 10

      if value == 32 || value == 9
        if trailing < 0
          trailing = position
        end
      else
        if (value == 10 || value == 13) && trailing >= 0
          neriCodeStyleAddLayoutFinding(this, context, options, result, trailing, position - trailing, "", "Remove trailing whitespace.")
        end
        trailing = -1
      end
      if byte == size
        break
      end
      position = position + utf16Width(codePointAt(context.text, byte))
      byte = byte + utf8Width(value)
    end
  end
end

class NeriCodeStyleFinalNewlineRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE004"
    this.optionKey = "insert_final_newline"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let length = host.stringByteLength(context.text)
    let map = context.sourceMap

    if length == 0 || map == null
      return
    end
    let last = host.stringByteAt(context.text, length - 1) as Int

    if last != 10 && last != 13
      neriCodeStyleAddLayoutFinding(this, context, options, result, map.utf16Length(), 0, neriCodeStyleNewline(context), "Insert a final newline.")
    end
  end
end
