use host

class NeriTokenSpacingRoles
  private values: Int[] = []

  def init(count: Int): Void
    var index = 0

    while index < count
      this.values = host.appendInt(this.values, 0)
      index = index + 1
    end
  end

  def markBinary(index: Int): Void
    this.values[index] = 1
  end

  def markUnary(index: Int): Void
    this.values[index] = 2
  end

  def markTernaryColon(index: Int): Void
    this.values[index] = 3
  end

  def isBinary(index: Int): Bool
    return this.values[index] == 1
  end

  def isUnary(index: Int): Bool
    return this.values[index] == 2
  end

  def isTernaryColon(index: Int): Bool
    return this.values[index] == 3
  end
end
