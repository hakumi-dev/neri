use host

class NeriCodeStyleContext
  public text: String = ""
  public sourceMap: IrSourceMap?
  public tokenStarts: ArenaCheckpointIndex<Int>?
  public newline: String = ""
  public tokens: TokenBuffer?
  public syntax: SyntaxArena?
  public blocks: SyntaxBlock?
  public root: Int = -1
  public valid: Bool = false
  public error: String = ""
end
