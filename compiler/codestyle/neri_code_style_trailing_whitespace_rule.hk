class NeriCodeStyleTrailingWhitespaceRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE003"
    this.optionKey = "trim_trailing_whitespace"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let map = context.sourceMap

    if map == null
      return
    end
    var byte = 0
    var position = 0
    var trailing = -1
    let size = host.stringByteLength(context.text)

    while byte <= size
      let value = byte < size ? host.stringByteAt(context.text, byte) as Int : 10

      if value == 32 || value == 9
        if trailing < 0
          trailing = position
        end
      else
        if (value == 10 || value == 13) && trailing >= 0
          neriCodeStyleAddLayoutFinding(this, context, options, result, trailing, position - trailing, "", "Remove trailing whitespace.")
        end
        trailing = -1
      end
      if byte == size
        break
      end
      position = position + utf16Width(codePointAt(context.text, byte))
      byte = byte + utf8Width(value)
    end
  end
end
