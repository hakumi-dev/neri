use console
use host

class NeriCodeStyleCliFile
  public path: String = ""
  public original: String = ""
  public updated: String = ""
  public options: NeriCodeStyleOptions = new NeriCodeStyleOptions()
  public result: NeriCodeStyleResult = new NeriCodeStyleResult()
  public next: NeriCodeStyleCliFile?
end

def neriCodeStyleCliUsage(): Void
  console.println("usage: neri format [--check] [--project <directory|manifest.json> [--unit <name>] | <source.hk>...]")
  console.println("       neri lint [--fix] [--project <directory|manifest.json> [--unit <name>] | <source.hk>...]")
end

def neriCodeStyleCliPosition(text: String, position: Int): String
  let map = new IrSourceMap(text)
  let finish = map.offsetAt(position)
  var byte = 0
  var line = 1
  var column = 1

  while byte < finish
    let value = host.stringByteAt(text, byte) as Int

    if value == 10
      line = line + 1
      column = 1
    else if value != 13
      let point = codePointAt(text, byte)

      column = column + utf16Width(point)
    end
    byte = byte + utf8Width(value)
  end
  return (line as String) + ":" + (column as String)
end

def neriCodeStyleCliReport(file: NeriCodeStyleCliFile, text: String, result: NeriCodeStyleResult): Int
  var count = 0
  var finding = result.findings

  while finding != null
    if finding.severity != "none"
      console.println(file.path + ":" + neriCodeStyleCliPosition(text, finding.start) + ": " + finding.severity + " " + finding.ruleId + ": " + finding.message)
      count = count + 1
    end
    finding = finding.next
  end
  return count
end

def neriCodeStyleCliContains(first: NeriCodeStyleCliFile?, path: String): Bool
  var file = first

  while file != null
    if file.path == path
      return true
    end
    file = file.next
  end
  return false
end

def neriCodeStyleCli(command: String): Void
  var check = false
  var fix = false
  var projectPath = ""
  var unit = ""
  var first: NeriCodeStyleCliFile? = null
  var last: NeriCodeStyleCliFile? = null
  var index = 1

  while index < host.argumentCount()
    let optional = host.argumentAt(index)

    if optional == null
      host.exit(2)
      return
    end
    let argument = optional

    if argument == "--check" && command == "format"
      check = true
      index = index + 1
    else if argument == "--fix" && command == "lint"
      fix = true
      index = index + 1
    else if argument == "--project" || argument == "--unit"
      if index + 1 >= host.argumentCount()
        neriCodeStyleCliUsage()
        host.exit(2)
        return
      end
      let value = host.argumentAt(index + 1)

      if value == null
        host.exit(2)
        return
      end
      if argument == "--project" && first != null
        console.println("--project cannot be combined with explicit source files")
        host.exit(2)
        return
      end
      if argument == "--project"
        projectPath = value
      else
        unit = value
      end
      index = index + 2
    else if argument == "--help"
      neriCodeStyleCliUsage()
      return
    else if bootstrapStartsWith(argument, "--")
      console.println("unknown option: " + argument)
      neriCodeStyleCliUsage()
      host.exit(2)
      return
    else
      if projectPath != ""
        console.println("--project cannot be combined with explicit source files")
        host.exit(2)
        return
      end
      let path = neriCanonicalPath(argument)

      if path == null || !neriSourceNameValid(path)
        console.println("source path is invalid: " + argument)
        host.exit(2)
        return
      end
      if !neriCodeStyleCliContains(first, path)
        let file = new NeriCodeStyleCliFile()

        file.path = path
        if first == null
          first = file
        else
          let tail = last

          if tail != null
            tail.next = file
          end
        end
        last = file
      end
      index = index + 1
    end
  end
  if projectPath != "" && first != null
    console.println("--project cannot be combined with explicit source files")
    host.exit(2)
    return
  end
  if unit != "" && projectPath == ""
    console.println("--unit requires --project")
    host.exit(2)
    return
  end
  if first == null
    let requested = projectPath == "" ? "." : projectPath
    let project = neriLoadProject(requested, unit)

    if project.error != ""
      console.println(project.error)
      host.exit(2)
      return
    end
    var source = project.ownSources.first.nextNode

    while source != null
      if !neriProjectListed(project.generatedOutputs, source.value)
        let file = new NeriCodeStyleCliFile()

        file.path = source.value
        if first == null
          first = file
        else
          let tail = last

          if tail != null
            tail.next = file
          end
        end
        last = file
      end
      source = source.nextNode
    end
    if unit == "" && neriProjectManifestName(project.manifest)
      let manifestText = host.readText(project.manifest)

      if manifestText == null
        console.println("could not read project: " + project.manifest)
        host.exit(2)
        return
      end
      let units = (new LspJsonParser(manifestText)).parse().get("units")
      var entry = units.first

      while entry != null
        let selected = neriLoadProject(project.manifest, entry.key)

        if selected.error != ""
          console.println(selected.error)
          host.exit(2)
          return
        end
        source = selected.ownSources.first.nextNode
        while source != null
          if !neriProjectListed(selected.generatedOutputs, source.value) && !neriCodeStyleCliContains(first, source.value)
            let file = new NeriCodeStyleCliFile()

            file.path = source.value
            let tail = last

            if tail != null
              tail.next = file
            else
              first = file
            end
            last = file
          end
          source = source.nextNode
        end
        entry = entry.next
      end
    end
  end
  if first == null
    console.println("No owned Neri sources were found.")
    host.exit(2)
    return
  end
  var file: NeriCodeStyleCliFile? = first

  while file != null
    let text = host.readText(file.path)

    if text == null
      console.println("could not read source: " + file.path)
      host.exit(2)
      return
    end
    file.original = text
    let configured = codeStyleOptionsFor(file.path)

    if configured.error != ""
      console.println(configured.error)
      host.exit(2)
      return
    end
    file.options = configured.options
    let context = neriCodeStyleContext(text)

    if !context.valid
      console.println(file.path + ": " + context.error)
      host.exit(2)
      return
    end
    file.result = neriCodeStyleAnalyze(context, file.options)
    let applied = neriCodeStyleApplyChecked(text, file.result.edits)

    if !applied.valid
      console.println(file.path + ": " + applied.error)
      host.exit(2)
      return
    end
    file.updated = applied.text
    file = file.next
  end
  var changed = 0
  var remaining = 0

  file = first
  while file != null
    if file.updated != file.original
      changed = changed + 1
      if command == "format" && check
        console.println(file.path + ": needs formatting")
      end
    end
    if command == "lint" && !fix
      remaining = remaining + neriCodeStyleCliReport(file, file.original, file.result)
    end
    file = file.next
  end
  let write = (command == "format" && !check) || (command == "lint" && fix)

  if write && changed > 0
    file = first
    while file != null
      let current = host.readText(file.path)

      if current == null || current != file.original
        console.println("source changed during CodeStyle validation: " + file.path)
        host.exit(2)
        return
      end
      file = file.next
    end
    var written = 0

    file = first
    while file != null
      if file.updated != file.original
        let current = host.readText(file.path)

        if current == null || current != file.original
          console.println("source changed after " + (written as String) + " file(s) were written: " + file.path)
          host.exit(2)
          return
        end
        if !host.writeText(file.path, file.updated)
          console.println("could not write source after " + (written as String) + " file(s): " + file.path + ": " + host.errorMessage())
          host.exit(2)
          return
        end
        written = written + 1
      end
      file = file.next
    end
  end
  if command == "lint" && fix
    file = first
    while file != null
      let fixed = neriCodeStyleAnalyzeText(file.updated, file.options)

      remaining = remaining + neriCodeStyleCliReport(file, file.updated, fixed)
      file = file.next
    end
  end
  if (command == "format" && check && changed > 0) || (command == "lint" && remaining > 0)
    host.exit(1)
  end
end
