use host

class NeriCodeStyleSetting
  public key: String = ""
  public value: String = ""
  public next: NeriCodeStyleSetting?
end

class NeriCodeStyleOptions
  public assertionHelpers: StringBuffer = new StringBuffer()
  public firstSetting: NeriCodeStyleSetting?

  def init(): Void
    this.assertionHelpers.add("test.assert*")
    this.assertionHelpers.add("assert")
  end

  def set(key: String, value: String): Void
    var current = this.firstSetting

    while current != null
      if current.key == key
        current.value = value
        return
      end
      current = current.next
    end
    let setting = new NeriCodeStyleSetting()

    setting.key = key
    setting.value = value
    setting.next = this.firstSetting
    this.firstSetting = setting
  end

  def value(key: String, fallback: String): String
    var current = this.firstSetting

    while current != null
      if current.key == key
        return current.value == "unset" ? fallback : current.value
      end
      current = current.next
    end
    return fallback
  end

  def severity(rule: NeriCodeStyleRule): String
    return this.value("neri_diagnostic." + codeStyleLower(rule.ruleId) + ".severity", rule.defaultSeverity)
  end
end

class NeriCodeStyleConfigResult
  public options: NeriCodeStyleOptions = new NeriCodeStyleOptions()
  public error: String = ""
end

def codeStyleLower(value: String): String
  var bytes: Byte[] = []
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    bytes = host.appendByte(bytes, (byte >= 65 && byte <= 90 ? byte + 32 : byte) as Byte)
    index = index + 1
  end
  let result = host.stringFromBytes(bytes)

  if result == null
    return ""
  end
  return result
end

def codeStyleTrim(value: String): String
  var first = 0
  var last = host.stringByteLength(value)

  while first < last && ((host.stringByteAt(value, first) as Int) == 32 || (host.stringByteAt(value, first) as Int) == 9 || (host.stringByteAt(value, first) as Int) == 13)
    first = first + 1
  end
  while last > first && ((host.stringByteAt(value, last - 1) as Int) == 32 || (host.stringByteAt(value, last - 1) as Int) == 9 || (host.stringByteAt(value, last - 1) as Int) == 13)
    last = last - 1
  end
  return host.stringSlice(value, first, last - first)
end

def codeStyleLine(text: String, start: Int): String
  var finish = start

  while finish < host.stringByteLength(text) && (host.stringByteAt(text, finish) as Int) != 10
    finish = finish + 1
  end
  return codeStyleTrim(host.stringSlice(text, start, finish - start))
end

def codeStyleNextLine(text: String, start: Int): Int
  var next = start

  while next < host.stringByteLength(text) && (host.stringByteAt(text, next) as Int) != 10
    next = next + 1
  end
  return next < host.stringByteLength(text) ? next + 1 : next
end

def codeStyleGlobMatchAt(pattern: String, patternAt: Int, path: String, pathAt: Int): Bool
  if patternAt == host.stringByteLength(pattern)
    return pathAt == host.stringByteLength(path)
  end
  let token = host.stringByteAt(pattern, patternAt) as Int

  if token == 92
    if patternAt + 1 >= host.stringByteLength(pattern) || pathAt >= host.stringByteLength(path)
      return false
    end
    let patternPoint = codePointAt(pattern, patternAt + 1)
    let pathPoint = codePointAt(path, pathAt)

    return patternPoint == pathPoint && codeStyleGlobMatchAt(pattern, patternAt + 1 + utf8Width(host.stringByteAt(pattern, patternAt + 1) as Int), path, pathAt + utf8Width(host.stringByteAt(path, pathAt) as Int))
  end
  if token == 42
    let recursive = patternAt + 1 < host.stringByteLength(pattern) && (host.stringByteAt(pattern, patternAt + 1) as Int) == 42
    let next = patternAt + (recursive ? 2 : 1)

    if recursive && next < host.stringByteLength(pattern) && (host.stringByteAt(pattern, next) as Int) == 47 && codeStyleGlobMatchAt(pattern, next + 1, path, pathAt)
      return true
    end
    var cursor = pathAt

    while true
      if codeStyleGlobMatchAt(pattern, next, path, cursor)
        return true
      end
      if cursor >= host.stringByteLength(path) || (!recursive && (host.stringByteAt(path, cursor) as Int) == 47)
        return false
      end
      cursor = cursor + utf8Width(host.stringByteAt(path, cursor) as Int)
    end
  end
  if pathAt >= host.stringByteLength(path)
    return false
  end
  if token == 63
    return (host.stringByteAt(path, pathAt) as Int) != 47 && codeStyleGlobMatchAt(pattern, patternAt + 1, path, pathAt + utf8Width(host.stringByteAt(path, pathAt) as Int))
  end
  if token == 91
    var finish = patternAt + 1

    while finish < host.stringByteLength(pattern) && (host.stringByteAt(pattern, finish) as Int) != 93
      finish = finish + 1
    end
    if finish == host.stringByteLength(pattern) || (host.stringByteAt(path, pathAt) as Int) == 47
      return false
    end
    let pathPoint = codePointAt(path, pathAt)
    var member = patternAt + 1
    var negate = false

    if member < finish && (host.stringByteAt(pattern, member) as Int) == 33
      negate = true
      member = member + 1
    end
    var found = false

    while member < finish
      if codePointAt(pattern, member) == pathPoint
        found = true
      end
      member = member + utf8Width(host.stringByteAt(pattern, member) as Int)
    end
    return found != negate && codeStyleGlobMatchAt(pattern, finish + 1, path, pathAt + utf8Width(host.stringByteAt(path, pathAt) as Int))
  end
  let patternPoint = codePointAt(pattern, patternAt)
  let pathPoint = codePointAt(path, pathAt)

  return patternPoint == pathPoint && codeStyleGlobMatchAt(pattern, patternAt + utf8Width(host.stringByteAt(pattern, patternAt) as Int), path, pathAt + utf8Width(host.stringByteAt(path, pathAt) as Int))
end

def codeStyleGlobSpecial(pattern: String, target: Int): Int
  var bracket = false
  var index = 0

  while index < host.stringByteLength(pattern)
    let byte = host.stringByteAt(pattern, index) as Int

    if byte == 92
      index = index + 1
    else if byte == 91
      bracket = true
    else if byte == 93
      bracket = false
    else if !bracket && byte == target
      return index
    end
    index = index + 1
  end
  return -1
end

def codeStyleGlobSimple(pattern: String, path: String): Bool
  if codeStyleGlobSpecial(pattern, 47) >= 0
    let normalized = bootstrapStartsWith(pattern, "/") ? host.stringSlice(pattern, 1, host.stringByteLength(pattern) - 1) : pattern

    return codeStyleGlobMatchAt(normalized, 0, path, 0)
  end
  if codeStyleGlobMatchAt(pattern, 0, path, 0)
    return true
  end
  var index = 0

  while index < host.stringByteLength(path)
    if (host.stringByteAt(path, index) as Int) == 47 && codeStyleGlobMatchAt(pattern, 0, path, index + 1)
      return true
    end
    index = index + 1
  end
  return false
end

def codeStyleNumericGlob(prefix: String, suffix: String, path: String, first: Int, last: Int): Bool
  var numberStart = 0

  while numberStart < host.stringByteLength(path)
    var numberEnd = numberStart

    if (host.stringByteAt(path, numberEnd) as Int) == 45
      numberEnd = numberEnd + 1
    end
    let digits = numberEnd

    while numberEnd < host.stringByteLength(path) && (host.stringByteAt(path, numberEnd) as Int) >= 48 && (host.stringByteAt(path, numberEnd) as Int) <= 57
      numberEnd = numberEnd + 1
    end
    if numberEnd > digits
      let candidate = host.parseInt(host.stringSlice(path, numberStart, numberEnd - numberStart))
      let before = host.stringSlice(path, 0, numberStart)
      let after = host.stringSlice(path, numberEnd, host.stringByteLength(path) - numberEnd)

      if candidate != null && candidate >= first && candidate <= last && codeStyleGlobMatchAt(prefix, 0, before, 0) && codeStyleGlobMatchAt(suffix, 0, after, 0)
        return true
      end
    end
    numberStart = numberStart + 1
  end
  return false
end

def codeStyleGlob(pattern: String, path: String): Bool
  let opening = codeStyleGlobSpecial(pattern, 123)

  if opening < 0
    return codeStyleGlobSimple(pattern, path)
  end
  var closing = opening + 1
  var braceDepth = 1
  var bracket = false

  while closing < host.stringByteLength(pattern) && braceDepth > 0
    let byte = host.stringByteAt(pattern, closing) as Int

    if byte == 92
      closing = closing + 1
    else if byte == 91
      bracket = true
    else if byte == 93
      bracket = false
    else if !bracket && byte == 123
      braceDepth = braceDepth + 1
    else if !bracket && byte == 125
      braceDepth = braceDepth - 1
    end
    if braceDepth > 0
      closing = closing + 1
    end
  end
  if braceDepth != 0
    return false
  end
  let prefix = host.stringSlice(pattern, 0, opening)
  let suffix = host.stringSlice(pattern, closing + 1, host.stringByteLength(pattern) - closing - 1)
  let body = host.stringSlice(pattern, opening + 1, closing - opening - 1)
  let range = bootstrapFindText(body, "..")

  if range > 0 && bootstrapFindText(body, ",") < 0
    let first = host.parseInt(host.stringSlice(body, 0, range))
    let last = host.parseInt(host.stringSlice(body, range + 2, host.stringByteLength(body) - range - 2))

    if first == null || last == null || first >= last
      return false
    end
    if codeStyleGlobSpecial(pattern, 47) >= 0
      let normalizedPrefix = bootstrapStartsWith(prefix, "/") ? host.stringSlice(prefix, 1, host.stringByteLength(prefix) - 1) : prefix

      return codeStyleNumericGlob(normalizedPrefix, suffix, path, first, last)
    end
    if codeStyleNumericGlob(prefix, suffix, path, first, last)
      return true
    end
    var component = 0

    while component < host.stringByteLength(path)
      if (host.stringByteAt(path, component) as Int) == 47 && codeStyleNumericGlob(prefix, suffix, host.stringSlice(path, component + 1, host.stringByteLength(path) - component - 1), first, last)
        return true
      end
      component = component + 1
    end
    return false
  end
  var start = opening + 1
  var finish = start
  var nested = 0
  var alternativeBracket = false

  while finish <= closing
    if finish < closing
      let byte = host.stringByteAt(pattern, finish) as Int

      if byte == 92
        finish = finish + 1
      else if byte == 91
        alternativeBracket = true
      else if byte == 93
        alternativeBracket = false
      else if !alternativeBracket && byte == 123
        nested = nested + 1
      else if !alternativeBracket && byte == 125
        nested = nested - 1
      end
    end
    if finish == closing || (!alternativeBracket && (host.stringByteAt(pattern, finish) as Int) == 44 && nested == 0)
      if codeStyleGlob(prefix + host.stringSlice(pattern, start, finish - start) + suffix, path)
        return true
      end
      start = finish + 1
    end
    finish = finish + 1
  end
  return false
end

def codeStyleEndsWith(value: String, suffix: String): Bool
  let start = host.stringByteLength(value) - host.stringByteLength(suffix)

  return start >= 0 && host.stringSlice(value, start, host.stringByteLength(suffix)) == suffix
end

def codeStyleGlobError(pattern: String): String
  let opening = codeStyleGlobSpecial(pattern, 123)

  if opening < 0
    return codeStyleGlobSpecial(pattern, 125) < 0 ? "" : "Unmatched brace in CodeStyle glob."
  end
  var closing = opening + 1
  var depth = 1
  var bracket = false

  while closing < host.stringByteLength(pattern) && depth > 0
    let byte = host.stringByteAt(pattern, closing) as Int

    if byte == 92
      closing = closing + 1
    else if byte == 91
      bracket = true
    else if byte == 93
      bracket = false
    else if !bracket && byte == 123
      depth = depth + 1
    else if !bracket && byte == 125
      depth = depth - 1
    end
    if depth > 0
      closing = closing + 1
    end
  end
  if depth != 0
    return "Unmatched brace in CodeStyle glob."
  end
  let body = host.stringSlice(pattern, opening + 1, closing - opening - 1)
  let range = bootstrapFindText(body, "..")

  if range >= 0 && bootstrapFindText(body, ",") < 0 && codeStyleGlobSpecial(body, 123) < 0
    let first = host.parseInt(host.stringSlice(body, 0, range))
    let last = host.parseInt(host.stringSlice(body, range + 2, host.stringByteLength(body) - range - 2))

    if first == null || last == null || first >= last
      return "Numeric CodeStyle glob ranges require the first integer to be less than the second."
    end
  end
  let nestedError = codeStyleGlobError(body)

  if nestedError != ""
    return nestedError
  end
  return codeStyleGlobError(host.stringSlice(pattern, closing + 1, host.stringByteLength(pattern) - closing - 1))
end

def codeStyleRelative(directory: String, path: String): String
  if path == directory
    return ""
  end
  let prefix = directory == "/" ? "/" : directory + "/"

  if !bootstrapStartsWith(path, prefix)
    return ""
  end
  return host.stringSlice(path, host.stringByteLength(prefix), host.stringByteLength(path) - host.stringByteLength(prefix))
end

def codeStyleRoot(text: String): Bool
  var section = false
  var start = 0

  while start < host.stringByteLength(text)
    let line = codeStyleLine(text, start)

    if bootstrapStartsWith(line, "[")
      section = true
    else if !section && line != "" && !bootstrapStartsWith(line, "#") && !bootstrapStartsWith(line, ";")
      let equal = bootstrapFindText(line, "=")

      if equal >= 0 && codeStyleLower(codeStyleTrim(host.stringSlice(line, 0, equal))) == "root" && codeStyleLower(codeStyleTrim(host.stringSlice(line, equal + 1, host.stringByteLength(line) - equal - 1))) == "true"
        return true
      end
    end
    start = codeStyleNextLine(text, start)
  end
  return false
end

def codeStyleHelperName(value: String): String
  var bytes: Byte[] = []
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    bytes = host.appendByte(bytes, (byte == 47 ? 46 : byte) as Byte)
    index = index + 1
  end
  let result = host.stringFromBytes(bytes)

  if result == null
    return ""
  end
  return result
end

def codeStyleHelpers(options: NeriCodeStyleOptions, value: String): Void
  options.assertionHelpers = new StringBuffer()
  if codeStyleLower(value) == "unset"
    options.assertionHelpers.add("test.assert*")
    options.assertionHelpers.add("assert")
    return
  end
  var start = 0
  var finish = 0

  while finish <= host.stringByteLength(value)
    if finish == host.stringByteLength(value) || (host.stringByteAt(value, finish) as Int) == 44
      let helper = codeStyleHelperName(codeStyleTrim(host.stringSlice(value, start, finish - start)))

      if helper != "" && (bootstrapFindText(helper, "*") < 0 || (bootstrapFindText(helper, "*") == host.stringByteLength(helper) - 1))
        options.assertionHelpers.add(helper)
      end
      start = finish + 1
    end
    finish = finish + 1
  end
end

def codeStyleHelperNameValid(value: String): Bool
  var length = host.stringByteLength(value)
  let prefix = length > 0 && (host.stringByteAt(value, length - 1) as Int) == 42

  if prefix
    length = length - 1
  end
  if length == 0
    return false
  end
  if !prefix && (host.stringByteAt(value, length - 1) as Int) == 46
    return false
  end
  var start = 0

  while start < length
    var finish = start

    while finish < length && (host.stringByteAt(value, finish) as Int) != 46
      finish = finish + 1
    end
    let part = host.stringSlice(value, start, finish - start)
    let tokens = (new BootstrapLexer(part)).lex()

    if tokens.count() != 2 || tokens.kindAt(0) != "Identifier" || tokens.lengthAt(0) != (new IrSourceMap(part)).utf16Length()
      return false
    end
    start = finish + 1
  end
  return true
end

def codeStyleHelpersValid(value: String): Bool
  if codeStyleLower(value) == "unset"
    return true
  end
  var count = 0
  var start = 0
  var finish = 0

  while finish <= host.stringByteLength(value)
    if finish == host.stringByteLength(value) || (host.stringByteAt(value, finish) as Int) == 44
      if !codeStyleHelperNameValid(codeStyleHelperName(codeStyleTrim(host.stringSlice(value, start, finish - start))))
        return false
      end
      count = count + 1
      start = finish + 1
    end
    finish = finish + 1
  end
  return count > 0
end

def codeStyleApply(options: NeriCodeStyleOptions, key: String, rawValue: String): Void
  let value = codeStyleLower(rawValue)

  if key == "neri_assertion_helpers"
    codeStyleHelpers(options, rawValue)
  else if bootstrapStartsWith(key, "neri_") || key == "indent_style" || key == "indent_size" || key == "tab_width" || key == "trim_trailing_whitespace" || key == "insert_final_newline"
    options.set(key, value)
  end
end

def codeStyleValueError(key: String, rawValue: String): String
  let value = codeStyleLower(rawValue)
  var rule: NeriCodeStyleRule? = neriCodeStyleRules()

  if key == "indent_style" && value != "space" && value != "tab" && value != "unset"
    return "Expected space, tab, or unset for indent_style."
  end
  if (key == "indent_size" || key == "tab_width") && value != "unset" && !(key == "indent_size" && value == "tab")
    let width = host.parseInt(value)

    if width == null || width <= 0
      return "Expected a positive integer for " + key + "."
    end
  end
  while rule != null
    if rule.optionKey == key
      return rule.validateOption(value) ? "" : "Invalid value for " + key + "."
    end
    rule = rule.next
  end
  if bootstrapStartsWith(key, "neri_diagnostic.") && codeStyleEndsWith(key, ".severity")
    return value == "none" || value == "suggestion" || value == "warning" || value == "error" || value == "unset" ? "" : "Expected none, suggestion, warning, error, or unset for " + key + "."
  end
  if key == "neri_assertion_helpers" && !codeStyleHelpersValid(rawValue)
    return "Assertion helpers must be comma-separated identifiers qualified with / and an optional trailing *."
  end
  return ""
end

def codeStyleApplyFile(result: NeriCodeStyleConfigResult, directory: String, path: String, text: String): Void
  let relative = codeStyleRelative(directory, path)
  var matching = false
  var start = 0

  while start < host.stringByteLength(text)
    let line = codeStyleLine(text, start)

    if bootstrapStartsWith(line, "[")
      if host.stringByteLength(line) < 2 || (host.stringByteAt(line, host.stringByteLength(line) - 1) as Int) != 93
        result.error = "Invalid section header in " + directory + "/.editorconfig: " + line
        return
      end
      let pattern = host.stringSlice(line, 1, host.stringByteLength(line) - 2)
      let patternError = codeStyleGlobError(pattern)

      if patternError != ""
        result.error = patternError + " File: " + directory + "/.editorconfig"
        return
      end
      matching = codeStyleGlob(pattern, relative)
    else if line != "" && !bootstrapStartsWith(line, "#") && !bootstrapStartsWith(line, ";")
      let equal = bootstrapFindText(line, "=")

      if equal < 0
        result.error = "Invalid .editorconfig line in " + directory + "/.editorconfig: " + line
        return
      end
      if matching
        let key = codeStyleLower(codeStyleTrim(host.stringSlice(line, 0, equal)))
        let value = codeStyleTrim(host.stringSlice(line, equal + 1, host.stringByteLength(line) - equal - 1))
        let valueError = codeStyleValueError(key, value)

        if valueError != ""
          result.error = valueError + " File: " + directory + "/.editorconfig"
          return
        end
        codeStyleApply(result.options, key, value)
      end
    end
    start = codeStyleNextLine(text, start)
  end
end

def codeStyleOptionsFor(path: String): NeriCodeStyleConfigResult
  let result = new NeriCodeStyleConfigResult()
  let absolute = host.pathAbsolute(path)

  if absolute == null
    result.error = "Cannot resolve CodeStyle source path: " + path
    return result
  end
  let directories = new StringBuffer()
  let configs = new StringBuffer()
  var directory = bootstrapDirectory(absolute)

  while true
    let text = host.readText(directory + "/.editorconfig")

    if text != null
      directories.add(directory)
      configs.add(text)
      if codeStyleRoot(text)
        break
      end
    end
    let parent = bootstrapDirectory(directory)

    if parent == directory
      break
    end
    directory = parent
  end
  var index = configs.size - 1

  while index >= 0 && result.error == ""
    codeStyleApplyFile(result, directories.get(index), absolute, configs.get(index))
    index = index - 1
  end
  return result
end
