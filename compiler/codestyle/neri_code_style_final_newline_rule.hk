class NeriCodeStyleFinalNewlineRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE004"
    this.optionKey = "insert_final_newline"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let length = host::stringByteLength(context.text)
    let map = context.sourceMap

    if length == 0 || map == null
      return
    end
    let last = host::stringByteAt(context.text, length - 1) as Int

    if last != 10 && last != 13
      neriCodeStyleAddLayoutFinding(this, context, options, result, map.utf16Length(), 0, neriCodeStyleNewline(context), "Insert a final newline.")
    end
  end
end
