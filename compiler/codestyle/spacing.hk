use host

class NeriCodeStyleTokenSpacingRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE006"
    this.optionKey = "neri_token_spacing"
    this.category = "style.spacing"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let tokens = context.tokens

    if tokens == null
      return
    end
    let roles = neriCodeStyleTokenRoles(context)
    var index = 0

    while index < tokens.count()
      let kind = tokens.kindAt(index)

      if kind == "Comma"
        neriCodeStyleTokenGap(this, context, options, result, index - 1, index, "", "Remove spacing before ','.")
        if index + 1 < tokens.count() && tokens.kindAt(index + 1) != "RParen" && tokens.kindAt(index + 1) != "RBracket"
          neriCodeStyleTokenGap(this, context, options, result, index, index + 1, " ", "Use one space after ','.")
        end
      else if kind == "Colon"
        neriCodeStyleTokenGap(this, context, options, result, index - 1, index, roles[index] == 3 ? " " : "", roles[index] == 3 ? "Use one space before the ternary ':'." : "Remove spacing before ':'.")
        neriCodeStyleTokenGap(this, context, options, result, index, index + 1, " ", "Use one space after ':'.")
      else if kind == "Dot"
        neriCodeStyleTokenGap(this, context, options, result, index - 1, index, "", "Remove spacing before '.'.")
        neriCodeStyleTokenGap(this, context, options, result, index, index + 1, "", "Remove spacing after '.'.")
      else if kind == "LParen" || kind == "LBracket"
        neriCodeStyleTokenGap(this, context, options, result, index, index + 1, "", "Remove spacing inside the opening delimiter.")
      else if kind == "RParen" || kind == "RBracket"
        neriCodeStyleTokenGap(this, context, options, result, index - 1, index, "", "Remove spacing inside the closing delimiter.")
      else if roles[index] == 1 || neriCodeStyleAssignmentRole(context, index)
        neriCodeStyleTokenGap(this, context, options, result, index - 1, index, " ", "Use one space before the operator.")
        neriCodeStyleTokenGap(this, context, options, result, index, index + 1, " ", "Use one space after the operator.")
      else if roles[index] == 2
        neriCodeStyleTokenGap(this, context, options, result, index, index + 1, "", "Remove spacing after the unary operator.")
      end
      index = index + 1
    end
  end
end

def neriCodeStyleTokenRoles(context: NeriCodeStyleContext): Int[]
  let tokens = context.tokens
  let arena = context.syntax
  var roles: Int[] = []

  if tokens == null
    return roles
  end
  var token = 0

  while token < tokens.count()
    roles = host.appendInt(roles, tokens.kindAt(token) == "As" ? 1 : 0)
    token = token + 1
  end
  if arena == null
    return roles
  end
  var node = 0

  while node < arena.count()
    let kind = arena.kindAt(node)

    if kind == "Binary" || kind == "Unary"
      let anchored = neriCodeStyleTokenAtOrAfter(context, arena.startAt(node))

      if anchored < tokens.count() && tokens.startAt(anchored) == arena.startAt(node)
        roles[anchored] = kind == "Binary" ? 1 : 2
      end
    else if kind == "Ternary"
      let colon = neriCodeStyleTokenAtOrAfter(context, arena.secondaryStartAt(node))

      if colon < tokens.count() && tokens.kindAt(colon) == "Colon" && tokens.startAt(colon) == arena.secondaryStartAt(node)
        roles[colon] = 3
      end
    end
    node = node + 1
  end
  return roles
end

def neriCodeStyleAssignmentRole(context: NeriCodeStyleContext, token: Int): Bool
  let tokens = context.tokens

  # Plain '=' has only assignment/default-initializer roles in the grammar;
  # comparisons have their own EqualEqual token.
  return tokens != null && tokens.kindAt(token) == "Equal"
end

def neriCodeStyleTokenGap(rule: NeriCodeStyleRule, context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult, left: Int, right: Int, replacement: String, message: String): Void
  let tokens = context.tokens
  let map = context.sourceMap

  if tokens == null || map == null || left < 0 || right >= tokens.count() || tokens.kindAt(left) == "NewLine" || tokens.kindAt(right) == "NewLine" || tokens.kindAt(right) == "EndOfFile"
    return
  end
  let start = tokens.startAt(left) + tokens.lengthAt(left)
  let finish = tokens.startAt(right)

  if finish < start || !neriCodeStyleHorizontalGap(context, start, finish)
    return
  end
  let first = map.offsetAt(start)
  let last = map.offsetAt(finish)
  let current = host.stringSlice(context.text, first, last - first)

  if current != replacement
    neriCodeStyleAddLayoutFinding(rule, context, options, result, start, finish - start, replacement, message)
  end
end

def neriCodeStyleHorizontalGap(context: NeriCodeStyleContext, start: Int, finish: Int): Bool
  let map = context.sourceMap

  if map == null
    return false
  end
  let first = map.offsetAt(start)
  let last = map.offsetAt(finish)
  var byte = first

  while byte < last
    let value = host.stringByteAt(context.text, byte) as Int

    if value != 32 && value != 9
      return false
    end
    byte = byte + 1
  end
  return true
end
