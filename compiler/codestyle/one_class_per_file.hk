class NeriCodeStyleOneClassPerFileRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE007"
    this.optionKey = "neri_one_class_per_file"
    this.category = "style.structure"
    this.safeFix = false
  end

  def enabled(options: NeriCodeStyleOptions): Bool
    return options.value(this.optionKey, "false") == "true"
  end

  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let arena = context.syntax

    if arena == null
      return
    end
    var found = false
    var index = 0

    while index < arena.childCountAt(context.root)
      let declaration = arena.childAt(context.root, index)

      if arena.kindAt(declaration) == "Class"
        if found
          let finding = new NeriCodeStyleFinding()

          finding.ruleId = this.ruleId
          finding.category = this.category
          finding.severity = options.severity(this)
          finding.message = "Keep one class or enum declaration per file."
          finding.start = arena.startAt(declaration)
          finding.length = arena.lengthAt(declaration)
          finding.safeFix = false
          neriCodeStyleInsertFinding(result, finding)
        end
        found = true
      end
      index = index + 1
    end
  end
end
