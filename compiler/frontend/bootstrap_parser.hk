use host

class BootstrapParser
  public tokens: TokenBuffer
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public arena: SyntaxArena = new SyntaxArena()
  public position: Int = 0
  public expressionDepth: Int = 0
  public argumentDepth: Int = 0
  public typeDepth: Int = 0
  public sourceBoundaries: IntBuffer = new IntBuffer()
  public sourceBoundaryIndex: Int = 0
  public lastTokenStart: Int = 0
  public lastTokenLength: Int = 0
  public lastTokenText: String = ""
  public sessionExpressions: Bool = false
  public recordBlocks: Bool = false
  public blocks: SyntaxBlock?
  private activeBlock: SyntaxBlock?

  def beginBlock(token: Int = -1): SyntaxBlock?
    if !this.recordBlocks
      return null
    end
    let block = new SyntaxBlock(this.tokens.kindAt(token < 0 ? this.currentIndex() : token))

    block.kind = this.tokens.kindAt(token < 0 ? this.currentIndex() : token)
    block.start = this.tokens.startAt(token < 0 ? this.currentIndex() : token)
    block.diagnosticsBefore = this.diagnostics.count()
    block.parent = this.activeBlock
    block.next = this.blocks
    this.blocks = block
    return block
  end

  def openBlock(block: SyntaxBlock?): Void
    if block != null
      this.activeBlock = block
      if this.currentKind().isNewLine() && this.diagnostics.count() == block.diagnosticsBefore
        block.headerEnd = this.tokens.startAt(this.currentIndex())
      end
    end
  end

  def closeBlock(block: SyntaxBlock?): Void
    var current = block

    while current != null
      current.closing = this.currentKind().isEnd() || (!current.ownsEnd && this.currentKind().isCase()) ? this.tokens.startAt(this.currentIndex()) : -1
      this.activeBlock = current.parent
      current = current.sharedEnd
    end
  end

  def init(tokens: TokenBuffer, parentArena: SyntaxArena? = null): Void
    this.tokens = tokens
    if parentArena != null
      this.arena = new SyntaxArena(parentArena)
    end
  end

  def addSourceBoundary(start: Int): Void
    this.sourceBoundaries.add(start)
  end

  def currentIndex(): Int
    if this.position >= this.tokens.count()
      return this.tokens.count() - 1
    end
    return this.position
  end

  def peekIndex(offset: Int): Int
    let index = this.position + offset

    if index >= this.tokens.count()
      return this.tokens.count() - 1
    end
    return index
  end

  def currentKind(): readonly TokenKind
    if this.atSourceBoundary(this.currentIndex())
      return this.tokens.kinds.getEndOfFile()
    end
    return this.tokens.kindAt(this.currentIndex())
  end

  def atContextualIdentifier(text: String): Bool
    return this.currentKind().isIdentifier() && this.tokens.textAt(this.currentIndex()) == text
  end

  def peekKind(offset: Int): readonly TokenKind
    if this.atSourceBoundary(this.peekIndex(offset))
      return this.tokens.kinds.getEndOfFile()
    end
    return this.tokens.kindAt(this.peekIndex(offset))
  end

  def atSourceBoundary(index: Int): Bool
    return this.sourceBoundaryIndex < this.sourceBoundaries.size && this.tokens.startAt(index) >= this.sourceBoundaries.get(this.sourceBoundaryIndex)
  end

  def advanceSourceBoundary(): Void
    let start = this.tokens.startAt(this.currentIndex())

    while this.sourceBoundaryIndex < this.sourceBoundaries.size && start >= this.sourceBoundaries.get(this.sourceBoundaryIndex)
      this.sourceBoundaryIndex = this.sourceBoundaryIndex + 1
    end
  end

  def diagnosticStart(index: Int): Int
    if this.atSourceBoundary(index)
      return this.sourceBoundaries.get(this.sourceBoundaryIndex) - 1
    end
    return this.tokens.startAt(index)
  end

  def next(): Int
    let index = this.currentIndex()

    if !this.atSourceBoundary(index) && !this.tokens.kindAt(index).isEndOfFile()
      this.position = this.position + 1
    end
    return index
  end

  def accept(kind: readonly TokenKind): Bool
    if this.currentKind().same(kind)
      this.next()
      return true
    end
    return false
  end

  def expect(kind: readonly TokenKind): Int
    if this.currentKind().same(kind)
      let matched = this.next()

      this.lastTokenStart = this.tokens.startAt(matched)
      this.lastTokenLength = this.tokens.lengthAt(matched)
      this.lastTokenText = this.tokens.textAt(matched)
      return matched
    end
    let index = this.currentIndex()
    let actual = this.currentKind()
    let message = "Unexpected token <" + actual.name() + ">, expected <" + kind.name() + ">."

    this.diagnostics.add("NR001", this.diagnosticStart(index), this.atSourceBoundary(index) ? 1 : this.tokens.lengthAt(index), message)
    this.lastTokenStart = this.diagnosticStart(index)
    this.lastTokenText = "<expected " + kind.name() + ">"
    this.lastTokenLength = host::stringByteLength(this.lastTokenText)
    return index
  end

  def skipNewLines(): Void
    while this.currentKind().isNewLine()
      this.next()
    end
  end

  def skipToEndOfLine(): Void
    while !this.currentKind().isNewLine() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      this.next()
    end
    this.skipNewLines()
  end

  def requireNewLine(): Void
    if this.currentKind().isNewLine()
      this.skipNewLines()
      return
    end
    let index = this.currentIndex()
    let message = "Unexpected token <" + this.currentKind().name() + ">, expected <NewLine>."

    this.diagnostics.add("NR001", this.diagnosticStart(index), this.atSourceBoundary(index) ? 1 : this.tokens.lengthAt(index), message)
    this.skipToEndOfLine()
  end

  def addNode(kind: readonly SyntaxKind, data: String, children: Int[]): Int
    return this.arena.add(kind, data, children)
  end

  def leaf(kind: readonly SyntaxKind, data: String): Int
    let children: Int[] = []

    return this.addNode(kind, data, children)
  end

  def anchorToken(node: Int, token: Int): Int
    this.arena.setAnchor(node, this.tokens.startAt(token), this.tokens.lengthAt(token))
    return node
  end

  def anchorNode(node: Int, source: Int): Int
    this.arena.setAnchor(node, this.arena.startAt(source), this.arena.lengthAt(source))
    return node
  end

  def literalNode(kind: readonly SyntaxKind, token: Int): Int
    let node = this.anchorToken(this.leaf(kind, this.tokens.textAt(token)), token)

    this.arena.setValue(node, this.tokens.valueAt(token))
    return node
  end

  def parseQualifiedName(): Int
    return this.parseQualifiedIdentifier(this.arena.kinds.getQualifiedName())
  end

  def parseQualifiedIdentifier(kind: readonly SyntaxKind): Int
    let start = this.currentIndex()

    this.expect(this.tokens.kinds.getIdentifier())
    var text = this.lastTokenText
    var qualifiers: Int[] = []

    while this.currentKind().isDoubleColon()
      qualifiers = host::appendInt(qualifiers, this.anchorToken(this.leaf(this.arena.kinds.getQualifiedName(), text), this.currentIndex() - 1))
      this.next()
      this.expect(this.tokens.kinds.getIdentifier())
      text = text + "." + this.lastTokenText
    end
    let result = this.anchorToken(this.addNode(kind, text, qualifiers), this.currentIndex() - 1)

    this.arena.setSecondaryAnchor(result, this.tokens.startAt(start), this.tokens.lengthAt(start))
    return result
  end

  def parseTypeParameters(): TypeParameterList
    let parameters = new TypeParameterList()

    if !this.accept(this.tokens.kinds.getLess())
      return parameters
    end
    while true
      this.skipNewLines()
      let name = this.expect(this.tokens.kinds.getIdentifier())

      parameters.names = host::appendString(parameters.names, this.tokens.textAt(name))
      var constraint = -1

      if this.accept(this.tokens.kinds.getColon())
        constraint = this.parseTypeName()
      end
      parameters.constraints = host::appendInt(parameters.constraints, constraint)
      this.skipNewLines()
      if !this.accept(this.tokens.kinds.getComma())
        break
      end
    end
    this.expect(this.tokens.kinds.getGreater())
    return parameters
  end

  def parseTypeArguments(): Int[]
    this.expect(this.tokens.kinds.getLess())
    var arguments: Int[] = []

    while true
      this.skipNewLines()
      arguments = host::appendInt(arguments, this.parseTypeName())
      this.skipNewLines()
      if !this.accept(this.tokens.kinds.getComma())
        break
      end
    end
    this.expect(this.tokens.kinds.getGreater())
    return arguments
  end

  def genericSuffix(): Bool
    let previous = this.position - 1

    if !this.currentKind().isLess() || previous < 0 || this.tokens.startAt(this.currentIndex()) != this.tokens.startAt(previous) + this.tokens.lengthAt(previous)
      return false
    end
    var offset = 0
    var depth = 0

    while offset < 256
      let kind = this.tokens.kindAt(this.peekIndex(offset))

      if kind.isEndOfFile()
        return false
      end
      if kind.isLess()
        depth = depth + 1
      else if kind.isGreater()
        depth = depth - 1
        if depth == 0
          let next = this.tokens.kindAt(this.peekIndex(offset + 1))

          return next.isLParen() || next.isRParen() || next.isRBracket() || next.isComma() || next.isNewLine() || next.isIf() || next.isEndOfFile() || next.isDot()
        end
      end
      offset = offset + 1
    end
    return false
  end

  def parseTypeName(allowFixedArray: Bool = true): Int
    if this.typeDepth >= 64
      let token = this.currentIndex()

      this.diagnostics.add("NR222", this.tokens.startAt(token), this.tokens.lengthAt(token), "Type nesting limit exceeded (64 levels).")
      this.skipToEndOfLine()
      return this.leaf(this.arena.kinds.getType(), "<error>")
    end
    this.typeDepth = this.typeDepth + 1
    let result = this.parseTypeCore(allowFixedArray)

    this.typeDepth = this.typeDepth - 1
    return result
  end

  def parseTypeCore(allowFixedArray: Bool): Int
    if this.currentKind().isIdentifier() && this.tokens.textAt(this.currentIndex()) == "readonly"
      let keyword = this.next()
      let inner = this.parseTypeName(allowFixedArray)

      return this.anchorToken(this.addNode(this.arena.kinds.getType(), "#readonly", [inner]), keyword)
    end
    if this.currentKind().isIdentifier() && this.tokens.textAt(this.currentIndex()) == "fields" && this.peekKind(1).isIdentifier() && this.tokens.textAt(this.peekIndex(1)) == "of"
      let keyword = this.next()

      this.next()
      let inner = this.parseTypeName(allowFixedArray)

      return this.anchorToken(this.addNode(this.arena.kinds.getType(), "#fields", [inner]), keyword)
    end
    var qualifier = ""

    if this.currentKind().isIdentifier() && (this.tokens.textAt(this.currentIndex()) == "shared" || this.tokens.textAt(this.currentIndex()) == "parallel" || this.tokens.textAt(this.currentIndex()) == "quote" || this.tokens.textAt(this.currentIndex()) == "cabi") && this.peekKind(1).isFn()
      qualifier = this.tokens.textAt(this.currentIndex()) + " "
      this.next()
    end
    if this.currentKind().isFn()
      let keyword = this.next()

      this.expect(this.tokens.kinds.getLParen())
      var types: Int[] = []

      this.skipNewLines()
      while !this.currentKind().isRParen() && !this.currentKind().isEndOfFile()
        types = host::appendInt(types, this.parseTypeName())
        if !this.accept(this.tokens.kinds.getComma())
          break
        end
        this.skipNewLines()
      end
      this.skipNewLines()
      this.expect(this.tokens.kinds.getRParen())
      this.expect(this.tokens.kinds.getColon())
      types = host::appendInt(types, this.parseTypeName())
      return this.anchorToken(this.addNode(this.arena.kinds.getType(), qualifier + "fn", types), keyword)
    end
    var name = -1
    var grouped = false

    if this.accept(this.tokens.kinds.getLParen())
      grouped = true
      name = this.parseTypeName()
      this.expect(this.tokens.kinds.getRParen())
    else
      name = this.parseQualifiedName()
    end
    var typeArguments: Int[] = []

    if !grouped && this.currentKind().isLess()
      typeArguments = this.parseTypeArguments()
    end
    var previousStart = this.lastTokenStart
    var previousLength = this.lastTokenLength
    var pointerStart = -1
    var pointerLength = 0
    var suffixes = ""

    while true
      if this.currentKind().isLBracket() && this.peekKind(1).isRBracket()
        this.next()
        let rightBracket = this.next()

        suffixes = suffixes + "[]"
        previousStart = this.tokens.startAt(rightBracket)
        previousLength = this.tokens.lengthAt(rightBracket)
      else if allowFixedArray && this.currentKind().isLBracket() && this.peekKind(1).isIntLiteral()
        this.next()
        let count = this.next()
        let rightBracket = this.expect(this.tokens.kinds.getRBracket())

        suffixes = suffixes + "[" + this.tokens.textAt(count) + "]"
        previousStart = this.tokens.startAt(rightBracket)
        previousLength = this.tokens.lengthAt(rightBracket)
      else if this.currentKind().isQuestion()
        let question = this.next()

        suffixes = suffixes + "?"
        previousStart = this.tokens.startAt(question)
        previousLength = this.tokens.lengthAt(question)
      else
        let adjacent = this.tokens.startAt(this.currentIndex()) == previousStart + previousLength

        if this.currentKind().isStar() && adjacent
          let star = this.next()

          suffixes = suffixes + "*"
          previousStart = this.tokens.startAt(star)
          previousLength = this.tokens.lengthAt(star)
          if pointerStart < 0
            pointerStart = previousStart
            pointerLength = previousLength
          end
        else
          break
        end
      end
    end
    let children = appendChild(emptyInts(), name)
    let typeNode = this.anchorNode(this.addNode(this.arena.kinds.getType(), (grouped ? "#group" : this.arena.dataAt(name)) + suffixes, children), name)

    this.arena.nodeAt(typeNode).typeArguments = typeArguments
    if pointerStart >= 0
      this.arena.setSecondaryAnchor(typeNode, pointerStart, pointerLength)
    else if suffixes != ""
      this.arena.setSecondaryAnchor(typeNode, previousStart, previousLength)
    end
    return typeNode
  end

  def parseProgram(): Int
    var records: Int[] = []
    var uses: Int[] = []
    var classes: Int[] = []
    var functions: Int[] = []
    var contracts: Int[] = []
    var namespaces: Int[] = []
    var currentNamespace = ""

    this.skipNewLines()
    while true
      if this.atSourceBoundary(this.currentIndex())
        this.advanceSourceBoundary()
        currentNamespace = ""
        this.skipNewLines()
        continue
      end
      if this.currentKind().isEndOfFile()
        break
      end
      let before = this.position

      if this.currentKind().isUse()
        uses = host::appendInt(uses, this.parseUse())
        this.skipNewLines()
      else if this.currentKind().isNamespace()
        let namespaceNode = this.parseNamespace()

        namespaces = host::appendInt(namespaces, namespaceNode)
        currentNamespace = this.arena.dataAt(namespaceNode)
        this.skipNewLines()
      else if this.currentKind().isAt() || this.declarationKind().isDef() || this.declarationKind().isClass() || this.declarationKind().isEnum()
        let annotations = this.parseFunctionAnnotations()

        if this.declarationKind().isClass()
          classes = host::appendInt(classes, this.parseClass(currentNamespace, annotations))
        else if this.declarationKind().isEnum()
          classes = host::appendInt(classes, this.parseEnum(currentNamespace, annotations))
        else
          functions = host::appendInt(functions, this.parseFunction(currentNamespace, annotations))
        end
        this.skipNewLines()
      else if this.currentKind().isStruct() || this.currentKind().isUnion()
        records = host::appendInt(records, parseNativeRecord(this, currentNamespace))
        this.skipNewLines()
      else if this.atContextualIdentifier("contract")
        contracts = host::appendInt(contracts, this.parseContract(currentNamespace))
        this.skipNewLines()
      else
        let unexpected = this.next()

        this.diagnostics.add("NR002", this.tokens.startAt(unexpected), this.tokens.lengthAt(unexpected), "Unexpected token '" + this.tokens.textAt(unexpected) + "' at module scope; expected a declaration.")
        this.skipNewLines()
      end
      if this.position == before
        this.next()
      end
    end

    var children: Int[] = []

    for item in uses
      children = host::appendInt(children, item)
    end
    for item in classes
      children = host::appendInt(children, item)
    end
    for item in functions
      children = host::appendInt(children, item)
    end
    for item in records
      children = host::appendInt(children, item)
    end
    for item in contracts
      children = host::appendInt(children, item)
    end
    for item in namespaces
      children = host::appendInt(children, item)
    end
    let data = (uses.Length as String) + "|" + (classes.Length as String) + "|" + (functions.Length as String) + "|" + (records.Length as String) + "|" + (contracts.Length as String) + "|" + (namespaces.Length as String)

    return this.addNode(this.arena.kinds.getProgram(), data, children)
  end

  def parseSubmission(): SubmissionSyntax
    let result = new SubmissionSyntax()
    var records: Int[] = []
    var uses: Int[] = []
    var classes: Int[] = []
    var functions: Int[] = []
    var contracts: Int[] = []
    var namespaces: Int[] = []
    var statements: Int[] = []
    var currentNamespace = ""

    this.skipNewLines()
    while !this.currentKind().isEndOfFile()
      let before = this.position
      let start = this.tokens.startAt(this.currentIndex())
      var declaration = false

      if this.currentKind().isUse()
        uses = host::appendInt(uses, this.parseUse())
        declaration = true
      else if this.currentKind().isNamespace()
        let namespaceNode = this.parseNamespace()

        namespaces = host::appendInt(namespaces, namespaceNode)
        currentNamespace = this.arena.dataAt(namespaceNode)
        declaration = true
      else if this.currentKind().isAt() || this.declarationKind().isDef() || this.declarationKind().isClass() || this.declarationKind().isEnum()
        let annotations = this.parseFunctionAnnotations()

        if this.declarationKind().isClass()
          classes = host::appendInt(classes, this.parseClass(currentNamespace, annotations))
        else if this.declarationKind().isEnum()
          classes = host::appendInt(classes, this.parseEnum(currentNamespace, annotations))
        else
          functions = host::appendInt(functions, this.parseFunction(currentNamespace, annotations))
        end
        declaration = true
      else if this.currentKind().isStruct() || this.currentKind().isUnion()
        records = host::appendInt(records, parseNativeRecord(this, currentNamespace))
        declaration = true
      else if this.atContextualIdentifier("contract")
        contracts = host::appendInt(contracts, this.parseContract(currentNamespace))
        declaration = true
      else
        let statement = this.parseStatementOrRecover(true)

        statements = appendChild(statements, statement)
      end
      this.skipNewLines()
      let finish = this.tokens.startAt(this.currentIndex())

      if declaration
        result.declarationStarts.add(start)
        result.declarationLengths.add(finish - start)
      else
        result.statementStarts.add(start)
        result.statementLengths.add(finish - start)
      end
      if this.position == before
        this.next()
      end
    end
    var returnChildren: Int[] = []
    let returnType = this.addNode(this.arena.kinds.getType(), "Void", emptyInts())

    returnChildren = host::appendInt(returnChildren, returnType)
    for statement in statements
      returnChildren = host::appendInt(returnChildren, statement)
      this.rejectSessionReturn(statement)
    end
    result.entry = this.arena.addDeclaration(SyntaxDeclaration.callable(this.arena, "", "__neri_session_entry", 0, 0, statements.Length, false, false), returnChildren)
    functions = host::appendInt(functions, result.entry)
    var children: Int[] = []

    for item in uses children = host::appendInt(children, item) end
    for item in classes children = host::appendInt(children, item) end
    for item in functions children = host::appendInt(children, item) end
    for item in records children = host::appendInt(children, item) end
    for item in contracts children = host::appendInt(children, item) end
    for item in namespaces children = host::appendInt(children, item) end
    result.root = this.addNode(this.arena.kinds.getProgram(), (uses.Length as String) + "|" + (classes.Length as String) + "|" + (functions.Length as String) + "|" + (records.Length as String) + "|" + (contracts.Length as String) + "|" + (namespaces.Length as String), children)
    result.declarationCount = classes.Length + functions.Length + records.Length + contracts.Length - 1
    result.statementCount = statements.Length
    result.status = this.submissionStatus()
    return result
  end

  def rejectSessionReturn(node: Int): Void
    if node < 0 || this.arena.kindAt(node).isClosure()
      return
    end
    if this.arena.kindAt(node).isReturn()
      this.diagnostics.add("NR_SESSION_RETURN", this.arena.startAt(node), this.arena.lengthAt(node), "A session submission cannot return from its generated entry.")
      return
    end
    var index = 0

    while index < this.arena.childCountAt(node)
      this.rejectSessionReturn(this.arena.childAt(node, index))
      index = index + 1
    end
  end

  def submissionStatus(): SubmissionStatus
    if this.diagnostics.count() == 0
      return SubmissionStatus.complete()
    end
    let eof = this.tokens.startAt(this.tokens.count() - 1)
    var incomplete = true
    var index = 0

    while index < this.diagnostics.count()
      if this.diagnostics.starts.get(index) < eof
        incomplete = false
      end
      index = index + 1
    end
    return incomplete ? SubmissionStatus.incomplete() : SubmissionStatus.invalid()
  end

  def parseUse(): Int
    let start = this.tokens.startAt(this.currentIndex())

    this.expect(this.tokens.kinds.getUse())
    var alias = ""
    var aliasNode = -1

    if this.currentKind().isIdentifier() && this.peekKind(1).isEqual()
      let token = this.next()

      alias = this.tokens.textAt(token)
      aliasNode = this.anchorToken(this.leaf(this.arena.kinds.getName(), alias), token)
      this.next()
    end
    let name = this.parseQualifiedName()
    let children = appendChild(appendChild(emptyInts(), name), aliasNode)
    let node = this.arena.addUse(new SyntaxUse(this.arena.dataAt(name), alias), children)

    this.arena.setAnchor(node, start, this.arena.startAt(name) + this.arena.lengthAt(name) - start)
    return node
  end

  def parseNamespace(): Int
    let start = this.tokens.startAt(this.currentIndex())

    this.expect(this.tokens.kinds.getNamespace())
    let name = this.parseQualifiedName()
    let node = this.addNode(this.arena.kinds.getNamespace(), this.arena.dataAt(name), appendChild(emptyInts(), name))

    this.requireNewLine()
    this.arena.setAnchor(node, start, this.arena.startAt(name) + this.arena.lengthAt(name) - start)
    return node
  end

  def parseFunctionAnnotations(): Int[]
    var annotations: Int[] = []

    while this.currentKind().isAt()
      this.next()
      let name = this.expect(this.tokens.kinds.getIdentifier())
      var arguments: Int[] = []

      if syntaxModifierRank(this.arena.modifiers.recognizeSource(this.tokens.textAt(name))) > 0
        this.diagnostics.add("NR001", this.tokens.startAt(name), this.tokens.lengthAt(name), "Use '" + this.tokens.textAt(name) + "' as a modifier before the declaration, without '@'.")
      end
      if this.currentKind().isLParen()
        this.next()
        if !this.currentKind().isRParen()
          while true
            let argument = this.expect(this.tokens.kinds.getStringLiteral())

            arguments = host::appendInt(arguments, this.leaf(this.arena.kinds.getStringLiteral(), this.tokens.textAt(argument)))
            if this.accept(this.tokens.kinds.getComma())
              this.skipNewLines()
            else
              break
            end
          end
        end
        this.expect(this.tokens.kinds.getRParen())
      end
      let annotation = this.anchorToken(this.addNode(this.arena.kinds.getFunctionAnnotation(), this.tokens.textAt(name), arguments), name)

      this.arena.nodeAt(annotation).annotationKind = this.arena.annotations.recognizeSource(this.tokens.textAt(name))
      annotations = host::appendInt(annotations, annotation)
      this.requireNewLine()
    end
    return annotations
  end

  def declarationKind(): readonly TokenKind
    var offset = 0
    var resourcePrefix = false

    while !this.peekKind(offset).isEndOfFile() && syntaxModifierRank(this.arena.modifiers.recognizeSource(this.tokens.textAt(this.peekIndex(offset)))) > 0
      resourcePrefix = true if this.peekKind(offset).isResource()
      offset = offset + 1
    end
    let kind = this.peekKind(offset)

    if resourcePrefix && (kind.isEndOfFile() || kind.isNewLine())
      return this.tokens.kinds.getClass()
    end
    return kind.isDef() || kind.isClass() || kind.isEnum() ? kind : this.tokens.kinds.getInvalid()
  end

  def parseDeclarationModifiers(): Int[]
    var result: Int[] = []
    var previousRank = 0
    var accessSeen = false

    while syntaxModifierRank(this.arena.modifiers.recognizeSource(this.tokens.textAt(this.currentIndex()))) > 0 && !this.currentKind().isEndOfFile()
      let token = this.next()
      let name = this.tokens.textAt(token)
      let kind = this.arena.modifiers.recognizeSource(name)
      let rank = syntaxModifierRank(kind)

      if syntaxModifierIn(this.arena, result, kind) >= 0 || (rank == 1 && accessSeen)
        this.diagnostics.add("NR001", this.tokens.startAt(token), this.tokens.lengthAt(token), "Declaration modifiers must be unique, with at most one access modifier.")
      else if rank < previousRank
        this.diagnostics.add("NR001", this.tokens.startAt(token), this.tokens.lengthAt(token), "Modifier '" + name + "' is out of order; use access, abstract/sealed, override, static, readonly, unsafe, resource before the declaration.")
      end
      result = host::appendInt(result, this.anchorToken(this.arena.addModifier(kind), token))
      previousRank = rank
      accessSeen = true if rank == 1
    end
    return result
  end

  def parseFunction(namespaceName: String, annotations: Int[], modifiers: Int[] = []): Int
    let block = this.beginBlock()
    let prefix = modifiers.Length > 0 ? modifiers : this.parseDeclarationModifiers()
    let isStatic = syntaxModifierIn(this.arena, prefix, this.arena.modifiers.getStatic()) >= 0
    let isUnsafe = syntaxModifierIn(this.arena, prefix, this.arena.modifiers.getUnsafe()) >= 0
    let isAbstract = syntaxModifierIn(this.arena, prefix, this.arena.modifiers.getAbstract()) >= 0

    this.expect(this.tokens.kinds.getDef())
    if this.currentKind().isStatic() || this.currentKind().isUnsafe()
      let misplaced = this.currentIndex()

      this.diagnostics.add("NR001", this.tokens.startAt(misplaced), this.tokens.lengthAt(misplaced), "Declaration modifiers precede 'def'.")
      this.parseDeclarationModifiers()
    end
    let name = this.expect(this.tokens.kinds.getIdentifier())
    let typeParameters = this.parseTypeParameters()

    this.expect(this.tokens.kinds.getLParen())
    let parameters = this.parseParameters()

    this.skipNewLines()
    this.expect(this.tokens.kinds.getRParen())
    this.expect(this.tokens.kinds.getColon())
    let returnType = this.parseTypeName()

    if !isAbstract
      this.openBlock(block)
    end
    this.requireNewLine()

    var body: Int[] = []

    if !isAbstract
      while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
        let statement = this.parseStatementOrRecover(this.sessionExpressions && this.tokens.textAt(name) == "__neri_session_entry")

        body = appendChild(body, statement)
      end
      this.closeBlock(block)
      this.expect(this.tokens.kinds.getEnd())
    end

    var children: Int[] = []

    for annotation in annotations
      children = host::appendInt(children, annotation)
    end
    for parameter in parameters
      children = host::appendInt(children, parameter)
    end
    children = host::appendInt(children, returnType)
    for statement in body
      children = host::appendInt(children, statement)
    end
    let result = this.anchorToken(this.arena.addDeclaration(SyntaxDeclaration.callable(this.arena, namespaceName, this.tokens.textAt(name), annotations.Length, parameters.Length, body.Length, isStatic, isUnsafe), children), name)

    this.arena.nodeAt(result).typeParameters = typeParameters.names
    this.arena.nodeAt(result).typeParameterConstraints = typeParameters.constraints
    this.arena.nodeAt(result).modifiers = prefix
    return result
  end

  def parseParameters(allowDefaults: Bool = true): Int[]
    var parameters: Int[] = []

    if this.currentKind().isRParen()
      return parameters
    end
    while true
      this.skipNewLines()
      var parameterMode = this.arena.parameterModes.getOrdinary()

      if this.currentKind().isIdentifier() && this.tokens.textAt(this.currentIndex()) == "labels" && this.peekKind(1).isIdentifier() && this.peekKind(2).isColon()
        let labels = this.next()

        parameterMode = this.arena.parameterModes.getLabels()
        if !allowDefaults
          this.diagnostics.add("NR001", this.tokens.startAt(labels), this.tokens.lengthAt(labels), "Alternative payloads cannot use labels parameters.")
        end
      end
      let name = this.expect(this.tokens.kinds.getIdentifier())

      this.expect(this.tokens.kinds.getColon())
      let typeNode = this.parseTypeName()
      var defaultValue = -1

      if this.accept(this.tokens.kinds.getEqual())
        if !allowDefaults
          let equal = this.currentIndex() - 1

          this.diagnostics.add("NR001", this.tokens.startAt(equal), this.tokens.lengthAt(equal), "Alternative payloads cannot have default values.")
          this.parseExpression(0)
        else
          defaultValue = this.parseExpression(0)
        end
      end
      var children = appendChild(emptyInts(), typeNode)

      children = appendChild(children, defaultValue)
      let parameter = this.anchorToken(this.addNode(this.arena.kinds.getParameter(), this.tokens.textAt(name), children), name)

      this.arena.nodeAt(parameter).parameterMode = parameterMode
      parameters = host::appendInt(parameters, parameter)
      if this.accept(this.tokens.kinds.getComma())
        this.skipNewLines()
      else
        break
      end
    end
    return parameters
  end

  def parseOptionalAccess(defaultAccess: readonly SourceAccess): readonly SourceAccess
    if isAccessModifier(this.currentKind())
      let token = this.next()

      let kind = this.tokens.kindAt(token)

      if kind.isPublic()
        return this.arena.accesses.getPublic()
      else if kind.isProtected()
        return this.arena.accesses.getProtected()
      else if kind.isInternal()
        return this.arena.accesses.getInternal()
      end
      return this.arena.accesses.getPrivate()
    end
    return defaultAccess
  end

  def parseClass(namespaceName: String, annotations: Int[] = []): Int
    let block = this.beginBlock()
    let modifiers = this.parseDeclarationModifiers()
    let access = syntaxModifierAccess(this.arena, modifiers, this.arena.accesses.getInternal())
    let isResource = syntaxModifierIn(this.arena, modifiers, this.arena.modifiers.getResource()) >= 0

    this.expect(this.tokens.kinds.getClass())
    let name = this.expect(this.tokens.kinds.getIdentifier())
    let typeParameters = this.parseTypeParameters()
    var baseType = -1

    if this.accept(this.tokens.kinds.getColon())
      baseType = this.parseTypeName()
    end
    this.openBlock(block)
    this.requireNewLine()
    var members: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      this.skipNewLines()
      if this.currentKind().isEnd() || this.currentKind().isEndOfFile()
        break
      end
      if this.currentKind().isAt() || this.declarationKind().isDef()
        members = host::appendInt(members, this.parseMethod())
      else
        members = host::appendInt(members, this.parseField())
      end
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), baseType)

    for member in members
      children = host::appendInt(children, member)
    end
    let result = this.anchorToken(this.arena.addDeclaration(SyntaxDeclaration.typeDeclaration(this.arena, namespaceName, this.tokens.textAt(name), access, false, isResource), children), name)

    this.arena.nodeAt(result).typeParameters = typeParameters.names
    this.arena.nodeAt(result).typeParameterConstraints = typeParameters.constraints
    this.arena.nodeAt(result).classAnnotations = annotations
    this.arena.nodeAt(result).modifiers = modifiers
    if block != null
      block.kind = this.tokens.kinds.getClass()
      block.syntaxNode = result
    end
    return result
  end

  # Alternatives use the class declaration family with explicit typed metadata.
  def parseEnum(namespaceName: String, annotations: Int[] = []): Int
    let block = this.beginBlock()
    let modifiers = this.parseDeclarationModifiers()
    let access = syntaxModifierAccess(this.arena, modifiers, this.arena.accesses.getInternal())

    this.expect(this.tokens.kinds.getEnum())
    let name = this.expect(this.tokens.kinds.getIdentifier())
    let typeParameters = this.parseTypeParameters()

    this.openBlock(block)
    this.requireNewLine()
    var cases: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      this.skipNewLines()
      if this.currentKind().isEnd() || this.currentKind().isEndOfFile()
        break
      end
      let keyword = this.expect(this.tokens.kinds.getCase())
      let caseName = this.expect(this.tokens.kinds.getIdentifier())

      this.expect(this.tokens.kinds.getLParen())
      let parameters = this.parseParameters(false)

      this.expect(this.tokens.kinds.getRParen())
      this.requireNewLine()
      cases = host::appendInt(cases, this.anchorToken(this.addNode(this.arena.kinds.getAlternativeCase(), this.tokens.textAt(caseName), parameters), caseName))
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    let result = this.anchorToken(this.arena.addDeclaration(SyntaxDeclaration.typeDeclaration(this.arena, namespaceName, this.tokens.textAt(name), access, true, false), cases), name)

    this.arena.nodeAt(result).typeParameterConstraints = typeParameters.constraints
    this.arena.nodeAt(result).typeParameters = typeParameters.names
    this.arena.nodeAt(result).classAnnotations = annotations
    this.arena.nodeAt(result).modifiers = modifiers
    if block != null
      block.kind = this.tokens.kinds.getClass()
      block.syntaxNode = result
    end
    return result
  end

  def parseMethod(): Int
    let annotations = this.parseFunctionAnnotations()
    let modifiers = this.parseDeclarationModifiers()
    let access = syntaxModifierAccess(this.arena, modifiers, this.arena.accesses.getPublic())
    let function = this.parseFunction("", emptyInts(), modifiers)
    var children: Int[] = []

    for annotation in annotations
      children = host::appendInt(children, annotation)
    end
    children = host::appendInt(children, function)
    return this.anchorNode(this.arena.addDeclaration(SyntaxDeclaration.method(this.arena, access, annotations.Length), children), function)
  end

  def parseContract(namespaceName: String): Int
    let block = this.beginBlock()

    this.next()
    let name = this.expect(this.tokens.kinds.getIdentifier())

    this.openBlock(block)
    this.requireNewLine()
    var methods: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      this.skipNewLines()
      if this.currentKind().isEnd() || this.currentKind().isEndOfFile()
        break
      end
      if this.currentKind().isAt() || this.declarationKind().isDef()
        methods = host::appendInt(methods, this.parseMethod())
      else
        let unexpected = this.next()

        this.diagnostics.add("NR002", this.tokens.startAt(unexpected), this.tokens.lengthAt(unexpected), "Unexpected token '" + this.tokens.textAt(unexpected) + "' in contract; expected a method declaration.")
        while !this.currentKind().isNewLine() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
          this.next()
        end
      end
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    return this.anchorToken(this.arena.addDeclaration(SyntaxDeclaration.contract(this.arena, namespaceName, this.tokens.textAt(name)), methods), name)
  end

  def parseField(): Int
    let access = this.parseOptionalAccess(this.arena.accesses.getPrivate())
    let name = this.expect(this.tokens.kinds.getIdentifier())

    this.expect(this.tokens.kinds.getColon())
    let typeNode = this.parseTypeName()
    var initializer = -1

    if this.accept(this.tokens.kinds.getEqual())
      initializer = this.parseExpression(0)
    end
    this.requireNewLine()
    var children = appendChild(emptyInts(), typeNode)

    children = appendChild(children, initializer)
    return this.anchorToken(this.arena.addDeclaration(SyntaxDeclaration.field(this.arena, access, this.tokens.textAt(name)), children), name)
  end

  def parseStatementOrRecover(allowExpression: Bool = false): Int
    if this.currentKind().isNewLine()
      this.next()
      return -1
    end
    let statementStart = this.currentIndex()
    let kind = this.currentKind()
    var statement = -1

    if kind.isLet()
      statement = this.parseVariable(this.arena.kinds.getLet())
    else if kind.isVar()
      statement = this.parseVariable(this.arena.kinds.getVar())
    else if kind.isReturn()
      statement = this.parseReturn()
    else if kind.isIf()
      statement = this.parseIf()
    else if kind.isWhile()
      statement = this.parseWhile()
    else if kind.isFor()
      statement = this.parseFor()
    else if kind.isMatch()
      statement = this.parseMatch()
    else if kind.isBreak()
      let keyword = this.next()

      statement = this.anchorToken(this.leaf(this.arena.kinds.getBreak(), ""), keyword)
    else if kind.isContinue()
      let keyword = this.next()

      statement = this.anchorToken(this.leaf(this.arena.kinds.getContinue(), ""), keyword)
    else if kind.isUnsafe()
      statement = this.parseUnsafeBlock()
    else if kind.isBorrow()
      statement = this.parseBorrowBlock()
    else if kind.isUsing()
      statement = this.parseUsingBlock()
    else if kind.isNative()
      let expression = this.parseNativeIntrinsic()

      statement = this.anchorNode(this.addNode(this.arena.kinds.getExpressionStatement(), "", appendChild(emptyInts(), expression)), expression)
    else
      statement = this.parseNamedStatementOrRecover(allowExpression)
    end
    if this.currentKind().isIf() && statement >= 0
      let keyword = this.next()
      let actionKind = this.arena.kindAt(statement)
      var allowed = actionKind.isAssignment() || actionKind.isExpressionStatement() || actionKind.isReturn() || actionKind.isBreak() || actionKind.isContinue()
      var token = statementStart

      while token < keyword
        if this.tokens.kindAt(token).isNewLine()
          allowed = false
        end
        token = token + 1
      end
      if !allowed
        this.diagnostics.add("NR007", this.tokens.startAt(keyword), this.tokens.lengthAt(keyword), "Postfix if requires a single-line assignment, call, return, break, or continue.")
      end
      let condition = this.parseExpression(0)

      if !this.currentKind().isNewLine() && !this.currentKind().isEndOfFile()
        let unexpected = this.currentIndex()

        this.diagnostics.add("NR007", this.tokens.startAt(unexpected), this.tokens.lengthAt(unexpected), "Postfix if ends at the newline; else, end, and chained modifiers are not allowed.")
        this.skipToEndOfLine()
      end
      statement = this.anchorToken(this.addNode(this.arena.kinds.getIf(), "1|0", [condition, statement]), keyword)
    end
    if statement >= 0
      this.arena.setStatementStart(statement, this.tokens.startAt(statementStart))
    end
    this.skipNewLines()
    return statement
  end

  def parseMatch(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getMatch())
    let value = this.parseExpression(0)

    this.openBlock(block)
    this.requireNewLine()
    var cases: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      this.skipNewLines()
      if this.currentKind().isEnd() || this.currentKind().isEndOfFile()
        break
      end
      let arm = this.beginBlock()
      let caseKeyword = this.expect(this.tokens.kinds.getCase())
      let name = this.parseQualifiedName()

      if this.accept(this.tokens.kinds.getDot())
        let member = this.expect(this.tokens.kinds.getIdentifier())

        this.arena.nodeAt(name).data = this.arena.dataAt(name) + "." + this.tokens.textAt(member)
        this.arena.setAnchor(name, this.tokens.startAt(member), this.tokens.lengthAt(member))
      else if bootstrapFindText(this.arena.dataAt(name), ".") >= 0
        this.diagnostics.add("NR009", this.arena.startAt(name), this.arena.lengthAt(name), "Use '.' between an alternative type and its case.")
      end

      this.expect(this.tokens.kinds.getLParen())
      var bindings: Int[] = []

      if !this.currentKind().isRParen()
        while true
          let binding = this.expect(this.tokens.kinds.getIdentifier())

          bindings = host::appendInt(bindings, this.anchorToken(this.leaf(this.arena.kinds.getAlternativeBinding(), this.tokens.textAt(binding)), binding))
          if !this.accept(this.tokens.kinds.getComma())
            break
          end
        end
      end
      this.expect(this.tokens.kinds.getRParen())
      this.openBlock(arm)
      if arm != null
        arm.ownsEnd = false
      end
      this.requireNewLine()
      var body: Int[] = []

      while !this.currentKind().isCase() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
        body = appendChild(body, this.parseStatementOrRecover())
      end
      this.closeBlock(arm)
      var children = appendChild(emptyInts(), name)

      for binding in bindings
        children = host::appendInt(children, binding)
      end
      for statement in body
        children = host::appendInt(children, statement)
      end
      cases = host::appendInt(cases, this.anchorToken(this.addNode(this.arena.kinds.getMatchCase(), (bindings.Length as String) + "|" + (body.Length as String), children), caseKeyword))
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), value)

    for item in cases
      children = host::appendInt(children, item)
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getMatch(), cases.Length as String, children), keyword)
  end

  def parseNamedStatementOrRecover(allowExpression: Bool = false): Int
    let startsNamed = this.currentKind().isIdentifier() && (this.peekKind(1).isEqual() || this.peekKind(1).isLParen() || this.peekKind(1).isDot() || this.peekKind(1).isDoubleColon() || this.peekKind(1).isLBracket())
    let startsThis = this.currentKind().isThis() && this.peekKind(1).isDot()
    let startsSuper = this.currentKind().isSuper() && (this.peekKind(1).isLParen() || this.peekKind(1).isDot())
    let startsPointer = this.currentKind().isStar()

    let kind = this.currentKind()
    let startsExpression = allowExpression && (kind.isIdentifier() || kind.isIntLiteral() || kind.isFloatLiteral() || kind.isStringLiteral() || kind.isTrue() || kind.isFalse() || kind.isNull() || kind.isThis() || kind.isLParen() || kind.isLBracket() || kind.isNew() || kind.isFn() || kind.unaryPrecedence() > 0)

    if startsNamed || startsThis || startsSuper || startsPointer || startsExpression
      let start = this.tokens.startAt(this.currentIndex())
      let expression = this.parseExpression(0)

      if this.accept(this.tokens.kinds.getEqual())
        let value = this.parseExpression(0)
        let expressionKind = this.arena.kindAt(expression)
        let operation = this.arena.nodeAt(expression).operatorKind
        let validTarget = expressionKind.isName() || expressionKind.isMember() || expressionKind.isIndex() || (expressionKind.isUnary() && operation != null && operation.isStar())

        if validTarget
          var children = appendChild(emptyInts(), expression)

          children = appendChild(children, value)
          return this.anchorNode(this.addNode(this.arena.kinds.getAssignment(), "", children), expression)
        end
        this.diagnostics.add("NR002", start, 1, "Unexpected token '" + expressionKind.name() + "' in statement.")
        return -1
      end
      if this.arena.kindAt(expression).isCall()
        let callee = this.arena.childAt(expression, 0)

        if this.arena.kindAt(callee).isSuper()
          return this.anchorNode(this.addNode(this.arena.kinds.getSuperConstructorCall(), "", appendCallArguments(emptyInts(), this.arena, expression)), callee)
        end
        return this.anchorNode(this.addNode(this.arena.kinds.getExpressionStatement(), "", appendChild(emptyInts(), expression)), expression)
      end
      if allowExpression
        return this.anchorNode(this.addNode(this.arena.kinds.getExpressionStatement(), "", appendChild(emptyInts(), expression)), expression)
      end
      this.diagnostics.add("NR003", start, 1, "Only function calls can be used as statements.")
      this.skipNewLines()
      return -1
    end

    let index = this.currentIndex()

    this.diagnostics.add("NR002", this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' in statement.")
    this.skipToEndOfLine()
    return -1
  end

  def parseVariable(kind: readonly SyntaxKind): Int
    let keyword = this.expect(kind.isLet() ? this.tokens.kinds.getLet() : this.tokens.kinds.getVar())
    let name = this.expect(this.tokens.kinds.getIdentifier())
    var typeNode = -1

    if this.accept(this.tokens.kinds.getColon())
      typeNode = this.parseTypeName()
    end
    this.expect(this.tokens.kinds.getEqual())
    let initializer = this.parseExpression(0)

    if !this.currentKind().isNewLine() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      let index = this.currentIndex()
      var code = "NR006"
      var statementName = "var"

      if kind.isLet()
        code = "NR005"
        statementName = "let"
      end
      this.diagnostics.add(code, this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' after " + statementName + " statement.")
      this.skipToEndOfLine()
    end
    var children = appendChild(emptyInts(), typeNode)

    children = appendChild(children, initializer)
    let node = this.anchorToken(this.addNode(kind, this.tokens.textAt(name), children), name)

    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseReturn(): Int
    let keyword = this.expect(this.tokens.kinds.getReturn())
    var expression = -1

    if !this.currentKind().isNewLine() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile() && !this.currentKind().isIf()
      expression = this.parseExpression(0)
    end
    if !this.currentKind().isNewLine() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile() && !this.currentKind().isIf()
      let index = this.currentIndex()

      this.diagnostics.add("NR004", this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' after return statement.")
      this.skipToEndOfLine()
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getReturn(), "", appendChild(emptyInts(), expression)), keyword)
  end

  def parseIf(sharedEnd: SyntaxBlock? = null): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getIf())
    let condition = this.parseExpression(0)

    if block != null
      block.sharedEnd = sharedEnd
    end
    this.openBlock(block)
    if !this.currentKind().isNewLine()
      let index = this.currentIndex()

      this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires a newline before its body.")
    end
    this.skipNewLines()
    var thenBody: Int[] = []

    while !this.currentKind().isElse() && !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      thenBody = appendChild(thenBody, this.parseStatementOrRecover())
    end
    var elseBody: Int[] = []
    var finalBlock = block

    if (this.currentKind().isElse() || this.currentKind().isEnd()) && this.currentIndex() > 0 && !this.tokens.kindAt(this.currentIndex() - 1).isNewLine()
      let index = this.currentIndex()

      this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires else and end on separate lines.")
    end
    if this.accept(this.tokens.kinds.getElse())
      if !this.currentKind().isIf() && !this.currentKind().isNewLine()
        let index = this.currentIndex()

        this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Else requires a newline before its body.")
      end
      let chained = this.currentKind().isIf()

      if !chained
        let branch = this.beginBlock(this.currentIndex() - 1)

        if branch != null
          branch.sharedEnd = block
        end
        this.openBlock(branch)
        finalBlock = branch
      end
      this.skipNewLines()
      if chained
        elseBody = host::appendInt(elseBody, this.parseIf(block))
        var nestedChildren = appendChild(emptyInts(), condition)

        for statement in thenBody
          nestedChildren = host::appendInt(nestedChildren, statement)
        end
        for statement in elseBody
          nestedChildren = host::appendInt(nestedChildren, statement)
        end
        return this.anchorToken(this.addNode(this.arena.kinds.getIf(), (thenBody.Length as String) + "|" + (elseBody.Length as String), nestedChildren), keyword)
      end
      while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
        elseBody = appendChild(elseBody, this.parseStatementOrRecover())
      end
      if this.currentKind().isEnd() && this.currentIndex() > 0 && !this.tokens.kindAt(this.currentIndex() - 1).isNewLine()
        let index = this.currentIndex()

        this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires end on a separate line.")
      end
    end
    this.closeBlock(finalBlock)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), condition)

    for statement in thenBody
      children = host::appendInt(children, statement)
    end
    for statement in elseBody
      children = host::appendInt(children, statement)
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getIf(), (thenBody.Length as String) + "|" + (elseBody.Length as String), children), keyword)
  end

  def parseWhile(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getWhile())
    let condition = this.parseExpression(0)

    this.openBlock(block)
    this.skipNewLines()
    var body: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), condition)

    for statement in body
      children = host::appendInt(children, statement)
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getWhile(), body.Length as String, children), keyword)
  end

  def parseFor(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getFor())
    let name = this.expect(this.tokens.kinds.getIdentifier())
    var typeNode = -1

    if this.accept(this.tokens.kinds.getColon())
      typeNode = this.parseTypeName()
    end
    this.expect(this.tokens.kinds.getIn())
    let collection = this.parseExpression(0)

    this.openBlock(block)
    this.skipNewLines()
    var body: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), typeNode)

    children = appendChild(children, collection)
    for statement in body
      children = host::appendInt(children, statement)
    end
    let node = this.anchorToken(this.addNode(this.arena.kinds.getFor(), this.tokens.textAt(name) + "|" + (body.Length as String), children), name)

    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseUnsafeBlock(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getUnsafe())

    this.openBlock(block)
    this.requireNewLine()
    var body: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    return this.anchorToken(this.addNode(this.arena.kinds.getUnsafeBlock(), body.Length as String, body), keyword)
  end

  def parseBorrowBlock(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getBorrow())
    let owner = this.parseExpression(25)

    this.expect(this.tokens.kinds.getAs())
    let pointer = this.expect(this.tokens.kinds.getIdentifier())

    this.openBlock(block)
    this.requireNewLine()
    var body: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), owner)

    for statement in body
      children = host::appendInt(children, statement)
    end
    let node = this.anchorToken(this.addNode(this.arena.kinds.getBorrowBlock(), this.tokens.textAt(pointer) + "|" + (body.Length as String), children), pointer)

    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseUsingBlock(): Int
    let block = this.beginBlock()
    let keyword = this.expect(this.tokens.kinds.getUsing())
    let name = this.expect(this.tokens.kinds.getIdentifier())

    this.expect(this.tokens.kinds.getLess())
    this.expect(this.tokens.kinds.getMinus())
    let acquisition = this.parseExpression(0)

    this.openBlock(block)
    this.requireNewLine()
    var body: Int[] = []

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.closeBlock(block)
    this.expect(this.tokens.kinds.getEnd())
    var children = appendChild(emptyInts(), acquisition)

    for statement in body
      children = appendChild(children, statement)
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getUsingBlock(), this.tokens.textAt(name) + "|" + (body.Length as String), children), keyword)
  end

  def parseExpression(parentPrecedence: Int): Int
    this.expressionDepth = this.expressionDepth + 1
    if this.expressionDepth > 256
      let limited = this.currentIndex()

      this.diagnostics.add("NRB002", this.tokens.startAt(limited), this.tokens.lengthAt(limited), "Expression nesting exceeds 256 levels.")
      if !this.currentKind().isEndOfFile()
        this.next()
      end
      this.expressionDepth = this.expressionDepth - 1
      return this.leaf(this.arena.kinds.getName(), "<limit>")
    end
    let unary = this.currentKind().unaryPrecedence()
    var left = -1

    if unary != 0 && unary >= parentPrecedence
      let operation = this.next()
      let operand = this.parseExpression(unary)

      left = this.anchorToken(this.addNode(this.arena.kinds.getUnary(), "", appendChild(emptyInts(), operand)), operation)
      this.arena.nodeAt(left).operatorKind = this.tokens.kindAt(operation)
    else
      left = this.parsePrimary()
    end

    while true
      let precedence = this.currentKind().binaryPrecedence()

      if precedence == 0 || precedence <= parentPrecedence
        break
      end
      let operation = this.next()

      if this.tokens.kindAt(operation).isAs()
        let targetType = this.parseTypeName()
        var castChildren = appendChild(emptyInts(), left)

        castChildren = appendChild(castChildren, targetType)
        left = this.anchorNode(this.addNode(this.arena.kinds.getCast(), "", castChildren), left)
      else
        let right = this.parseExpression(precedence)
        var binaryChildren = appendChild(emptyInts(), left)

        binaryChildren = appendChild(binaryChildren, right)
        left = this.anchorToken(this.addNode(this.arena.kinds.getBinary(), "", binaryChildren), operation)
        this.arena.nodeAt(left).operatorKind = this.tokens.kindAt(operation)
      end
    end

    if parentPrecedence == 0 && this.accept(this.tokens.kinds.getQuestion())
      let thenExpression = this.parseExpression(0)
      let colon = this.currentIndex()

      this.expect(this.tokens.kinds.getColon())
      let elseExpression = this.parseExpression(0)
      var ternaryChildren = appendChild(emptyInts(), left)

      ternaryChildren = appendChild(ternaryChildren, thenExpression)
      ternaryChildren = appendChild(ternaryChildren, elseExpression)
      left = this.anchorNode(this.addNode(this.arena.kinds.getTernary(), "", ternaryChildren), left)
      this.arena.setSecondaryAnchor(left, this.tokens.startAt(colon), this.tokens.lengthAt(colon))
    end
    this.expressionDepth = this.expressionDepth - 1
    return left
  end

  def parsePrimary(): Int
    let kind = this.currentKind()
    var left = -1

    if kind.isIdentifier() && this.tokens.textAt(this.currentIndex()) == "quote" && this.peekKind(1).isDo()
      let keyword = this.next()
      let closure = this.parseClosure(true)

      left = this.anchorToken(this.addNode(this.arena.kinds.getQuoteExpression(), "", appendChild(emptyInts(), closure)), keyword)
    else if kind.isFn()
      if this.argumentDepth > 0
        let token = this.currentIndex()

        this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "Inline fn arguments are not supported; use a trailing do block or pass a named callback.")
      end
      left = this.parseClosure()
    else if kind.isTransfer()
      let keyword = this.next()
      let name = this.expect(this.tokens.kinds.getIdentifier())

      left = this.anchorToken(this.leaf(this.arena.kinds.getTransfer(), this.tokens.textAt(name)), keyword)
    else if kind.isIdentifier()
      left = this.parseQualifiedIdentifier(this.arena.kinds.getName())
    else if kind.isStringLiteral()
      let token = this.next()

      left = this.literalNode(this.arena.kinds.getStringLiteral(), token)
    else if kind.isIntLiteral()
      let token = this.next()

      left = this.literalNode(this.arena.kinds.getIntLiteral(), token)
    else if kind.isFloatLiteral()
      let token = this.next()

      left = this.literalNode(this.arena.kinds.getFloatLiteral(), token)
    else if kind.isTrue() || kind.isFalse()
      let token = this.next()

      left = this.literalNode(this.arena.kinds.getBoolLiteral(), token)
    else if kind.isNull()
      let token = this.next()

      left = this.anchorToken(this.leaf(this.arena.kinds.getNullLiteral(), ""), token)
    else if kind.isThis()
      let token = this.next()

      left = this.anchorToken(this.leaf(this.arena.kinds.getThis(), ""), token)
    else if kind.isSuper()
      let token = this.next()

      left = this.anchorToken(this.leaf(this.arena.kinds.getSuper(), ""), token)
    else if kind.isLParen()
      this.next()
      left = this.parseExpression(0)
      this.skipNewLines()
      this.expect(this.tokens.kinds.getRParen())
    else if kind.isLBracket()
      left = this.parseArrayLiteral()
    else if kind.isNew()
      left = this.parseNewExpression()
    else if kind.isStackalloc()
      left = this.parseStackAlloc()
    else if kind.isNative()
      left = this.parseNativeIntrinsic()
    else
      this.next()
      left = this.leaf(this.arena.kinds.getName(), "<error>")
    end

    while true
      if this.genericSuffix()
        this.arena.nodeAt(left).typeArguments = this.parseTypeArguments()
      else if this.accept(this.tokens.kinds.getLParen())
        let arguments = this.parseArguments(this.tokens.kinds.getRParen(), true)

        this.skipNewLines()
        this.expect(this.tokens.kinds.getRParen())
        var children = appendChild(emptyInts(), left)

        for argument in arguments
          children = host::appendInt(children, argument)
        end
        left = this.anchorNode(this.addNode(this.arena.kinds.getCall(), arguments.Length as String, children), left)
      else if this.currentKind().isDo()
        let token = this.currentIndex()
        let callable = this.arena.kindAt(left).isCall() || this.arena.kindAt(left).isNew()

        if !callable || this.argumentDepth > 0
          this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "A do block must follow a call outside its argument list.")
        end
        let closure = this.parseClosure(true)

        if callable
          let node = this.arena.nodeAt(left)

          node.children = host::appendInt(node.children, closure)
          node.data = (node.children.Length - 1) as String
        end
        if !this.currentKind().isNewLine() && !this.currentKind().isEndOfFile()
          let following = this.currentIndex()

          this.diagnostics.add("NR009", this.tokens.startAt(following), this.tokens.lengthAt(following), "A do block must finish with end on its own line.")
        end
        break
      else if this.accept(this.tokens.kinds.getDot())
        let member = this.expect(this.tokens.kinds.getIdentifier())

        left = this.anchorToken(this.addNode(this.arena.kinds.getMember(), this.tokens.textAt(member), appendChild(emptyInts(), left)), member)
      else if this.currentKind().isLBracket()
        let bracket = this.next()
        let index = this.parseExpression(0)

        this.skipNewLines()
        this.expect(this.tokens.kinds.getRBracket())
        var indexChildren = appendChild(emptyInts(), left)

        indexChildren = appendChild(indexChildren, index)
        left = this.anchorToken(this.addNode(this.arena.kinds.getIndex(), "", indexChildren), bracket)
      else
        break
      end
    end
    return left
  end

  def parseClosure(block: Bool = false): Int
    let syntaxBlock = this.beginBlock()
    var keyword = -1
    var terminator = this.tokens.kinds.getRParen()
    var hasParameters = true

    if block
      keyword = this.expect(this.tokens.kinds.getDo())
      terminator = this.tokens.kinds.getPipe()
      hasParameters = this.accept(this.tokens.kinds.getPipe())
    else
      keyword = this.expect(this.tokens.kinds.getFn())
      this.expect(this.tokens.kinds.getLParen())
    end
    var parameters: Int[] = []

    if hasParameters
      this.skipNewLines()
    end
    while hasParameters && !this.currentKind().same(terminator) && !this.currentKind().isEndOfFile()
      let name = this.expect(this.tokens.kinds.getIdentifier())
      var annotation: Int[] = []

      if this.accept(this.tokens.kinds.getColon())
        annotation = host::appendInt(annotation, this.parseTypeName())
      end
      parameters = host::appendInt(parameters, this.anchorToken(this.addNode(this.arena.kinds.getParameter(), this.tokens.textAt(name), annotation), name))
      if !this.accept(this.tokens.kinds.getComma())
        break
      end
      this.skipNewLines()
    end
    if hasParameters
      this.skipNewLines()
      this.expect(terminator)
    end
    var result = this.anchorToken(this.leaf(this.arena.kinds.getType(), ""), keyword)

    if this.accept(this.tokens.kinds.getColon())
      result = this.parseTypeName()
    end
    this.openBlock(syntaxBlock)
    this.requireNewLine()
    let outerArgumentDepth = this.argumentDepth

    this.argumentDepth = 0
    var children = host::appendInt(parameters, result)

    while !this.currentKind().isEnd() && !this.currentKind().isEndOfFile()
      children = appendChild(children, this.parseStatementOrRecover())
    end
    if block && this.currentKind().isEnd() && this.currentIndex() > 0 && !this.tokens.kindAt(this.currentIndex() - 1).isNewLine()
      let token = this.currentIndex()

      this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "A do block requires end on its own line.")
    end
    this.closeBlock(syntaxBlock)
    this.expect(this.tokens.kinds.getEnd())
    this.argumentDepth = outerArgumentDepth
    return this.anchorToken(this.addNode(this.arena.kinds.getClosure(), parameters.Length as String, children), keyword)
  end

  def parseMissingArgumentExpression(terminator: readonly TokenKind, anchor: Int): Int
    let kind = this.currentKind()

    if kind.same(terminator) || kind.isComma() || kind.isNewLine() || kind.isEnd() || kind.isEndOfFile() || kind.isAt() || kind.isUse() || kind.isNamespace() || kind.isStruct() || kind.isUnion() || kind.isDef() || kind.isClass() || kind.isEnum() || this.atContextualIdentifier("contract")
      let index = this.currentIndex()

      this.diagnostics.add("NR001", this.diagnosticStart(index), this.atSourceBoundary(index) ? 1 : this.tokens.lengthAt(index), "Expected an expression after the named argument label.")
      let result = this.anchorToken(this.leaf(this.arena.kinds.getMissingExpression(), ""), anchor)

      return result
    end
    return this.parseExpression(0)
  end

  def parseNamedArgument(terminator: readonly TokenKind): Int
    let label = this.next()
    let colon = this.expect(this.tokens.kinds.getColon())
    let expression = this.parseMissingArgumentExpression(terminator, colon)
    let result = this.anchorToken(this.addNode(this.arena.kinds.getNamedArgument(), this.tokens.textAt(label), appendChild(emptyInts(), expression)), label)

    this.arena.setSecondaryAnchor(result, this.tokens.startAt(colon), this.tokens.lengthAt(colon))
    return result
  end

  def parseArguments(terminator: readonly TokenKind, allowNamedArguments: Bool = false): Int[]
    var arguments: Int[] = []

    if this.currentKind().same(terminator)
      return arguments
    end
    while true
      this.skipNewLines()
      if terminator.isRParen()
        this.argumentDepth = this.argumentDepth + 1
      end
      var argument = -1

      if this.currentKind().isIdentifier() && this.peekKind(1).isColon()
        if allowNamedArguments
          argument = this.parseNamedArgument(terminator)
        else
          let label = this.next()

          this.expect(this.tokens.kinds.getColon())
          this.diagnostics.add("NR004", this.tokens.startAt(label), this.tokens.lengthAt(label), "Named arguments are not allowed in this argument list.")
          argument = this.parseMissingArgumentExpression(terminator, label)
        end
      else
        argument = this.parseExpression(0)
      end
      arguments = host::appendInt(arguments, argument)
      if terminator.isRParen()
        this.argumentDepth = this.argumentDepth - 1
      end
      if this.accept(this.tokens.kinds.getComma())
        this.skipNewLines()
      else
        break
      end
    end
    return arguments
  end

  def parseArrayLiteral(): Int
    let bracket = this.expect(this.tokens.kinds.getLBracket())
    let elements = this.parseArguments(this.tokens.kinds.getRBracket())

    this.skipNewLines()
    this.expect(this.tokens.kinds.getRBracket())
    return this.anchorToken(this.addNode(this.arena.kinds.getArrayLiteral(), elements.Length as String, elements), bracket)
  end

  def parseNewExpression(): Int
    let keyword = this.expect(this.tokens.kinds.getNew())
    let typeNode = this.parseTypeName()

    this.skipNewLines()
    this.expect(this.tokens.kinds.getLParen())
    let arguments = this.parseArguments(this.tokens.kinds.getRParen(), true)

    this.skipNewLines()
    this.expect(this.tokens.kinds.getRParen())
    var children = appendChild(emptyInts(), typeNode)

    for argument in arguments
      children = host::appendInt(children, argument)
    end
    return this.anchorToken(this.addNode(this.arena.kinds.getNew(), arguments.Length as String, children), keyword)
  end

  def parseStackAlloc(): Int
    let keyword = this.expect(this.tokens.kinds.getStackalloc())
    let typeNode = this.parseTypeName(false)

    this.expect(this.tokens.kinds.getLBracket())
    let count = this.parseExpression(0)

    this.expect(this.tokens.kinds.getRBracket())
    var children = appendChild(emptyInts(), typeNode)

    children = appendChild(children, count)
    return this.anchorToken(this.addNode(this.arena.kinds.getStackAlloc(), "", children), keyword)
  end

  def parseNativeIntrinsic(): Int
    let keyword = this.expect(this.tokens.kinds.getNative())

    this.expect(this.tokens.kinds.getDoubleColon())
    let operation = this.expect(this.tokens.kinds.getIdentifier())
    var typeNode = -1

    if this.accept(this.tokens.kinds.getLess())
      typeNode = this.parseTypeName()
      this.expect(this.tokens.kinds.getGreater())
    end
    this.expect(this.tokens.kinds.getLParen())
    let arguments = this.parseArguments(this.tokens.kinds.getRParen())

    this.skipNewLines()
    this.expect(this.tokens.kinds.getRParen())
    var children = appendChild(emptyInts(), typeNode)

    for argument in arguments
      children = host::appendInt(children, argument)
    end
    let result = this.addNode(this.arena.kinds.getNativeIntrinsic(), this.tokens.textAt(operation) + "|" + (arguments.Length as String), children)

    this.arena.setAnchor(result, this.tokens.startAt(keyword), this.tokens.startAt(operation) + this.tokens.lengthAt(operation) - this.tokens.startAt(keyword))
    return result
  end
end
