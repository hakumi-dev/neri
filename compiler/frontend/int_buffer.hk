use arrays

## Stores indexed integers in a geometrically grown array.
## Out-of-range reads return the fallback; out-of-range writes update it.
class IntBuffer
  private values: Int[] = []
  private fallback: Int = 0
  public size: Int = 0

  def add(value: Int): Void
    if this.size == this.values.Length
      this.grow()
    end
    this.values[this.size] = value
    this.size = this.size + 1
  end

  def get(index: Int): Int
    if index < 0 || index >= this.size
      return this.fallback
    end
    return this.values[index]
  end

  def set(index: Int, value: Int): Void
    if index < 0 || index >= this.size
      this.fallback = value
      return
    end
    this.values[index] = value
  end

  private def grow(): Void
    let previous = this.values
    let capacity = previous.Length == 0 ? 16 : previous.Length * 2

    this.values = arrays::generate(capacity) do |index|
      return index < this.size ? previous[index] : 0
    end
  end
end
