class BoolBuffer
  private values: IntBuffer = new IntBuffer()

  def add(value: Bool): Void
    this.values.add(value ? 1 : 0)
  end

  def get(index: Int): Bool
    return this.values.get(index) != 0
  end

  def set(index: Int, value: Bool): Void
    this.values.set(index, value ? 1 : 0)
  end
end
