def utf8Width(first: Int): Int
  if first < 128
    return 1
  else if first < 224
    return 2
  else if first < 240
    return 3
  end
  return 4
end

def codePointAt(text: String, position: Int): Int
  let first = host.stringByteAt(text, position) as Int
  if first < 128
    return first
  else if first < 224
    let second = host.stringByteAt(text, position + 1) as Int
    return (first - 192) * 64 + second - 128
  else if first < 240
    let second = host.stringByteAt(text, position + 1) as Int
    let third = host.stringByteAt(text, position + 2) as Int
    return (first - 224) * 4096 + (second - 128) * 64 + third - 128
  end
  let second = host.stringByteAt(text, position + 1) as Int
  let third = host.stringByteAt(text, position + 2) as Int
  let fourth = host.stringByteAt(text, position + 3) as Int
  return (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
end

def utf16Width(codePoint: Int): Int
  if codePoint > 65535
    return 2
  end
  return 1
end

def inUnicodeRanges(codePoint: Int, ranges: Int[]): Bool
  var low = 0
  var high = ranges.Length / 2 - 1
  while low <= high
    let middle = low + (high - low) / 2
    let first = ranges[middle * 2]
    let last = ranges[middle * 2 + 1]
    if codePoint < first
      high = middle - 1
    else if codePoint > last
      low = middle + 1
    else
      return true
    end
  end
  return false
end

def isUnicodeLetter(codePoint: Int): Bool
  return inUnicodeRanges(codePoint, unicodeLetterRanges())
end

def isUnicodeDigit(codePoint: Int): Bool
  return inUnicodeRanges(codePoint, unicodeDigitRanges())
end
