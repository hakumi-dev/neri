# Declaration modifiers have one order; integration annotations remain separate.
def syntaxModifierRank(name: String): Int
  if name == "public" || name == "protected" || name == "internal" || name == "private"
    return 1
  else if name == "abstract" || name == "sealed"
    return 2
  else if name == "override"
    return 3
  else if name == "static"
    return 4
  else if name == "readonly"
    return 5
  else if name == "unsafe"
    return 6
  else if name == "resource"
    return 7
  end
  return 0
end

def syntaxModifierIn(syntax: SyntaxArena, modifiers: Int[], name: String): Int
  for modifier in modifiers
    if syntax.dataAt(modifier) == name
      return modifier
    end
  end
  return -1
end

def syntaxModifierNode(syntax: SyntaxArena, node: Int, name: String): Int
  return syntaxModifierIn(syntax, syntax.nodeAt(node).modifiers, name)
end

def syntaxHasModifier(syntax: SyntaxArena, node: Int, name: String): Bool
  return syntaxModifierNode(syntax, node, name) >= 0
end

def syntaxModifierAccess(syntax: SyntaxArena, modifiers: Int[], fallback: String): String
  for modifier in modifiers
    let name = syntax.dataAt(modifier)

    if syntaxModifierRank(name) == 1
      return name
    end
  end
  return fallback
end
