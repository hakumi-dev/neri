# Declaration modifiers have one order; integration annotations remain separate.
def syntaxModifierRank(kind: readonly ModifierKind): Int
  if kind.isPublic() || kind.isProtected() || kind.isInternal() || kind.isPrivate()
    return 1
  else if kind.isAbstract() || kind.isSealed()
    return 2
  else if kind.isOverride()
    return 3
  else if kind.isStatic()
    return 4
  else if kind.isReadonly()
    return 5
  else if kind.isUnsafe()
    return 6
  else if kind.isResource()
    return 7
  end
  return 0
end

def syntaxModifierIn(syntax: SyntaxArena, modifiers: Int[], kind: readonly ModifierKind): Int
  for modifier in modifiers
    let actual = syntax.nodeAt(modifier).modifierKind

    if actual != null && actual.same(kind)
      return modifier
    end
  end
  return -1
end

def syntaxModifierNode(syntax: SyntaxArena, node: Int, kind: readonly ModifierKind): Int
  return syntaxModifierIn(syntax, syntax.nodeAt(node).modifiers, kind)
end

def syntaxHasModifier(syntax: SyntaxArena, node: Int, kind: readonly ModifierKind): Bool
  return syntaxModifierNode(syntax, node, kind) >= 0
end

def syntaxModifierAccess(syntax: SyntaxArena, modifiers: Int[], fallback: readonly SourceAccess): readonly SourceAccess
  for modifier in modifiers
    let kind = syntax.nodeAt(modifier).modifierKind

    if kind != null
      if kind.isPublic()
        return syntax.accesses.getPublic()
      else if kind.isProtected()
        return syntax.accesses.getProtected()
      else if kind.isPrivate()
        return syntax.accesses.getPrivate()
      else if kind.isInternal()
        return syntax.accesses.getInternal()
      end
    end
  end
  return fallback
end
