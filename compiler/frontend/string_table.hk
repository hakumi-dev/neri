use host
use tasks

# Insert-only string table for compiler indexes. Linear probing compares full
# UTF-8 keys after hashing; collisions never identify two different symbols.
# Doubling at half occupancy gives amortized constant expected probe counts.
# https://algs4.cs.princeton.edu/34hash/
class StringTableEntry<T>
  public key: String
  public value: T
  public hash: Int

  def init(key: String, value: T, hash: Int): Void
    this.key = key
    this.value = value
    this.hash = hash
  end
end

class StringTable<T>
  private entries: StringTableEntry<T>?[] = []
  private size: Int = 0

  private def hash(key: String): Int
    var result = 0
    var offset = 0
    let length = host.stringByteLength(key)

    while offset < length
      # The modulus keeps multiplication within Int without overflow.
      result = result * 31 + (host.stringByteAt(key, offset) as Int)
      result = result - (result / 2147483647) * 2147483647
      offset = offset + 1
    end
    return result
  end

  private def slot(key: String, hash: Int): Int
    var position = hash - (hash / this.entries.Length) * this.entries.Length

    while true
      let entry = this.entries[position]

      if entry == null || (entry.hash == hash && entry.key == key)
        return position
      end
      position = position + 1
      position = 0 if position == this.entries.Length
    end
    return -1
  end

  def find(key: String): StringTableEntry<T>?
    if this.entries.Length == 0
      return null
    end
    return this.entries[this.slot(key, this.hash(key))]
  end

  # Keep the first value, matching source-declaration resolution order.
  def add(key: String, value: T): Bool
    if this.size * 2 >= this.entries.Length
      this.grow()
    end
    let hash = this.hash(key)
    let position = this.slot(key, hash)

    if this.entries[position] != null
      return false
    end
    this.entries[position] = new StringTableEntry<T>(key, value, hash)
    this.size = this.size + 1
    return true
  end

  private def grow(): Void
    let previous = this.entries
    let capacity = previous.Length == 0 ? 16 : previous.Length * 2

    this.entries = tasks.generate(capacity, 1) do |index|
      let empty: StringTableEntry<T>? = null

      return empty
    end
    for entry in previous
      if entry != null
        this.entries[this.slot(entry.key, entry.hash)] = entry
      end
    end
  end
end
