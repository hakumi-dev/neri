sealed class SyntaxUse
  public namespaceName: String
  public alias: String

  def init(namespaceName: String, alias: String = ""): Void
    this.namespaceName = namespaceName
    this.alias = alias
  end

  readonly def same(other: readonly SyntaxUse): Bool
    return this.namespaceName == other.namespaceName && this.alias == other.alias
  end
end
