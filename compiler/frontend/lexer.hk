use host

def textSlice(text: String, start: Int, length: Int): String
  return host.stringSlice(text, start, length)
end

def keywordKind(text: String): String
  if text == "as"
    return "As"
  else if text == "borrow"
    return "Borrow"
  else if text == "break"
    return "Break"
  else if text == "class"
    return "Class"
  else if text == "continue"
    return "Continue"
  else if text == "def"
    return "Def"
  else if text == "else"
    return "Else"
  else if text == "end"
    return "End"
  else if text == "false"
    return "False"
  else if text == "for"
    return "For"
  else if text == "if"
    return "If"
  else if text == "in"
    return "In"
  else if text == "internal"
    return "Internal"
  else if text == "let"
    return "Let"
  else if text == "namespace"
    return "Namespace"
  else if text == "native"
    return "Native"
  else if text == "new"
    return "New"
  else if text == "null"
    return "Null"
  else if text == "private"
    return "Private"
  else if text == "protected"
    return "Protected"
  else if text == "public"
    return "Public"
  else if text == "return"
    return "Return"
  else if text == "stackalloc"
    return "Stackalloc"
  else if text == "static"
    return "Static"
  else if text == "super"
    return "Super"
  else if text == "this"
    return "This"
  else if text == "true"
    return "True"
  else if text == "unsafe"
    return "Unsafe"
  else if text == "use"
    return "Use"
  else if text == "var"
    return "Var"
  else if text == "while"
    return "While"
  end
  return "Identifier"
end

def isIdentifierStart(codePoint: Int, letterRanges: Int[]): Bool
  return codePoint == 95 || inUnicodeRanges(codePoint, letterRanges)
end

def isIdentifierPart(codePoint: Int, letterRanges: Int[], digitRanges: Int[]): Bool
  return isIdentifierStart(codePoint, letterRanges) || inUnicodeRanges(codePoint, digitRanges)
end

def isStringEscape(codePoint: Int): Bool
  return codePoint == 34 || codePoint == 92 || codePoint == 48 || codePoint == 110 || codePoint == 116 || codePoint == 114
end

def escapedByte(codePoint: Int): Byte
  if codePoint == 34
    return 34 as Byte
  else if codePoint == 92
    return 92 as Byte
  else if codePoint == 48
    return 0 as Byte
  else if codePoint == 110
    return 10 as Byte
  else if codePoint == 116
    return 9 as Byte
  end
  return 13 as Byte
end

def fixedTokenText(kind: String): String
  if kind == "NewLine" return "\n" end
  if kind == "As" return "as" end
  if kind == "Borrow" return "borrow" end
  if kind == "Break" return "break" end
  if kind == "Class" return "class" end
  if kind == "Continue" return "continue" end
  if kind == "Def" return "def" end
  if kind == "Else" return "else" end
  if kind == "End" return "end" end
  if kind == "False" return "false" end
  if kind == "For" return "for" end
  if kind == "If" return "if" end
  if kind == "In" return "in" end
  if kind == "Internal" return "internal" end
  if kind == "Let" return "let" end
  if kind == "Namespace" return "namespace" end
  if kind == "Native" return "native" end
  if kind == "New" return "new" end
  if kind == "Null" return "null" end
  if kind == "Private" return "private" end
  if kind == "Protected" return "protected" end
  if kind == "Public" return "public" end
  if kind == "Return" return "return" end
  if kind == "Stackalloc" return "stackalloc" end
  if kind == "Static" return "static" end
  if kind == "Super" return "super" end
  if kind == "This" return "this" end
  if kind == "True" return "true" end
  if kind == "Unsafe" return "unsafe" end
  if kind == "Use" return "use" end
  if kind == "Var" return "var" end
  if kind == "While" return "while" end
  if kind == "EqualEqual" return "==" end
  if kind == "BangEqual" return "!=" end
  if kind == "LessEqual" return "<=" end
  if kind == "GreaterEqual" return ">=" end
  if kind == "AmpAmp" return "&&" end
  if kind == "PipePipe" return "||" end
  if kind == "LParen" return "(" end
  if kind == "RParen" return ")" end
  if kind == "Comma" return "," end
  if kind == "Colon" return ":" end
  if kind == "Question" return "?" end
  if kind == "At" return "@" end
  if kind == "Dot" return "." end
  if kind == "LBracket" return "[" end
  if kind == "RBracket" return "]" end
  if kind == "Plus" return "+" end
  if kind == "Minus" return "-" end
  if kind == "Star" return "*" end
  if kind == "Slash" return "/" end
  if kind == "Equal" return "=" end
  if kind == "Less" return "<" end
  if kind == "Greater" return ">" end
  if kind == "Bang" return "!" end
  if kind == "Amp" return "&" end
  return ""
end

class BootstrapLexer
  public source: String
  public tokens: TokenBuffer = new TokenBuffer()
  public letterRanges: Int[] = unicodeLetterRanges()
  public digitRanges: Int[] = unicodeDigitRanges()
  public sourceByteLength: Int = 0
  public bytePosition: Int = 0
  public utf16Position: Int = 0

  def init(source: String): Void
    this.source = source
    this.sourceByteLength = host.stringByteLength(source)
  end

  def byteLength(): Int
    return this.sourceByteLength
  end

  def byteAt(position: Int): Int
    return host.stringByteAt(this.source, position) as Int
  end

  def advanceScalar(): Void
    let point = codePointAt(this.source, this.bytePosition)
    this.bytePosition = this.bytePosition + utf8Width(this.byteAt(this.bytePosition))
    this.utf16Position = this.utf16Position + utf16Width(point)
  end

  def add(kind: String, startByte: Int, startUtf16: Int, value: String): Void
    var text = fixedTokenText(kind)
    if text == "" && kind != "EndOfFile"
      text = textSlice(this.source, startByte, this.bytePosition - startByte)
    end
    this.addKnown(kind, startUtf16, this.utf16Position - startUtf16, text, value)
  end

  def addKnown(kind: String, startUtf16: Int, length: Int, text: String, value: String): Void
    this.tokens.add(
      kind,
      startUtf16,
      length,
      text,
      value
    )
  end

  def lex(): TokenBuffer
    while this.bytePosition < this.byteLength()
      let startByte = this.bytePosition
      let startUtf16 = this.utf16Position
      let current = codePointAt(this.source, this.bytePosition)

      if current == 13 || current == 10
        if current == 13 && this.bytePosition + 1 < this.byteLength() && this.byteAt(this.bytePosition + 1) == 10
          this.bytePosition = this.bytePosition + 2
          this.utf16Position = this.utf16Position + 2
        else
          this.advanceScalar()
        end
        this.add("NewLine", startByte, startUtf16, "")
      else if current == 32 || current == 9
        this.advanceScalar()
        while this.bytePosition < this.byteLength() && (this.byteAt(this.bytePosition) == 32 || this.byteAt(this.bytePosition) == 9)
          this.advanceScalar()
        end
      else if current == 35
        this.advanceScalar()
        while this.bytePosition < this.byteLength() && this.byteAt(this.bytePosition) != 13 && this.byteAt(this.bytePosition) != 10
          this.advanceScalar()
        end
      else if isIdentifierStart(current, this.letterRanges)
        this.advanceScalar()
        while this.bytePosition < this.byteLength() && isIdentifierPart(codePointAt(this.source, this.bytePosition), this.letterRanges, this.digitRanges)
          this.advanceScalar()
        end
        let text = textSlice(this.source, startByte, this.bytePosition - startByte)
        let kind = keywordKind(text)
        var value = ""
        if kind == "True"
          value = "b:true"
        else if kind == "False"
          value = "b:false"
        end
        this.addKnown(kind, startUtf16, this.utf16Position - startUtf16, text, value)
      else if inUnicodeRanges(current, this.digitRanges)
        this.advanceScalar()
        while this.bytePosition < this.byteLength() && inUnicodeRanges(codePointAt(this.source, this.bytePosition), this.digitRanges)
          this.advanceScalar()
        end
        var isFloat = false
        if this.bytePosition + 1 < this.byteLength() && this.byteAt(this.bytePosition) == 46 && inUnicodeRanges(codePointAt(this.source, this.bytePosition + 1), this.digitRanges)
          isFloat = true
          this.advanceScalar()
          while this.bytePosition < this.byteLength() && inUnicodeRanges(codePointAt(this.source, this.bytePosition), this.digitRanges)
            this.advanceScalar()
          end
        end
        let text = textSlice(this.source, startByte, this.bytePosition - startByte)
        if isFloat
          let parsed = host.parseFloat(text)
          if parsed != null
            this.addKnown("FloatLiteral", startUtf16, this.utf16Position - startUtf16, text, "f:" + text)
          else
            this.addKnown("BadToken", startUtf16, this.utf16Position - startUtf16, text, "")
          end
        else
          let parsed = host.parseInt(text)
          if parsed != null
            this.addKnown("IntLiteral", startUtf16, this.utf16Position - startUtf16, text, "i:" + text)
          else
            this.addKnown("IntLiteral", startUtf16, this.utf16Position - startUtf16, text, "")
          end
        end
      else if current == 34
        this.advanceScalar()
        var bytes: Byte[] = []
        var terminated = false
        while this.bytePosition < this.byteLength() && !terminated
          let point = codePointAt(this.source, this.bytePosition)
          if point == 34
            this.advanceScalar()
            terminated = true
          else if point == 13 || point == 10
            break
          else if point == 92 && this.bytePosition + 1 < this.byteLength() && isStringEscape(this.byteAt(this.bytePosition + 1))
            this.advanceScalar()
            let escape = this.byteAt(this.bytePosition)
            this.advanceScalar()
            bytes = host.appendByte(bytes, escapedByte(escape))
          else
            let width = utf8Width(this.byteAt(this.bytePosition))
            var offset = 0
            while offset < width
              bytes = host.appendByte(bytes, this.byteAt(this.bytePosition + offset) as Byte)
              offset = offset + 1
            end
            this.advanceScalar()
          end
        end
        if terminated
          let decoded = host.stringFromBytes(bytes)
          if decoded != null
            this.add("StringLiteral", startByte, startUtf16, "s:" + decoded)
          else
            this.add("BadToken", startByte, startUtf16, "")
          end
        else
          this.add("BadToken", startByte, startUtf16, "")
        end
      else
        this.lexPunctuation(startByte, startUtf16, current)
      end
    end

    this.tokens.add("EndOfFile", this.utf16Position, 0, "", "")
    return this.tokens
  end

  def lexPunctuation(startByte: Int, startUtf16: Int, current: Int): Void
    var kind = "BadToken"
    var width = 1
    let hasNext = this.bytePosition + 1 < this.byteLength()
    var next = 0
    if hasNext
      next = this.byteAt(this.bytePosition + 1)
    end

    if current == 61 && next == 61
      kind = "EqualEqual"
      width = 2
    else if current == 33 && next == 61
      kind = "BangEqual"
      width = 2
    else if current == 60 && next == 61
      kind = "LessEqual"
      width = 2
    else if current == 62 && next == 61
      kind = "GreaterEqual"
      width = 2
    else if current == 38 && next == 38
      kind = "AmpAmp"
      width = 2
    else if current == 124 && next == 124
      kind = "PipePipe"
      width = 2
    else if current == 40
      kind = "LParen"
    else if current == 41
      kind = "RParen"
    else if current == 44
      kind = "Comma"
    else if current == 58
      kind = "Colon"
    else if current == 63
      kind = "Question"
    else if current == 64
      kind = "At"
    else if current == 46
      kind = "Dot"
    else if current == 91
      kind = "LBracket"
    else if current == 93
      kind = "RBracket"
    else if current == 43
      kind = "Plus"
    else if current == 45
      kind = "Minus"
    else if current == 42
      kind = "Star"
    else if current == 47
      kind = "Slash"
    else if current == 61
      kind = "Equal"
    else if current == 60
      kind = "Less"
    else if current == 62
      kind = "Greater"
    else if current == 33
      kind = "Bang"
    else if current == 38
      kind = "Amp"
    end

    var consumed = 0
    while consumed < width
      this.advanceScalar()
      consumed = consumed + 1
    end
    this.add(kind, startByte, startUtf16, "")
  end
end
