# The split separates the two variable child groups after one fixed child:
# an if condition, a match case name, or a closure result type after parameters.
sealed class SyntaxPartition
  public kind: readonly SyntaxKind
  public firstCount: Int
  public secondCount: Int

  def init(kind: readonly SyntaxKind, firstCount: Int, secondCount: Int): Void
    syntaxInvariant(kind.isIf() || kind.isMatchCase() || kind.isClosure())
    syntaxInvariant(firstCount >= 0 && secondCount >= 0)
    this.kind = kind
    this.firstCount = firstCount
    this.secondCount = secondCount
  end

  readonly def same(other: readonly SyntaxPartition): Bool
    return this.kind.same(other.kind) && this.firstCount == other.firstCount && this.secondCount == other.secondCount
  end
end
