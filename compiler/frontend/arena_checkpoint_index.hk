class ArenaCheckpointIndex<T>
  private fallback: T
  private root: ArenaCheckpointNode<T>?
  private capacity: Int = 1
  private size: Int = 0

  def init(fallback: T): Void
    this.fallback = fallback
  end

  def add(value: T): Void
    let current = this.root

    if current == null
      this.root = new ArenaCheckpointNode<T>(value)
      this.size = 1
      return
    end
    if this.size == this.capacity
      let expanded = new ArenaCheckpointNode<T>(value)

      expanded.left = current
      this.root = expanded
      this.capacity = this.capacity * 2
    end
    let root = this.root

    if root != null
      this.addAt(root, 0, this.capacity, this.size, value)
    end
    this.size = this.size + 1
  end

  private def addAt(node: ArenaCheckpointNode<T>, start: Int, span: Int, index: Int, value: T): Void
    if span <= 1
      node.value = value
      return
    end
    let half = span / 2

    if index < start + half
      let child = node.left

      if child == null
        let created = new ArenaCheckpointNode<T>(value)

        node.left = created
        this.addAt(created, start, half, index, value)
      else
        this.addAt(child, start, half, index, value)
      end
      return
    end
    let child = node.right

    if child == null
      let created = new ArenaCheckpointNode<T>(value)

      node.right = created
      this.addAt(created, start + half, half, index, value)
    else
      this.addAt(child, start + half, half, index, value)
    end
  end

  def get(index: Int): T
    let root = this.root

    if root == null || index < 0 || index >= this.size
      return this.fallback
    end
    return this.getAt(root, 0, this.capacity, index)
  end

  private def getAt(node: ArenaCheckpointNode<T>, start: Int, span: Int, index: Int): T
    if span <= 1
      return node.value
    end
    let half = span / 2

    if index < start + half
      let child = node.left

      if child != null
        return this.getAt(child, start, half, index)
      end
      return node.value
    end
    let child = node.right

    if child != null
      return this.getAt(child, start + half, half, index)
    end
    return node.value
  end
end
