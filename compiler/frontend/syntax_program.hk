sealed class SyntaxProgram
  public useCount: Int
  public classCount: Int
  public functionCount: Int
  public recordCount: Int
  public contractCount: Int
  public namespaceCount: Int

  def init(useCount: Int, classCount: Int, functionCount: Int, recordCount: Int, contractCount: Int, namespaceCount: Int): Void
    syntaxInvariant(useCount >= 0 && classCount >= 0 && functionCount >= 0 && recordCount >= 0 && contractCount >= 0 && namespaceCount >= 0)
    this.useCount = useCount
    this.classCount = classCount
    this.functionCount = functionCount
    this.recordCount = recordCount
    this.contractCount = contractCount
    this.namespaceCount = namespaceCount
  end

  readonly def childCount(): Int
    return this.useCount + this.classCount + this.functionCount + this.recordCount + this.contractCount + this.namespaceCount
  end

  readonly def same(other: readonly SyntaxProgram): Bool
    return this.useCount == other.useCount && this.classCount == other.classCount && this.functionCount == other.functionCount && this.recordCount == other.recordCount && this.contractCount == other.contractCount && this.namespaceCount == other.namespaceCount
  end
end
