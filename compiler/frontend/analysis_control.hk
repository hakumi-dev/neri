class AnalysisControl
  private callback: (fn(): Bool)?
  private remaining: Int = 256
  private stopped: Bool = false

  def init(callback: (fn(): Bool)? = null): Void
    this.callback = callback
  end

  readonly def isCancelled(): Bool
    return this.stopped
  end

  # False permanently cancels this analysis. The callback may collect input,
  # but must not mutate compiler state or dispatch another analysis.
  def poll(): Bool
    if this.stopped
      return false
    end
    this.remaining = 256
    let callback = this.callback

    if callback != null && !callback()
      this.stopped = true
    end
    return !this.stopped
  end

  def checkpoint(): Bool
    if this.stopped
      return false
    end
    this.remaining = this.remaining - 1
    if this.remaining == 0
      return this.poll()
    end
    return true
  end
end
