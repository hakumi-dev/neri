use host

class TokenNode
  public kind: readonly TokenKind
  public start: Int = 0
  public length: Int = 0
  public text: String = ""
  public value: String = ""
  public nextNode: TokenNode?
  public previousNode: TokenNode?

  def init(kind: readonly TokenKind, start: Int, length: Int, text: String, value: String): Void
    this.kind = kind
    this.start = start
    this.length = length
    this.text = text
    this.value = value
  end
end
