## Stores linked nodes with checkpointed indexed access and a parent snapshot.
abstract class ArenaStorage<Node, Parent>
  public parent: Parent?
  private baseCount: Int
  public first: Node
  public last: Node
  public cached: Node?
  public cachedIndex: Int = -1
  public size: Int = 0
  private checkpoints: ArenaCheckpointIndex<Node>

  def init(parent: Parent?, sentinel: Node, baseCount: Int): Void
    this.parent = parent
    this.baseCount = baseCount
    this.first = sentinel
    this.last = sentinel
    this.cached = sentinel
    this.checkpoints = new ArenaCheckpointIndex<Node>(sentinel)
  end

  protected abstract def linkNodes(previous: Node, next: Node): Void
  protected abstract def previousNode(node: Node): Node?
  protected abstract def nextNode(node: Node): Node?
  protected abstract def parentNodeAt(parent: Parent, index: Int): Node

  protected def appendNode(node: Node): Int
    let index = this.baseCount + this.size

    this.linkNodes(this.last, node)
    this.last = node
    if (this.size / arenaCheckpointBlockSize()) * arenaCheckpointBlockSize() == this.size
      this.checkpoints.add(node)
    end
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.baseCount + this.size
  end

  def nodeAt(index: Int): Node
    let offset = this.baseCount

    if index < offset
      let parent = this.parent

      if parent != null
        return this.parentNodeAt(parent, index)
      end
      return this.first
    end
    let localIndex = index - offset
    var node = this.cached
    var cursor = this.cachedIndex
    let blockSize = arenaCheckpointBlockSize()
    let checkpointIndex = (localIndex / blockSize) * blockSize

    if node == null
      node = this.checkpoints.get(localIndex / blockSize)
      cursor = checkpointIndex
    else
      let distance = localIndex < cursor ? cursor - localIndex : localIndex - cursor

      if distance > 1 && distance > localIndex - checkpointIndex
        node = this.checkpoints.get(localIndex / blockSize)
        cursor = checkpointIndex
      end
    end
    while cursor > localIndex
      if node != null
        node = this.previousNode(node)
      end
      cursor = cursor - 1
    end
    while cursor < localIndex
      if node != null
        node = this.nextNode(node)
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end
end
