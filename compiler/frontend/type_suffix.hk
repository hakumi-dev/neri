sealed class TypeSuffix
  public kind: readonly TypeSuffixKind
  # Preserve the source integer lexeme until semantic range validation.
  public lengthText: String
  public inner: readonly TypeSuffix?

  def init(kind: readonly TypeSuffixKind, inner: readonly TypeSuffix?, lengthText: String = ""): Void
    syntaxInvariant(kind.isFixedArray() == (lengthText != ""))
    this.kind = kind
    this.lengthText = lengthText
    this.inner = inner
  end

  readonly def same(other: readonly TypeSuffix): Bool
    return this.kind.same(other.kind) && this.lengthText == other.lengthText
  end
end
