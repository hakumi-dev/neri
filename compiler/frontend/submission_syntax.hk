use host

class SubmissionSyntax
  public root: Int = -1
  public entry: Int = -1
  public status: readonly SubmissionStatus = SubmissionStatus.invalid()
  public declarationCount: Int = 0
  public statementCount: Int = 0
  public declarationStarts: IntBuffer = new IntBuffer()
  public declarationLengths: IntBuffer = new IntBuffer()
  public statementStarts: IntBuffer = new IntBuffer()
  public statementLengths: IntBuffer = new IntBuffer()
end
