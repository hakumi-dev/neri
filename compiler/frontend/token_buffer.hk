use host

class TokenBuffer
  public first: TokenNode = new TokenNode("", 0, 0, "", "")
  public last: TokenNode = new TokenNode("", 0, 0, "", "")
  public cached: TokenNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(kind: String, start: Int, length: Int, text: String, value: String): Void
    let node = new TokenNode(kind, start, length, text, value)

    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
  end

  def count(): Int
    return this.size
  end

  def nodeAt(index: Int): TokenNode
    var node = this.cached
    var cursor = this.cachedIndex

    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end

  def textAt(index: Int): String
    return this.nodeAt(index).text
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end
end
