use ConsoleInteraction
use host

def hexDigit(value: Int): String
  return textSlice("0123456789abcdef", value, 1)
end

def hexText(value: String): String
  var result = ""
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    result = result + hexDigit(byte / 16) + hexDigit(byte - (byte / 16) * 16)
    index = index + 1
  end
  return result
end

def emitTokens(tokens: TokenBuffer): Void
  var index = 0
  while index < tokens.count()
    let line = "T|" + tokens.kindAt(index) + "|" + (tokens.startAt(index) as String) + "|" + (tokens.lengthAt(index) as String) + "|" + hexText(tokens.textAt(index)) + "|" + hexText(tokens.valueAt(index))
    ConsoleInteraction.println(line)
    index = index + 1
  end
end

def emitSyntaxNode(arena: SyntaxArena, index: Int, depth: Int): Void
  let line = "A|" + (depth as String) + "|" + arena.kindAt(index) + "|" + hexText(arena.dataAt(index)) + "|" + (arena.childCountAt(index) as String)
  ConsoleInteraction.println(line)
  var offset = 0
  while offset < arena.childCountAt(index)
    emitSyntaxNode(arena, arena.childAt(index, offset), depth + 1)
    offset = offset + 1
  end
end

def emitDiagnostics(diagnostics: DiagnosticBuffer): Void
  var index = 0
  while index < diagnostics.count()
    let line = "D|" + diagnostics.codes.get(index) + "|" + (diagnostics.starts.get(index) as String) + "|" + (diagnostics.lengths.get(index) as String) + "|" + hexText(diagnostics.messages.get(index))
    ConsoleInteraction.println(line)
    index = index + 1
  end
end

def main(): Void
  if host.argumentCount() != 1
    ConsoleInteraction.println("usage: neri-bootstrap-frontend <source.hk>")
    return
  end

  let path = host.argumentAt(0)
  if path == null
    ConsoleInteraction.println("source argument unavailable")
    return
  end
  let source = host.readText(path)
  if source == null
    ConsoleInteraction.println("source read failed: " + host.errorMessage())
    return
  end
  if host.stringByteLength(source) > 1048576
    ConsoleInteraction.println("D|NRB001|0|1|" + hexText("Source exceeds the 1048576-byte bootstrap frontend limit."))
    return
  end

  let lexer = new BootstrapLexer(source)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()
  emitTokens(tokens)
  emitSyntaxNode(parser.arena, root, 0)
  emitDiagnostics(parser.diagnostics)
end
