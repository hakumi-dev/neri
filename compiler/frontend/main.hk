use console
use host

def hexDigit(value: Int): String
  return textSlice("0123456789abcdef", value, 1)
end

def hexText(value: String): String
  var result = ""
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    result = result + hexDigit(byte / 16) + hexDigit(byte - (byte / 16) * 16)
    index = index + 1
  end
  return result
end

def emitTokens(tokens: TokenBuffer): Void
  var index = 0

  while index < tokens.count()
    let line = "T|" + tokens.kindAt(index).name() + "|" + (tokens.startAt(index) as String) + "|" + (tokens.lengthAt(index) as String) + "|" + hexText(tokens.textAt(index)) + "|" + hexText(tokens.valueAt(index))

    console::println(line)
    index = index + 1
  end
end

def syntaxDebugData(arena: SyntaxArena, index: Int): String
  let importDeclaration = arena.useAt(index)

  if importDeclaration != null
    return importDeclaration.alias == "" ? importDeclaration.namespaceName : importDeclaration.alias + " = " + importDeclaration.namespaceName
  end
  let declaration = arena.declarationAt(index)
  let modifier = arena.nodeAt(index).modifierKind

  if declaration != null
    if declaration.kind.isFunction()
      return declaration.namespaceName + "|" + declaration.name + "|" + (declaration.annotationCount as String) + "|" + (declaration.parameterCount as String) + "|" + (declaration.bodyCount as String) + "|" + (declaration.isStatic ? "true" : "false") + "|" + (declaration.isUnsafe ? "true" : "false")
    end
    if declaration.kind.isClass()
      let role = declaration.isAlternative ? "enum" : (declaration.isResource ? "resource" : "")
      let members = arena.childCountAt(index) - (declaration.isAlternative ? 0 : 1)

      return declaration.namespaceName + "|" + declaration.access.name() + "|" + declaration.name + "|" + (members as String) + "|" + role
    end
    if declaration.kind.isMethod()
      return declaration.access.name() + "|" + (declaration.annotationCount as String)
    end
    if declaration.kind.isField()
      return declaration.access.name() + "|" + declaration.name
    end
    return declaration.namespaceName + "|" + declaration.name
  end
  if modifier != null
    return modifier.name()
  end
  let operation = arena.nodeAt(index).operatorKind

  if operation != null
    return operation.name()
  end
  return arena.dataAt(index)
end

def emitSyntaxNode(arena: SyntaxArena, index: Int, depth: Int): Void
  let data = syntaxDebugData(arena, index)
  let line = "A|" + (depth as String) + "|" + arena.kindAt(index).name() + "|" + hexText(data) + "|" + (arena.childCountAt(index) as String)

  console::println(line)
  var offset = 0

  while offset < arena.childCountAt(index)
    emitSyntaxNode(arena, arena.childAt(index, offset), depth + 1)
    offset = offset + 1
  end
end

def emitDiagnostics(diagnostics: DiagnosticBuffer): Void
  var index = 0

  while index < diagnostics.count()
    let line = "D|" + diagnostics.codes.get(index) + "|" + (diagnostics.starts.get(index) as String) + "|" + (diagnostics.lengths.get(index) as String) + "|" + hexText(diagnostics.messages.get(index))

    console::println(line)
    index = index + 1
  end
end

def main(): Void
  if host::argumentCount() != 1
    console::println("usage: neri-bootstrap-frontend <source.hk>")
    return
  end

  let path = host::argumentAt(0)

  if path == null
    console::println("source argument unavailable")
    return
  end
  let source = host::readText(path)

  if source == null
    console::println("source read failed: " + host::errorMessage())
    return
  end
  if host::stringByteLength(source) > 1048576
    console::println("D|NRB001|0|1|" + hexText("Source exceeds the 1048576-byte bootstrap frontend limit."))
    return
  end

  let lexer = new BootstrapLexer(source)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()

  emitTokens(tokens)
  emitSyntaxNode(parser.arena, root, 0)
  emitDiagnostics(parser.diagnostics)
end
