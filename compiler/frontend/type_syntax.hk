sealed class TypeSyntax
  public kind: readonly TypeSyntaxKind
  public flavor: readonly FunctionTypeFlavor
  public name: String
  public suffixes: readonly TypeSuffix?

  private def init(kind: readonly TypeSyntaxKind, flavor: readonly FunctionTypeFlavor, name: String, suffixes: readonly TypeSuffix?): Void
    this.kind = kind
    this.flavor = flavor
    this.name = name
    this.suffixes = suffixes
  end

  static def named(arena: SyntaxArena, name: String, suffixes: readonly TypeSuffix? = null): readonly TypeSyntax
    return new TypeSyntax(arena.typeKinds.getNominal(), arena.functionFlavors.getOrdinary(), name, suffixes)
  end

  static def form(arena: SyntaxArena, kind: readonly TypeSyntaxKind, suffixes: readonly TypeSuffix? = null): readonly TypeSyntax
    syntaxInvariant(!kind.isNominal() && !kind.isResolved() && !kind.isFunction())
    return new TypeSyntax(kind, arena.functionFlavors.getOrdinary(), "", suffixes)
  end

  static def function(arena: SyntaxArena, flavor: readonly FunctionTypeFlavor): readonly TypeSyntax
    return new TypeSyntax(arena.typeKinds.getFunction(), flavor, "", null)
  end

  readonly def substituted(arena: SyntaxArena, resolvedName: String): readonly TypeSyntax
    syntaxInvariant(this.kind.isNominal())
    return new TypeSyntax(arena.typeKinds.getResolved(), this.flavor, resolvedName, this.suffixes)
  end

  readonly def same(other: readonly TypeSyntax): Bool
    if !this.kind.same(other.kind) || !this.flavor.same(other.flavor) || this.name != other.name
      return false
    end
    var left = this.suffixes
    var right = other.suffixes

    while left != null
      if right == null || !left.kind.same(right.kind) || left.lengthText != right.lengthText
        return false
      end
      left = left.inner
      right = right.inner
    end
    return right == null
  end
end
