use host

def isAccessModifier(kind: readonly TokenKind): Bool
  return kind.isPublic() || kind.isPrivate() || kind.isProtected() || kind.isInternal()
end

def boolText(value: Bool): String
  if value
    return "true"
  end
  return "false"
end

def appendCallArguments(children: Int[], arena: SyntaxArena, call: Int): Int[]
  var result = children
  var offset = 1

  while offset < arena.childCountAt(call)
    result = host::appendInt(result, arena.childAt(call, offset))
    offset = offset + 1
  end
  return result
end
