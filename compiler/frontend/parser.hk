use host

def binaryPrecedence(kind: String): Int
  if kind == "As"
    return 25
  else if kind == "Star" || kind == "Slash"
    return 20
  else if kind == "Plus" || kind == "Minus"
    return 10
  else if kind == "EqualEqual" || kind == "BangEqual"
    return 6
  else if kind == "Less" || kind == "LessEqual" || kind == "Greater" || kind == "GreaterEqual"
    return 5
  else if kind == "AmpAmp"
    return 3
  else if kind == "PipePipe"
    return 2
  end
  return 0
end

def unaryPrecedence(kind: String): Int
  if kind == "Plus" || kind == "Minus" || kind == "Bang" || kind == "Amp" || kind == "Star"
    return 30
  end
  return 0
end

def isAccessModifier(kind: String): Bool
  return kind == "Public" || kind == "Private" || kind == "Protected" || kind == "Internal"
end

def boolText(value: Bool): String
  if value
    return "true"
  end
  return "false"
end

class BootstrapParser
  public tokens: TokenBuffer = new TokenBuffer()
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public arena: SyntaxArena = new SyntaxArena()
  public position: Int = 0
  public expressionDepth: Int = 0
  public argumentDepth: Int = 0
  public typeDepth: Int = 0
  public sourceBoundaries: IntBuffer = new IntBuffer()
  public lastTokenStart: Int = 0
  public lastTokenLength: Int = 0
  public lastTokenText: String = ""

  def init(tokens: TokenBuffer): Void
    this.tokens = tokens
  end

  def addSourceBoundary(start: Int): Void
    this.sourceBoundaries.add(start)
  end

  def currentIndex(): Int
    if this.position >= this.tokens.count()
      return this.tokens.count() - 1
    end
    return this.position
  end

  def peekIndex(offset: Int): Int
    let index = this.position + offset
    if index >= this.tokens.count()
      return this.tokens.count() - 1
    end
    return index
  end

  def currentKind(): String
    return this.tokens.kindAt(this.currentIndex())
  end

  def peekKind(offset: Int): String
    return this.tokens.kindAt(this.peekIndex(offset))
  end

  def next(): Int
    let index = this.currentIndex()
    this.position = this.position + 1
    return index
  end

  def match(kind: String): Bool
    if this.currentKind() == kind
      this.next()
      return true
    end
    return false
  end

  def expect(kind: String): Int
    if this.currentKind() == kind
      let matched = this.next()
      this.lastTokenStart = this.tokens.startAt(matched)
      this.lastTokenLength = this.tokens.lengthAt(matched)
      this.lastTokenText = this.tokens.textAt(matched)
      return matched
    end
    let index = this.currentIndex()
    let actual = this.tokens.kindAt(index)
    let message = "Unexpected token <" + actual + ">, expected <" + kind + ">."
    this.diagnostics.add("NR001", this.tokens.startAt(index), this.tokens.lengthAt(index), message)
    this.lastTokenStart = this.tokens.startAt(index)
    this.lastTokenText = "<expected " + kind + ">"
    this.lastTokenLength = host.stringByteLength(this.lastTokenText)
    return index
  end

  def skipNewLines(): Void
    while this.currentKind() == "NewLine"
      this.next()
    end
  end

  def skipToEndOfLine(): Void
    while this.currentKind() != "NewLine" && this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      this.next()
    end
    this.skipNewLines()
  end

  def requireNewLine(): Void
    if this.currentKind() == "NewLine"
      this.skipNewLines()
      return
    end
    let index = this.currentIndex()
    let message = "Unexpected token <" + this.currentKind() + ">, expected <NewLine>."
    this.diagnostics.add("NR001", this.tokens.startAt(index), this.tokens.lengthAt(index), message)
    this.skipToEndOfLine()
  end

  def addNode(kind: String, data: String, children: Int[]): Int
    return this.arena.add(kind, data, children)
  end

  def leaf(kind: String, data: String): Int
    let children: Int[] = []
    return this.addNode(kind, data, children)
  end

  def anchorToken(node: Int, token: Int): Int
    this.arena.setAnchor(node, this.tokens.startAt(token), this.tokens.lengthAt(token))
    return node
  end

  def anchorNode(node: Int, source: Int): Int
    this.arena.setAnchor(node, this.arena.startAt(source), this.arena.lengthAt(source))
    return node
  end

  def literalNode(kind: String, token: Int): Int
    let node = this.anchorToken(this.leaf(kind, this.tokens.textAt(token)), token)
    this.arena.setValue(node, this.tokens.valueAt(token))
    return node
  end

  def parseQualifiedName(): Int
    this.expect("Identifier")
    var text = this.lastTokenText
    while this.currentKind() == "Dot"
      this.next()
      this.expect("Identifier")
      text = text + "." + this.lastTokenText
    end
    return this.anchorToken(this.leaf("QualifiedName", text), this.currentIndex() - 1)
  end

  def parseTypeParameters(): String[]
    var names: String[] = []
    if !this.match("Less")
      return names
    end
    while true
      this.skipNewLines()
      let name = this.expect("Identifier")
      names = host.appendString(names, this.tokens.textAt(name))
      this.skipNewLines()
      if !this.match("Comma")
        break
      end
    end
    this.expect("Greater")
    return names
  end

  def parseTypeArguments(): Int[]
    this.expect("Less")
    var arguments: Int[] = []
    while true
      this.skipNewLines()
      arguments = host.appendInt(arguments, this.parseTypeName())
      this.skipNewLines()
      if !this.match("Comma")
        break
      end
    end
    this.expect("Greater")
    return arguments
  end

  def genericSuffix(): Bool
    let previous = this.position - 1
    if this.currentKind() != "Less" || previous < 0 || this.tokens.startAt(this.currentIndex()) != this.tokens.startAt(previous) + this.tokens.lengthAt(previous)
      return false
    end
    var offset = 0
    var depth = 0
    while offset < 256
      let kind = this.tokens.kindAt(this.peekIndex(offset))
      if kind == "EndOfFile"
        return false
      end
      if kind == "Less"
        depth = depth + 1
      else if kind == "Greater"
        depth = depth - 1
        if depth == 0
          let next = this.tokens.kindAt(this.peekIndex(offset + 1))
          return next == "LParen" || next == "RParen" || next == "RBracket" || next == "Comma" || next == "NewLine" || next == "If" || next == "EndOfFile"
        end
      end
      offset = offset + 1
    end
    return false
  end

  def parseTypeName(allowFixedArray: Bool = true): Int
    if this.typeDepth >= 64
      let token = this.currentIndex()
      this.diagnostics.add("NR222", this.tokens.startAt(token), this.tokens.lengthAt(token), "Type nesting limit exceeded (64 levels).")
      this.skipToEndOfLine()
      return this.leaf("Type", "<error>")
    end
    this.typeDepth = this.typeDepth + 1
    let result = this.parseTypeCore(allowFixedArray)
    this.typeDepth = this.typeDepth - 1
    return result
  end

  def parseTypeCore(allowFixedArray: Bool): Int
    if this.currentKind() == "Identifier" && this.tokens.textAt(this.currentIndex()) == "readonly"
      let keyword = this.next()
      let inner = this.parseTypeName(allowFixedArray)
      return this.anchorToken(this.addNode("Type", "#readonly", [inner]), keyword)
    end
    if this.currentKind() == "Fn"
      let keyword = this.next()
      this.expect("LParen")
      var types: Int[] = []
      this.skipNewLines()
      while this.currentKind() != "RParen" && this.currentKind() != "EndOfFile"
        types = host.appendInt(types, this.parseTypeName())
        if !this.match("Comma")
          break
        end
        this.skipNewLines()
      end
      this.skipNewLines()
      this.expect("RParen")
      this.expect("Colon")
      types = host.appendInt(types, this.parseTypeName())
      return this.anchorToken(this.addNode("Type", "fn", types), keyword)
    end
    var name = -1
    var grouped = false
    if this.match("LParen")
      grouped = true
      name = this.parseTypeName()
      this.expect("RParen")
    else
      name = this.parseQualifiedName()
    end
    var typeArguments: Int[] = []
    if !grouped && this.currentKind() == "Less"
      typeArguments = this.parseTypeArguments()
    end
    var previousStart = this.lastTokenStart
    var previousLength = this.lastTokenLength
    var pointerStart = -1
    var pointerLength = 0
    var suffixes = ""
    while true
      if this.currentKind() == "LBracket" && this.peekKind(1) == "RBracket"
        this.next()
        let rightBracket = this.next()
        suffixes = suffixes + "[]"
        previousStart = this.tokens.startAt(rightBracket)
        previousLength = this.tokens.lengthAt(rightBracket)
      else if allowFixedArray && this.currentKind() == "LBracket" && this.peekKind(1) == "IntLiteral"
        this.next()
        let count = this.next()
        let rightBracket = this.expect("RBracket")
        suffixes = suffixes + "[" + this.tokens.textAt(count) + "]"
        previousStart = this.tokens.startAt(rightBracket)
        previousLength = this.tokens.lengthAt(rightBracket)
      else if this.currentKind() == "Question"
        let question = this.next()
        suffixes = suffixes + "?"
        previousStart = this.tokens.startAt(question)
        previousLength = this.tokens.lengthAt(question)
      else
        let adjacent = this.tokens.startAt(this.currentIndex()) == previousStart + previousLength
        if this.currentKind() == "Star" && adjacent
          let star = this.next()
          suffixes = suffixes + "*"
          previousStart = this.tokens.startAt(star)
          previousLength = this.tokens.lengthAt(star)
          if pointerStart < 0
            pointerStart = previousStart
            pointerLength = previousLength
          end
        else
          break
        end
      end
    end
    let children = appendChild(emptyInts(), name)
    let typeNode = this.anchorNode(this.addNode("Type", (grouped ? "#group" : this.arena.dataAt(name)) + suffixes, children), name)
    this.arena.nodeAt(typeNode).typeArguments = typeArguments
    if pointerStart >= 0
      this.arena.setSecondaryAnchor(typeNode, pointerStart, pointerLength)
    else if suffixes != ""
      this.arena.setSecondaryAnchor(typeNode, previousStart, previousLength)
    end
    return typeNode
  end

  def parseProgram(): Int
    var records: Int[] = []
    var uses: Int[] = []
    var classes: Int[] = []
    var functions: Int[] = []
    var currentNamespace = ""
    var boundary = 0
    this.skipNewLines()
    while this.currentKind() != "EndOfFile"
      while boundary < this.sourceBoundaries.size && this.tokens.startAt(this.position) >= this.sourceBoundaries.get(boundary)
        currentNamespace = ""
        boundary = boundary + 1
      end
      let before = this.position
      if this.currentKind() == "Use"
        uses = host.appendInt(uses, this.parseUse())
        this.skipNewLines()
      else if this.currentKind() == "Namespace"
        currentNamespace = this.parseNamespace()
        this.skipNewLines()
      else if this.currentKind() == "Def"
        functions = host.appendInt(functions, this.parseFunction(currentNamespace, emptyInts()))
        this.skipNewLines()
      else if this.currentKind() == "At"
        let annotations = this.parseFunctionAnnotations()
        functions = host.appendInt(functions, this.parseFunction(currentNamespace, annotations))
        this.skipNewLines()
      else if this.currentKind() == "Struct" || this.currentKind() == "Union"
        records = host.appendInt(records, parseNativeRecord(this, currentNamespace))
        this.skipNewLines()
      else if this.currentKind() == "Class" || (isAccessModifier(this.currentKind()) && this.peekKind(1) == "Class")
        classes = host.appendInt(classes, this.parseClass(currentNamespace))
        this.skipNewLines()
      else
        let unexpected = this.next()
        this.diagnostics.add("NR002", this.tokens.startAt(unexpected), this.tokens.lengthAt(unexpected), "Unexpected token '" + this.tokens.textAt(unexpected) + "' at module scope; expected a declaration.")
        this.skipNewLines()
      end
      if this.position == before
        this.next()
      end
    end

    var children: Int[] = []
    for item in uses
      children = host.appendInt(children, item)
    end
    for item in classes
      children = host.appendInt(children, item)
    end
    for item in functions
      children = host.appendInt(children, item)
    end
    for item in records
      children = host.appendInt(children, item)
    end
    let data = (uses.Length as String) + "|" + (classes.Length as String) + "|" + (functions.Length as String) + "|" + (records.Length as String)
    return this.addNode("Program", data, children)
  end

  def parseUse(): Int
    this.expect("Use")
    let name = this.parseQualifiedName()
    return this.addNode("Use", this.arena.dataAt(name), appendChild(emptyInts(), name))
  end

  def parseNamespace(): String
    this.expect("Namespace")
    let name = this.parseQualifiedName()
    this.requireNewLine()
    return this.arena.dataAt(name)
  end

  def parseFunctionAnnotations(): Int[]
    var annotations: Int[] = []
    while this.currentKind() == "At"
      this.next()
      let name = this.expect("Identifier")
      var arguments: Int[] = []
      if this.currentKind() == "LParen"
        this.next()
        if this.currentKind() != "RParen"
          while true
            let argument = this.expect("StringLiteral")
            arguments = host.appendInt(arguments, this.leaf("StringLiteral", this.tokens.textAt(argument)))
            if this.match("Comma")
              this.skipNewLines()
            else
              break
            end
          end
        end
        this.expect("RParen")
      end
      annotations = host.appendInt(annotations, this.addNode("FunctionAnnotation", this.tokens.textAt(name), arguments))
      this.requireNewLine()
    end
    return annotations
  end

  def parseFunction(namespaceName: String, annotations: Int[]): Int
    this.expect("Def")
    var isStatic = false
    if this.currentKind() == "Static"
      this.next()
      isStatic = true
    end
    var isUnsafe = false
    if this.currentKind() == "Unsafe"
      this.next()
      isUnsafe = true
    end
    let name = this.expect("Identifier")
    let typeParameters = this.parseTypeParameters()
    this.expect("LParen")
    let parameters = this.parseParameters()
    this.skipNewLines()
    this.expect("RParen")
    this.expect("Colon")
    let returnType = this.parseTypeName()
    this.requireNewLine()

    var body: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      let statement = this.parseStatementOrRecover()
      body = appendChild(body, statement)
    end
    this.expect("End")

    var children: Int[] = []
    for annotation in annotations
      children = host.appendInt(children, annotation)
    end
    for parameter in parameters
      children = host.appendInt(children, parameter)
    end
    children = host.appendInt(children, returnType)
    for statement in body
      children = host.appendInt(children, statement)
    end
    let flags = (annotations.Length as String) + "|" + (parameters.Length as String) + "|" + (body.Length as String) + "|" + boolText(isStatic) + "|" + boolText(isUnsafe)
    let result = this.anchorToken(this.addNode("Function", namespaceName + "|" + this.tokens.textAt(name) + "|" + flags, children), name)
    this.arena.nodeAt(result).typeParameters = typeParameters
    return result
  end

  def parseParameters(): Int[]
    var parameters: Int[] = []
    if this.currentKind() == "RParen"
      return parameters
    end
    while true
      this.skipNewLines()
      let name = this.expect("Identifier")
      this.expect("Colon")
      let typeNode = this.parseTypeName()
      var defaultValue = -1
      if this.match("Equal")
        defaultValue = this.parseExpression(0)
      end
      var children = appendChild(emptyInts(), typeNode)
      children = appendChild(children, defaultValue)
      parameters = host.appendInt(parameters, this.anchorToken(this.addNode("Parameter", this.tokens.textAt(name), children), name))
      if this.match("Comma")
        this.skipNewLines()
      else
        break
      end
    end
    return parameters
  end

  def parseOptionalAccess(defaultAccess: String): String
    if isAccessModifier(this.currentKind())
      let token = this.next()
      return this.tokens.textAt(token)
    end
    return defaultAccess
  end

  def parseClass(namespaceName: String): Int
    let access = this.parseOptionalAccess("internal")
    this.expect("Class")
    let name = this.expect("Identifier")
    let typeParameters = this.parseTypeParameters()
    var baseType = -1
    if this.match("Colon")
      baseType = this.parseTypeName()
    end
    this.requireNewLine()
    var members: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      this.skipNewLines()
      if this.currentKind() == "End" || this.currentKind() == "EndOfFile"
        break
      end
      if this.currentKind() == "Def" || this.currentKind() == "At" || (isAccessModifier(this.currentKind()) && this.peekKind(1) == "Def")
        members = host.appendInt(members, this.parseMethod())
      else
        members = host.appendInt(members, this.parseField())
      end
    end
    this.expect("End")
    var children = appendChild(emptyInts(), baseType)
    for member in members
      children = host.appendInt(children, member)
    end
    let result = this.anchorToken(this.addNode("Class", namespaceName + "|" + access + "|" + this.tokens.textAt(name) + "|" + (members.Length as String), children), name)
    this.arena.nodeAt(result).typeParameters = typeParameters
    return result
  end

  def parseMethod(): Int
    var annotations: Int[] = []
    while this.currentKind() == "At"
      this.next()
      let name = this.expect("Identifier")
      annotations = host.appendInt(annotations, this.leaf("MethodAnnotation", this.tokens.textAt(name)))
      this.requireNewLine()
    end
    let access = this.parseOptionalAccess("public")
    let function = this.parseFunction("", emptyInts())
    var children: Int[] = []
    for annotation in annotations
      children = host.appendInt(children, annotation)
    end
    children = host.appendInt(children, function)
    return this.anchorNode(this.addNode("Method", access + "|" + (annotations.Length as String), children), function)
  end

  def parseField(): Int
    let access = this.parseOptionalAccess("private")
    let name = this.expect("Identifier")
    this.expect("Colon")
    let typeNode = this.parseTypeName()
    var initializer = -1
    if this.match("Equal")
      initializer = this.parseExpression(0)
    end
    this.requireNewLine()
    var children = appendChild(emptyInts(), typeNode)
    children = appendChild(children, initializer)
    return this.anchorToken(this.addNode("Field", access + "|" + this.tokens.textAt(name), children), name)
  end

  def parseStatementOrRecover(): Int
    if this.currentKind() == "NewLine"
      this.next()
      return -1
    end
    let statementStart = this.currentIndex()
    let kind = this.currentKind()
    var statement = -1
    if kind == "Let"
      statement = this.parseVariable("Let")
    else if kind == "Var"
      statement = this.parseVariable("Var")
    else if kind == "Return"
      statement = this.parseReturn()
    else if kind == "If"
      statement = this.parseIf()
    else if kind == "While"
      statement = this.parseWhile()
    else if kind == "For"
      statement = this.parseFor()
    else if kind == "Break"
      let keyword = this.next()
      statement = this.anchorToken(this.leaf("Break", ""), keyword)
    else if kind == "Continue"
      let keyword = this.next()
      statement = this.anchorToken(this.leaf("Continue", ""), keyword)
    else if kind == "Unsafe"
      statement = this.parseUnsafeBlock()
    else if kind == "Borrow"
      statement = this.parseBorrowBlock()
    else if kind == "Native"
      let expression = this.parseNativeIntrinsic()
      statement = this.anchorNode(this.addNode("ExpressionStatement", "", appendChild(emptyInts(), expression)), expression)
    else
      statement = this.parseNamedStatementOrRecover()
    end
    if this.currentKind() == "If" && statement >= 0
      let keyword = this.next()
      let actionKind = this.arena.kindAt(statement)
      var allowed = actionKind == "Assignment" || actionKind == "ExpressionStatement" || actionKind == "Return" || actionKind == "Break" || actionKind == "Continue"
      var token = statementStart
      while token < keyword
        if this.tokens.kindAt(token) == "NewLine"
          allowed = false
        end
        token = token + 1
      end
      if !allowed
        this.diagnostics.add("NR007", this.tokens.startAt(keyword), this.tokens.lengthAt(keyword), "Postfix if requires a single-line assignment, call, return, break, or continue.")
      end
      let condition = this.parseExpression(0)
      if this.currentKind() != "NewLine" && this.currentKind() != "EndOfFile"
        let unexpected = this.currentIndex()
        this.diagnostics.add("NR007", this.tokens.startAt(unexpected), this.tokens.lengthAt(unexpected), "Postfix if ends at the newline; else, end, and chained modifiers are not allowed.")
        this.skipToEndOfLine()
      end
      statement = this.anchorToken(this.addNode("If", "1|0", [condition, statement]), keyword)
    end
    this.skipNewLines()
    return statement
  end

  def parseNamedStatementOrRecover(): Int
    let startsNamed = this.currentKind() == "Identifier" && (this.peekKind(1) == "Equal" || this.peekKind(1) == "LParen" || this.peekKind(1) == "Dot" || this.peekKind(1) == "LBracket")
    let startsThis = this.currentKind() == "This" && this.peekKind(1) == "Dot"
    let startsSuper = this.currentKind() == "Super" && (this.peekKind(1) == "LParen" || this.peekKind(1) == "Dot")
    let startsPointer = this.currentKind() == "Star"
    if startsNamed || startsThis || startsSuper || startsPointer
      let start = this.tokens.startAt(this.currentIndex())
      let expression = this.parseExpression(0)
      if this.match("Equal")
        let value = this.parseExpression(0)
        let expressionKind = this.arena.kindAt(expression)
        let validTarget = expressionKind == "Name" || expressionKind == "Member" || expressionKind == "Index" || (expressionKind == "Unary" && this.arena.dataAt(expression) == "Star")
        if validTarget
          var children = appendChild(emptyInts(), expression)
          children = appendChild(children, value)
          return this.anchorNode(this.addNode("Assignment", "", children), expression)
        end
        this.diagnostics.add("NR002", start, 1, "Unexpected token '" + expressionKind + "' in statement.")
        return -1
      end
      if this.arena.kindAt(expression) == "Call"
        let callee = this.arena.childAt(expression, 0)
        if this.arena.kindAt(callee) == "Super"
          return this.anchorNode(this.addNode("SuperConstructorCall", "", appendCallArguments(emptyInts(), this.arena, expression)), callee)
        end
        return this.anchorNode(this.addNode("ExpressionStatement", "", appendChild(emptyInts(), expression)), expression)
      end
      this.diagnostics.add("NR003", start, 1, "Only function calls can be used as statements.")
      this.skipNewLines()
      return -1
    end

    let index = this.currentIndex()
    this.diagnostics.add("NR002", this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' in statement.")
    this.skipToEndOfLine()
    return -1
  end

  def parseVariable(kind: String): Int
    let keyword = this.expect(kind)
    let name = this.expect("Identifier")
    var typeNode = -1
    if this.match("Colon")
      typeNode = this.parseTypeName()
    end
    this.expect("Equal")
    let initializer = this.parseExpression(0)
    if this.currentKind() != "NewLine" && this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      let index = this.currentIndex()
      var code = "NR006"
      var statementName = "var"
      if kind == "Let"
        code = "NR005"
        statementName = "let"
      end
      this.diagnostics.add(code, this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' after " + statementName + " statement.")
      this.skipToEndOfLine()
    end
    var children = appendChild(emptyInts(), typeNode)
    children = appendChild(children, initializer)
    let node = this.anchorToken(this.addNode(kind, this.tokens.textAt(name), children), name)
    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseReturn(): Int
    let keyword = this.expect("Return")
    var expression = -1
    if this.currentKind() != "NewLine" && this.currentKind() != "End" && this.currentKind() != "EndOfFile" && this.currentKind() != "If"
      expression = this.parseExpression(0)
    end
    if this.currentKind() != "NewLine" && this.currentKind() != "End" && this.currentKind() != "EndOfFile" && this.currentKind() != "If"
      let index = this.currentIndex()
      this.diagnostics.add("NR004", this.tokens.startAt(index), this.tokens.lengthAt(index), "Unexpected token '" + this.tokens.textAt(index) + "' after return statement.")
      this.skipToEndOfLine()
    end
    return this.anchorToken(this.addNode("Return", "", appendChild(emptyInts(), expression)), keyword)
  end

  def parseIf(): Int
    let keyword = this.expect("If")
    let condition = this.parseExpression(0)
    if this.currentKind() != "NewLine"
      let index = this.currentIndex()
      this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires a newline before its body.")
    end
    this.skipNewLines()
    var thenBody: Int[] = []
    while this.currentKind() != "Else" && this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      thenBody = appendChild(thenBody, this.parseStatementOrRecover())
    end
    var elseBody: Int[] = []
    if (this.currentKind() == "Else" || this.currentKind() == "End") && this.currentIndex() > 0 && this.tokens.kindAt(this.currentIndex() - 1) != "NewLine"
      let index = this.currentIndex()
      this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires else and end on separate lines.")
    end
    if this.match("Else")
      if this.currentKind() != "If" && this.currentKind() != "NewLine"
        let index = this.currentIndex()
        this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Else requires a newline before its body.")
      end
      let chained = this.currentKind() == "If"
      this.skipNewLines()
      if chained
        elseBody = host.appendInt(elseBody, this.parseIf())
        var nestedChildren = appendChild(emptyInts(), condition)
        for statement in thenBody
          nestedChildren = host.appendInt(nestedChildren, statement)
        end
        for statement in elseBody
          nestedChildren = host.appendInt(nestedChildren, statement)
        end
        return this.anchorToken(this.addNode("If", (thenBody.Length as String) + "|" + (elseBody.Length as String), nestedChildren), keyword)
      end
      while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
        elseBody = appendChild(elseBody, this.parseStatementOrRecover())
      end
      if this.currentKind() == "End" && this.currentIndex() > 0 && this.tokens.kindAt(this.currentIndex() - 1) != "NewLine"
        let index = this.currentIndex()
        this.diagnostics.add("NR008", this.tokens.startAt(index), this.tokens.lengthAt(index), "Block if requires end on a separate line.")
      end
    end
    this.expect("End")
    var children = appendChild(emptyInts(), condition)
    for statement in thenBody
      children = host.appendInt(children, statement)
    end
    for statement in elseBody
      children = host.appendInt(children, statement)
    end
    return this.anchorToken(this.addNode("If", (thenBody.Length as String) + "|" + (elseBody.Length as String), children), keyword)
  end

  def parseWhile(): Int
    let keyword = this.expect("While")
    let condition = this.parseExpression(0)
    this.skipNewLines()
    var body: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.expect("End")
    var children = appendChild(emptyInts(), condition)
    for statement in body
      children = host.appendInt(children, statement)
    end
    return this.anchorToken(this.addNode("While", body.Length as String, children), keyword)
  end

  def parseFor(): Int
    let keyword = this.expect("For")
    let name = this.expect("Identifier")
    var typeNode = -1
    if this.match("Colon")
      typeNode = this.parseTypeName()
    end
    this.expect("In")
    let collection = this.parseExpression(0)
    this.skipNewLines()
    var body: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.expect("End")
    var children = appendChild(emptyInts(), typeNode)
    children = appendChild(children, collection)
    for statement in body
      children = host.appendInt(children, statement)
    end
    let node = this.anchorToken(this.addNode("For", this.tokens.textAt(name) + "|" + (body.Length as String), children), name)
    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseUnsafeBlock(): Int
    let keyword = this.expect("Unsafe")
    this.requireNewLine()
    var body: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.expect("End")
    return this.anchorToken(this.addNode("UnsafeBlock", body.Length as String, body), keyword)
  end

  def parseBorrowBlock(): Int
    let keyword = this.expect("Borrow")
    let owner = this.parseExpression(25)
    this.expect("As")
    let pointer = this.expect("Identifier")
    this.requireNewLine()
    var body: Int[] = []
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      body = appendChild(body, this.parseStatementOrRecover())
    end
    this.expect("End")
    var children = appendChild(emptyInts(), owner)
    for statement in body
      children = host.appendInt(children, statement)
    end
    let node = this.anchorToken(this.addNode("BorrowBlock", this.tokens.textAt(pointer) + "|" + (body.Length as String), children), pointer)
    this.arena.setIrAnchor(node, this.tokens.startAt(keyword), this.tokens.lengthAt(keyword))
    return node
  end

  def parseExpression(parentPrecedence: Int): Int
    this.expressionDepth = this.expressionDepth + 1
    if this.expressionDepth > 256
      let limited = this.currentIndex()
      this.diagnostics.add("NRB002", this.tokens.startAt(limited), this.tokens.lengthAt(limited), "Expression nesting exceeds 256 levels.")
      if this.currentKind() != "EndOfFile"
        this.next()
      end
      this.expressionDepth = this.expressionDepth - 1
      return this.leaf("Name", "<limit>")
    end
    let unary = unaryPrecedence(this.currentKind())
    var left = -1
    if unary != 0 && unary >= parentPrecedence
      let operation = this.next()
      let operand = this.parseExpression(unary)
      left = this.anchorToken(this.addNode("Unary", this.tokens.kindAt(operation), appendChild(emptyInts(), operand)), operation)
    else
      left = this.parsePrimary()
    end

    while true
      let precedence = binaryPrecedence(this.currentKind())
      if precedence == 0 || precedence <= parentPrecedence
        break
      end
      let operation = this.next()
      if this.tokens.kindAt(operation) == "As"
        let targetType = this.parseTypeName()
        var castChildren = appendChild(emptyInts(), left)
        castChildren = appendChild(castChildren, targetType)
        left = this.anchorNode(this.addNode("Cast", "", castChildren), left)
      else
        let right = this.parseExpression(precedence)
        var binaryChildren = appendChild(emptyInts(), left)
        binaryChildren = appendChild(binaryChildren, right)
        left = this.anchorToken(this.addNode("Binary", this.tokens.kindAt(operation), binaryChildren), operation)
      end
    end

    if parentPrecedence == 0 && this.match("Question")
      let thenExpression = this.parseExpression(0)
      this.expect("Colon")
      let elseExpression = this.parseExpression(0)
      var ternaryChildren = appendChild(emptyInts(), left)
      ternaryChildren = appendChild(ternaryChildren, thenExpression)
      ternaryChildren = appendChild(ternaryChildren, elseExpression)
      left = this.anchorNode(this.addNode("Ternary", "", ternaryChildren), left)
    end
    this.expressionDepth = this.expressionDepth - 1
    return left
  end

  def parsePrimary(): Int
    let kind = this.currentKind()
    var left = -1
    if kind == "Fn"
      if this.argumentDepth > 0
        let token = this.currentIndex()
        this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "Inline fn arguments are not supported; use a trailing do block or pass a named callback.")
      end
      left = this.parseClosure()
    else if kind == "Identifier"
      let token = this.next()
      left = this.anchorToken(this.leaf("Name", this.tokens.textAt(token)), token)
    else if kind == "StringLiteral"
      let token = this.next()
      left = this.literalNode("StringLiteral", token)
    else if kind == "IntLiteral"
      let token = this.next()
      left = this.literalNode("IntLiteral", token)
    else if kind == "FloatLiteral"
      let token = this.next()
      left = this.literalNode("FloatLiteral", token)
    else if kind == "True" || kind == "False"
      let token = this.next()
      left = this.literalNode("BoolLiteral", token)
    else if kind == "Null"
      let token = this.next()
      left = this.anchorToken(this.leaf("NullLiteral", ""), token)
    else if kind == "This"
      let token = this.next()
      left = this.anchorToken(this.leaf("This", ""), token)
    else if kind == "Super"
      let token = this.next()
      left = this.anchorToken(this.leaf("Super", ""), token)
    else if kind == "LParen"
      this.next()
      left = this.parseExpression(0)
      this.skipNewLines()
      this.expect("RParen")
    else if kind == "LBracket"
      left = this.parseArrayLiteral()
    else if kind == "New"
      left = this.parseNewExpression()
    else if kind == "Stackalloc"
      left = this.parseStackAlloc()
    else if kind == "Native"
      left = this.parseNativeIntrinsic()
    else
      this.next()
      left = this.leaf("Name", "<error>")
    end

    while true
      if this.genericSuffix()
        this.arena.nodeAt(left).typeArguments = this.parseTypeArguments()
      else if this.match("LParen")
        let arguments = this.parseArguments("RParen")
        this.skipNewLines()
        this.expect("RParen")
        var children = appendChild(emptyInts(), left)
        for argument in arguments
          children = host.appendInt(children, argument)
        end
        left = this.anchorNode(this.addNode("Call", arguments.Length as String, children), left)
      else if this.currentKind() == "Do"
        let token = this.currentIndex()
        let callable = this.arena.kindAt(left) == "Call" || this.arena.kindAt(left) == "New"
        if !callable || this.argumentDepth > 0
          this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "A do block must follow a call outside its argument list.")
        end
        let closure = this.parseClosure(true)
        if callable
          let node = this.arena.nodeAt(left)
          node.children = host.appendInt(node.children, closure)
          node.data = (node.children.Length - 1) as String
        end
        if this.currentKind() != "NewLine" && this.currentKind() != "EndOfFile"
          let following = this.currentIndex()
          this.diagnostics.add("NR009", this.tokens.startAt(following), this.tokens.lengthAt(following), "A do block must finish with end on its own line.")
        end
        break
      else if this.match("Dot")
        let member = this.expect("Identifier")
        left = this.anchorToken(this.addNode("Member", this.tokens.textAt(member), appendChild(emptyInts(), left)), member)
      else if this.currentKind() == "LBracket"
        let bracket = this.next()
        let index = this.parseExpression(0)
        this.skipNewLines()
        this.expect("RBracket")
        var indexChildren = appendChild(emptyInts(), left)
        indexChildren = appendChild(indexChildren, index)
        left = this.anchorToken(this.addNode("Index", "", indexChildren), bracket)
      else
        break
      end
    end
    return left
  end

  def parseClosure(block: Bool = false): Int
    var keyword = -1
    var terminator = "RParen"
    var hasParameters = true
    if block
      keyword = this.expect("Do")
      terminator = "Pipe"
      hasParameters = this.match("Pipe")
    else
      keyword = this.expect("Fn")
      this.expect("LParen")
    end
    var parameters: Int[] = []
    if hasParameters
      this.skipNewLines()
    end
    while hasParameters && this.currentKind() != terminator && this.currentKind() != "EndOfFile"
      let name = this.expect("Identifier")
      var annotation: Int[] = []
      if this.match("Colon")
        annotation = host.appendInt(annotation, this.parseTypeName())
      end
      parameters = host.appendInt(parameters, this.anchorToken(this.addNode("Parameter", this.tokens.textAt(name), annotation), name))
      if !this.match("Comma")
        break
      end
      this.skipNewLines()
    end
    if hasParameters
      this.skipNewLines()
      this.expect(terminator)
    end
    var result = this.anchorToken(this.leaf("Type", ""), keyword)
    if this.match("Colon")
      result = this.parseTypeName()
    end
    this.requireNewLine()
    let outerArgumentDepth = this.argumentDepth
    this.argumentDepth = 0
    var children = host.appendInt(parameters, result)
    while this.currentKind() != "End" && this.currentKind() != "EndOfFile"
      children = appendChild(children, this.parseStatementOrRecover())
    end
    if block && this.currentKind() == "End" && this.currentIndex() > 0 && this.tokens.kindAt(this.currentIndex() - 1) != "NewLine"
      let token = this.currentIndex()
      this.diagnostics.add("NR009", this.tokens.startAt(token), this.tokens.lengthAt(token), "A do block requires end on its own line.")
    end
    this.expect("End")
    this.argumentDepth = outerArgumentDepth
    return this.anchorToken(this.addNode("Closure", parameters.Length as String, children), keyword)
  end

  def parseArguments(terminator: String): Int[]
    var arguments: Int[] = []
    if this.currentKind() == terminator
      return arguments
    end
    while true
      this.skipNewLines()
      if terminator == "RParen"
        this.argumentDepth = this.argumentDepth + 1
      end
      arguments = host.appendInt(arguments, this.parseExpression(0))
      if terminator == "RParen"
        this.argumentDepth = this.argumentDepth - 1
      end
      if this.match("Comma")
        this.skipNewLines()
      else
        break
      end
    end
    return arguments
  end

  def parseArrayLiteral(): Int
    let bracket = this.expect("LBracket")
    let elements = this.parseArguments("RBracket")
    this.skipNewLines()
    this.expect("RBracket")
    return this.anchorToken(this.addNode("ArrayLiteral", elements.Length as String, elements), bracket)
  end

  def parseNewExpression(): Int
    let keyword = this.expect("New")
    let typeNode = this.parseTypeName()
    this.skipNewLines()
    this.expect("LParen")
    let arguments = this.parseArguments("RParen")
    this.skipNewLines()
    this.expect("RParen")
    var children = appendChild(emptyInts(), typeNode)
    for argument in arguments
      children = host.appendInt(children, argument)
    end
    return this.anchorToken(this.addNode("New", arguments.Length as String, children), keyword)
  end

  def parseStackAlloc(): Int
    let keyword = this.expect("Stackalloc")
    let typeNode = this.parseTypeName(false)
    this.expect("LBracket")
    let count = this.parseExpression(0)
    this.expect("RBracket")
    var children = appendChild(emptyInts(), typeNode)
    children = appendChild(children, count)
    return this.anchorToken(this.addNode("StackAlloc", "", children), keyword)
  end

  def parseNativeIntrinsic(): Int
    let keyword = this.expect("Native")
    this.expect("Dot")
    let operation = this.expect("Identifier")
    var typeNode = -1
    if this.match("Less")
      typeNode = this.parseTypeName()
      this.expect("Greater")
    end
    this.expect("LParen")
    let arguments = this.parseArguments("RParen")
    this.skipNewLines()
    this.expect("RParen")
    var children = appendChild(emptyInts(), typeNode)
    for argument in arguments
      children = host.appendInt(children, argument)
    end
    let result = this.addNode("NativeIntrinsic", this.tokens.textAt(operation) + "|" + (arguments.Length as String), children)
    this.arena.setAnchor(result, this.tokens.startAt(keyword), this.tokens.startAt(operation) + this.tokens.lengthAt(operation) - this.tokens.startAt(keyword))
    return result
  end
end

def appendCallArguments(children: Int[], arena: SyntaxArena, call: Int): Int[]
  var result = children
  var offset = 1
  while offset < arena.childCountAt(call)
    result = host.appendInt(result, arena.childAt(call, offset))
    offset = offset + 1
  end
  return result
end
