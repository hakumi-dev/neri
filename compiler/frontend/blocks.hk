# Optional syntax metadata for editor queries. Positions use the parser's UTF-16
# coordinates; a negative closing position denotes a missing terminator.
class SyntaxBlock
  public start: Int = 0
  public headerEnd: Int = -1
  public closing: Int = -1
  public diagnosticsBefore: Int = 0
  public ownsEnd: Bool = true
  public sharedEnd: SyntaxBlock?
  public parent: SyntaxBlock?
  public next: SyntaxBlock?
end
