class StringBuffer: ValueBuffer<String>
  def init(): Void
    super("")
  end

  def join(): String
    return this.joinRange(0, this.size)
  end

  private def joinRange(start: Int, count: Int): String
    if count == 0
      return ""
    end
    if count == 1
      return this.get(start)
    end
    let left = count / 2

    return this.joinRange(start, left) + this.joinRange(start + left, count - left)
  end
end
