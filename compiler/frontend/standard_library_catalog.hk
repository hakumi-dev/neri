use host

class StandardLibraryCatalog
  private directory: String
  private manifest: String = ""
  private names: StringBuffer = new StringBuffer()
  private first: StandardLibraryModule?
  public error: String = ""

  def init(directory: String): Void
    this.directory = directory
    if directory == ""
      this.error = "Required standard library core is unavailable."
      return
    end
    let canonical = neriCanonicalPath(directory)

    if canonical != null
      this.directory = canonical
    end
    let manifest = this.directory + "/manifest.json"

    if host::readText(manifest) != null
      this.manifest = manifest
      let project = new NeriProject()

      project.manifest = manifest
      this.names = neriProjectUnitNames(project)
      this.error = project.error()
      if this.error == "" && this.names.size == 0
        this.error = "A standard-library manifest must declare library units."
      end
    end
  end

  def moduleNames(): StringBuffer
    return this.names
  end

  def sourceName(path: String): String?
    let canonical = neriCanonicalPath(path)
    let prefix = this.directory + "/"

    if canonical == null || !bootstrapStartsWith(canonical, prefix) || !semanticEndsWith(canonical, ".hk")
      return null
    end
    return host::stringSlice(canonical, host::stringByteLength(prefix), host::stringByteLength(canonical) - host::stringByteLength(prefix))
  end

  def sourcePaths(name: String): StringBuffer
    var module = this.first

    while module != null
      if module.name == name
        return module.paths
      end
      module = module.next
    end
    let paths = new StringBuffer()

    if this.error != ""
      return paths
    end
    if this.manifest == ""
      if neriRelativeProjectPath(name + ".hk") && host::readText(this.directory + "/" + name + ".hk") != null
        paths.add(name + ".hk")
      end
    else if neriProjectListed(this.names, name)
      let project = neriLoadProject(this.manifest, name)

      this.error = project.error()
      if this.error == "" && !projectUnitIsLibrary(project.kind)
        this.error = "Standard-library modules must be library units: " + name
      end
      var source = project.sources.first.nextNode

      while this.error == "" && source != null
        let relative = this.sourceName(source.value)

        if relative == null
          this.error = "Standard-library source must stay inside its library directory: " + source.value
        else
          paths.add(relative)
        end
        source = source.nextNode
      end
    end
    if this.manifest != "" && name == bootstrapCoreLibraryName() && !neriProjectListed(paths, "core.hk")
      this.error = "The core standard-library unit must include core.hk."
    end
    if this.error != ""
      return new StringBuffer()
    end
    let loaded = new StandardLibraryModule(name, paths)

    loaded.next = this.first
    this.first = loaded
    return paths
  end
end
