sealed class SyntaxDeclaration
  public kind: readonly SyntaxKind
  public namespaceName: String = ""
  public name: String = ""
  public access: readonly SourceAccess
  public annotationCount: Int = 0
  public parameterCount: Int = 0
  public bodyCount: Int = 0
  public isStatic: Bool = false
  public isUnsafe: Bool = false
  public isAlternative: Bool = false
  public isResource: Bool = false

  private def init(kind: readonly SyntaxKind, access: readonly SourceAccess): Void
    this.kind = kind
    this.access = access
  end

  static def callable(arena: SyntaxArena, namespaceName: String, name: String, annotationCount: Int, parameterCount: Int, bodyCount: Int, isStatic: Bool, isUnsafe: Bool): readonly SyntaxDeclaration
    syntaxInvariant(annotationCount >= 0 && parameterCount >= 0 && bodyCount >= 0)
    let result = new SyntaxDeclaration(arena.kinds.getFunction(), arena.accesses.getInternal())

    result.namespaceName = namespaceName
    result.name = name
    result.annotationCount = annotationCount
    result.parameterCount = parameterCount
    result.bodyCount = bodyCount
    result.isStatic = isStatic
    result.isUnsafe = isUnsafe
    return result
  end

  static def typeDeclaration(arena: SyntaxArena, namespaceName: String, name: String, access: readonly SourceAccess, alternative: Bool, resourceType: Bool): readonly SyntaxDeclaration
    syntaxInvariant(!alternative || !resourceType)
    let result = new SyntaxDeclaration(arena.kinds.getClass(), access)

    result.namespaceName = namespaceName
    result.name = name
    result.isAlternative = alternative
    result.isResource = resourceType
    return result
  end

  static def method(arena: SyntaxArena, access: readonly SourceAccess, annotationCount: Int): readonly SyntaxDeclaration
    syntaxInvariant(annotationCount >= 0)
    let result = new SyntaxDeclaration(arena.kinds.getMethod(), access)

    result.annotationCount = annotationCount
    return result
  end

  static def field(arena: SyntaxArena, access: readonly SourceAccess, name: String): readonly SyntaxDeclaration
    let result = new SyntaxDeclaration(arena.kinds.getField(), access)

    result.name = name
    return result
  end

  static def contract(arena: SyntaxArena, namespaceName: String, name: String): readonly SyntaxDeclaration
    let result = new SyntaxDeclaration(arena.kinds.getContract(), arena.accesses.getInternal())

    result.namespaceName = namespaceName
    result.name = name
    return result
  end

  static def nativeRecord(arena: SyntaxArena, namespaceName: String, name: String, isUnion: Bool): readonly SyntaxDeclaration
    let result = new SyntaxDeclaration(isUnion ? arena.kinds.getUnion() : arena.kinds.getStruct(), arena.accesses.getInternal())

    result.namespaceName = namespaceName
    result.name = name
    return result
  end

  readonly def renamed(name: String): readonly SyntaxDeclaration
    let result = new SyntaxDeclaration(this.kind, this.access)

    result.namespaceName = this.namespaceName
    result.name = name
    result.annotationCount = this.annotationCount
    result.parameterCount = this.parameterCount
    result.bodyCount = this.bodyCount
    result.isStatic = this.isStatic
    result.isUnsafe = this.isUnsafe
    result.isAlternative = this.isAlternative
    result.isResource = this.isResource
    return result
  end

  readonly def same(other: readonly SyntaxDeclaration): Bool
    return this.kind.same(other.kind) && this.namespaceName == other.namespaceName && this.name == other.name && this.access.same(other.access) && this.annotationCount == other.annotationCount && this.parameterCount == other.parameterCount && this.bodyCount == other.bodyCount && this.isStatic == other.isStatic && this.isUnsafe == other.isUnsafe && this.isAlternative == other.isAlternative && this.isResource == other.isResource
  end
end
