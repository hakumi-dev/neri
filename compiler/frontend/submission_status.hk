sealed class SubmissionStatus
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def complete(): SubmissionStatus
    return new SubmissionStatus(0)
  end

  readonly def isComplete(): Bool
    return this.tag == 0
  end

  static def incomplete(): SubmissionStatus
    return new SubmissionStatus(1)
  end

  readonly def isIncomplete(): Bool
    return this.tag == 1
  end

  static def invalid(): SubmissionStatus
    return new SubmissionStatus(2)
  end

  readonly def isInvalid(): Bool
    return this.tag == 2
  end

  readonly def name(): String
    if this.tag == 0
      return "complete"
    end
    if this.tag == 1
      return "incomplete"
    end
    return "invalid"
  end
end
