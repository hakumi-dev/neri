use arrays

## Stores indexed values in a geometrically grown array.
## Out-of-range reads return the fallback; out-of-range writes update it.
class ValueBuffer<T>
  private values: T[] = []
  private fallback: T
  public size: Int = 0

  def init(fallback: T): Void
    this.fallback = fallback
  end

  def add(value: T): Void
    if this.size == this.values.Length
      let previous = this.values
      let capacity = previous.Length == 0 ? 16 : previous.Length * 2

      this.values = arrays::generate<T>(capacity) do |index|
        return index < this.size ? previous[index] : this.fallback
      end
    end
    this.values[this.size] = value
    this.size = this.size + 1
  end

  def get(index: Int): T
    if index < 0 || index >= this.size
      return this.fallback
    end
    return this.values[index]
  end

  def set(index: Int, value: T): Void
    if index < 0 || index >= this.size
      this.fallback = value
      return
    end
    this.values[index] = value
  end

  def cursor(): BufferCursor<T>
    return new BufferCursor<T>(this)
  end
end
