use host

def emptyStrings(): String[]
  let values: String[] = []
  return values
end

def emptyInts(): Int[]
  let values: Int[] = []
  return values
end

class IntNode
  public value: Int = 0
  public nextNode: IntNode?
  public previousNode: IntNode?

  def init(value: Int): Void
    this.value = value
  end
end

class StringNode
  public value: String = ""
  public nextNode: StringNode?
  public previousNode: StringNode?

  def init(value: String): Void
    this.value = value
  end
end

class IntBuffer
  public first: IntNode = new IntNode(0)
  public last: IntNode = new IntNode(0)
  public cached: IntNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(value: Int): Void
    let node = new IntNode(value)
    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
  end

  def get(index: Int): Int
    return this.nodeAt(index).value
  end

  def nodeAt(index: Int): IntNode
    var node = this.cached
    var cursor = this.cachedIndex
    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  def set(index: Int, value: Int): Void
    this.nodeAt(index).value = value
  end
end

class StringBuffer
  public first: StringNode = new StringNode("")
  public last: StringNode = new StringNode("")
  public cached: StringNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(value: String): Void
    let node = new StringNode(value)
    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
  end

  def get(index: Int): String
    return this.nodeAt(index).value
  end

  def set(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def nodeAt(index: Int): StringNode
    var node = this.cached
    var cursor = this.cachedIndex
    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end
end

class TokenNode
  public kind: String = ""
  public start: Int = 0
  public length: Int = 0
  public text: String = ""
  public value: String = ""
  public nextNode: TokenNode?
  public previousNode: TokenNode?

  def init(kind: String, start: Int, length: Int, text: String, value: String): Void
    this.kind = kind
    this.start = start
    this.length = length
    this.text = text
    this.value = value
  end
end

class TokenBuffer
  public first: TokenNode = new TokenNode("", 0, 0, "", "")
  public last: TokenNode = new TokenNode("", 0, 0, "", "")
  public cached: TokenNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(kind: String, start: Int, length: Int, text: String, value: String): Void
    let node = new TokenNode(kind, start, length, text, value)
    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
  end

  def count(): Int
    return this.size
  end

  def nodeAt(index: Int): TokenNode
    var node = this.cached
    var cursor = this.cachedIndex
    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end

  def textAt(index: Int): String
    return this.nodeAt(index).text
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end
end

class DiagnosticBuffer
  public codes: StringBuffer = new StringBuffer()
  public starts: IntBuffer = new IntBuffer()
  public lengths: IntBuffer = new IntBuffer()
  public messages: StringBuffer = new StringBuffer()

  def init(): Void
    return
  end

  def add(code: String, start: Int, length: Int, message: String): Void
    var safeLength = length
    if safeLength < 1
      safeLength = 1
    end
    this.codes.add(code)
    this.starts.add(start)
    this.lengths.add(safeLength)
    this.messages.add(message)
  end

  def count(): Int
    return this.codes.size
  end
end

class SyntaxNode
  public kind: String = ""
  public data: String = ""
  public value: String = ""
  public start: Int = 0
  public length: Int = 1
  public secondaryStart: Int = 0
  public secondaryLength: Int = 1
  public irStart: Int = 0
  public irLength: Int = 1
  public children: Int[] = [0]
  public nextNode: SyntaxNode?
  public previousNode: SyntaxNode?

  def init(kind: String, data: String, children: Int[]): Void
    this.kind = kind
    this.data = data
    this.children = children
  end
end

class SyntaxArena
  public first: SyntaxNode = new SyntaxNode("", "", [0])
  public last: SyntaxNode = new SyntaxNode("", "", [0])
  public cached: SyntaxNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(kind: String, nodeData: String, nodeChildren: Int[]): Int
    let index = this.size
    let node = new SyntaxNode(kind, nodeData, nodeChildren)
    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.size
  end

  def nodeAt(index: Int): SyntaxNode
    var node = this.cached
    var cursor = this.cachedIndex
    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end

  def setAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)
    node.start = start
    node.length = length
    node.secondaryStart = start
    node.secondaryLength = length
    node.irStart = start
    node.irLength = length
  end

  def secondaryStartAt(index: Int): Int
    return this.nodeAt(index).secondaryStart
  end

  def secondaryLengthAt(index: Int): Int
    return this.nodeAt(index).secondaryLength
  end

  def setSecondaryAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)
    node.secondaryStart = start
    node.secondaryLength = length
  end

  def irStartAt(index: Int): Int
    return this.nodeAt(index).irStart
  end

  def irLengthAt(index: Int): Int
    return this.nodeAt(index).irLength
  end

  def setIrAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)
    node.irStart = start
    node.irLength = length
  end

  def childStartAt(index: Int): Int
    return 0
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end
end

def appendChild(children: Int[], child: Int): Int[]
  if child >= 0
    return host.appendInt(children, child)
  end
  return children
end
