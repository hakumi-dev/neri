class BootstrapLibraryReferences
  public control: AnalysisControl?
  private aliases: StringTable<Bool> = new StringTable<Bool>()
  private imported: StringTable<Bool> = new StringTable<Bool>()
  private qualified: StringTable<Bool> = new StringTable<Bool>()
  private imports: StringBuffer = new StringBuffer()
  private roots: StringBuffer = new StringBuffer()
  private aliasNames: StringBuffer = new StringBuffer()

  def addSource(source: String): Void
    let lexer = new BootstrapLexer(source)

    lexer.control = this.control
    let tokens = lexer.lex()
    let control = this.control
    var index = 0

    while index + 1 < tokens.count()
      if control != null && !control.checkpoint()
        return
      end
      if tokens.kindAt(index).isUse() && tokens.kindAt(index + 1).isIdentifier()
        var target = index + 1

        if index + 3 < tokens.count() && tokens.kindAt(index + 2).isEqual() && tokens.kindAt(index + 3).isIdentifier()
          let alias = tokens.textAt(index + 1)

          if this.aliases.add(alias, true)
            this.aliasNames.add(alias)
          end
          target = index + 3
        end
        let name = tokens.textAt(target)

        if this.imported.add(name, true)
          this.imports.add(name)
        end
      else if tokens.kindAt(index).isIdentifier() && tokens.kindAt(index + 1).isDoubleColon()
        let previous = tokens.kindAt(index - 1)

        if index == 0 || (!previous.isDoubleColon() && !previous.isDot() && !previous.isNamespace())
          let name = tokens.textAt(index)

          if this.qualified.add(name, true)
            this.roots.add(name)
          end
        end
      end
      index = index + 1
    end
  end

  def merge(other: BootstrapLibraryReferences): Void
    var alias = other.aliasNames.cursor()

    while alias.hasValue()
      if this.aliases.add(alias.current(), true)
        this.aliasNames.add(alias.current())
      end
      alias.advance()
    end
    var imported = other.imports.cursor()

    while imported.hasValue()
      if this.imported.add(imported.current(), true)
        this.imports.add(imported.current())
      end
      imported.advance()
    end
    var root = other.roots.cursor()

    while root.hasValue()
      if this.qualified.add(root.current(), true)
        this.roots.add(root.current())
      end
      root.advance()
    end
  end

  def libraryNames(): String[]
    var result: String[] = [bootstrapCoreLibraryName()]
    let seen = new StringTable<Bool>()

    seen.add(bootstrapCoreLibraryName(), true)
    var imported = this.imports.cursor()

    while imported.hasValue()
      if seen.add(imported.current(), true)
        result = host::appendString(result, imported.current())
      end
      imported.advance()
    end
    var root = this.roots.cursor()

    while root.hasValue()
      if this.aliases.find(root.current()) == null && seen.add(root.current(), true)
        result = host::appendString(result, root.current())
      end
      root.advance()
    end
    return result
  end
end
