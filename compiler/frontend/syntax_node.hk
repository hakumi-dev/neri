use host

class SyntaxNode
  public declaration: readonly SyntaxDeclaration?
  public importDeclaration: readonly SyntaxUse?
  public modifierKind: readonly ModifierKind?
  public parameterMode: readonly ParameterMode
  public annotationKind: readonly AnnotationKind
  public typeParameters: String[] = []
  public typeParameterConstraints: Int[]
  public typeArguments: Int[]
  public classAnnotations: Int[]
  public modifiers: Int[]
  public kind: readonly SyntaxKind
  public operatorKind: readonly TokenKind?
  public data: String = ""
  public value: String = ""
  public start: Int = 0
  public length: Int = 1
  public secondaryStart: Int = 0
  public secondaryLength: Int = 1
  public irStart: Int = 0
  public irLength: Int = 1
  public statementStart: Int = -1
  public children: Int[]
  public nextNode: SyntaxNode?
  public previousNode: SyntaxNode?

  def init(kind: readonly SyntaxKind, data: String, children: Int[], parameterMode: readonly ParameterMode, annotationKind: readonly AnnotationKind, declaration: readonly SyntaxDeclaration? = null, modifierKind: readonly ModifierKind? = null, importDeclaration: readonly SyntaxUse? = null): Void
    syntaxInvariant(syntaxDeclarationKind(kind) == (declaration != null))
    syntaxInvariant(kind.isModifier() == (modifierKind != null))
    syntaxInvariant(kind.isUse() == (importDeclaration != null))
    this.importDeclaration = importDeclaration
    if declaration != null
      syntaxInvariant(kind.same(declaration.kind))
    end
    this.declaration = declaration
    this.modifierKind = modifierKind
    this.parameterMode = parameterMode
    this.annotationKind = annotationKind
    this.kind = kind
    this.data = data
    let emptyIndices: Int[] = []

    this.typeParameterConstraints = emptyIndices
    this.typeArguments = emptyIndices
    this.classAnnotations = emptyIndices
    this.modifiers = emptyIndices
    this.children = children
  end
end
