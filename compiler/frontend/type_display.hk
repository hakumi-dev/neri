def syntaxTypeSuffixText(typeSyntax: readonly TypeSyntax): String
  var result = ""
  var suffix = typeSyntax.suffixes

  while suffix != null
    let kind = suffix.kind
    let spelling = kind.isManagedArray() ? "[]" : (kind.isOptional() ? "?" : (kind.isPointer() ? "*" : "[" + suffix.lengthText + "]"))

    result = spelling + result
    suffix = suffix.inner
  end
  return result
end

# Render source notation only for diagnostics, editor presentation and debug output.
def syntaxTypeDisplay(arena: SyntaxArena, node: Int): String
  let typeSyntax = arena.typeAt(node)
  let kind = typeSyntax.kind
  var result = typeSyntax.name

  if kind.isGrouped()
    result = "(" + syntaxTypeDisplay(arena, arena.childAt(node, 0)) + ")"
  else if kind.isReadonly() || kind.isFields()
    result = (kind.isReadonly() ? "readonly " : "fields of ") + syntaxTypeDisplay(arena, arena.childAt(node, 0))
  else if kind.isFunction()
    let flavor = typeSyntax.flavor

    result = (flavor.isShared() ? "shared " : (flavor.isParallel() ? "parallel " : (flavor.isQuotation() ? "quote " : (flavor.isCAbi() ? "cabi " : "")))) + "fn("
    var index = 0

    while index < arena.childCountAt(node) - 1
      result = result + (index == 0 ? "" : ", ") + syntaxTypeDisplay(arena, arena.childAt(node, index))
      index = index + 1
    end
    result = result + "): " + syntaxTypeDisplay(arena, arena.childAt(node, index))
  else if kind.isError()
    result = "<error>"
  end
  let arguments = arena.nodeAt(node).typeArguments
  var argument = 0

  while argument < arguments.Length
    result = result + (argument == 0 ? "<" : ", ") + syntaxTypeDisplay(arena, arguments[argument])
    argument = argument + 1
  end
  if arguments.Length > 0
    result = result + ">"
  end
  return result + syntaxTypeSuffixText(typeSyntax)
end

def syntaxTypeContainsPointer(arena: SyntaxArena, node: Int): Bool
  let typeSyntax = arena.typeAt(node)

  if typeSyntax.kind.isFunction() && typeSyntax.flavor.isCAbi()
    return true
  end
  var suffix = typeSyntax.suffixes

  while suffix != null
    if suffix.kind.isPointer()
      return true
    end
    suffix = suffix.inner
  end
  return typeSyntax.kind.isGrouped() && syntaxTypeContainsPointer(arena, arena.childAt(node, 0))
end
