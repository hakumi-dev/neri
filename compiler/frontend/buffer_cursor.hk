## Traverses a buffer, including values appended before the cursor advances.
class BufferCursor<T>
  private buffer: ValueBuffer<T>
  private index: Int = 0

  def init(buffer: ValueBuffer<T>): Void
    this.buffer = buffer
  end

  def hasValue(): Bool
    return this.index < this.buffer.size
  end

  def current(): T
    return this.buffer.get(this.index)
  end

  def replace(value: T): Void
    this.buffer.set(this.index, value)
  end

  def advance(): Void
    this.index = this.index + 1
  end
end
