def parseNativeRecord(parser: BootstrapParser, namespaceName: String): Int
  let block = parser.beginBlock()
  let kind = parser.currentKind()

  parser.next()
  let name = parser.expect(parser.tokens.kinds.getIdentifier())

  parser.openBlock(block)
  parser.requireNewLine()
  var fields: Int[] = []

  while !parser.currentKind().isEnd() && !parser.currentKind().isEndOfFile()
    let before = parser.position

    parser.skipNewLines()
    if parser.currentKind().isEnd() || parser.currentKind().isEndOfFile()
      break
    end
    let fieldName = parser.expect(parser.tokens.kinds.getIdentifier())

    parser.expect(parser.tokens.kinds.getColon())
    let fieldType = parser.parseTypeName()

    fields = host::appendInt(fields, parser.anchorToken(parser.addNode(parser.arena.kinds.getNativeField(), parser.tokens.textAt(fieldName), [fieldType]), fieldName))
    parser.requireNewLine()
    if parser.position == before
      parser.next()
    end
  end
  parser.closeBlock(block)
  parser.expect(parser.tokens.kinds.getEnd())
  return parser.anchorToken(parser.arena.addDeclaration(SyntaxDeclaration.nativeRecord(parser.arena, namespaceName, parser.tokens.textAt(name), kind.isUnion()), fields), name)
end
