def parseNativeRecord(parser: BootstrapParser, namespaceName: String): Int
  let kind = parser.currentKind()
  parser.next()
  let name = parser.expect("Identifier")
  parser.requireNewLine()
  var fields: Int[] = []
  while parser.currentKind() != "End" && parser.currentKind() != "EndOfFile"
    let before = parser.position
    parser.skipNewLines()
    if parser.currentKind() == "End" || parser.currentKind() == "EndOfFile"
      break
    end
    let fieldName = parser.expect("Identifier")
    parser.expect("Colon")
    let fieldType = parser.parseTypeName()
    fields = host.appendInt(fields, parser.anchorToken(parser.addNode("NativeField", parser.tokens.textAt(fieldName), [fieldType]), fieldName))
    parser.requireNewLine()
    if parser.position == before
      parser.next()
    end
  end
  parser.expect("End")
  return parser.anchorToken(parser.addNode(kind, namespaceName + "|" + parser.tokens.textAt(name), fields), name)
end
