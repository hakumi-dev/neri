use host

class SyntaxArena
  public parent: SyntaxArena?
  private baseCount: Int = 0
  public kinds: SyntaxKindCatalog
  public parameterModes: ParameterModeCatalog
  public annotations: AnnotationKindCatalog
  public accesses: SourceAccessCatalog
  public modifiers: ModifierKindCatalog
  public contextualRoles: ContextualRoleCatalog
  public blockKinds: BlockKindCatalog
  public typeKinds: TypeSyntaxKindCatalog
  public functionFlavors: FunctionTypeFlavorCatalog
  public typeSuffixes: TypeSuffixKindCatalog
  private absentType: readonly TypeSyntax
  public first: SyntaxNode
  public last: SyntaxNode
  public cached: SyntaxNode?
  public cachedIndex: Int = -1
  public size: Int = 0
  private checkpoints: ArenaCheckpointIndex<SyntaxNode>

  def init(parent: SyntaxArena? = null): Void
    this.parent = parent
    if parent != null
      this.baseCount = parent.count()
      this.kinds = parent.kinds
      this.parameterModes = parent.parameterModes
      this.annotations = parent.annotations
      this.accesses = parent.accesses
      this.modifiers = parent.modifiers
      this.contextualRoles = parent.contextualRoles
      this.blockKinds = parent.blockKinds
      this.typeKinds = parent.typeKinds
      this.functionFlavors = parent.functionFlavors
      this.typeSuffixes = parent.typeSuffixes
      this.absentType = parent.absentType
    else
      this.kinds = new SyntaxKindCatalog()
      this.parameterModes = new ParameterModeCatalog()
      this.annotations = new AnnotationKindCatalog()
      this.accesses = new SourceAccessCatalog()
      this.modifiers = new ModifierKindCatalog()
      this.contextualRoles = new ContextualRoleCatalog()
      this.blockKinds = new BlockKindCatalog()
      this.typeKinds = new TypeSyntaxKindCatalog()
      this.functionFlavors = new FunctionTypeFlavorCatalog()
      this.typeSuffixes = new TypeSuffixKindCatalog()
      this.absentType = TypeSyntax.form(this, this.typeKinds.getAbsent())
    end
    this.first = new SyntaxNode(this.kinds.getInvalid(), "", [0], this.parameterModes.getOrdinary(), this.annotations.getUnknown(), this.absentType)
    this.last = this.first
    this.cached = this.first
    this.checkpoints = new ArenaCheckpointIndex<SyntaxNode>(this.first)
  end

  def add(kind: readonly SyntaxKind, nodeData: String, nodeChildren: Int[]): Int
    syntaxInvariant(!syntaxDeclarationKind(kind) && !kind.isModifier() && !kind.isProgram() && !kind.isIf() && !kind.isMatchCase() && !kind.isClosure() && !kind.isType() && !kind.isUse())
    return this.append(kind, nodeData, nodeChildren)
  end

  def addDeclaration(declaration: readonly SyntaxDeclaration, children: Int[]): Int
    if declaration.kind.isFunction()
      syntaxInvariant(children.Length == declaration.annotationCount + declaration.parameterCount + declaration.bodyCount + 1)
    else if declaration.kind.isMethod()
      syntaxInvariant(children.Length == declaration.annotationCount + 1)
    else if declaration.kind.isField()
      syntaxInvariant(children.Length >= 1 && children.Length <= 2)
    end
    return this.append(declaration.kind, "", children, declaration)
  end

  def declarationAt(index: Int): readonly SyntaxDeclaration?
    return this.nodeAt(index).declaration
  end

  def addUse(importDeclaration: readonly SyntaxUse, children: Int[]): Int
    syntaxInvariant(children.Length == (importDeclaration.alias == "" ? 1 : 2))
    return this.append(this.kinds.getUse(), "", children, null, null, null, null, null, importDeclaration)
  end

  def useAt(index: Int): readonly SyntaxUse?
    return this.nodeAt(index).importDeclaration
  end

  def addModifier(modifier: readonly ModifierKind): Int
    syntaxInvariant(!modifier.isUnknown())
    return this.append(this.kinds.getModifier(), "", [], null, modifier)
  end

  def addProgram(program: readonly SyntaxProgram, children: Int[]): Int
    syntaxInvariant(program.childCount() == children.Length)
    return this.append(this.kinds.getProgram(), "", children, null, null, program)
  end

  def programUseCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.useCount
    end
    return 0
  end

  def programClassCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.classCount
    end
    return 0
  end

  def programFunctionCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.functionCount
    end
    return 0
  end

  def programRecordCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.recordCount
    end
    return 0
  end

  def programContractCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.contractCount
    end
    return 0
  end

  def programNamespaceCount(index: Int): Int
    let program = this.nodeAt(index).program

    syntaxInvariant(program != null)
    if program != null
      return program.namespaceCount
    end
    return 0
  end

  def addPartition(partition: readonly SyntaxPartition, children: Int[]): Int
    syntaxInvariant(partition.firstCount + partition.secondCount + 1 == children.Length)
    return this.append(partition.kind, "", children, null, null, null, partition)
  end

  def firstGroupCount(index: Int): Int
    let partition = this.nodeAt(index).partition

    syntaxInvariant(partition != null)
    if partition != null
      return partition.firstCount
    end
    return 0
  end

  def secondGroupCount(index: Int): Int
    let partition = this.nodeAt(index).partition

    syntaxInvariant(partition != null)
    if partition != null
      return partition.secondCount
    end
    return 0
  end

  def addType(typeSyntax: readonly TypeSyntax, children: Int[]): Int
    syntaxInvariant(!typeSyntax.kind.isAbsent())
    if typeSyntax.kind.isGrouped() || typeSyntax.kind.isReadonly() || typeSyntax.kind.isFields()
      syntaxInvariant(children.Length == 1)
    else if typeSyntax.kind.isFunction()
      syntaxInvariant(children.Length >= 1)
    end
    return this.append(this.kinds.getType(), "", children, null, null, null, null, typeSyntax)
  end

  def typeAt(index: Int): readonly TypeSyntax
    syntaxInvariant(this.kindAt(index).isType())
    return this.nodeAt(index).typeSyntax
  end

  private def append(kind: readonly SyntaxKind, nodeData: String, nodeChildren: Int[], declaration: readonly SyntaxDeclaration? = null, modifier: readonly ModifierKind? = null, program: readonly SyntaxProgram? = null, partition: readonly SyntaxPartition? = null, typeSyntax: readonly TypeSyntax? = null, importDeclaration: readonly SyntaxUse? = null): Int
    let index = this.parentOffset() + this.size
    var typeValue = this.absentType

    if typeSyntax != null
      typeValue = typeSyntax
    end
    let node = new SyntaxNode(kind, nodeData, nodeChildren, this.parameterModes.getOrdinary(), this.annotations.getUnknown(), typeValue, declaration, modifier, program, partition, importDeclaration)

    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    if (this.size / arenaCheckpointBlockSize()) * arenaCheckpointBlockSize() == this.size
      this.checkpoints.add(node)
    end
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.parentOffset() + this.size
  end

  def nodeAt(index: Int): SyntaxNode
    let offset = this.parentOffset()

    if index < offset
      let parent = this.parent

      if parent != null
        return parent.nodeAt(index)
      end
      return this.first
    end
    let localIndex = index - offset
    var node = this.cached
    var cursor = this.cachedIndex
    let blockSize = arenaCheckpointBlockSize()
    let checkpointIndex = (localIndex / blockSize) * blockSize

    if node == null
      node = this.checkpoints.get(localIndex / blockSize)
      cursor = checkpointIndex
    else
      let distance = localIndex < cursor ? cursor - localIndex : localIndex - cursor

      if distance > 1 && distance > localIndex - checkpointIndex
        node = this.checkpoints.get(localIndex / blockSize)
        cursor = checkpointIndex
      end
    end
    while cursor > localIndex
      if node != null
        node = node.previousNode
      end
      cursor = cursor - 1
    end
    while cursor < localIndex
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  private def parentOffset(): Int
    return this.baseCount
  end

  def kindAt(index: Int): readonly SyntaxKind
    return this.nodeAt(index).kind
  end

  def annotationAt(index: Int): readonly AnnotationKind
    return this.nodeAt(index).annotationKind
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end

  def setAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.start = start
    node.length = length
    node.secondaryStart = start
    node.secondaryLength = length
    node.irStart = start
    node.irLength = length
  end

  def secondaryStartAt(index: Int): Int
    return this.nodeAt(index).secondaryStart
  end

  def secondaryLengthAt(index: Int): Int
    return this.nodeAt(index).secondaryLength
  end

  def setSecondaryAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.secondaryStart = start
    node.secondaryLength = length
  end

  def irStartAt(index: Int): Int
    return this.nodeAt(index).irStart
  end

  def irLengthAt(index: Int): Int
    return this.nodeAt(index).irLength
  end

  def setIrAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.irStart = start
    node.irLength = length
  end

  def statementStartAt(index: Int): Int
    return this.nodeAt(index).statementStart
  end

  def setStatementStart(index: Int, start: Int): Void
    this.nodeAt(index).statementStart = start
  end

  def childStartAt(index: Int): Int
    return 0
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end
end
