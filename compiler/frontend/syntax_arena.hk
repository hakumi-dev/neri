use host

class SyntaxArena
  public parent: SyntaxArena?
  private baseCount: Int = 0
  public first: SyntaxNode = new SyntaxNode("", "", [0])
  public last: SyntaxNode = new SyntaxNode("", "", [0])
  public cached: SyntaxNode?
  public cachedIndex: Int = -1
  public size: Int = 0
  private checkpoints: ArenaCheckpointIndex<SyntaxNode>

  def init(parent: SyntaxArena? = null): Void
    this.parent = parent
    if parent != null
      this.baseCount = parent.count()
    end
    this.last = this.first
    this.cached = this.first
    this.checkpoints = new ArenaCheckpointIndex<SyntaxNode>(this.first)
  end

  def add(kind: String, nodeData: String, nodeChildren: Int[]): Int
    let index = this.parentOffset() + this.size
    let node = new SyntaxNode(kind, nodeData, nodeChildren)

    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    if (this.size / arenaCheckpointBlockSize()) * arenaCheckpointBlockSize() == this.size
      this.checkpoints.add(node)
    end
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.parentOffset() + this.size
  end

  def nodeAt(index: Int): SyntaxNode
    let offset = this.parentOffset()

    if index < offset
      let parent = this.parent

      if parent != null
        return parent.nodeAt(index)
      end
      return this.first
    end
    let localIndex = index - offset
    var node = this.cached
    var cursor = this.cachedIndex
    let blockSize = arenaCheckpointBlockSize()
    let checkpointIndex = (localIndex / blockSize) * blockSize

    if node == null
      node = this.checkpoints.get(localIndex / blockSize)
      cursor = checkpointIndex
    else
      let distance = localIndex < cursor ? cursor - localIndex : localIndex - cursor

      if distance > 1 && distance > localIndex - checkpointIndex
        node = this.checkpoints.get(localIndex / blockSize)
        cursor = checkpointIndex
      end
    end
    while cursor > localIndex
      if node != null
        node = node.previousNode
      end
      cursor = cursor - 1
    end
    while cursor < localIndex
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  private def parentOffset(): Int
    return this.baseCount
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end

  def setAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.start = start
    node.length = length
    node.secondaryStart = start
    node.secondaryLength = length
    node.irStart = start
    node.irLength = length
  end

  def secondaryStartAt(index: Int): Int
    return this.nodeAt(index).secondaryStart
  end

  def secondaryLengthAt(index: Int): Int
    return this.nodeAt(index).secondaryLength
  end

  def setSecondaryAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.secondaryStart = start
    node.secondaryLength = length
  end

  def irStartAt(index: Int): Int
    return this.nodeAt(index).irStart
  end

  def irLengthAt(index: Int): Int
    return this.nodeAt(index).irLength
  end

  def setIrAnchor(index: Int, start: Int, length: Int): Void
    let node = this.nodeAt(index)

    node.irStart = start
    node.irLength = length
  end

  def statementStartAt(index: Int): Int
    return this.nodeAt(index).statementStart
  end

  def setStatementStart(index: Int, start: Int): Void
    this.nodeAt(index).statementStart = start
  end

  def childStartAt(index: Int): Int
    return 0
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end
end
