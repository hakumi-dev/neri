def bootstrapCoreLibraryName(): String
  return "core"
end

def bootstrapCoreLibraryPath(): String?
  let directory = host::environment("NERI_STDLIB")

  if directory == null || directory == ""
    return null
  end
  return neriCanonicalPath(directory + "/" + bootstrapCoreLibraryName() + ".hk")
end

def bootstrapCoreLibrarySource(): String?
  let path = bootstrapCoreLibraryPath()

  if path == null
    return null
  end
  return host::readText(path)
end

def bootstrapLibraryImports(source: String): String[]
  let references = new BootstrapLibraryReferences()

  references.addSource(source)
  return references.libraryNames()
end
