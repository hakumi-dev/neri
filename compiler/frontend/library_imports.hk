def bootstrapCoreLibraryName(): String
  return "core"
end

def bootstrapCoreLibraryPath(): String?
  let directory = host.environment("NERI_STDLIB")

  if directory == null || directory == ""
    return null
  end
  return neriCanonicalPath(directory + "/" + bootstrapCoreLibraryName() + ".hk")
end

def bootstrapCoreLibrarySource(): String?
  let path = bootstrapCoreLibraryPath()

  if path == null
    return null
  end
  return host.readText(path)
end

def bootstrapLibraryImports(source: String): String[]
  let tokens = (new BootstrapLexer(source)).lex()
  var names: String[] = [bootstrapCoreLibraryName()]
  var index = 0

  while index + 1 < tokens.count()
    if tokens.kindAt(index).isUse() && tokens.kindAt(index + 1).isIdentifier()
      let name = tokens.textAt(index + 1)
      var known = false

      for existing in names
        known = true if existing == name
      end
      names = host.appendString(names, name) if !known
    end
    index = index + 1
  end
  return names
end
