def bootstrapLibraryImports(source: String): String[]
  let tokens = (new BootstrapLexer(source)).lex()
  var names: String[] = []
  var index = 0
  while index + 1 < tokens.count()
    if tokens.kindAt(index) == "Use" && tokens.kindAt(index + 1) == "Identifier"
      let name = tokens.textAt(index + 1)
      var known = false
      for existing in names
        known = true if existing == name
      end
      names = host.appendString(names, name) if !known
    end
    index = index + 1
  end
  return names
end
