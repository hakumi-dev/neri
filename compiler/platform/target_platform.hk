sealed class TargetPlatform
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def macOS(): TargetPlatform
    return new TargetPlatform(1)
  end

  static def linux(): TargetPlatform
    return new TargetPlatform(2)
  end

  static def windows(): TargetPlatform
    return new TargetPlatform(3)
  end

  static def parse(value: String): TargetPlatform?
    return TargetPlatform.macOS() if value == "macos-arm64"
    return TargetPlatform.linux() if value == "linux-x86_64"
    return TargetPlatform.windows() if value == "windows-x86_64"
    return null
  end

  readonly def isMacOS(): Bool
    return this.tag == 1
  end

  readonly def isLinux(): Bool
    return this.tag == 2
  end

  readonly def isWindows(): Bool
    return this.tag == 3
  end

  readonly def name(): String
    return "macos-arm64" if this.isMacOS()
    return "linux-x86_64" if this.isLinux()
    return "windows-x86_64"
  end

  readonly def triple(): String
    return "arm64-apple-macos" if this.isMacOS()
    return "x86_64-unknown-linux-gnu" if this.isLinux()
    return "x86_64-pc-windows-msvc"
  end

  readonly def linker(): String
    return "/usr/bin/clang++" if this.isMacOS()
    return "clang++-22" if this.isLinux()
    return "clang++.exe"
  end

  readonly def sameAs(other: readonly TargetPlatform): Bool
    return this.tag == other.tag
  end
end
