use host

class SessionDiagnostic
  public code: String
  public start: Int
  public length: Int
  public message: String
  public next: SessionDiagnostic?

  def init(code: String, start: Int, length: Int, message: String): Void
    this.code = code
    this.start = start
    this.length = length
    this.message = message
  end
end
