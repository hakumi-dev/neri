sealed class SessionCompletionStatus
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def complete(): SessionCompletionStatus
    return new SessionCompletionStatus(0)
  end

  readonly def isComplete(): Bool
    return this.tag == 0
  end

  static def disposed(): SessionCompletionStatus
    return new SessionCompletionStatus(1)
  end

  readonly def isDisposed(): Bool
    return this.tag == 1
  end

  static def unavailable(): SessionCompletionStatus
    return new SessionCompletionStatus(2)
  end

  readonly def isUnavailable(): Bool
    return this.tag == 2
  end

  static def invalidPosition(): SessionCompletionStatus
    return new SessionCompletionStatus(3)
  end

  readonly def isInvalidPosition(): Bool
    return this.tag == 3
  end

  static def limit(): SessionCompletionStatus
    return new SessionCompletionStatus(4)
  end

  readonly def isLimit(): Bool
    return this.tag == 4
  end

  readonly def name(): String
    if this.tag == 0
      return "complete"
    end
    if this.tag == 1
      return "disposed"
    end
    if this.tag == 2
      return "unavailable"
    end
    if this.tag == 3
      return "invalid-position"
    end
    return "limit"
  end
end
