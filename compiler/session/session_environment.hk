use host

class SessionEnvironment
  private identity: String
  private environmentIdentity: Int
  private baseSource: String = ""
  private snapshot: SessionSourceSnapshot?
  private initializationError: String = ""
  private nextCandidateId: Int = 1
  private firstBinding: SessionBinding?
  private generation: Int = 0
  private declarationsUsed: Int = 0
  private bindingsUsed: Int = 0
  private sourceBytes: Int = 0
  private disposed: Bool = false
  private pending: PendingSubmission?
  private pendingCount: Int = 0
  private compilation: SessionCompilation?
  private completionImports: StringBuffer = new StringBuffer()

  def init(identity: String, snapshot: SessionSourceSnapshot? = null): Void
    this.identity = identity
    this.completionImports = bootstrapInstalledLibraryNames()
    unsafe
      this.environmentIdentity = sessionEnvironmentIdentity()
    end
    if snapshot != null
      let frozen = snapshot.frozenCopy()

      this.snapshot = frozen
      this.baseSource = frozen.source()
      this.initializationError = frozen.error
    end
  end

  def prepare(source: String): PreparedSubmission
    let prepared = new PreparedSubmission(this.generation, this.identity, this.environmentIdentity, this.nextCandidateId)

    this.nextCandidateId = this.nextCandidateId + 1
    if this.disposed
      prepared.addDiagnostic("NR_SESSION_DISPOSED", 0, 1, "The session has been disposed.")
      return prepared
    end
    if this.initializationError != ""
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, this.initializationError)
      return prepared
    end
    let size = host::stringByteLength(source)

    if size > 1048576 || this.sourceBytes > 1048576 - size
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session source exceeds the 1048576-byte limit.")
      return prepared
    end
    let lexer = new BootstrapLexer(source)
    let tokens = lexer.lex()

    if rejectReservedSessionNames(tokens, prepared)
      return prepared
    end
    let referencedBindings = sessionReferencedBindings(this.firstBinding, tokens)
    let parser = new BootstrapParser(tokens)
    let submission = parser.parseSubmission()

    prepared.status = submission.status
    if tokens.count() > 1
      let finalToken = tokens.count() - 2

      if tokens.kindAt(finalToken).isBadToken() && startsWithQuote(tokens.textAt(finalToken))
        prepared.status = SubmissionStatus.incomplete()
      end
    end
    if parser.diagnostics.count() > 0
      copySessionDiagnostics(parser.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    prepared.declarations = submissionParts(source, submission.declarationStarts, submission.declarationLengths)
    prepared.statements = submissionParts(source, submission.statementStarts, submission.statementLengths)
    prepared.declarationCount = submission.declarationCount
    if this.declarationsUsed + prepared.declarationCount > 1024
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session declaration count exceeds 1024.")
      return prepared
    end
    let retained = this.compilation
    var sourceOffset = 0
    var retainedModel: SemanticModel? = null
    var retainedSyntax: SyntaxArena? = null
    var contextSource = this.baseSource
    var firstLibrary = 0

    if retained != null
      sourceOffset = retained.sourceEnd
      retainedModel = retained.model
      retainedSyntax = retained.syntax
      contextSource = ""
      let snapshot = this.snapshot

      if snapshot != null
        firstLibrary = snapshot.libraryCount()
      end
    end
    let declarationOffset = sourceOffset + utf16Length(contextSource)
    let prefix = contextSource + prepared.declarations + entryPrefix(this.generation, referencedBindings)
    let analysisProgram = prefix + indentSubmission(prepared.statements) + "end\n"
    var candidateSnapshot = new SessionSourceSnapshot()
    let currentSnapshot = this.snapshot

    if currentSnapshot != null
      candidateSnapshot = currentSnapshot.frozenCopy()
    end
    candidateSnapshot.captureLibraries(contextSource + prepared.declarations + prepared.statements)
    if candidateSnapshot.error != ""
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, candidateSnapshot.error)
      return prepared
    end
    let librarySource = candidateSnapshot.librarySuffix(firstLibrary)

    prepared.analysisSource = analysisProgram + librarySource
    let analysisLexer = new BootstrapLexer(analysisProgram + librarySource)

    analysisLexer.utf16Position = sourceOffset
    let analysisTokens = analysisLexer.lex()
    let analysisParser = new BootstrapParser(analysisTokens, retainedSyntax)

    analysisParser.sessionExpressions = true
    if retained == null
      candidateSnapshot.applyBoundaries(analysisParser, utf16Length(analysisProgram) - utf16Length(this.baseSource))
    else
      candidateSnapshot.applyLibraryBoundaries(analysisParser, sourceOffset + utf16Length(analysisProgram), firstLibrary)
    end
    let root = analysisParser.parseProgram()

    if analysisParser.diagnostics.count() > 0
      prepared.status = SubmissionStatus.invalid()
      copyMappedDiagnostics(analysisParser.diagnostics, prepared, source, submission,
        declarationOffset, sourceOffset + utf16Length(prefix))
      return prepared
    end
    let binder = new BootstrapBinder(analysisParser.arena, root, analysisTokens.startAt(analysisTokens.count() - 1), retainedModel)

    binder.requireEntryPoint = false
    binder.allowSessionEntryReplacement = true
    candidateSnapshot.applyLibrarySources(binder, sourceOffset + utf16Length(analysisProgram), firstLibrary)
    let model = binder.bind()

    if model.diagnostics.count() > 0
      prepared.status = SubmissionStatus.invalid()
      copyMappedDiagnostics(model.diagnostics, prepared, source, submission,
        declarationOffset, sourceOffset + utf16Length(prefix))
      return prepared
    end
    let entry = model.findFunction(prepared.entryName)

    if entry == null
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_INTERNAL", 0, 1, "Generated session entry is missing.")
      return prepared
    end
    var executionStatements = prepared.statements
    let bodyCount = model.bound.childCountAt(entry.boundNode)

    if submission.statementCount > 0 && bodyCount > 0
      let finalStatement = model.bound.childAt(entry.boundNode, bodyCount - 1)

      if model.bound.kindAt(finalStatement).isExpressionStatement()
        let expression = model.bound.childAt(finalStatement, 0)

        prepared.resultType = model.bound.typeAt(expression)
        if prepared.resultType != "Void"
          let last = submission.statementStarts.size - 1
          let tail = submissionPart(source, submission.statementStarts.get(last), submission.statementLengths.get(last))
          let byteStart = host::stringByteLength(prepared.statements) - host::stringByteLength(tail)

          executionStatements = host::stringSlice(prepared.statements, 0, byteStart) + "let __neri_session_result = " + tail
        end
      end
    end
    var local = entry.firstSessionLocal

    while local != null
      if !this.hasBinding(local.name)
        let binding = new SessionBinding(local.name, local.typeName, local.mutable, local.name)

        binding.identity = "session/" + (this.generation as String) + "/" + local.identity
        prepared.addBinding(binding)
      end
      local = local.nextLocal
    end
    collectSubmittedTypes(model, analysisParser.arena, prepared, declarationOffset, utf16Length(prepared.declarations))
    if this.bindingsUsed + prepared.bindingCount > 1024
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session binding count exceeds 1024.")
      prepared.firstBinding = null
      prepared.bindingCount = 0
      return prepared
    end
    prepared.frameSource = sessionFrameSource(this.generation, prepared.firstBinding)
    prepared.executionSource = contextSource + prepared.declarations + prepared.frameSource + executionEntrySource(this.generation, referencedBindings, prepared.firstBinding, executionStatements, prepared.resultType)
    let executionProgram = prepared.executionSource
    let executionAnalysisSource = executionProgram + librarySource
    let executionLexer = new BootstrapLexer(executionProgram + librarySource)

    executionLexer.utf16Position = sourceOffset
    let executionTokens = executionLexer.lex()
    let executionParser = new BootstrapParser(executionTokens, retainedSyntax)

    if retained == null
      candidateSnapshot.applyBoundaries(executionParser, utf16Length(executionProgram) - utf16Length(this.baseSource))
    else
      candidateSnapshot.applyLibraryBoundaries(executionParser, sourceOffset + utf16Length(executionProgram), firstLibrary)
    end
    let executionRoot = executionParser.parseProgram()

    if executionParser.diagnostics.count() > 0
      prepared.status = SubmissionStatus.invalid()
      copyMappedDiagnostics(executionParser.diagnostics, prepared, source, submission,
        declarationOffset, sourceOffset + utf16Length(contextSource + prepared.declarations + prepared.frameSource + executionEntryPrefix(this.generation, referencedBindings)))
      return prepared
    end
    let executionBinder = new BootstrapBinder(executionParser.arena, executionRoot, executionTokens.startAt(executionTokens.count() - 1), retainedModel)

    executionBinder.requireEntryPoint = false
    executionBinder.allowSessionEntryReplacement = true
    candidateSnapshot.applyLibrarySources(executionBinder, sourceOffset + utf16Length(executionProgram), firstLibrary)
    let executionModel = executionBinder.bind()

    if executionModel.diagnostics.count() > 0
      prepared.status = SubmissionStatus.invalid()
      copyMappedDiagnostics(executionModel.diagnostics, prepared, source, submission,
        declarationOffset, sourceOffset + utf16Length(contextSource + prepared.declarations + prepared.frameSource + executionEntryPrefix(this.generation, referencedBindings)))
      return prepared
    end
    prepared.status = SubmissionStatus.complete()
    if !this.register(prepared, candidateSnapshot, new SessionCompilation(executionModel, executionParser.arena, executionAnalysisSource, retained))
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session has 1024 active prepared submissions.")
    end
    return prepared
  end

  def complete(source: String, cursorByteOffset: Int): SessionCompletionResult
    if this.disposed || this.initializationError != ""
      let result = new SessionCompletionResult()

      result.status = this.disposed ? SessionCompletionStatus.disposed() : SessionCompletionStatus.unavailable()
      result.generation = this.generation
      return result
    end
    return sessionCompleteSource(source, cursorByteOffset, this.generation, this.firstBinding,
      this.compilation, this.snapshot, this.baseSource, this.completionImports)
  end

  def commit(prepared: PreparedSubmission): Bool
    if this.disposed
      return false
    end
    var claimed = this.pending

    while claimed != null
      if claimed.claimed && !prepared.matches(this.identity, this.environmentIdentity, claimed.candidateId)
        return false
      end
      if claimed.claimed
        claimed.claimed = false
      end
      claimed = claimed.next
    end
    let pending = this.removePending(prepared)

    if pending == null || pending.generation != this.generation
      return false
    end
    prepared.consumed = true
    this.compilation = pending.compilation
    var existing = this.firstBinding

    while existing != null
      existing.access = "__neri_session_previous." + existing.access
      existing = existing.next
    end
    var binding = pending.firstBinding

    while binding != null
      let next = binding.next

      binding.next = this.firstBinding
      this.firstBinding = binding
      binding = next
    end
    this.declarationsUsed = this.declarationsUsed + pending.declarationCount
    this.bindingsUsed = this.bindingsUsed + pending.bindingCount
    this.sourceBytes = this.sourceBytes + host::stringByteLength(pending.declarations) + host::stringByteLength(pending.statements)
    let committedSnapshot = pending.snapshot

    if committedSnapshot != null
      this.snapshot = committedSnapshot.frozenCopy()
      if pending.establishesProject
        this.baseSource = committedSnapshot.source()
      end
    end
    this.generation = this.generation + 1
    this.pending = null
    this.pendingCount = 0
    return true
  end

  def claimExecution(prepared: PreparedSubmission): String?
    if this.disposed || prepared.consumed
      return null
    end
    var item = this.pending
    var selected: PendingSubmission? = null

    while item != null
      if item.claimed
        return null
      end
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId) && item.generation == this.generation
        selected = item
      end
      item = item.next
    end
    if selected == null
      return null
    end
    selected.claimed = true
    return selected.executionSource
  end

  def releaseExecution(prepared: PreparedSubmission): Bool
    var item = this.pending

    while item != null
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId) && item.claimed
        item.claimed = false
        return true
      end
      item = item.next
    end
    return false
  end

  def claimedSnapshot(prepared: PreparedSubmission): SessionSourceSnapshot?
    var item = this.pending

    while item != null
      if item.claimed && prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        let snapshot = item.snapshot

        if snapshot != null
          return snapshot.frozenCopy()
        end
        return null
      end
      item = item.next
    end
    return null
  end

  def claimedModule(prepared: PreparedSubmission): IrModule?
    var item = this.pending

    while item != null
      if item.claimed && prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        let compilation = item.compilation

        if compilation != null
          return compilation.lower()
        end
        return null
      end
      item = item.next
    end
    return null
  end

  def claimedResultType(prepared: PreparedSubmission): String
    var item = this.pending

    while item != null
      if item.claimed && prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        return item.resultType
      end
      item = item.next
    end
    return "Void"
  end

  def claimedCompilationError(prepared: PreparedSubmission): String
    var item = this.pending

    while item != null
      if item.claimed && prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        let compilation = item.compilation

        if compilation != null
          return compilation.error
        end
      end
      item = item.next
    end
    return ""
  end

  def discard(prepared: PreparedSubmission): Bool
    var claimed = this.pending

    while claimed != null
      if claimed.claimed && prepared.matches(this.identity, this.environmentIdentity, claimed.candidateId)
        return false
      end
      claimed = claimed.next
    end
    let pending = this.removePending(prepared)

    if pending == null
      if prepared.consumed || prepared.generation != this.generation || !prepared.belongsTo(this.identity, this.environmentIdentity)
        return false
      end
    end
    prepared.consumed = true
    return true
  end

  def currentGeneration(): Int
    return this.generation
  end

  def bindingCount(): Int
    return this.bindingsUsed
  end

  def dispose(): Void
    this.disposed = true
    this.firstBinding = null
    this.declarationsUsed = 0
    this.bindingsUsed = 0
    this.sourceBytes = 0
    this.pending = null
    this.pendingCount = 0
    this.compilation = null
    this.snapshot = null
    this.baseSource = ""
  end

  def validateInitializer(snapshot: SessionSourceSnapshot, name: String, bindingName: String = "service", imports: String = ""): PreparedSubmission
    let prepared = new PreparedSubmission(this.generation, this.identity, this.environmentIdentity, this.nextCandidateId)

    this.nextCandidateId = this.nextCandidateId + 1
    if this.disposed
      prepared.addDiagnostic("NR_SESSION_DISPOSED", 0, 1, "The session has been disposed.")
      return prepared
    end
    if this.generation != 0 || this.baseSource != ""
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer must establish an empty session.")
      return prepared
    end
    let bindingTokens = new BootstrapLexer(bindingName).lex()

    if bindingTokens.count() != 2 || !bindingTokens.kindAt(0).isIdentifier() || bindingTokens.textAt(0) != bindingName
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer binding must be one identifier.")
      return prepared
    end
    if rejectReservedSessionNames(bindingTokens, prepared)
      return prepared
    end
    let nameParser = new BootstrapParser(new BootstrapLexer(name).lex())
    let qualifiedName = nameParser.parseQualifiedName()

    if nameParser.diagnostics.count() != 0 || !nameParser.currentKind().isEndOfFile()
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer name must be a function identifier or namespace-qualified function path.")
      return prepared
    end
    let importParser = new BootstrapParser(new BootstrapLexer(imports).lex())

    importParser.skipNewLines()
    while importParser.currentKind().isUse()
      importParser.parseUse()
      importParser.skipNewLines()
    end
    if importParser.diagnostics.count() != 0 || !importParser.currentKind().isEndOfFile()
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer imports must contain only use declarations.")
      return prepared
    end
    let contextImports = imports == "" ? "" : imports + "\n"
    let candidateSnapshot = snapshot.frozenCopy()
    let source = candidateSnapshot.source()
    let size = host::stringByteLength(source)

    if size > 1048576 || host::stringByteLength(contextImports) > 1048576 - size || this.sourceBytes > 1048576 - size - host::stringByteLength(contextImports)
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session source exceeds the 1048576-byte limit.")
      return prepared
    end
    candidateSnapshot.captureLibraries(source + contextImports + name + "()\n")
    if candidateSnapshot.error != ""
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, candidateSnapshot.error)
      return prepared
    end
    let analysisSource = source + contextImports + candidateSnapshot.librarySource()
    let lexer = new BootstrapLexer(analysisSource)
    let tokens = lexer.lex()

    if rejectReservedSessionNames(tokens, prepared)
      return prepared
    end
    let parser = new BootstrapParser(tokens)

    candidateSnapshot.applyBoundaries(parser, utf16Length(contextImports))
    let root = parser.parseProgram()

    if parser.diagnostics.count() > 0
      copySessionDiagnostics(parser.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

    binder.requireEntryPoint = false
    candidateSnapshot.applyLibrarySources(binder, utf16Length(source + contextImports), 0)
    let model = binder.bind()

    if model.diagnostics.count() > 0
      copySessionDiagnostics(model.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    prepared.declarationCount = sessionSourceDeclarationCount(parser.arena, root, utf16Length(source))
    if this.declarationsUsed + prepared.declarationCount > 1024
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session declaration count exceeds 1024.")
      return prepared
    end
    let initializer = model.findFunction(model.resolveQualifiedName(nameParser.arena.dataAt(qualifiedName)))

    if initializer == null || initializer.parameterCount != 0 || initializer.returnType == "Void" || initializer.isUnsafe
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer must name a safe zero-argument function with a value result.")
      return prepared
    end
    prepared.declarations = contextImports
    prepared.addBinding(new SessionBinding(bindingName, initializer.returnType, false, bindingName))
    if this.bindingsUsed + prepared.bindingCount > 1024
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session binding count exceeds 1024.")
      prepared.firstBinding = null
      prepared.bindingCount = 0
      return prepared
    end
    prepared.frameSource = sessionFrameSource(this.generation, prepared.firstBinding)
    prepared.executionSource = contextImports + prepared.frameSource + initializerEntrySource(this.generation, initializer.fullName, initializer.returnType, bindingName)
    let executionFragment = prepared.frameSource + initializerEntrySource(this.generation, initializer.fullName, initializer.returnType, bindingName)
    let executionSource = analysisSource + executionFragment
    let executionLexer = new BootstrapLexer(executionFragment)

    executionLexer.utf16Position = utf16Length(analysisSource)
    let executionTokens = executionLexer.lex()
    let executionParser = new BootstrapParser(executionTokens, parser.arena)
    let executionRoot = executionParser.parseProgram()

    if executionParser.diagnostics.count() != 0
      copySessionDiagnostics(executionParser.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    let executionBinder = new BootstrapBinder(executionParser.arena, executionRoot, executionTokens.startAt(executionTokens.count() - 1), model)

    executionBinder.requireEntryPoint = false
    let executionModel = executionBinder.bindChild()

    if executionModel.diagnostics.count() != 0
      copySessionDiagnostics(executionModel.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    sessionOwnInitializerDeclarations(executionModel, model)
    prepared.status = SubmissionStatus.complete()
    if !this.register(prepared, candidateSnapshot, new SessionCompilation(executionModel, executionParser.arena, executionSource), true)
      prepared.status = SubmissionStatus.invalid()
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session has 1024 active prepared submissions.")
    end
    return prepared
  end

  private def register(prepared: PreparedSubmission, snapshot: SessionSourceSnapshot, compilation: SessionCompilation?, establishesProject: Bool = false): Bool
    if this.pendingCount >= 1024
      return false
    end
    let item = new PendingSubmission(prepared, this.nextCandidateId - 1, snapshot.frozenCopy(), compilation, establishesProject)

    item.next = this.pending
    this.pending = item
    this.pendingCount = this.pendingCount + 1
    return true
  end

  private def removePending(prepared: PreparedSubmission): PendingSubmission?
    var previous: PendingSubmission? = null
    var item = this.pending

    while item != null
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        if previous == null
          this.pending = item.next
        else
          previous.next = item.next
        end
        item.next = null
        this.pendingCount = this.pendingCount - 1
        return item
      end
      previous = item
      item = item.next
    end
    return null
  end

  private def hasBinding(name: String): Bool
    var binding = this.firstBinding

    while binding != null
      if binding.name == name
        return true
      end
      binding = binding.next
    end
    return false
  end
end
