use console

class SessionTerminalOptions
  public prompt: String
  public continuationPrompt: String
  public context: String

  def init(prompt: String = "> ", continuationPrompt: String = ". ", context: String = ""): Void
    this.prompt = prompt
    this.continuationPrompt = continuationPrompt
    this.context = context
  end
end

class SessionTerminal
  private session: ExecutableSession

  def init(session: ExecutableSession): Void
    this.session = session
  end

  def run(options: SessionTerminalOptions): Void
    if options.context != ""
      let contextResult = this.session.submit(options.context)
      if !contextResult.execution.succeeded
        console.println(contextResult.format())
      end
    end
    while true
      console.print(options.prompt)
      let optionalFirst = console.readLine()
      if optionalFirst == null
        this.session.dispose()
        return
      end
      let first = optionalFirst
      if first == ":reset"
        let reset = this.session.reset()
        console.println(reset.succeeded ? "reset" : reset.message)
      else
        var source = first + "\n"
        var reachedEof = false
        if first != "."
          while true
            console.print(options.continuationPrompt)
            let optionalLine = console.readLine()
            if optionalLine == null
              reachedEof = true
              break
            end
            let line = optionalLine
            if line == "."
              break
            end
            source = source + line + "\n"
          end
          let response = this.session.submit(source)
          console.println(response.format())
          if reachedEof
            this.session.dispose()
            return
          end
        end
      end
    end
  end
end
