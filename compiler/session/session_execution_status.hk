sealed class SessionExecutionStatus
  private tag: Int
  private receivedCode: Int

  private def init(tag: Int, receivedCode: Int = 0): Void
    this.tag = tag
    this.receivedCode = receivedCode
  end

  static def fromRuntimeCode(code: Int): SessionExecutionStatus
    if code >= 0 && code <= 6
      return new SessionExecutionStatus(code)
    end
    return new SessionExecutionStatus(8, code)
  end

  static def success(): SessionExecutionStatus
    return new SessionExecutionStatus(0)
  end

  readonly def isSuccess(): Bool
    return this.tag == 0
  end

  static def invalidHandle(): SessionExecutionStatus
    return new SessionExecutionStatus(1)
  end

  readonly def isInvalidHandle(): Bool
    return this.tag == 1
  end

  static def loadFailed(): SessionExecutionStatus
    return new SessionExecutionStatus(2)
  end

  readonly def isLoadFailed(): Bool
    return this.tag == 2
  end

  static def invalidMetadata(): SessionExecutionStatus
    return new SessionExecutionStatus(3)
  end

  readonly def isInvalidMetadata(): Bool
    return this.tag == 3
  end

  static def incompatibleLayout(): SessionExecutionStatus
    return new SessionExecutionStatus(4)
  end

  readonly def isIncompatibleLayout(): Bool
    return this.tag == 4
  end

  static def incompatibleFrame(): SessionExecutionStatus
    return new SessionExecutionStatus(5)
  end

  readonly def isIncompatibleFrame(): Bool
    return this.tag == 5
  end

  static def invokeState(): SessionExecutionStatus
    return new SessionExecutionStatus(6)
  end

  readonly def isInvokeState(): Bool
    return this.tag == 6
  end

  static def compilationFailed(): SessionExecutionStatus
    return new SessionExecutionStatus(7)
  end

  readonly def isCompilationFailed(): Bool
    return this.tag == 7
  end

  readonly def isProtocolFailure(): Bool
    return this.tag == 8
  end

  readonly def failureMessage(): String
    if this.isProtocolFailure()
      return "unknown runtime session status " + (this.receivedCode as String)
    end
    return "session failed with status " + (this.tag as String)
  end
end
