use host
use console

def main(): Void
  let compiler = host.environment("NERI_SESSION_COMPILER")
  let linker = host.environment("NERI_LINKER")
  let target = host.environment("NERI_TARGET")
  let work = host.environment("NERI_SESSION_WORK")
  if compiler == null || linker == null || target == null || work == null
    console.println("NERI_SESSION_COMPILER, NERI_LINKER, NERI_TARGET and NERI_SESSION_WORK are required")
    host.exit(2)
    return
  end
  let session = new ExecutableSession(new SessionToolchain(compiler, linker, target, work))
  let terminal = new SessionTerminal(session)
  terminal.run(new SessionTerminalOptions())
end
