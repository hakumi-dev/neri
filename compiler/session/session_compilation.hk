use host

class SessionCompilation
  public error: String = ""
  public model: SemanticModel
  public syntax: SyntaxArena
  public source: String
  public parent: SessionCompilation?
  public sourceStart: Int = 0
  public sourceEnd: Int
  public identity: String
  private lowered: IrModule?

  def init(model: SemanticModel, syntax: SyntaxArena, source: String, parent: SessionCompilation? = null): Void
    this.model = model
    this.syntax = syntax
    this.source = source
    this.parent = parent
    var predecessor = ""

    if parent != null
      this.sourceStart = parent.sourceEnd
      predecessor = parent.identity
    end
    this.sourceEnd = this.sourceStart + utf16Length(source)
    this.identity = sessionCodeDigest(runCacheFrame(predecessor) + runCacheFrame(source))
  end

  def lower(): IrModule?
    let lowered = this.lowered

    if lowered != null
      return lowered
    end
    let lowerer = new IrLowerer(this.model, this.syntax, this.source, "neri-session")
    let sourceIds = new StringBuffer()
    let sourceTexts = new StringBuffer()
    let sourceStarts = new IntBuffer()

    sourceIds.add("session/" + this.identity)
    sourceTexts.add(this.source)
    sourceStarts.add(this.sourceStart)
    lowerer.setSources(sourceIds, sourceTexts, sourceStarts)
    let parent = this.parent

    if parent != null
      let previous = parent.lower()

      if previous == null
        return null
      end
      lowerer.retain(previous)
    end
    let module = lowerer.lower()

    if this.model.diagnostics.count() != 0
      this.error = this.model.diagnostics.codes.get(0) + ": " + this.model.diagnostics.messages.get(0)
      return null
    end
    var entry = module.firstFunction

    while entry != null
      if entry.symbol.name == "__neri_session_entry"
        module.exportSession(entry, this.identity)
        let verification = irVerify(module)

        if verification.succeeded()
          this.lowered = module
          return module
        end
        this.error = verification.errors.get(0)
        return null
      end
      entry = entry.nextFunction
    end
    return null
  end
end
