use host

@cabi("neri_rt_v1_session_identity")
def unsafe sessionEnvironmentIdentity(): Int
end

class SessionDiagnostic
  public code: String
  public start: Int
  public length: Int
  public message: String
  public next: SessionDiagnostic?

  def init(code: String, start: Int, length: Int, message: String): Void
    this.code = code
    this.start = start
    this.length = length
    this.message = message
  end
end

class SessionSourceSnapshot
  private text: String = ""
  private paths: StringBuffer = new StringBuffer()
  private finishes: IntBuffer = new IntBuffer()
  private sources: StringBuffer = new StringBuffer()
  private libraryNames: StringBuffer = new StringBuffer()
  private librarySources: StringBuffer = new StringBuffer()
  public error: String = ""

  def add(path: String, source: String): Void
    if this.error != ""
      return
    end
    if host.stringByteLength(this.text) > 1048576 - host.stringByteLength(source) - 1
      this.error = "Project source snapshot exceeds 1048576 bytes."
      return
    end
    this.text = this.text + source + "\n"
    this.paths.add(path)
    this.sources.add(source)
    this.finishes.add(utf16Length(this.text))
  end

  def source(): String
    return this.text
  end

  def count(): Int
    return this.sources.size
  end

  def sourceAt(index: Int): String
    return this.sources.get(index)
  end

  def frozenCopy(): SessionSourceSnapshot
    let result = new SessionSourceSnapshot()
    var path = this.paths.first.nextNode
    var source = this.sources.first.nextNode
    while path != null && source != null
      result.add(path.value, source.value)
      path = path.nextNode
      source = source.nextNode
    end
    var name = this.libraryNames.first.nextNode
    var library = this.librarySources.first.nextNode
    while name != null && library != null
      result.addLibrary(name.value, library.value)
      name = name.nextNode
      library = library.nextNode
    end
    result.error = this.error
    return result
  end

  def captureLibraries(source: String): Void
    let directory = host.environment("NERI_STDLIB")
    if directory == null
      return
    end
    var scanned = source + this.librarySource()
    var pending = true
    while pending
      if this.error != ""
        return
      end
      pending = false
      for name in bootstrapLibraryImports(scanned)
        if !this.hasLibrary(name)
          let text = host.readText(directory + "/" + name + ".hk")
          if text != null
            this.addLibrary(name, text)
            scanned = scanned + text + "\n"
            pending = true
          end
        end
      end
    end
  end

  private def hasLibrary(name: String): Bool
    var item = this.libraryNames.first.nextNode
    while item != null
      if item.value == name
        return true
      end
      item = item.nextNode
    end
    return false
  end

  private def addLibrary(name: String, source: String): Void
    if host.stringByteLength(this.text) + host.stringByteLength(this.librarySource()) > 1048576 - host.stringByteLength(source) - 1
      this.error = "Project and standard-library snapshot exceeds 1048576 bytes."
      return
    end
    this.libraryNames.add(name)
    this.librarySources.add(source)
  end

  def libraryCount(): Int
    return this.libraryNames.size
  end

  def libraryNameAt(index: Int): String
    return this.libraryNames.get(index)
  end

  def librarySourceAt(index: Int): String
    return this.librarySources.get(index)
  end

  def librarySource(): String
    var result = ""
    var source = this.librarySources.first.nextNode
    while source != null
      result = result + source.value + "\n"
      source = source.nextNode
    end
    return result
  end

  def applyBoundaries(parser: BootstrapParser, insertedBeforeLibraries: Int = 0): Void
    var index = 0
    while index < this.finishes.size
      parser.addSourceBoundary(this.finishes.get(index))
      index = index + 1
    end
    var finish = utf16Length(this.text) + insertedBeforeLibraries
    var library = this.librarySources.first.nextNode
    if library != null
      parser.addSourceBoundary(finish)
    end
    while library != null
      finish = finish + utf16Length(library.value + "\n")
      parser.addSourceBoundary(finish)
      library = library.nextNode
    end
  end

  def sourceIdentityAt(position: Int): String
    var index = 0
    var path = this.paths.first.nextNode
    while index < this.finishes.size && path != null
      if position < this.finishes.get(index)
        return path.value
      end
      index = index + 1
      path = path.nextNode
    end
    return "<submission>"
  end
end

def sessionSnapshotFromProject(project: NeriProject): SessionSourceSnapshot
  let snapshot = new SessionSourceSnapshot()
  if project.error != ""
    snapshot.error = project.error
    return snapshot
  end
  var entry = project.sources.first.nextNode
  while entry != null
    let source = host.readText(entry.value)
    if source == null
      snapshot.error = "Cannot read project source: " + entry.value
      return snapshot
    end
    snapshot.add(entry.value, source)
    entry = entry.nextNode
  end
  return snapshot
end

class SessionBinding
  public identity: String = ""
  public name: String
  public typeName: String
  public mutable: Bool
  public access: String
  public next: SessionBinding?

  def init(name: String, typeName: String, mutable: Bool, access: String): Void
    this.name = name
    this.typeName = typeName
    this.mutable = mutable
    this.access = access
  end
end

class SessionTypeMetadata
  public identity: String
  public name: String
  public layout: String
  public next: SessionTypeMetadata?

  def init(identity: String, name: String, layout: String): Void
    this.identity = identity
    this.name = name
    this.layout = layout
  end
end

class PreparedSubmission
  private owner: String
  private ownerEnvironment: Int
  private candidateId: Int
  public generation: Int
  public status: String = "invalid"
  public diagnostics: SessionDiagnostic?
  public declarations: String = ""
  public statements: String = ""
  public analysisSource: String = ""
  public executionSource: String = ""
  public frameSource: String = ""
  public entryName: String = "__neri_session_entry"
  public firstBinding: SessionBinding?
  public firstType: SessionTypeMetadata?
  public bindingCount: Int = 0
  public declarationCount: Int = 0
  public consumed: Bool = false

  def init(generation: Int, owner: String, ownerEnvironment: Int, candidateId: Int): Void
    this.generation = generation
    this.owner = owner
    this.ownerEnvironment = ownerEnvironment
    this.candidateId = candidateId
  end

  def matches(owner: String, ownerEnvironment: Int, candidateId: Int): Bool
    return this.owner == owner && this.ownerEnvironment == ownerEnvironment && this.candidateId == candidateId
  end

  def belongsTo(owner: String, ownerEnvironment: Int): Bool
    return this.owner == owner && this.ownerEnvironment == ownerEnvironment
  end

  def addDiagnostic(code: String, start: Int, length: Int, message: String): Void
    let diagnostic = new SessionDiagnostic(code, start, length, message)
    diagnostic.next = this.diagnostics
    this.diagnostics = diagnostic
  end

  def addBinding(binding: SessionBinding): Void
    binding.next = this.firstBinding
    this.firstBinding = binding
    this.bindingCount = this.bindingCount + 1
  end

  def addType(item: SessionTypeMetadata): Void
    item.next = this.firstType
    this.firstType = item
  end
end

class PendingSubmission
  public candidateId: Int
  public generation: Int
  public declarations: String
  public statements: String
  public frameSource: String
  public firstBinding: SessionBinding?
  public bindingCount: Int
  public declarationCount: Int
  public executionSource: String
  public snapshot: SessionSourceSnapshot?
  public claimed: Bool = false
  public next: PendingSubmission?

  def init(prepared: PreparedSubmission, candidateId: Int, snapshot: SessionSourceSnapshot?): Void
    this.candidateId = candidateId
    this.generation = prepared.generation
    this.declarations = prepared.declarations
    this.statements = prepared.statements
    this.frameSource = prepared.frameSource
    this.firstBinding = copyBindings(prepared.firstBinding)
    this.bindingCount = prepared.bindingCount
    this.declarationCount = prepared.declarationCount
    this.executionSource = prepared.executionSource
    this.snapshot = snapshot
  end
end

class SessionEnvironment
  private identity: String
  private environmentIdentity: Int
  private baseSource: String = ""
  private snapshot: SessionSourceSnapshot?
  private initializationError: String = ""
  private nextCandidateId: Int = 1
  private declarations: String = ""
  private frames: String = ""
  private firstBinding: SessionBinding?
  private generation: Int = 0
  private declarationsUsed: Int = 0
  private bindingsUsed: Int = 0
  private sourceBytes: Int = 0
  private disposed: Bool = false
  private pending: PendingSubmission?
  private pendingCount: Int = 0

  def init(identity: String, snapshot: SessionSourceSnapshot? = null): Void
    this.identity = identity
    unsafe
      this.environmentIdentity = sessionEnvironmentIdentity()
    end
    if snapshot != null
      let frozen = snapshot.frozenCopy()
      this.snapshot = frozen
      this.baseSource = frozen.source()
      this.initializationError = frozen.error
    end
  end

  def prepare(source: String): PreparedSubmission
    let prepared = new PreparedSubmission(this.generation, this.identity, this.environmentIdentity, this.nextCandidateId)
    this.nextCandidateId = this.nextCandidateId + 1
    if this.disposed
      prepared.addDiagnostic("NR_SESSION_DISPOSED", 0, 1, "The session has been disposed.")
      return prepared
    end
    if this.initializationError != ""
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, this.initializationError)
      return prepared
    end
    let size = host.stringByteLength(source)
    if size > 1048576 || this.sourceBytes > 1048576 - size
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session source exceeds the 1048576-byte limit.")
      return prepared
    end
    let lexer = new BootstrapLexer(source)
    let tokens = lexer.lex()
    if rejectReservedSessionNames(tokens, prepared)
      return prepared
    end
    let parser = new BootstrapParser(tokens)
    let submission = parser.parseSubmission()
    prepared.status = submission.status
    if tokens.count() > 1
      let finalToken = tokens.count() - 2
      if tokens.kindAt(finalToken) == "BadToken" && startsWithQuote(tokens.textAt(finalToken))
        prepared.status = "incomplete"
      end
    end
    if parser.diagnostics.count() > 0
      copySessionDiagnostics(parser.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    prepared.declarations = submissionParts(source, submission.declarationStarts, submission.declarationLengths)
    prepared.statements = submissionParts(source, submission.statementStarts, submission.statementLengths)
    prepared.declarationCount = submission.declarationCount
    if this.declarationsUsed + prepared.declarationCount > 1024
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session declaration count exceeds 1024.")
      return prepared
    end
    let prefix = this.baseSource + this.declarations + prepared.declarations + this.frames + entryPrefix(this.generation, this.firstBinding)
    let analysisProgram = prefix + indentSubmission(prepared.statements) + "end\n"
    var candidateSnapshot = new SessionSourceSnapshot()
    let currentSnapshot = this.snapshot
    if currentSnapshot != null
      candidateSnapshot = currentSnapshot.frozenCopy()
    end
    candidateSnapshot.captureLibraries(analysisProgram)
    if candidateSnapshot.error != ""
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, candidateSnapshot.error)
      return prepared
    end
    prepared.analysisSource = analysisProgram + candidateSnapshot.librarySource()
    let analysisLexer = new BootstrapLexer(prepared.analysisSource)
    let analysisTokens = analysisLexer.lex()
    let analysisParser = new BootstrapParser(analysisTokens)
    candidateSnapshot.applyBoundaries(analysisParser, utf16Length(analysisProgram) - utf16Length(this.baseSource))
    let root = analysisParser.parseProgram()
    if analysisParser.diagnostics.count() > 0
      prepared.status = "invalid"
      copyMappedDiagnostics(analysisParser.diagnostics, prepared, source, submission,
        utf16Length(this.baseSource + this.declarations), utf16Length(prefix))
      return prepared
    end
    let binder = new BootstrapBinder(analysisParser.arena, root, analysisTokens.startAt(analysisTokens.count() - 1))
    binder.requireEntryPoint = false
    let model = binder.bind()
    if model.diagnostics.count() > 0
      prepared.status = "invalid"
      copyMappedDiagnostics(model.diagnostics, prepared, source, submission,
        utf16Length(this.baseSource + this.declarations), utf16Length(prefix))
      return prepared
    end
    let entry = model.findFunction(prepared.entryName)
    if entry == null
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_INTERNAL", 0, 1, "Generated session entry is missing.")
      return prepared
    end
    var local = entry.firstSessionLocal
    while local != null
      if !this.hasBinding(local.name)
        let binding = new SessionBinding(local.name, local.typeName, local.mutable, local.name)
        binding.identity = "session/" + (this.generation as String) + "/" + local.identity
        prepared.addBinding(binding)
      end
      local = local.nextLocal
    end
    collectSubmittedTypes(model, analysisParser.arena, prepared, utf16Length(this.baseSource + this.declarations), utf16Length(prepared.declarations))
    if this.bindingsUsed + prepared.bindingCount > 1024
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session binding count exceeds 1024.")
      prepared.firstBinding = null
      prepared.bindingCount = 0
      return prepared
    end
    prepared.frameSource = sessionFrameSource(this.generation, prepared.firstBinding)
    prepared.executionSource = this.declarations + prepared.declarations + this.frames + prepared.frameSource + executionEntrySource(this.generation, this.firstBinding, prepared.firstBinding, prepared.statements)
    let executionProgram = this.baseSource + prepared.executionSource
    let executionAnalysisSource = executionProgram + candidateSnapshot.librarySource()
    let executionLexer = new BootstrapLexer(executionAnalysisSource)
    let executionTokens = executionLexer.lex()
    let executionParser = new BootstrapParser(executionTokens)
    candidateSnapshot.applyBoundaries(executionParser, utf16Length(prepared.executionSource))
    let executionRoot = executionParser.parseProgram()
    if executionParser.diagnostics.count() > 0
      prepared.status = "invalid"
      copyMappedDiagnostics(executionParser.diagnostics, prepared, source, submission,
        utf16Length(this.baseSource + this.declarations), utf16Length(this.baseSource + this.declarations + prepared.declarations + this.frames + prepared.frameSource + executionEntryPrefix(this.generation, this.firstBinding)))
      return prepared
    end
    let executionBinder = new BootstrapBinder(executionParser.arena, executionRoot, executionTokens.startAt(executionTokens.count() - 1))
    executionBinder.requireEntryPoint = false
    let executionModel = executionBinder.bind()
    if executionModel.diagnostics.count() > 0
      prepared.status = "invalid"
      copyMappedDiagnostics(executionModel.diagnostics, prepared, source, submission,
        utf16Length(this.baseSource + this.declarations), utf16Length(this.baseSource + this.declarations + prepared.declarations + this.frames + prepared.frameSource + executionEntryPrefix(this.generation, this.firstBinding)))
      return prepared
    end
    prepared.status = "complete"
    if !this.register(prepared, candidateSnapshot)
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session has 1024 active prepared submissions.")
    end
    return prepared
  end

  def commit(prepared: PreparedSubmission): Bool
    if this.disposed
      return false
    end
    var claimed = this.pending
    while claimed != null
      if claimed.claimed && !prepared.matches(this.identity, this.environmentIdentity, claimed.candidateId)
        return false
      end
      if claimed.claimed
        claimed.claimed = false
      end
      claimed = claimed.next
    end
    let pending = this.removePending(prepared)
    if pending == null || pending.generation != this.generation
      return false
    end
    prepared.consumed = true
    this.declarations = this.declarations + pending.declarations
    this.frames = this.frames + pending.frameSource
    var existing = this.firstBinding
    while existing != null
      existing.access = "__neri_session_previous." + existing.access
      existing = existing.next
    end
    var binding = pending.firstBinding
    while binding != null
      let next = binding.next
      binding.next = this.firstBinding
      this.firstBinding = binding
      binding = next
    end
    this.declarationsUsed = this.declarationsUsed + pending.declarationCount
    this.bindingsUsed = this.bindingsUsed + pending.bindingCount
    this.sourceBytes = this.sourceBytes + host.stringByteLength(pending.declarations) + host.stringByteLength(pending.statements)
    let committedSnapshot = pending.snapshot
    if committedSnapshot != null
      this.snapshot = committedSnapshot.frozenCopy()
    end
    this.generation = this.generation + 1
    this.pending = null
    this.pendingCount = 0
    return true
  end

  def claimExecution(prepared: PreparedSubmission): String?
    if this.disposed || prepared.consumed
      return null
    end
    var item = this.pending
    var selected: PendingSubmission? = null
    while item != null
      if item.claimed
        return null
      end
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId) && item.generation == this.generation
        selected = item
      end
      item = item.next
    end
    if selected == null
      return null
    end
    selected.claimed = true
    return selected.executionSource
  end

  def releaseExecution(prepared: PreparedSubmission): Bool
    var item = this.pending
    while item != null
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId) && item.claimed
        item.claimed = false
        return true
      end
      item = item.next
    end
    return false
  end

  def claimedSnapshot(prepared: PreparedSubmission): SessionSourceSnapshot?
    var item = this.pending
    while item != null
      if item.claimed && prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        let snapshot = item.snapshot
        if snapshot != null
          return snapshot.frozenCopy()
        end
        return null
      end
      item = item.next
    end
    return null
  end

  def discard(prepared: PreparedSubmission): Bool
    var claimed = this.pending
    while claimed != null
      if claimed.claimed && prepared.matches(this.identity, this.environmentIdentity, claimed.candidateId)
        return false
      end
      claimed = claimed.next
    end
    let pending = this.removePending(prepared)
    if pending == null
      if prepared.consumed || prepared.generation != this.generation || !prepared.belongsTo(this.identity, this.environmentIdentity)
        return false
      end
    end
    prepared.consumed = true
    return true
  end

  def currentGeneration(): Int
    return this.generation
  end

  def bindingCount(): Int
    return this.bindingsUsed
  end

  def dispose(): Void
    this.disposed = true
    this.declarations = ""
    this.frames = ""
    this.firstBinding = null
    this.declarationsUsed = 0
    this.bindingsUsed = 0
    this.sourceBytes = 0
    this.pending = null
    this.pendingCount = 0
  end

  def validateInitializer(snapshot: SessionSourceSnapshot, name: String): PreparedSubmission
    let prepared = new PreparedSubmission(this.generation, this.identity, this.environmentIdentity, this.nextCandidateId)
    this.nextCandidateId = this.nextCandidateId + 1
    if this.disposed
      prepared.addDiagnostic("NR_SESSION_DISPOSED", 0, 1, "The session has been disposed.")
      return prepared
    end
    if this.generation != 0 || this.baseSource != ""
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer must establish an empty session.")
      return prepared
    end
    let candidateSnapshot = snapshot.frozenCopy()
    let source = candidateSnapshot.source()
    let size = host.stringByteLength(source)
    if size > 1048576 || this.sourceBytes > 1048576 - size
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session source exceeds the 1048576-byte limit.")
      return prepared
    end
    candidateSnapshot.captureLibraries(source)
    if candidateSnapshot.error != ""
      prepared.addDiagnostic("NR_SESSION_PROJECT", 0, 1, candidateSnapshot.error)
      return prepared
    end
    let analysisSource = source + candidateSnapshot.librarySource()
    let lexer = new BootstrapLexer(analysisSource)
    let tokens = lexer.lex()
    if rejectReservedSessionNames(tokens, prepared)
      return prepared
    end
    let parser = new BootstrapParser(tokens)
    candidateSnapshot.applyBoundaries(parser)
    let root = parser.parseProgram()
    if parser.diagnostics.count() > 0
      copySessionDiagnostics(parser.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
    binder.requireEntryPoint = false
    let model = binder.bind()
    if model.diagnostics.count() > 0
      copySessionDiagnostics(model.diagnostics, prepared, 0, 0, false)
      return prepared
    end
    let programData = parser.arena.dataAt(root)
    prepared.declarationCount = semanticIntField(programData, 1) + semanticIntField(programData, 2) + semanticIntField(programData, 3)
    if this.declarationsUsed + prepared.declarationCount > 1024
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session declaration count exceeds 1024.")
      return prepared
    end
    let initializer = model.findFunction(name)
    if initializer == null || initializer.parameterCount != 0 || initializer.returnType == "Void" || initializer.isUnsafe
      prepared.addDiagnostic("NR_SESSION_INITIALIZER", 0, 1, "Initializer must name a safe zero-argument function with a value result.")
      return prepared
    end
    this.snapshot = candidateSnapshot.frozenCopy()
    this.baseSource = source
    prepared.declarations = ""
    prepared.addBinding(new SessionBinding("service", initializer.returnType, false, "service"))
    if this.bindingsUsed + prepared.bindingCount > 1024
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session binding count exceeds 1024.")
      prepared.firstBinding = null
      prepared.bindingCount = 0
      return prepared
    end
    prepared.frameSource = sessionFrameSource(this.generation, prepared.firstBinding)
    prepared.executionSource = this.frames + prepared.frameSource + initializerEntrySource(this.generation, name, initializer.returnType)
    prepared.status = "complete"
    if !this.register(prepared, candidateSnapshot)
      prepared.status = "invalid"
      prepared.addDiagnostic("NR_SESSION_LIMIT", 0, 1, "Session has 1024 active prepared submissions.")
    end
    return prepared
  end

  private def register(prepared: PreparedSubmission, snapshot: SessionSourceSnapshot): Bool
    if this.pendingCount >= 1024
      return false
    end
    let item = new PendingSubmission(prepared, this.nextCandidateId - 1, snapshot.frozenCopy())
    item.next = this.pending
    this.pending = item
    this.pendingCount = this.pendingCount + 1
    return true
  end

  private def removePending(prepared: PreparedSubmission): PendingSubmission?
    var previous: PendingSubmission? = null
    var item = this.pending
    while item != null
      if prepared.matches(this.identity, this.environmentIdentity, item.candidateId)
        if previous == null
          this.pending = item.next
        else
          previous.next = item.next
        end
        item.next = null
        this.pendingCount = this.pendingCount - 1
        return item
      end
      previous = item
      item = item.next
    end
    return null
  end

  private def hasBinding(name: String): Bool
    var binding = this.firstBinding
    while binding != null
      if binding.name == name
        return true
      end
      binding = binding.next
    end
    return false
  end
end

def rejectReservedSessionNames(tokens: TokenBuffer, prepared: PreparedSubmission): Bool
  var index = 0
  while index < tokens.count()
    if tokens.kindAt(index) == "Identifier"
      let name = tokens.textAt(index)
      if textStartsWith(name, "__neri_session_") || textStartsWith(name, "__NeriSessionState")
        prepared.addDiagnostic("NR_SESSION_RESERVED", tokens.startAt(index), tokens.lengthAt(index), "Identifier uses the reserved session namespace.")
        return true
      end
    end
    index = index + 1
  end
  return false
end

def textStartsWith(text: String, prefix: String): Bool
  let textSize = host.stringByteLength(text)
  let prefixSize = host.stringByteLength(prefix)
  if textSize < prefixSize
    return false
  end
  var index = 0
  while index < prefixSize
    if host.stringByteAt(text, index) != host.stringByteAt(prefix, index)
      return false
    end
    index = index + 1
  end
  return true
end

def copyBindings(source: SessionBinding?): SessionBinding?
  var first: SessionBinding? = null
  var item = source
  while item != null
    let copied = new SessionBinding(item.name, item.typeName, item.mutable, item.access)
    copied.identity = item.identity
    copied.next = first
    first = copied
    item = item.next
  end
  var reversed: SessionBinding? = null
  item = first
  while item != null
    let next = item.next
    item.next = reversed
    reversed = item
    item = next
  end
  return reversed
end

def collectSubmittedTypes(model: SemanticModel, syntax: SyntaxArena, prepared: PreparedSubmission, start: Int, length: Int): Void
  var symbol = model.firstClass
  while symbol != null
    if symbol.genericOrigin < 0 && symbol.syntaxNode >= 0
      let position = syntax.startAt(symbol.syntaxNode)
      if position >= start && position < start + length
        var layout = "class|" + symbol.fullName + "|base=" + symbol.baseName
        var field = symbol.firstField
        while field != null
          layout = layout + "|field=" + field.name + ":" + field.typeName
          field = field.nextField
        end
        prepared.addType(new SessionTypeMetadata("nominal/" + symbol.fullName, symbol.fullName, layout))
      end
    end
    symbol = symbol.nextClass
  end
end

def initializerEntrySource(generation: Int, name: String, returnType: String): String
  let state = "__NeriSessionState" + (generation as String)
  var result = "def __neri_session_entry("
  if generation > 0
    result = result + "__neri_session_previous: __NeriSessionState" + ((generation - 1) as String)
  end
  result = result + "): " + state + "\n"
  result = result + "let service: " + returnType + " = " + name + "()\n"
  result = result + "return new " + state + "("
  if generation > 0
    result = result + "__neri_session_previous, "
  end
  return result + "service)\nend\n"
end

def startsWithQuote(text: String): Bool
  return host.stringByteLength(text) > 0 && host.stringByteAt(text, 0) == (34 as Byte)
end

def utf16Length(text: String): Int
  var bytes = 0
  var units = 0
  while bytes < host.stringByteLength(text)
    let width = utf8Width(host.stringByteAt(text, bytes) as Int)
    units = units + (width == 4 ? 2 : 1)
    bytes = bytes + width
  end
  return units
end

def byteAtUtf16(text: String, target: Int): Int
  var bytes = 0
  var units = 0
  while bytes < host.stringByteLength(text) && units < target
    let width = utf8Width(host.stringByteAt(text, bytes) as Int)
    units = units + (width == 4 ? 2 : 1)
    bytes = bytes + width
  end
  return bytes
end

def submissionParts(source: String, starts: IntBuffer, lengths: IntBuffer): String
  var result = ""
  var index = 0
  while index < starts.size
    let start = byteAtUtf16(source, starts.get(index))
    let finish = byteAtUtf16(source, starts.get(index) + lengths.get(index))
    result = result + host.stringSlice(source, start, finish - start)
    if result != "" && host.stringByteAt(result, host.stringByteLength(result) - 1) != (10 as Byte)
      result = result + "\n"
    end
    index = index + 1
  end
  return result
end

def indentSubmission(source: String): String
  return source
end

def entryPrefix(generation: Int, bindings: SessionBinding?): String
  var result = "def __neri_session_entry("
  if generation > 0
    result = result + "__neri_session_previous: __NeriSessionState" + ((generation - 1) as String)
  end
  result = result + "): Void\n"
  var binding = bindings
  while binding != null
    result = result + "  " + (binding.mutable ? "var " : "let ") + binding.name + ": " + binding.typeName + " = __neri_session_previous." + binding.access + "\n"
    binding = binding.next
  end
  return result
end

def sessionFrameSource(generation: Int, bindings: SessionBinding?): String
  let name = "__NeriSessionState" + (generation as String)
  var fields = generation > 0 ? "  public __neri_session_previous: __NeriSessionState" + ((generation - 1) as String) + "\n" : ""
  var parameters = generation > 0 ? "__neri_session_previous: __NeriSessionState" + ((generation - 1) as String) : ""
  var assignments = generation > 0 ? "    this.__neri_session_previous = __neri_session_previous\n" : ""
  var binding = bindings
  while binding != null
    fields = fields + "  public " + binding.name + ": " + binding.typeName + "\n"
    parameters = parameters + (parameters == "" ? "" : ", ") + binding.name + ": " + binding.typeName
    assignments = assignments + "    this." + binding.name + " = " + binding.name + "\n"
    binding = binding.next
  end
  return "class " + name + "\n" + fields + "\n  def init(" + parameters + "): Void\n" + assignments + "  end\nend\n"
end

def executionEntrySource(generation: Int, previousBindings: SessionBinding?, newBindings: SessionBinding?, statements: String): String
  var result = executionEntryPrefix(generation, previousBindings)
  result = result + statements
  var writeback = previousBindings
  while writeback != null
    if writeback.mutable
      result = result + "__neri_session_previous." + writeback.access + " = " + writeback.name + "\n"
    end
    writeback = writeback.next
  end
  result = result + "return new __NeriSessionState" + (generation as String) + "("
  var separator = ""
  if generation > 0
    result = result + "__neri_session_previous"
    separator = ", "
  end
  var argument = newBindings
  while argument != null
    result = result + separator + argument.name
    separator = ", "
    argument = argument.next
  end
  return result + ")\nend\n"
end

def executionEntryPrefix(generation: Int, previousBindings: SessionBinding?): String
  let state = "__NeriSessionState" + (generation as String)
  var result = "def __neri_session_entry("
  if generation > 0
    result = result + "__neri_session_previous: __NeriSessionState" + ((generation - 1) as String)
  end
  result = result + "): " + state + "\n"
  var materialized = previousBindings
  while materialized != null
    result = result + (materialized.mutable ? "var " : "let ") + materialized.name + ": " + materialized.typeName + " = __neri_session_previous." + materialized.access + "\n"
    materialized = materialized.next
  end
  return result
end

def copySessionDiagnostics(source: DiagnosticBuffer, target: PreparedSubmission, prefix: Int, submittedLength: Int, mapped: Bool): Void
  var index = 0
  while index < source.count()
    var start = source.starts.get(index)
    if mapped
      if start >= prefix && start <= prefix + submittedLength
        start = start - prefix
      else
        start = 0
      end
    end
    target.addDiagnostic(source.codes.get(index), start, source.lengths.get(index), source.messages.get(index))
    index = index + 1
  end
end

def copyMappedDiagnostics(source: DiagnosticBuffer, target: PreparedSubmission, submitted: String, syntax: SubmissionSyntax, declarationStart: Int, statementStart: Int): Void
  let declarationLength = utf16Length(submissionParts(submitted, syntax.declarationStarts, syntax.declarationLengths))
  let statementLength = utf16Length(submissionParts(submitted, syntax.statementStarts, syntax.statementLengths))
  var index = 0
  while index < source.count()
    let generated = source.starts.get(index)
    var start = 0
    if generated >= declarationStart && generated < declarationStart + declarationLength
      start = submissionPartPosition(submitted, generated - declarationStart, syntax.declarationStarts, syntax.declarationLengths)
    else if generated >= statementStart && generated <= statementStart + statementLength
      start = submissionPartPosition(submitted, generated - statementStart, syntax.statementStarts, syntax.statementLengths)
    end
    target.addDiagnostic(source.codes.get(index), start, source.lengths.get(index), source.messages.get(index))
    index = index + 1
  end
end

def submissionPartPosition(source: String, generated: Int, starts: IntBuffer, lengths: IntBuffer): Int
  var offset = 0
  var index = 0
  while index < starts.size
    let startByte = byteAtUtf16(source, starts.get(index))
    let finishByte = byteAtUtf16(source, starts.get(index) + lengths.get(index))
    let part = host.stringSlice(source, startByte, finishByte - startByte)
    var emitted = lengths.get(index)
    if part != "" && host.stringByteAt(part, host.stringByteLength(part) - 1) != (10 as Byte)
      emitted = emitted + 1
    end
    if generated < offset + emitted
      let within = generated - offset
      return starts.get(index) + (within < lengths.get(index) ? within : lengths.get(index))
    end
    offset = offset + emitted
    index = index + 1
  end
  return 0
end
