use host

@cabiImport("neri_rt_v1_session_identity")
unsafe def sessionEnvironmentIdentity(): Int
end

def sessionSnapshotFromProject(project: NeriProject): SessionSourceSnapshot
  let snapshot = new SessionSourceSnapshot()

  if project.error() != ""
    snapshot.error = project.error()
    return snapshot
  end
  snapshot.captureVerifiedLibraries(project)
  let manifests = new StringBuffer()
  var owner = project.sourceOwners.first.nextNode

  while owner != null
    var separator = -1
    var index = 0

    while index < host::stringByteLength(owner.value)
      if host::stringByteAt(owner.value, index) == (35 as Byte)
        separator = index
      end
      index = index + 1
    end
    if separator >= 0
      let manifestPath = host::stringSlice(owner.value, 0, separator)
      var found = false
      var known = manifests.first.nextNode

      while known != null
        if known.value == manifestPath
          found = true
        end
        known = known.nextNode
      end
      if !found
        let content = host::readText(manifestPath)

        if content == null
          snapshot.error = "Cannot read project configuration: " + manifestPath
          return snapshot
        end
        manifests.add(manifestPath)
        snapshot.configuration = snapshot.configuration + runCacheFrame(manifestPath) + runCacheFrame(content)
      end
    end
    snapshot.configuration = snapshot.configuration + runCacheFrame(owner.value)
    owner = owner.nextNode
  end
  var generatedManifest = project.generationManifests.first.nextNode
  var generatedManifestIndex = 0

  while generatedManifest != null
    let content = project.generationManifestTexts.get(generatedManifestIndex)

    snapshot.configuration = snapshot.configuration + runCacheFrame(generatedManifest.value) + runCacheFrame(content)
    generatedManifest = generatedManifest.nextNode
    generatedManifestIndex = generatedManifestIndex + 1
  end
  var entry = project.sources.first.nextNode

  while entry != null
    let source = neriProjectVerifiedText(project, entry.value)

    if source == null
      snapshot.error = "Cannot read project source: " + entry.value
      return snapshot
    end
    snapshot.add(project.identityPath(entry.value), source)
    entry = entry.nextNode
  end
  return snapshot
end

def sessionSourceDeclarationCount(syntax: SyntaxArena, root: Int, sourceFinish: Int): Int
  var result = 0
  var index = 0

  while index < syntax.childCountAt(root)
    let declaration = syntax.childAt(root, index)
    let kind = syntax.kindAt(declaration)

    if syntax.startAt(declaration) < sourceFinish && (kind.isClass() || kind.isFunction() || kind.isStruct() || kind.isUnion() || kind.isContract())
      result = result + 1
    end
    index = index + 1
  end
  return result
end

# The initializer's project model is private to this candidate. Both declaration
# sets are emitted in its first native module; subsequent submissions retain it.
def sessionOwnInitializerDeclarations(child: SemanticModel, project: SemanticModel): Void
  semanticAdoptDeclarations(child, project)
end

def rejectReservedSessionNames(tokens: TokenBuffer, prepared: PreparedSubmission): Bool
  var index = 0

  while index < tokens.count()
    if tokens.kindAt(index).isIdentifier()
      let name = tokens.textAt(index)

      if textStartsWith(name, "__neri_session_") || textStartsWith(name, "__NeriSessionState")
        prepared.addDiagnostic("NR_SESSION_RESERVED", tokens.startAt(index), tokens.lengthAt(index), "Identifier uses the reserved session namespace.")
        return true
      end
    end
    index = index + 1
  end
  return false
end

def textStartsWith(text: String, prefix: String): Bool
  let textSize = host::stringByteLength(text)
  let prefixSize = host::stringByteLength(prefix)

  if textSize < prefixSize
    return false
  end
  var index = 0

  while index < prefixSize
    if host::stringByteAt(text, index) != host::stringByteAt(prefix, index)
      return false
    end
    index = index + 1
  end
  return true
end

def sessionReferencedBindings(source: SessionBinding?, tokens: TokenBuffer): SessionBinding?
  var result: SessionBinding? = null
  var binding = source

  while binding != null
    var index = 0
    var referenced = false

    while index < tokens.count() && !referenced
      referenced = tokens.kindAt(index).isIdentifier() && tokens.textAt(index) == binding.name
      index = index + 1
    end
    if referenced
      let copy = new SessionBinding(binding.name, binding.typeName, binding.mutable, binding.access)

      copy.identity = binding.identity
      copy.next = result
      result = copy
    end
    binding = binding.next
  end
  return result
end

def copyBindings(source: SessionBinding?): SessionBinding?
  var first: SessionBinding? = null
  var item = source

  while item != null
    let copied = new SessionBinding(item.name, item.typeName, item.mutable, item.access)

    copied.identity = item.identity
    copied.next = first
    first = copied
    item = item.next
  end
  var reversed: SessionBinding? = null

  item = first
  while item != null
    let next = item.next

    item.next = reversed
    reversed = item
    item = next
  end
  return reversed
end

def collectSubmittedTypes(model: SemanticModel, syntax: SyntaxArena, prepared: PreparedSubmission, start: Int, length: Int): Void
  var symbol = model.firstClass

  while symbol != null
    if symbol.genericOrigin < 0 && symbol.syntaxNode >= 0
      let position = syntax.startAt(symbol.syntaxNode)

      if position >= start && position < start + length
        var layout = "class|" + symbol.fullName + "|base=" + symbol.baseName
        var field = symbol.firstField

        while field != null
          layout = layout + "|field=" + field.name + ":" + field.typeName
          field = field.nextField
        end
        prepared.addType(new SessionTypeMetadata("nominal/" + symbol.fullName, symbol.fullName, layout))
      end
    end
    symbol = symbol.nextClass
  end
end

def initializerEntrySource(frameName: String, name: String, returnType: String, bindingName: String = "service"): String
  let state = frameName
  var result = "def __neri_session_entry("

  result = result + "): " + state + "\n"
  result = result + "let " + bindingName + ": " + semanticNamespaceDisplay(returnType) + " = " + semanticNamespaceDisplay(name) + "()\n"
  result = result + "return new " + state + "("
  return result + bindingName + ")\nend\n"
end

def startsWithQuote(text: String): Bool
  return host::stringByteLength(text) > 0 && host::stringByteAt(text, 0) == (34 as Byte)
end

def utf16Length(text: String): Int
  var bytes = 0
  var units = 0

  while bytes < host::stringByteLength(text)
    let width = utf8Width(host::stringByteAt(text, bytes) as Int)

    units = units + (width == 4 ? 2 : 1)
    bytes = bytes + width
  end
  return units
end

def byteAtUtf16(text: String, target: Int): Int
  var bytes = 0
  var units = 0

  while bytes < host::stringByteLength(text) && units < target
    let width = utf8Width(host::stringByteAt(text, bytes) as Int)

    units = units + (width == 4 ? 2 : 1)
    bytes = bytes + width
  end
  return bytes
end

def submissionPart(source: String, start: Int, length: Int): String
  let first = byteAtUtf16(source, start)
  let finish = byteAtUtf16(source, start + length)
  let text = host::stringSlice(source, first, finish - first)

  if text != "" && host::stringByteAt(text, host::stringByteLength(text) - 1) != (10 as Byte)
    return text + "\n"
  end
  return text
end

def submissionParts(source: String, starts: IntBuffer, lengths: IntBuffer): String
  var result = ""
  var index = 0

  while index < starts.size
    result = result + submissionPart(source, starts.get(index), lengths.get(index))
    index = index + 1
  end
  return result
end

def indentSubmission(source: String): String
  return source
end

def entryPrefix(generation: Int, previousFrameName: String, bindings: SessionBinding?): String
  var result = "def __neri_session_entry("

  if generation > 0
    result = result + "__neri_session_previous: " + previousFrameName
  end
  result = result + "): Void\n"
  var binding = bindings

  while binding != null
    result = result + "  " + (binding.mutable ? "var " : "let ") + binding.name + ": " + semanticNamespaceDisplay(binding.typeName) + " = __neri_session_previous." + binding.access + "\n"
    binding = binding.next
  end
  return result
end

def sessionFrameSource(generation: Int, frameName: String, previousFrameName: String, bindings: SessionBinding?): String
  let name = frameName
  var fields = generation > 0 ? "  public __neri_session_previous: " + previousFrameName + "\n" : ""
  var parameters = generation > 0 ? "__neri_session_previous: " + previousFrameName : ""
  var assignments = generation > 0 ? "    this.__neri_session_previous = __neri_session_previous\n" : ""
  var binding = bindings

  while binding != null
    fields = fields + "  public " + binding.name + ": " + semanticNamespaceDisplay(binding.typeName) + "\n"
    parameters = parameters + (parameters == "" ? "" : ", ") + binding.name + ": " + semanticNamespaceDisplay(binding.typeName)
    assignments = assignments + "    this." + binding.name + " = " + binding.name + "\n"
    binding = binding.next
  end
  fields = fields + "  public __neri_session_display: String\n"
  parameters = parameters + (parameters == "" ? "" : ", ") + "__neri_session_display: String = \"\""
  assignments = assignments + "    this.__neri_session_display = __neri_session_display\n"
  return "class " + name + "\n" + fields + "\n  def init(" + parameters + "): Void\n" + assignments + "  end\nend\n"
end

def sessionDisplayExpression(typeName: String, inspectionExpression: String = ""): String
  if typeName == "Void"
    return "\"\""
  else if typeName == "String"
    return "__neri_session_result"
  else if typeName == "Int" || typeName == "Byte" || typeName == "Float"
    return "(__neri_session_result as String)"
  else if typeName == "Bool"
    return "(__neri_session_result ? \"true\" : \"false\")"
  end
  return inspectionExpression == "" ? irQuote(typeName) : inspectionExpression
end

def executionEntrySource(generation: Int, frameName: String, previousFrameName: String, candidateId: Int, previousBindings: SessionBinding?, newBindings: SessionBinding?, statements: String, resultType: String = "Void", inspectionExpression: String = "", propagatedErrorType: String = "", errorInspectionExpression: String = ""): String
  let evaluatorName = "__neri_session_evaluate_" + (candidateId as String)
  let outputType = "result::Result<" + frameName + ", " + semanticNamespaceDisplay(propagatedErrorType) + ">"
  let functionName = propagatedErrorType == "" ? "__neri_session_entry" : evaluatorName
  var result = executionEntryPrefix(generation, frameName, previousFrameName, previousBindings, propagatedErrorType == "" ? frameName : outputType, functionName)

  result = result + statements
  var writeback = previousBindings

  while writeback != null
    if writeback.mutable
      result = result + "__neri_session_previous." + writeback.access + " = " + writeback.name + "\n"
    end
    writeback = writeback.next
  end
  if propagatedErrorType != ""
    result = result + "return result::Result<" + frameName + ", " + semanticNamespaceDisplay(propagatedErrorType) + ">.Ok(new " + frameName + "("
  else
    result = result + "return new " + frameName + "("
  end
  var separator = ""

  if generation > 0
    result = result + "__neri_session_previous"
    separator = ", "
  end
  var argument = newBindings

  while argument != null
    result = result + separator + argument.name
    separator = ", "
    argument = argument.next
  end
  result = result + separator + sessionDisplayExpression(resultType, inspectionExpression) + ")"
  if propagatedErrorType != ""
    result = result + ")"
  end
  result = result + "\nend\n"
  if propagatedErrorType == ""
    return result
  end
  var adapter = "def __neri_session_entry("

  if generation > 0
    adapter = adapter + "__neri_session_previous: " + previousFrameName
  end
  let failureFunction = "__neri_session_report_failure_" + (candidateId as String)

  adapter = "@cabiImport(\"neri_rt_v1_session_fail\")\nunsafe def " + failureFunction + "(message: String): Void\nend\n" + adapter
  adapter = adapter + "): " + frameName + "?\n  match " + evaluatorName + "("
  if generation > 0
    adapter = adapter + "__neri_session_previous"
  end
  adapter = adapter + ")\n    case result::Result.Ok(value)\n      return value\n    case result::Result.Error(__neri_session_error)\n      unsafe\n        " + failureFunction + "(" + errorInspectionExpression + ")\n      end\n      return null\n  end\nend\n"
  return result + adapter
end

def executionEntryPrefix(generation: Int, frameName: String, previousFrameName: String, previousBindings: SessionBinding?, returnType: String, functionName: String): String
  var result = "def " + functionName + "("

  if generation > 0
    result = result + "__neri_session_previous: " + previousFrameName
  end
  result = result + "): " + returnType + "\n"
  var materialized = previousBindings

  while materialized != null
    result = result + (materialized.mutable ? "var " : "let ") + materialized.name + ": " + semanticNamespaceDisplay(materialized.typeName) + " = __neri_session_previous." + materialized.access + "\n"
    materialized = materialized.next
  end
  return result
end

def copySessionDiagnostics(source: DiagnosticBuffer, target: PreparedSubmission, prefix: Int, submittedLength: Int, mapped: Bool): Void
  var index = 0

  while index < source.count()
    var start = source.starts.get(index)

    if mapped
      if start >= prefix && start <= prefix + submittedLength
        start = start - prefix
      else
        start = 0
      end
    end
    target.addDiagnostic(source.codes.get(index), start, source.lengths.get(index), source.messages.get(index))
    index = index + 1
  end
end

def copyMappedDiagnostics(source: DiagnosticBuffer, target: PreparedSubmission, submitted: String, syntax: SubmissionSyntax, declarationStart: Int, statementStart: Int): Void
  let declarationLength = utf16Length(submissionParts(submitted, syntax.declarationStarts, syntax.declarationLengths))
  let statementLength = utf16Length(submissionParts(submitted, syntax.statementStarts, syntax.statementLengths))
  var index = 0

  while index < source.count()
    let generated = source.starts.get(index)
    var start = 0

    if generated >= declarationStart && generated < declarationStart + declarationLength
      start = submissionPartPosition(submitted, generated - declarationStart, syntax.declarationStarts, syntax.declarationLengths)
    else if generated >= statementStart && generated <= statementStart + statementLength
      start = submissionPartPosition(submitted, generated - statementStart, syntax.statementStarts, syntax.statementLengths)
    end
    target.addDiagnostic(source.codes.get(index), start, source.lengths.get(index), source.messages.get(index))
    index = index + 1
  end
end

def submissionPartPosition(source: String, generated: Int, starts: IntBuffer, lengths: IntBuffer): Int
  var offset = 0
  var index = 0

  while index < starts.size
    let startByte = byteAtUtf16(source, starts.get(index))
    let finishByte = byteAtUtf16(source, starts.get(index) + lengths.get(index))
    let part = host::stringSlice(source, startByte, finishByte - startByte)
    var emitted = lengths.get(index)

    if part != "" && host::stringByteAt(part, host::stringByteLength(part) - 1) != (10 as Byte)
      emitted = emitted + 1
    end
    if generated < offset + emitted
      let within = generated - offset

      return starts.get(index) + (within < lengths.get(index) ? within : lengths.get(index))
    end
    offset = offset + emitted
    index = index + 1
  end
  return 0
end
