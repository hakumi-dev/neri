use host

class PreparedSubmission
  private owner: String
  private ownerEnvironment: Int
  private candidateId: Int
  public generation: Int
  public status: readonly SubmissionStatus = SubmissionStatus.invalid()
  public diagnostics: SessionDiagnostic?
  private diagnosticTail: SessionDiagnostic?
  public declarations: String = ""
  public statements: String = ""
  public analysisSource: String = ""
  public executionSource: String = ""
  public frameSource: String = ""
  public entryName: String = "__neri_session_entry"
  public firstBinding: SessionBinding?
  public firstType: SessionTypeMetadata?
  public bindingCount: Int = 0
  public declarationCount: Int = 0
  public resultType: String = "Void"
  public consumed: Bool = false

  def init(generation: Int, owner: String, ownerEnvironment: Int, candidateId: Int): Void
    this.generation = generation
    this.owner = owner
    this.ownerEnvironment = ownerEnvironment
    this.candidateId = candidateId
  end

  def matches(owner: String, ownerEnvironment: Int, candidateId: Int): Bool
    return this.owner == owner && this.ownerEnvironment == ownerEnvironment && this.candidateId == candidateId
  end

  def belongsTo(owner: String, ownerEnvironment: Int): Bool
    return this.owner == owner && this.ownerEnvironment == ownerEnvironment
  end

  def addDiagnostic(code: String, start: Int, length: Int, message: String): Void
    let diagnostic = new SessionDiagnostic(code, start, length, message)

    if this.diagnostics == null
      this.diagnostics = diagnostic
    else
      let tail = this.diagnosticTail

      if tail != null
        tail.next = diagnostic
      end
    end
    this.diagnosticTail = diagnostic
  end

  def addBinding(binding: SessionBinding): Void
    binding.next = this.firstBinding
    this.firstBinding = binding
    this.bindingCount = this.bindingCount + 1
  end

  def addType(item: SessionTypeMetadata): Void
    item.next = this.firstType
    this.firstType = item
  end
end
