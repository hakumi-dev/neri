class SessionExecutionResult
  public succeeded: Bool
  public status: Int
  public message: String
  public cacheHit: Bool = false
  public resultType: String = "Void"
  public resultText: String = ""

  def init(status: Int, message: String = ""): Void
    this.status = status
    this.succeeded = status == 0
    this.message = message
  end
end
