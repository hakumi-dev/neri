class SessionExecutionResult
  public status: readonly SessionExecutionStatus
  public message: String
  public cacheHit: Bool = false
  public resultType: String = "Void"
  public resultText: String = ""

  def init(status: readonly SessionExecutionStatus, message: String = ""): Void
    this.status = status
    this.message = message
  end

  def succeeded(): Bool
    return this.status.isSuccess()
  end
end
