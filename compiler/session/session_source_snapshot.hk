use host

class SessionSourceSnapshot
  private text: String = ""
  private paths: StringBuffer = new StringBuffer()
  private finishes: IntBuffer = new IntBuffer()
  private sources: StringBuffer = new StringBuffer()
  private libraryNames: StringBuffer = new StringBuffer()
  private librarySources: StringBuffer = new StringBuffer()
  private libraryBytes: Int = 0
  public error: String = ""
  public configuration: String = ""

  def add(path: String, source: String): Void
    if this.error != ""
      return
    end
    if host.stringByteLength(this.text) > 1048576 - host.stringByteLength(source) - 1
      this.error = "Project source snapshot exceeds 1048576 bytes."
      return
    end
    this.text = this.text + source + "\n"
    this.paths.add(path)
    this.sources.add(source)
    this.finishes.add(utf16Length(this.text))
  end

  def source(): String
    return this.text
  end

  def count(): Int
    return this.sources.size
  end

  def sourceAt(index: Int): String
    return this.sources.get(index)
  end

  def frozenCopy(): SessionSourceSnapshot
    let result = new SessionSourceSnapshot()
    var path = this.paths.first.nextNode
    var source = this.sources.first.nextNode

    while path != null && source != null
      result.paths.add(path.value)
      result.sources.add(source.value)
      path = path.nextNode
      source = source.nextNode
    end
    result.text = this.text
    var finish = this.finishes.first.nextNode

    while finish != null
      result.finishes.add(finish.value)
      finish = finish.nextNode
    end
    var name = this.libraryNames.first.nextNode
    var library = this.librarySources.first.nextNode

    while name != null && library != null
      result.addLibrary(name.value, library.value)
      name = name.nextNode
      library = library.nextNode
    end
    result.error = this.error
    result.configuration = this.configuration
    return result
  end

  def cacheInputs(): String
    var result = runCacheFrame(this.configuration)
    var path = this.paths.first.nextNode

    while path != null
      result = result + runCacheFrame(path.value)
      path = path.nextNode
    end
    return result
  end

  def captureLibraries(source: String): Void
    let directory = host.environment("NERI_STDLIB")

    if directory == null || directory == ""
      this.error = "Required standard library core is unavailable."
      return
    end
    let libraries = new StandardLibraryCatalog(directory)
    let pending = new StringBuffer()
    var index = 0

    pending.add(source)
    while index < pending.size
      if this.error != ""
        return
      end
      for name in bootstrapLibraryImports(pending.get(index))
        let paths = libraries.sourcePaths(name)

        if libraries.error != "" || (name == bootstrapCoreLibraryName() && paths.size == 0)
          this.error = libraries.error != "" ? libraries.error : "Required standard library core is unavailable."
          return
        end
        var path = paths.first.nextNode

        while path != null
          let sourceName = host.stringSlice(path.value, 0, host.stringByteLength(path.value) - 3)

          if !this.hasLibrary(sourceName)
            let text = host.readText(directory + "/" + path.value)

            if text != null
              this.addLibrary(sourceName, text)
              pending.add(text)
            else
              this.error = "Standard-library source is unavailable: " + path.value
              return
            end
          end
          path = path.nextNode
        end
      end
      index = index + 1
    end
  end

  private def hasLibrary(name: String): Bool
    var item = this.libraryNames.first.nextNode

    while item != null
      if item.value == name
        return true
      end
      item = item.nextNode
    end
    return false
  end

  private def addLibrary(name: String, source: String): Void
    if host.stringByteLength(this.text) + this.libraryBytes > 1048576 - host.stringByteLength(source) - 1
      this.error = "Project and standard-library snapshot exceeds 1048576 bytes."
      return
    end
    this.libraryNames.add(name)
    this.librarySources.add(source)
    this.libraryBytes = this.libraryBytes + host.stringByteLength(source) + 1
  end

  def captureVerifiedLibraries(project: NeriProject): Void
    let directory = host.environment("NERI_STDLIB")

    if directory == null || directory == ""
      return
    end
    let libraries = new StandardLibraryCatalog(directory)
    var index = 0

    while index < project.generatedInputs.size
      let path = project.generatedInputs.get(index)
      let relative = libraries.sourceName(path)

      if relative != null
        let name = host.stringSlice(relative, 0, host.stringByteLength(relative) - 3)
        let text = neriProjectVerifiedText(project, path)

        if text != null && !this.hasLibrary(name)
          this.addLibrary(name, text)
        end
      end
      index = index + 1
    end
  end

  def libraryCount(): Int
    return this.libraryNames.size
  end

  def libraryNameAt(index: Int): String
    return this.libraryNames.get(index)
  end

  def librarySourceAt(index: Int): String
    return this.librarySources.get(index)
  end

  def librarySource(): String
    var result = ""
    var source = this.librarySources.first.nextNode

    while source != null
      result = result + source.value + "\n"
      source = source.nextNode
    end
    return result
  end

  def librarySuffix(first: Int): String
    var result = ""
    var index = first

    while index < this.libraryCount()
      result = result + this.librarySourceAt(index) + "\n"
      index = index + 1
    end
    return result
  end

  def applyLibraryBoundaries(parser: BootstrapParser, start: Int, first: Int): Void
    var offset = start
    var index = first

    while index < this.libraryCount()
      parser.addSourceBoundary(offset)
      offset = offset + utf16Length(this.librarySourceAt(index) + "\n")
      index = index + 1
    end
    parser.addSourceBoundary(offset)
  end

  def applyLibrarySources(binder: BootstrapBinder, start: Int, first: Int): Void
    binder.clearSources()
    binder.addSource("main", 0)
    var offset = start
    var index = first

    while index < this.libraryCount()
      binder.addSource("@stdlib/" + this.libraryNameAt(index) + ".hk", offset)
      offset = offset + utf16Length(this.librarySourceAt(index) + "\n")
      index = index + 1
    end
  end

  def applyBoundaries(parser: BootstrapParser, insertedBeforeLibraries: Int = 0): Void
    var index = 0

    while index < this.finishes.size
      parser.addSourceBoundary(this.finishes.get(index))
      index = index + 1
    end
    var finish = utf16Length(this.text) + insertedBeforeLibraries
    var library = this.librarySources.first.nextNode

    if library != null
      parser.addSourceBoundary(finish)
    end
    while library != null
      finish = finish + utf16Length(library.value + "\n")
      parser.addSourceBoundary(finish)
      library = library.nextNode
    end
  end

  def sourceIdentityAt(position: Int): String
    var index = 0
    var path = this.paths.first.nextNode

    while index < this.finishes.size && path != null
      if position < this.finishes.get(index)
        return path.value
      end
      index = index + 1
      path = path.nextNode
    end
    return "<submission>"
  end
end
