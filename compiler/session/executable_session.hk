class ExecutableSession
  private handle: Int
  private initializerApplied: Bool = false
  private disposed: Bool = false
  private artifacts: SessionArtifact?
  private toolchain: SessionToolchain
  private ownerIdentity: String
  private environment: SessionEnvironment
  private lastCacheHit: Bool = false
  private retainedModules: String[] = []
  private lastCodegenMetrics: String = "null"
  private lastLinkMilliseconds: Int = 0
  private lastLowerMilliseconds: Int = 0
  private lastCacheLookupMilliseconds: Int = 0
  private objectLinker: String?
  private completionRevision: Int = 0
  private startupProgress: (fn(String, Int, Int): Void)?
  private startupNativeProgress: (fn(String, Int, Int, String): Void)?

  def init(toolchain: SessionToolchain): Void
    this.toolchain = toolchain
    this.objectLinker = this.discoverObjectLinker()
    unsafe
      this.handle = sessionBridgeCreate()
      this.ownerIdentity = sessionBridgeOwner(this.handle)
    end
    this.environment = new SessionEnvironment(this.ownerIdentity)
  end

  def prepare(source: String): PreparedSubmission
    return this.environment.prepare(source)
  end

  def complete(source: String, cursorByteOffset: Int): SessionCompletionResult
    let result = this.environment.complete(source, cursorByteOffset)

    result.generation = this.completionRevision
    return result
  end

  def completionGeneration(): Int
    return this.completionRevision
  end

  private def reportStartup(phase: String, projectCount: Int = 0, libraryCount: Int = 0): Void
    let progress = this.startupProgress

    progress(phase, projectCount, libraryCount) if progress != null
  end

  private def reportNativeProgress(phase: String, completed: Int, total: Int, detail: String, sourceOffset: Int, snapshot: SessionSourceSnapshot?): Void
    let progress = this.startupNativeProgress

    if progress == null
      return
    end
    var label = detail

    if phase == "lower" && snapshot != null && sourceOffset < host::stringByteLength(snapshot.source())
      let path = snapshot.sourceIdentityAtByte(sourceOffset)

      if path != "<submission>"
        let fileName = host::pathFileName(path)

        label = (fileName == null ? path : fileName) + ": " + detail
      end
    end
    progress(phase, completed, total, label)
  end

  private def discoverObjectLinker(): String?
    if !this.toolchain.target.isMacOS()
      return null
    end
    let configured = host::environment("NERI_SESSION_OBJECT_LINKER")

    if configured != null
      if configured != "" && new RunCacheFile(configured, true).kind == 1
        return configured
      end
      return null
    end
    let manifest = host::environment("NERI_RUNTIME_MANIFEST")

    if manifest != null && manifest != ""
      let sibling = bootstrapDirectory(manifest) + "/libneri-session-object-linker.dylib"

      if new RunCacheFile(sibling, true).kind == 1
        return sibling
      end
    end
    return null
  end

  private def nativeLibraries(module: IrModule): StringBuffer
    let result = new StringBuffer()
    var imported = module.firstImport

    while imported != null
      let name = imported.nativeLibrary

      if name != ""
        var found = false
        var index = 0

        while index < result.size
          if result.get(index) == name
            found = true
          end
          index = index + 1
        end
        result.add(name) if !found
      end
      imported = imported.nextImport
    end
    return result
  end

  private def nativeLibraryList(names: StringBuffer): String
    var result = ""
    var index = 0

    while index < names.size
      result = result + "\n" if index > 0
      result = result + names.get(index)
      index = index + 1
    end
    return result
  end

  private def compile(moduleIR: IrModule, snapshot: SessionSourceSnapshot?): String?
    this.lastCacheHit = false
    this.lastCodegenMetrics = "null"
    this.lastLinkMilliseconds = 0
    this.lastCacheLookupMilliseconds = 0
    let configuredMetrics = host::environment("NERI_SESSION_METRICS")
    var cacheStarted = 0

    cacheStarted = runCacheTime() if configuredMetrics != null && configuredMetrics != ""
    let cache = new RunCache()
    let configuredLinker = host::environment("NERI_LINKER")
    let objectLinker = this.objectLinker
    let objectBackend = objectLinker != null
    let nativeLibraries = this.nativeLibraries(moduleIR)
    var serializedPayload: IrWireBuffer? = null
    var payloadDigest = ""

    if this.toolchain.cacheEnabled && (objectBackend || (configuredLinker != null && configuredLinker == this.toolchain.linker))
      var dependencies = [this.toolchain.compiler]
      var configuration = runCacheFrame(this.toolchain.compiler)

      dependencies = host::appendString(dependencies, objectLinker) if objectLinker != null

      if snapshot != null
        configuration = configuration + snapshot.cacheInputs()
      end

      for retained in this.retainedModules
        dependencies = host::appendString(dependencies, retained)
      end
      let payload = irSerializePayload(moduleIR)

      serializedPayload = payload
      payloadDigest = sha256FastWire(payload.bytes)
      let identity = runCacheFrame(irTransportMajor() as String) + runCacheFrame(moduleIR.requiredFeatures.minimumTransportMinor() as String) + runCacheFrame(payloadDigest)

      cache.prepare(moduleIR, this.toolchain.target, this.toolchain.release, null,
        objectBackend ? "neri-session-object-cache-v2" : "neri-session-code-cache-v2",
        configuration, dependencies, sessionCodeDigest(identity), objectBackend)
    end
    this.lastCacheLookupMilliseconds = runCacheTime() - cacheStarted if configuredMetrics != null && configuredMetrics != ""
    this.reportStartup("cache-check") if cache.directory != ""
    if cache.hit()
      this.lastCacheHit = true
      this.reportStartup("cache-hit")
      return cache.executable
    end
    var directory: String? = null

    if cache.directory != ""
      directory = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "pending-session")
    end
    if directory == null
      directory = bootstrapTemporaryDirectory(this.toolchain.workRoot, "session-module")
    end
    if directory == null
      return null
    end
    let source = directory + "/submission.hk"
    let module = directory + "/program"
    let object = objectBackend ? module : directory + "/submission.o"
    let artifact = new SessionArtifact(directory, source, object, module)
    var codegenMetrics = ""

    if configuredMetrics != null && configuredMetrics != ""
      codegenMetrics = directory + "/codegen-metrics.json"
      artifact.extraSources.add(codegenMetrics)
    end

    artifact.extraSources.add(directory + "/receipt")
    artifact.next = this.artifacts
    this.artifacts = artifact
    this.reportStartup("codegen")
    let nativeProgress = this.startupNativeProgress
    var relay: (fn(String, Int, Int, String, Int): Void)? = null

    if nativeProgress != null
      relay = fn(phase, completed, total, detail, sourceOffset)
        this.reportNativeProgress(phase, completed, total, detail, sourceOffset, snapshot)
      end
    end
    var serialized = ""
    let payload = serializedPayload

    if payload != null
      serialized = irSerializeEnvelopePayloadHex(moduleIR, payload, payloadDigest)
    end
    if !bootstrapInvokeCodegen(moduleIR, EmissionKind.object(), object, this.toolchain.target, this.toolchain.release, null, codegenMetrics, serialized, relay)
      this.rollbackArtifact(artifact)
      return null
    end
    if codegenMetrics != ""
      let measuredCodegen = host::readText(codegenMetrics)

      this.lastCodegenMetrics = measuredCodegen if measuredCodegen != null
      host::removeFile(codegenMetrics)
    end
    if objectBackend
      if cache.publish(directory)
        this.artifacts = artifact.next
        return cache.executable
      end
      if cache.hit()
        this.rollbackArtifact(artifact)
        return cache.executable
      end
      return module
    end
    var linkStarted = 0

    linkStarted = runCacheTime() if configuredMetrics != null && configuredMetrics != ""
    this.reportStartup("link")
    var linkArguments = [object, "-o", module]
    var installNameIndex = -1

    for retained in this.retainedModules
      linkArguments = host::appendString(linkArguments, retained)
    end
    if nativeLibraries.size > 0
      var nativeDirectory = this.toolchain.target.isMacOS() ? "/opt/homebrew/lib" : ""
      let configured = host::environment("NERI_LIBRARY_PATH")

      nativeDirectory = configured if configured != null && configured != ""
      if nativeDirectory != ""
        if !platformAbsolutePath(nativeDirectory, this.toolchain.target)
          this.rollbackArtifact(artifact)
          return null
        end
        linkArguments = platformLibraryArguments(linkArguments, nativeDirectory, this.toolchain.target)
      end
      var index = 0

      while index < nativeLibraries.size
        linkArguments = host::appendString(linkArguments, "-l" + nativeLibraries.get(index))
        index = index + 1
      end
    end
    if this.toolchain.target.isMacOS()
      linkArguments = host::appendString(linkArguments, "-dynamiclib")
      linkArguments = host::appendString(linkArguments, "-Wl,-undefined,dynamic_lookup")
      if cache.directory != ""
        for option in ["-Xlinker", "-install_name", "-Xlinker", cache.executable]
          linkArguments = host::appendString(linkArguments, option)
        end
        installNameIndex = linkArguments.Length - 1
      end
    else if this.toolchain.target.isLinux()
      linkArguments = host::appendString(linkArguments, "-shared")
      linkArguments = host::appendString(linkArguments, "-Wl,-Bsymbolic")
    else
      linkArguments = host::appendString(linkArguments, "-shared")
    end
    let linkStatus = host::run(this.toolchain.linker, linkArguments)

    this.lastLinkMilliseconds = runCacheTime() - linkStarted if configuredMetrics != null && configuredMetrics != ""
    if linkStatus == null || linkStatus != 0
      this.rollbackArtifact(artifact)
      return null
    end
    if cache.publish(directory)
      host::removeFile(cache.directory + "/submission.o")
      this.artifacts = artifact.next
      return cache.executable
    end
    if cache.hit()
      this.rollbackArtifact(artifact)
      return cache.executable
    end
    if installNameIndex >= 0
      linkArguments[installNameIndex] = module
      let relink = host::run(this.toolchain.linker, linkArguments)

      if relink == null || relink != 0
        this.rollbackArtifact(artifact)
        return null
      end
    end
    host::removeFile(object)
    return module
  end

  private def rollbackArtifact(artifact: SessionArtifact): Void
    this.artifacts = artifact.next
    host::removeFile(artifact.module)
    host::removeFile(artifact.object)
    host::removeFile(artifact.source)
    var extra = artifact.extraSources.first.nextNode

    while extra != null
      host::removeFile(extra.value)
      extra = extra.nextNode
    end
    bootstrapRemoveRunDirectory(artifact.directory)
  end

  private def executeModule(prepared: PreparedSubmission, modulePath: String, artifactIdentity: String, nativeLibraries: String): SessionExecutionResult
    if this.disposed
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), "submission is not executable")
    end
    var status = SessionExecutionStatus.invalidHandle()
    var message = ""
    let resultType = this.environment.claimedResultType(prepared)
    var resultText = ""
    let configuredMetrics = host::environment("NERI_SESSION_METRICS")
    var loadStarted = 0
    var resultStarted = 0
    var moduleLoadMilliseconds = 0
    var resultMilliseconds = 0

    loadStarted = runCacheTime() if configuredMetrics != null && configuredMetrics != ""
    this.reportStartup("load")

    unsafe
      let objectLinker = this.objectLinker

      if objectLinker != null
        status = sessionBridgeLoadExecuteObjectLibraries(this.handle, modulePath, artifactIdentity, objectLinker, nativeLibraries)
      else
        status = sessionBridgeLoadExecuteRetained(this.handle, modulePath, artifactIdentity)
      end
      moduleLoadMilliseconds = runCacheTime() - loadStarted if configuredMetrics != null && configuredMetrics != ""
      if !status.isSuccess()
        message = sessionBridgeError(this.handle)
      else
        resultStarted = runCacheTime() if configuredMetrics != null && configuredMetrics != ""
        resultText = sessionBridgeResult(this.handle)
        resultMilliseconds = runCacheTime() - resultStarted if configuredMetrics != null && configuredMetrics != ""
      end
    end
    if configuredMetrics != null && configuredMetrics != ""
      let loadMilliseconds = runCacheTime() - loadStarted

      this.writeMetrics(artifactIdentity, loadMilliseconds, moduleLoadMilliseconds, resultMilliseconds)
    end
    if status.isSuccess() && !this.environment.commit(prepared)
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), "prepared submission became stale")
    end
    let result = new SessionExecutionResult(status, message)

    if status.isSuccess()
      this.completionRevision = this.completionRevision + 1
      this.retainedModules = host::appendString(this.retainedModules, modulePath)
      result.resultType = resultType
      result.resultText = resultText
    end
    return result
  end

  private def writeMetrics(artifactIdentity: String, loadMilliseconds: Int, moduleLoadMilliseconds: Int, resultMilliseconds: Int): Void
    let configured = host::environment("NERI_SESSION_METRICS")

    if configured == null || configured == ""
      return
    end
    let generation = this.retainedModules.Length + 1
    let text = "{\"schemaVersion\":1,\"ownerIdentity\":\"" + this.ownerIdentity + "\",\"generation\":" + (generation as String) + ",\"artifactIdentity\":\"" + artifactIdentity + "\",\"cacheHit\":" + (this.lastCacheHit ? "true" : "false") + ",\"lowerMs\":" + (this.lastLowerMilliseconds as String) + ",\"cacheLookupMs\":" + (this.lastCacheLookupMilliseconds as String) + ",\"linkMs\":" + (this.lastLinkMilliseconds as String) + ",\"loadExecuteMs\":" + (loadMilliseconds as String) + ",\"moduleLoadExecuteMs\":" + (moduleLoadMilliseconds as String) + ",\"resultReadMs\":" + (resultMilliseconds as String) + ",\"codegen\":" + this.lastCodegenMetrics + "}\n"

    host::writeText(configured + "/" + artifactIdentity + (this.lastCacheHit ? ".hit.json" : ".miss.json"), text)
  end

  def execute(prepared: PreparedSubmission): SessionExecutionResult
    if this.disposed
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), "submission is not executable")
    end
    let executionSource = this.environment.claimExecution(prepared)

    if executionSource == null
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), "submission is not executable")
    end
    let snapshot = this.environment.claimedSnapshot(prepared)

    if snapshot != null
      this.reportStartup("compile", snapshot.count(), snapshot.libraryCount())
    end
    let configuredMetrics = host::environment("NERI_SESSION_METRICS")
    var lowerStarted = 0

    lowerStarted = runCacheTime() if configuredMetrics != null && configuredMetrics != ""
    this.reportStartup("lower")
    let moduleIR = this.environment.claimedModule(prepared)

    this.lastLowerMilliseconds = runCacheTime() - lowerStarted if configuredMetrics != null && configuredMetrics != ""

    if moduleIR == null
      let error = this.environment.claimedCompilationError(prepared)

      this.environment.releaseExecution(prepared)
      return new SessionExecutionResult(SessionExecutionStatus.compilationFailed(), "session module lowering failed: " + error)
    end
    let module = this.compile(moduleIR, snapshot)

    if module == null
      this.environment.releaseExecution(prepared)
      return new SessionExecutionResult(SessionExecutionStatus.compilationFailed(), "session module compilation failed")
    end
    let result = this.executeModule(prepared, module, moduleIR.sessionArtifactIdentity, this.nativeLibraryList(this.nativeLibraries(moduleIR)))

    result.cacheHit = this.lastCacheHit
    if !result.succeeded()
      this.environment.releaseExecution(prepared)
    end
    return result
  end

  def submit(source: String): SessionResponse
    let prepared = this.prepare(source)

    if !prepared.status.isComplete()
      return new SessionResponse(prepared, new SessionExecutionResult(SessionExecutionStatus.invokeState(), prepared.status.name()))
    end
    return new SessionResponse(prepared, this.execute(prepared))
  end

  def initialize(prepared: PreparedSubmission): SessionExecutionResult
    if this.initializerApplied
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), "initializer has already run")
    end
    let result = this.execute(prepared)

    if result.succeeded()
      this.initializerApplied = true
    end
    return result
  end

  def initializeProject(projectPath: String, unit: String, functionName: String, bindingName: String = "service", imports: String = "", progress: (fn(String, Int, Int): Void)? = null, nativeProgress: (fn(String, Int, Int, String): Void)? = null): SessionExecutionResult
    if this.disposed
      return new SessionExecutionResult(SessionExecutionStatus.invalidHandle(), "session is disposed")
    end
    progress("project", 0, 0) if progress != null
    let project = neriLoadProject(projectPath, unit)

    if project.error() != ""
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), project.error())
    end
    let snapshot = sessionSnapshotFromProject(project)

    if snapshot.error != ""
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), snapshot.error)
    end
    progress("analyze", snapshot.count(), snapshot.libraryCount()) if progress != null
    let prepared = this.environment.validateInitializer(snapshot, functionName, bindingName, imports)

    if !prepared.status.isComplete()
      var message = "invalid initializer"
      let diagnostic = prepared.diagnostics

      if diagnostic != null
        message = diagnostic.message
      end
      return new SessionExecutionResult(SessionExecutionStatus.invokeState(), message)
    end
    this.startupProgress = progress
    this.startupNativeProgress = nativeProgress
    let result = this.initialize(prepared)

    this.startupProgress = null
    this.startupNativeProgress = null
    return result
  end

  private def removeArtifacts(): Void
    var artifact = this.artifacts

    while artifact != null
      host::removeFile(artifact.module)
      host::removeFile(artifact.object)
      host::removeFile(artifact.source)
      var extra = artifact.extraSources.first.nextNode

      while extra != null
        host::removeFile(extra.value)
        extra = extra.nextNode
      end
      bootstrapRemoveRunDirectory(artifact.directory)
      artifact = artifact.next
    end
    this.artifacts = null
  end

  def reset(): SessionExecutionResult
    if this.disposed
      return new SessionExecutionResult(SessionExecutionStatus.invalidHandle(), "session is disposed")
    end
    var status = SessionExecutionStatus.invalidHandle()
    var message = ""

    unsafe
      status = sessionBridgeReset(this.handle)
      if !status.isSuccess()
        message = sessionBridgeError(this.handle)
      end
    end
    if status.isSuccess()
      this.removeArtifacts()
      this.retainedModules = []
      this.environment.dispose()
      this.environment = new SessionEnvironment(this.ownerIdentity)
      this.completionRevision = this.completionRevision + 1
      this.initializerApplied = false
    end
    return new SessionExecutionResult(status, message)
  end

  def dispose(): SessionExecutionResult
    if this.disposed
      return new SessionExecutionResult(SessionExecutionStatus.success())
    end
    var status = SessionExecutionStatus.invalidHandle()

    unsafe
      status = sessionBridgeDestroy(this.handle)
    end
    if status.isSuccess()
      this.removeArtifacts()
      this.retainedModules = []
      this.environment.dispose()
      this.disposed = true
    end
    return new SessionExecutionResult(status)
  end
end
