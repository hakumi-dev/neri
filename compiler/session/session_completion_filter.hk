use host

class SessionCompletionFilter: SemanticCompletionFilter
  public generation: Int = 0

  def excludes(name: String, identity: String): Bool
    if super.excludes(name, identity) || identity == "callable:__neri_session_entry" || textStartsWith(identity, "__neri_session_entry/parameter[")
      return true
    end
    let prefix = "type:__NeriSessionState"

    if textStartsWith(identity, prefix)
      let suffix = host.stringSlice(identity, host.stringByteLength(prefix), host.stringByteLength(identity) - host.stringByteLength(prefix))
      let frame = host.parseInt(suffix)

      return frame != null && frame >= 0 && frame < this.generation && suffix == (frame as String)
    end
    return false
  end
end
