class SessionToolchain
  public compiler: String
  public linker: String
  public target: String
  public workRoot: String
  public release: Bool
  public cacheEnabled: Bool

  def init(compiler: String, linker: String, target: String, workRoot: String, release: Bool = false, cacheEnabled: Bool = true): Void
    this.compiler = compiler
    this.linker = linker
    this.target = target
    this.workRoot = workRoot
    this.release = release
    this.cacheEnabled = cacheEnabled
  end
end
