use host
use files

# Cache entries are compiler-owned data, never executable code or raw heap images.
# Consumers supply the complete ordered analysis input and binder policy.
class SemanticSnapshotCache
  public status: String = "disabled"
  public path: String = ""
  private directory: String = ""

  def prepare(context: String): Void
    this.status = "disabled"
    this.path = ""
    this.directory = ""
    let disabled = host::environment("NERI_SEMANTIC_CACHE")

    if disabled != null && disabled == "0"
      return
    end
    let executable = host::executablePath()
    let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

    if executable == null || manifestPath == null
      return
    end
    let compiler = referenceFileDigest(executable)
    let manifest = host::readText(manifestPath)

    if compiler == "" || manifest == null
      return
    end
    var root = ""
    let configured = host::environment("NERI_CACHE_DIR")
    let homeDirectory = host::environment("HOME")

    if configured != null
      root = configured
    else if homeDirectory != null
      root = homeDirectory + "/.neri-run-cache"
    end
    if !bootstrapStartsWith(root, "/") || root == "/"
      return
    end
    let access = new RunCache()

    files::createDirectory(root)
    if !access.privateDirectory(root)
      return
    end
    this.directory = root + "/semantic"
    files::createDirectory(this.directory)
    if !access.privateDirectory(this.directory)
      this.directory = ""
      return
    end
    let identity = runCacheFrame("neri-semantic-cache-v1") + runCacheFrame(compiler) + runCacheFrame(manifest) + runCacheFrame(context)

    this.path = this.directory + "/" + sha256FastText(identity) + ".snapshot"
    this.status = "miss"
  end

  def load(): SemanticSnapshot?
    if this.path == ""
      return null
    end
    let before = new RunCacheFile(this.path, false)

    if !before.owned || before.kind != 1
      return null
    end
    let read = files::readBytes(this.path, 67108929)
    let bytes = read.bytes

    if read.failure != null || read.closeFailure != null || bytes == null
      this.status = "corrupt"
      return null
    end
    let content = host::stringFromBytes(bytes)
    let after = new RunCacheFile(this.path, false)

    if content == null || host::stringByteLength(content) < 65 || before.fingerprint != after.fingerprint || !after.owned || after.kind != 1
      this.status = "corrupt"
      return null
    end
    let digest = host::stringSlice(content, 0, 64)
    let payload = host::stringSlice(content, 65, host::stringByteLength(content) - 65)

    if host::stringByteAt(content, 64) != 10 as Byte || digest != sha256FastText(payload)
      this.status = "corrupt"
      return null
    end
    let snapshot = semanticSnapshotDecode(payload)

    this.status = snapshot == null ? "corrupt" : "hit"
    return snapshot
  end

  def store(model: SemanticModel, root: Int): Bool
    if this.path == ""
      return false
    end
    let payload = semanticSnapshotEncode(model, root)

    if payload == null
      this.status = "unsupported"
      return false
    end
    let temporary = bootstrapTemporaryDirectory(this.directory, "pending")

    if temporary == null
      return false
    end
    let staged = temporary + "/snapshot"
    let written = host::writeText(staged, sha256FastText(payload) + "\n" + payload)
    var published = false

    if written
      published = files::move(staged, this.path).failure == null
    end
    bootstrapRemoveRunDirectory(temporary)
    return published
  end
end
