use host

def semanticSnapshotWriteSyntax(writer: SemanticSnapshotWriter, syntax: SyntaxArena): Void
  writer.fail() if syntax.parent != null
  writer.integer(syntax.count())
  var node = syntax.first.nextNode

  while node != null && !writer.failed
    writer.string(node.kind.name())
    writer.string(node.data)
    writer.string(node.value)
    writer.integers(node.children)
    let declaration = node.declaration

    writer.boolean(declaration != null)
    if declaration != null
      writer.string(declaration.namespaceName)
      writer.string(declaration.name)
      writer.string(declaration.access.name())
      writer.integer(declaration.annotationCount)
      writer.integer(declaration.parameterCount)
      writer.integer(declaration.bodyCount)
      writer.boolean(declaration.isStatic)
      writer.boolean(declaration.isUnsafe)
      writer.boolean(declaration.isAlternative)
      writer.boolean(declaration.isResource)
    end
    let imported = node.importDeclaration

    writer.boolean(imported != null)
    if imported != null
      writer.string(imported.namespaceName)
      writer.string(imported.alias)
    end
    let modifier = node.modifierKind

    writer.boolean(modifier != null)
    writer.string(modifier.name()) if modifier != null
    let operation = node.operatorKind

    writer.boolean(operation != null)
    writer.string(operation.name()) if operation != null
    writer.string(node.parameterMode.name())
    writer.string(node.annotationKind.name())
    writer.strings(node.typeParameters)
    writer.integers(node.typeParameterConstraints)
    writer.integers(node.typeArguments)
    writer.integers(node.classAnnotations)
    writer.integers(node.modifiers)
    writer.integer(node.start)
    writer.integer(node.length)
    writer.integer(node.secondaryStart)
    writer.integer(node.secondaryLength)
    writer.integer(node.irStart)
    writer.integer(node.irLength)
    writer.integer(node.statementStart)
    node = node.nextNode
  end
end

def semanticSnapshotIndices(reader: SemanticSnapshotReader, values: Int[], limit: Int, missing: Bool = false): Void
  for value in values
    reader.fail() if (value < 0 && !(missing && value == -1)) || value >= limit
  end
end

def semanticSnapshotDeclaration(reader: SemanticSnapshotReader, arena: SyntaxArena, kind: readonly SyntaxKind, children: Int[]): readonly SyntaxDeclaration?
  let present = reader.boolean()

  if !present
    reader.fail() if syntaxDeclarationKind(kind)
    return null
  end
  let namespaceName = reader.string()
  let name = reader.string()
  let access = reader.access()
  let annotations = reader.count()
  let parameters = reader.count()
  let bodies = reader.count()
  let isStatic = reader.boolean()
  let isUnsafe = reader.boolean()
  let alternative = reader.boolean()
  let resourceType = reader.boolean()

  if !syntaxDeclarationKind(kind) || (alternative && resourceType)
    reader.fail()
  end
  if reader.failed
    return null
  end
  if kind.isFunction()
    if children.Length != annotations + parameters + bodies + 1
      reader.fail()
      return null
    end
    return SyntaxDeclaration.callable(arena, namespaceName, name, annotations, parameters, bodies, isStatic, isUnsafe)
  else if kind.isMethod()
    if children.Length != annotations + 1
      reader.fail()
      return null
    end
    return SyntaxDeclaration.method(arena, access, annotations)
  else if kind.isClass()
    return SyntaxDeclaration.typeDeclaration(arena, namespaceName, name, access, alternative, resourceType)
  else if kind.isField()
    if children.Length < 1 || children.Length > 2
      reader.fail()
      return null
    end
    return SyntaxDeclaration.field(arena, access, name)
  else if kind.isContract()
    return SyntaxDeclaration.contract(arena, namespaceName, name)
  else if kind.isStruct() || kind.isUnion()
    return SyntaxDeclaration.nativeRecord(arena, namespaceName, name, kind.isUnion())
  end
  reader.fail()
  return null
end

def semanticSnapshotReadSyntax(reader: SemanticSnapshotReader): SyntaxArena
  let arena = new SyntaxArena()
  let count = reader.count()
  var index = 0

  while index < count && !reader.failed
    let kind = reader.kind()

    if kind.isInvalid()
      reader.fail()
      return arena
    end
    let data = reader.string()
    let value = reader.string()
    let children = reader.integers()

    # Trailing block arguments can point to nodes appended after the call.
    semanticSnapshotIndices(reader, children, count)
    reader.fail() if kind.isModifier() && children.Length != 0
    let declaration = semanticSnapshotDeclaration(reader, arena, kind, children)
    var imported: SyntaxUse? = null
    let hasImport = reader.boolean()

    if hasImport
      imported = new SyntaxUse(reader.string(), reader.string())
    end
    reader.fail() if kind.isUse() != hasImport
    if imported != null
      reader.fail() if children.Length != (imported.alias == "" ? 1 : 2)
    end
    var modifier: readonly ModifierKind? = null
    let hasModifier = reader.boolean()

    modifier = reader.modifier() if hasModifier
    reader.fail() if kind.isModifier() != hasModifier
    reader.fail() if modifier != null && modifier.isUnknown()
    if reader.failed
      return arena
    end
    var created = -1

    if declaration != null
      created = arena.addDeclaration(declaration, children)
    else if imported != null
      created = arena.addUse(imported, children)
    else if modifier != null
      created = arena.addModifier(modifier)
    else
      created = arena.add(kind, data, children)
    end
    let node = arena.nodeAt(created)

    node.data = data
    node.value = value
    node.operatorKind = reader.token() if reader.boolean()
    node.parameterMode = reader.mode()
    node.annotationKind = reader.annotation()
    node.typeParameters = reader.strings()
    node.typeParameterConstraints = reader.integers()
    node.typeArguments = reader.integers()
    node.classAnnotations = reader.integers()
    node.modifiers = reader.integers()
    semanticSnapshotIndices(reader, node.typeParameterConstraints, count, true)
    semanticSnapshotIndices(reader, node.typeArguments, count)
    semanticSnapshotIndices(reader, node.classAnnotations, count)
    semanticSnapshotIndices(reader, node.modifiers, count)
    node.start = reader.integer()
    node.length = reader.integer()
    node.secondaryStart = reader.integer()
    node.secondaryLength = reader.integer()
    node.irStart = reader.integer()
    node.irLength = reader.integer()
    node.statementStart = reader.integer()
    if node.start < 0 || node.length < 0 || node.secondaryStart < 0 || node.secondaryLength < 0 || node.irStart < 0 || node.irLength < 0 || node.statementStart < -1
      reader.fail()
    end
    index = index + 1
  end
  return arena
end

def semanticSnapshotWriteBound(writer: SemanticSnapshotWriter, bound: BoundArena): Void
  writer.fail() if bound.parent != null
  writer.integer(bound.count())
  var node = bound.first.nextNode

  while node != null && !writer.failed
    writer.string(node.kind.name())
    writer.string(node.typeName)
    writer.string(node.data)
    writer.string(node.value)
    writer.string(node.symbol)
    writer.integer(node.start)
    writer.integer(node.length)
    writer.integers(node.children)
    node = node.nextNode
  end
end

def semanticSnapshotReadBound(reader: SemanticSnapshotReader): BoundArena
  let arena = new BoundArena()
  let count = reader.count()
  var index = 0

  while index < count && !reader.failed
    let kind = reader.boundKind()

    if kind.isInvalid()
      reader.fail()
      return arena
    end
    let typeName = reader.string()
    let data = reader.string()
    let value = reader.string()
    let symbol = reader.string()
    let start = reader.integer()
    let length = reader.integer()
    let children = reader.integers()

    semanticSnapshotIndices(reader, children, index)
    reader.fail() if start < 0 || length < 0
    if reader.failed
      return arena
    end
    let created = arena.add(kind, typeName, data, start, length, children)
    let node = arena.nodeAt(created)

    node.value = value
    node.symbol = symbol
    index = index + 1
  end
  return arena
end

def semanticSnapshotEncode(model: SemanticModel, root: Int): String?
  let syntax = model.syntax

  if syntax == null || root < 0 || root >= syntax.count() || !syntax.kindAt(root).isProgram()
    return null
  end
  let writer = new SemanticSnapshotWriter()

  writer.string("neri-semantic-snapshot-v2")
  writer.integer(root)
  semanticSnapshotWriteSyntax(writer, syntax)
  semanticSnapshotWriteBound(writer, model.bound)
  semanticSnapshotWriteModel(writer, model)
  return writer.finish()
end

def semanticSnapshotDecode(payload: String): SemanticSnapshot?
  let reader = new SemanticSnapshotReader(payload)

  if reader.string() != "neri-semantic-snapshot-v2"
    return null
  end
  let root = reader.integer()
  let syntax = semanticSnapshotReadSyntax(reader)

  if reader.failed || root < 0 || root >= syntax.count() || !syntax.kindAt(root).isProgram()
    return null
  end
  let bound = semanticSnapshotReadBound(reader)

  if reader.failed
    return null
  end
  let model = semanticSnapshotReadModel(reader, syntax, bound)

  if model == null || !reader.complete()
    return null
  end
  return new SemanticSnapshot(model, syntax, root)
end
