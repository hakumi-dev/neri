use buffers
use host

class SemanticSnapshotWriter
  public failed: Bool = false
  private output: buffers::TextBuffer?
  private stringsSeen: StringTable<Int> = new StringTable<Int>()
  private stringCount: Int = 0

  def init(): Void
    this.output = buffers::TextBuffer.create(67108864, 65536)
    this.failed = this.output == null
  end

  def fail(): Void
    this.failed = true
  end

  private def append(text: String): Void
    let output = this.output

    if !this.failed && output != null
      this.failed = !output.append(text)
    end
  end

  def integer(value: Int): Void
    this.append((value as String) + "\n")
  end

  def boolean(value: Bool): Void
    this.integer(value ? 1 : 0)
  end

  def string(value: String): Void
    let previous = this.stringsSeen.find(value)

    if previous != null
      this.integer(previous.value)
      return
    end
    this.integer(-1)
    this.integer(host::stringByteLength(value))
    this.append(value)
    this.stringsSeen.add(value, this.stringCount)
    this.stringCount = this.stringCount + 1
  end

  def integers(values: Int[]): Void
    this.integer(values.Length)
    for value in values
      this.integer(value)
    end
  end

  def strings(values: String[]): Void
    this.integer(values.Length)
    for value in values
      this.string(value)
    end
  end

  def intBuffer(values: IntBuffer): Void
    this.integer(values.size)
    var index = 0

    while index < values.size
      this.integer(values.get(index))
      index = index + 1
    end
  end

  def stringBuffer(values: StringBuffer): Void
    this.integer(values.size)
    var item = values.first.nextNode

    while item != null
      this.string(item.value)
      item = item.nextNode
    end
  end

  def finish(): String?
    let output = this.output

    return null if this.failed || output == null
    return output.snapshot()
  end
end
