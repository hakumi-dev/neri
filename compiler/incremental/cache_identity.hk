use host

# The caller supplies the producer whose behavior determines this artifact.
# An empty producer is suitable only inside a parent key that already binds it.
def cacheIdentity(domain: readonly CacheDomain, producerDigest: String, format: String, inputs: String[]): String
  let framed = new StringBuffer()

  cacheIdentityField(framed, domain.name())
  cacheIdentityField(framed, format)
  cacheIdentityField(framed, producerDigest)
  cacheIdentityField(framed, inputs.Length as String)

  for input in inputs
    cacheIdentityField(framed, input)
  end
  return sha256FastText(framed.join())
end

def cacheIdentityField(output: StringBuffer, value: String): Void
  output.add((host::stringByteLength(value) as String) + ":")
  output.add(value)
end

def cacheFormatIdentity(domain: readonly CacheDomain, producerDigest: String): String
  return cacheIdentity(domain, producerDigest, "wire", [])
end
