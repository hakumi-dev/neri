use host
use arrays

class SemanticSnapshotReader
  public failed: Bool = false
  public position: Int = 0
  private payload: String
  private length: Int
  private pool: StringBuffer = new StringBuffer()
  private poolIndex: ArenaCheckpointIndex<StringNode>
  private syntaxKinds: StringTable<SyntaxKind> = new StringTable<SyntaxKind>()
  private boundKinds: StringTable<BoundKind> = new StringTable<BoundKind>()
  private modes: StringTable<ParameterMode> = new StringTable<ParameterMode>()
  private accesses: StringTable<SourceAccess> = new StringTable<SourceAccess>()
  private annotations: StringTable<AnnotationKind> = new StringTable<AnnotationKind>()
  private modifiers: StringTable<ModifierKind> = new StringTable<ModifierKind>()
  private tokens: StringTable<TokenKind> = new StringTable<TokenKind>()

  def init(payload: String): Void
    this.payload = payload
    this.length = host::stringByteLength(payload)
    this.failed = this.length > 67108864
    this.poolIndex = new ArenaCheckpointIndex<StringNode>(this.pool.first)
    for value in SyntaxKind.createCatalog()
      this.syntaxKinds.add(value.name(), value)
    end
    for value in BoundKind.createCatalog()
      this.boundKinds.add(value.name(), value)
    end
    for value in ParameterMode.createCatalog()
      this.modes.add(value.name(), value)
    end
    for value in SourceAccess.createCatalog()
      this.accesses.add(value.name(), value)
    end
    for value in AnnotationKind.createCatalog()
      this.annotations.add(value.name(), value)
    end
    for value in ModifierKind.createCatalog()
      this.modifiers.add(value.name(), value)
    end
    for value in TokenKind.createCatalog()
      this.tokens.add(value.name(), value)
    end
  end

  def fail(): Void
    this.failed = true
  end

  def integer(): Int
    if this.failed
      return 0
    end
    let start = this.position

    while this.position < this.length && this.position - start <= 20
      let byte = host::stringByteAt(this.payload, this.position) as Int

      if byte == 10
        let value = host::parseInt(host::stringSlice(this.payload, start, this.position - start))

        this.position = this.position + 1
        if value != null
          return value
        end
        break
      end
      if (byte < 48 || byte > 57) && !(byte == 45 && this.position == start)
        break
      end
      this.position = this.position + 1
    end
    this.failed = true
    return 0
  end

  def count(limit: Int = 1000000): Int
    let value = this.integer()

    if value < 0 || value > limit || value > this.length - this.position
      this.failed = true
      return 0
    end
    return value
  end

  def index(limit: Int, allowMissing: Bool = false): Int
    let value = this.integer()

    if (value < 0 && !(allowMissing && value == -1)) || value >= limit
      this.failed = true
      return -1
    end
    return value
  end

  def boolean(): Bool
    let value = this.integer()

    this.failed = true if value != 0 && value != 1
    return value == 1
  end

  def string(): String
    let id = this.integer()

    if this.failed
      return ""
    end
    if id == -1
      let size = this.count(67108864)

      if this.failed
        return ""
      end
      let value = host::stringSlice(this.payload, this.position, size)

      this.position = this.position + size
      this.pool.add(value)
      let index = this.pool.size - 1
      let block = arenaCheckpointBlockSize()

      this.poolIndex.add(this.pool.last) if (index / block) * block == index
      return value
    end
    if id < 0 || id >= this.pool.size
      this.failed = true
      return ""
    end
    let block = arenaCheckpointBlockSize()
    var node: StringNode? = this.poolIndex.get(id / block)
    var cursor = (id / block) * block

    while node != null && cursor < id
      node = node.nextNode
      cursor = cursor + 1
    end
    if node == null
      this.failed = true
      return ""
    end
    return node.value
  end

  def integers(): Int[]
    let count = this.count()
    let reader = this

    let values = arrays::generate<Int>(count) do |index|
      return reader.integer()
    end

    return values
  end

  def strings(): String[]
    let count = this.count()
    let reader = this

    let values = arrays::generate<String>(count) do |index|
      return reader.string()
    end

    return values
  end

  def intBuffer(): IntBuffer
    let count = this.count()
    let values = new IntBuffer()
    var index = 0

    while index < count && !this.failed
      values.add(this.integer())
      index = index + 1
    end
    return values
  end

  def stringBuffer(): StringBuffer
    let count = this.count()
    let values = new StringBuffer()
    var index = 0

    while index < count && !this.failed
      values.add(this.string())
      index = index + 1
    end
    return values
  end

  def complete(): Bool
    return !this.failed && this.position == this.length
  end

  def kind(): readonly SyntaxKind
    let value = this.syntaxKinds.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new SyntaxKindCatalog()).getInvalid()
  end

  def boundKind(): readonly BoundKind
    let value = this.boundKinds.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new BoundKindCatalog()).getInvalid()
  end

  def mode(): readonly ParameterMode
    let value = this.modes.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new ParameterModeCatalog()).getOrdinary()
  end

  def access(): readonly SourceAccess
    let value = this.accesses.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new SourceAccessCatalog()).getInternal()
  end

  def annotation(): readonly AnnotationKind
    let value = this.annotations.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new AnnotationKindCatalog()).getUnknown()
  end

  def modifier(): readonly ModifierKind
    let value = this.modifiers.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new ModifierKindCatalog()).getUnknown()
  end

  def token(): readonly TokenKind
    let value = this.tokens.find(this.string())

    if value != null
      return value.value
    end
    this.failed = true
    return (new TokenKindCatalog()).getInvalid()
  end
end
