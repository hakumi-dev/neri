use host
use files

# Darwin linkers record actual inputs and unsuccessful library searches using
# dependency_info records: opcode byte, UTF-8 path, then NUL. Missing candidates
# matter because a newly created library can shadow a previously selected one.
class NativeLinkInputs
  public inputs: StringBuffer = new StringBuffer()
  public missing: StringBuffer = new StringBuffer()
  public digests: StringBuffer = new StringBuffer()
  public valid: Bool = false

  def snapshot(): String
    this.digests = new StringBuffer()
    if !this.valid
      return ""
    end
    var result = ""
    var index = 0

    while index < this.inputs.size
      let path = this.inputs.get(index)
      let digest = referenceFileDigest(path)

      if digest == ""
        return ""
      end
      this.digests.add(digest)
      result = result + runCacheFrame(path) + runCacheFrame(digest)
      index = index + 1
    end
    result = result + runCacheFrame("missing")
    index = 0
    while index < this.missing.size
      let path = this.missing.get(index)
      let status = files::status(path)

      if status.failure != null || status.status == null || status.status.exists
        return ""
      end
      result = result + runCacheFrame(path)
      index = index + 1
    end
    return result
  end

  def load(path: String, objects: StringBuffer, output: String): Bool
    this.valid = false
    this.inputs = new StringBuffer()
    this.missing = new StringBuffer()
    let text = host::readText(path)

    if text == null || host::stringByteLength(text) > 4194304
      return false
    end
    let length = host::stringByteLength(text)
    var cursor = 0
    var version = false
    var complete = false
    let inputNames = new StringTable<Bool>()
    let missingNames = new StringTable<Bool>()
    let objectNames = new StringTable<Bool>()
    var object = objects.first.nextNode

    while object != null
      let absolute = host::pathAbsolute(object.value)
      let canonical = neriCanonicalPath(object.value)

      objectNames.add(absolute, true) if absolute != null
      objectNames.add(canonical, true) if canonical != null
      object = object.nextNode
    end
    let expectedOutput = host::pathAbsolute(output)

    while cursor < length
      let opcode = host::stringByteAt(text, cursor) as Int

      cursor = cursor + 1
      let start = cursor

      while cursor < length && host::stringByteAt(text, cursor) != (0 as Byte)
        cursor = cursor + 1
      end
      if cursor == length || cursor == start || complete
        return false
      end
      let value = host::stringSlice(text, start, cursor - start)

      cursor = cursor + 1
      if opcode == 0
        if version || start != 1
          return false
        end
        version = true
      else if !version
        return false
      else if opcode == 64
        let absolute = host::pathAbsolute(value)

        if absolute == null || expectedOutput == null || absolute != expectedOutput
          return false
        end
        complete = true
      else if opcode == 16 || opcode == 17
        let absolute = host::pathAbsolute(value)

        if absolute == null
          return false
        end
        if opcode == 16
          let canonical = neriCanonicalPath(value)

          if objectNames.find(absolute) == null && (canonical == null || objectNames.find(canonical) == null) && inputNames.add(absolute, true)
            this.inputs.add(absolute)
          end
        else if missingNames.add(absolute, true)
          this.missing.add(absolute)
        end
      else
        return false
      end
    end
    this.valid = version && complete && this.inputs.size > 0
    return this.valid
  end
end
