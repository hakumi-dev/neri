def semanticSnapshotWriteNode(writer: SemanticSnapshotWriter, node: Int, limit: Int): Void
  writer.fail() if node < -1 || node >= limit
  writer.integer(node)
end

def semanticSnapshotWriteBoundNode(writer: SemanticSnapshotWriter, node: Int, bound: BoundArena): Void
  semanticSnapshotWriteNode(writer, node, bound.count())
end

def semanticSnapshotWriteSyntaxNode(writer: SemanticSnapshotWriter, node: Int, syntax: SyntaxArena): Void
  semanticSnapshotWriteNode(writer, node, syntax.count())
end

def semanticSnapshotWriteParameter(writer: SemanticSnapshotWriter, parameter: SemanticParameter, syntax: SyntaxArena, bound: BoundArena): Void
  writer.string(parameter.identity)
  writer.string(parameter.name)
  writer.string(parameter.typeName)
  writer.boolean(parameter.hasDefault)
  semanticSnapshotWriteBoundNode(writer, parameter.boundDefault, bound)
  semanticSnapshotWriteSyntaxNode(writer, parameter.syntaxNode, syntax)
  writer.string(parameter.mode.name())
end

def semanticSnapshotReadParameter(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticParameter
  let identity = reader.string()
  let name = reader.string()
  let typeName = reader.string()
  let hasDefault = reader.boolean()
  let boundDefault = reader.index(bound.count(), true)
  let syntaxNode = reader.index(syntax.count(), true)
  let mode = reader.mode()
  let parameter = new SemanticParameter(identity, name, typeName, hasDefault, syntaxNode, mode)

  parameter.boundDefault = boundDefault
  return parameter
end

def semanticSnapshotWriteLocal(writer: SemanticSnapshotWriter, local: SemanticLocal, syntax: SyntaxArena): Void
  writer.string(local.identity)
  writer.string(local.name)
  writer.string(local.typeName)
  writer.boolean(local.mutable)
  writer.integer(local.depth)
  writer.boolean(local.active)
  semanticSnapshotWriteSyntaxNode(writer, local.syntaxNode, syntax)
  writer.integer(local.resourceMove.isAvailable() ? 0 : (local.resourceMove.isMoved() ? 2 : 1))
  writer.boolean(local.resourceScoped)
end

def semanticSnapshotReadLocal(reader: SemanticSnapshotReader, syntax: SyntaxArena): SemanticLocal
  let identity = reader.string()
  let name = reader.string()
  let typeName = reader.string()
  let mutable = reader.boolean()
  let depth = reader.integer()
  let active = reader.boolean()
  let syntaxNode = reader.index(syntax.count(), true)
  let move = reader.integer()
  let scoped = reader.boolean()
  let states = new ResourceMoveStates()

  reader.fail() if depth < 0 || depth > 1024 || move < 0 || move > 2
  let state = move == 0 ? states.available : (move == 2 ? states.moved : states.maybeMoved)
  let local = new SemanticLocal(identity, name, typeName, mutable, depth, syntaxNode, state)

  local.active = active
  local.resourceScoped = scoped
  return local
end

def semanticSnapshotWriteCallable(writer: SemanticSnapshotWriter, callable: SemanticCallable, syntax: SyntaxArena, bound: BoundArena): Void
  writer.integer(callable.genericOrigin)
  writer.string(callable.fullName)
  writer.string(callable.name)
  writer.string(callable.namespaceName)
  writer.string(callable.className)
  writer.string(callable.returnType)
  writer.boolean(callable.isStatic)
  writer.boolean(callable.isUnsafe)
  writer.boolean(callable.isReadonly)
  writer.boolean(callable.isAbstract)
  writer.string(callable.access.name())
  semanticSnapshotWriteSyntaxNode(writer, callable.syntaxNode, syntax)
  writer.integer(callable.bodyStart)
  writer.integer(callable.bodyCount)
  semanticSnapshotWriteBoundNode(writer, callable.boundNode, bound)
  writer.string(callable.cAbiSymbol)
  writer.string(callable.cExportSymbol)
  writer.string(callable.nativeLibrary)
  writer.string(callable.intrinsicName)
  semanticSnapshotWriteSyntaxNode(writer, callable.operationAnnotation, syntax)
  writer.string(callable.operationBridge)
  writer.boolean(callable.exactArguments)
  writer.string(callable.operatorName)
  writer.boolean(callable.conversion)
  writer.boolean(callable.hasOverride)
  writer.boolean(callable.hasBaseConstructorCall)
  writer.string(callable.baseConstructorName)
  writer.intBuffer(callable.baseArguments)
  var argumentIndex = 0

  while argumentIndex < callable.baseArguments.size
    let argument = callable.baseArguments.get(argumentIndex)

    writer.fail() if argument < 0 || argument >= bound.count()
    argumentIndex = argumentIndex + 1
  end
  semanticSnapshotWriteBoundNode(writer, callable.baseCallNode, bound)
  var parameter = callable.firstParameter
  var count = 0

  while parameter != null && count <= 1000000
    count = count + 1
    parameter = parameter.nextParameter
  end
  writer.fail() if count > 1000000 || count != callable.parameterCount
  writer.integer(count)
  parameter = callable.firstParameter
  while parameter != null && !writer.failed
    semanticSnapshotWriteParameter(writer, parameter, syntax, bound)
    parameter = parameter.nextParameter
  end
  var local = callable.firstSessionLocal

  count = 0
  while local != null && count <= 1000000
    count = count + 1
    local = local.nextLocal
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  local = callable.firstSessionLocal
  while local != null && !writer.failed
    semanticSnapshotWriteLocal(writer, local, syntax)
    local = local.nextLocal
  end
  writer.fail() if callable.genericOrigin < -1 || callable.genericOrigin >= syntax.count() || callable.bodyStart < 0 || callable.bodyCount < 0
end

def semanticSnapshotReadCallable(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticCallable
  let genericOrigin = reader.index(syntax.count(), true)
  let fullName = reader.string()
  let name = reader.string()
  let namespaceName = reader.string()
  let className = reader.string()
  let returnType = reader.string()
  let isStatic = reader.boolean()
  let isUnsafe = reader.boolean()
  let isReadonly = reader.boolean()
  let isAbstract = reader.boolean()
  let access = reader.access()
  let syntaxNode = reader.index(syntax.count(), true)
  let bodyStart = reader.integer()
  let bodyCount = reader.integer()
  let boundNode = reader.index(bound.count(), true)
  let cAbiSymbol = reader.string()
  let cExportSymbol = reader.string()
  let nativeLibrary = reader.string()
  let intrinsicName = reader.string()
  let operationAnnotation = reader.index(syntax.count(), true)
  let operationBridge = reader.string()
  let exactArguments = reader.boolean()
  let operatorName = reader.string()
  let conversion = reader.boolean()
  let hasOverride = reader.boolean()
  let hasBaseConstructorCall = reader.boolean()
  let baseConstructorName = reader.string()
  let baseArguments = reader.intBuffer()
  let baseCallNode = reader.index(bound.count(), true)
  let callable = new SemanticCallable(fullName, name, namespaceName, className, returnType, isStatic, isUnsafe, access, syntaxNode)

  callable.genericOrigin = genericOrigin
  callable.isReadonly = isReadonly
  callable.isAbstract = isAbstract
  callable.bodyStart = bodyStart
  callable.bodyCount = bodyCount
  callable.boundNode = boundNode
  callable.cAbiSymbol = cAbiSymbol
  callable.cExportSymbol = cExportSymbol
  callable.nativeLibrary = nativeLibrary
  callable.intrinsicName = intrinsicName
  callable.operationAnnotation = operationAnnotation
  callable.operationBridge = operationBridge
  callable.exactArguments = exactArguments
  callable.operatorName = operatorName
  callable.conversion = conversion
  callable.hasOverride = hasOverride
  callable.hasBaseConstructorCall = hasBaseConstructorCall
  callable.baseConstructorName = baseConstructorName
  callable.baseArguments = baseArguments
  callable.baseCallNode = baseCallNode
  reader.fail() if bodyStart < 0 || bodyCount < 0
  var argumentIndex = 0

  while argumentIndex < baseArguments.size
    let argument = baseArguments.get(argumentIndex)

    reader.fail() if argument < 0 || argument >= bound.count()
    argumentIndex = argumentIndex + 1
  end
  var index = 0
  let parameterCount = reader.count()

  while index < parameterCount && !reader.failed
    callable.addParameter(semanticSnapshotReadParameter(reader, syntax, bound))
    index = index + 1
  end
  index = 0
  let localCount = reader.count()

  while index < localCount && !reader.failed
    callable.addSessionLocal(semanticSnapshotReadLocal(reader, syntax))
    index = index + 1
  end
  return callable
end

def semanticSnapshotWriteField(writer: SemanticSnapshotWriter, field: SemanticField, syntax: SyntaxArena, bound: BoundArena): Void
  writer.string(field.owner)
  writer.string(field.name)
  writer.string(field.typeName)
  writer.string(field.access.name())
  semanticSnapshotWriteSyntaxNode(writer, field.syntaxNode, syntax)
  semanticSnapshotWriteBoundNode(writer, field.boundInitializer, bound)
end

def semanticSnapshotReadField(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticField
  let owner = reader.string()
  let name = reader.string()
  let typeName = reader.string()
  let access = reader.access()
  let syntaxNode = reader.index(syntax.count(), true)
  let boundInitializer = reader.index(bound.count(), true)
  let field = new SemanticField(owner, name, typeName, access, syntaxNode)

  field.boundInitializer = boundInitializer
  return field
end

def semanticSnapshotWriteClass(writer: SemanticSnapshotWriter, symbol: SemanticClass, syntax: SyntaxArena, bound: BoundArena): Void
  writer.boolean(symbol.bodiesBound)
  semanticSnapshotWriteSyntaxNode(writer, symbol.genericOrigin, syntax)
  writer.strings(symbol.genericArguments)
  writer.boolean(symbol.isFunctionType)
  writer.string(symbol.quotedFunctionType)
  writer.string(symbol.fieldPackEntityType)
  writer.boolean(symbol.isSharedFunction)
  writer.boolean(symbol.isParallelFunction)
  writer.boolean(symbol.isClosure)
  writer.boolean(symbol.isAlternative)
  writer.integer(symbol.propagationSuccessCase)
  writer.integer(symbol.propagationFailureCase)
  writer.boolean(symbol.isResource)
  writer.boolean(symbol.isSealed)
  writer.boolean(symbol.isAbstract)
  writer.boolean(symbol.snapshotAbstractValidated())
  writer.string(symbol.representation)
  writer.string(symbol.fullName)
  writer.string(symbol.name)
  writer.string(symbol.namespaceName)
  writer.string(symbol.access.name())
  writer.string(symbol.baseName)
  semanticSnapshotWriteSyntaxNode(writer, symbol.syntaxNode, syntax)
  writer.intBuffer(symbol.genericMethods)
  var genericMethodIndex = 0

  while genericMethodIndex < symbol.genericMethods.size
    let genericMethod = symbol.genericMethods.get(genericMethodIndex)

    writer.fail() if genericMethod < 0 || genericMethod >= syntax.count()
    genericMethodIndex = genericMethodIndex + 1
  end
  var field = symbol.firstField
  var count = 0

  while field != null && count <= 1000000
    count = count + 1
    field = field.nextField
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  field = symbol.firstField
  while field != null && !writer.failed
    semanticSnapshotWriteField(writer, field, syntax, bound)
    field = field.nextField
  end
  var method = symbol.firstMethod

  count = 0
  while method != null && count <= 1000000
    count = count + 1
    method = method.nextCallable
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  method = symbol.firstMethod
  while method != null && !writer.failed
    semanticSnapshotWriteCallable(writer, method, syntax, bound)
    method = method.nextCallable
  end
  var requirement = symbol.firstAbstractRequirement

  count = 0
  while requirement != null && count <= 1000000
    count = count + 1
    requirement = requirement.nextRequirement
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  requirement = symbol.firstAbstractRequirement
  while requirement != null && !writer.failed
    semanticSnapshotWriteCallable(writer, requirement.callable, syntax, bound)
    requirement = requirement.nextRequirement
  end
end

def semanticSnapshotReadClass(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticClass
  let bodiesBound = reader.boolean()
  let genericOrigin = reader.index(syntax.count(), true)
  let genericArguments = reader.strings()
  let isFunctionType = reader.boolean()
  let quotedFunctionType = reader.string()
  let fieldPackEntityType = reader.string()
  let isSharedFunction = reader.boolean()
  let isParallelFunction = reader.boolean()
  let isClosure = reader.boolean()
  let isAlternative = reader.boolean()
  let propagationSuccessCase = reader.integer()
  let propagationFailureCase = reader.integer()
  let isResource = reader.boolean()
  let isSealed = reader.boolean()
  let isAbstract = reader.boolean()
  let abstractValidated = reader.boolean()
  let representation = reader.string()
  let fullName = reader.string()
  let name = reader.string()
  let namespaceName = reader.string()
  let access = reader.access()
  let baseName = reader.string()
  let syntaxNode = reader.index(syntax.count(), true)
  let genericMethods = reader.intBuffer()
  let symbol = new SemanticClass(fullName, name, namespaceName, access, syntaxNode)

  symbol.bodiesBound = bodiesBound
  symbol.genericOrigin = genericOrigin
  symbol.genericArguments = genericArguments
  symbol.isFunctionType = isFunctionType
  symbol.quotedFunctionType = quotedFunctionType
  symbol.fieldPackEntityType = fieldPackEntityType
  symbol.isSharedFunction = isSharedFunction
  symbol.isParallelFunction = isParallelFunction
  symbol.isClosure = isClosure
  symbol.isAlternative = isAlternative
  symbol.propagationSuccessCase = propagationSuccessCase
  symbol.propagationFailureCase = propagationFailureCase
  symbol.isResource = isResource
  symbol.isSealed = isSealed
  symbol.isAbstract = isAbstract
  symbol.beginAbstractValidation() if abstractValidated
  symbol.representation = representation
  symbol.baseName = baseName
  symbol.genericMethods = genericMethods
  var genericMethodIndex = 0

  while genericMethodIndex < genericMethods.size
    let genericMethod = genericMethods.get(genericMethodIndex)

    reader.fail() if genericMethod < 0 || genericMethod >= syntax.count()
    genericMethodIndex = genericMethodIndex + 1
  end
  var index = 0
  let fieldCount = reader.count()

  while index < fieldCount && !reader.failed
    symbol.addField(semanticSnapshotReadField(reader, syntax, bound))
    index = index + 1
  end
  index = 0
  let methodCount = reader.count()

  while index < methodCount && !reader.failed
    symbol.addMethod(semanticSnapshotReadCallable(reader, syntax, bound))
    index = index + 1
  end
  index = 0
  let requirementCount = reader.count()
  var previous: SemanticAbstractRequirement? = null

  while index < requirementCount && !reader.failed
    let requirement = new SemanticAbstractRequirement(semanticSnapshotReadCallable(reader, syntax, bound))

    if previous == null
      symbol.firstAbstractRequirement = requirement
    else
      previous.nextRequirement = requirement
    end
    previous = requirement
    index = index + 1
  end
  return symbol
end

def semanticSnapshotWriteRecord(writer: SemanticSnapshotWriter, record: NativeRecord, syntax: SyntaxArena): Void
  writer.string(record.name)
  writer.string(record.namespaceName)
  writer.boolean(record.unionType)
  semanticSnapshotWriteSyntaxNode(writer, record.syntaxNode, syntax)
  writer.integer(record.size)
  writer.integer(record.alignment)
  writer.boolean(record.layoutComplete())
  writer.fail() if record.layoutFailed() || record.layoutInProgress()
  var field = record.firstField
  var count = 0

  while field != null && count <= 1000000
    count = count + 1
    field = field.nextField
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  field = record.firstField
  while field != null && !writer.failed
    writer.string(field.name)
    writer.string(field.typeName)
    writer.integer(field.offset)
    semanticSnapshotWriteSyntaxNode(writer, field.syntaxNode, syntax)
    field = field.nextField
  end
end

def semanticSnapshotReadRecord(reader: SemanticSnapshotReader, syntax: SyntaxArena): NativeRecord
  let name = reader.string()
  let namespaceName = reader.string()
  let unionType = reader.boolean()
  let syntaxNode = reader.index(syntax.count(), true)
  let size = reader.integer()
  let alignment = reader.integer()
  let layoutComplete = reader.boolean()
  let record = new NativeRecord(name, namespaceName, unionType, syntaxNode)

  reader.fail() if size < 0 || size > 1073741824 || alignment < 1 || alignment > 1073741824
  record.size = size
  record.alignment = alignment
  record.finishLayout() if layoutComplete
  var index = 0
  let count = reader.count()

  while index < count && !reader.failed
    let fieldName = reader.string()
    let fieldType = reader.string()
    let offset = reader.integer()
    let fieldNode = reader.index(syntax.count(), true)
    let field = new NativeField(fieldName, fieldType, fieldNode)

    reader.fail() if offset < 0 || offset > size
    field.offset = offset
    record.addField(field)
    index = index + 1
  end
  return record
end

def semanticSnapshotWriteContract(writer: SemanticSnapshotWriter, contract: SemanticContract, syntax: SyntaxArena, bound: BoundArena): Void
  writer.string(contract.fullName)
  writer.string(contract.name)
  writer.string(contract.namespaceName)
  semanticSnapshotWriteSyntaxNode(writer, contract.syntaxNode, syntax)
  var requirement = contract.firstRequirement
  var count = 0

  while requirement != null && count <= 1000000
    count = count + 1
    requirement = requirement.nextCallable
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  requirement = contract.firstRequirement
  while requirement != null && !writer.failed
    semanticSnapshotWriteCallable(writer, requirement, syntax, bound)
    requirement = requirement.nextCallable
  end
end

def semanticSnapshotReadContract(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticContract
  let fullName = reader.string()
  let name = reader.string()
  let namespaceName = reader.string()
  let syntaxNode = reader.index(syntax.count(), true)
  let contract = new SemanticContract(fullName, name, namespaceName, syntaxNode)
  var index = 0
  let count = reader.count()

  while index < count && !reader.failed
    contract.addRequirement(semanticSnapshotReadCallable(reader, syntax, bound))
    index = index + 1
  end
  return contract
end

def semanticSnapshotWriteModel(writer: SemanticSnapshotWriter, model: SemanticModel): Void
  let syntax = model.syntax

  if model.parent != null || syntax == null || model.diagnostics.count() != 0 || model.declarations != null || model.occurrences != null || model.completionSites != null || model.genericDepth != 0
    writer.fail()
    return
  end
  let source = syntax
  let bound = model.bound

  writer.integer(model.genericTemplates.size)
  var sequenceIndex = 0

  while sequenceIndex < model.genericTemplates.size
    writer.integer(model.genericTemplates.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  writer.integer(model.genericInstances)
  writer.integer(model.nextClosureId)
  writer.integer(model.usedNames.size)
  sequenceIndex = 0
  while sequenceIndex < model.usedNames.size
    writer.string(model.usedNames.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  writer.stringBuffer(model.referencedUseNames)
  writer.integer(model.declaredNamespaces.size)
  sequenceIndex = 0
  while sequenceIndex < model.declaredNamespaces.size
    writer.string(model.declaredNamespaces.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  writer.stringBuffer(model.namespaceAliasNames)
  var index = 0

  while index < model.namespaceAliasNames.size && !writer.failed
    let name = model.namespaceAliasNames.get(index)
    let alias = model.findNamespaceAlias(name)

    if alias == null || alias.alias != name
      writer.fail()
      return
    end
    writer.string(alias.namespaceName)
    semanticSnapshotWriteSyntaxNode(writer, alias.syntaxNode, source)
    writer.boolean(model.namespaceAliasReferenced(name))
    index = index + 1
  end
  var parameter = model.typeParameters
  var count = 0

  while parameter != null && count <= 1000000
    count = count + 1
    parameter = parameter.next
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  parameter = model.typeParameters
  while parameter != null && !writer.failed
    writer.string(parameter.name)
    writer.string(parameter.capability)
    parameter = parameter.next
  end
  var symbol = model.firstClass

  count = 0
  while symbol != null && count <= 1000000
    count = count + 1
    symbol = symbol.nextClass
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  symbol = model.firstClass
  while symbol != null && !writer.failed
    semanticSnapshotWriteClass(writer, symbol, source, bound)
    symbol = symbol.nextClass
  end
  var function = model.firstFunction

  count = 0
  while function != null && count <= 1000000
    count = count + 1
    function = function.nextCallable
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  function = model.firstFunction
  while function != null && !writer.failed
    semanticSnapshotWriteCallable(writer, function, source, bound)
    function = function.nextCallable
  end
  var record = model.firstRecord

  count = 0
  while record != null && count <= 1000000
    count = count + 1
    record = record.nextRecord
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  record = model.firstRecord
  while record != null && !writer.failed
    semanticSnapshotWriteRecord(writer, record, source)
    record = record.nextRecord
  end
  var contract = model.firstContract

  count = 0
  while contract != null && count <= 1000000
    count = count + 1
    contract = contract.nextContract
  end
  writer.fail() if count > 1000000
  writer.integer(count)
  contract = model.firstContract
  while contract != null && !writer.failed
    semanticSnapshotWriteContract(writer, contract, source, bound)
    contract = contract.nextContract
  end
end

def semanticSnapshotReadModel(reader: SemanticSnapshotReader, syntax: SyntaxArena, bound: BoundArena): SemanticModel?
  let model = new SemanticModel(null, syntax.parameterModes, syntax.accesses)

  model.syntax = syntax
  model.bound = bound
  let decodedTemplates = reader.intBuffer()
  var sequenceIndex = 0

  while sequenceIndex < decodedTemplates.size
    model.genericTemplates.add(decodedTemplates.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  var templateIndex = 0

  while templateIndex < model.genericTemplates.size && !reader.failed
    let node = model.genericTemplates.get(templateIndex)

    reader.fail() if node < 0 || node >= syntax.count()
    templateIndex = templateIndex + 1
  end
  model.genericInstances = reader.integer()
  model.nextClosureId = reader.integer()
  let decodedNames = reader.stringBuffer()

  sequenceIndex = 0
  while sequenceIndex < decodedNames.size
    model.usedNames.add(decodedNames.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  model.referencedUseNames = reader.stringBuffer()
  let decodedNamespaces = reader.stringBuffer()

  sequenceIndex = 0
  while sequenceIndex < decodedNamespaces.size
    model.declaredNamespaces.add(decodedNamespaces.get(sequenceIndex))
    sequenceIndex = sequenceIndex + 1
  end
  model.namespaceAliasNames = reader.stringBuffer()
  reader.fail() if model.genericInstances < 0 || model.genericInstances > 4096 || model.nextClosureId < 0
  var index = 0

  while index < model.namespaceAliasNames.size && !reader.failed
    let name = model.namespaceAliasNames.get(index)
    let namespaceName = reader.string()
    let syntaxNode = reader.index(syntax.count(), true)
    let referenced = reader.boolean()

    reader.fail() if name == "" || model.namespaceAliases.find(name) != null
    model.namespaceAliases.add(name, new SemanticNamespaceAlias(name, namespaceName, syntaxNode))
    model.referenceNamespaceAlias(name) if referenced
    index = index + 1
  end
  index = 0
  let parameterCount = reader.count()
  var previousParameter: SemanticTypeParameter? = null

  while index < parameterCount && !reader.failed
    let parameter = new SemanticTypeParameter(reader.string(), reader.string())

    if previousParameter == null
      model.typeParameters = parameter
    else
      previousParameter.next = parameter
    end
    previousParameter = parameter
    index = index + 1
  end
  index = 0
  let classCount = reader.count()

  while index < classCount && !reader.failed
    model.addClass(semanticSnapshotReadClass(reader, syntax, bound))
    index = index + 1
  end
  index = 0
  let functionCount = reader.count()

  while index < functionCount && !reader.failed
    model.addFunction(semanticSnapshotReadCallable(reader, syntax, bound))
    index = index + 1
  end
  index = 0
  let recordCount = reader.count()

  while index < recordCount && !reader.failed
    let record = semanticSnapshotReadRecord(reader, syntax)
    let last = model.lastRecord

    if last == null
      model.firstRecord = record
    else
      last.nextRecord = record
    end
    model.lastRecord = record
    index = index + 1
  end
  index = 0
  let contractCount = reader.count()

  while index < contractCount && !reader.failed
    model.addContract(semanticSnapshotReadContract(reader, syntax, bound))
    index = index + 1
  end
  return null if reader.failed
  return model
end
