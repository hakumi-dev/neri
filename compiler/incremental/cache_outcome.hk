enum CacheOutcome
  case NotRequested()
  case Ready()
  case Hit()
  case Missing()
  case Unsupported()
  case InvalidConfiguration()
  case DependencyUnavailable()
  case InputsChanged()
  case IncompatibleFormat()
  case InvalidEntry()
  case StorageUnavailable()

end

def cacheOutcomeName(value: CacheOutcome): String
  match value
    case CacheOutcome.NotRequested()
      return "not-requested"
    case CacheOutcome.Ready()
      return "ready"
    case CacheOutcome.Hit()
      return "hit"
    case CacheOutcome.Missing()
      return "missing"
    case CacheOutcome.Unsupported()
      return "unsupported"
    case CacheOutcome.InvalidConfiguration()
      return "invalid-configuration"
    case CacheOutcome.DependencyUnavailable()
      return "dependency-unavailable"
    case CacheOutcome.InputsChanged()
      return "inputs-changed"
    case CacheOutcome.IncompatibleFormat()
      return "incompatible-format"
    case CacheOutcome.InvalidEntry()
      return "invalid-entry"
    case CacheOutcome.StorageUnavailable()
      return "storage-unavailable"
  end
end
