sealed class CacheDomain
  private label: String

  private def init(label: String): Void
    this.label = label
  end

  static def semanticSnapshot(): CacheDomain
    return new CacheDomain("semantic-snapshot")
  end

  static def referenceToolchain(): CacheDomain
    return new CacheDomain("reference-toolchain")
  end

  static def referenceContract(): CacheDomain
    return new CacheDomain("reference-contract")
  end

  static def referenceArtifact(): CacheDomain
    return new CacheDomain("reference-artifact")
  end

  static def libraryDeclarations(): CacheDomain
    return new CacheDomain("library-declarations")
  end

  static def dependencyLibrary(): CacheDomain
    return new CacheDomain("dependency-library")
  end

  static def dependencyPrefix(): CacheDomain
    return new CacheDomain("dependency-prefix")
  end

  static def sessionInitializer(): CacheDomain
    return new CacheDomain("session-initializer")
  end

  static def runExecutable(): CacheDomain
    return new CacheDomain("run-executable")
  end

  static def runObject(): CacheDomain
    return new CacheDomain("run-object")
  end

  static def project(): CacheDomain
    return new CacheDomain("project")
  end

  static def projectSources(): CacheDomain
    return new CacheDomain("project-sources")
  end

  static def sessionObject(): CacheDomain
    return new CacheDomain("session-object")
  end

  static def sessionExecutable(): CacheDomain
    return new CacheDomain("session-executable")
  end

  static def nativeLink(): CacheDomain
    return new CacheDomain("native-link")
  end

  static def nativeLinkMetadata(): CacheDomain
    return new CacheDomain("native-link-metadata")
  end

  static def nativeReceipt(): CacheDomain
    return new CacheDomain("native-receipt")
  end

  static def objectReceipt(): CacheDomain
    return new CacheDomain("object-receipt")
  end

  static def incrementalReceipt(): CacheDomain
    return new CacheDomain("incremental-receipt")
  end

  static def debugSymbols(): CacheDomain
    return new CacheDomain("debug-symbols")
  end

  readonly def name(): String
    return this.label
  end
end
