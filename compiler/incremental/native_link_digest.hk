use host
use files
use crypto

# Internal content identity, not the standard SHA-256 of the complete file.
# Frame the length, fixed chunk size and ordered SHA-256 chunk digests.
def nativeLinkFileDigest(path: String): String
  let length = host::stringByteLength(path)

  if length == 0 || length > 4096
    return ""
  end
  var index = 0

  while index < length
    return "" if host::stringByteAt(path, index) == 0 as Byte
    index = index + 1
  end
  unsafe
    let name = native::alloc<Byte>(length)
    let buffer = native::alloc<Byte>(1048576)

    index = 0
    while index < length
      name[index] = host::stringByteAt(path, index)
      index = index + 1
    end
    let fd = files::openFile(name, length)

    native::free(name)
    if fd < 0
      native::free(buffer)
      return ""
    end
    let size = files::fileSize(fd)
    var valid = size >= 0 && size <= 68719476736
    var total = 0
    let parts = new StringBuffer()

    parts.add(runCacheFrame("neri-native-link-chunks-v1"))
    parts.add(runCacheFrame(size as String))
    parts.add(runCacheFrame("1048576"))
    let digest = stackalloc Byte[32]

    while valid && total < size
      let remaining = size - total
      let wanted = remaining < 1048576 ? remaining : 1048576
      var consumed = 0

      while valid && consumed < wanted
        let count = files::readFile(fd, buffer + consumed, wanted - consumed)

        if count == -2
          continue
        end
        if count <= 0 || count > wanted - consumed
          valid = false
        else
          consumed = consumed + count
        end
      end
      if valid
        valid = crypto::nativeSha256(buffer, consumed, digest) == 0
        var encoded: Byte[] = []

        index = 0
        while valid && index < 32
          encoded = host::appendByte(encoded, digest[index])
          index = index + 1
        end
        let hex = crypto::encodeHex(encoded)

        if hex == null
          valid = false
        else if valid
          parts.add(runCacheFrame(hex))
        end
        total = total + consumed
      end
    end
    if valid
      var extra = files::readFile(fd, buffer, 1)

      while extra == -2
        extra = files::readFile(fd, buffer, 1)
      end
      valid = extra == 0 && total == size && files::fileSize(fd) == size
    end
    let closed = files::closeFile(fd)

    native::free(buffer)
    return valid && closed == 0 ? sha256FastText(parts.join()) : ""
  end
end
