use host
use process

class AgentProcessResult
  public started: Bool = false
  public status: String = "unavailable"
  public message: String = ""
  public exitKind: String = ""
  public exitCode: Int = 0
  public stdout: String = ""
  public stderr: String = ""
  public stdoutTruncated: Bool = false
  public stderrTruncated: Bool = false

  def run(options: process.SpawnOptions, timeoutMs: Int): Void
    let started = process.spawn(options)
    let failure = started.failure()

    if failure != null
      this.message = "Cannot start process: " + failure.code()
      return
    end
    let child = started.child()

    if child == null
      this.message = "Cannot start process: missing child."
      return
    end
    this.started = true
    var remaining = timeoutMs
    var completed = child.wait(remaining > 60000 ? 60000 : remaining)

    while completed.failure == null && completed.running && remaining > 60000
      remaining = remaining - 60000
      completed = child.wait(remaining > 60000 ? 60000 : remaining)
    end
    let pollFailure = completed.failure

    if pollFailure != null
      this.message = "Cannot wait for process: " + pollFailure.code()
      child.cancel()
    else if completed.running
      this.status = "timeout"
      this.message = "Process exceeded its timeout."
      child.cancel()
      completed = child.wait(5000)
    else
      this.status = "completed"
    end
    let output = host.stringFromBytes(completed.stdout)
    let errors = host.stringFromBytes(completed.stderr)

    if output == null
      this.stdout = "<non-UTF-8 output>"
    else
      this.stdout = output
    end
    if errors == null
      this.stderr = "<non-UTF-8 output>"
    else
      this.stderr = errors
    end
    this.stdoutTruncated = completed.stdoutTruncated
    this.stderrTruncated = completed.stderrTruncated
    let exit = completed.exit

    if exit != null
      this.exitKind = exit.kind
      this.exitCode = exit.value
    end
    if !child.dispose()
      this.status = "unavailable"
      this.message = "Cannot release completed process."
    end
  end
end
