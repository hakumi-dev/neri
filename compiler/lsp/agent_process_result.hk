use host
use process

sealed class AgentProcessResult
  public outcome: readonly AgentProcessOutcome = AgentProcessOutcome.notStarted()
  public message: String = ""
  private exitStatus: process.ExitStatus?
  public stdout: String = ""
  public stderr: String = ""
  public stdoutTruncated: Bool = false
  public stderrTruncated: Bool = false

  readonly def exit(): readonly process.ExitStatus?
    return this.exitStatus
  end

  readonly def exitedWith(code: Int): Bool
    let exit = this.exitStatus

    return exit != null && exit.isExited() && exit.value() == code
  end

  private def init(): Void
  end

  static def run(options: process.SpawnOptions, timeoutMs: Int): readonly AgentProcessResult
    let result = new AgentProcessResult()

    result.execute(options, timeoutMs)
    return result
  end

  private def execute(options: process.SpawnOptions, timeoutMs: Int): Void
    let started = process.spawn(options)
    let failure = started.failure()

    if failure != null
      this.message = "Cannot start process: " + failure.code()
      return
    end
    let child = started.child()

    if child == null
      this.message = "Cannot start process: missing child."
      return
    end
    this.outcome = AgentProcessOutcome.unavailable()
    var remaining = timeoutMs
    var completed = child.wait(remaining > 60000 ? 60000 : remaining)

    while completed.failure == null && completed.running && remaining > 60000
      remaining = remaining - 60000
      completed = child.wait(remaining > 60000 ? 60000 : remaining)
    end
    let pollFailure = completed.failure

    if pollFailure != null
      this.message = "Cannot wait for process: " + pollFailure.code()
      child.cancel()
    else if completed.running
      this.outcome = AgentProcessOutcome.timeout()
      this.message = "Process exceeded its timeout."
      child.cancel()
      completed = child.wait(5000)
    else
      this.outcome = AgentProcessOutcome.completed()
    end
    let output = host.stringFromBytes(completed.stdout)
    let errors = host.stringFromBytes(completed.stderr)

    if output == null
      this.stdout = "<non-UTF-8 output>"
    else
      this.stdout = output
    end
    if errors == null
      this.stderr = "<non-UTF-8 output>"
    else
      this.stderr = errors
    end
    this.stdoutTruncated = completed.stdoutTruncated
    this.stderrTruncated = completed.stderrTruncated
    this.exitStatus = completed.exit
    if !child.dispose()
      this.outcome = AgentProcessOutcome.unavailable()
      this.message = "Cannot release completed process."
    end
  end
end

def agentProcessExitName(exit: readonly process.ExitStatus?): String
  if exit == null
    return ""
  end
  return exit.name()
end

def agentProcessExitCode(exit: readonly process.ExitStatus?): Int
  if exit == null
    return 0
  end
  return exit.value()
end
