class LspDeclarationTemplate
  public id: String = ""
  public prefix: String = ""
  public label: String = ""
  public detail: String = ""
  public context: String = ""
  public provider: String = ""
  public declarationKeyword: String = ""
  public header: String = ""
  public headerText: LspTemplateText = new LspTemplateText()
  public headerLayout: LspTemplateHeader?
  public bodyKind: String = ""
  public firstLine: LspTemplateLine?
  public lastLine: LspTemplateLine?
  public lineCount: Int = 0
  public hasFinalStop: Bool = false
  public nextTemplate: LspDeclarationTemplate?

  def addLine(line: LspTemplateLine): Void
    let tail = this.lastLine

    if tail == null
      this.firstLine = line
    else
      tail.nextLine = line
    end
    this.lastLine = line
    this.lineCount = this.lineCount + 1
  end
end
