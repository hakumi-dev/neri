class LspDeclarationTemplate
  public id: String = ""
  public prefix: String = ""
  public label: String = ""
  public detail: String = ""
  public context: readonly LspTemplateContext
  public provider: readonly LspTemplateProvider
  public declarationKeyword: readonly TokenKind?
  public header: String = ""
  public headerText: LspTemplateText = new LspTemplateText()
  public headerLayout: LspTemplateHeader?
  public body: readonly LspTemplateBody
  public firstLine: LspTemplateLine?
  public lastLine: LspTemplateLine?
  public lineCount: Int = 0
  public hasFinalStop: Bool = false
  public nextTemplate: LspDeclarationTemplate?

  def init(context: LspTemplateContext, provider: LspTemplateProvider, body: LspTemplateBody): Void
    this.context = context
    this.provider = provider
    this.body = body
  end

  def keywordText(): String
    let keyword = this.declarationKeyword

    if keyword == null
      return this.prefix
    end
    return keyword.fixedText()
  end

  def addLine(line: LspTemplateLine): Void
    let tail = this.lastLine

    if tail == null
      this.firstLine = line
    else
      tail.nextLine = line
    end
    this.lastLine = line
    this.lineCount = this.lineCount + 1
  end
end
