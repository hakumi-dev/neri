# Newline edits use the ordinary parser's optional block metadata. Only the
# primary document is parsed; this query never binds or changes project state.
def lspEnterLineStart(source: String, offset: Int): Int
  var start = offset

  while start > 0
    let previous = host.stringByteAt(source, start - 1) as Int

    if previous == 10 || previous == 13
      break
    end
    start = start - 1
  end
  return start
end

def lspEnterIndent(source: String, offset: Int): String
  let start = lspEnterLineStart(source, offset)
  var finish = start

  while finish < host.stringByteLength(source)
    let byte = host.stringByteAt(source, finish) as Int

    if byte != 32 && byte != 9
      break
    end
    finish = finish + 1
  end
  return host.stringSlice(source, start, finish - start)
end

def lspEnterIndentWidth(indent: String, tabSize: Int): Int
  var width = 0
  var index = 0

  while index < host.stringByteLength(indent)
    if (host.stringByteAt(indent, index) as Int) == 9
      width = (width / tabSize + 1) * tabSize
    else
      width = width + 1
    end
    index = index + 1
  end
  return width
end

def lspOnEnter(source: String, cursorByte: Int, tabSize: Int, insertSpaces: Bool): String
  let length = host.stringByteLength(source)

  if cursorByte < 0 || cursorByte > length || tabSize <= 0 || tabSize > 32
    return "[]"
  end
  let start = lspEnterLineStart(source, cursorByte)
  var finish = start

  while finish < length
    let byte = host.stringByteAt(source, finish) as Int

    if byte == 10 || byte == 13
      break
    end
    if byte != 32 && byte != 9
      return "[]"
    end
    finish = finish + 1
  end
  if start == 0
    return "[]"
  end
  var newlineStart = start - 1

  if (host.stringByteAt(source, newlineStart) as Int) == 10 && newlineStart > 0 && (host.stringByteAt(source, newlineStart - 1) as Int) == 13
    newlineStart = newlineStart - 1
  end
  let map = new IrSourceMap(source)
  let headerEnd = (new IrSourceMap(host.stringSlice(source, 0, newlineStart))).utf16Length()
  let lexer = new BootstrapLexer(source)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)

  parser.recordBlocks = true
  parser.parseProgram()
  var block = parser.blocks

  while block != null
    if block.headerEnd == headerEnd
      let base = lspEnterIndent(source, map.offsetAt(block.start))
      var unit = "\t"

      if insertSpaces
        unit = ""
        var index = 0

        while index < tabSize
          unit = unit + " "
          index = index + 1
        end
      end
      var text = base + unit
      var needsEnd = block.ownsEnd && block.closing < 0

      if block.ownsEnd && block.closing >= 0
        let closingIndent = lspEnterIndent(source, map.offsetAt(block.closing))
        var parent = block.parent
        var unclosedParent = false

        while parent != null
          unclosedParent = true if parent.ownsEnd && parent.closing < 0
          parent = parent.parent
        end

        # Recovery can consume an enclosing block's end. Its outdent shows that
        # the new nested block still needs its own terminator when a parent is
        # left unclosed. Complete, poorly indented blocks keep their existing end.
        needsEnd = unclosedParent && lspEnterIndentWidth(closingIndent, tabSize) < lspEnterIndentWidth(base, tabSize)
      end
      if needsEnd
        text = text + host.stringSlice(source, newlineStart, start - newlineStart) + base + "end"
      end
      let firstPosition = (new IrSourceMap(host.stringSlice(source, 0, start))).utf16Length()
      let lastPosition = firstPosition + finish - start

      return "[{\"range\":{\"start\":" + lspPosition(source, firstPosition) + ",\"end\":" + lspPosition(source, lastPosition) + "},\"newText\":" + lspQuote(text) + "}]"
    end
    block = block.next
  end
  return "[]"
end
