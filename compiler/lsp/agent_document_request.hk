abstract class AgentDocumentRequest: AgentToolRequest
  abstract def uri(): String
  abstract def expectedRevision(): Int?
  abstract def requiresOpenBuffer(): Bool
  abstract def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
  abstract def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext

  def execute(workspace: NeriAgentWorkspace): String
    return workspace.handleTool(this)
  end
end
