sealed class AgentWorkspaceStatus
  private tag: Int
  private def init(tag: Int): Void
    this.tag = tag
  end
  static def analysis(status: readonly AnalysisStatus): AgentWorkspaceStatus
    if status.isValid()
      return new AgentWorkspaceStatus(0)
    end
    if status.isInvalid()
      return new AgentWorkspaceStatus(1)
    end
    return AgentWorkspaceStatus.unavailable()
  end
  static def unavailable(): AgentWorkspaceStatus
    return new AgentWorkspaceStatus(2)
  end
  static def limit(): AgentWorkspaceStatus
    return new AgentWorkspaceStatus(3)
  end
  static def conflict(): AgentWorkspaceStatus
    return new AgentWorkspaceStatus(4)
  end
  static def notFound(): AgentWorkspaceStatus
    return new AgentWorkspaceStatus(5)
  end
  static def invalidRequest(): AgentWorkspaceStatus
    return new AgentWorkspaceStatus(6)
  end
  readonly def isValid(): Bool
    return this.tag == 0
  end
  readonly def isInvalid(): Bool
    return this.tag == 1
  end
  readonly def wireName(): String
    if this.tag == 0
      return "valid"
    end
    if this.tag == 1
      return "invalid"
    end
    if this.tag == 2
      return "unavailable"
    end
    if this.tag == 3
      return "limit"
    end
    if this.tag == 4
      return "conflict"
    end
    return this.tag == 5 ? "not_found" : "invalid_request"
  end
end
