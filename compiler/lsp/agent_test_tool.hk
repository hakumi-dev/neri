class AgentTestTool: AgentToolDescriptor
  def init(): Void
    super("neri.test", "Build and run every explicitly registered test unit in the root project manifest.", [new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes()))])
  end

  def outputSchema(): String
    return agentTestOutputSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let request: AgentToolRequest = new AgentTestRequest(arguments.get("operationId").scalarText())

    return request
  end
end
