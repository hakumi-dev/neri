# Only a resolved completion carries a bound model and semantic site.
sealed class LspCompletionContext
  private selectedTarget: SemanticCompletionTarget
  private outcome: LspCompletionOutcome
  private def init(target: SemanticCompletionTarget, outcome: LspCompletionOutcome): Void
    this.selectedTarget = target
    this.outcome = outcome
  end
  static def unavailable(target: SemanticCompletionTarget): LspCompletionContext
    return new LspCompletionContext(target, LspCompletionOutcome.Unavailable())
  end
  static def invalidPosition(target: SemanticCompletionTarget): LspCompletionContext
    return new LspCompletionContext(target, LspCompletionOutcome.InvalidPosition())
  end
  static def noContext(target: SemanticCompletionTarget): LspCompletionContext
    return new LspCompletionContext(target, LspCompletionOutcome.NoContext())
  end
  static def complete(resolution: LspCompletionResolution): LspCompletionContext
    return new LspCompletionContext(resolution.target, LspCompletionOutcome.Complete(resolution))
  end
  def target(): SemanticCompletionTarget
    return this.selectedTarget
  end
  def resolved(): LspCompletionResolution?
    match this.outcome
      case LspCompletionOutcome.Unavailable()
        return null
      case LspCompletionOutcome.InvalidPosition()
        return null
      case LspCompletionOutcome.NoContext()
        return null
      case LspCompletionOutcome.Complete(resolution)
        return resolution
    end
  end
  def wireName(): String
    match this.outcome
      case LspCompletionOutcome.Unavailable()
        return "unavailable"
      case LspCompletionOutcome.InvalidPosition()
        return "invalid-position"
      case LspCompletionOutcome.NoContext()
        return "no-context"
      case LspCompletionOutcome.Complete(resolution)
        return "complete"
    end
  end
end

