sealed class AgentInputLine
  private tag: Int
  private contents: String

  private def init(tag: Int, contents: String): Void
    this.tag = tag
    this.contents = contents
  end

  static def eof(): AgentInputLine
    return new AgentInputLine(0, "")
  end

  static def complete(text: String): AgentInputLine
    return new AgentInputLine(1, text)
  end

  static def truncated(text: String): AgentInputLine
    return new AgentInputLine(2, text)
  end

  static def limit(): AgentInputLine
    return new AgentInputLine(3, "")
  end

  static def invalid(): AgentInputLine
    return new AgentInputLine(4, "")
  end

  readonly def isEof(): Bool
    return this.tag == 0
  end

  readonly def isTruncated(): Bool
    return this.tag == 2
  end

  readonly def isLimit(): Bool
    return this.tag == 3
  end

  readonly def text(): String?
    if this.tag == 1 || this.tag == 2
      return this.contents
    end
    return null
  end

  readonly def completeText(): String?
    if this.tag == 1
      return this.contents
    end
    return null
  end
end
