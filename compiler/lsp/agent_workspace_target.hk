use host

class AgentWorkspaceTarget
  private storedOperationId: String
  private storedUri: String
  private storedPath: String
  private storedDocument: LspDocument?

  def init(operationId: String, uri: String, path: String, document: LspDocument?): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedPath = path
    this.storedDocument = document
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def path(): String
    return this.storedPath
  end

  def document(): LspDocument?
    return this.storedDocument
  end

  def setDocument(document: LspDocument): Void
    this.storedDocument = document
  end
end
