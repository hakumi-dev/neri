class AgentProfileRequest: AgentToolRequest
  private operation: String

  def init(operationId: String): Void
    this.operation = operationId
  end

  def operationId(): String
    return this.operation
  end

  def execute(workspace: NeriAgentWorkspace): String
    return (new AgentProfileService(workspace.root)).run(this.operation)
  end
end
