use host
use process

class AgentProfileService
  private root: String

  def init(root: String): Void
    this.root = root
  end

  def run(operationId: String): String
    let graph = new AgentProjectGraph(this.root)
    let before = graph.snapshot
    let projectKey = graph.manifest
    let compiler = agentCompilerExecutable()

    if graph.error != "" || compiler == null
      return agentProfileResponse(operationId, "unavailable", graph.error == "" ? "Cannot resolve the running compiler." : graph.error, projectKey, before, before, graph.count, false, "")
    end
    let directory = bootstrapRunDirectory()

    if directory == null
      return agentProfileResponse(operationId, "unavailable", "Cannot create a profiling workspace.", projectKey, before, before, graph.count, false, "")
    end
    var units = ""
    var separator = ""
    var status = "valid"
    var complete = true
    var unit = graph.first
    var index = 0

    while unit != null
      let artifact = directory + "/unit-" + (index as String)
      let timingPath = artifact + ".timings.jsonl"
      let options = new process.SpawnOptions(compiler)

      options.arguments = ["build", "--project", unit.manifest, "--unit", unit.name, unit.project.kind == "library" ? "--emit=obj" : "--emit=executable", "--output", artifact, "--release", "--timings"]
      options.workingDirectory = unit.project.root
      options.environment = [new process.EnvironmentEntry("NERI_TIMING_OUTPUT", timingPath)]
      options.stdoutLimit = 4096
      options.stderrLimit = 4096
      let processResult = new AgentProcessResult()

      processResult.run(options, 120000)
      var unitStatus = "unavailable"
      var message = processResult.message
      var digest = ""
      var timings = "[]"

      if processResult.status == "completed" && processResult.exitKind == "exit"
        if processResult.exitCode == 0
          let measuredArtifact = agentArtifactDigest(artifact)
          let text = host.readText(timingPath)

          if measuredArtifact != null && text != null
            digest = measuredArtifact
            let phases = new AgentPhaseProfile(text)

            timings = phases.json()
            if phases.error == "" && phases.complete
              unitStatus = "valid"
            else
              message = phases.error
            end
          else
            message = "Build artifact or compiler timings are unavailable."
          end
        else
          unitStatus = processResult.exitCode == 1 ? "invalid" : "unavailable"
          message = "Compiler returned a nonzero exit code."
        end
      end
      if unitStatus == "unavailable"
        status = "unavailable"
        complete = false
      else if unitStatus == "invalid" && status == "valid"
        status = "invalid"
      end
      let item = "{\"projectKey\":" + lspQuote(unit.key) + ",\"name\":" + lspQuote(unit.name) + ",\"kind\":" + lspQuote(unit.project.kind) + ",\"fingerprint\":" + lspQuote(unit.fingerprint) + ",\"status\":" + lspQuote(unitStatus) + ",\"message\":" + lspQuote(message) + ",\"exitKind\":" + lspQuote(processResult.exitKind) + ",\"exitCode\":" + (processResult.exitCode as String) + ",\"stdout\":" + lspQuote(processResult.stdout) + ",\"stderr\":" + lspQuote(processResult.stderr) + ",\"stdoutTruncated\":" + (processResult.stdoutTruncated ? "true" : "false") + ",\"stderrTruncated\":" + (processResult.stderrTruncated ? "true" : "false") + ",\"artifactDigest\":" + lspQuote(digest) + ",\"timings\":" + timings + "}"

      units = units + separator + item
      separator = ","
      host.removeFile(artifact)
      host.removeFile(artifact + ".nir.hex")
      host.removeFile(timingPath)
      index = index + 1
      unit = unit.next
    end
    let count = graph.count

    graph.refresh()
    bootstrapRemoveEmptyDirectory(directory)
    var message = ""

    if graph.snapshot != before
      status = "conflict"
      complete = false
      message = "Project inputs changed during profiling; measurements refer to the earlier snapshot."
    end
    return agentProfileResponse(operationId, status, message, projectKey, before, graph.snapshot, count, complete, units)
  end
end
