sealed class LspErrorCode
  private value: Int
  private def init(value: Int): Void
    this.value = value
  end
  static def parseError(): LspErrorCode
    return new LspErrorCode(-32700)
  end
  static def invalidRequest(): LspErrorCode
    return new LspErrorCode(-32600)
  end
  static def notInitialized(): LspErrorCode
    return new LspErrorCode(-32002)
  end
  static def invalidParams(): LspErrorCode
    return new LspErrorCode(-32602)
  end
  static def requestFailed(): LspErrorCode
    return new LspErrorCode(-32803)
  end
  static def requestCancelled(): LspErrorCode
    return new LspErrorCode(-32800)
  end
  static def methodNotFound(): LspErrorCode
    return new LspErrorCode(-32601)
  end
  readonly def wireCode(): Int
    return this.value
  end
end
