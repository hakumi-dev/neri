# Source membership is shared by CLI commands and language-service analysis.
class NeriProject
  public root: String = ""
  public manifest: String = ""
  public sources: StringBuffer = new StringBuffer()
  # Parallel to sources. Each path belongs to one manifest/unit key.
  public sourceOwners: StringBuffer = new StringBuffer()
  public ownSources: StringBuffer = new StringBuffer()
  public referenceSources: StringBuffer = new StringBuffer()
  private errorMessage: String = ""
  private errorClassification: NeriProjectErrorReason?
  public kind: String = ""
  public implicit: Bool = false
  public generatedInputs: StringBuffer = new StringBuffer()
  public generatedDigests: StringBuffer = new StringBuffer()
  public generatedOutputs: StringBuffer = new StringBuffer()
  public verifiedTextTable: StringTable<String> = new StringTable<String>()
  public verifiedDigestTable: StringTable<String> = new StringTable<String>()
  public generationManifests: StringBuffer = new StringBuffer()
  public generationManifestTexts: StringBuffer = new StringBuffer()
  public generatedOrigins: NeriGeneratedOrigin?

  public def error(): String
    return this.errorMessage
  end

  public def errorReason(): NeriProjectErrorReason?
    return this.errorClassification
  end

  internal def fail(message: String): Void
    this.failAs(NeriProjectErrorReason.InvalidProject(), message)
  end

  internal def failAs(reason: NeriProjectErrorReason, message: String): Void
    this.errorClassification = reason
    this.errorMessage = message
  end

  internal def copyError(other: NeriProject): Void
    this.errorClassification = other.errorClassification
    this.errorMessage = other.errorMessage
  end
end

def neriProjectVerifiedText(project: NeriProject, path: String): String?
  let verified = project.verifiedTextTable.find(path)

  if verified != null
    return verified.value
  end
  return host.readText(path)
end

def neriProjectStoreVerified(project: NeriProject, path: String, text: String, digest: String): Bool
  let previousText = project.verifiedTextTable.find(path)
  let previousDigest = project.verifiedDigestTable.find(path)

  if previousText != null || previousDigest != null
    return previousText != null && previousDigest != null && previousText.value == text && previousDigest.value == digest
  end
  project.verifiedTextTable.add(path, text)
  project.verifiedDigestTable.add(path, digest)
  return true
end

class NeriProjectReference
  public path: String = ""
  public next: NeriProjectReference?

  def init(path: String, next: NeriProjectReference?): Void
    this.path = path
    this.next = next
  end
end

def neriImplicitProjectHint(code: String): String
  if code == "NR163"
    return " If these sources form a library, declare a library unit in manifest.json."
  else if code == "NR164"
    return " If these entry points belong to separate programs, declare executable units in manifest.json with separate sources."
  end
  return ""
end

def neriSourceNameValid(path: String): Bool
  let name = host.pathFileName(path)

  if name == null || !semanticEndsWith(name, ".hk")
    return true
  end
  var offset = 0

  while offset < host.stringByteLength(name)
    let point = codePointAt(name, offset)

    # Unicode White_Space; directory names are deliberately not checked.
    if (point >= 9 && point <= 13) || point == 32 || point == 133 || point == 160 || point == 5760 || (point >= 8192 && point <= 8202) || point == 8232 || point == 8233 || point == 8239 || point == 8287 || point == 12288
      return false
    end
    offset = offset + utf8Width(host.stringByteAt(name, offset) as Int)
  end
  return true
end

def neriRelativeProjectPath(path: String): Bool
  if path == "" || bootstrapStartsWith(path, "/") || bootstrapFindText(path, "\\") >= 0
    return false
  end
  var start = 0
  var index = 0

  while index <= host.stringByteLength(path)
    if index == host.stringByteLength(path) || host.stringByteAt(path, index) == (47 as Byte)
      if index == start
        return false
      end
      let segment = host.stringSlice(path, start, index - start)

      if segment == "." || segment == ".."
        return false
      end
      start = index + 1
    end
    index = index + 1
  end
  return true
end

def neriProjectHost(): String?
  let configured = host.environment("NERI_HOST")

  if configured != null && configured != ""
    return configured
  end
  let manifest = host.environment("NERI_RUNTIME_MANIFEST")

  if manifest == null || manifest == ""
    return null
  end
  let directory = bootstrapDirectory(manifest)
  let name = host.pathFileName(directory)

  if name != null && name == "lib"
    return bootstrapDirectory(directory) + "/libexec/neri-host"
  end
  return directory + "/neri-host"
end

def neriRemoveProjectListing(directory: String): Void
  host.removeFile(directory + "/sources")
  bootstrapRemoveEmptyDirectory(directory)
end

def neriCanonicalPath(path: String): String?
  var input: Byte[] = []
  var index = 0

  if host.stringByteLength(path) > 1048576
    return null
  end
  while index < host.stringByteLength(path)
    let byte = host.stringByteAt(path, index)

    if byte == (0 as Byte)
      return null
    end
    input = host.appendByte(input, byte)
    index = index + 1
  end
  input = host.appendByte(input, 0 as Byte)
  var length = -1

  unsafe
    borrow input as pointer
      length = neriHostCanonicalPath(pointer, pointer, 0)
    end
  end
  if length < 0 || length > 1048576
    return null
  end
  var output: Byte[] = []

  index = 0
  while index <= length
    output = host.appendByte(output, 0 as Byte)
    index = index + 1
  end
  unsafe
    borrow input as inputPointer
      borrow output as outputPointer
        if neriHostCanonicalPath(inputPointer, outputPointer, length + 1) != length
          return null
        end
      end
    end
  end
  let decoded = host.stringFromBytes(output)

  if decoded == null
    return null
  end
  return host.stringSlice(decoded, 0, length)
end

def neriProjectListed(paths: StringBuffer, path: String): Bool
  var entry = paths.first.nextNode

  while entry != null
    if entry.value == path
      return true
    end
    entry = entry.nextNode
  end
  return false
end

def neriProjectStackContains(active: NeriProjectReference?, path: String): Bool
  var entry = active

  while entry != null
    if entry.path == path
      return true
    end
    entry = entry.next
  end
  return false
end

# References deliberately allow ../library, but no absolute, empty, or
# platform-dependent spellings. The resolved manifest is normalized before it
# participates in the DFS, so equivalent lexical paths deduplicate.
def neriProjectReferencePathValid(path: String): Bool
  if path == "" || bootstrapStartsWith(path, "/") || bootstrapFindText(path, "\\") >= 0
    return false
  end
  var start = 0
  var index = 0

  while index <= host.stringByteLength(path)
    if index == host.stringByteLength(path) || host.stringByteAt(path, index) == (47 as Byte)
      if index == start
        return false
      end
      let segment = host.stringSlice(path, start, index - start)

      if segment == "."
        return false
      end
      start = index + 1
    end
    index = index + 1
  end
  return true
end

def neriProjectManifestName(path: String): Bool
  let name = host.pathFileName(path)

  return name != null && (name == "manifest.json" || name == "neri.json")
end

def neriAddProjectSource(project: NeriProject, path: String, source: String, owner: String, own: Bool): Bool
  if !neriSourceNameValid(path)
    project.fail(".hk file names must not contain whitespace: " + source)
    return false
  end
  if neriProjectListed(project.sources, path)
    project.fail("Duplicate project source: " + source)
    return false
  end
  project.sources.add(path)
  project.sourceOwners.add(owner)
  if own
    project.ownSources.add(path)
  else
    project.referenceSources.add(path)
  end
  return true
end

# Unit paths are project-local and normalized. A directory may be '.', while
# explicit files and exclusions otherwise use ordinary relative segments.
def neriUnitPathValid(path: String): Bool
  if path == "."
    return true
  end
  return neriRelativeProjectPath(path)
end

def neriUnitExcluded(relative: String, exclusions: LspJson): Bool
  var exclusion = exclusions.first

  while exclusion != null
    let path = exclusion.value

    if relative == path || bootstrapStartsWith(relative, path + "/")
      return true
    end
    exclusion = exclusion.next
  end
  return false
end

def neriValidateUnitExclusions(project: NeriProject, exclusions: LspJson): Bool
  if exclusions.kind != "missing" && exclusions.kind != "array"
    project.fail("Unit exclude must be an array of relative file or directory paths.")
    return false
  end
  var exclusion = exclusions.first

  while exclusion != null
    if exclusion.kind != "string" || !neriUnitPathValid(exclusion.value) || bootstrapFindText(exclusion.value, "*") >= 0 || bootstrapFindText(exclusion.value, "?") >= 0
      project.fail("Unit exclude must contain normalized relative file or directory paths without globs.")
      return false
    end
    exclusion = exclusion.next
  end
  return true
end

def neriUnitSourceOwner(project: NeriProject, path: String): String?
  var source = project.sources.first.nextNode
  var owner = project.sourceOwners.first.nextNode

  while source != null && owner != null
    if source.value == path
      return owner.value
    end
    source = source.nextNode
    owner = owner.nextNode
  end
  return null
end

def neriAddUnitSource(project: NeriProject, path: String, relative: String, owner: String, own: Bool): Bool
  let previous = neriUnitSourceOwner(project, path)

  if previous != null
    if previous == owner
      return true
    end
    project.fail("Source belongs to multiple units: " + relative)
    return false
  end
  return neriAddProjectSource(project, path, relative, owner, own)
end

def neriExpandUnitDirectory(project: NeriProject, projectRoot: String, owner: String, own: Bool, sourceRoot: String, exclusions: LspJson): Bool
  let helper = neriProjectHost()

  if helper == null
    project.fail("Unit source discovery requires the Neri host helper.")
    return false
  end
  let directory = bootstrapRunDirectory()

  if directory == null
    project.fail("Cannot create a temporary unit source listing.")
    return false
  end
  let status = host.run(helper, ["list-project", projectRoot, sourceRoot, ".hk", directory + "/sources"])
  var listed: String? = null

  if status != null && status == 0
    listed = host.readText(directory + "/sources")
  end
  neriRemoveProjectListing(directory)
  if listed == null
    project.fail("Cannot enumerate unit source directory: " + sourceRoot)
    return false
  end
  let listing = listed
  let prefix = projectRoot + "/"
  var start = 0
  var index = 0

  while index <= host.stringByteLength(listing)
    if index == host.stringByteLength(listing) || host.stringByteAt(listing, index) == (10 as Byte)
      if index > start
        let path = host.stringSlice(listing, start, index - start)

        if bootstrapStartsWith(path, prefix)
          let relative = host.stringSlice(path, host.stringByteLength(prefix), host.stringByteLength(path) - host.stringByteLength(prefix))

          if !neriUnitExcluded(relative, exclusions) && !neriAddUnitSource(project, path, relative, owner, own)
            return false
          end
        end
      end
      start = index + 1
    end
    index = index + 1
  end
  return true
end

def neriLoadUnitSources(project: NeriProject, projectRoot: String, owner: String, own: Bool, unit: LspJson): Bool
  let sources = unit.get("sources")
  let exclusions = unit.get("exclude")

  if sources.kind != "array"
    project.fail("Unit sources must be a nonempty array of relative directories or .hk files.")
    return false
  end
  if sources.first == null && unit.get("generated").first == null
    project.fail("Unit must declare sources or generated manifests.")
    return false
  end
  if !neriValidateUnitExclusions(project, exclusions)
    return false
  end
  var source = sources.first

  while source != null
    if source.kind != "string" || !neriUnitPathValid(source.value) || bootstrapFindText(source.value, "*") >= 0 || bootstrapFindText(source.value, "?") >= 0
      project.fail("Unit sources must contain normalized relative directories or .hk files without globs.")
      return false
    end
    if semanticEndsWith(source.value, ".hk")
      if !neriUnitExcluded(source.value, exclusions)
        let fullPath = neriCanonicalPath(projectRoot + "/" + source.value)

        if fullPath == null
          project.fail("Invalid unit source path: " + source.value)
          return false
        end
        if fullPath != projectRoot + "/" + source.value
          project.fail("Unit source files must not use symlinks or escape the project: " + source.value)
          return false
        end
        if !neriAddUnitSource(project, fullPath, source.value, owner, own)
          return false
        end
      end
    else if !neriExpandUnitDirectory(project, projectRoot, owner, own, source.value, exclusions)
      return false
    end
    source = source.next
  end
  return true
end

def neriUnitKey(manifest: String, unit: String): String
  return manifest + "#" + unit
end

def neriProjectObjectKeysValid(node: LspJson, allowed: String[], context: String, project: NeriProject): Bool
  var child = node.first

  while child != null
    var known = false

    for key in allowed
      if child.key == key
        known = true
      end
    end
    if !known
      project.fail("Unknown " + context + " key: " + child.key)
      return false
    end
    var matches = 0
    var previous = node.first

    while previous != null
      if previous.key == child.key
        matches = matches + 1
      end
      previous = previous.next
    end
    if matches > 1
      project.fail("Duplicate " + context + " key: " + child.key)
      return false
    end
    child = child.next
  end
  return true
end

def neriProjectKeysUnique(node: LspJson, context: String, project: NeriProject): Bool
  var child = node.first

  while child != null
    var matches = 0
    var candidate = node.first

    while candidate != null
      if candidate.key == child.key
        matches = matches + 1
      end
      candidate = candidate.next
    end
    if matches > 1
      project.fail("Duplicate " + context + " key: " + child.key)
      return false
    end
    child = child.next
  end
  return true
end

def neriValidateProjectShape(config: LspJson, project: NeriProject): Bool
  if config.kind != "object" || !neriProjectObjectKeysValid(config, ["version", "defaultUnit", "units"], "project", project)
    if project.error() == ""
      project.fail("A project manifest must be a JSON object.")
    end
    return false
  end
  let version = config.get("version")
  let defaultUnit = config.get("defaultUnit")
  let units = config.get("units")

  if version.kind != "number" || version.value != "2"
    project.fail("Project version must be the number 2.")
    return false
  end
  if defaultUnit.kind != "missing" && (defaultUnit.kind != "string" || defaultUnit.value == "")
    project.fail("Project defaultUnit must be a nonempty string when present.")
    return false
  end
  if units.kind != "object" || units.first == null
    project.fail("Version 2 projects require a nonempty units object.")
    return false
  end
  if !neriProjectKeysUnique(units, "unit", project)
    return false
  end
  var unit = units.first

  while unit != null
    if unit.key == "" || unit.kind != "object" || !neriProjectObjectKeysValid(unit, ["kind", "sources", "exclude", "references", "generated"], "unit " + unit.key, project)
      if project.error() == ""
        project.fail("Each unit must be a named object.")
      end
      return false
    end
    let kind = unit.get("kind")
    let sources = unit.get("sources")
    let exclude = unit.get("exclude")
    let references = unit.get("references")
    let generated = unit.get("generated")

    if generated.kind != "missing" && generated.kind != "array"
      project.fail("Unit generated must be an array of generation manifests: " + unit.key)
      return false
    end
    var generation = generated.first

    while generation != null
      if generation.kind != "string" || !neriRelativeProjectPath(generation.value) || !semanticEndsWith(generation.value, ".json")
        project.fail("Unit generated must contain relative JSON manifest paths: " + unit.key)
        return false
      end
      generation = generation.next
    end

    if kind.kind != "string" || (kind.value != "library" && kind.value != "executable")
      project.fail("Unit kind must be library or executable: " + unit.key)
      return false
    end
    if sources.kind != "array"
      project.fail("Unit sources must be a nonempty array: " + unit.key)
      return false
    end
    if sources.first == null && generated.first == null
      project.fail("Unit must declare sources or generated manifests: " + unit.key)
      return false
    end
    var source = sources.first

    while source != null
      if source.kind != "string"
        project.fail("Unit sources must contain strings: " + unit.key)
        return false
      end
      source = source.next
    end
    if exclude.kind != "missing" && exclude.kind != "array"
      project.fail("Unit exclude must be an array: " + unit.key)
      return false
    end
    var excluded = exclude.first

    while excluded != null
      if excluded.kind != "string"
        project.fail("Unit exclude must contain strings: " + unit.key)
        return false
      end
      excluded = excluded.next
    end
    if references.kind != "missing" && references.kind != "array"
      project.fail("Unit references must be an array: " + unit.key)
      return false
    end
    var reference = references.first

    while reference != null
      if reference.kind == "object"
        if !neriProjectObjectKeysValid(reference, ["project", "unit"], "external reference", project)
          return false
        end
        let referenceProject = reference.get("project")
        let referenceUnit = reference.get("unit")

        if referenceProject.kind != "string" || !neriProjectReferencePathValid(referenceProject.value) || !neriProjectManifestName(referenceProject.value) || referenceUnit.kind != "string" || referenceUnit.value == ""
          project.fail("External unit references require project and unit strings.")
          return false
        end
      else if reference.kind != "string" || reference.value == ""
        project.fail("Unit references must be strings or external reference objects.")
        return false
      end
      reference = reference.next
    end
    unit = unit.next
  end
  if defaultUnit.kind == "string" && units.get(defaultUnit.value).kind != "object"
    project.fail("Project defaultUnit must name an existing unit.")
    return false
  end
  return true
end

def neriLoadUnitManifest(project: NeriProject, path: String, selectedUnit: String, own: Bool, active: NeriProjectReference?, visited: StringBuffer): Bool
  let absolute = neriCanonicalPath(path)

  if absolute == null
    project.fail("Cannot resolve project path: " + path)
    return false
  end
  let text = host.readText(absolute)

  if text == null
    project.fail("Cannot read project: " + absolute)
    return false
  end
  let parser = new LspJsonParser(text)
  let config = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host.stringByteLength(text)
    project.fail("Project manifest must contain exactly one JSON value.")
    return false
  end
  if !neriValidateProjectShape(config, project)
    return false
  end
  let units = config.get("units")

  if units.kind != "object" || units.first == null
    project.fail("Version 2 projects require a nonempty units object.")
    return false
  end
  var name = selectedUnit

  if name == ""
    let defaultUnit = config.get("defaultUnit")

    if defaultUnit.kind == "string"
      name = defaultUnit.value
    end
  end
  let definition = units.get(name)

  if name == "" || definition.kind != "object"
    project.fail("Select an existing unit using defaultUnit or --unit.")
    return false
  end
  let key = neriUnitKey(absolute, name)

  if neriProjectStackContains(active, key)
    project.fail("Unit reference cycle: " + key)
    return false
  end
  if neriProjectListed(visited, key)
    return true
  end
  let kind = definition.get("kind")

  if kind.kind != "string" || (kind.value != "library" && kind.value != "executable")
    project.fail("Unit kind must be library or executable: " + name)
    return false
  end
  if !own && kind.value != "library"
    project.fail("Referenced unit must be a library: " + key)
    return false
  end
  visited.add(key)
  let projectRoot = bootstrapDirectory(absolute)

  if own
    project.root = projectRoot
    project.manifest = absolute
    project.kind = kind.value
  end
  let before = project.sources.size

  if !neriLoadUnitSources(project, projectRoot, key, own, definition)
    return false
  end
  if !neriLoadGeneratedSources(project, projectRoot, key, own, definition.get("generated"))
    return false
  end
  if project.sources.size == before
    project.fail("Unit must resolve at least one own .hk source: " + key)
    return false
  end
  let references = definition.get("references")

  if references.kind != "missing" && references.kind != "array"
    project.fail("Unit references must be an array.")
    return false
  end
  var reference = references.first

  while reference != null
    var referenceManifest = absolute
    var referenceUnit = ""

    if reference.kind == "string"
      referenceUnit = reference.value
    else if reference.kind == "object"
      let referenceProject = reference.get("project")
      let referenceName = reference.get("unit")

      if referenceProject.kind != "string" || !neriProjectReferencePathValid(referenceProject.value) || !neriProjectManifestName(referenceProject.value) || referenceName.kind != "string" || referenceName.value == ""
        project.fail("External unit references require project and unit strings.")
        return false
      end
      let resolved = host.pathAbsolute(projectRoot + "/" + referenceProject.value)

      if resolved == null
        project.fail("Invalid external unit project: " + referenceProject.value)
        return false
      end
      referenceManifest = resolved
      referenceUnit = referenceName.value
      let externalOwnership = new NeriProject()

      if !neriValidateRootUnitOwnership(externalOwnership, referenceManifest)
        project.copyError(externalOwnership)
        return false
      end
    else
      project.fail("Unit references must be local unit names or external project/unit objects.")
      return false
    end
    if referenceUnit == "" || !neriLoadUnitManifest(project, referenceManifest, referenceUnit, false, new NeriProjectReference(key, active), visited)
      if project.error() == ""
        project.fail("Unit references require nonempty unit names.")
      end
      return false
    end
    reference = reference.next
  end
  return true
end

def neriValidateRootUnitOwnership(project: NeriProject, path: String): Bool
  let absolute = neriCanonicalPath(path)

  if absolute == null
    project.fail("Cannot resolve project path: " + path)
    return false
  end
  let text = host.readText(absolute)

  if text == null
    project.fail("Cannot read project: " + absolute)
    return false
  end
  let parser = new LspJsonParser(text)
  let config = parser.parse()

  parser.spaces()
  let units = config.get("units")

  if parser.failed || parser.position != host.stringByteLength(text)
    project.fail("Project manifest must contain exactly one JSON value.")
    return false
  end
  if !neriValidateProjectShape(config, project)
    return false
  end
  let scratch = new NeriProject()
  let projectRoot = bootstrapDirectory(absolute)
  var unit = units.first

  while unit != null
    if unit.kind != "object"
      project.fail("Each unit must be an object: " + unit.key)
      return false
    end
    let before = scratch.sources.size

    if !neriLoadUnitSources(scratch, projectRoot, neriUnitKey(absolute, unit.key), true, unit)
      project.copyError(scratch)
      return false
    end
    if scratch.sources.size == before && unit.get("generated").first == null
      project.fail("Unit must resolve at least one own .hk source: " + neriUnitKey(absolute, unit.key))
      return false
    end
    unit = unit.next
  end
  return true
end

def neriUnitGeneratedOwner(projectRoot: String, unit: LspJson, sourcePath: String): Bool
  var generation = unit.get("generated").first

  while generation != null
    if generation.kind == "string" && neriRelativeProjectPath(generation.value)
      let manifestPath = projectRoot + "/" + generation.value
      let text = host.readText(manifestPath)

      if text != null
        let parser = new LspJsonParser(text)
        let document = parser.parse()

        parser.spaces()
        if !parser.failed && parser.position == host.stringByteLength(text)
          var output = document.get("outputs").first

          while output != null
            let declared = output.get("path")

            if declared.kind == "string" && neriRelativeProjectPath(declared.value)
              let absolute = neriCanonicalPath(projectRoot + "/" + declared.value)

              if absolute != null && absolute == sourcePath
                return true
              end
            end
            output = output.next
          end
        end
      end
    end
    generation = generation.next
  end
  return false
end

def neriRootOwnerUnit(project: NeriProject, path: String, sourcePath: String): String?
  let absolute = neriCanonicalPath(path)

  if absolute == null
    project.fail("Cannot resolve project path: " + path)
    return null
  end
  let text = host.readText(absolute)

  if text == null
    project.fail("Cannot read project: " + absolute)
    return null
  end
  let parser = new LspJsonParser(text)
  let config = parser.parse()
  let units = config.get("units")

  if parser.failed || units.kind != "object" || units.first == null
    project.fail("Version 2 projects require a nonempty units object.")
    return null
  end
  let scratch = new NeriProject()
  let projectRoot = bootstrapDirectory(absolute)
  var generatedOwner = ""
  var unit = units.first

  while unit != null
    if unit.kind != "object" || !neriLoadUnitSources(scratch, projectRoot, neriUnitKey(absolute, unit.key), true, unit)
      if unit.kind != "object"
        project.fail("Each unit must be an object: " + unit.key)
      else
        project.copyError(scratch)
      end
      return null
    end
    if neriUnitGeneratedOwner(projectRoot, unit, sourcePath)
      if generatedOwner != ""
        project.fail("Generated source belongs to multiple units: " + sourcePath)
        return null
      end
      generatedOwner = unit.key
    end
    unit = unit.next
  end
  let owner = neriUnitSourceOwner(scratch, sourcePath)

  if owner == null
    if generatedOwner == ""
      return null
    end
    return generatedOwner
  end
  unit = units.first
  while unit != null
    if owner == neriUnitKey(absolute, unit.key)
      if generatedOwner != "" && generatedOwner != unit.key
        project.fail("Source belongs to multiple units: " + sourcePath)
        return null
      end
      return unit.key
    end
    unit = unit.next
  end
  return null
end

def neriLoadProject(path: String, selectedUnit: String = ""): NeriProject
  let directory = neriCanonicalPath(path)

  if directory != null && host.readText(directory) != null && neriProjectManifestName(directory)
    let parent = bootstrapDirectory(directory)
    let counterpart = semanticEndsWith(directory, "/manifest.json") ? parent + "/neri.json" : parent + "/manifest.json"

    if host.readText(counterpart) != null
      let ambiguous = new NeriProject()

      ambiguous.fail("Project directory contains both manifest.json and neri.json; keep exactly one project manifest.")
      return ambiguous
    end
  end
  if directory != null && host.readText(directory) == null
    let canonicalManifest = host.readText(directory + "/manifest.json")
    let legacyManifest = host.readText(directory + "/neri.json")

    if canonicalManifest != null && legacyManifest != null
      let ambiguous = new NeriProject()

      ambiguous.fail("Project directory contains both manifest.json and neri.json; keep exactly one project manifest.")
      return ambiguous
    end
    if canonicalManifest != null
      return neriLoadProject(directory + "/manifest.json", selectedUnit)
    end
    if legacyManifest != null
      return neriLoadProject(directory + "/neri.json", selectedUnit)
    end
  end
  if directory != null && host.readText(directory) == null
    let implicit = new NeriProject()

    if selectedUnit != "" && selectedUnit != "main"
      implicit.fail("An implicit project has one unit named main; omit --unit or use --unit main. Create " + directory + "/manifest.json to declare additional units.")
      return implicit
    end
    implicit.root = directory
    implicit.manifest = directory
    implicit.kind = "executable"
    implicit.implicit = true
    let exclusions = new LspJson()

    exclusions.kind = "array"
    if !neriExpandUnitDirectory(implicit, directory, directory + "#main", true, ".", exclusions)
      return implicit
    end
    if implicit.sources.size == 0
      implicit.failAs(NeriProjectErrorReason.EmptyImplicitProject(), "An implicit project must contain at least one .hk source.")
    end
    return implicit
  end
  let project = new NeriProject()

  if !neriValidateRootUnitOwnership(project, path)
    return project
  end
  let visited = new StringBuffer()

  neriLoadUnitManifest(project, path, selectedUnit, true, null, visited)
  return project
end

# The manifest loader remains the authority for unit names. Callers inspect a
# loaded project instead of deriving a unit from a source-file name.
def neriProjectUnitNames(project: NeriProject): StringBuffer
  let names = new StringBuffer()

  if project.implicit
    names.add("main")
    return names
  end
  let text = host.readText(project.manifest)

  if text == null
    project.fail("Cannot read project: " + project.manifest)
    return names
  end
  let parser = new LspJsonParser(text)
  let config = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host.stringByteLength(text) || !neriValidateProjectShape(config, project)
    if project.error() == ""
      project.fail("Project manifest must contain exactly one JSON value.")
    end
    return names
  end
  var unit = config.get("units").first

  while unit != null
    names.add(unit.key)
    unit = unit.next
  end
  return names
end

def neriProjectContains(project: NeriProject, path: String): Bool
  return neriProjectListed(project.sources, path)
end

def neriProjectForSource(path: String, sourcePath: String, selectedUnit: String = ""): NeriProject
  let locator = neriCanonicalPath(path)

  if locator != null && host.readText(locator) == null
    let canonicalManifest = host.readText(locator + "/manifest.json")
    let legacyManifest = host.readText(locator + "/neri.json")

    if canonicalManifest != null && legacyManifest != null
      return neriLoadProject(locator, selectedUnit)
    else if canonicalManifest != null
      return neriProjectForSource(locator + "/manifest.json", sourcePath, selectedUnit)
    else if legacyManifest != null
      return neriProjectForSource(locator + "/neri.json", sourcePath, selectedUnit)
    end
    return neriLoadProject(locator, selectedUnit)
  end
  # Ownership is independent from the selected/default consumer. Expand the
  # root declarations once, then load only the owner's reference closure.
  let ownership = new NeriProject()
  let owner = neriRootOwnerUnit(ownership, path, sourcePath)

  if ownership.error() != ""
    return ownership
  end
  if owner != null
    return neriLoadProject(path, owner)
  end
  return neriLoadProject(path, selectedUnit)
end

def lspUri(path: String): String
  var result = "file://"

  if platformDrivePath(path)
    result = "file:///"
  end
  var index = 0

  while index < host.stringByteLength(path)
    let byte = host.stringByteAt(path, index) as Int

    if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 47 || byte == 45 || byte == 46 || byte == 95 || byte == 126
      result = result + lspCharacter(byte)
    else
      result = result + "%" + irHexDigit(byte / 16) + irHexDigit(byte - (byte / 16) * 16)
    end
    index = index + 1
  end
  return result
end

def lspHexDigit(byte: Int): Int
  if byte >= 48 && byte <= 57
    return byte - 48
  else if byte >= 65 && byte <= 70
    return byte - 55
  else if byte >= 97 && byte <= 102
    return byte - 87
  end
  return -1
end

def lspPath(uri: String): String?
  if !bootstrapStartsWith(uri, "file:///") || host.stringByteLength(uri) > 16384
    return null
  end
  var bytes: Byte[] = []
  var index = 7

  while index < host.stringByteLength(uri)
    var byte = host.stringByteAt(uri, index) as Int

    if byte == 63 || byte == 35
      return null
    end
    if byte == 37
      if index + 2 >= host.stringByteLength(uri)
        return null
      end
      let high = lspHexDigit(host.stringByteAt(uri, index + 1) as Int)
      let low = lspHexDigit(host.stringByteAt(uri, index + 2) as Int)

      if high < 0 || low < 0
        return null
      end
      byte = high * 16 + low
      index = index + 2
    end
    if byte == 0
      return null
    end
    bytes = host.appendByte(bytes, byte as Byte)
    index = index + 1
  end
  let path = host.stringFromBytes(bytes)

  if path == null
    return null
  end
  if platformWindowsHost() && host.stringByteLength(path) >= 4 && host.stringByteAt(path, 0) == (47 as Byte) && host.stringByteAt(path, 2) == (58 as Byte)
    return host.pathAbsolute(host.stringSlice(path, 1, host.stringByteLength(path) - 1))
  end
  return host.pathAbsolute(path)
end
