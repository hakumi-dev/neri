# Shared by project feedback and profiling, whose completion contract is exact.
sealed class AgentAnalysisOutcome
  private tag: Int
  private def init(tag: Int): Void
    this.tag = tag
  end
  static def analyzed(status: readonly AnalysisStatus): AgentAnalysisOutcome
    if status.isValid()
      return new AgentAnalysisOutcome(0)
    end
    if status.isInvalid()
      return new AgentAnalysisOutcome(1)
    end
    return AgentAnalysisOutcome.unavailable()
  end
  static def unavailable(): AgentAnalysisOutcome
    return new AgentAnalysisOutcome(2)
  end
  static def conflict(): AgentAnalysisOutcome
    return new AgentAnalysisOutcome(3)
  end
  readonly def complete(): Bool
    return this.tag == 0 || this.tag == 1
  end
  readonly def wireName(): String
    if this.tag == 0
      return "valid"
    end
    if this.tag == 1
      return "invalid"
    end
    return this.tag == 2 ? "unavailable" : "conflict"
  end
end

