class LspQueryLocation
  public snapshot: LspSemanticSnapshot?
  public snapshotKey: String = ""
  public sourceKey: String = ""
  public start: Int = 0
  # UTF-16 offset within sourceKey. Unlike start, this is stable when a
  # project snapshot orders its closed sources differently.
  public sourceOffset: Int = 0
  public length: Int = 0
  public next: LspQueryLocation?
end
