class LspCompletionResolution
  public target: SemanticCompletionTarget
  public model: SemanticModel
  public site: SemanticCompletionSite
  public querySourceStarts: IntBuffer
  public queryInsertedLength: Int
  public queryMapsAfterInsertion: Bool

  def init(target: SemanticCompletionTarget, model: SemanticModel, site: SemanticCompletionSite, sourceStarts: IntBuffer, insertedLength: Int, mapsAfterInsertion: Bool): Void
    this.target = target
    this.model = model
    this.site = site
    this.querySourceStarts = sourceStarts
    this.queryInsertedLength = insertedLength
    this.queryMapsAfterInsertion = mapsAfterInsertion
  end
end

