# LSP snippet encoding and body insertion shared by declaration providers.
class LspSnippet
  public text: String = ""
  public plain: String = ""
  public nextField: Int = 1

  def literal(value: String): Void
    this.plain = this.plain + value
    this.text = this.text + lspSnippetEscape(value)
  end

  def field(value: String): Void
    this.plain = this.plain + value
    this.text = this.text + "${" + (this.nextField as String) + ":" + lspSnippetEscape(value) + "}"
    this.nextField = this.nextField + 1
  end
end

def lspSnippetEscape(value: String): String
  let parts = new StringBuffer()
  var start = 0
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    if byte == 36 || byte == 92 || byte == 125
      parts.add(host.stringSlice(value, start, index - start))
      parts.add("\\")
      start = index
    end
    index = index + 1
  end
  parts.add(host.stringSlice(value, start, index - start))
  return lspJoin(parts, 0, parts.size)
end

def lspDeclarationBody(document: LspDocument, site: LspDeclarationSite, snippet: LspSnippet, abstractMethod: Bool): Bool
  if abstractMethod
    return true
  end
  let prefix = host.stringSlice(document.text, 0, site.byteStart) + snippet.plain + site.lineEnding
  let source = prefix + host.stringSlice(document.text, site.byteFinish, host.stringByteLength(document.text) - site.byteFinish)
  let base = lspEnterIndent(document.text, site.byteStart)
  let options = lspCodeStyleConfig(document).options
  let tabs = options.value("indent_style", bootstrapFindText(base, "\t") >= 0 ? "tab" : "space") == "tab"
  let configuredSize = options.value("indent_size", options.value("tab_width", "2"))
  let size = host.parseInt(configuredSize == "tab" ? options.value("tab_width", "2") : configuredSize)
  var width = 2

  if size != null && size >= 1 && size <= 32
    width = size
  end
  let edits = (new LspJsonParser(lspOnEnter(source, host.stringByteLength(prefix), width, !tabs))).parse()
  let edit = edits.first

  if edit == null
    return false
  end
  let body = edit.get("newText").value
  var bodyEnd = bootstrapFindText(body, site.lineEnding)

  bodyEnd = host.stringByteLength(body) if bodyEnd < 0
  snippet.literal(site.lineEnding + host.stringSlice(body, 0, bodyEnd))
  snippet.text = snippet.text + "$0"
  snippet.literal(host.stringSlice(body, bodyEnd, host.stringByteLength(body) - bodyEnd))
  return true
end

def lspDeclarationItem(document: LspDocument, site: LspDeclarationSite, label: String, detail: String, snippet: LspSnippet, snippets: Bool): String
  var start = site.start
  var insertion = snippets ? snippet.text : snippet.plain
  var filter = site.header

  if bootstrapStartsWith(snippet.plain, site.header)
    # Keep the written prefix in the document. Only newly supplied syntax and
    # editable fields enter the client's snippet interpreter.
    let retained = snippets ? lspSnippetEscape(site.header) : site.header

    insertion = host.stringSlice(insertion, host.stringByteLength(retained), host.stringByteLength(insertion) - host.stringByteLength(retained))
    start = start + (new IrSourceMap(site.header)).utf16Length()
    filter = ""
  end
  let range = "{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, site.finish) + "}"

  return "{\"label\":" + lspQuote(label) + ",\"filterText\":" + lspQuote(filter) + ",\"kind\":15,\"detail\":" + lspQuote(detail) + ",\"insertTextFormat\":" + (snippets ? "2" : "1") + ",\"insertTextMode\":1,\"textEdit\":{\"range\":" + range + ",\"newText\":" + lspQuote(insertion) + "}}"
end
