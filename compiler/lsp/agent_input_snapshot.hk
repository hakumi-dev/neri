use host

# Share content observations within one graph pass. A verification pass creates
# a new snapshot and reads disk again, including previously missing files.
class AgentInputSnapshot
  private files: StringTable<AgentInputFile> = new StringTable<AgentInputFile>()
  private bytes: Int = 0
  private count: Int = 0

  def read(path: String): AgentInputFile
    let cached = this.files.find(path)

    if cached != null
      return cached.value
    end
    let file = new AgentInputFile(path)
    let text = file.text
    var length = 0
    let limits = new AgentLimits()

    if text != null
      length = host.stringByteLength(text)
    end
    if this.count < limits.analysisPaths() && this.bytes + length <= limits.analysisBytes()
      this.files.add(path, file)
      this.bytes = this.bytes + length
      this.count = this.count + 1
    end
    return file
  end
end
