use host

class AgentEditTool: AgentToolDescriptor
  def init(): Void
    super("neri.edit", "Apply one atomic UTF-16 edit to an in-memory project buffer using the expected workspace revision; does not execute code or persist files.", agentEditFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let expected = agentInputInteger(arguments.get("expectedRevision"))
    let range = arguments.get("range")
    let start = agentDecodedPosition(range.get("start"))
    let finish = agentDecodedPosition(range.get("end"))

    if expected == null || start == null || finish == null
      return null
    end
    let request: AgentToolRequest = new AgentEditRequest(arguments.get("operationId").scalarText(), arguments.get("uri").scalarText(), expected, new AgentRange(start, finish), arguments.get("text").scalarText())

    return request
  end
end
