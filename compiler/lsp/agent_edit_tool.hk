use json

class AgentEditTool: AgentToolDescriptor
  def init(): Void
    super(
      "neri.edit",
      "Preview or apply one coordinated UTF-16 edit batch to in-memory project buffers with snapshot and revision preconditions; does not persist files or execute code.",
      agentEditFields()
    )
  end

  def inputSchema(): String
    let schema = json::Json.object()

    schema.put("type", json::Json.string("object"))
    schema.put("oneOf", json::Json.array([
          agentInputObjectSchema(agentEditVariantFields("single")),
          agentInputObjectSchema(agentEditVariantFields("batch")),
          agentInputObjectSchema(agentEditVariantFields("page"))
        ]))
    return lspSchemaText(schema)
  end

  def outputSchema(): String
    return agentEditOutputSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let revision = agentInputInteger(arguments.get("expectedRevision"))
    let cursor = arguments.get("cursor").scalarText()
    let batch = arguments.get("edits")
    var edits: AgentTextEdit? = null

    if revision == null
      return null
    end
    if cursor != ""
      if !agentInputObjectValid(arguments, agentEditVariantFields("page"))
        return null
      end
    else if !batch.isMissing()
      if !agentInputObjectValid(arguments, agentEditVariantFields("batch"))
        return null
      end
      var item = batch.first
      var last: AgentTextEdit? = null

      while item != null
        let edit = agentDecodedEdit(item)

        if edit == null
          return null
        end
        if last == null
          edits = edit
        else
          last.next = edit
        end
        last = edit
        item = item.next
      end
    else
      if !agentInputObjectValid(arguments, agentEditVariantFields("single"))
        return null
      end
      edits = agentDecodedEdit(arguments)
      if edits == null
        return null
      end
    end
    return new AgentEditRequest(
      arguments.get("operationId").scalarText(),
      revision,
      arguments.get("expectedSnapshot").scalarText(),
      edits,
      arguments.get("preview").isTrue(),
      cursor
    )
  end
end
