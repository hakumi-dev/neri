use host
use json
use result

# Eviction can cause another delivery; it cannot suppress a new snapshot.
class AgentFeedbackDelivery
  private path: String
  private entries: json::Json = json::Json.array()
  private count: Int = 0

  def init(state: String): Void
    this.path = state + ".deliveries"
    let text = host::readText(this.path)

    if text == null || host::stringByteLength(text) > 32768
      return
    end
    match json::Json.parse(text)
      case result::Result.Ok(value)
        if value.kind() != "array" || value.count() > 64
          return
        end
        value.each() do |index, entry|
          let scope = entry.get("scope")
          let snapshot = entry.get("snapshot")
          let identity = entry.get("identity")

          if scope != null && snapshot != null && identity != null && scope.kind() == "string" && snapshot.kind() == "string" && identity.kind() == "string"
            this.entries.add(new json::Json(entry))
            this.count = this.count + 1
          end
        end
      case result::Result.Error(failure)
        return
    end
  end

  def seen(scope: String, snapshot: String, identity: String): Bool
    if scope == "" || snapshot == ""
      return false
    end
    let encoded = agentFeedbackJson(this.entries)

    if encoded == null
      return false
    end
    let parsed = (new LspJsonParser(encoded)).parse()
    var entry = parsed.first

    while entry != null
      if entry.get("scope").scalarText() == scope && entry.get("snapshot").scalarText() == snapshot && entry.get("identity").scalarText() == identity
        return true
      end
      entry = entry.next
    end
    return false
  end

  def remember(scope: String, snapshot: String, identity: String): Void
    if scope == "" || snapshot == "" || this.seen(scope, snapshot, identity)
      return
    end
    let next = json::Json.array()
    let encoded = agentFeedbackJson(this.entries)

    if encoded != null
      match json::Json.parse(encoded)
        case result::Result.Ok(value)
          var index = this.count >= 64 ? 1 : 0

          while index < value.count()
            let entry = value.at(index)

            next.add(new json::Json(entry)) if entry != null
            index = index + 1
          end
        case result::Result.Error(failure)
          this.count = 0
      end
    end
    let entry = json::Json.object()

    entry.put("scope", json::Json.string(scope))
    entry.put("snapshot", json::Json.string(snapshot))
    entry.put("identity", json::Json.string(identity))
    next.add(entry)
    this.entries = next
    this.count = this.count >= 64 ? 64 : this.count + 1
    let stored = agentFeedbackJson(next)

    host::writeText(this.path, stored) if stored != null
  end
end
