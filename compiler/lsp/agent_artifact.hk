use crypto
use files
use host

def agentCompilerExecutable(): String?
  return host::executablePath()
end

def agentArtifactDigest(path: String): String?
  let read = files::readBytes(path, 134217728)
  let bytes = read.bytes

  if read.failure != null || read.closeFailure != null || bytes == null
    return null
  end
  let digest = crypto::sha256(bytes)
  let digestBytes = digest.bytes()

  if digest.failure() != null || digestBytes == null
    return null
  end
  return crypto::encodeHex(digestBytes)
end

def agentCompilerIdentity(): String?
  let path = agentCompilerExecutable()

  if path == null
    return null
  end
  let digest = agentArtifactDigest(path)

  if digest == null
    return null
  end
  return sha256FastText(runCacheFrame(path) + runCacheFrame(digest))
end

def agentFeedbackCacheInputs(inputs: String, compilerIdentity: String): String
  return sha256FastText(runCacheFrame(inputs) + runCacheFrame(compilerIdentity))
end
