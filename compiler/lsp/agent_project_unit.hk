class AgentProjectUnit
  public key: String
  public name: String
  public manifest: String
  public project: NeriProject
  public workspace: NeriAgentWorkspace
  public fingerprint: String
  public references: StringBuffer = new StringBuffer()
  public next: AgentProjectUnit?

  def init(manifest: String, name: String, snapshot: AgentInputSnapshot? = null): Void
    this.manifest = manifest
    this.name = name
    this.key = neriUnitKey(manifest, name)
    this.workspace = new NeriAgentWorkspace(manifest, name, snapshot)
    this.project = this.workspace.project
    this.fingerprint = this.workspace.fingerprint
  end
end
