class LspTemplateText
  public first: LspTemplatePart?
  public last: LspTemplatePart?
  public rendered: String = ""

  def add(part: LspTemplatePart): Void
    let tail = this.last

    if tail == null
      this.first = part
    else
      tail.nextPart = part
    end
    this.last = part
    this.rendered = this.rendered + part.text()
  end
end
