class LspTemplateText
  public first: LspTemplatePart?
  public last: LspTemplatePart?
  public rendered: String = ""

  def add(kind: String, value: String): Void
    let part = new LspTemplatePart()

    part.kind = kind
    part.value = value
    let tail = this.last

    if tail == null
      this.first = part
    else
      tail.nextPart = part
    end
    this.last = part
    this.rendered = this.rendered + value
  end
end
