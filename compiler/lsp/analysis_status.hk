sealed class AnalysisStatus
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def unavailable(): AnalysisStatus
    return new AnalysisStatus(0)
  end

  static def invalid(): AnalysisStatus
    return new AnalysisStatus(1)
  end

  static def valid(): AnalysisStatus
    return new AnalysisStatus(2)
  end

  readonly def isUnavailable(): Bool
    return this.tag == 0
  end

  readonly def isInvalid(): Bool
    return this.tag == 1
  end

  readonly def isValid(): Bool
    return this.tag == 2
  end

  readonly def wireName(): String
    if this.isValid()
      return "valid"
    end
    if this.isInvalid()
      return "invalid"
    end
    return "unavailable"
  end

  static def parseWire(name: String): AnalysisStatus?
    if name == "valid"
      return AnalysisStatus.valid()
    end
    if name == "invalid"
      return AnalysisStatus.invalid()
    end
    if name == "unavailable"
      return AnalysisStatus.unavailable()
    end
    return null
  end
end
