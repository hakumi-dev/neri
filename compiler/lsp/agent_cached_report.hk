use host

# Validates the object, array, scalar and local-reference contracts used by the
# project feedback schema. The schema comes from the compiler, never the cache.
def agentCachedShape(value: LspJson, schema: LspJson, definitions: LspJson): Bool
  let reference = schema.get("$ref")

  if reference.kind == "string"
    let prefix = "#/$defs/"

    if host.stringSlice(reference.value, 0, host.stringByteLength(prefix)) != prefix
      return false
    end
    let target = definitions.get(host.stringSlice(reference.value, host.stringByteLength(prefix), host.stringByteLength(reference.value) - host.stringByteLength(prefix)))

    return target.kind == "object" && agentCachedShape(value, target, definitions)
  end
  let type = schema.get("type").value

  if type == "boolean"
    return value.kind == "literal" && (value.value == "true" || value.value == "false")
  end
  if type == "integer"
    let number = agentInputInteger(value)
    let minimum = agentInputInteger(schema.get("minimum"))

    return number != null && (minimum == null || number >= minimum)
  end
  if value.kind != type
    return false
  end
  if type == "object"
    var required = schema.get("required").first

    while required != null
      if value.get(required.value).kind == "missing"
        return false
      end
      required = required.next
    end
    var field = value.first

    while field != null
      let property = schema.get("properties").get(field.key)

      if property.kind != "object" || !agentCachedShape(field, property, definitions)
        return false
      end
      var duplicate = field.next

      while duplicate != null
        if duplicate.key == field.key
          return false
        end
        duplicate = duplicate.next
      end
      field = field.next
    end
  else if type == "array"
    var item = value.first

    while item != null
      if !agentCachedShape(item, schema.get("items"), definitions)
        return false
      end
      item = item.next
    end
  end
  return true
end

def agentCachedProjectReport(value: LspJson): Bool
  let schema = (new LspJsonParser(agentProjectFeedbackSchema())).parse()

  if !agentCachedShape(value, schema, schema.get("$defs")) || value.get("schemaVersion").value != "1" || value.get("scope").value != "project" || value.get("complete").value != "true"
    return false
  end
  var unit = value.get("units").first
  var count = 0
  var diagnostics = 0
  var status = "valid"
  var truncated = false

  while unit != null
    let unitStatus = unit.get("status").value
    let unitCount = agentInputInteger(unit.get("diagnosticCount"))
    var emitted = 0
    var diagnostic = unit.get("diagnostics").first

    while diagnostic != null
      emitted = emitted + 1
      diagnostic = diagnostic.next
    end
    if unitCount == null || (unitStatus != "valid" && unitStatus != "invalid") || emitted > unitCount || (unit.get("diagnosticsTruncated").value == "false" && emitted != unitCount)
      return false
    end
    var duplicate = unit.next

    while duplicate != null
      if duplicate.get("projectKey").value == unit.get("projectKey").value
        return false
      end
      duplicate = duplicate.next
    end
    diagnostics = diagnostics + unitCount
    count = count + 1
    truncated = truncated || unit.get("diagnosticsTruncated").value == "true"
    if unitStatus == "invalid"
      status = "invalid"
    end
    unit = unit.next
  end
  let analyzed = agentInputInteger(value.get("unitsAnalyzed"))
  let reused = agentInputInteger(value.get("unitsReused"))

  return analyzed != null && reused != null && analyzed + reused == count && value.get("unitsTotal").value == (count as String) && value.get("diagnosticCount").value == (diagnostics as String) && value.get("status").value == status && value.get("diagnosticsTruncated").value == (truncated ? "true" : "false")
end
