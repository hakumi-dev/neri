use host

# Validates the object, array, scalar and local-reference contracts used by the
# project feedback schema. The schema comes from the compiler, never the cache.
def agentCachedShape(value: LspJson, schema: LspJson, definitions: LspJson): Bool
  let reference = schema.get("$ref")

  if reference.isString()
    let prefix = "#/$defs/"

    if host.stringSlice(reference.scalarText(), 0, host.stringByteLength(prefix)) != prefix
      return false
    end
    let target = definitions.get(host.stringSlice(reference.scalarText(), host.stringByteLength(prefix), host.stringByteLength(reference.scalarText()) - host.stringByteLength(prefix)))

    return target.isObject() && agentCachedShape(value, target, definitions)
  end
  let type = schema.get("type").scalarText()

  if type == "boolean"
    return value.isBoolean()
  end
  if type == "integer"
    let number = agentInputInteger(value)
    let minimum = agentInputInteger(schema.get("minimum"))

    return number != null && (minimum == null || number >= minimum)
  end
  if !lspJsonMatchesType(value, type)
    return false
  end
  if type == "object"
    var required = schema.get("required").first

    while required != null
      if value.get(required.scalarText()).isMissing()
        return false
      end
      required = required.next
    end
    var field = value.first

    while field != null
      let property = schema.get("properties").get(field.key)

      if !property.isObject() || !agentCachedShape(field, property, definitions)
        return false
      end
      var duplicate = field.next

      while duplicate != null
        if duplicate.key == field.key
          return false
        end
        duplicate = duplicate.next
      end
      field = field.next
    end
  else if type == "array"
    var item = value.first

    while item != null
      if !agentCachedShape(item, schema.get("items"), definitions)
        return false
      end
      item = item.next
    end
  end
  return true
end

def agentCachedProjectReport(value: LspJson): Bool
  let schema = (new LspJsonParser(agentProjectFeedbackSchema())).parse()

  if !agentCachedShape(value, schema, schema.get("$defs")) || value.get("schemaVersion").scalarText() != "1" || value.get("scope").scalarText() != "project" || !value.get("complete").isTrue()
    return false
  end
  var unit = value.get("units").first
  var count = 0
  var diagnostics = 0
  var status = "valid"
  var truncated = false

  while unit != null
    let unitStatus = unit.get("status").scalarText()
    let unitCount = agentInputInteger(unit.get("diagnosticCount"))
    var emitted = 0
    var diagnostic = unit.get("diagnostics").first

    while diagnostic != null
      emitted = emitted + 1
      diagnostic = diagnostic.next
    end
    if unitCount == null || (unitStatus != "valid" && unitStatus != "invalid") || emitted > unitCount || (unit.get("diagnosticsTruncated").isFalse() && emitted != unitCount)
      return false
    end
    var duplicate = unit.next

    while duplicate != null
      if duplicate.get("projectKey").scalarText() == unit.get("projectKey").scalarText()
        return false
      end
      duplicate = duplicate.next
    end
    diagnostics = diagnostics + unitCount
    count = count + 1
    truncated = truncated || unit.get("diagnosticsTruncated").isTrue()
    if unitStatus == "invalid"
      status = "invalid"
    end
    unit = unit.next
  end
  let analyzed = agentInputInteger(value.get("unitsAnalyzed"))
  let reused = agentInputInteger(value.get("unitsReused"))

  return analyzed != null && reused != null && analyzed + reused == count && value.get("unitsTotal").scalarText() == (count as String) && value.get("diagnosticCount").scalarText() == (diagnostics as String) && value.get("status").scalarText() == status && (truncated ? value.get("diagnosticsTruncated").isTrue() : value.get("diagnosticsTruncated").isFalse())
end
