use host

class AgentDiagnosticPage
  public items: String = "["
  public total: Int = 0
  public emittedCount: Int = 0
  public nextOffset: Int = -1
  public failure: String = ""
  public byteBudget: Int = 65534

  def append(entry: String, offset: Int): Bool
    let limits = new AgentLimits()
    let bytes = host::stringByteLength(this.items) + host::stringByteLength(entry) + 2

    if this.emittedCount > 0 && (bytes > limits.diagnosticBytes() || bytes > this.byteBudget)
      this.nextOffset = offset
      return false
    end
    if host::stringByteLength(entry) + 2 > this.byteBudget
      this.failure = "A diagnostic exceeds the available response byte budget."
      this.nextOffset = offset
      return false
    end
    this.items = this.items + (this.emittedCount == 0 ? "" : ",") + entry
    this.emittedCount = this.emittedCount + 1
    return true
  end
end
