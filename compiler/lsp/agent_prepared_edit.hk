class AgentPreparedEdit
  public first: Int
  public last: Int
  public text: String
  public range: AgentRange
  public next: AgentPreparedEdit?

  def init(first: Int, last: Int, text: String, range: AgentRange): Void
    this.first = first
    this.last = last
    this.text = text
    this.range = range
  end
end
