sealed class LspTemplateHeaderResult
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def applied(): LspTemplateHeaderResult
    return new LspTemplateHeaderResult(0)
  end

  static def reject(): LspTemplateHeaderResult
    return new LspTemplateHeaderResult(1)
  end

  static def defer(): LspTemplateHeaderResult
    return new LspTemplateHeaderResult(2)
  end

  readonly def isApplied(): Bool
    return this.tag == 0
  end

  readonly def isDeferred(): Bool
    return this.tag == 2
  end
end
