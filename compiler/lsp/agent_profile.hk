def agentProfileResponse(operationId: String, status: String, message: String, root: String, before: String, after: String, count: Int, complete: Bool, units: String): String
  return "{\"schemaVersion\":1,\"operationId\":" + lspQuote(operationId) + ",\"status\":" + lspQuote(status) + ",\"message\":" + lspQuote(message) + ",\"projectKey\":" + lspQuote(root) + ",\"snapshotBefore\":" + lspQuote(before) + ",\"snapshotAfter\":" + lspQuote(after) + ",\"unitsTotal\":" + (count as String) + ",\"complete\":" + (complete ? "true" : "false") + ",\"units\":[" + units + "]}"
end

def agentProfileOutputSchema(): String
  return "{\"type\":\"object\",\"properties\":{\"schemaVersion\":{\"type\":\"integer\",\"minimum\":0},\"operationId\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"projectKey\":{\"type\":\"string\"},\"snapshotBefore\":{\"type\":\"string\"},\"snapshotAfter\":{\"type\":\"string\"},\"unitsTotal\":{\"type\":\"integer\",\"minimum\":0},\"complete\":{\"type\":\"boolean\"},\"units\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"projectKey\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"fingerprint\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"exitKind\":{\"type\":\"string\"},\"exitCode\":{\"type\":\"integer\"},\"stdout\":{\"type\":\"string\"},\"stderr\":{\"type\":\"string\"},\"stdoutTruncated\":{\"type\":\"boolean\"},\"stderrTruncated\":{\"type\":\"boolean\"},\"artifactDigest\":{\"type\":\"string\"},\"timings\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"phase\":{\"type\":\"string\"},\"durationMs\":{\"type\":\"integer\",\"minimum\":0},\"samples\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"phase\",\"durationMs\",\"samples\"],\"additionalProperties\":false}}},\"required\":[\"projectKey\",\"name\",\"kind\",\"fingerprint\",\"status\",\"message\",\"exitKind\",\"exitCode\",\"stdout\",\"stderr\",\"stdoutTruncated\",\"stderrTruncated\",\"artifactDigest\",\"timings\"],\"additionalProperties\":false}}},\"required\":[\"schemaVersion\",\"operationId\",\"status\",\"message\",\"projectKey\",\"snapshotBefore\",\"snapshotAfter\",\"unitsTotal\",\"complete\",\"units\"],\"additionalProperties\":false}"
end
