use host

class AgentEditPlan
  public first: AgentStagedDocument?
  public failure: String = ""
  public count: Int = 0

  def find(uri: String): AgentStagedDocument?
    var document = this.first

    while document != null
      if document.staged.uri == uri
        return document
      end
      document = document.next
    end
    return null
  end

  def prepare(workspace: NeriAgentWorkspace, snapshot: AgentOverlaySnapshot, edits: AgentTextEdit?): Bool
    var edit = edits
    var editsCount = 0
    let limits = new AgentLimits()

    while edit != null
      editsCount = editsCount + 1
      if editsCount > 256
        this.failure = "An edit batch exceeds 256 edits."
        return false
      end
      let rawPath = lspPath(edit.uri)
      var path: String? = null

      if rawPath != null
        path = neriCanonicalPath(rawPath)
      end
      if path == null || !snapshot.owns(path)
        this.failure = "Every edit URI must identify an existing source in the complete project graph."
        return false
      end
      let uri = lspUri(path)
      var staged = this.find(uri)

      if staged == null
        let document = workspace.server.find(uri)

        if document == null
          this.failure = "Open every edited buffer before submitting the batch."
          return false
        end
        let created = new AgentStagedDocument(document)

        created.next = this.first
        this.first = created
        staged = created
        this.count = this.count + 1
      end
      if staged == null
        this.failure = "Cannot prepare the edit buffer."
        return false
      end
      this.failure = staged.add(edit.range, edit.text)
      if this.failure != ""
        return false
      end
      edit = edit.next
    end
    if editsCount == 0
      this.failure = "An edit batch must contain at least one edit."
      return false
    end
    var document = this.first

    while document != null
      document.prepare()
      if host::stringByteLength(document.staged.text) > limits.documentBytes()
        this.failure = "Edit exceeds the document buffer limit."
        return false
      end
      document = document.next
    end
    var bytes = 0
    var opened = workspace.server.documents

    while opened != null
      let replacement = this.find(opened.uri)

      bytes = bytes + host::stringByteLength(replacement == null ? opened.text : replacement.staged.text)
      opened = opened.next
    end
    if bytes > limits.bufferBytes()
      this.failure = "Edit exceeds the workspace buffer limit."
      return false
    end
    return true
  end

  def unchanged(): Bool
    var document = this.first

    while document != null
      if document.original.version != document.originalVersion || document.original.text != document.originalText
        return false
      end
      document = document.next
    end
    return true
  end

  def digest(): String
    let records = new StringBuffer()
    var document = this.first

    while document != null
      let parts = new StringBuffer()
      var edit = document.edits

      while edit != null
        parts.add(runCacheFrame(edit.first as String) + runCacheFrame(edit.last as String) + runCacheFrame(edit.text))
        edit = edit.next
      end
      records.add(runCacheFrame(document.staged.uri) + parts.join())
      document = document.next
    end
    return sha256FastText(agentOrderedRecords(records))
  end
end
