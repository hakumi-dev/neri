sealed class AgentTestOutcome
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def passed(): AgentTestOutcome
    return new AgentTestOutcome(0)
  end

  static def failed(): AgentTestOutcome
    return new AgentTestOutcome(1)
  end

  static def noTests(): AgentTestOutcome
    return new AgentTestOutcome(2)
  end

  static def unavailable(): AgentTestOutcome
    return new AgentTestOutcome(3)
  end

  static def conflict(): AgentTestOutcome
    return new AgentTestOutcome(4)
  end

  readonly def complete(): Bool
    return this.tag == 0 || this.tag == 1
  end

  readonly def hasNoTests(): Bool
    return this.tag == 2
  end

  readonly def stateName(): String
    if this.complete()
      return "complete"
    end
    if this.hasNoTests()
      return "noTests"
    end
    return this.tag == 4 ? "conflict" : "unavailable"
  end

  readonly def statusName(): String
    if this.tag == 0
      return "valid"
    end
    if this.tag == 1
      return "invalid"
    end
    return this.tag == 4 ? "conflict" : "unavailable"
  end
end
