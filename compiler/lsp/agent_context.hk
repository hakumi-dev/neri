# Structured semantic context for local agent adapters. This is an adapter over
# the compiler's completion query: it does not infer types from rendered hover
# text, and it never falls back to an older semantic model.

def lspAgentIdentity(document: LspDocument, context: LspCompletionResolution, identity: String): LspAgentIdentity
  if identity == ""
    return LspAgentIdentity.none()
  end
  let model = context.model
  let target = context.target

  var declaration = model.declarations

  while declaration != null && declaration.identity != identity
    declaration = declaration.next
  end
  if declaration == null
    return LspAgentIdentity.unresolved(identity)
  end
  var sourceIndex = 0

  while sourceIndex + 1 < context.querySourceStarts.size && context.querySourceStarts.get(sourceIndex + 1) <= declaration.start
    sourceIndex = sourceIndex + 1
  end
  if sourceIndex >= document.sourceUris.size
    return LspAgentIdentity.unresolved(identity)
  end
  var sourceOffset = declaration.start - context.querySourceStarts.get(sourceIndex)

  if sourceIndex == 0
    if sourceOffset >= target.start + context.queryInsertedLength
      if !context.queryMapsAfterInsertion
        return LspAgentIdentity.unresolved(identity)
      end
      sourceOffset = sourceOffset - context.queryInsertedLength + target.length
    else if sourceOffset >= target.start
      return LspAgentIdentity.unresolved(identity)
    end
  end
  let sourceLength = (new IrSourceMap(document.sourceTexts.get(sourceIndex))).utf16Length()

  if sourceOffset < 0 || sourceOffset >= sourceLength
    return LspAgentIdentity.unresolved(identity)
  end
  return LspAgentIdentity.resolved(identity, identity + "|" + document.sourceUris.get(sourceIndex) + "|" + (sourceOffset as String))
end

def lspAgentIdentityProperties(identity: LspAgentIdentity): String
  return "\"identity\":" + lspQuote(identity.canonical()) + ",\"semanticIdentity\":" + lspQuote(identity.semantic()) + ",\"identityStatus\":" + lspQuote(identity.wireName())
end

def lspAgentTypeKind(model: SemanticModel, typeName: String): String
  if typeName == ""
    return "none"
  end
  if typeName == "Error"
    return "error"
  end
  if semanticIsOptional(typeName)
    return "optional"
  end
  if semanticIsArray(typeName) || nativeFixedArray(typeName)
    return "array"
  end
  if semanticIsPointer(typeName)
    return "pointer"
  end
  if nativeRecordType(typeName)
    return "record"
  end
  let mutable = semanticMutableType(typeName)

  if model.findTypeParameter(mutable) != null
    return "typeParameter"
  end
  if mutable == "Null"
    return "null"
  end
  if mutable == "Void"
    return "void"
  end
  if semanticIsBuiltin(mutable)
    return "scalar"
  end
  let symbol = model.findClass(mutable)

  if symbol == null
    return "unknown"
  end
  if symbol.isFunctionType
    return "function"
  end
  if symbol.isAlternative
    return "alternative"
  end
  return "class"
end

def lspAgentType(document: LspDocument, context: LspCompletionResolution, model: SemanticModel, typeName: String): String
  let identity = lspTypeIdentity(model, typeName)
  let resolved = lspAgentIdentity(document, context, identity)

  return "{\"kind\":" + lspQuote(lspAgentTypeKind(model, typeName)) + ",\"name\":" + lspQuote(typeName) + "," + lspAgentIdentityProperties(resolved) + "}"
end

def lspAgentCandidate(document: LspDocument, context: LspCompletionResolution, target: SemanticCompletionTarget, site: SemanticCompletionSite, candidate: SemanticCompletionCandidate): String
  let insertion = semanticCompletionInsertion(candidate, target, site)
  let editRange = "{\"start\":" + lspPosition(document.text, target.start) + ",\"end\":" + lspPosition(document.text, target.start + target.length) + "}"
  let identity = lspAgentIdentity(document, context, candidate.identity)

  return "{\"name\":" + lspQuote(candidate.name) + ",\"insertText\":" + lspQuote(insertion.text) + ",\"kind\":" + (candidate.kind as String) + ",\"detail\":" + lspQuote(candidate.detail) + "," + lspAgentIdentityProperties(identity) + ",\"textEdit\":{\"range\":" + editRange + ",\"newText\":" + lspQuote(insertion.text) + "},\"cursorByteOffset\":" + (insertion.cursorByteOffset as String) + "}"
end

# The caller synchronously analyzes the document before invoking this function
# and checks revision/version again before applying an edit. `complete` means a
# unique semantic completion site was found. Candidates are bounded suggestions,
# not a proof that every listed insertion produces a complete valid program.
def lspAgentContext(document: LspDocument, position: Int): String
  let context = lspCompletionContext(document, position)
  var result = "{\"status\":" + lspQuote(context.wireName())
  let target = context.target()
  let resolution = context.resolved()

  result = result + ",\"target\":{\"kind\":" + lspQuote(target.kind) + ",\"start\":" + (target.start as String) + ",\"length\":" + (target.length as String) + ",\"prefix\":" + lspQuote(target.prefix) + "}"
  if resolution == null
    return result + ",\"expectedType\":{\"kind\":\"none\",\"name\":\"\",\"identity\":\"\",\"semanticIdentity\":\"\",\"identityStatus\":\"none\"},\"receiver\":{\"kind\":\"\",\"type\":\"\"},\"callableIdentity\":\"\",\"callableSemanticIdentity\":\"\",\"callableIdentityStatus\":\"none\",\"count\":0,\"truncated\":false,\"candidates\":[]}"
  end
  let model = resolution.model
  let site = resolution.site
  var callableIdentity = LspAgentIdentity.none()
  let callable = site.callable

  if site.receiverKind == "argument-label" || site.receiverKind == "argument-start"
    callableIdentity = lspAgentIdentity(document, resolution, "callable:" + site.receiverType)
  else if callable != null
    callableIdentity = lspAgentIdentity(document, resolution, semanticCompletionCallableIdentity(model, callable))
  end
  let filter = new SemanticCompletionFilter()

  filter.marker = "__neri_completion_site_7f31__"
  let candidates = semanticCompletionCandidates(model, site, target.prefix, 128, bootstrapInstalledLibraryNames(), filter)
  let items = new StringBuffer()
  var candidate = candidates.first
  var itemBytes = 0
  var emitted = 0
  var budgetTruncated = false

  while candidate != null
    let item = (items.size == 0 ? "" : ",") + lspAgentCandidate(document, resolution, target, site, candidate)

    if itemBytes + host::stringByteLength(item) > 65536
      budgetTruncated = true
      break
    end
    items.add(item)
    itemBytes = itemBytes + host::stringByteLength(item)
    emitted = emitted + 1
    candidate = candidate.next
  end
  let serialized = result + ",\"expectedType\":" + lspAgentType(document, resolution, model, site.expectedType) + ",\"receiver\":{\"kind\":" + lspQuote(site.receiverKind) + ",\"type\":" + lspQuote(site.receiverType) + "},\"callableIdentity\":" + lspQuote(callableIdentity.canonical()) + ",\"callableSemanticIdentity\":" + lspQuote(callableIdentity.semantic()) + ",\"callableIdentityStatus\":" + lspQuote(callableIdentity.wireName()) + ",\"count\":" + (emitted as String) + ",\"truncated\":" + (candidates.truncated || budgetTruncated ? "true" : "false") + ",\"candidates\":[" + items.join() + "]}"

  if host::stringByteLength(serialized) > 131072
    return "{\"status\":\"limit\",\"target\":null,\"expectedType\":{\"kind\":\"none\",\"name\":\"\",\"identity\":\"\",\"semanticIdentity\":\"\",\"identityStatus\":\"none\"},\"receiver\":{\"kind\":\"\",\"type\":\"\"},\"callableIdentity\":\"\",\"callableSemanticIdentity\":\"\",\"callableIdentityStatus\":\"none\",\"count\":0,\"truncated\":true,\"candidates\":[]}"
  end
  return serialized
end
