use host

class AgentOpenRequest: AgentToolRequest
  private storedOperationId: String
  private storedUri: String
  private storedText: String?

  def init(operationId: String, uri: String, text: String?): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedText = text
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def text(): String?
    return this.storedText
  end

  def expectedRevision(): Int?
    return null
  end

  def requiresOpenBuffer(): Bool
    return false
  end

  def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
    return workspace.applyOpen(this, target)
  end

  def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext
    return new AgentToolContext()
  end
end
