use host

class AgentInputFile
  public text: String?
  public digest: String = "missing"
  private references: BootstrapLibraryReferences = new BootstrapLibraryReferences()
  private importsReady: Bool = false

  def init(path: String): Void
    let text = host::readText(path)

    this.text = text
    if text != null
      this.digest = sha256FastText(text)
    end
  end

  def libraryReferences(): BootstrapLibraryReferences
    if !this.importsReady
      let text = this.text

      if text != null
        this.references.addSource(text)
      end
      this.importsReady = true
    end
    return this.references
  end
end
