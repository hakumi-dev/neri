use host

class AgentInputFile
  public text: String?
  public digest: String = "missing"
  private imports: String[] = []
  private importsReady: Bool = false

  def init(path: String): Void
    let text = host.readText(path)

    this.text = text
    if text != null
      this.digest = sha256FastText(text)
    end
  end

  def libraryImports(): String[]
    if !this.importsReady
      let text = this.text

      if text != null
        this.imports = bootstrapLibraryImports(text)
      end
      this.importsReady = true
    end
    return this.imports
  end
end
