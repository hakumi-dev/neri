use console
use host

class LspDocument
  public uri: String = ""
  public sourcePath: String = ""
  public text: String = ""
  public version: Int = 0
  public semantic: SemanticModel?
  public tokens: TokenBuffer?
  public syntax: SyntaxArena?
  public syntaxRoot: Int = -1
  public analysisStatus: String = "unavailable"
  public lastDiagnostics: DiagnosticBuffer?
  public lastPublishedDiagnostics: String = "[]"
  public analysisRevision: Int = 0
  public analysisPending: Bool = false
  public dependencyPaths: StringBuffer?
  public projectKey: String = ""
  public sourceVersions: IntBuffer = new IntBuffer()
  public queryIndex: LspSemanticIndex?
  public querySnapshot: LspSemanticSnapshot?
  public publishDiagnostics: Bool = true
  public renameClosedWorld: Bool = true
  public renameOwnedSourceUris: StringBuffer = new StringBuffer()
  public requireEntryPoint: Bool = true
  public forbiddenEntryPointSources: StringBuffer = new StringBuffer()
  public stdlibDocumentation: LspJson?
  public sourceUris: StringBuffer = new StringBuffer()
  public sourceTexts: StringBuffer = new StringBuffer()
  public sourceStarts: IntBuffer = new IntBuffer()
  public generatedOrigins: NeriGeneratedOrigin?
  public next: LspDocument?
end
