use host

class LspQueuedMessage
  public message: LspJson?
  public byteLength: Int
  public id: String?
  public method: LspMethod = LspMethod.Unknown()
  public cancellation: Bool = false
  private cancellable: Bool = true
  private idleNotification: Bool = false
  public cancelled: Bool = false
  public next: LspQueuedMessage?

  def init(body: String): Void
    this.byteLength = host::stringByteLength(body)
    let parser = new LspJsonParser(body)
    let message = parser.parse()

    parser.spaces()
    if parser.failed || parser.position != this.byteLength
      return
    end
    this.message = message
    if message.isObject() && message.get("jsonrpc").scalarText() == "2.0" && message.get("method").isString()
      this.method = lspDecodeMethod(message.get("method").scalarText())
      this.id = lspRequestIdentity(message.get("id"))
    end
    match this.method
      case LspMethod.Unknown()
        this.idleNotification = false
      case LspMethod.Exit()
        this.idleNotification = true
      case LspMethod.Initialize()
        this.cancellable = false
      case LspMethod.Shutdown()
        this.cancellable = false
      case LspMethod.WorkspaceSymbol()
        this.idleNotification = false
      case LspMethod.OnTypeFormatting()
        this.idleNotification = false
      case LspMethod.Formatting()
        this.idleNotification = false
      case LspMethod.CodeAction()
        this.idleNotification = false
      case LspMethod.PrepareRename()
        this.idleNotification = false
      case LspMethod.Rename()
        this.idleNotification = false
      case LspMethod.DocumentSymbol()
        this.idleNotification = false
      case LspMethod.ResolveCompletion()
        this.idleNotification = false
      case LspMethod.Hover()
        this.idleNotification = false
      case LspMethod.Definition()
        this.idleNotification = false
      case LspMethod.SourceOrigin()
        this.idleNotification = false
      case LspMethod.TypeDefinition()
        this.idleNotification = false
      case LspMethod.References()
        this.idleNotification = false
      case LspMethod.DocumentHighlight()
        this.idleNotification = false
      case LspMethod.Completion()
        this.idleNotification = false
      case LspMethod.SignatureHelp()
        this.idleNotification = false
      case LspMethod.WatchedFiles()
        this.idleNotification = true
      case LspMethod.Close()
        this.idleNotification = true
      case LspMethod.Open()
        this.idleNotification = true
      case LspMethod.Change()
        this.idleNotification = true
      case LspMethod.CancelRequest()
        this.cancellation = true
    end
  end

  readonly def canCancel(): Bool
    return this.id != null && this.cancellable
  end

  readonly def interruptsIdle(): Bool
    return this.id != null || this.idleNotification
  end
end

def lspRequestIdentity(id: LspJson): String?
  if id.isString()
    return lspQuote(id.scalarText())
  end
  if id.isNumber()
    let value = host::parseInt(id.scalarText())

    if value != null
      return value as String
    end
  end
  return null
end
