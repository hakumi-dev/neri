class AgentFeedbackRequest: AgentToolRequest
  private operation: String
  private expectedSnapshot: String
  private cursor: String
  private pageSize: Int

  def init(operationId: String, expectedSnapshot: String = "", cursor: String = "", pageSize: Int = 128): Void
    this.operation = operationId
    this.expectedSnapshot = expectedSnapshot
    this.cursor = cursor
    this.pageSize = pageSize
  end

  def operationId(): String
    return this.operation
  end

  def execute(workspace: NeriAgentWorkspace): String
    return agentPersistentProjectFeedback(
      workspace.root,
      this.operation,
      this.expectedSnapshot,
      this.cursor,
      this.pageSize,
      workspace.responseBytes
    )
  end
end
