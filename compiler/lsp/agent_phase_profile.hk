use host

class AgentPhaseProfile
  public first: AgentPhaseTiming?
  public complete: Bool = false
  public error: String = ""

  def init(text: String): Void
    var start = 0
    var index = 0
    var phases = 0

    while index < host::stringByteLength(text)
      if (host::stringByteAt(text, index) as Int) == 10
        let line = host::stringSlice(text, start, index - start)
        let parser = new LspJsonParser(line)
        let event = parser.parse()

        parser.spaces()
        let duration = agentInputInteger(event.get("durationMs"))
        let phase = event.get("phase").scalarText()

        if parser.failed || parser.position != host::stringByteLength(line) || event.get("schemaVersion").scalarText() != "1" || phase == "" || host::stringByteLength(phase) > 128 || duration == null || this.complete
          this.error = "Invalid compiler timing record."
          return
        end
        if duration < 0 || duration > 86400000
          this.error = "Compiler timing is outside the supported range."
          return
        end
        var entry = this.first

        while entry != null && entry.phase != phase
          entry = entry.next
        end
        if entry == null
          phases = phases + 1
          if phases > 64
            this.error = "Compiler timing phase limit exceeded."
            return
          end
          let created = new AgentPhaseTiming(phase)

          created.next = this.first
          this.first = created
          entry = created
        end
        if entry != null
          entry.durationMs = entry.durationMs + duration
          entry.samples = entry.samples + 1
        end
        this.complete = phase == "build-complete"
        start = index + 1
      end
      index = index + 1
    end
    if start != host::stringByteLength(text) || !this.complete
      this.error = "Compiler timing stream is incomplete."
      this.complete = false
    end
  end

  def json(): String
    var result = ""
    var separator = ""
    var phase = this.first

    while phase != null
      result = result + separator + "{\"phase\":" + lspQuote(phase.phase) + ",\"durationMs\":" + (phase.durationMs as String) + ",\"samples\":" + (phase.samples as String) + "}"
      separator = ","
      phase = phase.next
    end
    return "[" + result + "]"
  end
end
