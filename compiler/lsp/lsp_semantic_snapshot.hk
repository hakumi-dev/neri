class LspSemanticSnapshot
  public projectKey: String = ""
  public projectRevision: Int = 0
  public semantic: SemanticModel?
  public sourceUris: StringBuffer = new StringBuffer()
  public sourceTexts: StringBuffer = new StringBuffer()
  public sourceStarts: IntBuffer = new IntBuffer()
  # -1 denotes a closed source read from the project snapshot.
  public sourceVersions: IntBuffer = new IntBuffer()
  public requireEntryPoint: Bool = true
  public forbiddenEntryPointSources: StringBuffer = new StringBuffer()
  # Rename may edit exported symbols only when the server proved this snapshot
  # contains every editable project source that can reference them.
  public renameClosedWorld: Bool = false
  public renameOwnedSourceUris: StringBuffer = new StringBuffer()
  private canonicalIdentities: StringTable<String>?
  private indexedStarts: Int[] = []
  private indexedUris: String[] = []
  private sourcesReady: Bool = false

  def sourceAt(position: Int): LspSnapshotSource?
    if !this.sourcesReady
      var index = 0

      while index < this.sourceStarts.size
        let uri = index < this.sourceUris.size ? this.sourceUris.get(index) : ""

        this.indexedStarts = host::appendInt(this.indexedStarts, this.sourceStarts.get(index))
        this.indexedUris = host::appendString(this.indexedUris, uri)
        index = index + 1
      end
      this.sourcesReady = true
    end
    if this.indexedStarts.Length == 0
      return null
    end
    var low = 0
    var high = this.indexedStarts.Length

    while low + 1 < high
      let middle = low + (high - low) / 2

      if this.indexedStarts[middle] <= position
        low = middle
      else
        high = middle
      end
    end
    return new LspSnapshotSource(this.indexedStarts[low], this.indexedUris[low])
  end

  def canonicalIdentity(identity: String): String
    if identity == ""
      return ""
    end
    if bootstrapStartsWith(identity, "namespace:")
      return identity
    end
    let resolved = this.identityTable().find(identity)

    if resolved != null
      return resolved.value
    end
    return identity + "|unresolved|" + lspSnapshotKey(this)
  end

  private def identityTable(): StringTable<String>
    let cached = this.canonicalIdentities

    if cached != null
      return cached
    end
    let identities = new StringTable<String>()
    let semantic = this.semantic

    if semantic != null
      var declaration = semantic.declarations

      while declaration != null
        let canonical = declaration.identity + "|" + lspSnapshotSourceKey(this, declaration.start) + "|" + (lspSnapshotSourceOffset(this, declaration.start) as String)

        identities.add(declaration.identity, canonical)
        declaration = declaration.next
      end
    end
    this.canonicalIdentities = identities
    return identities
  end
end
