use host

class AgentProjectFeedback
  private root: String
  public inputs: String = ""
  public report: String = ""

  def init(root: String): Void
    this.root = root
  end

  def collect(operationId: String, previousInputs: String = "", previousReport: String = "", suppressUnchanged: Bool = true): String
    this.inputs = ""
    this.report = ""
    let graph = new AgentProjectGraph(this.root)
    let before = graph.snapshot
    let projectKey = graph.manifest
    var prior = new LspJson()

    if previousReport != ""
      let parser = new LspJsonParser(previousReport)
      let parsed = parser.parse()

      parser.spaces()
      if !parser.failed && parser.position == host::stringByteLength(previousReport) && parsed.get("projectKey").scalarText() == projectKey && parsed.get("snapshot").scalarText() == previousInputs && agentCachedProjectReport(parsed)
        prior = parsed
      end
    end
    let unchanged = graph.error == "" && prior.isObject() && previousInputs != "" && before == previousInputs

    if unchanged && suppressUnchanged
      this.inputs = before
      return ""
    end
    var results = ""
    var separator = ""
    var status = graph.error == "" ? "valid" : "unavailable"
    var message = graph.error
    var complete = graph.error == ""
    var analyzed = 0
    var reused = 0
    var diagnosticCount = 0
    var diagnosticBytes = 0
    var truncated = false
    var changed = ""
    var changedSeparator = ""
    var unit = graph.first

    while unit != null && graph.error == ""
      var cached: LspJson? = null
      var candidate = prior.get("units").first

      while candidate != null
        if candidate.get("projectKey").scalarText() == unit.key && candidate.get("fingerprint").scalarText() == unit.fingerprint && (candidate.get("status").scalarText() == "valid" || candidate.get("status").scalarText() == "invalid") && candidate.get("diagnostics").isArray() && agentInputInteger(candidate.get("diagnosticCount")) != null
          cached = candidate
        end
        candidate = candidate.next
      end
      var result = new LspJson()
      var reuse = false

      if cached != null
        result = cached
        reuse = true
        reused = reused + 1
      else
        let analysis = new AgentDiskAnalysis(unit.workspace)

        result = (new LspJsonParser(analysis.run(operationId))).parse()
        unit.workspace.server.documents = null
        unit.workspace.server.priorityDocument = null
        analyzed = analyzed + 1
        changed = changed + changedSeparator + lspQuote(unit.key)
        changedSeparator = ","
      end
      let unitStatus = result.get("status").scalarText()
      let count = agentInputInteger(result.get("diagnosticCount"))
      var countText = "0"
      var diagnostics = lspJsonStringify(result.get("diagnostics"))
      var unitTruncated = result.get("diagnosticsTruncated").isTrue()

      if count != null
        diagnosticCount = diagnosticCount + count
        countText = count as String
      end
      if diagnosticBytes + host::stringByteLength(diagnostics) > (new AgentLimits()).projectDiagnosticBytes()
        diagnostics = "[]"
        unitTruncated = true
      else
        diagnosticBytes = diagnosticBytes + host::stringByteLength(diagnostics)
      end
      truncated = truncated || unitTruncated
      if unitStatus != "valid" && unitStatus != "invalid"
        status = "unavailable"
        complete = false
      else if unitStatus == "invalid" && status == "valid"
        status = "invalid"
      end
      results = results + separator + "{\"projectKey\":" + lspQuote(unit.key) + ",\"name\":" + lspQuote(unit.name) + ",\"fingerprint\":" + lspQuote(unit.fingerprint) + ",\"status\":" + lspQuote(unitStatus) + ",\"message\":" + lspQuote(result.get("message").scalarText()) + ",\"reused\":" + (reuse ? "true" : "false") + ",\"diagnosticCount\":" + countText + ",\"diagnosticsTruncated\":" + (unitTruncated ? "true" : "false") + ",\"diagnostics\":" + diagnostics + "}"
      separator = ","
      unit = unit.next
    end
    let count = graph.count
    var removed = ""
    var removedSeparator = ""
    var old = prior.get("units").first

    while old != null
      if graph.find(old.get("projectKey").scalarText()) == null
        removed = removed + removedSeparator + lspQuote(old.get("projectKey").scalarText())
        removedSeparator = ","
      end
      old = old.next
    end
    if !unchanged
      graph.refresh()
    end
    if graph.snapshot != before
      status = "conflict"
      message = "Project inputs changed during analysis; retry against the current graph."
      complete = false
    end
    if complete
      this.inputs = before
    end
    this.report = "{\"schemaVersion\":1,\"operationId\":" + lspQuote(operationId) + ",\"scope\":\"project\",\"projectKey\":" + lspQuote(projectKey) + ",\"snapshot\":" + lspQuote(before) + ",\"status\":" + lspQuote(status) + ",\"message\":" + lspQuote(message) + ",\"complete\":" + (complete ? "true" : "false") + ",\"unitsTotal\":" + (count as String) + ",\"unitsAnalyzed\":" + (analyzed as String) + ",\"unitsReused\":" + (reused as String) + ",\"diagnosticCount\":" + (diagnosticCount as String) + ",\"diagnosticsTruncated\":" + (truncated ? "true" : "false") + ",\"invalidatedUnits\":[" + changed + "],\"removedUnits\":[" + removed + "],\"units\":[" + results + "]}"
    return this.report
  end
end
