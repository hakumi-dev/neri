use host

class AgentInputField
  private storedName: String
  private storedType: AgentInputType
  private isRequired: Bool

  def init(name: String, type: AgentInputType, required: Bool = true): Void
    this.storedName = name
    this.storedType = type
    this.isRequired = required
  end

  def name(): String
    return this.storedName
  end

  def required(): Bool
    return this.isRequired
  end

  def schema(): String
    return this.storedType.schema()
  end

  def valid(value: LspJson): Bool
    return this.storedType.valid(value)
  end
end
