
def agentOutputDefinitions(): json::Json
  let string = lspTypeSchema("string")
  let integer = lspTypeSchema("integer")
  let nonnegative = lspTypeSchema("integer").put("minimum", json::Json.integer(0))
  let boolean = lspTypeSchema("boolean")
  let point = agentInputObjectSchema(agentPointFields())
  let range = lspObjectSchema([
      new LspSchemaProperty("start", lspReferenceSchema("point")),
      new LspSchemaProperty("end", lspReferenceSchema("point"))
    ])
  let diagnostic = lspObjectSchema([
      new LspSchemaProperty("uri", string),
      new LspSchemaProperty("range", lspReferenceSchema("range")),
      new LspSchemaProperty("severity", integer),
      new LspSchemaProperty("code", string),
      new LspSchemaProperty("message", string)
    ])
  let effects = lspObjectSchema([
      new LspSchemaProperty("applied", boolean),
      new LspSchemaProperty("analyzed", boolean),
      new LspSchemaProperty("persisted", boolean),
      new LspSchemaProperty("executed", boolean)
    ])
  let type = lspObjectSchema([
      new LspSchemaProperty("kind", string),
      new LspSchemaProperty("name", string),
      new LspSchemaProperty("identity", string),
      new LspSchemaProperty("semanticIdentity", string),
      new LspSchemaProperty("identityStatus", string)
    ])
  let target = lspObjectSchema([
      new LspSchemaProperty("kind", string),
      new LspSchemaProperty("start", nonnegative),
      new LspSchemaProperty("length", nonnegative),
      new LspSchemaProperty("prefix", string)
    ])
  let receiver = lspObjectSchema([
      new LspSchemaProperty("kind", string),
      new LspSchemaProperty("type", string)
    ])
  let textEdit = lspObjectSchema([
      new LspSchemaProperty("range", lspReferenceSchema("range")),
      new LspSchemaProperty("newText", string)
    ])
  let candidate = lspObjectSchema([
      new LspSchemaProperty("name", string),
      new LspSchemaProperty("insertText", string),
      new LspSchemaProperty("kind", integer),
      new LspSchemaProperty("detail", string),
      new LspSchemaProperty("identity", string),
      new LspSchemaProperty("semanticIdentity", string),
      new LspSchemaProperty("identityStatus", string),
      new LspSchemaProperty("textEdit", lspReferenceSchema("textEdit")),
      new LspSchemaProperty("cursorByteOffset", nonnegative)
    ])
  let nullableTarget = json::Json.object().put("anyOf", json::Json.array([
        lspReferenceSchema("target"), lspTypeSchema("null")
      ]))
  let context = lspObjectSchema([
      new LspSchemaProperty("status", string),
      new LspSchemaProperty("target", nullableTarget, false),
      new LspSchemaProperty("expectedType", lspReferenceSchema("type"), false),
      new LspSchemaProperty("receiver", lspReferenceSchema("receiver"), false),
      new LspSchemaProperty("callableIdentity", string, false),
      new LspSchemaProperty("callableSemanticIdentity", string, false),
      new LspSchemaProperty("callableIdentityStatus", string, false),
      new LspSchemaProperty("count", nonnegative),
      new LspSchemaProperty("truncated", boolean),
      new LspSchemaProperty("candidates", lspArraySchema(lspReferenceSchema("candidate")))
    ])
  let excerpt = lspObjectSchema([
      new LspSchemaProperty("text", string),
      new LspSchemaProperty("range", lspReferenceSchema("range")),
      new LspSchemaProperty("truncated", boolean)
    ])
  let definitions = json::Json.object()

  definitions.put("point", point)
  definitions.put("range", range)
  definitions.put("diagnostic", diagnostic)
  definitions.put("effects", effects)
  definitions.put("type", type)
  definitions.put("target", target)
  definitions.put("receiver", receiver)
  definitions.put("textEdit", textEdit)
  definitions.put("candidate", candidate)
  definitions.put("context", context)
  definitions.put("sourceExcerpt", excerpt)
  return definitions
end

def agentOutputSchema(): String
  let string = lspTypeSchema("string")
  let integer = lspTypeSchema("integer").put("minimum", json::Json.integer(0))
  let boolean = lspTypeSchema("boolean")
  let schema = lspObjectSchema([
      new LspSchemaProperty("schemaVersion", integer),
      new LspSchemaProperty("operationId", string),
      new LspSchemaProperty("uri", string),
      new LspSchemaProperty("projectKey", string),
      new LspSchemaProperty("revision", integer),
      new LspSchemaProperty("documentVersion", integer),
      new LspSchemaProperty("status", string),
      new LspSchemaProperty("analysisStatus", string),
      new LspSchemaProperty("diagnostics", lspArraySchema(lspReferenceSchema("diagnostic"))),
      new LspSchemaProperty("effects", lspReferenceSchema("effects", true)),
      new LspSchemaProperty("context", lspReferenceSchema("context", true), false),
      new LspSchemaProperty("message", string),
      new LspSchemaProperty("analysisRevision", integer),
      new LspSchemaProperty("snapshot", string),
      new LspSchemaProperty("analysisSnapshot", string),
      new LspSchemaProperty("diagnosticCount", integer),
      new LspSchemaProperty("diagnosticsTruncated", boolean),
      new LspSchemaProperty("sourceExcerpt", lspReferenceSchema("sourceExcerpt", true), false)
    ])

  schema.put("$schema", json::Json.string("https://json-schema.org/draft/2020-12/schema"))
  schema.put("$defs", agentOutputDefinitions())
  return lspSchemaText(schema)
end
