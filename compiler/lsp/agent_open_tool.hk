use host

class AgentOpenTool: AgentToolDescriptor
  def init(): Void
    super("neri.open", "Open one project source in an in-memory overlay; does not replace an already open buffer.", agentOpenFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let text = arguments.get("text")
    var proposed: String? = null

    if text.kind == "string"
      proposed = text.value
    end
    let request: AgentToolRequest = new AgentOpenRequest(arguments.get("operationId").value, arguments.get("uri").value, proposed)

    return request
  end
end
