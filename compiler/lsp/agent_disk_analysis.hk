# Disk analysis uses the owning unit supplied by its caller. The session or
# project graph verifies input fingerprints around this operation.
class AgentDiskAnalysis
  private workspace: NeriAgentWorkspace
  public document: LspDocument?

  def init(workspace: NeriAgentWorkspace): Void
    this.workspace = workspace
  end

  def run(operationId: String): String
    this.document = null
    let workspace = this.workspace

    workspace.server.documents = null
    workspace.server.priorityDocument = null
    workspace.server.sourceSymbolsEnabled = false
    if workspace.inputLimit
      return workspace.response(operationId, "", "limit", "Workspace analysis inputs exceed 1024 paths or 16 MiB.", null)
    end
    if workspace.project.error() != ""
      return workspace.response(operationId, "", "unavailable", workspace.project.error(), null)
    end
    let first = workspace.project.ownSources.first.nextNode

    if first == null
      return workspace.response(operationId, "", "unavailable", "Selected project unit has no source to analyze.", null)
    end
    let path = first.value
    let uri = lspUri(path)
    let text = neriProjectVerifiedText(workspace.project, path)

    if text == null
      return workspace.response(operationId, uri, "unavailable", "Source is unavailable: " + path, null)
    end
    let document = new LspDocument()

    this.document = document
    document.uri = uri
    document.sourcePath = path
    document.text = text
    document.version = 0
    document.publishDiagnostics = false
    workspace.server.documents = document
    workspace.server.invalidate(document)
    workspace.server.ensureAnalyzed(document)
    if document.analysisStatus != "valid" && document.analysisStatus != "invalid"
      return workspace.response(operationId, uri, "unavailable", "Project analysis is unavailable.", document, false, true)
    end
    return workspace.response(operationId, uri, document.analysisStatus, "", document, false, true)
  end
end
