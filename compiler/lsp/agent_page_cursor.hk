use host

use json
use result

class AgentPageCursor
  public offset: Int = 0
  public pageSize: Int = 128
  public unit: String = ""
  public failure: String = ""

  def decode(cursor: String, snapshot: String, query: String): Bool
    let parser = new LspJsonParser(cursor)
    let value = parser.parse()
    let fields = [
      new AgentInputField("snapshot", new AgentStringInput(64, 64)),
      new AgentInputField("query", new AgentStringInput(64, 64)),
      new AgentInputField("unit", new AgentStringInput(1, 8192)),
      new AgentInputField("offset", new AgentIntegerInput(0)),
      new AgentInputField("pageSize", new AgentIntegerInput(1))
    ]

    parser.spaces()
    if parser.failed || parser.position != host::stringByteLength(cursor) || !agentInputObjectValid(value, fields)
      this.failure = "Page cursor is malformed."
      return false
    end
    let offset = agentInputInteger(value.get("offset"))
    let pageSize = agentInputInteger(value.get("pageSize"))

    if offset == null || pageSize == null || pageSize > 128
      this.failure = "Page cursor has an invalid offset or page size."
      return false
    end
    if value.get("snapshot").scalarText() != snapshot || value.get("query").scalarText() != query
      this.failure = "Page cursor belongs to a different snapshot or query."
      return false
    end
    this.offset = offset
    this.pageSize = pageSize
    this.unit = value.get("unit").scalarText()
    return true
  end

  def encode(snapshot: String, query: String, unit: String, offset: Int, pageSize: Int = 128): String
    let value = json::Json.object()

    value.put("snapshot", json::Json.string(snapshot))
    value.put("query", json::Json.string(query))
    value.put("unit", json::Json.string(unit))
    value.put("offset", json::Json.integer(offset))
    value.put("pageSize", json::Json.integer(pageSize))
    match value.stringify()
      case result::Result.Ok(text)
        return text
      case result::Result.Error(problem)
        this.failure = "Cannot serialize the page cursor."
        return ""
    end
  end
end
