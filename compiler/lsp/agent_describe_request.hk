class AgentDescribeRequest: AgentToolRequest
  private operation: String
  private query: String

  def init(operationId: String, query: String): Void
    this.operation = operationId
    this.query = query
  end

  def operationId(): String
    return this.operation
  end

  def execute(workspace: NeriAgentWorkspace): String
    return (new AgentDescribeService(workspace.root)).describe(this.operation, this.query)
  end
end
