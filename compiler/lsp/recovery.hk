
def lspMissingArgumentEnd(tokens: TokenBuffer, colonStart: Int): Int
  var index = 0

  while index < tokens.count() && tokens.startAt(index) != colonStart
    index = index + 1
  end
  if index >= tokens.count()
    return -1
  end
  index = index + 1
  while index < tokens.count()
    let kind = tokens.kindAt(index)

    if kind.isComma() || kind.isRParen() || kind.isRBracket() || kind.isNewLine() || kind.isEnd() || kind.isEndOfFile()
      return tokens.startAt(index)
    end
    index = index + 1
  end
  return -1
end

def lspMissingArgumentInNode(syntax: SyntaxArena, tokens: TokenBuffer, node: Int, position: Int, labelPosition: Bool): LspMissingArgument?
  if node < 0
    return null
  end
  if syntax.kindAt(node).isNamedArgument() && syntax.childCountAt(node) == 1
    let expression = syntax.childAt(node, 0)

    if syntax.kindAt(expression).isMissingExpression()
      let result = new LspMissingArgument()

      result.colonStart = syntax.secondaryStartAt(node)
      result.colonLength = syntax.secondaryLengthAt(node)
      result.finish = lspMissingArgumentEnd(tokens, result.colonStart)
      let inLabel = labelPosition && syntax.startAt(node) <= position && position < syntax.startAt(node) + syntax.lengthAt(node)
      let inValue = !labelPosition && result.colonStart >= 0 && result.finish >= result.colonStart + result.colonLength && position >= result.colonStart + result.colonLength && position <= result.finish

      if inLabel || inValue
        return result
      end
    end
  end
  var offset = 0

  while offset < syntax.childCountAt(node)
    let result = lspMissingArgumentInNode(syntax, tokens, syntax.childAt(node, offset), position, labelPosition)

    if result != null
      return result
    end
    offset = offset + 1
  end
  return null
end

def lspMissingArgumentRepair(document: LspDocument, position: Int, marker: String, labelPosition: Bool = false): LspQueryRepair?
  let syntax = document.syntax
  let tokens = document.tokens

  if syntax == null || tokens == null || document.syntaxRoot < 0 || marker == ""
    return null
  end
  let missing = lspMissingArgumentInNode(syntax, tokens, document.syntaxRoot, position, labelPosition)

  if missing == null
    return null
  end
  let insertionStart = labelPosition ? missing.colonStart + missing.colonLength : position
  let map = new IrSourceMap(document.text)
  let byte = map.offsetAt(insertionStart)
  let result = new LspQueryRepair()

  result.text = host.stringSlice(document.text, 0, byte) + marker + host.stringSlice(document.text, byte, host.stringByteLength(document.text) - byte)
  result.insertionStart = insertionStart
  result.insertionLength = (new IrSourceMap(marker)).utf16Length()
  return result
end
