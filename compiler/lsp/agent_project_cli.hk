use console
use host

def agentProjectToolMain(name: String): Void
  var root = "."
  var operation = name
  var query = ""
  var index = 1

  while index < host.argumentCount()
    let argument = host.argumentAt(index)
    let value = host.argumentAt(index + 1)

    if argument == null || value == null || value == ""
      agentProjectToolUsage(name)
      return
    end
    if argument == "--project"
      root = value
    else if argument == "--operation"
      operation = value
    else if argument == "--query" && name == "describe"
      query = value
    else
      agentProjectToolUsage(name)
      return
    end
    index = index + 2
  end
  let tool = agentFindTool("neri." + name)
  let arguments = "{\"operationId\":" + lspQuote(operation) + (name == "describe" ? ",\"query\":" + lspQuote(query) : "") + "}"

  if tool == null
    agentProjectToolUsage(name)
    return
  end
  let request = tool.decode((new LspJsonParser(arguments)).parse())

  if request == null
    agentProjectToolUsage(name)
    return
  end
  let result = request.execute(new NeriAgentWorkspace(root, ""))

  console.println(result)
  let status = (new LspJsonParser(result)).parse().get("status").value

  if status != "valid"
    host.exit(status == "invalid" ? 1 : 2)
  end
end

def agentProjectToolUsage(name: String): Void
  console.println("Usage: neri " + name + " --project ROOT [--operation ID]" + (name == "describe" ? " --query SYMBOL" : ""))
  host.exit(2)
end
