use host

def agentTestArguments(project: String, compiler: String, work: String, declared: String[]): String[]
  var result: String[] = []

  for argument in declared
    var value = argument

    if argument == "{project}"
      value = project
    else if argument == "{compiler}"
      value = compiler
    else if argument == "{work}"
      value = work
    end
    result = host.appendString(result, value)
  end
  return result
end

def agentTestBuildSnapshot(graph: String, compiler: String, compilerDigest: String, unit: AgentProjectUnit): String
  var contents = runCacheFrame(graph) + runCacheFrame(compiler) + runCacheFrame(compilerDigest) + runCacheFrame(unit.key) + runCacheFrame(unit.fingerprint) + runCacheFrame(unit.project.testTimeoutMs as String)

  for argument in unit.project.testArguments
    contents = contents + runCacheFrame(argument)
  end
  return sha256FastText(contents)
end

def agentTestExecutable(path: String): String
  let operatingSystem = host.environment("OS")

  if operatingSystem != null && operatingSystem == "Windows_NT"
    return path + ".exe"
  end
  return path
end

def agentTestOutputSchema(): String
  let testResult = "{\"type\":\"object\",\"properties\":{\"projectKey\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"status\":{\"enum\":[\"valid\",\"invalid\",\"unavailable\"]},\"phase\":{\"enum\":[\"build\",\"run\"]},\"message\":{\"type\":\"string\"},\"buildSnapshot\":{\"type\":\"string\"},\"artifactDigest\":{\"type\":\"string\"},\"exitKind\":{\"type\":\"string\"},\"exitCode\":{\"type\":\"integer\"},\"stdout\":{\"type\":\"string\"},\"stderr\":{\"type\":\"string\"},\"stdoutTruncated\":{\"type\":\"boolean\"},\"stderrTruncated\":{\"type\":\"boolean\"},\"executed\":{\"type\":\"boolean\"}},\"required\":[\"projectKey\",\"name\",\"status\",\"phase\",\"message\",\"buildSnapshot\",\"artifactDigest\",\"exitKind\",\"exitCode\",\"stdout\",\"stderr\",\"stdoutTruncated\",\"stderrTruncated\",\"executed\"],\"additionalProperties\":false}"
  let effects = "{\"type\":\"object\",\"properties\":{\"applied\":{\"type\":\"boolean\"},\"analyzed\":{\"type\":\"boolean\"},\"persisted\":{\"type\":\"boolean\"},\"executed\":{\"type\":\"boolean\"}},\"required\":[\"applied\",\"analyzed\",\"persisted\",\"executed\"],\"additionalProperties\":false}"

  return "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"schemaVersion\":{\"type\":\"integer\",\"minimum\":1},\"operationId\":{\"type\":\"string\"},\"projectKey\":{\"type\":\"string\"},\"snapshot\":{\"type\":\"string\"},\"state\":{\"enum\":[\"complete\",\"noTests\",\"unavailable\",\"conflict\"]},\"status\":{\"enum\":[\"valid\",\"invalid\",\"unavailable\",\"conflict\"]},\"message\":{\"type\":\"string\"},\"complete\":{\"type\":\"boolean\"},\"noTests\":{\"type\":\"boolean\"},\"unitsTotal\":{\"type\":\"integer\",\"minimum\":0},\"testsTotal\":{\"type\":\"integer\",\"minimum\":0},\"tests\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/testResult\"}},\"effects\":{\"$ref\":\"#/$defs/effects\"}},\"required\":[\"schemaVersion\",\"operationId\",\"projectKey\",\"snapshot\",\"state\",\"status\",\"message\",\"complete\",\"noTests\",\"unitsTotal\",\"testsTotal\",\"tests\",\"effects\"],\"additionalProperties\":false,\"$defs\":{\"testResult\":" + testResult + ",\"effects\":" + effects + "}}"
end

def agentTestResponse(operationId: String, projectKey: String, snapshot: String, state: String, status: String, message: String, complete: Bool, noTests: Bool, unitsTotal: Int, testsTotal: Int, tests: String, executed: Bool): String
  return "{\"schemaVersion\":1,\"operationId\":" + lspQuote(operationId) + ",\"projectKey\":" + lspQuote(projectKey) + ",\"snapshot\":" + lspQuote(snapshot) + ",\"state\":" + lspQuote(state) + ",\"status\":" + lspQuote(status) + ",\"message\":" + lspQuote(message) + ",\"complete\":" + (complete ? "true" : "false") + ",\"noTests\":" + (noTests ? "true" : "false") + ",\"unitsTotal\":" + (unitsTotal as String) + ",\"testsTotal\":" + (testsTotal as String) + ",\"tests\":[" + tests + "],\"effects\":{\"applied\":false,\"analyzed\":false,\"persisted\":false,\"executed\":" + (executed ? "true" : "false") + "}}"
end
