# Syntax-only declaration templates run before project analysis. A null result
# delegates to semantic completion; an empty list is a handled position.
def lspDeclarationCompletionForTemplate(document: LspDocument, snippets: Bool, template: LspDeclarationTemplate, site: LspDeclarationSite): String?
  site.parser = new BootstrapParser((new BootstrapLexer(site.header)).lex())
  site.modifiers = site.parser.parseDeclarationModifiers()
  let parser = site.parser
  let abstractMethod = syntaxModifierIn(parser.arena, site.modifiers, parser.arena.modifiers.getAbstract()) >= 0
  let overriding = syntaxModifierIn(parser.arena, site.modifiers, parser.arena.modifiers.getOverride()) >= 0

  if overriding
    return null
  end
  let method = template.provider.isFunction()
  let classDeclaration = template.provider.isClass()

  if template.provider.isStatic()
    if site.modifiers.Length != 0 || parser.tokens.count() != 2
      return ""
    end
    let staticSnippet = new LspSnippet()

    lspTemplateAppend(staticSnippet, template.headerText)
    if template.body.isBlock() && !lspDeclarationBody(document, site, staticSnippet, false, template)
      return ""
    end
    if template.body.isNone() && !template.hasFinalStop
      staticSnippet.finalStop()
    end
    return lspDeclarationItem(document, site, template.label, template.detail, staticSnippet, snippets)
  end

  if (!method && !classDeclaration) || (classDeclaration && site.className != "") || (method && abstractMethod && !site.abstractClass)
    return ""
  end
  for modifier in site.modifiers
    let modifierKind = parser.arena.nodeAt(modifier).modifierKind

    if modifierKind == null || !semanticDeclarationModifierAllowed(modifierKind, classDeclaration ? parser.arena.kinds.getClass() : (site.className == "" ? parser.arena.kinds.getFunction() : parser.arena.kinds.getMethod()))
      return ""
    end
  end
  let snippet = new LspSnippet()
  let rendered = lspRenderTemplateHeader(template, site, snippet)

  if rendered.isDeferred()
    return null
  end
  if !rendered.isApplied()
    return ""
  end
  if !lspDeclarationBody(document, site, snippet, abstractMethod, template)
    return ""
  end
  snippet.finalStop() if abstractMethod
  return lspDeclarationItem(document, site, template.label, template.detail, snippet, snippets)
end

def lspDeclarationCompletion(document: LspDocument, position: Int, snippets: Bool, catalog: LspDeclarationCatalog): String?
  if catalog.error != ""
    return null
  end
  let site = lspDeclarationSite(document, position, false, catalog)

  if site == null
    return null
  end
  if syntaxModifierIn(site.parser.arena, site.modifiers, site.parser.arena.modifiers.getOverride()) >= 0
    return null
  end
  let keyword = site.parser.tokens.textAt(site.parser.currentIndex())
  let items = new StringBuffer()
  var deferred = false
  var template = catalog.first

  while template != null
    if template.context.matches(site.className != "") && (bootstrapStartsWith(template.prefix, keyword) || (!template.provider.isStatic() && bootstrapStartsWith(template.keywordText(), keyword)))
      let completion = lspDeclarationCompletionForTemplate(document, snippets, template, site)

      if completion == null
        deferred = true
      else if completion != ""
        items.add((items.size == 0 ? "" : ",") + completion)
      end
    end
    template = template.nextTemplate
  end
  if items.size == 0 && deferred
    return null
  end
  return "{\"isIncomplete\":true,\"items\":[" + items.join() + "]}"
end

def lspCompletionTriggerApplies(document: LspDocument, position: Int, context: LspJson, catalog: LspDeclarationCatalog? = null): Bool
  if context.get("triggerKind").scalarText() != "2"
    return true
  end
  let character = context.get("triggerCharacter").scalarText()

  if character != " " && character != ":" && character != ")"
    return true
  end
  if lspDeclarationSite(document, position, true, catalog) != null
    return true
  end
  let target = lspCompletionTarget(document.text, position)

  return target.kind == "import" || target.kind == "type"
end
