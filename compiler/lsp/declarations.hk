# Syntax-only declaration templates run before project analysis. A null result
# delegates to semantic completion; an empty list is a handled position.
def lspDeclarationCompletion(document: LspDocument, position: Int, snippets: Bool): String?
  let site = lspDeclarationSite(document, position)

  if site == null
    return null
  end
  let parser = site.parser
  let tokens = parser.tokens
  let keyword = tokens.textAt(parser.currentIndex())
  let keywordStart = tokens.startAt(parser.currentIndex())
  let modifiers = semanticCompletionUtf16Slice(site.header, 0, keywordStart)
  let abstractMethod = syntaxModifierIn(parser.arena, site.modifiers, "abstract") >= 0
  let overriding = syntaxModifierIn(parser.arena, site.modifiers, "override") >= 0

  if overriding
    return null
  end
  let method = bootstrapStartsWith("def", keyword)
  let classDeclaration = bootstrapStartsWith("class", keyword)

  if (!method && !classDeclaration) || (classDeclaration && site.className != "") || (method && abstractMethod && !site.abstractClass)
    return "[]"
  end
  for modifier in site.modifiers
    if !semanticDeclarationModifierAllowed(parser.arena.dataAt(modifier), classDeclaration ? "Class" : (site.className == "" ? "Function" : "Method"))
      return "[]"
    end
  end
  parser.next()
  let snippet = new LspSnippet()

  snippet.literal(modifiers + (method ? "def " : "class "))
  var name = ""

  if parser.currentKind() == "Identifier"
    name = tokens.textAt(parser.next())
    snippet.literal(name)
  else if parser.currentKind() == "EndOfFile"
    snippet.field(method ? "method" : "Name")
  else
    return "[]"
  end
  if !method
    let suffixStart = tokens.startAt(parser.currentIndex())

    parser.parseTypeParameters()
    if parser.accept("Colon")
      parser.parseTypeName()
    end
    if parser.diagnostics.count() != 0 || parser.currentKind() != "EndOfFile"
      return null
    end
    snippet.literal(semanticCompletionUtf16Slice(site.header, suffixStart, tokens.startAt(parser.currentIndex()) - suffixStart))
    if !lspDeclarationBody(document, site, snippet, false)
      return "[]"
    end
    return "{\"isIncomplete\":true,\"items\":[" + lspDeclarationItem(document, site, "class", "Declare a class", snippet, snippets) + "]}"
  end
  if parser.currentKind() == "EndOfFile"
    snippet.literal("(")
    snippet.field("")
    snippet.literal("): ")
    snippet.field("Void")
  else
    let suffixStart = tokens.startAt(parser.currentIndex())

    parser.parseTypeParameters()
    parser.expect("LParen")
    let emptyParameters = parser.currentKind() == "EndOfFile"

    if !emptyParameters
      parser.parseParameters()
    end
    let missingParen = parser.currentKind() == "EndOfFile"

    if missingParen && !emptyParameters
      return null
    end
    if !missingParen
      parser.expect("RParen")
    end
    if parser.diagnostics.count() != 0
      return null
    end
    let suffixEnd = tokens.startAt(parser.currentIndex())

    snippet.literal(semanticCompletionUtf16Slice(site.header, suffixStart, suffixEnd - suffixStart))
    snippet.field("") if emptyParameters
    snippet.literal(")") if missingParen
    if parser.currentKind() == "EndOfFile"
      snippet.literal(": ")
      snippet.field("Void")
    else
      # Type annotations use semantic candidates; Enter already completes a
      # finished signature's body without replacing its explicitly written type.
      return null
    end
  end
  if !lspDeclarationBody(document, site, snippet, abstractMethod)
    return "[]"
  end
  return "{\"isIncomplete\":true,\"items\":[" + lspDeclarationItem(document, site, "def", name == "" ? "Declare a method" : "Complete " + name, snippet, snippets) + "]}"
end

def lspCompletionTriggerApplies(document: LspDocument, position: Int, context: LspJson): Bool
  if context.get("triggerKind").value != "2"
    return true
  end
  let character = context.get("triggerCharacter").value

  if character != " " && character != ":" && character != ")"
    return true
  end
  if lspDeclarationSite(document, position, true) != null
    return true
  end
  let target = lspCompletionTarget(document.text, position)

  return target.kind == "import" || target.kind == "type"
end
