use host

class AgentStagedDocument
  public original: LspDocument
  public originalText: String
  public originalVersion: Int
  public staged: LspDocument = new LspDocument()
  public edits: AgentPreparedEdit?
  public next: AgentStagedDocument?

  def init(document: LspDocument): Void
    this.original = document
    this.originalText = document.text
    this.originalVersion = document.version
    this.staged.uri = document.uri
    this.staged.sourcePath = document.sourcePath
    this.staged.text = document.text
    this.staged.version = document.version + 1
    this.staged.publishDiagnostics = false
  end

  def add(range: AgentRange, text: String): String
    let first = agentBytePosition(this.originalText, range.start())
    let last = agentBytePosition(this.originalText, range.finish())

    if first < 0 || last < first
      return "Edit range must lie on UTF-16 scalar boundaries inside the original buffer."
    end
    var previous: AgentPreparedEdit? = null
    var current = this.edits

    while current != null
      if first < current.last && last > current.first || first == current.first
        return "Edits to the same buffer must not overlap or share an insertion position."
      end
      if current.first > first
        break
      end
      previous = current
      current = current.next
    end
    let prepared = new AgentPreparedEdit(first, last, text, range)

    prepared.next = current
    if previous == null
      this.edits = prepared
    else
      previous.next = prepared
    end
    return ""
  end

  def prepare(): Void
    let parts = new StringBuffer()
    var offset = 0
    var edit = this.edits

    while edit != null
      parts.add(host::stringSlice(this.originalText, offset, edit.first - offset))
      parts.add(edit.text)
      offset = edit.last
      edit = edit.next
    end
    parts.add(host::stringSlice(this.originalText, offset, host::stringByteLength(this.originalText) - offset))
    this.staged.text = parts.join()
  end
end
