use host

class LspMessageReader
  private input: LspInput
  private closed: Bool = false
  private readingBody: Bool = false
  private headerBytes: Int = 0
  private line: String = ""
  private length: Int = -1
  private received: Int = 0
  private bytes: Byte[] = []
  private parts: StringBuffer = new StringBuffer()
  private continuation: Int = 0

  def init(input: LspInput): Void
    this.input = input
  end

  readonly def isClosed(): Bool
    return this.closed
  end

  readonly def hasPendingFrame(): Bool
    return !this.closed && this.headerBytes > 0
  end

  # Return control even when a peer continuously supplies a large frame.
  def poll(): String?
    var count = 0

    while !this.closed && count < 16384
      let byte = this.input.tryReadByte()

      if byte == -2
        return null
      end
      if byte < 0
        this.finish()
        return null
      end
      let body = this.feedByte(byte as Byte)

      if body != null
        return body
      end
      count = count + 1
    end
    return null
  end

  def readMessage(): String?
    while !this.closed
      let byte = this.input.readByte()

      if byte < 0
        this.finish()
        return null
      end
      let body = this.feedByte(byte as Byte)

      if body != null
        return body
      end
    end
    return null
  end

  def finish(): Void
    this.closed = true
    this.bytes = []
    this.parts = new StringBuffer()
    this.line = ""
  end

  def feedByte(value: Byte): String?
    if this.closed
      return null
    end
    let byte = value as Int

    if !this.readingBody
      this.headerBytes = this.headerBytes + 1
      if byte > 127 || this.headerBytes > 8192
        this.finish()
        return null
      end
      if byte != 10
        this.line = this.line + lspCharacter(byte >= 65 && byte <= 90 ? byte + 32 : byte)
        return null
      end
      if this.line == "\r"
        if this.length < 0
          this.finish()
          return null
        end
        this.readingBody = true
        this.line = ""
        return this.complete() if this.length == 0
        return null
      end
      if !semanticEndsWith(this.line, "\r")
        this.finish()
        return null
      end
      if bootstrapStartsWith(this.line, "content-length:")
        if this.length >= 0
          this.finish()
          return null
        end
        var index = 15

        while index < host::stringByteLength(this.line) && (host::stringByteAt(this.line, index) == (32 as Byte) || host::stringByteAt(this.line, index) == (9 as Byte))
          index = index + 1
        end
        let length = host::parseInt(host::stringSlice(this.line, index, host::stringByteLength(this.line) - index - 1))

        if length == null || length < 0 || length > 2097152
          this.finish()
          return null
        end
        this.length = length
      end
      this.line = ""
      return null
    end
    if this.continuation > 0
      if byte < 128 || byte > 191
        this.finish()
        return null
      end
      this.continuation = this.continuation - 1
    else if byte >= 128
      if byte < 194 || byte > 244
        this.finish()
        return null
      end
      this.continuation = utf8Width(byte) - 1
    end
    this.bytes = host::appendByte(this.bytes, value)
    this.received = this.received + 1
    if (this.bytes.Length >= 256 && this.continuation == 0) || this.received == this.length
      let part = host::stringFromBytes(this.bytes)

      if part == null
        this.finish()
        return null
      end
      this.parts.add(part)
      this.bytes = []
    end
    if this.received == this.length
      return this.complete()
    end
    return null
  end

  private def complete(): String
    let result = this.parts.join()

    this.readingBody = false
    this.headerBytes = 0
    this.length = -1
    this.received = 0
    this.continuation = 0
    this.parts = new StringBuffer()
    return result
  end
end
