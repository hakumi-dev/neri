class LspSemanticIndex
  public projectKey: String = ""
  public projectRevision: Int = 0
  public first: LspSemanticQueryEntry?
  public last: LspSemanticQueryEntry?
  private entries: StringTable<LspSemanticQueryEntry> = new StringTable<LspSemanticQueryEntry>()

  # A caller replaces the whole project generation after any source or project
  # change. This prevents queries from mixing models from different versions.
  def begin(projectKey: String, projectRevision: Int): Void
    if this.projectKey == projectKey && this.projectRevision == projectRevision
      return
    end
    this.projectKey = projectKey
    this.projectRevision = projectRevision
    this.first = null
    this.last = null
    this.entries = new StringTable<LspSemanticQueryEntry>()
  end

  def contains(identity: String, snapshot: LspSemanticSnapshot, start: Int, length: Int, declaration: Bool): Bool
    let sourceKey = lspSnapshotSourceKey(snapshot, start)
    let sourceOffset = lspSnapshotSourceOffset(snapshot, start)

    return this.entries.find(lspQueryEntryKey(identity, sourceKey, sourceOffset, length, declaration)) != null
  end

  def add(identity: String, name: String, kind: Int, snapshot: LspSemanticSnapshot, start: Int, length: Int, declaration: Bool): Void
    if identity == "" || length <= 0
      return
    end
    let sourceKey = lspSnapshotSourceKey(snapshot, start)
    let sourceOffset = lspSnapshotSourceOffset(snapshot, start)
    let key = lspQueryEntryKey(identity, sourceKey, sourceOffset, length, declaration)

    if this.entries.find(key) != null
      return
    end
    let entry = new LspSemanticQueryEntry()

    entry.identity = identity
    entry.name = name
    entry.kind = kind
    entry.start = start
    entry.sourceOffset = sourceOffset
    entry.length = length
    entry.declaration = declaration
    entry.snapshot = snapshot
    entry.snapshotKey = lspSnapshotKey(snapshot)
    entry.sourceKey = sourceKey
    this.entries.add(key, entry)
    let tail = this.last

    if tail == null
      this.first = entry
    else
      tail.next = entry
    end
    this.last = entry
  end

  def addSnapshot(snapshot: LspSemanticSnapshot): Void
    if snapshot.projectKey != this.projectKey || snapshot.projectRevision != this.projectRevision
      return
    end
    let semantic = snapshot.semantic

    if semantic == null
      return
    end
    var declaration = semantic.declarations

    while declaration != null
      let kind = lspSourceSymbolKind(semantic, declaration)

      if kind != 0 && !lspSourceSymbolIsGenerated(declaration.identity)
        this.add(lspQueryCanonicalIdentity(snapshot, declaration.identity), declaration.name, kind, snapshot, declaration.start, declaration.length, true)
      end
      declaration = declaration.next
    end
    var occurrence = semantic.occurrences

    while occurrence != null
      this.add(lspQueryCanonicalIdentity(snapshot, occurrence.identity), "", 0, snapshot, occurrence.start, occurrence.length, false)
      occurrence = occurrence.next
    end
    var node = semantic.bound.first.nextNode

    while node != null
      if (node.kind.isName() || node.kind.isAssignment()) && node.typeName != "Error" && node.symbol != ""
        this.add(lspQueryCanonicalIdentity(snapshot, node.symbol), "", 0, snapshot, node.start, node.length, false)
      end
      node = node.nextNode
    end
  end
end
