use result
use host


def lspTypeSchema(type: String): json::Json
  return json::Json.object().put("type", json::Json.string(type))
end

def lspReferenceSchema(name: String, object: Bool = false): json::Json
  let schema = json::Json.object().put("$ref", json::Json.string("#/$defs/" + name))

  if object
    schema.put("type", json::Json.string("object"))
  end
  return schema
end

def lspArraySchema(items: json::Json): json::Json
  return lspTypeSchema("array").put("items", items)
end

def lspObjectSchema(fields: LspSchemaProperty[]): json::Json
  let properties = json::Json.object()
  let required = json::Json.array()

  for field in fields
    properties.put(field.name, field.schema)
    if field.required
      required.add(json::Json.string(field.name))
    end
  end
  let schema = lspTypeSchema("object")

  schema.put("properties", properties)
  schema.put("required", required)
  schema.put("additionalProperties", json::Json.boolean(false))
  return schema
end

def lspSchemaText(schema: json::Json): String
  match schema.stringify()
    case result::Result.Ok(text)
      return text
    case result::Result.Error(failure)
      let message = runCacheBytes("Cannot serialize compiler JSON schema: " + failure.code + "\n")

      unsafe
        borrow message as pointer
          runCacheWrite(pointer, message.Length - 1)
        end
      end
      host::exit(2)
      return ""
  end
end
