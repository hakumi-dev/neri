# Convert LSP UTF-16 positions to UTF-8 byte offsets. Never split a surrogate
# pair or CRLF. Columns beyond a line clamp to its end, as required by LSP.
def lspByteOffset(source: String, position: LspJson): Int
  let lineValue = position.get("line")
  let characterValue = position.get("character")
  let line = host.parseInt(lineValue.value)
  let character = host.parseInt(characterValue.value)

  if position.kind != "object" || lineValue.kind != "number" || characterValue.kind != "number" || line == null || character == null || line < 0 || character < 0
    return -1
  end
  var offset = 0
  var currentLine = 0
  let length = host.stringByteLength(source)

  while offset < length && currentLine < line
    let byte = host.stringByteAt(source, offset) as Int

    offset = offset + 1
    if byte == 13
      if offset < length && (host.stringByteAt(source, offset) as Int) == 10
        offset = offset + 1
      end
      currentLine = currentLine + 1
    else if byte == 10
      currentLine = currentLine + 1
    end
  end
  if currentLine != line
    return -1
  end
  var column = 0

  while offset < length && column < character
    let byte = host.stringByteAt(source, offset) as Int

    if byte == 13 || byte == 10
      return offset
    end
    let width = utf16Width(codePointAt(source, offset))

    if column + width > character
      return -1
    end
    column = column + width
    offset = offset + utf8Width(byte)
  end
  return offset
end

def lspApplyChanges(source: String, changes: LspJson): LspJson
  let result = new LspJson()

  if changes.kind != "array" || changes.first == null
    return result
  end
  var current = source
  var change = changes.first

  while change != null
    let text = change.get("text")

    if text.kind != "string"
      return result
    end
    let range = change.get("range")

    if range.kind == "missing"
      current = text.value
    else
      let start = lspByteOffset(current, range.get("start"))
      let finish = lspByteOffset(current, range.get("end"))

      if range.kind != "object" || start < 0 || finish < start
        return result
      end
      current = host.stringSlice(current, 0, start) + text.value + host.stringSlice(current, finish, host.stringByteLength(current) - finish)
    end
    change = change.next
  end
  result.kind = "string"
  result.value = current
  return result
end
