sealed class LspTemplateProvider
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def classDeclaration(): LspTemplateProvider
    return new LspTemplateProvider(0)
  end

  readonly def isClass(): Bool
    return this.tag == 0
  end

  static def functionDeclaration(): LspTemplateProvider
    return new LspTemplateProvider(1)
  end

  readonly def isFunction(): Bool
    return this.tag == 1
  end

  static def staticDeclaration(): LspTemplateProvider
    return new LspTemplateProvider(2)
  end

  readonly def isStatic(): Bool
    return this.tag == 2
  end

  static def fromName(name: String): LspTemplateProvider?
    if name == "classDeclaration"
      return LspTemplateProvider.classDeclaration()
    end
    if name == "functionDeclaration"
      return LspTemplateProvider.functionDeclaration()
    end
    if name == "staticDeclaration"
      return LspTemplateProvider.staticDeclaration()
    end
    return null
  end
end
