# Small JSON tree for the editor protocol; no editor or semantic rules live here.
class LspJson
  public kind: String = "missing"
  public value: String = ""
  public key: String = ""
  public first: LspJson?
  public last: LspJson?
  public next: LspJson?
  # Byte locations are retained for strict configuration diagnostics. Protocol
  # consumers may ignore them.
  public start: Int = 0
  public finish: Int = 0
  public keyStart: Int = 0

  def add(node: LspJson): Void
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
  end

  def get(key: String): LspJson
    var child = this.first

    while child != null
      if child.key == key
        return child
      end
      child = child.next
    end
    return new LspJson()
  end
end
