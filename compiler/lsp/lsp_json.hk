# Small JSON tree for the editor protocol; no editor or semantic rules live here.
class LspJson
  private content: LspJsonValue
  public key: String = ""
  public first: LspJson?
  public last: LspJson?
  public next: LspJson?
  # Byte locations are retained for strict configuration diagnostics. Protocol
  # consumers may ignore them.
  public start: Int = 0
  public finish: Int = 0
  public keyStart: Int = 0

  def init(content: LspJsonValue = LspJsonValue.Missing(), start: Int = 0): Void
    this.content = content
    this.start = start
  end

  def scalarText(): String
    match this.content
      case LspJsonValue.Missing()
        return ""
      case LspJsonValue.Null()
        return ""
      case LspJsonValue.Boolean(value)
        return ""
      case LspJsonValue.String(value)
        return value
      case LspJsonValue.Number(lexeme)
        return lexeme
      case LspJsonValue.Object()
        return ""
      case LspJsonValue.Array()
        return ""
    end
  end

  def replace(content: LspJsonValue): Void
    this.content = content
    this.first = null
    this.last = null
  end


  def isMissing(): Bool
    match this.content
      case LspJsonValue.Missing()
        return true
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isNull(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return true
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isBoolean(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return true
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isString(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return true
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isNumber(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return true
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isObject(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return true
      case LspJsonValue.Array()
        return false
    end
  end

  def isArray(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return false
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return true
    end
  end


  def matches(kind: LspJsonType): Bool
    match kind
      case LspJsonType.Null()
        return this.isNull()
      case LspJsonType.Boolean()
        return this.isBoolean()
      case LspJsonType.String()
        return this.isString()
      case LspJsonType.Number()
        return this.isNumber()
      case LspJsonType.Object()
        return this.isObject()
      case LspJsonType.Array()
        return this.isArray()
    end
  end


  def isTrue(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return value
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end

  def isFalse(): Bool
    match this.content
      case LspJsonValue.Missing()
        return false
      case LspJsonValue.Null()
        return false
      case LspJsonValue.Boolean(value)
        return !value
      case LspJsonValue.String(value)
        return false
      case LspJsonValue.Number(lexeme)
        return false
      case LspJsonValue.Object()
        return false
      case LspJsonValue.Array()
        return false
    end
  end


  def stringValue(): String?
    match this.content
      case LspJsonValue.Missing()
        return null
      case LspJsonValue.Null()
        return null
      case LspJsonValue.Boolean(value)
        return null
      case LspJsonValue.String(value)
        return value
      case LspJsonValue.Number(lexeme)
        return null
      case LspJsonValue.Object()
        return null
      case LspJsonValue.Array()
        return null
    end
  end

  def numberLexeme(): String?
    match this.content
      case LspJsonValue.Missing()
        return null
      case LspJsonValue.Null()
        return null
      case LspJsonValue.Boolean(value)
        return null
      case LspJsonValue.String(value)
        return null
      case LspJsonValue.Number(lexeme)
        return lexeme
      case LspJsonValue.Object()
        return null
      case LspJsonValue.Array()
        return null
    end
  end

  def add(node: LspJson): Void
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
  end

  def get(key: String): LspJson
    var child = this.first

    while child != null
      if child.key == key
        return child
      end
      child = child.next
    end
    return new LspJson()
  end
end
