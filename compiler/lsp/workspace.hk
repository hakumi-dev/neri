# Workspace search retains compact symbol locations, rather than keeping every
# closed unit's compiler model alive. Analysis and file access belong here in
# the LSP adapter; semantic queries remain independent of the protocol.
class LspWorkspaceSymbol
  public name: String = ""
  public kind: Int = 0
  public location: String = ""
  public next: LspWorkspaceSymbol?
end

def lspWorkspaceCollect(first: LspWorkspaceSymbol?, document: LspDocument): LspWorkspaceSymbol?
  var result = first
  var symbol = lspIndexWorkspaceSymbols(lspNavigationIndex(document), "")

  while symbol != null
    let location = symbol.location

    if location != null
      let json = lspQueryLocationJson(location)
      var seen = json == "null"
      var existing = result

      while existing != null
        if existing.location == json && existing.name == symbol.name && existing.kind == symbol.kind
          seen = true
          break
        end
        existing = existing.next
      end
      if !seen
        let item = new LspWorkspaceSymbol()

        item.name = symbol.name
        item.kind = symbol.kind
        item.location = json
        item.next = result
        result = item
      end
    end
    symbol = symbol.next
  end
  return result
end

def lspWorkspaceUnit(server: LspServer, project: NeriProject, seen: StringBuffer, first: LspWorkspaceSymbol?): LspWorkspaceSymbol?
  if project.error() != "" || project.ownSources.size == 0
    return first
  end
  let path = project.ownSources.get(0)
  let key = neriUnitSourceOwner(project, path)

  if key == null || neriProjectListed(seen, key)
    return first
  end
  seen.add(key)
  var opened = server.documents

  while opened != null
    if opened.projectKey == key
      return lspWorkspaceCollect(first, opened)
    end
    opened = opened.next
  end
  let text = host.readText(path)

  if text == null
    return first
  end
  let document = new LspDocument()

  document.uri = lspUri(path)
  document.text = text
  document.version = -1
  document.publishDiagnostics = false
  server.analyze(document)
  return lspWorkspaceCollect(first, document)
end

def lspWorkspaceProject(server: LspServer, root: String, seen: StringBuffer, first: LspWorkspaceSymbol?): LspWorkspaceSymbol?
  var result = first
  let project = neriLoadProject(root, server.selectedUnit(root))

  if project.error() != ""
    return result
  end
  if project.implicit
    return lspWorkspaceUnit(server, project, seen, result)
  end
  let text = host.readText(project.manifest)

  if text == null
    return result
  end
  let parser = new LspJsonParser(text)
  let config = parser.parse()
  var unit = config.get("units").first

  while unit != null
    result = lspWorkspaceUnit(server, neriLoadProject(project.manifest, unit.key), seen, result)
    unit = unit.next
  end
  return result
end

def lspWorkspaceSymbols(server: LspServer, query: String): String
  if !server.workspaceSymbolsReady
    let seen = new StringBuffer()
    let roots = new StringBuffer()
    var symbols: LspWorkspaceSymbol? = null

    if server.rootPath != ""
      roots.add(server.rootPath)
    end
    var document = server.documents

    while document != null
      server.ensureAnalyzed(document)
      symbols = lspWorkspaceCollect(symbols, document)
      seen.add(document.projectKey)
      let path = lspPath(document.uri)

      if path != null
        let root = server.nearestProjectRoot(path)

        if root != "" && !neriProjectListed(roots, root)
          roots.add(root)
        end
      end
      document = document.next
    end
    var root = roots.first.nextNode

    while root != null
      symbols = lspWorkspaceProject(server, root.value, seen, symbols)
      root = root.nextNode
    end
    server.workspaceSymbols = symbols
    server.workspaceSymbolsReady = true
  end
  let parts = new StringBuffer()
  var symbol = server.workspaceSymbols

  while symbol != null
    if lspIndexNameMatches(symbol.name, query)
      if parts.size > 0
        parts.add(",")
      end
      parts.add("{\"name\":" + lspQuote(symbol.name) + ",\"kind\":" + (symbol.kind as String) + ",\"location\":" + symbol.location + "}")
    end
    symbol = symbol.next
  end
  return "[" + lspJoin(parts, 0, parts.size) + "]"
end
