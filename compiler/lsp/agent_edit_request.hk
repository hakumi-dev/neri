class AgentEditRequest: AgentToolRequest
  private storedOperation: String
  private storedRevision: Int
  private storedSnapshot: String
  private storedEdits: AgentTextEdit?
  private storedPreview: Bool
  private storedCursor: String

  def init(
    operation: String,
    revision: Int,
    snapshot: String,
    edits: AgentTextEdit?,
    preview: Bool = false,
    cursor: String = ""
  ): Void
    this.storedOperation = operation
    this.storedRevision = revision
    this.storedSnapshot = snapshot
    this.storedEdits = edits
    this.storedPreview = preview
    this.storedCursor = cursor
  end

  def operationId(): String
    return this.storedOperation
  end

  def execute(workspace: NeriAgentWorkspace): String
    if this.storedCursor != ""
      if this.storedRevision != workspace.revision
        return (new AgentEditTransaction()).response(
          this.storedOperation,
          "conflict",
          "Workspace revision changed before transaction pagination.",
          workspace.revision,
          this.storedSnapshot
        )
      end
      return workspace.transactionPage(this.storedOperation, this.storedSnapshot, this.storedCursor)
    end
    return (new AgentEditTransaction()).run(
      workspace,
      this.storedOperation,
      this.storedEdits,
      this.storedRevision,
      this.storedSnapshot,
      this.storedPreview,
      workspace.operationControl
    )
  end
end
