class AgentFeedbackTool: AgentToolDescriptor
  def init(): Void
    super("neri.feedback", "Analyze all project units and referenced libraries on disk in their own type contexts. Reports coverage, affected consumers and diagnostics with a project snapshot.", [new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes()))])
  end

  def outputSchema(): String
    return agentProjectFeedbackSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let request: AgentToolRequest = new AgentFeedbackRequest(arguments.get("operationId").scalarText())

    return request
  end
end
