class AgentFeedbackTool: AgentToolDescriptor
  def init(): Void
    super("neri.feedback", "Analyze the selected unit's current files on disk, including its dependencies. Independent of unsaved overlays; returns current diagnostics after external edits.", [new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes()))])
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let request: AgentToolRequest = new AgentFeedbackRequest(arguments.get("operationId").value)

    return request
  end
end
