class AgentFeedbackTool: AgentToolDescriptor
  def init(): Void
    super(
      "neri.feedback",
      "Analyze project units on disk with persistent snapshot validation. Retrieve actionable diagnostics with nextCursor; counts and coverage describe the full analysis.",
      [
        new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes())),
        new AgentInputField("expectedSnapshot", new AgentStringInput(64, 64), false),
        new AgentInputField("cursor", new AgentStringInput(1, 1048576), false),
        new AgentInputField("pageSize", new AgentIntegerInput(1, 128), false)
      ]
    )
  end

  def outputSchema(): String
    return agentProjectFeedbackSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let parsed = agentInputInteger(arguments.get("pageSize"))
    let size = parsed != null ? parsed : 128
    let request: AgentToolRequest = new AgentFeedbackRequest(
      arguments.get("operationId").scalarText(),
      arguments.get("expectedSnapshot").scalarText(),
      arguments.get("cursor").scalarText(),
      size
    )

    return request
  end
end
