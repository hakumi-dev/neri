class LspQueryRepair
  public text: String = ""
  public insertionStart: Int = -1
  public insertionLength: Int = 0

  def originalOffset(repairedOffset: Int): Int
    if repairedOffset >= this.insertionStart + this.insertionLength
      return repairedOffset - this.insertionLength
    end
    if repairedOffset > this.insertionStart
      return this.insertionStart
    end
    return repairedOffset
  end

  def repairedOffset(originalOffset: Int): Int
    return originalOffset > this.insertionStart ? originalOffset + this.insertionLength : originalOffset
  end
end
