# Validated declaration templates. Template syntax is compiled at catalog load;
# completion never reparses catalog strings.
sealed class LspTemplatePart
  private kind: Int
  private contents: String
  public nextPart: LspTemplatePart?

  private def init(kind: Int, value: String): Void
    this.kind = kind
    this.contents = value
  end

  static def literal(value: String): LspTemplatePart
    return new LspTemplatePart(0, value)
  end

  static def field(value: String): LspTemplatePart
    return new LspTemplatePart(1, value)
  end

  static def finalStop(): LspTemplatePart
    return new LspTemplatePart(2, "")
  end

  readonly def text(): String
    return this.contents
  end

  readonly def isLiteral(): Bool
    return this.kind == 0
  end

  readonly def isField(): Bool
    return this.kind == 1
  end

  def isFinalStop(): Bool
    return this.kind == 2
  end
end
