def agentProjectFeedbackSchema(): String
  let legacy = (new LspJsonParser(agentOutputSchema())).parse()
  let definitions = lspJsonStringify(legacy.get("$defs"))
  let string = "{\"type\":\"string\"}"
  let integer = "{\"type\":\"integer\",\"minimum\":0}"
  let boolean = "{\"type\":\"boolean\"}"
  let strings = "{\"type\":\"array\",\"items\":" + string + "}"
  let unit = "{\"type\":\"object\",\"properties\":{\"projectKey\":" + string + ",\"name\":" + string + ",\"fingerprint\":" + string + ",\"status\":" + string + ",\"message\":" + string + ",\"reused\":" + boolean + ",\"diagnosticCount\":" + integer + ",\"diagnosticsTruncated\":" + boolean + ",\"diagnostics\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/diagnostic\"}}},\"required\":[\"projectKey\",\"name\",\"fingerprint\",\"status\",\"message\",\"reused\",\"diagnosticCount\",\"diagnosticsTruncated\",\"diagnostics\"],\"additionalProperties\":false}"

  return "{\"type\":\"object\",\"properties\":{\"schemaVersion\":" + integer + ",\"operationId\":" + string + ",\"scope\":" + string + ",\"projectKey\":" + string + ",\"snapshot\":" + string + ",\"status\":" + string + ",\"message\":" + string + ",\"complete\":" + boolean + ",\"unitsTotal\":" + integer + ",\"unitsAnalyzed\":" + integer + ",\"unitsReused\":" + integer + ",\"diagnosticCount\":" + integer + ",\"diagnosticsTruncated\":" + boolean + ",\"invalidatedUnits\":" + strings + ",\"removedUnits\":" + strings + ",\"units\":{\"type\":\"array\",\"items\":" + unit + "}},\"required\":[\"schemaVersion\",\"operationId\",\"scope\",\"projectKey\",\"snapshot\",\"status\",\"message\",\"complete\",\"unitsTotal\",\"unitsAnalyzed\",\"unitsReused\",\"diagnosticCount\",\"diagnosticsTruncated\",\"invalidatedUnits\",\"removedUnits\",\"units\"],\"additionalProperties\":false,\"$defs\":" + definitions + "}"
end
