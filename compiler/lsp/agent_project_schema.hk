use arrays

def agentProjectExecutionSchema(): json::Json
  let string = lspTypeSchema("string")

  return lspObjectSchema([
      new LspSchemaProperty("mode", string),
      new LspSchemaProperty("cause", string)
    ])
end

# Internal reports contain every unit; delivered responses add paging metadata.
def agentProjectReportSchema(delivery: Bool = false): json::Json
  let string = lspTypeSchema("string")
  let integer = lspTypeSchema("integer").put("minimum", json::Json.integer(0))
  let boolean = lspTypeSchema("boolean")
  let strings = lspArraySchema(string)
  let unit = lspObjectSchema([
      new LspSchemaProperty("projectKey", string),
      new LspSchemaProperty("name", string),
      new LspSchemaProperty("fingerprint", string),
      new LspSchemaProperty("status", string),
      new LspSchemaProperty("message", string),
      new LspSchemaProperty("reused", boolean),
      new LspSchemaProperty("diagnosticCount", integer),
      new LspSchemaProperty("diagnosticsTruncated", boolean),
      new LspSchemaProperty("diagnostics", lspArraySchema(lspReferenceSchema("diagnostic")))
    ])
  let fields = [
    new LspSchemaProperty("schemaVersion", integer),
    new LspSchemaProperty("operationId", string),
    new LspSchemaProperty("scope", string),
    new LspSchemaProperty("projectKey", string),
    new LspSchemaProperty("snapshot", string),
    new LspSchemaProperty("status", string),
    new LspSchemaProperty("message", string),
    new LspSchemaProperty("complete", boolean),
    new LspSchemaProperty("unitsTotal", integer),
    new LspSchemaProperty("unitsAnalyzed", integer),
    new LspSchemaProperty("unitsReused", integer),
    new LspSchemaProperty("diagnosticCount", integer),
    new LspSchemaProperty("diagnosticsTruncated", boolean),
    new LspSchemaProperty("invalidatedUnits", strings),
    new LspSchemaProperty("removedUnits", strings),
    new LspSchemaProperty("units", lspArraySchema(unit))
  ]
  let delivered: LspSchemaProperty[] = delivery ? [
    new LspSchemaProperty("nextCursor", string),
    new LspSchemaProperty("pageFailure", string, false),
    new LspSchemaProperty("execution", agentProjectExecutionSchema()),
    new LspSchemaProperty("requestId", string, false)
  ] : []
  let combined = arrays::generate<LspSchemaProperty>(fields.Length + delivered.Length) do |index|
    return index < fields.Length ? fields[index] : delivered[index - fields.Length]
  end

  return lspObjectSchema(combined)
end

def agentProjectFeedbackSchema(): String
  let string = lspTypeSchema("string")
  let schema = agentProjectReportSchema(true)

  let failureStatus = lspTypeSchema("string").put("enum", json::Json.array([
        json::Json.string("conflict"),
        json::Json.string("unavailable")
      ]))
  let failure = lspObjectSchema([
      new LspSchemaProperty("operationId", string, false),
      new LspSchemaProperty("status", failureStatus),
      new LspSchemaProperty("complete", lspTypeSchema("boolean").put("const", json::Json.boolean(false))),
      new LspSchemaProperty("message", string),
      new LspSchemaProperty("execution", agentProjectExecutionSchema(), false),
      new LspSchemaProperty("requestId", string, false)
    ])
  let output = lspTypeSchema("object").put("oneOf", json::Json.array([schema, failure]))

  output.put("$defs", agentOutputDefinitions())
  return lspSchemaText(output)
end
