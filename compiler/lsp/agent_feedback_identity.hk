use host

def agentFeedbackGraph(root: String, retained: AgentProjectGraph?): AgentProjectGraph
  if retained == null
    return new AgentProjectGraph(root)
  end
  return retained
end

# A worker inherits its creator's environment; every analysis input therefore
# participates in endpoint identity before another client can reuse it.
def agentFeedbackIdentity(): String?
  let compiler = agentCompilerIdentity()

  if compiler == null
    return null
  end
  var framed = runCacheFrame(compiler)
  let helper = neriProjectHost()

  if helper == null
    return null
  end
  let helperPath = neriCanonicalPath(helper)
  let helperDigest = agentArtifactDigest(helper)

  if helperPath == null || helperDigest == null
    return null
  end
  framed = framed + runCacheFrame(helperPath) + runCacheFrame(helperDigest)

  for name in ["NERI_HOST", "NERI_RUNTIME_MANIFEST", "NERI_CODEGEN", "NERI_STDLIB"]
    let configured = host::environment(name)

    framed = framed + runCacheFrame(name)
    if configured == null
      framed = framed + runCacheFrame("absent")
    else
      let canonical = neriCanonicalPath(configured)

      if canonical == null
        return null
      end
      let artifact = name == "NERI_STDLIB" ? canonical + "/manifest.json" : canonical
      let digest = agentArtifactDigest(artifact)

      if digest == null
        return null
      end
      framed = framed + runCacheFrame(configured) + runCacheFrame(canonical) + runCacheFrame(digest)
    end
  end
  return sha256FastText(framed)
end
