# Identity-to-LSP mapping for declarations deliberately recorded by the binder.
# This module never reconstructs declarations from source text.

def lspSourceSymbolKind(semantic: SemanticModel, identity: String): Int
  if bootstrapStartsWith(identity, "type:")
    return 5 # Class
  end
  if bootstrapStartsWith(identity, "record:")
    return 23 # Struct; LSP has no native-union kind.
  end
  if bootstrapStartsWith(identity, "field:") || bootstrapStartsWith(identity, "record-field:")
    return 8 # Field
  end
  if bootstrapStartsWith(identity, "callable:")
    let fullName = host.stringSlice(identity, 9, host.stringByteLength(identity) - 9)
    var classSymbol = semantic.firstClass
    while classSymbol != null
      var method = classSymbol.firstMethod
      while method != null
        if method.fullName == fullName
          return 6 # Method
        end
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
    # A generic function template is not a SemanticCallable until specialized,
    # but its binder-recorded declaration is still a module Function.
    return 12 # Function
  end
  if bootstrapFindText(identity, "/parameter") >= 0 || bootstrapFindText(identity, "/local@") >= 0
    return 13 # Variable
  end
  return 0
end

def lspSourceSymbolIsGenerated(identity: String): Bool
  # Generic specializations clone the original SyntaxNode, so their ranges are
  # source-backed but they are not source declarations. Their semantic keys
  # necessarily contain a canonical type-argument list; source identifiers do
  # not permit '<'. The template itself uses its unspecialized identity.
  return bootstrapFindText(identity, "<") >= 0
end
