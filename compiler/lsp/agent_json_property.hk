use json
use result

def agentJsonProperty(output: json::Json, name: String, text: String): Bool
  match json::Json.parse(text)
    case result::Result.Ok(value)
      output.put(name, new json::Json(value))
      return true
    case result::Result.Error(problem)
      return false
  end
end

def agentPositionJson(position: AgentPosition): json::Json
  let value = json::Json.object()

  value.put("line", json::Json.integer(position.line()))
  value.put("character", json::Json.integer(position.character()))
  return value
end

def agentRangeJson(range: AgentRange): json::Json
  let value = json::Json.object()

  value.put("start", agentPositionJson(range.start()))
  value.put("end", agentPositionJson(range.finish()))
  return value
end
