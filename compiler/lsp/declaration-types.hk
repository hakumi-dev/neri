# Type annotation candidates use the current model and scoped type parameters.
def lspSignatureTypeCompletion(document: LspDocument, position: Int): String?
  let site = lspDeclarationSite(document, position, true)

  if site == null || !site.parser.currentKind().isDef()
    return null
  end
  let tokens = site.parser.tokens
  var last = tokens.count() - 2
  var prefix = ""
  var start = position
  var namespacePrefix = ""

  if tokens.kindAt(last).isIdentifier()
    prefix = tokens.textAt(last)
    start = site.start + tokens.startAt(last)
    last = last - 1
  end
  while last >= 1 && tokens.kindAt(last).isDoubleColon() && tokens.kindAt(last - 1).isIdentifier()
    let part = tokens.textAt(last - 1)

    namespacePrefix = namespacePrefix == "" ? part : part + "." + namespacePrefix
    last = last - 2
  end
  if last < 0 || !tokens.kindAt(last).isColon()
    return null
  end
  var depth = 0
  var index = site.parser.currentIndex()

  while index < last
    depth = depth + 1 if tokens.kindAt(index).isLParen()
    depth = depth - 1 if tokens.kindAt(index).isRParen()
    index = index + 1
  end
  let allowVoid = depth == 0
  let parameters = new StringBuffer()
  let header = site.parser

  header.next()
  header.expect(header.tokens.kinds.getIdentifier())
  let generic = header.parseTypeParameters()

  if header.diagnostics.count() != 0
    return null
  end
  for name in generic.names
    parameters.add(name)
  end
  let model = lspAnalyzeQueryText(document, lspDeclarationContextText(site))

  if model == null
    return "[]"
  end
  let syntax = model.syntax

  if syntax != null && site.className != ""
    index = 0
    while index < model.genericTemplates.size
      let node = model.genericTemplates.get(index)
      let declaration = syntax.declarationAt(node)

      if syntax.kindAt(node).isClass() && declaration != null && semanticQualifiedName(declaration.namespaceName, declaration.name) == site.className
        for name in syntax.nodeAt(node).typeParameters
          parameters.add(name)
        end
      end
      index = index + 1
    end
  end
  let context = new SemanticCompletionSite()

  context.namespaceName = site.namespaceName
  context.className = site.className
  context.receiverType = model.resolveQualifiedName(namespacePrefix)
  let candidates = semanticCompletionAnnotationTypes(model, context, prefix, allowVoid, parameters)
  let items = new StringBuffer()
  let target = lspCompletionTarget(document.text, position)
  let finish = target.start == start ? start + target.length : position
  let range = "{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, finish) + "}"
  var candidate = candidates.first

  while candidate != null
    items.add((items.size == 0 ? "" : ",") + "{\"label\":" + lspQuote(candidate.name) + ",\"kind\":" + (candidate.kind as String) + ",\"detail\":" + lspQuote(candidate.detail) + ",\"textEdit\":{\"range\":" + range + ",\"newText\":" + lspQuote(candidate.insertText) + "}}")
    candidate = candidate.next
  end
  return "{\"isIncomplete\":" + (candidates.truncated ? "true" : "false") + ",\"items\":[" + items.join() + "]}"
end
