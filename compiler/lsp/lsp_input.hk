use console
use host

class LspInput
  private bytes: Byte[] = []
  private position: Int = 0
  private available: Int = 0

  def init(): Void
    while this.bytes.Length < 256
      this.bytes = host::appendByte(this.bytes, 0 as Byte)
    end
  end

  def readByte(): Int
    if this.position == this.available
      let buffer = this.bytes
      var count = 0

      unsafe
        borrow buffer as pointer
          count = lspRead(0, pointer, buffer.Length)
          while count == -2
            count = lspRead(0, pointer, buffer.Length)
          end
        end
      end
      if count <= 0
        return -1
      end
      this.position = 0
      this.available = count
    end
    let value = this.bytes[this.position] as Int

    this.position = this.position + 1
    return value
  end

  def waitReadable(milliseconds: Int): Bool
    if this.position < this.available
      return true
    end
    unsafe
      # Errors and EOF go through readByte, which terminates the input loop.
      return lspWaitReadable(0, milliseconds) != 0
    end
  end

  def tryReadByte(): Int
    if this.position == this.available
      var ready = 0

      unsafe
        ready = lspWaitReadable(0, 0)
      end
      if ready == 0 || ready == -2
        return -2
      end
      if ready < 0
        return -1
      end
      let buffer = this.bytes
      var count = 0

      unsafe
        borrow buffer as pointer
          count = lspRead(0, pointer, buffer.Length)
        end
      end
      if count == -2
        return -2
      end
      if count <= 0
        return -1
      end
      this.position = 0
      this.available = count
    end
    let value = this.bytes[this.position] as Int

    this.position = this.position + 1
    return value
  end
end
