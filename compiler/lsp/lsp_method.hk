enum LspMethod
  case Unknown()
  case Exit()
  case Initialize()
  case Shutdown()
  case WorkspaceSymbol()
  case OnTypeFormatting()
  case Formatting()
  case CodeAction()
  case PrepareRename()
  case Rename()
  case DocumentSymbol()
  case ResolveCompletion()
  case Hover()
  case Definition()
  case SourceOrigin()
  case TypeDefinition()
  case References()
  case DocumentHighlight()
  case Completion()
  case SignatureHelp()
  case WatchedFiles()
  case Close()
  case Open()
  case Change()
  case CancelRequest()
end

def lspDecodeMethod(name: String): LspMethod
  if name == "exit"
    return LspMethod.Exit()
  end
  if name == "initialize"
    return LspMethod.Initialize()
  end
  if name == "shutdown"
    return LspMethod.Shutdown()
  end
  if name == "workspace/symbol"
    return LspMethod.WorkspaceSymbol()
  end
  if name == "textDocument/onTypeFormatting"
    return LspMethod.OnTypeFormatting()
  end
  if name == "textDocument/formatting"
    return LspMethod.Formatting()
  end
  if name == "textDocument/codeAction"
    return LspMethod.CodeAction()
  end
  if name == "textDocument/prepareRename"
    return LspMethod.PrepareRename()
  end
  if name == "textDocument/rename"
    return LspMethod.Rename()
  end
  if name == "textDocument/documentSymbol"
    return LspMethod.DocumentSymbol()
  end
  if name == "completionItem/resolve"
    return LspMethod.ResolveCompletion()
  end
  if name == "textDocument/hover"
    return LspMethod.Hover()
  end
  if name == "textDocument/definition"
    return LspMethod.Definition()
  end
  if name == "neri/sourceOrigin"
    return LspMethod.SourceOrigin()
  end
  if name == "textDocument/typeDefinition"
    return LspMethod.TypeDefinition()
  end
  if name == "textDocument/references"
    return LspMethod.References()
  end
  if name == "textDocument/documentHighlight"
    return LspMethod.DocumentHighlight()
  end
  if name == "textDocument/completion"
    return LspMethod.Completion()
  end
  if name == "textDocument/signatureHelp"
    return LspMethod.SignatureHelp()
  end
  if name == "workspace/didChangeWatchedFiles"
    return LspMethod.WatchedFiles()
  end
  if name == "textDocument/didClose"
    return LspMethod.Close()
  end
  if name == "textDocument/didOpen"
    return LspMethod.Open()
  end
  if name == "textDocument/didChange"
    return LspMethod.Change()
  end
  if name == "$/cancelRequest"
    return LspMethod.CancelRequest()
  end
  return LspMethod.Unknown()
end

def lspMethodAcceptsInactiveSession(method: LspMethod): Bool
  match method
    case LspMethod.Unknown()
      return false
    case LspMethod.Exit()
      return true
    case LspMethod.Initialize()
      return true
    case LspMethod.Shutdown()
      return false
    case LspMethod.WorkspaceSymbol()
      return false
    case LspMethod.OnTypeFormatting()
      return false
    case LspMethod.Formatting()
      return false
    case LspMethod.CodeAction()
      return false
    case LspMethod.PrepareRename()
      return false
    case LspMethod.Rename()
      return false
    case LspMethod.DocumentSymbol()
      return false
    case LspMethod.ResolveCompletion()
      return false
    case LspMethod.Hover()
      return false
    case LspMethod.Definition()
      return false
    case LspMethod.SourceOrigin()
      return false
    case LspMethod.TypeDefinition()
      return false
    case LspMethod.References()
      return false
    case LspMethod.DocumentHighlight()
      return false
    case LspMethod.Completion()
      return false
    case LspMethod.SignatureHelp()
      return false
    case LspMethod.WatchedFiles()
      return false
    case LspMethod.Close()
      return false
    case LspMethod.Open()
      return false
    case LspMethod.Change()
      return false
    case LspMethod.CancelRequest()
      return false
  end
end
