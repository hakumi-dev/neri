sealed class LspMethod
  private tag: Int
  private def init(tag: Int): Void
    this.tag = tag
  end
  static def decode(name: String): LspMethod
    if name == "exit"
      return new LspMethod(1)
    end
    if name == "initialize"
      return new LspMethod(2)
    end
    if name == "shutdown"
      return new LspMethod(3)
    end
    if name == "workspace/symbol"
      return new LspMethod(4)
    end
    if name == "textDocument/onTypeFormatting"
      return new LspMethod(5)
    end
    if name == "textDocument/formatting"
      return new LspMethod(6)
    end
    if name == "textDocument/codeAction"
      return new LspMethod(7)
    end
    if name == "textDocument/prepareRename"
      return new LspMethod(8)
    end
    if name == "textDocument/rename"
      return new LspMethod(9)
    end
    if name == "textDocument/documentSymbol"
      return new LspMethod(10)
    end
    if name == "completionItem/resolve"
      return new LspMethod(11)
    end
    if name == "textDocument/hover"
      return new LspMethod(12)
    end
    if name == "textDocument/definition"
      return new LspMethod(13)
    end
    if name == "neri/sourceOrigin"
      return new LspMethod(14)
    end
    if name == "textDocument/typeDefinition"
      return new LspMethod(15)
    end
    if name == "textDocument/references"
      return new LspMethod(16)
    end
    if name == "textDocument/documentHighlight"
      return new LspMethod(17)
    end
    if name == "textDocument/completion"
      return new LspMethod(18)
    end
    if name == "textDocument/signatureHelp"
      return new LspMethod(19)
    end
    if name == "workspace/didChangeWatchedFiles"
      return new LspMethod(20)
    end
    if name == "textDocument/didClose"
      return new LspMethod(21)
    end
    if name == "textDocument/didOpen"
      return new LspMethod(22)
    end
    if name == "textDocument/didChange"
      return new LspMethod(23)
    end
    return new LspMethod(0)
  end
  readonly def isExit(): Bool
    return this.tag == 1
  end
  readonly def isInitialize(): Bool
    return this.tag == 2
  end
  readonly def isShutdown(): Bool
    return this.tag == 3
  end
  readonly def isWorkspaceSymbol(): Bool
    return this.tag == 4
  end
  readonly def isOnTypeFormatting(): Bool
    return this.tag == 5
  end
  readonly def isFormatting(): Bool
    return this.tag == 6
  end
  readonly def isCodeAction(): Bool
    return this.tag == 7
  end
  readonly def isPrepareRename(): Bool
    return this.tag == 8
  end
  readonly def isRename(): Bool
    return this.tag == 9
  end
  readonly def isDocumentSymbol(): Bool
    return this.tag == 10
  end
  readonly def isResolveCompletion(): Bool
    return this.tag == 11
  end
  readonly def isHover(): Bool
    return this.tag == 12
  end
  readonly def isDefinition(): Bool
    return this.tag == 13
  end
  readonly def isSourceOrigin(): Bool
    return this.tag == 14
  end
  readonly def isTypeDefinition(): Bool
    return this.tag == 15
  end
  readonly def isReferences(): Bool
    return this.tag == 16
  end
  readonly def isDocumentHighlight(): Bool
    return this.tag == 17
  end
  readonly def isCompletion(): Bool
    return this.tag == 18
  end
  readonly def isSignatureHelp(): Bool
    return this.tag == 19
  end
  readonly def isWatchedFiles(): Bool
    return this.tag == 20
  end
  readonly def isClose(): Bool
    return this.tag == 21
  end
  readonly def isOpen(): Bool
    return this.tag == 22
  end
  readonly def isChange(): Bool
    return this.tag == 23
  end
end

