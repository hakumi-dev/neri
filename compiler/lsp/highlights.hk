# Highlight only occurrences belonging to this document, never dependencies.
def lspAddHighlight(parts: StringBuffer, document: LspDocument, limit: Int, start: Int, length: Int): Void
  if start < 0 || length <= 0 || start + length > limit
    return
  end
  lspAddLocation(parts, "{\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + length) + "},\"kind\":1}")
end

def lspHighlights(document: LspDocument, position: Int): String
  let semantic = document.semantic
  if semantic == null
    return "[]"
  end
  let identity = lspSymbolAt(semantic, position)
  if identity == ""
    return "[]"
  end
  let highlights = new StringBuffer()
  let limit = (new IrSourceMap(document.text)).utf16Length()
  var declaration = semantic.declarations
  while declaration != null
    if declaration.identity == identity
      lspAddHighlight(highlights, document, limit, declaration.start, declaration.length)
    end
    declaration = declaration.next
  end
  var node = semantic.bound.first.nextNode
  while node != null
    if (node.kind == "Name" || node.kind == "Assignment") && node.symbol == identity
      lspAddHighlight(highlights, document, limit, node.start, node.length)
    end
    node = node.nextNode
  end
  var occurrence = semantic.occurrences
  while occurrence != null
    if occurrence.identity == identity
      lspAddHighlight(highlights, document, limit, occurrence.start, occurrence.length)
    end
    occurrence = occurrence.next
  end
  let parts = new StringBuffer()
  var highlight = highlights.first.nextNode
  while highlight != null
    if parts.size > 0
      parts.add(",")
    end
    parts.add(highlight.value)
    highlight = highlight.nextNode
  end
  return "[" + lspJoin(parts, 0, parts.size) + "]"
end
