use host

class AgentLimits
  def messageBytes(): Int
    return 2097152
  end

  def operationIdBytes(): Int
    return 256
  end

  def uriBytes(): Int
    return 4096
  end

  def documentBytes(): Int
    return 1048576
  end

  def bufferDocuments(): Int
    return 64
  end

  def bufferBytes(): Int
    return 8388608
  end

  def analysisPaths(): Int
    return 1024
  end

  def analysisBytes(): Int
    return 16777216
  end

  def diagnosticCount(): Int
    return 128
  end

  def diagnosticBytes(): Int
    return 65534
  end

  def excerptPrefixBytes(): Int
    return 1024
  end

  def excerptBytes(): Int
    return 4096
  end
end

class AgentStringInput: AgentInputType
  private minimumBytes: Int
  private maximumBytes: Int

  def init(minimumBytes: Int, maximumBytes: Int): Void
    this.minimumBytes = minimumBytes
    this.maximumBytes = maximumBytes
  end

  def schema(): String
    return "{\"type\":\"string\"}"
  end

  def valid(value: LspJson): Bool
    if value.kind != "string"
      return false
    end
    let length = host.stringByteLength(value.value)

    return length >= this.minimumBytes && length <= this.maximumBytes
  end
end

class AgentIntegerInput: AgentInputType
  private minimum: Int

  def init(minimum: Int): Void
    this.minimum = minimum
  end

  def schema(): String
    return "{\"type\":\"integer\",\"minimum\":" + (this.minimum as String) + "}"
  end

  def valid(value: LspJson): Bool
    let parsed = agentInputInteger(value)

    return parsed != null && parsed >= this.minimum
  end
end

class AgentObjectInput: AgentInputType
  private fields: AgentInputField[]

  def init(fields: AgentInputField[]): Void
    this.fields = fields
  end

  def schema(): String
    return agentInputObjectSchema(this.fields)
  end

  def valid(value: LspJson): Bool
    return agentInputObjectValid(value, this.fields)
  end
end

class AgentInputField
  private storedName: String
  private storedType: AgentInputType
  private isRequired: Bool

  def init(name: String, type: AgentInputType, required: Bool = true): Void
    this.storedName = name
    this.storedType = type
    this.isRequired = required
  end

  def name(): String
    return this.storedName
  end

  def required(): Bool
    return this.isRequired
  end

  def schema(): String
    return this.storedType.schema()
  end

  def valid(value: LspJson): Bool
    return this.storedType.valid(value)
  end
end

def agentInputInteger(value: LspJson): Int?
  if value.kind != "number"
    return null
  end
  return host.parseInt(value.value)
end

def agentInputField(fields: AgentInputField[], name: String): AgentInputField?
  for field in fields
    if field.name() == name
      return field
    end
  end
  return null
end

def agentInputObjectValid(value: LspJson, fields: AgentInputField[]): Bool
  if value.kind != "object"
    return false
  end
  var child = value.first

  while child != null
    let field = agentInputField(fields, child.key)

    if field == null || !field.valid(child)
      return false
    end
    var duplicate = child.next

    while duplicate != null
      if duplicate.key == child.key
        return false
      end
      duplicate = duplicate.next
    end
    child = child.next
  end
  for field in fields
    if field.required() && value.get(field.name()).kind == "missing"
      return false
    end
  end
  return true
end

def agentInputObjectSchema(fields: AgentInputField[]): String
  var properties = ""
  var required = ""
  var propertySeparator = ""
  var requiredSeparator = ""

  for field in fields
    properties = properties + propertySeparator + lspQuote(field.name()) + ":" + field.schema()
    propertySeparator = ","
    if field.required()
      required = required + requiredSeparator + lspQuote(field.name())
      requiredSeparator = ","
    end
  end
  return "{\"type\":\"object\",\"properties\":{" + properties + "},\"required\":[" + required + "],\"additionalProperties\":false}"
end

class AgentPosition
  private storedLine: Int
  private storedCharacter: Int

  def init(line: Int, character: Int): Void
    this.storedLine = line
    this.storedCharacter = character
  end

  def line(): Int
    return this.storedLine
  end

  def character(): Int
    return this.storedCharacter
  end
end

class AgentRange
  private storedStart: AgentPosition
  private storedFinish: AgentPosition

  def init(start: AgentPosition, finish: AgentPosition): Void
    this.storedStart = start
    this.storedFinish = finish
  end

  def start(): AgentPosition
    return this.storedStart
  end

  def finish(): AgentPosition
    return this.storedFinish
  end
end

class AgentOpenRequest: AgentToolRequest
  private storedOperationId: String
  private storedUri: String
  private storedText: String?

  def init(operationId: String, uri: String, text: String?): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedText = text
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def text(): String?
    return this.storedText
  end

  def expectedRevision(): Int?
    return null
  end

  def requiresOpenBuffer(): Bool
    return false
  end

  def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
    return workspace.applyOpen(this, target)
  end

  def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext
    return new AgentToolContext()
  end
end

class AgentInspectRequest: AgentToolRequest
  private storedOperationId: String
  private storedUri: String
  private storedExpectedRevision: Int
  private storedPosition: AgentPosition

  def init(operationId: String, uri: String, expectedRevision: Int, position: AgentPosition): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedExpectedRevision = expectedRevision
    this.storedPosition = position
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def expectedRevision(): Int?
    return this.storedExpectedRevision
  end

  def position(): AgentPosition
    return this.storedPosition
  end

  def requiresOpenBuffer(): Bool
    return true
  end

  def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
    return new AgentToolExecution()
  end

  def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext
    return workspace.inspectContext(this, document)
  end
end

class AgentEditRequest: AgentToolRequest
  private storedOperationId: String
  private storedUri: String
  private storedExpectedRevision: Int
  private storedRange: AgentRange
  private storedText: String

  def init(operationId: String, uri: String, expectedRevision: Int, range: AgentRange, text: String): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedExpectedRevision = expectedRevision
    this.storedRange = range
    this.storedText = text
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def expectedRevision(): Int?
    return this.storedExpectedRevision
  end

  def range(): AgentRange
    return this.storedRange
  end

  def text(): String
    return this.storedText
  end

  def requiresOpenBuffer(): Bool
    return true
  end

  def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
    return workspace.applyEdit(this, target)
  end

  def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext
    return new AgentToolContext()
  end
end

def agentDecodedPosition(value: LspJson): AgentPosition?
  let line = agentInputInteger(value.get("line"))
  let character = agentInputInteger(value.get("character"))

  if line == null || character == null
    return null
  end
  return new AgentPosition(line, character)
end

def agentBaseFields(): AgentInputField[]
  let limits = new AgentLimits()

  return [new AgentInputField("operationId", new AgentStringInput(1, limits.operationIdBytes())), new AgentInputField("uri", new AgentStringInput(1, limits.uriBytes()))]
end

def agentPointFields(): AgentInputField[]
  return [new AgentInputField("line", new AgentIntegerInput(0)), new AgentInputField("character", new AgentIntegerInput(0))]
end

def agentOpenFields(): AgentInputField[]
  let limits = new AgentLimits()
  let fields = agentBaseFields()

  return [fields[0], fields[1], new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()), false)]
end

def agentInspectFields(): AgentInputField[]
  let fields = agentBaseFields()

  return [fields[0], fields[1], new AgentInputField("expectedRevision", new AgentIntegerInput(0)), new AgentInputField("position", new AgentObjectInput(agentPointFields()))]
end

def agentEditFields(): AgentInputField[]
  let limits = new AgentLimits()
  let fields = agentBaseFields()
  let range = [new AgentInputField("start", new AgentObjectInput(agentPointFields())), new AgentInputField("end", new AgentObjectInput(agentPointFields()))]

  return [fields[0], fields[1], new AgentInputField("expectedRevision", new AgentIntegerInput(0)), new AgentInputField("range", new AgentObjectInput(range)), new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()))]
end

class AgentOpenTool: AgentToolDescriptor
  def init(): Void
    super("neri.open", "Open one project source in an in-memory overlay; does not replace an already open buffer.", agentOpenFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let text = arguments.get("text")
    var proposed: String? = null

    if text.kind == "string"
      proposed = text.value
    end
    let request: AgentToolRequest = new AgentOpenRequest(arguments.get("operationId").value, arguments.get("uri").value, proposed)

    return request
  end
end

class AgentInspectTool: AgentToolDescriptor
  def init(): Void
    super("neri.inspect", "Inspect the source at a UTF-16 position using the expected workspace revision; returns bounded context and diagnostics.", agentInspectFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let expected = agentInputInteger(arguments.get("expectedRevision"))
    let position = agentDecodedPosition(arguments.get("position"))

    if expected == null || position == null
      return null
    end
    let request: AgentToolRequest = new AgentInspectRequest(arguments.get("operationId").value, arguments.get("uri").value, expected, position)

    return request
  end
end

class AgentEditTool: AgentToolDescriptor
  def init(): Void
    super("neri.edit", "Apply one atomic UTF-16 edit to an in-memory project buffer using the expected workspace revision; does not execute code or persist files.", agentEditFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let expected = agentInputInteger(arguments.get("expectedRevision"))
    let range = arguments.get("range")
    let start = agentDecodedPosition(range.get("start"))
    let finish = agentDecodedPosition(range.get("end"))

    if expected == null || start == null || finish == null
      return null
    end
    let request: AgentToolRequest = new AgentEditRequest(arguments.get("operationId").value, arguments.get("uri").value, expected, new AgentRange(start, finish), arguments.get("text").value)

    return request
  end
end

def agentTools(): AgentToolDescriptor
  let open: AgentToolDescriptor = new AgentOpenTool()
  let inspect: AgentToolDescriptor = new AgentInspectTool()
  let edit: AgentToolDescriptor = new AgentEditTool()

  open.link(inspect)
  inspect.link(edit)
  return open
end

def agentFindTool(name: String): AgentToolDescriptor?
  var tool: AgentToolDescriptor? = agentTools()

  while tool != null
    if tool.name() == name
      return tool
    end
    tool = tool.next()
  end
  return null
end
