use host

def agentInputInteger(value: LspJson): Int?
  let lexeme = value.numberLexeme()

  if lexeme == null
    return null
  end
  return host::parseInt(lexeme)
end

def agentInputField(fields: AgentInputField[], name: String): AgentInputField?
  for field in fields
    if field.name() == name
      return field
    end
  end
  return null
end

def agentInputObjectValid(value: LspJson, fields: AgentInputField[]): Bool
  if !value.isObject()
    return false
  end
  var child = value.first

  while child != null
    let field = agentInputField(fields, child.key)

    if field == null || !field.valid(child)
      return false
    end
    if lspJsonDuplicateKey(value, child)
      return false
    end
    child = child.next
  end
  for field in fields
    if field.required() && value.get(field.name()).isMissing()
      return false
    end
  end
  return true
end

def agentInputObjectSchema(fields: AgentInputField[]): json::Json
  let properties = arrays::generate<LspSchemaProperty>(fields.Length) do |index|
    let field = fields[index]

    return new LspSchemaProperty(field.name(), field.schema(), field.required())
  end

  return lspObjectSchema(properties)
end

def agentDecodedPosition(value: LspJson): AgentPosition?
  let line = agentInputInteger(value.get("line"))
  let character = agentInputInteger(value.get("character"))

  if line == null || character == null
    return null
  end
  return new AgentPosition(line, character)
end

def agentBaseFields(): AgentInputField[]
  let limits = new AgentLimits()

  return [
    new AgentInputField("operationId", new AgentStringInput(1, limits.operationIdBytes())),
    new AgentInputField("uri", new AgentStringInput(1, limits.uriBytes()))
  ]
end

def agentPointFields(): AgentInputField[]
  return [
    new AgentInputField("line", new AgentIntegerInput(0)),
    new AgentInputField("character", new AgentIntegerInput(0))
  ]
end

def agentOpenFields(): AgentInputField[]
  let limits = new AgentLimits()
  let fields = agentBaseFields()

  return [fields[0], fields[1], new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()), false)]
end

def agentInspectFields(): AgentInputField[]
  let fields = agentBaseFields()

  return [
    fields[0],
    fields[1],
    new AgentInputField("expectedRevision", new AgentIntegerInput(0)),
    new AgentInputField("position", new AgentObjectInput(agentPointFields()))
  ]
end


def agentTools(): AgentToolDescriptor
  let open: AgentToolDescriptor = new AgentOpenTool()
  let inspect: AgentToolDescriptor = new AgentInspectTool()
  let edit: AgentToolDescriptor = new AgentEditTool()
  let feedback: AgentToolDescriptor = new AgentFeedbackTool()
  let describe: AgentToolDescriptor = new AgentDescribeTool()
  let test: AgentToolDescriptor = new AgentTestTool()
  let profile: AgentToolDescriptor = new AgentProfileTool()

  open.link(inspect)
  inspect.link(edit)
  edit.link(feedback)
  feedback.link(describe)
  describe.link(test)
  test.link(profile)
  return open
end

def agentFindTool(name: String): AgentToolDescriptor?
  var tool: AgentToolDescriptor? = agentTools()

  while tool != null
    if tool.name() == name
      return tool
    end
    tool = tool.next()
  end
  return null
end

def agentEditRangeFields(): AgentInputField[]
  return [
    new AgentInputField("start", new AgentObjectInput(agentPointFields())),
    new AgentInputField("end", new AgentObjectInput(agentPointFields()))
  ]
end

def agentEditItemFields(required: Bool = true): AgentInputField[]
  let limits = new AgentLimits()

  return [
    new AgentInputField("uri", new AgentStringInput(1, limits.uriBytes()), required),
    new AgentInputField("range", new AgentObjectInput(agentEditRangeFields()), required),
    new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()), required)
  ]
end

def agentEditCommonFields(): AgentInputField[]
  return [
    new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes())),
    new AgentInputField("expectedRevision", new AgentIntegerInput(0)),
    new AgentInputField("expectedSnapshot", new AgentStringInput(64, 64))
  ]
end

def agentEditVariantFields(mode: String): AgentInputField[]
  let common = agentEditCommonFields()
  let item = agentEditItemFields()
  let preview = new AgentInputField("preview", new AgentBooleanInput(), false)

  if mode == "page"
    return [common[0], common[1], common[2], new AgentInputField("cursor", new AgentStringInput(1, 16384))]
  end
  if mode == "batch"
    return [
      common[0],
      common[1],
      common[2],
      preview,
      new AgentInputField("edits", new AgentArrayInput(new AgentObjectInput(item), 1, 256))
    ]
  end
  return [common[0], common[1], common[2], preview, item[0], item[1], item[2]]
end

def agentEditFields(): AgentInputField[]
  let common = agentEditCommonFields()
  let item = agentEditItemFields(false)

  return [
    common[0], common[1], common[2], item[0], item[1], item[2],
    new AgentInputField("preview", new AgentBooleanInput(), false),
    new AgentInputField("edits", new AgentArrayInput(new AgentObjectInput(agentEditItemFields()), 1, 256), false),
    new AgentInputField("cursor", new AgentStringInput(1, 16384), false)
  ]
end

def agentDecodedEdit(value: LspJson): AgentTextEdit?
  let range = value.get("range")
  let start = agentDecodedPosition(range.get("start"))
  let finish = agentDecodedPosition(range.get("end"))

  if start == null || finish == null
    return null
  end
  return new AgentTextEdit(value.get("uri").scalarText(), new AgentRange(start, finish), value.get("text").scalarText())
end

def agentEditOutputSchema(): String
  let string = lspTypeSchema("string")
  let integer = lspTypeSchema("integer")
  let diagnostics = lspArraySchema(lspReferenceSchema("diagnostic"))
  let difference = lspObjectSchema([
      new LspSchemaProperty("range", lspReferenceSchema("range")),
      new LspSchemaProperty("oldText", string),
      new LspSchemaProperty("newText", string)
    ])
  let change = lspObjectSchema([
      new LspSchemaProperty("uri", string),
      new LspSchemaProperty("beforeVersion", integer),
      new LspSchemaProperty("afterVersion", integer),
      new LspSchemaProperty("edits", lspArraySchema(difference))
    ])
  let consumer = lspObjectSchema([
      new LspSchemaProperty("projectKey", string),
      new LspSchemaProperty("analysisStatus", string),
      new LspSchemaProperty("diagnosticCount", integer),
      new LspSchemaProperty("diagnosticsTruncated", lspTypeSchema("boolean")),
      new LspSchemaProperty("pageMessage", string),
      new LspSchemaProperty("nextCursor", string),
      new LspSchemaProperty("diagnostics", diagnostics)
    ])
  let schema = lspObjectSchema([

      new LspSchemaProperty("schemaVersion", lspTypeSchema("integer")),
      new LspSchemaProperty("operationId", lspTypeSchema("string")),
      new LspSchemaProperty("status", lspTypeSchema("string")),
      new LspSchemaProperty("message", lspTypeSchema("string"), false),
      new LspSchemaProperty("revision", lspTypeSchema("integer")),
      new LspSchemaProperty("snapshot", lspTypeSchema("string")),
      new LspSchemaProperty("proposedSnapshot", lspTypeSchema("string"), false),
      new LspSchemaProperty("proposalId", lspTypeSchema("string"), false),
      new LspSchemaProperty("requestDigest", lspTypeSchema("string"), false),
      new LspSchemaProperty("applied", lspTypeSchema("boolean")),
      new LspSchemaProperty("persisted", lspTypeSchema("boolean")),
      new LspSchemaProperty("changes", lspArraySchema(change), false),
      new LspSchemaProperty("consumers", lspArraySchema(consumer), false),
      new LspSchemaProperty("projectKey", lspTypeSchema("string"), false),
      new LspSchemaProperty("analysisStatus", lspTypeSchema("string"), false),
      new LspSchemaProperty("diagnosticCount", lspTypeSchema("integer"), false),
      new LspSchemaProperty("emittedCount", lspTypeSchema("integer"), false),
      new LspSchemaProperty("diagnostics", diagnostics, false),
      new LspSchemaProperty("nextCursor", lspTypeSchema("string"), false)
    ])

  schema.put("$defs", agentOutputDefinitions())
  return lspSchemaText(schema)
end
