use host

def agentInputInteger(value: LspJson): Int?
  if value.kind != "number"
    return null
  end
  return host.parseInt(value.value)
end

def agentInputField(fields: AgentInputField[], name: String): AgentInputField?
  for field in fields
    if field.name() == name
      return field
    end
  end
  return null
end

def agentInputObjectValid(value: LspJson, fields: AgentInputField[]): Bool
  if value.kind != "object"
    return false
  end
  var child = value.first

  while child != null
    let field = agentInputField(fields, child.key)

    if field == null || !field.valid(child)
      return false
    end
    var duplicate = child.next

    while duplicate != null
      if duplicate.key == child.key
        return false
      end
      duplicate = duplicate.next
    end
    child = child.next
  end
  for field in fields
    if field.required() && value.get(field.name()).kind == "missing"
      return false
    end
  end
  return true
end

def agentInputObjectSchema(fields: AgentInputField[]): String
  var properties = ""
  var required = ""
  var propertySeparator = ""
  var requiredSeparator = ""

  for field in fields
    properties = properties + propertySeparator + lspQuote(field.name()) + ":" + field.schema()
    propertySeparator = ","
    if field.required()
      required = required + requiredSeparator + lspQuote(field.name())
      requiredSeparator = ","
    end
  end
  return "{\"type\":\"object\",\"properties\":{" + properties + "},\"required\":[" + required + "],\"additionalProperties\":false}"
end

def agentDecodedPosition(value: LspJson): AgentPosition?
  let line = agentInputInteger(value.get("line"))
  let character = agentInputInteger(value.get("character"))

  if line == null || character == null
    return null
  end
  return new AgentPosition(line, character)
end

def agentBaseFields(): AgentInputField[]
  let limits = new AgentLimits()

  return [new AgentInputField("operationId", new AgentStringInput(1, limits.operationIdBytes())), new AgentInputField("uri", new AgentStringInput(1, limits.uriBytes()))]
end

def agentPointFields(): AgentInputField[]
  return [new AgentInputField("line", new AgentIntegerInput(0)), new AgentInputField("character", new AgentIntegerInput(0))]
end

def agentOpenFields(): AgentInputField[]
  let limits = new AgentLimits()
  let fields = agentBaseFields()

  return [fields[0], fields[1], new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()), false)]
end

def agentInspectFields(): AgentInputField[]
  let fields = agentBaseFields()

  return [fields[0], fields[1], new AgentInputField("expectedRevision", new AgentIntegerInput(0)), new AgentInputField("position", new AgentObjectInput(agentPointFields()))]
end

def agentEditFields(): AgentInputField[]
  let limits = new AgentLimits()
  let fields = agentBaseFields()
  let range = [new AgentInputField("start", new AgentObjectInput(agentPointFields())), new AgentInputField("end", new AgentObjectInput(agentPointFields()))]

  return [fields[0], fields[1], new AgentInputField("expectedRevision", new AgentIntegerInput(0)), new AgentInputField("range", new AgentObjectInput(range)), new AgentInputField("text", new AgentStringInput(0, limits.documentBytes()))]
end

def agentTools(): AgentToolDescriptor
  let open: AgentToolDescriptor = new AgentOpenTool()
  let inspect: AgentToolDescriptor = new AgentInspectTool()
  let edit: AgentToolDescriptor = new AgentEditTool()
  let feedback: AgentToolDescriptor = new AgentFeedbackTool()

  open.link(inspect)
  inspect.link(edit)
  edit.link(feedback)
  return open
end

def agentFindTool(name: String): AgentToolDescriptor?
  var tool: AgentToolDescriptor? = agentTools()

  while tool != null
    if tool.name() == name
      return tool
    end
    tool = tool.next()
  end
  return null
end
