sealed class LspLifecycle
  private tag: Int
  private def init(tag: Int): Void
    this.tag = tag
  end
  static def awaitingInitialization(): LspLifecycle
    return new LspLifecycle(0)
  end
  static def active(): LspLifecycle
    return new LspLifecycle(1)
  end
  static def stopped(): LspLifecycle
    return new LspLifecycle(2)
  end
  readonly def isAwaitingInitialization(): Bool
    return this.tag == 0
  end
  readonly def isActive(): Bool
    return this.tag == 1
  end
  readonly def isStopped(): Bool
    return this.tag == 2
  end
end

