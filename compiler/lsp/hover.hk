# Query the version's bound model, never names collected by text matching.
def lspHover(document: LspDocument, position: Int, documentationEnabled: Bool = true, markdown: Bool = false): String
  let semantic = document.semantic
  if semantic == null
    return "null"
  end
  let identity = lspSymbolAt(semantic, position)
  var occurrence = semantic.occurrences
  var occurrenceStart = -1
  var occurrenceLength = 0
  var occurrenceDisplay = ""
  while occurrence != null
    if occurrence.identity == identity && occurrence.start <= position && position < occurrence.start + occurrence.length
      occurrenceStart = occurrence.start
      occurrenceLength = occurrence.length
      occurrenceDisplay = occurrence.display
    end
    occurrence = occurrence.next
  end
  var declaration = semantic.declarations
  while declaration != null
    if identity != "" && declaration.identity == identity && (occurrenceStart >= 0 || (declaration.start <= position && position < declaration.start + declaration.length)) && declaration.typeName != "Error" && (declaration.typeName != "" || declaration.display != "")
      let start = occurrenceStart >= 0 ? occurrenceStart : declaration.start
      let length = occurrenceStart >= 0 ? occurrenceLength : declaration.length
      let declaredDisplay = declaration.display != "" ? declaration.display : declaration.name + ": " + declaration.typeName
      let display = occurrenceDisplay != "" ? occurrenceDisplay : declaredDisplay
      let documentation = documentationEnabled ? lspDocumentationForDeclaration(document, declaration) : ""
      return "{\"contents\":" + lspHoverMarkup(display, documentation, markdown) + ",\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + length) + "}}"
    end
    declaration = declaration.next
  end
  var candidate: BoundNode? = null
  var ambiguous = false
  var node = semantic.bound.first.nextNode
  while node != null
    let kind = node.kind
    let supported = kind == "Name" || kind == "This" || kind == "IntLiteral" || kind == "FloatLiteral" || kind == "StringLiteral" || kind == "BoolLiteral" || kind == "NullLiteral"
    if supported && node.start <= position && position < node.start + node.length
      if candidate == null || node.length < candidate.length
        candidate = node
        ambiguous = false
      else if candidate.start == node.start && candidate.length == node.length && candidate.typeName != node.typeName
        # Specialized bodies can share a source span; do not pick an arbitrary
        # instantiation's type for the generic source declaration.
        ambiguous = true
      end
    end
    node = node.nextNode
  end
  if candidate == null || ambiguous || candidate.typeName == "Error"
    return "null"
  end
  var display = candidate.typeName
  if candidate.kind == "Name"
    display = candidate.data + ": " + display
  else if candidate.kind == "This"
    display = "this: " + display
  end
  return "{\"contents\":" + lspHoverMarkup(display, "", markdown) + ",\"range\":{\"start\":" + lspPosition(document.text, candidate.start) + ",\"end\":" + lspPosition(document.text, candidate.start + candidate.length) + "}}"
end
