# Query the version's bound model, never names collected by text matching.
def lspHoverForSemantic(document: LspDocument, semantic: SemanticModel, position: Int, documentationEnabled: Bool, markdown: Bool, repair: LspQueryRepair?): String
  var semanticPosition = position

  if repair != null
    semanticPosition = repair.repairedOffset(position)
  end
  let identity = lspSymbolAt(semantic, semanticPosition)
  var occurrence = semantic.occurrences
  var occurrenceStart = -1
  var occurrenceLength = 0
  var occurrenceDisplay = ""

  while occurrence != null
    if occurrence.identity == identity && occurrence.start <= semanticPosition && semanticPosition < occurrence.start + occurrence.length
      occurrenceStart = occurrence.start
      occurrenceLength = occurrence.length
      occurrenceDisplay = occurrence.display
    end
    occurrence = occurrence.next
  end
  if occurrenceDisplay == "" && bootstrapStartsWith(identity, "callable:")
    var boundCall = semantic.bound.first.nextNode
    var specializedIdentity = ""
    var specializedDisplay = ""
    var specializedAmbiguous = false

    while boundCall != null
      if boundCall.data != "" && boundCall.start <= semanticPosition && semanticPosition < boundCall.start + boundCall.length
        let candidateIdentity = "callable:" + boundCall.data
        var specialized = semantic.declarations

        while specialized != null
          if specialized.identity == candidateIdentity && specialized.display != ""
            if specializedIdentity != "" && specializedIdentity != candidateIdentity
              specializedAmbiguous = true
            else
              specializedIdentity = candidateIdentity
              specializedDisplay = specialized.display
            end
          end
          specialized = specialized.next
        end
      end
      boundCall = boundCall.nextNode
    end
    if !specializedAmbiguous
      occurrenceDisplay = specializedDisplay
    end
  end
  var declaration = semantic.declarations

  while declaration != null
    if identity != "" && declaration.identity == identity && (occurrenceStart >= 0 || (declaration.start <= semanticPosition && semanticPosition < declaration.start + declaration.length)) && declaration.typeName != "Error" && (declaration.typeName != "" || declaration.display != "" || occurrenceDisplay != "")
      let repairedStart = occurrenceStart >= 0 ? occurrenceStart : declaration.start
      var start = repairedStart

      if repair != null
        start = repair.originalOffset(repairedStart)
      end
      let length = occurrenceStart >= 0 ? occurrenceLength : declaration.length
      let declaredDisplay = declaration.display != "" ? declaration.display : declaration.name + ": " + semanticCompletionTypeDisplay(declaration.typeName)
      let display = occurrenceDisplay != "" ? occurrenceDisplay : declaredDisplay
      var documentation = ""

      if documentationEnabled
        if repair != null
          documentation = lspDocumentationForRepairedDeclaration(document, declaration, repair.insertionStart, repair.insertionLength, repair.insertionLength)
        else
          documentation = lspDocumentationForDeclaration(document, declaration)
        end
      end
      return "{\"contents\":" + lspHoverMarkup(display, documentation, markdown) + ",\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + length) + "}}"
    end
    declaration = declaration.next
  end
  var candidate: BoundNode? = null
  var ambiguous = false
  var node = semantic.bound.first.nextNode

  while node != null
    let kind = node.kind
    let supported = kind.isName() || kind.isThis() || kind.isIntLiteral() || kind.isFloatLiteral() || kind.isStringLiteral() || kind.isBoolLiteral() || kind.isNullLiteral()

    if supported && node.start <= semanticPosition && semanticPosition < node.start + node.length
      if candidate == null || node.length < candidate.length
        candidate = node
        ambiguous = false
      else if candidate.start == node.start && candidate.length == node.length && candidate.typeName != node.typeName
        # Specialized bodies can share a source span; do not pick an arbitrary
        # instantiation's type for the generic source declaration.
        ambiguous = true
      end
    end
    node = node.nextNode
  end
  if candidate == null || ambiguous || candidate.typeName == "Error"
    return "null"
  end
  var display = semanticCompletionTypeDisplay(candidate.typeName)

  if candidate.kind.isName()
    display = candidate.data + ": " + display
  else if candidate.kind.isThis()
    display = "this: " + display
  end
  var start = candidate.start

  if repair != null
    start = repair.originalOffset(candidate.start)
  end

  return "{\"contents\":" + lspHoverMarkup(display, "", markdown) + ",\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + candidate.length) + "}}"
end

def lspHover(document: LspDocument, position: Int, documentationEnabled: Bool = true, markdown: Bool = false): String
  let semantic = document.semantic

  if semantic != null
    return lspHoverForSemantic(document, semantic, position, documentationEnabled, markdown, null)
  end
  let repair = lspMissingArgumentRepair(document, position, "__neri_hover_site_7f31__", true)

  if repair == null
    return "null"
  end
  let recovered = lspAnalyzeQueryText(document, repair.text)

  if recovered == null
    return "null"
  end
  return lspHoverForSemantic(document, recovered, position, documentationEnabled, markdown, repair)
end
