def lspJsonKnownKey(key: String, names: String[]): Bool
  for name in names
    if key == name
      return true
    end
  end
  return false
end

def lspJsonDuplicateKey(object: LspJson, field: LspJson, earlierOnly: Bool = false): Bool
  var candidate = object.first
  var matches = 0

  while candidate != null && (!earlierOnly || candidate.keyStart < field.keyStart)
    if candidate.key == field.key
      matches = matches + 1
      if earlierOnly || matches > 1
        return true
      end
    end
    candidate = candidate.next
  end
  return false
end

# Consumers retain their object checks, diagnostic wording and duplicate location.
def lspJsonKeyError(
  object: LspJson,
  names: String[]?,
  earlierOnly: Bool = false
): LspJsonKeyError?
  var field = object.first

  while field != null
    if names != null && !lspJsonKnownKey(field.key, names)
      return LspJsonKeyError.Unknown(field)
    end
    if lspJsonDuplicateKey(object, field, earlierOnly)
      return LspJsonKeyError.Duplicate(field)
    end
    field = field.next
  end
  return null
end
