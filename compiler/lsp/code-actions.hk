def lspUnusedUseEdit(document: LspDocument, syntax: SyntaxArena, node: Int): String
  let start = syntax.startAt(node)
  let finish = start + syntax.lengthAt(node)

  return "{\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, finish) + "},\"newText\":\"\"}"
end

def lspVersionedUseEdit(document: LspDocument, edits: String): String
  return "{\"documentChanges\":[{\"textDocument\":{\"uri\":" + lspQuote(document.uri) + ",\"version\":" + (document.version as String) + "},\"edits\":[" + edits + "]}]}"
end

def lspRemoveUnusedUses(document: LspDocument, semantic: SemanticModel, syntax: SyntaxArena, selectedStart: Int, selectedOnly: Bool): String
  var result = document.text
  let primaryEnd = (new IrSourceMap(document.text)).utf16Length()
  var index = semanticIntField(syntax.dataAt(document.syntaxRoot), 0) - 1

  while index >= 0
    let node = syntax.childAt(document.syntaxRoot, index)
    let name = syntax.dataAt(node)
    let start = syntax.startAt(node)
    let finish = start + syntax.lengthAt(node)

    if start < primaryEnd && semantic.hasUse(name) && !semantic.useReferenced(name) && (!selectedOnly || start == selectedStart)
      let map = new IrSourceMap(result)
      let byteStart = map.offsetAt(start)
      let byteEnd = map.offsetAt(finish)

      result = host.stringSlice(result, 0, byteStart) + host.stringSlice(result, byteEnd, host.stringByteLength(result) - byteEnd)
    end
    index = index - 1
  end
  return result
end

def lspUnusedUseEditValid(document: LspDocument, text: String): Bool
  let snapshot = lspNavigationSnapshot(document)
  let texts = new StringBuffer()

  texts.add(text)
  var index = 1

  while index < snapshot.sourceTexts.size
    texts.add(snapshot.sourceTexts.get(index))
    index = index + 1
  end
  return lspAnalyzeSnapshotTexts(snapshot, texts).semantic != null
end

def lspUnusedUseActions(document: LspDocument, selectionStart: Int, selectionEnd: Int, quickFix: Bool, organize: Bool): String
  if !quickFix && !organize
    return "[]"
  end
  let semantic = document.semantic
  let syntax = document.syntax

  if semantic == null || syntax == null || semantic.diagnostics.count() != 0
    return "[]"
  end
  let useCount = semanticIntField(syntax.dataAt(document.syntaxRoot), 0)
  let primaryEnd = (new IrSourceMap(document.text)).utf16Length()
  var allEdits = ""
  var allSeparator = ""
  var selectedEdit = ""
  var selectedName = ""
  var selectedStart = -1
  var index = 0

  while index < useCount
    let node = syntax.childAt(document.syntaxRoot, index)
    let name = syntax.dataAt(node)

    if syntax.startAt(node) < primaryEnd && semantic.hasUse(name) && !semantic.useReferenced(name)
      let edit = lspUnusedUseEdit(document, syntax, node)

      allEdits = allEdits + allSeparator + edit
      allSeparator = ","
      let start = syntax.startAt(node)
      let finish = start + syntax.lengthAt(node)
      let cursor = selectionStart == selectionEnd && start <= selectionStart && selectionStart < finish
      let overlap = selectionStart < finish && selectionEnd > start

      if selectedEdit == "" && (cursor || overlap)
        selectedEdit = edit
        selectedName = name
        selectedStart = start
      end
    end
    index = index + 1
  end
  var result = "["
  var separator = ""
  let quickText = lspRemoveUnusedUses(document, semantic, syntax, selectedStart, true)

  if quickFix && selectedEdit != "" && lspUnusedUseEditValid(document, quickText)
    result = result + "{\"title\":\"Remove unused import '" + selectedName + "'\",\"kind\":\"quickfix\",\"isPreferred\":true,\"edit\":" + lspVersionedUseEdit(document, selectedEdit) + "}"
    separator = ","
  end
  let organizedText = lspRemoveUnusedUses(document, semantic, syntax, -1, false)

  if organize && allEdits != "" && lspUnusedUseEditValid(document, organizedText)
    result = result + separator + "{\"title\":\"Remove unused imports\",\"kind\":\"source.organizeImports\",\"edit\":" + lspVersionedUseEdit(document, allEdits) + "}"
  end
  return result + "]"
end
