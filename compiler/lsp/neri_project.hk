# Source membership is shared by CLI commands and language-service analysis.
class NeriProject
  public root: String = ""
  public manifest: String = ""
  public sources: StringBuffer = new StringBuffer()
  # Parallel to sources. Each path belongs to one manifest/unit key.
  public sourceOwners: StringBuffer = new StringBuffer()
  public ownSources: StringBuffer = new StringBuffer()
  public referenceSources: StringBuffer = new StringBuffer()
  private errorMessage: String = ""
  private errorClassification: NeriProjectErrorReason?
  public kind: String = ""
  public implicit: Bool = false
  public testDeclared: Bool = false
  public testArguments: String[] = []
  public testTimeoutMs: Int = 120000
  public generatedInputs: StringBuffer = new StringBuffer()
  public generatedDigests: StringBuffer = new StringBuffer()
  public generatedOutputs: StringBuffer = new StringBuffer()
  public verifiedTextTable: StringTable<String> = new StringTable<String>()
  public verifiedDigestTable: StringTable<String> = new StringTable<String>()
  public generationManifests: StringBuffer = new StringBuffer()
  public generationManifestTexts: StringBuffer = new StringBuffer()
  public generatedOrigins: NeriGeneratedOrigin?

  public def error(): String
    return this.errorMessage
  end

  public def errorReason(): NeriProjectErrorReason?
    return this.errorClassification
  end

  internal def fail(message: String): Void
    this.failAs(NeriProjectErrorReason.InvalidProject(), message)
  end

  internal def failAs(reason: NeriProjectErrorReason, message: String): Void
    this.errorClassification = reason
    this.errorMessage = message
  end

  internal def copyError(other: NeriProject): Void
    this.errorClassification = other.errorClassification
    this.errorMessage = other.errorMessage
  end
end
