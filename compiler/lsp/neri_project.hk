# Source membership is shared by CLI commands and language-service analysis.
class NeriProject
  public control: AnalysisControl?
  public root: String = ""
  public manifest: String = ""
  public sources: StringBuffer = new StringBuffer()
  # Parallel to sources. Each path belongs to one manifest/unit key.
  public sourceOwners: StringBuffer = new StringBuffer()
  private sourceOwnerIndex: StringTable<String> = new StringTable<String>()
  private sourceMapPhysical: StringBuffer = new StringBuffer()
  private sourceMapLogical: StringBuffer = new StringBuffer()
  private sourceMapOwners: StringBuffer = new StringBuffer()
  public ownSources: StringBuffer = new StringBuffer()
  public referenceSources: StringBuffer = new StringBuffer()
  private errorMessage: String = ""
  private errorClassification: NeriProjectErrorReason?
  public kind: ProjectUnitKind?
  public implicit: Bool = false
  public testDeclared: Bool = false
  public testArguments: String[] = []
  public testTimeoutMs: Int = 120000
  public generatedInputs: StringBuffer = new StringBuffer()
  public generatedDigests: StringBuffer = new StringBuffer()
  public generatedOutputs: StringBuffer = new StringBuffer()
  public verifiedTextTable: StringTable<String> = new StringTable<String>()
  public verifiedDigestTable: StringTable<String> = new StringTable<String>()
  public manifestTexts: StringTable<String> = new StringTable<String>()
  public generationManifests: StringBuffer = new StringBuffer()
  public generationManifestTexts: StringBuffer = new StringBuffer()
  public generatedOrigins: NeriGeneratedOrigin?

  def sourceOwner(path: String): String?
    let entry = this.sourceOwnerIndex.find(path)

    if entry == null
      return null
    end
    return entry.value
  end

  # Keep the ordered source lists and lookup index in sync through one mutation.
  def registerSource(path: String, owner: String, own: Bool): Bool
    if this.sourceOwnerIndex.find(path) != null
      return false
    end
    this.sourceOwnerIndex.add(path, owner)
    this.sources.add(path)
    this.sourceOwners.add(owner)
    if own
      this.ownSources.add(path)
    else
      this.referenceSources.add(path)
    end
    return true
  end

  def identityPath(path: String): String
    let owner = this.sourceOwner(path)

    if owner == null
      return path
    end
    return this.mappedPath(path, owner)
  end

  def registerSourceMapping(owner: String, physical: String, logical: String): Void
    this.sourceMapPhysical.add(physical)
    this.sourceMapLogical.add(logical)
    this.sourceMapOwners.add(owner)
  end

  def mappedPath(path: String, owner: String): String
    var result = path
    var longest = 0
    var index = 0

    while index < this.sourceMapPhysical.size
      let physical = this.sourceMapPhysical.get(index)

      if owner == this.sourceMapOwners.get(index) && (path == physical || bootstrapStartsWith(path, physical + "/")) && host::stringByteLength(physical) > longest
        let suffix = host::stringSlice(path, host::stringByteLength(physical), host::stringByteLength(path) - host::stringByteLength(physical))

        let logical = this.sourceMapLogical.get(index)

        result = logical == "/" && suffix != "" ? suffix : logical + suffix
        longest = host::stringByteLength(physical)
      end
      index = index + 1
    end
    return result
  end

  def remapIdentitySources(): Bool
    let index = new StringTable<String>()
    let mapped = new StringBuffer()
    var source = this.sources.first.nextNode

    while source != null
      let path = this.identityPath(source.value)
      let sourceOwner = this.sourceOwner(source.value)

      if sourceOwner == null || !index.add(path, sourceOwner)
        return false
      end
      mapped.add(path)
      source = source.nextNode
    end
    source = this.ownSources.first.nextNode
    while source != null
      source.value = this.identityPath(source.value)
      source = source.nextNode
    end
    source = this.referenceSources.first.nextNode
    while source != null
      source.value = this.identityPath(source.value)
      source = source.nextNode
    end
    this.sources = mapped
    this.sourceOwnerIndex = index
    this.sourceMapPhysical = new StringBuffer()
    this.sourceMapLogical = new StringBuffer()
    this.sourceMapOwners = new StringBuffer()
    return true
  end

  def validateIdentityPaths(): Bool
    let identities = new StringTable<Bool>()
    var source = this.sources.first.nextNode

    while source != null
      let identity = this.identityPath(source.value)

      if !identities.add(identity, true)
        this.fail("Source identity belongs to multiple project sources: " + identity)
        return false
      end
      source = source.nextNode
    end
    return true
  end

  public def error(): String
    return this.errorMessage
  end

  internal def observeManifest(path: String, text: String): Bool
    let previous = this.manifestTexts.find(path)

    if previous != null && previous.value != text
      this.fail("Project manifest changed while loading: " + path)
      return false
    end
    this.manifestTexts.add(path, text) if previous == null
    return true
  end

  internal def continueLoading(): Bool
    let control = this.control

    return control == null || control.poll()
  end

  public def errorReason(): NeriProjectErrorReason?
    return this.errorClassification
  end

  internal def fail(message: String): Void
    this.failAs(NeriProjectErrorReason.InvalidProject(), message)
  end

  internal def failAs(reason: NeriProjectErrorReason, message: String): Void
    this.errorClassification = reason
    this.errorMessage = message
  end

  internal def copyError(other: NeriProject): Void
    this.errorClassification = other.errorClassification
    this.errorMessage = other.errorMessage
  end
end
