# Small JSON tree for the editor protocol; no editor or semantic rules live here.
class LspJson
  public kind: String = "missing"
  public value: String = ""
  public key: String = ""
  public first: LspJson?
  public last: LspJson?
  public next: LspJson?

  def add(node: LspJson): Void
    let tail = this.last
    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
  end

  def get(key: String): LspJson
    var child = this.first
    while child != null
      if child.key == key
        return child
      end
      child = child.next
    end
    return new LspJson()
  end
end

def lspCharacter(point: Int): String
  var bytes: Byte[] = []
  if point < 128
    bytes = host.appendByte(bytes, point as Byte)
  else if point < 2048
    bytes = host.appendByte(bytes, (192 + point / 64) as Byte)
    bytes = host.appendByte(bytes, (128 + (point - (point / 64) * 64)) as Byte)
  else if point < 65536
    bytes = host.appendByte(bytes, (224 + point / 4096) as Byte)
    bytes = host.appendByte(bytes, (128 + ((point / 64) - (point / 4096) * 64)) as Byte)
    bytes = host.appendByte(bytes, (128 + (point - (point / 64) * 64)) as Byte)
  else
    bytes = host.appendByte(bytes, (240 + point / 262144) as Byte)
    bytes = host.appendByte(bytes, (128 + ((point / 4096) - (point / 262144) * 64)) as Byte)
    bytes = host.appendByte(bytes, (128 + ((point / 64) - (point / 4096) * 64)) as Byte)
    bytes = host.appendByte(bytes, (128 + (point - (point / 64) * 64)) as Byte)
  end
  let decoded = host.stringFromBytes(bytes)
  if decoded == null
    return ""
  end
  return decoded
end

def lspJoin(parts: StringBuffer, start: Int, count: Int): String
  if count == 0
    return ""
  end
  if count == 1
    return parts.get(start)
  end
  let left = count / 2
  return lspJoin(parts, start, left) + lspJoin(parts, start + left, count - left)
end

def lspQuote(text: String): String
  let parts = new StringBuffer()
  parts.add("\"")
  var index = 0
  var start = 0
  while index < host.stringByteLength(text)
    let byte = host.stringByteAt(text, index) as Int
    if byte == 34 || byte == 92 || byte < 32
      parts.add(host.stringSlice(text, start, index - start))
      if byte < 32
        parts.add("\\u00" + irHexDigit(byte / 16) + irHexDigit((byte - (byte / 16) * 16)))
      else
        parts.add("\\" + host.stringSlice(text, index, 1))
      end
      start = index + 1
    end
    index = index + 1
  end
  parts.add(host.stringSlice(text, start, index - start) + "\"")
  return lspJoin(parts, 0, parts.size)
end

class LspJsonParser
  public text: String = ""
  public position: Int = 0
  public failed: Bool = false

  def init(text: String): Void
    this.text = text
  end

  def byte(): Int
    if this.position >= host.stringByteLength(this.text)
      return -1
    end
    return host.stringByteAt(this.text, this.position) as Int
  end

  def spaces(): Void
    while this.byte() == 32 || this.byte() == 9 || this.byte() == 10 || this.byte() == 13
      this.position = this.position + 1
    end
  end

  def hex4(): Int
    var result = 0
    var count = 0
    while count < 4
      let byte = this.byte()
      var digit = -1
      if byte >= 48 && byte <= 57
        digit = byte - 48
      else if byte >= 65 && byte <= 70
        digit = byte - 55
      else if byte >= 97 && byte <= 102
        digit = byte - 87
      end
      if digit < 0
        this.failed = true
        return 0
      end
      result = result * 16 + digit
      this.position = this.position + 1
      count = count + 1
    end
    return result
  end

  def string(): String
    this.position = this.position + 1
    let parts = new StringBuffer()
    var start = this.position
    while !this.failed
      let byte = this.byte()
      if byte < 32
        this.failed = true
        return ""
      end
      if byte == 34
        parts.add(host.stringSlice(this.text, start, this.position - start))
        this.position = this.position + 1
        return lspJoin(parts, 0, parts.size)
      end
      if byte == 92
        parts.add(host.stringSlice(this.text, start, this.position - start))
        this.position = this.position + 1
        let escape = this.byte()
        this.position = this.position + 1
        if escape == 34 || escape == 92 || escape == 47
          parts.add(lspCharacter(escape))
        else if escape == 98
          parts.add(lspCharacter(8))
        else if escape == 102
          parts.add(lspCharacter(12))
        else if escape == 110
          parts.add("\n")
        else if escape == 114
          parts.add("\r")
        else if escape == 116
          parts.add("\t")
        else if escape == 117
          var point = this.hex4()
          if point >= 55296 && point <= 56319
            if this.byte() != 92
              this.failed = true
              return ""
            end
            this.position = this.position + 1
            if this.byte() != 117
              this.failed = true
              return ""
            end
            this.position = this.position + 1
            let low = this.hex4()
            if low < 56320 || low > 57343
              this.failed = true
              return ""
            end
            point = 65536 + (point - 55296) * 1024 + low - 56320
          else if point >= 56320 && point <= 57343
            this.failed = true
            return ""
          end
          parts.add(lspCharacter(point))
        else
          this.failed = true
        end
        start = this.position
      else
        this.position = this.position + 1
      end
    end
    return ""
  end

  def parse(depth: Int = 0): LspJson
    let node = new LspJson()
    this.spaces()
    if depth > 64
      this.failed = true
      return node
    end
    let byte = this.byte()
    if byte == 34
      node.kind = "string"
      node.value = this.string()
    else if byte == 123 || byte == 91
      node.kind = byte == 123 ? "object" : "array"
      let closing = byte == 123 ? 125 : 93
      this.position = this.position + 1
      this.spaces()
      if this.byte() == closing
        this.position = this.position + 1
        return node
      end
      while !this.failed
        var key = ""
        if byte == 123
          this.spaces()
          if this.byte() != 34
            this.failed = true
            return node
          end
          key = this.string()
          this.spaces()
          if this.byte() != 58
            this.failed = true
            return node
          end
          this.position = this.position + 1
        end
        let child = this.parse(depth + 1)
        child.key = key
        node.add(child)
        this.spaces()
        if this.byte() == closing
          this.position = this.position + 1
          return node
        end
        if this.byte() != 44
          this.failed = true
          return node
        end
        this.position = this.position + 1
      end
    else
      let start = this.position
      while this.byte() >= 0 && this.byte() != 44 && this.byte() != 93 && this.byte() != 125 && this.byte() != 32 && this.byte() != 9 && this.byte() != 10 && this.byte() != 13
        this.position = this.position + 1
      end
      node.value = host.stringSlice(this.text, start, this.position - start)
      node.kind = "literal"
      if node.value != "true" && node.value != "false" && node.value != "null"
        # Protocol ids and versions are integers; other JSON numbers are accepted
        # by the number grammar, even though this server never interprets them.
        let number = new LspJsonParser(node.value)
        if number.byte() == 45
          number.position = number.position + 1
        end
        if number.byte() == 48
          number.position = number.position + 1
        else
          let digits = number.position
          while number.byte() >= 48 && number.byte() <= 57 number.position = number.position + 1 end
          if number.position == digits
            this.failed = true
          end
        end
        if number.byte() == 46
          number.position = number.position + 1
          let digits = number.position
          while number.byte() >= 48 && number.byte() <= 57 number.position = number.position + 1 end
          if number.position == digits
            this.failed = true
          end
        end
        if number.byte() == 69 || number.byte() == 101
          number.position = number.position + 1
          if number.byte() == 43 || number.byte() == 45
            number.position = number.position + 1
          end
          let digits = number.position
          while number.byte() >= 48 && number.byte() <= 57 number.position = number.position + 1 end
          if number.position == digits
            this.failed = true
          end
        end
        if number.byte() != -1
          this.failed = true
        end
        node.kind = "number"
      end
    end
    return node
  end
end

def lspJsonStringify(node: LspJson): String
  if node.kind == "string"
    return lspQuote(node.value)
  end
  if node.kind == "number" || node.kind == "literal"
    return node.value
  end
  if node.kind != "object" && node.kind != "array"
    return "null"
  end
  let parts = new StringBuffer()
  parts.add(node.kind == "object" ? "{" : "[")
  var child = node.first
  var separator = ""
  while child != null
    if node.kind == "object"
      parts.add(separator + lspQuote(child.key) + ":" + lspJsonStringify(child))
    else
      parts.add(separator + lspJsonStringify(child))
    end
    separator = ","
    child = child.next
  end
  parts.add(node.kind == "object" ? "}" : "]")
  return lspJoin(parts, 0, parts.size)
end
