enum LspDiagnosticSeverity
  case Error()
  case Warning()
  case Information()
  case Hint()
end

def lspDiagnosticSeverityCode(severity: LspDiagnosticSeverity): Int
  match severity
    case LspDiagnosticSeverity.Error()
      return 1
    case LspDiagnosticSeverity.Warning()
      return 2
    case LspDiagnosticSeverity.Information()
      return 3
    case LspDiagnosticSeverity.Hint()
      return 4
  end
end
