use host
use json
use result

class NeriAgentWorkspace
  public root: String = ""
  public unit: String = ""
  public revision: Int = 0
  public server: LspServer = new LspServer("")
  public fingerprint: String = ""
  public project: NeriProject = new NeriProject()
  public inputLimit: Bool = false
  public operationControl: AnalysisControl?
  public responseBytes: Int = 2097152
  private diskFeedback: AgentFeedbackSession?
  private transactionView: AgentTransactionView?
  private analysisSnapshot: String = ""
  private operationSnapshot: AgentOverlaySnapshot?

  def retainTransaction(view: AgentTransactionView): Void
    this.transactionView = view
  end

  def transactionPage(operation: String, expectedSnapshot: String, cursor: String): String
    let view = this.transactionView

    if view == null
      return (new AgentEditTransaction()).response(
        operation,
        "conflict",
        "No transaction view is retained in this workspace.",
        this.revision,
        ""
      )
    end
    return view.page(this, operation, expectedSnapshot, cursor)
  end

  def feedback(): AgentFeedbackSession
    let existing = this.diskFeedback

    if existing != null
      return existing
    end
    let created = new AgentFeedbackSession(this.root, this.unit)

    this.diskFeedback = created
    return created
  end

  def init(root: String, unit: String, snapshot: AgentInputSnapshot? = null): Void
    this.root = root
    this.unit = unit
    this.server.rootPath = neriProjectManifestName(root) ? bootstrapDirectory(root) : root
    this.server.unit = unit
    this.server.documentationEnabled = false
    this.server.allOwnedAdvisories = true
    this.fingerprint = this.inputFingerprint(snapshot)
  end

  def addInput(paths: StringBuffer, path: String, seen: StringTable<Bool>): Void
    if path != "" && seen.add(path, true)
      paths.add(path)
    end
  end

  # Closed dependencies and manifests are observed before each operation.
  # Open buffers remain the source authority until this workspace is disposed.
  def inputFingerprint(snapshot: AgentInputSnapshot? = null): String
    let limits = new AgentLimits()
    var observations = new AgentInputSnapshot()

    if snapshot != null
      observations = snapshot
    end
    let project = neriLoadProject(this.root, this.unit)
    let paths = new StringBuffer()
    let seen = new StringTable<Bool>()
    let parts = new StringBuffer()
    var projectIdentity = this.root
    let canonicalProject = neriCanonicalPath(this.root)

    if canonicalProject != null
      projectIdentity = canonicalProject
    end
    let configuredStdlib = host::environment("NERI_STDLIB")
    var stdlib = ""

    if configuredStdlib != null
      stdlib = configuredStdlib
      let canonicalStdlib = neriCanonicalPath(configuredStdlib)

      if canonicalStdlib != null
        stdlib = canonicalStdlib
      end
    end
    let libraries = new StandardLibraryCatalog(stdlib)

    this.project = project
    this.inputLimit = false
    this.addInput(paths, project.manifest, seen)
    this.addInput(paths, stdlib + "/manifest.json", seen) if stdlib != ""
    parts.add(runCacheFrame(projectIdentity) + runCacheFrame(this.unit) + runCacheFrame(neriVersion()) + runCacheFrame(stdlib) + runCacheFrame(project.error()) + runCacheFrame(projectUnitKindName(project.kind)))
    var index = 0

    while index < project.sources.size
      this.addInput(paths, project.sources.get(index), seen)
      if index < project.sourceOwners.size
        let owner = project.sourceOwners.get(index)
        var split = host::stringByteLength(owner)
        var scan = 0

        while scan < host::stringByteLength(owner)
          if (host::stringByteAt(owner, scan) as Int) == 35
            split = scan
          end
          scan = scan + 1
        end
        this.addInput(paths, host::stringSlice(owner, 0, split), seen)
        parts.add(runCacheFrame(owner))
      end
      index = index + 1
    end
    index = 0
    while index < project.generationManifests.size
      this.addInput(paths, project.generationManifests.get(index), seen)
      index = index + 1
    end
    index = 0
    while index < project.generatedInputs.size
      this.addInput(paths, project.generatedInputs.get(index), seen)
      index = index + 1
    end
    let owned = project.ownSources.cursor()

    while owned.hasValue()
      var directory = bootstrapDirectory(owned.current())

      while true
        let configPath = directory + "/.editorconfig"

        this.addInput(paths, configPath, seen)
        let text = observations.read(configPath).text

        if text != null && codeStyleRoot(text)
          break
        end
        let parent = bootstrapDirectory(directory)

        if parent == directory
          break
        end
        directory = parent
      end
      owned.advance()
    end
    var totalBytes = 0
    let references = new BootstrapLibraryReferences()

    index = 0
    while index < paths.size
      if paths.size > limits.analysisPaths()
        this.inputLimit = true
        break
      end
      let path = paths.get(index)
      let file = observations.read(path)
      let disk = file.text
      let opened = this.server.findPath(path)
      var text = disk

      if opened != null
        text = opened.text
      end
      parts.add(runCacheFrame(path) + runCacheFrame(file.digest))
      if text != null
        totalBytes = totalBytes + host::stringByteLength(text)
        if totalBytes > limits.analysisBytes()
          this.inputLimit = true
          break
        end
        if stdlib != "" && semanticEndsWith(path, ".hk")
          if opened == null
            references.merge(file.libraryReferences())
          else
            references.addSource(text)
          end
        end
      end
      index = index + 1
      if index == paths.size && stdlib != ""
        for library in references.libraryNames()
          let sources = libraries.sourcePaths(library)
          var source = sources.cursor()

          while source.hasValue()
            this.addInput(paths, stdlib + "/" + source.current(), seen)
            source.advance()
          end
        end
      end
    end
    parts.add(runCacheFrame(libraries.error))
    return sha256FastText(parts.join())
  end

  def refresh(): Void
    let fingerprint = this.inputFingerprint()

    if fingerprint != this.fingerprint
      this.fingerprint = fingerprint
      this.revision = this.revision + 1
      this.server.reanalyze()
    end
  end

  def response(
    operation: String,
    uri: String,
    status: readonly AgentWorkspaceStatus,
    message: String,
    document: LspDocument?,
    applied: Bool = false,
    analyzed: Bool = false,
    context: String = "",
    position: Int = 0
  ): String
    var version = 0
    var analysisStatus: readonly AnalysisStatus = AnalysisStatus.unavailable()
    var analysisRevision = 0
    var diagnostics = "[]"
    var diagnosticCount = 0
    var emittedDiagnostics = 0
    var snapshot = ""
    var projectKey = ""

    if document != null
      version = document.version
      if analyzed
        projectKey = document.projectKey
        analysisStatus = document.analysisStatus
        analysisRevision = document.analysisRevision
        diagnostics = agentDocumentDiagnostics(document)
        var emitted = (new LspJsonParser(diagnostics)).parse().first

        while emitted != null
          emittedDiagnostics = emittedDiagnostics + 1
          emitted = emitted.next
        end
        let raw = document.lastDiagnostics

        if raw != null
          diagnosticCount = raw.count() + document.advisories.count()
        else
          var item = (new LspJsonParser(document.lastPublishedDiagnostics)).parse().first

          while item != null
            diagnosticCount = diagnosticCount + 1
            item = item.next
          end
        end
        let parts = new StringBuffer()
        var index = 0

        parts.add(runCacheFrame(document.projectKey))
        while index < document.sourceTexts.size
          parts.add(runCacheFrame(document.sourceUris.get(index)) + runCacheFrame(document.sourceTexts.get(index)))
          index = index + 1
        end
        snapshot = sha256FastText(parts.join())
      end
    end
    let output = json::Json.object()
    let effects = json::Json.object()
    let domain = this.operationSnapshot
    let domainSnapshot = domain == null ? "" : domain.capture(this)

    output.put("schemaVersion", json::Json.integer(2))
    output.put("operationId", json::Json.string(operation))
    output.put("uri", json::Json.string(uri))
    output.put("projectKey", json::Json.string(projectKey))
    output.put("revision", json::Json.integer(this.revision))
    output.put("documentVersion", json::Json.integer(version))
    output.put("status", json::Json.string(status.wireName()))
    output.put("message", json::Json.string(message))
    output.put("analysisStatus", json::Json.string(analysisStatus.wireName()))
    output.put("analysisRevision", json::Json.integer(analysisRevision))
    output.put("snapshot", json::Json.string(domainSnapshot))
    output.put("analysisSnapshot", json::Json.string(snapshot))
    output.put("diagnosticCount", json::Json.integer(diagnosticCount))
    output.put("diagnosticsTruncated", json::Json.boolean(diagnosticCount > emittedDiagnostics))
    effects.put("applied", json::Json.boolean(applied))
    effects.put("analyzed", json::Json.boolean(analyzed))
    effects.put("persisted", json::Json.boolean(false))
    effects.put("executed", json::Json.boolean(false))
    output.put("effects", effects)
    if !agentJsonProperty(output, "diagnostics", diagnostics)
      return (new AgentEditTransaction()).response(
        operation,
        "unavailable",
        "Cannot serialize document diagnostics.",
        this.revision,
        domainSnapshot
      )
    end
    if document != null && analyzed && !agentJsonProperty(
      output,
      "sourceExcerpt",
      agentSourceExcerpt(document.text, position)
    )
      return (new AgentEditTransaction()).response(
        operation,
        "unavailable",
        "Cannot serialize the source excerpt.",
        this.revision,
        domainSnapshot
      )
    end
    if context != "" && !agentJsonProperty(output, "context", context)
      return (new AgentEditTransaction()).response(
        operation,
        "unavailable",
        "Cannot serialize semantic context.",
        this.revision,
        domainSnapshot
      )
    end
    match output.stringify()
      case result::Result.Ok(text)
        return text
      case result::Result.Error(problem)
        return (new AgentEditTransaction()).response(
          operation,
          "limit",
          "Document response exceeds serialization limits.",
          this.revision,
          domainSnapshot
        )
    end

  end

  def handleTool(request: AgentDocumentRequest): String
    let operation = request.operationId()
    let uri = request.uri()

    this.refresh()
    let graph = new AgentProjectGraph(this.root)
    let observed = new AgentOverlaySnapshot(this, graph)
    let graphSnapshot = graph.snapshot

    this.operationSnapshot = observed
    if graph.error() != ""
      return this.response(operation, uri, AgentWorkspaceStatus.unavailable(), graph.error(), null)
    end
    if this.inputLimit
      return this.response(
        operation,
        uri,
        AgentWorkspaceStatus.limit(),
        "Workspace analysis inputs exceed 1024 paths or 16 MiB.",
        null
      )
    end
    if this.project.error() != ""
      return this.response(operation, uri, AgentWorkspaceStatus.unavailable(), this.project.error(), null)
    end
    let rawPath = lspPath(uri)
    var path: String? = null

    if rawPath != null
      path = neriCanonicalPath(rawPath)
    end
    if path == null || !observed.owns(path)
      return this.response(
        operation,
        uri,
        AgentWorkspaceStatus.invalidRequest(),
        "URI must identify an existing source in the complete project graph.",
        null
      )
    end
    let canonicalUri = lspUri(path)
    let target = new AgentWorkspaceTarget(operation, canonicalUri, path, this.server.find(canonicalUri))
    let document = target.document()

    if request.requiresOpenBuffer() && document == null
      return this.response(
        operation,
        canonicalUri,
        AgentWorkspaceStatus.notFound(),
        "Open the buffer before inspecting or editing it.",
        null
      )
    end
    let expected = request.expectedRevision()

    if expected != null && expected != this.revision
      return this.response(
        operation,
        canonicalUri,
        AgentWorkspaceStatus.conflict(),
        "Workspace revision changed; inspect the current revision before retrying.",
        document
      )
    end
    let execution = request.apply(this, target)
    let appliedFingerprint = execution.appliedFingerprint()
    let failedExecution = execution.failure()

    if failedExecution != null
      return failedExecution
    end
    let current = target.document()

    if current == null
      return this.response(operation, canonicalUri, AgentWorkspaceStatus.unavailable(), "Buffer is unavailable.", null)
    end
    if appliedFingerprint != null
      this.revision = this.revision + 1
      this.server.reanalyze()
      this.fingerprint = appliedFingerprint
    end
    this.analyzeRootDocument(current, path, graph)
    let context = request.context(this, current)
    let failedContext = context.failure()

    if failedContext != null
      return failedContext
    end
    let before = this.revision

    this.refresh()
    graph.refresh()
    if this.revision != before || graph.snapshot != graphSnapshot || graph.error() != ""
      return this.response(
        operation,
        canonicalUri,
        AgentWorkspaceStatus.conflict(),
        "Files changed during analysis; inspect the current revision. Applied buffer edits are retained.",
        current,
        appliedFingerprint != null
      )
    end
    return this.response(
      operation,
      canonicalUri,
      AgentWorkspaceStatus.analysis(current.analysisStatus),
      "",
      current,
      appliedFingerprint != null,
      true,
      context.json(),
      context.position()
    )
  end

  def analyzeRootDocument(document: LspDocument, path: String, graph: AgentProjectGraph): Void
    let currentSnapshot = (new AgentOverlaySnapshot(this, graph)).snapshot

    if this.analysisSnapshot != currentSnapshot
      this.server.reanalyze()
      this.analysisSnapshot = currentSnapshot
    end
    let originalRoot = this.server.rootPath
    let originalUnit = this.server.unit
    var owner = graph.first

    if this.project.sourceOwner(path) == null
      while owner != null
        if neriProjectListed(owner.project.ownSources, path)
          this.server.rootPath = bootstrapDirectory(owner.manifest)
          this.server.unit = owner.name
          break
        end
        owner = owner.next
      end
    end
    this.server.ensureAnalyzed(document)
    this.server.rootPath = originalRoot
    this.server.unit = originalUnit
  end

  def applyOpen(request: AgentOpenRequest, target: AgentWorkspaceTarget): AgentToolExecution

    let existing = target.document()

    if existing != null
      return AgentToolExecution.failed(this.response(
          request.operationId(),
          target.uri(),
          AgentWorkspaceStatus.conflict(),
          "Buffer is already open; inspect its current revision or edit it.",
          existing
        ))
    end
    let proposed = request.text()
    var source = host::readText(target.path())

    if proposed != null
      source = proposed
    end
    if source == null
      return AgentToolExecution.failed(this.response(
          request.operationId(),
          target.uri(),
          AgentWorkspaceStatus.notFound(),
          "Source is unavailable.",
          null
        ))
    end
    let limits = new AgentLimits()
    var count = 0
    var bytes = host::stringByteLength(source)
    var other = this.server.documents

    while other != null
      count = count + 1
      bytes = bytes + host::stringByteLength(other.text)
      other = other.next
    end
    if count >= limits.bufferDocuments() || bytes > limits.bufferBytes() || host::stringByteLength(source) > limits.documentBytes()
      return AgentToolExecution.failed(this.response(
          request.operationId(),
          target.uri(),
          AgentWorkspaceStatus.limit(),
          "Buffers are limited to 64 documents, 1 MiB per document and 8 MiB total.",
          null
        ))
    end
    let opened = new LspDocument()

    opened.uri = target.uri()
    opened.sourcePath = target.path()
    opened.text = source
    opened.version = 1
    opened.publishDiagnostics = false
    opened.next = this.server.documents
    this.server.documents = opened
    let acceptedFingerprint = this.inputFingerprint()

    if this.inputLimit
      this.server.documents = opened.next
      return AgentToolExecution.failed(this.response(
          request.operationId(),
          target.uri(),
          AgentWorkspaceStatus.limit(),
          "Opening this overlay exceeds the workspace analysis input limit.",
          null
        ))
    end
    target.setDocument(opened)
    return AgentToolExecution.applied(acceptedFingerprint)
  end


  def inspectContext(request: AgentInspectRequest, document: LspDocument): AgentToolContext

    let position = agentBytePosition(document.text, request.position())

    if position < 0
      return AgentToolContext.failed(this.response(
          request.operationId(),
          document.uri,
          AgentWorkspaceStatus.invalidRequest(),
          "Position is outside the buffer or splits a UTF-16 scalar.",
          document
        ))
    end
    let offset = (new IrSourceMap(host::stringSlice(document.text, 0, position))).utf16Length()

    return AgentToolContext.complete(lspAgentContext(document, offset), offset)
  end
end
