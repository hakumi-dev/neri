# Parser and binder errors control analysis validity. Advisories share their
# source offsets but remain independent of the compilation error buffer.
def lspCollectAdvisories(document: LspDocument, allOwnedSources: Bool, styleEnabled: Bool): LspAdvisoryBuffer
  let result = new LspAdvisoryBuffer()
  let semantic = document.semantic
  let errors = document.lastDiagnostics
  let primaryEnd = document.sourceStarts.size > 1 ? document.sourceStarts.get(1) : -1

  if semantic != null && errors != null && errors.count() == 0
    lspCollectUnusedUseAdvisories(document, semantic, primaryEnd, allOwnedSources, result)
  end
  if styleEnabled
    let configs = new StringTable<String>()
    var source = 0

    while source < document.sourceTexts.size
      let uri = document.sourceUris.get(source)
      let owned = source == 0 || neriProjectListed(document.renameOwnedSourceUris, uri)

      if owned && (allOwnedSources || source == 0)
        let path = source == 0 ? document.sourcePath : lspPathOrEmpty(lspPath(uri))
        let config = path == "" ? new NeriCodeStyleConfigResult() : codeStyleOptionsFor(path, configs)
        let offset = document.sourceStarts.get(source)

        if config.error != ""
          result.add("NRSTYLE_CONFIG", offset, 0, config.error, LspDiagnosticSeverity.Warning())
        else
          var finding = neriCodeStyleAnalyzeText(document.sourceTexts.get(source), config.options).findings

          while finding != null
            if !finding.severity.isNone()
              let severity = finding.severity.isError() ? LspDiagnosticSeverity.Error() : (finding.severity.isWarning() ? LspDiagnosticSeverity.Warning() : LspDiagnosticSeverity.Information())

              result.add(finding.ruleId, offset + finding.start, finding.length, finding.message, severity)
            end
            finding = finding.next
          end
        end
      end
      source = source + 1
    end
  end
  return result
end

def lspPrimaryAdvisories(document: LspDocument, includeTags: Bool, supplied: LspAdvisoryBuffer? = null): String
  let advisories = supplied == null ? document.advisories : supplied
  let diagnostics = advisories.diagnostics
  let primaryEnd = document.sourceStarts.size > 1 ? document.sourceStarts.get(1) : -1
  var result = ""
  var separator = ""
  var index = 0

  while index < advisories.count()
    let start = diagnostics.starts.get(index)

    if primaryEnd < 0 || start < primaryEnd
      let code = diagnostics.codes.get(index)
      let tags = includeTags && code == "NR_UNUSED_USE" ? ",\"tags\":[1]" : ""

      result = result + separator + "{\"range\":{\"start\":" + lspPosition(
        document.text,
        start
      ) + ",\"end\":" + lspPosition(
        document.text,
        start + diagnostics.lengths.get(index)
      ) + "},\"severity\":" + (lspDiagnosticSeverityCode(advisories.severities.get(index)) as String) + ",\"code\":" + lspQuote(code) + ",\"source\":\"neri\",\"message\":" + lspQuote(diagnostics.messages.get(index)) + tags + "}"
      separator = ","
    end
    index = index + 1
  end
  return result
end

def lspCollectUnusedUseAdvisories(
  document: LspDocument,
  semantic: SemanticModel,
  primaryEnd: Int,
  allOwnedSources: Bool,
  result: LspAdvisoryBuffer
): Void
  let syntax = document.syntax

  if syntax == null
    return
  end
  let useCount = syntax.programUseCount(document.syntaxRoot)
  var index = 0
  var source = 0

  while index < useCount
    let node = syntax.childAt(document.syntaxRoot, index)
    let start = syntax.startAt(node)

    while source + 1 < document.sourceStarts.size && document.sourceStarts.get(source + 1) <= start
      source = source + 1
    end
    let owned = source < document.sourceUris.size && neriProjectListed(
      document.renameOwnedSourceUris,
      document.sourceUris.get(source)
    )

    if (allOwnedSources ? owned : primaryEnd < 0 || start < primaryEnd) && lspUseUnreferenced(semantic, syntax, node)
      result.add(
        "NR_UNUSED_USE",
        start,
        syntax.lengthAt(node),
        "Unused import: " + lspUseName(syntax, node) + ".",
        LspDiagnosticSeverity.Hint()
      )
    end
    index = index + 1
  end
end
