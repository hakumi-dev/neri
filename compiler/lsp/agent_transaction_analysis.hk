class AgentTransactionAnalysis
  public document: LspDocument?
  public failure: String = ""

  def prepare(
    workspace: NeriAgentWorkspace,
    target: NeriAgentWorkspace,
    plan: AgentEditPlan,
    control: AnalysisControl
  ): Bool
    let server = target.server

    server.documents = null
    server.priorityDocument = null
    server.sourceSymbolsEnabled = false
    var opened = workspace.server.documents

    while opened != null
      let replacement = plan.find(opened.uri)
      let source = replacement == null ? opened : replacement.staged
      let clone = new LspDocument()

      clone.uri = source.uri
      clone.sourcePath = source.sourcePath
      clone.text = source.text
      clone.version = source.version
      clone.publishDiagnostics = false
      clone.control = control
      clone.next = server.documents
      server.documents = clone
      opened = opened.next
    end
    target.fingerprint = target.inputFingerprint()
    if target.inputLimit
      this.failure = "Staged sources exceed the analysis input limit."
      return false
    end
    return true
  end

  def run(unit: AgentProjectUnit, workspace: NeriAgentWorkspace, plan: AgentEditPlan, control: AnalysisControl): Bool
    if !this.prepare(workspace, unit.workspace, plan, control)
      return false
    end
    let server = unit.workspace.server
    let sources = unit.project.ownSources.cursor()

    if !sources.hasValue()
      this.failure = "A consumer has no source to analyze: " + unit.key
      return false
    end
    let path = sources.current()
    let uri = lspUri(path)
    var primary = server.find(uri)

    if primary == null
      let text = neriProjectVerifiedText(unit.project, path)

      if text == null
        this.failure = "A consumer source is unavailable: " + path
        return false
      end
      let created = new LspDocument()

      created.uri = uri
      created.sourcePath = path
      created.text = text
      created.publishDiagnostics = false
      created.control = control
      created.next = server.documents
      server.documents = created
      primary = created
    end
    if primary == null
      this.failure = "Cannot prepare the consumer buffer."
      return false
    end
    this.document = primary
    server.invalidate(primary)
    server.ensureAnalyzed(primary)
    if !control.poll()
      this.failure = "Transaction analysis was cancelled."
      return false
    end
    if !primary.analysisStatus.isValid() && !primary.analysisStatus.isInvalid()
      this.failure = "Consumer analysis is unavailable: " + unit.key
      return false
    end
    return true
  end
end
