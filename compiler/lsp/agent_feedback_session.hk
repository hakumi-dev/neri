use host

class AgentFeedbackSession
  private workspace: NeriAgentWorkspace
  public inputs: String = ""

  def init(root: String, unit: String): Void
    this.workspace = new NeriAgentWorkspace(root, unit)
  end

  def collect(operationId: String, previousInputs: String = "", cacheIdentity: String? = ""): String
    this.inputs = ""
    this.workspace.server.documents = null
    this.workspace.server.priorityDocument = null
    this.workspace.refresh()
    if this.workspace.inputLimit
      return this.workspace.response(operationId, "", "limit", "Workspace analysis inputs exceed 1024 paths or 16 MiB.", null)
    end
    if this.workspace.project.error() != ""
      return this.workspace.response(operationId, "", "unavailable", this.workspace.project.error(), null)
    end
    let identity = cacheIdentity
    var before = this.workspace.fingerprint
    var cacheable = identity != null

    if identity != null && identity != ""
      before = agentFeedbackCacheInputs(before, identity)
    end

    if cacheable && previousInputs != "" && previousInputs == before
      this.inputs = before
      return ""
    end
    let first = this.workspace.project.ownSources.first.nextNode

    if first == null
      return this.workspace.response(operationId, "", "unavailable", "Selected project unit has no source to analyze.", null)
    end
    let path = first.value
    let uri = lspUri(path)
    let text = neriProjectVerifiedText(this.workspace.project, path)

    if text == null
      return this.workspace.response(operationId, uri, "unavailable", "Source is unavailable: " + path, null)
    end
    let document = new LspDocument()

    document.uri = uri
    document.sourcePath = path
    document.text = text
    document.version = 0
    document.publishDiagnostics = false
    this.workspace.server.documents = document
    this.workspace.server.invalidate(document)
    this.workspace.server.ensureAnalyzed(document)
    this.workspace.refresh()
    if this.workspace.inputLimit
      return this.workspace.response(operationId, uri, "limit", "Workspace analysis inputs exceed 1024 paths or 16 MiB.", null)
    end
    var after = this.workspace.fingerprint

    if identity != null && identity != ""
      after = agentFeedbackCacheInputs(after, identity)
    end
    if after != before
      return this.workspace.response(operationId, uri, "conflict", "Files changed during analysis; retry with the current inputs.", document)
    end
    if document.analysisStatus != "valid" && document.analysisStatus != "invalid"
      return this.workspace.response(operationId, uri, "unavailable", "Project analysis is unavailable.", document, false, true)
    end
    if cacheable
      this.inputs = before
    end
    return this.workspace.response(operationId, uri, document.analysisStatus, "", document, false, true)
  end
end
