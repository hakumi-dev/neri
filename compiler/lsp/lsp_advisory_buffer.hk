class LspAdvisoryBuffer
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public severities: SemanticSequence<LspDiagnosticSeverity> = new SemanticSequence<LspDiagnosticSeverity>(LspDiagnosticSeverity.Hint())

  def add(code: String, start: Int, length: Int, message: String, severity: LspDiagnosticSeverity): Void
    this.diagnostics.codes.add(code)
    this.diagnostics.starts.add(start)
    this.diagnostics.lengths.add(length)
    this.diagnostics.messages.add(message)
    this.severities.add(severity)
  end

  def count(): Int
    return this.diagnostics.count()
  end
end
