use host

class AgentStringInput: AgentInputType
  private minimumBytes: Int
  private maximumBytes: Int

  def init(minimumBytes: Int, maximumBytes: Int): Void
    this.minimumBytes = minimumBytes
    this.maximumBytes = maximumBytes
  end

  def schema(): String
    return "{\"type\":\"string\"}"
  end

  def valid(value: LspJson): Bool
    if !value.isString()
      return false
    end
    let length = host.stringByteLength(value.scalarText())

    return length >= this.minimumBytes && length <= this.maximumBytes
  end
end
