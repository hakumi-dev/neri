# Document symbols come from the bound declarations of the current analysis.
# The semantic model retains selection ranges (identifier spans), but not full
# declaration spans or a declaration tree, so this intentionally returns the
# flat SymbolInformation form accepted by textDocument/documentSymbol.

def lspDocumentSymbolIsLocal(declaration: SemanticDeclaration, length: Int): Bool
  return declaration.start >= 0 && declaration.length > 0 && declaration.start + declaration.length <= length
end

class LspDocumentSymbol
  public identity: String = ""
  public name: String = ""
  public start: Int = 0
  public length: Int = 0
  public kind: Int = 0
  public next: LspDocumentSymbol?

  def init(identity: String, name: String, start: Int, length: Int, kind: Int): Void
    this.identity = identity
    this.name = name
    this.start = start
    this.length = length
    this.kind = kind
  end
end

def lspDocumentSymbolSeen(symbols: LspDocumentSymbol?, identity: String): Bool
  var item = symbols

  while item != null
    if item.identity == identity
      return true
    end
    item = item.next
  end
  return false
end

def lspInsertDocumentSymbol(symbols: LspDocumentSymbol?, identity: String, name: String, start: Int, length: Int, kind: Int): LspDocumentSymbol
  let added = new LspDocumentSymbol(identity, name, start, length, kind)

  if symbols == null || start < symbols.start || (start == symbols.start && length < symbols.length)
    added.next = symbols
    return added
  end
  let first = symbols
  var current = first

  while true
    let next = current.next

    if next == null || (next.start > start || (next.start == start && next.length > length))
      break
    end
    current = next
  end
  added.next = current.next
  current.next = added
  return first
end

def lspDocumentSymbolInformation(document: LspDocument, symbol: LspDocumentSymbol): String
  return "{\"name\":" + lspQuote(symbol.name) + ",\"kind\":" + (symbol.kind as String) + ",\"location\":{\"uri\":" + lspQuote(document.uri) + ",\"range\":{\"start\":" + lspPosition(document.text, symbol.start) + ",\"end\":" + lspPosition(document.text, symbol.start + symbol.length) + "}}}"
end

def lspDocumentSymbols(document: LspDocument): String
  let semantic = document.semantic

  if semantic == null
    return "[]"
  end
  let documentLength = (new IrSourceMap(document.text)).utf16Length()
  var symbols: LspDocumentSymbol? = null
  var declaration = semantic.declarations

  while declaration != null
    let kind = lspSourceSymbolKind(semantic, declaration)

    if kind != 0 && !lspSourceSymbolIsGenerated(declaration.identity) && lspDocumentSymbolIsLocal(declaration, documentLength) && !lspDocumentSymbolSeen(symbols, declaration.identity)
      symbols = lspInsertDocumentSymbol(symbols, declaration.identity, declaration.name, declaration.start, declaration.length, kind)
    end
    declaration = declaration.next
  end
  let result = new StringBuffer()
  var separator = ""
  var symbol = symbols

  while symbol != null
    result.add(separator)
    result.add(lspDocumentSymbolInformation(document, symbol))
    separator = ","
    symbol = symbol.next
  end
  return "[" + result.join() + "]"
end
