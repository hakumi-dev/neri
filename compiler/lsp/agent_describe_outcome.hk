sealed class AgentDescribeOutcome
  private tag: Int
  private omitted: Bool
  private truncated: Bool
  private def init(tag: Int, omitted: Bool = false, truncated: Bool = false): Void
    this.tag = tag
    this.omitted = omitted
    this.truncated = truncated
  end
  static def results(omitted: Bool, truncated: Bool): AgentDescribeOutcome
    return new AgentDescribeOutcome(0, omitted, truncated)
  end
  static def invalidRequest(): AgentDescribeOutcome
    return new AgentDescribeOutcome(1)
  end
  static def unavailable(): AgentDescribeOutcome
    return new AgentDescribeOutcome(2)
  end
  static def limit(): AgentDescribeOutcome
    return new AgentDescribeOutcome(3)
  end
  static def conflict(): AgentDescribeOutcome
    return new AgentDescribeOutcome(4)
  end
  readonly def complete(): Bool
    return this.tag == 0 && !this.omitted && !this.truncated
  end
  readonly def resultsTruncated(): Bool
    return this.truncated
  end
  readonly def wireName(): String
    if this.tag == 0
      return "valid"
    end
    if this.tag == 1
      return "invalid_request"
    end
    if this.tag == 2
      return "unavailable"
    end
    return this.tag == 3 ? "limit" : "conflict"
  end
end

