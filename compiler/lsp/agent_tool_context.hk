use host

sealed class AgentToolContext
  private outcome: AgentContextOutcome

  private def init(outcome: AgentContextOutcome): Void
    this.outcome = outcome
  end

  static def absent(): AgentToolContext
    return new AgentToolContext(AgentContextOutcome.Absent())
  end

  static def failed(response: String): AgentToolContext
    return new AgentToolContext(AgentContextOutcome.Failed(response))
  end

  static def complete(content: String, position: Int): AgentToolContext
    return new AgentToolContext(AgentContextOutcome.Complete(content, position))
  end

  def failure(): String?
    match this.outcome
      case AgentContextOutcome.Absent()
        return null
      case AgentContextOutcome.Failed(response)
        return response
      case AgentContextOutcome.Complete(content, position)
        return null
    end
  end

  def json(): String
    match this.outcome
      case AgentContextOutcome.Absent()
        return ""
      case AgentContextOutcome.Failed(response)
        return ""
      case AgentContextOutcome.Complete(content, position)
        return content
    end
  end

  def position(): Int
    match this.outcome
      case AgentContextOutcome.Absent()
        return 0
      case AgentContextOutcome.Failed(response)
        return 0
      case AgentContextOutcome.Complete(content, position)
        return position
    end
  end
end
