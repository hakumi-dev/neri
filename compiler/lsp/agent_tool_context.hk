use host

class AgentToolContext
  private failureResponse: String?
  private content: String = ""
  private sourcePosition: Int = 0

  def fail(response: String): AgentToolContext
    this.failureResponse = response
    return this
  end

  def complete(content: String, position: Int): AgentToolContext
    this.content = content
    this.sourcePosition = position
    return this
  end

  def failure(): String?
    return this.failureResponse
  end

  def json(): String
    return this.content
  end

  def position(): Int
    return this.sourcePosition
  end
end
