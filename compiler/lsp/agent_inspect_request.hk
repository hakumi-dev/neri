use host

class AgentInspectRequest: AgentDocumentRequest
  private storedOperationId: String
  private storedUri: String
  private storedExpectedRevision: Int
  private storedPosition: AgentPosition

  def init(operationId: String, uri: String, expectedRevision: Int, position: AgentPosition): Void
    this.storedOperationId = operationId
    this.storedUri = uri
    this.storedExpectedRevision = expectedRevision
    this.storedPosition = position
  end

  def operationId(): String
    return this.storedOperationId
  end

  def uri(): String
    return this.storedUri
  end

  def expectedRevision(): Int?
    return this.storedExpectedRevision
  end

  def position(): AgentPosition
    return this.storedPosition
  end

  def requiresOpenBuffer(): Bool
    return true
  end

  def apply(workspace: NeriAgentWorkspace, target: AgentWorkspaceTarget): AgentToolExecution
    return new AgentToolExecution()
  end

  def context(workspace: NeriAgentWorkspace, document: LspDocument): AgentToolContext
    return workspace.inspectContext(this, document)
  end
end
