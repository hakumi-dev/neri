use files
use host
use process

class AgentTestService
  private root: String

  def init(root: String): Void
    this.root = root
  end

  def run(operationId: String): String
    let graph = new AgentProjectGraph(this.root)
    let before = graph.snapshot
    let projectKey = graph.manifest
    var unitsTotal = 0
    var testsTotal = 0
    var candidate = graph.first

    while candidate != null
      if neriProjectListed(graph.projects, candidate.manifest)
        unitsTotal = unitsTotal + 1
        if candidate.project.testDeclared
          testsTotal = testsTotal + 1
        end
      end
      candidate = candidate.next
    end
    if graph.error != ""
      return agentTestResponse(operationId, projectKey, before, AgentTestOutcome.unavailable(), graph.error, unitsTotal, testsTotal, "", false)
    end
    if testsTotal == 0
      return agentTestResponse(operationId, projectKey, before, AgentTestOutcome.noTests(), "No project test units are registered.", unitsTotal, 0, "", false)
    end
    let compiler = graph.compilerPath
    let compilerDigest = graph.compilerDigest
    let directory = bootstrapRunDirectory()

    if directory == null
      return agentTestResponse(operationId, projectKey, before, AgentTestOutcome.unavailable(), "Cannot create the test work directory.", unitsTotal, testsTotal, "", false)
    end
    var results = ""
    var separator = ""
    var status: readonly AnalysisStatus = AnalysisStatus.valid()
    var executed = false
    var cleanupFailed = false
    var capturedBytes = 0
    var unit = graph.first

    while unit != null
      if neriProjectListed(graph.projects, unit.manifest) && unit.project.testDeclared
        let work = bootstrapTemporaryDirectory(directory, "test")
        let buildSnapshot = agentTestBuildSnapshot(before, compiler, compilerDigest, unit)
        var testStatus: readonly AnalysisStatus = AnalysisStatus.unavailable()
        var phase: readonly AgentTestPhase = AgentTestPhase.build()
        var message = ""
        var artifactDigest = ""
        var exit: readonly process::ExitStatus? = null
        var stdout = ""
        var stderr = ""
        var stdoutTruncated = false
        var stderrTruncated = false

        if work == null
          message = "Cannot create the unit test work directory."
        else
          let artifact = agentTestExecutable(work + "/program")
          let buildOptions = new process::SpawnOptions(compiler)

          buildOptions.arguments = ["build", "--project", unit.manifest, "--unit", unit.name, "--output", work + "/program", "--no-cache"]
          buildOptions.workingDirectory = bootstrapDirectory(unit.manifest)
          buildOptions.stdoutLimit = 65536
          buildOptions.stderrLimit = 65536
          let build = AgentProcessResult.run(buildOptions, 120000)

          executed = executed || build.outcome.started()
          if build.outcome.isUnavailable()
            message = build.message
          else if build.outcome.isTimeout()
            testStatus = AnalysisStatus.invalid()
            message = "Building the test unit exceeded 120000 milliseconds."
          else if !build.exitedWith(0)
            testStatus = AnalysisStatus.invalid()
            message = "Building the test unit failed."
          else
            let digest = agentArtifactDigest(artifact)

            if digest != null
              artifactDigest = digest
            end
            if artifactDigest == ""
              message = "The build completed without a readable executable artifact."
            else
              let runOptions = new process::SpawnOptions(artifact)

              runOptions.arguments = agentTestArguments(bootstrapDirectory(unit.manifest), compiler, work, unit.project.testArguments)
              runOptions.workingDirectory = bootstrapDirectory(unit.manifest)
              runOptions.stdoutLimit = 65536
              runOptions.stderrLimit = 65536
              let run = AgentProcessResult.run(runOptions, unit.project.testTimeoutMs)

              phase = AgentTestPhase.run(run.outcome.started())
              executed = executed || run.outcome.started()
              if run.outcome.isUnavailable()
                message = run.message
              else if run.outcome.isTimeout()
                testStatus = AnalysisStatus.invalid()
                message = "Test exceeded " + (unit.project.testTimeoutMs as String) + " milliseconds."
              else if !run.exitedWith(0)
                testStatus = AnalysisStatus.invalid()
                message = "Test exited unsuccessfully."
              else
                testStatus = AnalysisStatus.valid()
                message = "Test completed successfully."
              end
              exit = run.exit()
              stdout = run.stdout
              stderr = run.stderr
              stdoutTruncated = run.stdoutTruncated
              stderrTruncated = run.stderrTruncated
            end
          end
          if phase.isBuild()
            exit = build.exit()
            stdout = build.stdout
            stderr = build.stderr
            stdoutTruncated = build.stdoutTruncated
            stderrTruncated = build.stderrTruncated
          end
          let cleaned = files::removeTree(work)

          if cleaned.failure != null
            testStatus = AnalysisStatus.unavailable()
            message = "Cannot remove the unit test work directory."
            cleanupFailed = true
          end
        end
        if testStatus.isUnavailable()
          status = AnalysisStatus.unavailable()
        else if testStatus.isInvalid() && status.isValid()
          status = AnalysisStatus.invalid()
        end
        let outputBytes = host::stringByteLength(stdout) + host::stringByteLength(stderr)

        if capturedBytes + outputBytes > 1048576
          stdout = ""
          stderr = ""
          stdoutTruncated = true
          stderrTruncated = true
        else
          capturedBytes = capturedBytes + outputBytes
        end
        results = results + separator + "{\"projectKey\":" + lspQuote(unit.key) + ",\"name\":" + lspQuote(unit.name) + ",\"status\":" + lspQuote(testStatus.wireName()) + ",\"phase\":" + lspQuote(phase.wireName()) + ",\"message\":" + lspQuote(message) + ",\"buildSnapshot\":" + lspQuote(buildSnapshot) + ",\"artifactDigest\":" + lspQuote(artifactDigest) + ",\"exitKind\":" + lspQuote(agentProcessExitName(exit)) + ",\"exitCode\":" + (agentProcessExitCode(exit) as String) + ",\"stdout\":" + lspQuote(stdout) + ",\"stderr\":" + lspQuote(stderr) + ",\"stdoutTruncated\":" + (stdoutTruncated ? "true" : "false") + ",\"stderrTruncated\":" + (stderrTruncated ? "true" : "false") + ",\"executed\":" + (phase.executed() ? "true" : "false") + "}"
        separator = ","
      end
      unit = unit.next
    end
    let cleaned = files::removeTree(directory)

    if cleaned.failure != null
      status = AnalysisStatus.unavailable()
      cleanupFailed = true
    end
    graph.refresh()
    if graph.snapshot != before
      return agentTestResponse(operationId, projectKey, before, AgentTestOutcome.conflict(), "Project inputs changed while tests ran; retry against the current graph.", unitsTotal, testsTotal, results, executed)
    end
    var outcome: readonly AgentTestOutcome = AgentTestOutcome.passed()
    var message = "All registered project tests completed successfully."

    if status.isInvalid()
      outcome = AgentTestOutcome.failed()
      message = "One or more registered project tests failed."
    else if status.isUnavailable()
      outcome = AgentTestOutcome.unavailable()
      message = "The registered project test run was incomplete."
    end
    if cleanupFailed
      message = "The registered project test run could not remove its temporary work directory."
    end
    return agentTestResponse(operationId, projectKey, before, outcome, message, unitsTotal, testsTotal, results, executed)
  end
end
