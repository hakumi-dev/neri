# Pure reanalysis of caller-supplied texts in an immutable project context.
class LspSnapshotAnalysis
  public semantic: SemanticModel?
  public sourceTexts: StringBuffer = new StringBuffer()
  public sourceStarts: IntBuffer = new IntBuffer()
end

def lspAnalyzeSnapshotTexts(snapshot: LspSemanticSnapshot, texts: StringBuffer): LspSnapshotAnalysis
  let result = new LspSnapshotAnalysis()
  var source = ""
  var index = 0
  while index < texts.size
    result.sourceStarts.add((new IrSourceMap(source)).utf16Length())
    let text = texts.get(index)
    result.sourceTexts.add(text)
    source = source + text + "\n"
    index = index + 1
  end
  let tokens = (new BootstrapLexer(source)).lex()
  let parser = new BootstrapParser(tokens)
  index = 0
  while index < result.sourceStarts.size
    parser.addSourceBoundary(result.sourceStarts.get(index))
    index = index + 1
  end
  let root = parser.parseProgram()
  if parser.diagnostics.count() != 0
    return result
  end
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
  binder.recordSourceSymbols = true
  binder.requireEntryPoint = snapshot.requireEntryPoint
  binder.forbiddenEntryPointSources = snapshot.forbiddenEntryPointSources
  binder.clearSources()
  index = 0
  while index < snapshot.sourceUris.size
    binder.addSource(snapshot.sourceUris.get(index), result.sourceStarts.get(index))
    index = index + 1
  end
  let semantic = binder.bind()
  if semantic.diagnostics.count() == 0
    result.semantic = semantic
  end
  return result
end
