use host

class AgentIntegerInput: AgentInputType
  private minimum: Int
  private maximum: Int?

  def init(minimum: Int, maximum: Int? = null): Void
    this.minimum = minimum
    this.maximum = maximum
  end

  def schema(): json::Json
    let schema = lspTypeSchema("integer").put("minimum", json::Json.integer(this.minimum))
    let maximum = this.maximum

    schema.put("maximum", json::Json.integer(maximum)) if maximum != null
    return schema
  end

  def valid(value: LspJson): Bool
    let parsed = agentInputInteger(value)

    let maximum = this.maximum

    return parsed != null && parsed >= this.minimum && (maximum == null || parsed <= maximum)
  end
end
