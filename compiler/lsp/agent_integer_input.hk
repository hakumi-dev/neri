use host

class AgentIntegerInput: AgentInputType
  private minimum: Int

  def init(minimum: Int): Void
    this.minimum = minimum
  end

  def schema(): String
    return "{\"type\":\"integer\",\"minimum\":" + (this.minimum as String) + "}"
  end

  def valid(value: LspJson): Bool
    let parsed = agentInputInteger(value)

    return parsed != null && parsed >= this.minimum
  end
end
