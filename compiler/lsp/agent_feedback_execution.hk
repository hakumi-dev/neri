use json

class AgentFeedbackExecution
  private requestId: String
  private mode: readonly AgentFeedbackExecutionKind
  private cause: String

  def init(requestId: String, mode: readonly AgentFeedbackExecutionKind, cause: String = ""): Void
    this.requestId = requestId
    this.mode = mode
    this.cause = cause
  end

  def write(output: json::Json): Void
    let execution = json::Json.object()

    execution.put("mode", json::Json.string(agentFeedbackExecutionName(this.mode)))
    execution.put("cause", json::Json.string(this.cause))
    output.put("execution", execution)
    output.put("requestId", json::Json.string(this.requestId)) if this.requestId != ""
  end
end
