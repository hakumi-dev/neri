class AgentDescribeTool: AgentToolDescriptor
  def init(): Void
    super("neri.describe", "Find typed semantic declarations and documentation across every unit in the project graph.", [new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes())), new AgentInputField("query", new AgentStringInput(1, 1024))])
  end

  def outputSchema(): String
    return agentDescribeOutputSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let request: AgentToolRequest = new AgentDescribeRequest(arguments.get("operationId").scalarText(), arguments.get("query").scalarText())

    return request
  end
end
