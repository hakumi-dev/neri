use host

sealed class AgentToolExecution
  private outcome: AgentToolOutcome

  private def init(outcome: AgentToolOutcome): Void
    this.outcome = outcome
  end

  static def unchanged(): AgentToolExecution
    return new AgentToolExecution(AgentToolOutcome.Unchanged())
  end

  static def failed(response: String): AgentToolExecution
    return new AgentToolExecution(AgentToolOutcome.Failed(response))
  end

  static def applied(fingerprint: String): AgentToolExecution
    return new AgentToolExecution(AgentToolOutcome.Applied(fingerprint))
  end

  def failure(): String?
    match this.outcome
      case AgentToolOutcome.Unchanged()
        return null
      case AgentToolOutcome.Failed(response)
        return response
      case AgentToolOutcome.Applied(fingerprint)
        return null
    end
  end

  def appliedFingerprint(): String?
    match this.outcome
      case AgentToolOutcome.Unchanged()
        return null
      case AgentToolOutcome.Failed(response)
        return null
      case AgentToolOutcome.Applied(fingerprint)
        return fingerprint
    end
  end
end
