use console
use host

class LspServer
  public rootPath: String = ""
  public unit: String = ""
  public documentationEnabled: Bool = true
  public codeStyleDiagnostics: Bool = true
  public sourceSymbolsEnabled: Bool = true
  public hoverMarkdown: Bool = false
  public completionMarkdown: Bool = false
  public completionSnippets: Bool = false
  public unnecessaryDiagnosticTags: Bool = false
  public codeActionLiterals: Bool = false
  public versionedWorkspaceEdits: Bool = false
  public nextAnalysisRevision: Int = 1
  public control: AnalysisControl?
  public stdlibDocumentation: LspJson?
  public initialized: Bool = false
  public shutdown: Bool = false
  public documents: LspDocument?
  public workspaceSymbols: LspWorkspaceSymbol?
  public workspaceSymbolsReady: Bool = false
  public priorityDocument: LspDocument?
  public declarationCatalog: LspDeclarationCatalog = new LspDeclarationCatalog()

  def init(catalogPath: String? = null): Void
    if catalogPath == null
      this.declarationCatalog = lspConfiguredDeclarationCatalog()
    else
      this.declarationCatalog = lspLoadDeclarationCatalog(catalogPath)
    end
  end

  def find(uri: String): LspDocument?
    var document = this.documents

    while document != null
      if document.uri == uri
        return document
      end
      document = document.next
    end
    return null
  end

  def publish(document: LspDocument, diagnostics: String): Void
    if !this.continueAnalysis()
      return
    end
    document.lastPublishedDiagnostics = diagnostics
    if !document.publishDiagnostics
      return
    end
    lspSend("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + lspQuote(document.uri) + ",\"version\":" + (document.version as String) + ",\"diagnostics\":" + diagnostics + "}}")
  end

  def findPath(path: String): LspDocument?
    var document = this.documents

    while document != null
      if this.resolveDocumentPath(document) == path
        return document
      end
      document = document.next
    end
    return null
  end

  def sourceUri(path: String): String
    let opened = this.findPath(path)

    if opened != null
      return opened.uri
    end
    return lspUri(path)
  end

  def resolveDocumentPath(document: LspDocument): String
    if document.sourcePath != ""
      return document.sourcePath
    end
    let candidate = lspPath(document.uri)

    if candidate == null
      return ""
    end
    let lexical = host::pathAbsolute(candidate)

    if lexical == null
      return ""
    end
    let canonical = neriCanonicalPath(lexical)

    document.sourcePath = lexical
    if canonical != null
      document.sourcePath = canonical
    end
    return document.sourcePath
  end

  # Return a project directory rather than a manifest filename.  The shared
  # loader then applies the canonical `manifest.json` preference, accepts the
  # legacy name, and can report two competing files as configuration error.
  # A workspace without either file is still a project: it is inferred from
  # the .hk files below its root.
  def generationManifestCandidate(source: String): Bool
    let parser = new LspJsonParser(source)
    let config = parser.parse()

    parser.spaces()
    return !parser.failed && parser.position == host::stringByteLength(source) && config.isObject() && config.get("version").isNumber() && config.get("version").scalarText() == "1" && config.get("generator").isString() && config.get("generator").scalarText() != "" && config.get("generatorVersion").isString() && config.get("generatorVersion").scalarText() != "" && config.get("inputs").isArray() && config.get("outputs").isArray()
  end

  def nearestProjectRoot(path: String): String
    let lexical = host::pathAbsolute(path)

    if lexical == null
      return ""
    end
    var absolute = lexical
    let canonical = neriCanonicalPath(lexical)

    if canonical != null
      absolute = canonical
    end
    if lspItoOriginalForSnapshot(absolute) != ""
      return ""
    end
    var boundary = ""

    if this.rootPath != ""
      let workspaceAbsolute = host::pathAbsolute(this.rootPath)
      var workspace = ""

      if workspaceAbsolute != null
        workspace = workspaceAbsolute
        let workspaceCanonical = neriCanonicalPath(workspaceAbsolute)

        if workspaceCanonical != null
          workspace = workspaceCanonical
        end
      end
      if workspace != "" && bootstrapPathWithin(workspace, absolute)
        boundary = workspace
      end
    end
    var directory = bootstrapDirectory(absolute)
    var nearest = ""
    var nestedManifest = ""
    var packageDirectory = directory

    while true
      if !this.continueAnalysis()
        return ""
      end
      if host::readText(packageDirectory + "/package.json") != null
        let itoManifest = packageDirectory + "/.neri/ito/manifest.json"

        if lspItoSnapshotSource(itoManifest, absolute) != "" || lspItoPackageSource(itoManifest, absolute)
          return itoManifest
        end
      end
      if boundary != "" && packageDirectory == boundary
        break
      end
      let parent = bootstrapDirectory(packageDirectory)

      if parent == packageDirectory
        break
      end
      packageDirectory = parent
    end

    while true
      if !this.continueAnalysis()
        return ""
      end
      let separator = directory == "/" ? "" : "/"
      let modern = directory + separator + "manifest.json"
      let legacy = directory + separator + "neri.json"
      let modernSource = host::readText(modern)
      let legacySource = host::readText(legacy)
      let hasModern = modernSource != null
      let hasLegacy = legacySource != null

      if hasModern || hasLegacy
        if nearest == ""
          # Two project filenames remain an error at the nearest boundary.
          if hasModern && hasLegacy
            return directory
          end
          nearest = directory
          nestedManifest = hasModern ? modern : legacy
          var candidateSource = ""

          if modernSource != null
            candidateSource = modernSource
          else
            if legacySource != null
              candidateSource = legacySource
            end
          end
          if !this.generationManifestCandidate(candidateSource)
            return directory
          end
        else
          # A generation manifest can use a project filename. Skip it only
          # when a valid ancestor project verifies both that manifest and this
          # generated output as members of the same unit snapshot.
          let owner = neriProjectForSource(directory, absolute, this.selectedUnit(directory), this.control)

          if !this.continueAnalysis()
            return ""
          end
          if owner.error() == "" && neriProjectListed(owner.generationManifests, nestedManifest) && neriProjectListed(owner.generatedOutputs, absolute)
            return directory
          end
        end
      end
      if boundary != "" && directory == boundary
        if nearest != ""
          return nearest
        end
        return directory
      end
      let parent = bootstrapDirectory(directory)

      if parent == directory
        return nearest
      end
      directory = parent
    end
    return ""
  end

  def selectedUnit(projectPath: String): String
    if this.unit == "" || this.rootPath == ""
      return ""
    end
    let workspacePath = lspPathOrEmpty(host::pathAbsolute(this.rootPath))
    var project = lspPathOrEmpty(host::pathAbsolute(projectPath))

    if neriProjectManifestName(project)
      project = bootstrapDirectory(project)
    end
    if workspacePath == project
      return this.unit
    end
    return ""
  end

  def reanalyze(): Void
    # Conservative invalidation: each open document sees the current in-memory
    # versions of all sources in its compilation unit.
    var document = this.documents

    while document != null
      document.dependencyPaths = null
      this.invalidate(document)
      document = document.next
    end
  end

  def documentUsesPath(document: LspDocument, path: String): Bool
    let dependencies = document.dependencyPaths

    # Unknown membership is conservatively invalidated until analysis succeeds.
    # Editing text preserves membership; open/close and watched files reset it.
    return dependencies == null || neriProjectListed(dependencies, path)
  end

  def reanalyzePath(path: String, primaryUri: String = ""): Void
    let absolute = host::pathAbsolute(path)
    var document = this.documents

    while document != null
      if document.uri == primaryUri || (absolute != null && this.documentUsesPath(document, absolute))
        this.invalidate(document)
      end
      document = document.next
    end
  end

  def invalidate(document: LspDocument): Void
    document.analysisPending = true
    document.sourcesReady = false
    document.analysisStatus = "unavailable"
    document.lastDiagnostics = null
    document.lastPublishedDiagnostics = "[]"
    document.semantic = null
    document.tokens = null
    document.syntax = null
    document.syntaxRoot = -1
    document.queryIndex = null
    document.querySnapshot = null
    document.analysisRevision = this.nextAnalysisRevision
    this.nextAnalysisRevision = this.nextAnalysisRevision + 1
    this.workspaceSymbolsReady = false
    this.workspaceSymbols = null
  end

  def ensureAnalyzed(document: LspDocument?): Void
    if document != null
      document.control = this.control
    end
    if document != null && document.analysisPending
      this.analyze(document)
    end
  end

  def pendingAnalysis(): LspDocument?
    let priority = this.priorityDocument

    if priority != null && priority.analysisPending
      return priority
    end
    var document = this.documents

    while document != null
      if document.analysisPending
        return document
      end
      document = document.next
    end
    return null
  end

  def ensureQueryPrepared(document: LspDocument): Void
    document.control = this.control
    if document.analysisPending && !document.sourcesReady
      this.analyze(document, true)
    end
  end

  def analyze(document: LspDocument, prepareOnly: Bool = false): Void
    document.control = this.control
    this.analyzeDocument(document, prepareOnly)
    let control = this.control

    if control != null && control.isCancelled()
      this.invalidate(document)
    end
  end

  def continueAnalysis(): Bool
    let control = this.control

    return control == null || control.poll()
  end

  def sendResult(id: String, result: String): Void
    if this.continueAnalysis()
      lspResult(id, result)
    end
  end

  def sendError(id: String, code: Int, message: String): Void
    if this.continueAnalysis()
      lspError(id, code, message)
    end
  end

  private def sameSourceNames(left: StringBuffer, right: StringBuffer): Bool
    if left.size != right.size
      return false
    end
    var index = 0

    while index < left.size
      if !this.continueAnalysis() || left.get(index) != right.get(index)
        return false
      end
      index = index + 1
    end
    return true
  end

  private def sameAnalysisSources(previous: LspSemanticSnapshot, document: LspDocument): Bool
    if previous.projectKey != document.projectKey || previous.requireEntryPoint != document.requireEntryPoint || previous.renameClosedWorld != document.renameClosedWorld
      return false
    end
    if !this.sameSourceNames(previous.sourceUris, document.sourceUris) || !this.sameSourceNames(previous.sourceTexts, document.sourceTexts) || !this.sameSourceNames(previous.forbiddenEntryPointSources, document.forbiddenEntryPointSources) || !this.sameSourceNames(previous.renameOwnedSourceUris, document.renameOwnedSourceUris)
      return false
    end
    if previous.sourceVersions.size != document.sourceVersions.size || previous.sourceStarts.size != document.sourceStarts.size
      return false
    end
    var index = 0

    while index < previous.sourceVersions.size
      if !this.continueAnalysis() || previous.sourceVersions.get(index) != document.sourceVersions.get(index) || previous.sourceStarts.get(index) != document.sourceStarts.get(index)
        return false
      end
      index = index + 1
    end
    return true
  end

  private def analyzeDocument(document: LspDocument, prepareOnly: Bool): Void
    if !this.continueAnalysis()
      return
    end
    var previousSources: LspSemanticSnapshot? = null

    if document.sourcesReady
      previousSources = lspNavigationSnapshot(document)
    end
    document.analysisPending = false
    document.sourcesReady = false
    # A failed parse or library load must not expose a previous version's model.
    document.analysisStatus = "unavailable"
    document.lastDiagnostics = null
    document.lastPublishedDiagnostics = "[]"
    document.semantic = null
    this.workspaceSymbolsReady = false
    this.workspaceSymbols = null
    document.queryIndex = null
    document.querySnapshot = null
    document.projectKey = document.uri
    document.sourceVersions = new IntBuffer()
    document.sourceVersions.add(document.version)
    document.renameClosedWorld = true
    document.renameOwnedSourceUris = new StringBuffer()
    document.renameOwnedSourceUris.add(document.uri)
    document.tokens = null
    document.syntax = null
    document.syntaxRoot = -1
    document.analysisRevision = this.nextAnalysisRevision
    this.nextAnalysisRevision = this.nextAnalysisRevision + 1
    document.stdlibDocumentation = this.stdlibDocumentation
    document.requireEntryPoint = true
    document.forbiddenEntryPointSources = new StringBuffer()
    var implicitProject = false
    let filePath = lspPath(document.uri)

    document.dependencyPaths = null
    document.generatedOrigins = null

    if filePath != null && !neriSourceNameValid(filePath)
      document.analysisStatus = "invalid"
      this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_FILE_NAME\",\"source\":\"neri\",\"message\":\".hk file names must not contain whitespace.\"}]")
      return
    end
    # Put the queried document first so its compiler ranges remain local.
    let sourceParts = new StringBuffer()
    var sourceLength = (new IrSourceMap(document.text)).utf16Length() + 1

    sourceParts.add(document.text + "\n")
    let starts = new IntBuffer()
    let ids = new StringBuffer()
    let texts = new StringBuffer()
    var loadedProject: NeriProject? = null

    document.sourceUris = ids
    document.sourceTexts = texts
    document.sourceStarts = starts
    let corePath = bootstrapCoreLibraryPath()
    var primaryId = document.uri

    if filePath != null
      let primaryPath = this.resolveDocumentPath(document)

      if corePath != null && primaryPath == corePath
        primaryId = "@stdlib/" + bootstrapCoreLibraryName() + ".hk"
        document.requireEntryPoint = false
      end
    end
    starts.add(0)
    ids.add(primaryId)
    texts.add(document.text)
    if filePath != null && primaryId == document.uri
      let lexical = host::pathAbsolute(filePath)

      if lexical != null
        let path = this.resolveDocumentPath(document)
        let original = lspItoOriginalForSnapshot(path)

        if original != ""
          this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":3,\"code\":\"NR_PROJECT_CONTEXT\",\"source\":\"neri\",\"message\":" + lspQuote("This is an Ito build snapshot. Open the live source: " + original) + "}]")
          return
        end
        let projectPath = this.nearestProjectRoot(lexical)

        if !this.continueAnalysis()
          return
        end
        if projectPath != ""
          let project = semanticEndsWith(projectPath, "/.neri/ito/manifest.json") ? lspItoProjectForSource(projectPath, path, this.unit, this.control) : neriProjectForSource(projectPath, path, this.selectedUnit(projectPath), this.control)

          if !this.continueAnalysis()
            return
          end
          loadedProject = project

          # An empty inferred workspace can still analyze its first unsaved
          # document. Once it is saved, discovery includes it on the next
          # analysis. Other implicit-project configuration errors stay visible.
          if project.error() != "" && !neriProjectErrorReasonIsEmptyImplicitProject(project.errorReason())
            this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_PROJECT\",\"source\":\"neri\",\"message\":" + lspQuote(project.error()) + "}]")
            if document.publishDiagnostics
              lspLog(project.error())
            end
            return
          end
          if !project.implicit && !neriProjectContains(project, path)
            this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":3,\"code\":\"NR_PROJECT_CONTEXT\",\"source\":\"neri\",\"message\":\"This source has no owning compilation unit in the project manifest; semantic analysis is unavailable.\"}]")
            return
          end
          if neriProjectContains(project, path)
            document.dependencyPaths = project.sources
            document.generatedOrigins = project.generatedOrigins
            var outputIndex = 0

            while outputIndex < project.generatedOutputs.size
              let outputPath = project.generatedOutputs.get(outputIndex)
              var outputOverlay = this.documents

              while outputOverlay != null
                if this.resolveDocumentPath(outputOverlay) == outputPath
                  let verified = neriProjectVerifiedText(project, outputPath)

                  if verified == null || outputOverlay.text != verified
                    this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_GENERATED\",\"source\":\"neri\",\"message\":\"A generated output has unsaved changes. Regenerate its artifacts before using the generated API.\"}]")
                    return
                  end
                end
                outputOverlay = outputOverlay.next
              end
              outputIndex = outputIndex + 1
            end
            var generationIndex = 0

            while generationIndex < project.generatedInputs.size
              let inputPath = project.generatedInputs.get(generationIndex)
              var overlay = this.documents

              while overlay != null
                if this.resolveDocumentPath(overlay) == inputPath && sha256FastText(overlay.text) != project.generatedDigests.get(generationIndex)
                  this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_GENERATED\",\"source\":\"neri\",\"message\":\"A generation input has unsaved changes. Save and regenerate its artifacts before using the generated API.\"}]")
                  return
                end
                overlay = overlay.next
              end
              generationIndex = generationIndex + 1
            end
            document.renameClosedWorld = projectUnitIsExecutable(project.kind)
            var ownIndex = 0

            while ownIndex < project.ownSources.size
              let ownPath = project.ownSources.get(ownIndex)

              if ownPath != path
                document.renameOwnedSourceUris.add(this.sourceUri(ownPath))
              end
              ownIndex = ownIndex + 1
            end
            var ownerIndex = 0

            while ownerIndex < project.sources.size
              if project.sources.get(ownerIndex) == path
                document.projectKey = project.sourceOwners.get(ownerIndex)
              end
              ownerIndex = ownerIndex + 1
            end
            implicitProject = project.implicit
            document.requireEntryPoint = projectUnitIsExecutable(project.kind)
            if projectUnitIsLibrary(project.kind)
              # Preserve the editor URI for the primary file, including aliases.
              document.forbiddenEntryPointSources.add(document.uri)
              var own = project.ownSources.first.nextNode

              while own != null
                document.forbiddenEntryPointSources.add(this.sourceUri(own.value))
                own = own.nextNode
              end
            end
            var reference = project.referenceSources.first.nextNode

            while reference != null
              document.forbiddenEntryPointSources.add(this.sourceUri(reference.value))
              reference = reference.nextNode
            end
            var entry = project.sources.first.nextNode

            while entry != null
              if !this.continueAnalysis()
                return
              end
              if entry.value != path
                let opened = this.findPath(entry.value)
                var text: String? = null

                if neriProjectListed(project.generatedOutputs, entry.value)
                  text = neriProjectVerifiedText(project, entry.value)
                else if opened != null
                  text = opened.text
                else
                  text = neriProjectVerifiedText(project, entry.value)
                end
                if text == null
                  this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_SOURCE_UNAVAILABLE\",\"source\":\"neri\",\"message\":" + lspQuote("Cannot read project source: " + entry.value) + "}]")
                  if document.publishDiagnostics
                    lspLog("Cannot read project source: " + entry.value)
                  end
                  return
                end
                starts.add(sourceLength)
                ids.add(this.sourceUri(entry.value))
                texts.add(text)
                var sourceVersion = -1

                if opened != null
                  sourceVersion = opened.version
                end
                document.sourceVersions.add(sourceVersion)
                sourceParts.add(text + "\n")
                sourceLength = sourceLength + (new IrSourceMap(text)).utf16Length() + 1
              end
              entry = entry.nextNode
            end
          end
        end
      end
    end
    var source = sourceParts.join()
    var pendingLibraries = true
    let libraryDirectory = host::environment("NERI_STDLIB")
    var libraryRoot = ""

    if libraryDirectory != null
      libraryRoot = libraryDirectory
    end
    let libraries = new StandardLibraryCatalog(libraryRoot)
    let libraryReferences = new BootstrapLibraryReferences()

    libraryReferences.control = this.control
    libraryReferences.addSource(source)

    while pendingLibraries
      if !this.continueAnalysis()
        return
      end
      pendingLibraries = false
      let directory = host::environment("NERI_STDLIB")

      for library in libraryReferences.libraryNames()
        if !this.continueAnalysis()
          return
        end
        let paths = libraries.sourcePaths(library)
        var path = paths.first.nextNode

        while path != null
          var supplied = false
          var sourceIndex = 0

          while sourceIndex < ids.size
            if ids.get(sourceIndex) == "@stdlib/" + path.value
              supplied = true
            end
            sourceIndex = sourceIndex + 1
          end
          if directory != null && !supplied
            let libraryPath = directory + "/" + path.value
            let project = loadedProject
            var text: String? = null

            if project == null
              text = host::readText(libraryPath)
            else
              text = neriProjectVerifiedText(project, libraryPath)
            end

            if text != null
              starts.add(sourceLength)
              ids.add("@stdlib/" + path.value)
              texts.add(text)
              document.sourceVersions.add(-1)
              sourceParts.add(text + "\n")
              libraryReferences.addSource(text)
              sourceLength = sourceLength + (new IrSourceMap(text)).utf16Length() + 1
              pendingLibraries = true
            else
              libraries.error = "Standard-library source is unavailable: " + libraryPath
            end
          end
          path = path.nextNode
        end
      end
      if pendingLibraries
        source = sourceParts.join()
      end
    end
    var coreLoaded = false
    var coreIndex = 0

    while coreIndex < ids.size
      if ids.get(coreIndex) == "@stdlib/" + bootstrapCoreLibraryName() + ".hk"
        coreLoaded = true
      end
      coreIndex = coreIndex + 1
    end
    if !coreLoaded || libraries.error != ""
      let message = libraries.error != "" ? libraries.error : "Required standard library core is unavailable."

      this.publish(document, "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_STDLIB\",\"source\":\"neri\",\"message\":" + lspQuote(message) + "}]")
      if document.publishDiagnostics
        lspLog(message)
      end
      return
    end
    if !this.continueAnalysis()
      return
    end
    document.sourcesReady = true
    # The generation identifies verified inputs, not the amount of semantic
    # work completed. Idle diagnostics may finish the same prepared generation.
    if previousSources != null && this.sameAnalysisSources(previousSources, document)
      document.analysisRevision = previousSources.projectRevision
    end
    if prepareOnly
      document.analysisPending = true
      return
    end
    let lexer = new BootstrapLexer(source)

    lexer.control = this.control
    let tokens = lexer.lex()
    let parser = new BootstrapParser(tokens)
    var index = 0

    if !this.continueAnalysis()
      return
    end
    parser.control = this.control
    while index < starts.size
      parser.addSourceBoundary(starts.get(index))
      index = index + 1
    end
    let root = parser.parseProgram()

    if !this.continueAnalysis()
      return
    end
    document.tokens = tokens
    document.syntax = parser.arena
    document.syntaxRoot = root
    var diagnostics = parser.diagnostics

    if diagnostics.count() == 0
      let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

      binder.control = this.control
      binder.recordSourceSymbols = this.sourceSymbolsEnabled
      binder.requireEntryPoint = document.requireEntryPoint
      binder.forbiddenEntryPointSources = document.forbiddenEntryPointSources
      binder.clearSources()
      index = 0
      while index < starts.size
        binder.addSource(ids.get(index), starts.get(index))
        index = index + 1
      end
      let semantic = binder.bind()

      if !this.continueAnalysis()
        return
      end
      document.semantic = semantic
      diagnostics = semantic.diagnostics
    end
    document.lastDiagnostics = diagnostics
    document.analysisStatus = diagnostics.count() == 0 ? "valid" : "invalid"
    var result = "["
    var separator = ""

    index = 0
    while index < diagnostics.count()
      let start = diagnostics.starts.get(index)

      if starts.size == 1 || start < starts.get(1)
        let code = diagnostics.codes.get(index)
        let message = diagnostics.messages.get(index) + (implicitProject ? neriImplicitProjectHint(code) : "")

        result = result + separator + "{\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + diagnostics.lengths.get(index)) + "},\"severity\":1,\"code\":" + lspQuote(code) + ",\"source\":\"neri\",\"message\":" + lspQuote(message) + "}"
        separator = ","
      else
        var sourceIndex = 0

        while sourceIndex + 1 < starts.size && starts.get(sourceIndex + 1) <= start
          sourceIndex = sourceIndex + 1
        end
        if diagnostics.codes.get(index) == "NR_PROJECT_ENTRY" && neriProjectListed(document.forbiddenEntryPointSources, ids.get(sourceIndex))
          result = result + separator + "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"code\":\"NR_PROJECT_ENTRY\",\"source\":\"neri\",\"message\":" + lspQuote(diagnostics.messages.get(index)) + "}"
          separator = ","
        else if bootstrapStartsWith(ids.get(sourceIndex), "@stdlib/")
          if document.publishDiagnostics
            lspLog("Neri standard library diagnostic: " + diagnostics.messages.get(index))
          end
        end
      end
      index = index + 1
    end
    let semantic = document.semantic

    if this.sourceSymbolsEnabled && semantic != null && diagnostics.count() == 0
      let primaryEnd = starts.size == 1 ? -1 : starts.get(1)
      let unused = lspUnusedUseDiagnostics(document, semantic, primaryEnd, this.unnecessaryDiagnosticTags)

      if unused != ""
        result = result + separator + unused
        separator = ","
      end
    end
    let style = this.codeStyleDiagnostics ? lspCodeStyleDiagnostics(document) : ""

    if style != ""
      result = result + separator + style
    end
    this.publish(document, result + "]")
  end

  def handle(message: LspJson): Bool
    let method = message.get("method")
    let requestId = message.get("id")
    let request = !requestId.isMissing()
    var id = "null"

    if requestId.isString()
      id = lspQuote(requestId.scalarText())
    else if requestId.isNumber() && host::parseInt(requestId.scalarText()) != null
      id = requestId.scalarText()
    else if request
      this.sendError("null", -32600, "Invalid request id")
      return true
    end
    if !message.isObject() || message.get("jsonrpc").scalarText() != "2.0" || !method.isString()
      this.sendError(id, -32600, "Invalid request")
      return true
    end
    if method.scalarText() == "exit"
      host::exit(this.shutdown ? 0 : 1)
      return false
    end
    if method.scalarText() == "initialize" && request && !this.initialized
      this.initialized = true
      let params = message.get("params")
      let root = lspPath(params.get("rootUri").scalarText())

      if root != null
        this.rootPath = root
      end
      let initializationOptions = params.get("initializationOptions")
      let unit = initializationOptions.get("unit")

      if unit.isString()
        this.unit = unit.scalarText()
      end
      let documentation = initializationOptions.get("documentation")
      let styleDiagnostics = initializationOptions.get("codeStyleDiagnostics")

      if styleDiagnostics.isFalse()
        this.codeStyleDiagnostics = false
      end
      if documentation.isFalse()
        this.documentationEnabled = false
      end
      let textCapabilities = params.get("capabilities").get("textDocument")

      this.hoverMarkdown = lspJsonArrayContains(textCapabilities.get("hover").get("contentFormat"), "markdown")
      this.completionMarkdown = lspJsonArrayContains(textCapabilities.get("completion").get("completionItem").get("documentationFormat"), "markdown")
      this.completionSnippets = textCapabilities.get("completion").get("completionItem").get("snippetSupport").isTrue()
      this.unnecessaryDiagnosticTags = lspJsonArrayContainsNumber(textCapabilities.get("publishDiagnostics").get("tagSupport").get("valueSet"), "1")
      this.versionedWorkspaceEdits = params.get("capabilities").get("workspace").get("workspaceEdit").get("documentChanges").isTrue()
      this.codeActionLiterals = this.versionedWorkspaceEdits && textCapabilities.get("codeAction").get("codeActionLiteralSupport").get("codeActionKind").get("valueSet").isArray()
      this.stdlibDocumentation = lspLoadStdlibDocumentation()
      let actions = (this.codeActionLiterals ? ",\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\",\"source.organizeImports\",\"source.fixAll.neri\"]}" : "") + ",\"workspaceSymbolProvider\":true,\"typeDefinitionProvider\":true,\"documentFormattingProvider\":true"
      let rename = this.versionedWorkspaceEdits ? ",\"renameProvider\":{\"prepareProvider\":true}" : ""
      let onType = ",\"documentOnTypeFormattingProvider\":{\"firstTriggerCharacter\":\"\\n\"},\"experimental\":{\"sourceOriginProvider\":true}"

      this.sendResult(id, "{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"documentSymbolProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\" \",\":\",\")\",\"(\",\",\"],\"resolveProvider\":true},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"textDocumentSync\":{\"openClose\":true,\"change\":2}" + actions + rename + onType + "},\"serverInfo\":{\"name\":\"neri\",\"version\":" + lspQuote(neriVersion()) + "}}")
      if this.declarationCatalog.error != ""
        lspSend("{\"jsonrpc\":\"2.0\",\"method\":\"window/showMessage\",\"params\":{\"type\":1,\"message\":" + lspQuote(this.declarationCatalog.error) + "}}")
      end
      return true
    end
    if !this.initialized || this.shutdown
      if request
        this.sendError(id, this.shutdown ? -32600 : -32002, this.shutdown ? "Server has shut down" : "Server not initialized")
      end
      return true
    end
    if method.scalarText() == "shutdown" && request
      this.shutdown = true
      this.sendResult(id, "null")
      return true
    end
    if method.scalarText() == "workspace/symbol" && request
      let query = message.get("params").get("query")

      if !query.isString()
        this.sendError(id, -32602, "Expected a symbol query")
      else
        this.sendResult(id, lspWorkspaceSymbols(this, query.scalarText()))
      end
      return true
    end
    if method.scalarText() == "textDocument/onTypeFormatting" && request
      let params = message.get("params")
      let document = this.find(params.get("textDocument").get("uri").scalarText())
      let tabSizeValue = params.get("options").get("tabSize")
      let tabSize = host::parseInt(tabSizeValue.scalarText())
      let spaces = params.get("options").get("insertSpaces")

      if document == null || params.get("ch").scalarText() != "\n"
        this.sendResult(id, "[]")
        return true
      end
      let position = lspByteOffset(document.text, params.get("position"))

      if position < 0 || !tabSizeValue.isNumber() || tabSize == null || tabSize <= 0 || tabSize > 32 || !spaces.isBoolean()
        this.sendError(id, -32602, "Invalid on-type formatting position or options")
      else
        this.sendResult(id, lspOnEnter(document.text, position, tabSize, spaces.isTrue()))
      end
      return true
    end
    if method.scalarText() == "textDocument/formatting" && request
      let document = this.find(message.get("params").get("textDocument").get("uri").scalarText())

      if document == null
        this.sendResult(id, "[]")
      else
        this.sendResult(id, lspCodeStyleFormatting(document))
      end
      return true
    end
    if method.scalarText() == "textDocument/codeAction" && request
      let params = message.get("params")
      let document = this.find(params.get("textDocument").get("uri").scalarText())

      this.ensureAnalyzed(document)

      if !this.codeActionLiterals || document == null
        this.sendResult(id, "[]")
        return true
      end
      let start = lspByteOffset(document.text, params.get("range").get("start"))
      let finish = lspByteOffset(document.text, params.get("range").get("end"))

      if start < 0 || finish < start
        this.sendError(id, -32602, "Invalid document range")
        return true
      end
      let only = params.get("context").get("only")
      let all = only.isMissing()
      let quickFix = all || lspJsonArrayContains(only, "") || lspJsonArrayContains(only, "quickfix")
      let organize = all || lspJsonArrayContains(only, "") || lspJsonArrayContains(only, "source") || lspJsonArrayContains(only, "source.organizeImports")
      let fixAll = all || lspJsonArrayContains(only, "") || lspJsonArrayContains(only, "source") || lspJsonArrayContains(only, "source.fixAll") || lspJsonArrayContains(only, "source.fixAll.neri")
      let startPosition = (new IrSourceMap(host::stringSlice(document.text, 0, start))).utf16Length()
      let endPosition = (new IrSourceMap(host::stringSlice(document.text, 0, finish))).utf16Length()
      let imports = lspUnusedUseActions(document, startPosition, endPosition, quickFix, organize)
      let style = lspCodeStyleActions(document, startPosition, endPosition, quickFix, fixAll)

      this.sendResult(id, lspJoinActionArrays(imports, style))
      return true
    end
    if (method.scalarText() == "textDocument/prepareRename" || method.scalarText() == "textDocument/rename") && request
      let params = message.get("params")
      let document = this.find(params.get("textDocument").get("uri").scalarText())

      this.ensureAnalyzed(document)

      if !this.versionedWorkspaceEdits || document == null
        this.sendResult(id, "null")
        return true
      end
      let offset = lspByteOffset(document.text, params.get("position"))

      if offset < 0
        this.sendError(id, -32602, "Invalid document position")
        return true
      end
      let position = (new IrSourceMap(host::stringSlice(document.text, 0, offset))).utf16Length()
      let snapshot = lspNavigationSnapshot(document)
      var result = lspPrepareRename(snapshot, position)

      if method.scalarText() == "textDocument/rename"
        if !params.get("newName").isString()
          this.sendError(id, -32602, "Expected a new identifier")
          return true
        end
        result = lspRename(snapshot, position, params.get("newName").scalarText())
      end
      if result.error != ""
        this.sendError(id, -32803, result.error)
      else
        this.sendResult(id, result.value)
      end
      return true
    end
    if method.scalarText() == "textDocument/documentSymbol" && request
      let document = this.find(message.get("params").get("textDocument").get("uri").scalarText())

      this.ensureAnalyzed(document)

      if document == null
        this.sendResult(id, "[]")
      else
        this.sendResult(id, lspDocumentSymbols(document))
      end
      return true
    end
    if method.scalarText() == "completionItem/resolve" && request
      let item = message.get("params")
      let uri = item.get("data").get("uri")
      var document: LspDocument? = null

      if uri.isString()
        document = this.find(uri.scalarText())
      end
      this.sendResult(id, lspResolveCompletion(document, item, this.documentationEnabled, this.completionMarkdown))
      return true
    end
    if (method.scalarText() == "textDocument/hover" || method.scalarText() == "textDocument/definition" || method.scalarText() == "neri/sourceOrigin" || method.scalarText() == "textDocument/typeDefinition" || method.scalarText() == "textDocument/references" || method.scalarText() == "textDocument/documentHighlight" || method.scalarText() == "textDocument/completion" || method.scalarText() == "textDocument/signatureHelp") && request
      let params = message.get("params")
      let document = this.find(params.get("textDocument").get("uri").scalarText())

      if document == null
        this.sendResult(id, "null")
      else
        let offset = lspByteOffset(document.text, params.get("position"))

        if offset < 0
          this.sendError(id, -32602, "Invalid document position")
        else
          let position = (new IrSourceMap(host::stringSlice(document.text, 0, offset))).utf16Length()

          if method.scalarText() == "textDocument/completion"
            if !lspCompletionTriggerApplies(document, position, params.get("context"), this.declarationCatalog)
              this.sendResult(id, "[]")
              return true
            end
            let declaration = lspDeclarationCompletion(document, position, this.completionSnippets, this.declarationCatalog)

            if declaration != null
              this.sendResult(id, declaration)
              return true
            end
          end
          if method.scalarText() == "textDocument/completion"
            this.ensureQueryPrepared(document)
          else
            this.ensureAnalyzed(document)
          end
          if method.scalarText() == "textDocument/references"
            this.sendResult(id, lspReferences(document, position, params.get("context").get("includeDeclaration").isTrue()))
          else if method.scalarText() == "neri/sourceOrigin"
            this.sendResult(id, lspSourceOrigin(document, position))
          else if method.scalarText() == "textDocument/typeDefinition"
            this.sendResult(id, lspTypeDefinition(document, position))
          else if method.scalarText() == "textDocument/documentHighlight"
            this.sendResult(id, lspHighlights(document, position))
          else if method.scalarText() == "textDocument/completion"
            this.sendResult(id, !document.sourcesReady ? "[]" : lspCompletion(document, position, this.completionSnippets))
          else if method.scalarText() == "textDocument/signatureHelp"
            this.sendResult(id, lspSignatureHelp(document, position))
          else
            this.sendResult(id, method.scalarText() == "textDocument/hover" ? lspHover(document, position, this.documentationEnabled, this.hoverMarkdown) : lspDefinition(document, position))
          end
        end
      end
      return true
    end
    if request
      this.sendError(id, -32601, "Method not found")
      return true
    end
    let params = message.get("params")
    let item = params.get("textDocument")
    let uri = item.get("uri")

    if method.scalarText() == "workspace/didChangeWatchedFiles"
      this.workspaceSymbolsReady = false
      this.workspaceSymbols = null
      this.stdlibDocumentation = lspLoadStdlibDocumentation()
      this.reanalyze()
      return true
    end
    if method.scalarText() == "textDocument/didClose"
      this.workspaceSymbolsReady = false
      this.workspaceSymbols = null
      var previous: LspDocument? = null
      var current = this.documents

      while current != null
        if current.uri == uri.scalarText()
          this.publish(current, "[]")
          this.priorityDocument = null
          if previous == null
            this.documents = current.next
          else
            previous.next = current.next
          end
          this.reanalyze()
          return true
        end
        previous = current
        current = current.next
      end
    else if method.scalarText() == "textDocument/didOpen" || method.scalarText() == "textDocument/didChange"
      if !uri.isString() || uri.scalarText() == ""
        return true
      end
      let versionNode = item.get("version")
      let version = host::parseInt(versionNode.scalarText())

      if !versionNode.isNumber() || version == null
        return true
      end
      var document = this.find(uri.scalarText())
      var text = item.get("text")

      if method.scalarText() == "textDocument/didChange"
        if document == null || version <= document.version
          return true
        end
        text = lspApplyChanges(document.text, params.get("contentChanges"))
        if !text.isString()
          lspLog("Neri LSP rejected invalid document changes; the document and version were preserved.")
          return true
        end
      else if document != null
        return true
      end
      if !text.isString()
        return true
      end
      if document == null
        let opened = new LspDocument()

        opened.uri = uri.scalarText()
        opened.next = this.documents
        this.documents = opened
        document = opened
      end
      let current = document

      if current != null
        current.text = text.scalarText()
        current.version = version
        this.priorityDocument = current
        let changedPath = this.resolveDocumentPath(current)

        if method.scalarText() == "textDocument/didOpen" && changedPath != ""
          this.reanalyze()
        else if changedPath == ""
          this.invalidate(current)
        else
          this.reanalyzePath(changedPath, current.uri)
        end
      end
    end
    return true
  end
end
