enum ProjectUnitKind
  case Executable()
  case Library()
end

def projectUnitKindFromName(name: String): ProjectUnitKind?
  if name == "executable"
    return ProjectUnitKind.Executable()
  end
  if name == "library"
    return ProjectUnitKind.Library()
  end
  return null
end

def projectUnitKindName(kind: ProjectUnitKind?): String
  if kind == null
    return ""
  end
  match kind
    case ProjectUnitKind.Executable()
      return "executable"
    case ProjectUnitKind.Library()
      return "library"
  end
end

def projectUnitKindFromJson(node: LspJson): ProjectUnitKind?
  let name = node.stringValue()

  if name == null
    return null
  end
  return projectUnitKindFromName(name)
end

def projectUnitIsExecutable(kind: ProjectUnitKind?): Bool
  if kind == null
    return false
  end
  match kind
    case ProjectUnitKind.Executable()
      return true
    case ProjectUnitKind.Library()
      return false
  end
end

def projectUnitIsLibrary(kind: ProjectUnitKind?): Bool
  if kind == null
    return false
  end
  match kind
    case ProjectUnitKind.Executable()
      return false
    case ProjectUnitKind.Library()
      return true
  end
end
