sealed class AgentProcessOutcome
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def notStarted(): AgentProcessOutcome
    return new AgentProcessOutcome(0)
  end

  static def unavailable(): AgentProcessOutcome
    return new AgentProcessOutcome(1)
  end

  static def completed(): AgentProcessOutcome
    return new AgentProcessOutcome(2)
  end

  static def timeout(): AgentProcessOutcome
    return new AgentProcessOutcome(3)
  end

  readonly def started(): Bool
    return this.tag != 0
  end

  readonly def isUnavailable(): Bool
    return this.tag == 0 || this.tag == 1
  end

  readonly def isCompleted(): Bool
    return this.tag == 2
  end

  readonly def isTimeout(): Bool
    return this.tag == 3
  end
end
