use console
use host

# State is an integrity-checked optimization. It does not authenticate the file's
# author or replace analysis of inputs that no longer match.
def agentFeedbackStateDigest(scope: String, inputs: String, report: String): String
  return sha256FastText(runCacheFrame("2") + runCacheFrame(scope) + runCacheFrame(inputs) + runCacheFrame(report))
end

def agentFeedbackCachedState(record: LspJson, scope: String, projectScope: Bool): String?
  if !record.isObject()
    return null
  end
  var version = false
  var storedScope = false
  var inputs = false
  var report = false
  var digest = false
  var field = record.first

  while field != null
    if field.key == "version" && !version
      version = true
    else if field.key == "scope" && !storedScope
      storedScope = true
    else if field.key == "inputs" && !inputs
      inputs = true
    else if field.key == "report" && !report
      report = true
    else if field.key == "digest" && !digest
      digest = true
    else
      return null
    end
    field = field.next
  end
  let cachedReport = record.get("report")

  if !version || !storedScope || !inputs || !report || !digest || !record.get("version").isNumber() || record.get("version").scalarText() != "2" || !record.get("scope").isString() || (!projectScope && record.get("scope").scalarText() != scope) || !record.get("inputs").isString() || record.get("inputs").scalarText() == "" || !record.get("digest").isString()
    return null
  end
  if projectScope
    if !agentCachedProjectReport(cachedReport)
      return null
    end
  else if !cachedReport.isNull()
    return null
  end
  let rendered = lspJsonStringify(cachedReport)

  if record.get("digest").scalarText() != agentFeedbackStateDigest(record.get("scope").scalarText(), record.get("inputs").scalarText(), rendered)
    return null
  end
  return rendered
end

# The CLI selects transport and cache policy. Analysis stays in the shared session.
def agentFeedbackMain(): Void
  var root = "."
  var unit = ""
  var state = ""
  var operation = "feedback"
  var hook = false
  var index = 1

  while index < host::argumentCount()
    let argument = host::argumentAt(index)

    if argument != null && argument == "--codex-hook"
      hook = true
      index = index + 1
    else if argument != null && (argument == "--project" || argument == "--unit" || argument == "--state" || argument == "--operation") && index + 1 < host::argumentCount()
      let value = host::argumentAt(index + 1)

      if value == null || value == ""
        agentFeedbackUsage()
        return
      end
      if argument == "--project"
        root = value
      else if argument == "--unit"
        unit = value
      else if argument == "--state"
        state = value
      else
        operation = value
      end
      index = index + 2
    else
      agentFeedbackUsage()
      return
    end
  end
  let absolute = neriCanonicalPath(root)
  let limits = new AgentLimits()

  if absolute == null || host::stringByteLength(operation) > limits.operationIdBytes() || (state != "" && !hook)
    agentFeedbackUsage()
    return
  end
  let adapter = new AgentFeedbackHook()

  if hook
    if !adapter.read()
      console::println(adapter.output("{\"status\":\"unavailable\",\"message\":\"Invalid or oversized PostToolUse hook input.\"}"))
      return
    end
    operation = adapter.operationId
  end
  var previous = ""
  var previousReport = ""
  var sameDelivery = false
  let scope = adapter.scope(absolute, unit)

  if hook && state != "" && (unit == "" || scope != "")
    let stored = host::readText(state)

    if stored != null && host::stringByteLength(stored) <= (new AgentLimits()).messageBytes()
      let parser = new LspJsonParser(stored)
      let record = parser.parse()

      parser.spaces()
      let cached = agentFeedbackCachedState(record, scope, unit == "")

      if !parser.failed && parser.position == host::stringByteLength(stored) && cached != null
        previous = record.get("inputs").scalarText()
        if unit == ""
          previousReport = cached
          sameDelivery = scope != "" && record.get("scope").scalarText() == scope
        end
      end
    end
  end
  var feedback = ""
  var inputs = ""
  var report = "null"

  if unit == ""
    let project = new AgentProjectFeedback(absolute)

    feedback = project.collect(operation, previous, previousReport, sameDelivery)
    inputs = project.inputs
    if project.report != ""
      report = project.report
    end
  else
    let compilerBefore = agentCompilerIdentity()
    let session = new AgentFeedbackSession(absolute, unit)

    feedback = session.collect(operation, previous, compilerBefore)
    inputs = session.inputs
    let compilerAfter = agentCompilerIdentity()

    if compilerBefore == null || compilerAfter == null || compilerBefore != compilerAfter
      inputs = ""
      if feedback == ""
        feedback = (new AgentFeedbackSession(absolute, unit)).collect(operation, "", null)
      end
    end
  end

  if feedback == ""
    console::println("{}")
    return
  end
  console::println(hook ? adapter.output(feedback) : feedback)
  if hook && state != "" && (unit == "" || scope != "") && inputs != ""
    # A lost or partial cache write causes another report, never stale analysis.
    let digest = agentFeedbackStateDigest(scope, inputs, report)

    host::writeText(state, "{\"version\":2,\"scope\":" + lspQuote(scope) + ",\"inputs\":" + lspQuote(inputs) + ",\"report\":" + report + ",\"digest\":" + lspQuote(digest) + "}")
  end
end

def agentFeedbackUsage(): Void
  console::println("Usage: neri feedback --project ROOT [--unit UNIT] [--operation ID] [--codex-hook [--state FILE]]")
  host::exit(2)
end
