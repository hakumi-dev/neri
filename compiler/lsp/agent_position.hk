use host

class AgentPosition
  private storedLine: Int
  private storedCharacter: Int

  def init(line: Int, character: Int): Void
    this.storedLine = line
    this.storedCharacter = character
  end

  def line(): Int
    return this.storedLine
  end

  def character(): Int
    return this.storedCharacter
  end
end
