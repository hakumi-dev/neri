sealed class LspTemplateContext
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def global(): LspTemplateContext
    return new LspTemplateContext(0)
  end

  readonly def isGlobal(): Bool
    return this.tag == 0
  end

  static def classScope(): LspTemplateContext
    return new LspTemplateContext(1)
  end

  readonly def isClass(): Bool
    return this.tag == 1
  end

  static def fromName(name: String): LspTemplateContext?
    if name == "global"
      return LspTemplateContext.global()
    end
    if name == "class"
      return LspTemplateContext.classScope()
    end
    return null
  end

  readonly def matches(inClass: Bool): Bool
    return this.isClass() == inClass
  end
end
