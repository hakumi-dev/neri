use json

class AgentArrayInput: AgentInputType
  private item: AgentInputType
  private minimum: Int
  private maximum: Int

  def init(item: AgentInputType, minimum: Int, maximum: Int): Void
    this.item = item
    this.minimum = minimum
    this.maximum = maximum
  end

  def schema(): json::Json
    let schema = lspTypeSchema("array")

    schema.put("items", this.item.schema())
    schema.put("minItems", json::Json.integer(this.minimum))
    schema.put("maxItems", json::Json.integer(this.maximum))
    return schema
  end

  def valid(value: LspJson): Bool
    if !value.isArray()
      return false
    end
    var count = 0
    var child = value.first

    while child != null
      count = count + 1
      if count > this.maximum || !this.item.valid(child)
        return false
      end
      child = child.next
    end
    return count >= this.minimum
  end
end
