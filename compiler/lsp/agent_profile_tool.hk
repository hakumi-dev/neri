class AgentProfileTool: AgentToolDescriptor
  def init(): Void
    super("neri.profile", "Build every unit in the project graph with bounded process output and phase timings. Reports snapshots, cache observations and artifacts; never runs an application.", [new AgentInputField("operationId", new AgentStringInput(1, (new AgentLimits()).operationIdBytes()))])
  end

  def outputSchema(): String
    return agentProfileOutputSchema()
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let request: AgentToolRequest = new AgentProfileRequest(arguments.get("operationId").scalarText())

    return request
  end
end
