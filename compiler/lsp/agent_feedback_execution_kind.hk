enum AgentFeedbackExecutionKind
  case Persistent()
  case FreshFallback()
end

def agentFeedbackExecutionName(kind: readonly AgentFeedbackExecutionKind): String
  match kind
    case AgentFeedbackExecutionKind.Persistent()
      return "persistent"
    case AgentFeedbackExecutionKind.FreshFallback()
      return "fresh-fallback"
  end
end
