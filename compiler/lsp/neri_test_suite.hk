use host

class NeriTestSuite
  public units: StringBuffer = new StringBuffer()
  public error: String = ""

  def init(path: String): Void
    let source = host::readText(path)

    if source == null
      this.error = "Cannot read test suite: " + path
      return
    end
    let parser = new LspJsonParser(source)
    let config = parser.parse()

    parser.spaces()
    if parser.failed || parser.position != host::stringByteLength(source) || !config.isObject()
      this.error = "Test suite must contain one JSON object: " + path
      return
    end
    let keys = new StringTable<Bool>()
    var field = config.first

    while field != null
      if (field.key != "version" && field.key != "units") || !keys.add(field.key, true)
        this.error = "Test suite has an unknown or duplicate key: " + field.key
        return
      end
      field = field.next
    end
    let version = config.get("version")
    let declared = config.get("units")

    if !version.isNumber() || version.scalarText() != "1" || !declared.isArray()
      this.error = "Test suite requires version 1 and a units array: " + path
      return
    end
    let names = new StringTable<Bool>()
    var unit = declared.first

    while unit != null
      if !unit.isString() || unit.scalarText() == ""
        this.error = "Test suite units must contain nonempty names: " + path
        return
      end
      let name = unit.scalarText()

      if !names.add(name, true)
        this.error = "Duplicate test suite unit: " + name
        return
      end
      this.units.add(name)
      unit = unit.next
    end
  end
end
