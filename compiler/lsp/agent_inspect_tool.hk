use host

class AgentInspectTool: AgentToolDescriptor
  def init(): Void
    super("neri.inspect", "Inspect the source at a UTF-16 position using the expected workspace revision; returns bounded context and diagnostics.", agentInspectFields())
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    let expected = agentInputInteger(arguments.get("expectedRevision"))
    let position = agentDecodedPosition(arguments.get("position"))

    if expected == null || position == null
      return null
    end
    let request: AgentToolRequest = new AgentInspectRequest(arguments.get("operationId").value, arguments.get("uri").value, expected, position)

    return request
  end
end
