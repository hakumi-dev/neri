use result
use host

# The hook renders actionable units; the API and persisted cache retain the
# complete report. Delivery identity is handled before this presentation step.
def agentHookProjectFeedback(report: json::Value): json::Json
  let output = json::Json.object()

  output.put("schemaVersion", json::Json.integer(2))
  output.put("view", json::Json.string("diagnostics"))
  report.each() do |key, value|
    if key != null && key != "units" && key != "schemaVersion"
      output.put(key, new json::Json(value))
    end
  end
  let cursor = report.get("nextCursor")
  let root = report.get("projectKey")
  let snapshot = report.get("snapshot")
  let executable = agentCompilerExecutable()

  if cursor != null && root != null && snapshot != null && executable != null
    let token = cursor.text()
    let project = root.text()
    let version = snapshot.text()

    if token != null && token != "" && project != null && version != null
      let parsed = (new LspJsonParser(token)).parse()
      let size = parsed.get("pageSize").scalarText()

      output.put(
        "nextCommand",
        json::Json.string(agentFeedbackShellQuote(executable) + " feedback --project " + agentFeedbackShellQuote(project) + " --expected-snapshot " + agentFeedbackShellQuote(version) + " --cursor " + agentFeedbackShellQuote(token) + " --page-size " + size)
      )
    end
  end
  let units = json::Json.array()
  let all = report.get("units")

  if all != null
    all.each() do |key, unit|
      let count = unit.get("diagnosticCount")
      let truncated = unit.get("diagnosticsTruncated")
      let status = unit.get("status")
      let hasDiagnostics = count != null && count.text() != "0"
      let incomplete = truncated != null && truncated.text() == "true"
      let actionable = status != null && status.text() != "valid"

      if hasDiagnostics || incomplete || actionable
        let selected = json::Json.object()

        for field in [
          "projectKey",
          "name",
          "status",
          "message",
          "reused",
          "diagnosticCount",
          "diagnosticsTruncated",
          "diagnostics"
        ]
          let value = unit.get(field)

          if value != null
            selected.put(field, new json::Json(value))
          end
        end
        units.add(selected)
      end
    end
  end
  output.put("units", units)
  return output
end

def agentFeedbackShellQuote(value: String): String
  var output = "'"
  var start = 0
  var index = 0
  let length = host::stringByteLength(value)

  while index < length
    if host::stringByteAt(value, index) == (39 as Byte)
      output = output + host::stringSlice(value, start, index - start) + "'\\''"
      start = index + 1
    end
    index = index + 1
  end
  return output + host::stringSlice(value, start, length - start) + "'"
end

def agentHookFeedback(feedback: String): String
  let options = new json::Options()

  options.maxInputBytes = (new AgentLimits()).messageBytes()
  options.maxOutputBytes = options.maxInputBytes
  match json::Json.parse(feedback, options)
    case result::Result.Ok(report)
      let scope = report.get("scope")

      if scope == null || scope.text() != "project"
        return feedback
      end
      match agentHookProjectFeedback(report).stringify(options)
        case result::Result.Ok(text)
          return text
        case result::Result.Error(failure)
          return feedback
      end
    case result::Result.Error(failure)
      return feedback
  end
end
