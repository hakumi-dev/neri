def lspContractMemberIdentity(identity: String): Bool
  return bootstrapStartsWith(identity, "contract-member:")
end

def lspGeneratedContractCallIdentity(identity: String): Bool
  return bootstrapStartsWith(identity, "callable:")
end

# A generic body can first bind a member call to its contract requirement and
# then bind the specialized call to a concrete method at the same source range.
# The contract occurrence is the source-level meaning of that abstract body.
def lspSymbolAt(semantic: SemanticModel, position: Int): String
  var identity = ""
  # Select the abstract requirement before resolving concrete specializations.
  # Specializations are prepended and therefore do not have a stable iteration
  # order relative to the original contract occurrence.
  var contractIdentity = ""
  var contractStart = -1
  var contractLength = 0
  var contractAmbiguous = false
  var contractOccurrence = semantic.occurrences
  while contractOccurrence != null
    if contractOccurrence.start <= position && position < contractOccurrence.start + contractOccurrence.length && lspContractMemberIdentity(contractOccurrence.identity)
      if contractIdentity != "" && (contractIdentity != contractOccurrence.identity || contractStart != contractOccurrence.start || contractLength != contractOccurrence.length)
        contractAmbiguous = true
      else if contractIdentity == ""
        contractIdentity = contractOccurrence.identity
        contractStart = contractOccurrence.start
        contractLength = contractOccurrence.length
      end
    end
    contractOccurrence = contractOccurrence.next
  end
  if contractIdentity != "" && !contractAmbiguous
    identity = contractIdentity
  end
  var occurrence = semantic.occurrences
  while occurrence != null
    if occurrence.start <= position && position < occurrence.start + occurrence.length
      if identity != "" && identity != occurrence.identity
        if !(contractIdentity != "" && !contractAmbiguous && occurrence.start == contractStart && occurrence.length == contractLength && lspGeneratedContractCallIdentity(occurrence.identity))
          return ""
        end
      end
      identity = occurrence.identity if identity == ""
    end
    occurrence = occurrence.next
  end
  var node = semantic.bound.first.nextNode
  while node != null
    if (node.kind == "Name" || node.kind == "Assignment") && node.typeName != "Error" && node.start <= position && position < node.start + node.length && node.symbol != ""
      if identity != "" && identity != node.symbol
        return ""
      end
      identity = node.symbol if identity == ""
    end
    node = node.nextNode
  end
  var declaration = semantic.declarations
  while declaration != null
    if declaration.start <= position && position < declaration.start + declaration.length
      if identity != "" && identity != declaration.identity
        return ""
      end
      identity = declaration.identity if identity == ""
    end
    declaration = declaration.next
  end
  return identity
end

def lspLocation(document: LspDocument, start: Int, length: Int): String
  var index = 0
  while index + 1 < document.sourceStarts.size && document.sourceStarts.get(index + 1) <= start
    index = index + 1
  end
  let text = document.sourceTexts.get(index)
  let offset = document.sourceStarts.get(index)
  var uri = document.sourceUris.get(index)
  if bootstrapStartsWith(uri, "@stdlib/")
    let directory = host.environment("NERI_STDLIB")
    if directory == null
      return "null"
    end
    uri = lspUri(directory + "/" + host.stringSlice(uri, 8, host.stringByteLength(uri) - 8))
  end
  return "{\"uri\":" + lspQuote(uri) + ",\"range\":{\"start\":" + lspPosition(text, start - offset) + ",\"end\":" + lspPosition(text, start - offset + length) + "}}"
end

def lspNavigationSnapshot(document: LspDocument): LspSemanticSnapshot
  let cached = document.querySnapshot

  if cached != null
    return cached
  end
  let snapshot = new LspSemanticSnapshot()
  snapshot.projectKey = document.projectKey == "" ? document.uri : document.projectKey
  snapshot.projectRevision = document.analysisRevision
  snapshot.semantic = document.semantic
  snapshot.sourceUris = document.sourceUris
  snapshot.sourceTexts = document.sourceTexts
  snapshot.sourceStarts = document.sourceStarts
  snapshot.sourceVersions = document.sourceVersions
  snapshot.requireEntryPoint = document.requireEntryPoint
  snapshot.forbiddenEntryPointSources = document.forbiddenEntryPointSources
  snapshot.renameClosedWorld = document.renameClosedWorld
  snapshot.renameOwnedSourceUris = document.renameOwnedSourceUris
  document.querySnapshot = snapshot
  return snapshot
end

def lspNavigationIndex(document: LspDocument): LspSemanticIndex
  let cached = document.queryIndex
  if cached != null
    return cached
  end
  let snapshot = lspNavigationSnapshot(document)
  let index = new LspSemanticIndex()
  index.begin(snapshot.projectKey, snapshot.projectRevision)
  index.addSnapshot(snapshot)
  document.queryIndex = index
  return index
end

def lspQueryLocationJson(location: LspQueryLocation): String
  let snapshot = location.snapshot
  if snapshot == null
    return "null"
  end
  var index = 0
  while index + 1 < snapshot.sourceStarts.size && snapshot.sourceStarts.get(index + 1) <= location.start
    index = index + 1
  end
  if index < 0 || index >= snapshot.sourceUris.size || index >= snapshot.sourceTexts.size
    return "null"
  end
  var uri = snapshot.sourceUris.get(index)
  if bootstrapStartsWith(uri, "@stdlib/")
    let directory = host.environment("NERI_STDLIB")
    if directory == null
      return "null"
    end
    uri = lspUri(directory + "/" + host.stringSlice(uri, 8, host.stringByteLength(uri) - 8))
  end
  let text = snapshot.sourceTexts.get(index)
  return "{\"uri\":" + lspQuote(uri) + ",\"range\":{\"start\":" + lspPosition(text, location.sourceOffset) + ",\"end\":" + lspPosition(text, location.sourceOffset + location.length) + "}}"
end

def lspDefinition(document: LspDocument, position: Int): String
  let snapshot = lspNavigationSnapshot(document)
  let identity = lspQueryCanonicalIdentity(snapshot, lspSnapshotIdentityAt(snapshot, position))
  if identity == ""
    return "null"
  end
  let location = lspIndexDefinition(lspNavigationIndex(document), identity)
  if location != null
    return lspQueryLocationJson(location)
  end
  return "null"
end

def lspTypeAt(semantic: SemanticModel, position: Int): String
  var best: BoundNode? = null
  var node = semantic.bound.first.nextNode
  while node != null
    if node.typeName != "" && node.typeName != "Error" && node.start <= position && position < node.start + node.length
      if best == null || node.length < best.length
        best = node
      end
    end
    node = node.nextNode
  end
  if best == null
    return ""
  end
  return best.typeName
end

def lspTypeIdentity(semantic: SemanticModel, typeName: String): String
  var base = semanticMutableType(typeName)
  while semanticIsArray(base) || nativeFixedArray(base) || semanticIsOptional(base) || semanticIsPointer(base)
    base = semanticInnerType(base)
  end
  if nativeRecordType(base)
    let name = host.stringSlice(base, 7, host.stringByteLength(base) - 7)
    return semantic.findRecord(name) == null ? "" : "record:" + name
  end
  if semantic.findClass(base) == null
    return ""
  end
  return "type:" + lspGenericTemplateName(base)
end

def lspGenericTemplateName(typeName: String): String
  var index = 0
  while index < host.stringByteLength(typeName)
    if (host.stringByteAt(typeName, index) as Int) == 60
      return host.stringSlice(typeName, 0, index)
    end
    index = index + 1
  end
  return typeName
end

# Type definition resolves the compiler-inferred type at an expression. Builtin
# and structural types have no source declaration and deliberately return null.
def lspTypeDefinition(document: LspDocument, position: Int): String
  let snapshot = lspNavigationSnapshot(document)
  let semantic = snapshot.semantic
  if semantic == null
    return "null"
  end
  let identity = lspTypeIdentity(semantic, lspTypeAt(semantic, position))
  if identity == ""
    return "null"
  end
  let location = lspIndexDefinition(lspNavigationIndex(document), lspQueryCanonicalIdentity(snapshot, identity))
  if location == null
    return "null"
  end
  return lspQueryLocationJson(location)
end

def lspAddLocation(locations: StringBuffer, location: String): Void
  var current = locations.first.nextNode
  while current != null
    if current.value == location
      return
    end
    current = current.nextNode
  end
  locations.add(location)
end

def lspNavigationReferences(document: LspDocument, identity: String, includeDeclaration: Bool): String
  let locations = new StringBuffer()
  var location = lspIndexReferences(lspNavigationIndex(document), identity, includeDeclaration)
  while location != null
    lspAddLocation(locations, lspQueryLocationJson(location))
    location = location.next
  end
  let parts = new StringBuffer()
  var current = locations.first.nextNode
  while current != null
    if parts.size > 0
      parts.add(",")
    end
    parts.add(current.value)
    current = current.nextNode
  end
  return "[" + lspJoin(parts, 0, parts.size) + "]"
end

def lspReferences(document: LspDocument, position: Int, includeDeclaration: Bool): String
  let snapshot = lspNavigationSnapshot(document)
  let identity = lspQueryCanonicalIdentity(snapshot, lspSnapshotIdentityAt(snapshot, position))
  if identity == ""
    return "[]"
  end
  return lspNavigationReferences(document, identity, includeDeclaration)
end
