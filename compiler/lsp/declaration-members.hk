# Inherited signatures come from the binder's shared method lookup.
def lspOverrideCompletion(document: LspDocument, position: Int, snippets: Bool): String?
  let site = lspDeclarationSite(document, position)

  if site == null || site.className == ""
    return null
  end
  let parser = site.parser

  if syntaxModifierIn(parser.arena, site.modifiers, "override") < 0
    return null
  end
  if parser.currentKind() == "Def"
    parser.next()
  end
  var prefix = ""

  if parser.currentKind() == "Identifier"
    prefix = parser.tokens.textAt(parser.next())
  end
  if parser.currentKind() != "EndOfFile"
    return "[]"
  end
  let model = lspAnalyzeQueryText(document, lspDeclarationContextText(site))

  if model == null
    return "[]"
  end
  let owner = model.findClass(site.className)

  if owner == null
    return "[]"
  end
  let candidates = semanticOverrideCandidates(model, owner, prefix)
  let items = new StringBuffer()
  var candidate = candidates.first

  while candidate != null
    let method = semanticFindBaseMethod(model, owner, candidate.name)

    if method != null
      let access = syntaxModifierAccess(parser.arena, site.modifiers, method.access)
      let isAbstract = syntaxModifierIn(parser.arena, site.modifiers, "abstract") >= 0
      let staticModifier = syntaxModifierIn(parser.arena, site.modifiers, "static") >= 0
      let readonlyModifier = syntaxModifierIn(parser.arena, site.modifiers, "readonly") >= 0
      let unsafeModifier = syntaxModifierIn(parser.arena, site.modifiers, "unsafe") >= 0

      if access == method.access && !staticModifier && (!isAbstract || site.abstractClass) && (!readonlyModifier || method.isReadonly) && (!unsafeModifier || method.isUnsafe)
        let snippet = new LspSnippet()

        snippet.literal(method.access + " " + (isAbstract ? "abstract " : "") + "override " + (method.isReadonly ? "readonly " : "") + (method.isUnsafe ? "unsafe " : "") + "def " + method.name + "(")
        var parameter = method.firstParameter
        var separator = ""

        while parameter != null
          snippet.literal(separator + parameter.name + ": " + parameter.typeName)
          separator = ", "
          parameter = parameter.nextParameter
        end
        snippet.literal("): " + method.returnType)
        if lspDeclarationBody(document, site, snippet, isAbstract)
          items.add((items.size == 0 ? "" : ",") + lspDeclarationItem(document, site, method.name, candidate.detail, snippet, snippets))
        end
      end
    end
    candidate = candidate.next
  end
  return "{\"isIncomplete\":true,\"items\":[" + lspJoin(items, 0, items.size) + "]}"
end
