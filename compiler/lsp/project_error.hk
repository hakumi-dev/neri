public enum NeriProjectErrorReason
  case InvalidProject()
  case EmptyImplicitProject()
end

def neriProjectErrorReasonIsEmptyImplicitProject(reason: NeriProjectErrorReason?): Bool
  if reason == null
    return false
  end
  match reason
    case NeriProjectErrorReason.InvalidProject()
      return false
    case NeriProjectErrorReason.EmptyImplicitProject()
      return true
  end
  return false
end
