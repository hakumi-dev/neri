enum LspJsonType
  case Null()
  case Boolean()
  case String()
  case Number()
  case Object()
  case Array()
end

def lspJsonTypeName(kind: LspJsonType): String
  match kind
    case LspJsonType.Null()
      return "null"
    case LspJsonType.Boolean()
      return "boolean"
    case LspJsonType.String()
      return "string"
    case LspJsonType.Number()
      return "number"
    case LspJsonType.Object()
      return "object"
    case LspJsonType.Array()
      return "array"
  end
end

def lspJsonTypeFromName(name: String): LspJsonType?
  if name == "null"
    return LspJsonType.Null()
  end
  if name == "boolean"
    return LspJsonType.Boolean()
  end
  if name == "string"
    return LspJsonType.String()
  end
  if name == "number"
    return LspJsonType.Number()
  end
  if name == "object"
    return LspJsonType.Object()
  end
  if name == "array"
    return LspJsonType.Array()
  end
  return null
end

def lspJsonMatchesType(node: LspJson, name: String): Bool
  let kind = lspJsonTypeFromName(name)

  return kind != null && node.matches(kind)
end
