class LspDeclarationCatalog
  public path: String = ""
  public source: String = ""
  public error: String = ""
  public first: LspDeclarationTemplate?
  public last: LspDeclarationTemplate?

  def add(template: LspDeclarationTemplate): Void
    let tail = this.last

    if tail == null
      this.first = template
    else
      tail.nextTemplate = template
    end
    this.last = template
  end

  def prefixApplies(prefix: String): Bool
    var template = this.first

    while template != null
      if bootstrapStartsWith(template.prefix, prefix) || (template.provider != "staticDeclaration" && bootstrapStartsWith(template.declarationKeyword, prefix))
        return true
      end
      template = template.nextTemplate
    end
    return false
  end
end
