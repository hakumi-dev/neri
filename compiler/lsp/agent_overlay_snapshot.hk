use changes

def agentOrderedRecords(records: StringBuffer): String
  var index = 1

  while index < records.size
    let record = records.get(index)
    var position = index

    while position > 0 && changes::compareText(record, records.get(position - 1)) < 0
      records.set(position, records.get(position - 1))
      position = position - 1
    end
    records.set(position, record)
    index = index + 1
  end
  return records.join()
end

class AgentOverlaySnapshot
  public graph: AgentProjectGraph
  public revision: Int
  public snapshot: String

  def init(workspace: NeriAgentWorkspace, graph: AgentProjectGraph): Void
    this.graph = graph
    this.revision = workspace.revision
    this.snapshot = this.capture(workspace)
  end

  def capture(workspace: NeriAgentWorkspace, plan: AgentEditPlan? = null): String
    let buffers = new StringBuffer()
    var document = workspace.server.documents

    while document != null
      var source = document

      if plan != null
        let replacement = plan.find(document.uri)

        if replacement != null
          source = replacement.staged
        end
      end
      buffers.add(runCacheFrame(source.uri) + runCacheFrame(source.version as String) + runCacheFrame(source.text))
      document = document.next
    end
    return sha256FastText(runCacheFrame(this.graph.snapshot) + agentOrderedRecords(buffers))
  end

  def unchanged(workspace: NeriAgentWorkspace): Bool
    this.graph.refresh()
    return this.graph.error() == "" && workspace.revision == this.revision && this.capture(workspace) == this.snapshot
  end

  def owns(path: String): Bool
    var unit = this.graph.first

    while unit != null
      if unit.project.sourceOwner(path) != null
        return true
      end
      unit = unit.next
    end
    return false
  end
end
