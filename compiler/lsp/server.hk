use console
use host

def lspReadMessage(input: LspInput): String?
  var length = -1
  var headerBytes = 0

  while true
    var line = ""
    var byte = input.readByte()

    while byte != 10
      if byte < 0 || byte > 127 || headerBytes > 8192
        return null
      end
      line = line + lspCharacter(byte)
      headerBytes = headerBytes + 1
      byte = input.readByte()
    end
    headerBytes = headerBytes + 1
    if line == "\r"
      break
    end
    if !semanticEndsWith(line, "\r")
      return null
    end
    # Header names are case-insensitive, per the base protocol.
    var lower = ""
    var index = 0

    while index < host::stringByteLength(line)
      var value = host::stringByteAt(line, index) as Int

      if value >= 65 && value <= 90
        value = value + 32
      end
      lower = lower + lspCharacter(value)
      index = index + 1
    end
    if bootstrapStartsWith(lower, "content-length:")
      if length >= 0
        return null
      end
      index = 15
      while index < host::stringByteLength(lower) && ((host::stringByteAt(lower, index) as Int) == 32 || (host::stringByteAt(lower, index) as Int) == 9)
        index = index + 1
      end
      let value = host::parseInt(host::stringSlice(lower, index, host::stringByteLength(lower) - index - 1))

      if value == null || value < 0 || value > 2097152
        return null
      end
      length = value
    end
  end
  if length < 0
    return null
  end
  var bytes: Byte[] = []
  let parts = new StringBuffer()
  var continuation = 0
  var index = 0

  while index < length
    let byte = input.readByte()

    if byte < 0
      return null
    end
    bytes = host::appendByte(bytes, byte as Byte)
    if byte >= 192
      continuation = utf8Width(byte) - 1
    else if continuation > 0
      continuation = continuation - 1
    end
    index = index + 1
    if (bytes.Length >= 256 && continuation == 0) || index == length
      let part = host::stringFromBytes(bytes)

      if part == null
        return null
      end
      parts.add(part)
      bytes = []
    end
  end
  return lspJoin(parts, 0, parts.size)
end

def lspSend(body: String): Void
  console::print("Content-Length: " + (host::stringByteLength(body) as String) + "\r\n\r\n" + body)
end

def lspResult(id: String, result: String): Void
  lspSend("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}")
end

def lspError(id: String, code: Int, message: String): Void
  lspSend("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + (code as String) + ",\"message\":" + lspQuote(message) + "}}")
end

def lspLog(message: String): Void
  lspSend("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":" + lspQuote(message) + "}}")
end

def lspPosition(text: String, offset: Int): String
  let cursor = new IrUtf16Cursor(text)
  var line = 0
  var column = 0
  var index = 0
  var previous = -1

  while cursor.hasNext() && index < offset
    let unit = cursor.nextUnit()

    if unit == 13
      line = line + 1
      column = 0
    else if unit == 10
      if previous != 13
        line = line + 1
      end
      column = 0
    else
      column = column + 1
    end
    previous = unit
    index = index + 1
  end
  return "{\"line\":" + (line as String) + ",\"character\":" + (column as String) + "}"
end

def lspPathOrEmpty(path: String?): String
  if path == null
    return ""
  end
  return path
end

def lspUnusedUseDiagnostics(document: LspDocument, semantic: SemanticModel, primaryEnd: Int, includeTag: Bool): String
  let syntax = document.syntax

  if syntax == null
    return ""
  end
  var result = ""
  var separator = ""
  let useCount = semanticIntField(syntax.dataAt(document.syntaxRoot), 0)
  var index = 0

  while index < useCount
    let useNode = syntax.childAt(document.syntaxRoot, index)
    let name = lspUseName(syntax, useNode)
    let start = syntax.startAt(useNode)

    if (primaryEnd < 0 || start < primaryEnd) && lspUseUnreferenced(semantic, syntax, useNode)
      let tags = includeTag ? ",\"tags\":[1]" : ""

      result = result + separator + "{\"range\":{\"start\":" + lspPosition(document.text, start) + ",\"end\":" + lspPosition(document.text, start + syntax.lengthAt(useNode)) + "},\"severity\":4,\"code\":\"NR_UNUSED_USE\",\"source\":\"neri\",\"message\":\"Unused import: " + name + ".\"" + tags + "}"
      separator = ","
    end
    index = index + 1
  end
  return result
end

def lspMain(): Void
  let server = new LspServer()
  let input = new LspInput()

  while true
    let pending = server.pendingAnalysis()

    # Drain notifications and serve queries before idle diagnostics. Consecutive
    # edits replace the pending generation, so each pause analyzes current text.
    if pending != null && !input.waitReadable(150)
      server.analyze(pending)
      continue
    end
    let body = lspReadMessage(input)

    if body == null
      return
    end
    let parser = new LspJsonParser(body)
    let message = parser.parse()

    parser.spaces()
    if parser.failed || parser.position != host::stringByteLength(body)
      lspError("null", -32700, "Parse error")
    else if !server.handle(message)
      return
    end
  end
end
