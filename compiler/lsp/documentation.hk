use console
use host

# Documentation is attached only after semantic identity resolution. Source
# scanning determines the text belonging to that declaration, never the symbol.
def lspDocumentationIndentMatches(text: String, first: Int, second: Int, length: Int): Bool
  var index = 0

  while index < length
    if host::stringByteAt(text, first + index) != host::stringByteAt(text, second + index)
      return false
    end
    index = index + 1
  end
  return true
end

def lspDocumentationAt(text: String, declarationStart: Int): String
  let map = new IrSourceMap(text)
  let declarationByte = map.offsetAt(declarationStart)

  if declarationByte < 0 || declarationByte > host::stringByteLength(text)
    return ""
  end
  var declarationLine = declarationByte

  while declarationLine > 0 && host::stringByteAt(text, declarationLine - 1) != (10 as Byte) && host::stringByteAt(text, declarationLine - 1) != (13 as Byte)
    declarationLine = declarationLine - 1
  end
  var declarationContent = declarationLine

  while declarationContent < declarationByte && (host::stringByteAt(text, declarationContent) == (32 as Byte) || host::stringByteAt(text, declarationContent) == (9 as Byte))
    declarationContent = declarationContent + 1
  end
  let indentation = declarationContent - declarationLine
  let reversed = new StringBuffer()
  var previousEnd = declarationLine

  while previousEnd > 0
    if host::stringByteAt(text, previousEnd - 1) == (10 as Byte)
      previousEnd = previousEnd - 1
      if previousEnd > 0 && host::stringByteAt(text, previousEnd - 1) == (13 as Byte)
        previousEnd = previousEnd - 1
      end
    else if host::stringByteAt(text, previousEnd - 1) == (13 as Byte)
      previousEnd = previousEnd - 1
    end
    var previousStart = previousEnd

    while previousStart > 0 && host::stringByteAt(text, previousStart - 1) != (10 as Byte) && host::stringByteAt(text, previousStart - 1) != (13 as Byte)
      previousStart = previousStart - 1
    end
    var content = previousStart

    while content < previousEnd && (host::stringByteAt(text, content) == (32 as Byte) || host::stringByteAt(text, content) == (9 as Byte))
      content = content + 1
    end
    var trimmedEnd = previousEnd

    while trimmedEnd > content && (host::stringByteAt(text, trimmedEnd - 1) == (32 as Byte) || host::stringByteAt(text, trimmedEnd - 1) == (9 as Byte))
      trimmedEnd = trimmedEnd - 1
    end
    if content - previousStart != indentation || !lspDocumentationIndentMatches(text, previousStart, declarationLine, indentation)
      break
    end
    if content + 1 >= trimmedEnd || host::stringByteAt(text, content) != (35 as Byte) || host::stringByteAt(text, content + 1) != (35 as Byte)
      break
    end
    var textStart = content + 2

    if textStart < trimmedEnd && host::stringByteAt(text, textStart) == (32 as Byte)
      textStart = textStart + 1
    end
    reversed.add(host::stringSlice(text, textStart, trimmedEnd - textStart))
    previousEnd = previousStart
  end
  var result = ""
  var index = reversed.size
  var separator = ""

  while index > 0
    index = index - 1
    result = result + separator + reversed.get(index)
    separator = "\n"
  end
  return result
end

def lspStdlibDocumentation(document: LspDocument, sourceIndex: Int, identity: String): String
  let index = document.stdlibDocumentation

  if index == null || sourceIndex < 0 || sourceIndex >= document.sourceUris.size || sourceIndex >= document.sourceTexts.size
    return ""
  end
  let uri = document.sourceUris.get(sourceIndex)

  if !bootstrapStartsWith(uri, "@stdlib/")
    return ""
  end
  let path = host::stringSlice(uri, 8, host::stringByteLength(uri) - 8)
  let sources = index.get("sources")

  if !sources.isArray()
    return ""
  end
  var source = sources.first

  while source != null
    if source.isObject() && source.get("path").isString() && source.get("path").scalarText() == path && source.get("sha256").isString() && source.get("sha256").scalarText() == sha256Text(document.sourceTexts.get(sourceIndex))
      let entries = source.get("entries")

      if !entries.isArray()
        return ""
      end
      var entry = entries.first

      while entry != null
        if entry.isObject() && entry.get("identity").isString() && entry.get("identity").scalarText() == identity && entry.get("documentation").isString()
          return entry.get("documentation").scalarText()
        end
        entry = entry.next
      end
      return ""
    end
    source = source.next
  end
  return ""
end

def lspDocumentationIdentitySupported(identity: String): Bool
  return bootstrapStartsWith(identity, "callable:") || bootstrapStartsWith(identity, "type:") || bootstrapStartsWith(identity, "field:") || bootstrapStartsWith(identity, "record:") || bootstrapStartsWith(identity, "record-field:")
end

def lspDocumentationForSource(document: LspDocument, sourceIndex: Int, relative: Int, identity: String): String
  if sourceIndex < 0 || sourceIndex >= document.sourceTexts.size || sourceIndex >= document.sourceUris.size
    return ""
  end
  if !lspDocumentationIdentitySupported(identity)
    # Parameters and locals may share the declaration line's start. They do
    # not inherit callable prose until a parameter-doc syntax exists.
    return ""
  end
  if bootstrapStartsWith(document.sourceUris.get(sourceIndex), "@stdlib/")
    # Packaged standard-library prose exists only in the optional sidecar. The
    # .hk sources remain authoritative for types and signatures in --no-doc.
    return lspStdlibDocumentation(document, sourceIndex, identity)
  end
  let text = document.sourceTexts.get(sourceIndex)

  if relative < 0 || relative > (new IrSourceMap(text)).utf16Length()
    return ""
  end
  return lspDocumentationAt(text, relative)
end

def lspDocumentationForDeclaration(document: LspDocument, declaration: SemanticDeclaration): String
  var sourceIndex = 0

  while sourceIndex + 1 < document.sourceStarts.size && document.sourceStarts.get(sourceIndex + 1) <= declaration.start
    sourceIndex = sourceIndex + 1
  end
  if sourceIndex >= document.sourceTexts.size || sourceIndex >= document.sourceStarts.size
    return ""
  end
  let relative = declaration.start - document.sourceStarts.get(sourceIndex)

  return lspDocumentationForSource(document, sourceIndex, relative, declaration.identity)
end

def lspDocumentationDeclaration(model: SemanticModel, identity: String): SemanticDeclaration?
  var declaration = model.declarations

  while declaration != null
    if declaration.identity == identity && !lspSourceSymbolIsGenerated(identity)
      return declaration
    end
    declaration = declaration.next
  end
  return null
end

def lspDocumentationForIdentity(document: LspDocument, identity: String): String
  let semantic = document.semantic

  if semantic == null
    return ""
  end
  let declaration = lspDocumentationDeclaration(semantic, identity)

  if declaration == null
    return ""
  end
  return lspDocumentationForDeclaration(document, declaration)
end

def lspMarkdownEscape(text: String): String
  let parts = new StringBuffer()
  var start = 0
  var index = 0

  while index < host::stringByteLength(text)
    let byte = host::stringByteAt(text, index) as Int
    let syntax = byte == 92 || byte == 96 || byte == 42 || byte == 95 || byte == 91 || byte == 93 || byte == 60 || byte == 62 || byte == 35 || byte == 124

    if syntax
      parts.add(host::stringSlice(text, start, index - start) + "\\" + host::stringSlice(text, index, 1))
      start = index + 1
    end
    index = index + 1
  end
  parts.add(host::stringSlice(text, start, index - start))
  return parts.join()
end

def lspDocumentationMarkup(text: String, markdown: Bool): String
  let kind = markdown ? "markdown" : "plaintext"
  let value = markdown ? lspMarkdownEscape(text) : text

  return "{\"kind\":" + lspQuote(kind) + ",\"value\":" + lspQuote(value) + "}"
end

def lspHoverMarkup(display: String, documentation: String, markdown: Bool): String
  if markdown
    var value = "```neri\n" + display + "\n```"

    if documentation != ""
      value = value + "\n\n" + lspMarkdownEscape(documentation)
    end
    return "{\"kind\":\"markdown\",\"value\":" + lspQuote(value) + "}"
  end
  let value = documentation == "" ? display : display + "\n\n" + documentation

  return "{\"kind\":\"plaintext\",\"value\":" + lspQuote(value) + "}"
end

def lspJsonArrayContains(node: LspJson, value: String): Bool
  if !node.isArray()
    return false
  end
  var child = node.first

  while child != null
    if child.isString() && child.scalarText() == value
      return true
    end
    child = child.next
  end
  return false
end

def lspCompletionItemWithDocumentation(item: LspJson, documentation: String, markdown: Bool): String
  if !item.isObject() || documentation == ""
    return lspJsonStringify(item)
  end
  let parts = new StringBuffer()

  parts.add("{")
  var child = item.first
  var separator = ""

  while child != null
    if child.key != "documentation"
      parts.add(separator + lspQuote(child.key) + ":" + lspJsonStringify(child))
      separator = ","
    end
    child = child.next
  end
  parts.add(separator + "\"documentation\":" + lspDocumentationMarkup(documentation, markdown) + "}")
  return parts.join()
end

def lspCompletionItemWithoutDocumentation(item: LspJson): String
  if !item.isObject() || item.get("documentation").isMissing()
    return lspJsonStringify(item)
  end
  let parts = new StringBuffer()

  parts.add("{")
  var child = item.first
  var separator = ""

  while child != null
    if child.key != "documentation"
      parts.add(separator + lspQuote(child.key) + ":" + lspJsonStringify(child))
      separator = ","
    end
    child = child.next
  end
  parts.add("}")
  return parts.join()
end

def lspDocumentationForRepairedDeclaration(document: LspDocument, declaration: SemanticDeclaration, targetStart: Int, replacementLength: Int, delta: Int): String
  var sourceIndex = 0

  while sourceIndex + 1 < document.sourceStarts.size && document.sourceStarts.get(sourceIndex + 1) + delta <= declaration.start
    sourceIndex = sourceIndex + 1
  end
  if sourceIndex >= document.sourceStarts.size
    return ""
  end
  var relative = declaration.start - document.sourceStarts.get(sourceIndex)

  if sourceIndex > 0
    relative = relative - delta
  else if declaration.start >= targetStart + replacementLength
    relative = relative - delta
  end
  return lspDocumentationForSource(document, sourceIndex, relative, declaration.identity)
end

def lspResolvedCompletionDocumentation(document: LspDocument, item: LspJson, data: LspJson, identity: String): String
  let semantic = document.semantic

  if semantic != null
    let declaration = lspDocumentationDeclaration(semantic, identity)

    if declaration == null
      return ""
    end
    return lspDocumentationForDeclaration(document, declaration)
  end
  let startNode = data.get("start")
  let lengthNode = data.get("length")
  let callNode = data.get("call")
  let label = item.get("label")
  let start = host::parseInt(startNode.scalarText())
  let length = host::parseInt(lengthNode.scalarText())

  if !startNode.isNumber() || !lengthNode.isNumber() || start == null || length == null || start < 0 || length < 0 || start + length > (new IrSourceMap(document.text)).utf16Length() || !callNode.isBoolean() || !label.isString() || label.scalarText() == ""
    return ""
  end
  let map = new IrSourceMap(document.text)
  let first = map.offsetAt(start)
  let last = map.offsetAt(start + length)
  let replacement = label.scalarText() + (callNode.isTrue() ? "()" : "")
  let repaired = host::stringSlice(document.text, 0, first) + replacement + host::stringSlice(document.text, last, host::stringByteLength(document.text) - last)
  let repairedModel = lspAnalyzeQueryText(document, repaired)

  if repairedModel == null
    return ""
  end
  let declaration = lspDocumentationDeclaration(repairedModel, identity)

  if declaration == null || declaration.name != label.scalarText()
    return ""
  end
  let replacementLength = (new IrSourceMap(replacement)).utf16Length()

  return lspDocumentationForRepairedDeclaration(document, declaration, start, replacementLength, replacementLength - length)
end

def lspResolveCompletion(document: LspDocument?, item: LspJson, documentationEnabled: Bool, markdown: Bool): String
  if !documentationEnabled
    return lspCompletionItemWithoutDocumentation(item)
  end
  if document == null
    return lspJsonStringify(item)
  end
  let data = item.get("data")
  let uri = data.get("uri")
  let identity = data.get("identity")
  let versionNode = data.get("version")
  let revisionNode = data.get("revision")
  let version = host::parseInt(versionNode.scalarText())
  let revision = host::parseInt(revisionNode.scalarText())

  if !data.isObject() || !uri.isString() || !identity.isString() || !versionNode.isNumber() || !revisionNode.isNumber() || version == null || revision == null
    return lspJsonStringify(item)
  end
  if uri.scalarText() != document.uri || version != document.version || revision != document.analysisRevision
    return lspJsonStringify(item)
  end
  return lspCompletionItemWithDocumentation(item, lspResolvedCompletionDocumentation(document, item, data, identity.scalarText()), markdown)
end

def lspLoadStdlibDocumentation(): LspJson?
  let directory = host::environment("NERI_STDLIB")

  if directory == null
    return null
  end
  let text = host::readText(directory + "/documentation.json")

  if text == null
    return null
  end
  let parser = new LspJsonParser(text)
  let index = parser.parse()

  parser.spaces()
  let schema = host::parseInt(index.get("schemaVersion").scalarText())

  if parser.failed || parser.position != host::stringByteLength(text) || !index.isObject() || !index.get("schemaVersion").isNumber() || schema == null || schema != 1 || !index.get("toolchainVersion").isString() || index.get("toolchainVersion").scalarText() != neriVersion() || !index.get("sources").isArray()
    return null
  end
  return index
end

def lspDocumentationIndexUsage(): Void
  console::println("usage: neri documentation-index [--toolchain-version VERSION] --output FILE STDLIB.hk...")
end

def lspDocumentationIndexMain(): Void
  var version = ""
  var output = ""
  let paths = new StringBuffer()
  var index = 1

  while index < host::argumentCount()
    let optionalArgument = host::argumentAt(index)

    if optionalArgument == null
      return
    end
    let argument = optionalArgument

    if argument == "--toolchain-version" || argument == "--output"
      if index + 1 >= host::argumentCount()
        lspDocumentationIndexUsage()
        host::exit(2)
        return
      end
      let optionalValue = host::argumentAt(index + 1)

      if optionalValue == null
        return
      end
      if argument == "--toolchain-version"
        version = optionalValue
      else
        output = optionalValue
      end
      index = index + 2
    else if bootstrapStartsWith(argument, "--")
      lspDocumentationIndexUsage()
      host::exit(2)
      return
    else
      paths.add(argument)
      index = index + 1
    end
  end
  if version == ""
    version = neriVersion()
  end
  if version != neriVersion() || output == "" || paths.size == 0
    lspDocumentationIndexUsage()
    host::exit(2)
    return
  end

  let optionalLibraryDirectory = host::environment("NERI_STDLIB")
  var libraryDirectory = ""

  if optionalLibraryDirectory != null
    libraryDirectory = optionalLibraryDirectory
  end
  let libraries = new StandardLibraryCatalog(libraryDirectory)

  if libraries.error != ""
    console::println(libraries.error)
    host::exit(2)
    return
  end
  let names = new StringBuffer()

  index = 0
  while index < paths.size
    let optionalName = libraries.sourceName(paths.get(index))

    if optionalName == null
      console::println("cannot index standard-library source: " + paths.get(index))
      host::exit(2)
      return
    end
    if neriProjectListed(names, optionalName)
      console::println("duplicate standard-library source name: " + optionalName)
      host::exit(2)
      return
    end
    names.add(optionalName)
    index = index + 1
  end
  let texts = new StringBuffer()
  let starts = new IntBuffer()
  let references = new BootstrapLibraryReferences()
  var combined = ""

  index = 0
  var pending = true

  while pending
    while index < paths.size
      let optionalText = host::readText(paths.get(index))

      if optionalText == null
        console::println("cannot index standard-library source: " + paths.get(index))
        host::exit(2)
        return
      end
      starts.add((new IrSourceMap(combined)).utf16Length())
      texts.add(optionalText)
      combined = combined + optionalText + "\n"
      references.addSource(optionalText)
      index = index + 1
    end
    pending = false
    # Documentation needs the same transitive library environment as ordinary
    # compilation and LSP analysis. Queue every source declared by an imported
    # module, preserving its path relative to the standard-library directory.
    for library in references.libraryNames()
      let sources = libraries.sourcePaths(library)

      if libraries.error != ""
        console::println(libraries.error)
        host::exit(2)
        return
      end
      var source = sources.first.nextNode

      while source != null
        if !neriProjectListed(names, source.value)
          names.add(source.value)
          paths.add(libraryDirectory + "/" + source.value)
          pending = true
        end
        source = source.nextNode
      end
    end
  end
  let indexedSourceCount = names.size

  starts.add((new IrSourceMap(combined)).utf16Length())
  names.add("documentation-index-main.hk")
  texts.add("def main(): Void\nend\n")
  combined = combined + texts.get(texts.size - 1) + "\n"

  let tokens = (new BootstrapLexer(combined)).lex()
  let parser = new BootstrapParser(tokens)

  index = 0
  while index < starts.size
    parser.addSourceBoundary(starts.get(index))
    index = index + 1
  end
  let root = parser.parseProgram()

  if parser.diagnostics.count() != 0
    irEmitDiagnostics(parser.diagnostics, "Parse", names, texts, starts)
    host::exit(1)
    return
  end
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

  binder.recordSourceSymbols = true
  binder.clearSources()
  index = 0
  while index < starts.size
    binder.addSource("@stdlib/" + names.get(index), starts.get(index))
    index = index + 1
  end
  let semantic = binder.bind()

  if semantic.diagnostics.count() != 0
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", names, texts, starts)
    host::exit(1)
    return
  end

  var result = "{\"schemaVersion\":1,\"toolchainVersion\":" + lspQuote(version) + ",\"sources\":["
  var sourceSeparator = ""

  index = 0
  while index < indexedSourceCount
    result = result + sourceSeparator + "{\"path\":" + lspQuote(names.get(index)) + ",\"sha256\":" + lspQuote(sha256Text(texts.get(index))) + ",\"entries\":["
    var entrySeparator = ""
    var declaration = semantic.declarations
    let finish = starts.get(index + 1)

    while declaration != null
      if declaration.start >= starts.get(index) && declaration.start < finish && !lspSourceSymbolIsGenerated(declaration.identity) && lspDocumentationIdentitySupported(declaration.identity)
        let documentation = lspDocumentationAt(texts.get(index), declaration.start - starts.get(index))

        if documentation != ""
          result = result + entrySeparator + "{\"identity\":" + lspQuote(declaration.identity) + ",\"documentation\":" + lspQuote(documentation) + "}"
          entrySeparator = ","
        end
      end
      declaration = declaration.next
    end
    result = result + "]}"
    sourceSeparator = ","
    index = index + 1
  end
  result = result + "]}\n"
  if !host::writeText(output, result)
    console::println("cannot write documentation index: " + host::errorMessage())
    host::exit(2)
  end
end
