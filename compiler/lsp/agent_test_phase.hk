sealed class AgentTestPhase
  private running: Bool
  private didExecute: Bool

  private def init(running: Bool, didExecute: Bool): Void
    this.running = running
    this.didExecute = didExecute
  end

  static def build(): AgentTestPhase
    return new AgentTestPhase(false, false)
  end

  static def run(executed: Bool): AgentTestPhase
    return new AgentTestPhase(true, executed)
  end

  readonly def isBuild(): Bool
    return !this.running
  end

  readonly def executed(): Bool
    return this.didExecute
  end

  readonly def wireName(): String
    return this.running ? "run" : "build"
  end
end
