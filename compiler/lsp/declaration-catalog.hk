
def lspCatalogLineColumn(text: String, bytePosition: Int): String
  var line = 1
  var column = 1
  var index = 0

  while index < bytePosition && index < host.stringByteLength(text)
    if (host.stringByteAt(text, index) as Int) == 10
      line = line + 1
      column = 1
    else
      column = column + 1
    end
    index = index + 1
  end
  return (line as String) + ":" + (column as String)
end

def lspCatalogFail(catalog: LspDeclarationCatalog, text: String, position: Int, message: String): Bool
  if catalog.error == ""
    catalog.error = catalog.path + ":" + lspCatalogLineColumn(text, position) + ": " + message
  end
  return false
end

def lspCatalogProperty(catalog: LspDeclarationCatalog, text: String, object: LspJson, name: String, required: Bool = true): LspJson?
  var child = object.first
  var found: LspJson? = null

  while child != null
    if child.key == name
      if found != null
        lspCatalogFail(catalog, text, child.keyStart, "Duplicate property '" + name + "'.")
        return null
      end
      found = child
    end
    child = child.next
  end
  if found == null && required
    lspCatalogFail(catalog, text, object.start, "Missing required property '" + name + "'.")
  end
  return found
end

def lspCatalogKnownProperty(name: String, names: String[]): Bool
  for candidate in names
    if name == candidate
      return true
    end
  end
  return false
end

def lspCatalogObject(catalog: LspDeclarationCatalog, text: String, node: LspJson, names: String[]): Bool
  if node.kind != "object"
    return lspCatalogFail(catalog, text, node.start, "Expected an object.")
  end
  var child = node.first

  while child != null
    if !lspCatalogKnownProperty(child.key, names)
      return lspCatalogFail(catalog, text, child.keyStart, "Unknown property '" + child.key + "'.")
    end
    var candidate = node.first
    var occurrences = 0

    while candidate != null
      occurrences = occurrences + 1 if candidate.key == child.key
      candidate = candidate.next
    end
    if occurrences > 1
      return lspCatalogFail(catalog, text, child.keyStart, "Duplicate property '" + child.key + "'.")
    end
    child = child.next
  end
  return true
end

def lspCatalogString(catalog: LspDeclarationCatalog, text: String, object: LspJson, name: String): String?
  let node = lspCatalogProperty(catalog, text, object, name)

  if node == null
    return null
  end
  if node.kind != "string" || node.value == ""
    lspCatalogFail(catalog, text, node.start, "Property '" + name + "' must be a nonempty string.")
    return null
  end
  return node.value
end

def lspCatalogIdentifier(value: String): Bool
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    let valid = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (index > 0 && byte >= 48 && byte <= 57) || (index > 0 && (byte == 45 || byte == 95))

    if !valid
      return false
    end
    index = index + 1
  end
  return index > 0
end

def lspCatalogSingleLine(value: String): Bool
  return bootstrapFindText(value, "\n") < 0 && bootstrapFindText(value, "\r") < 0
end

def lspCatalogPlaceholderByte(text: String, index: Int): Int
  return host.stringByteAt(text, index) as Int
end

# Validate the placeholder subset and compile it once. Backslash quotes only
# '$', '\\' and '}', including inside field defaults.
def lspCatalogScanTemplate(catalog: LspDeclarationCatalog, source: String, node: LspJson, expected: Int[], finalStop: Bool[], compiled: LspTemplateText): String?
  let rendered = new StringBuffer()
  var start = 0
  var index = 0

  while index < host.stringByteLength(source)
    if lspCatalogPlaceholderByte(source, index) == 92
      let literal = host.stringSlice(source, start, index - start)

      rendered.add(literal)
      compiled.add("literal", literal)
      if index + 1 >= host.stringByteLength(source) || (lspCatalogPlaceholderByte(source, index + 1) != 36 && lspCatalogPlaceholderByte(source, index + 1) != 92 && lspCatalogPlaceholderByte(source, index + 1) != 125)
        lspCatalogFail(catalog, catalog.source, node.start, "Template escapes support only \\$, \\\\ and \\}.")
        return null
      end
      let escaped = host.stringSlice(source, index + 1, 1)

      rendered.add(escaped)
      compiled.add("literal", escaped)
      index = index + 2
      start = index
      continue
    end
    if lspCatalogPlaceholderByte(source, index) != 36
      index = index + 1
      continue
    end
    if index + 1 < host.stringByteLength(source) && lspCatalogPlaceholderByte(source, index + 1) == 48
      let literal = host.stringSlice(source, start, index - start)

      rendered.add(literal)
      compiled.add("literal", literal)
      if finalStop[0]
        lspCatalogFail(catalog, catalog.source, node.start, "A template may contain at most one $0 final stop.")
        return null
      end
      finalStop[0] = true
      compiled.add("final", "")
      index = index + 2
      if index < host.stringByteLength(source) && lspCatalogPlaceholderByte(source, index) >= 48 && lspCatalogPlaceholderByte(source, index) <= 57
        lspCatalogFail(catalog, catalog.source, node.start, "Only canonical $0 is supported; quote a literal dollar as \\$.")
        return null
      end
      start = index
      continue
    end
    if index + 1 < host.stringByteLength(source) && lspCatalogPlaceholderByte(source, index + 1) >= 48 && lspCatalogPlaceholderByte(source, index + 1) <= 57
      lspCatalogFail(catalog, catalog.source, node.start, "Numeric placeholders use `${N:default}`; quote a literal dollar as \\$.")
      return null
    end
    if index + 1 >= host.stringByteLength(source) || lspCatalogPlaceholderByte(source, index + 1) != 123
      index = index + 1
      continue
    end
    let literal = host.stringSlice(source, start, index - start)

    rendered.add(literal)
    compiled.add("literal", literal)
    var cursor = index + 2
    var digits = 0

    while cursor < host.stringByteLength(source) && lspCatalogPlaceholderByte(source, cursor) >= 48 && lspCatalogPlaceholderByte(source, cursor) <= 57
      digits = digits + 1
      cursor = cursor + 1
    end
    let numberText = host.stringSlice(source, index + 2, digits)
    let number = host.parseInt(numberText)

    if digits == 0 || number == null || numberText != (expected[0] as String) || cursor >= host.stringByteLength(source) || lspCatalogPlaceholderByte(source, cursor) != 58
      lspCatalogFail(catalog, catalog.source, node.start, "Editable placeholders must be contiguous `${N:default}` values starting at 1.")
      return null
    end
    cursor = cursor + 1
    let value = new StringBuffer()
    var valueStart = cursor

    while cursor < host.stringByteLength(source) && lspCatalogPlaceholderByte(source, cursor) != 125
      if lspCatalogPlaceholderByte(source, cursor) == 92
        value.add(host.stringSlice(source, valueStart, cursor - valueStart))
        if cursor + 1 >= host.stringByteLength(source) || (lspCatalogPlaceholderByte(source, cursor + 1) != 36 && lspCatalogPlaceholderByte(source, cursor + 1) != 92 && lspCatalogPlaceholderByte(source, cursor + 1) != 125)
          lspCatalogFail(catalog, catalog.source, node.start, "Template escapes support only \\$, \\\\ and \\}.")
          return null
        end
        value.add(host.stringSlice(source, cursor + 1, 1))
        cursor = cursor + 2
        valueStart = cursor
      else
        cursor = cursor + 1
      end
    end
    if cursor >= host.stringByteLength(source)
      lspCatalogFail(catalog, catalog.source, node.start, "Unclosed editable placeholder.")
      return null
    end
    value.add(host.stringSlice(source, valueStart, cursor - valueStart))
    let defaultValue = lspJoin(value, 0, value.size)

    rendered.add(defaultValue)
    compiled.add("field", defaultValue)
    expected[0] = expected[0] + 1
    index = cursor + 1
    start = index
  end
  let literal = host.stringSlice(source, start, host.stringByteLength(source) - start)

  rendered.add(literal)
  compiled.add("literal", literal)
  return lspJoin(rendered, 0, rendered.size)
end

def lspCatalogTemplateValid(catalog: LspDeclarationCatalog, text: String, node: LspJson, template: LspDeclarationTemplate): Bool
  let expected = [1]
  let finalStop = [false]
  let headerNode = lspCatalogProperty(catalog, text, node, "header")

  if headerNode == null
    return false
  end
  let renderedHeader = lspCatalogScanTemplate(catalog, template.header, headerNode, expected, finalStop, template.headerText)

  if renderedHeader == null
    return false
  end
  var source = renderedHeader
  var index = 0
  var line = template.firstLine

  while line != null
    let rendered = lspCatalogScanTemplate(catalog, line.source, node, expected, finalStop, line.text)

    if rendered == null
      return false
    end
    source = source + "\n" + rendered
    line = line.nextLine
  end
  template.hasFinalStop = finalStop[0]
  if template.bodyKind == "block"
    source = source + "\nend"
  end
  if template.context == "class"
    var nested = ""

    for line in lspSplitLines(source)
      nested = nested + "  " + line + "\n"
    end
    source = "class CatalogOwner\n" + nested + "end"
  end
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  if parser.diagnostics.count() != 0 || parser.arena.childCountAt(root) != 1
    return lspCatalogFail(catalog, text, node.start, "Template defaults must parse as exactly one Neri declaration.")
  end
  var declaration = parser.arena.childAt(root, 0)
  var kind = parser.arena.kindAt(declaration)

  if template.context == "class"
    if kind != "Class" || parser.arena.childCountAt(declaration) != 1
      return lspCatalogFail(catalog, text, node.start, "Class-context template defaults must parse as one member declaration.")
    end
    declaration = parser.arena.childAt(declaration, 0)
    kind = parser.arena.kindAt(declaration)
  end

  if template.provider == "classDeclaration" && kind != "Class"
    return lspCatalogFail(catalog, text, node.start, "Provider 'classDeclaration' requires one class declaration.")
  end
  if template.provider == "functionDeclaration" && kind != "Function" && kind != "Method"
    return lspCatalogFail(catalog, text, node.start, "Provider 'functionDeclaration' requires one function declaration.")
  end
  template.declarationKeyword = kind == "Class" ? "class" : (kind == "Method" || kind == "Function" ? "def" : template.prefix)
  if template.provider != "staticDeclaration" && template.bodyKind != "block"
    return lspCatalogFail(catalog, text, node.start, "Class and function declaration providers require a block body policy.")
  end
  if template.provider == "staticDeclaration" && kind != "Class" && kind != "Function" && kind != "Method" && kind != "Contract"
    return lspCatalogFail(catalog, text, node.start, "Provider 'staticDeclaration' requires one supported declaration.")
  end
  if !lspCompileTemplateHeader(template, catalog, text, node)
    return false
  end
  return true
end

def lspSplitLines(source: String): String[]
  var result: String[] = []
  var start = 0
  var index = 0

  while index <= host.stringByteLength(source)
    if index == host.stringByteLength(source) || (host.stringByteAt(source, index) as Int) == 10
      result = host.appendString(result, host.stringSlice(source, start, index - start))
      start = index + 1
    end
    index = index + 1
  end
  return result
end

def lspParseDeclarationCatalog(text: String, path: String): LspDeclarationCatalog
  let catalog = new LspDeclarationCatalog()

  catalog.path = path
  catalog.source = text
  let parser = new LspJsonParser(text)
  let root = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host.stringByteLength(text)
    lspCatalogFail(catalog, text, parser.position, "Invalid JSON.")
    return catalog
  end
  if !lspCatalogObject(catalog, text, root, ["version", "templates"])
    return catalog
  end
  let version = lspCatalogProperty(catalog, text, root, "version")
  let templates = lspCatalogProperty(catalog, text, root, "templates")

  if version == null
    return catalog
  end
  if version.kind != "number" || version.value != "1"
    lspCatalogFail(catalog, text, version.start, "Catalog version must be 1.")
    return catalog
  end
  if templates == null
    return catalog
  end
  if templates.kind != "array"
    lspCatalogFail(catalog, text, templates.start, "Property 'templates' must be an array.")
    return catalog
  end
  var entry = templates.first

  while entry != null && catalog.error == ""
    if !lspCatalogObject(catalog, text, entry, ["id", "prefix", "label", "detail", "context", "provider", "header", "body"])
      break
    end
    let template = new LspDeclarationTemplate()
    let id = lspCatalogString(catalog, text, entry, "id")
    let prefix = lspCatalogString(catalog, text, entry, "prefix")
    let label = lspCatalogString(catalog, text, entry, "label")
    let detail = lspCatalogString(catalog, text, entry, "detail")
    let context = lspCatalogString(catalog, text, entry, "context")
    let provider = lspCatalogString(catalog, text, entry, "provider")
    let header = lspCatalogString(catalog, text, entry, "header")
    let body = lspCatalogProperty(catalog, text, entry, "body")

    if id == null || prefix == null || label == null || detail == null || context == null || provider == null || header == null || body == null
      break
    end
    template.id = id
    template.prefix = prefix
    template.label = label
    template.detail = detail
    template.context = context
    template.provider = provider
    template.header = header
    if !lspCatalogIdentifier(id)
      lspCatalogFail(catalog, text, entry.start, "Template id must start with an ASCII letter and contain only letters, digits, '_' or '-'.")
      break
    end
    let prefixTokens = (new BootstrapLexer(prefix)).lex()

    let prefixByte = host.stringByteAt(prefix, 0) as Int
    let prefixStartsName = (prefixByte >= 65 && prefixByte <= 90) || (prefixByte >= 97 && prefixByte <= 122) || prefixByte >= 128

    if prefixTokens.count() != 2 || prefixTokens.textAt(0) != prefix || !prefixStartsName
      lspCatalogFail(catalog, text, entry.start, "Template prefix must be exactly one Neri token.")
      break
    end
    if !lspCatalogSingleLine(header)
      lspCatalogFail(catalog, text, entry.start, "Template headers must be single-line source.")
      break
    end
    if context != "global" && context != "class"
      lspCatalogFail(catalog, text, entry.start, "Context must be 'global' or 'class'.")
      break
    end
    if provider != "classDeclaration" && provider != "functionDeclaration" && provider != "staticDeclaration"
      lspCatalogFail(catalog, text, entry.start, "Unknown declaration provider '" + provider + "'.")
      break
    end
    if !lspCatalogObject(catalog, text, body, ["kind", "lines"])
      break
    end
    let bodyKind = lspCatalogString(catalog, text, body, "kind")
    let lines = lspCatalogProperty(catalog, text, body, "lines")

    if bodyKind == null || lines == null || lines.kind != "array"
      lspCatalogFail(catalog, text, body.start, "Body requires a kind and an array of lines.")
      break
    end
    template.bodyKind = bodyKind
    if bodyKind != "block" && bodyKind != "none"
      lspCatalogFail(catalog, text, body.start, "Body kind must be 'block' or 'none'.")
      break
    end
    var line = lines.first

    while line != null
      if line.kind != "string"
        lspCatalogFail(catalog, text, line.start, "Body lines must be strings.")
        break
      end
      if !lspCatalogSingleLine(line.value)
        lspCatalogFail(catalog, text, line.start, "Each body line must be a single logical line.")
        break
      end
      if host.stringByteLength(line.value) > 0 && (host.stringByteAt(line.value, 0) as Int) == 32
        lspCatalogFail(catalog, text, line.start, "Body indentation uses leading tab characters as logical levels.")
        break
      end
      let compiledLine = new LspTemplateLine()

      compiledLine.source = line.value
      template.addLine(compiledLine)
      line = line.next
    end
    if catalog.error != ""
      break
    end
    if bodyKind == "none" && template.lineCount != 0
      lspCatalogFail(catalog, text, body.start, "A body with kind 'none' must have no lines.")
      break
    end
    var previous = catalog.first

    while previous != null
      if previous.id == template.id
        lspCatalogFail(catalog, text, entry.start, "Duplicate template id '" + template.id + "'.")
        break
      end
      previous = previous.nextTemplate
    end
    if catalog.error == "" && lspCatalogTemplateValid(catalog, text, entry, template)
      catalog.add(template)
    end
    entry = entry.next
  end
  if catalog.error != ""
    catalog.first = null
    catalog.last = null
  end
  return catalog
end

def lspLoadDeclarationCatalog(path: String): LspDeclarationCatalog
  let text = host.readText(path)

  if text == null
    let catalog = new LspDeclarationCatalog()

    catalog.path = path
    catalog.error = path + ":1:1: Declaration template catalog could not be read."
    return catalog
  end
  return lspParseDeclarationCatalog(text, path)
end

def lspConfiguredDeclarationCatalog(): LspDeclarationCatalog
  let configured = host.environment("NERI_TEMPLATE_CATALOG")

  if configured != null && configured != ""
    return lspLoadDeclarationCatalog(configured)
  end
  let stdlib = host.environment("NERI_STDLIB")

  if stdlib != null
    return lspLoadDeclarationCatalog(bootstrapDirectory(stdlib) + "/share/neri/templates/declarations.json")
  end
  let catalog = new LspDeclarationCatalog()

  catalog.path = "NERI_TEMPLATE_CATALOG"
  catalog.error = "NERI_TEMPLATE_CATALOG:1:1: Declaration template catalog path is not configured."
  return catalog
end
