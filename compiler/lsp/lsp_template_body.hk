sealed class LspTemplateBody
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def block(): LspTemplateBody
    return new LspTemplateBody(0)
  end

  readonly def isBlock(): Bool
    return this.tag == 0
  end

  static def none(): LspTemplateBody
    return new LspTemplateBody(1)
  end

  readonly def isNone(): Bool
    return this.tag == 1
  end

  static def fromName(name: String): LspTemplateBody?
    if name == "block"
      return LspTemplateBody.block()
    end
    if name == "none"
      return LspTemplateBody.none()
    end
    return null
  end
end
