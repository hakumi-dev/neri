# Ito compiles local package sources into a snapshot. Editor analysis keeps the
# compiled dependency graph, but reads the package's live source files.
def lspItoMappedSource(manifest: String, sourcePath: String, reverse: Bool): String
  let content = host::readText(manifest)

  if content == null
    return ""
  end
  let parser = new LspJsonParser(content)
  let config = parser.parse()
  let project = new NeriProject()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(content) || !neriValidateProjectShape(config, project)
    return ""
  end
  let root = bootstrapDirectory(manifest)
  var unit = config.get("units").first

  while unit != null
    let owner = neriUnitKey(manifest, unit.key)

    if !neriRegisterSourceMap(project, manifest, owner, config.get("sourceMap"))
      return ""
    end
    var source = unit.get("sources").first

    while source != null
      if source.isString() && semanticEndsWith(source.scalarText(), ".hk")
        let physical = host::pathAbsolute(root + "/" + source.scalarText())

        if physical != null
          let logical = project.mappedPath(physical, owner)

          if logical != physical
            if reverse && physical == sourcePath
              return logical
            else if !reverse && logical == sourcePath
              return physical
            end
          end
        end
      end
      source = source.next
    end
    unit = unit.next
  end
  return ""
end

def lspItoSnapshotSource(manifest: String, sourcePath: String): String
  return lspItoMappedSource(manifest, sourcePath, false)
end

def lspItoOriginalForSnapshot(path: String): String
  let marker = "/.neri/ito/"
  let boundary = bootstrapFindText(path, marker)

  if boundary < 1
    return ""
  end
  let root = host::stringSlice(path, 0, boundary)
  let manifest = root + "/.neri/ito/manifest.json"

  if host::readText(root + "/package.json") == null || host::readText(manifest) == null
    return ""
  end
  return lspItoMappedSource(manifest, path, true)
end

def lspItoPackageSource(manifest: String, sourcePath: String): Bool
  let root = bootstrapDirectory(bootstrapDirectory(bootstrapDirectory(manifest)))

  if !bootstrapPathWithin(root, sourcePath) || sourcePath == root || host::readText(sourcePath) == null
    return false
  end
  let content = host::readText(root + "/package.json")

  if content == null
    return false
  end
  let parser = new LspJsonParser(content)
  let package = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(content)
    return false
  end
  let relative = host::stringSlice(sourcePath, host::stringByteLength(root) + 1, host::stringByteLength(sourcePath) - host::stringByteLength(root) - 1)
  var source = package.get("neri").get("sources").first

  while source != null
    if source.isString()
      let directory = source.scalarText()

      if neriRelativeProjectPath(directory) && bootstrapStartsWith(relative, directory + "/")
        return true
      end
    end
    source = source.next
  end
  return false
end

def lspItoRemapSources(project: NeriProject, manifest: String): Void
  if !project.remapIdentitySources()
    project.fail("Source identity belongs to multiple project sources.")
  end
end

def lspItoProjectForSource(manifest: String, sourcePath: String, unit: String, control: AnalysisControl?): NeriProject
  let snapshot = lspItoSnapshotSource(manifest, sourcePath)
  let canonical = snapshot == "" ? null : neriCanonicalPath(snapshot)

  if canonical == null
    if lspItoPackageSource(manifest, sourcePath)
      let project = neriLoadProject(manifest, "app", control)

      if project.error() == ""
        lspItoRemapSources(project, manifest)
        if !neriProjectContains(project, sourcePath)
          neriAddProjectSource(project, sourcePath, sourcePath, neriUnitKey(manifest, "app"), true)
        end
      end
      return project
    end
    return neriProjectForSource(manifest, sourcePath, unit, control)
  end
  let project = neriProjectForSource(manifest, canonical, unit, control)

  if project.error() == ""
    lspItoRemapSources(project, manifest)
  end
  return project
end
