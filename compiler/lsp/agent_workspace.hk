use host

# Agent positions use LSP UTF-16 units, with strict bounds for proposed edits.
def agentBytePosition(text: String, position: LspJson): Int
  let offset = lspByteOffset(text, position)

  if offset < 0
    return -1
  end
  let prefix = host.stringSlice(text, 0, offset)
  let actual = (new LspJsonParser(lspPosition(text, (new IrSourceMap(prefix)).utf16Length()))).parse()

  if actual.get("line").value != position.get("line").value || actual.get("character").value != position.get("character").value
    return -1
  end
  return offset
end

def agentDiagnosticJson(document: LspDocument, start: Int, length: Int, code: String, message: String): String
  let location = (new LspJsonParser(lspLocation(document, start, length))).parse()

  return "{\"uri\":" + lspJsonStringify(location.get("uri")) + ",\"range\":" + lspJsonStringify(location.get("range")) + ",\"severity\":1,\"code\":" + lspQuote(code) + ",\"message\":" + lspQuote(message) + "}"
end

def agentSourceExcerpt(text: String, position: Int): String
  let map = new IrSourceMap(text)
  let center = map.offsetAt(position)
  var first = center > 1024 ? center - 1024 : 0
  let length = host.stringByteLength(text)

  while first > 0 && first < length && (host.stringByteAt(text, first) as Int) >= 128 && (host.stringByteAt(text, first) as Int) < 192
    first = first - 1
  end
  if first > 0 && first < length && (host.stringByteAt(text, first) as Int) == 10 && (host.stringByteAt(text, first - 1) as Int) == 13
    first = first - 1
  end
  var last = first + 4096

  if last > length
    last = length
  end
  while last > first && last < length && (host.stringByteAt(text, last) as Int) >= 128 && (host.stringByteAt(text, last) as Int) < 192
    last = last - 1
  end
  if last > first && last < length && (host.stringByteAt(text, last) as Int) == 10 && (host.stringByteAt(text, last - 1) as Int) == 13
    last = last - 1
  end
  let startOffset = (new IrSourceMap(host.stringSlice(text, 0, first))).utf16Length()
  let excerpt = host.stringSlice(text, first, last - first)
  let endOffset = startOffset + (new IrSourceMap(excerpt)).utf16Length()

  return "{\"text\":" + lspQuote(excerpt) + ",\"range\":{\"start\":" + lspPosition(text, startOffset) + ",\"end\":" + lspPosition(text, endOffset) + "},\"truncated\":" + (first > 0 || last < length ? "true" : "false") + "}"
end

def agentDocumentDiagnostics(document: LspDocument): String
  let diagnostics = document.lastDiagnostics
  var result = "["
  var separator = ""
  var index = 0

  if diagnostics == null
    let published = (new LspJsonParser(document.lastPublishedDiagnostics)).parse()
    var item = published.first

    while item != null && index < 128
      let entry = "{\"uri\":" + lspQuote(document.uri) + ",\"range\":" + lspJsonStringify(item.get("range")) + ",\"severity\":" + lspJsonStringify(item.get("severity")) + ",\"code\":" + lspJsonStringify(item.get("code")) + ",\"message\":" + lspJsonStringify(item.get("message")) + "}"

      if host.stringByteLength(result) + host.stringByteLength(entry) > 65534
        break
      end
      result = result + separator + entry
      separator = ","
      index = index + 1
      item = item.next
    end
    return result + "]"
  end
  while index < diagnostics.count() && index < 128
    let start = diagnostics.starts.get(index)
    var source = 0

    while source + 1 < document.sourceStarts.size && document.sourceStarts.get(source + 1) <= start
      source = source + 1
    end
    if source < document.sourceTexts.size
      let entry = agentDiagnosticJson(document, start, diagnostics.lengths.get(index), diagnostics.codes.get(index), diagnostics.messages.get(index))

      if host.stringByteLength(result) + host.stringByteLength(entry) > 65534
        break
      end
      result = result + separator + entry
      separator = ","
    end
    index = index + 1
  end
  return result + "]"
end

class NeriAgentWorkspace
  public root: String = ""
  public unit: String = ""
  public revision: Int = 0
  public server: LspServer = new LspServer("")
  public fingerprint: String = ""
  public project: NeriProject = new NeriProject()
  public inputLimit: Bool = false

  def init(root: String, unit: String): Void
    this.root = root
    this.unit = unit
    this.server.rootPath = neriProjectManifestName(root) ? bootstrapDirectory(root) : root
    this.server.unit = unit
    this.server.documentationEnabled = false
    this.server.codeStyleDiagnostics = false
    this.fingerprint = this.inputFingerprint()
  end

  def addInput(paths: StringBuffer, path: String): Void
    if path != "" && !neriProjectListed(paths, path)
      paths.add(path)
    end
  end

  # Closed dependencies and manifests are observed before each operation.
  # Open buffers remain the source authority until this workspace is disposed.
  def inputFingerprint(): String
    let project = neriLoadProject(this.root, this.unit)
    let paths = new StringBuffer()
    let parts = new StringBuffer()

    this.project = project
    this.inputLimit = false
    this.addInput(paths, project.manifest)
    parts.add(runCacheFrame(project.error) + runCacheFrame(project.kind))
    var index = 0

    while index < project.sources.size
      this.addInput(paths, project.sources.get(index))
      if index < project.sourceOwners.size
        let owner = project.sourceOwners.get(index)
        var split = host.stringByteLength(owner)
        var scan = 0

        while scan < host.stringByteLength(owner)
          if (host.stringByteAt(owner, scan) as Int) == 35
            split = scan
          end
          scan = scan + 1
        end
        this.addInput(paths, host.stringSlice(owner, 0, split))
        parts.add(runCacheFrame(owner))
      end
      index = index + 1
    end
    index = 0
    while index < project.generationManifests.size
      this.addInput(paths, project.generationManifests.get(index))
      index = index + 1
    end
    index = 0
    while index < project.generatedInputs.size
      this.addInput(paths, project.generatedInputs.get(index))
      index = index + 1
    end
    let core = bootstrapCoreLibraryPath()

    if core != null
      this.addInput(paths, core)
    end
    let stdlib = host.environment("NERI_STDLIB")
    var totalBytes = 0

    index = 0
    while index < paths.size
      if paths.size > 1024
        this.inputLimit = true
        break
      end
      let path = paths.get(index)
      let disk = host.readText(path)
      let opened = this.server.findPath(path)
      var text = disk

      if opened != null
        text = opened.text
      end
      var digest = "missing"

      if disk != null
        digest = sha256FastText(disk)
      end
      parts.add(runCacheFrame(path) + runCacheFrame(digest))
      if text != null
        totalBytes = totalBytes + host.stringByteLength(text)
        if totalBytes > 16777216
          this.inputLimit = true
          break
        end
        if stdlib != null && semanticEndsWith(path, ".hk")
          for library in bootstrapLibraryImports(text)
            this.addInput(paths, stdlib + "/" + library + ".hk")
          end
        end
      end
      index = index + 1
    end
    return sha256FastText(lspJoin(parts, 0, parts.size))
  end

  def refresh(): Void
    let fingerprint = this.inputFingerprint()

    if fingerprint != this.fingerprint
      this.fingerprint = fingerprint
      this.revision = this.revision + 1
      this.server.reanalyze()
    end
  end

  def response(operation: String, uri: String, status: String, message: String, document: LspDocument?, applied: Bool = false, analyzed: Bool = false, context: String = "", position: Int = 0): String
    var version = 0
    var analysisStatus = "unavailable"
    var analysisRevision = 0
    var diagnostics = "[]"
    var diagnosticCount = 0
    var emittedDiagnostics = 0
    var snapshot = ""
    var projectKey = ""
    var excerpt = ""

    if document != null
      version = document.version
      if analyzed
        projectKey = document.projectKey
        analysisStatus = document.analysisStatus
        analysisRevision = document.analysisRevision
        diagnostics = agentDocumentDiagnostics(document)
        var emitted = (new LspJsonParser(diagnostics)).parse().first

        while emitted != null
          emittedDiagnostics = emittedDiagnostics + 1
          emitted = emitted.next
        end
        let raw = document.lastDiagnostics

        if raw != null
          diagnosticCount = raw.count()
        else
          var item = (new LspJsonParser(document.lastPublishedDiagnostics)).parse().first

          while item != null
            diagnosticCount = diagnosticCount + 1
            item = item.next
          end
        end
        let parts = new StringBuffer()
        var index = 0

        parts.add(runCacheFrame(document.projectKey))
        while index < document.sourceTexts.size
          parts.add(runCacheFrame(document.sourceUris.get(index)) + runCacheFrame(document.sourceTexts.get(index)))
          index = index + 1
        end
        snapshot = sha256FastText(lspJoin(parts, 0, parts.size))
        excerpt = ",\"sourceExcerpt\":" + agentSourceExcerpt(document.text, position)
      end
    end
    let extra = ",\"projectKey\":" + lspQuote(projectKey) + excerpt + (context == "" ? "" : ",\"context\":" + context)

    return "{\"schemaVersion\":1,\"operationId\":" + lspQuote(operation) + ",\"uri\":" + lspQuote(uri) + ",\"revision\":" + (this.revision as String) + ",\"documentVersion\":" + (version as String) + ",\"status\":" + lspQuote(status) + ",\"message\":" + lspQuote(message) + ",\"analysisStatus\":" + lspQuote(analysisStatus) + ",\"analysisRevision\":" + (analysisRevision as String) + ",\"snapshot\":" + lspQuote(snapshot) + ",\"diagnostics\":" + diagnostics + ",\"diagnosticCount\":" + (diagnosticCount as String) + ",\"diagnosticsTruncated\":" + (diagnosticCount > emittedDiagnostics ? "true" : "false") + ",\"effects\":{\"applied\":" + (applied ? "true" : "false") + ",\"analyzed\":" + (analyzed ? "true" : "false") + ",\"persisted\":false,\"executed\":false}" + extra + "}"
  end

  def handleTool(name: String, arguments: LspJson): String
    let operation = arguments.get("operationId").value
    let uri = arguments.get("uri").value

    this.refresh()
    if this.inputLimit
      return this.response(operation, uri, "limit", "Workspace analysis inputs exceed 1024 paths or 16 MiB.", null)
    end
    if this.project.error != ""
      return this.response(operation, uri, "unavailable", this.project.error, null)
    end
    let rawPath = lspPath(uri)
    var path: String? = null

    if rawPath != null
      path = neriCanonicalPath(rawPath)
    end
    if path == null || !neriProjectListed(this.project.sources, path)
      return this.response(operation, uri, "invalid_request", "URI must identify an existing source in the selected project unit or its references.", null)
    end
    let canonicalUri = lspUri(path)
    var document = this.server.find(canonicalUri)
    var applied = false
    var acceptedFingerprint = this.fingerprint

    if name == "neri.open"
      if document != null
        return this.response(operation, canonicalUri, "conflict", "Buffer is already open; inspect its current revision or edit it.", document)
      end
      let proposed = arguments.get("text")
      var source = host.readText(path)

      if proposed.kind == "string"
        source = proposed.value
      end
      if source == null
        return this.response(operation, canonicalUri, "not_found", "Source is unavailable.", null)
      end
      var count = 0
      var bytes = host.stringByteLength(source)
      var other = this.server.documents

      while other != null
        count = count + 1
        bytes = bytes + host.stringByteLength(other.text)
        other = other.next
      end
      if count >= 64 || bytes > 8388608 || host.stringByteLength(source) > 1048576
        return this.response(operation, canonicalUri, "limit", "Buffers are limited to 64 documents, 1 MiB per document and 8 MiB total.", null)
      end
      let opened = new LspDocument()

      opened.uri = canonicalUri
      opened.sourcePath = path
      opened.text = source
      opened.version = 1
      opened.publishDiagnostics = false
      opened.next = this.server.documents
      this.server.documents = opened
      acceptedFingerprint = this.inputFingerprint()
      if this.inputLimit
        this.server.documents = opened.next
        return this.response(operation, canonicalUri, "limit", "Opening this overlay exceeds the workspace analysis input limit.", null)
      end
      document = opened
      applied = true
    else
      if document == null
        return this.response(operation, canonicalUri, "not_found", "Open the buffer before inspecting or editing it.", null)
      end
      let expected = agentInteger(arguments.get("expectedRevision"))

      if expected == null || expected != this.revision
        return this.response(operation, canonicalUri, "conflict", "Workspace revision changed; inspect the current revision before retrying.", document)
      end
      if name == "neri.edit"
        let range = arguments.get("range")
        let first = agentBytePosition(document.text, range.get("start"))
        let last = agentBytePosition(document.text, range.get("end"))

        if first < 0 || last < first
          return this.response(operation, canonicalUri, "invalid_request", "Edit range must lie on UTF-16 scalar boundaries inside the buffer.", document)
        end
        let source = host.stringSlice(document.text, 0, first) + arguments.get("text").value + host.stringSlice(document.text, last, host.stringByteLength(document.text) - last)
        var bytes = host.stringByteLength(source)
        var other = this.server.documents

        while other != null
          if other.uri != canonicalUri
            bytes = bytes + host.stringByteLength(other.text)
          end
          other = other.next
        end
        if host.stringByteLength(source) > 1048576 || bytes > 8388608
          return this.response(operation, canonicalUri, "limit", "Edit exceeds the document or workspace buffer limit.", document)
        end
        let previous = document.text

        document.text = source
        acceptedFingerprint = this.inputFingerprint()
        if this.inputLimit
          document.text = previous
          return this.response(operation, canonicalUri, "limit", "Edit exceeds the workspace analysis input limit.", document)
        end
        document.version = document.version + 1
        applied = true
      end
    end
    if document == null
      return this.response(operation, canonicalUri, "unavailable", "Buffer is unavailable.", null)
    end
    if applied
      this.revision = this.revision + 1
      this.server.reanalyze()
      this.fingerprint = acceptedFingerprint
    end
    this.server.ensureAnalyzed(document)
    var context = ""
    var inspectOffset = 0

    if name == "neri.inspect"
      let position = agentBytePosition(document.text, arguments.get("position"))

      if position < 0
        return this.response(operation, canonicalUri, "invalid_request", "Position is outside the buffer or splits a UTF-16 scalar.", document)
      end
      let offset = (new IrSourceMap(host.stringSlice(document.text, 0, position))).utf16Length()

      inspectOffset = offset
      context = lspAgentContext(document, offset)
    end
    let before = this.revision

    this.refresh()
    if this.revision != before
      return this.response(operation, canonicalUri, "conflict", "Files changed during analysis; inspect the current revision. Applied buffer edits are retained.", document, applied)
    end
    return this.response(operation, canonicalUri, document.analysisStatus, "", document, applied, true, context, inspectOffset)
  end
end
