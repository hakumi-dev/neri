use host

class AgentLimits
  def projectUnits(): Int
    return 256
  end

  def projectDiagnosticBytes(): Int
    return 262144
  end

  def messageBytes(): Int
    return 2097152
  end

  def operationIdBytes(): Int
    return 256
  end

  def uriBytes(): Int
    return 4096
  end

  def documentBytes(): Int
    return 1048576
  end

  def bufferDocuments(): Int
    return 64
  end

  def bufferBytes(): Int
    return 8388608
  end

  def analysisPaths(): Int
    return 1024
  end

  def analysisBytes(): Int
    return 16777216
  end

  def diagnosticCount(): Int
    return 128
  end

  def diagnosticBytes(): Int
    return 65534
  end

  def excerptPrefixBytes(): Int
    return 1024
  end

  def excerptBytes(): Int
    return 4096
  end
end
