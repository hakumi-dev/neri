def lspCodeStyleConfig(document: LspDocument): NeriCodeStyleConfigResult
  if document.sourcePath == ""
    return new NeriCodeStyleConfigResult()
  end
  return codeStyleOptionsFor(document.sourcePath)
end

def lspCodeStyleEdit(document: LspDocument, edit: NeriCodeStyleEdit): String
  return "{\"range\":{\"start\":" + lspPosition(document.text, edit.start) + ",\"end\":" + lspPosition(document.text, edit.start + edit.length) + "},\"newText\":" + lspQuote(edit.replacement) + "}"
end

def lspCodeStyleEdits(document: LspDocument, edits: NeriCodeStyleEdit?): String
  var result = ""
  var separator = ""
  var edit = edits

  while edit != null
    result = result + separator + lspCodeStyleEdit(document, edit)
    separator = ","
    edit = edit.next
  end
  return result
end

def lspCodeStyleDiagnostic(document: LspDocument, finding: NeriCodeStyleFinding): String
  let severity = finding.severity == "error" ? 1 : (finding.severity == "warning" ? 2 : 3)

  return "{\"range\":{\"start\":" + lspPosition(document.text, finding.start) + ",\"end\":" + lspPosition(document.text, finding.start + finding.length) + "},\"severity\":" + (severity as String) + ",\"code\":" + lspQuote(finding.ruleId) + ",\"source\":\"neri\",\"message\":" + lspQuote(finding.message) + "}"
end

def lspCodeStyleDiagnostics(document: LspDocument): String
  let config = lspCodeStyleConfig(document)

  if config.error != ""
    return "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":2,\"code\":\"NRSTYLE_CONFIG\",\"source\":\"neri\",\"message\":" + lspQuote(config.error) + "}"
  end
  let analysis = neriCodeStyleAnalyzeText(document.text, config.options)
  var result = ""
  var separator = ""
  var finding = analysis.findings

  while finding != null
    if finding.severity != "none"
      result = result + separator + lspCodeStyleDiagnostic(document, finding)
      separator = ","
    end
    finding = finding.next
  end
  return result
end

def lspCodeStyleFormatting(document: LspDocument): String
  let config = lspCodeStyleConfig(document)

  if config.error != ""
    return "[]"
  end
  let analysis = neriCodeStyleAnalyzeText(document.text, config.options)

  if !analysis.valid || !neriCodeStyleApplyChecked(document.text, analysis.edits).valid
    return "[]"
  end
  return "[" + lspCodeStyleEdits(document, analysis.edits) + "]"
end

def lspCodeStyleActions(document: LspDocument, selectionStart: Int, selectionEnd: Int, quickFix: Bool, fixAll: Bool): String
  let config = lspCodeStyleConfig(document)

  if config.error != "" || (!quickFix && !fixAll)
    return "[]"
  end
  let analysis = neriCodeStyleAnalyzeText(document.text, config.options)

  if !analysis.valid || !neriCodeStyleApplyChecked(document.text, analysis.edits).valid
    return "[]"
  end
  var result = "["
  var separator = ""
  var finding = analysis.findings

  while finding != null
    let edit = finding.edit
    let finish = finding.start + finding.length
    let selected = selectionStart == selectionEnd ? selectionStart >= finding.start && selectionStart < finish : selectionStart < finish && selectionEnd > finding.start

    if quickFix && selected && finding.safeFix && edit != null
      result = result + separator + "{\"title\":" + lspQuote(finding.message) + ",\"kind\":\"quickfix\",\"diagnostics\":[" + lspCodeStyleDiagnostic(document, finding) + "],\"edit\":" + lspVersionedUseEdit(document, lspCodeStyleEdit(document, edit)) + "}"
      separator = ","
    end
    finding = finding.next
  end
  if fixAll && analysis.edits != null
    result = result + separator + "{\"title\":\"Fix all Neri code style issues\",\"kind\":\"source.fixAll.neri\",\"edit\":" + lspVersionedUseEdit(document, lspCodeStyleEdits(document, analysis.edits)) + "}"
  end
  return result + "]"
end

def lspJoinActionArrays(first: String, second: String): String
  if first == "[]"
    return second
  end
  if second == "[]"
    return first
  end
  return host.stringSlice(first, 0, host.stringByteLength(first) - 1) + "," + host.stringSlice(second, 1, host.stringByteLength(second) - 1)
end
