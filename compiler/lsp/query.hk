
def lspQueryEntryKey(identity: String, sourceKey: String, sourceOffset: Int, length: Int, declaration: Bool): String
  # Length prefixes preserve tuple equality even when a URI contains delimiters.
  return (host.stringByteLength(identity) as String) + ":" + identity + (host.stringByteLength(sourceKey) as String) + ":" + sourceKey + ":" + (sourceOffset as String) + ":" + (length as String) + ":" + (declaration ? "1" : "0")
end

def lspSnapshotKey(snapshot: LspSemanticSnapshot): String
  let uri = snapshot.sourceUris.size > 0 ? snapshot.sourceUris.get(0) : ""

  return snapshot.projectKey + "|" + (snapshot.projectRevision as String) + "|" + uri
end

def lspSnapshotSourceKey(snapshot: LspSemanticSnapshot, position: Int): String
  let source = snapshot.sourceAt(position)

  if source == null
    return ""
  end
  return source.uri
end

def lspSnapshotSourceOffset(snapshot: LspSemanticSnapshot, position: Int): Int
  let source = snapshot.sourceAt(position)

  if source == null
    return -1
  end
  return position - source.start
end

# Semantic identities for locals are intentionally compact and can repeat in
# separate compilation units. Query identities therefore anchor every resolved
# identity to its canonical declaration source location. This also gives a
# generated generic occurrence the template declaration it already resolves to.
def lspQueryCanonicalIdentity(snapshot: LspSemanticSnapshot, identity: String): String
  return snapshot.canonicalIdentity(identity)
end

def lspQueryLocation(snapshot: LspSemanticSnapshot, start: Int, length: Int): LspQueryLocation?
  var index = 0

  while index + 1 < snapshot.sourceStarts.size && snapshot.sourceStarts.get(index + 1) <= start
    index = index + 1
  end
  if index < 0 || index >= snapshot.sourceUris.size || index >= snapshot.sourceTexts.size || index >= snapshot.sourceStarts.size
    return null
  end
  let relative = start - snapshot.sourceStarts.get(index)
  let textLength = (new IrSourceMap(snapshot.sourceTexts.get(index))).utf16Length()

  if relative < 0 || length <= 0 || relative + length > textLength
    return null
  end
  let location = new LspQueryLocation()

  location.snapshot = snapshot
  location.snapshotKey = lspSnapshotKey(snapshot)
  location.sourceKey = lspSnapshotSourceKey(snapshot, start)
  location.start = start
  location.sourceOffset = relative
  location.length = length
  return location
end

def lspSnapshotIdentityAt(snapshot: LspSemanticSnapshot, position: Int): String
  let semantic = snapshot.semantic

  if semantic == null
    return ""
  end
  return lspSymbolAt(semantic, position)
end

def lspIndexDefinition(index: LspSemanticIndex, identity: String): LspQueryLocation?
  var entry = index.first

  while entry != null
    if entry.declaration && entry.identity == identity
      let snapshot = entry.snapshot

      if snapshot != null
        return lspQueryLocation(snapshot, entry.start, entry.length)
      end
    end
    entry = entry.next
  end
  return null
end

def lspQueryLocationSeen(locations: LspQueryLocation?, candidate: LspQueryLocation): Bool
  var location = locations

  while location != null
    if location.sourceKey == candidate.sourceKey && location.sourceOffset == candidate.sourceOffset && location.length == candidate.length
      return true
    end
    location = location.next
  end
  return false
end

def lspIndexReferences(index: LspSemanticIndex, identity: String, includeDeclaration: Bool): LspQueryLocation?
  var first: LspQueryLocation? = null
  var last: LspQueryLocation? = null
  var entry = index.first

  while entry != null
    if entry.identity == identity && (includeDeclaration || !entry.declaration)
      let snapshot = entry.snapshot

      if snapshot != null
        let location = lspQueryLocation(snapshot, entry.start, entry.length)

        if location != null && !lspQueryLocationSeen(first, location)
          if first == null
            first = location
          else if last != null
            last.next = location
          end
          last = location
        end
      end
    end
    entry = entry.next
  end
  return first
end

def lspIndexNameMatches(name: String, query: String): Bool
  if query == ""
    return true
  end
  var start = 0

  while start + host.stringByteLength(query) <= host.stringByteLength(name)
    var equal = true
    var offset = 0

    while offset < host.stringByteLength(query)
      var left = host.stringByteAt(name, start + offset) as Int
      var right = host.stringByteAt(query, offset) as Int

      if left >= 65 && left <= 90
        left = left + 32
      end
      if right >= 65 && right <= 90
        right = right + 32
      end
      if left != right
        equal = false
      end
      offset = offset + 1
    end
    if equal
      return true
    end
    start = start + 1
  end
  return false
end

def lspIndexWorkspaceSymbols(index: LspSemanticIndex, query: String): LspQuerySymbol?
  var first: LspQuerySymbol? = null
  var last: LspQuerySymbol? = null
  var entry = index.first

  while entry != null
    # Workspace search is a project API surface: declarations of local
    # variables and parameters are navigated through document queries, not
    # advertised beside types, members, and module functions.
    if entry.declaration && entry.kind != 13 && lspIndexNameMatches(entry.name, query)
      let snapshot = entry.snapshot

      if snapshot != null
        let location = lspQueryLocation(snapshot, entry.start, entry.length)

        if location != null
          let symbol = new LspQuerySymbol()

          symbol.identity = entry.identity
          symbol.name = entry.name
          symbol.kind = entry.kind
          symbol.location = location
          if first == null
            first = symbol
          else if last != null
            last.next = symbol
          end
          last = symbol
        end
      end
    end
    entry = entry.next
  end
  return first
end
