# Shared semantic-query façade for one immutable project analysis generation.
# The server supplies complete project snapshots; this layer never reads files,
# reparses text, resolves names, or formats LSP JSON.

class LspSemanticSnapshot
  public projectKey: String = ""
  public projectRevision: Int = 0
  public semantic: SemanticModel?
  public sourceUris: StringBuffer = new StringBuffer()
  public sourceTexts: StringBuffer = new StringBuffer()
  public sourceStarts: IntBuffer = new IntBuffer()
  # -1 denotes a closed source read from the project snapshot.
  public sourceVersions: IntBuffer = new IntBuffer()
  public requireEntryPoint: Bool = true
  public forbiddenEntryPointSources: StringBuffer = new StringBuffer()
  # Rename may edit exported symbols only when the server proved this snapshot
  # contains every editable project source that can reference them.
  public renameClosedWorld: Bool = false
  public renameOwnedSourceUris: StringBuffer = new StringBuffer()
end

class LspQueryLocation
  public snapshot: LspSemanticSnapshot?
  public snapshotKey: String = ""
  public sourceKey: String = ""
  public start: Int = 0
  # UTF-16 offset within sourceKey. Unlike start, this is stable when a
  # project snapshot orders its closed sources differently.
  public sourceOffset: Int = 0
  public length: Int = 0
  public next: LspQueryLocation?
end

class LspQuerySymbol
  public identity: String = ""
  public name: String = ""
  public kind: Int = 0
  public location: LspQueryLocation?
  public next: LspQuerySymbol?
end

class LspSemanticQueryEntry
  public identity: String = ""
  public name: String = ""
  public kind: Int = 0
  public start: Int = 0
  public sourceOffset: Int = 0
  public length: Int = 0
  public declaration: Bool = false
  public snapshot: LspSemanticSnapshot?
  public snapshotKey: String = ""
  public sourceKey: String = ""
  public next: LspSemanticQueryEntry?
end

class LspSemanticIndex
  public projectKey: String = ""
  public projectRevision: Int = 0
  public first: LspSemanticQueryEntry?
  public last: LspSemanticQueryEntry?

  # A caller replaces the whole project generation after any source or project
  # change. This prevents queries from mixing models from different versions.
  def begin(projectKey: String, projectRevision: Int): Void
    if this.projectKey == projectKey && this.projectRevision == projectRevision
      return
    end
    this.projectKey = projectKey
    this.projectRevision = projectRevision
    this.first = null
    this.last = null
  end

  def contains(identity: String, snapshot: LspSemanticSnapshot, start: Int, length: Int, declaration: Bool): Bool
    let sourceKey = lspSnapshotSourceKey(snapshot, start)
    let sourceOffset = lspSnapshotSourceOffset(snapshot, start)
    var entry = this.first
    while entry != null
      if entry.identity == identity && entry.sourceKey == sourceKey && entry.sourceOffset == sourceOffset && entry.length == length && entry.declaration == declaration
        return true
      end
      entry = entry.next
    end
    return false
  end

  def add(identity: String, name: String, kind: Int, snapshot: LspSemanticSnapshot, start: Int, length: Int, declaration: Bool): Void
    if identity == "" || length <= 0 || this.contains(identity, snapshot, start, length, declaration)
      return
    end
    let entry = new LspSemanticQueryEntry()
    entry.identity = identity
    entry.name = name
    entry.kind = kind
    entry.start = start
    entry.sourceOffset = lspSnapshotSourceOffset(snapshot, start)
    entry.length = length
    entry.declaration = declaration
    entry.snapshot = snapshot
    entry.snapshotKey = lspSnapshotKey(snapshot)
    entry.sourceKey = lspSnapshotSourceKey(snapshot, start)
    let tail = this.last
    if tail == null
      this.first = entry
    else
      tail.next = entry
    end
    this.last = entry
  end

  def addSnapshot(snapshot: LspSemanticSnapshot): Void
    if snapshot.projectKey != this.projectKey || snapshot.projectRevision != this.projectRevision
      return
    end
    let semantic = snapshot.semantic
    if semantic == null
      return
    end
    var declaration = semantic.declarations
    while declaration != null
      let kind = lspSourceSymbolKind(semantic, declaration)
      if kind != 0 && !lspSourceSymbolIsGenerated(declaration.identity)
        this.add(lspQueryCanonicalIdentity(snapshot, declaration.identity), declaration.name, kind, snapshot, declaration.start, declaration.length, true)
      end
      declaration = declaration.next
    end
    var occurrence = semantic.occurrences
    while occurrence != null
      this.add(lspQueryCanonicalIdentity(snapshot, occurrence.identity), "", 0, snapshot, occurrence.start, occurrence.length, false)
      occurrence = occurrence.next
    end
    var node = semantic.bound.first.nextNode
    while node != null
      if (node.kind == "Name" || node.kind == "Assignment") && node.typeName != "Error" && node.symbol != ""
        this.add(lspQueryCanonicalIdentity(snapshot, node.symbol), "", 0, snapshot, node.start, node.length, false)
      end
      node = node.nextNode
    end
  end
end

def lspSnapshotKey(snapshot: LspSemanticSnapshot): String
  let uri = snapshot.sourceUris.size > 0 ? snapshot.sourceUris.get(0) : ""
  return snapshot.projectKey + "|" + (snapshot.projectRevision as String) + "|" + uri
end

def lspSnapshotSourceKey(snapshot: LspSemanticSnapshot, position: Int): String
  var index = 0
  while index + 1 < snapshot.sourceStarts.size && snapshot.sourceStarts.get(index + 1) <= position
    index = index + 1
  end
  if index < 0 || index >= snapshot.sourceUris.size || index >= snapshot.sourceStarts.size
    return ""
  end
  return snapshot.sourceUris.get(index)
end

def lspSnapshotSourceOffset(snapshot: LspSemanticSnapshot, position: Int): Int
  var index = 0
  while index + 1 < snapshot.sourceStarts.size && snapshot.sourceStarts.get(index + 1) <= position
    index = index + 1
  end
  if index < 0 || index >= snapshot.sourceStarts.size
    return -1
  end
  return position - snapshot.sourceStarts.get(index)
end

# Semantic identities for locals are intentionally compact and can repeat in
# separate compilation units. Query identities therefore anchor every resolved
# identity to its canonical declaration source location. This also gives a
# generated generic occurrence the template declaration it already resolves to.
def lspQueryCanonicalIdentity(snapshot: LspSemanticSnapshot, identity: String): String
  if identity == ""
    return ""
  end
  let semantic = snapshot.semantic
  if semantic == null
    return identity + "|unresolved|" + lspSnapshotKey(snapshot)
  end
  var declaration = semantic.declarations
  while declaration != null
    if declaration.identity == identity
      return identity + "|" + lspSnapshotSourceKey(snapshot, declaration.start) + "|" + (lspSnapshotSourceOffset(snapshot, declaration.start) as String)
    end
    declaration = declaration.next
  end
  return identity + "|unresolved|" + lspSnapshotKey(snapshot)
end

def lspQueryLocation(snapshot: LspSemanticSnapshot, start: Int, length: Int): LspQueryLocation?
  var index = 0
  while index + 1 < snapshot.sourceStarts.size && snapshot.sourceStarts.get(index + 1) <= start
    index = index + 1
  end
  if index < 0 || index >= snapshot.sourceUris.size || index >= snapshot.sourceTexts.size || index >= snapshot.sourceStarts.size
    return null
  end
  let relative = start - snapshot.sourceStarts.get(index)
  let textLength = (new IrSourceMap(snapshot.sourceTexts.get(index))).utf16Length()
  if relative < 0 || length <= 0 || relative + length > textLength
    return null
  end
  let location = new LspQueryLocation()
  location.snapshot = snapshot
  location.snapshotKey = lspSnapshotKey(snapshot)
  location.sourceKey = lspSnapshotSourceKey(snapshot, start)
  location.start = start
  location.sourceOffset = relative
  location.length = length
  return location
end

def lspSnapshotIdentityAt(snapshot: LspSemanticSnapshot, position: Int): String
  let semantic = snapshot.semantic
  if semantic == null
    return ""
  end
  return lspSymbolAt(semantic, position)
end

def lspIndexDefinition(index: LspSemanticIndex, identity: String): LspQueryLocation?
  var entry = index.first
  while entry != null
    if entry.declaration && entry.identity == identity
      let snapshot = entry.snapshot
      if snapshot != null
        return lspQueryLocation(snapshot, entry.start, entry.length)
      end
    end
    entry = entry.next
  end
  return null
end

def lspQueryLocationSeen(locations: LspQueryLocation?, candidate: LspQueryLocation): Bool
  var location = locations
  while location != null
    if location.sourceKey == candidate.sourceKey && location.sourceOffset == candidate.sourceOffset && location.length == candidate.length
      return true
    end
    location = location.next
  end
  return false
end

def lspIndexReferences(index: LspSemanticIndex, identity: String, includeDeclaration: Bool): LspQueryLocation?
  var first: LspQueryLocation? = null
  var last: LspQueryLocation? = null
  var entry = index.first
  while entry != null
    if entry.identity == identity && (includeDeclaration || !entry.declaration)
      let snapshot = entry.snapshot
      if snapshot != null
        let location = lspQueryLocation(snapshot, entry.start, entry.length)
        if location != null && !lspQueryLocationSeen(first, location)
          if first == null
            first = location
          else if last != null
            last.next = location
          end
          last = location
        end
      end
    end
    entry = entry.next
  end
  return first
end

def lspIndexNameMatches(name: String, query: String): Bool
  if query == ""
    return true
  end
  var start = 0
  while start + host.stringByteLength(query) <= host.stringByteLength(name)
    var equal = true
    var offset = 0
    while offset < host.stringByteLength(query)
      var left = host.stringByteAt(name, start + offset) as Int
      var right = host.stringByteAt(query, offset) as Int
      if left >= 65 && left <= 90
        left = left + 32
      end
      if right >= 65 && right <= 90
        right = right + 32
      end
      if left != right
        equal = false
      end
      offset = offset + 1
    end
    if equal
      return true
    end
    start = start + 1
  end
  return false
end

def lspIndexWorkspaceSymbols(index: LspSemanticIndex, query: String): LspQuerySymbol?
  var first: LspQuerySymbol? = null
  var last: LspQuerySymbol? = null
  var entry = index.first
  while entry != null
    # Workspace search is a project API surface: declarations of local
    # variables and parameters are navigated through document queries, not
    # advertised beside types, members, and module functions.
    if entry.declaration && entry.kind != 13 && lspIndexNameMatches(entry.name, query)
      let snapshot = entry.snapshot
      if snapshot != null
        let location = lspQueryLocation(snapshot, entry.start, entry.length)
        if location != null
          let symbol = new LspQuerySymbol()
          symbol.identity = entry.identity
          symbol.name = entry.name
          symbol.kind = entry.kind
          symbol.location = location
          if first == null
            first = symbol
          else if last != null
            last.next = symbol
          end
          last = symbol
        end
      end
    end
    entry = entry.next
  end
  return first
end
