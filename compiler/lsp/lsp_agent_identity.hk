sealed class LspAgentIdentity
  private outcome: LspIdentityOutcome
  private def init(outcome: LspIdentityOutcome): Void
    this.outcome = outcome
  end
  static def none(): LspAgentIdentity
    return new LspAgentIdentity(LspIdentityOutcome.None())
  end
  static def unresolved(semantic: String): LspAgentIdentity
    return new LspAgentIdentity(LspIdentityOutcome.Unresolved(semantic))
  end
  static def resolved(semantic: String, canonical: String): LspAgentIdentity
    return new LspAgentIdentity(LspIdentityOutcome.Canonical(semantic, canonical))
  end
  def canonical(): String
    match this.outcome
      case LspIdentityOutcome.None()
        return ""
      case LspIdentityOutcome.Unresolved(semantic)
        return ""
      case LspIdentityOutcome.Canonical(semantic, canonical)
        return canonical
    end
  end
  def semantic(): String
    match this.outcome
      case LspIdentityOutcome.None()
        return ""
      case LspIdentityOutcome.Unresolved(semantic)
        return semantic
      case LspIdentityOutcome.Canonical(semantic, canonical)
        return semantic
    end
  end
  def wireName(): String
    match this.outcome
      case LspIdentityOutcome.None()
        return "none"
      case LspIdentityOutcome.Unresolved(semantic)
        return "unresolved"
      case LspIdentityOutcome.Canonical(semantic, canonical)
        return "canonical"
    end
  end
end

