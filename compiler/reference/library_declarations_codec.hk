def libraryDeclarationWriteSymbol(writer: SemanticSnapshotWriter, symbol: IrSymbol): Void
  writer.integer(symbol.kind.wireCode())
  writer.string(symbol.name)
end

def libraryDeclarationReadSymbol(reader: SemanticSnapshotReader, moduleName: String, expected: Int = 0): IrSymbol
  let code = reader.integer()
  let name = reader.string()

  reader.fail() if code < 1 || code > 10 || (expected != 0 && code != expected) || name == ""
  let safe = code < 1 || code > 10 ? 1 : code

  return irSymbol(moduleName, IrSymbolKind.createCatalog()[safe - 1], name)
end

def libraryDeclarationWriteOptionalSymbol(writer: SemanticSnapshotWriter, symbol: IrSymbol?): Void
  writer.boolean(symbol != null)
  libraryDeclarationWriteSymbol(writer, symbol) if symbol != null
end

def libraryDeclarationReadOptionalSymbol(reader: SemanticSnapshotReader, moduleName: String, expected: Int = 0): IrSymbol?
  if reader.boolean()
    return libraryDeclarationReadSymbol(reader, moduleName, expected)
  end
  return null
end

def libraryDeclarationEffects(bits: Int): EffectSet
  var result = new EffectSet()

  result = result.withRead() if referenceHasBit(bits, 1)
  result = result.withWrite() if referenceHasBit(bits, 2)
  result = result.withMayPanic() if referenceHasBit(bits, 4)
  result = result.withManagedAllocate() if referenceHasBit(bits, 8)
  result = result.withNativeAllocate() if referenceHasBit(bits, 16)
  result = result.withSafepoint() if referenceHasBit(bits, 32)
  result = result.withUnsafe() if referenceHasBit(bits, 64)
  result = result.withNoReturn() if referenceHasBit(bits, 128)
  return result
end

def libraryDeclarationReadEffects(reader: SemanticSnapshotReader): EffectSet
  let bits = reader.integer()

  reader.fail() if bits < 0 || bits > 255
  return libraryDeclarationEffects(bits)
end

def libraryDeclarationWriteField(writer: SemanticSnapshotWriter, field: IrField): Void
  libraryDeclarationWriteSymbol(writer, field.symbol)
  writer.string(field.typeName)
  writer.integer(field.access.wireCode())
end

def libraryDeclarationReadField(reader: SemanticSnapshotReader, moduleName: String): IrField
  let symbol = libraryDeclarationReadSymbol(reader, moduleName, 2)
  let typeName = reader.string()
  let accessCode = reader.integer()

  reader.fail() if irTypeTag(typeName) == 0 || accessCode < 1 || accessCode > 4
  let safe = accessCode < 1 || accessCode > 4 ? 1 : accessCode

  return new IrField(symbol, typeName, IrAccess.createCatalog()[safe - 1], irNoLocation())
end

def libraryDeclarationWriteMethod(writer: SemanticSnapshotWriter, method: IrMethod): Void
  libraryDeclarationWriteSymbol(writer, method.functionSymbol)
  writer.integer(method.dispatch.wireCode())
  libraryDeclarationWriteOptionalSymbol(writer, method.dispatchSlot)
end

def libraryDeclarationReadMethod(reader: SemanticSnapshotReader, moduleName: String): IrMethod
  let symbol = libraryDeclarationReadSymbol(reader, moduleName, 3)
  let dispatchCode = reader.integer()
  let slot = libraryDeclarationReadOptionalSymbol(reader, moduleName, 3)

  reader.fail() if dispatchCode < 1 || dispatchCode > 3 || ((dispatchCode == 3) != (slot != null))
  let safe = dispatchCode < 1 || dispatchCode > 3 ? 1 : dispatchCode

  return new IrMethod(symbol, IrDispatchKind.createCatalog()[safe - 1], slot, irNoLocation())
end

def libraryDeclarationWriteClass(writer: SemanticSnapshotWriter, value: IrClass): Void
  libraryDeclarationWriteSymbol(writer, value.symbol)
  libraryDeclarationWriteOptionalSymbol(writer, value.baseSymbol)
  writer.integer(value.access.wireCode())
  writer.integer(value.fieldCount)
  var field = value.firstField

  while field != null
    libraryDeclarationWriteField(writer, field)
    field = field.nextField
  end
  writer.integer(value.methodCount)
  var method = value.firstMethod

  while method != null
    libraryDeclarationWriteMethod(writer, method)
    method = method.nextMethod
  end
end

def libraryDeclarationReadClass(reader: SemanticSnapshotReader, moduleName: String): IrClass
  let symbol = libraryDeclarationReadSymbol(reader, moduleName, 1)
  let base = libraryDeclarationReadOptionalSymbol(reader, moduleName, 1)
  let accessCode = reader.integer()

  reader.fail() if accessCode < 1 || accessCode > 4
  let safe = accessCode < 1 || accessCode > 4 ? 1 : accessCode
  let value = new IrClass(symbol, base, IrAccess.createCatalog()[safe - 1], irNoLocation())

  value.retained = true
  let fields = reader.count()
  var index = 0

  while index < fields && !reader.failed
    value.addField(libraryDeclarationReadField(reader, moduleName))
    index = index + 1
  end
  let methods = reader.count()

  index = 0
  while index < methods && !reader.failed
    value.addMethod(libraryDeclarationReadMethod(reader, moduleName))
    index = index + 1
  end
  return value
end

def libraryDeclarationWriteRecord(writer: SemanticSnapshotWriter, value: IrNativeRecord): Void
  libraryDeclarationWriteSymbol(writer, value.symbol)
  writer.boolean(value.unionType)
  writer.integer(value.fieldCount)
  var field = value.firstField

  while field != null
    libraryDeclarationWriteField(writer, field)
    field = field.nextField
  end
end

def libraryDeclarationReadRecord(reader: SemanticSnapshotReader, moduleName: String): IrNativeRecord
  let symbol = libraryDeclarationReadSymbol(reader, moduleName, 10)
  let value = new IrNativeRecord(symbol, reader.boolean())
  let fields = reader.count()
  var index = 0

  while index < fields && !reader.failed
    value.addField(libraryDeclarationReadField(reader, moduleName))
    index = index + 1
  end
  return value
end

def libraryDeclarationWriteFunction(writer: SemanticSnapshotWriter, value: IrFunction): Void
  libraryDeclarationWriteSymbol(writer, value.symbol)
  writer.integer(value.kind.wireCode())
  writer.string(value.resultType)
  writer.stringBuffer(value.parameterTypes)
  writer.integer(value.effects.bits())
  writer.integer(value.localEffects.bits())
  writer.boolean(value.unsafeCall)
  writer.boolean(value.parallelUnsafe)
  writer.string(value.cExportSymbol)
  libraryDeclarationWriteOptionalSymbol(writer, value.declaringClass)
  libraryDeclarationWriteOptionalSymbol(writer, value.dispatchSlot)
  writer.stringBuffer(irFunctionLinkReferences(value))
end

def libraryDeclarationReadFunction(reader: SemanticSnapshotReader, moduleName: String): IrFunction
  let symbol = libraryDeclarationReadSymbol(reader, moduleName)
  let kindCode = reader.integer()
  let resultType = reader.string()
  let parameterTypes = reader.stringBuffer()
  let effects = libraryDeclarationReadEffects(reader)
  let localEffects = libraryDeclarationReadEffects(reader)
  let unsafeCall = reader.boolean()
  let parallelUnsafe = reader.boolean()
  let cExportSymbol = reader.string()
  let owner = libraryDeclarationReadOptionalSymbol(reader, moduleName, 1)
  let slot = libraryDeclarationReadOptionalSymbol(reader, moduleName, 3)
  let references = reader.stringBuffer()

  reader.fail() if (symbol.kind.wireCode() != 3 && symbol.kind.wireCode() != 4) || kindCode < 1 || kindCode > 5 || irTypeTag(resultType) == 0 || (owner == null && slot != null)
  var parameter = parameterTypes.first.nextNode

  while parameter != null
    reader.fail() if irTypeTag(parameter.value) == 0 || parameter.value == "void"
    parameter = parameter.nextNode
  end
  let safe = kindCode < 1 || kindCode > 5 ? 1 : kindCode
  let value = new IrFunction(symbol, resultType, IrFunctionKind.createCatalog()[safe - 1], unsafeCall, irNoLocation())

  value.retained = true
  value.parameterTypes = parameterTypes
  value.effects = effects
  value.localEffects = localEffects
  value.parallelUnsafe = parallelUnsafe
  value.cExportSymbol = cExportSymbol
  value.declaringClass = owner
  value.dispatchSlot = slot
  value.linkReferences = references
  return value
end

def libraryDeclarationWriteImport(writer: SemanticSnapshotWriter, value: IrImport): Void
  libraryDeclarationWriteSymbol(writer, value.symbol)
  writer.integer(value.kind.wireCode())
  writer.string(value.resultType)
  writer.stringBuffer(value.parameterTypes)
  writer.string(value.linkName)
  writer.string(value.nativeLibrary)
  writer.integer(value.effects.bits())
  writer.integer(value.runtimeMajor)
  writer.integer(value.runtimeMinor)
  writer.integer(value.runtimeFeatures.bits())
end

def libraryDeclarationReadImport(reader: SemanticSnapshotReader, moduleName: String): IrImport
  let symbol = libraryDeclarationReadSymbol(reader, moduleName)
  let kindCode = reader.integer()
  let resultType = reader.string()
  let parameters = reader.stringBuffer()
  let linkName = reader.string()
  let nativeLibrary = reader.string()
  let effects = libraryDeclarationReadEffects(reader)
  let major = reader.integer()
  let minor = reader.integer()
  let features = reader.integer()

  reader.fail() if kindCode < 1 || kindCode > 2 || irTypeTag(resultType) == 0 || linkName == "" || major < -1 || minor < 0 || features < 0 || features > 1073741823
  var parameter = parameters.first.nextNode

  while parameter != null
    reader.fail() if irTypeTag(parameter.value) == 0 || parameter.value == "void"
    parameter = parameter.nextNode
  end
  let safe = kindCode < 1 || kindCode > 2 ? 1 : kindCode
  let value = new IrImport(symbol, resultType, IrImportKind.createCatalog()[safe - 1], linkName, effects, irNoLocation())

  value.parameterTypes = parameters
  value.nativeLibrary = nativeLibrary
  value.runtimeMajor = major
  value.runtimeMinor = minor
  value.runtimeFeatures = libraryDeclarationRuntimeFeatures(features)
  return value
end

def libraryDeclarationRuntimeFeatures(bits: Int): RuntimeFeatures
  var result = new RuntimeFeatures()

  result = result.withPreciseGc() if referenceHasBit(bits, 1)
  result = result.withNonmovingGc() if referenceHasBit(bits, 2)
  result = result.withScopedBorrows() if referenceHasBit(bits, 4)
  result = result.withNativeMemory() if referenceHasBit(bits, 8)
  result = result.withRootFrames() if referenceHasBit(bits, 16)
  result = result.withSourceLocations() if referenceHasBit(bits, 32)
  result = result.withNativeStrings() if referenceHasBit(bits, 64)
  result = result.withConsoleIo() if referenceHasBit(bits, 128)
  result = result.withInlineAggregates() if referenceHasBit(bits, 256)
  result = result.withExtendedScalars() if referenceHasBit(bits, 512)
  result = result.withMultipleMutators() if referenceHasBit(bits, 1024)
  result = result.withBootstrapHost() if referenceHasBit(bits, 2048)
  result = result.withSockets() if referenceHasBit(bits, 4096)
  result = result.withInteractiveIo() if referenceHasBit(bits, 8192)
  result = result.withScopedTasks() if referenceHasBit(bits, 16384)
  result = result.withFiles() if referenceHasBit(bits, 32768)
  result = result.withInterrupts() if referenceHasBit(bits, 65536)
  result = result.withWallClock() if referenceHasBit(bits, 131072)
  result = result.withCrypto() if referenceHasBit(bits, 262144)
  result = result.withRootedFiles() if referenceHasBit(bits, 524288)
  result = result.withProcess() if referenceHasBit(bits, 1048576)
  result = result.withDirectory() if referenceHasBit(bits, 2097152)
  result = result.withSocketCloseResult() if referenceHasBit(bits, 4194304)
  result = result.withSessionModules() if referenceHasBit(bits, 8388608)
  result = result.withDrain() if referenceHasBit(bits, 16777216)
  result = result.withOptionalConsoleRead() if referenceHasBit(bits, 33554432)
  result = result.withProcessIo() if referenceHasBit(bits, 67108864)
  result = result.withFilesystemMutation() if referenceHasBit(bits, 134217728)
  result = result.withSocketEndpoints() if referenceHasBit(bits, 268435456)
  result = result.withSequentialArrays() if referenceHasBit(bits, 536870912)
  return result
end
