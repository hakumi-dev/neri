# This is a declaration image. Executable bodies remain in the provider object.
def libraryDeclarationsEncode(module: IrModule): String?
  let writer = new SemanticSnapshotWriter()

  writer.string("neri-library-declarations-v2")
  writer.string(module.id)
  writer.strings(module.requiredFeatures.orderedNames())
  writer.integer(module.classCount)
  var classValue = module.firstClass

  while classValue != null
    libraryDeclarationWriteClass(writer, classValue)
    classValue = classValue.nextClass
  end
  writer.integer(module.recordCount)
  var record = module.firstRecord

  while record != null
    libraryDeclarationWriteRecord(writer, record)
    record = record.nextRecord
  end
  writer.integer(module.functionCount)
  var function = module.firstFunction

  while function != null
    libraryDeclarationWriteFunction(writer, function)
    function = function.nextFunction
  end
  writer.integer(module.importCount)
  var importValue = module.firstImport

  while importValue != null
    libraryDeclarationWriteImport(writer, importValue)
    importValue = importValue.nextImport
  end
  return writer.finish()
end

def libraryDeclarationsDecode(payload: String, moduleName: String, domains: IrDomainCatalog? = null): IrModule?
  let reader = new SemanticSnapshotReader(payload)

  if reader.string() != "neri-library-declarations-v2"
    return null
  end
  let providerName = reader.string()

  if providerName == "" || moduleName == "" || reader.failed
    return null
  end
  let module = new IrModule(moduleName, "", domains)

  let features = reader.strings()
  let featureError = new ReferenceArtifact()

  for feature in features
    if !referenceKnownFeature(feature) || !referenceAddIrFeature(featureError, module.requiredFeatures, feature)
      return null
    end
  end
  module.requiredFeatures.requireRetainedModules()
  let classes = reader.count()
  var index = 0

  while index < classes && !reader.failed
    module.addClass(libraryDeclarationReadClass(reader, moduleName))
    index = index + 1
  end
  let records = reader.count()

  index = 0
  while index < records && !reader.failed
    let record = libraryDeclarationReadRecord(reader, moduleName)
    let last = module.lastRecord

    if last == null
      module.firstRecord = record
    else
      last.nextRecord = record
    end
    module.lastRecord = record
    module.recordCount = module.recordCount + 1
    index = index + 1
  end
  let functions = reader.count()

  index = 0
  while index < functions && !reader.failed
    module.addFunction(libraryDeclarationReadFunction(reader, moduleName))
    index = index + 1
  end
  let imports = reader.count()

  index = 0
  while index < imports && !reader.failed
    module.addImport(libraryDeclarationReadImport(reader, moduleName))
    index = index + 1
  end
  if !reader.complete() || !irVerify(module).succeeded()
    return null
  end
  return module
end
