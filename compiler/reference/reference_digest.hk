use files
use crypto

# Persistent reference identities describe bytes, not inode/mtime metadata.
# The bounded regular-file reader also reports short reads and close failures.
def referenceFileDigest(path: String): String
  let read = files::readBytes(path, 134217728)
  let bytes = read.bytes

  if read.failure != null || read.closeFailure != null || bytes == null
    return ""
  end
  let digest = crypto::sha256(bytes).bytes()

  if digest == null
    return ""
  end
  let hex = crypto::encodeHex(digest)

  return hex == null ? "" : hex
end
