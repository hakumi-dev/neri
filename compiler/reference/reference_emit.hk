use host
use files
use console

def referenceEmit(semantic: SemanticModel, module: IrModule, ownedIds: StringBuffer, sourceIds: StringBuffer, sourceStarts: IntBuffer, compilerIdentity: String, target: readonly TargetPlatform, output: String, release: Bool, sources: BootstrapSourceInput?): Bool
  let absolute = host::pathAbsolute(output)

  if absolute == null
    console::println("Invalid reference output path: " + output)
    return false
  end
  let artifact = referenceBuild(semantic, ownedIds, sourceIds, sourceStarts, module.id, compilerIdentity, target.name(), absolute + ".o", false)

  if artifact.error != ""
    console::println(artifact.error)
    return false
  end
  let implementationError = referenceImplementationError(module, semantic, ownedIds)

  if implementationError != ""
    console::println(implementationError)
    return false
  end
  let implementation = referenceImplementation(module, semantic, ownedIds)

  if implementation == null
    return false
  end
  let verified = irVerify(implementation)

  if !verified.succeeded()
    var index = 0

    while index < verified.errors.size
      console::println("Reference verification: " + verified.errors.get(index))
      index = index + 1
    end
    return false
  end
  let directory = bootstrapTemporaryDirectory(bootstrapDirectory(absolute), "reference")

  if directory == null
    console::println("Cannot create reference staging directory beside " + absolute)
    return false
  end
  let objectPath = directory + "/implementation.o"
  var succeeded = bootstrapInvokeCodegen(implementation, EmissionKind.object(), objectPath, target, release, sources)

  if succeeded
    let digest = referenceFileDigest(objectPath)

    artifact.objectDigest = digest
    artifact.runtimeMinor = bootstrapRequiredRuntimeMinor(implementation)
    artifact.runtimeFeatureBits = bootstrapRequiredRuntimeFeatures(implementation).bits()
    var imported = implementation.firstImport

    while imported != null
      artifact.runtimeSymbols.add(imported.linkName)
      imported = imported.nextImport
    end
    for feature in implementation.requiredFeatures.orderedNames()
      artifact.runtimeFeatureNames.add(feature)
    end
    succeeded = digest != "" && host::writeText(directory + "/contract.nref", artifact.render())
  end
  if succeeded
    # Publish metadata last. Readers never accept a mismatched object: its
    # fingerprint is checked before use. Interrupted replacement fails closed.
    succeeded = files::move(objectPath, artifact.objectPath).failure == null
    succeeded = files::move(directory + "/contract.nref", absolute).failure == null if succeeded
  end
  bootstrapRemoveRunDirectory(directory)
  console::println("Could not publish reference artifact: " + absolute) if !succeeded
  return succeeded
end
