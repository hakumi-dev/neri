use host

class ReferenceArtifact
  public schemaVersion: Int = 1
  public compilerIdentity: String = ""
  public target: String = ""
  public moduleName: String = ""
  public contractDigest: String = ""
  public objectPath: String = ""
  public objectDigest: String = ""
  public artifactDigest: String = ""
  public runtimeSymbols: StringBuffer = new StringBuffer()
  public runtimeMinor: Int = 1
  public runtimeFeatureBits: Int = 0
  public runtimeFeatureNames: StringBuffer = new StringBuffer()
  public firstFunction: ReferenceFunction?
  public lastFunction: ReferenceFunction?
  public error: String = ""

  def addFunction(function: SemanticCallable): Void
    let item = new ReferenceFunction(function)
    let last = this.lastFunction

    if last == null
      this.firstFunction = item
    else
      last.next = item
    end
    this.lastFunction = item
  end

  def contract(): String
    var result = "reference-contract-v1" + runCacheFrame(this.moduleName)

    var entry = this.firstFunction

    while entry != null
      let function = entry.callable

      result = result + runCacheFrame(function.fullName) + runCacheFrame(function.returnType)
      result = result + runCacheFrame(function.parameterCount as String)
      var parameter = function.firstParameter

      while parameter != null
        result = result + runCacheFrame(parameter.name) + runCacheFrame(parameter.typeName)
        parameter = parameter.nextParameter
      end
      entry = entry.next
    end
    return result
  end

  def finish(): Void
    this.contractDigest = sha256FastText(this.contract())
  end

  def render(): String
    var result = "{\"schemaVersion\":1,\"compilerIdentity\":" + lspQuote(this.compilerIdentity) + ",\"target\":" + lspQuote(this.target)

    result = result + ",\"module\":" + lspQuote(this.moduleName) + ",\"contractDigest\":" + lspQuote(this.contractDigest)
    result = result + ",\"objectPath\":" + lspQuote(this.objectPath) + ",\"objectDigest\":" + lspQuote(this.objectDigest)
    result = result + ",\"runtimeMinor\":" + (this.runtimeMinor as String) + ",\"runtimeFeatureBits\":" + (this.runtimeFeatureBits as String) + ",\"runtimeSymbols\":["
    var index = 0

    while index < this.runtimeSymbols.size
      result = result + (index == 0 ? "" : ",") + lspQuote(this.runtimeSymbols.get(index))
      index = index + 1
    end
    result = result + "],\"runtimeFeatureNames\":["
    index = 0
    while index < this.runtimeFeatureNames.size
      result = result + (index == 0 ? "" : ",") + lspQuote(this.runtimeFeatureNames.get(index))
      index = index + 1
    end
    result = result + "],\"functions\":["
    var separator = ""

    var entry = this.firstFunction

    while entry != null
      let function = entry.callable

      result = result + separator + "{\"name\":" + lspQuote(function.fullName) + ",\"return\":" + lspQuote(function.returnType) + ",\"parameters\":["
      var parameter = function.firstParameter
      var parameterSeparator = ""

      while parameter != null
        result = result + parameterSeparator + "{\"name\":" + lspQuote(parameter.name) + ",\"type\":" + lspQuote(parameter.typeName) + "}"
        parameterSeparator = ","
        parameter = parameter.nextParameter
      end
      result = result + "]}"
      separator = ","
      entry = entry.next
    end
    let payload = result + "]"

    this.artifactDigest = sha256FastText(payload)
    return payload + ",\"artifactDigest\":" + lspQuote(this.artifactDigest) + "}\n"
  end

  def hydrate(model: SemanticModel): Bool
    if this.error != ""
      return false
    end
    var entry = this.firstFunction
    let seen = new StringTable<Bool>()

    while entry != null
      let function = entry.callable

      if model.findFunction(function.fullName) != null || !seen.add(function.fullName, true)
        this.error = "Reference function conflicts with an existing declaration: " + function.fullName
        return false
      end
      entry = entry.next
    end
    entry = this.firstFunction
    while entry != null
      let function = entry.callable

      referenceAddNamespace(model, function.namespaceName)
      model.addFunction(function)
      entry = entry.next
    end
    return true
  end
end

def referenceAddNamespace(model: SemanticModel, name: String): Void
  if name == ""
    return
  end
  referenceAddNamespace(model, semanticNamespacePrefix(name))
  var index = 0

  while index < model.declaredNamespaces.size
    if model.declaredNamespaces.get(index) == name
      return
    end
    index = index + 1
  end
  model.declaredNamespaces.add(name)
end

def referenceScalar(typeName: String): Bool
  return typeName == "Void" || typeName == "Bool" || typeName == "Byte" || typeName == "Int" || typeName == "Float" || typeName == "String"
end

def referenceIdentifier(name: String, qualified: Bool): Bool
  let length = host::stringByteLength(name)

  if length == 0
    return false
  end
  var segmentStart = true
  var index = 0

  while index < length
    let byte = host::stringByteAt(name, index) as Int

    if byte == 46 && qualified && !segmentStart && index + 1 < length
      segmentStart = true
    else if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || (!segmentStart && byte >= 48 && byte <= 57)
      segmentStart = false
    else
      return false
    end
    index = index + 1
  end
  return !segmentStart
end

def referenceShortName(name: String): String
  var index = host::stringByteLength(name) - 1

  while index >= 0
    if host::stringByteAt(name, index) as Int == 46
      return host::stringSlice(name, index + 1, host::stringByteLength(name) - index - 1)
    end
    index = index - 1
  end
  return name
end

def referenceNamespace(name: String): String
  var index = host::stringByteLength(name) - 1

  while index >= 0
    if host::stringByteAt(name, index) as Int == 46
      return host::stringSlice(name, 0, index)
    end
    index = index - 1
  end
  return ""
end

def referenceLoad(path: String, compilerIdentity: String, target: String): ReferenceArtifact
  let result = new ReferenceArtifact()
  let text = host::readText(path)

  if text == null
    result.error = "Cannot read reference artifact: " + path
    return result
  end
  let parser = new LspJsonParser(text)
  let root = parser.parse()

  parser.spaces()

  if parser.failed || parser.position != host::stringByteLength(text) || !root.isObject() || !root.get("schemaVersion").isNumber() || root.get("schemaVersion").scalarText() != "1"
    result.error = "Reference artifact has an unsupported or corrupt schema: " + path
    return result
  end
  let compilerNode = root.get("compilerIdentity")
  let targetNode = root.get("target")
  let moduleNode = root.get("module")
  let contractNode = root.get("contractDigest")
  let objectNode = root.get("objectPath")
  let digestNode = root.get("objectDigest")
  let artifactDigestNode = root.get("artifactDigest")
  let runtimeMinorNode = root.get("runtimeMinor")
  let runtimeBitsNode = root.get("runtimeFeatureBits")
  let runtimeSymbolsNode = root.get("runtimeSymbols")
  let runtimeFeaturesNode = root.get("runtimeFeatureNames")
  let functionsNode = root.get("functions")

  if !compilerNode.isString() || !targetNode.isString() || !moduleNode.isString() || !contractNode.isString() || !objectNode.isString() || !digestNode.isString() || !artifactDigestNode.isString() || !runtimeMinorNode.isNumber() || !runtimeBitsNode.isNumber() || !runtimeSymbolsNode.isArray() || !runtimeFeaturesNode.isArray() || !functionsNode.isArray()
    result.error = "Reference artifact is missing required fields: " + path
    return result
  end
  result.compilerIdentity = compilerNode.scalarText()
  result.target = targetNode.scalarText()
  result.moduleName = moduleNode.scalarText()
  result.contractDigest = contractNode.scalarText()
  result.objectPath = objectNode.scalarText()
  result.objectDigest = digestNode.scalarText()
  let minor = host::parseInt(runtimeMinorNode.scalarText())

  if minor == null || minor < 1 || minor > 1000
    result.error = "Reference artifact has an invalid runtime requirement: " + path
    return result
  end
  result.runtimeMinor = minor
  let bits = host::parseInt(runtimeBitsNode.scalarText())

  if bits == null || bits < 0 || bits > 1073741823
    result.error = "Reference artifact has invalid runtime feature bits: " + path
    return result
  end
  result.runtimeFeatureBits = bits
  var symbolNode = runtimeSymbolsNode.first

  while symbolNode != null
    if !symbolNode.isString() || symbolNode.scalarText() == ""
      result.error = "Reference artifact has an invalid runtime symbol: " + path
      return result
    end
    result.runtimeSymbols.add(symbolNode.scalarText())
    symbolNode = symbolNode.next
  end
  var featureNode = runtimeFeaturesNode.first

  while featureNode != null
    let feature = featureNode.scalarText()

    if !featureNode.isString() || !referenceKnownFeature(feature)
      result.error = "Reference artifact has an unknown runtime feature: " + path
      return result
    end
    result.runtimeFeatureNames.add(feature)
    featureNode = featureNode.next
  end
  if result.moduleName == "" || result.objectPath == "" || result.contractDigest == "" || result.objectDigest == "" || result.compilerIdentity != compilerIdentity || result.target != target
    result.error = "Reference artifact compiler or target is incompatible: " + path
    return result
  end
  var item = functionsNode.first

  while item != null
    let nameNode = item.get("name")
    let returnNode = item.get("return")
    let parametersNode = item.get("parameters")

    if !item.isObject() || !nameNode.isString() || !returnNode.isString() || !parametersNode.isArray() || !referenceIdentifier(nameNode.scalarText(), true) || referenceShortName(nameNode.scalarText()) == "main" || !referenceScalar(returnNode.scalarText())
      result.error = "Reference artifact has an invalid function declaration: " + path
      return result
    end
    let fullName = nameNode.scalarText()
    let callable = new SemanticCallable(fullName, referenceShortName(fullName), referenceNamespace(fullName), "", returnNode.scalarText(), false, false, (new SourceAccessCatalog()).getInternal(), -1)
    var parameter = parametersNode.first
    let parameterNames = new StringTable<Bool>()

    while parameter != null
      let parameterName = parameter.get("name")
      let parameterType = parameter.get("type")

      if !parameter.isObject() || !parameterName.isString() || !parameterType.isString() || !referenceIdentifier(parameterName.scalarText(), false) || !parameterNames.add(parameterName.scalarText(), true) || !referenceScalar(parameterType.scalarText()) || parameterType.scalarText() == "Void"
        result.error = "Reference artifact has an invalid parameter declaration: " + path
        return result
      end
      callable.addParameter(new SemanticParameter(fullName + "/parameter[" + (callable.parameterCount as String) + "]", parameterName.scalarText(), parameterType.scalarText(), false, -1, (new ParameterModeCatalog()).getOrdinary()))
      parameter = parameter.next
    end
    result.addFunction(callable)
    item = item.next
  end
  if result.contractDigest != sha256FastText(result.contract())
    result.error = "Reference artifact contract digest does not match: " + path
    return result
  end
  result.render()
  if artifactDigestNode.scalarText() != result.artifactDigest
    result.error = "Reference artifact metadata digest does not match: " + path
    return result
  end
  let digest = referenceFileDigest(result.objectPath)

  if digest == "" || digest != result.objectDigest
    result.error = "Reference implementation object is missing or changed: " + result.objectPath
  end
  return result
end

def referenceKnownFeature(name: String): Bool
  return name == "c-interop-v1" || name == "debug-scopes-v1" || name == "extended-scalars-v1" || name == "native-libraries-v1" || name == "native-records-v1" || name == "native-strings-v1" || name == "retained-modules-v1" || name == "scoped-tasks-v1" || name == "sequential-arrays-v1" || name == "session-module-v1" || name == "string-data-v1"
end

def referenceOwned(position: Int, ownedIds: StringBuffer, sourceIds: StringBuffer, sourceStarts: IntBuffer): Bool
  var sourceId = ""
  var index = 0

  while index < sourceIds.size && position >= sourceStarts.get(index)
    sourceId = sourceIds.get(index)
    index = index + 1
  end
  index = 0
  while index < ownedIds.size
    if sourceId == ownedIds.get(index)
      return true
    end
    index = index + 1
  end
  return false
end

def referenceBuild(model: SemanticModel, ownedIds: StringBuffer, sourceIds: StringBuffer, sourceStarts: IntBuffer, moduleName: String, compilerIdentity: String, target: String, objectPath: String, verifyObject: Bool = true): ReferenceArtifact
  let result = new ReferenceArtifact()

  result.moduleName = moduleName
  result.compilerIdentity = compilerIdentity
  result.target = target
  result.objectPath = objectPath
  let syntax = model.syntax

  if syntax == null
    result.error = "Reference emission requires checked source declarations."
    return result
  end
  var classSymbol = model.firstClass

  while classSymbol != null
    if classSymbol.syntaxNode >= 0 && referenceOwned(syntax.irStartAt(classSymbol.syntaxNode), ownedIds, sourceIds, sourceStarts)
      result.error = "Reference v1 cannot export class '" + classSymbol.fullName + "'."
      return result
    end
    classSymbol = classSymbol.nextClass
  end
  var record = model.firstRecord

  while record != null
    if record.syntaxNode >= 0 && referenceOwned(syntax.irStartAt(record.syntaxNode), ownedIds, sourceIds, sourceStarts)
      result.error = "Reference v1 cannot export native record '" + record.name + "'."
      return result
    end
    record = record.nextRecord
  end
  var contract = model.firstContract

  while contract != null
    if referenceOwned(syntax.irStartAt(contract.syntaxNode), ownedIds, sourceIds, sourceStarts)
      result.error = "Reference v1 cannot export contract '" + contract.fullName + "'."
      return result
    end
    contract = contract.nextContract
  end
  var templateIndex = 0

  while templateIndex < model.genericTemplates.size
    let node = model.genericTemplates.get(templateIndex)

    if referenceOwned(syntax.irStartAt(node), ownedIds, sourceIds, sourceStarts)
      result.error = "Reference v1 cannot export generic declarations."
      return result
    end
    templateIndex = templateIndex + 1
  end
  var function = model.firstFunction

  while function != null
    if function.syntaxNode >= 0 && referenceOwned(syntax.irStartAt(function.syntaxNode), ownedIds, sourceIds, sourceStarts)
      if function.name == "main" || !referenceIdentifier(function.fullName, true) || function.isUnsafe || function.isStatic || function.cAbiSymbol != "" || function.cExportSymbol != "" || function.nativeLibrary != "" || function.intrinsicName != "" || function.operationAnnotation >= 0 || function.exactArguments || function.operatorName != "" || function.conversion || function.genericOrigin >= 0 || !referenceScalar(function.returnType)
        result.error = "Reference v1 cannot export function '" + function.fullName + "' with this signature or annotation."
        return result
      end
      var parameter = function.firstParameter

      while parameter != null
        if !referenceIdentifier(parameter.name, false) || !referenceScalar(parameter.typeName) || parameter.typeName == "Void" || parameter.hasDefault || !parameter.mode.isOrdinary()
          result.error = "Reference v1 cannot export function '" + function.fullName + "' with this parameter."
          return result
        end
        parameter = parameter.nextParameter
      end
      result.addFunction(function)
    end
    function = function.nextCallable
  end
  result.finish()
  if !verifyObject
    return result
  end
  let digest = referenceFileDigest(objectPath)

  if digest == ""
    result.error = "Reference implementation object is unavailable: " + objectPath
    return result
  end
  result.objectDigest = digest
  return result
end
