# Declaration images encode structural types using the IR type-kind wire tags.
# The depth bound is symmetric so every encoded type can be decoded safely.
def libraryDeclarationWriteType(writer: SemanticSnapshotWriter, type: readonly IrType, depth: Int = 0): Void
  if depth >= 128 || writer.failed
    writer.fail()
    return
  end
  let kind = type.kind()

  writer.integer(kind.wireCode())
  if kind.isClass() || kind.isNativeRecord()
    writer.string(type.nominalName())
  else if kind.isFixedArray()
    writer.integer(type.elementCount())
    libraryDeclarationWriteType(writer, type.element(), depth + 1)
  else if kind.isArray() || kind.isOptional() || kind.isPointer() || kind.isBorrowCapability()
    libraryDeclarationWriteType(writer, type.element(), depth + 1)
  else if kind.isCFunction()
    writer.integer(type.componentCount())
    var index = 0

    while index < type.componentCount()
      libraryDeclarationWriteType(writer, type.component(index), depth + 1)
      index = index + 1
    end
  end
end

def libraryDeclarationReadType(reader: SemanticSnapshotReader, types: IrTypePool, depth: Int = 0): readonly IrType
  if depth >= 128 || reader.failed
    reader.fail()
    return types.voidType()
  end
  let code = reader.integer()

  if code == 1
    return types.voidType()
  else if code == 2
    return types.boolType()
  else if code == 3
    return types.byteType()
  else if code == 4
    return types.intType()
  else if code == 5
    return types.floatType()
  else if code == 6
    return types.stringType()
  else if code == 7
    return types.int32Type()
  else if code == 8
    return types.uint32Type()
  else if code == 9
    return types.uint64Type()
  else if code == 10
    return types.float32Type()
  else if code == 32
    return types.unsafeType()
  else if code == 17 || code == 20
    let name = reader.string()

    if name == "" || reader.failed
      reader.fail()
      return types.voidType()
    end
    return code == 17 ? types.classType(name) : types.record(name)
  else if code == 16 || code == 18 || code == 19 || code == 33
    let element = libraryDeclarationReadType(reader, types, depth + 1)

    if code == 16
      return types.array(element)
    else if code == 18
      return types.optional(element)
    else if code == 19
      return types.pointer(element)
    end
    return types.borrowType(element)
  else if code == 21
    let count = reader.integer()
    let element = libraryDeclarationReadType(reader, types, depth + 1)

    if count <= 0 || count > 4294967295 || reader.failed
      reader.fail()
      return types.voidType()
    end
    return types.fixedArray(element, count)
  else if code == 22
    let count = reader.count()

    if count < 1 || reader.failed
      reader.fail()
      return types.voidType()
    end
    let result = libraryDeclarationReadType(reader, types, depth + 1)
    let parameters = new IrTypeBuffer()
    var index = 1

    while index < count && !reader.failed
      let parameter = libraryDeclarationReadType(reader, types, depth + 1)

      reader.fail() if irIsVoid(parameter)
      parameters.add(parameter)
      index = index + 1
    end
    if !reader.failed
      return types.cFunction(result, parameters.toArray())
    end
  end
  reader.fail()
  return types.voidType()
end

def libraryDeclarationWriteTypes(writer: SemanticSnapshotWriter, types: IrTypeBuffer): Void
  writer.integer(types.size)
  var index = 0

  while index < types.size
    libraryDeclarationWriteType(writer, types.get(index))
    index = index + 1
  end
end

def libraryDeclarationReadTypes(reader: SemanticSnapshotReader, types: IrTypePool): IrTypeBuffer
  let result = new IrTypeBuffer()
  let count = reader.count()
  var index = 0

  while index < count && !reader.failed
    let type = libraryDeclarationReadType(reader, types)

    reader.fail() if irIsVoid(type)
    result.add(type)
    index = index + 1
  end
  return result
end
