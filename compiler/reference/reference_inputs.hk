use host

class ReferenceInputs
  public error: String = ""
  public compilerIdentity: String = ""
  public target: String = ""
  public model: SemanticModel = new SemanticModel()
  public declarations: IrModule = new IrModule("main", "")
  public objects: StringBuffer = new StringBuffer()
  public runtimeMinor: Int = 1
  public runtimeFeatures: RuntimeFeatures = new RuntimeFeatures()
  public runtimeFeatureBits: Int = 0
  private objectDigests: StringBuffer = new StringBuffer()

  def prepare(paths: StringBuffer, target: String, moduleName: String): Bool
    this.target = target
    let executable = host::executablePath()
    let codegen = host::environment("NERI_CODEGEN")
    let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

    if executable == null || codegen == null || manifestPath == null
      this.error = "References require an identifiable compiler, code generator and runtime manifest."
      return false
    end
    let manifest = host::readText(manifestPath)

    if manifest == null
      this.error = "References require a readable runtime manifest."
      return false
    end
    if this.target == ""
      this.target = bootstrapManifestString(manifest, "target")
    end
    if TargetPlatform.parse(this.target) == null || this.target != bootstrapManifestString(manifest, "target")
      this.error = "Reference target must match the installed runtime target."
      return false
    end
    let runtimeName = bootstrapManifestString(manifest, "artifact")

    if !bootstrapArtifactNameValid(runtimeName)
      this.error = "References require a valid runtime artifact."
      return false
    end
    var identity = "neri-reference-toolchain-v1"

    for path in [executable, codegen, manifestPath, bootstrapDirectory(manifestPath) + "/" + runtimeName]
      let digest = referenceFileDigest(path)

      if digest == ""
        this.error = "Cannot fingerprint reference toolchain input: " + path
        return false
      end
      identity = identity + runCacheFrame(digest)
    end
    this.compilerIdentity = sha256FastText(identity)
    this.declarations = new IrModule(moduleName, "", this.model.irDomains)
    var path = paths.first.nextNode

    while path != null
      let artifact = referenceLoad(path.value, this.compilerIdentity, this.target)

      if artifact.error != "" || !artifact.hydrate(this.model)
        this.error = artifact.error
        return false
      end
      let declarations = referenceDeclarations(artifact, this.model.irDomains)
      var function = declarations.firstFunction

      while function != null
        let next = function.nextFunction

        function.symbol.moduleName = moduleName
        function.nextFunction = null
        this.declarations.addFunction(function)
        function = next
      end
      this.objects.add(artifact.objectPath)
      this.objectDigests.add(artifact.objectDigest)
      this.runtimeFeatures = this.runtimeFeatures.mergedWith(referenceRuntimeFeatures(artifact))
      this.runtimeFeatureBits = referenceMergeBits(this.runtimeFeatureBits, artifact.runtimeFeatureBits)
      this.runtimeMinor = artifact.runtimeMinor if artifact.runtimeMinor > this.runtimeMinor
      path = path.nextNode
    end
    if this.runtimeMinor > bootstrapManifestRequiredInt(manifest, "abiMinor") || !referenceBitsSatisfied(this.runtimeFeatureBits, bootstrapManifestRequiredInt(manifest, "features"))
      this.error = "The runtime does not satisfy the reference implementation requirements."
      return false
    end
    return true
  end

  def verifyObjects(): Bool
    var index = 0

    while index < this.objects.size
      let digest = referenceFileDigest(this.objects.get(index))

      if digest == "" || digest != this.objectDigests.get(index)
        this.error = "Reference implementation changed during compilation: " + this.objects.get(index)
        return false
      end
      index = index + 1
    end
    return true
  end

  def addObject(path: String, digest: String): Void
    this.objects.add(path)
    this.objectDigests.add(digest)
  end
end

def referenceHasBit(value: Int, bit: Int): Bool
  let quotient = value / bit

  return quotient - (quotient / 2) * 2 == 1
end

def referenceMergeBits(left: Int, right: Int): Int
  var result = left
  var bit = 1

  while bit <= 536870912
    result = result + bit if referenceHasBit(right, bit) && !referenceHasBit(left, bit)
    bit = bit * 2
  end
  return result
end

def referenceBitsSatisfied(required: Int, available: Int): Bool
  if required < 0 || available < 0
    return false
  end
  var bit = 1

  while bit <= 536870912
    if referenceHasBit(required, bit) && !referenceHasBit(available, bit)
      return false
    end
    bit = bit * 2
  end
  return true
end
