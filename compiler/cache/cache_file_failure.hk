enum CacheFileFailure
  case InvalidPath()
  case InvalidLimit()
  case OpenFailed()
  case SizeUnavailable()
  case MetadataFailed()
  case LimitExceeded()
  case ReadFailed()
  case ChangedSize()
  case ChangedFile()
  case DigestFailed()
  case CloseFailed()
end

def cacheFileFailureName(failure: CacheFileFailure): String
  match failure
    case CacheFileFailure.InvalidPath()
      return "invalid-path"
    case CacheFileFailure.InvalidLimit()
      return "invalid-limit"
    case CacheFileFailure.OpenFailed()
      return "open-failed"
    case CacheFileFailure.SizeUnavailable()
      return "size-unavailable"
    case CacheFileFailure.MetadataFailed()
      return "metadata-failed"
    case CacheFileFailure.LimitExceeded()
      return "limit-exceeded"
    case CacheFileFailure.ReadFailed()
      return "read-failed"
    case CacheFileFailure.ChangedSize()
      return "changed-size"
    case CacheFileFailure.ChangedFile()
      return "changed-file"
    case CacheFileFailure.DigestFailed()
      return "digest-failed"
    case CacheFileFailure.CloseFailed()
      return "close-failed"
  end
end
