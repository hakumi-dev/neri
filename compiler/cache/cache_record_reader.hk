use host

class CacheRecordReader
  public failed: Bool = false
  public position: Int = 0
  private payload: String
  private length: Int
  private pool: StringBuffer = new StringBuffer()

  def init(payload: String): Void
    this.payload = payload
    this.length = host::stringByteLength(payload)
    this.failed = this.length > cacheRecordMaxBytes()
  end

  def fail(): Void
    this.failed = true
  end

  def integer(): Int
    if this.failed
      return 0
    end
    let start = this.position

    while this.position < this.length && this.position - start <= 20
      let byte = host::stringByteAt(this.payload, this.position) as Int

      if byte == 10
        let value = host::parseInt(host::stringSlice(this.payload, start, this.position - start))

        this.position = this.position + 1
        if value != null
          return value
        end
        break
      end
      if (byte < 48 || byte > 57) && !(byte == 45 && this.position == start)
        break
      end
      this.position = this.position + 1
    end
    this.failed = true
    return 0
  end

  def count(limit: Int = cacheRecordMaxCount()): Int
    let value = this.integer()

    if value < 0 || value > limit || value > this.length - this.position
      this.failed = true
      return 0
    end
    return value
  end

  def index(limit: Int, allowMissing: Bool = false): Int
    let value = this.integer()

    if (value < 0 && !(allowMissing && value == -1)) || value >= limit
      this.failed = true
      return -1
    end
    return value
  end

  def boolean(): Bool
    let value = this.integer()

    this.failed = true if value != 0 && value != 1
    return value == 1
  end

  def string(): String
    let id = this.integer()

    if this.failed
      return ""
    end
    if id == -1
      let size = this.count(cacheRecordMaxBytes())

      if this.failed
        return ""
      end
      let value = host::stringSlice(this.payload, this.position, size)

      this.position = this.position + size
      this.pool.add(value)
      return value
    end
    if id < 0 || id >= this.pool.size
      this.failed = true
      return ""
    end
    return this.pool.get(id)
  end

  def integers(): Int[]
    let count = this.count()
    let reader = this

    let values = arrays::generate<Int>(count) do |index|
      return reader.integer()
    end

    return values
  end

  def strings(): String[]
    let count = this.count()
    let reader = this

    let values = arrays::generate<String>(count) do |index|
      return reader.string()
    end

    return values
  end

  def intBuffer(): IntBuffer
    let count = this.count()
    let values = new IntBuffer()
    var index = 0

    while index < count && !this.failed
      values.add(this.integer())
      index = index + 1
    end
    return values
  end

  def stringBuffer(): StringBuffer
    let count = this.count()
    let values = new StringBuffer()
    var index = 0

    while index < count && !this.failed
      values.add(this.string())
      index = index + 1
    end
    return values
  end

  def complete(): Bool
    return !this.failed && this.position == this.length
  end

end
