use host

@cabiImport("neri_rt_v1_cache_supported")
unsafe def runCacheSupported(): Int
end

@cabiImport("neri_rt_v1_cache_metadata")
unsafe def runCacheMetadata(path: Byte*, length: Int, follow: Int, kind: Int*, permissions: Int*, owned: Int*, fingerprint: Byte*): Int
end

@cabiImport("neri_rt_v1_stderr_write_bytes")
unsafe def runCacheWrite(bytes: Byte*, length: Int): Int
end

@cabiImport("neri_rt_v1_clock_milliseconds")
unsafe def runCacheClock(): Int
end

@cabiImport("malloc")
unsafe def shaAllocateBytes(size: Int): Byte*?
end

@cabiImport("free")
unsafe def shaFreeBytes(bytes: Byte*): Void
end

@cabiImport("neri_rt_v1_crypto_sha256")
unsafe def shaNativeDigest(bytes: Byte*, length: Int, digest: Byte*): Int
end

# Consumes the native allocation after hashing, including native digest failure.
unsafe def shaConsumeBytes(bytes: Byte*, length: Int): String?
  var digest: Byte[] = []
  var index = 0

  while index < 32
    digest = host.appendByte(digest, 0 as Byte)
    index = index + 1
  end
  var status = -1

  borrow digest as output
    status = shaNativeDigest(bytes, length, output)
  end
  shaFreeBytes(bytes)
  if status != 0
    return null
  end
  var result = ""

  index = 0
  while index < 32
    let value = digest[index] as Int

    result = result + irHexDigit(value / 16) + irHexDigit(value - (value / 16) * 16)
    index = index + 1
  end
  return result
end

@cabiImport("neri_rt_v1_host_canonical_path")
unsafe def neriHostCanonicalPath(path: Byte*, output: Byte*, capacity: Int): Int
end

@cabiImport("neri_rt_v1_file_read")
unsafe def lspRead(fd: Int, bytes: Byte*, length: Int): Int
end

@cabiImport("neri_rt_v1_file_wait_readable")
unsafe def lspWaitReadable(fd: Int, milliseconds: Int): Int
end
