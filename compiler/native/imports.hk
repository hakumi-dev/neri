use host

@cabi("stat")
unsafe def runCacheStat(path: Byte*, data: Byte*): Int
end

@cabi("uname")
unsafe def runCacheUname(data: Byte*): Int
end

@cabi("lstat")
unsafe def runCacheLstat(path: Byte*, data: Byte*): Int
end

@cabi("getuid")
unsafe def runCacheUid(): Int
end

@cabi("mkdir")
unsafe def runCacheMkdir(path: Byte*, mode: Int): Int
end

@cabi("rename")
unsafe def runCacheRename(from: Byte*, to: Byte*): Int
end

@cabi("write")
unsafe def runCacheWrite(fd: Int, bytes: Byte*, length: Int): Int
end

@cabi("neri_rt_v1_clock_milliseconds")
unsafe def runCacheClock(): Int
end

@cabi("malloc")
unsafe def shaAllocateBytes(size: Int): Byte*?
end

@cabi("free")
unsafe def shaFreeBytes(bytes: Byte*): Void
end

@cabi("neri_rt_v1_crypto_sha256")
unsafe def shaNativeDigest(bytes: Byte*, length: Int, digest: Byte*): Int
end

# Consumes the native allocation after hashing, including native digest failure.
unsafe def shaConsumeBytes(bytes: Byte*, length: Int): String?
  var digest: Byte[] = []
  var index = 0

  while index < 32
    digest = host.appendByte(digest, 0 as Byte)
    index = index + 1
  end
  var status = -1

  borrow digest as output
    status = shaNativeDigest(bytes, length, output)
  end
  shaFreeBytes(bytes)
  if status != 0
    return null
  end
  var result = ""

  index = 0
  while index < 32
    let value = digest[index] as Int

    result = result + irHexDigit(value / 16) + irHexDigit(value - (value / 16) * 16)
    index = index + 1
  end
  return result
end

@cabi("neri_rt_v1_host_canonical_path")
unsafe def neriHostCanonicalPath(path: Byte*, output: Byte*, capacity: Int): Int
end

@cabi("neri_rt_v1_file_read")
unsafe def lspRead(fd: Int, bytes: Byte*, length: Int): Int
end

@cabi("neri_rt_v1_file_wait_readable")
unsafe def lspWaitReadable(fd: Int, milliseconds: Int): Int
end
