use host

def irQuote(value: String): String
  let parts = new StringBuffer()

  parts.add("\"")
  var position = 0
  var start = 0

  while position < host::stringByteLength(value)
    let byte = host::stringByteAt(value, position) as Int

    if byte == 34 || byte == 92 || byte < 32
      parts.add(host::stringSlice(value, start, position - start))
      if byte == 34
        parts.add("\\\"")
      else if byte == 92
        parts.add("\\\\")
      else if byte == 10
        parts.add("\\n")
      else if byte == 13
        parts.add("\\r")
      else if byte == 9
        parts.add("\\t")
      else if byte == 8
        parts.add("\\b")
      else if byte == 12
        parts.add("\\f")
      else
        parts.add("\\u" + irHexUnsigned(byte, 4))
      end
      position = position + 1
      start = position
    else
      let width = utf8Width(byte)

      position = position + width
    end
  end
  parts.add(host::stringSlice(value, start, position - start))
  parts.add("\"")
  return parts.join()
end

def irSymbolKindName(kind: readonly IrSymbolKind): String
  return kind.displayName()
end

def irRenderSymbol(symbol: IrSymbol): String
  return "@[" + irQuote(symbol.moduleName) + ", " + irSymbolKindName(symbol.kind) + ", " + irQuote(symbol.name) + "]"
end

def irRenderSemanticType(moduleName: String, typeName: String): String
  let kind = irTypeKind(typeName)

  if kind == "cabi"
    return semanticCFunctionDisplay(typeName)
  end
  if kind == "record"
    return "record<" + "@[" + irQuote(moduleName) + ", native-record, " + irQuote(irTypeInner(typeName)) + "]" + ">"
  end
  if kind == "fixed-array"
    return "fixed-array<" + (irFixedArrayCount(typeName) as String) + ", " + irRenderSemanticType(moduleName, irFixedArrayInner(typeName)) + ">"
  end
  if kind == "class"
    return "class<" + "@[" + irQuote(moduleName) + ", class, " + irQuote(irTypeInner(typeName)) + "]" + ">"
  end
  if kind == "array"
    return "array<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">"
  end
  if kind == "optional"
    return "optional<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">"
  end
  if kind == "pointer"
    return "ptr<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">"
  end
  if kind == "borrow"
    return "!borrow<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">"
  end
  return typeName
end

def irRenderLocation(location: IrLocation): String
  if !location.present
    return ""
  end
  return " #source(" + irQuote(location.sourceId) + "):" + (location.start as String) + "+" + (location.length as String)
end

def irOpcodeName(opcode: readonly IrOpcode): String
  return opcode.displayName()
end

def irPredicateName(predicate: readonly IrComparison): String
  return predicate.displayName()
end

def irJoinValues(values: Int[]): String
  let parts = new StringBuffer()
  var index = 0

  while index < values.Length
    if index > 0
      parts.add(", ")
    end
    parts.add("%" + (values[index] as String))
    index = index + 1
  end
  return parts.join()
end

def irJoinTypes(moduleName: String, types: StringBuffer): String
  let parts = new StringBuffer()
  var index = 0

  while index < types.size
    if index > 0
      parts.add(", ")
    end
    parts.add(irRenderSemanticType(moduleName, types.get(index)))
    index = index + 1
  end
  return parts.join()
end

def irRenderConstant(moduleName: String, instruction: IrInstruction): String
  let kind = instruction.constantKind

  if kind == null
    return ""
  end
  if kind.isBool()
    return instruction.constantValue == "true" ? "bool.true" : "bool.false"
  end
  if kind.isByte()
    return "byte." + instruction.constantValue
  end
  if kind.isInt()
    return "int." + instruction.constantValue
  end
  if kind.isFloat()
    return "float." + instruction.constantValue
  end
  if kind.isStringGlobal()
    return "string.global " + "@[" + irQuote(moduleName) + ", global, " + irQuote(instruction.constantValue) + "]"
  end
  return "optional.none<" + irRenderSemanticType(moduleName, instruction.resultType) + ">"
end

def irRenderInstruction(moduleName: String, instruction: IrInstruction): String
  let parts = new StringBuffer()

  parts.add("  ")

  if instruction.secondResultId >= 0
    parts.add("(%" + (instruction.resultId as String) + ": " + irRenderSemanticType(moduleName, instruction.resultType) + ", %" + (instruction.secondResultId as String) + ": " + irRenderSemanticType(moduleName, instruction.secondResultType) + ") = ")
  else if instruction.resultId >= 0
    parts.add("%" + (instruction.resultId as String) + ": " + irRenderSemanticType(moduleName, instruction.resultType) + " = ")
  end
  parts.add(irOpcodeName(instruction.opcode))
  if instruction.typeArguments.Length > 0
    parts.add("<")
    var typeIndex = 0

    while typeIndex < instruction.typeArguments.Length
      if typeIndex > 0
        parts.add(", ")
      end
      parts.add(irRenderSemanticType(moduleName, instruction.typeArguments[typeIndex]))
      typeIndex = typeIndex + 1
    end
    parts.add(">")
  end
  let instructionSymbol = instruction.symbol

  if instructionSymbol != null
    let symbol = instructionSymbol

    parts.add(" " + irRenderSymbol(symbol))
  end
  if instruction.constantKind != null
    parts.add(" " + irRenderConstant(moduleName, instruction))
  end
  let predicate = instruction.predicate

  if predicate != null
    parts.add(" predicate=" + irPredicateName(predicate))
  end
  if instruction.flag
    parts.add(" flag=true")
  end
  if instruction.operands.Length > 0
    parts.add(" (" + irJoinValues(instruction.operands) + ")")
  end
  parts.add(" scope=" + (instruction.debugScopeId as String) + irRenderLocation(instruction.location) + "\n")
  return parts.join()
end

def irRenderEdge(target: Int, arguments: Int[]): String
  return "^" + (target as String) + "(" + irJoinValues(arguments) + ")"
end

def irRenderTerminator(terminator: IrTerminator): String
  if terminator.kind.isBranch()
    return "  br " + irRenderEdge(terminator.firstTarget, terminator.firstArguments) + " scope=" + (terminator.debugScopeId as String) + irRenderLocation(terminator.location) + "\n"
  end
  if terminator.kind.isConditionalBranch()
    return "  cond_br %" + (terminator.condition as String) + ", " + irRenderEdge(terminator.firstTarget, terminator.firstArguments) + ", " + irRenderEdge(terminator.secondTarget, terminator.secondArguments) + " scope=" + (terminator.debugScopeId as String) + irRenderLocation(terminator.location) + "\n"
  end
  if terminator.kind.isReturn()
    var value = ""

    if terminator.value >= 0
      value = " %" + (terminator.value as String)
    end
    return "  return" + value + " scope=" + (terminator.debugScopeId as String) + irRenderLocation(terminator.location) + "\n"
  end
  return "  panic " + irQuote(terminator.panicCode) + ", " + irQuote(terminator.panicMessage) + " scope=" + (terminator.debugScopeId as String) + irRenderLocation(terminator.location) + "\n"
end

def irFunctionKindName(kind: readonly IrFunctionKind): String
  return kind.displayName()
end

def irNextDebugLocal(function: IrFunction): IrDebugLocal?
  var best: IrDebugLocal? = null
  var current = function.firstDebugLocal

  while current != null
    if !current.emitted && (best == null || current.value < best.value || (current.value == best.value && (irCompareText(current.name, best.name) < 0 || (current.name == best.name && current.scopeId < best.scopeId))))
      best = current
    end
    current = current.nextLocal
  end
  return best
end

def irRenderFunction(moduleName: String, function: IrFunction): String
  let parts = new StringBuffer()

  parts.add("func " + irRenderSymbol(function.symbol) + " kind=" + irFunctionKindName(function.kind) + " (" + irJoinTypes(moduleName, function.parameterTypes) + ") -> " + irRenderSemanticType(moduleName, function.resultType) + " effects=" + function.effects.render() + " unsafe-call=" + (function.unsafeCall ? "true" : "false") + " entry=^" + (function.entryBlock as String))

  if function.unsafeRootId >= 0
    parts.add(" unsafe-root=%" + (function.unsafeRootId as String) + ": !unsafe")
  end
  if function.cExportSymbol != ""
    parts.add(" export=" + irQuote(function.cExportSymbol))
  end
  let optionalDeclaringClass = function.declaringClass

  if optionalDeclaringClass != null
    let declaringClass = optionalDeclaringClass

    parts.add(" class=" + irRenderSymbol(declaringClass))
  end
  let optionalFunctionSlot = function.dispatchSlot

  if optionalFunctionSlot != null
    let dispatchSlot = optionalFunctionSlot

    parts.add(" slot=" + irRenderSymbol(dispatchSlot))
  end
  parts.add(irRenderLocation(function.location) + " {\n")
  var scope = function.firstDebugScope

  while scope != null
    parts.add("  debug.scope " + (scope.id as String) + " parent=" + (scope.parentId as String) + irRenderLocation(scope.location) + "\n")
    scope = scope.nextScope
  end
  var local = irNextDebugLocal(function)

  while local != null
    local.emitted = true
    parts.add("  debug.local " + irQuote(local.name) + " = %" + (local.value as String) + " scope=" + (local.scopeId as String) + irRenderLocation(local.location) + "\n")
    local = irNextDebugLocal(function)
  end
  let blockOrder = irBlockOrder(function)
  var blockIndex = 0

  while blockIndex < blockOrder.size
    let block = blockOrder.get(blockIndex)

    if block == null
      blockIndex = blockIndex + 1
      continue
    end
    parts.add("^" + (block.id as String) + "(")
    var parameter = block.firstParameter
    var parameterIndex = 0

    while parameter != null
      if parameterIndex > 0
        parts.add(", ")
      end
      parts.add("%" + (parameter.id as String) + ": " + irRenderSemanticType(moduleName, parameter.typeName) + irRenderLocation(parameter.location))
      parameter = parameter.nextParameter
      parameterIndex = parameterIndex + 1
    end
    parts.add("):\n")
    var instruction = block.firstInstruction

    while instruction != null
      parts.add(irRenderInstruction(moduleName, instruction))
      instruction = instruction.nextInstruction
    end
    let optionalTerminator = block.terminator

    if optionalTerminator != null
      let terminator = optionalTerminator

      parts.add(irRenderTerminator(terminator))
    end
    blockIndex = blockIndex + 1
  end
  parts.add("}\n\n")
  return parts.join()
end

def irBlockOrder(function: IrFunction): IrBlockOrder
  return new IrBlockOrder(function)
end

def irOrderedClasses(module: IrModule): IrOrderNode<IrClass>?
  let ordered = new IrOrderList<IrClass>()
  var current = module.firstClass

  while current != null
    ordered.add(current, 0, current.symbol.name)
    current = current.nextClass
  end
  return ordered.sorted()
end

def irOrderedGlobals(module: IrModule): IrOrderNode<IrGlobal>?
  let ordered = new IrOrderList<IrGlobal>()
  var current = module.firstGlobal

  while current != null
    ordered.add(current, 0, current.symbol.name)
    current = current.nextGlobal
  end
  return ordered.sorted()
end

def irOrderedImports(module: IrModule): IrOrderNode<IrImport>?
  let ordered = new IrOrderList<IrImport>()
  var current = module.firstImport

  while current != null
    ordered.add(current, current.symbol.kind.wireCode(), current.symbol.name)
    current = current.nextImport
  end
  return ordered.sorted()
end

def irOrderedFunctions(module: IrModule): IrOrderNode<IrFunction>?
  let ordered = new IrOrderList<IrFunction>()
  var current = module.firstFunction

  while current != null
    ordered.add(current, current.symbol.kind.wireCode(), current.symbol.name)
    current = current.nextFunction
  end
  return ordered.sorted()
end

def irOrderedSources(module: IrModule): IrOrderNode<IrSource>?
  let ordered = new IrOrderList<IrSource>()
  var current = module.firstSource

  while current != null
    ordered.add(current, 0, current.id)
    current = current.nextSource
  end
  return ordered.sorted()
end

def irRenderModule(module: IrModule): String
  module.resetEmission()
  let parts = new StringBuffer()

  parts.add("neri-ir " + (irSemanticMajor() as String) + "." + (irSemanticMinor() as String) + "\nmodule " + irQuote(module.id) + "\nrequires [")
  var separator = ""

  for feature in module.requiredFeatures.orderedNames()
    parts.add(separator + irQuote(feature))
    separator = ", "
  end
  parts.add("]\n\n")
  var record = module.firstRecord

  while record != null
    parts.add((record.unionType ? "union " : "struct ") + irRenderSymbol(record.symbol) + " {\n")
    var nativeField = record.firstField

    while nativeField != null
      parts.add("  " + irRenderSymbol(nativeField.symbol) + ": " + irRenderSemanticType(module.id, nativeField.typeName) + "\n")
      nativeField = nativeField.nextField
    end
    parts.add("}\n\n")
    record = record.nextRecord
  end
  var sourceNode = irOrderedSources(module)

  while sourceNode != null
    let source = sourceNode.value

    parts.add("source " + irQuote(source.id) + " bytes=" + (host::stringByteLength(source.text) as String) + " sha256=" + sha256Text(source.text) + "\n")
    sourceNode = sourceNode.next
  end
  parts.add("\n")
  var classNode = irOrderedClasses(module)

  while classNode != null
    let classValue = classNode.value

    parts.add("class " + irRenderSymbol(classValue.symbol) + " access=" + (classValue.access.isPublic() ? "public" : classValue.access.isPrivate() ? "private" : classValue.access.isProtected() ? "protected" : "internal"))
    let optionalBase = classValue.baseSymbol

    if optionalBase != null
      let baseSymbol = optionalBase

      parts.add(" base=" + irRenderSymbol(baseSymbol))
    end
    parts.add(" {\n")
    var field = classValue.firstField

    while field != null
      parts.add("  field " + irRenderSymbol(field.symbol) + " : " + irRenderSemanticType(module.id, field.typeName) + " access=" + (field.access.isPublic() ? "public" : field.access.isPrivate() ? "private" : field.access.isProtected() ? "protected" : "internal") + "\n")
      field = field.nextField
    end
    var method = classValue.firstMethod

    while method != null
      parts.add("  method " + irRenderSymbol(method.functionSymbol) + " dispatch=" + (method.dispatch.isStatic() ? "static" : method.dispatch.isDirect() ? "direct" : "virtual"))
      let optionalMethodSlot = method.dispatchSlot

      if optionalMethodSlot != null
        let dispatchSlot = optionalMethodSlot

        parts.add(" slot=" + irRenderSymbol(dispatchSlot))
      end
      parts.add(irRenderLocation(method.location) + "\n")
      method = method.nextMethod
    end
    parts.add("}\n\n")
    classNode = classNode.next
  end
  var globalNode = irOrderedGlobals(module)

  while globalNode != null
    let global = globalNode.value

    parts.add("global " + irRenderSymbol(global.symbol) + " : string = string.utf8 " + irQuote(global.value) + " linkage=internal" + irRenderLocation(global.location) + "\n\n")
    globalNode = globalNode.next
  end
  var importNode = irOrderedImports(module)

  while importNode != null
    let importValue = importNode.value

    parts.add("import " + irRenderSymbol(importValue.symbol) + " : (" + irJoinTypes(module.id, importValue.parameterTypes) + ") -> " + irRenderSemanticType(module.id, importValue.resultType) + " kind=" + (importValue.kind.isRuntime() ? "runtime" : "cabi") + " link=" + irQuote(importValue.linkName) + " effects=" + importValue.effects.render())
    if importValue.nativeLibrary != ""
      parts.add(" library=" + irQuote(importValue.nativeLibrary))
    end
    if importValue.runtimeMajor >= 0
      parts.add(" runtime=" + (importValue.runtimeMajor as String) + "." + (importValue.runtimeMinor as String) + "+0x" + irHexUnsigned(importValue.runtimeFeatures.bits(), 16))
    end
    parts.add(irRenderLocation(importValue.location) + "\n\n")
    importNode = importNode.next
  end
  var functionNode = irOrderedFunctions(module)

  while functionNode != null
    let function = functionNode.value

    parts.add(irRenderFunction(module.id, function))
    functionNode = functionNode.next
  end
  let result = parts.join()

  if semanticEndsWith(result, "\n\n")
    return host::stringSlice(result, 0, host::stringByteLength(result) - 1)
  end
  return result
end
