use host

def irQuote(value: String): String
  var result = "\""
  var position = 0
  while position < host.stringByteLength(value)
    let byte = host.stringByteAt(value, position) as Int
    if byte == 34
      result = result + "\\\""
      position = position + 1
    else if byte == 92
      result = result + "\\\\"
      position = position + 1
    else if byte == 10
      result = result + "\\n"
      position = position + 1
    else if byte == 13
      result = result + "\\r"
      position = position + 1
    else if byte == 9
      result = result + "\\t"
      position = position + 1
    else if byte == 8
      result = result + "\\b"
      position = position + 1
    else if byte == 12
      result = result + "\\f"
      position = position + 1
    else if byte < 32
      result = result + "\\u" + irHexUnsigned(byte, 4)
      position = position + 1
    else
      let width = utf8Width(byte)
      result = result + host.stringSlice(value, position, width)
      position = position + width
    end
  end
  return result + "\""
end

def irSymbolKindName(kind: Int): String
  if kind == 1 return "class" end
  if kind == 2 return "field" end
  if kind == 3 return "method" end
  if kind == 4 return "function" end
  if kind == 5 return "parameter" end
  if kind == 6 return "local" end
  if kind == 7 return "library-function" end
  if kind == 8 return "intrinsic" end
  return "global"
end

def irRenderSymbol(symbol: IrSymbol): String
  return "@[" + irQuote(symbol.moduleName) + ", " + irSymbolKindName(symbol.kind) + ", " + irQuote(symbol.name) + "]"
end

def irRenderSemanticType(moduleName: String, typeName: String): String
  let kind = irTypeKind(typeName)
  if kind == "class"
    return "class<" + irRenderSymbol(irSymbol(moduleName, 1, irTypeInner(typeName))) + ">"
  end
  if kind == "array" return "array<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">" end
  if kind == "optional" return "optional<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">" end
  if kind == "pointer" return "ptr<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">" end
  if kind == "borrow" return "!borrow<" + irRenderSemanticType(moduleName, irTypeInner(typeName)) + ">" end
  return typeName
end

def irRenderLocation(location: IrLocation): String
  if !location.present return "" end
  return " #source(" + irQuote(location.sourceId) + "):" + (location.start as String) + "+" + (location.length as String)
end

def irOpcodeName(opcode: Int): String
  let names: String[] = ["", "constant", "int.neg.checked", "int.add.checked", "int.sub.checked", "int.mul.checked", "int.div.checked", "float.neg", "float.add", "float.sub", "float.mul", "float.div", "bool.not", "bool.and", "bool.or", "compare", "cast.int-to-float", "cast.float-to-int.checked", "cast.int-to-byte.checked", "cast.byte-to-int", "class.upcast", "optional.none", "optional.some", "optional.is-some", "optional.get.checked", "string.concat", "string.equal", "string.not-equal", "call", "call.direct", "call.virtual", "call.import", "call.unsafe", "call.cabi", "array.new", "array.length", "array.load.checked", "array.store.checked", "object.alloc", "field.load", "field.store", "unsafe.begin", "unsafe.end", "stack.alloc", "pointer.load", "pointer.store", "pointer.offset", "pointer.difference", "pointer.compare", "pointer.cast", "native.alloc", "native.realloc", "native.free", "borrow.begin", "borrow.end", "string.from-int", "string.from-byte", "string.from-float"]
  if opcode >= 1 && opcode < names.Length return names[opcode] end
  return "unknown"
end

def irPredicateName(predicate: Int): String
  if predicate == 1 return "eq" end
  if predicate == 2 return "ne" end
  if predicate == 3 return "lt" end
  if predicate == 4 return "le" end
  if predicate == 5 return "gt" end
  return "ge"
end

def irRenderEffects(effects: Int): String
  var result = "["
  let values: Int[] = [1, 2, 4, 8, 16, 32, 64, 128]
  let names: String[] = ["read", "write", "may-panic", "managed-alloc", "native-alloc", "safepoint", "unsafe", "noreturn"]
  var index = 0
  var count = 0
  while index < values.Length
    if irHasEffect(effects, values[index])
      if count > 0 result = result + ", " end
      result = result + names[index]
      count = count + 1
    end
    index = index + 1
  end
  return result + "]"
end

def irJoinValues(values: Int[]): String
  var result = ""
  var index = 0
  while index < values.Length
    if index > 0 result = result + ", " end
    result = result + "%" + (values[index] as String)
    index = index + 1
  end
  return result
end

def irJoinTypes(moduleName: String, types: StringBuffer): String
  var result = ""
  var index = 0
  while index < types.size
    if index > 0 result = result + ", " end
    result = result + irRenderSemanticType(moduleName, types.get(index))
    index = index + 1
  end
  return result
end

def irRenderConstant(moduleName: String, instruction: IrInstruction): String
  if instruction.constantKind == 1 return instruction.constantValue == "true" ? "bool.true" : "bool.false" end
  if instruction.constantKind == 2 return "byte." + instruction.constantValue end
  if instruction.constantKind == 3 return "int." + instruction.constantValue end
  if instruction.constantKind == 4 return "float." + instruction.constantValue end
  if instruction.constantKind == 7 return "string.global " + irRenderSymbol(irSymbol(moduleName, 9, instruction.constantValue)) end
  return "optional.none<" + irRenderSemanticType(moduleName, instruction.resultType) + ">"
end

def irRenderInstruction(moduleName: String, instruction: IrInstruction): String
  var result = "  "
  if instruction.secondResultId >= 0
    result = result + "(%" + (instruction.resultId as String) + ": " + irRenderSemanticType(moduleName, instruction.resultType) + ", %" + (instruction.secondResultId as String) + ": " + irRenderSemanticType(moduleName, instruction.secondResultType) + ") = "
  else if instruction.resultId >= 0
    result = result + "%" + (instruction.resultId as String) + ": " + irRenderSemanticType(moduleName, instruction.resultType) + " = "
  end
  result = result + irOpcodeName(instruction.opcode)
  if instruction.typeArguments.Length > 0
    result = result + "<"
    var typeIndex = 0
    while typeIndex < instruction.typeArguments.Length
      if typeIndex > 0 result = result + ", " end
      result = result + irRenderSemanticType(moduleName, instruction.typeArguments[typeIndex])
      typeIndex = typeIndex + 1
    end
    result = result + ">"
  end
  let instructionSymbol = instruction.symbol
  if instructionSymbol != null
    let symbol = instructionSymbol
    result = result + " " + irRenderSymbol(symbol)
  end
  if instruction.constantKind > 0 result = result + " " + irRenderConstant(moduleName, instruction) end
  if instruction.predicate > 0 result = result + " predicate=" + irPredicateName(instruction.predicate) end
  if instruction.flag result = result + " flag=true" end
  if instruction.operands.Length > 0 result = result + " (" + irJoinValues(instruction.operands) + ")" end
  return result + irRenderLocation(instruction.location) + "\n"
end

def irRenderEdge(target: Int, arguments: Int[]): String
  return "^" + (target as String) + "(" + irJoinValues(arguments) + ")"
end

def irRenderTerminator(terminator: IrTerminator): String
  if terminator.kind == 1 return "  br " + irRenderEdge(terminator.firstTarget, terminator.firstArguments) + irRenderLocation(terminator.location) + "\n" end
  if terminator.kind == 2 return "  cond_br %" + (terminator.condition as String) + ", " + irRenderEdge(terminator.firstTarget, terminator.firstArguments) + ", " + irRenderEdge(terminator.secondTarget, terminator.secondArguments) + irRenderLocation(terminator.location) + "\n" end
  if terminator.kind == 3
    var value = ""
    if terminator.value >= 0 value = " %" + (terminator.value as String) end
    return "  return" + value + irRenderLocation(terminator.location) + "\n"
  end
  return "  panic " + irQuote(terminator.panicCode) + ", " + irQuote(terminator.panicMessage) + irRenderLocation(terminator.location) + "\n"
end

def irFunctionKindName(kind: Int): String
  if kind == 1 return "function" end
  if kind == 2 return "static-method" end
  if kind == 3 return "instance-method" end
  if kind == 4 return "constructor" end
  return "default-adapter"
end

def irNextDebugLocal(function: IrFunction): IrDebugLocal?
  var best: IrDebugLocal? = null
  var current = function.firstDebugLocal
  while current != null
    if !current.emitted && (best == null || current.value < best.value || (current.value == best.value && irCompareText(current.name, best.name) < 0))
      best = current
    end
    current = current.nextLocal
  end
  return best
end

def irRenderFunction(moduleName: String, function: IrFunction): String
  var result = "func " + irRenderSymbol(function.symbol) + " kind=" + irFunctionKindName(function.kind) + " (" + irJoinTypes(moduleName, function.parameterTypes) + ") -> " + irRenderSemanticType(moduleName, function.resultType) + " effects=" + irRenderEffects(function.effects) + " unsafe-call=" + (function.unsafeCall ? "true" : "false") + " entry=^" + (function.entryBlock as String)
  if function.unsafeRootId >= 0 result = result + " unsafe-root=%" + (function.unsafeRootId as String) + ": !unsafe" end
  let optionalDeclaringClass = function.declaringClass
  if optionalDeclaringClass != null
    let declaringClass = optionalDeclaringClass
    result = result + " class=" + irRenderSymbol(declaringClass)
  end
  let optionalFunctionSlot = function.dispatchSlot
  if optionalFunctionSlot != null
    let dispatchSlot = optionalFunctionSlot
    result = result + " slot=" + irRenderSymbol(dispatchSlot)
  end
  result = result + irRenderLocation(function.location) + " {\n"
  var local = irNextDebugLocal(function)
  while local != null
    local.emitted = true
    result = result + "  debug.local " + irQuote(local.name) + " = %" + (local.value as String) + irRenderLocation(local.location) + "\n"
    local = irNextDebugLocal(function)
  end
  let blockOrder = irBlockOrder(function)
  var blockIndex = 0
  while blockIndex < blockOrder.size
    let block = irFindBlock(function, blockOrder.get(blockIndex))
    if block == null
      blockIndex = blockIndex + 1
      continue
    end
    result = result + "^" + (block.id as String) + "("
    var parameter = block.firstParameter
    var parameterIndex = 0
    while parameter != null
      if parameterIndex > 0 result = result + ", " end
      result = result + "%" + (parameter.id as String) + ": " + irRenderSemanticType(moduleName, parameter.typeName) + irRenderLocation(parameter.location)
      parameter = parameter.nextParameter
      parameterIndex = parameterIndex + 1
    end
    result = result + "):\n"
    var instruction = block.firstInstruction
    while instruction != null
      result = result + irRenderInstruction(moduleName, instruction)
      instruction = instruction.nextInstruction
    end
    let optionalTerminator = block.terminator
    if optionalTerminator != null
      let terminator = optionalTerminator
      result = result + irRenderTerminator(terminator)
    end
    blockIndex = blockIndex + 1
  end
  return result + "}\n\n"
end

def irFindBlock(function: IrFunction, id: Int): IrBlock?
  var block = function.firstBlock
  while block != null
    if block.id == id return block end
    block = block.nextBlock
  end
  return null
end

def irBufferContains(values: IntBuffer, value: Int): Bool
  var index = 0
  while index < values.size
    if values.get(index) == value return true end
    index = index + 1
  end
  return false
end

def irBlockOrder(function: IrFunction): IntBuffer
  let order = new IntBuffer()
  order.add(function.entryBlock)
  var index = 0
  while index < order.size
    let block = irFindBlock(function, order.get(index))
    if block != null
      let terminator = block.terminator
      if terminator != null
        if (terminator.kind == 1 || terminator.kind == 2) && !irBufferContains(order, terminator.firstTarget)
          order.add(terminator.firstTarget)
        end
        if terminator.kind == 2 && !irBufferContains(order, terminator.secondTarget)
          order.add(terminator.secondTarget)
        end
      end
    end
    index = index + 1
  end
  return order
end

def irNextClass(module: IrModule): IrClass?
  var best: IrClass? = null
  var current = module.firstClass
  while current != null
    if !current.emitted && (best == null || irCompareText(current.symbol.name, best.symbol.name) < 0) best = current end
    current = current.nextClass
  end
  return best
end

def irNextGlobal(module: IrModule): IrGlobal?
  var best: IrGlobal? = null
  var current = module.firstGlobal
  while current != null
    if !current.emitted && (best == null || irCompareText(current.symbol.name, best.symbol.name) < 0) best = current end
    current = current.nextGlobal
  end
  return best
end

def irNextImport(module: IrModule): IrImport?
  var best: IrImport? = null
  var current = module.firstImport
  while current != null
    if !current.emitted && (best == null || current.symbol.kind < best.symbol.kind || (current.symbol.kind == best.symbol.kind && irCompareText(current.symbol.name, best.symbol.name) < 0)) best = current end
    current = current.nextImport
  end
  return best
end

def irNextFunction(module: IrModule): IrFunction?
  var best: IrFunction? = null
  var current = module.firstFunction
  while current != null
    if !current.emitted && (best == null || current.symbol.kind < best.symbol.kind || (current.symbol.kind == best.symbol.kind && irCompareText(current.symbol.name, best.symbol.name) < 0)) best = current end
    current = current.nextFunction
  end
  return best
end

def irNextSource(module: IrModule): IrSource?
  var best: IrSource? = null
  var current = module.firstSource
  while current != null
    if !current.emitted && (best == null || irCompareText(current.id, best.id) < 0) best = current end
    current = current.nextSource
  end
  return best
end

def irRenderModule(module: IrModule): String
  module.resetEmission()
  var result = "neri-ir 1.0\nmodule " + irQuote(module.id) + "\nrequires ["
  var featureIndex = 0
  var previousFeature = ""
  while featureIndex < module.requiredFeatures.size
    let optionalFeature = module.nextFeature(previousFeature, featureIndex == 0)
    if optionalFeature != null
      let feature = optionalFeature
      if featureIndex > 0 result = result + ", " end
      result = result + irQuote(feature)
      previousFeature = feature
    end
    featureIndex = featureIndex + 1
  end
  result = result + "]\n\n"
  var source = irNextSource(module)
  while source != null
    source.emitted = true
    result = result + "source " + irQuote(source.id) + " bytes=" + (host.stringByteLength(source.text) as String) + " sha256=" + sha256Text(source.text) + "\n"
    source = irNextSource(module)
  end
  result = result + "\n"
  var classValue = irNextClass(module)
  while classValue != null
    classValue.emitted = true
    result = result + "class " + irRenderSymbol(classValue.symbol) + " access=" + (classValue.access == 1 ? "public" : classValue.access == 2 ? "private" : classValue.access == 3 ? "protected" : "internal")
    let optionalBase = classValue.baseSymbol
    if optionalBase != null
      let baseSymbol = optionalBase
      result = result + " base=" + irRenderSymbol(baseSymbol)
    end
    result = result + " {\n"
    var field = classValue.firstField
    while field != null
      result = result + "  field " + irRenderSymbol(field.symbol) + " : " + irRenderSemanticType(module.id, field.typeName) + " access=" + (field.access == 1 ? "public" : field.access == 2 ? "private" : field.access == 3 ? "protected" : "internal") + "\n"
      field = field.nextField
    end
    var method = classValue.firstMethod
    while method != null
      result = result + "  method " + irRenderSymbol(method.functionSymbol) + " dispatch=" + (method.dispatch == 1 ? "static" : method.dispatch == 2 ? "direct" : "virtual")
      let optionalMethodSlot = method.dispatchSlot
      if optionalMethodSlot != null
        let dispatchSlot = optionalMethodSlot
        result = result + " slot=" + irRenderSymbol(dispatchSlot)
      end
      result = result + irRenderLocation(method.location) + "\n"
      method = method.nextMethod
    end
    result = result + "}\n\n"
    classValue = irNextClass(module)
  end
  var global = irNextGlobal(module)
  while global != null
    global.emitted = true
    result = result + "global " + irRenderSymbol(global.symbol) + " : string = string.utf8 " + irQuote(global.value) + " linkage=internal" + irRenderLocation(global.location) + "\n\n"
    global = irNextGlobal(module)
  end
  var importValue = irNextImport(module)
  while importValue != null
    importValue.emitted = true
    result = result + "import " + irRenderSymbol(importValue.symbol) + " : (" + irJoinTypes(module.id, importValue.parameterTypes) + ") -> " + irRenderSemanticType(module.id, importValue.resultType) + " kind=" + (importValue.kind == 1 ? "runtime" : "cabi") + " link=" + irQuote(importValue.linkName) + " effects=" + irRenderEffects(importValue.effects)
    if importValue.runtimeMajor >= 0 result = result + " runtime=" + (importValue.runtimeMajor as String) + "." + (importValue.runtimeMinor as String) + "+0x" + irHexUnsigned(importValue.runtimeFeatures, 16) end
    result = result + irRenderLocation(importValue.location) + "\n\n"
    importValue = irNextImport(module)
  end
  var function = irNextFunction(module)
  while function != null
    function.emitted = true
    result = result + irRenderFunction(module.id, function)
    function = irNextFunction(module)
  end
  if semanticEndsWith(result, "\n\n")
    return host.stringSlice(result, 0, host.stringByteLength(result) - 1)
  end
  return result
end
