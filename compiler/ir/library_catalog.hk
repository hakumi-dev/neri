# Installed artifact inventories are available with and without documentation.
# Reading names from that inventory does not parse or import library sources.
def bootstrapInstalledLibraryNames(): StringBuffer
  let names = new StringBuffer()
  let directory = host.environment("NERI_STDLIB")

  if directory == null || directory == ""
    return names
  end
  let manifest = host.readText(bootstrapDirectory(directory) + "/ARTIFACTS.sha256")

  if manifest == null
    return names
  end
  var start = 0
  let length = host.stringByteLength(manifest)

  while start < length
    var finish = start

    while finish < length && host.stringByteAt(manifest, finish) != (10 as Byte)
      finish = finish + 1
    end
    if finish - start > 76
      let path = host.stringSlice(manifest, start + 66, finish - start - 66)

      if bootstrapStartsWith(path, "stdlib/") && semanticEndsWith(path, ".hk")
        let name = host.stringSlice(path, 7, host.stringByteLength(path) - 10)

        if name != "" && bootstrapFindText(name, "/") < 0 && bootstrapFindText(name, "\\") < 0 && !neriProjectListed(names, name)
          names.add(name)
        end
      end
    end
    start = finish + 1
  end
  return names
end
