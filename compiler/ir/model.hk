class IrLocation
  public sourceId: String = "main"
  public present: Bool = false
  public start: Int = 0
  public length: Int = 0

  def init(present: Bool, start: Int, length: Int): Void
    this.present = present
    this.start = start
    this.length = length
  end
end

class IrSource
  public id: String = "main"
  public text: String = ""
  public globalStart: Int = 0
  public utf16Length: Int = 0
  public map: IrSourceMap = new IrSourceMap("")
  public nextSource: IrSource?
  public emitted: Bool = false

  def init(id: String, text: String, globalStart: Int): Void
    this.id = id
    this.text = text
    this.globalStart = globalStart
    this.map = new IrSourceMap(text)
    this.utf16Length = this.map.utf16Length()
  end
end

class IrSymbol
  public moduleName: String = "main"
  public kind: Int = 4
  public name: String = ""

  def init(moduleName: String, kind: Int, name: String): Void
    this.moduleName = moduleName
    this.kind = kind
    this.name = name
  end
end

class IrParameter
  public id: Int = 0
  public typeName: String = "int"
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextParameter: IrParameter?

  def init(id: Int, typeName: String, location: IrLocation): Void
    this.id = id
    this.typeName = typeName
    this.location = location
  end
end

class IrInstruction
  public opcode: Int = 0
  public resultId: Int = -1
  public resultType: String = "void"
  public secondResultId: Int = -1
  public secondResultType: String = "void"
  public operands: Int[] = [0]
  public typeArguments: String[] = [""]
  public symbol: IrSymbol?
  public constantKind: Int = 0
  public constantValue: String = ""
  public predicate: Int = 0
  public flag: Bool = false
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextInstruction: IrInstruction?

  def init(opcode: Int, resultId: Int, resultType: String, operands: Int[], typeArguments: String[], symbol: IrSymbol?, constantKind: Int, constantValue: String, predicate: Int, flag: Bool, location: IrLocation): Void
    this.opcode = opcode
    this.resultId = resultId
    this.resultType = resultType
    this.operands = operands
    this.typeArguments = typeArguments
    this.symbol = symbol
    this.constantKind = constantKind
    this.constantValue = constantValue
    this.predicate = predicate
    this.flag = flag
    this.location = location
  end
end

class IrTerminator
  public kind: Int = 0
  public condition: Int = -1
  public firstTarget: Int = -1
  public firstArguments: Int[] = [0]
  public secondTarget: Int = -1
  public secondArguments: Int[] = [0]
  public value: Int = -1
  public panicCode: String = ""
  public panicMessage: String = ""
  public location: IrLocation = new IrLocation(false, 0, 0)

  def init(kind: Int, location: IrLocation): Void
    let values: Int[] = []
    this.kind = kind
    this.firstArguments = values
    let otherValues: Int[] = []
    this.secondArguments = otherValues
    this.location = location
  end
end

class IrBlock
  public id: Int = 0
  public firstParameter: IrParameter?
  public lastParameter: IrParameter?
  public parameterCount: Int = 0
  public firstInstruction: IrInstruction?
  public lastInstruction: IrInstruction?
  public instructionCount: Int = 0
  public terminator: IrTerminator?
  public nextBlock: IrBlock?

  def init(id: Int): Void
    this.id = id
  end

  def addParameter(parameter: IrParameter): Void
    if this.firstParameter == null
      this.firstParameter = parameter
    else
      let last = this.lastParameter
      if last != null
        last.nextParameter = parameter
      end
    end
    this.lastParameter = parameter
    this.parameterCount = this.parameterCount + 1
  end

  def addInstruction(instruction: IrInstruction): Void
    if this.firstInstruction == null
      this.firstInstruction = instruction
    else
      let last = this.lastInstruction
      if last != null
        last.nextInstruction = instruction
      end
    end
    this.lastInstruction = instruction
    this.instructionCount = this.instructionCount + 1
  end
end

class IrDebugLocal
  public name: String = ""
  public value: Int = 0
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextLocal: IrDebugLocal?
  public emitted: Bool = false

  def init(name: String, value: Int, location: IrLocation): Void
    this.name = name
    this.value = value
    this.location = location
  end
end

class IrFunction
  public symbol: IrSymbol = new IrSymbol("main", 4, "main")
  public parameterTypes: StringBuffer = new StringBuffer()
  public resultType: String = "void"
  public kind: Int = 1
  public effects: Int = 0
  public localEffects: Int = 0
  public unsafeCall: Bool = false
  public entryBlock: Int = 0
  public unsafeRootId: Int = -1
  public declaringClass: IrSymbol?
  public dispatchSlot: IrSymbol?
  public location: IrLocation = new IrLocation(false, 0, 0)
  public firstBlock: IrBlock?
  public lastBlock: IrBlock?
  public blockCount: Int = 0
  public firstDebugLocal: IrDebugLocal?
  public lastDebugLocal: IrDebugLocal?
  public debugLocalCount: Int = 0
  public nextBlockId: Int = 0
  public nextValueId: Int = 0
  public nextFunction: IrFunction?
  public callees: StringBuffer = new StringBuffer()
  public emitted: Bool = false

  def init(symbol: IrSymbol, resultType: String, kind: Int, unsafeCall: Bool, location: IrLocation): Void
    this.symbol = symbol
    this.resultType = resultType
    this.kind = kind
    this.unsafeCall = unsafeCall
    this.location = location
  end

  def createBlock(): IrBlock
    let block = new IrBlock(this.nextBlockId)
    this.nextBlockId = this.nextBlockId + 1
    if this.firstBlock == null
      this.firstBlock = block
    else
      let last = this.lastBlock
      if last != null
        last.nextBlock = block
      end
    end
    this.lastBlock = block
    this.blockCount = this.blockCount + 1
    return block
  end

  def allocateValue(): Int
    let result = this.nextValueId
    this.nextValueId = this.nextValueId + 1
    return result
  end

  def addDebugLocal(local: IrDebugLocal): Void
    if this.firstDebugLocal == null
      this.firstDebugLocal = local
    else
      let last = this.lastDebugLocal
      if last != null
        last.nextLocal = local
      end
    end
    this.lastDebugLocal = local
    this.debugLocalCount = this.debugLocalCount + 1
  end
end

class IrField
  public symbol: IrSymbol = new IrSymbol("main", 2, "field")
  public typeName: String = "int"
  public access: Int = 1
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextField: IrField?

  def init(symbol: IrSymbol, typeName: String, access: Int, location: IrLocation): Void
    this.symbol = symbol
    this.typeName = typeName
    this.access = access
    this.location = location
  end
end

class IrMethod
  public functionSymbol: IrSymbol = new IrSymbol("main", 3, "method")
  public dispatch: Int = 2
  public dispatchSlot: IrSymbol?
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextMethod: IrMethod?

  def init(functionSymbol: IrSymbol, dispatch: Int, dispatchSlot: IrSymbol?, location: IrLocation): Void
    this.functionSymbol = functionSymbol
    this.dispatch = dispatch
    this.dispatchSlot = dispatchSlot
    this.location = location
  end
end

class IrClass
  public symbol: IrSymbol = new IrSymbol("main", 1, "class")
  public baseSymbol: IrSymbol?
  public access: Int = 4
  public location: IrLocation = new IrLocation(false, 0, 0)
  public firstField: IrField?
  public lastField: IrField?
  public fieldCount: Int = 0
  public firstMethod: IrMethod?
  public lastMethod: IrMethod?
  public methodCount: Int = 0
  public nextClass: IrClass?
  public emitted: Bool = false

  def init(symbol: IrSymbol, baseSymbol: IrSymbol?, access: Int, location: IrLocation): Void
    this.symbol = symbol
    this.baseSymbol = baseSymbol
    this.access = access
    this.location = location
  end

  def addField(field: IrField): Void
    if this.firstField == null
      this.firstField = field
    else
      let last = this.lastField
      if last != null
        last.nextField = field
      end
    end
    this.lastField = field
    this.fieldCount = this.fieldCount + 1
  end

  def addMethod(method: IrMethod): Void
    if this.firstMethod == null
      this.firstMethod = method
    else
      let last = this.lastMethod
      if last != null
        last.nextMethod = method
      end
    end
    this.lastMethod = method
    this.methodCount = this.methodCount + 1
  end
end

class IrGlobal
  public symbol: IrSymbol = new IrSymbol("main", 9, "global")
  public value: String = ""
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextGlobal: IrGlobal?
  public emitted: Bool = false

  def init(symbol: IrSymbol, value: String, location: IrLocation): Void
    this.symbol = symbol
    this.value = value
    this.location = location
  end
end

class IrImport
  public symbol: IrSymbol = new IrSymbol("main", 7, "import")
  public parameterTypes: StringBuffer = new StringBuffer()
  public resultType: String = "void"
  public kind: Int = 1
  public linkName: String = ""
  public effects: Int = 0
  public runtimeMajor: Int = -1
  public runtimeMinor: Int = 0
  public runtimeFeatures: Int = 0
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextImport: IrImport?
  public emitted: Bool = false

  def init(symbol: IrSymbol, resultType: String, kind: Int, linkName: String, effects: Int, location: IrLocation): Void
    this.symbol = symbol
    this.resultType = resultType
    this.kind = kind
    this.linkName = linkName
    this.effects = effects
    this.location = location
  end
end

class IrModule
  public id: String = "main"
  public firstSource: IrSource?
  public lastSource: IrSource?
  public sourceCount: Int = 0
  public requiredFeatures: StringBuffer = new StringBuffer()
  public firstClass: IrClass?
  public lastClass: IrClass?
  public classCount: Int = 0
  public firstGlobal: IrGlobal?
  public lastGlobal: IrGlobal?
  public globalCount: Int = 0
  public firstImport: IrImport?
  public lastImport: IrImport?
  public importCount: Int = 0
  public firstFunction: IrFunction?
  public lastFunction: IrFunction?
  public functionCount: Int = 0

  def init(id: String, source: String): Void
    this.id = id
    this.addSource(new IrSource("main", source, 0))
  end

  def clearSources(): Void
    this.firstSource = null
    this.lastSource = null
    this.sourceCount = 0
  end

  def addSource(source: IrSource): Void
    if this.firstSource == null
      this.firstSource = source
    else
      let last = this.lastSource
      if last != null
        last.nextSource = source
      end
    end
    this.lastSource = source
    this.sourceCount = this.sourceCount + 1
  end

  def location(globalStart: Int, length: Int): IrLocation
    var source = this.firstSource
    while source != null
      if globalStart >= source.globalStart && globalStart <= source.globalStart + source.utf16Length
        let location = source.map.location(globalStart - source.globalStart, length)
        location.sourceId = source.id
        return location
      end
      source = source.nextSource
    end
    return new IrLocation(false, 0, 0)
  end

  def requireFeature(feature: String): Void
    var index = 0
    while index < this.requiredFeatures.size
      if this.requiredFeatures.get(index) == feature
        return
      end
      index = index + 1
    end
    this.requiredFeatures.add(feature)
  end

  def hasFeature(feature: String): Bool
    var index = 0
    while index < this.requiredFeatures.size
      if this.requiredFeatures.get(index) == feature
        return true
      end
      index = index + 1
    end
    return false
  end

  def nextFeature(previous: String, first: Bool): String?
    var best: String? = null
    var index = 0
    while index < this.requiredFeatures.size
      let feature = this.requiredFeatures.get(index)
      if (first || irCompareText(feature, previous) > 0) && (best == null || irCompareText(feature, best) < 0)
        best = feature
      end
      index = index + 1
    end
    return best
  end

  def resetEmission(): Void
    var source = this.firstSource
    while source != null
      source.emitted = false
      source = source.nextSource
    end
    var classValue = this.firstClass
    while classValue != null
      classValue.emitted = false
      classValue = classValue.nextClass
    end
    var global = this.firstGlobal
    while global != null
      global.emitted = false
      global = global.nextGlobal
    end
    var importValue = this.firstImport
    while importValue != null
      importValue.emitted = false
      importValue = importValue.nextImport
    end
    var function = this.firstFunction
    while function != null
      function.emitted = false
      var local = function.firstDebugLocal
      while local != null
        local.emitted = false
        local = local.nextLocal
      end
      function = function.nextFunction
    end
  end

  def addClass(value: IrClass): Void
    if this.firstClass == null
      this.firstClass = value
    else
      let last = this.lastClass
      if last != null
        last.nextClass = value
      end
    end
    this.lastClass = value
    this.classCount = this.classCount + 1
  end

  def addGlobal(value: IrGlobal): Void
    if this.firstGlobal == null
      this.firstGlobal = value
    else
      let last = this.lastGlobal
      if last != null
        last.nextGlobal = value
      end
    end
    this.lastGlobal = value
    this.globalCount = this.globalCount + 1
  end

  def addImport(value: IrImport): Void
    if this.firstImport == null
      this.firstImport = value
    else
      let last = this.lastImport
      if last != null
        last.nextImport = value
      end
    end
    this.lastImport = value
    this.importCount = this.importCount + 1
  end

  def addFunction(value: IrFunction): Void
    if this.firstFunction == null
      this.firstFunction = value
    else
      let last = this.lastFunction
      if last != null
        last.nextFunction = value
      end
    end
    this.lastFunction = value
    this.functionCount = this.functionCount + 1
  end
end
