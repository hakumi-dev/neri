use console
use host

def bootstrapBatchMain(): Void
  var project = ""
  var directory = ""
  var units: String[] = []
  var options: String[] = []
  let selected = new StringTable<Bool>()
  var index = 1

  while index < host.argumentCount()
    let supplied = host.argumentAt(index)

    if supplied == null
      host.exit(2)
      return
    end
    let argument = supplied

    if argument == "--timings" || argument == "--release" || argument == "--no-cache"
      options = host.appendString(options, argument)
      index = index + 1
    else if (argument == "--project" || argument == "--output-dir" || argument == "--unit" || argument == "--target") && index + 1 < host.argumentCount()
      let value = host.argumentAt(index + 1)

      if value == null
        host.exit(2)
        return
      end
      if argument == "--project"
        project = value
      else if argument == "--output-dir"
        directory = value
      else if argument == "--unit"
        let name = host.pathFileName(value)

        if value == "" || value == "." || value == ".." || name == null || name != value || !neriProjectUnitsFieldValid(value) || !selected.add(value, true)
          console.println("build-batch requires unique unit names usable as output file names.")
          host.exit(2)
          return
        end
        units = host.appendString(units, value)
      else
        options = host.appendString(options, "--target")
        options = host.appendString(options, value)
      end
      index = index + 2
    else
      bootstrapUsage()
      host.exit(2)
      return
    end
  end
  if project == "" || directory == "" || units.Length == 0
    bootstrapUsage()
    host.exit(2)
    return
  end
  # Validate every requested unit before producing artifacts.
  for unit in units
    let loaded = neriLoadProject(project, unit)

    if loaded.error() != "" || !projectUnitIsExecutable(loaded.kind)
      console.println(loaded.error() != "" ? loaded.error() : "build-batch requires executable units: " + unit)
      host.exit(2)
      return
    end
  end
  let batch = new BatchCompilation()

  for unit in units
    var arguments = ["build", "--project", project, "--unit", unit, "--output", directory + "/" + unit]

    for option in options
      arguments = host.appendString(arguments, option)
    end
    bootstrapCompile(arguments, batch)
  end
  console.println("neri batch dependencies analyzed=" + (batch.analyzed as String) + " reused=" + (batch.reused as String) + " fallback=" + (batch.fallback as String))
end
