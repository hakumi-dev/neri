class IrDebugScope
  public id: Int = 0
  public parentId: Int = 0
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextScope: IrDebugScope?
  public emitted: Bool = false

  def init(id: Int, parentId: Int, location: IrLocation): Void
    this.id = id
    this.parentId = parentId
    this.location = location
  end
end
