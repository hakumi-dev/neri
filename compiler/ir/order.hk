
def irOrderBeforeOrEqual<T>(left: IrOrderNode<T>, right: IrOrderNode<T>): Bool
  if left.primary != right.primary
    return left.primary < right.primary
  end
  let names = irCompareText(left.name, right.name)

  if names != 0
    return names < 0
  end
  return left.ordinal <= right.ordinal
end

def irOrderSplit<T>(head: IrOrderNode<T>): IrOrderNode<T>?
  var slow = head
  var fast = head.next

  while fast != null
    fast = fast.next
    if fast != null
      let nextSlow = slow.next

      if nextSlow != null
        slow = nextSlow
      end
      fast = fast.next
    end
  end
  let right = slow.next

  slow.next = null
  return right
end

def irOrderMerge<T>(optionalLeft: IrOrderNode<T>?, optionalRight: IrOrderNode<T>?): IrOrderNode<T>?
  if optionalLeft == null
    return optionalRight
  end
  if optionalRight == null
    return optionalLeft
  end
  var left: IrOrderNode<T>? = optionalLeft
  var right: IrOrderNode<T>? = optionalRight
  var head = optionalLeft

  if irOrderBeforeOrEqual(optionalLeft, optionalRight)
    left = optionalLeft.next
  else
    head = optionalRight
    right = optionalRight.next
  end
  var tail = head

  while left != null && right != null
    if irOrderBeforeOrEqual(left, right)
      tail.next = left
      tail = left
      left = left.next
    else
      tail.next = right
      tail = right
      right = right.next
    end
  end
  tail.next = left != null ? left : right
  return head
end

def irOrderSort<T>(head: IrOrderNode<T>?): IrOrderNode<T>?
  if head == null || head.next == null
    return head
  end
  let right = irOrderSplit(head)

  return irOrderMerge(irOrderSort(head), irOrderSort(right))
end
