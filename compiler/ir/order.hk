class IrOrderNode<T>
  public value: T
  public primary: Int
  public name: String
  public ordinal: Int
  public next: IrOrderNode<T>?

  def init(value: T, primary: Int, name: String, ordinal: Int): Void
    this.value = value
    this.primary = primary
    this.name = name
    this.ordinal = ordinal
  end
end

class IrOrderList<T>
  private first: IrOrderNode<T>?
  private last: IrOrderNode<T>?
  private count: Int = 0

  def add(value: T, primary: Int, name: String): Void
    let node = new IrOrderNode<T>(value, primary, name, this.count)
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
    this.count = this.count + 1
  end

  def sorted(): IrOrderNode<T>?
    this.first = irOrderSort(this.first)
    this.last = null
    var current = this.first

    while current != null
      this.last = current
      current = current.next
    end
    return this.first
  end
end

def irOrderBeforeOrEqual<T>(left: IrOrderNode<T>, right: IrOrderNode<T>): Bool
  if left.primary != right.primary
    return left.primary < right.primary
  end
  let names = irCompareText(left.name, right.name)

  if names != 0
    return names < 0
  end
  return left.ordinal <= right.ordinal
end

def irOrderSplit<T>(head: IrOrderNode<T>): IrOrderNode<T>?
  var slow = head
  var fast = head.next

  while fast != null
    fast = fast.next
    if fast != null
      let nextSlow = slow.next

      if nextSlow != null
        slow = nextSlow
      end
      fast = fast.next
    end
  end
  let right = slow.next

  slow.next = null
  return right
end

def irOrderMerge<T>(optionalLeft: IrOrderNode<T>?, optionalRight: IrOrderNode<T>?): IrOrderNode<T>?
  if optionalLeft == null
    return optionalRight
  end
  if optionalRight == null
    return optionalLeft
  end
  var left: IrOrderNode<T>? = optionalLeft
  var right: IrOrderNode<T>? = optionalRight
  var head = optionalLeft

  if irOrderBeforeOrEqual(optionalLeft, optionalRight)
    left = optionalLeft.next
  else
    head = optionalRight
    right = optionalRight.next
  end
  var tail = head

  while left != null && right != null
    if irOrderBeforeOrEqual(left, right)
      tail.next = left
      tail = left
      left = left.next
    else
      tail.next = right
      tail = right
      right = right.next
    end
  end
  tail.next = left != null ? left : right
  return head
end

def irOrderSort<T>(head: IrOrderNode<T>?): IrOrderNode<T>?
  if head == null || head.next == null
    return head
  end
  let right = irOrderSplit(head)

  return irOrderMerge(irOrderSort(head), irOrderSort(right))
end
