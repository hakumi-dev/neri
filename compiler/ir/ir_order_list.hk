class IrOrderList<T>
  private first: IrOrderNode<T>?
  private last: IrOrderNode<T>?
  private count: Int = 0

  def add(value: T, primary: Int, name: String): Void
    let node = new IrOrderNode<T>(value, primary, name, this.count)
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
    this.count = this.count + 1
  end

  def sorted(): IrOrderNode<T>?
    this.first = irOrderSort(this.first)
    this.last = null
    var current = this.first

    while current != null
      this.last = current
      current = current.next
    end
    return this.first
  end
end
