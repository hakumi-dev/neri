# Native target policy. Driver and language-server code use these helpers rather
# than embedding OS triples, executable suffixes or linker search rules.
use host

def platformSupportedTarget(target: String): Bool
  return target == "macos-arm64" || target == "linux-x86_64" || target == "windows-x86_64"
end

def platformWindowsHost(): Bool
  let operatingSystem = host.environment("OS")
  return operatingSystem != null && operatingSystem == "Windows_NT"
end

def platformLinker(target: String): String
  if target == "windows-x86_64"
    return "clang++.exe"
  end
  return target == "macos-arm64" ? "/usr/bin/clang++" : "clang++-22"
end

def platformTriple(target: String): String
  if target == "windows-x86_64"
    return "x86_64-pc-windows-msvc"
  end
  return target == "macos-arm64" ? "arm64-apple-macos" : "x86_64-unknown-linux-gnu"
end

def platformExecutable(path: String, target: String): String
  if target == "windows-x86_64" && !semanticEndsWith(path, ".exe")
    return path + ".exe"
  end
  return path
end

def platformLinkArguments(target: String, object: String, runtime: String, output: String): String[]
  var arguments = ["--target=" + platformTriple(target), object, runtime, "-o", output]
  if target == "windows-x86_64"
    arguments = host.appendString(arguments, "-lws2_32")
    arguments = host.appendString(arguments, "-lbcrypt")
    arguments = host.appendString(arguments, "-lshell32")
  end
  return arguments
end

def platformDrivePath(path: String): Bool
  if host.stringByteLength(path) < 3
    return false
  end
  let drive = host.stringByteAt(path, 0) as Int
  return ((drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122)) && host.stringByteAt(path, 1) == (58 as Byte) && (host.stringByteAt(path, 2) == (47 as Byte) || host.stringByteAt(path, 2) == (92 as Byte))
end

def platformAbsolutePath(path: String, target: String): Bool
  return bootstrapStartsWith(path, "/") || (target == "windows-x86_64" && platformDrivePath(path))
end

def platformLibraryArguments(arguments: String[], directory: String, target: String): String[]
  var result = host.appendString(arguments, "-L" + directory)
  if target != "windows-x86_64"
    result = host.appendString(result, "-Xlinker")
    result = host.appendString(result, "-rpath")
    result = host.appendString(result, "-Xlinker")
    result = host.appendString(result, directory)
  end
  return result
end
