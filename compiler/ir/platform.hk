# Native target policy. Driver and language-server code use these helpers rather
# than embedding OS triples, executable suffixes or linker search rules.
use host

def platformWindowsHost(): Bool
  let operatingSystem = host.environment("OS")

  return operatingSystem != null && operatingSystem == "Windows_NT"
end

def platformExecutable(path: String, target: readonly TargetPlatform): String
  if target.isWindows() && !semanticEndsWith(path, ".exe")
    return path + ".exe"
  end
  return path
end

def platformLinkObjectsArguments(target: readonly TargetPlatform, objects: StringBuffer, runtime: String, output: String, exportRuntime: Bool = false): String[]
  # Session modules resolve runtime APIs from their host process. Keep every
  # runtime object linked and exported when the executable hosts sessions.
  var arguments = ["--target=" + target.triple()]
  var object = objects.first.nextNode

  while object != null
    arguments = host.appendString(arguments, object.value)
    object = object.nextNode
  end
  if exportRuntime && target.isMacOS()
    arguments = host.appendString(arguments, "-Xlinker")
    arguments = host.appendString(arguments, "-force_load")
    arguments = host.appendString(arguments, "-Xlinker")
    arguments = host.appendString(arguments, runtime)
  else if exportRuntime && target.isLinux()
    arguments = host.appendString(arguments, "-Wl,--whole-archive")
    arguments = host.appendString(arguments, runtime)
    arguments = host.appendString(arguments, "-Wl,--no-whole-archive")
    arguments = host.appendString(arguments, "-Wl,--export-dynamic")
  else
    arguments = host.appendString(arguments, runtime)
  end
  arguments = host.appendString(arguments, "-o")
  arguments = host.appendString(arguments, output)
  if target.isWindows()
    arguments = host.appendString(arguments, "-lws2_32")
    arguments = host.appendString(arguments, "-lbcrypt")
    arguments = host.appendString(arguments, "-lshell32")
  end
  return arguments
end

def platformDrivePath(path: String): Bool
  if host.stringByteLength(path) < 3
    return false
  end
  let drive = host.stringByteAt(path, 0) as Int

  return ((drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122)) && host.stringByteAt(path, 1) == (58 as Byte) && (host.stringByteAt(path, 2) == (47 as Byte) || host.stringByteAt(path, 2) == (92 as Byte))
end

def platformAbsolutePath(path: String, target: readonly TargetPlatform): Bool
  return bootstrapStartsWith(path, "/") || (target.isWindows() && platformDrivePath(path))
end

def platformLibraryArguments(arguments: String[], directory: String, target: readonly TargetPlatform): String[]
  var result = host.appendString(arguments, "-L" + directory)

  if !target.isWindows()
    result = host.appendString(result, "-Xlinker")
    result = host.appendString(result, "-rpath")
    result = host.appendString(result, "-Xlinker")
    result = host.appendString(result, directory)
  end
  return result
end
