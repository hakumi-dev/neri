use host
use files

def runCacheSupportedHost(): Bool
  unsafe
    return runCacheSupported() == 1
  end
end

def runCacheBytes(text: String): Byte[]
  var bytes: Byte[] = []
  var index = 0

  while index < host::stringByteLength(text)
    bytes = host::appendByte(bytes, host::stringByteAt(text, index))
    index = index + 1
  end
  return host::appendByte(bytes, 0 as Byte)
end

def runCacheTime(): Int
  unsafe
    return runCacheClock()
  end
end

def runCacheFrame(text: String): String
  return (host::stringByteLength(text) as String) + ":" + text
end

def runCacheReport(enabled: Bool, phase: String, started: Int): Void
  runCacheReportDuration(enabled, phase, runCacheTime() - started)
end

def runCacheReportDuration(enabled: Bool, phase: String, elapsed: Int): Void
  let timingPath = host::environment("NERI_TIMING_OUTPUT")

  if enabled && timingPath != null && timingPath != "" && host::stringByteLength(timingPath) <= 4096
    let previous = host::readText(timingPath)
    var prefix = ""

    if previous != null
      prefix = previous
    end
    let record = "{\"schemaVersion\":1,\"phase\":" + lspQuote(phase) + ",\"durationMs\":" + (elapsed as String) + "}\n"

    if host::stringByteLength(prefix) + host::stringByteLength(record) > 8388608 || !host::writeText(timingPath, prefix + record)
      host::exit(2)
    end
  end
  if enabled
    let text = "neri timing " + phase + " " + (elapsed as String) + " ms\n"
    let bytes = runCacheBytes(text)

    unsafe
      borrow bytes as pointer
        runCacheWrite(pointer, host::stringByteLength(text))
      end
    end
  end
end

class RunCache
  public directory: String = ""
  public executable: String = ""
  public inputs: String = ""
  public dependencies: String[] = []
  public outcome: CacheOutcome = CacheOutcome.NotRequested()
  public detail: String = ""
  private objectBundle: Bool = false
  private nativeReceipt: Bool = false
  private cacheKey: String = ""
  private codegenIdentity: CodegenIdentity = new CodegenIdentity()
  private linkToolchain: NativeLinkToolchain?
  private storage: RunCacheStorage = new RunCacheStorage()

  def report(enabled: Bool): Void
    if !enabled || this.detail == ""
      return
    end
    let text = "neri cache " + cacheOutcomeName(this.outcome) + ": " + this.detail + "\n"
    let bytes = runCacheBytes(text)

    unsafe
      borrow bytes as pointer
        runCacheWrite(pointer, host::stringByteLength(text))
      end
    end
  end

  def privateDirectory(path: String): Bool
    let info = new RunCacheFile(path, false)

    return info.kind == 2 && info.permissions == 448 && info.owned
  end

  def snapshot(): String
    var result = ""
    let linkToolchain = this.linkToolchain

    if linkToolchain != null && !linkToolchain.matches()
      return ""
    end

    for path in this.dependencies
      let info = new RunCacheFile(path, true)

      result = result + (host::stringByteLength(path) as String) + ":" + path + ":" + info.fingerprint + "\n"
    end
    return result
  end

  def prepare(module: IrModule, target: readonly TargetPlatform, release: Bool, debugSources: BootstrapSourceInput? = null, purpose: readonly CacheDomain = CacheDomain.runExecutable(), configurationInputs: String = "", additionalDependencies: String[] = [], canonicalDigest: String = "", nativeObject: Bool = false, nativeReceipt: Bool = false, linkToolchain: NativeLinkToolchain? = null): Void
    this.directory = ""
    this.executable = ""
    this.inputs = ""
    this.dependencies = []
    this.cacheKey = ""
    this.linkToolchain = null
    this.storage = new RunCacheStorage()
    this.codegenIdentity = new CodegenIdentity()
    this.outcome = CacheOutcome.Unsupported()
    this.detail = "target or native-library dependency tracking is unsupported"
    this.objectBundle = nativeObject
    this.nativeReceipt = nativeReceipt && !nativeObject
    if !target.isMacOS() || (module.requiredFeatures.hasNativeLibraries() && !nativeObject) || !runCacheSupportedHost()
      return
    end
    if !nativeObject
      if linkToolchain == null || !linkToolchain.matches()
        this.outcome = CacheOutcome.DependencyUnavailable()
        this.detail = linkToolchain == null ? "native link identity is unavailable" : linkToolchain.failureReason
        return
      end
      this.linkToolchain = linkToolchain
    end
    # External link inputs and other host ABIs are uncached until their complete
    # dependency discovery is available. Failures always use the normal run path.
    # Object files record native import signatures; their library binaries are
    # resolved by the final link on every build.
    let descriptor = new RunCacheDependencies()

    if !descriptor.capture(target, nativeObject, additionalDependencies, linkToolchain)
      this.outcome = CacheOutcome.DependencyUnavailable()
      this.detail = descriptor.failureReason
      return
    end
    this.dependencies = descriptor.paths
    var root = ""
    let configured = host::environment("NERI_CACHE_DIR")
    let homeDirectory = host::environment("HOME")

    if configured != null
      root = configured
    else if homeDirectory != null
      root = homeDirectory + "/.neri-run-cache"
    end
    if !bootstrapStartsWith(root, "/") || root == "/"
      this.outcome = CacheOutcome.InvalidConfiguration()
      this.detail = "cache root must be an absolute non-root directory"
      return
    end
    files::createDirectory(root)
    if !this.privateDirectory(root)
      this.outcome = CacheOutcome.StorageUnavailable()
      this.detail = "cache root must be an owned directory with mode 0700"
      return
    end
    if !this.codegenIdentity.capture()
      this.outcome = CacheOutcome.DependencyUnavailable()
      this.detail = "code generator identity is unavailable"
      return
    end
    this.inputs = this.snapshot()
    if this.inputs == ""
      this.outcome = CacheOutcome.InputsChanged()
      this.detail = "native dependencies changed during observation"
      return
    end
    var configuration = runCacheFrame(configurationInputs) + runCacheFrame(target.name()) + runCacheFrame(release ? "release" : "debug") + runCacheFrame(descriptor.configuration) + runCacheFrame(this.inputs)

    configuration = configuration + runCacheFrame(linkToolchain.identity) if this.linkToolchain != null && linkToolchain != null

    configuration = configuration + runCacheFrame("native-object") if nativeObject

    let workingDirectory = host::pathAbsolute(".")

    if workingDirectory != null
      configuration = configuration + runCacheFrame(workingDirectory)
    end
    var source = debugSources

    while source != null && !release
      configuration = configuration + runCacheFrame(source.id) + runCacheFrame(source.identityPath)
      source = source.nextInput
    end
    let contentIdentity = canonicalDigest == "" ? irSerializeEnvelopeHex(module) : canonicalDigest
    let format = nativeObject ? "object-bundle" : (this.nativeReceipt ? "native-receipt" : "metadata-receipt")
    let key = cacheIdentity(purpose, this.codegenIdentity.digest, format, [configuration, contentIdentity])

    this.cacheKey = key
    this.outcome = CacheOutcome.Ready()
    this.detail = ""
    this.setupStorage(root, key)
  end

  def setupStorage(root: String, key: String): Void
    this.directory = ""
    this.executable = ""
    if !this.storage.setup(root, key)
      this.outcome = CacheOutcome.StorageUnavailable()
      this.detail = "cache storage cannot be opened safely"
      return
    end
    this.directory = this.storage.selected()
    if this.directory == ""
      this.reserveGeneration()
    else
      this.executable = this.directory + "/program"
    end
  end

  def reserveGeneration(): Void
    if this.storage.reserve()
      this.directory = this.storage.directory
      this.executable = this.directory + "/program"
    else
      this.directory = ""
      this.executable = ""
      this.outcome = CacheOutcome.StorageUnavailable()
      this.detail = "a private cache generation cannot be reserved"
    end
  end

  def hit(): Bool
    if this.selectedHit()
      this.outcome = CacheOutcome.Hit()
      this.detail = ""
      return true
    end
    this.reserveGeneration() if this.cacheKey != ""
    return false
  end

  private def selectedHit(): Bool
    if this.directory == ""
      return false
    end
    if this.inputs != this.snapshot()
      this.outcome = CacheOutcome.InputsChanged()
      this.detail = "dependencies changed since cache preparation"
      return false
    end
    this.outcome = CacheOutcome.InvalidEntry()
    this.detail = "cache artifact or receipt failed integrity validation"
    if (new RunCacheFile(this.directory, false)).kind == 0
      this.outcome = CacheOutcome.Missing()
      this.detail = ""
      return false
    end
    if !this.privateDirectory(this.directory)
      return false
    end
    let info = new RunCacheFile(this.executable, false)

    if info.kind == 0
      this.outcome = CacheOutcome.Missing()
      this.detail = ""
      return false
    end
    if this.nativeReceipt
      let before = new RunCacheFile(this.directory + "/receipt", false)
      let read = files::readBytes(this.directory + "/receipt", NativeLinkLimits.traceBytes())
      let bytes = read.bytes

      if !before.owned || before.kind != 1 || read.failure != null || read.closeFailure != null || bytes == null
        return false
      end
      let payload = host::stringFromBytes(bytes)

      return false if payload == null
      let reader = new CacheRecordReader(payload)

      if reader.string() != "neri-native-receipt" || reader.string() != cacheFormatIdentity(CacheDomain.nativeReceipt(), this.cacheKey) || reader.string() != this.cacheKey
        this.outcome = CacheOutcome.IncompatibleFormat()
        this.detail = "native receipt belongs to a different cache identity"
        return false
      end
      let digest = reader.string()
      let expected = reader.string()
      let observed = new NativeLinkInputs()
      let count = reader.count(NativeLinkLimits.dependencyCount())
      var index = 0

      while index < count && !reader.failed
        let path = reader.string()

        return false if !bootstrapStartsWith(path, "/")
        observed.inputs.add(path)
        index = index + 1
      end
      let missing = reader.count(NativeLinkLimits.dependencyCount())

      index = 0
      while index < missing && !reader.failed
        let path = reader.string()

        return false if !bootstrapStartsWith(path, "/")
        observed.missing.add(path)
        index = index + 1
      end
      let shared = reader.count(NativeLinkLimits.dependencyCount())

      index = 0
      while index < shared && !reader.failed
        observed.shared.add(reader.string())
        index = index + 1
      end
      observed.valid = reader.complete() && count > 0
      let after = new RunCacheFile(this.directory + "/receipt", false)

      return info.owned && info.kind == 1 && digest != "" && digest == referenceFileDigest(this.executable) && info.fingerprint == (new RunCacheFile(this.executable, false)).fingerprint && expected != "" && observed.snapshot() == expected && before.fingerprint == after.fingerprint && after.owned && after.kind == 1 && this.inputs == this.snapshot() && this.codegenIdentity.matches()
    end

    if this.objectBundle
      let receiptInfo = new RunCacheFile(this.directory + "/receipt", false)

      if !receiptInfo.owned || receiptInfo.kind != 1
        return false
      end
      let read = files::readBytes(this.directory + "/receipt", 512)
      let bytes = read.bytes

      if read.failure != null || read.closeFailure != null || bytes == null
        return false
      end
      let receipt = host::stringFromBytes(bytes)
      let expected = this.objectReceipt(this.directory)
      let receiptAfter = new RunCacheFile(this.directory + "/receipt", false)

      return expected != "" && receipt == expected && receiptAfter.owned && receiptAfter.kind == 1 && receiptInfo.fingerprint == receiptAfter.fingerprint && this.inputs == this.snapshot() && this.codegenIdentity.matches()
    end
    let receipt = host::readText(this.directory + "/receipt")

    return info.owned && info.kind == 1 && receipt != null && receipt == info.fingerprint && this.inputs == this.snapshot() && this.codegenIdentity.matches()
  end

  private def objectReceipt(directory: String): String
    let object = directory + "/program"
    let transport = object + ".nir.hex"
    let before = new RunCacheFile(object, false)
    let transportBefore = new RunCacheFile(transport, false)

    if !this.privateDirectory(directory) || !before.owned || before.kind != 1 || !transportBefore.owned || transportBefore.kind != 1
      return ""
    end
    let objectDigest = referenceFileDigest(object)
    let transportDigest = referenceFileDigest(transport)
    let after = new RunCacheFile(object, false)
    let transportAfter = new RunCacheFile(transport, false)

    if objectDigest == "" || transportDigest == "" || before.fingerprint != after.fingerprint || transportBefore.fingerprint != transportAfter.fingerprint
      return ""
    end
    return cacheFormatIdentity(CacheDomain.objectReceipt(), this.cacheKey) + "\n" + this.cacheKey + "\n" + objectDigest + "\n" + transportDigest + "\n"
  end

  private def nativeExecutableReceipt(staging: String, observed: NativeLinkInputs?): String
    if observed == null || !observed.valid || observed.inputs.size == 0 || observed.inputs.size > NativeLinkLimits.dependencyCount() || observed.missing.size > NativeLinkLimits.dependencyCount() || observed.inputs.size != observed.digests.size
      return ""
    end
    let expected = observed.expectedSnapshot()
    let before = new RunCacheFile(staging + "/program", false)
    let digest = referenceFileDigest(staging + "/program")
    let after = new RunCacheFile(staging + "/program", false)

    if expected == "" || !this.privateDirectory(staging) || !before.owned || before.kind != 1 || before.fingerprint != after.fingerprint || digest == "" || observed.snapshot() != expected
      return ""
    end
    let writer = new CacheRecordWriter()

    writer.string("neri-native-receipt")
    writer.string(cacheFormatIdentity(CacheDomain.nativeReceipt(), this.cacheKey))
    writer.string(this.cacheKey)
    writer.string(digest)
    writer.string(expected)
    writer.stringBuffer(observed.inputs)
    writer.stringBuffer(observed.missing)
    writer.stringBuffer(observed.shared)
    let receipt = writer.finish()

    return receipt != null && host::stringByteLength(receipt) <= NativeLinkLimits.traceBytes() ? receipt : ""
  end

  def publish(staging: String, observed: NativeLinkInputs? = null): Bool
    if this.directory == "" || this.inputs != this.snapshot()
      return false
    end
    # Publish a complete directory with one atomic rename. Concurrent builders
    # never overwrite or execute each other's partially linked artifacts.
    let info = new RunCacheFile(staging + "/program", false)
    let receipt = this.objectBundle ? this.objectReceipt(staging) : (this.nativeReceipt ? this.nativeExecutableReceipt(staging, observed) : info.fingerprint)

    if receipt == "" || !host::writeText(staging + "/receipt", receipt)
      return false
    end
    if this.objectBundle && (this.objectReceipt(staging) != receipt || this.inputs != this.snapshot())
      return false
    end
    if this.nativeReceipt && (this.nativeExecutableReceipt(staging, observed) != receipt || this.inputs != this.snapshot())
      return false
    end
    return this.codegenIdentity.matches() && this.directory == this.storage.directory && this.storage.publish(staging)
  end
end
