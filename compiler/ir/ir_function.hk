class IrFunction
  public symbol: IrSymbol
  public parameterTypes: StringBuffer = new StringBuffer()
  public resultType: String = "void"
  public kind: readonly IrFunctionKind
  public effects: EffectSet = new EffectSet()
  public localEffects: EffectSet = new EffectSet()
  public unsafeCall: Bool = false
  public retained: Bool = false
  public cExportSymbol: String = ""
  public entryBlock: Int = 0
  public unsafeRootId: Int = -1
  public declaringClass: IrSymbol?
  public dispatchSlot: IrSymbol?
  public location: IrLocation = new IrLocation(false, 0, 0)
  public firstBlock: IrBlock?
  public lastBlock: IrBlock?
  public blockCount: Int = 0
  public firstDebugLocal: IrDebugLocal?
  public lastDebugLocal: IrDebugLocal?
  public debugLocalCount: Int = 0
  public firstDebugScope: IrDebugScope?
  public lastDebugScope: IrDebugScope?
  public debugScopeCount: Int = 0
  public nextDebugScopeId: Int = 1
  public nextBlockId: Int = 0
  public nextValueId: Int = 0
  public nextFunction: IrFunction?
  public callees: StringBuffer = new StringBuffer()
  # Complete implementation edges for separately compiled library declarations.
  # Null means the implementation graph is unavailable, not an empty graph.
  public linkReferences: StringBuffer?
  public linkRuntimeFeatures: RuntimeFeatures = new RuntimeFeatures()
  public parallelCallees: StringBuffer?
  public parallelUnsafe: Bool = false
  public effectCallers: IrEffectCaller?
  public effectQueueNext: IrFunction?
  public effectQueued: Bool = false
  public emitted: Bool = false

  def init(symbol: IrSymbol, resultType: String, kind: readonly IrFunctionKind, unsafeCall: Bool, location: IrLocation): Void
    this.symbol = symbol
    this.resultType = resultType
    this.kind = kind
    this.unsafeCall = unsafeCall
    this.location = location
  end

  def addCallee(name: String): Void
    this.callees.add(name)
    let parallel = this.parallelCallees

    parallel.add(name) if parallel != null
  end

  def createBlock(): IrBlock
    let block = new IrBlock(this.nextBlockId)

    this.nextBlockId = this.nextBlockId + 1
    if this.firstBlock == null
      this.firstBlock = block
    else
      let last = this.lastBlock

      if last != null
        last.nextBlock = block
      end
    end
    this.lastBlock = block
    this.blockCount = this.blockCount + 1
    return block
  end

  def allocateValue(): Int
    let result = this.nextValueId

    this.nextValueId = this.nextValueId + 1
    return result
  end

  def addDebugLocal(local: IrDebugLocal): Void
    var existing = this.firstDebugLocal

    while existing != null
      let sameLocation = existing.location.sourceId == local.location.sourceId && existing.location.present == local.location.present && existing.location.start == local.location.start && existing.location.length == local.location.length

      if existing.value == local.value && existing.name == local.name && existing.scopeId == local.scopeId && sameLocation
        return
      end
      existing = existing.nextLocal
    end
    if this.firstDebugLocal == null
      this.firstDebugLocal = local
    else
      let last = this.lastDebugLocal

      if last != null
        last.nextLocal = local
      end
    end
    this.lastDebugLocal = local
    this.debugLocalCount = this.debugLocalCount + 1
  end

  def addDebugScope(parentId: Int, location: IrLocation): IrDebugScope
    let scope = new IrDebugScope(this.nextDebugScopeId, parentId, location)

    this.nextDebugScopeId = this.nextDebugScopeId + 1
    if this.firstDebugScope == null
      this.firstDebugScope = scope
    else
      let last = this.lastDebugScope

      if last != null
        last.nextScope = scope
      end
    end
    this.lastDebugScope = scope
    this.debugScopeCount = this.debugScopeCount + 1
    return scope
  end
end
