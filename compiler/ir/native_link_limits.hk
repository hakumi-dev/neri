# Limits bound untrusted loader output and dependency discovery. File hashing
# has a separate streaming policy, independent of these in-memory records.
sealed class NativeLinkLimits
  static def traceBytes(): Int
    return 4194304
  end

  static def pathBytes(): Int
    return 4096
  end

  static def dependencyCount(): Int
    return 4096
  end

  static def observationMilliseconds(): Int
    return 10000
  end

  static def queryBytes(): Int
    return 4096
  end
end
