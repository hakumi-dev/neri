def irWriteClass(writer: IrWireBuffer, moduleName: String, value: IrClass, retainedModules: Bool): Void
  irWriteSymbol(writer, value.symbol)
  let baseSymbol = value.baseSymbol

  writer.writeBool(baseSymbol != null)
  if baseSymbol != null
    irWriteSymbol(writer, baseSymbol)
  end
  writer.writeByte(value.access.wireCode())
  writer.writeBool(value.retained) if retainedModules
  writer.writeUInt32(value.fieldCount)
  var field = value.firstField

  while field != null
    irWriteSymbol(writer, field.symbol)
    irWriteType(writer, moduleName, field.typeName)
    writer.writeByte(field.access.wireCode())
    irWriteLocation(writer, field.location)
    field = field.nextField
  end
  writer.writeUInt32(value.methodCount)
  var method = value.firstMethod

  while method != null
    irWriteSymbol(writer, method.functionSymbol)
    writer.writeByte(method.dispatch.wireCode())
    let slot = method.dispatchSlot

    writer.writeBool(slot != null)
    if slot != null
      irWriteSymbol(writer, slot)
    end
    irWriteLocation(writer, method.location)
    method = method.nextMethod
  end
  irWriteLocation(writer, value.location)
end

def irWriteGlobal(writer: IrWireBuffer, moduleName: String, value: IrGlobal): Void
  irWriteSymbol(writer, value.symbol)
  irWriteType(writer, moduleName, "string")
  writer.writeByte(writer.domains.constantKind.getStringUtf8().wireCode())
  writer.writeUtf8(value.value)
  writer.writeByte(writer.domains.globalLinkage.getInternal().wireCode())
  irWriteLocation(writer, value.location)
end

def irWriteImport(writer: IrWireBuffer, moduleName: String, value: IrImport): Void
  irWriteSymbol(writer, value.symbol)
  irWriteTypeBuffer(writer, moduleName, value.parameterTypes)
  irWriteType(writer, moduleName, value.resultType)
  writer.writeByte(value.kind.wireCode())
  writer.writeUtf8(value.linkName)
  writer.writeUInt32(value.effects.bits())
  writer.writeBool(value.runtimeMajor >= 0)
  if value.runtimeMajor >= 0
    writer.writeUInt16(value.runtimeMajor)
    writer.writeUInt16(value.runtimeMinor)
    writer.writeUInt64(value.runtimeFeatures.bits())
  end
  irWriteLocation(writer, value.location)
end

def irWriteInstruction(writer: IrWireBuffer, moduleName: String, value: IrInstruction, debugScopes: Bool): Void
  writer.writeUInt16(value.opcode.wireCode())
  var resultCount = 0

  if value.resultId >= 0
    resultCount = 1
  end
  if value.secondResultId >= 0
    resultCount = 2
  end
  writer.writeUInt32(resultCount)
  if value.resultId >= 0
    irWriteValueDefinition(writer, moduleName, value.resultId, value.resultType)
  end
  if value.secondResultId >= 0
    irWriteValueDefinition(writer, moduleName, value.secondResultId, value.secondResultType)
  end
  irWriteIntVector(writer, value.operands)
  irWriteTypeArray(writer, moduleName, value.typeArguments)
  let symbol = value.symbol

  writer.writeBool(symbol != null)
  if symbol != null
    irWriteSymbol(writer, symbol)
  end
  writer.writeBool(value.constantKind != null)
  if value.constantKind != null
    irWriteConstant(writer, moduleName, value)
  end
  let predicate = value.predicate

  writer.writeBool(predicate != null)
  if predicate != null
    writer.writeByte(predicate.wireCode())
  end
  writer.writeBool(value.flag)
  irWriteLocation(writer, value.location)
  writer.writeUInt32(value.debugScopeId) if debugScopes
end

def irWriteTerminator(writer: IrWireBuffer, value: IrTerminator, debugScopes: Bool): Void
  writer.writeByte(value.kind.wireCode())
  if value.kind.isBranch()
    writer.writeUInt32(value.firstTarget)
    irWriteIntVector(writer, value.firstArguments)
  else if value.kind.isConditionalBranch()
    writer.writeUInt32(value.condition)
    writer.writeUInt32(value.firstTarget)
    irWriteIntVector(writer, value.firstArguments)
    writer.writeUInt32(value.secondTarget)
    irWriteIntVector(writer, value.secondArguments)
  else if value.kind.isReturn()
    writer.writeBool(value.value >= 0)
    if value.value >= 0
      writer.writeUInt32(value.value)
    end
  else
    writer.writeUtf8(value.panicCode)
    writer.writeUtf8(value.panicMessage)
  end
  irWriteLocation(writer, value.location)
  writer.writeUInt32(value.debugScopeId) if debugScopes
end

def irWriteBlock(writer: IrWireBuffer, moduleName: String, block: IrBlock, debugScopes: Bool): Void
  writer.writeUInt32(block.id)
  writer.writeUInt32(block.parameterCount)
  var parameter = block.firstParameter

  while parameter != null
    writer.writeUInt32(parameter.id)
    irWriteType(writer, moduleName, parameter.typeName)
    irWriteLocation(writer, parameter.location)
    parameter = parameter.nextParameter
  end
  writer.writeUInt32(block.instructionCount)
  var instruction = block.firstInstruction

  while instruction != null
    irWriteInstruction(writer, moduleName, instruction, debugScopes)
    instruction = instruction.nextInstruction
  end
  let terminator = block.terminator

  if terminator != null
    irWriteTerminator(writer, terminator, debugScopes)
  end
end

def irWriteFunction(writer: IrWireBuffer, moduleName: String, value: IrFunction, debugScopes: Bool, retainedModules: Bool, cInterop: Bool): Void
  irWriteSymbol(writer, value.symbol)
  irWriteTypeBuffer(writer, moduleName, value.parameterTypes)
  irWriteType(writer, moduleName, value.resultType)
  writer.writeByte(value.kind.wireCode())
  writer.writeUInt32(value.effects.bits())
  writer.writeBool(value.unsafeCall)
  writer.writeBool(value.retained) if retainedModules
  writer.writeUtf8(value.cExportSymbol) if cInterop
  writer.writeUInt32(value.entryBlock)
  writer.writeBool(value.unsafeRootId >= 0)
  if value.unsafeRootId >= 0
    irWriteValueDefinition(writer, moduleName, value.unsafeRootId, "!unsafe")
  end
  let declaringClass = value.declaringClass

  writer.writeBool(declaringClass != null)
  if declaringClass != null
    irWriteSymbol(writer, declaringClass)
  end
  let dispatchSlot = value.dispatchSlot

  writer.writeBool(dispatchSlot != null)
  if dispatchSlot != null
    irWriteSymbol(writer, dispatchSlot)
  end
  irWriteLocation(writer, value.location)
  let order = irBlockOrder(value)

  writer.writeUInt32(order.size)
  var index = 0

  while index < order.size
    let block = order.get(index)

    if block != null
      irWriteBlock(writer, moduleName, block, debugScopes)
    end
    index = index + 1
  end
  if debugScopes
    writer.writeUInt32(value.debugScopeCount)
    var scope = value.firstDebugScope

    while scope != null
      writer.writeUInt32(scope.id)
      writer.writeUInt32(scope.parentId)
      irWriteLocation(writer, scope.location)
      scope = scope.nextScope
    end
  end
  writer.writeUInt32(value.debugLocalCount)
  var local = irNextDebugLocal(value)

  while local != null
    local.emitted = true
    writer.writeUtf8(local.name)
    writer.writeUInt32(local.value)
    writer.writeUInt32(local.scopeId) if debugScopes
    irWriteLocation(writer, local.location)
    local = irNextDebugLocal(value)
  end
end

def irSerializePayload(module: IrModule): IrWireBuffer
  module.resetEmission()
  let writer = new IrWireBuffer(module.domains)

  writer.writeUInt16(irSemanticMajor())
  writer.writeUInt16(irSemanticMinor())
  writer.writeUtf8(module.id)
  let features = module.requiredFeatures.orderedNames()

  writer.writeUInt32(features.Length)
  for feature in features
    writer.writeUtf8(feature)
  end
  writer.writeUInt32(module.sourceCount)
  var sourceNode = irOrderedSources(module)

  while sourceNode != null
    let source = sourceNode.value

    writer.writeUtf8(source.id)
    writer.writeBlob(source.text)
    sourceNode = sourceNode.next
  end
  writer.writeUInt32(module.classCount)
  var classNode = irOrderedClasses(module)

  while classNode != null
    let classValue = classNode.value

    irWriteClass(writer, module.id, classValue, module.requiredFeatures.hasRetainedModules())
    classNode = classNode.next
  end
  writer.writeUInt32(module.globalCount)
  var globalNode = irOrderedGlobals(module)

  while globalNode != null
    let global = globalNode.value

    irWriteGlobal(writer, module.id, global)
    globalNode = globalNode.next
  end
  writer.writeUInt32(module.importCount)
  var importNode = irOrderedImports(module)

  while importNode != null
    let importValue = importNode.value

    irWriteImport(writer, module.id, importValue)
    if module.requiredFeatures.hasNativeLibraries()
      writer.writeUtf8(importValue.nativeLibrary)
    end
    importNode = importNode.next
  end
  writer.writeUInt32(module.functionCount)
  var functionNode = irOrderedFunctions(module)

  while functionNode != null
    let function = functionNode.value

    let debugLayout = module.requiredFeatures.hasDebugScopes() || module.requiredFeatures.hasRetainedModules() || module.requiredFeatures.hasCInterop()

    irWriteFunction(writer, module.id, function, debugLayout, module.requiredFeatures.hasRetainedModules(), module.requiredFeatures.hasCInterop())
    functionNode = functionNode.next
  end
  if module.requiredFeatures.hasNativeRecords()
    irWriteNativeRecords(writer, module)
  end
  if module.requiredFeatures.hasSessionModule()
    let entry = module.sessionEntry

    if entry != null
      irWriteSymbol(writer, entry)
      irWriteType(writer, module.id, module.sessionSourceType)
      irWriteType(writer, module.id, module.sessionTargetType)
      writer.writeUtf8(module.sessionArtifactIdentity) if module.requiredFeatures.hasRetainedModules()
    end
  end
  return writer
end

def irSerializeEnvelopePayloadHex(module: IrModule, payload: IrWireBuffer, checksum: String): String
  let envelope = new IrWireBuffer(module.domains)
  let magic: Int[] = [78, 69, 82, 73, 82, 13, 10, 26]

  for byte in magic envelope.writeByte(byte) end
  envelope.writeUInt16(irTransportMajor())
  envelope.writeUInt16(module.requiredFeatures.minimumTransportMinor())
  envelope.writeUInt32(0)
  envelope.writeUInt64(payload.bytes.size)
  envelope.writeHexBytes(checksum)
  envelope.append(payload)
  return envelope.toHex()
end

def irSerializeEnvelopeHex(module: IrModule): String
  let payload = irSerializePayload(module)

  return irSerializeEnvelopePayloadHex(module, payload, sha256FastWire(payload.bytes))
end
