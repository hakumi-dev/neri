class IrRuntimeContract
  public name: String = ""
  public linkName: String = ""
  public resultType: String = "void"
  public effects: EffectSet = new EffectSet()
  public runtimeMinor: Int = 4
  public runtimeFeatures: RuntimeFeatures = new RuntimeFeatures()
  public symbolKind: Int = 7
  public parallelSafe: Bool = false

  def init(name: String, linkName: String, resultType: String, effects: EffectSet, runtimeMinor: Int, runtimeFeatures: RuntimeFeatures, symbolKind: Int): Void
    this.name = name
    this.linkName = linkName
    this.resultType = resultType
    this.effects = effects
    this.runtimeMinor = runtimeMinor
    this.runtimeFeatures = runtimeFeatures
    this.symbolKind = symbolKind
  end
end

def irFloatBitsText(literal: String): String
  let parsed = host.parseFloat(literal)

  if parsed == null
    return "0000000000000000"
  end
  var value = parsed
  var result = ""

  unsafe
    let pointer = &value
    let bytes = pointer as Byte*
    var index = 7

    while index >= 0
      let byte = bytes[index] as Int

      result = result + irHexDigit(byte / 16) + irHexDigit(byte - (byte / 16) * 16)
      index = index - 1
    end
  end
  return result
end

class IrLowerer
  public semantic: SemanticModel = new SemanticModel()
  public bound: BoundArena = new BoundArena()
  public syntax: SyntaxArena = new SyntaxArena()
  public source: String = ""
  public module: IrModule = new IrModule("main", "")
  public adapterTargets: StringBuffer = new StringBuffer()
  public adapterArities: IntBuffer = new IntBuffer()
  public adapterVirtual: IntBuffer = new IntBuffer()
  public adapterNodes: IntBuffer = new IntBuffer()
  public checkParallel: Bool = false
  public retainedModule: IrModule?
  private locationOverride: IrLocation?

  def init(semantic: SemanticModel, syntax: SyntaxArena, source: String, moduleName: String): Void
    this.semantic = semantic
    this.bound = semantic.bound
    this.syntax = syntax
    this.source = source
    this.module = new IrModule(moduleName, source)
  end

  def setSources(ids: StringBuffer, texts: StringBuffer, starts: IntBuffer): Void
    this.module.clearSources()
    var index = 0

    while index < ids.size
      this.module.addSource(new IrSource(ids.get(index), texts.get(index), starts.get(index)))
      index = index + 1
    end
  end

  def retain(parent: IrModule): Void
    this.retainedModule = parent
    this.module.retainedParent = parent
  end

  def retainDeclarations(target: IrModule, parent: IrModule): Void
    let previousModule = this.module
    let previousRetained = this.retainedModule

    this.module = target
    this.retainedModule = parent
    this.lowerRetainedModule(parent)
    this.module = previousModule
    this.retainedModule = previousRetained
  end

  def location(node: Int): IrLocation
    let override = this.locationOverride

    if override != null
      return override
    end
    return this.module.location(this.bound.startAt(node), this.bound.lengthAt(node))
  end

  def semanticLocation(start: Int, length: Int): IrLocation
    return this.module.location(start, length)
  end

  def childScopeLocation(node: Int, first: Int, count: Int): IrLocation
    if count <= 0
      return new IrLocation(false, 0, 0)
    end
    return this.location(this.bound.childAt(node, first))
  end

  def treeScopeLocation(node: Int): IrLocation
    return this.location(node)
  end

  def lower(): IrModule
    this.module.requireFeature("debug-scopes-v1")
    let retained = this.retainedModule

    if retained != null
      this.module.requireFeature("retained-modules-v1")
    end
    var signature = this.semantic.firstClass

    while signature != null
      this.checkParallel = true if signature.isParallelFunction
      signature = signature.nextClass
    end
    irLowerNativeRecords(this)
    var typeIndex = 0
    let parentBound = this.bound.parent

    if parentBound != null && retained != null
      typeIndex = parentBound.count()
    end

    while typeIndex < this.bound.count()
      this.requireType(irType(this.bound.typeAt(typeIndex)))
      typeIndex = typeIndex + 1
    end
    this.lowerClasses()
    var classSymbol = this.semantic.firstClass

    while classSymbol != null
      var method = classSymbol.firstMethod

      while method != null
        this.lowerCallable(method)
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
    this.lowerFunctionsInSymbolOrder()
    var adapter = 0

    while adapter < this.adapterTargets.size
      let target = this.findCallable(this.adapterTargets.get(adapter))

      if target != null
        this.lowerDefaultAdapter(target, this.adapterArities.get(adapter), this.adapterVirtual.get(adapter) == 1, this.adapterNodes.get(adapter))
      end
      adapter = adapter + 1
    end
    if retained != null
      this.lowerRetainedModule(retained)
    end
    if this.checkParallel
      irPropagateEffects(this.module, true)
      irCheckParallelCallbacks(this)
    end
    irPropagateEffects(this.module)
    return this.module
  end

  private def lowerRetainedModule(parent: IrModule): Void
    let functions = new StringBuffer()
    let classes = new StringBuffer()
    var localClass = this.module.firstClass

    while localClass != null
      let base = localClass.baseSymbol

      this.addRetainedName(classes, base.name) if base != null
      var field = localClass.firstField

      while field != null
        this.addRetainedType(classes, field.typeName)
        field = field.nextField
      end
      var method = localClass.firstMethod

      while method != null
        this.addRetainedName(functions, method.functionSymbol.name)
        let slot = method.dispatchSlot

        this.addRetainedName(functions, slot.name) if slot != null
        method = method.nextMethod
      end
      localClass = localClass.nextClass
    end
    var localRecord = this.module.firstRecord

    while localRecord != null
      var field = localRecord.firstField

      while field != null
        this.addRetainedType(classes, field.typeName)
        field = field.nextField
      end
      localRecord = localRecord.nextRecord
    end
    var localImport = this.module.firstImport

    while localImport != null
      this.addRetainedType(classes, localImport.resultType)
      var parameter = localImport.parameterTypes.first.nextNode

      while parameter != null
        this.addRetainedType(classes, parameter.value)
        parameter = parameter.nextNode
      end
      localImport = localImport.nextImport
    end
    var local = this.module.firstFunction

    while local != null
      var callee = 0

      while callee < local.callees.size
        this.addRetainedName(functions, local.callees.get(callee))
        callee = callee + 1
      end
      this.addRetainedType(classes, local.resultType)
      var parameter = local.parameterTypes.first.nextNode

      while parameter != null
        this.addRetainedType(classes, parameter.value)
        parameter = parameter.nextNode
      end
      let owner = local.declaringClass

      this.addRetainedName(classes, owner.name) if owner != null
      var block = local.firstBlock

      while block != null
        var blockParameter = block.firstParameter

        while blockParameter != null
          this.addRetainedType(classes, blockParameter.typeName)
          blockParameter = blockParameter.nextParameter
        end
        var instruction = block.firstInstruction

        while instruction != null
          this.addRetainedType(classes, instruction.resultType)
          this.addRetainedType(classes, instruction.secondResultType)
          var typeIndex = 0

          while typeIndex < instruction.typeArguments.Length
            this.addRetainedType(classes, instruction.typeArguments[typeIndex])
            typeIndex = typeIndex + 1
          end
          let symbol = instruction.symbol

          if symbol != null
            if symbol.kind == 1
              this.addRetainedName(classes, symbol.name)
            else if symbol.kind == 3 || symbol.kind == 4
              this.addRetainedName(functions, symbol.name)
            end
          end
          instruction = instruction.nextInstruction
        end
        block = block.nextBlock
      end
      local = local.nextFunction
    end
    this.addRetainedType(classes, this.module.sessionSourceType)
    this.addRetainedType(classes, this.module.sessionTargetType)
    var changed = true

    while changed
      let oldFunctionCount = functions.size
      let oldClassCount = classes.size
      var functionIndex = 0

      while functionIndex < functions.size
        let sourceFunction = this.findRetainedFunction(parent, functions.get(functionIndex))

        if sourceFunction != null
          this.addRetainedType(classes, sourceFunction.resultType)
          let owner = sourceFunction.declaringClass

          this.addRetainedName(classes, owner.name) if owner != null
          var parameter = sourceFunction.parameterTypes.first.nextNode

          while parameter != null
            this.addRetainedType(classes, parameter.value)
            parameter = parameter.nextNode
          end
        end
        functionIndex = functionIndex + 1
      end
      var classIndex = 0

      while classIndex < classes.size
        let classValue = this.findRetainedClass(parent, classes.get(classIndex))

        if classValue != null
          let base = classValue.baseSymbol

          this.addRetainedName(classes, base.name) if base != null
          var field = classValue.firstField

          while field != null
            this.addRetainedType(classes, field.typeName)
            field = field.nextField
          end
          var method = classValue.firstMethod

          while method != null
            this.addRetainedName(functions, method.functionSymbol.name)
            method = method.nextMethod
          end
        else
          let record = this.findRetainedRecord(parent, classes.get(classIndex))

          if record != null
            var field = record.firstField

            while field != null
              this.addRetainedType(classes, field.typeName)
              field = field.nextField
            end
          end
        end
        classIndex = classIndex + 1
      end
      changed = functions.size != oldFunctionCount || classes.size != oldClassCount
    end
    var classIndex = 0

    while classIndex < classes.size
      let classValue = this.findRetainedClass(parent, classes.get(classIndex))

      if classValue != null && !this.hasOwnedClass(classValue.symbol.name)
        let declaration = new IrClass(classValue.symbol, classValue.baseSymbol, classValue.access, irNoLocation())

        declaration.retained = true
        var field = classValue.firstField

        while field != null
          declaration.addField(new IrField(field.symbol, field.typeName, field.access, irNoLocation()))
          field = field.nextField
        end
        var method = classValue.firstMethod

        while method != null
          declaration.addMethod(new IrMethod(method.functionSymbol, method.dispatch, method.dispatchSlot, irNoLocation()))
          method = method.nextMethod
        end
        this.module.addClass(declaration)
      end
      classIndex = classIndex + 1
    end
    var recordIndex = 0

    while recordIndex < classes.size
      let sourceRecord = this.findRetainedRecord(parent, classes.get(recordIndex))

      if sourceRecord != null && !this.hasOwnedRecord(sourceRecord.symbol.name)
        let declaration = new IrNativeRecord(sourceRecord.symbol, sourceRecord.unionType)
        var field = sourceRecord.firstField

        while field != null
          declaration.addField(new IrField(field.symbol, field.typeName, field.access, irNoLocation()))
          field = field.nextField
        end
        let last = this.module.lastRecord

        if last == null
          this.module.firstRecord = declaration
        else
          last.nextRecord = declaration
        end
        this.module.lastRecord = declaration
        this.module.recordCount = this.module.recordCount + 1
        this.module.requireFeature("native-records-v1")
      end
      recordIndex = recordIndex + 1
    end
    var functionIndex = 0

    while functionIndex < functions.size
      let sourceFunction = this.findRetainedFunction(parent, functions.get(functionIndex))

      if sourceFunction != null && sourceFunction.symbol.name != "__neri_session_entry" && irEffectFunction(this.module, sourceFunction.symbol.name) == null
        let function = new IrFunction(sourceFunction.symbol, sourceFunction.resultType, sourceFunction.kind, sourceFunction.unsafeCall, irNoLocation())

        function.retained = true
        function.effects = sourceFunction.effects
        function.localEffects = sourceFunction.effects
        function.declaringClass = sourceFunction.declaringClass
        function.dispatchSlot = sourceFunction.dispatchSlot
        var parameter = sourceFunction.parameterTypes.first.nextNode

        while parameter != null
          function.parameterTypes.add(parameter.value)
          parameter = parameter.nextNode
        end
        this.module.addFunction(function)
      end
      functionIndex = functionIndex + 1
    end
  end

  private def addRetainedName(names: StringBuffer, name: String): Void
    var index = 0

    while index < names.size
      if names.get(index) == name
        return
      end
      index = index + 1
    end
    names.add(name) if name != ""
  end

  private def addRetainedType(classes: StringBuffer, typeName: String): Void
    this.requireType(typeName)
    let kind = irTypeKind(typeName)

    if kind == "class" || kind == "record"
      this.addRetainedName(classes, irTypeInner(typeName))
    else if kind == "fixed-array"
      this.addRetainedType(classes, irFixedArrayInner(typeName))
    else if kind == "array" || kind == "optional" || kind == "pointer"
      this.addRetainedType(classes, irTypeInner(typeName))
    end
  end

  private def hasOwnedClass(name: String): Bool
    var value = this.module.firstClass

    while value != null
      if value.symbol.name == name && !value.retained
        return true
      end
      value = value.nextClass
    end
    return false
  end

  private def hasOwnedRecord(name: String): Bool
    var value = this.module.firstRecord

    while value != null
      if value.symbol.name == name
        return true
      end
      value = value.nextRecord
    end
    return false
  end

  private def findRetainedFunction(parent: IrModule, name: String): IrFunction?
    var module: IrModule? = parent

    while module != null
      var function = module.firstFunction

      while function != null
        if function.symbol.name == name && !function.retained
          return function
        end
        function = function.nextFunction
      end
      module = module.retainedParent
    end
    return null
  end

  private def findRetainedClass(parent: IrModule, name: String): IrClass?
    var module: IrModule? = parent

    while module != null
      var value = module.firstClass

      while value != null
        if value.symbol.name == name && !value.retained
          return value
        end
        value = value.nextClass
      end
      module = module.retainedParent
    end
    return null
  end

  private def findRetainedRecord(parent: IrModule, name: String): IrNativeRecord?
    var module: IrModule? = parent

    while module != null
      var value = module.firstRecord

      while value != null
        if value.symbol.name == name
          return value
        end
        value = value.nextRecord
      end
      module = module.retainedParent
    end
    return null
  end

  def requireType(typeName: String): Void
    if irIsExtendedScalar(typeName)
      this.module.requireFeature("extended-scalars-v1")
      return
    end
    if typeName == "string"
      this.module.requireFeature("native-strings-v1")
      return
    end
    let kind = irTypeKind(typeName)

    if kind == "record" || kind == "fixed-array"
      this.module.requireFeature("native-records-v1")
      if kind == "fixed-array"
        this.requireType(irFixedArrayInner(typeName))
      end
      return
    end
    if kind == "array" || kind == "optional" || kind == "pointer"
      this.requireType(irTypeInner(typeName))
    end
  end

  def lowerFunctionsInSymbolOrder(): Void
    let ordered = new IrOrderList<SemanticCallable>()
    var function = this.semantic.firstFunction

    while function != null
      ordered.add(function, 0, function.fullName)
      function = function.nextCallable
    end
    var current = ordered.sorted()

    while current != null
      this.lowerCallable(current.value)
      current = current.next
    end
  end

  def lowerClasses(): Void
    var semanticClass = this.semantic.firstClass

    while semanticClass != null
      if semanticClass.representation == ""
        this.lowerClass(semanticClass)
      end
      semanticClass = semanticClass.nextClass
    end
  end

  def lowerClass(semanticClass: SemanticClass): Void
    var baseSymbol: IrSymbol? = null

    if semanticClass.baseName != ""
      baseSymbol = irSymbol(this.module.id, 1, semanticClass.baseName)
    end
    let declaration = new IrClass(irSymbol(this.module.id, 1, semanticClass.fullName), baseSymbol, irAccessTag(semanticClass.access), irNoLocation())

    if semanticClass.syntaxNode >= 0
      let origin = this.semanticLocation(this.syntax.irStartAt(semanticClass.syntaxNode), this.syntax.irLengthAt(semanticClass.syntaxNode))

      declaration.declarationSourceId = origin.sourceId if origin.present
    end

    var field = semanticClass.firstField

    while field != null
      this.requireType(irType(field.typeName))
      declaration.addField(new IrField(irSymbol(this.module.id, 2, field.owner + "." + field.name), irType(field.typeName), irAccessTag(field.access), irNoLocation()))
      field = field.nextField
    end
    var method = semanticClass.firstMethod

    while method != null
      var dispatch = 3
      var slot: IrSymbol? = irSymbol(this.module.id, 3, this.dispatchSlot(semanticClass, method))

      if method.isStatic
        dispatch = 1
        slot = null
      else if method.name == "init"
        dispatch = 2
        slot = null
      end
      declaration.addMethod(new IrMethod(irSymbol(this.module.id, 3, method.fullName), dispatch, slot, this.semanticLocation(this.bound.startAt(method.boundNode), this.bound.lengthAt(method.boundNode))))
      method = method.nextCallable
    end
    this.module.addClass(declaration)
  end

  def dispatchSlot(owner: SemanticClass, method: SemanticCallable): String
    var current = owner
    var result = method.fullName
    var steps = 0

    while current.baseName != "" && steps < 256
      let baseClass = this.semantic.findClass(current.baseName)

      if baseClass == null
        return result
      end
      var candidate = baseClass.firstMethod

      while candidate != null
        if candidate.name == method.name && !candidate.isStatic && candidate.name != "init"
          result = candidate.fullName
        end
        candidate = candidate.nextCallable
      end
      current = baseClass
      steps = steps + 1
    end
    return result
  end

  def lowerCallable(callable: SemanticCallable): Void
    if callable.cAbiSymbol != "" || callable.intrinsicName != ""
      return
    end
    this.requireType(irType(callable.returnType))
    var typedParameter = callable.firstParameter

    while typedParameter != null
      this.requireType(irType(typedParameter.typeName))
      typedParameter = typedParameter.nextParameter
    end
    let represented = this.representedClass(callable.className)
    let symbolKind = callable.className == "" || represented ? 4 : 3
    var functionKind = 1

    if callable.className != "" && !represented
      if callable.isStatic
        functionKind = 2
      else if callable.name == "init"
        functionKind = 4
      else
        functionKind = 3
      end
    end
    let function = new IrFunction(irSymbol(this.module.id, symbolKind, callable.fullName), irType(callable.returnType), functionKind, callable.isUnsafe, this.location(callable.boundNode))

    function.parallelCallees = new StringBuffer() if this.checkParallel
    function.parallelUnsafe = callable.isUnsafe
    if callable.className != "" && !represented
      function.declaringClass = irSymbol(this.module.id, 1, callable.className)
      if !callable.isStatic && callable.name != "init"
        let owner = this.semantic.findClass(callable.className)

        if owner != null
          function.dispatchSlot = irSymbol(this.module.id, 3, this.dispatchSlot(owner, callable))
        end
      end
    end
    let entry = function.createBlock()
    let context = new IrFunctionContext(function, entry)

    if callable.className != "" && !callable.isStatic
      let receiverType = irType(callable.className)

      function.parameterTypes.add(receiverType)
      let receiver = function.allocateValue()

      entry.addParameter(new IrParameter(receiver, receiverType, this.location(callable.boundNode)))
      context.addVariable(callable.fullName + "/this", 5, "this", receiverType, receiver, false, this.location(callable.boundNode))
    end
    var parameter = callable.firstParameter

    while parameter != null
      let typeName = irType(parameter.typeName)

      function.parameterTypes.add(typeName)
      let value = function.allocateValue()
      let parameterLocation = this.module.location(this.syntax.startAt(parameter.syntaxNode), this.syntax.lengthAt(parameter.syntaxNode))

      entry.addParameter(new IrParameter(value, typeName, parameterLocation))
      context.addVariable(parameter.identity, 5, parameter.name, typeName, value, false, parameterLocation)
      parameter = parameter.nextParameter
    end
    if callable.isAbstract
      # A typed trap preserves the virtual slot without supplying an implementation.
      let trap = new IrTerminator(4, function.location)

      trap.panicCode = "NRP009"
      trap.panicMessage = "Invalid abstract method dispatch"
      entry.terminator = trap
      function.localEffects = function.localEffects.mergedWith(new EffectSet().withMayPanic().withNoReturn())
      this.module.addFunction(function)
      return
    end
    if callable.isUnsafe
      function.unsafeRootId = function.allocateValue()
      context.unsafeCapabilities.add(function.unsafeRootId)
      context.unsafeDepth = 1
    end
    if callable.className != "" && callable.name == "init"
      let receiver = context.findVariable("this")
      let owner = this.semantic.findClass(callable.className)

      if receiver != null && owner != null
        this.lowerConstructorPreamble(context, callable, owner, receiver.value, function.location)
      end
    end
    if this.resourceOutcome(function.resultType)
      this.ensureCloseFailures(context)
    end
    context.enterScope(this.childScopeLocation(callable.boundNode, 0, this.bound.childCountAt(callable.boundNode)))
    var index = 0

    while index < this.bound.childCountAt(callable.boundNode) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(callable.boundNode, index))
      index = index + 1
    end
    context.leaveScope()
    let declaringClass = this.semantic.findClass(callable.className)

    if declaringClass != null && declaringClass.isFunctionType
      let trap = new IrTerminator(4, function.location)

      trap.panicCode = "NRP007"
      trap.panicMessage = "Invalid callback dispatch"
      context.current.terminator = trap
      function.localEffects = function.localEffects.mergedWith(new EffectSet().withMayPanic().withNoReturn())
      context.terminated = true
    end
    if !context.terminated && function.resultType == "void"
      context.returnValue(-1, function.location)
    end
    this.module.addFunction(function)
  end

  def lowerFieldInitializers(context: IrFunctionContext, owner: SemanticClass, receiver: Int, location: IrLocation): Void
    let previousOverride = context.thisOverride
    let previousOverrideType = context.thisOverrideType

    context.thisOverride = receiver
    context.thisOverrideType = "class|" + owner.fullName
    var field = owner.firstField

    while field != null
      let typeName = irType(field.typeName)
      var value = new IrValue(-1, typeName)

      if field.boundInitializer >= 0
        value = this.lowerExpression(context, field.boundInitializer, typeName)
      else
        value = this.lowerDefaultFieldValue(context, typeName, location)
      end
      if value.id >= 0
        let operands: Int[] = [receiver, value.id]

        context.emitSymbol(40, "void", operands, irSymbol(this.module.id, 2, field.owner + "." + field.name), location)
        context.function.localEffects = context.function.localEffects.withWrite()
      end
      field = field.nextField
    end
    context.thisOverride = previousOverride
    context.thisOverrideType = previousOverrideType
  end

  def lowerDefaultFieldValue(context: IrFunctionContext, typeName: String, location: IrLocation): IrValue
    if irIsExtendedScalar(typeName)
      let zero = context.emitConstant("int", 3, "0", location)

      context.function.localEffects = context.function.localEffects.withMayPanic()
      return context.emitValue(58, typeName, [zero.id], location)
    end
    if typeName == "bool"
      return context.emitConstant(typeName, 1, "false", location)
    end
    if typeName == "byte"
      return context.emitConstant(typeName, 2, "0", location)
    end
    if typeName == "int"
      return context.emitConstant(typeName, 3, "0", location)
    end
    if typeName == "float"
      return context.emitConstant(typeName, 4, "0x0000000000000000", location)
    end
    if typeName == "string"
      let name = "literal.string.sha256." + sha256Text("")

      if !this.hasGlobal(name)
        this.module.addGlobal(new IrGlobal(irSymbol(this.module.id, 9, name), "", irNoLocation()))
      end
      this.module.requireFeature("native-strings-v1")
      this.module.requireFeature("string-data-v1")
      return context.emit(1, "string", irEmptyInts(), irEmptyStrings(), null, 7, name, 0, false, location)
    end
    if irIsOptional(typeName)
      return context.emitTyped(21, typeName, irEmptyInts(), irTypeInner(typeName), location)
    end
    return new IrValue(-1, typeName)
  end

  def lowerConstructorPreamble(context: IrFunctionContext, callable: SemanticCallable, owner: SemanticClass, receiver: Int, location: IrLocation): Void
    if owner.baseName != ""
      let baseClass = this.semantic.findClass(owner.baseName)

      if baseClass != null
        var baseConstructor = this.findCallable(callable.baseConstructorName)

        if baseConstructor == null
          baseConstructor = this.findCallable(baseClass.fullName + ".init")
        end
        if baseConstructor != null
          var arguments: Int[] = []
          let baseCall = callable.baseCallNode >= 0 ? callable.baseCallNode : callable.boundNode

          if callable.baseCallNode >= 0
            arguments = this.lowerArguments(context, baseCall, 0, baseConstructor)
          end
          let upcastOperands: Int[] = [receiver]
          let baseReceiver = context.emitValue(20, "class|" + baseClass.fullName, upcastOperands, location)
          var operands: Int[] = [baseReceiver.id]

          for argument in arguments operands = host.appendInt(operands, argument) end
          if callable.baseArguments.size < baseConstructor.parameterCount
            let adapterName = this.requestDefaultAdapter(baseConstructor, callable.baseArguments.size, false, baseCall)

            context.emitSymbol(28, "void", operands, irSymbol(this.module.id, 4, adapterName), location)
            context.function.addCallee(adapterName)
          else
            context.emitSymbol(29, "void", operands, irSymbol(this.module.id, 3, baseConstructor.fullName), location)
            context.function.addCallee(baseConstructor.fullName)
          end
        else
          this.lowerConstructionDefaults(context, baseClass, receiver, location)
        end
      end
    end
    this.lowerFieldInitializers(context, owner, receiver, location)
  end

  def lowerConstructionDefaults(context: IrFunctionContext, owner: SemanticClass, receiver: Int, location: IrLocation): Void
    if owner.baseName != ""
      let baseClass = this.semantic.findClass(owner.baseName)

      if baseClass != null
        let baseConstructor = this.findCallable(baseClass.fullName + ".init")

        if baseConstructor == null
          this.lowerConstructionDefaults(context, baseClass, receiver, location)
        else
          let upcastOperands: Int[] = [receiver]
          let baseReceiver = context.emitValue(20, "class|" + baseClass.fullName, upcastOperands, location)
          let operands: Int[] = [baseReceiver.id]

          if baseConstructor.parameterCount > 0
            let adapterName = this.requestDefaultAdapter(baseConstructor, 0, false, baseConstructor.boundNode)

            context.emitSymbol(28, "void", operands, irSymbol(this.module.id, 4, adapterName), location)
            context.function.addCallee(adapterName)
          else
            context.emitSymbol(29, "void", operands, irSymbol(this.module.id, 3, baseConstructor.fullName), location)
            context.function.addCallee(baseConstructor.fullName)
          end
        end
      end
    end
    this.lowerFieldInitializers(context, owner, receiver, location)
  end

  def lowerStatement(context: IrFunctionContext, node: Int): Void
    let kind = this.bound.kindAt(node)

    if kind == "Let" || kind == "Var"
      let value = this.lowerExpression(context, this.bound.childAt(node, 0), irType(this.bound.typeAt(node)))
      let variable = context.addVariable(this.bound.symbolAt(node), 6, this.bound.dataAt(node), irType(this.bound.typeAt(node)), value.id, kind == "Var", this.location(node))

      irPrepareNativeVariable(this, context, variable, node)
    else if kind == "Assignment"
      this.lowerAssignment(context, node)
    else if kind == "Return"
      if this.bound.childCountAt(node) == 0
        this.emitScopeCleanups(context, 0)
        context.returnValue(-1, this.location(node))
      else
        if this.resourceOutcome(context.function.resultType)
          this.lowerOutcomeReturn(context, node)
        else
          let value = this.lowerExpression(context, this.bound.childAt(node, 0), context.function.resultType)

          this.emitScopeCleanups(context, 0)
          context.returnValue(value.id, this.location(node))
        end
      end
    else if kind == "ExpressionStatement"
      this.lowerExpression(context, this.bound.childAt(node, 0), "")
    else if kind == "If"
      this.lowerIf(context, node)
    else if kind == "While"
      this.lowerWhile(context, node)
    else if kind == "For"
      this.lowerFor(context, node)
    else if kind == "Match"
      this.lowerMatch(context, node)
    else if kind == "Break"
      this.lowerLoopTransfer(context, false, node)
    else if kind == "Continue"
      this.lowerLoopTransfer(context, true, node)
    else if kind == "UnsafeBlock"
      this.lowerUnsafeBlock(context, node)
    else if kind == "BorrowBlock"
      this.lowerBorrowBlock(context, node)
    else if kind == "UsingBlock"
      this.lowerUsingBlock(context, node)
    end
  end

  def lowerUsingBlock(context: IrFunctionContext, node: Int): Void
    let acquired = this.lowerExpression(context, this.bound.childAt(node, 0), "")

    if semanticField(this.bound.dataAt(node), 1) == "result"
      this.lowerResultUsingBlock(context, node, acquired)
      return
    end
    context.enterScope(this.treeScopeLocation(node))
    context.addVariable(this.bound.symbolAt(node), 6, semanticField(this.bound.dataAt(node), 0), irType(this.bound.typeAt(this.bound.childAt(node, 0))), acquired.id, false, this.location(node))
    context.pushResourceCleanup(acquired.id, this.bound.typeAt(this.bound.childAt(node, 0)), this.bound.symbolAt(node))
    var index = 1

    while index < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, index))
      index = index + 1
    end
    if !context.terminated
      this.emitScopeCleanups(context, context.cleanupDepth - 1)
    end
    context.popCleanup()
    context.leaveScope()
  end

  def lowerResultUsingBlock(context: IrFunctionContext, node: Int, acquired: IrValue): Void
    this.ensureCloseFailures(context)
    let resultName = semanticMutableType(this.bound.typeAt(this.bound.childAt(node, 0)))
    let tag = context.emitSymbol(39, "int", [acquired.id], irSymbol(this.module.id, 2, resultName + ".$alternativeTag"), this.location(node))
    let ok = context.emitConstant("int", 3, "0", this.location(node))
    let isOk = context.emitCompare(tag.id, ok.id, 1, this.location(node))
    let success = context.function.createBlock()
    let failure = context.function.createBlock()

    context.conditional(isOk.id, success, irEmptyInts(), failure, irEmptyInts(), this.location(node))
    context.setCurrent(failure)
    let error = context.emitSymbol(39, irType(this.resultErrorType(resultName)), [acquired.id], irSymbol(this.module.id, 2, resultName + ".$alternative1_0"), this.location(node))

    this.emitResultAcquisitionFailure(context, node, error)
    context.setCurrent(success)
    let value = context.emitSymbol(39, irType(this.bound.typeAt(node)), [acquired.id], irSymbol(this.module.id, 2, resultName + ".$alternative0_0"), this.location(node))

    context.enterScope(this.treeScopeLocation(node))
    context.addVariable(this.bound.symbolAt(node), 6, semanticField(this.bound.dataAt(node), 0), irType(this.bound.typeAt(node)), value.id, false, this.location(node))
    context.pushResourceCleanup(value.id, this.bound.typeAt(node), this.bound.symbolAt(node))
    var index = 1

    while index < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, index))
      index = index + 1
    end
    if !context.terminated
      this.emitScopeCleanups(context, context.cleanupDepth - 1)
    end
    context.popCleanup()
    context.leaveScope()
  end

  def resultErrorType(resultName: String): String
    let result = this.semantic.findClass(resultName)

    if result != null && result.genericArguments.Length > 1
      return result.genericArguments[1]
    end
    return "Error"
  end

  def emitResultAcquisitionFailure(context: IrFunctionContext, node: Int, error: IrValue): Void
    let outcomeName = semanticMutableType(irTypeInner(context.function.resultType))
    let outcome = this.semantic.findClass(outcomeName)
    let completionField = this.findField(outcomeName + ".completion")

    if outcome == null || completionField == null
      context.returnValue(-1, this.location(node))
      return
    end
    let completionName = completionField.typeName
    let completion = context.emitSymbol(38, irType(completionName), irEmptyInts(), irSymbol(this.module.id, 1, completionName), this.location(node))
    let tag = context.emitConstant("int", 3, "1", this.location(node))

    context.emitSymbol(40, "void", [completion.id, tag.id], irSymbol(this.module.id, 2, completionName + ".$alternativeTag"), this.location(node))
    let errorOptional = context.emitValue(22, "optional|" + error.typeName, [error.id], this.location(node))

    context.emitSymbol(40, "void", [completion.id, errorOptional.id], irSymbol(this.module.id, 2, completionName + ".$alternative1_0"), this.location(node))
    let collector = this.ensureCloseFailures(context)

    this.emitScopeCleanups(context, 0)
    let wrapped = context.emitSymbol(38, context.function.resultType, irEmptyInts(), irSymbol(this.module.id, 1, outcomeName), this.location(node))
    let initializer = this.findCallable(outcomeName + ".init")

    if initializer != null
      context.emitSymbol(29, "void", [wrapped.id, completion.id, collector], irSymbol(this.module.id, 3, initializer.fullName), this.location(node))
    end
    context.returnValue(wrapped.id, this.location(node))
  end

  def lowerMatch(context: IrFunctionContext, node: Int): Void
    let scrutinee = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let incoming = context.snapshot()
    let carried = context.sortedMutableState()
    let merge = context.function.createBlock()
    let merged = context.addParameters(merge, carried, this.location(node))
    var test = context.current
    var branch = 1
    var anyOpen = false

    while branch < this.bound.childCountAt(node)
      context.restore(incoming)
      context.setCurrent(test)
      let caseNode = this.bound.childAt(node, branch)
      let caseIndex = semanticIntField(this.bound.dataAt(caseNode), 0)
      let owner = semanticMutableType(this.bound.typeAt(this.bound.childAt(node, 0)))
      let tag = context.emitSymbol(39, "int", [scrutinee.id], irSymbol(this.module.id, 2, owner + ".$alternativeTag"), this.location(caseNode))

      context.function.localEffects = context.function.localEffects.withRead()
      let expected = context.emitConstant("int", 3, caseIndex as String, this.location(caseNode))
      let equal = context.emitCompare(tag.id, expected.id, 1, this.location(caseNode))
      let body = context.function.createBlock()
      let next = context.function.createBlock()

      context.conditional(equal.id, body, irEmptyInts(), next, irEmptyInts(), this.location(caseNode))
      context.restore(incoming)
      context.setCurrent(body)
      context.enterScope(this.treeScopeLocation(caseNode))
      let bindingCount = semanticIntField(this.bound.dataAt(caseNode), 1)
      var binding = 0

      while binding < bindingCount
        let bindingNode = this.bound.childAt(caseNode, binding)
        let typeName = irType(this.bound.typeAt(bindingNode))
        let value = context.emitSymbol(39, typeName, [scrutinee.id], irSymbol(this.module.id, 2, owner + "." + this.bound.dataAt(bindingNode)), this.location(bindingNode))

        context.function.localEffects = context.function.localEffects.withRead()
        context.addVariable(this.bound.symbolAt(bindingNode), 6, this.bound.dataAt(bindingNode), typeName, value.id, false, this.location(bindingNode))
        binding = binding + 1
      end
      let bodyCount = semanticIntField(this.bound.dataAt(caseNode), 2)
      var statement = 0

      while statement < bodyCount && !context.terminated
        this.lowerStatement(context, this.bound.childAt(caseNode, bindingCount + statement))
        statement = statement + 1
      end
      context.leaveScope()
      if !context.terminated
        context.branch(merge, this.currentArguments(carried), this.location(caseNode))
        anyOpen = true
      end
      test = next
      branch = branch + 1
    end
    context.setCurrent(test)
    let trap = new IrTerminator(4, this.location(node))

    trap.debugScopeId = context.debugScopeId
    trap.panicCode = "NRP008"
    trap.panicMessage = "Invalid closed alternative tag"
    context.current.terminator = trap
    context.function.localEffects = context.function.localEffects.withMayPanic()
    if !anyOpen
      let unused = new IrTerminator(4, this.location(node))

      unused.debugScopeId = context.debugScopeId
      unused.panicCode = "NRP008"
      unused.panicMessage = "Unreachable match continuation"
      merge.terminator = unused
      context.terminated = true
      return
    end
    context.restore(incoming)
    this.applyState(context, merged)
    context.setCurrent(merge)
  end

  def lowerAssignment(context: IrFunctionContext, node: Int): Void
    if this.bound.dataAt(node) != ""
      let variable = context.findVariableIdentity(this.bound.symbolAt(node), this.bound.dataAt(node))
      let value = this.lowerExpression(context, this.bound.childAt(node, 0), irType(this.bound.typeAt(node)))

      if variable != null
        if variable.addressedPointer >= 0
          let operands: Int[] = [this.currentUnsafe(context), variable.addressedPointer, value.id]

          context.emitTyped(45, "void", operands, variable.typeName, this.location(node))
          context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withUnsafe())
        else
          variable.value = value.id
          if variable.declarationLocation.present
            context.function.addDebugLocal(new IrDebugLocal(variable.name, value.id, variable.declarationLocation, variable.debugScopeId))
          end
        end
      end
      return
    end
    if this.bound.childCountAt(node) == 2 && this.bound.kindAt(this.bound.childAt(node, 0)) == "Member"
      let targetNode = this.bound.childAt(node, 0)
      let field = this.findField(this.bound.dataAt(targetNode))
      var receiverType = ""

      if field != null
        receiverType = "class|" + field.owner
      end
      let receiver = this.lowerExpression(context, this.bound.childAt(targetNode, 0), receiverType)
      let value = this.lowerExpression(context, this.bound.childAt(node, 1), irType(this.bound.typeAt(node)))
      let operands: Int[] = [receiver.id, value.id]

      context.emitSymbol(40, "void", operands, irSymbol(this.module.id, 2, this.bound.dataAt(targetNode)), this.location(node))
      context.function.localEffects = context.function.localEffects.withWrite()
    else if this.bound.childCountAt(node) == 2
      let targetNode = this.bound.childAt(node, 0)
      let targetKind = this.bound.kindAt(targetNode)

      if targetKind == "NativeField" || targetKind == "NativeIndex"
        let pointer = irNativeStorageAddress(this, context, targetNode)
        let value = this.lowerExpression(context, this.bound.childAt(node, 1), irType(this.bound.typeAt(node)))

        context.emitTyped(45, "void", [this.currentUnsafe(context), pointer.id, value.id], value.typeName, this.location(node))
        context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withUnsafe())
      else if targetKind == "Unary" && this.bound.dataAt(targetNode) == "*"
        let pointer = this.lowerExpression(context, this.bound.childAt(targetNode, 0), "")
        let value = this.lowerExpression(context, this.bound.childAt(node, 1), irType(this.bound.typeAt(node)))
        let operands: Int[] = [this.currentUnsafe(context), pointer.id, value.id]

        context.emitTyped(45, "void", operands, irType(this.bound.typeAt(node)), this.location(node))
        context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withUnsafe())
      else if targetKind == "Index"
        let collectionNode = this.bound.childAt(targetNode, 0)
        let collection = this.lowerExpression(context, collectionNode, "")
        let index = this.lowerExpression(context, this.bound.childAt(targetNode, 1), "int")

        if irIsPointer(collection.typeName)
          let offsetOperands: Int[] = [this.currentUnsafe(context), collection.id, index.id]
          let pointer = context.emitTyped(46, collection.typeName, offsetOperands, irTypeInner(collection.typeName), irNoLocation())
          let value = this.lowerExpression(context, this.bound.childAt(node, 1), irType(this.bound.typeAt(node)))
          let storeOperands: Int[] = [this.currentUnsafe(context), pointer.id, value.id]

          context.emitTyped(45, "void", storeOperands, irTypeInner(collection.typeName), this.location(node))
          context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withUnsafe())
        else
          let value = this.lowerExpression(context, this.bound.childAt(node, 1), irType(this.bound.typeAt(node)))
          let storeOperands: Int[] = [collection.id, index.id, value.id]

          context.emitValue(37, "void", storeOperands, this.location(node))
          context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withMayPanic())
        end
      end
    end
  end

  def lowerExpression(context: IrFunctionContext, node: Int, expectedType: String): IrValue
    let value = this.lowerRawExpression(context, node, expectedType)

    return this.coerce(context, value, expectedType, node)
  end

  def lowerRawExpression(context: IrFunctionContext, node: Int, expectedType: String): IrValue
    let kind = this.bound.kindAt(node)
    let typeName = irType(this.bound.typeAt(node))
    let location = this.location(node)

    if kind == "NativeField" || kind == "NativeIndex"
      let pointer = irNativeStorageAddress(this, context, node)

      context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withUnsafe())
      return context.emitTyped(44, typeName, [this.currentUnsafe(context), pointer.id], typeName, location)
    else if kind == "Closure"
      return this.lowerClosure(context, node)
    else if kind == "Quotation"
      return this.lowerQuotation(context, node)
    else if kind == "IntLiteral"
      return context.emitConstant("int", 3, host.stringSlice(this.bound.valueAt(node), 2, host.stringByteLength(this.bound.valueAt(node)) - 2), location)
    else if kind == "FloatLiteral"
      let literal = host.stringSlice(this.bound.valueAt(node), 2, host.stringByteLength(this.bound.valueAt(node)) - 2)

      return context.emitConstant("float", 4, "0x" + irFloatBitsText(literal), location)
    else if kind == "BoolLiteral"
      return context.emitConstant("bool", 1, host.stringSlice(this.bound.valueAt(node), 2, host.stringByteLength(this.bound.valueAt(node)) - 2), location)
    else if kind == "StringLiteral"
      return this.lowerString(context, node)
    else if kind == "NullLiteral"
      var resultType = expectedType

      if resultType == ""
        resultType = typeName
      end
      return context.emit(1, resultType, irEmptyInts(), irEmptyStrings(), null, 5, "", 0, false, location)
    else if kind == "Name" || kind == "Transfer"
      let variable = context.findVariableIdentity(this.bound.symbolAt(node), this.bound.dataAt(node))

      if variable != null
        if kind == "Transfer"
          context.releaseResourceCleanup(variable.identity)
        end
        if variable.addressedPointer >= 0
          let operands: Int[] = [this.currentUnsafe(context), variable.addressedPointer]

          context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withUnsafe())
          return context.emitTyped(44, variable.typeName, operands, variable.typeName, location)
        end
        if variable.typeName == typeName
          return new IrValue(variable.value, typeName)
        end
        if irIsOptional(variable.typeName) && irTypeInner(variable.typeName) == typeName
          let operands: Int[] = [variable.value]

          context.function.localEffects = context.function.localEffects.withMayPanic()
          return context.emitValue(24, typeName, operands, location)
        end
        return new IrValue(variable.value, variable.typeName)
      end
    else if kind == "This"
      if context.thisOverride >= 0
        return new IrValue(context.thisOverride, context.thisOverrideType)
      end
      let receiver = context.findVariable("this")

      if receiver != null
        return new IrValue(receiver.value, receiver.typeName)
      end
    else if kind == "Unary"
      return this.lowerUnary(context, node)
    else if kind == "Binary"
      return this.lowerBinary(context, node)
    else if kind == "Ternary"
      return this.lowerTernary(context, node)
    else if kind == "Cast"
      return this.lowerCast(context, node)
    else if kind == "ArrayLiteral"
      return this.lowerArray(context, node)
    else if kind == "Index"
      return this.lowerIndex(context, node)
    else if kind == "Member"
      let field = this.findField(this.bound.dataAt(node))
      var receiverType = ""

      if field != null
        receiverType = "class|" + field.owner
      end
      let receiver = this.lowerExpression(context, this.bound.childAt(node, 0), receiverType)
      let operands: Int[] = [receiver.id]

      context.function.localEffects = context.function.localEffects.withRead()
      if field != null && semanticIsOptional(field.typeName) && semanticInnerType(field.typeName) == this.bound.typeAt(node)
        let value = context.emitSymbol(39, irType(field.typeName), operands, irSymbol(this.module.id, 2, this.bound.dataAt(node)), location)

        context.function.localEffects = context.function.localEffects.withMayPanic()
        return context.emitValue(24, typeName, [value.id], location)
      end
      return context.emitSymbol(39, typeName, operands, irSymbol(this.module.id, 2, this.bound.dataAt(node)), location)
    else if kind == "IntrinsicMember"
      return this.lowerIntrinsicMember(context, node)
    else if kind == "Call"
      return this.lowerCall(context, node)
    else if kind == "TaskGenerate"
      return irLowerTaskGenerate(this, context, node)
    else if kind == "InstanceCall"
      return this.lowerInstanceCall(context, node)
    else if kind == "New"
      return this.lowerNew(context, node)
    else if kind == "AlternativeConstruct"
      return this.lowerAlternativeConstruct(context, node)
    else if kind == "StackAlloc"
      return this.lowerStackAlloc(context, node)
    else if kind == "NativeIntrinsic"
      return this.lowerNative(context, node)
    end
    return new IrValue(-1, typeName)
  end

  def coerce(context: IrFunctionContext, value: IrValue, expectedType: String, node: Int): IrValue
    if expectedType == "" || value.typeName == expectedType
      return value
    end
    let operands: Int[] = [value.id]

    if irIsOptional(expectedType) && irTypeInner(expectedType) == value.typeName
      return context.emitValue(22, expectedType, operands, this.location(node))
    end
    # A derived object may satisfy an optional base-class parameter. Upcast the
    # present value first, then construct the optional representation so the
    # call operand has the exact ABI type the verifier requires.
    if irIsOptional(expectedType) && irTypeKind(irTypeInner(expectedType)) == "class" && irTypeKind(value.typeName) == "class"
      var present = value

      if present.typeName != irTypeInner(expectedType)
        present = context.emitValue(20, irTypeInner(expectedType), [present.id], this.location(node))
      end
      return context.emitValue(22, expectedType, [present.id], this.location(node))
    end
    if irTypeKind(value.typeName) == "class" && irTypeKind(expectedType) == "class"
      return context.emitValue(20, expectedType, operands, this.location(node))
    end
    return value
  end

  def lowerUnary(context: IrFunctionContext, node: Int): IrValue
    let operation = this.bound.dataAt(node)

    if operation == "&"
      return this.lowerAddressOf(context, node)
    end
    let operand = this.lowerExpression(context, this.bound.childAt(node, 0), "")

    if operation == "*"
      let operands: Int[] = [this.currentUnsafe(context), operand.id]

      context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withUnsafe())
      return context.emitTyped(44, irType(this.bound.typeAt(node)), operands, irType(this.bound.typeAt(node)), this.location(node))
    end
    if operation == "+"
      return operand
    end
    var opcode = 12

    if operation == "-" && irIsInteger(operand.typeName)
      opcode = 2
    end
    if operation == "-" && irIsFloat(operand.typeName)
      opcode = 7
    end
    let operands: Int[] = [operand.id]

    if opcode == 2
      context.function.localEffects = context.function.localEffects.withMayPanic()
    end
    return context.emitValue(opcode, irType(this.bound.typeAt(node)), operands, this.location(node))
  end

  def lowerBinary(context: IrFunctionContext, node: Int): IrValue
    let operation = this.bound.dataAt(node)

    if operation == "&&" || operation == "||"
      return this.lowerShortCircuit(context, node, operation == "||")
    end
    let leftNode = this.bound.childAt(node, 0)
    let rightNode = this.bound.childAt(node, 1)
    var leftExpected = ""
    var rightExpected = ""

    if this.bound.kindAt(leftNode) == "NullLiteral"
      leftExpected = irType(this.bound.typeAt(rightNode))
    end
    if this.bound.kindAt(rightNode) == "NullLiteral"
      rightExpected = irType(this.bound.typeAt(leftNode))
    end
    if semanticIsOptional(this.bound.typeAt(leftNode)) && this.bound.typeAt(rightNode) == semanticInnerType(this.bound.typeAt(leftNode))
      rightExpected = irType(this.bound.typeAt(leftNode))
    end
    if semanticIsOptional(this.bound.typeAt(rightNode)) && this.bound.typeAt(leftNode) == semanticInnerType(this.bound.typeAt(rightNode))
      leftExpected = irType(this.bound.typeAt(rightNode))
    end
    let left = this.lowerExpression(context, leftNode, leftExpected)
    let right = this.lowerExpression(context, rightNode, rightExpected)
    let operands: Int[] = [left.id, right.id]

    if irIsPointer(left.typeName)
      if operation == "+" || (operation == "-" && !irIsPointer(right.typeName))
        var offset = right

        if operation == "-"
          let negateOperands: Int[] = [right.id]

          offset = context.emitValue(2, "int", negateOperands, this.location(node))
          context.function.localEffects = context.function.localEffects.withMayPanic()
        end
        let pointerOperands: Int[] = [this.currentUnsafe(context), left.id, offset.id]

        context.function.localEffects = context.function.localEffects.withUnsafe()
        return context.emitTyped(46, left.typeName, pointerOperands, irTypeInner(left.typeName), this.location(node))
      end
      let opcode = operation == "-" && irIsPointer(right.typeName) ? 47 : 48
      var predicate = 0

      if operation == "=="
        predicate = 1
      end
      if operation == "!="
        predicate = 2
      end
      if operation == "<"
        predicate = 3
      end
      if operation == "<="
        predicate = 4
      end
      if operation == ">"
        predicate = 5
      end
      if operation == ">="
        predicate = 6
      end
      let pointerOperands: Int[] = [this.currentUnsafe(context), left.id, right.id]

      context.function.localEffects = context.function.localEffects.withUnsafe()
      return context.emit(opcode, opcode == 47 ? "int" : "bool", pointerOperands, [irTypeInner(left.typeName)], null, 0, "", predicate, false, this.location(node))
    end
    if operation == "==" || operation == "!=" || operation == "<" || operation == "<=" || operation == ">" || operation == ">="
      var predicate = 1

      if operation == "!="
        predicate = 2
      end
      if operation == "<"
        predicate = 3
      end
      if operation == "<="
        predicate = 4
      end
      if operation == ">"
        predicate = 5
      end
      if operation == ">="
        predicate = 6
      end
      if left.typeName == "string"
        context.function.localEffects = context.function.localEffects.withRead()
        return context.emitValue(operation == "==" ? 26 : 27, "bool", operands, this.location(node))
      end
      if irIsManaged(left.typeName) || irIsOptional(left.typeName)
        context.function.localEffects = context.function.localEffects.withRead()
      end
      return context.emitCompare(left.id, right.id, predicate, this.location(node))
    end
    var opcode = 3

    if irIsInteger(left.typeName)
      if operation == "+"
        opcode = 3
      end
      if operation == "-"
        opcode = 4
      end
      if operation == "*"
        opcode = 5
      end
      if operation == "/"
        opcode = 6
      end
      context.function.localEffects = context.function.localEffects.withMayPanic()
    else if irIsFloat(left.typeName)
      if operation == "+"
        opcode = 8
      end
      if operation == "-"
        opcode = 9
      end
      if operation == "*"
        opcode = 10
      end
      if operation == "/"
        opcode = 11
      end
    else if left.typeName == "string"
      opcode = 25
      context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    end
    return context.emitValue(opcode, irType(this.bound.typeAt(node)), operands, this.location(node))
  end

  def lowerCast(context: IrFunctionContext, node: Int): IrValue
    let value = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let target = irType(this.bound.typeAt(node))

    if value.typeName == target
      return value
    end
    if irIsExtendedScalar(value.typeName) || irIsExtendedScalar(target)
      context.function.localEffects = context.function.localEffects.withMayPanic()
      return context.emitValue(58, target, [value.id], this.location(node))
    end
    var opcode = 16

    if value.typeName == "float" && target == "int"
      opcode = 17
    end
    if value.typeName == "int" && target == "byte"
      opcode = 18
    end
    if value.typeName == "byte" && target == "int"
      opcode = 19
    end
    if value.typeName == "int" && target == "string"
      opcode = 55
    end
    if value.typeName == "byte" && target == "string"
      opcode = 56
    end
    if value.typeName == "float" && target == "string"
      opcode = 57
    end
    if irTypeKind(value.typeName) == "class" && irTypeKind(target) == "class"
      opcode = 20
    end
    if irIsPointer(value.typeName) && irIsPointer(target)
      let operands: Int[] = [this.currentUnsafe(context), value.id]
      let types: String[] = [irTypeInner(value.typeName), irTypeInner(target)]

      context.function.localEffects = context.function.localEffects.withUnsafe()
      return context.emit(49, target, operands, types, null, 0, "", 0, false, this.location(node))
    end
    let operands: Int[] = [value.id]

    if opcode == 17 || opcode == 18
      context.function.localEffects = context.function.localEffects.withMayPanic()
    end
    if opcode >= 55 && opcode <= 57
      context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
      this.module.requireFeature("native-strings-v1")
    end
    return context.emitValue(opcode, target, operands, this.location(node))
  end

  def lowerArray(context: IrFunctionContext, node: Int): IrValue
    var operands: Int[] = []
    var index = 0

    while index < this.bound.childCountAt(node)
      let value = this.lowerExpression(context, this.bound.childAt(node, index), irTypeInner(irType(this.bound.typeAt(node))))

      operands = host.appendInt(operands, value.id)
      index = index + 1
    end
    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    return context.emitTyped(34, irType(this.bound.typeAt(node)), operands, irTypeInner(irType(this.bound.typeAt(node))), this.location(node))
  end

  def lowerIndex(context: IrFunctionContext, node: Int): IrValue
    let collection = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let index = this.lowerExpression(context, this.bound.childAt(node, 1), "int")

    if irIsPointer(collection.typeName)
      let offsetOperands: Int[] = [this.currentUnsafe(context), collection.id, index.id]
      let pointer = context.emitTyped(46, collection.typeName, offsetOperands, irTypeInner(collection.typeName), this.location(node))
      let loadOperands: Int[] = [this.currentUnsafe(context), pointer.id]

      context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withUnsafe())
      return context.emitTyped(44, irType(this.bound.typeAt(node)), loadOperands, irTypeInner(collection.typeName), this.location(node))
    end
    let operands: Int[] = [collection.id, index.id]

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withMayPanic())
    return context.emitValue(36, irType(this.bound.typeAt(node)), operands, this.location(node))
  end

  def lowerAddressOf(context: IrFunctionContext, node: Int): IrValue
    let nameNode = this.bound.childAt(node, 0)

    if this.bound.kindAt(nameNode) == "NativeField" || this.bound.kindAt(nameNode) == "NativeIndex"
      return irNativeStorageAddress(this, context, nameNode)
    end
    let variable = context.findVariableIdentity(this.bound.symbolAt(nameNode), this.bound.dataAt(nameNode))

    if variable == null
      return new IrValue(-1, irType(this.bound.typeAt(node)))
    end
    if variable.addressedPointer >= 0
      return new IrValue(variable.addressedPointer, "pointer|" + variable.typeName)
    end
    let one = context.emitConstant("int", 3, "1", this.location(node))
    let allocationOperands: Int[] = [this.currentUnsafe(context), one.id]
    let pointer = context.emitTyped(43, "pointer|" + variable.typeName, allocationOperands, variable.typeName, this.location(node))
    let storeOperands: Int[] = [this.currentUnsafe(context), pointer.id, variable.value]

    context.emitTyped(45, "void", storeOperands, variable.typeName, this.location(node))
    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withMayPanic().withUnsafe())
    variable.addressedPointer = pointer.id
    variable.addressedDepth = context.unsafeDepth
    return pointer
  end

  def lowerStackAlloc(context: IrFunctionContext, node: Int): IrValue
    let count = this.lowerExpression(context, this.bound.childAt(node, 0), "int")
    let operands: Int[] = [this.currentUnsafe(context), count.id]

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withUnsafe())
    return context.emitTyped(43, irType(this.bound.typeAt(node)), operands, irTypeInner(irType(this.bound.typeAt(node))), this.location(node))
  end

  def lowerNative(context: IrFunctionContext, node: Int): IrValue
    var operands: Int[] = [this.currentUnsafe(context)]
    var index = 0

    while index < this.bound.childCountAt(node)
      let value = this.lowerExpression(context, this.bound.childAt(node, index), "")

      operands = host.appendInt(operands, value.id)
      index = index + 1
    end
    let operation = this.bound.dataAt(node)
    let resultType = irType(this.bound.typeAt(node))
    var elementType = irTypeInner(resultType)

    if elementType == "" && this.bound.childCountAt(node) > 0
      elementType = irTypeInner(irType(this.bound.typeAt(this.bound.childAt(node, 0))))
    end
    var opcode = 50

    if operation == "realloc"
      opcode = 51
    end
    if operation == "free"
      opcode = 52
    end
    context.function.localEffects = context.function.localEffects.mergedWith(opcode == 52 ? new EffectSet().withUnsafe() : new EffectSet().withMayPanic().withNativeAllocate().withUnsafe())
    let types: String[] = [elementType]

    return context.emit(opcode, resultType, operands, types, null, 0, "", 0, operation == "calloc", this.location(node))
  end

  def argumentParameter(argument: Int, sourceIndex: Int): Int
    if this.bound.kindAt(argument) == "Argument"
      let index = host.parseInt(this.bound.dataAt(argument))

      if index != null
        return index
      end
    end
    return sourceIndex
  end

  def argumentExpression(argument: Int): Int
    return this.bound.kindAt(argument) == "Argument" ? this.bound.childAt(argument, 0) : argument
  end

  # Evaluation follows source order; only the already evaluated SSA values move.
  def lowerArguments(context: IrFunctionContext, node: Int, start: Int, callable: SemanticCallable?): Int[]
    var values: Int[] = []
    var parameters: Int[] = []
    var fieldEntries: Int[] = []
    var index = start
    var largest = -1
    var reordered = false

    while index < this.bound.childCountAt(node)
      let argument = this.bound.childAt(node, index)

      if this.bound.kindAt(argument) == "FieldPackArgument"
        let entry = this.lowerExpression(context, this.bound.childAt(argument, 0), "class|fields.Entry")

        fieldEntries = host.appendInt(fieldEntries, entry.id)
        index = index + 1
        continue
      end
      let slot = this.argumentParameter(argument, values.Length)
      var expected = ""

      if callable != null
        let parameter = callable.parameterAt(slot)

        if parameter != null
          expected = irType(parameter.typeName)
        end
      end
      let expression = this.argumentExpression(argument)
      let value = this.bound.kindAt(expression) == "FieldPack" ? this.lowerFieldPack(context, expression, fieldEntries) : this.lowerExpression(context, expression, expected)

      values = host.appendInt(values, value.id)
      parameters = host.appendInt(parameters, slot)
      reordered = true if slot != values.Length - 1
      largest = slot if slot > largest
      index = index + 1
    end
    if !reordered
      return values
    end
    var ordered: Int[] = []
    var slot = 0

    while slot <= largest
      index = 0
      while index < parameters.Length
        ordered = host.appendInt(ordered, values[index]) if parameters[index] == slot
        index = index + 1
      end
      slot = slot + 1
    end
    return ordered
  end

  def lowerConstructedValue(context: IrFunctionContext, className: String, arguments: Int[], node: Int): IrValue
    let constructor = this.findCallable(className + ".init")

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    let receiver = context.emitSymbol(38, "class|" + className, irEmptyInts(), irSymbol(this.module.id, 1, className), this.location(node))

    if constructor != null
      var operands: Int[] = [receiver.id]

      for argument in arguments operands = host.appendInt(operands, argument) end
      context.emitSymbol(29, "void", operands, irSymbol(this.module.id, 3, constructor.fullName), this.location(node))
      context.function.addCallee(constructor.fullName)
    end
    return receiver
  end

  def lowerStringValue(context: IrFunctionContext, value: String, node: Int): IrValue
    let name = "literal.string.sha256." + sha256Text(value)
    let symbol = irSymbol(this.module.id, 9, name)

    if !this.hasGlobal(name)
      this.module.addGlobal(new IrGlobal(symbol, value, irNoLocation()))
    end
    this.module.requireFeature("native-strings-v1")
    this.module.requireFeature("string-data-v1")
    return context.emit(1, "string", irEmptyInts(), irEmptyStrings(), null, 7, name, 0, false, this.location(node))
  end

  def lowerFieldPack(context: IrFunctionContext, node: Int, entries: Int[]): IrValue
    let wrapperName = this.bound.dataAt(node)
    let wrapper = this.semantic.findClass(wrapperName)
    var entityType = ""

    if wrapper != null
      entityType = wrapper.fieldPackEntityType
    end
    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    let entryArray = context.emitTyped(34, "array|class|fields.Entry", entries, "class|fields.Entry", this.location(node))
    let entity = this.lowerStringValue(context, entityType, node)
    let pack = this.lowerConstructedValue(context, "fields.Pack", [entryArray.id, entity.id], node)
    let stored = this.lowerConstructedValue(context, wrapperName, [], node)

    context.emitSymbol(40, "void", [stored.id, pack.id], irSymbol(this.module.id, 2, wrapperName + ".storedPack"), this.location(node))
    return stored
  end

  def lowerCall(context: IrFunctionContext, node: Int): IrValue
    let target = this.bound.dataAt(node)

    var callable = this.findCallable(this.bound.symbolAt(node))

    if callable == null
      callable = this.findCallable(target)
    end
    var resolvedCallable = callable

    if resolvedCallable == null
      resolvedCallable = this.findCAbiCallable(target)
    end
    if resolvedCallable != null && resolvedCallable.cAbiSymbol != ""
      if this.runtimeContract(resolvedCallable.cAbiSymbol) != null
        return this.lowerRuntimeCall(context, node, resolvedCallable.cAbiSymbol)
      end
      return this.lowerCAbiCall(context, node, resolvedCallable)
    end
    if resolvedCallable != null && resolvedCallable.intrinsicName != ""
      return this.lowerIntrinsicCall(context, node, resolvedCallable)
    end
    if resolvedCallable == null && this.runtimeContract(target) != null
      return this.lowerRuntimeCall(context, node, target)
    end
    let operands = this.lowerArguments(context, node, 0, callable)
    let symbolKind = callable != null && callable.className != "" && !this.representedClass(callable.className) ? 3 : 4
    var callTarget = target
    var callSymbolKind = symbolKind

    if callable != null && operands.Length < callable.parameterCount
      callTarget = this.requestDefaultAdapter(callable, operands.Length, false, node)
      callSymbolKind = 4
    end
    context.function.addCallee(callTarget)
    if callable != null && callable.isUnsafe
      var unsafeOperands: Int[] = [this.currentUnsafe(context)]

      for operand in operands
        unsafeOperands = host.appendInt(unsafeOperands, operand)
      end
      return context.emitSymbol(32, irType(this.bound.typeAt(node)), unsafeOperands, irSymbol(this.module.id, callSymbolKind, callTarget), this.location(node))
    end
    return context.emitSymbol(28, irType(this.bound.typeAt(node)), operands, irSymbol(this.module.id, callSymbolKind, callTarget), this.location(node))
  end

  def lowerInstanceCall(context: IrFunctionContext, node: Int): IrValue
    var operands: Int[] = []
    let callable = this.findCallable(this.bound.dataAt(node))
    let receiverNode = this.bound.childAt(node, 0)
    var receiver = this.lowerExpression(context, receiverNode, "")
    let dispatchType = receiver.typeName
    let receiverClass = this.semantic.findClass(irTypeInner(dispatchType))

    if this.checkParallel && receiverClass != null && receiverClass.isFunctionType && !receiverClass.isParallelFunction
      context.function.parallelUnsafe = true
    end
    let isDirect = this.bound.valueAt(node) == "direct"
    let represented = callable != null && this.representedClass(callable.className)
    let symbolKind = represented ? 4 : 3

    if callable != null && receiver.typeName != irType(callable.className)
      let upcastOperands: Int[] = [receiver.id]

      receiver = context.emitValue(20, irType(callable.className), upcastOperands, this.location(receiverNode))
    end
    operands = host.appendInt(operands, receiver.id)
    for value in this.lowerArguments(context, node, 1, callable)
      operands = host.appendInt(operands, value)
    end
    var opcode = 30
    var targetName = this.bound.dataAt(node)

    if callable != null && callable.name == "init"
      opcode = 29
    end
    if isDirect
      opcode = 29
    end
    if represented
      opcode = 28
    end
    if callable != null && callable.isUnsafe && receiverClass != null && receiverClass.isResource
      # Resource classes cannot be inherited, so this receiver has one concrete
      # target and can use the capability-carrying direct call form.
      opcode = 32
    end
    if callable != null && operands.Length - 1 < callable.parameterCount
      let adapterName = this.requestDefaultAdapter(callable, operands.Length - 1, opcode == 30, node)

      context.function.addCallee(adapterName)
      return context.emitSymbol(28, irType(this.bound.typeAt(node)), operands, irSymbol(this.module.id, 4, adapterName), this.location(node))
    end
    if callable != null && !represented && !callable.isStatic && callable.name != "init"
      let owner = this.semantic.findClass(callable.className)

      if owner != null
        targetName = this.dispatchSlot(owner, callable)
      end
    end
    if callable != null && callable.isUnsafe && opcode != 30
      var unsafeOperands: Int[] = [this.currentUnsafe(context)]

      for operand in operands
        unsafeOperands = host.appendInt(unsafeOperands, operand)
      end
      context.function.addCallee(this.bound.dataAt(node))
      return context.emitSymbol(32, irType(this.bound.typeAt(node)), unsafeOperands, irSymbol(this.module.id, symbolKind, targetName), this.location(node))
    end
    if opcode == 30
      operands = this.virtualOperands(context, operands, receiver.typeName, targetName)
      this.addVirtualCallees(context, targetName, dispatchType)
    else
      context.function.addCallee(this.bound.dataAt(node))
    end
    return context.emitSymbol(opcode, irType(this.bound.typeAt(node)), operands, irSymbol(this.module.id, symbolKind, targetName), this.location(node))
  end

  def lowerIntrinsicMember(context: IrFunctionContext, node: Int): IrValue
    let member = semanticIntrinsicMemberById(this.semantic, this.bound.dataAt(node))
    let typeName = irType(this.bound.typeAt(node))

    if member == null || this.bound.childCountAt(node) != 1
      return new IrValue(-1, typeName)
    end
    let receiver = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let operands: Int[] = [receiver.id]

    context.function.localEffects = context.function.localEffects.mergedWith(member.effects)
    return context.emitValue(member.opcode, typeName, operands, this.location(node))
  end

  def lowerClosure(context: IrFunctionContext, node: Int): IrValue
    return this.lowerStoredObject(context, node)
  end

  def lowerQuotation(context: IrFunctionContext, node: Int): IrValue
    return this.lowerStoredObject(context, node)
  end

  def lowerStoredObject(context: IrFunctionContext, node: Int): IrValue
    let name = this.bound.dataAt(node)
    let owner = this.semantic.findClass(name)
    var values: Int[] = []
    var index = 0

    while index < this.bound.childCountAt(node)
      let value = this.lowerExpression(context, this.bound.childAt(node, index), "")

      values = host.appendInt(values, value.id)
      index = index + 1
    end
    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withWrite().withMayPanic().withManagedAllocate().withSafepoint())
    let receiver = context.emitSymbol(38, "class|" + name, irEmptyInts(), irSymbol(this.module.id, 1, name), this.location(node))

    if owner != null
      var field = owner.firstField

      index = 0
      while field != null
        let operands: Int[] = [receiver.id, values[index]]

        context.emitSymbol(40, "void", operands, irSymbol(this.module.id, 2, name + "." + field.name), this.location(node))
        field = field.nextField
        index = index + 1
      end
    end
    if this.bound.typeAt(node) == name
      return receiver
    end
    return context.emitValue(20, irType(this.bound.typeAt(node)), [receiver.id], this.location(node))
  end

  def lowerNew(context: IrFunctionContext, node: Int): IrValue
    let className = this.bound.dataAt(node)
    let constructor = this.findCallable(className + ".init")
    let arguments = this.lowerArguments(context, node, 0, constructor)

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    let receiver = context.emitSymbol(38, irType(this.bound.typeAt(node)), irEmptyInts(), irSymbol(this.module.id, 1, className), this.location(node))

    if constructor != null
      var operands: Int[] = [receiver.id]

      for argument in arguments operands = host.appendInt(operands, argument) end
      if arguments.Length < constructor.parameterCount
        let adapterName = this.requestDefaultAdapter(constructor, arguments.Length, false, node)

        context.emitSymbol(28, "void", operands, irSymbol(this.module.id, 4, adapterName), this.location(node))
        context.function.addCallee(adapterName)
      else
        context.emitSymbol(29, "void", operands, irSymbol(this.module.id, 3, constructor.fullName), this.location(node))
        context.function.addCallee(constructor.fullName)
      end
    else
      let owner = this.semantic.findClass(className)

      if owner != null
        this.lowerConstructionDefaults(context, owner, receiver.id, this.location(node))
      end
    end
    return receiver
  end

  def lowerAlternativeConstruct(context: IrFunctionContext, node: Int): IrValue
    let className = semanticField(this.bound.dataAt(node), 0)
    let caseIndex = semanticIntField(this.bound.dataAt(node), 1)
    let receiver = context.emitSymbol(38, irType(this.bound.typeAt(node)), irEmptyInts(), irSymbol(this.module.id, 1, className), this.location(node))

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withMayPanic().withManagedAllocate().withSafepoint())
    let tag = context.emitConstant("int", 3, caseIndex as String, this.location(node))

    context.emitSymbol(40, "void", [receiver.id, tag.id], irSymbol(this.module.id, 2, className + ".$alternativeTag"), this.location(node))
    var index = 0

    while index < this.bound.childCountAt(node)
      let expected = irType(this.alternativePayloadType(className, caseIndex, index))
      let value = this.lowerExpression(context, this.bound.childAt(node, index), expected)

      context.emitSymbol(40, "void", [receiver.id, value.id], irSymbol(this.module.id, 2, className + "." + alternativePayloadField(caseIndex, index)), this.location(node))
      index = index + 1
    end
    context.function.localEffects = context.function.localEffects.withWrite()
    return receiver
  end

  def alternativePayloadType(className: String, caseIndex: Int, payloadIndex: Int): String
    let symbol = this.semantic.findClass(className)

    if symbol != null
      let name = alternativePayloadField(caseIndex, payloadIndex)
      var field = symbol.firstField

      while field != null
        if field.name == name
          return field.typeName
        end
        field = field.nextField
      end
    end
    return this.bound.typeAt(0)
  end

  def lowerString(context: IrFunctionContext, node: Int): IrValue
    let encoded = this.bound.valueAt(node)
    let value = host.stringSlice(encoded, 2, host.stringByteLength(encoded) - 2)
    let name = "literal.string.sha256." + sha256Text(value)
    let symbol = irSymbol(this.module.id, 9, name)

    if !this.hasGlobal(name)
      this.module.addGlobal(new IrGlobal(symbol, value, irNoLocation()))
    end
    this.module.requireFeature("native-strings-v1")
    this.module.requireFeature("string-data-v1")
    return context.emit(1, "string", irEmptyInts(), irEmptyStrings(), null, 7, name, 0, false, this.location(node))
  end

  def hasGlobal(name: String): Bool
    var current = this.module.firstGlobal

    while current != null
      if current.symbol.name == name
        return true
      end
      current = current.nextGlobal
    end
    return false
  end

  def lowerShortCircuit(context: IrFunctionContext, node: Int, shortValue: Bool): IrValue
    let left = this.lowerExpression(context, this.bound.childAt(node, 0), "bool")
    var rightBlock = context.function.createBlock()
    var shortBlock = context.function.createBlock()

    if shortValue
      let swap = rightBlock

      rightBlock = shortBlock
      shortBlock = swap
    end
    let merge = context.function.createBlock()
    let result = context.function.allocateValue()

    merge.addParameter(new IrParameter(result, "bool", this.location(node)))
    if shortValue
      context.conditional(left.id, shortBlock, irEmptyInts(), rightBlock, irEmptyInts(), this.location(node))
    else
      context.conditional(left.id, rightBlock, irEmptyInts(), shortBlock, irEmptyInts(), this.location(node))
    end
    context.setCurrent(rightBlock)
    let right = this.lowerExpression(context, this.bound.childAt(node, 1), "bool")
    let rightArguments: Int[] = [right.id]

    context.branch(merge, rightArguments, this.location(node))
    context.setCurrent(shortBlock)
    let constant = context.emitConstant("bool", 1, shortValue ? "true" : "false", this.location(node))
    let shortArguments: Int[] = [constant.id]

    context.branch(merge, shortArguments, this.location(node))
    context.setCurrent(merge)
    return new IrValue(result, "bool")
  end

  def lowerTernary(context: IrFunctionContext, node: Int): IrValue
    let condition = this.lowerExpression(context, this.bound.childAt(node, 0), "bool")
    let baseline = context.snapshot()
    let thenBlock = context.function.createBlock()
    let elseBlock = context.function.createBlock()
    let merge = context.function.createBlock()
    let resultType = irType(this.bound.typeAt(node))
    let result = context.function.allocateValue()

    merge.addParameter(new IrParameter(result, resultType, this.location(node)))
    context.conditional(condition.id, thenBlock, irEmptyInts(), elseBlock, irEmptyInts(), this.location(node))
    context.restore(baseline)
    context.setCurrent(thenBlock)
    let whenTrue = this.lowerExpression(context, this.bound.childAt(node, 1), resultType)
    let trueArguments: Int[] = [whenTrue.id]

    context.branch(merge, trueArguments, this.location(node))
    context.restore(baseline)
    context.setCurrent(elseBlock)
    let whenFalse = this.lowerExpression(context, this.bound.childAt(node, 2), resultType)
    let falseArguments: Int[] = [whenFalse.id]

    context.branch(merge, falseArguments, this.location(node))
    context.restore(baseline)
    context.setCurrent(merge)
    return new IrValue(result, resultType)
  end

  def lowerIf(context: IrFunctionContext, node: Int): Void
    let conditionNode = this.bound.childAt(node, 0)
    let condition = this.lowerExpression(context, conditionNode, "bool")
    let incoming = context.snapshot()
    let mutableValues = context.sortedMutableState()
    let thenCount = semanticIntField(this.bound.dataAt(node), 0)
    let elseCount = semanticIntField(this.bound.dataAt(node), 1)
    let thenBlock = context.function.createBlock()
    let elseBlock = context.function.createBlock()

    context.conditional(condition.id, thenBlock, irEmptyInts(), elseBlock, irEmptyInts(), this.location(node))
    context.restore(incoming)
    context.setCurrent(thenBlock)
    context.enterScope(this.childScopeLocation(node, 1, thenCount))
    var index = 0

    while index < thenCount && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, 1 + index))
      index = index + 1
    end
    context.leaveScope()
    let thenPath = new IrPath(context.current, context.snapshot(), context.terminated)

    context.restore(incoming)
    context.setCurrent(elseBlock)
    context.enterScope(this.childScopeLocation(node, 1 + thenCount, elseCount))
    index = 0
    while index < elseCount && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, 1 + thenCount + index))
      index = index + 1
    end
    context.leaveScope()
    let elsePath = new IrPath(context.current, context.snapshot(), context.terminated)

    if thenPath.terminated && elsePath.terminated
      context.terminated = true
      return
    end
    if thenPath.terminated
      context.restore(elsePath.state)
      context.setCurrent(elsePath.block)
      return
    end
    if elsePath.terminated
      context.restore(thenPath.state)
      context.setCurrent(thenPath.block)
      return
    end
    let merge = context.function.createBlock()
    let changed = this.changedVariables(mutableValues, thenPath.state, elsePath.state)
    let merged = context.addParameters(merge, changed, this.location(node))

    context.current = thenPath.block
    context.branch(merge, this.stateArguments(thenPath.state, changed), this.location(node))
    context.current = elsePath.block
    context.branch(merge, this.stateArguments(elsePath.state, changed), this.location(node))
    context.restore(incoming)
    this.applyState(context, merged)
    context.setCurrent(merge)
  end

  def lowerWhile(context: IrFunctionContext, node: Int): Void
    let incoming = context.snapshot()
    let carried = context.sortedMutableState()
    let header = context.function.createBlock()
    let body = context.function.createBlock()
    let exit = context.function.createBlock()
    let headerValues = context.addParameters(header, carried, this.location(node))
    let exitValues = context.addParameters(exit, carried, this.location(node))

    context.branch(header, this.stateArguments(incoming, carried), this.location(node))
    context.restore(incoming)
    this.applyState(context, headerValues)
    context.setCurrent(header)
    let condition = this.lowerExpression(context, this.bound.childAt(node, 0), "bool")

    context.conditional(condition.id, body, irEmptyInts(), exit, this.currentArguments(carried), this.location(node))
    context.setCurrent(body)
    context.enterScope(this.childScopeLocation(node, 1, this.bound.childCountAt(node) - 1))
    let previousLoop = context.loop

    context.loop = new IrLoopFrame(header, exit, carried, -1, this.location(node), context.cleanupDepth, previousLoop)
    var index = 1

    while index < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, index))
      index = index + 1
    end
    if !context.terminated
      context.branch(header, this.currentArguments(carried), this.location(node))
    end
    context.loop = previousLoop
    context.leaveScope()
    context.restore(incoming)
    this.applyState(context, exitValues)
    context.setCurrent(exit)
  end

  def lowerFor(context: IrFunctionContext, node: Int): Void
    let collection = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let collectionOperands: Int[] = [collection.id]

    context.function.localEffects = context.function.localEffects.withRead()
    let length = context.emitValue(35, "int", collectionOperands, this.location(node))
    let zero = context.emitConstant("int", 3, "0", this.location(node))
    let incoming = context.snapshot()
    let carried = context.sortedMutableState()
    let header = context.function.createBlock()
    let body = context.function.createBlock()
    let exit = context.function.createBlock()
    let indexValue = context.function.allocateValue()

    header.addParameter(new IrParameter(indexValue, "int", this.location(node)))
    let headerValues = context.addParameters(header, carried, this.location(node))
    let exitValues = context.addParameters(exit, carried, this.location(node))
    var initialArguments: Int[] = [zero.id]

    for argument in this.stateArguments(incoming, carried) initialArguments = host.appendInt(initialArguments, argument) end
    context.branch(header, initialArguments, this.location(node))
    context.restore(incoming)
    this.applyState(context, headerValues)
    context.setCurrent(header)
    let hasNext = context.emitCompare(indexValue, length.id, 3, this.location(node))

    context.conditional(hasNext.id, body, irEmptyInts(), exit, this.currentArguments(carried), this.location(node))
    context.setCurrent(body)
    let loadOperands: Int[] = [collection.id, indexValue]

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withMayPanic())
    let element = context.emitValue(36, irType(semanticField(this.bound.dataAt(node), 1)), loadOperands, this.location(node))

    context.enterScope(this.treeScopeLocation(node))
    context.addVariable(this.bound.symbolAt(node), 6, semanticField(this.bound.dataAt(node), 0), irType(semanticField(this.bound.dataAt(node), 1)), element.id, false, this.location(node))
    let previousLoop = context.loop

    context.loop = new IrLoopFrame(header, exit, carried, indexValue, this.location(node), context.cleanupDepth, previousLoop)
    var child = 1

    while child < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, child))
      child = child + 1
    end
    if !context.terminated
      this.emitLoopContinue(context, context.loop, this.location(node))
    end
    context.loop = previousLoop
    context.leaveScope()
    context.restore(incoming)
    this.applyState(context, exitValues)
    context.setCurrent(exit)
  end

  def lowerLoopTransfer(context: IrFunctionContext, isContinue: Bool, node: Int): Void
    let frame = context.loop

    if frame == null
      return
    end
    this.emitScopeCleanups(context, frame.cleanupDepth)
    if isContinue
      this.emitLoopContinue(context, frame, this.location(node))
    else
      context.branch(frame.breakTarget, this.currentArguments(frame.carried), this.location(node))
    end
  end

  def emitScopeCleanups(context: IrFunctionContext, fromDepth: Int): Void
    var cleanup = context.cleanup
    var depth = context.cleanupDepth

    while cleanup != null && depth > fromDepth
      if cleanup.opcode == 55
        if cleanup.active
          let failure = this.emitResourceClose(context, cleanup.ownedValue, cleanup.resourceType)

          this.collectCloseFailure(context, failure)
        end
      else if cleanup.opcode == 54
        let borrowOperands: Int[] = [cleanup.capability, cleanup.token]

        context.emitValue(54, "void", borrowOperands, irNoLocation())
      else
        let unsafeOperands: Int[] = [cleanup.capability]

        context.emitValue(42, "void", unsafeOperands, irNoLocation())
      end
      cleanup = cleanup.previous
      depth = depth - 1
    end
  end

  def emitResourceClose(context: IrFunctionContext, ownedValue: Int, resourceType: String): IrValue
    let owner = this.semantic.findClass(semanticMutableType(resourceType))

    if owner == null
      return new IrValue(-1, "optional|class|result.Failure")
    end
    var method = owner.firstMethod

    while method != null
      if method.name == "close" && !method.isStatic && method.parameterCount == 0
        let receiver = new IrValue(ownedValue, "class|" + owner.fullName)
        let target = this.dispatchSlot(owner, method)
        let virtualOperands = this.virtualOperands(context, [receiver.id], receiver.typeName, target)

        this.addVirtualCallees(context, target, receiver.typeName)
        return context.emitSymbol(30, irType(method.returnType), virtualOperands, irSymbol(this.module.id, 3, target), context.function.location)
      end
      method = method.nextCallable
    end
    return new IrValue(-1, "optional|class|result.Failure")
  end

  def ensureCloseFailures(context: IrFunctionContext): Int
    if context.closeFailures >= 0
      return context.closeFailures
    end
    let collector = context.emitSymbol(38, "class|resources.CloseFailures", irEmptyInts(), irSymbol(this.module.id, 1, "resources.CloseFailures"), context.function.location)
    let initializer = this.findCallable("resources.CloseFailures.init")

    if initializer != null
      context.emitSymbol(29, "void", [collector.id], irSymbol(this.module.id, 3, initializer.fullName), context.function.location)
      context.function.addCallee(initializer.fullName)
    end
    context.closeFailures = collector.id
    return collector.id
  end

  def collectCloseFailure(context: IrFunctionContext, failure: IrValue): Void
    if failure.id < 0
      return
    end
    let hasFailure = context.emitValue(23, "bool", [failure.id], context.function.location)
    let present = context.function.createBlock()
    let next = context.function.createBlock()

    context.conditional(hasFailure.id, present, irEmptyInts(), next, irEmptyInts(), context.function.location)
    context.setCurrent(present)
    let value = context.emitValue(24, "class|result.Failure", [failure.id], context.function.location)
    let collector = this.ensureCloseFailures(context)
    let add = this.findCallable("resources.CloseFailures.add")
    let owner = this.semantic.findClass("resources.CloseFailures")

    if add != null && owner != null
      let target = this.dispatchSlot(owner, add)
      let operands = this.virtualOperands(context, [collector, value.id], "class|resources.CloseFailures", target)

      this.addVirtualCallees(context, target, "class|resources.CloseFailures")
      context.emitSymbol(30, "void", operands, irSymbol(this.module.id, 3, target), context.function.location)
    end
    context.branch(next, irEmptyInts(), context.function.location)
    context.setCurrent(next)
  end

  def resourceOutcome(typeName: String): Bool
    let owner = this.semantic.findClass(semanticMutableType(irTypeInner(typeName)))

    return owner != null && semanticStartsWith(owner.fullName, "resources.Outcome<")
  end

  def lowerOutcomeReturn(context: IrFunctionContext, node: Int): Void
    let child = this.bound.childAt(node, 0)
    let returned = this.lowerExpression(context, child, "")
    let outcomeName = semanticMutableType(irTypeInner(context.function.resultType))
    let outcome = this.semantic.findClass(outcomeName)

    if outcome == null || outcome.genericArguments.Length < 2
      this.emitScopeCleanups(context, 0)
      context.returnValue(returned.id, this.location(node))
      return
    end
    let valueType = outcome.genericArguments[0]
    let failureType = outcome.genericArguments[1]
    let completionField = this.findField(outcomeName + ".completion")
    let failuresField = this.findField(outcomeName + ".closeFailures")
    let collector = this.ensureCloseFailures(context)
    var completion = new IrValue(-1, "class|Error")

    if this.bound.typeAt(child) == outcomeName
      if completionField != null
        completion = context.emitSymbol(39, irType(completionField.typeName), [returned.id], irSymbol(this.module.id, 2, completionField.owner + ".completion"), this.location(node))
      else
        completion = returned
      end
      if failuresField != null
        let previous = context.emitSymbol(39, irType(failuresField.typeName), [returned.id], irSymbol(this.module.id, 2, failuresField.owner + ".closeFailures"), this.location(node))
        let append = this.findCallable("resources.CloseFailures.append")
        let collectorOwner = this.semantic.findClass("resources.CloseFailures")

        if append != null && collectorOwner != null
          let target = this.dispatchSlot(collectorOwner, append)
          let operands = this.virtualOperands(context, [collector, previous.id], "class|resources.CloseFailures", target)

          this.addVirtualCallees(context, target, "class|resources.CloseFailures")
          context.emitSymbol(30, "void", operands, irSymbol(this.module.id, 3, target), this.location(node))
        end
      end
    else
      var completionName = "resources.Completion<" + valueType + "," + failureType + ">"

      if completionField != null
        completionName = completionField.typeName
      end
      completion = context.emitSymbol(38, irType(completionName), irEmptyInts(), irSymbol(this.module.id, 1, completionName), this.location(node))
      let isFailure = semanticAssignable(this.semantic, failureType, this.bound.typeAt(child)) && !semanticAssignable(this.semantic, valueType, this.bound.typeAt(child))
      let tag = context.emitConstant("int", 3, isFailure ? "1" : "0", this.location(node))

      context.emitSymbol(40, "void", [completion.id, tag.id], irSymbol(this.module.id, 2, completionName + ".$alternativeTag"), this.location(node))
      let payload = isFailure ? ".$alternative1_0" : ".$alternative0_0"
      let payloadValue = isFailure ? context.emitValue(22, "optional|" + irType(failureType), [returned.id], this.location(node)) : returned

      context.emitSymbol(40, "void", [completion.id, payloadValue.id], irSymbol(this.module.id, 2, completionName + payload), this.location(node))
    end
    this.emitScopeCleanups(context, 0)
    let wrapped = context.emitSymbol(38, context.function.resultType, irEmptyInts(), irSymbol(this.module.id, 1, outcomeName), this.location(node))
    let initializer = this.findCallable(outcomeName + ".init")

    if initializer != null
      context.emitSymbol(29, "void", [wrapped.id, completion.id, collector], irSymbol(this.module.id, 3, initializer.fullName), this.location(node))
      context.function.addCallee(initializer.fullName)
    end
    context.returnValue(wrapped.id, this.location(node))
  end

  def emitLoopContinue(context: IrFunctionContext, frame: IrLoopFrame?, branchLocation: IrLocation): Void
    if frame == null
      return
    end
    var arguments: Int[] = []

    if frame.indexValue >= 0
      let one = context.emitConstant("int", 3, "1", branchLocation)
      let addOperands: Int[] = [frame.indexValue, one.id]

      context.function.localEffects = context.function.localEffects.withMayPanic()
      let next = context.emitValue(3, "int", addOperands, branchLocation)

      arguments = host.appendInt(arguments, next.id)
    end
    for argument in this.currentArguments(frame.carried) arguments = host.appendInt(arguments, argument) end
    context.branch(frame.continueTarget, arguments, branchLocation)
  end

  def changedVariables(candidates: IrState, first: IrState, second: IrState): IrState
    let result = new IrState()
    var entry = candidates.first

    while entry != null
      if first.valueFor(entry.variable) != second.valueFor(entry.variable)
        result.add(entry.variable, entry.value)
      end
      entry = entry.nextEntry
    end
    return result
  end

  def stateArguments(state: IrState, variables: IrState): Int[]
    var result: Int[] = []
    var entry = variables.first

    while entry != null
      result = host.appendInt(result, state.valueFor(entry.variable))
      entry = entry.nextEntry
    end
    return result
  end

  def currentArguments(variables: IrState): Int[]
    var result: Int[] = []
    var entry = variables.first

    while entry != null
      result = host.appendInt(result, entry.variable.value)
      entry = entry.nextEntry
    end
    return result
  end

  def applyState(context: IrFunctionContext, state: IrState): Void
    var entry = state.first

    while entry != null
      entry.variable.value = entry.value
      if entry.variable.declarationLocation.present
        context.function.addDebugLocal(new IrDebugLocal(entry.variable.name, entry.value, entry.variable.declarationLocation, entry.variable.debugScopeId))
      end
      entry = entry.nextEntry
    end
  end

  def lowerUnsafeBlock(context: IrFunctionContext, node: Int): Void
    context.function.parallelUnsafe = true
    let capability = context.emitValue(41, "!unsafe", irEmptyInts(), this.location(node))

    context.unsafeDepth = context.unsafeDepth + 1
    if context.unsafeCapabilities.size < context.unsafeDepth
      context.unsafeCapabilities.add(capability.id)
    else
      context.unsafeCapabilities.set(context.unsafeDepth - 1, capability.id)
    end
    context.function.localEffects = context.function.localEffects.withUnsafe()
    context.pushCleanup(42, capability.id, -1)
    var nativeVariable = context.firstVariable

    while nativeVariable != null
      irPrepareNativeVariable(this, context, nativeVariable, node)
      nativeVariable = nativeVariable.nextVariable
    end
    var index = 0

    while index < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, index))
      index = index + 1
    end
    if !context.terminated
      var variable = context.firstVariable

      while variable != null
        if variable.addressedPointer >= 0 && variable.addressedDepth == context.unsafeDepth
          let loadOperands: Int[] = [capability.id, variable.addressedPointer]
          let value = context.emitTyped(44, variable.typeName, loadOperands, variable.typeName, this.location(node))

          variable.value = value.id
          variable.addressedPointer = -1
          variable.addressedDepth = -1
          if variable.declarationLocation.present
            context.function.addDebugLocal(new IrDebugLocal(variable.name, value.id, variable.declarationLocation, variable.debugScopeId))
          end
          context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withUnsafe())
        end
        variable = variable.nextVariable
      end
      let operands: Int[] = [capability.id]

      context.emitValue(42, "void", operands, this.location(node))
    end
    context.popCleanup()
    context.unsafeDepth = context.unsafeDepth - 1
  end

  def currentUnsafe(context: IrFunctionContext): Int
    if context.unsafeDepth == 0
      return -1
    end
    return context.unsafeCapabilities.get(context.unsafeDepth - 1)
  end

  def lowerBorrowBlock(context: IrFunctionContext, node: Int): Void
    let owner = this.lowerExpression(context, this.bound.childAt(node, 0), "")
    let pointerType = irType(semanticField(this.bound.dataAt(node), 1))
    let elementType = irTypeInner(pointerType)
    let operands: Int[] = [this.currentUnsafe(context), owner.id]
    let pair = context.emitPair(53, pointerType, "borrow|" + elementType, operands, elementType, this.location(node))

    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withSafepoint().withUnsafe())
    context.pushCleanup(54, this.currentUnsafe(context), pair.secondResultId)
    context.enterScope(this.treeScopeLocation(node))
    context.addVariable(this.bound.symbolAt(node), 6, semanticField(this.bound.dataAt(node), 0), pointerType, pair.resultId, false, this.location(node))
    var index = 1

    while index < this.bound.childCountAt(node) && !context.terminated
      this.lowerStatement(context, this.bound.childAt(node, index))
      index = index + 1
    end
    if !context.terminated
      let endOperands: Int[] = [this.currentUnsafe(context), pair.secondResultId]

      context.emitValue(54, "void", endOperands, this.location(node))
    end
    context.popCleanup()
    context.leaveScope()
  end

  def lowerRuntimeCall(context: IrFunctionContext, node: Int, target: String): IrValue
    let callable = this.findCAbiCallable(target)
    let operands = this.lowerArguments(context, node, 0, callable)
    var operandTypes = new StringBuffer()
    var index = 0

    while index < operands.Length
      var typeName = irType(this.bound.typeAt(this.bound.childAt(node, index)))

      if callable != null
        let parameter = callable.parameterAt(index)

        if parameter != null
          typeName = irType(parameter.typeName)
        end
      end
      operandTypes.add(typeName)
      index = index + 1
    end
    var resultType = irType(this.bound.typeAt(node))
    let contract = this.runtimeContract(target)

    if contract == null
      return new IrValue(-1, resultType)
    end
    let importName = "runtime.import." + (contract.symbolKind as String) + "." + contract.name
    let importSymbol = irSymbol(this.module.id, 7, importName)

    if !this.hasImport(importName)
      let declaration = new IrImport(importSymbol, contract.resultType, 1, contract.linkName, contract.effects, irNoLocation())

      declaration.runtimeMajor = 1
      declaration.runtimeMinor = contract.runtimeMinor
      declaration.runtimeFeatures = contract.runtimeFeatures
      index = 0
      while index < operands.Length
        declaration.parameterTypes.add(operandTypes.get(index))
        index = index + 1
      end
      this.module.addImport(declaration)
    end
    context.function.localEffects = context.function.localEffects.mergedWith(contract.effects)
    if this.checkParallel && !contract.parallelSafe
      context.function.parallelUnsafe = true
    end
    return context.emitSymbol(31, resultType, operands, importSymbol, this.location(node))
  end

  def lowerIntrinsicCall(context: IrFunctionContext, node: Int, callable: SemanticCallable): IrValue
    let contract = semanticIntrinsic(this.semantic, callable.intrinsicName)

    if contract == null
      return new IrValue(-1, irType(callable.returnType))
    end
    let importName = "runtime.intrinsic." + contract.name
    let importSymbol = irSymbol(this.module.id, 7, importName)

    if !this.hasImport(importName)
      let declaration = new IrImport(importSymbol, irType(contract.resultType), 1, contract.linkName, contract.effects, this.location(node))

      declaration.runtimeMajor = 1
      declaration.runtimeMinor = contract.minimumMinor
      declaration.runtimeFeatures = contract.runtimeFeatures
      for parameterType in contract.parameterTypes
        declaration.parameterTypes.add(irType(parameterType))
      end
      this.module.addImport(declaration)
    end
    let operands = this.lowerArguments(context, node, 0, callable)

    context.function.localEffects = context.function.localEffects.mergedWith(contract.effects)
    if this.checkParallel && !contract.parallelSafe
      context.function.parallelUnsafe = true
    end
    return context.emitSymbol(31, irType(contract.resultType), operands, importSymbol, this.location(node))
  end

  def representedClass(name: String): Bool
    if name == ""
      return false
    end
    let owner = this.semantic.findClass(name)

    return owner != null && owner.representation != ""
  end

  def lowerCAbiCall(context: IrFunctionContext, node: Int, callable: SemanticCallable): IrValue
    context.function.parallelUnsafe = true
    if !this.hasImport(callable.fullName)
      let declaration = new IrImport(irSymbol(this.module.id, 4, callable.fullName), irType(callable.returnType), 2, callable.cAbiSymbol, new EffectSet().withRead().withWrite().withUnsafe(), this.location(callable.boundNode))

      declaration.nativeLibrary = callable.nativeLibrary
      if callable.nativeLibrary != "" && !this.module.hasFeature("native-libraries-v1")
        this.module.requiredFeatures.add("native-libraries-v1")
      end
      var parameter = callable.firstParameter

      while parameter != null
        declaration.parameterTypes.add(irType(parameter.typeName))
        parameter = parameter.nextParameter
      end
      this.module.addImport(declaration)
    end
    var operands: Int[] = [this.currentUnsafe(context)]

    for value in this.lowerArguments(context, node, 0, callable)
      operands = host.appendInt(operands, value)
    end
    context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withWrite().withUnsafe())
    return context.emitSymbol(33, irType(callable.returnType), operands, irSymbol(this.module.id, 4, callable.fullName), this.location(node))
  end

  def hasImport(name: String): Bool
    var current = this.module.firstImport

    while current != null
      if current.symbol.name == name
        return true
      end
      current = current.nextImport
    end
    return false
  end

  def findField(name: String): SemanticField?
    var classSymbol = this.semantic.firstClass

    while classSymbol != null
      var field = classSymbol.firstField

      while field != null
        if field.owner + "." + field.name == name
          return field
        end
        field = field.nextField
      end
      classSymbol = classSymbol.nextClass
    end
    return null
  end

  def findCAbiCallable(symbol: String): SemanticCallable?
    var function = this.semantic.firstFunction

    while function != null
      if function.cAbiSymbol == symbol
        return function
      end
      function = function.nextCallable
    end
    return null
  end

  def addVirtualCallees(context: IrFunctionContext, slotName: String, receiverType: String): Void
    this.addVirtualCalleesFrom(context, slotName, receiverType, this.semantic)
  end

  private def addVirtualCalleesFrom(context: IrFunctionContext, slotName: String, receiverType: String, model: SemanticModel): Void
    let parent = model.parent

    if parent != null
      this.addVirtualCalleesFrom(context, slotName, receiverType, parent)
    end
    var classSymbol = model.firstClass

    while classSymbol != null
      var method = classSymbol.firstMethod

      while method != null
        if !method.isStatic && method.name != "init" && this.dispatchSlot(classSymbol, method) == slotName
          context.function.callees.add(method.fullName)
          let precise = context.function.parallelCallees

          if precise != null && irParallelDispatchTarget(this, irTypeInner(receiverType), classSymbol, method, slotName)
            precise.add(method.fullName)
          end
        end
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
  end

  def virtualOperands(context: IrFunctionContext, operands: Int[], receiverType: String, slot: String): Int[]
    let declaration = this.findCallable(slot)

    if declaration == null || receiverType == "class|" + declaration.className
      return operands
    end
    let receiver = context.emitValue(20, "class|" + declaration.className, [operands[0]], irNoLocation())
    var adjusted: Int[] = [receiver.id]
    var index = 1

    while index < operands.Length
      adjusted = host.appendInt(adjusted, operands[index])
      index = index + 1
    end
    return adjusted
  end

  def argumentSupplied(node: Int, parameter: Int, arity: Int): Bool
    var named = false
    var index = 0

    while index < this.bound.childCountAt(node)
      let argument = this.bound.childAt(node, index)

      if this.bound.kindAt(argument) == "Argument"
        named = true
        if this.argumentParameter(argument, -1) == parameter
          return true
        end
      end
      index = index + 1
    end
    return !named && parameter < arity
  end

  def defaultAdapterName(target: SemanticCallable, arity: Int, virtualDispatch: Bool, node: Int): String
    var prefix = true
    var selection = ""
    var index = 0

    while index < target.parameterCount
      let supplied = this.argumentSupplied(node, index, arity)

      prefix = false if supplied != (index < arity)
      selection = selection + "_" + (index as String) if supplied
      index = index + 1
    end
    return target.fullName + (prefix ? "$default$arity" + (arity as String) : "$default$parameters" + selection) + (virtualDispatch ? "$virtual" : "")
  end

  def requestDefaultAdapter(target: SemanticCallable, arity: Int, virtualDispatch: Bool, node: Int): String
    let name = this.defaultAdapterName(target, arity, virtualDispatch, node)
    let dispatch = virtualDispatch ? 1 : 0
    var index = 0

    while index < this.adapterTargets.size
      if this.adapterTargets.get(index) == target.fullName && this.adapterArities.get(index) == arity && this.adapterVirtual.get(index) == dispatch && this.defaultAdapterName(target, arity, virtualDispatch, this.adapterNodes.get(index)) == name
        return name
      end
      index = index + 1
    end
    this.adapterTargets.add(target.fullName)
    this.adapterArities.add(arity)
    this.adapterVirtual.add(dispatch)
    this.adapterNodes.add(node)
    return name
  end

  def lowerDefaultAdapter(target: SemanticCallable, arity: Int, virtualDispatch: Bool, node: Int): Void
    let name = this.defaultAdapterName(target, arity, virtualDispatch, node)

    let retained = this.retainedModule

    if irEffectFunction(this.module, name) != null || (retained != null && this.findRetainedFunction(retained, name) != null)
      return
    end
    let adapterLocation = this.location(node)
    let previousLocationOverride = this.locationOverride

    this.locationOverride = adapterLocation
    let function = new IrFunction(irSymbol(this.module.id, 4, name), irType(target.returnType), 5, false, adapterLocation)

    function.parallelCallees = new StringBuffer() if this.checkParallel
    let entry = function.createBlock()
    let context = new IrFunctionContext(function, entry)
    var operands: Int[] = []

    if target.className != "" && !target.isStatic
      let receiverType = irType(target.className)

      function.parameterTypes.add(receiverType)
      let receiver = function.allocateValue()

      entry.addParameter(new IrParameter(receiver, receiverType, this.location(target.boundNode)))
      context.addVariable(target.fullName + "/this", 5, "this", receiverType, receiver, false, this.location(target.boundNode))
      operands = host.appendInt(operands, receiver)
    end
    var parameter = target.firstParameter
    var index = 0

    while parameter != null
      let typeName = irType(parameter.typeName)
      var value = -1

      if this.argumentSupplied(node, index, arity)
        function.parameterTypes.add(typeName)
        value = function.allocateValue()

        entry.addParameter(new IrParameter(value, typeName, this.module.location(this.syntax.startAt(parameter.syntaxNode), this.syntax.lengthAt(parameter.syntaxNode))))
      else
        value = this.lowerExpression(context, parameter.boundDefault, typeName).id
      end
      context.addVariable(parameter.identity, 5, parameter.name, typeName, value, false, this.module.location(this.syntax.startAt(parameter.syntaxNode), this.syntax.lengthAt(parameter.syntaxNode)))
      operands = host.appendInt(operands, value)
      parameter = parameter.nextParameter
      index = index + 1
    end
    let represented = this.representedClass(target.className)
    var opcode = target.className != "" && !target.isStatic && !represented ? 29 : 28
    var callTarget = target.fullName

    if virtualDispatch
      let owner = this.semantic.findClass(target.className)

      if owner != null
        callTarget = this.dispatchSlot(owner, target)
      end
      operands = this.virtualOperands(context, operands, "class|" + target.className, callTarget)
      opcode = 30
      this.addVirtualCallees(context, callTarget, "class|" + target.className)
    else
      function.addCallee(target.fullName)
    end
    let symbolKind = target.className != "" && !represented ? 3 : 4
    let result = context.emitSymbol(opcode, irType(target.returnType), operands, irSymbol(this.module.id, symbolKind, callTarget), this.location(target.boundNode))

    context.returnValue(irType(target.returnType) == "void" ? -1 : result.id, this.location(target.boundNode))
    this.module.addFunction(function)
    this.locationOverride = previousLocationOverride
  end

  def findCallable(name: String): SemanticCallable?
    let function = this.semantic.findFunction(name)

    if function != null
      return function
    end
    return this.findMethod(this.semantic, name)
  end

  private def findMethod(model: SemanticModel, name: String): SemanticCallable?
    var classSymbol = model.firstClass

    while classSymbol != null
      var method = classSymbol.firstMethod

      while method != null
        if method.fullName == name
          return method
        end
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
    let parent = model.parent

    if parent != null
      return this.findMethod(parent, name)
    end
    return null
  end

  def runtimeContract(name: String): IrRuntimeContract?
    if name == "sessionEnvironmentIdentity" || name == "neri_rt_v1_session_identity"
      return new IrRuntimeContract(name, "neri_rt_v1_session_identity", "int", new EffectSet().withMayPanic().withNativeAllocate().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeCreate" || name == "neri_rt_v1_session_create"
      return new IrRuntimeContract(name, "neri_rt_v1_session_create", "int", new EffectSet().withMayPanic().withNativeAllocate().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeOwner" || name == "neri_rt_v1_session_owner"
      return new IrRuntimeContract(name, "neri_rt_v1_session_owner", "string", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeLoadExecute" || name == "neri_rt_v1_session_load_execute"
      return new IrRuntimeContract(name, "neri_rt_v1_session_load_execute", "int", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeLoadExecuteRetained" || name == "neri_rt_v1_session_load_execute_retained"
      return new IrRuntimeContract(name, "neri_rt_v1_session_load_execute_retained", "int", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint().withUnsafe(), 23, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeLoadExecuteObject" || name == "neri_rt_v1_session_load_execute_object"
      return new IrRuntimeContract(name, "neri_rt_v1_session_load_execute_object", "int", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint().withUnsafe(), 24, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeReset" || name == "neri_rt_v1_session_reset"
      return new IrRuntimeContract(name, "neri_rt_v1_session_reset", "int", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeDestroy" || name == "neri_rt_v1_session_destroy"
      return new IrRuntimeContract(name, "neri_rt_v1_session_destroy", "int", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeError" || name == "neri_rt_v1_session_error"
      return new IrRuntimeContract(name, "neri_rt_v1_session_error", "string", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withUnsafe(), 19, new RuntimeFeatures().withSessionModules(), 6)
    end
    if name == "sessionBridgeResult" || name == "neri_rt_v1_session_result"
      return new IrRuntimeContract(name, "neri_rt_v1_session_result", "string", new EffectSet().withRead().withMayPanic().withManagedAllocate().withNativeAllocate().withUnsafe(), 23, new RuntimeFeatures().withSessionModules(), 6)
    end
    return null
  end

end
