class IrMethod
  public functionSymbol: IrSymbol
  public dispatch: readonly IrDispatchKind
  public dispatchSlot: IrSymbol?
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextMethod: IrMethod?

  def init(functionSymbol: IrSymbol, dispatch: readonly IrDispatchKind, dispatchSlot: IrSymbol?, location: IrLocation): Void
    this.functionSymbol = functionSymbol
    this.dispatch = dispatch
    this.dispatchSlot = dispatchSlot
    this.location = location
  end
end
