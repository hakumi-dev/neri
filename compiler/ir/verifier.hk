class IrVerification
  public errors: StringBuffer = new StringBuffer()

  def fail(message: String): Void
    this.errors.add(message)
  end

  def succeeded(): Bool
    return this.errors.size == 0
  end
end

class IrVerifier
  public module: IrModule = new IrModule("main", "")
  public result: IrVerification = new IrVerification()
  public symbols: StringBuffer = new StringBuffer()

  def init(module: IrModule): Void
    this.module = module
  end

  def verify(): IrVerification
    if this.module.id == ""
      this.result.fail("module id is empty")
    end
    this.verifySources()
    var classValue = this.module.firstClass
    while classValue != null
      this.declareSymbol(classValue.symbol)
      this.verifyLocation(classValue.location)
      var field = classValue.firstField
      while field != null
        this.declareSymbol(field.symbol)
        this.verifyType(field.typeName)
        this.verifyLocation(field.location)
        field = field.nextField
      end
      classValue = classValue.nextClass
    end
    var global = this.module.firstGlobal
    while global != null
      this.declareSymbol(global.symbol)
      this.verifyLocation(global.location)
      global = global.nextGlobal
    end
    var importValue = this.module.firstImport
    while importValue != null
      this.declareSymbol(importValue.symbol)
      this.verifyTypeBuffer(importValue.parameterTypes)
      this.verifyType(importValue.resultType)
      this.verifyLocation(importValue.location)
      importValue = importValue.nextImport
    end
    var function = this.module.firstFunction
    while function != null
      this.declareSymbol(function.symbol)
      this.verifyFunction(function)
      function = function.nextFunction
    end
    return this.result
  end

  def verifySources(): Void
    if this.module.sourceCount == 0
      this.result.fail("module has no sources")
    end
    var source = this.module.firstSource
    while source != null
      if source.id == ""
        this.result.fail("source id is empty")
      end
      var other = source.nextSource
      while other != null
        if source.id == other.id
          this.result.fail("duplicate source '" + source.id + "'")
        end
        other = other.nextSource
      end
      source = source.nextSource
    end
  end

  def declareSymbol(symbol: IrSymbol): Void
    if symbol.moduleName != this.module.id
      this.result.fail("symbol belongs to another module: " + symbol.name)
    end
    if symbol.name == ""
      this.result.fail("symbol name is empty")
    end
    let key = symbol.moduleName + "|" + (symbol.kind as String) + "|" + symbol.name
    var index = 0
    while index < this.symbols.size
      if this.symbols.get(index) == key
        this.result.fail("duplicate symbol '" + symbol.name + "'")
        return
      end
      index = index + 1
    end
    this.symbols.add(key)
  end

  def verifyTypeBuffer(types: StringBuffer): Void
    var index = 0
    while index < types.size
      this.verifyType(types.get(index))
      index = index + 1
    end
  end

  def verifyType(typeName: String): Void
    if irTypeTag(typeName) == 0
      this.result.fail("invalid IR type '" + typeName + "'")
    end
  end

  def sourceFor(id: String): IrSource?
    var source = this.module.firstSource
    while source != null
      if source.id == id
        return source
      end
      source = source.nextSource
    end
    return null
  end

  def verifyLocation(location: IrLocation): Void
    if !location.present
      return
    end
    let source = this.sourceFor(location.sourceId)
    if source == null
      this.result.fail("location references unknown source '" + location.sourceId + "'")
      return
    end
    if location.start < 0 || location.length < 0 || location.start + location.length > host.stringByteLength(source.text)
      this.result.fail("location is outside source '" + location.sourceId + "'")
    end
  end

  def defineValue(id: Int, typeName: String, defined: IntBuffer, types: StringBuffer, function: IrFunction): Void
    if id < 0 || id >= function.nextValueId
      this.result.fail("value id is outside function range in '" + function.symbol.name + "'")
      return
    end
    if defined.get(id) != 0
      this.result.fail("duplicate value %" + (id as String) + " in '" + function.symbol.name + "'")
      return
    end
    this.verifyType(typeName)
    defined.set(id, 1)
    types.set(id, typeName)
  end

  def verifyValueUse(id: Int, defined: IntBuffer, function: IrFunction): Void
    if id < 0 || id >= function.nextValueId || defined.get(id) == 0
      this.result.fail("use of undefined value %" + (id as String) + " in '" + function.symbol.name + "'")
    end
  end

  def findBlock(function: IrFunction, id: Int): IrBlock?
    var block = function.firstBlock
    while block != null
      if block.id == id
        return block
      end
      block = block.nextBlock
    end
    return null
  end

  def verifyEdge(function: IrFunction, targetId: Int, arguments: Int[], defined: IntBuffer): Void
    let target = this.findBlock(function, targetId)
    if target == null
      this.result.fail("branch targets unknown block in '" + function.symbol.name + "'")
      return
    end
    if arguments.Length != target.parameterCount
      this.result.fail("branch argument count does not match block parameters in '" + function.symbol.name + "'")
    end
    for argument in arguments this.verifyValueUse(argument, defined, function) end
  end

  def verifyInstruction(function: IrFunction, instruction: IrInstruction, defined: IntBuffer, types: StringBuffer): Void
    if instruction.opcode < 1 || instruction.opcode > 57
      this.result.fail("invalid opcode in '" + function.symbol.name + "'")
    end
    for operand in instruction.operands this.verifyValueUse(operand, defined, function) end
    for typeName in instruction.typeArguments this.verifyType(typeName) end
    this.verifyLocation(instruction.location)
    if instruction.opcode == 1 && instruction.constantKind == 0
      this.result.fail("constant instruction has no constant")
    end
    if instruction.opcode != 1 && instruction.constantKind != 0
      this.result.fail("non-constant instruction carries a constant")
    end
    if instruction.opcode == 15 || instruction.opcode == 48
      if instruction.predicate < 1 || instruction.predicate > 6
        this.result.fail("comparison instruction has no valid predicate")
      end
    else if instruction.predicate != 0
      this.result.fail("non-comparison instruction carries a predicate")
    end
    if instruction.opcode >= 42 && instruction.opcode <= 54
      if instruction.operands.Length == 0 || instruction.operands[0] < 0 || instruction.operands[0] >= function.nextValueId || types.get(instruction.operands[0]) != "!unsafe"
        this.result.fail("unsafe instruction has no live unsafe capability in '" + function.symbol.name + "'")
      end
    end
    if instruction.opcode == 41
      if instruction.resultType != "!unsafe" || instruction.operands.Length != 0
        this.result.fail("unsafe.begin has an invalid shape")
      end
    end
    if instruction.opcode == 53
      if instruction.secondResultId < 0 || irTypeKind(instruction.secondResultType) != "borrow"
        this.result.fail("borrow.begin has no borrow token")
      end
    else if instruction.secondResultId >= 0
      this.result.fail("instruction has an unexpected second result")
    end
  end

  def verifyFunction(function: IrFunction): Void
    this.verifyTypeBuffer(function.parameterTypes)
    this.verifyType(function.resultType)
    this.verifyLocation(function.location)
    if function.blockCount == 0
      this.result.fail("function '" + function.symbol.name + "' has no blocks")
    end
    let entry = this.findBlock(function, function.entryBlock)
    if entry == null
      this.result.fail("function '" + function.symbol.name + "' has no entry block")
      return
    end
    let defined = new IntBuffer()
    let types = new StringBuffer()
    var index = 0
    while index < function.nextValueId
      defined.add(0)
      types.add("")
      index = index + 1
    end
    if function.unsafeRootId >= 0
      this.defineValue(function.unsafeRootId, "!unsafe", defined, types, function)
    end
    if function.unsafeCall != (function.unsafeRootId >= 0)
      this.result.fail("unsafe function root does not match unsafe-call flag")
    end
    var block = function.firstBlock
    while block != null
      var other = block.nextBlock
      while other != null
        if block.id == other.id
          this.result.fail("duplicate block id in '" + function.symbol.name + "'")
        end
        other = other.nextBlock
      end
      var parameter = block.firstParameter
      while parameter != null
        this.defineValue(parameter.id, parameter.typeName, defined, types, function)
        this.verifyLocation(parameter.location)
        parameter = parameter.nextParameter
      end
      var instruction = block.firstInstruction
      while instruction != null
        if instruction.resultId >= 0
          this.defineValue(instruction.resultId, instruction.resultType, defined, types, function)
        end
        if instruction.secondResultId >= 0
          this.defineValue(instruction.secondResultId, instruction.secondResultType, defined, types, function)
        end
        instruction = instruction.nextInstruction
      end
      block = block.nextBlock
    end
    index = 0
    while index < function.nextValueId
      if defined.get(index) == 0
        this.result.fail("missing value %" + (index as String) + " in '" + function.symbol.name + "'")
      end
      index = index + 1
    end
    if entry.parameterCount != function.parameterTypes.size
      this.result.fail("entry parameters do not match function signature")
    end
    var entryParameter = entry.firstParameter
    index = 0
    while entryParameter != null && index < function.parameterTypes.size
      if entryParameter.typeName != function.parameterTypes.get(index)
        this.result.fail("entry parameter type does not match function signature")
      end
      entryParameter = entryParameter.nextParameter
      index = index + 1
    end
    block = function.firstBlock
    while block != null
      var instruction = block.firstInstruction
      while instruction != null
        this.verifyInstruction(function, instruction, defined, types)
        instruction = instruction.nextInstruction
      end
      let terminator = block.terminator
      if terminator == null
        this.result.fail("block has no terminator in '" + function.symbol.name + "'")
      else
        this.verifyLocation(terminator.location)
        if terminator.kind == 1
          this.verifyEdge(function, terminator.firstTarget, terminator.firstArguments, defined)
        else if terminator.kind == 2
          this.verifyValueUse(terminator.condition, defined, function)
          if terminator.condition >= 0 && terminator.condition < function.nextValueId && types.get(terminator.condition) != "bool"
            this.result.fail("conditional branch condition is not bool")
          end
          this.verifyEdge(function, terminator.firstTarget, terminator.firstArguments, defined)
          this.verifyEdge(function, terminator.secondTarget, terminator.secondArguments, defined)
        else if terminator.kind == 3
          if function.resultType == "void" && terminator.value >= 0
            this.result.fail("void return carries a value")
          end
          if function.resultType != "void" && terminator.value < 0
            this.result.fail("non-void return has no value")
          end
          if terminator.value >= 0
            this.verifyValueUse(terminator.value, defined, function)
            if terminator.value < function.nextValueId && types.get(terminator.value) != function.resultType
              this.result.fail("return value type does not match function result")
            end
          end
        else if terminator.kind != 4
          this.result.fail("invalid terminator in '" + function.symbol.name + "'")
        end
      end
      block = block.nextBlock
    end
  end
end

def irVerify(module: IrModule): IrVerification
  return (new IrVerifier(module)).verify()
end
