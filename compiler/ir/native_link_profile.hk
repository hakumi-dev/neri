use host
use files

# Accept only bounded little-endian arm64 macOS executable Mach-O profiles without embedded dyld settings.
def nativeLinkProfile(path: String): Bool
  return new NativeLinkProfile().check(path)
end

class NativeLinkProfile
  def check(path: String): Bool
    let pathLength = host::stringByteLength(path)

    if pathLength == 0 || pathLength > 4096
      return false
    end
    var index = 0

    while index < pathLength
      return false if host::stringByteAt(path, index) == 0 as Byte
      index = index + 1
    end
    unsafe
      let pathBytes = native::alloc<Byte>(pathLength)

      index = 0
      while index < pathLength
        pathBytes[index] = host::stringByteAt(path, index)
        index = index + 1
      end
      let fd = files::openFile(pathBytes, pathLength)

      native::free(pathBytes)
      if fd < 0
        return false
      end
      let fileSize = files::fileSize(fd)
      let capacity = 4194336
      let buffer = native::alloc<Byte>(capacity)
      var read = 0
      var valid = fileSize >= 32 && fileSize <= 68719476736

      while valid && read < 32
        let count = files::readFile(fd, buffer + read, 32 - read)

        if count == -2
          continue
        end
        if count <= 0 || count > 32 - read
          valid = false
        else
          read = read + count
        end
      end
      if valid && (nativeLinkRead32le(buffer) != 4277009103 || nativeLinkRead32le(buffer + 4) != 16777228 || nativeLinkRead32le(buffer + 8) != 0 || nativeLinkRead32le(buffer + 12) != 2)
        valid = false
      end
      let commandCount = valid ? nativeLinkRead32le(buffer + 16) : 0
      let commandBytes = valid ? nativeLinkRead32le(buffer + 20) : 0

      if commandCount <= 0 || commandCount > 65536 || commandBytes < commandCount * 8 || commandBytes > 4194304 || commandBytes > fileSize - 32
        valid = false
      end
      let needed = 32 + commandBytes

      while valid && read < needed
        let count = files::readFile(fd, buffer + read, needed - read)

        if count == -2
          continue
        end
        if count <= 0 || count > needed - read
          valid = false
        else
          read = read + count
        end
      end
      var cursor = 32
      let commandEnd = needed
      var seenMacOS = false
      var commands = 0

      while valid && cursor < commandEnd && commandEnd - cursor >= 8 && commands < commandCount
        let command = nativeLinkRead32le(buffer + cursor)
        let commandSize = nativeLinkRead32le(buffer + cursor + 4)

        if commandSize < 8 || commandSize / 8 * 8 != commandSize || commandSize > commandEnd - cursor
          valid = false
        else if command == 2147483687 || command == 39
          valid = false
        else if command == 50
          let toolCount = commandSize >= 24 ? nativeLinkRead32le(buffer + cursor + 20) : 0

          if commandSize < 24 || toolCount > (commandSize - 24) / 8 || commandSize != 24 + toolCount * 8 || seenMacOS || nativeLinkRead32le(buffer + cursor + 8) != 1
            valid = false
          else
            seenMacOS = true
          end
        else if command == 36
          if commandSize < 16 || seenMacOS
            valid = false
          else
            seenMacOS = true
          end
        else if command == 37 || command == 47 || command == 48
          valid = false
        end
        cursor = cursor + commandSize
        commands = commands + 1
      end
      valid = valid && commands == commandCount && cursor == commandEnd && seenMacOS
      let closed = files::closeFile(fd)

      native::free(buffer)
      return valid && closed == 0
    end
  end

end

unsafe def nativeLinkRead32le(bytes: Byte*): Int
  var result = 0
  var factor = 1
  var index = 0

  while index < 4
    result = result + (bytes[index] as Int) * factor
    factor = factor * 256
    index = index + 1
  end
  return result
end
