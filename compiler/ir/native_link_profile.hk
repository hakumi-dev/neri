use host
use files

# Validate native ARM64 tools and every slice in ARM64/x86-64 universal tools.
# Embedded dyld settings remain outside the cache profile, including under Rosetta.
def nativeLinkProfile(path: String): Bool
  return new NativeLinkProfile().check(path)
end

class NativeLinkProfile
  def check(path: String): Bool
    let pathLength = host::stringByteLength(path)

    if pathLength == 0 || pathLength > 4096
      return false
    end
    var index = 0

    while index < pathLength
      return false if host::stringByteAt(path, index) == 0 as Byte
      index = index + 1
    end
    unsafe
      let pathBytes = native::alloc<Byte>(pathLength)

      index = 0
      while index < pathLength
        pathBytes[index] = host::stringByteAt(path, index)
        index = index + 1
      end
      let fd = files::openFile(pathBytes, pathLength)

      native::free(pathBytes)
      return false if fd < 0
      let fileSize = files::fileSize(fd)
      let buffer = native::alloc<Byte>(4194336)
      var valid = fileSize >= 32 && fileSize <= 68719476736 && nativeLinkReadExact(fd, buffer, 8)

      if valid
        let magic = nativeLinkRead32le(buffer)

        if magic == 4277009103
          valid = nativeLinkReadExact(fd, buffer + 8, 24) && nativeLinkProfileSlice(fd, buffer, fileSize, -1) >= 0
        else if magic == 3199925962 || magic == 3216703178
          valid = nativeLinkProfileUniversal(fd, buffer, fileSize, magic == 3216703178)
        else
          valid = false
        end
      end
      let closed = files::closeFile(fd)

      native::free(buffer)
      return valid && closed == 0
    end
  end
end

unsafe def nativeLinkReadExact(fd: Int, buffer: Byte*, length: Int): Bool
  var read = 0

  while read < length
    let count = files::readFile(fd, buffer + read, length - read)

    continue if count == -2
    return false if count <= 0 || count > length - read
    read = read + count
  end
  return true
end

# The header is already in buffer; return the total bytes consumed from this slice.
unsafe def nativeLinkProfileSlice(fd: Int, buffer: Byte*, size: Int, expectedSubtype: Int, expectedCPU: Int = 16777228): Int
  let subtype = nativeLinkRead32le(buffer + 8)
  let baseSubtype = subtype - (subtype / 16777216) * 16777216

  # mach/machine.h: ARM64 ALL, V8, E, X1 and E_X1; x86-64 ALL and H.
  let supportedSubtype = expectedCPU == 16777228 ? (baseSubtype <= 3 || baseSubtype == 12) : expectedCPU == 16777223 && (baseSubtype == 3 || baseSubtype == 8)

  if size < 32 || nativeLinkRead32le(buffer) != 4277009103 || nativeLinkRead32le(buffer + 4) != expectedCPU || !supportedSubtype || nativeLinkRead32le(buffer + 12) != 2 || (expectedSubtype >= 0 && subtype != expectedSubtype)
    return -1
  end
  let commandCount = nativeLinkRead32le(buffer + 16)
  let commandBytes = nativeLinkRead32le(buffer + 20)

  if commandCount <= 0 || commandCount > 65536 || commandBytes < commandCount * 8 || commandBytes > 4194304 || commandBytes > size - 32
    return -1
  end
  return -1 if !nativeLinkReadExact(fd, buffer + 32, commandBytes)
  var cursor = 32
  let commandEnd = 32 + commandBytes
  var seenMacOS = false
  var commands = 0

  while cursor < commandEnd && commandEnd - cursor >= 8 && commands < commandCount
    let command = nativeLinkRead32le(buffer + cursor)
    let commandSize = nativeLinkRead32le(buffer + cursor + 4)

    if commandSize < 8 || commandSize / 8 * 8 != commandSize || commandSize > commandEnd - cursor
      return -1
    else if command == 2147483687 || command == 39
      return -1
    else if command == 50
      let toolCount = commandSize >= 24 ? nativeLinkRead32le(buffer + cursor + 20) : 0

      if commandSize < 24 || toolCount > (commandSize - 24) / 8 || commandSize != 24 + toolCount * 8 || seenMacOS || nativeLinkRead32le(buffer + cursor + 8) != 1
        return -1
      end
      seenMacOS = true
    else if command == 36
      return -1 if commandSize < 16 || seenMacOS
      seenMacOS = true
    else if command == 37 || command == 47 || command == 48
      return -1
    end
    cursor = cursor + commandSize
    commands = commands + 1
  end
  return commands == commandCount && cursor == commandEnd && seenMacOS ? commandEnd : -1
end

unsafe def nativeLinkFatOffset(record: Byte*, wide: Bool): Int
  return nativeLinkRead32be(record + (wide ? 12 : 8))
end

unsafe def nativeLinkFatSize(record: Byte*, wide: Bool): Int
  return nativeLinkRead32be(record + (wide ? 20 : 12))
end

unsafe def nativeLinkProfileUniversal(fd: Int, buffer: Byte*, fileSize: Int, wide: Bool): Bool
  let count = nativeLinkRead32be(buffer + 4)
  let entrySize = wide ? 32 : 20
  let tableEnd = 8 + count * entrySize

  # Streaming skips avoid allocating the entire tool; bound total I/O as well.
  return false if count < 1 || count > 64 || tableEnd > fileSize || fileSize > 536870912
  let table = native::alloc<Byte>(count * entrySize)
  var valid = nativeLinkReadExact(fd, table, count * entrySize)
  var index = 0
  var armSlices = 0

  while valid && index < count
    let record = table + index * entrySize
    let offset = nativeLinkFatOffset(record, wide)
    let size = nativeLinkFatSize(record, wide)
    let alignment = nativeLinkRead32be(record + (wide ? 24 : 16))
    let cpu = nativeLinkRead32be(record)

    if (cpu != 16777228 && cpu != 16777223) || offset < tableEnd || size < 32 || offset > fileSize || size > fileSize - offset || alignment > 30
      valid = false
    else if wide && (nativeLinkRead32be(record + 8) != 0 || nativeLinkRead32be(record + 16) != 0 || nativeLinkRead32be(record + 28) != 0)
      valid = false
    else
      var boundary = 1
      var bit = 0

      while bit < alignment
        boundary = boundary * 2
        bit = bit + 1
      end
      valid = offset / boundary * boundary == offset
    end
    var other = 0

    while valid && other < index
      let previous = table + other * entrySize
      let otherOffset = nativeLinkFatOffset(previous, wide)
      let otherSize = nativeLinkFatSize(previous, wide)

      if (offset < otherOffset + otherSize && otherOffset < offset + size) || (nativeLinkRead32be(record) == nativeLinkRead32be(previous) && nativeLinkRead32be(record + 4) == nativeLinkRead32be(previous + 4))
        valid = false
      end
      other = other + 1
    end
    armSlices = armSlices + 1 if nativeLinkRead32be(record) == 16777228
    index = index + 1
  end
  var position = tableEnd
  var checked = 0

  while valid && checked < count
    var selected = -1
    var nextOffset = fileSize

    index = 0
    while index < count
      let record = table + index * entrySize
      let offset = nativeLinkFatOffset(record, wide)

      if offset >= position && offset < nextOffset
        selected = index
        nextOffset = offset
      end
      index = index + 1
    end
    if selected < 0
      valid = false
      break
    end
    while valid && position < nextOffset
      let remaining = nextOffset - position
      let chunk = remaining > 65536 ? 65536 : remaining

      valid = nativeLinkReadExact(fd, buffer, chunk)
      position = position + chunk
    end
    if valid
      let record = table + selected * entrySize

      valid = nativeLinkReadExact(fd, buffer, 32)
      if valid
        let consumed = nativeLinkProfileSlice(fd, buffer, nativeLinkFatSize(record, wide), nativeLinkRead32be(record + 4), nativeLinkRead32be(record))

        valid = consumed >= 32
        position = nextOffset + consumed if valid
      end
    end
    checked = checked + 1
  end
  native::free(table)
  return valid && armSlices > 0 && checked == count
end

unsafe def nativeLinkRead32le(bytes: Byte*): Int
  var result = 0
  var factor = 1
  var index = 0

  while index < 4
    result = result + (bytes[index] as Int) * factor
    factor = factor * 256
    index = index + 1
  end
  return result
end

unsafe def nativeLinkRead32be(bytes: Byte*): Int
  var result = 0
  var index = 0

  while index < 4
    result = result * 256 + (bytes[index] as Int)
    index = index + 1
  end
  return result
end
