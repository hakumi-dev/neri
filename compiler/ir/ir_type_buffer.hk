use host
use arrays

class IrTypeBuffer
  private values: (readonly IrType)[] = []
  public size: Int = 0

  def add(value: readonly IrType): Void
    if this.size == this.values.Length
      let previous = this.values
      let capacity = this.size == 0 ? 8 : this.size * 2

      this.values = arrays::generate(capacity) do |index|
        return index < previous.Length ? previous[index] : value
      end
    end
    this.values[this.size] = value
    this.size = this.size + 1
  end

  def get(index: Int): readonly IrType
    if index < 0 || index >= this.size
      irInvariantFailure("IR type index is out of range")
    end
    return this.values[index]
  end

  def toArray(): (readonly IrType)[]
    return arrays::generate(this.size) do |index|
      return this.get(index)
    end
  end

  def set(index: Int, value: readonly IrType): Void
    if index < 0 || index >= this.size
      irInvariantFailure("IR type index is out of range")
    end
    this.values[index] = value
  end
end

def irAppendType(values: (readonly IrType)[], value: readonly IrType): (readonly IrType)[]
  return arrays::generate(values.Length + 1) do |index|
    return index < values.Length ? values[index] : value
  end
end
