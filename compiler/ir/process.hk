use host

@cabi("mkdtemp")
def unsafe bootstrapMkdtemp(template: Byte*): Byte*?
end

def bootstrapRunDirectory(): String?
  var parent = "/tmp"
  let configured = host.environment("TMPDIR")
  if configured != null && configured != "" parent = configured end
  return bootstrapTemporaryDirectory(parent, "neri-run")
end

def bootstrapTemporaryDirectory(parent: String, prefix: String): String?
  let template = parent + "/" + prefix + ".XXXXXX"
  var bytes: Byte[] = []
  var index = 0
  while index < host.stringByteLength(template)
    bytes = host.appendByte(bytes, host.stringByteAt(template, index))
    index = index + 1
  end
  bytes = host.appendByte(bytes, 0 as Byte)
  unsafe
    borrow bytes as pointer
      let created = bootstrapMkdtemp(pointer)
      if created == null return null end
    end
  end
  let decoded = host.stringFromBytes(bytes)
  if decoded == null return null end
  return host.stringSlice(decoded, 0, host.stringByteLength(decoded) - 1)
end

def bootstrapRemoveRunDirectory(directory: String): Void
  host.removeFile(directory + "/program")
  host.removeFile(directory + "/program.o")
  host.removeFile(directory + "/program.nir.hex")
  host.removeFile(directory + "/program.o.nir.hex")
  host.run("/bin/rmdir", [directory])
end
