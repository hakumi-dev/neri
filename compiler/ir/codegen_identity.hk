use host
use process

# Native codegen identifies its actual loaded images, including the platform
# loader. An unavailable identity disables reuse without preventing compilation.
class CodegenIdentity
  public digest: String = ""
  private executable: String = ""

  def capture(): Bool
    this.digest = ""
    this.executable = ""
    let executable = host::environment("NERI_CODEGEN")

    if executable == null
      return false
    end
    this.executable = executable
    this.digest = this.read()
    return this.digest != ""
  end

  def matches(): Bool
    return this.digest != "" && this.read() == this.digest
  end

  private def read(): String
    let options = new process::SpawnOptions(this.executable)

    options.arguments = ["--cache-identity"]
    options.stdoutLimit = 65
    options.stderrLimit = 4096
    let started = process::spawn(options)
    let child = started.child()

    if child == null
      return ""
    end
    let completed = child.wait(10000)

    if completed.running || completed.failure != null
      child.cancel()
      child.dispose()
      return ""
    end
    let released = child.dispose()
    let exit = completed.exit
    let output = host::stringFromBytes(completed.stdout)

    if !released || exit == null || !exit.isExited() || exit.value() != 0 || completed.stdoutTruncated || output == null || host::stringByteLength(output) != 65 || host::stringByteAt(output, 64) != 10 as Byte
      return ""
    end
    var index = 0

    while index < 64
      let byte = host::stringByteAt(output, index) as Int

      if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102))
        return ""
      end
      index = index + 1
    end
    return host::stringSlice(output, 0, 64)
  end
end
