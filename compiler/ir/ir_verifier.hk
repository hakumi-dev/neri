class IrVerifier
  public module: IrModule
  public result: IrVerification = new IrVerification()
  private symbols: StringTable<Bool> = new StringTable<Bool>()
  private sources: StringTable<IrSource> = new StringTable<IrSource>()
  private blocks: StringTable<IrBlock> = new StringTable<IrBlock>()

  def init(module: IrModule): Void
    this.module = module
  end

  def verify(): IrVerification
    this.result = new IrVerification()
    this.symbols = new StringTable<Bool>()
    this.sources = new StringTable<IrSource>()
    this.blocks = new StringTable<IrBlock>()
    if this.module.id == ""
      this.result.fail("module id is empty")
    end
    this.verifySources()
    var record = this.module.firstRecord

    while record != null
      this.declareSymbol(record.symbol)
      var nativeField = record.firstField

      while nativeField != null
        this.declareSymbol(nativeField.symbol)
        this.verifyType(nativeField.typeName)
        nativeField = nativeField.nextField
      end
      record = record.nextRecord
    end
    var classValue = this.module.firstClass

    while classValue != null
      this.declareSymbol(classValue.symbol)
      this.verifyLocation(classValue.location)
      if classValue.retained && !this.module.requiredFeatures.hasRetainedModules()
        this.result.fail("retained class requires retained-modules-v1")
      end
      var field = classValue.firstField

      while field != null
        this.declareSymbol(field.symbol)
        this.verifyType(field.typeName)
        this.verifyLocation(field.location)
        field = field.nextField
      end
      classValue = classValue.nextClass
    end
    var global = this.module.firstGlobal

    while global != null
      this.declareSymbol(global.symbol)
      this.verifyLocation(global.location)
      global = global.nextGlobal
    end
    var importValue = this.module.firstImport

    while importValue != null
      this.declareSymbol(importValue.symbol)
      this.verifyTypeBuffer(importValue.parameterTypes)
      this.verifyType(importValue.resultType)
      this.verifyLocation(importValue.location)
      if importValue.nativeLibrary != ""
        if !importValue.kind.isCAbi() || !semanticNativeLibraryName(importValue.nativeLibrary) || !this.module.requiredFeatures.hasNativeLibraries()
          this.result.fail("native library requires a C ABI import and native-libraries-v1")
        end
      end
      importValue = importValue.nextImport
    end
    var function = this.module.firstFunction

    while function != null
      this.declareSymbol(function.symbol)
      this.verifyFunction(function)
      function = function.nextFunction
    end
    this.verifySessionExport()
    return this.result
  end

  def verifySessionExport(): Void
    let entry = this.module.sessionEntry

    if entry == null
      return
    end
    var function = this.module.firstFunction

    while function != null && (function.symbol.name != entry.name || function.symbol.moduleName != entry.moduleName || !function.symbol.kind.same(entry.kind))
      function = function.nextFunction
    end
    if function == null || !entry.kind.isFunction() || entry.name != "__neri_session_entry"
      this.result.fail("session export entry is missing")
      return
    end
    let returned = function.resultType
    let target = this.module.sessionTargetType
    let source = this.module.sessionSourceType
    let invalidResult = (returned != target && returned != "optional|" + target) || irTypeKind(target) != "class"
    var invalidSource = function.parameterTypes.size > 1 || (function.parameterTypes.size == 0 && source != "void")

    if function.parameterTypes.size == 1
      invalidSource = irTypeKind(function.parameterTypes.get(0)) != "class" || function.parameterTypes.get(0) != source
    end
    if invalidResult || invalidSource
      this.result.fail("session entry must return a managed frame or optional managed frame")
    end
  end

  def verifySources(): Void
    if this.module.sourceCount == 0
      this.result.fail("module has no sources")
    end
    let counts = new StringTable<Int>()
    var source = this.module.firstSource

    while source != null
      this.sources.add(source.id, source)
      let entry = counts.find(source.id)

      if entry == null
        counts.add(source.id, 1)
      else
        entry.value = entry.value + 1
      end
      source = source.nextSource
    end
    source = this.module.firstSource

    while source != null
      if source.id == ""
        this.result.fail("source id is empty")
      end
      let entry = counts.find(source.id)

      if entry != null
        entry.value = entry.value - 1
        var remaining = entry.value

        while remaining > 0
          this.result.fail("duplicate source '" + source.id + "'")
          remaining = remaining - 1
        end
      end
      source = source.nextSource
    end
  end

  def declareSymbol(symbol: IrSymbol): Void
    if symbol.moduleName != this.module.id
      this.result.fail("symbol belongs to another module: " + symbol.name)
    end
    if symbol.name == ""
      this.result.fail("symbol name is empty")
    end
    let kind = symbol.kind.displayName()
    let key = (host::stringByteLength(symbol.moduleName) as String) + ":" + symbol.moduleName + (host::stringByteLength(kind) as String) + ":" + kind + (host::stringByteLength(symbol.name) as String) + ":" + symbol.name

    if !this.symbols.add(key, true)
      this.result.fail("duplicate symbol '" + symbol.name + "'")
    end
  end

  def verifyTypeBuffer(types: StringBuffer): Void
    var index = 0

    while index < types.size
      this.verifyType(types.get(index))
      index = index + 1
    end
  end

  def verifyType(typeName: String): Void
    if irTypeTag(typeName) == 0
      this.result.fail("invalid IR type '" + typeName + "'")
    end
    if semanticIsCFunction(typeName)
      if !this.module.requiredFeatures.hasCInterop() || !irCAbiType(typeName, false)
        this.result.fail("native callable requires c-interop-v1 and a C ABI signature")
      end
      this.verifyTypeBuffer(semanticCFunctionComponents(typeName))
    else if irIsOptional(typeName) || irIsPointer(typeName) || irTypeKind(typeName) == "array"
      this.verifyType(irTypeInner(typeName))
    end
  end

  def sourceFor(id: String): IrSource?
    let entry = this.sources.find(id)

    if entry != null
      return entry.value
    end
    return null
  end

  def verifyDebugScopeId(function: IrFunction, id: Int, owner: String): Void
    if id < 0 || id > function.debugScopeCount || (id != 0 && !this.module.requiredFeatures.hasDebugScopes())
      this.result.fail(owner + " references an invalid debug scope in '" + function.symbol.name + "'")
    end
  end

  def verifyLocation(location: IrLocation): Void
    if !location.present
      return
    end
    let source = this.sourceFor(location.sourceId)

    if source == null
      this.result.fail("location references unknown source '" + location.sourceId + "'")
      return
    end
    if location.start < 0 || location.length < 0 || location.start + location.length > host::stringByteLength(source.text)
      this.result.fail("location is outside source '" + location.sourceId + "'")
    end
  end

  def defineValue(id: Int, typeName: String, defined: IntBuffer, types: StringBuffer, function: IrFunction): Void
    if id < 0 || id >= function.nextValueId
      this.result.fail("value id is outside function range in '" + function.symbol.name + "'")
      return
    end
    if defined.get(id) != 0
      this.result.fail("duplicate value %" + (id as String) + " in '" + function.symbol.name + "'")
      return
    end
    this.verifyType(typeName)
    defined.set(id, 1)
    types.set(id, typeName)
  end

  def verifyValueUse(id: Int, defined: IntBuffer, function: IrFunction): Void
    if id < 0 || id >= function.nextValueId || defined.get(id) == 0
      this.result.fail("use of undefined value %" + (id as String) + " in '" + function.symbol.name + "'")
    end
  end

  def findBlock(id: Int): IrBlock?
    let entry = this.blocks.find(id as String)

    if entry != null
      return entry.value
    end
    return null
  end

  def verifyEdge(function: IrFunction, targetId: Int, arguments: Int[], defined: IntBuffer): Void
    let target = this.findBlock(targetId)

    if target == null
      this.result.fail("branch targets unknown block in '" + function.symbol.name + "'")
      return
    end
    if arguments.Length != target.parameterCount
      this.result.fail("branch argument count does not match block parameters in '" + function.symbol.name + "'")
    end
    for argument in arguments this.verifyValueUse(argument, defined, function) end
  end

  def verifyInstruction(function: IrFunction, instruction: IrInstruction, defined: IntBuffer, types: StringBuffer): Void
    for operand in instruction.operands this.verifyValueUse(operand, defined, function) end
    for typeName in instruction.typeArguments this.verifyType(typeName) end
    this.verifyLocation(instruction.location)
    if instruction.opcode.isCFunctionAddress() || instruction.opcode.isCallCIndirect()
      if !this.module.requiredFeatures.hasCInterop()
        this.result.fail("native callable instructions require c-interop-v1")
      end
      if instruction.opcode.isCFunctionAddress()
        if instruction.operands.Length != 0 || instruction.symbol == null || !semanticIsCFunction(instruction.resultType)
          this.result.fail("native function address has an invalid shape")
        end
      else if instruction.operands.Length < 2 || instruction.symbol != null
        this.result.fail("indirect C call has an invalid shape")
      else
        let callee = instruction.operands[1]

        if callee >= 0 && callee < types.size
          let signature = types.get(callee)
          let components = semanticCFunctionComponents(signature)

          if !semanticIsCFunction(signature) || components.size + 1 != instruction.operands.Length
            this.result.fail("indirect C call has an incompatible signature")
          else
            if instruction.resultType != components.get(0)
              this.result.fail("indirect C call has an incompatible result")
            end
            var index = 1

            while index < components.size
              let operand = instruction.operands[index + 1]

              if operand >= 0 && operand < types.size && types.get(operand) != components.get(index)
                this.result.fail("indirect C call has an incompatible argument")
              end
              index = index + 1
            end
          end
        end
      end
    end
    if instruction.opcode.isConstant() && instruction.constantKind == null
      this.result.fail("constant instruction has no constant")
    end
    if !instruction.opcode.isConstant() && instruction.constantKind != null
      this.result.fail("non-constant instruction carries a constant")
    end
    if instruction.opcode.isCompare() || instruction.opcode.isPointerCompare()
      if instruction.predicate == null
        this.result.fail("comparison instruction has no valid predicate")
      end
    else if instruction.predicate != null
      this.result.fail("non-comparison instruction carries a predicate")
    end
    if instruction.opcode.requiresUnsafeCapability()
      if instruction.operands.Length == 0 || instruction.operands[0] < 0 || instruction.operands[0] >= function.nextValueId || types.get(instruction.operands[0]) != "!unsafe"
        this.result.fail("unsafe instruction has no live unsafe capability in '" + function.symbol.name + "'")
      end
    end
    if instruction.opcode.isUnsafeBegin()
      if instruction.resultType != "!unsafe" || instruction.operands.Length != 0
        this.result.fail("unsafe.begin has an invalid shape")
      end
    end
    if instruction.opcode.isBorrowBegin()
      if instruction.secondResultId < 0 || irTypeKind(instruction.secondResultType) != "borrow"
        this.result.fail("borrow.begin has no borrow token")
      end
    else if instruction.secondResultId >= 0
      this.result.fail("instruction has an unexpected second result")
    end
  end

  def verifyFunction(function: IrFunction): Void
    this.verifyTypeBuffer(function.parameterTypes)
    this.verifyType(function.resultType)
    this.verifyLocation(function.location)
    if function.cExportSymbol != ""
      if !this.module.requiredFeatures.hasCInterop() || !semanticPortableCSymbol(function.cExportSymbol) || !function.kind.isFunction() || !irCAbiType(function.resultType, true)
        this.result.fail("C export requires a portable name and a module C ABI function")
      end
      var parameter = function.parameterTypes.first.nextNode

      while parameter != null
        if !irCAbiType(parameter.value, false)
          this.result.fail("C export has an incompatible parameter type")
        end
        parameter = parameter.nextNode
      end
    end
    if function.retained
      if !this.module.requiredFeatures.hasRetainedModules()
        this.result.fail("retained function requires retained-modules-v1")
      end
      if function.blockCount != 0 || function.firstBlock != null || function.unsafeRootId >= 0 || function.nextValueId != 0 || function.debugScopeCount != 0 || function.debugLocalCount != 0
        this.result.fail("retained function '" + function.symbol.name + "' carries body state")
      end
      return
    end
    if function.blockCount == 0
      this.result.fail("function '" + function.symbol.name + "' has no blocks")
    end
    this.blocks = new StringTable<IrBlock>()
    let blockCounts = new StringTable<Int>()
    var indexedBlock = function.firstBlock

    while indexedBlock != null
      let key = indexedBlock.id as String

      this.blocks.add(key, indexedBlock)
      let entry = blockCounts.find(key)

      if entry == null
        blockCounts.add(key, 1)
      else
        entry.value = entry.value + 1
      end
      indexedBlock = indexedBlock.nextBlock
    end
    let entry = this.findBlock(function.entryBlock)

    if entry == null
      this.result.fail("function '" + function.symbol.name + "' has no entry block")
      return
    end
    let defined = new IntBuffer()
    let types = new StringBuffer()
    var index = 0

    while index < function.nextValueId
      defined.add(0)
      types.add("")
      index = index + 1
    end
    if function.unsafeRootId >= 0
      this.defineValue(function.unsafeRootId, "!unsafe", defined, types, function)
    end
    if function.unsafeCall != (function.unsafeRootId >= 0)
      this.result.fail("unsafe function root does not match unsafe-call flag")
    end
    var scope = function.firstDebugScope
    var expectedScopeId = 1

    while scope != null
      if !this.module.requiredFeatures.hasDebugScopes()
        this.result.fail("debug scope requires debug-scopes-v1")
      end
      if scope.id != expectedScopeId || scope.parentId < 0 || scope.parentId >= scope.id
        this.result.fail("invalid debug scope in '" + function.symbol.name + "'")
      end
      this.verifyLocation(scope.location)
      expectedScopeId = expectedScopeId + 1
      scope = scope.nextScope
    end
    if function.debugScopeCount != expectedScopeId - 1
      this.result.fail("debug scope count mismatch in '" + function.symbol.name + "'")
    end
    var block = function.firstBlock

    while block != null
      let countEntry = blockCounts.find(block.id as String)

      if countEntry != null
        countEntry.value = countEntry.value - 1
        var remaining = countEntry.value

        while remaining > 0
          this.result.fail("duplicate block id in '" + function.symbol.name + "'")
          remaining = remaining - 1
        end
      end
      var parameter = block.firstParameter

      while parameter != null
        this.defineValue(parameter.id, parameter.typeName, defined, types, function)
        this.verifyLocation(parameter.location)
        parameter = parameter.nextParameter
      end
      var instruction = block.firstInstruction

      while instruction != null
        this.verifyDebugScopeId(function, instruction.debugScopeId, "instruction")
        if instruction.resultId >= 0
          this.defineValue(instruction.resultId, instruction.resultType, defined, types, function)
        end
        if instruction.secondResultId >= 0
          this.defineValue(instruction.secondResultId, instruction.secondResultType, defined, types, function)
        end
        instruction = instruction.nextInstruction
      end
      block = block.nextBlock
    end
    index = 0
    while index < function.nextValueId
      if defined.get(index) == 0
        this.result.fail("missing value %" + (index as String) + " in '" + function.symbol.name + "'")
      end
      index = index + 1
    end
    var local = function.firstDebugLocal
    var localCount = 0

    while local != null
      this.verifyLocation(local.location)
      if local.value < 0 || local.value >= function.nextValueId || defined.get(local.value) == 0
        this.result.fail("debug local references an undefined value in '" + function.symbol.name + "'")
      end
      if local.scopeId < 0 || local.scopeId > function.debugScopeCount || (local.scopeId != 0 && !this.module.requiredFeatures.hasDebugScopes())
        this.result.fail("debug local references an invalid scope in '" + function.symbol.name + "'")
      end
      localCount = localCount + 1
      local = local.nextLocal
    end
    if localCount != function.debugLocalCount
      this.result.fail("debug local count mismatch in '" + function.symbol.name + "'")
    end
    if entry.parameterCount != function.parameterTypes.size
      this.result.fail("entry parameters do not match function signature")
    end
    var entryParameter = entry.firstParameter

    index = 0
    while entryParameter != null && index < function.parameterTypes.size
      if entryParameter.typeName != function.parameterTypes.get(index)
        this.result.fail("entry parameter type does not match function signature")
      end
      entryParameter = entryParameter.nextParameter
      index = index + 1
    end
    block = function.firstBlock
    while block != null
      var instruction = block.firstInstruction

      while instruction != null
        this.verifyInstruction(function, instruction, defined, types)
        instruction = instruction.nextInstruction
      end
      let terminator = block.terminator

      if terminator == null
        this.result.fail("block has no terminator in '" + function.symbol.name + "'")
      else
        this.verifyLocation(terminator.location)
        this.verifyDebugScopeId(function, terminator.debugScopeId, "terminator")
        if terminator.kind.isBranch()
          this.verifyEdge(function, terminator.firstTarget, terminator.firstArguments, defined)
        else if terminator.kind.isConditionalBranch()
          this.verifyValueUse(terminator.condition, defined, function)
          if terminator.condition >= 0 && terminator.condition < function.nextValueId && types.get(terminator.condition) != "bool"
            this.result.fail("conditional branch condition is not bool")
          end
          this.verifyEdge(function, terminator.firstTarget, terminator.firstArguments, defined)
          this.verifyEdge(function, terminator.secondTarget, terminator.secondArguments, defined)
        else if terminator.kind.isReturn()
          if function.resultType == "void" && terminator.value >= 0
            this.result.fail("void return carries a value")
          end
          if function.resultType != "void" && terminator.value < 0
            this.result.fail("non-void return has no value")
          end
          if terminator.value >= 0
            this.verifyValueUse(terminator.value, defined, function)
            if terminator.value < function.nextValueId && types.get(terminator.value) != function.resultType
              this.result.fail("return value type does not match function result")
            end
          end
        else if !terminator.kind.isPanic()
          this.result.fail("invalid terminator in '" + function.symbol.name + "'")
        end
      end
      block = block.nextBlock
    end
  end
end
