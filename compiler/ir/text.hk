class IrUtf16Cursor
  public text: String = ""
  public bytePosition: Int = 0
  public pendingLow: Int = -1

  def init(text: String): Void
    this.text = text
  end

  def hasNext(): Bool
    return this.pendingLow >= 0 || this.bytePosition < host.stringByteLength(this.text)
  end

  def nextUnit(): Int
    if this.pendingLow >= 0
      let value = this.pendingLow
      this.pendingLow = -1
      return value
    end
    let point = codePointAt(this.text, this.bytePosition)
    this.bytePosition = this.bytePosition + utf8Width(host.stringByteAt(this.text, this.bytePosition) as Int)
    if point <= 65535
      return point
    end
    let scalar = point - 65536
    this.pendingLow = 56320 + (scalar - (scalar / 1024) * 1024)
    return 55296 + scalar / 1024
  end
end

def irCompareText(left: String, right: String): Int
  let leftCursor = new IrUtf16Cursor(left)
  let rightCursor = new IrUtf16Cursor(right)
  while leftCursor.hasNext() && rightCursor.hasNext()
    let leftUnit = leftCursor.nextUnit()
    let rightUnit = rightCursor.nextUnit()
    if leftUnit < rightUnit
      return -1
    end
    if leftUnit > rightUnit
      return 1
    end
  end
  if leftCursor.hasNext()
    return 1
  end
  if rightCursor.hasNext()
    return -1
  end
  return 0
end

def irHexDigit(value: Int): String
  return host.stringSlice("0123456789abcdef", value, 1)
end

def irHex(value: String): String
  var result = ""
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    result = result + irHexDigit(byte / 16) + irHexDigit(byte - (byte / 16) * 16)
    index = index + 1
  end
  return result
end

def irHexUnsigned(value: Int, width: Int): String
  var result = ""
  var position = width - 1
  while position >= 0
    let divisor = shaPower2(position * 4)
    let digit = (value / divisor) - ((value / divisor) / 16) * 16
    result = result + irHexDigit(digit)
    position = position - 1
  end
  return result
end

def irAccessTag(access: String): Int
  if access == "public"
    return 1
  end
  if access == "private"
    return 2
  end
  if access == "protected"
    return 3
  end
  return 4
end

def irEmptyInts(): Int[]
  let result: Int[] = []
  return result
end

def irEmptyStrings(): String[]
  let result: String[] = []
  return result
end

def irLocation(start: Int, length: Int): IrLocation
  return new IrLocation(true, start, length)
end

class IrSourceMap
  public offsets: IntBuffer = new IntBuffer()
  public ascii: Bool = true
  public length: Int = 0

  def init(source: String): Void
    let byteLength = host.stringByteLength(source)
    var scan = 0
    while scan < byteLength
      if (host.stringByteAt(source, scan) as Int) >= 128
        this.ascii = false
        break
      end
      scan = scan + 1
    end
    if this.ascii
      this.length = byteLength
      return
    end
    this.offsets.add(0)
    var bytePosition = 0
    while bytePosition < host.stringByteLength(source)
      let point = codePointAt(source, bytePosition)
      let nextByte = bytePosition + utf8Width(host.stringByteAt(source, bytePosition) as Int)
      if utf16Width(point) == 2
        this.offsets.add(bytePosition)
      end
      this.offsets.add(nextByte)
      bytePosition = nextByte
    end
    this.length = this.offsets.size - 1
  end

  def utf16Length(): Int
    return this.length
  end

  def offsetAt(utf16Offset: Int): Int
    if utf16Offset < 0
      return 0
    end
    if this.ascii
      if utf16Offset > this.length
        return this.length
      end
      return utf16Offset
    end
    if utf16Offset >= this.offsets.size
      return this.offsets.get(this.offsets.size - 1)
    end
    return this.offsets.get(utf16Offset)
  end

  def location(start: Int, length: Int): IrLocation
    let byteStart = this.offsetAt(start)
    let byteEnd = this.offsetAt(start + length)
    return new IrLocation(true, byteStart, byteEnd - byteStart)
  end
end

def irUtf8Offset(source: String, utf16Offset: Int): Int
  var bytePosition = 0
  var utf16Position = 0
  while bytePosition < host.stringByteLength(source) && utf16Position < utf16Offset
    let point = codePointAt(source, bytePosition)
    bytePosition = bytePosition + utf8Width(host.stringByteAt(source, bytePosition) as Int)
    utf16Position = utf16Position + utf16Width(point)
  end
  return bytePosition
end

def irSourceLocation(source: String, start: Int, length: Int): IrLocation
  let byteStart = irUtf8Offset(source, start)
  let byteEnd = irUtf8Offset(source, start + length)
  return new IrLocation(true, byteStart, byteEnd - byteStart)
end

def irNoLocation(): IrLocation
  return new IrLocation(false, 0, 0)
end

def irSymbol(moduleName: String, kind: Int, name: String): IrSymbol
  return new IrSymbol(moduleName, kind, name)
end
