use host
use process

# One resolved plan supplies both executable cache identity and link arguments.
# This binds the selected tools, not their complete dynamically loaded closure.
class NativeLinkToolchain
  public driver: String = ""
  public linker: String = ""
  public lto: String = ""
  public identity: String = ""
  private attempted: Bool = false
  private metadata: String = ""

  def capture(target: readonly TargetPlatform): Bool
    if this.attempted
      return this.identity != ""
    end
    this.attempted = true
    let configured = host::environment("NERI_LINKER")

    if !target.isMacOS() || !runCacheSupportedHost() || configured == null || !bootstrapStartsWith(configured, "/") || !semanticEndsWith(configured, "/bin/clang++")
      return false
    end
    for variable in ["LIBRARY_PATH", "COMPILER_PATH", "GCC_EXEC_PREFIX", "CCC_OVERRIDE_OPTIONS", "DYLD_INSERT_LIBRARIES", "DYLD_LIBRARY_PATH", "DYLD_FRAMEWORK_PATH", "DYLD_FALLBACK_LIBRARY_PATH", "DYLD_FALLBACK_FRAMEWORK_PATH", "DYLD_VERSIONED_LIBRARY_PATH", "DYLD_VERSIONED_FRAMEWORK_PATH", "DYLD_ROOT_PATH", "DYLD_IMAGE_SUFFIX"]
      let value = host::environment(variable)

      if value != null && value != ""
        return false
      end
    end
    this.driver = configured
    let driverBefore = this.fileMetadata(configured)

    if driverBefore == ""
      return false
    end
    this.linker = this.query("/usr/bin/xcrun", ["--find", "ld"])
    this.lto = this.query(configured, ["--no-default-config", "-print-file-name=libLTO.dylib"])
    if this.linker == "" || this.lto == "" || this.fileMetadata(configured) != driverBefore
      return false
    end
    # Hash contents once per compilation, bracketed by metadata for the whole
    # tool set. Only this in-process plan may reuse that content observation.
    let before = this.snapshot()
    var identity = runCacheFrame("darwin-link-tools-v1")

    if before == ""
      return false
    end
    for path in [this.driver, this.linker, this.lto]
      let canonical = neriCanonicalPath(path)
      let digest = referenceFileDigest(path)

      if canonical == null || digest == ""
        return false
      end
      identity = identity + runCacheFrame(path) + runCacheFrame(runCacheFrame(canonical) + runCacheFrame(digest))
    end
    if this.snapshot() != before || this.fileMetadata(configured) != driverBefore
      return false
    end
    this.metadata = before
    this.identity = identity
    return true
  end

  def matches(): Bool
    return this.identity != "" && this.metadata != "" && this.snapshot() == this.metadata
  end

  def arguments(arguments: String[]): String[]
    var result = host::appendString(arguments, "--no-default-config")

    result = host::appendString(result, "--ld-path=" + this.linker)
    # Clang emits its default earlier; Darwin ld's last -lto_library wins.
    result = host::appendString(result, "-Xlinker")
    result = host::appendString(result, "-lto_library")
    result = host::appendString(result, "-Xlinker")
    return host::appendString(result, this.lto)
  end

  private def snapshot(): String
    var result = runCacheFrame("darwin-link-tools-v1")

    for path in [this.driver, this.linker, this.lto]
      let identity = this.fileMetadata(path)

      if identity == ""
        return ""
      end
      result = result + runCacheFrame(path) + runCacheFrame(identity)
    end
    return result
  end

  private def fileMetadata(path: String): String
    let before = new RunCacheFile(path, true)
    let canonical = neriCanonicalPath(path)
    let after = new RunCacheFile(path, true)

    if before.kind != 1 || canonical == null || before.fingerprint == "" || before.fingerprint != after.fingerprint || neriCanonicalPath(path) != canonical
      return ""
    end
    return runCacheFrame(canonical) + runCacheFrame(before.fingerprint)
  end

  private def query(executable: String, arguments: String[]): String
    let options = new process::SpawnOptions(executable)

    options.arguments = arguments
    options.stdoutLimit = 4096
    options.stderrLimit = 4096
    let started = process::spawn(options)
    let child = started.child()

    if child == null
      return ""
    end
    let completed = child.wait(10000)

    if completed.running || completed.failure != null
      child.cancel()
      child.dispose()
      return ""
    end
    let released = child.dispose()
    let exit = completed.exit
    let output = host::stringFromBytes(completed.stdout)

    if !released || exit == null || !exit.isExited() || exit.value() != 0 || completed.stdoutTruncated || output == null || !bootstrapStartsWith(output, "/")
      return ""
    end
    let length = host::stringByteLength(output)

    if length < 2 || host::stringByteAt(output, length - 1) != 10 as Byte
      return ""
    end
    var index = 0

    while index < length - 1
      let byte = host::stringByteAt(output, index) as Int

      if byte < 32 || byte == 127
        return ""
      end
      index = index + 1
    end
    let path = host::stringSlice(output, 0, length - 1)
    let canonical = neriCanonicalPath(path)

    return canonical == null ? "" : canonical
  end
end
