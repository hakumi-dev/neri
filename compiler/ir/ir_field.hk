class IrField
  public symbol: IrSymbol
  public typeName: readonly IrType
  public access: readonly IrAccess
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextField: IrField?

  def init(symbol: IrSymbol, typeName: readonly IrType, access: readonly IrAccess, location: IrLocation): Void
    this.symbol = symbol
    this.typeName = typeName
    this.access = access
    this.location = location
  end
end
