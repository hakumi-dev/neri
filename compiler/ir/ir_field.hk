class IrField
  public symbol: IrSymbol
  public typeName: String = "int"
  public access: readonly IrAccess
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextField: IrField?

  def init(symbol: IrSymbol, typeName: String, access: readonly IrAccess, location: IrLocation): Void
    this.symbol = symbol
    this.typeName = typeName
    this.access = access
    this.location = location
  end
end
