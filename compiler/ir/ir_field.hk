class IrField
  public symbol: IrSymbol = new IrSymbol("main", 2, "field")
  public typeName: String = "int"
  public access: Int = 1
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextField: IrField?

  def init(symbol: IrSymbol, typeName: String, access: Int, location: IrLocation): Void
    this.symbol = symbol
    this.typeName = typeName
    this.access = access
    this.location = location
  end
end
