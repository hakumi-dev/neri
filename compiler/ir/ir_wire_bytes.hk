use host

class IrWireBytes
  public size: Int = 0
  private first: IrWireChunk?
  private last: IrWireChunk?
  private cached: IrWireChunk?
  private cachedStart: Int = 0
  private zeroTemplate: Byte[] = []

  def init(): Void
    var index = 0

    while index < 255
      this.zeroTemplate = host.appendByte(this.zeroTemplate, 0 as Byte)
      index = index + 1
    end
  end

  def add(value: Int): Void
    let chunk = this.last

    if chunk == null || chunk.used == chunk.bytes.Length
      let created = new IrWireChunk(this.zeroTemplate)
      let tail = this.last

      if tail == null
        this.first = created
        this.cached = created
      else
        tail.next = created
      end
      this.last = created
      created.bytes[0] = value as Byte
      created.used = 1
    else
      chunk.bytes[chunk.used] = value as Byte
      chunk.used = chunk.used + 1
    end
    this.size = this.size + 1
  end

  def get(index: Int): Int
    if index < 0 || index >= this.size
      return 0
    end
    var chunk = this.cached
    var start = this.cachedStart

    if chunk == null || index < start
      chunk = this.first
      start = 0
    end
    while chunk != null && index >= start + chunk.used
      start = start + chunk.used
      chunk = chunk.next
    end
    this.cached = chunk
    this.cachedStart = start
    if chunk == null
      return 0
    end
    return chunk.bytes[index - start] as Int
  end

  def unpack(): IntBuffer
    let result = new IntBuffer()
    var chunk = this.first

    while chunk != null
      var index = 0

      while index < chunk.used
        result.add(chunk.bytes[index] as Int)
        index = index + 1
      end
      chunk = chunk.next
    end
    return result
  end

  def text(): String?
    var count = this.size / 256

    count = count + 1 if count * 256 < this.size
    return this.chunkText(this.first, count)
  end

  private def chunkText(chunk: IrWireChunk?, count: Int): String?
    if chunk == null || count == 0
      return ""
    end
    if count == 1
      if chunk.used == chunk.bytes.Length
        return host.stringFromBytes(chunk.bytes)
      end
      var bytes: Byte[] = []
      var index = 0

      while index < chunk.used
        bytes = host.appendByte(bytes, chunk.bytes[index])
        index = index + 1
      end
      return host.stringFromBytes(bytes)
    end
    let leftCount = count / 2
    var rightChunk: IrWireChunk? = chunk
    var index = 0

    while index < leftCount && rightChunk != null
      rightChunk = rightChunk.next
      index = index + 1
    end
    let left = this.chunkText(chunk, leftCount)
    let right = this.chunkText(rightChunk, count - leftCount)

    if left == null || right == null
      return null
    end
    return left + right
  end
end
