use host
use files
use crypto

class RunCacheStorage
  public directory: String = ""
  private root: String = ""
  private namespaceDirectory: String = ""
  private keyDirectory: String = ""
  private reserved: Bool = false

  private def privateDirectory(path: String): Bool
    let info = new RunCacheFile(path, false)

    return info.kind == 2 && info.owned && info.permissions == 448
  end

  private def hexadecimal(text: String, length: Int): Bool
    return false if host::stringByteLength(text) != length
    var index = 0

    while index < length
      let byte = host::stringByteAt(text, index) as Int

      return false if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102))
      index = index + 1
    end
    return true
  end

  private def parents(): Bool
    return this.root != "" && this.privateDirectory(this.root) && this.privateDirectory(this.namespaceDirectory) && this.privateDirectory(this.keyDirectory)
  end

  def setup(root: String, key: String): Bool
    this.directory = ""
    this.reserved = false
    this.root = ""
    if !this.hexadecimal(key, 64) || !this.privateDirectory(root)
      return false
    end
    this.root = root
    this.namespaceDirectory = root + "/artifacts-v2"
    this.keyDirectory = this.namespaceDirectory + "/" + key
    files::createDirectory(this.namespaceDirectory)

    return false if !this.privateDirectory(this.namespaceDirectory)
    files::createDirectory(this.keyDirectory)
    return this.parents()
  end

  def selected(): String
    return "" if !this.parents()
    let path = this.keyDirectory + "/selected"
    let before = new RunCacheFile(path, false)

    return "" if !before.owned || before.kind != 1
    let read = files::readBytes(path, 64)
    let bytes = read.bytes

    return "" if read.failure != null || read.closeFailure != null || bytes == null
    let text = host::stringFromBytes(bytes)
    let after = new RunCacheFile(path, false)

    if text == null || host::stringByteLength(text) != 44 || !bootstrapStartsWith(text, "generation.") || host::stringByteAt(text, 43) != (10 as Byte) || !this.hexadecimal(host::stringSlice(text, 11, 32), 32) || !after.owned || after.kind != 1 || before.fingerprint != after.fingerprint
      return ""
    end
    let selected = this.keyDirectory + "/" + host::stringSlice(text, 0, 43)

    return this.parents() && this.privateDirectory(selected) ? selected : ""
  end

  def reserve(): Bool
    return false if !this.parents()
    return true if this.reserved
    let entropy = crypto::randomBytes(16).bytes()

    return false if entropy == null
    let encoded = crypto::encodeHex(entropy)

    return false if encoded == null || !this.hexadecimal(encoded, 32)
    let destination = this.keyDirectory + "/generation." + encoded
    let observed = files::status(destination)
    let status = observed.status

    return false if observed.failure != null || status == null || status.exists || status.symlink
    this.directory = destination
    this.reserved = true
    return true
  end

  def publish(staging: String): Bool
    if !this.reserved || !this.parents() || !this.privateDirectory(staging)
      return false
    end
    let observed = files::status(this.directory)
    let status = observed.status
    let program = new RunCacheFile(staging + "/program", false)
    let receipt = new RunCacheFile(staging + "/receipt", false)

    if observed.failure != null || status == null || status.exists || status.symlink || !program.owned || program.kind != 1 || !receipt.owned || receipt.kind != 1
      return false
    end
    # A completed generation is nonempty and is never replaced or removed.
    if files::move(staging, this.directory).failure != null
      return false
    end
    this.reserved = false
    let name = host::pathFileName(this.directory)

    if name != null && this.parents() && this.privateDirectory(this.directory)
      let temporary = this.directory + "/selection.pending"
      let checked = files::status(temporary)
      let temporaryStatus = checked.status

      if checked.failure == null && temporaryStatus != null && !temporaryStatus.exists && !temporaryStatus.symlink && host::writeText(temporary, name + "\n")
        let info = new RunCacheFile(temporary, false)

        if info.owned && info.kind == 1
          files::move(temporary, this.keyDirectory + "/selected")
        end
      end
    end
    # Once moved, callers must use the final path even if pointer promotion
    # failed. The previous selector and its readers remain untouched.
    return true
  end
end
