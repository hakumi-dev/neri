use console
use host

def neriVersion(): String
  return "0.2.0-dev"
end

class BootstrapSourceInput
  public path: String = ""
  public id: String = "main"
  public text: String = ""
  public emitted: Bool = false
  public nextInput: BootstrapSourceInput?

  def init(path: String, id: String, text: String): Void
    this.path = path
    this.id = id
    this.text = text
  end
end

def bootstrapSpaces(count: Int): String
  var result = ""
  var index = 0
  while index < count
    result = result + " "
    index = index + 1
  end
  return result
end

def bootstrapCarets(count: Int): String
  var result = ""
  var index = 0
  while index < count
    result = result + "^"
    index = index + 1
  end
  return result
end

def bootstrapExpandTabs(value: String): String
  var result = ""
  var column = 0
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    if byte == 9
      let spaces = 4 - (column - (column / 4) * 4)
      result = result + bootstrapSpaces(spaces)
      column = column + spaces
      index = index + 1
    else
      let width = utf8Width(byte)
      result = result + host.stringSlice(value, index, width)
      column = column + utf16Width(codePointAt(value, index))
      index = index + width
    end
  end
  return result
end

def bootstrapVisualColumn(value: String): Int
  return (new IrSourceMap(bootstrapExpandTabs(value))).utf16Length() + 1
end

def irEmitDiagnostics(diagnostics: DiagnosticBuffer, phase: String, sourcePaths: StringBuffer, sourceTexts: StringBuffer, sourceStarts: IntBuffer): Void
  console.println(phase + ": FAILED")
  let emitted = new IntBuffer()
  var index = 0
  while index < diagnostics.count()
    emitted.add(0)
    index = index + 1
  end
  index = 0
  while index < diagnostics.count()
    var selected = -1
    var candidate = 0
    while candidate < diagnostics.count()
      if emitted.get(candidate) == 0 && (selected < 0 || diagnostics.starts.get(candidate) < diagnostics.starts.get(selected) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) < diagnostics.lengths.get(selected)) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) == diagnostics.lengths.get(selected) && irCompareText(diagnostics.codes.get(candidate), diagnostics.codes.get(selected)) < 0) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) == diagnostics.lengths.get(selected) && diagnostics.codes.get(candidate) == diagnostics.codes.get(selected) && irCompareText(diagnostics.messages.get(candidate), diagnostics.messages.get(selected)) < 0))
        selected = candidate
      end
      candidate = candidate + 1
    end
    emitted.set(selected, 1)
    let absoluteStart = diagnostics.starts.get(selected)
    var sourceIndex = 0
    while sourceIndex + 1 < sourceStarts.size && sourceStarts.get(sourceIndex + 1) <= absoluteStart
      sourceIndex = sourceIndex + 1
    end
    let source = sourceTexts.get(sourceIndex)
    let localStart = absoluteStart - sourceStarts.get(sourceIndex)
    let byteStart = (new IrSourceMap(source)).offsetAt(localStart)
    var line = 1
    var lineStart = 0
    var scan = 0
    while scan < byteStart
      if (host.stringByteAt(source, scan) as Int) == 10
        line = line + 1
        lineStart = scan + 1
      end
      scan = scan + 1
    end
    var lineEnd = lineStart
    while lineEnd < host.stringByteLength(source) && (host.stringByteAt(source, lineEnd) as Int) != 10 && (host.stringByteAt(source, lineEnd) as Int) != 13
      lineEnd = lineEnd + 1
    end
    let rawLine = host.stringSlice(source, lineStart, lineEnd - lineStart)
    let prefix = host.stringSlice(source, lineStart, byteStart - lineStart)
    let column = bootstrapVisualColumn(prefix)
    console.println(sourcePaths.get(sourceIndex) + ":" + (line as String) + ":" + (column as String) + " error " + diagnostics.codes.get(selected) + ": " + diagnostics.messages.get(selected))
    console.println(bootstrapExpandTabs(rawLine))
    console.println(bootstrapSpaces(column - 1) + bootstrapCarets(diagnostics.lengths.get(selected)))
    index = index + 1
  end
end

def bootstrapStartsWith(value: String, prefix: String): Bool
  let valueLength = host.stringByteLength(value)
  let prefixLength = host.stringByteLength(prefix)
  if prefixLength > valueLength
    return false
  end
  return host.stringSlice(value, 0, prefixLength) == prefix
end

def bootstrapSourceId(path: String, sourceRoot: String, singleDefault: Bool): String
  if sourceRoot == "" && singleDefault
    return "main"
  end
  var root = sourceRoot
  while root != "/" && semanticEndsWith(root, "/")
    root = host.stringSlice(root, 0, host.stringByteLength(root) - 1)
  end
  if root == "/" && bootstrapStartsWith(path, "/")
    return host.stringSlice(path, 1, host.stringByteLength(path) - 1)
  end
  if root != "" && bootstrapStartsWith(path, root + "/")
    return host.stringSlice(path, host.stringByteLength(root) + 1, host.stringByteLength(path) - host.stringByteLength(root) - 1)
  end
  if bootstrapStartsWith(path, "./")
    return host.stringSlice(path, 2, host.stringByteLength(path) - 2)
  end
  return path
end

def bootstrapPathWithin(root: String, path: String): Bool
  return path == root || bootstrapStartsWith(path, root == "/" ? "/" : root + "/")
end

def bootstrapCommonSourceRoot(first: BootstrapSourceInput?): String
  let initial = first
  if initial == null
    return ""
  end
  var root = bootstrapDirectory(initial.path)
  var source = initial.nextInput
  while source != null
    while !bootstrapPathWithin(root, source.path) && root != "/"
      root = bootstrapDirectory(root)
    end
    source = source.nextInput
  end
  return root
end

def bootstrapNextSource(first: BootstrapSourceInput?): BootstrapSourceInput?
  var best: BootstrapSourceInput? = null
  var current = first
  while current != null
    if !current.emitted && (best == null || irCompareText(current.id, best.id) < 0)
      best = current
    end
    current = current.nextInput
  end
  return best
end

def bootstrapUsage(): Void
  console.println("neri lsp starts the editor-independent language server over stdio.")
  console.println("Use --project <neri.json> [--unit <name>] instead of explicit source files to compile a unit and its references.")
  console.println("usage: neri [build|check|run] [--module <name>] [--source-root <dir>] [--target <target>] [--release] [--no-cache] [--timings] [--emit=neri-ir|neri-ir-hex|llvm-ir|asm|obj|executable] [--output <path>] <source.hk>... [-- <program arguments>]")
  console.println("A source file without a command is run. Native targets default to the installed runtime target.")
  console.println("neri build main.hk creates ./main; use --output to choose another path. neri --version prints the version.")
end

def bootstrapValidEmit(emit: String): Bool
  return emit == "neri-ir" || emit == "neri-ir-hex" || emit == "llvm-ir" || emit == "asm" || emit == "obj" || emit == "executable"
end

def bootstrapWriteArtifact(output: String, artifact: String): Bool
  if output == "" || output == "-"
    console.print(artifact)
    return true
  end
  if host.writeText(output, artifact)
    return true
  end
  console.println("could not write output: " + host.errorMessage())
  return false
end
