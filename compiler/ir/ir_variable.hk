class IrVariable
  public identity: String = ""
  public symbolKind: readonly IrSymbolKind
  public name: String = ""
  public typeName: String = "int"
  public value: Int = -1
  public mutable: Bool = false
  public active: Bool = true
  public depth: Int = 0
  public addressedPointer: Int = -1
  public addressedDepth: Int = -1
  public declarationLocation: IrLocation = new IrLocation(false, 0, 0)
  public debugScopeId: Int = 0
  public nextVariable: IrVariable?

  def init(identity: String, symbolKind: readonly IrSymbolKind, name: String, typeName: String, value: Int, mutable: Bool, depth: Int, declarationLocation: IrLocation): Void
    this.identity = identity
    this.symbolKind = symbolKind
    this.name = name
    this.typeName = typeName
    this.value = value
    this.mutable = mutable
    this.depth = depth
    this.declarationLocation = declarationLocation
  end
end
