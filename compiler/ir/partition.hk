class IrCompilationUnit
  public module: IrModule
  public owner: String
  public next: IrCompilationUnit?

  def init(module: IrModule, owner: String): Void
    this.module = module
    this.owner = owner
  end
end

def irPartitionLocation(value: IrLocation): IrLocation
  let result = new IrLocation(value.present, value.start, value.length)

  result.sourceId = value.sourceId
  return result
end

def irPartitionSymbol(value: IrSymbol): IrSymbol
  return new IrSymbol(value.moduleName, value.kind, value.name)
end

def irPartitionOptionalSymbol(value: IrSymbol?): IrSymbol?
  if value == null
    return null
  end
  return irPartitionSymbol(value)
end

def irPartitionFunction(value: IrFunction): IrFunction
  let result = new IrFunction(irPartitionSymbol(value.symbol), value.resultType, value.kind, value.unsafeCall, irPartitionLocation(value.location))

  result.effects = value.effects
  result.cExportSymbol = value.cExportSymbol
  result.localEffects = value.localEffects
  result.entryBlock = value.entryBlock
  result.unsafeRootId = value.unsafeRootId
  result.declaringClass = irPartitionOptionalSymbol(value.declaringClass)
  result.dispatchSlot = irPartitionOptionalSymbol(value.dispatchSlot)
  result.nextBlockId = value.nextBlockId
  result.nextValueId = value.nextValueId
  result.nextDebugScopeId = value.nextDebugScopeId
  result.parallelUnsafe = value.parallelUnsafe
  result.parameterTypes = value.parameterTypes
  # Blocks, parameters, instructions and terminators have no serializer state;
  # only the function wrapper and debug lists must be independent per unit.
  result.firstBlock = value.firstBlock
  result.lastBlock = value.lastBlock
  result.blockCount = value.blockCount
  var scope = value.firstDebugScope

  while scope != null
    let copiedScope = new IrDebugScope(scope.id, scope.parentId, irPartitionLocation(scope.location))
    let last = result.lastDebugScope

    if last == null
      result.firstDebugScope = copiedScope
    else
      last.nextScope = copiedScope
    end
    result.lastDebugScope = copiedScope
    result.debugScopeCount = result.debugScopeCount + 1
    scope = scope.nextScope
  end
  var local = value.firstDebugLocal

  while local != null
    result.addDebugLocal(new IrDebugLocal(local.name, local.value, irPartitionLocation(local.location), local.scopeId))
    local = local.nextLocal
  end
  result.callees = value.callees
  result.parallelCallees = value.parallelCallees
  return result
end

def irPartitionClass(value: IrClass): IrClass
  let result = new IrClass(irPartitionSymbol(value.symbol), irPartitionOptionalSymbol(value.baseSymbol), value.access, irPartitionLocation(value.location))

  result.declarationSourceId = value.declarationSourceId
  result.firstField = value.firstField
  result.lastField = value.lastField
  result.fieldCount = value.fieldCount
  result.firstMethod = value.firstMethod
  result.lastMethod = value.lastMethod
  result.methodCount = value.methodCount
  return result
end

def irPartitionImport(value: IrImport): IrImport
  let result = new IrImport(irPartitionSymbol(value.symbol), value.resultType, value.kind, value.linkName, value.effects, irPartitionLocation(value.location))

  result.nativeLibrary = value.nativeLibrary
  result.runtimeMajor = value.runtimeMajor
  result.runtimeMinor = value.runtimeMinor
  result.runtimeFeatures = value.runtimeFeatures
  var parameter = value.parameterTypes.first.nextNode

  while parameter != null
    result.parameterTypes.add(parameter.value)
    parameter = parameter.nextNode
  end
  return result
end

def irPartitionHasName(values: StringBuffer, name: String): Bool
  var value = values.first.nextNode

  while value != null
    if value.value == name
      return true
    end
    value = value.nextNode
  end
  return false
end

def irPartitionSourceOwner(sourceId: String, sourceIds: StringBuffer, sourceOwners: StringBuffer): String?
  var source = sourceIds.first.nextNode
  var owner = sourceOwners.first.nextNode

  while source != null && owner != null
    if source.value == sourceId
      return owner.value
    end
    source = source.nextNode
    owner = owner.nextNode
  end
  return null
end

def irPartitionClassConsumer(semantic: SemanticModel, name: String): Bool
  let value = semantic.findClass(name)

  return value != null && (value.genericOrigin >= 0 || value.isClosure || value.syntaxNode < 0)
end

def irPartitionClassByName(module: IrModule, name: String): IrClass?
  var value = module.firstClass

  while value != null
    if value.symbol.name == name
      return value
    end
    value = value.nextClass
  end
  return null
end

def irPartitionClassOwner(value: IrClass, sourceIds: StringBuffer, sourceOwners: StringBuffer): String?
  if value.declarationSourceId != ""
    return irPartitionSourceOwner(value.declarationSourceId, sourceIds, sourceOwners)
  end
  return irPartitionOwner(value.location, sourceIds, sourceOwners)
end

def irPartitionFunctionConsumer(semantic: SemanticModel, value: IrFunction): Bool
  let classSymbol = value.declaringClass

  if classSymbol != null && irPartitionClassConsumer(semantic, classSymbol.name)
    return true
  end
  let callable = semantic.findFunction(value.symbol.name)

  return callable != null && callable.genericOrigin >= 0
end

def irPartitionOwner(location: IrLocation, sourceIds: StringBuffer, sourceOwners: StringBuffer): String?
  if !location.present
    return null
  end
  let owner = irPartitionSourceOwner(location.sourceId, sourceIds, sourceOwners)

  if owner == null || owner == ""
    return null
  end
  return owner
end

def irPartitionFindUnit(first: IrCompilationUnit?, owner: String): IrCompilationUnit?
  var current = first

  while current != null
    if current.owner == owner
      return current
    end
    current = current.next
  end
  return null
end

def irPartitionNewUnit(module: IrModule, owner: String, entry: Bool): IrCompilationUnit
  let result = new IrModule(module.id, "")

  result.clearSources()
  result.retainedParent = module
  if entry
    var feature = module.requiredFeatures.first.nextNode

    while feature != null
      result.requireFeature(feature.value)
      feature = feature.nextNode
    end
  else if module.hasFeature("debug-scopes-v1")
    result.requireFeature("debug-scopes-v1")
  end
  result.requireFeature("retained-modules-v1")
  result.requireFeature("c-interop-v1") if module.hasFeature("c-interop-v1")
  return new IrCompilationUnit(result, owner)
end

def irPartitionAddSource(unit: IrCompilationUnit, original: IrModule, sourceId: String): Void
  if sourceId == ""
    return
  end
  var existing = unit.module.firstSource

  while existing != null
    if existing.id == sourceId
      return
    end
    existing = existing.nextSource
  end
  var source = original.firstSource

  while source != null
    if source.id == sourceId
      unit.module.addSource(new IrSource(source.id, source.text, source.globalStart, source.map))
      return
    end
    source = source.nextSource
  end
end

def irPartitionNeedLocation(unit: IrCompilationUnit, original: IrModule, value: IrLocation): Void
  if value.present
    irPartitionAddSource(unit, original, value.sourceId)
  end
end

def irPartitionNeedFunctionLocations(unit: IrCompilationUnit, original: IrModule, value: IrFunction): Void
  irPartitionNeedLocation(unit, original, value.location)
  var block = value.firstBlock

  while block != null
    var parameter = block.firstParameter

    while parameter != null
      irPartitionNeedLocation(unit, original, parameter.location)
      parameter = parameter.nextParameter
    end
    var instruction = block.firstInstruction

    while instruction != null
      irPartitionNeedLocation(unit, original, instruction.location)
      instruction = instruction.nextInstruction
    end
    let terminator = block.terminator

    if terminator != null
      irPartitionNeedLocation(unit, original, terminator.location)
    end
    block = block.nextBlock
  end
  var scope = value.firstDebugScope

  while scope != null
    irPartitionNeedLocation(unit, original, scope.location)
    scope = scope.nextScope
  end
  var local = value.firstDebugLocal

  while local != null
    irPartitionNeedLocation(unit, original, local.location)
    local = local.nextLocal
  end
end

def irPartitionNeedDependencies(unit: IrCompilationUnit, function: IrFunction, globals: StringBuffer, imports: StringBuffer): Void
  var block = function.firstBlock

  while block != null
    var instruction = block.firstInstruction

    while instruction != null
      let symbol = instruction.symbol

      unit.module.requireFeature("scoped-tasks-v1") if instruction.opcode == 61
      if instruction.constantKind == 7 && !irPartitionHasName(globals, instruction.constantValue)
        globals.add(instruction.constantValue)
      end
      if symbol != null && symbol.kind == 9 && !irPartitionHasName(globals, symbol.name)
        globals.add(symbol.name)
      end
      # Imports use their declaration name but C ABI call instructions carry
      # function-kind symbols, so select declarations by name rather than kind.
      if symbol != null && symbol.kind != 9 && !irPartitionHasName(imports, symbol.name)
        imports.add(symbol.name)
      end
      instruction = instruction.nextInstruction
    end
    block = block.nextBlock
  end
end

def irPartitionCopyDependencies(unit: IrCompilationUnit, original: IrModule, entry: Bool): Void
  let globals = new StringBuffer()
  let imports = new StringBuffer()
  var function = unit.module.firstFunction

  while function != null
    if !function.retained
      irPartitionNeedDependencies(unit, function, globals, imports)
    end
    function = function.nextFunction
  end
  var global = original.firstGlobal

  while global != null
    if irPartitionHasName(globals, global.symbol.name)
      unit.module.addGlobal(new IrGlobal(irPartitionSymbol(global.symbol), global.value, irNoLocation()))
      unit.module.requireFeature("native-strings-v1")
      unit.module.requireFeature("string-data-v1")
    end
    global = global.nextGlobal
  end
  var importValue = original.firstImport

  while importValue != null
    if entry || irPartitionHasName(imports, importValue.symbol.name)
      let copied = irPartitionImport(importValue)

      copied.location = irNoLocation()
      unit.module.addImport(copied)
      unit.module.requireFeature("native-libraries-v1") if copied.nativeLibrary != ""
    end
    importValue = importValue.nextImport
  end
end

def irPartitionHasConsumerEntry(module: IrModule, sourceIds: StringBuffer, sourceOwners: StringBuffer, consumerOwner: String): Bool
  var entries = 0
  var classValue = module.firstClass

  while classValue != null
    if classValue.retained
      return false
    end
    classValue = classValue.nextClass
  end
  var function = module.firstFunction

  while function != null
    if function.retained
      return false
    end
    if function.symbol.kind == 4 && function.symbol.name == "main" && function.kind == 1 && function.parameterTypes.size == 0 && function.resultType == "void"
      entries = entries + 1
      let owner = irPartitionOwner(function.location, sourceIds, sourceOwners)

      if owner == null || owner != consumerOwner
        return false
      end
    end
    function = function.nextFunction
  end
  return entries == 1
end

def irPartitionModule(module: IrModule, semantic: SemanticModel, sourceIds: StringBuffer, sourceOwners: StringBuffer, consumerOwner: String): IrCompilationUnit?
  if sourceIds.size != sourceOwners.size || consumerOwner == "" || module.sessionEntry != null
    return null
  end
  if !irPartitionHasConsumerEntry(module, sourceIds, sourceOwners, consumerOwner)
    return null
  end
  var first: IrCompilationUnit? = null
  var last: IrCompilationUnit? = null
  let consumer = irPartitionNewUnit(module, consumerOwner, true)

  first = consumer
  last = consumer
  var classValue = module.firstClass

  while classValue != null
    let declaredOwner = irPartitionClassOwner(classValue, sourceIds, sourceOwners)
    var owner = consumerOwner

    if declaredOwner != null && !irPartitionClassConsumer(semantic, classValue.symbol.name)
      owner = declaredOwner
    end
    let existing = irPartitionFindUnit(first, owner)
    var unit = existing

    if unit == null
      let created = irPartitionNewUnit(module, owner, false)
      let tail = last

      if tail == null
        return null
      end
      tail.next = created
      last = created
      unit = created
    end
    if unit == null
      return null
    end
    unit.module.addClass(irPartitionClass(classValue))
    irPartitionAddSource(unit, module, classValue.declarationSourceId)
    irPartitionNeedLocation(unit, module, classValue.location)
    var field = classValue.firstField

    while field != null
      irPartitionNeedLocation(unit, module, field.location)
      field = field.nextField
    end
    var method = classValue.firstMethod

    while method != null
      irPartitionNeedLocation(unit, module, method.location)
      method = method.nextMethod
    end
    classValue = classValue.nextClass
  end
  var function = module.firstFunction

  while function != null
    var owner = irPartitionOwner(function.location, sourceIds, sourceOwners)
    let declaringClass = function.declaringClass

    if declaringClass != null
      let classValue = irPartitionClassByName(module, declaringClass.name)

      if classValue == null
        return null
      end
      owner = irPartitionClassOwner(classValue, sourceIds, sourceOwners)
      owner = consumerOwner if irPartitionClassConsumer(semantic, declaringClass.name)
    end

    if irPartitionFunctionConsumer(semantic, function)
      owner = consumerOwner
    end
    if owner == null
      return null
    end
    let existing = irPartitionFindUnit(first, owner)
    var unit = existing

    if unit == null
      let created = irPartitionNewUnit(module, owner, false)
      let tail = last

      if tail == null
        return null
      end
      tail.next = created
      last = created
      unit = created
    end
    if unit == null
      return null
    end
    let copied = irPartitionFunction(function)

    unit.module.addFunction(copied)
    irPartitionNeedFunctionLocations(unit, module, copied)
    function = function.nextFunction
  end
  let retainedLowerer = new IrLowerer(new SemanticModel(), new SyntaxArena(), "", module.id)
  var unit = first

  while unit != null
    irPartitionCopyDependencies(unit, module, unit.owner == consumerOwner)
    retainedLowerer.retainDeclarations(unit.module, module)
    unit = unit.next
  end
  return first
end
