sealed class IrTypePool
  private kinds: readonly IrTypeKindCatalog
  private entries: StringTable<readonly IrType> = new StringTable<readonly IrType>()
  private semanticEntries: StringTable<readonly IrType> = new StringTable<readonly IrType>()
  private scalars: (readonly IrType)[]

  def init(kinds: readonly IrTypeKindCatalog? = null): Void
    if kinds == null
      this.kinds = new IrTypeKindCatalog()
    else
      this.kinds = kinds
    end
    this.scalars = [IrType.scalar(this.kinds.getVoid()), IrType.scalar(this.kinds.getBool()), IrType.scalar(this.kinds.getByte()), IrType.scalar(this.kinds.getInt()), IrType.scalar(this.kinds.getFloat()), IrType.scalar(this.kinds.getString()), IrType.scalar(this.kinds.getInt32()), IrType.scalar(this.kinds.getUint32()), IrType.scalar(this.kinds.getUint64()), IrType.scalar(this.kinds.getFloat32()), IrType.scalar(this.kinds.getUnsafeCapability())]
  end

  def voidType(): readonly IrType
    return this.scalars[0]
  end

  def boolType(): readonly IrType
    return this.scalars[1]
  end

  def byteType(): readonly IrType
    return this.scalars[2]
  end

  def intType(): readonly IrType
    return this.scalars[3]
  end

  def floatType(): readonly IrType
    return this.scalars[4]
  end

  def stringType(): readonly IrType
    return this.scalars[5]
  end

  def int32Type(): readonly IrType
    return this.scalars[6]
  end

  def uint32Type(): readonly IrType
    return this.scalars[7]
  end

  def uint64Type(): readonly IrType
    return this.scalars[8]
  end

  def float32Type(): readonly IrType
    return this.scalars[9]
  end

  def unsafeType(): readonly IrType
    return this.scalars[10]
  end

  private def unary(kind: readonly IrTypeKind, element: readonly IrType): readonly IrType
    let key = kind.displayName() + "|" + element.canonicalKey()
    let found = this.entries.find(key)

    if found != null
      return found.value
    end
    let result = IrType.unary(kind, element)

    this.entries.add(key, result)
    return result
  end

  def array(element: readonly IrType): readonly IrType
    return this.unary(this.kinds.getArray(), element)
  end

  def optional(element: readonly IrType): readonly IrType
    return this.unary(this.kinds.getOptional(), element)
  end

  def pointer(element: readonly IrType): readonly IrType
    return this.unary(this.kinds.getPointer(), element)
  end

  def borrowType(element: readonly IrType): readonly IrType
    return this.unary(this.kinds.getBorrowCapability(), element)
  end

  private def nominal(kind: readonly IrTypeKind, name: String): readonly IrType
    let key = kind.displayName() + "|" + name
    let found = this.entries.find(key)

    if found != null
      return found.value
    end
    let result = IrType.nominal(kind, name)

    this.entries.add(key, result)
    return result
  end

  def classType(name: String): readonly IrType
    return this.nominal(this.kinds.getClass(), name)
  end

  def record(name: String): readonly IrType
    return this.nominal(this.kinds.getNativeRecord(), name)
  end

  def fixedArray(element: readonly IrType, count: Int): readonly IrType
    let key = "fixed-array|" + (count as String) + "|" + element.canonicalKey()
    let found = this.entries.find(key)

    if found != null
      return found.value
    end
    let result = IrType.fixedArray(this.kinds.getFixedArray(), element, count)

    this.entries.add(key, result)
    return result
  end

  def cFunction(resultType: readonly IrType, parameters: (readonly IrType)[]): readonly IrType
    var key = "c-function|" + (parameters.Length as String) + "|" + (host::stringByteLength(resultType.canonicalKey()) as String) + ":" + resultType.canonicalKey()

    for parameter in parameters
      key = key + "|" + (host::stringByteLength(parameter.canonicalKey()) as String) + ":" + parameter.canonicalKey()
    end
    let found = this.entries.find(key)

    if found != null
      return found.value
    end
    let result = IrType.cFunction(this.kinds.getCFunction(), resultType, parameters)

    this.entries.add(key, result)
    return result
  end

  # This is the sole boundary from the semantic type encoding to structural IR.
  def fromSemantic(typeName: String): readonly IrType
    let found = this.semanticEntries.find(typeName)

    if found != null
      return found.value
    end
    let result = this.convertSemantic(typeName)

    this.semanticEntries.add(typeName, result)
    return result
  end

  private def convertSemantic(typeName: String): readonly IrType
    if semanticIsReadonly(typeName)
      return this.fromSemantic(semanticMutableType(typeName))
    end
    if semanticIsCFunction(typeName)
      let components = semanticCFunctionComponents(typeName)
      let result = this.fromSemantic(components.get(0))
      var parameters: (readonly IrType)[] = []
      var index = 1

      while index < components.size
        parameters = irAppendType(parameters, this.fromSemantic(components.get(index)))
        index = index + 1
      end
      return this.cFunction(result, parameters)
    end
    if typeName == "Void"
      return this.voidType()
    end
    if typeName == "Bool"
      return this.boolType()
    end
    if typeName == "Byte"
      return this.byteType()
    end
    if typeName == "Int"
      return this.intType()
    end
    if typeName == "Float"
      return this.floatType()
    end
    if typeName == "String"
      return this.stringType()
    end
    if typeName == "Int32"
      return this.int32Type()
    end
    if typeName == "UInt32"
      return this.uint32Type()
    end
    if typeName == "UInt64"
      return this.uint64Type()
    end
    if typeName == "Float32"
      return this.float32Type()
    end
    if semanticIsArray(typeName)
      return this.array(this.fromSemantic(semanticInnerType(typeName)))
    end
    if semanticIsOptional(typeName)
      return this.optional(this.fromSemantic(semanticInnerType(typeName)))
    end
    if semanticIsPointer(typeName)
      return this.pointer(this.fromSemantic(semanticInnerType(typeName)))
    end
    if nativeFixedArray(typeName)
      return this.fixedArray(this.fromSemantic(nativeArrayInner(typeName)), nativeArrayCount(typeName))
    end
    if nativeRecordType(typeName)
      return this.record(nativeRecordName(typeName))
    end
    return this.classType(typeName)
  end
end
