class IrParameter
  public id: Int = 0
  public typeName: readonly IrType
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextParameter: IrParameter?

  def init(id: Int, typeName: readonly IrType, location: IrLocation): Void
    this.id = id
    this.typeName = typeName
    this.location = location
  end
end
