class IrCleanup
  public kind: readonly IrCleanupKind
  public capability: Int = -1
  public token: Int = -1
  public ownedValue: Int = -1
  public resourceType: String = ""
  public identity: String = ""
  public active: Bool = true
  public previous: IrCleanup?

  def init(kind: readonly IrCleanupKind, capability: Int, token: Int, previous: IrCleanup?): Void
    this.kind = kind
    this.capability = capability
    this.token = token
    this.previous = previous
  end
end
