class IrFunctionContext
  public domains: IrDomainCatalog
  public function: IrFunction
  public current: IrBlock
  public firstVariable: IrVariable?
  public lastVariable: IrVariable?
  public scopeDepth: Int = 0
  public terminated: Bool = false
  public unsafeCapabilities: IntBuffer = new IntBuffer()
  public unsafeDepth: Int = 0
  public cleanup: IrCleanup?
  public cleanupDepth: Int = 0
  public closeFailures: Int = -1
  public loop: IrLoopFrame?
  public thisOverride: Int = -1
  public thisOverrideType: String = ""
  public debugScopeId: Int = 0
  public debugScopeStack: IntBuffer = new IntBuffer()

  def init(domains: IrDomainCatalog, function: IrFunction, entry: IrBlock): Void
    this.domains = domains
    this.function = function
    this.current = entry
  end

  def pushCleanup(kind: readonly IrCleanupKind, capability: Int, token: Int): Void
    this.cleanup = new IrCleanup(kind, capability, token, this.cleanup)
    this.cleanupDepth = this.cleanupDepth + 1
  end

  def pushResourceCleanup(ownedValue: Int, resourceType: String, identity: String): Void
    let cleanup = new IrCleanup(this.domains.cleanupKind.getCloseResource(), -1, -1, this.cleanup)

    cleanup.ownedValue = ownedValue
    cleanup.resourceType = resourceType
    cleanup.identity = identity
    this.cleanup = cleanup
    this.cleanupDepth = this.cleanupDepth + 1
  end

  def releaseResourceCleanup(identity: String): Void
    var current = this.cleanup

    while current != null
      if current.kind.isCloseResource() && current.identity == identity
        current.active = false
        return
      end
      current = current.previous
    end
  end

  def popCleanup(): Void
    let currentCleanup = this.cleanup

    if currentCleanup != null
      this.cleanup = currentCleanup.previous
    end
    this.cleanupDepth = this.cleanupDepth - 1
  end

  def enterScope(location: IrLocation): Void
    if this.debugScopeStack.size == this.scopeDepth
      this.debugScopeStack.add(this.debugScopeId)
    else
      this.debugScopeStack.set(this.scopeDepth, this.debugScopeId)
    end
    this.scopeDepth = this.scopeDepth + 1
    if location.present && location.length > 0
      let scope = this.function.addDebugScope(this.debugScopeId, location)

      this.debugScopeId = scope.id
    end
  end

  def leaveScope(): Void
    var variable = this.firstVariable

    while variable != null
      if variable.depth == this.scopeDepth
        variable.active = false
      end
      variable = variable.nextVariable
    end
    this.scopeDepth = this.scopeDepth - 1
    this.debugScopeId = this.debugScopeStack.get(this.scopeDepth)
  end

  def addVariable(identity: String, symbolKind: readonly IrSymbolKind, name: String, typeName: String, value: Int, mutable: Bool, declarationLocation: IrLocation): IrVariable
    let variable = new IrVariable(identity, symbolKind, name, typeName, value, mutable, this.scopeDepth, declarationLocation)

    variable.debugScopeId = this.debugScopeId
    if this.firstVariable == null
      this.firstVariable = variable
    else
      let last = this.lastVariable

      if last != null
        last.nextVariable = variable
      end
    end
    this.lastVariable = variable
    if declarationLocation.present
      this.function.addDebugLocal(new IrDebugLocal(name, value, declarationLocation, this.debugScopeId))
    end
    return variable
  end

  def snapshot(): IrState
    let result = new IrState()
    var variable = this.firstVariable

    while variable != null
      if variable.active
        result.add(variable, variable.value)
      end
      variable = variable.nextVariable
    end
    return result
  end

  def restore(state: IrState): Void
    var entry = state.first

    while entry != null
      entry.variable.value = entry.value
      entry = entry.nextEntry
    end
  end

  def sortedMutableState(): IrState
    let result = new IrState()
    var remaining = 0
    var variable = this.firstVariable

    while variable != null
      if variable.active && variable.mutable
        remaining = remaining + 1
      end
      variable = variable.nextVariable
    end
    var previousKind: readonly IrSymbolKind? = null
    var previousName = ""
    var emitted = 0

    while emitted < remaining
      var best: IrVariable? = null

      variable = this.firstVariable
      while variable != null
        let afterPrevious = previousKind == null || previousKind.precedes(variable.symbolKind) || (variable.symbolKind.same(previousKind) && irCompareText(variable.identity, previousName) > 0)

        if variable.active && variable.mutable && afterPrevious && (best == null || variable.symbolKind.precedes(best.symbolKind) || (variable.symbolKind.same(best.symbolKind) && irCompareText(variable.identity, best.identity) < 0))
          best = variable
        end
        variable = variable.nextVariable
      end
      if best != null
        result.add(best, best.value)
        previousKind = best.symbolKind
        previousName = best.identity
      end
      emitted = emitted + 1
    end
    return result
  end

  def arguments(state: IrState): Int[]
    var result: Int[] = []
    var entry = state.first

    while entry != null
      result = host::appendInt(result, entry.variable.value)
      entry = entry.nextEntry
    end
    return result
  end

  def addParameters(block: IrBlock, variables: IrState, location: IrLocation): IrState
    let result = new IrState()
    var entry = variables.first

    while entry != null
      let id = this.function.allocateValue()

      block.addParameter(new IrParameter(id, entry.variable.typeName, location))
      result.add(entry.variable, id)
      entry = entry.nextEntry
    end
    return result
  end

  def findVariable(name: String): IrVariable?
    var current = this.firstVariable
    var result: IrVariable? = null

    while current != null
      if current.active && current.name == name
        result = current
      end
      current = current.nextVariable
    end
    return result
  end

  def findVariableIdentity(identity: String, fallbackName: String): IrVariable?
    var current = this.firstVariable

    while current != null
      if current.active && current.identity == identity
        return current
      end
      current = current.nextVariable
    end
    return this.findVariable(fallbackName)
  end

  def emit(opcode: readonly IrOpcode, resultType: String, operands: Int[], typeArguments: String[], symbol: IrSymbol?, constantKind: readonly IrConstantKind?, constantValue: String, predicate: readonly IrComparison?, flag: Bool, location: IrLocation): IrValue
    var resultId = -1

    if resultType != "void"
      resultId = this.function.allocateValue()
    end
    let instruction = new IrInstruction(opcode, resultId, resultType, operands, typeArguments, symbol, constantKind, constantValue, predicate, flag, location)

    instruction.debugScopeId = this.debugScopeId
    this.current.addInstruction(instruction)
    return new IrValue(resultId, resultType)
  end

  def emitValue(opcode: readonly IrOpcode, resultType: String, operands: Int[], location: IrLocation): IrValue
    return this.emit(opcode, resultType, operands, irEmptyStrings(), null, null, "", null, false, location)
  end

  def emitTyped(opcode: readonly IrOpcode, resultType: String, operands: Int[], typeArgument: String, location: IrLocation): IrValue
    let types: String[] = [typeArgument]

    return this.emit(opcode, resultType, operands, types, null, null, "", null, false, location)
  end

  def emitPair(opcode: readonly IrOpcode, firstType: String, secondType: String, operands: Int[], typeArgument: String, location: IrLocation): IrInstruction
    let types: String[] = [typeArgument]
    let first = this.function.allocateValue()
    let second = this.function.allocateValue()
    let instruction = new IrInstruction(opcode, first, firstType, operands, types, null, null, "", null, false, location)

    instruction.debugScopeId = this.debugScopeId
    instruction.secondResultId = second
    instruction.secondResultType = secondType
    this.current.addInstruction(instruction)
    return instruction
  end

  def emitSymbol(opcode: readonly IrOpcode, resultType: String, operands: Int[], symbol: IrSymbol, location: IrLocation): IrValue
    return this.emit(opcode, resultType, operands, irEmptyStrings(), symbol, null, "", null, false, location)
  end

  def emitConstant(resultType: String, constantKind: readonly IrConstantKind, constantValue: String, location: IrLocation): IrValue
    return this.emit(this.domains.opcode.getConstant(), resultType, irEmptyInts(), irEmptyStrings(), null, constantKind, constantValue, null, false, location)
  end

  def emitCompare(left: Int, right: Int, predicate: readonly IrComparison, location: IrLocation): IrValue
    let operands: Int[] = [left, right]

    return this.emit(this.domains.opcode.getCompare(), "bool", operands, irEmptyStrings(), null, null, "", predicate, false, location)
  end

  def returnValue(value: Int, location: IrLocation): Void
    let terminator = new IrTerminator(this.domains.terminatorKind.getReturn(), location)

    terminator.debugScopeId = this.debugScopeId
    terminator.value = value
    this.current.terminator = terminator
    this.terminated = true
  end

  def branch(target: IrBlock, arguments: Int[], location: IrLocation): Void
    let terminator = new IrTerminator(this.domains.terminatorKind.getBranch(), location)

    terminator.debugScopeId = this.debugScopeId
    terminator.firstTarget = target.id
    terminator.firstArguments = arguments
    this.current.terminator = terminator
    this.terminated = true
  end

  def conditional(condition: Int, whenTrue: IrBlock, trueArguments: Int[], whenFalse: IrBlock, falseArguments: Int[], location: IrLocation): Void
    let terminator = new IrTerminator(this.domains.terminatorKind.getConditionalBranch(), location)

    terminator.debugScopeId = this.debugScopeId
    terminator.condition = condition
    terminator.firstTarget = whenTrue.id
    terminator.firstArguments = trueArguments
    terminator.secondTarget = whenFalse.id
    terminator.secondArguments = falseArguments
    this.current.terminator = terminator
    this.terminated = true
  end

  def setCurrent(block: IrBlock): Void
    this.current = block
    this.terminated = false
  end
end
