class IrAdapterRequest
  public target: SemanticCallable
  public arity: Int
  public virtualDispatch: Bool
  public node: Int
  public name: String
  public next: IrAdapterRequest?

  def init(target: SemanticCallable, arity: Int, virtualDispatch: Bool, node: Int, name: String): Void
    this.target = target
    this.arity = arity
    this.virtualDispatch = virtualDispatch
    this.node = node
    this.name = name
  end
end
