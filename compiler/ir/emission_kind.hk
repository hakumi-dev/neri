sealed class EmissionKind
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def neriIR(): EmissionKind
    return new EmissionKind(0)
  end

  readonly def isNeriIR(): Bool
    return this.tag == 0
  end

  static def neriIRHex(): EmissionKind
    return new EmissionKind(1)
  end

  readonly def isNeriIRHex(): Bool
    return this.tag == 1
  end

  static def llvmIR(): EmissionKind
    return new EmissionKind(2)
  end

  readonly def isLLVMIR(): Bool
    return this.tag == 2
  end

  static def assembly(): EmissionKind
    return new EmissionKind(3)
  end

  readonly def isAssembly(): Bool
    return this.tag == 3
  end

  static def object(): EmissionKind
    return new EmissionKind(4)
  end

  readonly def isObject(): Bool
    return this.tag == 4
  end

  static def executable(): EmissionKind
    return new EmissionKind(5)
  end

  readonly def isExecutable(): Bool
    return this.tag == 5
  end

  static def cHeader(): EmissionKind
    return new EmissionKind(6)
  end

  readonly def isCHeader(): Bool
    return this.tag == 6
  end

  static def parse(value: String): EmissionKind?
    return EmissionKind.neriIR() if value == "neri-ir"
    return EmissionKind.neriIRHex() if value == "neri-ir-hex"
    return EmissionKind.llvmIR() if value == "llvm-ir"
    return EmissionKind.assembly() if value == "asm"
    return EmissionKind.object() if value == "obj"
    return EmissionKind.executable() if value == "executable"
    return EmissionKind.cHeader() if value == "c-header"
    return null
  end

  readonly def name(): String
    return "neri-ir" if this.isNeriIR()
    return "neri-ir-hex" if this.isNeriIRHex()
    return "llvm-ir" if this.isLLVMIR()
    return "asm" if this.isAssembly()
    return "obj" if this.isObject()
    return "executable" if this.isExecutable()
    return "c-header"
  end

  readonly def codegenName(): String?
    return "llvm-ir" if this.isLLVMIR()
    return "assembly" if this.isAssembly()
    return "object" if this.isObject() || this.isExecutable()
    return null
  end

  readonly def usesCodegen(): Bool
    return this.isLLVMIR() || this.isAssembly() || this.isObject() || this.isExecutable()
  end
end
