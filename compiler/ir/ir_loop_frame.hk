class IrLoopFrame
  public continueTarget: IrBlock = new IrBlock(0)
  public breakTarget: IrBlock = new IrBlock(0)
  public carried: IrState = new IrState()
  public indexValue: Int = -1
  public location: IrLocation = new IrLocation(false, 0, 0)
  public cleanupDepth: Int = 0
  public parent: IrLoopFrame?

  def init(continueTarget: IrBlock, breakTarget: IrBlock, carried: IrState, indexValue: Int, location: IrLocation, cleanupDepth: Int, parent: IrLoopFrame?): Void
    this.continueTarget = continueTarget
    this.breakTarget = breakTarget
    this.carried = carried
    this.indexValue = indexValue
    this.location = location
    this.cleanupDepth = cleanupDepth
    this.parent = parent
  end
end
