class IrImport
  public symbol: IrSymbol = new IrSymbol("main", 7, "import")
  public parameterTypes: StringBuffer = new StringBuffer()
  public resultType: String = "void"
  public kind: Int = 1
  public linkName: String = ""
  public nativeLibrary: String = ""
  public effects: EffectSet = new EffectSet()
  public runtimeMajor: Int = -1
  public runtimeMinor: Int = 0
  public runtimeFeatures: RuntimeFeatures = new RuntimeFeatures()
  public location: IrLocation = new IrLocation(false, 0, 0)
  public nextImport: IrImport?
  public emitted: Bool = false

  def init(symbol: IrSymbol, resultType: String, kind: Int, linkName: String, effects: EffectSet, location: IrLocation): Void
    this.symbol = symbol
    this.resultType = resultType
    this.kind = kind
    this.linkName = linkName
    this.effects = effects
    this.location = location
  end
end
