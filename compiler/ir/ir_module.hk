class IrModule
  public retainedParent: IrModule?
  public sessionEntry: IrSymbol?
  public sessionArtifactIdentity: String = ""
  public sessionSourceType: String = "void"
  public sessionTargetType: String = "void"
  public firstRecord: IrNativeRecord?
  public lastRecord: IrNativeRecord?
  public recordCount: Int = 0
  public id: String = "main"
  public firstSource: IrSource?
  public lastSource: IrSource?
  public sourceCount: Int = 0
  public requiredFeatures: StringBuffer = new StringBuffer()
  public firstClass: IrClass?
  public lastClass: IrClass?
  public classCount: Int = 0
  public firstGlobal: IrGlobal?
  public lastGlobal: IrGlobal?
  public globalCount: Int = 0
  public firstImport: IrImport?
  public lastImport: IrImport?
  public importCount: Int = 0
  public firstFunction: IrFunction?
  public lastFunction: IrFunction?
  public functionCount: Int = 0

  def init(id: String, source: String): Void
    this.id = id
    this.addSource(new IrSource("main", source, 0))
  end

  def clearSources(): Void
    this.firstSource = null
    this.lastSource = null
    this.sourceCount = 0
  end

  def addSource(source: IrSource): Void
    if this.firstSource == null
      this.firstSource = source
    else
      let last = this.lastSource

      if last != null
        last.nextSource = source
      end
    end
    this.lastSource = source
    this.sourceCount = this.sourceCount + 1
  end

  def location(globalStart: Int, length: Int): IrLocation
    var source = this.firstSource

    while source != null
      if globalStart >= source.globalStart && globalStart <= source.globalStart + source.utf16Length
        let location = source.map.location(globalStart - source.globalStart, length)

        location.sourceId = source.id
        return location
      end
      source = source.nextSource
    end
    var parent = this.retainedParent

    while parent != null
      source = parent.firstSource

      while source != null
        if globalStart >= source.globalStart && globalStart <= source.globalStart + source.utf16Length
          let imported = new IrSource(source.id, source.text, source.globalStart, source.map)

          this.addSource(imported)
          let location = imported.map.location(globalStart - imported.globalStart, length)

          location.sourceId = imported.id
          return location
        end
        source = source.nextSource
      end
      parent = parent.retainedParent
    end
    return new IrLocation(false, 0, 0)
  end

  def requireFeature(feature: String): Void
    var index = 0

    while index < this.requiredFeatures.size
      if this.requiredFeatures.get(index) == feature
        return
      end
      index = index + 1
    end
    this.requiredFeatures.add(feature)
  end

  def hasFeature(feature: String): Bool
    var index = 0

    while index < this.requiredFeatures.size
      if this.requiredFeatures.get(index) == feature
        return true
      end
      index = index + 1
    end
    return false
  end

  def nextFeature(previous: String, first: Bool): String?
    var best: String? = null
    var index = 0

    while index < this.requiredFeatures.size
      let feature = this.requiredFeatures.get(index)

      if (first || irCompareText(feature, previous) > 0) && (best == null || irCompareText(feature, best) < 0)
        best = feature
      end
      index = index + 1
    end
    return best
  end

  def resetEmission(): Void
    var source = this.firstSource

    while source != null
      source.emitted = false
      source = source.nextSource
    end
    var classValue = this.firstClass

    while classValue != null
      classValue.emitted = false
      classValue = classValue.nextClass
    end
    var global = this.firstGlobal

    while global != null
      global.emitted = false
      global = global.nextGlobal
    end
    var importValue = this.firstImport

    while importValue != null
      importValue.emitted = false
      importValue = importValue.nextImport
    end
    var function = this.firstFunction

    while function != null
      function.emitted = false
      var local = function.firstDebugLocal

      while local != null
        local.emitted = false
        local = local.nextLocal
      end
      var scope = function.firstDebugScope

      while scope != null
        scope.emitted = false
        scope = scope.nextScope
      end
      function = function.nextFunction
    end
  end

  def addClass(value: IrClass): Void
    if this.firstClass == null
      this.firstClass = value
    else
      let last = this.lastClass

      if last != null
        last.nextClass = value
      end
    end
    this.lastClass = value
    this.classCount = this.classCount + 1
  end

  def addGlobal(value: IrGlobal): Void
    if this.firstGlobal == null
      this.firstGlobal = value
    else
      let last = this.lastGlobal

      if last != null
        last.nextGlobal = value
      end
    end
    this.lastGlobal = value
    this.globalCount = this.globalCount + 1
  end

  def addImport(value: IrImport): Void
    if this.firstImport == null
      this.firstImport = value
    else
      let last = this.lastImport

      if last != null
        last.nextImport = value
      end
    end
    this.lastImport = value
    this.importCount = this.importCount + 1
  end

  def addFunction(value: IrFunction): Void
    if this.firstFunction == null
      this.firstFunction = value
    else
      let last = this.lastFunction

      if last != null
        last.nextFunction = value
      end
    end
    this.lastFunction = value
    this.functionCount = this.functionCount + 1
  end

  def exportSession(entry: IrFunction, artifactIdentity: String = ""): Void
    this.sessionEntry = entry.symbol
    this.sessionArtifactIdentity = artifactIdentity
    this.sessionTargetType = entry.resultType
    this.sessionSourceType = entry.parameterTypes.size == 0 ? "void" : entry.parameterTypes.get(0)
    this.requireFeature("session-module-v1")
    if artifactIdentity != ""
      this.requireFeature("retained-modules-v1")
    end
  end
end
