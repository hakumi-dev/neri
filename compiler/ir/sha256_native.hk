use host

def sha256FastText(text: String): String
  let length = host.stringByteLength(text)

  unsafe
    let bytes = shaAllocateBytes(length == 0 ? 1 : length)

    if bytes != null
      var index = 0

      while index < length
        bytes[index] = host.stringByteAt(text, index)
        index = index + 1
      end
      let digest = shaConsumeBytes(bytes, length)

      if digest != null
        return digest
      end
    end
  end
  return sha256Text(text)
end

def sha256FastBuffer(values: IntBuffer): String
  unsafe
    let bytes = shaAllocateBytes(values.size == 0 ? 1 : values.size)

    if bytes != null
      var index = 0

      while index < values.size
        bytes[index] = values.get(index) as Byte
        index = index + 1
      end
      let digest = shaConsumeBytes(bytes, values.size)

      if digest != null
        return digest
      end
    end
  end
  return sha256Buffer(values)
end

def sha256FastWire(values: IrWireBytes): String
  unsafe
    let bytes = shaAllocateBytes(values.size == 0 ? 1 : values.size)

    if bytes != null
      var index = 0

      while index < values.size
        bytes[index] = values.get(index) as Byte
        index = index + 1
      end
      let digest = shaConsumeBytes(bytes, values.size)

      if digest != null
        return digest
      end
    end
  end
  return sha256Buffer(values.unpack())
end
