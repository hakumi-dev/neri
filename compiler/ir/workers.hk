def irLowerWorkerEntry(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let typeName = lowerer.module.types.fromSemantic(lowerer.bound.typeAt(node))
  let target = lowerer.bound.dataAt(node)

  lowerer.requireType(typeName)
  lowerer.module.requiredFeatures.requireIsolatedWorkers()
  context.function.addCallee(target)
  return context.emitSymbol(lowerer.module.domains.opcode.getWorkerEntry(), typeName, [], irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getFunction(), target), lowerer.location(node))
end

def irLowerWorkerStart(lowerer: IrLowerer, context: IrFunctionContext, node: Int, operation: SemanticCallable): IrValue
  let arguments = lowerer.lowerArguments(context, node, 0, operation)
  let location = lowerer.location(node)
  # Binding verifies the declaration's bridge and creates only a private native
  # adapter for a named entry. No callback value or captured receiver is shared.
  let capability = context.emitValue(lowerer.module.domains.opcode.getUnsafeBegin(), lowerer.module.types.unsafeType(), [], location)
  var operands: Int[] = [capability.id]

  for argument in arguments
    operands = host::appendInt(operands, argument)
  end
  context.function.addCallee(operation.operationBridge)
  context.function.parallelUnsafe = true
  context.function.localEffects = context.function.localEffects.mergedWith(irCAbiEffects())
  let result = context.emitSymbol(lowerer.module.domains.opcode.getCallUnsafe(), lowerer.module.types.fromSemantic(operation.returnType), operands, irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getFunction(), operation.operationBridge), location)

  context.emitValue(lowerer.module.domains.opcode.getUnsafeEnd(), lowerer.module.types.voidType(), [capability.id], location)
  return result
end
