use arrays

class IrClass
  public symbol: IrSymbol
  public baseSymbol: IrSymbol?
  public access: readonly IrAccess
  public retained: Bool = false
  public isInterface: Bool = false
  public isAbstract: Bool = false
  public interfaces: IrSymbol[] = []
  public interfaceMethods: IrInterfaceMethod[] = []
  # Internal ownership provenance. It is deliberately not transported.
  public declarationSourceId: String = ""
  public location: IrLocation = new IrLocation(false, 0, 0)
  public firstField: IrField?
  public lastField: IrField?
  public fieldCount: Int = 0
  public firstMethod: IrMethod?
  public lastMethod: IrMethod?
  public methodCount: Int = 0
  public nextClass: IrClass?
  public emitted: Bool = false

  def init(symbol: IrSymbol, baseSymbol: IrSymbol?, access: readonly IrAccess, location: IrLocation): Void
    this.symbol = symbol
    this.baseSymbol = baseSymbol
    this.access = access
    this.location = location
  end

  def addInterface(symbol: IrSymbol): Void
    let existing = this.interfaces

    this.interfaces = arrays::generate<IrSymbol>(existing.Length + 1) do |index|
      return index == existing.Length ? symbol : existing[index]
    end
  end

  def addInterfaceMethod(binding: IrInterfaceMethod): Void
    let existing = this.interfaceMethods

    this.interfaceMethods = arrays::generate<IrInterfaceMethod>(existing.Length + 1) do |index|
      return index == existing.Length ? binding : existing[index]
    end
  end

  def addField(field: IrField): Void
    if this.firstField == null
      this.firstField = field
    else
      let last = this.lastField

      if last != null
        last.nextField = field
      end
    end
    this.lastField = field
    this.fieldCount = this.fieldCount + 1
  end

  def addMethod(method: IrMethod): Void
    if this.firstMethod == null
      this.firstMethod = method
    else
      let last = this.lastMethod

      if last != null
        last.nextMethod = method
      end
    end
    this.lastMethod = method
    this.methodCount = this.methodCount + 1
  end
end
