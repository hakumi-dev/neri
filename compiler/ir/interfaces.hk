def irLowerInterfaceMetadata(lowerer: IrLowerer, source: SemanticClass, target: IrClass): Void
  target.isInterface = source.isInterface
  target.isAbstract = source.isAbstract
  if source.isInterface || source.interfaces.Length > 0
    lowerer.module.requiredFeatures.requireExplicitInterfaces()
  end
  for name in source.interfaces
    target.addInterface(irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getClass(), name))
  end
  return if source.isInterface
  for contract in semanticImplementedInterfaces(lowerer.semantic, source)
    lowerer.module.requiredFeatures.requireExplicitInterfaces()
    var required = contract.firstMethod

    while required != null
      let implementation = semanticFindContractMethod(
        lowerer.semantic,
        source.fullName,
        required.name,
        required.parameterCount
      )

      if implementation != null && !implementation.isAbstract
        let owner = lowerer.semantic.findClass(implementation.className)

        if owner != null
          target.addInterfaceMethod(new IrInterfaceMethod(
              irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getMethod(), required.fullName),
              irSymbol(
                lowerer.module.id,
                lowerer.module.domains.symbolKind.getMethod(),
                lowerer.dispatchSlot(owner, implementation)
              )
            ))
        end
      end
      required = required.nextCallable
    end
  end
end

def irInterfaceSlot(lowerer: IrLowerer, slot: String): SemanticCallable?
  let method = lowerer.findCallable(slot)

  return null if method == null
  let owner = lowerer.semantic.findClass(method.className)

  return owner != null && owner.isInterface ? method : null
end

def irAddInterfaceCallees(
  lowerer: IrLowerer,
  context: IrFunctionContext,
  requirement: SemanticCallable,
  receiver: String,
  model: SemanticModel
): Void
  let parent = model.parent

  irAddInterfaceCallees(lowerer, context, requirement, receiver, parent) if parent != null
  var candidate = model.firstClass

  while candidate != null
    if !candidate.isInterface && !candidate.isAbstract && semanticImplementsInterface(
      lowerer.semantic,
      candidate,
      requirement.className
    )
      let implementation = semanticFindContractMethod(
        lowerer.semantic,
        candidate.fullName,
        requirement.name,
        requirement.parameterCount
      )

      if implementation != null && !implementation.isAbstract
        context.function.callees.add(implementation.fullName)
        let precise = context.function.parallelCallees

        if precise != null && semanticClassAssignable(lowerer.semantic, receiver, candidate.fullName)
          precise.add(implementation.fullName)
        end
      end
    end
    candidate = candidate.nextClass
  end
end
