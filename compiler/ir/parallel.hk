# Parallel capability checks use source receiver types; serialized IR retains
# the conservative effect summary required by the native boundary verifier.
def irParallelDispatchTarget(lowerer: IrLowerer, receiver: String, owner: SemanticClass, method: SemanticCallable, slot: String): Bool
  if semanticClassAssignable(lowerer.semantic, receiver, owner.fullName)
    return true
  end
  # An inherited implementation also serves a receiver with no override.
  var current = lowerer.semantic.findClass(receiver)
  while current != null
    var candidate = current.firstMethod
    while candidate != null
      if !candidate.isStatic && candidate.name != "init" && lowerer.dispatchSlot(current, candidate) == slot
        return candidate.fullName == method.fullName
      end
      candidate = candidate.nextCallable
    end
    current = lowerer.semantic.findClass(current.baseName)
  end
  return false
end

def irCheckParallelCallbacks(lowerer: IrLowerer): Void
  var closure = lowerer.semantic.firstClass
  while closure != null
    if closure.isParallelFunction && closure.isClosure
      let invoke = closure.firstMethod
      if invoke != null
        let function = irEffectFunction(lowerer.module, invoke.fullName)
        if function != null && (irHasEffect(function.effects, 64) || irHasEffect(function.effects, 16))
          let node = closure.syntaxNode
          lowerer.semantic.diagnostics.add("NR241", lowerer.syntax.startAt(node), lowerer.syntax.lengthAt(node), "A parallel callback requires parallel-capable calls and cannot perform I/O, host services, native allocation, or unsafe operations.")
        end
      end
    end
    closure = closure.nextClass
  end
  var function = lowerer.module.firstFunction
  while function != null
    function.parallelCallees = null
    function = function.nextFunction
  end
end
