class IrValue
  public id: Int = -1
  public typeName: String = "void"

  def init(id: Int, typeName: String): Void
    this.id = id
    this.typeName = typeName
  end
end

class IrVariable
  public identity: String = ""
  public symbolKind: Int = 6
  public name: String = ""
  public typeName: String = "int"
  public value: Int = -1
  public mutable: Bool = false
  public active: Bool = true
  public depth: Int = 0
  public addressedPointer: Int = -1
  public addressedDepth: Int = -1
  public nextVariable: IrVariable?

  def init(identity: String, symbolKind: Int, name: String, typeName: String, value: Int, mutable: Bool, depth: Int): Void
    this.identity = identity
    this.symbolKind = symbolKind
    this.name = name
    this.typeName = typeName
    this.value = value
    this.mutable = mutable
    this.depth = depth
  end
end

class IrStateEntry
  public variable: IrVariable = new IrVariable("error", 6, "error", "int", -1, false, 0)
  public value: Int = -1
  public nextEntry: IrStateEntry?

  def init(variable: IrVariable, value: Int): Void
    this.variable = variable
    this.value = value
  end
end

class IrState
  public first: IrStateEntry?
  public last: IrStateEntry?
  public count: Int = 0

  def init(): Void
    return
  end

  def add(variable: IrVariable, value: Int): Void
    let entry = new IrStateEntry(variable, value)
    if this.first == null this.first = entry else
      let last = this.last
      if last != null last.nextEntry = entry end
    end
    this.last = entry
    this.count = this.count + 1
  end

  def valueFor(variable: IrVariable): Int
    var entry = this.first
    while entry != null
      if entry.variable.identity == variable.identity return entry.value end
      entry = entry.nextEntry
    end
    return -1
  end
end

class IrPath
  public block: IrBlock = new IrBlock(0)
  public state: IrState = new IrState()
  public terminated: Bool = false

  def init(block: IrBlock, state: IrState, terminated: Bool): Void
    this.block = block
    this.state = state
    this.terminated = terminated
  end
end

class IrLoopFrame
  public continueTarget: IrBlock = new IrBlock(0)
  public breakTarget: IrBlock = new IrBlock(0)
  public carried: IrState = new IrState()
  public indexValue: Int = -1
  public location: IrLocation = new IrLocation(false, 0, 0)
  public cleanupDepth: Int = 0
  public parent: IrLoopFrame?

  def init(continueTarget: IrBlock, breakTarget: IrBlock, carried: IrState, indexValue: Int, location: IrLocation, cleanupDepth: Int, parent: IrLoopFrame?): Void
    this.continueTarget = continueTarget
    this.breakTarget = breakTarget
    this.carried = carried
    this.indexValue = indexValue
    this.location = location
    this.cleanupDepth = cleanupDepth
    this.parent = parent
  end
end

class IrCleanup
  public opcode: Int = 42
  public capability: Int = -1
  public token: Int = -1
  public previous: IrCleanup?

  def init(opcode: Int, capability: Int, token: Int, previous: IrCleanup?): Void
    this.opcode = opcode
    this.capability = capability
    this.token = token
    this.previous = previous
  end
end

class IrFunctionContext
  public function: IrFunction = new IrFunction(new IrSymbol("main", 4, "main"), "void", 1, false, new IrLocation(false, 0, 0))
  public current: IrBlock = new IrBlock(0)
  public firstVariable: IrVariable?
  public lastVariable: IrVariable?
  public scopeDepth: Int = 0
  public terminated: Bool = false
  public unsafeCapabilities: IntBuffer = new IntBuffer()
  public unsafeDepth: Int = 0
  public cleanup: IrCleanup?
  public cleanupDepth: Int = 0
  public loop: IrLoopFrame?
  public thisOverride: Int = -1
  public thisOverrideType: String = ""

  def init(function: IrFunction, entry: IrBlock): Void
    this.function = function
    this.current = entry
  end

  def pushCleanup(opcode: Int, capability: Int, token: Int): Void
    this.cleanup = new IrCleanup(opcode, capability, token, this.cleanup)
    this.cleanupDepth = this.cleanupDepth + 1
  end

  def popCleanup(): Void
    let currentCleanup = this.cleanup
    if currentCleanup != null this.cleanup = currentCleanup.previous end
    this.cleanupDepth = this.cleanupDepth - 1
  end

  def enterScope(): Void
    this.scopeDepth = this.scopeDepth + 1
  end

  def leaveScope(): Void
    var variable = this.firstVariable
    while variable != null
      if variable.depth == this.scopeDepth
        variable.active = false
      end
      variable = variable.nextVariable
    end
    this.scopeDepth = this.scopeDepth - 1
  end

  def addVariable(identity: String, symbolKind: Int, name: String, typeName: String, value: Int, mutable: Bool): IrVariable
    let variable = new IrVariable(identity, symbolKind, name, typeName, value, mutable, this.scopeDepth)
    if this.firstVariable == null
      this.firstVariable = variable
    else
      let last = this.lastVariable
      if last != null last.nextVariable = variable end
    end
    this.lastVariable = variable
    return variable
  end

  def snapshot(): IrState
    let result = new IrState()
    var variable = this.firstVariable
    while variable != null
      if variable.active result.add(variable, variable.value) end
      variable = variable.nextVariable
    end
    return result
  end

  def restore(state: IrState): Void
    var entry = state.first
    while entry != null
      entry.variable.value = entry.value
      entry = entry.nextEntry
    end
  end

  def sortedMutableState(): IrState
    let result = new IrState()
    var remaining = 0
    var variable = this.firstVariable
    while variable != null
      if variable.active && variable.mutable remaining = remaining + 1 end
      variable = variable.nextVariable
    end
    var previousKind = -1
    var previousName = ""
    var emitted = 0
    while emitted < remaining
      var best: IrVariable? = null
      variable = this.firstVariable
      while variable != null
        let afterPrevious = variable.symbolKind > previousKind || (variable.symbolKind == previousKind && irCompareText(variable.identity, previousName) > 0)
        if variable.active && variable.mutable && afterPrevious && (best == null || variable.symbolKind < best.symbolKind || (variable.symbolKind == best.symbolKind && irCompareText(variable.identity, best.identity) < 0))
          best = variable
        end
        variable = variable.nextVariable
      end
      if best != null
        result.add(best, best.value)
        previousKind = best.symbolKind
        previousName = best.identity
      end
      emitted = emitted + 1
    end
    return result
  end

  def arguments(state: IrState): Int[]
    var result: Int[] = []
    var entry = state.first
    while entry != null
      result = host.appendInt(result, entry.variable.value)
      entry = entry.nextEntry
    end
    return result
  end

  def addParameters(block: IrBlock, variables: IrState, location: IrLocation): IrState
    let result = new IrState()
    var entry = variables.first
    while entry != null
      let id = this.function.allocateValue()
      block.addParameter(new IrParameter(id, entry.variable.typeName, location))
      result.add(entry.variable, id)
      entry = entry.nextEntry
    end
    return result
  end

  def findVariable(name: String): IrVariable?
    var current = this.firstVariable
    var result: IrVariable? = null
    while current != null
      if current.active && current.name == name
        result = current
      end
      current = current.nextVariable
    end
    return result
  end

  def findVariableIdentity(identity: String, fallbackName: String): IrVariable?
    var current = this.firstVariable
    while current != null
      if current.active && current.identity == identity return current end
      current = current.nextVariable
    end
    return this.findVariable(fallbackName)
  end

  def emit(opcode: Int, resultType: String, operands: Int[], typeArguments: String[], symbol: IrSymbol?, constantKind: Int, constantValue: String, predicate: Int, flag: Bool, location: IrLocation): IrValue
    var resultId = -1
    if resultType != "void"
      resultId = this.function.allocateValue()
    end
    this.current.addInstruction(new IrInstruction(opcode, resultId, resultType, operands, typeArguments, symbol, constantKind, constantValue, predicate, flag, location))
    return new IrValue(resultId, resultType)
  end

  def emitValue(opcode: Int, resultType: String, operands: Int[], location: IrLocation): IrValue
    return this.emit(opcode, resultType, operands, irEmptyStrings(), null, 0, "", 0, false, location)
  end

  def emitTyped(opcode: Int, resultType: String, operands: Int[], typeArgument: String, location: IrLocation): IrValue
    let types: String[] = [typeArgument]
    return this.emit(opcode, resultType, operands, types, null, 0, "", 0, false, location)
  end

  def emitPair(opcode: Int, firstType: String, secondType: String, operands: Int[], typeArgument: String, location: IrLocation): IrInstruction
    let types: String[] = [typeArgument]
    let first = this.function.allocateValue()
    let second = this.function.allocateValue()
    let instruction = new IrInstruction(opcode, first, firstType, operands, types, null, 0, "", 0, false, location)
    instruction.secondResultId = second
    instruction.secondResultType = secondType
    this.current.addInstruction(instruction)
    return instruction
  end

  def emitSymbol(opcode: Int, resultType: String, operands: Int[], symbol: IrSymbol, location: IrLocation): IrValue
    return this.emit(opcode, resultType, operands, irEmptyStrings(), symbol, 0, "", 0, false, location)
  end

  def emitConstant(resultType: String, constantKind: Int, constantValue: String, location: IrLocation): IrValue
    return this.emit(1, resultType, irEmptyInts(), irEmptyStrings(), null, constantKind, constantValue, 0, false, location)
  end

  def emitCompare(left: Int, right: Int, predicate: Int, location: IrLocation): IrValue
    let operands: Int[] = [left, right]
    return this.emit(15, "bool", operands, irEmptyStrings(), null, 0, "", predicate, false, location)
  end

  def returnValue(value: Int, location: IrLocation): Void
    let terminator = new IrTerminator(3, location)
    terminator.value = value
    this.current.terminator = terminator
    this.terminated = true
  end

  def branch(target: IrBlock, arguments: Int[], location: IrLocation): Void
    let terminator = new IrTerminator(1, location)
    terminator.firstTarget = target.id
    terminator.firstArguments = arguments
    this.current.terminator = terminator
    this.terminated = true
  end

  def conditional(condition: Int, whenTrue: IrBlock, trueArguments: Int[], whenFalse: IrBlock, falseArguments: Int[], location: IrLocation): Void
    let terminator = new IrTerminator(2, location)
    terminator.condition = condition
    terminator.firstTarget = whenTrue.id
    terminator.firstArguments = trueArguments
    terminator.secondTarget = whenFalse.id
    terminator.secondArguments = falseArguments
    this.current.terminator = terminator
    this.terminated = true
  end

  def setCurrent(block: IrBlock): Void
    this.current = block
    this.terminated = false
  end
end
