use console
use host

def bootstrapNativeProgressLabel(module: IrModule, sources: BootstrapSourceInput?, phase: String, detail: String, sourceOffset: Int): String
  if phase != "lower"
    return detail
  end
  var functionValue = module.firstFunction

  while functionValue != null
    if functionValue.symbol.name == detail && functionValue.location.present && functionValue.location.start == sourceOffset
      var source = sources

      while source != null
        if source.id == functionValue.location.sourceId
          let fileName = host::pathFileName(source.path)

          return (fileName == null ? source.path : fileName) + ": " + detail
        end
        source = source.nextInput
      end
    end
    functionValue = functionValue.nextFunction
  end
  return detail
end

def bootstrapCompile(arguments: String[], batch: BatchCompilation? = null, progress: (fn(String, Int, Int): Void)? = null, nativeProgress: (fn(String, Int, Int, String): Void)? = null): Void
  let started = runCacheTime()

  var timings = false
  var noCache = false
  var quiet = false
  var moduleName = "main"
  var sourceRoot = ""
  var projectPath = ""
  let referencedPaths = new StringBuffer()
  let referencedIds = new StringBuffer()
  let referencePaths = new StringBuffer()
  var unit = ""
  var projectKind: ProjectUnitKind? = null
  var implicitProject = false
  var loadedProject: NeriProject? = null
  var consumerOwner = ""
  var emitName = "neri-ir"
  var emitExplicit = false
  var output = ""
  var targetName = ""
  var release = false
  var sessionModule = false
  var command = "run"
  var firstSource: BootstrapSourceInput? = null
  var lastSource: BootstrapSourceInput? = null
  var sourceCount = 0
  var libraryCount = 0
  var programArguments: String[] = []
  var index = 0

  while index < arguments.Length
    let optionalArgument: String? = arguments[index]

    if optionalArgument == null
      return
    end
    let argument = optionalArgument

    if index == 0 && (argument == "build" || argument == "check" || argument == "run")
      command = argument
      index = index + 1
    else if argument == "--" && command == "run"
      index = index + 1
      while index < arguments.Length
        let value: String? = arguments[index]

        if value != null
          programArguments = host::appendString(programArguments, value)
        end
        index = index + 1
      end
    else if argument == "--version" || (index == 0 && argument == "version")
      console::println("neri " + neriVersion())
      return
    else if argument == "--help"
      bootstrapUsage()
      return
    else if argument == "--module" || argument == "--source-root" || argument == "--output" || argument == "--target" || argument == "--project" || argument == "--unit" || argument == "--reference"
      if index + 1 >= arguments.Length
        bootstrapUsage()
        host::exit(2)
        return
      end
      let optionalValue: String? = arguments[index + 1]

      if optionalValue == null
        return
      end
      if argument == "--reference"
        referencePaths.add(optionalValue)
      else if argument == "--project"
        projectPath = optionalValue
      else if argument == "--unit"
        unit = optionalValue
      else if argument == "--module"
        moduleName = optionalValue
      else if argument == "--source-root"
        sourceRoot = optionalValue
      else if argument == "--output"
        output = optionalValue
      else
        targetName = optionalValue
      end
      index = index + 2
    else if bootstrapStartsWith(argument, "--module=")
      moduleName = host::stringSlice(argument, 9, host::stringByteLength(argument) - 9)
      index = index + 1
    else if bootstrapStartsWith(argument, "--source-root=")
      sourceRoot = host::stringSlice(argument, 14, host::stringByteLength(argument) - 14)
      index = index + 1
    else if bootstrapStartsWith(argument, "--emit=")
      emitName = host::stringSlice(argument, 7, host::stringByteLength(argument) - 7)
      emitExplicit = true
      index = index + 1
    else if argument == "--timings"
      timings = true
      index = index + 1
    else if argument == "--no-cache"
      noCache = true
      index = index + 1
    else if argument == "--quiet"
      quiet = true
      index = index + 1
    else if argument == "--release"
      release = true
      index = index + 1
    else if argument == "--session-module"
      sessionModule = true
      index = index + 1
    else if bootstrapStartsWith(argument, "--")
      console::println("unknown option: " + argument)
      bootstrapUsage()
      host::exit(2)
      return
    else
      let optionalPath = host::pathAbsolute(argument)

      if optionalPath == null
        console::println("source path is invalid: " + argument)
        host::exit(2)
        return
      end
      let path = optionalPath

      if !neriSourceNameValid(path)
        console::println(".hk file names must not contain whitespace: " + argument)
        host::exit(2)
        return
      end
      let text = host::readText(path)

      if text == null
        console::println("could not read source: " + argument)
        host::exit(2)
        return
      end
      let input = new BootstrapSourceInput(path, "", text)

      if firstSource == null
        firstSource = input
      else
        let last = lastSource

        if last != null
          last.nextInput = input
        end
      end
      lastSource = input
      sourceCount = sourceCount + 1
      index = index + 1
    end
  end
  progress("project", 0, 0) if progress != null
  if projectPath != ""
    if sourceCount != 0
      progress("load", 0, 0) if progress != null
      console::println("--project cannot be combined with explicit source files")
      host::exit(2)
      return
    end
    let project = neriLoadProject(projectPath, unit)

    if project.error() != ""
      progress("load", 0, 0) if progress != null
      console::println(project.error())
      host::exit(2)
      return
    end
    projectKind = project.kind
    implicitProject = project.implicit
    loadedProject = project
    let ownSource = project.ownSources.first.nextNode

    if ownSource != null
      let owner = neriUnitSourceOwner(project, ownSource.value)

      consumerOwner = owner if owner != null
    end
    var reference = project.referenceSources.first.nextNode

    while reference != null
      referencedPaths.add(reference.value)
      reference = reference.nextNode
    end
    var entry = project.sources.first.nextNode

    while entry != null
      let text = neriProjectVerifiedText(project, entry.value)

      if text == null
        progress("load", 0, 0) if progress != null
        console::println("could not read project source: " + entry.value)
        host::exit(2)
        return
      end
      let input = new BootstrapSourceInput(entry.value, "", text)

      input.identityPath = project.identityPath(entry.value)

      if firstSource == null
        firstSource = input
      else
        let last = lastSource

        if last != null
          last.nextInput = input
        end
      end
      lastSource = input
      sourceCount = sourceCount + 1
      entry = entry.nextNode
    end
  else if unit != ""
    progress("load", 0, 0) if progress != null
    console::println("--unit requires --project")
    host::exit(2)
    return
  end
  if sourceCount == 0
    progress("load", 0, 0) if progress != null
    bootstrapUsage()
    host::exit(2)
    return
  end
  if (command == "build" || command == "run") && !emitExplicit
    emitName = "executable"
  end
  let emitReference = emitName == "reference"
  let emit = EmissionKind.parse(emitReference ? "obj" : emitName)

  if emitReference && (command != "build" || !projectUnitIsLibrary(projectKind) || output == "" || output == "-" || sessionModule || referencePaths.size > 0)
    progress("load", 0, 0) if progress != null
    console::println("Reference emission requires build, a project library unit, and --output <file.nref>; sessions and chained binary references are not supported yet.")
    host::exit(2)
    return
  end
  if referencePaths.size > 0 && sessionModule
    progress("load", 0, 0) if progress != null
    console::println("Binary references are not supported in session modules yet.")
    host::exit(2)
    return
  end
  let references = new ReferenceInputs()

  if emitReference || referencePaths.size > 0
    if !references.prepare(referencePaths, targetName, moduleName)
      progress("load", 0, 0) if progress != null
      console::println(references.error)
      host::exit(2)
      return
    end
    targetName = references.target
  end

  if projectUnitIsLibrary(projectKind) && emit != null && emit.isExecutable()
    progress("load", 0, 0) if progress != null
    console::println("A library unit cannot be emitted as an executable; use check or build --emit=obj --output <file>.")
    host::exit(2)
    return
  end
  if command == "run" && (emit == null || !emit.isExecutable() || output != "")
    progress("load", 0, 0) if progress != null
    console::println("run owns its executable location; --output and non-executable --emit are invalid")
    host::exit(2)
    return
  end
  if emit == null
    progress("load", 0, 0) if progress != null
    console::println("unknown emit kind: " + emitName)
    progress("load", 0, 0) if progress != null
    bootstrapUsage()
    host::exit(2)
    return
  end

  var logicalRoot = ""

  if sourceRoot != ""
    let optionalRoot = host::pathAbsolute(sourceRoot)

    if optionalRoot == null
      progress("load", 0, 0) if progress != null
      console::println("source root is invalid: " + sourceRoot)
      host::exit(2)
      return
    end
    logicalRoot = optionalRoot
  else if sourceCount > 1
    logicalRoot = bootstrapCommonSourceRoot(firstSource)
  end

  let libraryDirectory = host::environment("NERI_STDLIB")

  if libraryDirectory == null || libraryDirectory == ""
    progress("load", 0, 0) if progress != null
    console::println("required standard library core is unavailable: NERI_STDLIB is not set")
    host::exit(2)
    return
  end
  let libraries = new StandardLibraryCatalog(libraryDirectory)

  if libraries.error != ""
    progress("load", 0, 0) if progress != null
    console::println(libraries.error)
    host::exit(2)
    return
  end
  var source = firstSource
  let sourceIdentities = new StringTable<Bool>()
  let suppliedPaths = new StringTable<Bool>()
  let libraryReferences = new BootstrapLibraryReferences()

  while source != null
    if logicalRoot != "" && !bootstrapPathWithin(logicalRoot, source.identityPath)
      progress("load", 0, 0) if progress != null
      console::println("source is outside source root: " + source.path)
      host::exit(2)
      return
    end
    let librarySourceName = libraries.sourceName(source.path)

    if librarySourceName != null
      source.id = "@stdlib/" + librarySourceName
    else
      source.id = bootstrapSourceId(source.identityPath, logicalRoot, sourceCount == 1 && sourceRoot == "")
    end
    if !sourceIdentities.add(source.id, true)
      progress("load", 0, 0) if progress != null
      console::println("source identity is specified more than once: " + source.id)
      host::exit(2)
      return
    end
    let canonical = neriCanonicalPath(source.path)

    suppliedPaths.add(canonical, true) if canonical != null
    libraryReferences.addSource(source.text)
    source = source.nextInput
  end
  var pendingLibraries = true

  while pendingLibraries
    pendingLibraries = false
    for libraryName in libraryReferences.libraryNames()
      let paths = libraries.sourcePaths(libraryName)

      if libraries.error != "" || (libraryName == bootstrapCoreLibraryName() && paths.size == 0)
        progress("load", 0, 0) if progress != null
        console::println(libraries.error != "" ? libraries.error : "required standard library core is unavailable")
        host::exit(2)
        return
      end
      var path = paths.first.nextNode

      while path != null
        let libraryPath = libraryDirectory + "/" + path.value
        let canonical = neriCanonicalPath(libraryPath)
        let supplied = canonical != null && suppliedPaths.find(canonical) != null

        if !supplied
          let project = loadedProject
          var libraryText: String? = null

          if project == null
            libraryText = host::readText(libraryPath)
          else
            libraryText = neriProjectVerifiedText(project, libraryPath)
          end

          if libraryText != null
            libraryReferences.addSource(libraryText)
            let library = new BootstrapSourceInput(libraryPath, "@stdlib/" + path.value, libraryText)
            let last = lastSource

            if last != null
              last.nextInput = library
            end
            lastSource = library
            suppliedPaths.add(canonical, true) if canonical != null
            libraryCount = libraryCount + 1
            pendingLibraries = true
          else
            progress("load", 0, 0) if progress != null
            console::println("standard library source is unavailable: " + libraryPath)
            host::exit(2)
            return
          end
        end
        path = path.nextNode
      end
    end
  end
  let sourceIds = new StringBuffer()
  let sourceOwners = new StringBuffer()
  let sourcePaths = new StringBuffer()
  let sourceTexts = new StringBuffer()

  source = bootstrapNextSource(firstSource)
  while source != null
    source.emitted = true
    sourceIds.add(source.id)
    var owner = consumerOwner

    owner = "@stdlib" if bootstrapStartsWith(source.id, "@stdlib/")
    let project = loadedProject

    if project != null
      let declaredOwner = neriUnitSourceOwner(project, source.path)

      if declaredOwner != null
        owner = declaredOwner
      end
    end
    sourceOwners.add(owner)
    if projectUnitIsLibrary(projectKind) || neriProjectListed(referencedPaths, source.path)
      referencedIds.add(source.id)
    end
    let optionalFileName = host::pathFileName(source.path)
    var displayName = source.id

    if optionalFileName != null
      displayName = optionalFileName
    end
    sourcePaths.add(displayName)
    sourceTexts.add(source.text)
    source = bootstrapNextSource(firstSource)
  end

  var dependency: BatchDependency? = null
  let incremental = new IncrementalProjectCache()
  let linkInputs = new NativeLinkInputs()

  runCacheReport(timings, "source-load", started)
  progress("analyze", sourceCount, libraryCount) if progress != null
  if loadedProject != null && batch == null && !sessionModule && referencePaths.size == 0 && emit.isExecutable() && (command == "build" || command == "run")
    let lookupStarted = runCacheTime()

    progress("cache-check", 0, 0) if progress != null

    if targetName == ""
      let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

      if manifestPath != null
        let manifest = host::readText(manifestPath)

        targetName = bootstrapManifestString(manifest, "target") if manifest != null
      end
    end
    let target = TargetPlatform.parse(targetName)

    if command == "build" && output == ""
      output = bootstrapDefaultExecutableOutput(firstSource)
    end
    if target != null && (command == "run" || (output != "" && output != "-"))
      var outputIdentity = "run"

      if command == "build"
        output = platformExecutable(output, target)
        let absolute = host::pathAbsolute(output)

        outputIdentity = absolute if absolute != null
      end
      let configuration = runCacheFrame(projectPath) + runCacheFrame(unit) + runCacheFrame(moduleName) + runCacheFrame(sourceRoot) + runCacheFrame(command) + runCacheFrame(outputIdentity)

      incremental.prepare(firstSource, sourceIds, sourceOwners, target, release, configuration, noCache, loadedProject)
      var hit = incremental.hit()

      if hit && command == "build"
        hit = incremental.restore(output)
      end
      runCacheReport(timings, hit ? "incremental-hit" : "incremental-miss", lookupStarted)
      if hit
        progress("cache-hit", 0, 0) if progress != null
        if command == "build"
          runCacheReport(timings, "build-complete", started)
          progress("load", 0, 0) if progress != null
          console::println(output) if !quiet
          return
        end
        runCacheReport(timings, "ready", started)
        progress("load", 0, 0) if progress != null
        let executionStarted = runCacheTime()
        let status = host::run(incremental.cache.executable, programArguments)

        runCacheReport(timings, "execute", executionStarted)
        if status != null
          host::exit(status > 125 ? 125 : status)
          return
        end
      end
    end
  end
  let sourceStarts = new IntBuffer()
  let combinedParts = new StringBuffer()
  let assembleStarted = runCacheTime()
  var combinedLength = 0
  var textNode = sourceTexts.first.nextNode

  while textNode != null
    sourceStarts.add(combinedLength)
    combinedParts.add(textNode.value)
    combinedParts.add("\n")
    combinedLength = combinedLength + (new IrSourceMap(textNode.value)).utf16Length() + 1
    textNode = textNode.nextNode
  end
  let combined = combinedParts.join()

  runCacheReport(timings, "source-assemble", assembleStarted)
  if (batch != null || (loadedProject != null && !noCache)) && projectUnitIsExecutable(projectKind) && !sessionModule && referencePaths.size == 0 && consumerOwner != ""
    var analysisBatch = batch

    if analysisBatch == null
      analysisBatch = new BatchCompilation()
    end
    if analysisBatch != null
      let consumerOwners = new StringTable<Bool>()

      consumerOwners.add(consumerOwner, true)
      let project = loadedProject

      # A batch intentionally shares stable sibling libraries across its units.
      # Interactive builds keep root libraries with the editable consumer.
      if batch == null && project != null && !project.implicit
        let manifest = project.manifestTexts.find(project.manifest)

        if manifest != null
          let parser = new LspJsonParser(manifest.value)
          let config = parser.parse()
          var rootUnit = config.get("units").first

          while rootUnit != null
            consumerOwners.add(neriUnitKey(project.manifest, rootUnit.key), true)
            rootUnit = rootUnit.next
          end
        end
      end

      dependency = analysisBatch.prepare(combined, sourceIds, sourceTexts, sourceStarts, sourceOwners, consumerOwners, timings, !noCache)
    end
  end
  var parseSource = combined
  var dependencyLibrary: DependencyLibrary? = null

  if dependency != null && emit.isExecutable() && !noCache && !sessionModule
    if targetName == ""
      let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

      if manifestPath != null
        let manifest = host::readText(manifestPath)

        targetName = bootstrapManifestString(manifest, "target") if manifest != null
      end
    end
    let target = TargetPlatform.parse(targetName)

    if target != null
      let library = new DependencyLibrary()
      var libraryProgress: (fn(String, Int, Int, String, Int): Void)? = null

      if nativeProgress != null
        let callback = nativeProgress

        libraryProgress = fn(phase, completed, total, detail, sourceOffset)
          callback(phase, completed, total, detail)
        end
      end
      if library.materialize(dependency, combined, sourceIds, sourceTexts, sourceStarts, moduleName, target, release, firstSource, timings, progress, libraryProgress)
        dependencyLibrary = library
      else if library.error != ""
        progress("load", 0, 0) if progress != null
        console::println(library.error)
        irEmitDiagnostics(dependency.model.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
        host::exit(2)
        return
      end
    end
  end
  var parseOffset = 0
  var retainedSyntax: SyntaxArena? = null
  var retainedModel: SemanticModel? = null

  if referencePaths.size > 0
    retainedModel = references.model
  end

  if dependency != null
    parseSource = host::stringSlice(combined, dependency.byteLength, host::stringByteLength(combined) - dependency.byteLength)
    parseOffset = dependency.sourceLength
    retainedSyntax = dependency.syntax
    retainedModel = dependency.model
  end
  let parseStarted = runCacheTime()

  progress("compile", sourceCount, libraryCount) if progress != null
  let lexer = new BootstrapLexer(parseSource)

  lexer.utf16Position = parseOffset
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens, retainedSyntax)

  index = 0
  while index < sourceStarts.size
    parser.addSourceBoundary(sourceStarts.get(index)) if sourceStarts.get(index) >= parseOffset
    index = index + 1
  end
  let root = parser.parseProgram()

  runCacheReport(timings, "parse", parseStarted)
  if parser.diagnostics.count() > 0
    progress("load", 0, 0) if progress != null
    irEmitDiagnostics(parser.diagnostics, "Parse", sourcePaths, sourceTexts, sourceStarts)
    host::exit(1)
    return
  end
  let bindStarted = runCacheTime()
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1), retainedModel)

  binder.requireEntryPoint = !sessionModule && (projectUnitIsExecutable(projectKind) || (projectKind == null && (projectPath == "" || emit.isExecutable())))
  binder.forbiddenEntryPointSources = referencedIds
  binder.clearSources()
  index = 0
  while index < sourceIds.size
    binder.addSource(sourceIds.get(index), sourceStarts.get(index))
    index = index + 1
  end
  let semantic = binder.bind()

  runCacheReport(timings, "bind", bindStarted)
  if semantic.diagnostics.count() > 0
    progress("load", 0, 0) if progress != null
    if implicitProject
      index = 0
      while index < semantic.diagnostics.count()
        semantic.diagnostics.messages.set(index, semantic.diagnostics.messages.get(index) + neriImplicitProjectHint(semantic.diagnostics.codes.get(index)))
        index = index + 1
      end
    end
    progress("load", 0, 0) if progress != null
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
    host::exit(1)
    return
  end
  if retainedModel != null && referencePaths.size == 0 && dependencyLibrary == null
    semanticAdoptDeclarations(semantic, retainedModel)
  end
  let lowerStarted = runCacheTime()

  progress("lower", 0, 0) if progress != null
  let lowerer = new IrLowerer(semantic, parser.arena, combined, moduleName)

  lowerer.setSources(sourceIds, sourceTexts, sourceStarts)
  if referencePaths.size > 0
    lowerer.retain(references.declarations)
  end
  if dependencyLibrary != null
    dependencyLibrary.retain(lowerer, references)
  end
  let module = lowerer.lower()

  runCacheReport(timings, "lower", lowerStarted)
  if semantic.diagnostics.count() > 0
    progress("load", 0, 0) if progress != null
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
    host::exit(1)
    return
  end
  if sessionModule
    var sessionEntry: IrFunction? = null
    var candidate = module.firstFunction

    while candidate != null
      if candidate.symbol.name == "__neri_session_entry"
        sessionEntry = candidate
      end
      candidate = candidate.nextFunction
    end
    if sessionEntry == null
      progress("load", 0, 0) if progress != null
      console::println("SessionModule: generated __neri_session_entry is missing")
      host::exit(1)
      return
    end
    let entry = sessionEntry

    let targetType = irIsOptional(entry.resultType) ? irTypeInner(entry.resultType) : entry.resultType
    var invalidSource = entry.parameterTypes.size > 1

    if entry.parameterTypes.size == 1
      invalidSource = irTypeKind(entry.parameterTypes.get(0)) != "class"
    end
    if invalidSource || irTypeKind(targetType) != "class"
      progress("load", 0, 0) if progress != null
      console::println("SessionModule: entry must take zero or one managed frame and return a managed frame or optional managed frame")
      host::exit(1)
      return
    end
    module.exportSession(entry)
  end
  let verificationStarted = runCacheTime()
  let verification = irVerify(module)

  runCacheReport(timings, "ir-verify", verificationStarted)
  if !verification.succeeded()
    progress("load", 0, 0) if progress != null
    index = 0
    while index < verification.errors.size
      progress("load", 0, 0) if progress != null
      console::println("NIRV|" + verification.errors.get(index))
      index = index + 1
    end
    host::exit(1)
    return
  end
  if emit.usesCodegen()
    runCacheReport(timings, "frontend", started)
    progress("codegen", 0, 0) if progress != null
    if targetName == ""
      let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

      if manifestPath != null
        let manifest = host::readText(manifestPath)

        if manifest != null
          targetName = bootstrapManifestString(manifest, "target")
        end
      end
    end
    let target = TargetPlatform.parse(targetName)

    if target == null
      progress("load", 0, 0) if progress != null
      console::println("--target must be linux-x86_64, macos-arm64 or windows-x86_64 for native artifacts")
      host::exit(2)
      return
    end
    var runDirectory = ""
    let cache = new RunCache()

    if command == "run"
      let lookupStarted = runCacheTime()

      progress("cache-check", 0, 0) if progress != null

      if !noCache && referencePaths.size == 0 && !incremental.enabled
        cache.prepare(module, target, release, firstSource)
      end
      let hit = cache.hit()

      runCacheReport(timings, hit ? "cache-hit" : "cache-miss", lookupStarted)
      if hit
        progress("cache-hit", 0, 0) if progress != null
        runCacheReport(timings, "ready", started)
        progress("load", 0, 0) if progress != null
        let executionStarted = runCacheTime()
        let result = host::run(cache.executable, programArguments)

        runCacheReport(timings, "execute", executionStarted)
        if result != null
          host::exit(result > 125 ? 125 : result)
          return
        end
        # A vanished or non-executable artifact is a miss, not a program error.
      end
      var directory: String? = null

      if cache.directory != ""
        directory = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "pending")
      end
      if directory == null
        directory = bootstrapRunDirectory()
      end
      if directory == null
        progress("load", 0, 0) if progress != null
        console::println("could not create temporary run directory")
        host::exit(2)
        return
      end
      runDirectory = directory
      output = directory + "/program"
    end
    if output == "" && command == "build" && emit.isExecutable()
      let first = firstSource

      if first != null
        let name = host::pathFileName(first.path)

        if name != null
          let length = host::stringByteLength(name)

          if length > 3 && (host::stringByteAt(name, length - 3) as Int) == 46 && (host::stringByteAt(name, length - 2) as Int) == 104 && (host::stringByteAt(name, length - 1) as Int) == 107
            output = "./" + host::stringSlice(name, 0, length - 3)
          end
        end
      end
    end
    if output == ""
      progress("load", 0, 0) if progress != null
      console::println("--output is required for native artifacts")
      host::exit(2)
      return
    end
    if (emit.isObject() || emit.isExecutable()) && output == "-"
      progress("load", 0, 0) if progress != null
      console::println("--output - is not valid for " + emit.name())
      host::exit(2)
      return
    end
    if emit.isExecutable()
      output = platformExecutable(output, target)
    end
    if emitReference
      let ownedIds = new StringBuffer()

      index = 0
      while index < sourceIds.size
        if sourceOwners.get(index) == consumerOwner
          ownedIds.add(sourceIds.get(index))
        end
        index = index + 1
      end
      if !referenceEmit(semantic, module, ownedIds, sourceIds, sourceStarts, references.compilerIdentity, target, output, release, firstSource)
        progress("load", 0, 0) if progress != null
        host::exit(2)
        return
      end
      runCacheReport(timings, "build-complete", started)
      progress("load", 0, 0) if progress != null
      console::println(output) if !quiet
      return
    end
    var units: IrCompilationUnit? = null

    if emit.isExecutable() && !sessionModule && consumerOwner != "" && referencePaths.size == 0
      let partitionStarted = runCacheTime()

      units = irPartitionModule(module, semantic, sourceIds, sourceOwners, consumerOwner)
      runCacheReport(timings, units == null ? "partition-fallback" : "partition", partitionStarted)
    end
    var nativeSucceeded = false
    var relay: (fn(String, Int, Int, String, Int): Void)? = null

    if nativeProgress != null
      let capturedSources = firstSource
      let callback = nativeProgress

      relay = fn(phase, completed, total, detail, sourceOffset)
        callback(phase, completed, total, bootstrapNativeProgressLabel(module, capturedSources, phase, detail, sourceOffset))
      end
    end

    if units != null
      nativeSucceeded = bootstrapEmitCompilationUnits(module, units, output, target, release, timings,
        noCache, firstSource, incremental.enabled ? linkInputs : null, progress, relay, references)
    else
      nativeSucceeded = bootstrapEmitNative(module, emit, output, target, release, timings, firstSource, references, incremental.enabled ? linkInputs : null, progress, relay)
    end

    progress("load", 0, 0) if progress != null

    if nativeSucceeded && linkInputs.valid
      incremental.publish(output, linkInputs.inputs, linkInputs.missing, linkInputs.digests)
    end
    if nativeSucceeded && command == "build"
      runCacheReport(timings, "build-complete", started)
    end
    if command == "run"
      var status = 2

      if nativeSucceeded
        if cache.publish(runDirectory)
          runDirectory = ""
        end
        if cache.hit()
          output = cache.executable
        end
        runCacheReport(timings, "ready", started)
        let executionStarted = runCacheTime()
        let result = host::run(output, programArguments)

        runCacheReport(timings, "execute", executionStarted)
        if result != null
          status = result
        else
          progress("load", 0, 0) if progress != null
          console::println("could not run executable: " + host::errorMessage())
        end
      end
      if runDirectory != ""
        bootstrapRemoveRunDirectory(runDirectory)
      end
      if status > 125
        status = 125
      end
      host::exit(status)
      return
    end
    if !nativeSucceeded
      host::exit(2)
    end
    if output != "-" && !quiet
      progress("load", 0, 0) if progress != null
      console::println(output)
    end
  else if emit.isCHeader()
    let headerError = irCHeaderError(module)

    if headerError != ""
      progress("load", 0, 0) if progress != null
      console::println("CHeader: " + headerError)
      host::exit(1)
      return
    end
    let artifact = irCHeader(module)

    if !bootstrapWriteArtifact(output, artifact)
      host::exit(2)
    end
  else if emit.isNeriIRHex()
    let artifact = irSerializeEnvelopeHex(module)

    if !bootstrapWriteArtifact(output, artifact)
      host::exit(2)
    end
  else
    let artifact = irRenderModule(module)

    if !bootstrapWriteArtifact(output, artifact)
      host::exit(2)
    end
  end
end
