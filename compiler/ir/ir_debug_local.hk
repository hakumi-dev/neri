class IrDebugLocal
  public name: String = ""
  public value: Int = 0
  public location: IrLocation = new IrLocation(false, 0, 0)
  public scopeId: Int = 0
  public nextLocal: IrDebugLocal?
  public emitted: Bool = false

  def init(name: String, value: Int, location: IrLocation, scopeId: Int = 0): Void
    this.name = name
    this.value = value
    this.location = location
    this.scopeId = scopeId
  end
end
