def irLowerTaskGenerate(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let typeName = irType(lowerer.bound.typeAt(node))
  let signature = lowerer.semantic.findClass(lowerer.bound.dataAt(node))

  if signature == null
    return new IrValue(-1, typeName)
  end
  let invoke = signature.firstMethod

  if invoke == null
    return new IrValue(-1, typeName)
  end
  if !lowerer.module.requiredFeatures.hasScopedTasks()
    lowerer.module.requiredFeatures.requireScopedTasks()
  end
  let count = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 0), "int")
  let workers = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 1), "int")
  let callback = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 2), "class|" + signature.fullName)
  let slot = lowerer.dispatchSlot(signature, invoke)

  lowerer.addVirtualCallees(context, slot, callback.typeName)
  let receiver = lowerer.virtualOperands(context, [callback.id], callback.typeName, slot)
  let location = lowerer.location(node)
  # Source binding proves shared captures and the parallel callback capability.
  # The native boundary explicitly trusts that proof for disjoint result writes.
  let capability = context.emitValue(lowerer.module.domains.opcode.getUnsafeBegin(), "!unsafe", irEmptyInts(), location)
  let result = context.emit(lowerer.module.domains.opcode.getTaskGenerate(), typeName, [capability.id, count.id, workers.id, receiver[0]], [irTypeInner(typeName)], irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getMethod(), slot), null, "", null, false, location)

  context.emitValue(lowerer.module.domains.opcode.getUnsafeEnd(), "void", [capability.id], location)
  context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withWrite().withMayPanic().withManagedAllocate().withSafepoint().withUnsafe())
  return result
end
