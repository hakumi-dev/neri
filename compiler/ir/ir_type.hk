use host

sealed class IrType
  private typeKind: readonly IrTypeKind
  private child: (readonly IrType)?
  private name: String
  private count: Int
  private signature: (readonly IrType)[]
  private key: String

  private def init(kind: readonly IrTypeKind, child: (readonly IrType)?, name: String, count: Int, signature: (readonly IrType)[], key: String): Void
    this.typeKind = kind
    this.child = child
    this.name = name
    this.count = count
    this.signature = signature
    this.key = key
  end

  static def scalar(kind: readonly IrTypeKind): readonly IrType
    if !(kind.isVoid() || kind.isBool() || kind.isByte() || kind.isInt() || kind.isFloat() || kind.isString() || kind.isInt32() || kind.isUint32() || kind.isUint64() || kind.isFloat32() || kind.isUnsafeCapability())
      irInvariantFailure("IR scalar type requires a scalar kind")
    end
    return new IrType(kind, null, "", 0, [], kind.displayName())
  end

  static def unary(kind: readonly IrTypeKind, element: readonly IrType): readonly IrType
    if !(kind.isArray() || kind.isOptional() || kind.isPointer() || kind.isBorrowCapability())
      irInvariantFailure("IR unary type requires an element-bearing kind")
    end
    return new IrType(kind, element, "", 0, [], kind.displayName() + "|" + element.canonicalKey())
  end

  static def nominal(kind: readonly IrTypeKind, name: String): readonly IrType
    if !(kind.isClass() || kind.isNativeRecord()) || name == ""
      irInvariantFailure("IR nominal type requires a nonempty class or record name")
    end
    return new IrType(kind, null, name, 0, [], kind.displayName() + "|" + name)
  end

  static def fixedArray(kind: readonly IrTypeKind, element: readonly IrType, count: Int): readonly IrType
    if !kind.isFixedArray() || count <= 0 || count > 4294967295
      irInvariantFailure("IR fixed array requires a positive UInt32 element count")
    end
    return new IrType(kind, element, "", count, [], "fixed-array|" + (count as String) + "|" + element.canonicalKey())
  end

  static def cFunction(kind: readonly IrTypeKind, result: readonly IrType, parameters: (readonly IrType)[]): readonly IrType
    if !kind.isCFunction()
      irInvariantFailure("IR C function requires a callable kind")
    end
    var signature: (readonly IrType)[] = [result]
    var key = "c-function|" + (parameters.Length as String) + "|" + (host::stringByteLength(result.canonicalKey()) as String) + ":" + result.canonicalKey()

    for parameter in parameters
      signature = irAppendType(signature, parameter)
      key = key + "|" + (host::stringByteLength(parameter.canonicalKey()) as String) + ":" + parameter.canonicalKey()
    end
    return new IrType(kind, null, "", 0, signature, key)
  end

  readonly def kind(): readonly IrTypeKind
    return this.typeKind
  end

  readonly def canonicalKey(): String
    return this.key
  end

  readonly def same(other: readonly IrType): Bool
    return this.key == other.key
  end

  readonly def element(): readonly IrType
    let child = this.child

    if child != null
      return child
    end
    irInvariantFailure("IR type has no element")
    return this
  end

  readonly def nominalName(): String
    return this.name
  end

  readonly def elementCount(): Int
    return this.count
  end

  readonly def componentCount(): Int
    return this.signature.Length
  end

  readonly def component(index: Int): readonly IrType
    return this.signature[index]
  end
end
