class IrEffectCaller
  public function: IrFunction
  public nextCaller: IrEffectCaller?

  def init(function: IrFunction, nextCaller: IrEffectCaller?): Void
    this.function = function
    this.nextCaller = nextCaller
  end
end

def irEffectFunction(module: IrModule, name: String): IrFunction?
  var function = module.firstFunction
  while function != null
    if function.symbol.name == name
      return function
    end
    function = function.nextFunction
  end
  return null
end

def irPropagateEffects(module: IrModule, parallel: Bool = false): Void
  var function = module.firstFunction
  while function != null
    function.effects = function.localEffects
    if parallel && function.parallelUnsafe
      function.effects = irEffectUnion(function.effects, 64)
    end
    function.effectCallers = null
    function.effectQueueNext = null
    function.effectQueued = false
    function = function.nextFunction
  end
  # Resolve each edge once. Reverse edges visit only affected callers later.
  function = module.firstFunction
  while function != null
    var callees = function.callees
    let precise = function.parallelCallees
    callees = precise if parallel && precise != null
    var index = 0
    while index < callees.size
      let callee = irEffectFunction(module, callees.get(index))
      if callee != null
        callee.effectCallers = new IrEffectCaller(function, callee.effectCallers)
        function.effects = irEffectUnion(function.effects, 32)
      end
      index = index + 1
    end
    function = function.nextFunction
  end
  var first: IrFunction? = null
  var last: IrFunction? = null
  function = module.firstFunction
  while function != null
    if last == null
      first = function
    else
      last.effectQueueNext = function
    end
    last = function
    function.effectQueued = true
    function = function.nextFunction
  end
  while first != null
    let current = first
    first = current.effectQueueNext
    if first == null
      last = null
    end
    current.effectQueueNext = null
    current.effectQueued = false
    var propagated = current.effects
    # Noreturn describes the whole callee, not its callers or dispatch slot.
    if irHasEffect(propagated, 128)
      propagated = propagated - 128
    end
    var edge = current.effectCallers
    while edge != null
      let caller = edge.function
      let nextEffects = irEffectUnion(caller.effects, propagated)
      if nextEffects != caller.effects
        caller.effects = nextEffects
        if !caller.effectQueued
          caller.effectQueued = true
          if last == null
            first = caller
          else
            last.effectQueueNext = caller
          end
          last = caller
        end
      end
      edge = edge.nextCaller
    end
  end
  # The graph is scratch state; only the inferred summaries remain in the IR.
  function = module.firstFunction
  while function != null
    function.effectCallers = null
    function = function.nextFunction
  end
end
