use host
use crypto

class RunCacheFile
  public fingerprint: String = ""
  public kind: Int = 0
  public permissions: Int = 0
  public owned: Bool = false

  def init(path: String, follow: Bool): Void
    let name = runCacheBytes(path)

    unsafe
      let kind = stackalloc Int[1]
      let permissions = stackalloc Int[1]
      let owned = stackalloc Int[1]
      var digest: Byte[] = []
      var index = 0

      while index < 32
        digest = host.appendByte(digest, 0 as Byte)
        index = index + 1
      end
      var status = -1

      borrow name as pathBytes
        borrow digest as fingerprint
          status = runCacheMetadata(pathBytes, host.stringByteLength(path), follow ? 1 : 0, kind, permissions, owned, fingerprint)
        end
      end
      if status != 0
        return
      end
      let encoded = crypto.encodeHex(digest)

      if encoded == null
        return
      end
      this.kind = kind[0]
      this.permissions = permissions[0]
      this.owned = owned[0] == 1
      this.fingerprint = encoded
    end
  end
end
