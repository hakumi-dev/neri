class BatchDependency
  public identity: String
  public syntax: SyntaxArena
  public model: SemanticModel
  public identifiers: StringTable<Bool> = new StringTable<Bool>()
  public byteLength: Int
  public sourceLength: Int
  public root: Int
  public importScope: String = ""
  private baseUses: StringTable<Bool> = new StringTable<Bool>()

  def init(identity: String, syntax: SyntaxArena, root: Int, model: SemanticModel, byteLength: Int, sourceLength: Int, followingUses: String[], tokens: TokenBuffer): Void
    this.identity = identity
    this.syntax = syntax
    this.model = model
    this.byteLength = byteLength
    this.sourceLength = sourceLength
    this.root = root
    var index = 0

    while index < syntax.childCountAt(root)
      let node = syntax.childAt(root, index)

      if syntax.kindAt(node).isUse()
        let declaration = syntax.useAt(node)

        if declaration != null && declaration.alias == ""
          this.baseUses.add(declaration.namespaceName, true)
        end
      end
      index = index + 1
    end
    this.importScope = this.scopeKey(followingUses)
    var token = tokens.first.nextNode

    while token != null
      this.identifiers.add(token.text, true) if token.kind.isIdentifier()
      token = token.nextNode
    end
  end

  def scopeKey(followingUses: String[]): String
    let seen = new StringTable<Bool>()
    var result = ""

    for name in followingUses
      if this.baseUses.find(name) == null && seen.add(name, true)
        result = result + runCacheFrame(name)
      end
    end
    return result
  end

  def accepts(parser: BootstrapParser, root: Int): Bool
    var index = 0

    while index < parser.arena.childCountAt(root)
      let node = parser.arena.childAt(root, index)
      let kind = parser.arena.kindAt(node)

      if !kind.isUse() && !kind.isNamespace()
        let declaration = parser.arena.declarationAt(node)

        if declaration == null
          return false
        end
        let name = declaration.name

        # A consumer declaration referenced by a dependency can change resolution.
        # Such units use the ordinary whole-program analysis.
        if this.identifiers.find(name) != null
          return false
        end
      end
      index = index + 1
    end
    return true
  end
end
