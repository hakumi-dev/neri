def irType(typeName: String): String
  if typeName == "Void"
    return "void"
  end
  if typeName == "Bool"
    return "bool"
  end
  if typeName == "Byte"
    return "byte"
  end
  if typeName == "Int"
    return "int"
  end
  if typeName == "Float"
    return "float"
  end
  if typeName == "String"
    return "string"
  end
  if semanticIsArray(typeName)
    return "array|" + irType(semanticInnerType(typeName))
  end
  if semanticIsOptional(typeName)
    return "optional|" + irType(semanticInnerType(typeName))
  end
  if semanticIsPointer(typeName)
    return "pointer|" + irType(semanticInnerType(typeName))
  end
  return "class|" + typeName
end

def irTypeInner(typeName: String): String
  let separator = semanticFindByte(typeName, 124)
  if separator < 0
    return ""
  end
  return host.stringSlice(typeName, separator + 1, host.stringByteLength(typeName) - separator - 1)
end

def irTypeKind(typeName: String): String
  let separator = semanticFindByte(typeName, 124)
  if separator < 0
    return typeName
  end
  return host.stringSlice(typeName, 0, separator)
end

def irIsVoid(typeName: String): Bool
  return typeName == "void"
end

def irIsManaged(typeName: String): Bool
  let kind = irTypeKind(typeName)
  return typeName == "string" || kind == "array" || kind == "class"
end

def irIsOptional(typeName: String): Bool
  return irTypeKind(typeName) == "optional"
end

def irIsPointer(typeName: String): Bool
  return irTypeKind(typeName) == "pointer"
end

def irTypeEqual(left: String, right: String): Bool
  return left == right
end

def irRenderType(typeName: String): String
  let kind = irTypeKind(typeName)
  if kind == "array"
    return "array<" + irRenderType(irTypeInner(typeName)) + ">"
  end
  if kind == "optional"
    return "optional<" + irRenderType(irTypeInner(typeName)) + ">"
  end
  if kind == "pointer"
    return "ptr<" + irRenderType(irTypeInner(typeName)) + ">"
  end
  if kind == "class"
    return "class<" + irTypeInner(typeName) + ">"
  end
  if kind == "borrow"
    return "!borrow<" + irRenderType(irTypeInner(typeName)) + ">"
  end
  return typeName
end

def irTypeTag(typeName: String): Int
  if typeName == "void"
    return 1
  end
  if typeName == "bool"
    return 2
  end
  if typeName == "byte"
    return 3
  end
  if typeName == "int"
    return 4
  end
  if typeName == "float"
    return 5
  end
  if typeName == "string"
    return 6
  end
  let kind = irTypeKind(typeName)
  if kind == "array"
    return 16
  end
  if kind == "class"
    return 17
  end
  if kind == "optional"
    return 18
  end
  if kind == "pointer"
    return 19
  end
  if typeName == "!unsafe"
    return 32
  end
  if kind == "borrow"
    return 33
  end
  return 0
end

def irHasEffect(effects: Int, effect: Int): Bool
  return (effects / effect) - ((effects / effect) / 2) * 2 == 1
end

def irEffectUnion(left: Int, right: Int): Int
  var result = left
  var effect = 1
  while effect <= 128
    if irHasEffect(right, effect) && !irHasEffect(result, effect)
      result = result + effect
    end
    effect = effect * 2
  end
  return result
end
