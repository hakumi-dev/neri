def irTypeInner(typeName: readonly IrType): readonly IrType
  return typeName.element()
end

def irTypeKind(typeName: readonly IrType): readonly IrTypeKind
  return typeName.kind()
end

def irIsVoid(typeName: readonly IrType): Bool
  return typeName.kind().isVoid()
end

def irIsManaged(typeName: readonly IrType): Bool
  let kind = typeName.kind()

  return kind.isString() || kind.isArray() || kind.isClass()
end

def irIsOptional(typeName: readonly IrType): Bool
  return typeName.kind().isOptional()
end

def irIsPointer(typeName: readonly IrType): Bool
  return typeName.kind().isPointer()
end

def irTypeEqual(left: readonly IrType, right: readonly IrType): Bool
  return left.same(right)
end

def irRenderType(typeName: readonly IrType): String
  let kind = typeName.kind()

  if kind.isCFunction()
    var result = "cabi fn("
    var index = 1

    while index < typeName.componentCount()
      result = result + ", " if index > 1
      result = result + irRenderType(typeName.component(index))
      index = index + 1
    end
    return result + "): " + irRenderType(typeName.component(0))
  end
  if kind.isArray()
    return "array<" + irRenderType(typeName.element()) + ">"
  end
  if kind.isOptional()
    return "optional<" + irRenderType(typeName.element()) + ">"
  end
  if kind.isPointer()
    return "ptr<" + irRenderType(typeName.element()) + ">"
  end
  if kind.isClass()
    return "class<" + typeName.nominalName() + ">"
  end
  if kind.isNativeRecord()
    return "record|" + typeName.nominalName()
  end
  if kind.isFixedArray()
    return "fixed-array|" + (typeName.elementCount() as String) + "|" + irRenderType(typeName.element())
  end
  if kind.isBorrowCapability()
    return "!borrow<" + irRenderType(typeName.element()) + ">"
  end
  if kind.isUnsafeCapability()
    return "!unsafe"
  end
  return kind.displayName()
end

def irIsExtendedScalar(typeName: readonly IrType): Bool
  let kind = typeName.kind()

  return kind.isInt32() || kind.isUint32() || kind.isUint64() || kind.isFloat32()
end

def irIsInteger(typeName: readonly IrType): Bool
  let kind = typeName.kind()

  return kind.isInt() || kind.isInt32() || kind.isUint32() || kind.isUint64()
end

def irIsFloat(typeName: readonly IrType): Bool
  let kind = typeName.kind()

  return kind.isFloat() || kind.isFloat32()
end

def irTypeComponents(typeName: readonly IrType): IrTypeBuffer
  let result = new IrTypeBuffer()
  var index = 0

  while index < typeName.componentCount()
    result.add(typeName.component(index))
    index = index + 1
  end
  return result
end
