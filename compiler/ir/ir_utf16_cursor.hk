class IrUtf16Cursor
  public text: String = ""
  public bytePosition: Int = 0
  public pendingLow: Int = -1

  def init(text: String): Void
    this.text = text
  end

  def hasNext(): Bool
    return this.pendingLow >= 0 || this.bytePosition < host.stringByteLength(this.text)
  end

  def nextUnit(): Int
    if this.pendingLow >= 0
      let value = this.pendingLow

      this.pendingLow = -1
      return value
    end
    let point = codePointAt(this.text, this.bytePosition)

    this.bytePosition = this.bytePosition + utf8Width(host.stringByteAt(this.text, this.bytePosition) as Int)
    if point <= 65535
      return point
    end
    let scalar = point - 65536

    this.pendingLow = 56320 + (scalar - (scalar / 1024) * 1024)
    return 55296 + scalar / 1024
  end
end
