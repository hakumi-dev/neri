use console
use host

def bootstrapFindText(text: String, pattern: String): Int
  let textLength = host.stringByteLength(text)
  let patternLength = host.stringByteLength(pattern)
  var start = 0
  while start + patternLength <= textLength
    var matched = 0
    while matched < patternLength && host.stringByteAt(text, start + matched) == host.stringByteAt(pattern, matched)
      matched = matched + 1
    end
    if matched == patternLength
      return start
    end
    start = start + 1
  end
  return -1
end

def bootstrapManifestString(text: String, name: String): String
  let marker = "\"" + name + "\":"
  let found = bootstrapFindText(text, marker)
  if found < 0
    return ""
  end
  var start = found + host.stringByteLength(marker)
  while start < host.stringByteLength(text)
    let byte = host.stringByteAt(text, start) as Int
    if byte != 9 && byte != 10 && byte != 13 && byte != 32
      break
    end
    start = start + 1
  end
  if start >= host.stringByteLength(text) || (host.stringByteAt(text, start) as Int) != 34
    return ""
  end
  start = start + 1
  var finish = start
  while finish < host.stringByteLength(text) && (host.stringByteAt(text, finish) as Int) != 34
    finish = finish + 1
  end
  return host.stringSlice(text, start, finish - start)
end

def bootstrapManifestInt(text: String, name: String): Int?
  let marker = "\"" + name + "\":"
  let found = bootstrapFindText(text, marker)
  if found < 0
    return null
  end
  var start = found + host.stringByteLength(marker)
  while start < host.stringByteLength(text)
    let byte = host.stringByteAt(text, start) as Int
    if byte != 9 && byte != 10 && byte != 13 && byte != 32
      break
    end
    start = start + 1
  end
  var finish = start
  while finish < host.stringByteLength(text)
    let byte = host.stringByteAt(text, finish) as Int
    if byte < 48 || byte > 57
      break
    end
    finish = finish + 1
  end
  if finish == start
    return null
  end
  return host.parseInt(host.stringSlice(text, start, finish - start))
end

def bootstrapManifestRequiredInt(text: String, name: String): Int
  let value = bootstrapManifestInt(text, name)
  if value != null
    return value
  end
  return -1
end

def bootstrapFeaturePresent(features: Int, feature: Int): Bool
  let bucket = features / feature
  return bucket - (bucket / 2) * 2 == 1
end

def bootstrapFeatureUnion(features: Int, additions: Int): Int
  var result = features
  var feature = 1
  while feature <= additions && feature <= 1152921504606846976
    if bootstrapFeaturePresent(additions, feature) && !bootstrapFeaturePresent(result, feature)
      result = result + feature
    end
    feature = feature * 2
  end
  return result
end

def bootstrapRequiredRuntimeMinor(module: IrModule): Int
  var required = module.hasFeature("native-strings-v1") ? 2 : 1
  if module.hasFeature("scoped-tasks-v1")
    required = 10
  else if module.hasFeature("extended-scalars-v1")
    required = 9
  end
  var importValue = module.firstImport
  while importValue != null
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_") && required < 11
      required = 11
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_interrupt_") && required < 12
      required = 12
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_clock_wall_") && required < 13
      required = 13
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_crypto_") && required < 14
      required = 14
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_root_") && required < 15
      required = 15
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_process_") && required < 16
      required = 16
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_directory_") && required < 17
      required = 17
    end
    if importValue.linkName == "neri_rt_v1_net_close_result" && required < 18
      required = 18
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_drain_") && required < 20
      required = 20
    end
    if (bootstrapStartsWith(importValue.linkName, "neri_rt_v1_terminal_") || bootstrapStartsWith(importValue.linkName, "neri_rt_v1_clock_")) && required < 8
      required = 8
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_net_") && required < 7
      required = 7
    end
    if importValue.kind == 1 && importValue.runtimeMinor > required
      required = importValue.runtimeMinor
    end
    importValue = importValue.nextImport
  end
  return required
end

def bootstrapRequiredRuntimeFeatures(module: IrModule): Int
  var required = 32
  required = bootstrapFeatureUnion(required, 16384) if module.hasFeature("scoped-tasks-v1")
  if module.hasFeature("extended-scalars-v1")
    required = bootstrapFeatureUnion(required, 512)
  end
  if module.hasFeature("native-strings-v1")
    required = bootstrapFeatureUnion(required, 64)
  end
  var importValue = module.firstImport
  while importValue != null
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_")
      required = bootstrapFeatureUnion(required, 32768)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_interrupt_")
      required = bootstrapFeatureUnion(required, 65536)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_clock_wall_")
      required = bootstrapFeatureUnion(required, 131072)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_crypto_")
      required = bootstrapFeatureUnion(required, 262144)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_root_")
      required = bootstrapFeatureUnion(required, 524288)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_process_")
      required = bootstrapFeatureUnion(required, 1048576)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_file_directory_")
      required = bootstrapFeatureUnion(required, 2097152)
    end
    if importValue.linkName == "neri_rt_v1_net_close_result"
      required = bootstrapFeatureUnion(required, 4194304)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_drain_")
      required = bootstrapFeatureUnion(required, 16777216)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_net_")
      required = bootstrapFeatureUnion(required, 4096)
    end
    if bootstrapStartsWith(importValue.linkName, "neri_rt_v1_terminal_") || bootstrapStartsWith(importValue.linkName, "neri_rt_v1_clock_")
      required = bootstrapFeatureUnion(required, 8192)
    end
    if importValue.kind == 1
      required = bootstrapFeatureUnion(required, importValue.runtimeFeatures)
    end
    importValue = importValue.nextImport
  end
  return required
end

def bootstrapArtifactNameValid(value: String): Bool
  if value == "" || bootstrapStartsWith(value, "/") || bootstrapFindText(value, "..") >= 0 || bootstrapFindText(value, "\\") >= 0
    return false
  end
  return true
end

def bootstrapDirectory(path: String): String
  var slash = -1
  var index = 0
  while index < host.stringByteLength(path)
    if (host.stringByteAt(path, index) as Int) == 47
      slash = index
    end
    index = index + 1
  end
  if slash < 0
    return "."
  end
  if slash == 0
    return "/"
  end
  return host.stringSlice(path, 0, slash)
end

def bootstrapRun(executable: String, arguments: String[]): Bool
  let status = host.run(executable, arguments)
  if status == null
    console.println("could not execute '" + executable + "': " + host.errorMessage())
    return false
  end
  if status != 0
    console.println("'" + executable + "' failed with status " + (status as String))
    return false
  end
  return true
end

def bootstrapCodegenEmitName(emit: String): String
  if emit == "asm"
    return "assembly"
  end
  if emit == "obj" || emit == "executable"
    return "object"
  end
  return "llvm-ir"
end

def bootstrapInvokeCodegen(module: IrModule, emit: String, output: String, target: String, release: Bool): Bool
  let optionalCodegen = host.environment("NERI_CODEGEN")
  if optionalCodegen == null || optionalCodegen == ""
    console.println("NERI_CODEGEN must name the native neri-codegen executable")
    return false
  end
  let codegen = optionalCodegen
  let transport = output + ".nir.hex"
  if !host.writeText(transport, irSerializeEnvelopeHex(module))
    console.println("could not write Neri IR transport: " + host.errorMessage())
    return false
  end
  let arguments: String[] = [
    "--input", transport,
    "--input-format", "hex",
    "--target", target,
    "--optimization", release ? "release" : "debug",
    "--emit", bootstrapCodegenEmitName(emit),
    "--output", output
  ]
  let succeeded = bootstrapRun(codegen, arguments)
  host.removeFile(transport)
  return succeeded
end

def bootstrapLinkExecutable(module: IrModule, objectPath: String, output: String, target: String): Bool
  let optionalManifest = host.environment("NERI_RUNTIME_MANIFEST")
  if optionalManifest == null || optionalManifest == ""
    console.println("NERI_RUNTIME_MANIFEST must name the runtime package manifest")
    return false
  end
  let manifestPath = optionalManifest
  let optionalManifestText = host.readText(manifestPath)
  if optionalManifestText == null
    console.println("could not read runtime manifest: " + host.errorMessage())
    return false
  end
  let manifestText = optionalManifestText
  let schemaVersion = bootstrapManifestRequiredInt(manifestText, "schemaVersion")
  let transportMajor = bootstrapManifestRequiredInt(manifestText, "irTransportMajor")
  let transportMinor = bootstrapManifestRequiredInt(manifestText, "irTransportMinor")
  let abiMajor = bootstrapManifestRequiredInt(manifestText, "abiMajor")
  let abiMinor = bootstrapManifestRequiredInt(manifestText, "abiMinor")
  let features = bootstrapManifestRequiredInt(manifestText, "features")
  let requiredMinor = bootstrapRequiredRuntimeMinor(module)
  let requiredFeatures = bootstrapRequiredRuntimeFeatures(module)
  if schemaVersion < 0 || transportMajor < 0 || transportMinor < 0 || abiMajor < 0 || abiMinor < 0 || features < 0
    console.println("runtime manifest is missing a required field")
    return false
  end
  if schemaVersion != 2 || bootstrapManifestString(manifestText, "toolchainVersion") != "0.2.0-dev" || transportMajor != 1 || transportMinor != 1 || bootstrapManifestString(manifestText, "target") != target || abiMajor != 1
    console.println("runtime manifest does not match Neri 0.2.0-dev, IR transport 1.1, target '" + target + "', and ABI v1")
    return false
  end
  if abiMinor < requiredMinor
    console.println("runtime manifest does not provide the required ABI minor version")
    return false
  end
  var requiredFeature = 1
  while requiredFeature <= requiredFeatures && requiredFeature <= 1152921504606846976
    if bootstrapFeaturePresent(requiredFeatures, requiredFeature) && !bootstrapFeaturePresent(features, requiredFeature)
      console.println("runtime manifest does not provide the required ABI features")
      return false
    end
    requiredFeature = requiredFeature * 2
  end
  let artifact = bootstrapManifestString(manifestText, "artifact")
  if !bootstrapArtifactNameValid(artifact)
    console.println("runtime manifest has an invalid artifact path")
    return false
  end
  let optionalRuntime = host.pathJoin(bootstrapDirectory(manifestPath), artifact)
  if optionalRuntime == null
    console.println("runtime artifact path is invalid")
    return false
  end
  var linker = platformLinker(target)
  let configuredLinker = host.environment("NERI_LINKER")
  if configuredLinker != null && configuredLinker != ""
    linker = configuredLinker
  end
  var arguments = platformLinkArguments(target, objectPath, optionalRuntime, output)
  if target == "linux-x86_64" && bootstrapFeaturePresent(requiredFeatures, 262144)
    arguments = host.appendString(arguments, "-lcrypto")
  end
  if module.hasFeature("native-libraries-v1")
    var directory = target == "macos-arm64" ? "/opt/homebrew/lib" : ""
    let configuredDirectory = host.environment("NERI_LIBRARY_PATH")
    if configuredDirectory != null && configuredDirectory != ""
      directory = configuredDirectory
    end
    if directory != ""
      if !platformAbsolutePath(directory, target)
        console.println("NERI_LIBRARY_PATH must be an absolute directory")
        return false
      end
      arguments = platformLibraryArguments(arguments, directory, target)
    end
    var libraries = new StringBuffer()
    var imported = module.firstImport
    while imported != null
      let library = imported.nativeLibrary
      if library != ""
        if !semanticNativeLibraryName(library)
          console.println("invalid native library name")
          return false
        end
        var found = false
        var index = 0
        while index < libraries.size
          if libraries.get(index) == library
            found = true
          end
          index = index + 1
        end
        if !found
          libraries.add(library)
          arguments = host.appendString(arguments, "-l" + library)
        end
      end
      imported = imported.nextImport
    end
  end
  return bootstrapRun(linker, arguments)
end

def bootstrapEmitNative(module: IrModule, emit: String, output: String, target: String, release: Bool, timings: Bool = false): Bool
  if emit != "executable"
    return bootstrapInvokeCodegen(module, emit, output, target, release)
  end
  let objectPath = output + ".o"
  let codegenStarted = runCacheTime()
  if !bootstrapInvokeCodegen(module, emit, objectPath, target, release)
    return false
  end
  runCacheReport(timings, "codegen", codegenStarted)
  let linkStarted = runCacheTime()
  let linked = bootstrapLinkExecutable(module, objectPath, output, target)
  runCacheReport(timings, "link", linkStarted)
  host.removeFile(objectPath)
  return linked
end
