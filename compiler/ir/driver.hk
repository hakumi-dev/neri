use console
use host
use process

def bootstrapCodegenProgress(path: String, consumed: Int, progress: fn(String, Int, Int, String, Int): Void): Int
  let content = host::readText(path)

  if content == null
    return consumed
  end
  let length = host::stringByteLength(content)

  if length > 1048576 || consumed > length
    return consumed
  end
  var start = consumed
  var index = consumed

  while index < length
    if (host::stringByteAt(content, index) as Int) == 10
      let line = host::stringSlice(content, start, index - start)
      let parser = new LspJsonParser(line)
      let value = parser.parse()

      parser.spaces()
      let phase = value.get("phase").scalarText()
      let completed = host::parseInt(value.get("completed").scalarText())
      let total = host::parseInt(value.get("total").scalarText())
      let sourceOffset = host::parseInt(value.get("sourceOffset").scalarText())
      let detail = value.get("detail").scalarText()

      if !parser.failed && parser.position == host::stringByteLength(line) && value.get("schemaVersion").scalarText() == "1" && (phase == "lower" || phase == "verify" || phase == "optimize" || phase == "emit") && completed != null && total != null && sourceOffset != null && completed >= 0 && total >= 0 && completed <= total && sourceOffset >= 0 && host::stringByteLength(detail) <= 160
        progress(phase, completed, total, detail, sourceOffset)
      end
      start = index + 1
    end
    index = index + 1
  end
  return start
end

def bootstrapRunCodegenWithProgress(executable: String, arguments: String[], path: String, progress: fn(String, Int, Int, String, Int): Void): Bool
  let options = new process::SpawnOptions(executable)

  options.arguments = arguments
  let started = process::spawn(options)
  let child = started.child()

  if child == null
    progress("end", 0, 0, "", 0)
    console::println("could not execute '" + executable + "': " + host::errorMessage())
    return false
  end
  var consumed = 0
  var completed = child.wait(100)

  while completed.running && completed.failure == null
    consumed = bootstrapCodegenProgress(path, consumed, progress)
    completed = child.wait(100)
  end
  consumed = bootstrapCodegenProgress(path, consumed, progress)
  progress("end", 0, 0, "", 0)
  if completed.stderr.Length > 0
    unsafe
      borrow completed.stderr as pointer
        runCacheWrite(pointer, completed.stderr.Length)
      end
    end
  end
  if completed.stdout.Length > 0
    let output = host::stringFromBytes(completed.stdout)

    console::print(output) if output != null
  end
  let failure = completed.failure
  let exit = completed.exit

  if failure != null
    console::println("'" + executable + "' failed while waiting: " + failure.code())
    child.cancel()
    child.dispose()
    return false
  end
  child.dispose()
  if completed.stdoutTruncated || completed.stderrTruncated
    console::println("'" + executable + "' output exceeded the capture limit")
    return false
  end
  if exit == null || !exit.isExited() || exit.value() != 0
    console::println("'" + executable + "' failed with status " + (exit == null ? "unknown" : (exit.value() as String)))
    return false
  end
  return true
end

def bootstrapFindText(text: String, pattern: String): Int
  let textLength = host::stringByteLength(text)
  let patternLength = host::stringByteLength(pattern)
  var start = 0

  while start + patternLength <= textLength
    var matched = 0

    while matched < patternLength && host::stringByteAt(text, start + matched) == host::stringByteAt(pattern, matched)
      matched = matched + 1
    end
    if matched == patternLength
      return start
    end
    start = start + 1
  end
  return -1
end

def bootstrapManifestString(text: String, name: String): String
  let marker = "\"" + name + "\":"
  let found = bootstrapFindText(text, marker)

  if found < 0
    return ""
  end
  var start = found + host::stringByteLength(marker)

  while start < host::stringByteLength(text)
    let byte = host::stringByteAt(text, start) as Int

    if byte != 9 && byte != 10 && byte != 13 && byte != 32
      break
    end
    start = start + 1
  end
  if start >= host::stringByteLength(text) || (host::stringByteAt(text, start) as Int) != 34
    return ""
  end
  start = start + 1
  var finish = start

  while finish < host::stringByteLength(text) && (host::stringByteAt(text, finish) as Int) != 34
    finish = finish + 1
  end
  return host::stringSlice(text, start, finish - start)
end

def bootstrapManifestInt(text: String, name: String): Int?
  let marker = "\"" + name + "\":"
  let found = bootstrapFindText(text, marker)

  if found < 0
    return null
  end
  var start = found + host::stringByteLength(marker)

  while start < host::stringByteLength(text)
    let byte = host::stringByteAt(text, start) as Int

    if byte != 9 && byte != 10 && byte != 13 && byte != 32
      break
    end
    start = start + 1
  end
  var finish = start

  while finish < host::stringByteLength(text)
    let byte = host::stringByteAt(text, finish) as Int

    if byte < 48 || byte > 57
      break
    end
    finish = finish + 1
  end
  if finish == start
    return null
  end
  return host::parseInt(host::stringSlice(text, start, finish - start))
end

def bootstrapManifestRequiredInt(text: String, name: String): Int
  let value = bootstrapManifestInt(text, name)

  if value != null
    return value
  end
  return -1
end

def bootstrapRequiredRuntimeMinor(module: IrModule): Int
  var required = module.requiredFeatures.minimumRuntimeMinor()
  var importValue = module.firstImport

  while importValue != null
    let symbolMinor = abiRuntimeSymbolMinimumMinor(importValue.linkName)

    if symbolMinor > required
      required = symbolMinor
    end
    if importValue.kind.isRuntime() && importValue.runtimeMinor > required
      required = importValue.runtimeMinor
    end
    importValue = importValue.nextImport
  end
  return required
end

def bootstrapRequiredRuntimeFeatures(module: IrModule): RuntimeFeatures
  var required = module.requiredFeatures.runtimeFeatures().withSourceLocations()
  var importValue = module.firstImport

  while importValue != null
    required = required.mergedWith(abiRuntimeSymbolFeatures(importValue.linkName))
    if importValue.kind.isRuntime()
      required = required.mergedWith(importValue.runtimeFeatures)
    end
    importValue = importValue.nextImport
  end
  return required
end

def bootstrapArtifactNameValid(value: String): Bool
  if value == "" || bootstrapStartsWith(value, "/") || bootstrapFindText(value, "..") >= 0 || bootstrapFindText(value, "\\") >= 0
    return false
  end
  return true
end

def bootstrapDirectory(path: String): String
  var slash = -1
  var index = 0

  while index < host::stringByteLength(path)
    if (host::stringByteAt(path, index) as Int) == 47
      slash = index
    end
    index = index + 1
  end
  if slash < 0
    return "."
  end
  if slash == 0
    return "/"
  end
  return host::stringSlice(path, 0, slash)
end

def bootstrapRun(executable: String, arguments: String[]): Bool
  let status = host::run(executable, arguments)

  if status == null
    console::println("could not execute '" + executable + "': " + host::errorMessage())
    return false
  end
  if status != 0
    console::println("'" + executable + "' failed with status " + (status as String))
    return false
  end
  return true
end

def bootstrapReportCodegenMetrics(path: String, prefix: String): Void
  let text = host::readText(path)

  if text == null
    return
  end
  let parser = new LspJsonParser(text)
  let record = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(text) || record.get("schemaVersion").scalarText() != "1"
    return
  end
  let serialized = agentInputInteger(record.get("serializeMs"))

  runCacheReportDuration(true, prefix + "serialize", serialized) if serialized != null && serialized >= 0
  let nativeMetrics = record.get("native")
  let keys = ["inputNs", "readerVerifierNs", "loweringAndPreverifyNs", "llvmOptimizationAndPostverifyNs", "targetCodegenNs"]
  let phases = ["native-input", "native-read-verify", "native-lower-verify", "native-optimize-verify", "native-emit"]
  var index = 0

  while index < keys.Length
    let duration = agentInputInteger(nativeMetrics.get(keys[index]))

    runCacheReportDuration(true, prefix + phases[index], duration / 1000000) if duration != null && duration >= 0
    index = index + 1
  end
end

def bootstrapInvokeCodegen(module: IrModule, emit: readonly EmissionKind, output: String, target: readonly TargetPlatform, release: Bool, debugSources: BootstrapSourceInput? = null, metricsPath: String = "", serializedInput: String = "", progress: (fn(String, Int, Int, String, Int): Void)? = null): Bool
  let codegenEmit = emit.codegenName()

  if codegenEmit == null
    progress("end", 0, 0, "", 0) if progress != null
    console::println("native code generation does not support emit kind: " + emit.name())
    return false
  end
  let optionalCodegen = host::environment("NERI_CODEGEN")

  if optionalCodegen == null || optionalCodegen == ""
    progress("end", 0, 0, "", 0) if progress != null
    console::println("NERI_CODEGEN must name the native neri-codegen executable")
    return false
  end
  let codegen = optionalCodegen
  let transport = output + ".nir.hex"
  var serializeStarted = 0

  serializeStarted = runCacheTime() if metricsPath != ""
  let serialized = serializedInput == "" ? irSerializeEnvelopeHex(module) : serializedInput
  var serializeMilliseconds = 0

  serializeMilliseconds = runCacheTime() - serializeStarted if metricsPath != ""
  var writeStarted = 0

  writeStarted = runCacheTime() if metricsPath != ""

  if !host::writeText(transport, serialized)
    progress("end", 0, 0, "", 0) if progress != null
    console::println("could not write Neri IR transport: " + host::errorMessage())
    return false
  end
  var arguments: String[] = [
    "--input", transport,
    "--input-format", "hex",
    "--target", target.name(),
    "--optimization", release ? "release" : "debug",
    "--emit", codegenEmit,
    "--output", output
  ]
  var writeMilliseconds = 0

  writeMilliseconds = runCacheTime() - writeStarted if metricsPath != ""
  let nativeMetrics = output + ".native-metrics.json"

  if metricsPath != ""
    arguments = host::appendString(arguments, "--metrics")
    arguments = host::appendString(arguments, nativeMetrics)
  end
  let progressPath = output + ".native-progress.jsonl"

  if progress != null
    host::removeFile(progressPath)
    arguments = host::appendString(arguments, "--progress")
    arguments = host::appendString(arguments, progressPath)
  end
  var source = debugSources

  while source != null && !release
    arguments = host::appendString(arguments, "--debug-source")
    arguments = host::appendString(arguments, source.id)
    arguments = host::appendString(arguments, source.identityPath)
    source = source.nextInput
  end
  var codegenStarted = 0

  codegenStarted = runCacheTime() if metricsPath != ""
  var succeeded = false

  if progress == null
    succeeded = bootstrapRun(codegen, arguments)
  else
    succeeded = bootstrapRunCodegenWithProgress(codegen, arguments, progressPath, progress)
  end
  var codegenMilliseconds = 0

  codegenMilliseconds = runCacheTime() - codegenStarted if metricsPath != ""

  host::removeFile(transport)
  host::removeFile(progressPath) if progress != null
  if metricsPath != ""
    let measured = host::readText(nativeMetrics)
    var nativeMetricsText = "null"

    nativeMetricsText = measured if measured != null

    host::writeText(metricsPath, "{\"schemaVersion\":1,\"serializeMs\":" + (serializeMilliseconds as String) + ",\"writeMs\":" + (writeMilliseconds as String) + ",\"codegenProcessMs\":" + (codegenMilliseconds as String) + ",\"native\":" + nativeMetricsText + "}\n")
    host::removeFile(nativeMetrics)
  end
  return succeeded
end

def bootstrapLinkExecutable(module: IrModule, objectPath: String, output: String, target: readonly TargetPlatform): Bool
  let objects = new StringBuffer()

  objects.add(objectPath)
  return bootstrapLinkObjects(module, objects, output, target)
end

def bootstrapLinkObjects(module: IrModule, objects: StringBuffer, output: String, target: readonly TargetPlatform, references: ReferenceInputs? = null, linkInputs: NativeLinkInputs? = null): Bool
  let optionalManifest = host::environment("NERI_RUNTIME_MANIFEST")

  if optionalManifest == null || optionalManifest == ""
    console::println("NERI_RUNTIME_MANIFEST must name the runtime package manifest")
    return false
  end
  let manifestPath = optionalManifest
  let optionalManifestText = host::readText(manifestPath)

  if optionalManifestText == null
    console::println("could not read runtime manifest: " + host::errorMessage())
    return false
  end
  let manifestText = optionalManifestText
  let schemaVersion = bootstrapManifestRequiredInt(manifestText, "schemaVersion")
  let transportMajor = bootstrapManifestRequiredInt(manifestText, "irTransportMajor")
  let transportMinor = bootstrapManifestRequiredInt(manifestText, "irTransportMinor")
  let abiMajor = bootstrapManifestRequiredInt(manifestText, "abiMajor")
  let abiMinor = bootstrapManifestRequiredInt(manifestText, "abiMinor")
  let features = bootstrapManifestRequiredInt(manifestText, "features")
  var requiredMinor = bootstrapRequiredRuntimeMinor(module)
  var requiredFeatures = bootstrapRequiredRuntimeFeatures(module)

  if references != null
    if !references.verifyObjects()
      console::println(references.error)
      return false
    end
    requiredMinor = references.runtimeMinor if references.runtimeMinor > requiredMinor
    requiredFeatures = requiredFeatures.mergedWith(references.runtimeFeatures)
    var object = references.objects.first.nextNode

    while object != null
      objects.add(object.value)
      object = object.nextNode
    end
  end

  if schemaVersion < 0 || transportMajor < 0 || transportMinor < 0 || abiMajor < 0 || abiMinor < 0 || features < 0
    console::println("runtime manifest is missing a required field")
    return false
  end
  if schemaVersion != 2 || bootstrapManifestString(manifestText, "toolchainVersion") != "0.2.0" || transportMajor != irTransportMajor() || transportMinor != irTransportMinor() || bootstrapManifestString(manifestText, "target") != target.name() || abiMajor != 1
    console::println("runtime manifest does not match Neri 0.2.0, IR transport 1.8, target '" + target.name() + "', and ABI v1")
    return false
  end
  if abiMinor < requiredMinor
    console::println("runtime manifest does not provide the required ABI minor version")
    return false
  end
  if !requiredFeatures.isSatisfiedByBits(features)
    console::println("runtime manifest does not provide the required ABI features")
    return false
  end
  if references != null && !referenceBitsSatisfied(references.runtimeFeatureBits, features)
    console::println("runtime manifest does not provide the reference implementation features")
    return false
  end
  let artifact = bootstrapManifestString(manifestText, "artifact")

  if !bootstrapArtifactNameValid(artifact)
    console::println("runtime manifest has an invalid artifact path")
    return false
  end
  let optionalRuntime = host::pathJoin(bootstrapDirectory(manifestPath), artifact)

  if optionalRuntime == null
    console::println("runtime artifact path is invalid")
    return false
  end
  var linker = target.linker()
  let configuredLinker = host::environment("NERI_LINKER")

  if configuredLinker != null && configuredLinker != ""
    linker = configuredLinker
  end
  let reachable = new IrLinkReachability()

  reachable.analyze(module)
  if reachable.error != ""
    console::println(reachable.error)
    return false
  end
  let sessionRuntime = reachable.runtimeFeatures.hasSessionModules() || module.sessionEntry != null
  var arguments = platformLinkObjectsArguments(target, objects, optionalRuntime, output, sessionRuntime, reachable.exportedSymbols)

  # Session-loaded code can use crypto even when the host object has no direct
  # crypto call, so Linux must link libcrypto for a session host as well.
  let requiresCrypto = reachable.runtimeFeatures.hasCrypto()

  if target.isLinux() && (requiresCrypto || sessionRuntime)
    arguments = host::appendString(arguments, "-lcrypto")
  end
  if module.requiredFeatures.hasNativeLibraries()
    var directory = target.isMacOS() ? "/opt/homebrew/lib" : ""
    let configuredDirectory = host::environment("NERI_LIBRARY_PATH")

    if configuredDirectory != null && configuredDirectory != ""
      directory = configuredDirectory
    end
    if directory != ""
      if !platformAbsolutePath(directory, target)
        console::println("NERI_LIBRARY_PATH must be an absolute directory")
        return false
      end
      arguments = platformLibraryArguments(arguments, directory, target)
    end
    var libraries = new StringBuffer()
    var imported = module.firstImport

    while imported != null
      let library = imported.nativeLibrary

      if library != "" && reachable.nativeLibraries.find(library) != null
        if !semanticNativeLibraryName(library)
          console::println("invalid native library name")
          return false
        end
        var found = false
        var index = 0

        while index < libraries.size
          if libraries.get(index) == library
            found = true
          end
          index = index + 1
        end
        if !found
          libraries.add(library)
          arguments = host::appendString(arguments, "-l" + library)
        end
      end
      imported = imported.nextImport
    end
  end
  var dependencyDirectory: String? = null
  var dependencyPath = ""

  if linkInputs != null && target.isMacOS()
    dependencyDirectory = bootstrapRunDirectory()
    if dependencyDirectory != null
      dependencyPath = dependencyDirectory + "/link-inputs"
      arguments = host::appendString(arguments, "-Xlinker")
      arguments = host::appendString(arguments, "-dependency_info")
      arguments = host::appendString(arguments, "-Xlinker")
      arguments = host::appendString(arguments, dependencyPath)
    end
  end
  var succeeded = bootstrapRun(linker, arguments)

  if succeeded && linkInputs != null && dependencyPath != ""
    if linkInputs.load(dependencyPath, objects, output)
      # Discover the linker graph, then bracket the published link with exact
      # input snapshots. Hashing only after linking could certify stale bytes.
      let before = linkInputs.snapshot()

      linkInputs.valid = false
      if before != ""
        succeeded = bootstrapRun(linker, arguments)
        if succeeded
          let observed = new NativeLinkInputs()

          if observed.load(dependencyPath, objects, output)
            linkInputs.valid = observed.snapshot() == before
          end
        end
      end
    end
  end
  if dependencyDirectory != null
    bootstrapRemoveRunDirectory(dependencyDirectory)
  end
  return succeeded
end

def bootstrapEmitNative(module: IrModule, emit: readonly EmissionKind, output: String, target: readonly TargetPlatform, release: Bool, timings: Bool = false, debugSources: BootstrapSourceInput? = null, references: ReferenceInputs? = null, linkInputs: NativeLinkInputs? = null, progress: (fn(String, Int, Int): Void)? = null, nativeProgress: (fn(String, Int, Int, String, Int): Void)? = null): Bool
  if !emit.isExecutable()
    return bootstrapInvokeCodegen(module, emit, output, target, release, null, "", "", nativeProgress)
  end
  let objectPath = output + ".o"
  let codegenStarted = runCacheTime()

  if !bootstrapInvokeCodegen(module, emit, objectPath, target, release, debugSources, "", "", nativeProgress)
    return false
  end
  runCacheReport(timings, "codegen", codegenStarted)
  let linkStarted = runCacheTime()
  let objects = new StringBuffer()

  objects.add(objectPath)
  progress("link", 0, 0) if progress != null
  let linked = bootstrapLinkObjects(module, objects, output, target, references, linkInputs)

  runCacheReport(timings, "link", linkStarted)
  let symbols = !linked || bootstrapExecutableSymbols(output, target, release)

  host::removeFile(objectPath)
  return linked && symbols
end

def bootstrapExecutableSymbols(output: String, target: readonly TargetPlatform, release: Bool): Bool
  if !release && target.isMacOS()
    var symbolTool = "dsymutil"
    let configured = host::environment("NERI_DSYMUTIL")

    if configured != null && configured != ""
      symbolTool = configured
    end
    # Mach-O keeps a debug map into the object. Link its DWARF before removing it.
    if !bootstrapRun(symbolTool, [output, "-o", output + ".dSYM"])
      console::println("could not generate debug symbols for " + output)
      return false
    end
  end
  return true
end

def bootstrapUnitSources(module: IrModule, sources: BootstrapSourceInput?): BootstrapSourceInput?
  var first: BootstrapSourceInput? = null
  var last: BootstrapSourceInput? = null
  var source = sources

  while source != null
    var declared = module.firstSource

    while declared != null && declared.id != source.id
      declared = declared.nextSource
    end
    if declared != null
      let copy = new BootstrapSourceInput(source.path, source.id, source.text)

      copy.identityPath = source.identityPath
      let tail = last

      if tail == null
        first = copy
      else
        tail.nextInput = copy
      end
      last = copy
    end
    source = source.nextInput
  end
  return first
end

def bootstrapCompileUnit(unit: IrCompilationUnit, target: readonly TargetPlatform, release: Bool, timings: Bool, noCache: Bool, sources: BootstrapSourceInput?, temporaryDirectories: StringBuffer, progress: (fn(String, Int, Int): Void)? = null, nativeProgress: (fn(String, Int, Int, String, Int): Void)? = null): String?
  let started = runCacheTime()
  let payload = irSerializePayload(unit.module)
  let payloadDigest = sha256FastWire(payload.bytes)
  let cache = new RunCache()
  let unitSources = bootstrapUnitSources(unit.module, sources)

  if !noCache
    # The serialized unit is the complete codegen input, including retained
    # contracts. Unrelated project manifests must not invalidate its object.
    cache.prepare(unit.module, target, release, unitSources, "neri-aot-object-cache-v3",
      runCacheFrame(unit.key), [], payloadDigest, true)
  end
  let hit = cache.hit()

  runCacheReport(timings, hit ? "object-cache-hit" : "object-cache-miss", started)
  progress("cache-hit", 0, 0) if hit && progress != null
  if hit
    return cache.executable
  end
  var directory: String? = null

  if cache.directory != ""
    directory = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "pending-object")
  end
  directory = bootstrapRunDirectory() if directory == null

  if directory == null
    progress("load", 0, 0) if progress != null
    console::println("could not create temporary object directory")
    return null
  end
  let path = directory + "/program"
  let codegenStarted = runCacheTime()
  let serialized = irSerializeEnvelopePayloadHex(unit.module, payload, payloadDigest)

  if !bootstrapInvokeCodegen(unit.module, EmissionKind.object(), path, target, release, unitSources, "", serialized, nativeProgress)
    bootstrapRemoveRunDirectory(directory)
    return null
  end
  runCacheReport(timings, "object-codegen", codegenStarted)
  if cache.publish(directory)
    return cache.executable
  end
  if cache.hit()
    bootstrapRemoveRunDirectory(directory)
    return cache.executable
  end
  temporaryDirectories.add(directory)
  return path
end

def bootstrapEmitCompilationUnits(module: IrModule, units: IrCompilationUnit, output: String, target: readonly TargetPlatform, release: Bool, timings: Bool, noCache: Bool, sources: BootstrapSourceInput?, linkInputs: NativeLinkInputs? = null, progress: (fn(String, Int, Int): Void)? = null, nativeProgress: (fn(String, Int, Int, String, Int): Void)? = null, references: ReferenceInputs? = null): Bool
  let objects = new StringBuffer()
  let temporaryDirectories = new StringBuffer()
  var unit: IrCompilationUnit? = units
  var succeeded = true

  while unit != null && succeeded
    let object = bootstrapCompileUnit(unit, target, release, timings, noCache, sources, temporaryDirectories, progress, nativeProgress)

    if object == null
      succeeded = false
    else
      objects.add(object)
    end
    unit = unit.next
  end
  if succeeded
    let started = runCacheTime()

    progress("link", 0, 0) if progress != null
    succeeded = bootstrapLinkObjects(module, objects, output, target, references, linkInputs)
    runCacheReport(timings, "link", started)
    succeeded = bootstrapExecutableSymbols(output, target, release) if succeeded
  end
  var temporary = temporaryDirectories.first.nextNode

  while temporary != null
    bootstrapRemoveRunDirectory(temporary.value)
    temporary = temporary.nextNode
  end
  return succeeded
end
