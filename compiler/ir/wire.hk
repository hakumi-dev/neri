use host

class IrWireChunk
  public bytes: Byte[] = []
  public used: Int = 0
  public next: IrWireChunk?

  def init(zeroTemplate: Byte[]): Void
    this.bytes = host.appendByte(zeroTemplate, 0 as Byte)
  end
end

class IrWireBytes
  public size: Int = 0
  private first: IrWireChunk?
  private last: IrWireChunk?
  private cached: IrWireChunk?
  private cachedStart: Int = 0
  private zeroTemplate: Byte[] = []

  def init(): Void
    var index = 0

    while index < 255
      this.zeroTemplate = host.appendByte(this.zeroTemplate, 0 as Byte)
      index = index + 1
    end
  end

  def add(value: Int): Void
    let chunk = this.last

    if chunk == null || chunk.used == chunk.bytes.Length
      let created = new IrWireChunk(this.zeroTemplate)
      let tail = this.last

      if tail == null
        this.first = created
        this.cached = created
      else
        tail.next = created
      end
      this.last = created
      created.bytes[0] = value as Byte
      created.used = 1
    else
      chunk.bytes[chunk.used] = value as Byte
      chunk.used = chunk.used + 1
    end
    this.size = this.size + 1
  end

  def get(index: Int): Int
    if index < 0 || index >= this.size
      return 0
    end
    var chunk = this.cached
    var start = this.cachedStart

    if chunk == null || index < start
      chunk = this.first
      start = 0
    end
    while chunk != null && index >= start + chunk.used
      start = start + chunk.used
      chunk = chunk.next
    end
    this.cached = chunk
    this.cachedStart = start
    if chunk == null
      return 0
    end
    return chunk.bytes[index - start] as Int
  end

  def unpack(): IntBuffer
    let result = new IntBuffer()
    var chunk = this.first

    while chunk != null
      var index = 0

      while index < chunk.used
        result.add(chunk.bytes[index] as Int)
        index = index + 1
      end
      chunk = chunk.next
    end
    return result
  end

  def text(): String?
    var count = this.size / 256

    count = count + 1 if count * 256 < this.size
    return this.chunkText(this.first, count)
  end

  private def chunkText(chunk: IrWireChunk?, count: Int): String?
    if chunk == null || count == 0
      return ""
    end
    if count == 1
      if chunk.used == chunk.bytes.Length
        return host.stringFromBytes(chunk.bytes)
      end
      var bytes: Byte[] = []
      var index = 0

      while index < chunk.used
        bytes = host.appendByte(bytes, chunk.bytes[index])
        index = index + 1
      end
      return host.stringFromBytes(bytes)
    end
    let leftCount = count / 2
    var rightChunk: IrWireChunk? = chunk
    var index = 0

    while index < leftCount && rightChunk != null
      rightChunk = rightChunk.next
      index = index + 1
    end
    let left = this.chunkText(chunk, leftCount)
    let right = this.chunkText(rightChunk, count - leftCount)

    if left == null || right == null
      return null
    end
    return left + right
  end
end

class IrWireBuffer
  public bytes: IrWireBytes = new IrWireBytes()

  def init(): Void
    return
  end

  def writeByte(value: Int): Void
    this.bytes.add(value - (value / 256) * 256)
  end

  def writeBool(value: Bool): Void
    this.writeByte(value ? 1 : 0)
  end

  def writeUInt16(value: Int): Void
    this.writeUnsigned(value, 2)
  end

  def writeUInt32(value: Int): Void
    this.writeUnsigned(value, 4)
  end

  def writeUInt64(value: Int): Void
    this.writeUnsigned(value, 8)
  end

  def writeInt64(value: Int): Void
    var remaining = value
    var index = 0

    while index < 8
      var byte = remaining - (remaining / 256) * 256

      if byte < 0
        byte = byte + 256
      end
      this.writeByte(byte)
      remaining = (remaining - byte) / 256
      index = index + 1
    end
  end

  def writeUnsigned(value: Int, width: Int): Void
    var remaining = value
    var index = 0

    while index < width
      let byte = remaining - (remaining / 256) * 256

      this.writeByte(byte)
      remaining = remaining / 256
      index = index + 1
    end
  end

  def writeUtf8(value: String): Void
    let length = host.stringByteLength(value)

    this.writeUInt32(length)
    var index = 0

    while index < length
      this.writeByte(host.stringByteAt(value, index) as Int)
      index = index + 1
    end
  end

  def writeBlob(value: String): Void
    this.writeUtf8(value)
  end

  def append(other: IrWireBuffer): Void
    var index = 0

    while index < other.bytes.size
      this.writeByte(other.bytes.get(index))
      index = index + 1
    end
  end

  def writeHexBytes(value: String): Void
    var index = 0

    while index < host.stringByteLength(value)
      this.writeByte(irHexValue(host.stringByteAt(value, index) as Int) * 16 + irHexValue(host.stringByteAt(value, index + 1) as Int))
      index = index + 2
    end
  end


  def writeHexUInt64(value: String): Void
    var index = 14

    while index >= 0
      this.writeByte(irHexValue(host.stringByteAt(value, index) as Int) * 16 + irHexValue(host.stringByteAt(value, index + 1) as Int))
      index = index - 2
    end
  end

  def toHex(): String
    let output = new IrWireBytes()
    var index = 0

    while index < this.bytes.size
      let byte = this.bytes.get(index)

      output.add(irHexByte(byte / 16) as Int)
      output.add(irHexByte(byte - (byte / 16) * 16) as Int)
      index = index + 1
    end
    let result = output.text()

    if result != null
      return result
    end
    return this.toHexByParts()
  end

  private def toHexByParts(): String
    var parts = new StringBuffer()
    var part = ""
    var partBytes = 0
    var index = 0

    while index < this.bytes.size
      let byte = this.bytes.get(index)

      part = part + irHexDigit(byte / 16) + irHexDigit(byte - (byte / 16) * 16)
      partBytes = partBytes + 1
      if partBytes == 32
        parts.add(part)
        part = ""
        partBytes = 0
      end
      index = index + 1
    end
    if partBytes > 0
      parts.add(part)
    end
    while parts.size > 1
      let combined = new StringBuffer()

      index = 0
      while index < parts.size
        if index + 1 < parts.size
          combined.add(parts.get(index) + parts.get(index + 1))
        else
          combined.add(parts.get(index))
        end
        index = index + 2
      end
      parts = combined
    end
    if parts.size == 0
      return ""
    end
    return parts.get(0)
  end
end

def irHexByte(value: Int): Byte
  return (value < 10 ? 48 + value : 87 + value) as Byte
end

def irHexValue(byte: Int): Int
  if byte >= 48 && byte <= 57
    return byte - 48
  end
  if byte >= 65 && byte <= 70
    return byte - 55
  end
  return byte - 87
end

def irWriteSymbol(writer: IrWireBuffer, symbol: IrSymbol): Void
  writer.writeUtf8(symbol.moduleName)
  writer.writeByte(symbol.kind)
  writer.writeUtf8(symbol.name)
end

def irWriteType(writer: IrWireBuffer, moduleName: String, typeName: String): Void
  let tag = irTypeTag(typeName)

  writer.writeByte(tag)
  if tag == 16 || tag == 18 || tag == 19 || tag == 33
    irWriteType(writer, moduleName, irTypeInner(typeName))
  else if tag == 17
    irWriteSymbol(writer, irSymbol(moduleName, 1, irTypeInner(typeName)))
  else if tag == 20
    irWriteSymbol(writer, irSymbol(moduleName, 10, irTypeInner(typeName)))
  else if tag == 21
    writer.writeUInt32(irFixedArrayCount(typeName))
    irWriteType(writer, moduleName, irFixedArrayInner(typeName))
  end
end

def irWriteLocation(writer: IrWireBuffer, location: IrLocation): Void
  writer.writeBool(location.present)
  if location.present
    writer.writeUtf8(location.sourceId)
    writer.writeUInt32(location.start)
    writer.writeUInt32(location.length)
  end
end

def irWriteValueDefinition(writer: IrWireBuffer, moduleName: String, id: Int, typeName: String): Void
  writer.writeUInt32(id)
  irWriteType(writer, moduleName, typeName)
end

def irWriteIntVector(writer: IrWireBuffer, values: Int[]): Void
  writer.writeUInt32(values.Length)
  for value in values writer.writeUInt32(value) end
end

def irWriteTypeArray(writer: IrWireBuffer, moduleName: String, values: String[]): Void
  writer.writeUInt32(values.Length)
  for value in values irWriteType(writer, moduleName, value) end
end

def irWriteTypeBuffer(writer: IrWireBuffer, moduleName: String, values: StringBuffer): Void
  writer.writeUInt32(values.size)
  var index = 0

  while index < values.size
    irWriteType(writer, moduleName, values.get(index))
    index = index + 1
  end
end

def irWriteConstant(writer: IrWireBuffer, moduleName: String, instruction: IrInstruction): Void
  writer.writeByte(instruction.constantKind)
  if instruction.constantKind == 1
    writer.writeBool(instruction.constantValue == "true")
  else if instruction.constantKind == 2
    let value = host.parseInt(instruction.constantValue)

    if value == null
      writer.writeByte(0)
    else
      writer.writeByte(value)
    end
  else if instruction.constantKind == 3
    let value = host.parseInt(instruction.constantValue)

    if value == null
      writer.writeInt64(0)
    else
      writer.writeInt64(value)
    end
  else if instruction.constantKind == 4
    writer.writeHexUInt64(host.stringSlice(instruction.constantValue, 2, 16))
  else if instruction.constantKind == 5
    irWriteType(writer, moduleName, instruction.resultType)
  else if instruction.constantKind == 7
    irWriteSymbol(writer, irSymbol(moduleName, 9, instruction.constantValue))
  end
end
