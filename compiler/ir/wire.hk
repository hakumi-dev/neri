use host

def irHexByte(value: Int): Byte
  return (value < 10 ? 48 + value : 87 + value) as Byte
end

def irHexValue(byte: Int): Int
  if byte >= 48 && byte <= 57
    return byte - 48
  end
  if byte >= 65 && byte <= 70
    return byte - 55
  end
  return byte - 87
end

def irWriteSymbol(writer: IrWireBuffer, symbol: IrSymbol): Void
  writer.writeUtf8(symbol.moduleName)
  writer.writeByte(symbol.kind.wireCode())
  writer.writeUtf8(symbol.name)
end

def irWriteType(writer: IrWireBuffer, moduleName: String, typeName: readonly IrType): Void
  let kind = typeName.kind()

  writer.writeByte(kind.wireCode())
  if kind.isArray() || kind.isOptional() || kind.isPointer() || kind.isBorrowCapability()
    irWriteType(writer, moduleName, irTypeInner(typeName))
  else if kind.isClass()
    irWriteSymbol(writer, irSymbol(moduleName, writer.domains.symbolKind.getClass(), typeName.nominalName()))
  else if kind.isNativeRecord()
    irWriteSymbol(writer, irSymbol(moduleName, writer.domains.symbolKind.getNativeRecord(), typeName.nominalName()))
  else if kind.isFixedArray()
    writer.writeUInt32(irFixedArrayCount(typeName))
    irWriteType(writer, moduleName, irFixedArrayInner(typeName))
  else if kind.isCFunction()

    writer.writeUInt32(typeName.componentCount() - 1)
    var index = 0

    while index < typeName.componentCount()
      irWriteType(writer, moduleName, typeName.component(index))
      index = index + 1
    end
  end
end

def irWriteLocation(writer: IrWireBuffer, location: IrLocation): Void
  writer.writeBool(location.present)
  if location.present
    writer.writeUtf8(location.sourceId)
    writer.writeUInt32(location.start)
    writer.writeUInt32(location.length)
  end
end

def irWriteValueDefinition(writer: IrWireBuffer, moduleName: String, id: Int, typeName: readonly IrType): Void
  writer.writeUInt32(id)
  irWriteType(writer, moduleName, typeName)
end

def irWriteIntVector(writer: IrWireBuffer, values: Int[]): Void
  writer.writeUInt32(values.Length)
  for value in values writer.writeUInt32(value) end
end

def irWriteTypeArray(writer: IrWireBuffer, moduleName: String, values: (readonly IrType)[]): Void
  writer.writeUInt32(values.Length)
  for value in values irWriteType(writer, moduleName, value) end
end

def irWriteTypeBuffer(writer: IrWireBuffer, moduleName: String, values: IrTypeBuffer): Void
  writer.writeUInt32(values.size)
  var index = 0

  while index < values.size
    irWriteType(writer, moduleName, values.get(index))
    index = index + 1
  end
end

def irWriteConstant(writer: IrWireBuffer, moduleName: String, instruction: IrInstruction): Void
  let kind = instruction.constantKind

  if kind == null
    return
  end
  writer.writeByte(kind.wireCode())
  if kind.isBool()
    writer.writeBool(instruction.constantValue == "true")
  else if kind.isByte()
    let value = host::parseInt(instruction.constantValue)

    if value == null
      writer.writeByte(0)
    else
      writer.writeByte(value)
    end
  else if kind.isInt()
    let value = host::parseInt(instruction.constantValue)

    if value == null
      writer.writeInt64(0)
    else
      writer.writeInt64(value)
    end
  else if kind.isFloat()
    writer.writeHexUInt64(host::stringSlice(instruction.constantValue, 2, 16))
  else if kind.isOptionalNone()
    irWriteType(writer, moduleName, instruction.resultType)
  else if kind.isStringGlobal()
    irWriteSymbol(writer, irSymbol(moduleName, writer.domains.symbolKind.getGlobal(), instruction.constantValue))
  end
end
