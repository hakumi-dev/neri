class IrOrderNode<T>
  public value: T
  public primary: Int
  public name: String
  public ordinal: Int
  public next: IrOrderNode<T>?

  def init(value: T, primary: Int, name: String, ordinal: Int): Void
    this.value = value
    this.primary = primary
    this.name = name
    this.ordinal = ordinal
  end
end
