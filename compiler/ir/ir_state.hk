class IrState
  public first: IrStateEntry?
  public last: IrStateEntry?
  public count: Int = 0

  def init(): Void
    return
  end

  def add(variable: IrVariable, value: Int): Void
    let entry = new IrStateEntry(variable, value)

    if this.first == null
      this.first = entry
    else
      let last = this.last

      if last != null
        last.nextEntry = entry
      end
    end
    this.last = entry
    this.count = this.count + 1
  end

  def valueFor(variable: IrVariable): Int
    var entry = this.first

    while entry != null
      if entry.variable.identity == variable.identity
        return entry.value
      end
      entry = entry.nextEntry
    end
    return -1
  end
end
