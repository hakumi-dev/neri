# Only an allocated array's element descriptor contains a type-descriptor
# relocation. Signatures, fields, and ordinary typed instructions use layout
# information without keeping the class descriptor alive.
def irLinkTypeReferences(names: StringBuffer, seen: StringTable<Bool>, typeName: String): Void
  let kind = irTypeKind(typeName)

  if kind == "class"
    let name = irTypeInner(typeName)

    names.add(name) if seen.add(name, true)
  else if kind == "array" || kind == "optional"
    irLinkTypeReferences(names, seen, irTypeInner(typeName))
  end
end

def irFunctionLinkReferences(function: IrFunction): StringBuffer
  let recorded = function.linkReferences

  if recorded != null
    return recorded
  end
  let names = new StringBuffer()
  let seen = new StringTable<Bool>()
  var callee = function.callees.first.nextNode

  while callee != null
    names.add(callee.value) if seen.add(callee.value, true)
    callee = callee.nextNode
  end
  var block = function.firstBlock

  while block != null
    var instruction = block.firstInstruction

    while instruction != null
      let symbol = instruction.symbol

      names.add(symbol.name) if symbol != null && seen.add(symbol.name, true)
      if instruction.opcode.isArrayNew() || instruction.opcode.isTaskGenerate() || instruction.opcode.isArrayGenerate()
        for argument in instruction.typeArguments
          irLinkTypeReferences(names, seen, argument)
        end
      end
      instruction = instruction.nextInstruction
    end
    block = block.nextBlock
  end
  return names
end
