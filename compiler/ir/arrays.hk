def irLowerArrayGenerate(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let typeName = irType(lowerer.bound.typeAt(node))
  let signature = lowerer.semantic.findClass(lowerer.bound.dataAt(node))

  if signature == null
    return new IrValue(-1, typeName)
  end
  let invoke = signature.firstMethod

  if invoke == null
    return new IrValue(-1, typeName)
  end
  lowerer.module.requiredFeatures.requireSequentialArrays()
  let count = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 0), "int")
  let callback = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 1), "class|" + signature.fullName)
  let slot = lowerer.dispatchSlot(signature, invoke)

  lowerer.addVirtualCallees(context, slot, callback.typeName)
  let receiver = lowerer.virtualOperands(context, [callback.id], callback.typeName, slot)
  let location = lowerer.location(node)
  let result = context.emit(lowerer.module.domains.opcode.getArrayGenerate(), typeName, [count.id, receiver[0]], [irTypeInner(typeName)], irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getMethod(), slot), null, "", null, false, location)

  context.function.localEffects = context.function.localEffects.mergedWith(new EffectSet().withRead().withWrite().withMayPanic().withManagedAllocate().withSafepoint())
  return result
end
