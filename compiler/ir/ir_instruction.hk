class IrInstruction
  public opcode: Int = 0
  public resultId: Int = -1
  public resultType: String = "void"
  public secondResultId: Int = -1
  public secondResultType: String = "void"
  public operands: Int[] = [0]
  public typeArguments: String[] = [""]
  public symbol: IrSymbol?
  public constantKind: Int = 0
  public constantValue: String = ""
  public predicate: Int = 0
  public flag: Bool = false
  public location: IrLocation = new IrLocation(false, 0, 0)
  public debugScopeId: Int = 0
  public nextInstruction: IrInstruction?

  def init(opcode: Int, resultId: Int, resultType: String, operands: Int[], typeArguments: String[], symbol: IrSymbol?, constantKind: Int, constantValue: String, predicate: Int, flag: Bool, location: IrLocation): Void
    this.opcode = opcode
    this.resultId = resultId
    this.resultType = resultType
    this.operands = operands
    this.typeArguments = typeArguments
    this.symbol = symbol
    this.constantKind = constantKind
    this.constantValue = constantValue
    this.predicate = predicate
    this.flag = flag
    this.location = location
  end
end
