class IrInstruction
  public opcode: readonly IrOpcode
  public resultId: Int = -1
  public resultType: readonly IrType
  public secondResultId: Int = -1
  public secondResultType: (readonly IrType)?
  public operands: Int[] = [0]
  public typeArguments: (readonly IrType)[] = []
  public symbol: IrSymbol?
  public constantKind: readonly IrConstantKind?
  public constantValue: String = ""
  public predicate: readonly IrComparison?
  public flag: Bool = false
  public location: IrLocation = new IrLocation(false, 0, 0)
  public debugScopeId: Int = 0
  public nextInstruction: IrInstruction?

  def init(opcode: readonly IrOpcode, resultId: Int, resultType: readonly IrType, operands: Int[], typeArguments: (readonly IrType)[], symbol: IrSymbol?, constantKind: readonly IrConstantKind?, constantValue: String, predicate: readonly IrComparison?, flag: Bool, location: IrLocation): Void
    this.opcode = opcode
    this.resultId = resultId
    this.resultType = resultType
    this.operands = operands
    this.typeArguments = typeArguments
    this.symbol = symbol
    this.constantKind = constantKind
    this.constantValue = constantValue
    this.predicate = predicate
    this.flag = flag
    this.location = location
  end
  def secondType(): readonly IrType
    let second = this.secondResultType

    if second != null
      return second
    end
    irInvariantFailure("IR instruction has no second result type")
    return this.resultType
  end
end
