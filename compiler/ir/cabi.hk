# Foreign calls may reenter Neri and collect while the outer frame is live.
def irCAbiEffects(): EffectSet
  return new EffectSet().withRead().withWrite().withUnsafe().withMayPanic().withManagedAllocate().withNativeAllocate().withSafepoint()
end

def irCAbiType(typeName: String, allowVoid: Bool): Bool
  if typeName == "void"
    return allowVoid
  end
  if irIsInteger(typeName) || irIsFloat(typeName) || typeName == "byte" || typeName == "bool" || irIsPointer(typeName)
    return true
  end
  if irIsOptional(typeName)
    let inner = irTypeInner(typeName)

    return irIsPointer(inner) || semanticIsCFunction(inner)
  end
  if semanticIsCFunction(typeName)
    let components = semanticCFunctionComponents(typeName)

    if components.size == 0 || !irCAbiType(components.get(0), true)
      return false
    end
    var index = 1

    while index < components.size
      if !irCAbiType(components.get(index), false)
        return false
      end
      index = index + 1
    end
    return true
  end
  return false
end

def irLowerCFunction(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let callable = lowerer.findCallable(lowerer.bound.dataAt(node))
  let typeName = irType(lowerer.bound.typeAt(node))

  lowerer.requireType(typeName)
  if callable != null
    lowerer.requireCAbiImport(callable) if callable.cAbiSymbol != ""
    return context.emitSymbol(lowerer.module.domains.opcode.getCFunctionAddress(), typeName, [], irSymbol(lowerer.module.id, lowerer.module.domains.symbolKind.getFunction(), callable.fullName), lowerer.location(node))
  end
  lowerer.semantic.diagnostics.add("NR280", lowerer.bound.startAt(node), lowerer.bound.lengthAt(node), "Native function address has no declared target.")
  return new IrValue(-1, typeName)
end

def irLowerCCall(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let callee = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 0), "")
  let components = semanticCFunctionComponents(callee.typeName)
  var operands: Int[] = [lowerer.currentUnsafe(context), callee.id]
  var index = 1

  while index < lowerer.bound.childCountAt(node)
    let argument = lowerer.lowerExpression(context, lowerer.bound.childAt(node, index), components.get(index))

    operands = host.appendInt(operands, argument.id)
    index = index + 1
  end
  context.function.parallelUnsafe = true
  context.function.localEffects = context.function.localEffects.mergedWith(irCAbiEffects())
  return context.emitValue(lowerer.module.domains.opcode.getCallCIndirect(), irType(lowerer.bound.typeAt(node)), operands, lowerer.location(node))
end
