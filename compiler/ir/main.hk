
def main(): Void
  let firstArgument = host::argumentAt(0)

  if firstArgument != null && firstArgument == "--print-runtime-manifest"
    let configured = host::environment("NERI_RUNTIME_MANIFEST")

    if host::argumentCount() != 1 || configured == null || configured == ""
      console::println("NERI_TOOLCHAIN: Select a launcher with NERI_RUNTIME_MANIFEST configured.")
      host::exit(2)
      return
    end
    let manifest = neriCanonicalPath(configured)

    if manifest == null || host::readText(manifest) == null
      console::println("NERI_TOOLCHAIN: Runtime manifest is unavailable.")
      host::exit(2)
      return
    end
    console::println(manifest)
    return
  end
  if firstArgument != null && firstArgument == "build-batch"
    bootstrapBatchMain()
    return
  end
  if firstArgument != null && (firstArgument == "describe" || firstArgument == "test" || firstArgument == "profile")
    agentProjectToolMain(firstArgument)
    return
  end
  if firstArgument != null && firstArgument == "feedback"
    agentFeedbackMain()
    return
  end
  if firstArgument != null && firstArgument == "feedback-worker"
    agentFeedbackWorkerMain()
    return
  end
  if firstArgument != null && firstArgument == "project-units"
    neriProjectUnitsCli()
    return
  end
  if firstArgument != null && firstArgument == "documentation-index"
    lspDocumentationIndexMain()
    return
  end
  if firstArgument != null && firstArgument == "agent"
    agentMain()
    return
  end
  if host::argumentCount() == 1 && firstArgument != null && firstArgument == "lsp"
    lspMain()
    return
  end
  if firstArgument != null && (firstArgument == "format" || firstArgument == "lint")
    neriCodeStyleCli(firstArgument)
    return
  end
  var arguments: String[] = []
  var argumentIndex = 0

  while argumentIndex < host::argumentCount()
    let argument = host::argumentAt(argumentIndex)

    arguments = host::appendString(arguments, argument) if argument != null
    argumentIndex = argumentIndex + 1
  end
  bootstrapCompile(arguments)
end

def neriProjectUnitsFieldValid(value: String): Bool
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    if byte == 9 || byte == 10 || byte == 13
      return false
    end
    index = index + 1
  end
  return true
end

def neriProjectUnitsCli(): Void
  var projectPath = ""
  var testSuite = ""
  var selectingTests = false
  var index = 1

  while index < host::argumentCount()
    let argument = host::argumentAt(index)

    if argument != null && argument == "--project" && index + 1 < host::argumentCount()
      let value = host::argumentAt(index + 1)

      projectPath = value if value != null
      index = index + 2
    else if argument != null && argument == "--test-suite" && index + 1 < host::argumentCount()
      let value = host::argumentAt(index + 1)

      testSuite = value if value != null
      selectingTests = true
      index = index + 2
    else
      bootstrapUsage()
      host::exit(2)
      return
    end
  end
  if projectPath == "" || (selectingTests && testSuite == "")
    bootstrapUsage()
    host::exit(2)
    return
  end
  let project = neriLoadProject(projectPath)

  if project.error() != ""
    console::println(project.error())
    host::exit(2)
    return
  end
  let names = neriProjectUnitNames(project)

  if project.error() != ""
    console::println(project.error())
    host::exit(2)
    return
  end
  let records = new StringBuffer()

  if selectingTests
    let suite = new NeriTestSuite(testSuite)

    if suite.error != ""
      console::println(suite.error)
      host::exit(2)
      return
    end
    let known = new StringTable<Bool>()
    var name = names.cursor()

    while name.hasValue()
      known.add(name.current(), true)
      name.advance()
    end
    name = suite.units.cursor()
    while name.hasValue()
      if known.find(name.current()) == null
        console::println("Unknown test suite unit: " + name.current())
        host::exit(2)
        return
      end
      let selected = neriLoadProject(project.manifest, name.current())

      if selected.error() != ""
        console::println(selected.error())
        host::exit(2)
        return
      end
      if !projectUnitIsExecutable(selected.kind) || !selected.testDeclared || !neriProjectUnitsFieldValid(name.current())
        console::println("Test suite unit must be a representable executable with test metadata: " + name.current())
        host::exit(2)
        return
      end
      var record = name.current() + "\t" + (selected.testTimeoutMs as String)

      for argument in selected.testArguments
        record = record + "\t" + irHex(argument)
      end
      records.add(record + "\n")
      name.advance()
    end
  else
    var name = names.cursor()

    while name.hasValue()
      let selected = neriLoadProject(project.manifest, name.current())

      if selected.error() != ""
        console::println(selected.error())
        host::exit(2)
        return
      end
      if projectUnitIsExecutable(selected.kind)
        var source = selected.ownSources.cursor()

        while source.hasValue()
          if !neriProjectUnitsFieldValid(name.current()) || !neriProjectUnitsFieldValid(source.current())
            console::println("project-units cannot represent a unit or source containing a tab or line break.")
            host::exit(2)
            return
          end
          records.add(name.current() + "\t" + source.current() + "\n")
          source.advance()
        end
      end
      name.advance()
    end
  end
  var record = records.cursor()

  while record.hasValue()
    console::print(record.current())
    record.advance()
  end
end
