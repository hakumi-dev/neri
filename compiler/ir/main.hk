use console
use host

def main(): Void
  let firstArgument = host.argumentAt(0)

  if firstArgument != null && firstArgument == "project-units"
    neriProjectUnitsCli()
    return
  end
  if firstArgument != null && firstArgument == "documentation-index"
    lspDocumentationIndexMain()
    return
  end
  if firstArgument != null && firstArgument == "agent"
    agentMain()
    return
  end
  if host.argumentCount() == 1 && firstArgument != null && firstArgument == "lsp"
    lspMain()
    return
  end
  if firstArgument != null && (firstArgument == "format" || firstArgument == "lint")
    neriCodeStyleCli(firstArgument)
    return
  end
  let started = runCacheTime()
  var timings = false
  var noCache = false
  var quiet = false
  var moduleName = "main"
  var sourceRoot = ""
  var projectPath = ""
  let referencedPaths = new StringBuffer()
  let referencedIds = new StringBuffer()
  var unit = ""
  var projectKind = ""
  var implicitProject = false
  var loadedProject: NeriProject? = null
  var consumerOwner = ""
  var emit = "neri-ir"
  var emitExplicit = false
  var output = ""
  var target = ""
  var release = false
  var sessionModule = false
  var command = "run"
  var firstSource: BootstrapSourceInput? = null
  var lastSource: BootstrapSourceInput? = null
  var sourceCount = 0
  var programArguments: String[] = []
  var index = 0

  while index < host.argumentCount()
    let optionalArgument = host.argumentAt(index)

    if optionalArgument == null
      return
    end
    let argument = optionalArgument

    if index == 0 && (argument == "build" || argument == "check" || argument == "run")
      command = argument
      index = index + 1
    else if argument == "--" && command == "run"
      index = index + 1
      while index < host.argumentCount()
        let value = host.argumentAt(index)

        if value != null
          programArguments = host.appendString(programArguments, value)
        end
        index = index + 1
      end
    else if argument == "--version" || (index == 0 && argument == "version")
      console.println("neri " + neriVersion())
      return
    else if argument == "--help"
      bootstrapUsage()
      return
    else if argument == "--module" || argument == "--source-root" || argument == "--output" || argument == "--target" || argument == "--project" || argument == "--unit"
      if index + 1 >= host.argumentCount()
        bootstrapUsage()
        host.exit(2)
        return
      end
      let optionalValue = host.argumentAt(index + 1)

      if optionalValue == null
        return
      end
      if argument == "--project"
        projectPath = optionalValue
      else if argument == "--unit"
        unit = optionalValue
      else if argument == "--module"
        moduleName = optionalValue
      else if argument == "--source-root"
        sourceRoot = optionalValue
      else if argument == "--output"
        output = optionalValue
      else
        target = optionalValue
      end
      index = index + 2
    else if bootstrapStartsWith(argument, "--module=")
      moduleName = host.stringSlice(argument, 9, host.stringByteLength(argument) - 9)
      index = index + 1
    else if bootstrapStartsWith(argument, "--source-root=")
      sourceRoot = host.stringSlice(argument, 14, host.stringByteLength(argument) - 14)
      index = index + 1
    else if bootstrapStartsWith(argument, "--emit=")
      emit = host.stringSlice(argument, 7, host.stringByteLength(argument) - 7)
      emitExplicit = true
      index = index + 1
    else if argument == "--timings"
      timings = true
      index = index + 1
    else if argument == "--no-cache"
      noCache = true
      index = index + 1
    else if argument == "--quiet"
      quiet = true
      index = index + 1
    else if argument == "--release"
      release = true
      index = index + 1
    else if argument == "--session-module"
      sessionModule = true
      index = index + 1
    else if bootstrapStartsWith(argument, "--")
      console.println("unknown option: " + argument)
      bootstrapUsage()
      host.exit(2)
      return
    else
      let optionalPath = host.pathAbsolute(argument)

      if optionalPath == null
        console.println("source path is invalid: " + argument)
        host.exit(2)
        return
      end
      let path = optionalPath

      if !neriSourceNameValid(path)
        console.println(".hk file names must not contain whitespace: " + argument)
        host.exit(2)
        return
      end
      let text = host.readText(path)

      if text == null
        console.println("could not read source: " + argument)
        host.exit(2)
        return
      end
      let input = new BootstrapSourceInput(path, "", text)

      if firstSource == null
        firstSource = input
      else
        let last = lastSource

        if last != null
          last.nextInput = input
        end
      end
      lastSource = input
      sourceCount = sourceCount + 1
      index = index + 1
    end
  end
  if projectPath != ""
    if sourceCount != 0
      console.println("--project cannot be combined with explicit source files")
      host.exit(2)
      return
    end
    let project = neriLoadProject(projectPath, unit)

    if project.error != ""
      console.println(project.error)
      host.exit(2)
      return
    end
    projectKind = project.kind
    implicitProject = project.implicit
    loadedProject = project
    let ownSource = project.ownSources.first.nextNode

    if ownSource != null
      let owner = neriUnitSourceOwner(project, ownSource.value)

      consumerOwner = owner if owner != null
    end
    var reference = project.referenceSources.first.nextNode

    while reference != null
      referencedPaths.add(reference.value)
      reference = reference.nextNode
    end
    var entry = project.sources.first.nextNode

    while entry != null
      let text = neriProjectVerifiedText(project, entry.value)

      if text == null
        console.println("could not read project source: " + entry.value)
        host.exit(2)
        return
      end
      let input = new BootstrapSourceInput(entry.value, "", text)

      if firstSource == null
        firstSource = input
      else
        let last = lastSource

        if last != null
          last.nextInput = input
        end
      end
      lastSource = input
      sourceCount = sourceCount + 1
      entry = entry.nextNode
    end
  else if unit != ""
    console.println("--unit requires --project")
    host.exit(2)
    return
  end
  if sourceCount == 0
    bootstrapUsage()
    host.exit(2)
    return
  end
  if (command == "build" || command == "run") && !emitExplicit
    emit = "executable"
  end
  if projectKind == "library" && emit == "executable"
    console.println("A library unit cannot be emitted as an executable; use check or build --emit=obj --output <file>.")
    host.exit(2)
    return
  end
  if command == "run" && (emit != "executable" || output != "")
    console.println("run owns its executable location; --output and non-executable --emit are invalid")
    host.exit(2)
    return
  end
  if !bootstrapValidEmit(emit)
    console.println("unknown emit kind: " + emit)
    bootstrapUsage()
    host.exit(2)
    return
  end

  var logicalRoot = ""

  if sourceRoot != ""
    let optionalRoot = host.pathAbsolute(sourceRoot)

    if optionalRoot == null
      console.println("source root is invalid: " + sourceRoot)
      host.exit(2)
      return
    end
    logicalRoot = optionalRoot
  else if sourceCount > 1
    logicalRoot = bootstrapCommonSourceRoot(firstSource)
  end

  let coreLibraryPath = bootstrapCoreLibraryPath()
  var source = firstSource

  while source != null
    if logicalRoot != "" && !bootstrapPathWithin(logicalRoot, source.path)
      console.println("source is outside source root: " + source.path)
      host.exit(2)
      return
    end
    let canonicalSource = neriCanonicalPath(source.path)

    if coreLibraryPath != null && canonicalSource != null && canonicalSource == coreLibraryPath
      source.path = coreLibraryPath
      source.id = "@stdlib/" + bootstrapCoreLibraryName() + ".hk"
    else
      source.id = bootstrapSourceId(source.path, logicalRoot, sourceCount == 1 && sourceRoot == "")
    end
    var duplicate = source.nextInput

    while duplicate != null
      var duplicateId = bootstrapSourceId(duplicate.path, logicalRoot, sourceCount == 1 && sourceRoot == "")
      let canonicalDuplicate = neriCanonicalPath(duplicate.path)

      if coreLibraryPath != null && canonicalDuplicate != null && canonicalDuplicate == coreLibraryPath
        duplicateId = "@stdlib/" + bootstrapCoreLibraryName() + ".hk"
      end

      if source.id == duplicateId
        console.println("source identity is specified more than once: " + source.id)
        host.exit(2)
        return
      end
      duplicate = duplicate.nextInput
    end
    source = source.nextInput
  end
  var pendingLibraries = true

  while pendingLibraries
    pendingLibraries = false
    var libraryNames: String[] = []

    source = firstSource
    while source != null
      for name in bootstrapLibraryImports(source.text)
        var known = false

        for existing in libraryNames
          known = true if existing == name
        end
        libraryNames = host.appendString(libraryNames, name) if !known
      end
      source = source.nextInput
    end
    let directory = host.environment("NERI_STDLIB")

    if directory == null || directory == ""
      console.println("required standard library core is unavailable: NERI_STDLIB is not set")
      host.exit(2)
      return
    end

    for libraryName in libraryNames
      var libraryPath = directory + "/" + libraryName + ".hk"

      if libraryName == bootstrapCoreLibraryName() && coreLibraryPath != null
        libraryPath = coreLibraryPath
      end
      var supplied = false

      source = firstSource
      while source != null
        if source.path == libraryPath
          supplied = true
        end
        source = source.nextInput
      end
      if !supplied
        let project = loadedProject
        var libraryText: String? = null

        if project == null
          libraryText = host.readText(libraryPath)
        else
          libraryText = neriProjectVerifiedText(project, libraryPath)
        end

        if libraryText != null
          let library = new BootstrapSourceInput(libraryPath, "@stdlib/" + libraryName + ".hk", libraryText)
          let last = lastSource

          if last != null
            last.nextInput = library
          end
          lastSource = library
          pendingLibraries = true
        else if libraryName == bootstrapCoreLibraryName()
          console.println("required standard library core is unavailable: " + libraryPath)
          host.exit(2)
          return
        end
      end
    end
  end
  let sourceIds = new StringBuffer()
  let sourceOwners = new StringBuffer()
  let sourcePaths = new StringBuffer()
  let sourceTexts = new StringBuffer()
  let sourceStarts = new IntBuffer()
  var combined = ""
  var combinedLength = 0

  source = bootstrapNextSource(firstSource)
  while source != null
    source.emitted = true
    sourceIds.add(source.id)
    var owner = consumerOwner

    owner = "@stdlib" if bootstrapStartsWith(source.id, "@stdlib/")
    let project = loadedProject

    if project != null
      let declaredOwner = neriUnitSourceOwner(project, source.path)

      if declaredOwner != null
        owner = declaredOwner
      end
    end
    sourceOwners.add(owner)
    if projectKind == "library" || neriProjectListed(referencedPaths, source.path)
      referencedIds.add(source.id)
    end
    let optionalFileName = host.pathFileName(source.path)
    var displayName = source.id

    if optionalFileName != null
      displayName = optionalFileName
    end
    sourcePaths.add(displayName)
    sourceTexts.add(source.text)
    sourceStarts.add(combinedLength)
    combined = combined + source.text + "\n"
    combinedLength = combinedLength + (new IrSourceMap(source.text)).utf16Length() + 1
    source = bootstrapNextSource(firstSource)
  end

  let lexer = new BootstrapLexer(combined)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)

  index = 0
  while index < sourceStarts.size
    parser.addSourceBoundary(sourceStarts.get(index))
    index = index + 1
  end
  let root = parser.parseProgram()

  if parser.diagnostics.count() > 0
    irEmitDiagnostics(parser.diagnostics, "Parse", sourcePaths, sourceTexts, sourceStarts)
    host.exit(1)
    return
  end
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

  binder.requireEntryPoint = !sessionModule && (projectKind == "executable" || (projectKind == "" && (projectPath == "" || emit == "executable")))
  binder.forbiddenEntryPointSources = referencedIds
  binder.clearSources()
  index = 0
  while index < sourceIds.size
    binder.addSource(sourceIds.get(index), sourceStarts.get(index))
    index = index + 1
  end
  let semantic = binder.bind()

  if semantic.diagnostics.count() > 0
    if implicitProject
      index = 0
      while index < semantic.diagnostics.count()
        semantic.diagnostics.messages.set(index, semantic.diagnostics.messages.get(index) + neriImplicitProjectHint(semantic.diagnostics.codes.get(index)))
        index = index + 1
      end
    end
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
    host.exit(1)
    return
  end
  let lowerer = new IrLowerer(semantic, parser.arena, combined, moduleName)

  lowerer.setSources(sourceIds, sourceTexts, sourceStarts)
  let module = lowerer.lower()

  if semantic.diagnostics.count() > 0
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
    host.exit(1)
    return
  end
  if sessionModule
    var sessionEntry: IrFunction? = null
    var candidate = module.firstFunction

    while candidate != null
      if candidate.symbol.name == "__neri_session_entry"
        sessionEntry = candidate
      end
      candidate = candidate.nextFunction
    end
    if sessionEntry == null
      console.println("SessionModule: generated __neri_session_entry is missing")
      host.exit(1)
      return
    end
    let entry = sessionEntry

    if entry.parameterTypes.size > 1 || entry.resultType == "void"
      console.println("SessionModule: entry must take zero or one managed frame and return a managed frame")
      host.exit(1)
      return
    end
    module.exportSession(entry)
  end
  let verification = irVerify(module)

  if !verification.succeeded()
    index = 0
    while index < verification.errors.size
      console.println("NIRV|" + verification.errors.get(index))
      index = index + 1
    end
    host.exit(1)
    return
  end
  if emit == "llvm-ir" || emit == "asm" || emit == "obj" || emit == "executable"
    runCacheReport(timings, "frontend", started)
    if target == ""
      let manifestPath = host.environment("NERI_RUNTIME_MANIFEST")

      if manifestPath != null
        let manifest = host.readText(manifestPath)

        if manifest != null
          target = bootstrapManifestString(manifest, "target")
        end
      end
    end
    if !platformSupportedTarget(target)
      console.println("--target must be linux-x86_64, macos-arm64 or windows-x86_64 for native artifacts")
      host.exit(2)
      return
    end
    var runDirectory = ""
    let cache = new RunCache()

    if command == "run"
      let lookupStarted = runCacheTime()

      if !noCache
        cache.prepare(module, target, release, firstSource)
      end
      let hit = cache.hit()

      runCacheReport(timings, hit ? "cache-hit" : "cache-miss", lookupStarted)
      if hit
        runCacheReport(timings, "ready", started)
        let executionStarted = runCacheTime()
        let result = host.run(cache.executable, programArguments)

        runCacheReport(timings, "execute", executionStarted)
        if result != null
          host.exit(result > 125 ? 125 : result)
          return
        end
        # A vanished or non-executable artifact is a miss, not a program error.
      end
      var directory: String? = null

      if cache.directory != ""
        directory = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "pending")
      end
      if directory == null
        directory = bootstrapRunDirectory()
      end
      if directory == null
        console.println("could not create temporary run directory")
        host.exit(2)
        return
      end
      runDirectory = directory
      output = directory + "/program"
    end
    if output == "" && command == "build" && emit == "executable"
      let first = firstSource

      if first != null
        let name = host.pathFileName(first.path)

        if name != null
          let length = host.stringByteLength(name)

          if length > 3 && (host.stringByteAt(name, length - 3) as Int) == 46 && (host.stringByteAt(name, length - 2) as Int) == 104 && (host.stringByteAt(name, length - 1) as Int) == 107
            output = "./" + host.stringSlice(name, 0, length - 3)
          end
        end
      end
    end
    if output == ""
      console.println("--output is required for native artifacts")
      host.exit(2)
      return
    end
    if (emit == "obj" || emit == "executable") && output == "-"
      console.println("--output - is not valid for " + emit)
      host.exit(2)
      return
    end
    if emit == "executable"
      output = platformExecutable(output, target)
    end
    var units: IrCompilationUnit? = null

    if emit == "executable" && !sessionModule && consumerOwner != ""
      let partitionStarted = runCacheTime()

      units = irPartitionModule(module, semantic, sourceIds, sourceOwners, consumerOwner)
      runCacheReport(timings, units == null ? "partition-fallback" : "partition", partitionStarted)
    end
    var nativeSucceeded = false

    if units != null
      let configuration = bootstrapAotConfiguration(sourceOwners)
      var configurationText = ""

      configurationText = configuration if configuration != null

      nativeSucceeded = bootstrapEmitCompilationUnits(module, units, output, target, release, timings,
        noCache || configuration == null, firstSource, configurationText)
    else
      nativeSucceeded = bootstrapEmitNative(module, emit, output, target, release, timings, firstSource)
    end

    if command == "run"
      var status = 2

      if nativeSucceeded
        if cache.publish(runDirectory)
          runDirectory = ""
        end
        if cache.hit()
          output = cache.executable
        end
        runCacheReport(timings, "ready", started)
        let executionStarted = runCacheTime()
        let result = host.run(output, programArguments)

        runCacheReport(timings, "execute", executionStarted)
        if result != null
          status = result
        else
          console.println("could not run executable: " + host.errorMessage())
        end
      end
      if runDirectory != ""
        bootstrapRemoveRunDirectory(runDirectory)
      end
      if status > 125
        status = 125
      end
      host.exit(status)
      return
    end
    if !nativeSucceeded
      host.exit(2)
    end
    if output != "-" && !quiet
      console.println(output)
    end
  else if emit == "neri-ir-hex"
    let artifact = irSerializeEnvelopeHex(module)

    if !bootstrapWriteArtifact(output, artifact)
      host.exit(2)
    end
  else
    let artifact = irRenderModule(module)

    if !bootstrapWriteArtifact(output, artifact)
      host.exit(2)
    end
  end
end

def neriProjectUnitsFieldValid(value: String): Bool
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    if byte == 9 || byte == 10 || byte == 13
      return false
    end
    index = index + 1
  end
  return true
end

def neriProjectUnitsCli(): Void
  var projectPath = ""
  var index = 1

  while index < host.argumentCount()
    let argument = host.argumentAt(index)

    if argument != null && argument == "--project" && index + 1 < host.argumentCount()
      let value = host.argumentAt(index + 1)

      projectPath = value if value != null
      index = index + 2
    else
      bootstrapUsage()
      host.exit(2)
      return
    end
  end
  if projectPath == ""
    bootstrapUsage()
    host.exit(2)
    return
  end
  let project = neriLoadProject(projectPath)

  if project.error != ""
    console.println(project.error)
    host.exit(2)
    return
  end
  let names = neriProjectUnitNames(project)

  if project.error != ""
    console.println(project.error)
    host.exit(2)
    return
  end
  var name = names.first.nextNode
  let records = new StringBuffer()

  while name != null
    let selected = neriLoadProject(project.manifest, name.value)

    if selected.error != ""
      console.println(selected.error)
      host.exit(2)
      return
    end
    if selected.kind == "executable"
      var source = selected.ownSources.first.nextNode

      while source != null
        if !neriProjectUnitsFieldValid(name.value) || !neriProjectUnitsFieldValid(source.value)
          console.println("project-units cannot represent a unit or source containing a tab or line break.")
          host.exit(2)
          return
        end
        records.add(name.value + "\t" + source.value + "\n")
        source = source.nextNode
      end
    end
    name = name.nextNode
  end
  var record = records.first.nextNode

  while record != null
    console.print(record.value)
    record = record.nextNode
  end
end
