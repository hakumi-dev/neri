use ConsoleInteraction
use host

class BootstrapSourceInput
  public path: String = ""
  public id: String = "main"
  public text: String = ""
  public emitted: Bool = false
  public nextInput: BootstrapSourceInput?

  def init(path: String, id: String, text: String): Void
    this.path = path
    this.id = id
    this.text = text
  end
end

def bootstrapSpaces(count: Int): String
  var result = ""
  var index = 0
  while index < count
    result = result + " "
    index = index + 1
  end
  return result
end

def bootstrapCarets(count: Int): String
  var result = ""
  var index = 0
  while index < count
    result = result + "^"
    index = index + 1
  end
  return result
end

def bootstrapExpandTabs(value: String): String
  var result = ""
  var column = 0
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    if byte == 9
      let spaces = 4 - (column - (column / 4) * 4)
      result = result + bootstrapSpaces(spaces)
      column = column + spaces
      index = index + 1
    else
      let width = utf8Width(byte)
      result = result + host.stringSlice(value, index, width)
      column = column + utf16Width(codePointAt(value, index))
      index = index + width
    end
  end
  return result
end

def bootstrapVisualColumn(value: String): Int
  return (new IrSourceMap(bootstrapExpandTabs(value))).utf16Length() + 1
end

def irEmitDiagnostics(diagnostics: DiagnosticBuffer, phase: String, sourcePaths: StringBuffer, sourceTexts: StringBuffer, sourceStarts: IntBuffer): Void
  ConsoleInteraction.println(phase + ": FAILED")
  let emitted = new IntBuffer()
  var index = 0
  while index < diagnostics.count()
    emitted.add(0)
    index = index + 1
  end
  index = 0
  while index < diagnostics.count()
    var selected = -1
    var candidate = 0
    while candidate < diagnostics.count()
      if emitted.get(candidate) == 0 && (selected < 0 || diagnostics.starts.get(candidate) < diagnostics.starts.get(selected) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) < diagnostics.lengths.get(selected)) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) == diagnostics.lengths.get(selected) && irCompareText(diagnostics.codes.get(candidate), diagnostics.codes.get(selected)) < 0) || (diagnostics.starts.get(candidate) == diagnostics.starts.get(selected) && diagnostics.lengths.get(candidate) == diagnostics.lengths.get(selected) && diagnostics.codes.get(candidate) == diagnostics.codes.get(selected) && irCompareText(diagnostics.messages.get(candidate), diagnostics.messages.get(selected)) < 0))
        selected = candidate
      end
      candidate = candidate + 1
    end
    emitted.set(selected, 1)
    let absoluteStart = diagnostics.starts.get(selected)
    var sourceIndex = 0
    while sourceIndex + 1 < sourceStarts.size && sourceStarts.get(sourceIndex + 1) <= absoluteStart
      sourceIndex = sourceIndex + 1
    end
    let source = sourceTexts.get(sourceIndex)
    let localStart = absoluteStart - sourceStarts.get(sourceIndex)
    let byteStart = (new IrSourceMap(source)).offsetAt(localStart)
    var line = 1
    var lineStart = 0
    var scan = 0
    while scan < byteStart
      if (host.stringByteAt(source, scan) as Int) == 10
        line = line + 1
        lineStart = scan + 1
      end
      scan = scan + 1
    end
    var lineEnd = lineStart
    while lineEnd < host.stringByteLength(source) && (host.stringByteAt(source, lineEnd) as Int) != 10 && (host.stringByteAt(source, lineEnd) as Int) != 13
      lineEnd = lineEnd + 1
    end
    let rawLine = host.stringSlice(source, lineStart, lineEnd - lineStart)
    let prefix = host.stringSlice(source, lineStart, byteStart - lineStart)
    let column = bootstrapVisualColumn(prefix)
    ConsoleInteraction.println(sourcePaths.get(sourceIndex) + ":" + (line as String) + ":" + (column as String) + " error " + diagnostics.codes.get(selected) + ": " + diagnostics.messages.get(selected))
    ConsoleInteraction.println(bootstrapExpandTabs(rawLine))
    ConsoleInteraction.println(bootstrapSpaces(column - 1) + bootstrapCarets(diagnostics.lengths.get(selected)))
    index = index + 1
  end
end

def bootstrapStartsWith(value: String, prefix: String): Bool
  let valueLength = host.stringByteLength(value)
  let prefixLength = host.stringByteLength(prefix)
  if prefixLength > valueLength
    return false
  end
  return host.stringSlice(value, 0, prefixLength) == prefix
end

def bootstrapSourceId(path: String, sourceRoot: String, singleDefault: Bool): String
  if sourceRoot == "" && singleDefault
    return "main"
  end
  var root = sourceRoot
  while root != "/" && semanticEndsWith(root, "/")
    root = host.stringSlice(root, 0, host.stringByteLength(root) - 1)
  end
  if root == "/" && bootstrapStartsWith(path, "/")
    return host.stringSlice(path, 1, host.stringByteLength(path) - 1)
  end
  if root != "" && bootstrapStartsWith(path, root + "/")
    return host.stringSlice(path, host.stringByteLength(root) + 1, host.stringByteLength(path) - host.stringByteLength(root) - 1)
  end
  if bootstrapStartsWith(path, "./")
    return host.stringSlice(path, 2, host.stringByteLength(path) - 2)
  end
  return path
end

def bootstrapPathWithin(root: String, path: String): Bool
  return path == root || bootstrapStartsWith(path, root == "/" ? "/" : root + "/")
end

def bootstrapCommonSourceRoot(first: BootstrapSourceInput?): String
  let initial = first
  if initial == null
    return ""
  end
  var root = bootstrapDirectory(initial.path)
  var source = initial.nextInput
  while source != null
    while !bootstrapPathWithin(root, source.path) && root != "/"
      root = bootstrapDirectory(root)
    end
    source = source.nextInput
  end
  return root
end

def bootstrapNextSource(first: BootstrapSourceInput?): BootstrapSourceInput?
  var best: BootstrapSourceInput? = null
  var current = first
  while current != null
    if !current.emitted && (best == null || irCompareText(current.id, best.id) < 0)
      best = current
    end
    current = current.nextInput
  end
  return best
end

def bootstrapUsage(): Void
  ConsoleInteraction.println("usage: neri [build|check|run] [--module <name>] [--source-root <dir>] [--target <target>] [--release] [--no-cache] [--timings] [--emit=neri-ir|neri-ir-hex|llvm-ir|asm|obj|executable] [--output <path>] <source.hk>... [-- <program arguments>]")
  ConsoleInteraction.println("A source file without a command is run. Native targets default to the installed runtime target.")
  ConsoleInteraction.println("neri build main.hk creates ./main; use --output to choose another path. neri --version prints the version.")
end

def bootstrapValidEmit(emit: String): Bool
  return emit == "neri-ir" || emit == "neri-ir-hex" || emit == "llvm-ir" || emit == "asm" || emit == "obj" || emit == "executable"
end

def bootstrapWriteArtifact(output: String, artifact: String): Bool
  if output == "" || output == "-"
    ConsoleInteraction.print(artifact)
    return true
  end
  if host.writeText(output, artifact)
    return true
  end
  ConsoleInteraction.println("could not write output: " + host.errorMessage())
  return false
end

def main(): Void
  let started = runCacheTime()
  var timings = false
  var noCache = false
  var moduleName = "main"
  var sourceRoot = ""
  var emit = "neri-ir"
  var emitExplicit = false
  var output = ""
  var target = ""
  var release = false
  var command = "run"
  var firstSource: BootstrapSourceInput? = null
  var lastSource: BootstrapSourceInput? = null
  var sourceCount = 0
  var programArguments: String[] = []
  var index = 0
  while index < host.argumentCount()
    let optionalArgument = host.argumentAt(index)
    if optionalArgument == null
      return
    end
    let argument = optionalArgument
    if index == 0 && (argument == "build" || argument == "check" || argument == "run")
      command = argument
      index = index + 1
    else if argument == "--" && command == "run"
      index = index + 1
      while index < host.argumentCount()
        let value = host.argumentAt(index)
        if value != null
          programArguments = host.appendString(programArguments, value)
        end
        index = index + 1
      end
    else if argument == "--version" || (index == 0 && argument == "version")
      ConsoleInteraction.println("neri 0.2.0-dev")
      return
    else if argument == "--help"
      bootstrapUsage()
      return
    else if argument == "--module" || argument == "--source-root" || argument == "--output" || argument == "--target"
      if index + 1 >= host.argumentCount()
        bootstrapUsage()
        host.exit(2)
        return
      end
      let optionalValue = host.argumentAt(index + 1)
      if optionalValue == null
        return
      end
      if argument == "--module"
        moduleName = optionalValue
      else if argument == "--source-root"
        sourceRoot = optionalValue
      else if argument == "--output"
        output = optionalValue
      else
        target = optionalValue
      end
      index = index + 2
    else if bootstrapStartsWith(argument, "--module=")
      moduleName = host.stringSlice(argument, 9, host.stringByteLength(argument) - 9)
      index = index + 1
    else if bootstrapStartsWith(argument, "--source-root=")
      sourceRoot = host.stringSlice(argument, 14, host.stringByteLength(argument) - 14)
      index = index + 1
    else if bootstrapStartsWith(argument, "--emit=")
      emit = host.stringSlice(argument, 7, host.stringByteLength(argument) - 7)
      emitExplicit = true
      index = index + 1
    else if argument == "--timings"
      timings = true
      index = index + 1
    else if argument == "--no-cache"
      noCache = true
      index = index + 1
    else if argument == "--release"
      release = true
      index = index + 1
    else if bootstrapStartsWith(argument, "--")
      ConsoleInteraction.println("unknown option: " + argument)
      bootstrapUsage()
      host.exit(2)
      return
    else
      let optionalPath = host.pathAbsolute(argument)
      if optionalPath == null
        ConsoleInteraction.println("source path is invalid: " + argument)
        host.exit(2)
        return
      end
      let path = optionalPath
      let text = host.readText(path)
      if text == null
        ConsoleInteraction.println("could not read source: " + argument)
        host.exit(2)
        return
      end
      let input = new BootstrapSourceInput(path, "", text)
      if firstSource == null
        firstSource = input
      else
        let last = lastSource
        if last != null
          last.nextInput = input
        end
      end
      lastSource = input
      sourceCount = sourceCount + 1
      index = index + 1
    end
  end
  if sourceCount == 0
    bootstrapUsage()
    host.exit(2)
    return
  end
  if (command == "build" || command == "run") && !emitExplicit
    emit = "executable"
  end
  if command == "run" && (emit != "executable" || output != "")
    ConsoleInteraction.println("run owns its executable location; --output and non-executable --emit are invalid")
    host.exit(2)
    return
  end
  if !bootstrapValidEmit(emit)
    ConsoleInteraction.println("unknown emit kind: " + emit)
    bootstrapUsage()
    host.exit(2)
    return
  end

  var logicalRoot = ""
  if sourceRoot != ""
    let optionalRoot = host.pathAbsolute(sourceRoot)
    if optionalRoot == null
      ConsoleInteraction.println("source root is invalid: " + sourceRoot)
      host.exit(2)
      return
    end
    logicalRoot = optionalRoot
  else if sourceCount > 1
    logicalRoot = bootstrapCommonSourceRoot(firstSource)
  end

  var source = firstSource
  while source != null
    if logicalRoot != "" && !bootstrapPathWithin(logicalRoot, source.path)
      ConsoleInteraction.println("source is outside source root: " + source.path)
      host.exit(2)
      return
    end
    source.id = bootstrapSourceId(source.path, logicalRoot, sourceCount == 1 && sourceRoot == "")
    var duplicate = source.nextInput
    while duplicate != null
      let duplicateId = bootstrapSourceId(duplicate.path, logicalRoot, sourceCount == 1 && sourceRoot == "")
      if source.id == duplicateId
        ConsoleInteraction.println("source identity is specified more than once: " + source.id)
        host.exit(2)
        return
      end
      duplicate = duplicate.nextInput
    end
    source = source.nextInput
  end
  for libraryName in ["http", "terminal", "clock"]
    var needsLibrary = false
    source = firstSource
    while source != null
      let imports = (new BootstrapLexer(source.text)).lex()
      var tokenIndex = 0
      while tokenIndex + 1 < imports.count()
        if imports.kindAt(tokenIndex) == "Use" && imports.textAt(tokenIndex + 1) == libraryName
          needsLibrary = true
        end
        tokenIndex = tokenIndex + 1
      end
      source = source.nextInput
    end
    if needsLibrary
      let directory = host.environment("NERI_STDLIB")
      if directory == null
        ConsoleInteraction.println("The " + libraryName + " library requires NERI_STDLIB; use the toolchain launcher.")
        host.exit(2)
        return
      end
      let libraryPath = directory + "/" + libraryName + ".hk"
      var supplied = false
      source = firstSource
      while source != null
        if source.path == libraryPath
          supplied = true
        end
        source = source.nextInput
      end
      if !supplied
        let libraryText = host.readText(libraryPath)
        if libraryText == null
          ConsoleInteraction.println("Cannot read standard library: " + libraryPath)
          host.exit(2)
          return
        end
        let library = new BootstrapSourceInput(libraryPath, "@stdlib/" + libraryName + ".hk", libraryText)
        let last = lastSource
        if last != null
          last.nextInput = library
        end
        lastSource = library
      end
    end
  end
  let sourceIds = new StringBuffer()
  let sourcePaths = new StringBuffer()
  let sourceTexts = new StringBuffer()
  let sourceStarts = new IntBuffer()
  var combined = ""
  var combinedLength = 0
  source = bootstrapNextSource(firstSource)
  while source != null
    source.emitted = true
    sourceIds.add(source.id)
    let optionalFileName = host.pathFileName(source.path)
    var displayName = source.id
    if optionalFileName != null
      displayName = optionalFileName
    end
    sourcePaths.add(displayName)
    sourceTexts.add(source.text)
    sourceStarts.add(combinedLength)
    combined = combined + source.text + "\n"
    combinedLength = combinedLength + (new IrSourceMap(source.text)).utf16Length() + 1
    source = bootstrapNextSource(firstSource)
  end

  let lexer = new BootstrapLexer(combined)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)
  index = 0
  while index < sourceStarts.size
    parser.addSourceBoundary(sourceStarts.get(index))
    index = index + 1
  end
  let root = parser.parseProgram()
  if parser.diagnostics.count() > 0
    irEmitDiagnostics(parser.diagnostics, "Parse", sourcePaths, sourceTexts, sourceStarts)
    host.exit(1)
    return
  end
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
  binder.clearSources()
  index = 0
  while index < sourceIds.size
    binder.addSource(sourceIds.get(index), sourceStarts.get(index))
    index = index + 1
  end
  let semantic = binder.bind()
  if semantic.diagnostics.count() > 0
    irEmitDiagnostics(semantic.diagnostics, "TypeCheck", sourcePaths, sourceTexts, sourceStarts)
    host.exit(1)
    return
  end
  let lowerer = new IrLowerer(semantic, parser.arena, combined, moduleName)
  lowerer.setSources(sourceIds, sourceTexts, sourceStarts)
  let module = lowerer.lower()
  let verification = irVerify(module)
  if !verification.succeeded()
    index = 0
    while index < verification.errors.size
      ConsoleInteraction.println("NIRV|" + verification.errors.get(index))
      index = index + 1
    end
    host.exit(1)
    return
  end
  if emit == "llvm-ir" || emit == "asm" || emit == "obj" || emit == "executable"
    runCacheReport(timings, "frontend", started)
    if target == ""
      let manifestPath = host.environment("NERI_RUNTIME_MANIFEST")
      if manifestPath != null
        let manifest = host.readText(manifestPath)
        if manifest != null
          target = bootstrapManifestString(manifest, "target")
        end
      end
    end
    if target != "linux-x86_64" && target != "macos-arm64"
      ConsoleInteraction.println("--target must be linux-x86_64 or macos-arm64 for native artifacts")
      host.exit(2)
      return
    end
    var runDirectory = ""
    let cache = new RunCache()
    if command == "run"
      let lookupStarted = runCacheTime()
      if !noCache
        cache.prepare(module, target, release)
      end
      let hit = cache.hit()
      runCacheReport(timings, hit ? "cache-hit" : "cache-miss", lookupStarted)
      if hit
        runCacheReport(timings, "ready", started)
        let executionStarted = runCacheTime()
        let result = host.run(cache.executable, programArguments)
        runCacheReport(timings, "execute", executionStarted)
        if result != null
          host.exit(result > 125 ? 125 : result)
          return
        end
        # A vanished or non-executable artifact is a miss, not a program error.
      end
      var directory: String? = null
      if cache.directory != ""
        directory = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "pending")
      end
      if directory == null
        directory = bootstrapRunDirectory()
      end
      if directory == null
        ConsoleInteraction.println("could not create temporary run directory")
        host.exit(2)
        return
      end
      runDirectory = directory
      output = directory + "/program"
    end
    if output == "" && command == "build" && emit == "executable"
      let first = firstSource
      if first != null
        let name = host.pathFileName(first.path)
        if name != null
          let length = host.stringByteLength(name)
          if length > 3 && (host.stringByteAt(name, length - 3) as Int) == 46 && (host.stringByteAt(name, length - 2) as Int) == 104 && (host.stringByteAt(name, length - 1) as Int) == 107
            output = "./" + host.stringSlice(name, 0, length - 3)
          end
        end
      end
    end
    if output == ""
      ConsoleInteraction.println("--output is required for native artifacts")
      host.exit(2)
      return
    end
    if (emit == "obj" || emit == "executable") && output == "-"
      ConsoleInteraction.println("--output - is not valid for " + emit)
      host.exit(2)
      return
    end
    let nativeSucceeded = bootstrapEmitNative(module, emit, output, target, release, timings)
    if command == "run"
      var status = 2
      if nativeSucceeded
        if cache.publish(runDirectory)
          runDirectory = ""
        end
        if cache.hit()
          output = cache.executable
        end
        runCacheReport(timings, "ready", started)
        let executionStarted = runCacheTime()
        let result = host.run(output, programArguments)
        runCacheReport(timings, "execute", executionStarted)
        if result != null
          status = result
        else
          ConsoleInteraction.println("could not run executable: " + host.errorMessage())
        end
      end
      if runDirectory != ""
        bootstrapRemoveRunDirectory(runDirectory)
      end
      if status > 125
        status = 125
      end
      host.exit(status)
      return
    end
    if !nativeSucceeded
      host.exit(2)
    end
    if output != "-"
      ConsoleInteraction.println(output)
    end
  else if emit == "neri-ir-hex"
    let artifact = irSerializeEnvelopeHex(module)
    if !bootstrapWriteArtifact(output, artifact)
      host.exit(2)
    end
  else
    let artifact = irRenderModule(module)
    if !bootstrapWriteArtifact(output, artifact)
      host.exit(2)
    end
  end
end
