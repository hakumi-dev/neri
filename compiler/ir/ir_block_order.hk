use arrays

class IrBlockOrder
  private blocks: StringTable<IrBlock> = new StringTable<IrBlock>()
  private visited: StringTable<Bool> = new StringTable<Bool>()
  private values: IrBlock?[] = []
  public size: Int = 0

  def init(function: IrFunction): Void
    var block = function.firstBlock

    while block != null
      this.blocks.add(block.id as String, block)
      block = block.nextBlock
    end
    if function.blockCount == 0
      return
    end
    this.add(function.entryBlock)
    var index = 0

    while index < this.size
      let current = this.get(index)

      if current != null
        let terminator = current.terminator

        if terminator != null
          if terminator.kind.isBranch() || terminator.kind.isConditionalBranch()
            this.add(terminator.firstTarget)
          end
          if terminator.kind.isConditionalBranch()
            this.add(terminator.secondTarget)
          end
        end
      end
      index = index + 1
    end
  end

  private def add(id: Int): Void
    let key = id as String

    if !this.visited.add(key, true)
      return
    end
    if this.size == this.values.Length
      let previous = this.values
      let capacity = previous.Length == 0 ? 16 : previous.Length * 2

      this.values = arrays::generate<IrBlock?>(capacity) do |index|
        return index < this.size ? previous[index] : null
      end
    end
    let entry = this.blocks.find(key)

    this.values[this.size] = entry == null ? null : entry.value
    this.size = this.size + 1
  end

  def get(index: Int): IrBlock?
    return index >= 0 && index < this.size ? this.values[index] : null
  end
end
