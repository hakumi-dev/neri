class IrStateEntry
  public variable: IrVariable = new IrVariable("error", 6, "error", "int", -1, false, 0, new IrLocation(false, 0, 0))
  public value: Int = -1
  public nextEntry: IrStateEntry?

  def init(variable: IrVariable, value: Int): Void
    this.variable = variable
    this.value = value
  end
end
