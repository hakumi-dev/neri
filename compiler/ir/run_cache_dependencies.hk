use host
use files

# Describe inputs consumed by codegen separately from final native linking.
class RunCacheDependencies
  public paths: String[] = []
  public configuration: String = ""

  def capture(target: readonly TargetPlatform, nativeObject: Bool, additionalDependencies: String[], linkToolchain: NativeLinkToolchain? = null): Bool
    this.paths = []
    this.configuration = ""
    let codegen = host::environment("NERI_CODEGEN")

    if codegen == null || (new RunCacheFile(codegen, true)).kind != 1
      return false
    end
    this.paths = [codegen]
    if !nativeObject
      let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")
      let sdk = host::environment("SDKROOT")

      if manifestPath == null || sdk == null || !bootstrapStartsWith(sdk, "/") || linkToolchain == null || !linkToolchain.matches()
        return false
      end
      let read = files::readBytes(manifestPath, 1048576)
      let bytes = read.bytes

      if read.failure != null || read.closeFailure != null || bytes == null
        return false
      end
      let manifest = host::stringFromBytes(bytes)

      if manifest == null || bootstrapManifestString(manifest, "target") != target.name()
        return false
      end
      let artifact = bootstrapManifestString(manifest, "artifact")

      if !bootstrapArtifactNameValid(artifact)
        return false
      end
      let runtime = bootstrapDirectory(manifestPath) + "/" + artifact

      this.paths = [codegen, runtime, manifestPath, linkToolchain.driver, linkToolchain.linker, linkToolchain.lto]
      # Clang reads SDK metadata itself; linker dependency_info does not record
      # those reads. Preserve the SDK root and optional settings observation.
      this.paths = host::appendString(this.paths, sdk)
      this.paths = host::appendString(this.paths, sdk + "/SDKSettings.json")
      this.configuration = runCacheFrame(manifest)
      # Actual SDK files, loaded images and unsuccessful searches are captured
      # by the native link receipt. Bind launch choices, not guessed libraries.
      for variable in ["SDKROOT", "DEVELOPER_DIR", "MACOSX_DEPLOYMENT_TARGET", "PATH", "NERI_DSYMUTIL"]
        let value = host::environment(variable)

        if value != null
          this.configuration = this.configuration + runCacheFrame(variable) + runCacheFrame(value)
        end
      end
    end
    for dependency in additionalDependencies
      this.paths = host::appendString(this.paths, dependency)
    end
    for path in this.paths
      let info = new RunCacheFile(path, true)

      if info.kind != 1 || info.fingerprint == ""
        if !nativeObject
          let sdk = host::environment("SDKROOT")

          if sdk != null
            if path == sdk && info.kind == 2 && info.fingerprint != ""
              continue
            end
            if path == sdk + "/SDKSettings.json" && info.kind == 0
              let status = files::status(path)
              let value = status.status

              if status.failure == null && value != null && !value.exists
                continue
              end
            end
          end
        end
        return false
      end
    end
    return true
  end
end
