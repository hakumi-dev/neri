class IrNativeRecord
  public symbol: IrSymbol = new IrSymbol("main", 10, "")
  public unionType: Bool = false
  public firstField: IrField?
  public lastField: IrField?
  public fieldCount: Int = 0
  public nextRecord: IrNativeRecord?

  def init(symbol: IrSymbol, unionType: Bool): Void
    this.symbol = symbol
    this.unionType = unionType
  end

  def addField(field: IrField): Void
    let last = this.lastField
    if last == null
      this.firstField = field
    else
      last.nextField = field
    end
    this.lastField = field
    this.fieldCount = this.fieldCount + 1
  end
end

def irLowerNativeRecords(lowerer: IrLowerer): Void
  var record = lowerer.semantic.firstRecord
  while record != null
    let declaration = new IrNativeRecord(irSymbol(lowerer.module.id, 10, record.name), record.unionType)
    var field = record.firstField
    while field != null
      let typeName = irType(field.typeName)
      lowerer.requireType(typeName)
      declaration.addField(new IrField(irSymbol(lowerer.module.id, 2, record.name + "." + field.name), typeName, 1, irNoLocation()))
      field = field.nextField
    end
    let last = lowerer.module.lastRecord
    if last == null
      lowerer.module.firstRecord = declaration
    else
      last.nextRecord = declaration
    end
    lowerer.module.lastRecord = declaration
    lowerer.module.recordCount = lowerer.module.recordCount + 1
    lowerer.module.requireFeature("native-records-v1")
    record = record.nextRecord
  end
end

def irWriteNativeRecords(writer: IrWireBuffer, module: IrModule): Void
  writer.writeUInt32(module.recordCount)
  var previous = ""
  var index = 0
  while index < module.recordCount
    var selected: IrNativeRecord? = null
    var candidate = module.firstRecord
    while candidate != null
      if index == 0 || irCompareText(previous, candidate.symbol.name) < 0
        if selected == null
          selected = candidate
        else if irCompareText(candidate.symbol.name, selected.symbol.name) < 0
          selected = candidate
        end
      end
      candidate = candidate.nextRecord
    end
    if selected != null
      irWriteSymbol(writer, selected.symbol)
      writer.writeBool(selected.unionType)
      writer.writeUInt32(selected.fieldCount)
      var field = selected.firstField
      while field != null
        irWriteSymbol(writer, field.symbol)
        irWriteType(writer, module.id, field.typeName)
        writer.writeByte(field.access)
        irWriteLocation(writer, field.location)
        field = field.nextField
      end
      previous = selected.symbol.name
    end
    index = index + 1
  end
end

def irFixedArrayInner(typeName: String): String
  return irTypeInner(irTypeInner(typeName))
end

def irFixedArrayCount(typeName: String): Int
  return semanticIntField(typeName, 1)
end

def irNativeFieldAddress(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let receiverNode = lowerer.bound.childAt(node, 0)
  var receiver = new IrValue(-1, "void")
  if semanticIsPointer(lowerer.bound.typeAt(receiverNode))
    receiver = lowerer.lowerExpression(context, receiverNode, "")
  else
    receiver = irNativeStorageAddress(lowerer, context, receiverNode)
  end
  context.function.localEffects = irEffectUnion(context.function.localEffects, 64)
  return context.emitSymbol(59, "pointer|" + irType(lowerer.bound.typeAt(node)), [lowerer.currentUnsafe(context), receiver.id], irSymbol(lowerer.module.id, 2, lowerer.bound.dataAt(node)), lowerer.location(node))
end

def irNativeStorageAddress(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let typeName = irType(lowerer.bound.typeAt(node))
  if lowerer.bound.kindAt(node) == "NativeField"
    return irNativeFieldAddress(lowerer, context, node)
  end
  if lowerer.bound.kindAt(node) == "NativeIndex"
    return irNativeIndexAddress(lowerer, context, node)
  end
  if lowerer.bound.kindAt(node) == "Index"
    let collection = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 0), "")
    let index = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 1), "int")
    if irIsPointer(collection.typeName)
      context.function.localEffects = irEffectUnion(context.function.localEffects, 64)
      return context.emitTyped(46, collection.typeName, [lowerer.currentUnsafe(context), collection.id, index.id], irTypeInner(collection.typeName), lowerer.location(node))
    end
  end
  if lowerer.bound.kindAt(node) == "Unary" && lowerer.bound.dataAt(node) == "*"
    return lowerer.lowerExpression(context, lowerer.bound.childAt(node, 0), "")
  end
  var variable: IrVariable? = null
  if lowerer.bound.kindAt(node) == "Name"
    variable = context.findVariableIdentity(lowerer.bound.symbolAt(node), lowerer.bound.dataAt(node))
    if variable != null && variable.addressedPointer >= 0
      return new IrValue(variable.addressedPointer, "pointer|" + typeName)
    end
  end
  let value = lowerer.lowerExpression(context, node, typeName)
  let one = context.emitConstant("int", 3, "1", lowerer.location(node))
  let pointer = context.emitTyped(43, "pointer|" + typeName, [lowerer.currentUnsafe(context), one.id], typeName, lowerer.location(node))
  context.emitTyped(45, "void", [lowerer.currentUnsafe(context), pointer.id, value.id], typeName, lowerer.location(node))
  if variable != null
    variable.addressedPointer = pointer.id
    variable.addressedDepth = context.unsafeDepth
  end
  context.function.localEffects = irEffectUnion(context.function.localEffects, 70)
  return pointer
end

def irNativeIndexAddress(lowerer: IrLowerer, context: IrFunctionContext, node: Int): IrValue
  let receiver = irNativeStorageAddress(lowerer, context, lowerer.bound.childAt(node, 0))
  let index = lowerer.lowerExpression(context, lowerer.bound.childAt(node, 1), "int")
  context.function.localEffects = irEffectUnion(context.function.localEffects, 68)
  return context.emitValue(60, "pointer|" + irType(lowerer.bound.typeAt(node)), [lowerer.currentUnsafe(context), receiver.id, index.id], lowerer.location(node))
end

def irPrepareNativeVariable(lowerer: IrLowerer, context: IrFunctionContext, variable: IrVariable, node: Int): Void
  let kind = irTypeKind(variable.typeName)
  if !variable.active || variable.addressedPointer >= 0 || context.unsafeDepth == 0 || (kind != "record" && kind != "fixed-array")
    return
  end
  let one = context.emitConstant("int", 3, "1", lowerer.location(node))
  let capability = lowerer.currentUnsafe(context)
  let pointer = context.emitTyped(43, "pointer|" + variable.typeName, [capability, one.id], variable.typeName, lowerer.location(node))
  context.emitTyped(45, "void", [capability, pointer.id, variable.value], variable.typeName, lowerer.location(node))
  variable.addressedPointer = pointer.id
  variable.addressedDepth = context.unsafeDepth
  context.function.localEffects = irEffectUnion(context.function.localEffects, 70)
end
