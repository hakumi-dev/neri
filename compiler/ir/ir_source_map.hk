class IrSourceMap
  public offsets: IntBuffer = new IntBuffer()
  public ascii: Bool = true
  public length: Int = 0

  def init(source: String): Void
    let byteLength = host.stringByteLength(source)
    var scan = 0

    while scan < byteLength
      if (host.stringByteAt(source, scan) as Int) >= 128
        this.ascii = false
        break
      end
      scan = scan + 1
    end
    if this.ascii
      this.length = byteLength
      return
    end
    this.offsets.add(0)
    var bytePosition = 0

    while bytePosition < host.stringByteLength(source)
      let point = codePointAt(source, bytePosition)
      let nextByte = bytePosition + utf8Width(host.stringByteAt(source, bytePosition) as Int)

      if utf16Width(point) == 2
        this.offsets.add(bytePosition)
      end
      this.offsets.add(nextByte)
      bytePosition = nextByte
    end
    this.length = this.offsets.size - 1
  end

  def utf16Length(): Int
    return this.length
  end

  def offsetAt(utf16Offset: Int): Int
    if utf16Offset < 0
      return 0
    end
    if this.ascii
      if utf16Offset > this.length
        return this.length
      end
      return utf16Offset
    end
    if utf16Offset >= this.offsets.size
      return this.offsets.get(this.offsets.size - 1)
    end
    return this.offsets.get(utf16Offset)
  end

  def location(start: Int, length: Int): IrLocation
    let byteStart = this.offsetAt(start)
    let byteEnd = this.offsetAt(start + length)

    return new IrLocation(true, byteStart, byteEnd - byteStart)
  end
end
