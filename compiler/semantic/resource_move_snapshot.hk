sealed class ResourceMoveSnapshot
  public state: readonly ResourceMoveState
  public next: ResourceMoveSnapshot?

  private def init(state: readonly ResourceMoveState): Void
    this.state = state
  end

  static def capture(firstLocal: SemanticLocal?): readonly ResourceMoveSnapshot?
    var first: ResourceMoveSnapshot? = null
    var last: ResourceMoveSnapshot? = null
    var local = firstLocal

    while local != null
      let node = new ResourceMoveSnapshot(local.resourceMove)

      if last == null
        first = node
      else
        last.next = node
      end
      last = node
      local = local.nextLocal
    end
    return first
  end
end
