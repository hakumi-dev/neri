use host

def genericContractParameterName(template: Int, index: Int): String
  return "$parameter." + (template as String) + "." + (index as String)
end

def genericContractReplace(value: String, needle: String, replacement: String): String
  if needle == ""
    return value
  end
  let length = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)
  var result = ""
  var start = 0
  var index = 0

  while index + needleLength <= length
    var matches = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, index + offset) != host::stringByteAt(needle, offset)
        matches = false
        break
      end
      offset = offset + 1
    end
    if matches
      result = result + host::stringSlice(value, start, index - start) + replacement
      index = index + needleLength
      start = index
    else
      index = index + 1
    end
  end
  return result + host::stringSlice(value, start, length - start)
end

def genericContractMessage(message: String, names: StringBuffer): String
  var result = message
  var index = names.size - 2

  while index >= 0
    result = genericContractReplace(result, names.get(index), names.get(index + 1))
    index = index - 2
  end
  return result
end

def genericContractInternalIdentity(value: String): Bool
  return bootstrapFindText(value, "$parameter.") >= 0
end

def genericContractMergeSymbols(target: SemanticCompletionSite, source: SemanticCompletionSite): Void
  var symbol = source.firstSymbol

  while symbol != null
    if !genericContractInternalIdentity(symbol.identity) && !genericContractInternalIdentity(symbol.typeName)
      target.addSymbol(symbol.identity, symbol.name, symbol.typeName, symbol.mutable)
    end
    symbol = symbol.next
  end
end

def genericContractMergeSourceData(owner: BootstrapBinder, validation: SemanticModel): Void
  var occurrence = validation.occurrences

  while occurrence != null
    if !genericContractInternalIdentity(occurrence.identity)
      let copy = new SemanticOccurrence()

      copy.identity = occurrence.identity
      copy.display = occurrence.display
      copy.start = occurrence.start
      copy.length = occurrence.length
      copy.next = owner.model.occurrences
      owner.model.occurrences = copy
    end
    occurrence = occurrence.next
  end
  var site = validation.completionSites

  while site != null
    let contract = semanticTypeParameterContract(validation, site.receiverType)
    let nominal = semanticTypeParameterInterface(validation, site.receiverType)

    if contract != null || nominal != null
      let copy = new SemanticCompletionSite()

      copy.start = site.start
      copy.length = site.length
      copy.namespaceName = site.namespaceName
      copy.className = site.className
      copy.expectsFunction = site.expectsFunction
      if contract != null
        copy.receiverKind = "contract"
        copy.receiverType = contract.fullName
      else if nominal != null
        copy.receiverKind = "interface"
        copy.receiverType = semanticIsReadonly(site.receiverType) ? semanticReadView(nominal.fullName) : nominal.fullName
      end
      genericContractMergeSymbols(copy, site)
      copy.next = owner.model.completionSites
      owner.model.completionSites = copy
    end
    site = site.next
  end
end

def genericContractMergeDiagnostics(owner: BootstrapBinder, validation: SemanticModel, names: StringBuffer): Void
  var index = 0

  while index < validation.diagnostics.count()
    owner.model.diagnostics.add(
      validation.diagnostics.codes.get(index),
      validation.diagnostics.starts.get(index),
      validation.diagnostics.lengths.get(index),
      genericContractMessage(validation.diagnostics.messages.get(index), names)
    )
    index = index + 1
  end
end

def semanticOpaqueGenericArguments(
  owner: BootstrapBinder,
  template: Int,
  namespaceOverride: String = "",
  names: StringBuffer? = null
): StringBuffer
  let parameters = owner.syntax.nodeAt(template).typeParameters
  let arguments = new StringBuffer()
  var index = 0

  while index < parameters.Length && owner.checkpoint()
    let name = genericContractParameterName(template, index)
    let capability = semanticGenericCapability(owner, template, index, false, namespaceOverride)

    arguments.add(name)
    if names != null
      names.add(name)
      names.add(parameters[index])
    end
    owner.model.addTypeParameter(new SemanticTypeParameter(name, capability))
    index = index + 1
  end
  return arguments
end

def genericDefinitionReceiver(owner: BootstrapBinder, template: Int): SemanticClass?
  let declaration = semanticDeclaration(owner, template)

  if declaration == null
    return null
  end
  return owner.model.findClass(semanticQualifiedName(declaration.namespaceName, declaration.name))
end

def validateGenericDefinition(
  owner: BootstrapBinder,
  template: Int,
  ordinaryReceiver: SemanticClass? = null
): Void
  let source = owner.syntax.nodeAt(template)
  let validationSyntax = new SyntaxArena(owner.syntax)
  let validation = new BootstrapBinder(validationSyntax, owner.root, owner.sourceLength, owner.model)
  let names = new StringBuffer()

  validation.control = owner.control
  validation.requireEntryPoint = false
  validation.recordSourceSymbols = owner.recordSourceSymbols
  validation.recordCompletionSites = owner.recordCompletionSites
  validation.model.genericInstances = 0
  validation.model.genericDepth = 0
  var definitionClass: SemanticClass? = null
  let definitionFunctions = new StringBuffer()

  if source.kind.isClass()
    var receiver = ordinaryReceiver

    if source.typeParameters.Length > 0
      let arguments = semanticOpaqueGenericArguments(validation, template, names: names)

      receiver = instantiateGenericClass(validation, template, arguments, template)
      definitionClass = receiver
    end
    if receiver != null
      let methodCount = receiver.genericMethods.size
      var index = 0

      while index < methodCount && validation.checkpoint()
        let method = receiver.genericMethods.get(index)
        let wrapper = semanticDeclaration(validation, method)

        if wrapper != null
          let function = validation.syntax.childAt(method, wrapper.annotationCount)
          let arguments = semanticOpaqueGenericArguments(validation, function, receiver.namespaceName, names)
          let callable = instantiateGenericMethod(validation, receiver, method, arguments, function)

          if callable != null && definitionClass == null
            definitionFunctions.add(callable.fullName)
          end
        end
        index = index + 1
      end
    end
  else
    let arguments = semanticOpaqueGenericArguments(validation, template, names: names)

    let callable = instantiateGenericFunction(validation, template, arguments, template)

    if callable != null
      definitionFunctions.add(callable.fullName)
    end
  end

  if definitionClass != null || definitionFunctions.size > 0
    let bodies = new BootstrapBodyBinder(validation)

    bodies.bindBodies(definitionClass, definitionFunctions)
    semanticValidateInterfaces(validation)
  end
  if owner.cancelled()
    return
  end
  genericContractMergeDiagnostics(owner, validation.model, names)
  genericContractMergeSourceData(owner, validation.model)
end

def genericDefinitionHasSourceBody(owner: BootstrapBinder, template: Int): Bool
  let declaration = semanticDeclaration(owner, template)

  if declaration == null
    return false
  end
  if declaration.bodyCount > 0
    return true
  end
  var annotation = 0

  while annotation < declaration.annotationCount
    let kind = owner.syntax.annotationAt(owner.syntax.childAt(template, annotation))

    return false if kind.isIntrinsic() || kind.isOperation()
    annotation = annotation + 1
  end
  return true
end

def validateGenericDefinitions(owner: BootstrapBinder): Void

  let classCount = owner.classCount()
  let count = classCount + owner.functionCount()
  var index = 0

  while index < count && owner.checkpoint()
    let template = index < classCount ? owner.classNodeAt(index) : owner.functionNodeAt(index - classCount)
    let source = owner.syntax.nodeAt(template)

    if source.typeParameters.Length > 0 && semanticGenericConstraintsValid(owner, template, false)
      if source.kind.isClass() || genericDefinitionHasSourceBody(owner, template)
        validateGenericDefinition(owner, template)
      end
    else if source.kind.isClass() && source.typeParameters.Length == 0
      let receiver = genericDefinitionReceiver(owner, template)

      if receiver != null && receiver.genericMethods.size > 0
        validateGenericDefinition(owner, template, receiver)
      end
    end
    index = index + 1
  end
end
