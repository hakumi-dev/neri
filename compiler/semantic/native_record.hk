class NativeRecord
  public name: String = ""
  public namespaceName: String = ""
  public unionType: Bool = false
  public syntaxNode: Int = -1
  public size: Int = 0
  public alignment: Int = 1
  public layoutState: Int = 0
  public firstField: NativeField?
  public lastField: NativeField?
  public nextRecord: NativeRecord?
  def init(name: String, namespaceName: String, unionType: Bool, node: Int): Void
    this.name = name
    this.namespaceName = namespaceName
    this.unionType = unionType
    this.syntaxNode = node
  end
  def addField(field: NativeField): Void
    let last = this.lastField

    if last == null
      this.firstField = field
    else
      last.nextField = field
    end
    this.lastField = field
  end
  def findField(name: String): NativeField?
    var field = this.firstField

    while field != null
      if field.name == name
        return field
      end
      field = field.nextField
    end
    return null
  end
end
