class SemanticCompletionSite
  public argumentScope: SemanticCompletionSite?
  public start: Int = 0
  public length: Int = 0
  public namespaceName: String = ""
  public className: String = ""
  public callable: SemanticCallable?
  public receiverKind: String = ""
  public receiverType: String = ""
  public expectedType: String = ""
  public expectsFunction: Bool = false
  public firstSymbol: SemanticCompletionSymbol?
  public lastSymbol: SemanticCompletionSymbol?
  public next: SemanticCompletionSite?

  # A later declaration shadows an earlier parameter, outer local or local in
  # an enclosing callback. Keep one candidate per source spelling.
  def addSymbol(identity: String, name: String, typeName: String, mutable: Bool): Void
    var current = this.firstSymbol

    while current != null
      if current.name == name
        current.identity = identity
        current.typeName = typeName
        current.mutable = mutable
        return
      end
      current = current.next
    end
    let symbol = new SemanticCompletionSymbol()

    symbol.identity = identity
    symbol.name = name
    symbol.typeName = typeName
    symbol.mutable = mutable
    if this.firstSymbol == null
      this.firstSymbol = symbol
    else
      let last = this.lastSymbol

      if last != null
        last.next = symbol
      end
    end
    this.lastSymbol = symbol
  end
end
