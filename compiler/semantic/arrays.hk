def semanticGeneratorCallbackValid(
  body: BootstrapBodyBinder,
  signature: SemanticClass,
  result: String,
  callbackType: String
): Bool
  if callbackType == "Error" || semanticAssignable(body.model(), signature.fullName, callbackType)
    return true
  end
  let candidate = semanticExpectedFunction(body, callbackType)

  if candidate == null || semanticIsOptional(callbackType) || (semanticIsReadonly(callbackType) && !candidate.isSharedFunction) || (signature.isParallelFunction && !candidate.isParallelFunction)
    return false
  end
  let invoke = candidate.firstMethod

  if invoke == null || invoke.parameterCount != 1
    return false
  end
  let parameter = invoke.firstParameter

  if parameter == null || (parameter.typeName != "Int" && parameter.typeName != "Error")
    return false
  end
  let poisonedResult = result == "Error" || invoke.returnType == "Error"

  return (poisonedResult || parameter.typeName == "Error") && (poisonedResult || invoke.returnType == result)
end

## Result context supplies the ordinary callback signature before capture binding.
def bindArrayGenerate(body: BootstrapBodyBinder, node: Int, expectedType: String): BoundValue?
  let syntax = body.syntax()
  let callee = syntax.childAt(node, 0)
  let name = genericCalleeName(body, callee)
  let template = genericOperationTemplate(body, callee, "arrays.generate")

  if template < 0
    return null
  end
  body.owner.recordOccurrence("callable:" + genericName(body.owner, template), callee)
  let count = syntax.childCountAt(node) - 1

  if count != 2
    body.report("NR111", callee, "Array generation expects a count and an ordinary callback.")
    return body.bindFailedCall(node)
  end
  let explicit = syntax.nodeAt(callee).typeArguments
  var result = semanticIsArray(expectedType) ? semanticInnerType(expectedType) : ""

  if explicit.Length == 1
    result = body.owner.resolveTypeNode(explicit[0], body.owner.currentNamespace, "")
  else if explicit.Length > 1
    body.report("NR220", callee, "Array generation accepts one result type argument.")
  end
  let callbackNode = syntax.childAt(node, count)
  var callback: BoundValue? = null

  if result == ""
    if syntax.kindAt(callbackNode).isClosure()
      let resultNode = syntax.childAt(callbackNode, syntax.firstGroupCount(callbackNode))

      if !syntax.typeAt(resultNode).kind.isInferred()
        result = body.owner.resolveTypeNode(resultNode, body.owner.currentNamespace, "")
      end
    else
      let callbackName = genericCalleeName(body, callbackNode)
      let function = body.resolveFunction(callbackName)

      if function != null
        result = function.returnType
      else if callbackName == ""
        let value = body.bindExpression(callbackNode, "")

        callback = value
        let signature = semanticExpectedFunction(body, value.typeName)

        if value.typeName == "Error"
          result = "Error"
        else if signature != null
          let invoke = signature.firstMethod

          result = invoke.returnType if invoke != null
        end
      end
    end
  end
  result = "Error" if result == "" && expectedType == "Error"
  let validResult = result != "Error" && semanticArrayElement(body.model(), result)

  if !validResult && result != "Error"
    body.report(
      "NR242",
      node,
      "Array generation requires a safe array element type from a result annotation, type argument, or typed callback."
    )
  end
  let parameters = new StringBuffer()

  parameters.add("Int")
  let callbackResult = validResult ? result : "Error"
  let signature = semanticFunctionType(body.owner, parameters, callbackResult, node)
  let lengthNode = syntax.childAt(node, 1)
  let length = body.bindExpression(lengthNode, "Int")

  if length.typeName != "Error" && length.typeName != "Int"
    body.report("NR112", lengthNode, "Array generation count must be Int.")
  end
  callback = body.bindExpression(callbackNode, signature.fullName) if callback == null
  if callback != null && !semanticGeneratorCallbackValid(body, signature, callbackResult, callback.typeName)
    let requirement = validResult ? "an fn(Int): " + result + " callback." : "an ordinary callback taking Int."

    body.report("NR112", callbackNode, "Array generation requires " + requirement)
  end
  if !validResult
    return new BoundValue(
      "Error",
      body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts())
    )
  end
  if callback != null
    let children: Int[] = [length.boundNode, callback.boundNode]

    return new BoundValue(
      result + "[]",
      body.addBound(body.boundKinds().getArrayGenerate(), result + "[]", signature.fullName, node, children)
    )
  end
  return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
end
