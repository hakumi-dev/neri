class BoundNode
  public kind: String = ""
  public typeName: String = ""
  public data: String = ""
  public value: String = ""
  public symbol: String = ""
  public start: Int = 0
  public length: Int = 1
  public children: Int[] = [0]
  public nextNode: BoundNode?
  public previousNode: BoundNode?

  def init(kind: String, typeName: String, data: String, start: Int, length: Int, children: Int[]): Void
    this.kind = kind
    this.typeName = typeName
    this.data = data
    this.start = start
    this.length = length
    this.children = children
  end
end

class BoundArena
  public parent: BoundArena?
  private baseCount: Int = 0
  public first: BoundNode = new BoundNode("", "", "", 0, 1, [0])
  public last: BoundNode = new BoundNode("", "", "", 0, 1, [0])
  public cached: BoundNode?
  public cachedIndex: Int = -1
  public size: Int = 0
  private checkpoints: ArenaCheckpointIndex<BoundNode>

  def init(parent: BoundArena? = null): Void
    this.parent = parent
    if parent != null
      this.baseCount = parent.count()
    end
    this.last = this.first
    this.cached = this.first
    this.checkpoints = new ArenaCheckpointIndex<BoundNode>(this.first)
  end

  def add(kind: String, typeName: String, nodeData: String, start: Int, length: Int, nodeChildren: Int[]): Int
    let index = this.parentOffset() + this.size
    let node = new BoundNode(kind, typeName, nodeData, start, length, nodeChildren)

    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    if (this.size / arenaCheckpointBlockSize()) * arenaCheckpointBlockSize() == this.size
      this.checkpoints.add(node)
    end
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.parentOffset() + this.size
  end

  def nodeAt(index: Int): BoundNode
    let offset = this.parentOffset()

    if index < offset
      let parent = this.parent

      if parent != null
        return parent.nodeAt(index)
      end
      return this.first
    end
    let localIndex = index - offset
    var node = this.cached
    var cursor = this.cachedIndex
    let blockSize = arenaCheckpointBlockSize()
    let checkpointIndex = (localIndex / blockSize) * blockSize

    if node == null
      node = this.checkpoints.get(localIndex / blockSize)
      cursor = checkpointIndex
    else
      let distance = localIndex < cursor ? cursor - localIndex : localIndex - cursor

      if distance > 1 && distance > localIndex - checkpointIndex
        node = this.checkpoints.get(localIndex / blockSize)
        cursor = checkpointIndex
      end
    end
    while cursor > localIndex
      if node != null
        node = node.previousNode
      end
      cursor = cursor - 1
    end
    while cursor < localIndex
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  private def parentOffset(): Int
    return this.baseCount
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def typeAt(index: Int): String
    return this.nodeAt(index).typeName
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def symbolAt(index: Int): String
    return this.nodeAt(index).symbol
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def setSymbol(index: Int, symbol: String): Void
    this.nodeAt(index).symbol = symbol
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end
end

class SemanticParameter
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public hasDefault: Bool = false
  public boundDefault: Int = -1
  public syntaxNode: Int = -1
  public nextParameter: SemanticParameter?

  def init(identity: String, name: String, typeName: String, hasDefault: Bool, syntaxNode: Int): Void
    this.identity = identity
    this.name = name
    this.typeName = typeName
    this.hasDefault = hasDefault
    this.syntaxNode = syntaxNode
  end
end

class SemanticCallable
  public genericOrigin: Int = -1
  public fullName: String = ""
  public name: String = ""
  public namespaceName: String = ""
  public className: String = ""
  public returnType: String = "Error"
  public isStatic: Bool = false
  public isUnsafe: Bool = false
  public isReadonly: Bool = false
  public access: String = "internal"
  public syntaxNode: Int = -1
  public bodyStart: Int = 0
  public bodyCount: Int = 0
  public boundNode: Int = -1
  public cAbiSymbol: String = ""
  public nativeLibrary: String = ""
  public intrinsicName: String = ""
  public exactArguments: Bool = false
  public operatorName: String = ""
  public conversion: Bool = false
  public hasOverride: Bool = false
  public hasBaseConstructorCall: Bool = false
  public baseConstructorName: String = ""
  public baseArguments: IntBuffer = new IntBuffer()
  public firstParameter: SemanticParameter?
  public lastParameter: SemanticParameter?
  public parameterCount: Int = 0
  public nextCallable: SemanticCallable?
  public firstSessionLocal: SemanticLocal?
  public lastSessionLocal: SemanticLocal?

  def init(fullName: String, name: String, namespaceName: String, className: String, returnType: String, isStatic: Bool, isUnsafe: Bool, access: String, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.className = className
    this.returnType = returnType
    this.isStatic = isStatic
    this.isUnsafe = isUnsafe
    this.access = access
    this.syntaxNode = syntaxNode
  end

  def addParameter(parameter: SemanticParameter): Void
    if this.firstParameter == null
      this.firstParameter = parameter
    else
      let last = this.lastParameter

      if last != null
        last.nextParameter = parameter
      end
    end
    this.lastParameter = parameter
    this.parameterCount = this.parameterCount + 1
  end

  def parameterAt(index: Int): SemanticParameter?
    var current = this.firstParameter
    var cursor = 0

    while current != null
      if cursor == index
        return current
      end
      current = current.nextParameter
      cursor = cursor + 1
    end
    return null
  end

  def addSessionLocal(local: SemanticLocal): Void
    if this.firstSessionLocal == null
      this.firstSessionLocal = local
    else
      let last = this.lastSessionLocal

      if last != null
        last.nextLocal = local
      end
    end
    this.lastSessionLocal = local
  end
end

class SemanticField
  public owner: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public access: String = "private"
  public syntaxNode: Int = -1
  public boundInitializer: Int = -1
  public nextField: SemanticField?

  def init(owner: String, name: String, typeName: String, access: String, syntaxNode: Int): Void
    this.owner = owner
    this.name = name
    this.typeName = typeName
    this.access = access
    this.syntaxNode = syntaxNode
  end
end

class SemanticClass
  public bodiesBound: Bool = false
  public genericOrigin: Int = -1
  public genericArguments: String[] = []
  public isFunctionType: Bool = false
  public isSharedFunction: Bool = false
  public isParallelFunction: Bool = false
  public isClosure: Bool = false
  public isAlternative: Bool = false
  public isResource: Bool = false
  public isSealed: Bool = false
  public representation: String = ""
  public fullName: String = ""
  public name: String = ""
  public namespaceName: String = ""
  public access: String = "internal"
  public baseName: String = ""
  public syntaxNode: Int = -1
  public firstField: SemanticField?
  public lastField: SemanticField?
  public firstMethod: SemanticCallable?
  public lastMethod: SemanticCallable?
  public nextClass: SemanticClass?

  def init(fullName: String, name: String, namespaceName: String, access: String, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.access = access
    this.syntaxNode = syntaxNode
  end

  def addField(field: SemanticField): Void
    if this.firstField == null
      this.firstField = field
    else
      let last = this.lastField

      if last != null
        last.nextField = field
      end
    end
    this.lastField = field
  end

  def addMethod(method: SemanticCallable): Void
    if this.firstMethod == null
      this.firstMethod = method
    else
      let last = this.lastMethod

      if last != null
        last.nextCallable = method
      end
    end
    this.lastMethod = method
  end
end

class SemanticLocal
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public mutable: Bool = false
  public depth: Int = 0
  public active: Bool = true
  public syntaxNode: Int = -1
  public resourceMoved: Bool = false
  public resourceMaybeMoved: Bool = false
  public resourceScoped: Bool = false
  public nextLocal: SemanticLocal?

  def init(identity: String, name: String, typeName: String, mutable: Bool, depth: Int, syntaxNode: Int): Void
    this.identity = identity
    this.name = name
    this.typeName = typeName
    this.mutable = mutable
    this.depth = depth
    this.syntaxNode = syntaxNode
  end
end

class BoundValue
  public typeName: String = "Error"
  public boundNode: Int = -1
  # An affine value remembers the local that owns it while it is being bound.
  # This is deliberately semantic data, rather than a syntax-kind check: a
  # parenthesized name reaches the same value as the name itself.
  public resourceIdentity: String = ""

  def init(typeName: String, boundNode: Int, resourceIdentity: String = ""): Void
    this.typeName = typeName
    this.boundNode = boundNode
    this.resourceIdentity = resourceIdentity
  end
end

class SemanticDeclaration
  public identity: String = ""
  public name: String = ""
  public typeName: String = ""
  public display: String = ""
  public symbolKind: Int = 0
  public start: Int = 0
  public length: Int = 0
  public next: SemanticDeclaration?
end

class SemanticOccurrence
  public identity: String = ""
  public display: String = ""
  public start: Int = 0
  public length: Int = 0
  public next: SemanticOccurrence?
end

class SemanticCompletionSymbol
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public mutable: Bool = false
  public next: SemanticCompletionSymbol?
end

class SemanticCompletionSite
  public start: Int = 0
  public length: Int = 0
  public namespaceName: String = ""
  public className: String = ""
  public callable: SemanticCallable?
  public receiverKind: String = ""
  public receiverType: String = ""
  public firstSymbol: SemanticCompletionSymbol?
  public lastSymbol: SemanticCompletionSymbol?
  public next: SemanticCompletionSite?

  # A later declaration shadows an earlier parameter, outer local or local in
  # an enclosing callback. Keep one candidate per source spelling.
  def addSymbol(identity: String, name: String, typeName: String, mutable: Bool): Void
    var current = this.firstSymbol

    while current != null
      if current.name == name
        current.identity = identity
        current.typeName = typeName
        current.mutable = mutable
        return
      end
      current = current.next
    end
    let symbol = new SemanticCompletionSymbol()

    symbol.identity = identity
    symbol.name = name
    symbol.typeName = typeName
    symbol.mutable = mutable
    if this.firstSymbol == null
      this.firstSymbol = symbol
    else
      let last = this.lastSymbol

      if last != null
        last.next = symbol
      end
    end
    this.lastSymbol = symbol
  end
end

class SemanticModel
  public parent: SemanticModel?
  public syntax: SyntaxArena?
  public declarations: SemanticDeclaration?
  public occurrences: SemanticOccurrence?
  public completionSites: SemanticCompletionSite?
  public firstRecord: NativeRecord?
  public lastRecord: NativeRecord?

  def findRecord(name: String): NativeRecord?
    var record = this.firstRecord

    while record != null
      if record.name == name
        return record
      end
      record = record.nextRecord
    end
    let parent = this.parent

    if parent != null
      return parent.findRecord(name)
    end
    return null
  end
  public genericTemplates: IntBuffer = new IntBuffer()
  public genericInstances: Int = 0
  public genericDepth: Int = 0
  public nextClosureId: Int = 0
  public firstClass: SemanticClass?
  public lastClass: SemanticClass?
  public firstFunction: SemanticCallable?
  public lastFunction: SemanticCallable?
  public usedNames: StringBuffer = new StringBuffer()
  public referencedUseNames: StringBuffer = new StringBuffer()
  public declaredNamespaces: StringBuffer = new StringBuffer()
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public bound: BoundArena = new BoundArena()
  public intrinsics: SemanticIntrinsicRegistry?

  def init(parent: SemanticModel? = null): Void
    this.parent = parent
    if parent != null
      this.intrinsics = parent.intrinsics
      this.genericInstances = parent.genericInstances
      this.nextClosureId = parent.nextClosureId
      var index = 0

      while index < parent.usedNames.size
        this.usedNames.add(parent.usedNames.get(index))
        index = index + 1
      end
      index = 0
      while index < parent.genericTemplates.size
        this.genericTemplates.add(parent.genericTemplates.get(index))
        index = index + 1
      end
      index = 0
      while index < parent.declaredNamespaces.size
        this.declaredNamespaces.add(parent.declaredNamespaces.get(index))
        index = index + 1
      end
    else
      this.intrinsics = new SemanticIntrinsicRegistry()
    end
  end

  def addClass(symbol: SemanticClass): Void
    if this.firstClass == null
      this.firstClass = symbol
    else
      let last = this.lastClass

      if last != null
        last.nextClass = symbol
      end
    end
    this.lastClass = symbol
  end

  def addFunction(symbol: SemanticCallable): Void
    if this.firstFunction == null
      this.firstFunction = symbol
    else
      let last = this.lastFunction

      if last != null
        last.nextCallable = symbol
      end
    end
    this.lastFunction = symbol
  end

  def findClass(fullName: String): SemanticClass?
    var current = this.firstClass

    while current != null
      if current.fullName == fullName
        return current
      end
      current = current.nextClass
    end
    let parent = this.parent

    if parent != null
      return parent.findClass(fullName)
    end
    return null
  end

  def findFunction(fullName: String): SemanticCallable?
    var current = this.firstFunction

    while current != null
      if current.fullName == fullName
        return current
      end
      current = current.nextCallable
    end
    let parent = this.parent

    if parent != null
      return parent.findFunction(fullName)
    end
    return null
  end

  def hasUse(name: String): Bool
    var index = 0

    while index < this.usedNames.size
      if this.usedNames.get(index) == name
        return true
      end
      index = index + 1
    end
    let parent = this.parent

    if parent != null
      return parent.hasUse(name)
    end
    return false
  end

  def ownsClass(symbol: SemanticClass): Bool
    var current = this.firstClass

    while current != null
      if current.fullName == symbol.fullName
        return true
      end
      current = current.nextClass
    end
    return false
  end

  def ownsFunction(symbol: SemanticCallable): Bool
    var current = this.firstFunction

    while current != null
      if current.fullName == symbol.fullName
        return true
      end
      current = current.nextCallable
    end
    return false
  end

  def referenceUse(name: String): Void
    if !this.hasUse(name)
      return
    end
    var index = 0

    while index < this.referencedUseNames.size
      if this.referencedUseNames.get(index) == name
        return
      end
      index = index + 1
    end
    this.referencedUseNames.add(name)
  end

  def referenceQualifiedUse(fullName: String): Void
    var index = 0

    while index < this.usedNames.size
      let name = this.usedNames.get(index)

      if fullName == name || bootstrapStartsWith(fullName, name + ".")
        this.referenceUse(name)
      end
      index = index + 1
    end
  end

  def useReferenced(name: String): Bool
    var index = 0

    while index < this.referencedUseNames.size
      if this.referencedUseNames.get(index) == name
        return true
      end
      index = index + 1
    end
    return false
  end
end
