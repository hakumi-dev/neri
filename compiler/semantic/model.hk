class BoundNode
  public kind: String = ""
  public typeName: String = ""
  public data: String = ""
  public value: String = ""
  public symbol: String = ""
  public start: Int = 0
  public length: Int = 1
  public children: Int[] = [0]
  public nextNode: BoundNode?
  public previousNode: BoundNode?

  def init(kind: String, typeName: String, data: String, start: Int, length: Int, children: Int[]): Void
    this.kind = kind
    this.typeName = typeName
    this.data = data
    this.start = start
    this.length = length
    this.children = children
  end
end

class BoundArena
  public first: BoundNode = new BoundNode("", "", "", 0, 1, [0])
  public last: BoundNode = new BoundNode("", "", "", 0, 1, [0])
  public cached: BoundNode?
  public cachedIndex: Int = -1
  public size: Int = 0

  def init(): Void
    this.last = this.first
    this.cached = this.first
  end

  def add(kind: String, typeName: String, nodeData: String, start: Int, length: Int, nodeChildren: Int[]): Int
    let index = this.size
    let node = new BoundNode(kind, typeName, nodeData, start, length, nodeChildren)
    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.size
  end

  def nodeAt(index: Int): BoundNode
    var node = this.cached
    var cursor = this.cachedIndex
    if node == null
      node = this.first
      cursor = -1
    else if index < cursor
      if cursor - index <= index + 1
        while cursor > index
          node = node.previousNode
          cursor = cursor - 1
        end
      else
        node = this.first
        cursor = -1
      end
    end
    while cursor < index
      if node != null node = node.nextNode end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null return node end
    return this.first
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end

  def kindAt(index: Int): String
    return this.nodeAt(index).kind
  end

  def typeAt(index: Int): String
    return this.nodeAt(index).typeName
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def symbolAt(index: Int): String
    return this.nodeAt(index).symbol
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def setSymbol(index: Int, symbol: String): Void
    this.nodeAt(index).symbol = symbol
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end
end

class SemanticParameter
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public hasDefault: Bool = false
  public boundDefault: Int = -1
  public syntaxNode: Int = -1
  public nextParameter: SemanticParameter?

  def init(identity: String, name: String, typeName: String, hasDefault: Bool, syntaxNode: Int): Void
    this.identity = identity
    this.name = name
    this.typeName = typeName
    this.hasDefault = hasDefault
    this.syntaxNode = syntaxNode
  end
end

class SemanticCallable
  public fullName: String = ""
  public name: String = ""
  public namespaceName: String = ""
  public className: String = ""
  public returnType: String = "Error"
  public isStatic: Bool = false
  public isUnsafe: Bool = false
  public access: String = "internal"
  public syntaxNode: Int = -1
  public bodyStart: Int = 0
  public bodyCount: Int = 0
  public boundNode: Int = -1
  public cAbiSymbol: String = ""
  public hasOverride: Bool = false
  public hasBaseConstructorCall: Bool = false
  public baseConstructorName: String = ""
  public baseArguments: IntBuffer = new IntBuffer()
  public firstParameter: SemanticParameter?
  public lastParameter: SemanticParameter?
  public parameterCount: Int = 0
  public nextCallable: SemanticCallable?

  def init(fullName: String, name: String, namespaceName: String, className: String, returnType: String, isStatic: Bool, isUnsafe: Bool, access: String, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.className = className
    this.returnType = returnType
    this.isStatic = isStatic
    this.isUnsafe = isUnsafe
    this.access = access
    this.syntaxNode = syntaxNode
  end

  def addParameter(parameter: SemanticParameter): Void
    if this.firstParameter == null
      this.firstParameter = parameter
    else
      let last = this.lastParameter
      if last != null
        last.nextParameter = parameter
      end
    end
    this.lastParameter = parameter
    this.parameterCount = this.parameterCount + 1
  end

  def parameterAt(index: Int): SemanticParameter?
    var current = this.firstParameter
    var cursor = 0
    while current != null
      if cursor == index
        return current
      end
      current = current.nextParameter
      cursor = cursor + 1
    end
    return null
  end
end

class SemanticField
  public owner: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public access: String = "private"
  public syntaxNode: Int = -1
  public boundInitializer: Int = -1
  public nextField: SemanticField?

  def init(owner: String, name: String, typeName: String, access: String, syntaxNode: Int): Void
    this.owner = owner
    this.name = name
    this.typeName = typeName
    this.access = access
    this.syntaxNode = syntaxNode
  end
end

class SemanticClass
  public fullName: String = ""
  public name: String = ""
  public namespaceName: String = ""
  public access: String = "internal"
  public baseName: String = ""
  public syntaxNode: Int = -1
  public firstField: SemanticField?
  public lastField: SemanticField?
  public firstMethod: SemanticCallable?
  public lastMethod: SemanticCallable?
  public nextClass: SemanticClass?

  def init(fullName: String, name: String, namespaceName: String, access: String, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.access = access
    this.syntaxNode = syntaxNode
  end

  def addField(field: SemanticField): Void
    if this.firstField == null
      this.firstField = field
    else
      let last = this.lastField
      if last != null
        last.nextField = field
      end
    end
    this.lastField = field
  end

  def addMethod(method: SemanticCallable): Void
    if this.firstMethod == null
      this.firstMethod = method
    else
      let last = this.lastMethod
      if last != null
        last.nextCallable = method
      end
    end
    this.lastMethod = method
  end
end

class SemanticLocal
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public mutable: Bool = false
  public depth: Int = 0
  public active: Bool = true
  public syntaxNode: Int = -1
  public nextLocal: SemanticLocal?

  def init(identity: String, name: String, typeName: String, mutable: Bool, depth: Int, syntaxNode: Int): Void
    this.identity = identity
    this.name = name
    this.typeName = typeName
    this.mutable = mutable
    this.depth = depth
    this.syntaxNode = syntaxNode
  end
end

class BoundValue
  public typeName: String = "Error"
  public boundNode: Int = -1

  def init(typeName: String, boundNode: Int): Void
    this.typeName = typeName
    this.boundNode = boundNode
  end
end

class SemanticModel
  public firstClass: SemanticClass?
  public lastClass: SemanticClass?
  public firstFunction: SemanticCallable?
  public lastFunction: SemanticCallable?
  public usedNames: StringBuffer = new StringBuffer()
  public declaredNamespaces: StringBuffer = new StringBuffer()
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public bound: BoundArena = new BoundArena()

  def init(): Void
    return
  end

  def addClass(symbol: SemanticClass): Void
    if this.firstClass == null
      this.firstClass = symbol
    else
      let last = this.lastClass
      if last != null
        last.nextClass = symbol
      end
    end
    this.lastClass = symbol
  end

  def addFunction(symbol: SemanticCallable): Void
    if this.firstFunction == null
      this.firstFunction = symbol
    else
      let last = this.lastFunction
      if last != null
        last.nextCallable = symbol
      end
    end
    this.lastFunction = symbol
  end

  def findClass(fullName: String): SemanticClass?
    var current = this.firstClass
    while current != null
      if current.fullName == fullName
        return current
      end
      current = current.nextClass
    end
    return null
  end

  def findFunction(fullName: String): SemanticCallable?
    var current = this.firstFunction
    while current != null
      if current.fullName == fullName
        return current
      end
      current = current.nextCallable
    end
    return null
  end

  def hasUse(name: String): Bool
    var index = 0
    while index < this.usedNames.size
      if this.usedNames.get(index) == name
        return true
      end
      index = index + 1
    end
    return false
  end
end
