use host

def propagationAnnotationArgument(owner: BootstrapBinder, annotation: Int, index: Int): String
  let written = owner.syntax.dataAt(owner.syntax.childAt(annotation, index))
  let length = host::stringByteLength(written)

  if length < 2
    return ""
  end
  return host::stringSlice(written, 1, length - 2)
end

def propagationCases(owner: BootstrapBinder, node: Int, report: Bool = true): Int[]
  var result = [-1, -1]
  var found = false
  let declaration = semanticDeclaration(owner, node)

  for annotation in owner.syntax.nodeAt(node).classAnnotations
    if !owner.syntax.annotationAt(annotation).isPropagation()
      continue
    end
    if found
      owner.report("NR283", annotation, "Annotation '@propagation' may appear only once.") if report
      continue
    end
    found = true
    if declaration == null || !declaration.isAlternative || owner.syntax.childCountAt(annotation) != 2 || owner.syntax.childCountAt(node) != 2
      owner.report("NR283", annotation, "Annotation '@propagation' requires an enum with two single-payload cases and two case names.") if report
      continue
    end
    let successName = propagationAnnotationArgument(owner, annotation, 0)
    let failureName = propagationAnnotationArgument(owner, annotation, 1)
    var index = 0

    while index < owner.syntax.childCountAt(node)
      let caseNode = owner.syntax.childAt(node, index)
      let caseName = owner.syntax.dataAt(caseNode)

      if owner.syntax.childCountAt(caseNode) != 1
        owner.report("NR283", caseNode, "A propagation case must have exactly one payload.") if report
        return [-1, -1]
      end
      result[0] = index if caseName == successName
      result[1] = index if caseName == failureName
      index = index + 1
    end
    if successName == failureName || result[0] < 0 || result[1] < 0
      owner.report("NR283", annotation, "Propagation case names must identify distinct enum cases.") if report
      return [-1, -1]
    end
  end
  return result
end

def configurePropagation(owner: BootstrapBinder, symbol: SemanticClass): Void
  let cases = propagationCases(owner, symbol.syntaxNode, symbol.genericOrigin < 0)

  symbol.propagationSuccessCase = cases[0]
  symbol.propagationFailureCase = cases[1]
end

def propagationPayloadType(symbol: SemanticClass, caseIndex: Int): String
  let fieldName = alternativePayloadField(caseIndex, 0)
  var field = symbol.firstField

  while field != null
    if field.name == fieldName
      return field.typeName
    end
    field = field.nextField
  end
  return "Error"
end
