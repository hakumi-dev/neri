class SemanticLocal
  public identity: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public mutable: Bool = false
  public depth: Int = 0
  public active: Bool = true
  public syntaxNode: Int = -1
  public resourceMove: readonly ResourceMoveState
  public resourceScoped: Bool = false
  public nextLocal: SemanticLocal?

  def init(identity: String, name: String, typeName: String, mutable: Bool, depth: Int, syntaxNode: Int, resourceMove: readonly ResourceMoveState): Void
    this.identity = identity
    this.name = name
    this.typeName = typeName
    this.mutable = mutable
    this.depth = depth
    this.syntaxNode = syntaxNode
    this.resourceMove = resourceMove
  end
end
