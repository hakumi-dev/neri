# The binder and editor share inheritance lookup and its visibility boundary.
def semanticFindBaseMethod(model: SemanticModel, owner: SemanticClass, name: String): SemanticCallable?
  var current = model.findClass(owner.baseName)
  var steps = 0

  while current != null && steps < 256
    var method = current.firstMethod

    while method != null
      if method.name == name && method.name != "init" && method.access != "private"
        return method
      end
      method = method.nextCallable
    end
    current = model.findClass(current.baseName)
    steps = steps + 1
  end
  return null
end

def semanticOverrideCandidates(model: SemanticModel, owner: SemanticClass, prefix: String): SemanticCompletionList
  let result = new SemanticCompletionList()
  var current = model.findClass(owner.baseName)
  var steps = 0

  while current != null && steps < 256 && !result.truncated
    var method = current.firstMethod

    while method != null && !result.truncated
      var declared = owner.firstMethod
      var implemented = false

      while declared != null
        implemented = true if declared.name == method.name
        declared = declared.nextCallable
      end
      let inherited = semanticFindBaseMethod(model, owner, method.name)

      if !implemented && inherited != null && inherited.fullName == method.fullName && !method.isStatic
        semanticCompletionAdd(result, prefix, method.name, method.name, 2, semanticCompletionCallableDetail(method), method.fullName)
      end
      method = method.nextCallable
    end
    current = model.findClass(current.baseName)
    steps = steps + 1
  end
  return result
end
