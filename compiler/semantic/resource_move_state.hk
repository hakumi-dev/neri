sealed class ResourceMoveState
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def available(): ResourceMoveState
    return new ResourceMoveState(0)
  end

  static def maybeMoved(): ResourceMoveState
    return new ResourceMoveState(1)
  end

  static def moved(): ResourceMoveState
    return new ResourceMoveState(2)
  end

  readonly def isAvailable(): Bool
    return this.tag == 0
  end

  readonly def isMoved(): Bool
    return this.tag == 2
  end
end
