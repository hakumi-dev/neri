use host

# Length-prefixed components keep nested signatures unambiguous. The final
# delimiter prevents result suffixes from becoming suffixes of the signature.
def semanticCFunctionType(components: StringBuffer): String
  var result = "cabi|" + (components.size as String) + "|"
  var component = components.first.nextNode

  while component != null
    result = result + (host::stringByteLength(component.value) as String) + ":" + component.value
    component = component.nextNode
  end
  return result + "|"
end

def semanticIsCFunction(typeName: String): Bool
  return bootstrapStartsWith(typeName, "cabi|") && semanticEndsWith(typeName, "|")
end

def semanticCFunctionComponents(typeName: String): StringBuffer
  let result = new StringBuffer()

  if !semanticIsCFunction(typeName)
    return result
  end
  var cursor = 5
  let length = host::stringByteLength(typeName)
  var count = 0

  while cursor < length && host::stringByteAt(typeName, cursor) != (124 as Byte)
    let digit = (host::stringByteAt(typeName, cursor) as Int) - 48

    if digit < 0 || digit > 9 || count > length
      return result
    end
    count = count * 10 + digit
    cursor = cursor + 1
  end
  if count == 0 || count > length
    return result
  end
  cursor = cursor + 1
  var index = 0

  while index < count && cursor < length - 1
    var size = 0

    while cursor < length && host::stringByteAt(typeName, cursor) != (58 as Byte)
      let digit = (host::stringByteAt(typeName, cursor) as Int) - 48

      if digit < 0 || digit > 9 || size > length
        return new StringBuffer()
      end
      size = size * 10 + digit
      cursor = cursor + 1
    end
    cursor = cursor + 1
    if size <= 0 || size > length - cursor - 1
      return new StringBuffer()
    end
    result.add(host::stringSlice(typeName, cursor, size))
    cursor = cursor + size
    index = index + 1
  end
  if index != count || cursor != length - 1
    return new StringBuffer()
  end
  return result
end

def semanticCAbiType(typeName: String, allowVoid: Bool): Bool
  if semanticIsNumeric(typeName) || typeName == "Bool" || (allowVoid && typeName == "Void")
    return true
  end
  if semanticIsPointer(typeName)
    let inner = semanticInnerType(typeName)

    return semanticCAbiPointerElement(inner)
  end
  if semanticIsOptional(typeName)
    let inner = semanticInnerType(typeName)

    return (semanticIsPointer(inner) || semanticIsCFunction(inner)) && semanticCAbiType(inner, false)
  end
  if semanticIsCFunction(typeName)
    let components = semanticCFunctionComponents(typeName)

    if components.size == 0 || !semanticCAbiType(components.get(0), true)
      return false
    end
    var index = 1

    while index < components.size
      if !semanticCAbiType(components.get(index), false)
        return false
      end
      index = index + 1
    end
    return true
  end
  return false
end

def semanticCAbiPointerElement(typeName: String): Bool
  if nativeFixedArray(typeName)
    return nativeArrayCount(typeName) > 0 && semanticCAbiPointerElement(nativeArrayInner(typeName))
  end
  return typeName == "Void" || nativeValueType(typeName) || semanticCAbiType(typeName, false)
end

def semanticCFunctionDisplay(typeName: String): String
  if semanticIsOptional(typeName) || semanticIsPointer(typeName) || semanticIsArray(typeName)
    let inner = semanticInnerType(typeName)
    let suffix = semanticIsArray(typeName) ? "[]" : (semanticIsOptional(typeName) ? "?" : "*")
    let display = semanticCFunctionDisplay(inner)

    return (semanticIsCFunction(inner) ? "(" + display + ")" : display) + suffix
  end
  if nativeFixedArray(typeName)
    return semanticCFunctionDisplay(nativeArrayInner(typeName)) + "[" + (nativeArrayCount(typeName) as String) + "]"
  end
  if !semanticIsCFunction(typeName)
    return typeName
  end
  let components = semanticCFunctionComponents(typeName)

  if components.size == 0
    return "<invalid C function signature>"
  end
  var result = "cabi fn("
  var index = 1

  while index < components.size
    result = result + ", " if index > 1
    result = result + semanticCFunctionDisplay(components.get(index))
    index = index + 1
  end
  return result + "): " + semanticCFunctionDisplay(components.get(0))
end

def semanticCFunctionSignature(callable: SemanticCallable): String
  let components = new StringBuffer()

  components.add(callable.returnType)
  var parameter = callable.firstParameter

  while parameter != null
    components.add(parameter.typeName)
    parameter = parameter.nextParameter
  end
  return semanticCFunctionType(components)
end

def semanticPortableCSymbol(name: String): Bool
  if name == ""
    return false
  end
  var index = 0

  while index < host::stringByteLength(name)
    let byte = host::stringByteAt(name, index) as Int
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95

    if !letter && (index == 0 || byte < 48 || byte > 57)
      return false
    end
    index = index + 1
  end
  return true
end

def semanticValidateCDeclarations(owner: BootstrapBinder): Void
  let declarations = new StringTable<SemanticCallable>()
  var function = owner.model.firstFunction

  while function != null
    if function.cAbiSymbol == "neri_rt_v1_foreign_enter" || function.cAbiSymbol == "neri_rt_v1_foreign_leave"
      owner.report("NR280", function.syntaxNode, "Foreign entry runtime symbols are controlled by the compiler and cannot be imported with '@cabiImport'.")
    end
    if function.cExportSymbol != ""
      let name = function.cExportSymbol

      if name == "main" || bootstrapStartsWith(name, "neri_") || bootstrapStartsWith(name, "hk1_") || bootstrapStartsWith(name, "__")
        owner.report("NR280", function.syntaxNode, "C export symbol '" + name + "' is reserved.")
      end
    end
    let name = function.cExportSymbol != "" ? function.cExportSymbol : function.cAbiSymbol

    if name != ""
      let previous = declarations.find(name)

      if previous != null && (function.cExportSymbol != "" || previous.value.cExportSymbol != "")
        owner.report("NR280", function.syntaxNode, "C export symbol '" + name + "' conflicts with another C declaration.")
      else if previous == null
        declarations.add(name, function)
      end
    end
    function = function.nextCallable
  end
end
