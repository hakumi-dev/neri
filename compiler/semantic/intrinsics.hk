use host

class SemanticNativeIntrinsic
  public name: String
  public linkName: String
  public resultType: String
  public parameterTypes: String[]
  public effects: Int
  public minimumMinor: Int
  public runtimeFeatures: Int
  public legacyName: String = ""
  public parallelSafe: Bool = true
  public next: SemanticNativeIntrinsic?

  def init(name: String, linkName: String, resultType: String, parameterTypes: String[], effects: Int, minimumMinor: Int, runtimeFeatures: Int, legacyName: String = "", parallelSafe: Bool = true): Void
    this.name = name
    this.linkName = linkName
    this.resultType = resultType
    this.parameterTypes = parameterTypes
    this.effects = effects
    this.minimumMinor = minimumMinor
    this.runtimeFeatures = runtimeFeatures
    this.legacyName = legacyName
    this.parallelSafe = parallelSafe
  end
end

class SemanticIntrinsicRegistry
  public members: SemanticIntrinsicMember[] = [new SemanticIntrinsicMember("array.length", "Array", "Length", "Int", 35, 1)]
  public first: SemanticNativeIntrinsic?
  public last: SemanticNativeIntrinsic?

  def init(): Void
    this.add(new SemanticNativeIntrinsic("string.concat", "neri_rt_v1_string_concat", "String", ["String", "String"], 44, 2, 0))
    this.add(new SemanticNativeIntrinsic("string.equal", "neri_rt_v1_string_equal", "Bool", ["String", "String"], 1, 2, 0))
    this.add(new SemanticNativeIntrinsic("string.byteLength", "neri_rt_v1_host_string_byte_length", "Int", ["String"], 4, 6, 2048, "host.stringByteLength"))
    this.add(new SemanticNativeIntrinsic("string.byteAt", "neri_rt_v1_host_string_byte_at", "Byte", ["String", "Int"], 4, 6, 2048, "host.stringByteAt"))
    this.add(new SemanticNativeIntrinsic("string.slice", "neri_rt_v1_host_string_slice", "String", ["String", "Int", "Int"], 44, 6, 2048, "host.stringSlice"))
    this.add(new SemanticNativeIntrinsic("string.fromBytes", "neri_rt_v1_host_string_from_bytes", "String?", ["Byte[]"], 44, 6, 2048, "host.stringFromBytes"))

    this.add(new SemanticNativeIntrinsic("stdio.write", "neri_rt_v1_stdout_write", "Void", ["String"], 6, 3, 128, "console.print", false))
    this.add(new SemanticNativeIntrinsic("stdio.writeLine", "neri_rt_v1_stdout_write_line", "Void", ["String"], 6, 3, 128, "console.println", false))
    this.add(new SemanticNativeIntrinsic("stdio.read", "neri_rt_v1_stdin_read_line", "String", [], 45, 4, 192, "console.read", false))
    this.add(new SemanticNativeIntrinsic("stdio.readLine", "neri_rt_v1_stdin_read_line_optional", "String?", [], 45, 21, 33554432, "console.readLine", false))

    this.add(new SemanticNativeIntrinsic("integer.abs", "neri_rt_v1_math_abs", "Int", ["Int"], 4, 4, 0, "math.abs"))
    this.add(new SemanticNativeIntrinsic("integer.max", "neri_rt_v1_math_max", "Int", ["Int", "Int"], 0, 4, 0, "math.max"))
    this.add(new SemanticNativeIntrinsic("integer.min", "neri_rt_v1_math_min", "Int", ["Int", "Int"], 0, 4, 0, "math.min"))
    this.add(new SemanticNativeIntrinsic("integer.pow", "neri_rt_v1_math_pow", "Int", ["Int", "Int"], 4, 4, 0, "math.pow"))

    this.add(new SemanticNativeIntrinsic("assertion.require", "neri_rt_v1_test_assert", "Void", ["Bool"], 4, 4, 0, "test.assert"))
    this.add(new SemanticNativeIntrinsic("assertion.true", "neri_rt_v1_test_assert_true", "Void", ["Bool"], 4, 4, 0, "test.assertTrue"))
    this.add(new SemanticNativeIntrinsic("assertion.false", "neri_rt_v1_test_assert_false", "Void", ["Bool"], 4, 4, 0, "test.assertFalse"))
    this.add(new SemanticNativeIntrinsic("assertion.equal", "", "Void", ["T", "T"], 4, 4, 0, "test.assertEqual"))

    this.add(new SemanticNativeIntrinsic("host.exit", "neri_rt_v1_host_exit", "Void", ["Int"], 6, 6, 2048, "host.exit", false))
    this.add(new SemanticNativeIntrinsic("host.argumentCount", "neri_rt_v1_host_argument_count", "Int", [], 1, 6, 2048, "host.argumentCount", false))
    this.add(new SemanticNativeIntrinsic("host.errorMessage", "neri_rt_v1_host_error_message", "String", [], 45, 6, 2048, "host.errorMessage", false))
    this.add(new SemanticNativeIntrinsic("host.readText", "neri_rt_v1_host_read_text", "String?", ["String"], 45, 6, 2048, "host.readText", false))
    this.add(new SemanticNativeIntrinsic("host.pathJoin", "neri_rt_v1_host_path_join", "String?", ["String", "String"], 44, 6, 2048, "host.pathJoin", false))
    this.add(new SemanticNativeIntrinsic("host.pathAbsolute", "neri_rt_v1_host_path_absolute", "String?", ["String"], 45, 6, 2048, "host.pathAbsolute", false))
    this.add(new SemanticNativeIntrinsic("host.pathFileName", "neri_rt_v1_host_path_file_name", "String?", ["String"], 44, 6, 2048, "host.pathFileName", false))
    this.add(new SemanticNativeIntrinsic("host.argumentAt", "neri_rt_v1_host_argument_at", "String?", ["Int"], 45, 6, 2048, "host.argumentAt", false))
    this.add(new SemanticNativeIntrinsic("host.environment", "neri_rt_v1_host_environment", "String?", ["String"], 45, 6, 2048, "host.environment", false))
    this.add(new SemanticNativeIntrinsic("host.parseInt", "neri_rt_v1_host_parse_int", "Int?", ["String"], 4, 6, 2048, "host.parseInt", false))
    this.add(new SemanticNativeIntrinsic("host.parseFloat", "neri_rt_v1_host_parse_float", "Float?", ["String"], 4, 6, 2048, "host.parseFloat", false))
    this.add(new SemanticNativeIntrinsic("host.run", "neri_rt_v1_host_run", "Int?", ["String", "String[]"], 7, 6, 2048, "host.run", false))
    this.add(new SemanticNativeIntrinsic("host.appendByte", "neri_rt_v1_host_append_byte", "Byte[]", ["Byte[]", "Byte"], 44, 6, 2048, "host.appendByte", false))
    this.add(new SemanticNativeIntrinsic("host.appendInt", "neri_rt_v1_host_append_int", "Int[]", ["Int[]", "Int"], 44, 6, 2048, "host.appendInt", false))
    this.add(new SemanticNativeIntrinsic("host.appendString", "neri_rt_v1_host_append_string", "String[]", ["String[]", "String"], 44, 6, 2048, "host.appendString", false))
    this.add(new SemanticNativeIntrinsic("host.writeText", "neri_rt_v1_host_write_text", "Bool", ["String", "String"], 6, 6, 2048, "host.writeText", false))
    this.add(new SemanticNativeIntrinsic("host.writeBytes", "neri_rt_v1_host_write_bytes", "Bool", ["String", "Byte[]"], 6, 6, 2048, "host.writeBytes", false))
    this.add(new SemanticNativeIntrinsic("host.removeFile", "neri_rt_v1_host_remove_file", "Bool", ["String"], 6, 6, 2048, "host.removeFile", false))
  end

  def add(value: SemanticNativeIntrinsic): Void
    if this.first == null
      this.first = value
    else
      let last = this.last

      if last != null
        last.next = value
      end
    end
    this.last = value
  end

  def find(name: String): SemanticNativeIntrinsic?
    var current = this.first

    while current != null
      if current.name == name
        return current
      end
      current = current.next
    end
    return null
  end

  def findLegacy(fullName: String): SemanticNativeIntrinsic?
    var current = this.first

    while current != null
      if current.legacyName == fullName
        return current
      end
      current = current.next
    end
    return null
  end

  def libraryNames(): String[]
    var names: String[] = []
    var current = this.first

    while current != null
      let separator = semanticFindByte(current.legacyName, 46)

      if separator > 0
        let library = host.stringSlice(current.legacyName, 0, separator)
        var known = false

        for existing in names
          known = true if existing == library
        end
        names = host.appendString(names, library) if !known
      end
      current = current.next
    end
    return names
  end

  def memberNames(library: String): String[]
    var names: String[] = []
    var current = this.first
    let prefix = library + "."

    while current != null
      if bootstrapStartsWith(current.legacyName, prefix)
        names = host.appendString(names, host.stringSlice(current.legacyName, host.stringByteLength(prefix), host.stringByteLength(current.legacyName) - host.stringByteLength(prefix)))
      end
      current = current.next
    end
    return names
  end
end

def semanticIntrinsic(model: SemanticModel, name: String): SemanticNativeIntrinsic?
  let registry = model.intrinsics

  if registry == null
    return null
  end
  return registry.find(name)
end

def semanticLegacyIntrinsic(model: SemanticModel, fullName: String): SemanticNativeIntrinsic?
  let registry = model.intrinsics

  if registry == null
    return null
  end
  return registry.findLegacy(fullName)
end

def semanticBuiltinLibraries(model: SemanticModel): String[]
  let registry = model.intrinsics
  var names: String[] = []

  if registry != null
    names = registry.libraryNames()
  end
  # Array and tasks are language facilities with no native member contract.
  names = host.appendString(names, "tasks")
  names = host.appendString(names, "Array")
  return names
end

def semanticRepresentationType(name: String): String
  return name == "utf8" ? "String" : ""
end
