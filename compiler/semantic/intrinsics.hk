class SemanticNativeIntrinsic
  public name: String
  public linkName: String
  public resultType: String
  public parameterTypes: String[]
  public effects: Int
  public minimumMinor: Int
  public runtimeFeatures: Int

  def init(name: String, linkName: String, resultType: String, parameterTypes: String[], effects: Int, minimumMinor: Int, runtimeFeatures: Int): Void
    this.name = name
    this.linkName = linkName
    this.resultType = resultType
    this.parameterTypes = parameterTypes
    this.effects = effects
    this.minimumMinor = minimumMinor
    this.runtimeFeatures = runtimeFeatures
  end
end

def semanticIntrinsic(name: String): SemanticNativeIntrinsic?
  if name == "string.concat"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_string_concat", "String", ["String", "String"], 44, 2, 0)
  else if name == "string.equal"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_string_equal", "Bool", ["String", "String"], 1, 2, 0)
  else if name == "string.byteLength"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_host_string_byte_length", "Int", ["String"], 4, 6, 2048)
  else if name == "string.byteAt"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_host_string_byte_at", "Byte", ["String", "Int"], 4, 6, 2048)
  else if name == "string.slice"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_host_string_slice", "String", ["String", "Int", "Int"], 44, 6, 2048)
  else if name == "string.fromBytes"
    return new SemanticNativeIntrinsic(name, "neri_rt_v1_host_string_from_bytes", "String?", ["Byte[]"], 44, 6, 2048)
  end
  return null
end

def semanticRepresentationType(name: String): String
  return name == "utf8" ? "String" : ""
end
