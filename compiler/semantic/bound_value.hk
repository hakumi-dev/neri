class BoundValue
  public typeName: String = "Error"
  public boundNode: Int = -1
  # An affine value remembers the local that owns it while it is being bound.
  # This is deliberately semantic data, rather than a syntax-kind check: a
  # parenthesized name reaches the same value as the name itself.
  public resourceIdentity: String = ""

  def init(typeName: String, boundNode: Int, resourceIdentity: String = ""): Void
    this.typeName = typeName
    this.boundNode = boundNode
    this.resourceIdentity = resourceIdentity
  end
end
