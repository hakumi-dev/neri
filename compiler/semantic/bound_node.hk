class BoundNode
  public kind: readonly BoundKind
  public typeName: String = ""
  public data: String = ""
  public value: String = ""
  public symbol: String = ""
  public start: Int = 0
  public length: Int = 1
  public children: Int[] = [0]
  public nextNode: BoundNode?
  public previousNode: BoundNode?

  def init(kind: readonly BoundKind, typeName: String, data: String, start: Int, length: Int, children: Int[]): Void
    this.kind = kind
    this.typeName = typeName
    this.data = data
    this.start = start
    this.length = length
    this.children = children
  end
end
