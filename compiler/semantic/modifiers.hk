def semanticDeclarationModifierAllowed(modifier: readonly ModifierKind, kind: readonly SyntaxKind, alternative: Bool = false): Bool
  if kind.isFunction()
    return modifier.isUnsafe()
  else if kind.isClass()
    return syntaxModifierRank(modifier) == 1 || modifier.isAbstract() || modifier.isSealed() || (modifier.isResource() && !alternative)
  end
  return !modifier.isSealed() && !modifier.isResource()
end

def semanticValidateModuleModifiers(owner: BootstrapBinder, node: Int): Void
  for modifier in owner.syntax.nodeAt(node).modifiers
    let kind = owner.syntax.nodeAt(modifier).modifierKind

    if kind == null
      owner.report("NR_INTERNAL_SYNTAX", modifier, "Internal compiler structural failure: modifier metadata is missing.")
      continue
    end

    if kind.isStatic()
      owner.report("NR170", modifier, "Modifier 'static' is valid only on methods declared inside a class.")
    else if !semanticDeclarationModifierAllowed(kind, owner.syntax.kinds.getFunction())
      owner.report("NR172", modifier, "Modifier '" + kind.name() + "' is not supported on a module function.")
    end
  end
end

def semanticValidateClassModifiers(owner: BootstrapBinder, node: Int): Void
  let declaration = semanticDeclaration(owner, node)

  if declaration == null
    return
  end
  for modifier in owner.syntax.nodeAt(node).modifiers
    let kind = owner.syntax.nodeAt(modifier).modifierKind

    if kind == null
      owner.report("NR_INTERNAL_SYNTAX", modifier, "Internal compiler structural failure: modifier metadata is missing.")
      continue
    end

    if !semanticDeclarationModifierAllowed(kind, owner.syntax.kinds.getClass(), declaration.isAlternative)
      owner.report("NR172", modifier, "Modifier '" + kind.name() + "' is not supported on this type declaration.")
    end
  end
end

def semanticValidateMethodModifiers(owner: BootstrapBinder, node: Int): Void
  for modifier in owner.syntax.nodeAt(node).modifiers
    let kind = owner.syntax.nodeAt(modifier).modifierKind

    if kind == null
      owner.report("NR_INTERNAL_SYNTAX", modifier, "Internal compiler structural failure: modifier metadata is missing.")
      continue
    end

    if !semanticDeclarationModifierAllowed(kind, owner.syntax.kinds.getMethod())
      owner.report("NR172", modifier, "Modifier '" + kind.name() + "' is not supported on a method.")
    end
  end
end
