def semanticDeclarationModifierAllowed(name: String, kind: String): Bool
  if kind == "Function"
    return name == "unsafe"
  else if kind == "Class" || kind == "Enum"
    return syntaxModifierRank(name) == 1 || name == "abstract" || name == "sealed" || (name == "resource" && kind == "Class")
  end
  return name != "sealed" && name != "resource"
end

def semanticValidateModuleModifiers(owner: BootstrapBinder, node: Int): Void
  for modifier in owner.syntax.nodeAt(node).modifiers
    let name = owner.syntax.dataAt(modifier)

    if name == "static"
      owner.report("NR170", modifier, "Modifier 'static' is valid only on methods declared inside a class.")
    else if !semanticDeclarationModifierAllowed(name, "Function")
      owner.report("NR172", modifier, "Modifier '" + name + "' is not supported on a module function.")
    end
  end
end

def semanticValidateClassModifiers(owner: BootstrapBinder, node: Int): Void
  for modifier in owner.syntax.nodeAt(node).modifiers
    let name = owner.syntax.dataAt(modifier)
    let alternative = semanticField(owner.syntax.dataAt(node), 4) == "enum"

    if !semanticDeclarationModifierAllowed(name, alternative ? "Enum" : "Class")
      owner.report("NR172", modifier, "Modifier '" + name + "' is not supported on this type declaration.")
    end
  end
end

def semanticValidateMethodModifiers(owner: BootstrapBinder, node: Int): Void
  for modifier in owner.syntax.nodeAt(node).modifiers
    let name = owner.syntax.dataAt(modifier)

    if !semanticDeclarationModifierAllowed(name, "Method")
      owner.report("NR172", modifier, "Modifier '" + name + "' is not supported on a method.")
    end
  end
end
