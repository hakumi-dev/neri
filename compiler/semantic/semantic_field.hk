class SemanticField
  public owner: String = ""
  public name: String = ""
  public typeName: String = "Error"
  public access: readonly SourceAccess
  public syntaxNode: Int = -1
  public boundInitializer: Int = -1
  public nextField: SemanticField?

  def init(owner: String, name: String, typeName: String, access: readonly SourceAccess, syntaxNode: Int): Void
    this.owner = owner
    this.name = name
    this.typeName = typeName
    this.access = access
    this.syntaxNode = syntaxNode
  end
end
