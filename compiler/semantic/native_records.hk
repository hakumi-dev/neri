
def nativeRecordCount(owner: BootstrapBinder): Int
  return semanticIntField(owner.syntax.dataAt(owner.root), 3)
end

def nativeRecordNode(owner: BootstrapBinder, index: Int): Int
  return owner.syntax.childAt(owner.root, owner.useCount() + owner.classCount() + owner.functionCount() + index)
end

def registerNativeRecordNames(owner: BootstrapBinder): Void
  var index = 0

  while index < nativeRecordCount(owner) && owner.checkpoint()
    let node = nativeRecordNode(owner, index)
    let declaration = semanticDeclaration(owner, node)

    if declaration == null
      index = index + 1
      continue
    end
    let namespaceName = declaration.namespaceName
    let shortName = declaration.name
    let name = semanticQualifiedName(namespaceName, shortName)
    var genericCollision = false
    var templateIndex = 0

    while templateIndex < owner.model.genericTemplates.size && owner.checkpoint()
      let template = owner.model.genericTemplates.get(templateIndex)

      if owner.syntax.kindAt(template).isClass() && genericName(owner, template) == name
        genericCollision = true
      end
      templateIndex = templateIndex + 1
    end
    if semanticReservedTypeName(shortName) || owner.model.findClass(name) != null || owner.model.findRecord(name) != null || owner.model.findContract(name) != null || genericCollision
      owner.report("NR230", node, "Native type '" + name + "' is already defined or reserved.")
    else
      let record = new NativeRecord(name, namespaceName, owner.syntax.kindAt(node).isUnion(), node)

      owner.recordDeclaration("record:" + name, shortName, name, node, (record.unionType ? "union " : "struct ") + name)
      let last = owner.model.lastRecord

      if last == null
        owner.model.firstRecord = record
      else
        last.nextRecord = record
      end
      owner.model.lastRecord = record
    end
    index = index + 1
  end
end

def registerNativeRecordFields(owner: BootstrapBinder): Void
  var record = owner.model.firstRecord

  while record != null && owner.checkpoint()
    var index = 0

    while index < owner.syntax.childCountAt(record.syntaxNode) && owner.checkpoint()
      let node = owner.syntax.childAt(record.syntaxNode, index)
      let name = owner.syntax.dataAt(node)
      let typeName = owner.resolveTypeNode(owner.syntax.childAt(node, 0), record.namespaceName, name)

      if record.findField(name) != null
        owner.report("NR230", node, "Duplicate native field '" + name + "'.")
      else
        record.addField(new NativeField(name, typeName, node))
        owner.recordDeclaration("record-field:" + record.name + "." + name, name, typeName, node, record.name + "." + name + ": " + semanticCFunctionDisplay(typeName))
      end
      index = index + 1
    end
    record = record.nextRecord
  end
  record = owner.model.firstRecord
  while record != null && owner.checkpoint()
    layoutNativeRecord(owner, record, 0)
    record = record.nextRecord
  end
end

def nativeRecordType(typeName: String): Bool
  return host::stringByteLength(typeName) >= 7 && host::stringSlice(typeName, 0, 7) == "record|"
end

def nativeFixedArray(typeName: String): Bool
  return semanticEndsWith(typeName, "]") && !semanticEndsWith(typeName, "[]")
end

def nativeArrayStart(typeName: String): Int
  var index = host::stringByteLength(typeName) - 2

  while index > 0
    if host::stringByteAt(typeName, index) == (91 as Byte)
      return index
    end
    index = index - 1
  end
  return 0
end

def nativeArrayInner(typeName: String): String
  return host::stringSlice(typeName, 0, nativeArrayStart(typeName))
end

def nativeArrayCount(typeName: String): Int
  let start = nativeArrayStart(typeName)
  let count = host::parseInt(host::stringSlice(typeName, start + 1, host::stringByteLength(typeName) - start - 2))

  if count != null
    return count
  end
  return 0
end

def nativeRecordName(typeName: String): String
  return host::stringSlice(typeName, 7, host::stringByteLength(typeName) - 7)
end

def nativeValueType(typeName: String): Bool
  return nativeRecordType(typeName) && !semanticIsPointer(typeName) && !semanticIsOptional(typeName) && !semanticIsArray(typeName) && !nativeFixedArray(typeName)
end

def nativeFieldWritable(body: BootstrapBodyBinder, node: Int): Bool
  let kind = body.model().bound.kindAt(node)

  if kind.isNativeField() || kind.isNativeIndex() || kind.isIndex()
    let receiver = body.model().bound.childAt(node, 0)

    if semanticIsPointer(body.model().bound.typeAt(receiver))
      return true
    end
    return nativeFieldWritable(body, receiver)
  end
  if kind.isName()
    let local = body.findLocal(body.model().bound.dataAt(node))

    return local != null && local.mutable
  end
  if kind.isUnary() && body.model().bound.dataAt(node) == "*"
    return true
  end
  return false
end

def bindNativeField(body: BootstrapBodyBinder, node: Int, objectValue: BoundValue, name: String): BoundValue
  var typeName = objectValue.typeName

  if semanticIsPointer(typeName)
    typeName = semanticInnerType(typeName)
  end
  let record = body.model().findRecord(nativeRecordName(typeName))

  if body.unsafeDepth == 0
    body.report("NR192", node, "Native field access requires an unsafe declaration or block.")
  end
  if record != null
    let field = record.findField(name)

    if field != null
      return new BoundValue(field.typeName, body.addBound(body.boundKinds().getNativeField(), field.typeName, record.name + "." + name, node, [objectValue.boundNode]))
    end
  end
  body.report("NR131", node, "Native type '" + typeName + "' has no field '" + name + "'.")
  return new BoundValue("Error", body.addBound(body.boundKinds().getNativeField(), "Error", name, node, [objectValue.boundNode]))
end

def nativeTypeAlignment(owner: BootstrapBinder, typeName: String, node: Int, depth: Int): Int
  if depth >= 128
    owner.report("NR232", node, "Native layout exceeds 128 nested types.")
    return 0
  end
  if semanticIsCFunction(typeName) || (semanticIsOptional(typeName) && semanticIsCFunction(semanticInnerType(typeName)))
    return 8
  end
  if nativeFixedArray(typeName)
    if nativeArrayCount(typeName) < 1 || nativeArrayCount(typeName) > 1073741824
      owner.report("NR231", node, "A fixed native array requires a positive bounded element count.")
      return 0
    end
    return nativeTypeAlignment(owner, nativeArrayInner(typeName), node, depth + 1)
  end
  if semanticIsPointer(typeName) || (semanticIsOptional(typeName) && semanticIsPointer(semanticInnerType(typeName)))
    var element = typeName

    while semanticIsPointer(element) || semanticIsOptional(element)
      element = semanticInnerType(element)
    end
    if !semanticIsNumeric(element) && element != "Bool" && element != "Void" && !nativeRecordType(element) && !semanticIsCFunction(element)
      owner.report("NR231", node, "Native fields cannot point to managed types.")
      return 0
    end
    return 8
  end
  if typeName == "Bool" || typeName == "Byte"
    return 1
  end
  if typeName == "Int32" || typeName == "UInt32" || typeName == "Float32"
    return 4
  end
  if typeName == "Int" || typeName == "UInt64" || typeName == "Float"
    return 8
  end
  if nativeRecordType(typeName)
    let record = owner.model.findRecord(nativeRecordName(typeName))

    if record != null
      if layoutNativeRecord(owner, record, depth + 1)
        return record.alignment
      end
      return 0
    end
  end
  owner.report("NR231", node, "Type '" + typeName + "' has no C-compatible inline layout.")
  return 0
end

def nativeTypeSize(owner: BootstrapBinder, typeName: String, node: Int, depth: Int): Int
  let alignment = nativeTypeAlignment(owner, typeName, node, depth)

  if alignment == 0
    return 0
  end
  if nativeFixedArray(typeName)
    let count = nativeArrayCount(typeName)
    let size = nativeTypeSize(owner, nativeArrayInner(typeName), node, depth + 1)

    if size > 1073741824 / count
      owner.report("NR231", node, "Native array layout exceeds one GiB.")
      return 0
    end
    return size * count
  end
  if nativeRecordType(typeName) && !semanticIsPointer(typeName) && !semanticIsOptional(typeName)
    let record = owner.model.findRecord(nativeRecordName(typeName))

    if record != null
      return record.size
    end
  end
  return alignment
end

def nativeAlign(value: Int, alignment: Int): Int
  return ((value + alignment - 1) / alignment) * alignment
end

def layoutNativeRecord(owner: BootstrapBinder, record: NativeRecord, depth: Int): Bool
  if !owner.checkpoint()
    return false
  end
  if record.layoutComplete()
    return true
  end
  if record.layoutFailed()
    return false
  end
  if record.layoutInProgress() || depth >= 128
    owner.report("NR232", record.syntaxNode, "Native layout is recursive by value or exceeds 128 nested types.")
    record.failLayout()
    return false
  end
  record.beginLayout()
  if record.firstField == null
    owner.report("NR231", record.syntaxNode, "A native struct or union requires at least one field.")
    record.failLayout()
    return false
  end
  var field: NativeField? = record.firstField

  while field != null
    if !owner.checkpoint()
      return false
    end
    let alignment = nativeTypeAlignment(owner, field.typeName, field.syntaxNode, depth)
    let size = nativeTypeSize(owner, field.typeName, field.syntaxNode, depth)

    if alignment == 0 || size == 0 || size > 1073741824
      if size > 0
        owner.report("NR231", field.syntaxNode, "Native layout exceeds one GiB.")
      end
      record.failLayout()
      return false
    end
    if alignment > record.alignment
      record.alignment = alignment
    end
    if record.unionType
      field.offset = 0
      if size > record.size
        record.size = size
      end
    else
      field.offset = nativeAlign(record.size, alignment)
      record.size = field.offset + size
    end
    field = field.nextField
  end
  record.size = nativeAlign(record.size, record.alignment)
  if record.size > 1073741824
    owner.report("NR231", record.syntaxNode, "Native layout exceeds one GiB.")
    record.failLayout()
    return false
  end
  record.finishLayout()
  return true
end

def bindNativeLayout(body: BootstrapBodyBinder, node: Int, operation: String, typeName: String, offset: Int): BoundValue
  var value = 0
  let count = body.syntax().childCountAt(node) - offset

  if typeName == "" || (operation == "offsetOf" ? count != 1 : count != 0)
    body.report("NR233", node, "Native layout query requires one type argument and offsetOf requires one field-name string.")
  else if operation == "sizeOf"
    value = nativeTypeSize(body.owner, typeName, node, 0)
  else if operation == "alignOf"
    value = nativeTypeAlignment(body.owner, typeName, node, 0)
  else
    let argument = body.syntax().childAt(node, offset)
    var record: NativeRecord? = null

    if nativeRecordType(typeName)
      record = body.model().findRecord(nativeRecordName(typeName))
    end
    if record == null || !body.syntax().kindAt(argument).isStringLiteral()
      body.report("NR233", node, "offsetOf requires a native record and a literal field name.")
    else
      let raw = body.syntax().dataAt(argument)
      let name = host::stringSlice(raw, 1, host::stringByteLength(raw) - 2)
      let field = record.findField(name)

      if field == null
        body.report("NR233", argument, "Unknown native field '" + name + "'.")
      else
        value = field.offset
      end
    end
  end
  return new BoundValue("Int", body.addBoundValue(body.boundKinds().getIntLiteral(), "Int", "", "i:" + (value as String), node, []))
end
