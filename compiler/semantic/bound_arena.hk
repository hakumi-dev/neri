class BoundArena
  public parent: BoundArena?
  private baseCount: Int = 0
  public kinds: BoundKindCatalog
  public first: BoundNode
  public last: BoundNode
  public cached: BoundNode?
  public cachedIndex: Int = -1
  public size: Int = 0
  private checkpoints: ArenaCheckpointIndex<BoundNode>

  def init(parent: BoundArena? = null): Void
    this.parent = parent
    if parent != null
      this.baseCount = parent.count()
      this.kinds = parent.kinds
    else
      this.kinds = new BoundKindCatalog()
    end
    this.first = new BoundNode(this.kinds.getInvalid(), "", "", 0, 1, [0])
    this.last = this.first
    this.cached = this.first
    this.checkpoints = new ArenaCheckpointIndex<BoundNode>(this.first)
  end

  def add(kind: readonly BoundKind, typeName: String, nodeData: String, start: Int, length: Int, nodeChildren: Int[]): Int
    let index = this.parentOffset() + this.size
    let node = new BoundNode(kind, typeName, nodeData, start, length, nodeChildren)

    node.previousNode = this.last
    this.last.nextNode = node
    this.last = node
    if (this.size / arenaCheckpointBlockSize()) * arenaCheckpointBlockSize() == this.size
      this.checkpoints.add(node)
    end
    this.size = this.size + 1
    return index
  end

  def count(): Int
    return this.parentOffset() + this.size
  end

  def nodeAt(index: Int): BoundNode
    let offset = this.parentOffset()

    if index < offset
      let parent = this.parent

      if parent != null
        return parent.nodeAt(index)
      end
      return this.first
    end
    let localIndex = index - offset
    var node = this.cached
    var cursor = this.cachedIndex
    let blockSize = arenaCheckpointBlockSize()
    let checkpointIndex = (localIndex / blockSize) * blockSize

    if node == null
      node = this.checkpoints.get(localIndex / blockSize)
      cursor = checkpointIndex
    else
      let distance = localIndex < cursor ? cursor - localIndex : localIndex - cursor

      if distance > 1 && distance > localIndex - checkpointIndex
        node = this.checkpoints.get(localIndex / blockSize)
        cursor = checkpointIndex
      end
    end
    while cursor > localIndex
      if node != null
        node = node.previousNode
      end
      cursor = cursor - 1
    end
    while cursor < localIndex
      if node != null
        node = node.nextNode
      end
      cursor = cursor + 1
    end
    this.cached = node
    this.cachedIndex = cursor
    if node != null
      return node
    end
    return this.first
  end

  private def parentOffset(): Int
    return this.baseCount
  end

  def childAt(index: Int, offset: Int): Int
    return this.nodeAt(index).children[offset]
  end

  def kindAt(index: Int): readonly BoundKind
    return this.nodeAt(index).kind
  end

  def typeAt(index: Int): String
    return this.nodeAt(index).typeName
  end

  def dataAt(index: Int): String
    return this.nodeAt(index).data
  end

  def valueAt(index: Int): String
    return this.nodeAt(index).value
  end

  def symbolAt(index: Int): String
    return this.nodeAt(index).symbol
  end

  def setValue(index: Int, value: String): Void
    this.nodeAt(index).value = value
  end

  def setSymbol(index: Int, symbol: String): Void
    this.nodeAt(index).symbol = symbol
  end

  def childCountAt(index: Int): Int
    return this.nodeAt(index).children.Length
  end

  def startAt(index: Int): Int
    return this.nodeAt(index).start
  end

  def lengthAt(index: Int): Int
    return this.nodeAt(index).length
  end
end
