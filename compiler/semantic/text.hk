use host

def semanticField(value: String, wanted: Int): String
  var start = 0
  var field = 0
  var index = 0
  let length = host.stringByteLength(value)
  while index <= length
    let atEnd = index == length
    var separator = false
    if !atEnd
      separator = (host.stringByteAt(value, index) as Int) == 124
    end
    if atEnd || separator
      if field == wanted
        return host.stringSlice(value, start, index - start)
      end
      field = field + 1
      start = index + 1
    end
    index = index + 1
  end
  return ""
end

def semanticIntField(value: String, wanted: Int): Int
  let parsed = host.parseInt(semanticField(value, wanted))
  if parsed != null
    return parsed
  end
  return 0
end

def semanticBoolField(value: String, wanted: Int): Bool
  return semanticField(value, wanted) == "true"
end

def semanticQualifiedName(namespaceName: String, name: String): String
  if namespaceName == ""
    return name
  end
  return namespaceName + "." + name
end

def semanticEndsWith(value: String, suffix: String): Bool
  let valueLength = host.stringByteLength(value)
  let suffixLength = host.stringByteLength(suffix)
  if suffixLength > valueLength
    return false
  end
  return host.stringSlice(value, valueLength - suffixLength, suffixLength) == suffix
end

def semanticStripSuffix(value: String, suffix: String): String
  return host.stringSlice(value, 0, host.stringByteLength(value) - host.stringByteLength(suffix))
end

def semanticJoin(left: String, separator: String, right: String): String
  if left == ""
    return right
  end
  return left + separator + right
end

def semanticContainsByte(value: String, byte: Int): Bool
  return semanticFindByte(value, byte) >= 0
end

def semanticFindByte(value: String, byte: Int): Int
  var index = 0
  while index < host.stringByteLength(value)
    if (host.stringByteAt(value, index) as Int) == byte
      return index
    end
    index = index + 1
  end
  return -1
end
