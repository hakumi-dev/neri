use host

class GenericInference
  public owner: BootstrapBinder = new BootstrapBinder(new SyntaxArena(), -1, 0)
  public names: String[] = []
  public arguments: StringBuffer = new StringBuffer()

  def init(owner: BootstrapBinder, names: String[]): Void
    this.owner = owner
    this.names = names
    for name in names
      this.arguments.add("")
    end
  end

  def unresolved(node: Int): Bool
    let source = this.owner.syntax.nodeAt(node)
    var index = 0

    while index < this.names.Length
      if genericBase(source.data) == this.names[index] && this.arguments.get(index) == ""
        return true
      end
      index = index + 1
    end
    for child in source.children
      if this.owner.syntax.kindAt(child).isType() && this.unresolved(child)
        return true
      end
    end
    for argument in source.typeArguments
      if this.unresolved(argument)
        return true
      end
    end
    return false
  end

  def inferClosure(pattern: Int, node: Int, namespaceName: String): Void
    let signature = this.owner.syntax.nodeAt(pattern)
    let closureNode = this.owner.syntax.kindAt(node).isQuoteExpression() ? this.owner.syntax.childAt(node, 0) : node
    let closure = this.owner.syntax.nodeAt(closureNode)

    if signature.data != "fn" && signature.data != "shared fn" && signature.data != "parallel fn" && signature.data != "quote fn"
      return
    end
    let count = semanticIntField(closure.data, 0)

    if signature.children.Length != count + 1
      return
    end
    var index = 0

    while index < count
      let parameter = this.owner.syntax.nodeAt(closure.children[index])

      if parameter.children.Length > 0
        this.infer(signature.children[index], this.owner.resolveTypeNode(parameter.children[0], namespaceName, ""))
      end
      index = index + 1
    end
    let result = closure.children[count]

    if this.owner.syntax.dataAt(result) != ""
      this.infer(signature.children[count], this.owner.resolveTypeNode(result, namespaceName, ""))
    end
  end

  def infer(pattern: Int, actual: String): Void
    if actual == "" || actual == "Null" || actual == "Error"
      return
    end
    let source = this.owner.syntax.nodeAt(pattern)
    var written = source.data
    var value = actual

    while semanticIsArray(written) || semanticIsOptional(written) || semanticIsPointer(written)
      if semanticIsArray(written)
        if !semanticIsArray(value)
          return
        end
        value = semanticInnerType(value)
      else if semanticIsOptional(written)
        if semanticIsOptional(value)
          value = semanticInnerType(value)
        end
      else if semanticIsPointer(written)
        if !semanticIsPointer(value)
          return
        end
        value = semanticInnerType(value)
      end
      written = semanticInnerType(written)
    end
    var index = 0

    while index < this.names.Length
      if written == this.names[index]
        if this.arguments.get(index) == ""
          this.arguments.set(index, value)
        end
        return
      end
      index = index + 1
    end
    if written == "#readonly"
      this.infer(source.children[0], semanticMutableType(value))
      return
    end
    if written == "#group"
      this.infer(source.children[0], value)
      return
    end
    if written == "cabi fn" && semanticIsCFunction(value)
      let components = semanticCFunctionComponents(value)

      if components.size == source.children.Length
        index = 0
        while index < components.size - 1
          this.infer(source.children[index], components.get(index + 1))
          index = index + 1
        end
        this.infer(source.children[index], components.get(0))
      end
      return
    end
    let classSymbol = this.owner.model.findClass(semanticMutableType(value))

    if classSymbol == null
      return
    end
    if written == "#fields" && classSymbol.fieldPackEntityType != ""
      this.infer(source.children[0], classSymbol.fieldPackEntityType)
      return
    end
    let quotation = written == "quote fn" && classSymbol.quotedFunctionType != ""

    if ((written == "fn" || written == "shared fn" || written == "parallel fn") && classSymbol.isFunctionType) || quotation
      var functionClass: SemanticClass? = classSymbol

      if quotation
        functionClass = this.owner.model.findClass(classSymbol.quotedFunctionType)
      end
      var signature: SemanticCallable? = null

      if functionClass != null
        signature = functionClass.firstMethod
      end

      if signature != null && signature.parameterCount + 1 == source.children.Length
        index = 0
        while index < signature.parameterCount
          let parameter = signature.parameterAt(index)

          if parameter != null
            this.infer(source.children[index], parameter.typeName)
          end
          index = index + 1
        end
        this.infer(source.children[index], signature.returnType)
      end
    else if classSymbol.genericOrigin >= 0 && source.typeArguments.Length == classSymbol.genericArguments.Length
      index = 0
      while index < source.typeArguments.Length
        this.infer(source.typeArguments[index], classSymbol.genericArguments[index])
        index = index + 1
      end
    end
  end
end

def genericCalleeName(body: BootstrapBodyBinder, node: Int): String
  let kind = body.syntax().kindAt(node)

  if kind.isName()
    let name = body.syntax().dataAt(node)

    if !closureHasVariable(body, name)
      return name
    end
  end
  return ""
end

def bindGenericExpression(body: BootstrapBodyBinder, node: Int, expectedType: String): BoundValue?
  let owner = body.owner
  let call = owner.syntax.kindAt(node).isCall()
  let callee = call ? owner.syntax.childAt(node, 0) : node
  let name = genericCalleeName(body, callee)
  let explicit = owner.syntax.nodeAt(callee).typeArguments

  if name == ""
    if explicit.Length > 0
      owner.report("NR220", callee, "Type arguments require a generic module function.")
    end
    return null
  end
  let ordinaryName = semanticIsQualifiedName(name) ? owner.model.resolveQualifiedName(name) : semanticQualifiedName(owner.currentNamespace, name)
  let ordinary = owner.model.findFunction(ordinaryName)

  if ordinary != null
    if explicit.Length > 0
      owner.report("NR220", callee, "Function '" + name + "' does not accept type arguments.")
    end
    return null
  end
  let template = findGenericTemplate(owner, name, owner.currentNamespace, owner.syntax.kinds.getFunction())

  if template < 0
    if explicit.Length > 0
      owner.report("NR220", callee, "Function '" + name + "' does not accept type arguments.")
    end
    return null
  end
  let source = owner.syntax.nodeAt(template)
  let names = source.typeParameters
  let inference = new GenericInference(owner, names)
  let arguments = inference.arguments
  var index = 0

  if explicit.Length > 0
    if explicit.Length != names.Length
      owner.report("NR220", callee, "Wrong number of type arguments for '" + name + "'.")
      return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
    end
    index = 0
    while index < explicit.Length
      arguments.set(index, owner.resolveTypeNode(explicit[index], owner.currentNamespace, ""))
      index = index + 1
    end
  end
  let declaration = semanticDeclaration(owner, template)

  if declaration == null
    return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
  end
  let start = declaration.annotationCount
  let count = declaration.parameterCount
  let resultNode = source.children[start + count]

  if call
    inference.infer(resultNode, expectedType)
  else
    let signature = owner.model.findClass(semanticIsOptional(expectedType) ? semanticInnerType(expectedType) : expectedType)

    if signature != null && signature.isFunctionType
      let invoke = signature.firstMethod

      if invoke != null && invoke.parameterCount == count
        inference.infer(resultNode, invoke.returnType)
        index = 0
        while index < count
          let parameter = invoke.parameterAt(index)

          if parameter != null
            inference.infer(owner.syntax.childAt(source.children[start + index], 0), parameter.typeName)
          end
          index = index + 1
        end
      end
    end
  end
  let values = new IntBuffer()
  let types = new StringBuffer()
  let actual = call ? owner.syntax.childCountAt(node) - 1 : 0
  let parameterNames = new StringBuffer()
  let defaultFlags = new IntBuffer()
  var mapping = new SemanticArgumentMap()
  var packParameter = -1

  index = 0
  while index < count
    let parameterNode = source.children[start + index]

    parameterNames.add(owner.syntax.dataAt(parameterNode))
    defaultFlags.add(owner.syntax.childCountAt(parameterNode) > 1 ? 1 : 0)
    packParameter = index if owner.syntax.nodeAt(parameterNode).parameterMode.isLabels()
    index = index + 1
  end
  if call
    mapping = semanticMapArguments(owner, node, 1, parameterNames, defaultFlags, name, true, false, packParameter)
    if mapping.hasNamed || packParameter >= 0
      mapping = semanticMapArguments(owner, node, 1, parameterNames, defaultFlags, name, true, true, packParameter)
    end
  end
  index = 0
  while index < actual
    values.add(-1)
    types.add("")
    index = index + 1
  end
  var pass = 0

  while pass < 2
    index = 0
    while index < actual
      let argumentNode = semanticArgumentExpression(owner.syntax, owner.syntax.childAt(node, index + 1))
      let parameterIndex = mapping.parameterAt(index)
      let kind = owner.syntax.kindAt(argumentNode)
      let genericValue = findGenericTemplate(owner, genericCalleeName(body, argumentNode), owner.currentNamespace, owner.syntax.kinds.getFunction()) >= 0
      let packed = mapping.isPackEntry(index)
      let contextual = kind.isClosure() || kind.isQuoteExpression() || kind.isArrayLiteral() || genericValue || packed

      if values.get(index) < 0 && (pass == 1 || !contextual)
        var expected = ""
        var pattern = -1

        if parameterIndex >= 0 && parameterIndex < count
          pattern = owner.syntax.childAt(source.children[start + parameterIndex], 0)
          if !packed && (kind.isClosure() || kind.isQuoteExpression())
            inference.inferClosure(pattern, argumentNode, owner.currentNamespace)
          end
          if !inference.unresolved(pattern)
            let clone = genericClone(owner, pattern, names, arguments)

            expected = owner.resolveTypeNode(clone, declaration.namespaceName, "")
            if packed
              let sourceArgument = owner.syntax.childAt(node, index + 1)
              let field = fieldPackField(body, expected, semanticArgumentLabel(owner.syntax, sourceArgument), sourceArgument, false)

              expected = ""
              if field != null
                expected = field.typeName
              end
            end
          end
        end
        let value = body.bindExpression(argumentNode, expected)

        values.set(index, value.boundNode)
        types.set(index, value.typeName)
        if pattern >= 0 && !packed
          inference.infer(pattern, value.typeName)
        end
      end
      index = index + 1
    end
    pass = pass + 1
  end
  let callable = instantiateGenericFunction(owner, template, arguments, callee)

  if callable == null
    return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
  end
  if !call
    return bindFunctionValue(body, node, callable, expectedType)
  end
  semanticValidateNamedDefaults(owner, node, callable, mapping)
  owner.recordOccurrence(owner.callableSourceIdentity(callable), callee)
  if !mapping.hasNamed && packParameter < 0
    body.validateCallCount(callable.fullName, callee, actual, callable)
  end
  if callable.isUnsafe && body.unsafeDepth == 0
    owner.report("NR189", callee, "Unsafe generic calls require an unsafe declaration or block.")
  end
  var children: Int[] = []

  index = 0
  while index < actual
    let argumentNode = owner.syntax.childAt(node, index + 1)
    let parameterIndex = mapping.parameterAt(index)
    var value = values.get(index)
    let parameter = callable.parameterAt(parameterIndex)

    if mapping.isPackEntry(index) && parameter != null
      let entry = fieldPackEntry(body, parameter, argumentNode, new BoundValue(types.get(index), value))

      value = body.addBound(body.boundKinds().getFieldPackArgument(), "fields.Entry", parameterIndex as String, argumentNode, [entry])
    else if mapping.hasNamed || packParameter >= 0
      value = body.addBound(body.boundKinds().getArgument(), types.get(index), parameterIndex as String, argumentNode, [value])
    end
    children = host::appendInt(children, value)
    if parameter != null && semanticArgumentLabel(owner.syntax, argumentNode) != "" && !mapping.isPackEntry(index)
      owner.recordOccurrence(parameter.identity, argumentNode, parameter.name + ": " + parameter.typeName)
    end
    if parameter != null && !mapping.isPackEntry(index) && ((callable.exactArguments && parameter.typeName != types.get(index)) || (!callable.exactArguments && !semanticAssignable(owner.model, parameter.typeName, types.get(index))))
      owner.report("NR112", owner.syntax.childAt(node, index + 1), "Generic argument expects '" + parameter.typeName + "', but got '" + types.get(index) + "'.")
    end
    index = index + 1
  end
  body.recordArgumentCompletion(node, 1, callable, mapping)
  children = appendFieldPack(body, callable, node, children)
  return new BoundValue(callable.returnType, body.addBound(body.boundKinds().getCall(), callable.returnType, callable.fullName, callee, children))
end
