use host

def genericSyntaxName(syntax: SyntaxArena, node: Int): String
  let data = syntax.dataAt(node)

  return semanticQualifiedName(semanticField(data, 0), semanticField(data, syntax.kindAt(node) == "Class" ? 2 : 1))
end

def genericName(owner: BootstrapBinder, node: Int): String
  return genericSyntaxName(owner.syntax, node)
end

def referenceGenericUses(owner: BootstrapBinder, node: Int, namespaceName: String): Void
  let data = owner.syntax.dataAt(node)
  let kind = owner.syntax.kindAt(node)

  if kind == "Name"
    owner.model.referenceQualifiedUse(data)
    var useIndex = 0

    while useIndex < owner.model.usedNames.size
      let qualified = semanticQualifiedName(owner.model.usedNames.get(useIndex), data)

      if owner.model.findFunction(qualified) != null
        owner.model.referenceUse(owner.model.usedNames.get(useIndex))
      end
      var genericIndex = 0

      while genericIndex < owner.model.genericTemplates.size
        if genericName(owner, owner.model.genericTemplates.get(genericIndex)) == qualified
          owner.model.referenceUse(owner.model.usedNames.get(useIndex))
        end
        genericIndex = genericIndex + 1
      end
      useIndex = useIndex + 1
    end
  else if kind == "Type"
    owner.model.referenceQualifiedUse(data)
    semanticResolveType(owner.model, data, namespaceName)
    let base = genericBase(data)
    var useIndex = 0

    while useIndex < owner.model.usedNames.size
      let qualified = semanticQualifiedName(owner.model.usedNames.get(useIndex), base)
      var genericIndex = 0

      while genericIndex < owner.model.genericTemplates.size
        let declared = genericName(owner, owner.model.genericTemplates.get(genericIndex))

        if declared == base || declared == qualified
          owner.model.referenceUse(owner.model.usedNames.get(useIndex))
        end
        genericIndex = genericIndex + 1
      end
      useIndex = useIndex + 1
    end
  end
  var index = 0

  while index < owner.syntax.childCountAt(node)
    referenceGenericUses(owner, owner.syntax.childAt(node, index), namespaceName)
    index = index + 1
  end
end

def referenceGenericTemplateUses(owner: BootstrapBinder): Void
  if owner.model.usedNames.size == 0
    return
  end
  var index = 0

  while index < owner.model.genericTemplates.size
    let node = owner.model.genericTemplates.get(index)

    referenceGenericUses(owner, node, semanticField(owner.syntax.dataAt(node), 0))
    index = index + 1
  end
end

def alternativeCaseCount(owner: BootstrapBinder, symbol: SemanticClass): Int
  return owner.syntax.childCountAt(symbol.syntaxNode)
end

def alternativeCaseNode(owner: BootstrapBinder, symbol: SemanticClass, index: Int): Int
  return owner.syntax.childAt(symbol.syntaxNode, index)
end

def alternativePayloadField(caseIndex: Int, payloadIndex: Int): String
  return "$alternative" + (caseIndex as String) + "_" + (payloadIndex as String)
end

def alternativeSourceIdentity(owner: BootstrapBinder, symbol: SemanticClass, name: String): String
  let typeName = symbol.genericOrigin >= 0 ? genericName(owner, symbol.genericOrigin) : symbol.fullName

  return "alternative:" + typeName + "." + name
end

def registerAlternativeFields(owner: BootstrapBinder): Void
  var symbol = owner.model.firstClass

  while symbol != null
    if symbol.isAlternative && symbol.firstField == null
      symbol.addField(new SemanticField(symbol.fullName, "$alternativeTag", "Int", "private", symbol.syntaxNode))
      if alternativeCaseCount(owner, symbol) == 0
        owner.report("NR260", symbol.syntaxNode, "A closed alternative declaration requires at least one case.")
      end
      var caseIndex = 0

      while caseIndex < alternativeCaseCount(owner, symbol)
        let caseNode = alternativeCaseNode(owner, symbol, caseIndex)

        owner.recordDeclaration(alternativeSourceIdentity(owner, symbol, owner.syntax.dataAt(caseNode)), owner.syntax.dataAt(caseNode), symbol.fullName, caseNode)
        var earlier = 0

        while earlier < caseIndex
          if owner.syntax.dataAt(alternativeCaseNode(owner, symbol, earlier)) == owner.syntax.dataAt(caseNode)
            owner.report("NR260", caseNode, "Alternative '" + owner.syntax.dataAt(caseNode) + "' is already declared.")
          end
          earlier = earlier + 1
        end
        var payload = 0

        while payload < owner.syntax.childCountAt(caseNode)
          let parameter = owner.syntax.childAt(caseNode, payload)
          var previousPayload = 0

          while previousPayload < payload
            if owner.syntax.dataAt(owner.syntax.childAt(caseNode, previousPayload)) == owner.syntax.dataAt(parameter)
              owner.report("NR261", parameter, "Alternative payload '" + owner.syntax.dataAt(parameter) + "' is already declared.")
            end
            previousPayload = previousPayload + 1
          end
          let typeName = owner.resolveTypeNode(owner.syntax.childAt(parameter, 0), symbol.namespaceName, owner.syntax.dataAt(parameter))

          symbol.addField(new SemanticField(symbol.fullName, alternativePayloadField(caseIndex, payload), typeName, "private", parameter))
          payload = payload + 1
        end
        caseIndex = caseIndex + 1
      end
    end
    symbol = symbol.nextClass
  end
end

def registerGenericTemplates(owner: BootstrapBinder): Void
  let declarations = new IntBuffer()
  var index = 0

  while index < owner.classCount()
    declarations.add(owner.classNodeAt(index))
    index = index + 1
  end
  index = 0
  while index < owner.functionCount()
    declarations.add(owner.functionNodeAt(index))
    index = index + 1
  end
  index = 0
  while index < declarations.size
    let node = declarations.get(index)
    let parameters = owner.syntax.nodeAt(node).typeParameters

    if parameters.Length > 0
      if owner.syntax.kindAt(node) == "Class" && owner.classRepresentation(node) != ""
        owner.report("NR245", node, "A represented class cannot declare type parameters.")
      end
      if owner.syntax.kindAt(node) == "Class" && semanticReservedTypeName(semanticField(owner.syntax.dataAt(node), 2))
        owner.report("NR156", node, "Type '" + genericName(owner, node) + "' is reserved.")
        index = index + 1
        continue
      end
      owner.model.genericTemplates.add(node)
      let parent = owner.model.parent

      if parent != null
        var parentIndex = 0

        while parentIndex < parent.genericTemplates.size
          let existing = parent.genericTemplates.get(parentIndex)

          if owner.syntax.kindAt(node) == owner.syntax.kindAt(existing) && genericName(owner, node) == genericName(owner, existing)
            owner.report("NR220", node, "Generic declaration '" + genericName(owner, node) + "' must have a unique name.")
            break
          end
          parentIndex = parentIndex + 1
        end
      end
      var other = 0

      while other < declarations.size
        let candidate = declarations.get(other)

        if candidate != node && owner.syntax.kindAt(node) == owner.syntax.kindAt(candidate) && genericName(owner, node) == genericName(owner, candidate)
          owner.report("NR220", node, "Generic declaration '" + genericName(owner, node) + "' must have a unique name.")
          break
        end
        other = other + 1
      end
      var parameter = 0

      while parameter < parameters.Length
        if semanticReservedTypeName(parameters[parameter])
          owner.report("NR220", node, "A type parameter cannot use a reserved type name.")
        end
        other = 0
        while other < parameter
          if parameters[other] == parameters[parameter]
            owner.report("NR220", node, "Duplicate type parameter '" + parameters[parameter] + "'.")
          end
          other = other + 1
        end
        parameter = parameter + 1
      end
      if owner.syntax.kindAt(node) == "Function" && semanticField(owner.syntax.dataAt(node), 1) == "main"
        owner.report("NR220", node, "The entry point cannot have type parameters.")
      end
      if owner.syntax.kindAt(node) == "Function" && (semanticIntField(owner.syntax.dataAt(node), 2) > 0 || semanticBoolField(owner.syntax.dataAt(node), 5))
        owner.report("NR220", node, "Generic module functions have no C ABI annotations or static modifier.")
      end
      if owner.recordSourceSymbols
        let data = owner.syntax.dataAt(node)
        let fullName = genericName(owner, node)

        if owner.syntax.kindAt(node) == "Class"
          owner.recordDeclaration("type:" + fullName, semanticField(data, 2), fullName, node, "class " + fullName)
          var member = owner.classMemberStart(node)

          while member < owner.syntax.childCountAt(node)
            let declaration = owner.syntax.childAt(node, member)

            if owner.syntax.kindAt(declaration) == "Field"
              let fieldName = semanticField(owner.syntax.dataAt(declaration), 1)

              owner.recordDeclaration("field:" + fullName + "." + fieldName, fieldName, "", declaration)
            else if owner.syntax.kindAt(declaration) == "Method"
              let annotationCount = semanticIntField(owner.syntax.dataAt(declaration), 1)
              let functionNode = owner.syntax.childAt(declaration, annotationCount)
              let methodName = semanticField(owner.syntax.dataAt(functionNode), 1)

              owner.recordDeclaration("callable:" + fullName + "." + methodName, methodName, "", functionNode, "", 6)
            else if owner.syntax.kindAt(declaration) == "AlternativeCase"
              let caseName = owner.syntax.dataAt(declaration)

              owner.recordDeclaration("alternative:" + fullName + "." + caseName, caseName, fullName, declaration)
            end
            member = member + 1
          end
        else
          owner.recordDeclaration("callable:" + fullName, semanticField(data, 1), "", node)
          let annotationCount = semanticIntField(data, 2)
          let parameterCount = semanticIntField(data, 3)
          var parameter = 0

          while parameter < parameterCount
            let declaration = owner.syntax.childAt(node, annotationCount + parameter)

            owner.recordDeclaration(fullName + "/parameter[" + (parameter as String) + "]", owner.syntax.dataAt(declaration), "", declaration)
            parameter = parameter + 1
          end
        end
      end
    end
    index = index + 1
  end
end

def findGenericTemplateReadOnly(model: SemanticModel, syntax: SyntaxArena, name: String, namespaceName: String, kind: String): Int
  # A value at or below -3 encodes the second conflicting node as -node-3.
  # Callers that only query visibility can treat every negative value as absent.
  var candidate = -1
  var index = 0

  while index < model.genericTemplates.size
    let node = model.genericTemplates.get(index)

    if syntax.kindAt(node) == kind
      let fullName = genericSyntaxName(syntax, node)

      if fullName == semanticQualifiedName(namespaceName, name)
        return node
      end
      if fullName == name
        candidate = node
      end
    end
    index = index + 1
  end
  var imported = -1

  index = 0
  while index < model.genericTemplates.size
    let node = model.genericTemplates.get(index)

    if syntax.kindAt(node) == kind
      var useIndex = 0

      while useIndex < model.usedNames.size
        if genericSyntaxName(syntax, node) == semanticQualifiedName(model.usedNames.get(useIndex), name)
          if imported >= 0 && imported != node
            return -node - 3
          end
          imported = node
        end
        useIndex = useIndex + 1
      end
    end
    index = index + 1
  end
  return imported >= 0 ? imported : candidate
end

def findGenericTemplate(owner: BootstrapBinder, name: String, namespaceName: String, kind: String): Int
  let result = findGenericTemplateReadOnly(owner.model, owner.syntax, name, namespaceName, kind)

  if result <= -3
    owner.report("NR220", -result - 3, "Generic name '" + name + "' is ambiguous.")
    return -1
  end
  if result >= 0
    let importedName = genericName(owner, result)

    owner.model.referenceQualifiedUse(importedName)
    var useIndex = 0

    while useIndex < owner.model.usedNames.size
      if importedName == semanticQualifiedName(owner.model.usedNames.get(useIndex), name)
        owner.model.referenceUse(owner.model.usedNames.get(useIndex))
      end
      useIndex = useIndex + 1
    end
  end
  return result
end
