use host

def genericName(owner: BootstrapBinder, node: Int): String
  let data = owner.syntax.dataAt(node)
  return semanticQualifiedName(semanticField(data, 0), semanticField(data, owner.syntax.kindAt(node) == "Class" ? 2 : 1))
end

def registerGenericTemplates(owner: BootstrapBinder): Void
  let declarations = new IntBuffer()
  var index = 0
  while index < owner.classCount()
    declarations.add(owner.classNodeAt(index))
    index = index + 1
  end
  index = 0
  while index < owner.functionCount()
    declarations.add(owner.functionNodeAt(index))
    index = index + 1
  end
  index = 0
  while index < declarations.size
    let node = declarations.get(index)
    let parameters = owner.syntax.nodeAt(node).typeParameters
    if parameters.Length > 0
      owner.model.genericTemplates.add(node)
      var other = 0
      while other < declarations.size
        let candidate = declarations.get(other)
        if candidate != node && owner.syntax.kindAt(node) == owner.syntax.kindAt(candidate) && genericName(owner, node) == genericName(owner, candidate)
          owner.report("NR220", node, "Generic declaration '" + genericName(owner, node) + "' must have a unique name.")
          break
        end
        other = other + 1
      end
      var parameter = 0
      while parameter < parameters.Length
        if semanticIsBuiltin(parameters[parameter])
          owner.report("NR220", node, "A type parameter cannot shadow a built-in type.")
        end
        other = 0
        while other < parameter
          if parameters[other] == parameters[parameter]
            owner.report("NR220", node, "Duplicate type parameter '" + parameters[parameter] + "'.")
          end
          other = other + 1
        end
        parameter = parameter + 1
      end
      if owner.syntax.kindAt(node) == "Function" && semanticField(owner.syntax.dataAt(node), 1) == "main"
        owner.report("NR220", node, "The entry point cannot have type parameters.")
      end
      if owner.syntax.kindAt(node) == "Function" && (semanticIntField(owner.syntax.dataAt(node), 2) > 0 || semanticBoolField(owner.syntax.dataAt(node), 5))
        owner.report("NR220", node, "Generic module functions have no C ABI annotations or static modifier.")
      end
    end
    index = index + 1
  end
end

def findGenericTemplate(owner: BootstrapBinder, name: String, namespaceName: String, kind: String): Int
  var candidate = -1
  var index = 0
  while index < owner.model.genericTemplates.size
    let node = owner.model.genericTemplates.get(index)
    if owner.syntax.kindAt(node) == kind
      let fullName = genericName(owner, node)
      if fullName == semanticQualifiedName(namespaceName, name)
        return node
      end
      if fullName == name
        candidate = node
      end
    end
    index = index + 1
  end
  var imported = -1
  index = 0
  while index < owner.model.genericTemplates.size
    let node = owner.model.genericTemplates.get(index)
    if owner.syntax.kindAt(node) == kind
      var useIndex = 0
      while useIndex < owner.model.usedNames.size
        if genericName(owner, node) == semanticQualifiedName(owner.model.usedNames.get(useIndex), name)
          if imported >= 0 && imported != node
            owner.report("NR220", node, "Generic name '" + name + "' is ambiguous.")
            return -1
          end
          imported = node
        end
        useIndex = useIndex + 1
      end
    end
    index = index + 1
  end
  return imported >= 0 ? imported : candidate
end
