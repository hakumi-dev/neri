use host

def semanticFieldPackType(owner: BootstrapBinder, entity: String, node: Int): SemanticClass
  if owner.model.findClass("fields.Pack") == null
    owner.report("NR277", node, "Field-pack types require 'use fields'.")
  end
  let entityClass = owner.model.findClass(entity)
  let parameter = owner.model.findTypeParameter(entity)

  if parameter == null && (entityClass == null || entityClass.isAlternative || entityClass.isResource || entityClass.representation != "" || entityClass.isFunctionType || entityClass.quotedFunctionType != "" || entityClass.fieldPackEntityType != "")
    owner.report("NR277", node, "A fields-of type requires a class with declared instance fields.")
  end
  let name = "(fields of " + entity + ")"
  let existing = owner.model.findClass(name)

  if existing != null
    return existing
  end
  let signature = new SemanticClass(name, name, "", "internal", -1)

  signature.fieldPackEntityType = entity
  signature.isSealed = true
  signature.bodiesBound = true
  signature.addField(new SemanticField(name, "storedPack", "fields.Pack", "private", node))
  let view = semanticReadView("fields.Pack")
  let accessor = new SemanticCallable(name + ".pack", "pack", "", name, view, false, false, "public", node)

  accessor.isReadonly = true
  let receiver = owner.addBound("This", semanticReadView(name), "", node, emptyInts())
  let member = owner.addBound("Member", view, name + ".storedPack", node, [receiver])
  let returned = owner.addBound("Return", view, "", node, [member])

  accessor.boundNode = owner.addBound("Function", view, accessor.fullName, node, [returned])
  signature.addMethod(accessor)
  owner.model.addClass(signature)
  return signature
end

def semanticLabelParameter(callable: SemanticCallable): Int
  var index = 0
  var parameter = callable.firstParameter

  while parameter != null
    if parameter.mode == "labels"
      return index
    end
    parameter = parameter.nextParameter
    index = index + 1
  end
  return -1
end

def fieldPackField(body: BootstrapBodyBinder, typeName: String, label: String, node: Int, report: Bool): SemanticField?
  let pack = body.model().findClass(semanticMutableType(typeName))
  var field: SemanticField? = null

  if pack != null
    let entity = body.model().findClass(pack.fieldPackEntityType)

    if entity != null
      field = body.findField(entity, label)
    end
  end
  if field == null || field.access != "public"
    if report
      body.report("NR278", node, "Field pack '" + typeName + "' has no public instance field named '" + label + "'.")
    end
    return null
  end
  return field
end

def fieldPackScalar(typeName: String): Bool
  let value = semanticIsOptional(typeName) ? semanticInnerType(typeName) : typeName

  return value == "Bool" || value == "Int" || value == "String"
end

def fieldPackCapture(body: BootstrapBodyBinder, value: BoundValue, declaredType: String, node: Int): Int
  return quotationBoxScalar(body, value.boundNode, declaredType, node, "NR277")
end

def fieldPackEntry(body: BootstrapBodyBinder, parameter: SemanticParameter, argumentNode: Int, value: BoundValue): Int
  let label = semanticArgumentLabel(body.syntax(), argumentNode)
  let field = fieldPackField(body, parameter.typeName, label, argumentNode, true)

  if field == null
    return body.addBound("ErrorExpression", "Error", "", argumentNode, [])
  end
  body.owner.recordOccurrence(body.owner.fieldSourceIdentity(field), argumentNode, field.owner + "." + field.name + ": " + field.typeName)
  if !semanticAssignable(body.model(), field.typeName, value.typeName)
    body.report("NR112", semanticArgumentExpression(body.syntax(), argumentNode), "Field '" + field.owner + "." + field.name + "' expects type '" + field.typeName + "', but got '" + value.typeName + "'.")
  end
  if !fieldPackScalar(field.typeName)
    body.report("NR279", argumentNode, "Field packs currently represent Bool, Int, String and their optional types; field '" + field.name + "' has type '" + field.typeName + "'.")
    return body.addBound("ErrorExpression", "Error", "", argumentNode, [])
  end
  let identity = body.addBoundValue("StringLiteral", "String", "", "s:" + field.owner + "." + field.name, argumentNode, [])
  let typeName = body.addBoundValue("StringLiteral", "String", "", "s:" + field.typeName, argumentNode, [])
  let captured = fieldPackCapture(body, value, field.typeName, argumentNode)

  return body.addBound("New", "fields.Entry", "fields.Entry", argumentNode, [identity, typeName, captured])
end

def fieldPackAbiValid(body: BootstrapBodyBinder, node: Int): Bool
  let entryTypes = new StringBuffer()

  entryTypes.add("String")
  entryTypes.add("String")
  entryTypes.add("quotation.CaptureValue")
  let packTypes = new StringBuffer()

  packTypes.add("fields.Entry[]")
  packTypes.add("String")
  let valid = quotationConstructorMatches(body, "fields.Entry", entryTypes) && quotationConstructorMatches(body, "fields.Pack", packTypes)

  if !valid
    body.report("NR277", node, "Field packs require the standard fields.Entry and fields.Pack constructor ABI.")
  end
  return valid
end

def appendFieldPack(body: BootstrapBodyBinder, callable: SemanticCallable, node: Int, children: Int[]): Int[]
  let index = semanticLabelParameter(callable)
  let parameter = callable.parameterAt(index)

  if index < 0 || parameter == null
    return children
  end
  fieldPackAbiValid(body, node)
  let pack = body.addBound("FieldPack", parameter.typeName, parameter.typeName, node, [])
  let argument = body.addBound("Argument", parameter.typeName, index as String, node, [pack])

  return host.appendInt(children, argument)
end
