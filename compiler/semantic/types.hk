def semanticIsBuiltin(typeName: String): Bool
  return semanticIsNumeric(typeName) || typeName == "Bool" || typeName == "String" || typeName == "Void"
end

def semanticIsNumeric(typeName: String): Bool
  return typeName == "Int" || typeName == "Byte" || typeName == "Float" || typeName == "Int32" || typeName == "UInt32" || typeName == "UInt64" || typeName == "Float32"
end

def semanticIsArithmetic(typeName: String): Bool
  return semanticIsNumeric(typeName) && typeName != "Byte"
end

def semanticNativeLibraryName(name: String): Bool
  let length = host.stringByteLength(name)
  if length == 0 || length > 128
    return false
  end
  var index = 0
  while index < length
    let byte = host.stringByteAt(name, index) as Int
    let alphaNumeric = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
    if !alphaNumeric && (index == 0 || (byte != 95 && byte != 45 && byte != 46))
      return false
    end
    index = index + 1
  end
  return true
end

def semanticIsOptional(typeName: String): Bool
  return semanticEndsWith(typeName, "?")
end

def semanticIsArray(typeName: String): Bool
  return semanticEndsWith(typeName, "[]")
end

def semanticIsPointer(typeName: String): Bool
  return semanticEndsWith(typeName, "*")
end

def semanticContainsPointer(typeName: String): Bool
  var current = typeName
  while semanticIsArray(current) || nativeFixedArray(current) || semanticIsOptional(current) || semanticIsPointer(current)
    if semanticIsPointer(current)
      return true
    end
    current = semanticInnerType(current)
  end
  return false
end

def semanticInnerType(typeName: String): String
  if nativeFixedArray(typeName)
    return nativeArrayInner(typeName)
  end
  if semanticIsArray(typeName)
    return semanticStripSuffix(typeName, "[]")
  else if semanticIsOptional(typeName)
    return semanticStripSuffix(typeName, "?")
  else if semanticIsPointer(typeName)
    return semanticStripSuffix(typeName, "*")
  end
  return typeName
end

def semanticClassAssignable(model: SemanticModel, target: String, source: String): Bool
  if target == source
    return true
  end
  var current = model.findClass(source)
  var steps = 0
  while current != null && steps < 256
    if current.baseName == target
      return true
    end
    current = model.findClass(current.baseName)
    steps = steps + 1
  end
  return false
end

def semanticAssignable(model: SemanticModel, target: String, source: String): Bool
  if target == "Error" || target == source
    return true
  end
  if semanticIsOptional(target)
    if source == "Null"
      return true
    end
    let targetInner = semanticInnerType(target)
    if semanticIsOptional(source)
      return targetInner == semanticInnerType(source)
    end
    return semanticAssignable(model, targetInner, source)
  end
  if semanticIsArray(target) || semanticIsPointer(target)
    return target == source
  end
  if model.findClass(target) != null && model.findClass(source) != null
    return semanticClassAssignable(model, target, source)
  end
  return false
end

def semanticEqualityComparable(typeName: String): Bool
  if semanticIsOptional(typeName)
    return semanticEqualityComparable(semanticInnerType(typeName))
  end
  return semanticIsNumeric(typeName) || typeName == "Bool" || typeName == "String"
end

def semanticResolveType(model: SemanticModel, typeName: String, namespaceName: String): String
  var baseName = typeName
  var suffix = ""
  while semanticIsArray(baseName) || nativeFixedArray(baseName) || semanticIsOptional(baseName) || semanticIsPointer(baseName)
    if nativeFixedArray(baseName)
      let start = nativeArrayStart(baseName)
      suffix = host.stringSlice(baseName, start, host.stringByteLength(baseName) - start) + suffix
      baseName = nativeArrayInner(baseName)
    else if semanticIsArray(baseName)
      suffix = "[]" + suffix
      baseName = semanticInnerType(baseName)
    else if semanticIsOptional(baseName)
      suffix = "?" + suffix
      baseName = semanticInnerType(baseName)
    else
      suffix = "*" + suffix
      baseName = semanticInnerType(baseName)
    end
  end
  if semanticIsBuiltin(baseName)
    return baseName + suffix
  end
  let localName = semanticQualifiedName(namespaceName, baseName)
  if model.findRecord(localName) != null
    return "record|" + localName + suffix
  end
  if model.findClass(localName) != null
    return localName + suffix
  end
  if model.findRecord(baseName) != null
    return "record|" + baseName + suffix
  end
  if model.findClass(baseName) != null
    return baseName + suffix
  end
  var candidate = ""
  var index = 0
  while index < model.usedNames.size
    let imported = semanticQualifiedName(model.usedNames.get(index), baseName)
    if model.findRecord(imported) != null
      if candidate != ""
        return "Ambiguous"
      end
      candidate = "record|" + imported
    end
    if model.findClass(imported) != null
      if candidate != ""
        return "Ambiguous"
      end
      candidate = imported
    end
    index = index + 1
  end
  if candidate != ""
    return candidate + suffix
  end
  return "Unknown"
end
