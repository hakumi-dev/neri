use host

class BootstrapBinder
  public syntax: SyntaxArena = new SyntaxArena()
  public model: SemanticModel = new SemanticModel()
  public root: Int = -1
  public currentNamespace: String = ""
  public currentClass: SemanticClass?
  public currentCallable: SemanticCallable?
  public firstLocal: SemanticLocal?
  public lastLocal: SemanticLocal?
  public scopeDepth: Int = 0
  public loopDepth: Int = 0
  public unsafeDepth: Int = 0
  public sourceLength: Int = 0
  public sourceIds: StringBuffer = new StringBuffer()
  public sourceStarts: IntBuffer = new IntBuffer()
  public recordSourceSymbols: Bool = false
  public recordCompletionSites: Bool = false
  public requireEntryPoint: Bool = true
  public allowSessionEntryReplacement: Bool = false
  public forbiddenEntryPointSources: StringBuffer = new StringBuffer()

  def recordDeclaration(identity: String, name: String, typeName: String, node: Int, display: String = "", symbolKind: Int = 0): Void
    if !this.recordSourceSymbols
      return
    end
    let declaration = new SemanticDeclaration()

    declaration.identity = identity
    declaration.name = name
    declaration.typeName = typeName
    declaration.display = display
    declaration.symbolKind = symbolKind
    declaration.start = this.syntax.startAt(node)
    declaration.length = this.syntax.lengthAt(node)
    declaration.next = this.model.declarations
    this.model.declarations = declaration
  end

  def recordOccurrence(identity: String, node: Int, display: String = ""): Void
    if !this.recordSourceSymbols || identity == ""
      return
    end
    let occurrence = new SemanticOccurrence()

    occurrence.identity = identity
    occurrence.display = display
    occurrence.start = this.syntax.startAt(node)
    occurrence.length = this.syntax.lengthAt(node)
    occurrence.next = this.model.occurrences
    this.model.occurrences = occurrence
  end

  def init(syntax: SyntaxArena, root: Int, sourceLength: Int, parentModel: SemanticModel? = null): Void
    this.syntax = syntax
    this.root = root
    this.sourceLength = sourceLength
    this.model = new SemanticModel(parentModel)
    this.model.syntax = syntax
    if parentModel != null
      this.model.bound = new BoundArena(parentModel.bound)
    end
    this.addSource("main", 0)
  end

  def clearSources(): Void
    this.sourceIds = new StringBuffer()
    this.sourceStarts = new IntBuffer()
  end

  def addSource(id: String, start: Int): Void
    this.sourceIds.add(id)
    this.sourceStarts.add(start)
  end

  def sourceIdAt(position: Int): String
    var result = "main"
    var index = 0

    while index < this.sourceStarts.size && position >= this.sourceStarts.get(index)
      result = this.sourceIds.get(index)
      index = index + 1
    end
    return result
  end

  def sourceStartAt(position: Int): Int
    var result = 0
    var index = 0

    while index < this.sourceStarts.size && position >= this.sourceStarts.get(index)
      result = this.sourceStarts.get(index)
      index = index + 1
    end
    return result
  end

  def report(code: String, node: Int, message: String): Void
    this.model.diagnostics.add(code, this.syntax.startAt(node), this.syntax.lengthAt(node), message)
  end

  def reportLength(code: String, node: Int, length: Int, message: String): Void
    this.model.diagnostics.add(code, this.syntax.startAt(node), length, message)
  end

  def reportSecondary(code: String, node: Int, message: String): Void
    this.model.diagnostics.add(code, this.syntax.secondaryStartAt(node), this.syntax.secondaryLengthAt(node), message)
  end

  def addBound(kind: String, typeName: String, data: String, syntaxNode: Int, children: Int[]): Int
    return this.model.bound.add(kind, typeName, data, this.syntax.irStartAt(syntaxNode), this.syntax.irLengthAt(syntaxNode), children)
  end

  def addBoundValue(kind: String, typeName: String, data: String, value: String, syntaxNode: Int, children: Int[]): Int
    let node = this.addBound(kind, typeName, data, syntaxNode, children)

    this.model.bound.setValue(node, value)
    return node
  end

  def addBoundSymbol(kind: String, typeName: String, data: String, symbol: String, syntaxNode: Int, children: Int[]): Int
    let node = this.addBound(kind, typeName, data, syntaxNode, children)

    this.model.bound.setSymbol(node, symbol)
    return node
  end

  def bind(): SemanticModel
    this.registerNamespaces()
    registerContractNames(this)
    this.registerUses()
    registerGenericTemplates(this)
    validateGenericOperations(this)
    this.registerClassNames()
    var sourceIndex = 0

    while sourceIndex < this.sourceIds.size
      if this.sourceIds.get(sourceIndex) == "@stdlib/core.hk"
        let textClass = this.model.findClass("String")

        if textClass == null || textClass.representation != "utf8"
          this.report("NR245", this.root, "The core library must declare String with its registered UTF-8 representation.")
        end
      end
      sourceIndex = sourceIndex + 1
    end
    registerNativeRecordNames(this)
    registerNativeRecordFields(this)
    this.registerClassMembers()
    registerAlternativeFields(this)
    this.resolveInheritance()
    this.validateInheritedMembers()
    validateAbstractClasses(this)
    this.registerFunctions()
    registerContractRequirements(this)
    referenceGenericTemplateUses(this)
    validateConstrainedGenericFunctions(this)
    this.validateEntryPoint()
    let bodies = new BootstrapBodyBinder(this)

    while true
      let instances = this.model.genericInstances

      bodies.bindClassBodies()
      bodies.bindFunctionBodies()
      if instances == this.model.genericInstances
        break
      end
    end
    return this.model
  end

  # The parser root supplied to a child binder contains only newly parsed
  # declarations. Its model can resolve retained declarations through parentModel.
  def bindChild(): SemanticModel
    return this.bind()
  end

  def useCount(): Int
    return semanticIntField(this.syntax.dataAt(this.root), 0)
  end

  def classCount(): Int
    return semanticIntField(this.syntax.dataAt(this.root), 1)
  end

  def functionCount(): Int
    return semanticIntField(this.syntax.dataAt(this.root), 2)
  end

  def classNodeAt(index: Int): Int
    return this.syntax.childAt(this.root, this.useCount() + index)
  end

  def functionNodeAt(index: Int): Int
    return this.syntax.childAt(this.root, this.useCount() + this.classCount() + index)
  end

  def registerNamespaces(): Void
    var recordIndex = 0

    while recordIndex < nativeRecordCount(this)
      this.addNamespace(semanticField(this.syntax.dataAt(nativeRecordNode(this, recordIndex)), 0))
      recordIndex = recordIndex + 1
    end
    var contractIndex = 0

    while contractIndex < semanticContractCount(this)
      this.addNamespace(semanticField(this.syntax.dataAt(semanticContractNode(this, contractIndex)), 0))
      contractIndex = contractIndex + 1
    end
    var index = 0

    while index < this.classCount()
      let node = this.classNodeAt(index)

      this.addNamespace(semanticField(this.syntax.dataAt(node), 0))
      index = index + 1
    end
    index = 0
    while index < this.functionCount()
      let node = this.functionNodeAt(index)

      this.addNamespace(semanticField(this.syntax.dataAt(node), 0))
      index = index + 1
    end
  end

  def addNamespace(name: String): Void
    if name == ""
      return
    end
    var index = 0

    while index < this.model.declaredNamespaces.size
      if this.model.declaredNamespaces.get(index) == name
        return
      end
      index = index + 1
    end
    this.model.declaredNamespaces.add(name)
  end

  def namespaceExists(name: String): Bool
    var index = 0

    while index < this.model.declaredNamespaces.size
      if this.model.declaredNamespaces.get(index) == name
        return true
      end
      index = index + 1
    end
    return false
  end

  def registerUses(): Void
    var index = 0

    while index < this.useCount()
      let node = this.syntax.childAt(this.root, index)
      let name = this.syntax.dataAt(node)

      if this.namespaceExists(name)
        if !this.model.hasUse(name)
          this.model.usedNames.add(name)
        end
      else
        this.report("NR101A", node, "Unknown import '" + name + "'. Add its source or dependency to the project.")
      end
      index = index + 1
    end
  end

  def registerClassNames(): Void
    var index = 0

    while index < this.classCount()
      let node = this.classNodeAt(index)

      if this.syntax.nodeAt(node).typeParameters.Length > 0
        index = index + 1
        continue
      end
      let data = this.syntax.dataAt(node)
      let namespaceName = semanticField(data, 0)
      let access = semanticField(data, 1)
      let name = semanticField(data, 2)
      let fullName = semanticQualifiedName(namespaceName, name)
      let representation = this.classRepresentation(node)
      let abstract = validateAbstractClass(this, node)
      let representedBuiltin = representation != "" && semanticRepresentationType(representation) == fullName && this.sourceIdAt(this.syntax.startAt(node)) == "@stdlib/core.hk"

      if semanticReservedTypeName(name) && !representedBuiltin
        this.report("NR156", node, "Type '" + fullName + "' is reserved.")
      else if this.model.findClass(fullName) != null || this.model.findContract(fullName) != null
        this.report("NR156", node, "Type '" + fullName + "' is already defined.")
      else
        let symbol = new SemanticClass(fullName, name, namespaceName, access, node)

        symbol.isAlternative = semanticField(data, 4) == "enum"
        symbol.isResource = semanticField(data, 4) == "resource"
        symbol.representation = representation
        symbol.isSealed = representation != "" || this.classSealed(node)
        symbol.isAbstract = abstract
        this.model.addClass(symbol)
        this.recordDeclaration("type:" + fullName, name, fullName, node, abstract ? "abstract class " + fullName : "class " + fullName)
      end
      index = index + 1
    end
  end

  def classAnnotationArgument(annotation: Int): String
    if this.syntax.childCountAt(annotation) != 1
      return ""
    end
    let written = this.syntax.dataAt(this.syntax.childAt(annotation, 0))

    if host.stringByteLength(written) < 2
      return ""
    end
    return host.stringSlice(written, 1, host.stringByteLength(written) - 2)
  end

  def classRepresentation(node: Int): String
    var result = ""

    for annotation in this.syntax.nodeAt(node).classAnnotations
      let name = this.syntax.dataAt(annotation)

      if name == "representation"
        let value = this.classAnnotationArgument(annotation)

        if semanticField(this.syntax.dataAt(node), 4) == "enum"
          this.report("NR245", annotation, "Annotation '@representation' requires an ordinary class.")
        else if result != "" || semanticRepresentationType(value) == ""
          this.report("NR245", annotation, "Annotation '@representation' requires one unique supported representation name.")
        else
          result = value
        end
      else
        this.report("NR245", annotation, "Unknown class annotation '@" + name + "'.")
      end
    end
    return result
  end

  def classSealed(node: Int): Bool
    return syntaxHasModifier(this.syntax, node, "sealed")
  end

  def classForNode(node: Int): SemanticClass?
    var current = this.model.firstClass

    while current != null
      if current.syntaxNode == node
        return current
      end
      current = current.nextClass
    end
    return null
  end

  def classBaseNode(node: Int): Int
    if this.syntax.childCountAt(node) > 0
      let first = this.syntax.childAt(node, 0)

      if this.syntax.kindAt(first) == "Type"
        return first
      end
    end
    return -1
  end

  def classMemberStart(node: Int): Int
    if this.classBaseNode(node) >= 0
      return 1
    end
    return 0
  end

  def resolveTypeNode(node: Int, namespaceName: String, fieldName: String): String
    if this.syntax.dataAt(node) == "#readonly"
      let inner = this.resolveTypeNode(this.syntax.childAt(node, 0), namespaceName, fieldName)

      if semanticContainsPointer(inner) || nativeValueType(inner) || nativeFixedArray(inner) || inner == "Void"
        this.report("NR240", node, "Readonly views require managed references or scalar values.")
        return "Error"
      end
      return semanticReadView(inner)
    end
    if this.syntax.dataAt(node) == "fn" || this.syntax.dataAt(node) == "shared fn" || this.syntax.dataAt(node) == "parallel fn"
      var parameters = new StringBuffer()
      var index = 0
      let count = this.syntax.childCountAt(node)

      while index < count - 1
        let parameter = this.resolveTypeNode(this.syntax.childAt(node, index), namespaceName, "")

        parameters.add(parameter)
        index = index + 1
      end
      let result = this.resolveTypeNode(this.syntax.childAt(node, count - 1), namespaceName, "")

      return semanticFunctionType(this, parameters, result, node, this.syntax.dataAt(node) != "fn", this.syntax.dataAt(node) == "parallel fn").fullName
    end
    let written = this.syntax.dataAt(node)
    var resolved = ""
    var baseName = written

    while semanticIsArray(baseName) || nativeFixedArray(baseName) || semanticIsOptional(baseName) || semanticIsPointer(baseName)
      baseName = semanticInnerType(baseName)
    end
    if baseName == "#group"
      resolved = this.resolveTypeNode(this.syntax.childAt(node, 0), namespaceName, fieldName) + host.stringSlice(written, 6, host.stringByteLength(written) - 6)
    end
    if this.syntax.nodeAt(node).typeArguments.Length > 0
      let arguments = new StringBuffer()

      for argument in this.syntax.nodeAt(node).typeArguments
        arguments.add(this.resolveTypeNode(argument, namespaceName, ""))
      end
      let template = findGenericTemplate(this, baseName, namespaceName, "Class")

      if template < 0
        this.report("NR220", node, "Type '" + baseName + "' is not a generic class.")
        return "Error"
      end
      let specialized = instantiateGenericClass(this, template, arguments, node)

      if specialized == null
        return "Error"
      end
      resolved = specialized.fullName + host.stringSlice(written, host.stringByteLength(baseName), host.stringByteLength(written) - host.stringByteLength(baseName))
    end
    if resolved == ""
      resolved = semanticResolveType(this.model, written, namespaceName)
    end
    if resolved == "Unknown"
      if fieldName == ""
        this.report("NR109", node, "Unknown type '" + semanticField(written, 0) + "'.")
      else
        this.report("NR152", node, "Unknown type '" + semanticField(written, 0) + "' for field '" + fieldName + "'.")
      end
      return "Error"
    else if resolved == "Ambiguous"
      this.report("NR157", node, "Type '" + written + "' is ambiguous.")
      return "Error"
    end
    if semanticEndsWith(resolved, "??")
      this.report("NR168", node, "Optional suffix '?' cannot be repeated without an intervening type constructor.")
      return "Error"
    end
    if semanticEndsWith(resolved, "Void?")
      this.report("NR167", node, "Type 'Void' cannot be optional.")
      return "Error"
    end
    this.recordTypeOccurrence(resolved, node)
    return resolved
  end

  # Specializations are generated symbols. Source navigation must point at the
  # generic declaration the programmer wrote, while ordinary classes keep
  # their resolved declaration identity.
  def recordTypeOccurrence(resolved: String, node: Int): Void
    var base = semanticMutableType(resolved)

    while semanticIsArray(base) || nativeFixedArray(base) || semanticIsOptional(base) || semanticIsPointer(base)
      base = semanticInnerType(base)
    end
    if nativeRecordType(base)
      let name = host.stringSlice(base, 7, host.stringByteLength(base) - 7)

      if this.model.findRecord(name) != null
        this.recordOccurrence("record:" + name, node)
      end
      return
    end
    let classSymbol = this.model.findClass(base)

    if classSymbol == null
      return
    end
    let declarationName = classSymbol.genericOrigin >= 0 ? genericName(this, classSymbol.genericOrigin) : classSymbol.fullName

    this.recordOccurrence("type:" + declarationName, node)
  end

  def callableSourceIdentity(callable: SemanticCallable): String
    if callable.genericOrigin >= 0
      return "callable:" + genericName(this, callable.genericOrigin)
    end
    if callable.className == ""
      return "callable:" + callable.fullName
    end
    let classSymbol = this.model.findClass(callable.className)

    if classSymbol != null && classSymbol.genericOrigin >= 0
      return "callable:" + genericName(this, classSymbol.genericOrigin) + "." + callable.name
    end
    return "callable:" + callable.fullName
  end

  def fieldSourceIdentity(field: SemanticField): String
    let classSymbol = this.model.findClass(field.owner)

    if classSymbol != null && classSymbol.genericOrigin >= 0
      return "field:" + genericName(this, classSymbol.genericOrigin) + "." + field.name
    end
    return "field:" + field.owner + "." + field.name
  end

  def writtenTypeName(node: Int): String
    let written = this.syntax.dataAt(node)
    var baseName = written

    while semanticIsArray(baseName) || nativeFixedArray(baseName) || semanticIsOptional(baseName) || semanticIsPointer(baseName)
      baseName = semanticInnerType(baseName)
    end
    if baseName == "#group"
      return this.writtenTypeName(this.syntax.childAt(node, 0)) + host.stringSlice(written, 6, host.stringByteLength(written) - 6)
    end
    return written
  end

  def validatePointerType(node: Int, unsafeAllowed: Bool): Void
    let typeName = this.writtenTypeName(node)

    if !semanticContainsPointer(typeName)
      return
    end
    if !unsafeAllowed
      this.reportSecondary("NR190", node, "Raw pointer types can be used only inside an unsafe declaration or block.")
    end
    this.validatePointerElement(node)
  end

  def validatePointerElement(node: Int): Void
    let typeName = this.writtenTypeName(node)

    if !semanticContainsPointer(typeName)
      return
    end
    var baseName = typeName

    while semanticIsArray(baseName) || nativeFixedArray(baseName) || semanticIsOptional(baseName) || semanticIsPointer(baseName)
      baseName = semanticInnerType(baseName)
    end
    if !semanticIsNumeric(baseName) && baseName != "Bool" && baseName != "Void" && !nativeValueType(semanticResolveType(this.model, baseName, this.currentNamespace))
      this.reportSecondary("NR191", node, "Type '" + baseName + "' cannot be the element type of a raw pointer.")
    end
  end

  def registerClassMembers(): Void
    var index = 0

    while index < this.classCount()
      let classNode = this.classNodeAt(index)
      let classSymbol = this.classForNode(classNode)

      if classSymbol != null
        if classSymbol.isAlternative
          index = index + 1
          continue
        end
        this.currentNamespace = classSymbol.namespaceName
        let start = this.classMemberStart(classNode)
        var offset = start

        while offset < this.syntax.childCountAt(classNode)
          let member = this.syntax.childAt(classNode, offset)

          if this.syntax.kindAt(member) == "Field"
            this.registerField(classSymbol, member)
          else if this.syntax.kindAt(member) == "Method"
            this.registerMethod(classSymbol, member)
          end
          offset = offset + 1
        end
        if classSymbol.representation != "" && (classSymbol.fullName != semanticRepresentationType(classSymbol.representation) || this.sourceIdAt(this.syntax.startAt(classNode)) != "@stdlib/core.hk" || classSymbol.access != "public" || classSymbol.isResource || this.syntax.nodeAt(classNode).typeParameters.Length > 0 || this.classBaseNode(classNode) >= 0 || classSymbol.firstField != null || this.findDeclaredMethod(classSymbol, "init") != null)
          this.report("NR245", classNode, "A represented class requires its canonical trusted standard-library declaration, public access, and no base, fields, type parameters, resource role, or constructor.")
        end
      end
      index = index + 1
    end
    this.currentNamespace = ""
  end

  def findDeclaredField(classSymbol: SemanticClass, name: String): SemanticField?
    var field = classSymbol.firstField

    while field != null
      if field.name == name
        return field
      end
      field = field.nextField
    end
    return null
  end

  def findDeclaredMethod(classSymbol: SemanticClass, name: String): SemanticCallable?
    var method = classSymbol.firstMethod

    while method != null
      if method.name == name
        return method
      end
      method = method.nextCallable
    end
    return null
  end

  def registerField(classSymbol: SemanticClass, node: Int): Void
    let data = this.syntax.dataAt(node)
    let access = semanticField(data, 0)
    let name = semanticField(data, 1)

    if this.findDeclaredField(classSymbol, name) != null
      this.report("NR155A", node, "Field '" + name + "' is already defined in class '" + classSymbol.fullName + "'.")
      return
    end
    let typeNode = this.syntax.childAt(node, 0)
    let typeName = this.resolveTypeNode(typeNode, classSymbol.namespaceName, name)

    if semanticContainsResource(this.model, typeName)
      this.report("NR262", node, "Resource ownership cannot be stored in a field.")
    end
    this.validatePointerType(typeNode, true)
    classSymbol.addField(new SemanticField(classSymbol.fullName, name, typeName, access, node))
    this.recordDeclaration("field:" + classSymbol.fullName + "." + name, name, typeName, node, classSymbol.fullName + "." + name + ": " + typeName)
  end

  def registerMethod(classSymbol: SemanticClass, node: Int, validateAbstract: Bool = true): Void
    let access = semanticField(this.syntax.dataAt(node), 0)
    let annotationCount = semanticIntField(this.syntax.dataAt(node), 1)
    let functionNode = this.syntax.childAt(node, annotationCount)
    let abstract = validateAbstractMethod(this, node, classSymbol.isAbstract, validateAbstract)

    if this.syntax.nodeAt(functionNode).typeParameters.Length > 0
      this.report("NR220", functionNode, "Method type parameters are not supported; declare parameters on the class or a module function.")
      return
    end
    let name = semanticField(this.syntax.dataAt(functionNode), 1)

    if this.findDeclaredMethod(classSymbol, name) != null
      this.report("NR155", functionNode, "Method '" + name + "' is already defined in class '" + classSymbol.fullName + "'.")
      return
    end
    let callable = this.createCallable(functionNode, classSymbol, access, abstract)

    callable.isReadonly = syntaxHasModifier(this.syntax, functionNode, "readonly")
    callable.hasOverride = syntaxHasModifier(this.syntax, functionNode, "override")
    if callable.isReadonly && (name == "init" || callable.isStatic)
      this.report("NR240", syntaxModifierNode(this.syntax, functionNode, "readonly"), "Modifier 'readonly' requires an instance method other than a constructor.")
    end
    if classSymbol.isResource && !callable.isStatic && semanticContainsResource(this.model, callable.returnType)
      this.report("NR262", functionNode, "A resource method cannot expose an owned resource value.")
    end
    if name == "init" && callable.returnType != "Void"
      this.report("NR154B", functionNode, "Constructor 'init' in class '" + classSymbol.name + "' must return Void.")
    end
    if name == "init" && callable.isStatic
      this.report("NR179", functionNode, "Constructor 'init' cannot be static.")
    end
    var annotation = 0

    while annotation < annotationCount
      let annotationNode = this.syntax.childAt(node, annotation)
      let annotationName = this.syntax.dataAt(annotationNode)

      if annotationName == "operator"
        var operation = ""

        if this.syntax.childCountAt(annotationNode) == 1
          let written = this.syntax.dataAt(this.syntax.childAt(annotationNode, 0))

          if host.stringByteLength(written) >= 2
            operation = host.stringSlice(written, 1, host.stringByteLength(written) - 2)
          end
        end
        let supported = operation == "+" || operation == "-" || operation == "*" || operation == "/" || operation == "==" || operation == "!=" || operation == "<" || operation == "<=" || operation == ">" || operation == ">=" || operation == "!"
        let arity = callable.parameterCount
        var valid = supported && callable.operatorName == "" && (arity == 0 || arity == 1) && callable.access == "public" && !callable.isStatic && !callable.isUnsafe && !classSymbol.isResource && name != "init"
        let comparison = operation == "==" || operation == "!=" || operation == "<" || operation == "<=" || operation == ">" || operation == ">=" || operation == "!"

        valid = false if arity == 0 && operation != "+" && operation != "-" && operation != "!"
        valid = false if arity == 1 && operation == "!"
        valid = false if callable.returnType != (comparison ? "Bool" : classSymbol.fullName)
        let parameter = callable.firstParameter

        valid = false if arity == 1 && (parameter == null || parameter.typeName != classSymbol.fullName)
        var existing = classSymbol.firstMethod

        while existing != null
          valid = false if existing.operatorName == operation && existing.parameterCount == arity
          existing = existing.nextCallable
        end
        if !valid
          this.report("NR243", annotationNode, "Annotation '@operator' requires one supported operator and a unique public safe non-resource instance method with its exact receiver, operand, and result types.")
        else
          callable.operatorName = operation
        end
      else if annotationName == "conversion"
        var valid = this.syntax.childCountAt(annotationNode) == 0 && !callable.conversion && callable.parameterCount == 0 && callable.returnType != "Void" && semanticMutableType(callable.returnType) != classSymbol.fullName && callable.access == "public" && !callable.isStatic && !callable.isUnsafe && !classSymbol.isResource && name != "init"
        var existing = classSymbol.firstMethod

        while existing != null
          valid = false if existing.conversion && existing.returnType == callable.returnType
          existing = existing.nextCallable
        end
        if !valid
          this.report("NR244", annotationNode, "Annotation '@conversion' requires a unique public safe non-resource zero-argument instance method with a distinct non-Void result type.")
        else
          callable.conversion = true
        end
      else if annotationName == "intrinsic"
        this.report("NR247", annotationNode, "Annotation '@intrinsic' applies only to a module function.")
      else if annotationName == "exact"
        this.report("NR248", annotationNode, "Annotation '@exact' applies only to a module function.")
      else
        this.report("NR172", annotationNode, "Unknown method annotation '@" + annotationName + "'.")
      end
      annotation = annotation + 1
    end
    classSymbol.addMethod(callable)
  end

  def createCallable(functionNode: Int, classSymbol: SemanticClass?, access: String, isAbstract: Bool = false): SemanticCallable
    let data = this.syntax.dataAt(functionNode)
    var namespaceName = semanticField(data, 0)
    let name = semanticField(data, 1)
    let annotationCount = semanticIntField(data, 2)
    let parameterCount = semanticIntField(data, 3)
    let bodyCount = semanticIntField(data, 4)
    let isStatic = semanticBoolField(data, 5)
    let isUnsafe = semanticBoolField(data, 6)
    var className = ""
    var fullName = semanticQualifiedName(namespaceName, name)

    if classSymbol != null
      className = classSymbol.fullName
      namespaceName = classSymbol.namespaceName
      fullName = classSymbol.fullName + "." + name
    else if this.syntax.nodeAt(functionNode).typeParameters.Length == 0
      semanticValidateModuleModifiers(this, functionNode)
    end
    let returnNode = this.syntax.childAt(functionNode, annotationCount + parameterCount)
    let returnType = this.resolveTypeNode(returnNode, namespaceName, "")

    this.validatePointerType(returnNode, isUnsafe)
    this.validatePointerElement(returnNode)
    let callable = new SemanticCallable(fullName, name, namespaceName, className, returnType, isStatic, isUnsafe, access, functionNode)

    callable.isAbstract = isAbstract
    callable.bodyStart = annotationCount + parameterCount + 1
    callable.bodyCount = bodyCount
    var annotationIndex = 0
    var sawCAbi = false
    var sawLibrary = false
    var sawIntrinsic = false
    var sawExact = false

    while annotationIndex < annotationCount
      let annotationNode = this.syntax.childAt(functionNode, annotationIndex)
      let annotationName = this.syntax.dataAt(annotationNode)

      if annotationName == "exact"
        if sawExact || this.syntax.childCountAt(annotationNode) != 0 || classSymbol != null
          this.report("NR248", annotationNode, "Annotation '@exact' applies once to a module function, without arguments.")
        end
        sawExact = true
        callable.exactArguments = true
      else if annotationName == "intrinsic"
        if sawIntrinsic
          this.report("NR247", annotationNode, "Annotation '@intrinsic' cannot be repeated.")
        end
        sawIntrinsic = true
        callable.intrinsicName = this.classAnnotationArgument(annotationNode)
        if semanticIntrinsic(this.model, callable.intrinsicName) == null
          this.report("NR247", annotationNode, "Annotation '@intrinsic' requires one supported intrinsic name.")
        end
      else if annotationName == "library"
        if sawLibrary
          this.report("NR213", annotationNode, "Annotation '@library' cannot be repeated.")
        end
        sawLibrary = true
        if this.syntax.childCountAt(annotationNode) == 1
          let rawLibrary = this.syntax.dataAt(this.syntax.childAt(annotationNode, 0))

          if host.stringByteLength(rawLibrary) >= 2
            callable.nativeLibrary = host.stringSlice(rawLibrary, 1, host.stringByteLength(rawLibrary) - 2)
          end
        end
        if !semanticNativeLibraryName(callable.nativeLibrary)
          this.report("NR213", annotationNode, "Annotation '@library' requires one library name: letters, digits, '_', '-', or '.', starting with a letter or digit.")
        end
      else if annotationName != "cabi"
        this.report("NR205", annotationNode, "Unknown function annotation '@" + annotationName + "'.")
      else if sawCAbi
        this.report("NR206", annotationNode, "Function annotation '@cabi' cannot be repeated.")
      else
        sawCAbi = true
        if this.syntax.childCountAt(annotationNode) == 1
          let rawSymbol = this.syntax.dataAt(this.syntax.childAt(annotationNode, 0))

          if host.stringByteLength(rawSymbol) >= 2
            callable.cAbiSymbol = host.stringSlice(rawSymbol, 1, host.stringByteLength(rawSymbol) - 2)
          end
        end
        if callable.cAbiSymbol == ""
          this.report("NR210", annotationNode, "Annotation '@cabi' requires exactly one portable C symbol string.")
        end
        if !isUnsafe
          this.report("NR207", functionNode, "A '@cabi' declaration must use 'unsafe def'.")
        end
        if bodyCount > 0
          this.report("NR208", functionNode, "A '@cabi' declaration describes an external symbol and must have an empty body.")
        end
      end
      annotationIndex = annotationIndex + 1
    end
    if sawLibrary && !sawCAbi
      this.report("NR213", functionNode, "Annotation '@library' requires a C ABI import.")
    end
    var index = 0
    var sawDefault = false

    while index < parameterCount
      let parameterNode = this.syntax.childAt(functionNode, annotationCount + index)
      let parameterName = this.syntax.dataAt(parameterNode)
      let parameterType = this.resolveTypeNode(this.syntax.childAt(parameterNode, 0), namespaceName, "")

      this.validatePointerType(this.syntax.childAt(parameterNode, 0), isUnsafe)
      this.validatePointerElement(this.syntax.childAt(parameterNode, 0))
      let hasDefault = this.syntax.childCountAt(parameterNode) > 1

      if !hasDefault && sawDefault
        this.report("NR107A", parameterNode, "Parameter '" + parameterName + "' is missing a default value after a defaulted parameter.")
      end
      if hasDefault
        sawDefault = true
      end
      if this.findParameter(callable, parameterName) != null
        this.report("NR107", parameterNode, "Duplicate parameter '" + parameterName + "'.")
      end
      let identity = fullName + "/parameter[" + (index as String) + "]"

      callable.addParameter(new SemanticParameter(identity, parameterName, parameterType, hasDefault, parameterNode))
      this.recordDeclaration(identity, parameterName, parameterType, parameterNode)
      index = index + 1
    end
    if callable.intrinsicName != ""
      let intrinsic = semanticIntrinsic(this.model, callable.intrinsicName)
      var valid = false

      if intrinsic != null
        valid = intrinsic.linkName != "" && classSymbol == null && !isUnsafe && bodyCount == 0 && !sawCAbi && !sawLibrary && callable.returnType == intrinsic.resultType && callable.parameterCount == intrinsic.parameterTypes.Length
      end

      if intrinsic != null && callable.parameterCount == intrinsic.parameterTypes.Length
        index = 0
        while index < callable.parameterCount
          let parameter = callable.parameterAt(index)

          valid = false if parameter == null || parameter.typeName != intrinsic.parameterTypes[index] || parameter.hasDefault
          index = index + 1
        end
      end
      if !valid
        this.report("NR247", functionNode, "An intrinsic must be a safe empty-body module function with the exact registered parameter and result types and no defaults, C ABI, or library annotation.")
      end
    end
    if this.recordSourceSymbols
      var display = (callable.isAbstract ? "abstract " : "") + "def " + fullName + "("
      var parameter = callable.firstParameter
      var separator = ""

      while parameter != null
        display = display + separator + parameter.name + ": " + parameter.typeName
        separator = ", "
        parameter = parameter.nextParameter
      end
      display = display + "): " + returnType
      this.recordDeclaration("callable:" + fullName, name, returnType, functionNode, display)
    end
    return callable
  end

  def findParameter(callable: SemanticCallable, name: String): SemanticParameter?
    var parameter = callable.firstParameter

    while parameter != null
      if parameter.name == name
        return parameter
      end
      parameter = parameter.nextParameter
    end
    return null
  end

  def resolveInheritance(): Void
    var index = 0

    while index < this.classCount()
      let node = this.classNodeAt(index)
      let symbol = this.classForNode(node)
      let baseNode = this.classBaseNode(node)

      if symbol != null && baseNode >= 0
        let written = this.syntax.dataAt(baseNode)

        if semanticIsBuiltin(written) || semanticIsArray(written) || semanticIsOptional(written) || semanticIsPointer(written)
          this.report("NR159", baseNode, "Base type '" + written + "' must be a class.")
        else
          let resolved = semanticResolveType(this.model, written, symbol.namespaceName)

          if resolved == "Unknown"
            this.report("NR158", baseNode, "Base class '" + written + "' was not found.")
          else if resolved == symbol.fullName
            this.report("NR160", baseNode, "Class '" + symbol.name + "' cannot inherit from itself.")
          else
            let base = this.model.findClass(resolved)

            if base != null && base.isSealed
              this.report("NR159", baseNode, "Sealed class '" + resolved + "' cannot be inherited.")
            else if base != null && base.isAlternative
              this.report("NR260", baseNode, "Closed alternative type '" + resolved + "' cannot be inherited.")
            else if base != null && base.isResource
              this.report("NR262", baseNode, "Resource classes cannot be inherited.")
            else if symbol.isResource
              this.report("NR262", baseNode, "A resource class cannot inherit from another class.")
            else
              symbol.baseName = resolved
              this.recordTypeOccurrence(resolved, baseNode)
            end
          end
        end
      end
      index = index + 1
    end
    var current = this.model.firstClass

    while current != null
      if this.hasInheritanceCycle(current)
        this.report("NR161", current.syntaxNode, "Inheritance cycle detected for class '" + current.name + "'.")
        current.baseName = ""
      end
      current = current.nextClass
    end
  end

  def hasInheritanceCycle(classSymbol: SemanticClass): Bool
    var current = this.model.findClass(classSymbol.baseName)
    var steps = 0

    while current != null && steps < 256
      if current.fullName == classSymbol.fullName
        return true
      end
      current = this.model.findClass(current.baseName)
      steps = steps + 1
    end
    return false
  end

  def findBaseField(classSymbol: SemanticClass, name: String): SemanticField?
    var current = this.model.findClass(classSymbol.baseName)
    var steps = 0

    while current != null && steps < 256
      let field = this.findDeclaredField(current, name)

      if field != null
        return field
      end
      current = this.model.findClass(current.baseName)
      steps = steps + 1
    end
    return null
  end

  def findBaseMethod(classSymbol: SemanticClass, name: String): SemanticCallable?
    return semanticFindBaseMethod(this.model, classSymbol, name)
  end

  def compatibleMethods(left: SemanticCallable, right: SemanticCallable, sharedSignature: Bool = false): Bool
    # Only the synthetic shared-function subtype strengthens its invoke contract.
    let readonlyCompatible = left.isReadonly == right.isReadonly || (sharedSignature && left.isReadonly && !right.isReadonly)

    if left.access != right.access || left.isUnsafe != right.isUnsafe || !readonlyCompatible || left.returnType != right.returnType || left.parameterCount != right.parameterCount
      return false
    end
    var index = 0

    while index < left.parameterCount
      let leftParameter = left.parameterAt(index)
      let rightParameter = right.parameterAt(index)

      if leftParameter == null || rightParameter == null || leftParameter.typeName != rightParameter.typeName
        return false
      end
      index = index + 1
    end
    return true
  end

  def validateInheritedMembers(): Void
    var classSymbol = this.model.firstClass

    while classSymbol != null
      var field = classSymbol.firstField

      while field != null
        let inherited = this.findBaseField(classSymbol, field.name)

        if inherited != null
          this.report("NR178", field.syntaxNode, "Field '" + field.name + "' cannot redeclare the inherited field from '" + inherited.owner + "'.")
        end
        field = field.nextField
      end
      var method = classSymbol.firstMethod

      while method != null
        if method.name == "init"
          if method.hasOverride
            this.report("NR176", method.syntaxNode, "Constructor 'init' cannot use 'override'.")
          end
        else if method.isStatic && method.hasOverride
          this.report("NR175", method.syntaxNode, "Static method '" + method.name + "' cannot override or be overridden.")
        else
          let inherited = this.findBaseMethod(classSymbol, method.name)

          if inherited == null
            if method.hasOverride
              this.report("NR174", method.syntaxNode, "Method '" + method.name + "' uses 'override', but no compatible base method exists.")
            end
          else if method.isStatic || inherited.isStatic
            this.report("NR175", method.syntaxNode, "Static method '" + method.name + "' cannot override or be overridden.")
          else if !this.compatibleMethods(method, inherited, classSymbol.isFunctionType && classSymbol.isSharedFunction)
            this.report("NR177", method.syntaxNode, "Method '" + method.name + "' conflicts with an inherited method and must use the exact same signature and visibility.")
          end
        end
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
  end

  def registerFunctions(): Void
    var index = 0

    while index < this.functionCount()
      let node = this.functionNodeAt(index)

      if semanticField(this.syntax.dataAt(node), 1) == "main" && this.isForbiddenEntryPoint(node)
        this.report("NR_PROJECT_ENTRY", node, "Library sources cannot declare a 'main' entry point.")
        index = index + 1
        continue
      end
      if this.syntax.nodeAt(node).typeParameters.Length > 0
        index = index + 1
        continue
      end
      let data = this.syntax.dataAt(node)
      let namespaceName = semanticField(data, 0)
      let name = semanticField(data, 1)
      let fullName = semanticQualifiedName(namespaceName, name)
      let existing = this.model.findFunction(fullName)

      if existing != null && !(this.allowSessionEntryReplacement && fullName == "__neri_session_entry" && !this.model.ownsFunction(existing))
        this.report("NR105", node, "Function '" + name + "' is already defined.")
      else
        let callable = this.createCallable(node, null, "internal")

        this.model.addFunction(callable)
      end
      index = index + 1
    end
  end

  def isForbiddenEntryPoint(node: Int): Bool
    let source = this.sourceIdAt(this.syntax.irStartAt(node))
    var entry = this.forbiddenEntryPointSources.first.nextNode

    while entry != null
      if entry.value == source
        return true
      end
      entry = entry.nextNode
    end
    return false
  end

  def validateEntryPoint(): Void
    var mainCount = 0
    var current = this.model.firstFunction

    while current != null
      if current.name == "main"
        if current.namespaceName != ""
          this.report("NR165", current.syntaxNode, "Function 'main' cannot belong to namespace '" + current.namespaceName + "'.")
        else
          mainCount = mainCount + 1
          if mainCount > 1
            this.report("NR164", current.syntaxNode, "Program cannot define more than one top-level 'main' entry point.")
          end
          if current.parameterCount > 0
            this.report("NR166", current.syntaxNode, "Function 'main' must not declare parameters.")
          end
          if current.returnType != "Void"
            let returnNode = this.syntax.childAt(current.syntaxNode, semanticIntField(this.syntax.dataAt(current.syntaxNode), 2) + current.parameterCount)

            this.report("NR106", returnNode, "Function 'main' must return Void, not '" + current.returnType + "'.")
          end
        end
      end
      current = current.nextCallable
    end
    if mainCount == 0 && this.requireEntryPoint
      this.model.diagnostics.add("NR163", this.sourceLength, 1, "Program must define exactly one top-level 'main(): Void' entry point with no parameters.")
    end
  end
end
