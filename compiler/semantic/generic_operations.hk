def genericOperationArgument(syntax: SyntaxArena, annotation: Int): String
  if syntax.childCountAt(annotation) != 1
    return ""
  end
  let argument = syntax.childAt(annotation, 0)

  if !syntax.kindAt(argument).isStringLiteral()
    return ""
  end
  let written = syntax.dataAt(argument)

  if host.stringByteLength(written) < 2
    return ""
  end
  return host.stringSlice(written, 1, host.stringByteLength(written) - 2)
end

def genericOperationName(syntax: SyntaxArena, node: Int): String
  let declaration = syntax.declarationAt(node)

  if declaration == null
    return ""
  end
  let annotationCount = declaration.annotationCount
  var index = 0

  while index < annotationCount
    let annotation = syntax.childAt(node, index)

    if syntax.annotationAt(annotation).isOperation()
      return genericOperationArgument(syntax, annotation)
    end
    index = index + 1
  end
  return ""
end

def genericTaskGenerateShape(owner: BootstrapBinder, node: Int): Bool
  let syntax = owner.syntax
  let source = syntax.nodeAt(node)
  let data = semanticDeclaration(owner, node)

  if data == null
    return false
  end
  let annotationCount = data.annotationCount
  let parameterCount = data.parameterCount

  if annotationCount != 1 || source.typeParameters.Length != 1 || parameterCount != 3 || data.bodyCount != 0 || data.isStatic || data.isUnsafe
    return false
  end
  let elementType = source.typeParameters[0]
  let count = syntax.childAt(node, annotationCount)
  let parallelism = syntax.childAt(node, annotationCount + 1)
  let callback = syntax.childAt(node, annotationCount + 2)
  let result = syntax.childAt(node, annotationCount + parameterCount)

  if syntax.childCountAt(count) != 1 || syntax.dataAt(syntax.childAt(count, 0)) != "Int"
    return false
  end
  if syntax.childCountAt(parallelism) != 2 || syntax.dataAt(syntax.childAt(parallelism, 0)) != "Int"
    return false
  end
  let defaultValue = syntax.childAt(parallelism, 1)

  if !syntax.kindAt(defaultValue).isIntLiteral() || syntax.dataAt(defaultValue) != "0"
    return false
  end
  if syntax.childCountAt(callback) != 1
    return false
  end
  let callbackType = syntax.nodeAt(syntax.childAt(callback, 0))

  if callbackType.data != "parallel fn" || callbackType.children.Length != 2 || syntax.dataAt(callbackType.children[0]) != "Int" || syntax.dataAt(callbackType.children[1]) != elementType
    return false
  end
  return syntax.dataAt(result) == elementType + "[]"
end

def validateGenericOperations(owner: BootstrapBinder): Void
  var index = 0

  while index < owner.model.genericTemplates.size
    let node = owner.model.genericTemplates.get(index)

    if owner.syntax.kindAt(node).isFunction()
      let declaration = semanticDeclaration(owner, node)

      if declaration == null
        index = index + 1
        continue
      end
      let annotationCount = declaration.annotationCount
      var annotationIndex = 0
      var operationCount = 0
      var operationAnnotation = -1
      var operationName = ""

      while annotationIndex < annotationCount
        let annotation = owner.syntax.childAt(node, annotationIndex)

        if owner.syntax.annotationAt(annotation).isOperation()
          operationCount = operationCount + 1
          if operationAnnotation < 0
            operationAnnotation = annotation
            operationName = genericOperationArgument(owner.syntax, annotation)
          end
        end
        annotationIndex = annotationIndex + 1
      end
      if operationCount > 1
        owner.report("NR249", node, "Annotation '@operation' cannot be repeated.")
      else if operationCount == 1 && (operationName != "tasks.generate" || !genericTaskGenerateShape(owner, node))
        owner.report("NR249", operationAnnotation, "Annotation '@operation(\"tasks.generate\")' must be the sole annotation on a safe empty-body generic module function with signature (Int, Int = 0, parallel fn(Int): T): T[].")
      end
    end
    index = index + 1
  end
end

def genericOperationTemplate(body: BootstrapBodyBinder, callee: Int, operation: String): Int
  let name = genericCalleeName(body, callee)

  if name == ""
    return -1
  end
  let template = findGenericTemplate(body.owner, name, body.owner.currentNamespace, body.syntax().kinds.getFunction())

  if template < 0 || genericOperationName(body.syntax(), template) != operation
    return -1
  end
  return template
end
