## Fork shares the indexed tree in O(1). Appends copy only shared paths,
## while exclusive leaves stay mutable; indexed reads take O(log32 size).
class SemanticSequence<T>
  private root: SemanticSequenceNode<T>?
  private fallback: T
  private level: Int = 0
  private capacity: Int = 32
  public size: Int = 0

  def init(fallback: T, source: SemanticSequence<T>? = null): Void
    this.fallback = fallback
    if source != null
      this.root = source.root
      this.level = source.level
      this.capacity = source.capacity
      this.size = source.size
      let root = this.root

      root.shared = true if root != null
    end
  end

  def add(value: T): Void
    if this.size == this.capacity
      let expanded = new SemanticSequenceNode<T>()
      let previous = this.root

      previous.shared = true if previous != null
      expanded.setChild(0, previous)
      this.root = expanded
      this.level = this.level + 1
      this.capacity = this.capacity * 32
    end
    this.root = this.write(this.root, this.level, this.capacity / 32, this.size, value)
    this.size = this.size + 1
  end

  private def write(node: SemanticSequenceNode<T>?, depth: Int, span: Int, index: Int, value: T): SemanticSequenceNode<T>
    let writable = this.nodeForWrite(node)

    if depth == 0
      writable.setValue(index, value)
    else
      let slot = index / span
      let child = this.write(writable.childAt(slot), depth - 1, span / 32, index - slot * span, value)

      writable.setChild(slot, child)
    end
    return writable
  end

  private def nodeForWrite(node: SemanticSequenceNode<T>?): SemanticSequenceNode<T>
    if node == null
      return new SemanticSequenceNode<T>()
    end
    if node.shared
      return node.duplicate()
    end
    return node
  end

  def get(index: Int): T
    if index < 0 || index >= this.size
      return this.fallback
    end
    var node = this.root
    var remaining = index
    var depth = this.level
    var span = this.capacity / 32

    while node != null && depth > 0
      let slot = remaining / span

      node = node.childAt(slot)
      remaining = remaining - slot * span
      span = span / 32
      depth = depth - 1
    end
    if node != null
      return node.valueAt(remaining, this.fallback)
    end
    return this.fallback
  end
end
