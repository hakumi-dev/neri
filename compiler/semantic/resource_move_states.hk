sealed class ResourceMoveStates
  public available: readonly ResourceMoveState = ResourceMoveState.available()
  public maybeMoved: readonly ResourceMoveState = ResourceMoveState.maybeMoved()
  public moved: readonly ResourceMoveState = ResourceMoveState.moved()

  readonly def join(left: readonly ResourceMoveState, right: readonly ResourceMoveState): readonly ResourceMoveState
    if left.isMoved() && right.isMoved()
      return this.moved
    end
    if left.isAvailable() && right.isAvailable()
      return this.available
    end
    return this.maybeMoved
  end
end
