class SemanticClass
  public bodiesBound: Bool = false
  public genericOrigin: Int = -1
  public genericArguments: String[] = []
  public isFunctionType: Bool = false
  public quotedFunctionType: String = ""
  public fieldPackEntityType: String = ""
  public isSharedFunction: Bool = false
  public isParallelFunction: Bool = false
  public isClosure: Bool = false
  public isAlternative: Bool = false
  public isResource: Bool = false
  public isSealed: Bool = false
  public isAbstract: Bool = false
  private abstractValidationStarted: Bool = false
  public representation: String = ""
  public fullName: String = ""
  public name: String = ""
  public namespaceName: String = ""
  public access: readonly SourceAccess
  public baseName: String = ""
  public syntaxNode: Int = -1
  public firstField: SemanticField?
  public lastField: SemanticField?
  public firstMethod: SemanticCallable?
  public lastMethod: SemanticCallable?
  public firstAbstractRequirement: SemanticAbstractRequirement?
  public nextClass: SemanticClass?

  def init(fullName: String, name: String, namespaceName: String, access: readonly SourceAccess, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.access = access
    this.syntaxNode = syntaxNode
  end

  def addField(field: SemanticField): Void
    if this.firstField == null
      this.firstField = field
    else
      let last = this.lastField

      if last != null
        last.nextField = field
      end
    end
    this.lastField = field
  end

  def addMethod(method: SemanticCallable): Void
    if this.firstMethod == null
      this.firstMethod = method
    else
      let last = this.lastMethod

      if last != null
        last.nextCallable = method
      end
    end
    this.lastMethod = method
  end

  def addAbstractRequirement(requirement: SemanticAbstractRequirement): Void
    requirement.nextRequirement = this.firstAbstractRequirement
    this.firstAbstractRequirement = requirement
  end

  def beginAbstractValidation(): Bool
    if this.abstractValidationStarted
      return false
    end
    this.abstractValidationStarted = true
    return true
  end

end
