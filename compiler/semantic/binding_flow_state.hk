class BindingFlowState
  private locals: ValueBuffer<FlowNarrowing> = new ValueBuffer<FlowNarrowing>(new FlowNarrowing("", "", 0))
  private members: ValueBuffer<FlowNarrowing> = new ValueBuffer<FlowNarrowing>(new FlowNarrowing("", "", 0))
  private effects: IntBuffer = new IntBuffer()
  private depth: Int = 0
  public mutationEpoch: Int = 0

  def enterFlow(): Void
    this.depth = this.depth + 1
  end

  def leaveFlow(): Void
    this.leave(this.locals)
    this.leave(this.members)
    this.depth = this.depth - 1
  end

  private def leave(values: ValueBuffer<FlowNarrowing>): Void
    let cursor = values.cursor()

    while cursor.hasValue()
      let entry = cursor.current()

      entry.active = false if entry.depth == this.depth
      cursor.advance()
    end
  end

  private def lookup(values: ValueBuffer<FlowNarrowing>, identity: String, fallback: String): String
    var index = values.size - 1

    while index >= 0
      let entry = values.get(index)

      if entry.active && entry.depth <= this.depth && entry.identity == identity
        return entry.typeName
      end
      index = index - 1
    end
    return fallback
  end

  def variableType(name: String, fallback: String): String
    return this.lookup(this.locals, name, fallback)
  end

  def findMemberNarrowing(path: String): String
    return this.lookup(this.members, path, "")
  end

  def addNarrowing(name: String, typeName: String): Void
    this.locals.add(new FlowNarrowing(name, typeName, this.depth))
  end

  def addMemberNarrowing(path: String, typeName: String): Void
    this.members.add(new FlowNarrowing(path, typeName, this.depth))
  end

  def invalidateNarrowing(name: String): Void
    let cursor = this.locals.cursor()

    while cursor.hasValue()
      let entry = cursor.current()

      entry.active = false if entry.identity == name
      cursor.advance()
    end
    this.invalidateMemberNarrowings()
  end

  def invalidateMemberNarrowings(): Void
    this.mutationEpoch = this.mutationEpoch + 1
    let cursor = this.members.cursor()

    while cursor.hasValue()
      cursor.current().active = false
      cursor.advance()
    end
  end

  def memberFlowSnapshot(): BoolBuffer
    let result = new BoolBuffer()
    let cursor = this.members.cursor()

    while cursor.hasValue()
      result.add(cursor.current().active)
      cursor.advance()
    end
    return result
  end

  def restoreMemberFlows(snapshot: BoolBuffer): Void
    this.joinMemberFlows(snapshot, snapshot)
  end

  def joinMemberFlows(left: BoolBuffer, right: BoolBuffer): Void
    var index = 0

    while index < this.members.size
      this.members.get(index).active = index < left.count() && index < right.count() && left.get(index) && right.get(index)
      index = index + 1
    end
  end

  def memberConditionStable(node: Int): Bool
    var index = 0

    while index < this.effects.size
      if this.effects.get(index) == node
        return false
      end
      index = index + 1
    end
    return true
  end

  def recordEffect(node: Int): Void
    this.effects.add(node)
  end
end
