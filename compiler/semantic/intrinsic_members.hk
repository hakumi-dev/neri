class SemanticIntrinsicMember
  public id: String = ""
  public family: String = ""
  public name: String = ""
  public resultType: String = ""
  public opcode: Int = 0
  public effects: Int = 0

  def init(id: String, family: String, name: String, resultType: String, opcode: Int, effects: Int): Void
    this.id = id
    this.family = family
    this.name = name
    this.resultType = resultType
    this.opcode = opcode
    this.effects = effects
  end
end

def semanticIntrinsicMemberDefinitions(model: SemanticModel): SemanticIntrinsicMember[]
  let registry = model.intrinsics

  if registry != null
    return registry.members
  end
  return []
end

def semanticIntrinsicMembers(model: SemanticModel, receiverType: String): SemanticIntrinsicMember[]
  if semanticIsArray(receiverType)
    return semanticIntrinsicMemberDefinitions(model)
  end
  return []
end

def semanticIntrinsicMember(model: SemanticModel, receiverType: String, name: String): SemanticIntrinsicMember?
  for member in semanticIntrinsicMembers(model, receiverType)
    if member.name == name
      return member
    end
  end
  return null
end

def semanticIntrinsicMemberById(model: SemanticModel, id: String): SemanticIntrinsicMember?
  for member in semanticIntrinsicMemberDefinitions(model)
    if member.id == id
      return member
    end
  end
  return null
end
