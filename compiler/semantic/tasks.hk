# Result context supplies the parallel callback signature before capture binding.
def bindTaskGenerate(body: BootstrapBodyBinder, node: Int, expectedType: String): BoundValue?
  let syntax = body.syntax()
  let callee = syntax.childAt(node, 0)
  let name = genericCalleeName(body, callee)
  let template = genericOperationTemplate(body, callee, "tasks.generate")
  let legacy = template < 0 && name == "tasks.generate" && body.model().findFunction(name) == null && findGenericTemplateReadOnly(body.model(), syntax, name, body.owner.currentNamespace, syntax.kinds.getFunction()) == -1

  if template < 0 && !legacy
    return null
  end
  if template >= 0
    body.owner.recordOccurrence("callable:" + genericName(body.owner, template), callee)
  end
  if legacy
    if !body.model().hasUse("tasks")
      body.report("NR102", callee, "Library 'tasks' is not imported.")
    end
    body.model().referenceUse("tasks")
  end
  let count = syntax.childCountAt(node) - 1

  if count != 2 && count != 3
    body.report("NR111", callee, "Task generation expects a count, optional parallelism, and a parallel callback.")
    return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
  end
  let explicit = syntax.nodeAt(callee).typeArguments
  var result = semanticIsArray(expectedType) ? semanticInnerType(expectedType) : ""

  if explicit.Length == 1
    result = body.owner.resolveTypeNode(explicit[0], body.owner.currentNamespace, "")
  else if explicit.Length > 1
    body.report("NR220", callee, "Task generation accepts one result type argument.")
  end
  let callbackNode = syntax.childAt(node, count)
  var callback: BoundValue? = null

  if result == ""
    if syntax.kindAt(callbackNode).isClosure()
      let resultNode = syntax.childAt(callbackNode, semanticIntField(syntax.dataAt(callbackNode), 0))

      if syntax.dataAt(resultNode) != ""
        result = body.owner.resolveTypeNode(resultNode, body.owner.currentNamespace, "")
      end
    else
      let name = genericCalleeName(body, callbackNode)
      let function = body.resolveFunction(name)

      if function != null
        result = function.returnType
      else if name == ""
        let value = body.bindExpression(callbackNode, "")

        callback = value
        let signature = semanticExpectedFunction(body, value.typeName)

        if signature != null
          let invoke = signature.firstMethod

          result = invoke.returnType if invoke != null
        end
      end
    end
  end
  if !semanticArrayElement(body.model(), result)
    body.report("NR242", node, "Task generation requires a safe array element type from a result annotation, type argument, or typed callback.")
    return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
  end
  let parameters = new StringBuffer()

  parameters.add("Int")
  let signature = semanticFunctionType(body.owner, parameters, result, node, true, true)
  let lengthNode = syntax.childAt(node, 1)
  let length = body.bindExpression(lengthNode, "Int")

  if length.typeName != "Int"
    body.report("NR112", lengthNode, "Task count must be Int.")
  end
  var parallelism = body.addBoundValue(body.boundKinds().getIntLiteral(), "Int", "", "i:0", node, emptyInts())

  if count == 3
    let workersNode = syntax.childAt(node, 2)
    let workers = body.bindExpression(workersNode, "Int")

    parallelism = workers.boundNode
    if workers.typeName != "Int"
      body.report("NR112", workersNode, "Task parallelism must be Int.")
    end
  end
  callback = body.bindExpression(callbackNode, signature.fullName) if callback == null
  if callback != null
    if !semanticAssignable(body.model(), signature.fullName, callback.typeName)
      body.report("NR112", callbackNode, "Task generation requires a parallel fn(Int): " + result + " callback.")
    end
    let children: Int[] = [length.boundNode, parallelism, callback.boundNode]

    return new BoundValue(result + "[]", body.addBound(body.boundKinds().getTaskGenerate(), result + "[]", signature.fullName, node, children))
  end
  return new BoundValue("Error", body.addBound(body.boundKinds().getErrorExpression(), "Error", "", node, emptyInts()))
end
