use host

class SemanticContract
  public fullName: String
  public name: String
  public namespaceName: String
  public syntaxNode: Int
  public firstRequirement: SemanticCallable?
  public lastRequirement: SemanticCallable?
  public nextContract: SemanticContract?

  def init(fullName: String, name: String, namespaceName: String, syntaxNode: Int): Void
    this.fullName = fullName
    this.name = name
    this.namespaceName = namespaceName
    this.syntaxNode = syntaxNode
  end

  def addRequirement(requirement: SemanticCallable): Void
    let last = this.lastRequirement

    if last == null
      this.firstRequirement = requirement
    else
      last.nextCallable = requirement
    end
    this.lastRequirement = requirement
  end
end

def semanticContractCount(owner: BootstrapBinder): Int
  return semanticIntField(owner.syntax.dataAt(owner.root), 4)
end

def semanticContractNode(owner: BootstrapBinder, index: Int): Int
  return owner.syntax.childAt(owner.root, owner.useCount() + owner.classCount() + owner.functionCount() + nativeRecordCount(owner) + index)
end

def semanticContractRequirement(contract: SemanticContract, name: String): SemanticCallable?
  var requirement = contract.firstRequirement

  while requirement != null
    if requirement.operatorName == "" && requirement.name == name
      return requirement
    end
    requirement = requirement.nextCallable
  end
  return null
end

def semanticContractLabel(contract: SemanticContract, name: String): SemanticCallable?
  var requirement = contract.firstRequirement

  while requirement != null
    if requirement.name == name
      return requirement
    end
    requirement = requirement.nextCallable
  end
  return null
end

def semanticContractOperator(contract: SemanticContract, operation: String, arity: Int): SemanticCallable?
  var requirement = contract.firstRequirement

  while requirement != null
    if requirement.operatorName == operation && requirement.parameterCount == arity
      return requirement
    end
    requirement = requirement.nextCallable
  end
  return null
end

def semanticContractSubstitute(typeName: String, selfType: String): String
  var base = typeName

  while semanticIsArray(base) || semanticIsOptional(base) || semanticIsPointer(base)
    base = semanticInnerType(base)
  end
  if base != "Self"
    return typeName
  end
  return selfType + host::stringSlice(typeName, host::stringByteLength(base), host::stringByteLength(typeName) - host::stringByteLength(base))
end

def semanticContractCallable(requirement: SemanticCallable, receiverType: String): SemanticCallable
  let result = new SemanticCallable(requirement.fullName, requirement.name, requirement.namespaceName, receiverType,
    semanticContractSubstitute(requirement.returnType, receiverType), false, false, requirement.access, requirement.syntaxNode)

  result.isReadonly = requirement.isReadonly
  result.operatorName = requirement.operatorName
  result.exactArguments = true
  var parameter = requirement.firstParameter

  while parameter != null
    result.addParameter(new SemanticParameter(parameter.identity, parameter.name, semanticContractSubstitute(parameter.typeName, receiverType), false, parameter.syntaxNode, parameter.mode))
    parameter = parameter.nextParameter
  end
  return result
end

def semanticTypeParameterContract(model: SemanticModel, typeName: String): SemanticContract?
  let parameter = model.findTypeParameter(semanticMutableType(typeName))

  if parameter == null || parameter.capability == ""
    return null
  end
  return model.findContract(parameter.capability)
end

def semanticTypeParameterMethod(model: SemanticModel, receiverType: String, name: String): SemanticCallable?
  let contract = semanticTypeParameterContract(model, receiverType)

  if contract == null
    return null
  end
  let requirement = semanticContractRequirement(contract, name)

  return null if requirement == null || (semanticIsReadonly(receiverType) && !requirement.isReadonly)
  return semanticContractCallable(requirement, receiverType)
end

def semanticTypeParameterOperator(model: SemanticModel, receiverType: String, operation: String, arity: Int): SemanticCallable?
  let contract = semanticTypeParameterContract(model, receiverType)

  if contract == null
    return null
  end
  let requirement = semanticContractOperator(contract, operation, arity)

  return null if requirement == null || (semanticIsReadonly(receiverType) && !requirement.isReadonly)
  return semanticContractCallable(requirement, receiverType)
end

def semanticContractType(owner: BootstrapBinder, node: Int, namespaceName: String): String
  let written = owner.syntax.dataAt(node)
  var base = written

  while semanticIsArray(base) || semanticIsOptional(base) || semanticIsPointer(base)
    base = semanticInnerType(base)
  end
  if base == "Self"
    if owner.syntax.nodeAt(node).typeArguments.Length > 0
      owner.report("NR252", node, "Contract Self types cannot have type arguments.")
      return "Error"
    end
    return "Self" + host::stringSlice(written, host::stringByteLength(base), host::stringByteLength(written) - host::stringByteLength(base))
  end
  if semanticContractNestedSelf(owner, node)
    owner.report("NR252", node, "Contract Self may be used directly or with array and optional wrappers, not inside another generic or function type.")
    return "Error"
  end
  return owner.resolveTypeNode(node, namespaceName, "")
end

def semanticContractNestedSelf(owner: BootstrapBinder, node: Int): Bool
  if owner.syntax.dataAt(node) == "Self"
    return true
  end
  for argument in owner.syntax.nodeAt(node).typeArguments
    if semanticContractNestedSelf(owner, argument)
      return true
    end
  end
  var index = 0

  while index < owner.syntax.childCountAt(node)
    if semanticContractNestedSelf(owner, owner.syntax.childAt(node, index))
      return true
    end
    index = index + 1
  end
  return false
end

def semanticContractOperation(owner: BootstrapBinder, annotation: Int): String
  if !owner.syntax.annotationAt(annotation).isOperator() || owner.syntax.childCountAt(annotation) != 1
    return ""
  end
  let written = owner.syntax.dataAt(owner.syntax.childAt(annotation, 0))

  if host::stringByteLength(written) < 2
    return ""
  end
  return host::stringSlice(written, 1, host::stringByteLength(written) - 2)
end

def registerContractNames(owner: BootstrapBinder): Void
  var index = 0

  while index < semanticContractCount(owner) && owner.checkpoint()
    let node = semanticContractNode(owner, index)
    let data = semanticDeclaration(owner, node)

    if data == null
      index = index + 1
      continue
    end
    let namespaceName = data.namespaceName
    let name = data.name
    let fullName = semanticQualifiedName(namespaceName, name)
    var duplicate = semanticReservedTypeName(name) || name == "Self" || owner.model.findContract(fullName) != null || owner.model.findClass(fullName) != null || owner.model.findRecord(fullName) != null
    var declaration = 0

    while declaration < owner.classCount() && owner.checkpoint()
      let candidate = owner.classNodeAt(declaration)
      let candidateData = semanticDeclaration(owner, candidate)

      if candidateData != null && semanticQualifiedName(candidateData.namespaceName, candidateData.name) == fullName
        duplicate = true
      end
      declaration = declaration + 1
    end
    declaration = 0
    while declaration < nativeRecordCount(owner) && owner.checkpoint()
      let candidate = nativeRecordNode(owner, declaration)
      let candidateData = semanticDeclaration(owner, candidate)

      if candidateData != null && semanticQualifiedName(candidateData.namespaceName, candidateData.name) == fullName
        duplicate = true
      end
      declaration = declaration + 1
    end

    if duplicate
      owner.report("NR252", node, "Contract '" + fullName + "' conflicts with an existing type declaration.")
    else
      owner.model.addContract(new SemanticContract(fullName, name, namespaceName, node))
      owner.recordDeclaration("contract:" + fullName, name, fullName, node, "contract " + fullName, 11)
    end
    index = index + 1
  end
end

def registerContractRequirements(owner: BootstrapBinder): Void
  var contract = owner.model.firstContract

  while contract != null && owner.checkpoint()
    if owner.model.ownsContract(contract)
      var index = 0

      while index < owner.syntax.childCountAt(contract.syntaxNode) && owner.checkpoint()
        let method = owner.syntax.childAt(contract.syntaxNode, index)
        let declaration = semanticDeclaration(owner, method)

        if declaration == null
          index = index + 1
          continue
        end
        let access = declaration.access
        let annotationCount = declaration.annotationCount
        let functionNode = owner.syntax.childAt(method, annotationCount)
        let data = semanticDeclaration(owner, functionNode)

        if data == null
          index = index + 1
          continue
        end
        let name = data.name
        let parameterCount = data.parameterCount
        let bodyCount = data.bodyCount
        let isStatic = data.isStatic
        let isUnsafe = data.isUnsafe
        let returnNode = owner.syntax.childAt(functionNode, parameterCount)
        let callable = new SemanticCallable(contract.fullName + "." + name, name, contract.namespaceName, "Self",
          semanticContractType(owner, returnNode, contract.namespaceName), isStatic, isUnsafe, access, functionNode)
        var annotationIndex = 0
        var valid = name != "init" && access.isPublic() && !isStatic && !isUnsafe && bodyCount == 0 && owner.syntax.nodeAt(functionNode).typeParameters.Length == 0

        callable.isReadonly = syntaxHasModifier(owner.syntax, functionNode, owner.syntax.modifiers.getReadonly())
        for modifier in owner.syntax.nodeAt(functionNode).modifiers
          let kind = owner.syntax.nodeAt(modifier).modifierKind

          valid = false if kind == null || (!kind.isReadonly() && !kind.isPublic())
        end
        valid = false if semanticContractNestedSelf(owner, returnNode) && callable.returnType == "Error"

        while annotationIndex < annotationCount
          let annotation = owner.syntax.childAt(method, annotationIndex)

          if owner.syntax.annotationAt(annotation).isOperator() && callable.operatorName == ""
            callable.operatorName = semanticContractOperation(owner, annotation)
            valid = false if callable.operatorName == ""
          else
            valid = false
          end
          annotationIndex = annotationIndex + 1
        end
        var parameterIndex = 0

        while parameterIndex < parameterCount
          let parameterNode = owner.syntax.childAt(functionNode, parameterIndex)
          let typeName = semanticContractType(owner, owner.syntax.childAt(parameterNode, 0), contract.namespaceName)

          if owner.syntax.nodeAt(parameterNode).parameterMode.isLabels()
            owner.report("NR277", parameterNode, "Labels parameters require an ordinary function or method declaration.")
            valid = false
          end

          valid = false if owner.syntax.childCountAt(parameterNode) > 1 || typeName == "Error" || semanticContainsPointer(typeName)
          callable.addParameter(new SemanticParameter(callable.fullName + "/parameter[" + (parameterIndex as String) + "]",
              owner.syntax.dataAt(parameterNode), typeName, false, parameterNode, owner.model.parameterModes.getOrdinary()))
          parameterIndex = parameterIndex + 1
        end
        valid = false if callable.returnType == "Error" || semanticContainsPointer(callable.returnType) || callable.returnType == "Void" && callable.operatorName != ""
        valid = false if semanticContractLabel(contract, name) != null
        if callable.operatorName != ""
          let comparison = callable.operatorName == "==" || callable.operatorName == "!=" || callable.operatorName == "<" || callable.operatorName == "<=" || callable.operatorName == ">" || callable.operatorName == ">=" || callable.operatorName == "!"
          let expectedReturn = comparison ? "Bool" : "Self"
          let supported = callable.operatorName == "+" || callable.operatorName == "-" || callable.operatorName == "*" || callable.operatorName == "/" || callable.operatorName == "==" || callable.operatorName == "!=" || callable.operatorName == "<" || callable.operatorName == "<=" || callable.operatorName == ">" || callable.operatorName == ">=" || callable.operatorName == "!"

          valid = false if !supported
          valid = false if semanticContractOperator(contract, callable.operatorName, parameterCount) != null
          valid = false if callable.returnType != expectedReturn
          let operand = callable.firstParameter

          valid = false if parameterCount > 1 || (parameterCount == 0 && callable.operatorName != "+" && callable.operatorName != "-" && callable.operatorName != "!") || (parameterCount == 1 && (callable.operatorName == "!" || operand == null))
          if parameterCount == 1 && operand != null
            valid = false if operand.typeName != "Self"
          end
        end
        if !valid
          owner.report("NR252", method, "A contract requirement must be a unique public safe instance signature without a body, defaults, static or generic modifiers, and may use only the 'readonly' modifier or a supported '@operator' annotation.")
        else
          contract.addRequirement(callable)
          owner.recordDeclaration("contract-member:" + callable.fullName, name, callable.returnType, functionNode, semanticCompletionCallableDetail(callable), 6)
        end
        index = index + 1
      end
      if contract.firstRequirement == null
        owner.report("NR252", contract.syntaxNode, "A contract must declare at least one valid requirement.")
      end
    end
    contract = contract.nextContract
  end
end
