class SemanticModel
  public irDomains: IrDomainCatalog = new IrDomainCatalog()
  public parent: SemanticModel?
  public syntax: SyntaxArena?
  public declarations: SemanticDeclaration?
  public occurrences: SemanticOccurrence?
  public completionSites: SemanticCompletionSite?
  public firstRecord: NativeRecord?
  public lastRecord: NativeRecord?
  public firstContract: SemanticContract?
  public lastContract: SemanticContract?

  def addContract(contract: SemanticContract): Void
    let last = this.lastContract

    if last == null
      this.firstContract = contract
    else
      last.nextContract = contract
    end
    this.lastContract = contract
  end

  def findContract(name: String): SemanticContract?
    var contract = this.firstContract

    while contract != null
      if contract.fullName == name
        return contract
      end
      contract = contract.nextContract
    end
    let parent = this.parent

    if parent != null
      return parent.findContract(name)
    end
    return null
  end

  def ownsContract(value: SemanticContract): Bool
    var contract = this.firstContract

    while contract != null
      if contract.fullName == value.fullName && contract.syntaxNode == value.syntaxNode
        return true
      end
      contract = contract.nextContract
    end
    return false
  end

  def findRecord(name: String): NativeRecord?
    var record = this.firstRecord

    while record != null
      if record.name == name
        return record
      end
      record = record.nextRecord
    end
    let parent = this.parent

    if parent != null
      return parent.findRecord(name)
    end
    return null
  end
  public genericTemplates: IntBuffer = new IntBuffer()
  public genericInstances: Int = 0
  public genericDepth: Int = 0
  public nextClosureId: Int = 0
  public firstClass: SemanticClass?
  public lastClass: SemanticClass?
  public firstFunction: SemanticCallable?
  public lastFunction: SemanticCallable?
  private classesByName: StringTable<SemanticClass> = new StringTable<SemanticClass>()
  private functionsByName: StringTable<SemanticCallable> = new StringTable<SemanticCallable>()
  private indexedClass: SemanticClass?
  private indexedFunction: SemanticCallable?
  public usedNames: StringBuffer = new StringBuffer()
  public referencedUseNames: StringBuffer = new StringBuffer()
  public declaredNamespaces: StringBuffer = new StringBuffer()
  public diagnostics: DiagnosticBuffer = new DiagnosticBuffer()
  public bound: BoundArena = new BoundArena()
  public intrinsics: SemanticIntrinsicRegistry?
  public typeParameters: SemanticTypeParameter?

  def addTypeParameter(parameter: SemanticTypeParameter): Void
    parameter.next = this.typeParameters
    this.typeParameters = parameter
  end

  def findTypeParameter(name: String): SemanticTypeParameter?
    var parameter = this.typeParameters

    while parameter != null
      if parameter.name == name
        return parameter
      end
      parameter = parameter.next
    end
    let parent = this.parent

    if parent != null
      return parent.findTypeParameter(name)
    end
    return null
  end

  public parameterModes: ParameterModeCatalog
  public accesses: SourceAccessCatalog

  def init(parent: SemanticModel? = null, parameterModes: ParameterModeCatalog? = null, accesses: SourceAccessCatalog? = null): Void
    if accesses != null
      this.accesses = accesses
    else if parent != null
      this.accesses = parent.accesses
    else
      this.accesses = new SourceAccessCatalog()
    end
    if parameterModes != null
      this.parameterModes = parameterModes
    else if parent != null
      this.parameterModes = parent.parameterModes
    else
      this.parameterModes = new ParameterModeCatalog()
    end
    this.parent = parent
    if parent != null
      this.intrinsics = parent.intrinsics
      this.genericInstances = parent.genericInstances
      this.nextClosureId = parent.nextClosureId
      var index = 0

      while index < parent.usedNames.size
        this.usedNames.add(parent.usedNames.get(index))
        index = index + 1
      end
      index = 0
      while index < parent.genericTemplates.size
        this.genericTemplates.add(parent.genericTemplates.get(index))
        index = index + 1
      end
      index = 0
      while index < parent.declaredNamespaces.size
        this.declaredNamespaces.add(parent.declaredNamespaces.get(index))
        index = index + 1
      end
    else
      this.intrinsics = new SemanticIntrinsicRegistry(this.irDomains)
    end
  end

  def addClass(symbol: SemanticClass): Void
    if this.firstClass == null
      this.firstClass = symbol
    else
      let last = this.lastClass

      if last != null
        last.nextClass = symbol
      end
    end
    this.lastClass = symbol
  end

  def addFunction(symbol: SemanticCallable): Void
    if this.firstFunction == null
      this.firstFunction = symbol
    else
      let last = this.lastFunction

      if last != null
        last.nextCallable = symbol
      end
    end
    this.lastFunction = symbol
  end

  def findClass(fullName: String): SemanticClass?
    # Index appended declarations, including lists adopted by session initializers.
    let indexed = this.indexedClass
    var current = this.firstClass

    current = indexed.nextClass if indexed != null
    while current != null
      this.classesByName.add(current.fullName, current)
      this.indexedClass = current
      current = current.nextClass
    end
    let entry = this.classesByName.find(fullName)

    if entry != null
      return entry.value
    end
    let parent = this.parent

    if parent != null
      return parent.findClass(fullName)
    end
    return null
  end

  def findFunction(fullName: String): SemanticCallable?
    let indexed = this.indexedFunction
    var current = this.firstFunction

    current = indexed.nextCallable if indexed != null
    while current != null
      this.functionsByName.add(current.fullName, current)
      this.indexedFunction = current
      current = current.nextCallable
    end
    let entry = this.functionsByName.find(fullName)

    if entry != null
      return entry.value
    end
    let parent = this.parent

    if parent != null
      return parent.findFunction(fullName)
    end
    return null
  end

  def hasUse(name: String): Bool
    var index = 0

    while index < this.usedNames.size
      if this.usedNames.get(index) == name
        return true
      end
      index = index + 1
    end
    let parent = this.parent

    if parent != null
      return parent.hasUse(name)
    end
    return false
  end

  def ownsClass(symbol: SemanticClass): Bool
    var current = this.firstClass

    while current != null
      if current.fullName == symbol.fullName
        return true
      end
      current = current.nextClass
    end
    return false
  end

  def ownsFunction(symbol: SemanticCallable): Bool
    var current = this.firstFunction

    while current != null
      if current.fullName == symbol.fullName
        return true
      end
      current = current.nextCallable
    end
    return false
  end

  def referenceUse(name: String): Void
    if !this.hasUse(name)
      return
    end
    var index = 0

    while index < this.referencedUseNames.size
      if this.referencedUseNames.get(index) == name
        return
      end
      index = index + 1
    end
    this.referencedUseNames.add(name)
  end

  def referenceQualifiedUse(fullName: String): Void
    var index = 0

    while index < this.usedNames.size
      let name = this.usedNames.get(index)

      if fullName == name || bootstrapStartsWith(fullName, name + ".")
        this.referenceUse(name)
      end
      index = index + 1
    end
  end

  def useReferenced(name: String): Bool
    var index = 0

    while index < this.referencedUseNames.size
      if this.referencedUseNames.get(index) == name
        return true
      end
      index = index + 1
    end
    return false
  end
end
