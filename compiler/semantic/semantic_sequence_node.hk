use arrays

class SemanticSequenceNode<T>
  public shared: Bool = false
  private children: SemanticSequenceNode<T>?[] = []
  private values: T[] = []

  def childAt(index: Int): SemanticSequenceNode<T>?
    return this.children.Length == 0 ? null : this.children[index]
  end

  def valueAt(index: Int, fallback: T): T
    return this.values.Length == 0 ? fallback : this.values[index]
  end

  def setChild(index: Int, value: SemanticSequenceNode<T>?): Void
    if this.children.Length == 0
      this.children = arrays::generate<SemanticSequenceNode<T>?>(32) do |position|
        return null
      end
    end
    this.children[index] = value
  end

  def setValue(index: Int, value: T): Void
    if this.values.Length == 0
      this.values = arrays::generate<T>(32) do |position|
        return value
      end
    end
    this.values[index] = value
  end

  def duplicate(): SemanticSequenceNode<T>
    let copy = new SemanticSequenceNode<T>()

    if this.children.Length != 0
      copy.children = arrays::generate<SemanticSequenceNode<T>?>(32) do |index|
        let child = this.children[index]

        # Both parents now reach this child, so later writes must copy its path.
        child.shared = true if child != null
        return child
      end
    end
    if this.values.Length != 0
      copy.values = arrays::generate<T>(32) do |index|
        return this.values[index]
      end
    end
    return copy
  end
end
