class SemanticTypeParameter
  public name: String
  public capability: String
  public next: SemanticTypeParameter?

  def init(name: String, capability: String): Void
    this.name = name
    this.capability = capability
  end
end

def semanticFindContract(model: SemanticModel, written: String, namespaceName: String): SemanticContract?
  let qualified = semanticIsQualifiedName(written)
  var result = model.findContract(qualified ? model.resolveQualifiedName(written) : semanticQualifiedName(
      namespaceName,
      written
    ))

  if result == null && !qualified
    result = model.findContract(written)
  end
  if result != null || qualified
    return result
  end
  var index = 0

  while index < model.usedNames.size
    let candidate = model.findContract(semanticQualifiedName(model.usedNames.get(index), written))

    if candidate != null
      return null if result != null
      result = candidate
    end
    index = index + 1
  end
  return result
end

def semanticResolveContract(
  owner: BootstrapBinder,
  written: String,
  namespaceName: String,
  node: Int
): SemanticContract?
  let result = semanticFindContract(owner.model, written, namespaceName)

  if result == null
    owner.report("NR250", node, "Unknown or ambiguous generic contract '" + written + "'.")
    return null
  end
  if !semanticIsQualifiedName(written) && result.fullName != written && result.fullName != semanticQualifiedName(
    namespaceName,
    written
  )
    owner.model.referenceUse(semanticNamespacePrefix(result.fullName))
  end
  owner.recordNamespaceQualifier(written, node)
  owner.recordOccurrence("contract:" + result.fullName, node)
  return result
end

def semanticBoundDependsOnParameter(syntax: SyntaxArena, node: Int, parameters: String[]): Bool
  let type = syntax.nodeAt(node)

  if !type.kind.isType()
    return false
  end
  if type.typeSyntax.kind.isNominal()
    for name in parameters
      return true if type.typeSyntax.name == name
    end
  end
  for argument in type.typeArguments
    return true if semanticBoundDependsOnParameter(syntax, argument, parameters)
  end
  for child in type.children
    return true if semanticBoundDependsOnParameter(syntax, child, parameters)
  end
  return false
end

def semanticGenericCapability(
  owner: BootstrapBinder,
  template: Int,
  index: Int,
  report: Bool,
  namespaceOverride: String = ""
): String
  let constraints = owner.syntax.nodeAt(template).typeParameterConstraints

  return "" if index < 0 || index >= constraints.Length || constraints[index] < 0
  let node = constraints[index]
  let bound = owner.syntax.nodeAt(node)
  let declaration = semanticDeclaration(owner, template)

  if declaration == null
    return ""
  end
  let namespaceName = namespaceOverride != "" ? namespaceOverride : declaration.namespaceName

  if report && owner.recordCompletionSites
    let site = new SemanticCompletionSite()

    site.start = owner.syntax.startAt(node)
    site.length = owner.syntax.lengthAt(node)
    site.namespaceName = namespaceName
    site.receiverKind = "constraint"
    site.next = owner.model.completionSites
    owner.model.completionSites = site
  end

  if !bound.kind.isType() || !bound.typeSyntax.kind.isNominal() || bound.typeSyntax.suffixes != null || bound.children.Length != 1 || !owner.syntax.kindAt(bound.children[0]).isQualifiedName()
    if report
      owner.report(
        "NR250",
        node,
        "A generic constraint names one structural contract or nominal interface."
      )
    end
    return ""
  end
  if semanticBoundDependsOnParameter(owner.syntax, node, owner.syntax.nodeAt(template).typeParameters)
    owner.report("NR250", node, "A generic interface constraint requires concrete type arguments.") if report
    return ""
  end
  let written = bound.typeSyntax.name

  if bound.typeArguments.Length == 0
    let contract = semanticFindContract(owner.model, written, namespaceName)

    if contract != null
      semanticResolveContract(owner, written, namespaceName, node) if report
      return contract.fullName
    end
    let resolved = semanticResolveType(owner.model, written, namespaceName)
    let interfaceType = owner.model.findClass(resolved)

    if interfaceType != null && interfaceType.isInterface
      owner.resolveTypeNode(node, namespaceName, "") if report
      return resolved
    end
    semanticResolveContract(owner, written, namespaceName, node) if report
    return ""
  end
  let target = findGenericTemplate(owner, written, namespaceName, owner.syntax.kinds.getClass())
  let interfaceDeclaration = target < 0 ? null : semanticDeclaration(owner, target)

  if interfaceDeclaration == null || !interfaceDeclaration.isInterface
    owner.report("NR250", node, "A parameterized generic constraint must name a nominal interface.") if report
    return ""
  end
  let resolved = owner.resolveTypeNode(node, namespaceName, "")

  return resolved == "Error" ? "" : resolved
end

def semanticHasGenericConstraints(owner: BootstrapBinder, template: Int): Bool
  for constraint in owner.syntax.nodeAt(template).typeParameterConstraints
    return true if constraint >= 0
  end
  return false
end

def semanticGenericConstraintsValid(
  owner: BootstrapBinder,
  template: Int,
  report: Bool = true,
  namespaceOverride: String = ""
): Bool
  return true if !semanticHasGenericConstraints(owner, template)
  let source = owner.syntax.nodeAt(template)
  let declaration = semanticDeclaration(owner, template)
  let constrainedClass = source.kind.isClass() && declaration != null && !declaration.isAlternative

  if !constrainedClass && (!source.kind.isFunction() || genericOperationName(owner.syntax, template) != "")
    if report
      owner.report(
        "NR250",
        template,
        "Only generic classes and module functions can declare contracts. Compiler operations have fixed signatures."
      )
    end
    return false
  end
  var valid = true
  var index = 0

  while index < source.typeParameterConstraints.Length
    if source.typeParameterConstraints[index] >= 0 && semanticGenericCapability(
      owner,
      template,
      index,
      report,
      namespaceOverride
    ) == ""
      valid = false
    end
    index = index + 1
  end
  return valid
end

def validatePendingClassConstraints(owner: BootstrapBinder): Void
  var pending = owner.pendingClassConstraints

  owner.pendingClassConstraints = null
  while pending != null && owner.checkpoint()
    let arguments = new StringBuffer()

    for argument in pending.specialization.genericArguments
      arguments.add(argument)
    end
    pending.specialization.genericConstraintsRejected = !semanticCheckGenericConstraints(
      owner,
      pending.specialization.genericOrigin,
      arguments,
      pending.node
    )
    pending = pending.next
  end
end

def semanticFindContractMethod(model: SemanticModel, typeName: String, name: String, arity: Int): SemanticCallable?
  let abstract = semanticTypeParameterMethod(model, typeName, name)

  if abstract != null && abstract.parameterCount == arity
    return abstract
  end
  let owner = model.findClass(semanticMutableType(typeName))

  return null if owner == null
  return owner.isAbstract ? semanticFindInterfaceMethod(
    model,
    owner,
    name
  ) : semanticFindClassMethod(
    model,
    owner,
    name
  )
end

def semanticRequirementMatches(requirement: SemanticCallable, implementation: SemanticCallable, typeName: String): Bool
  return false if !implementation.access.isPublic() || implementation.isStatic || implementation.isUnsafe || implementation.parameterCount != requirement.parameterCount
  return false if implementation.returnType != semanticContractSubstitute(requirement.returnType, typeName) || (requirement.isReadonly && !implementation.isReadonly) || (semanticIsReadonly(typeName) && !implementation.isReadonly)
  var expected = requirement.firstParameter
  var actual = implementation.firstParameter

  while expected != null && actual != null
    return false if actual.typeName != semanticContractSubstitute(expected.typeName, typeName) || !actual.mode.same(expected.mode)
    expected = expected.nextParameter
    actual = actual.nextParameter
  end
  return expected == null && actual == null
end

def semanticTypeSatisfiesContract(model: SemanticModel, typeName: String, contract: SemanticContract): Bool
  var requirement = contract.firstRequirement

  while requirement != null
    if requirement.operatorName != ""
      let builtin = semanticBuiltinOperatorResult(typeName, requirement.operatorName, requirement.parameterCount)

      if builtin != ""
        return false if builtin != semanticContractSubstitute(requirement.returnType, typeName)
      else
        let implementation = semanticOperatorMethod(
          model,
          typeName,
          requirement.operatorName,
          requirement.parameterCount
        )

        return false if implementation == null || !semanticRequirementMatches(requirement, implementation, typeName)
      end
    else
      let implementation = semanticFindContractMethod(model, typeName, requirement.name, requirement.parameterCount)

      return false if implementation == null || !semanticRequirementMatches(requirement, implementation, typeName)
    end
    requirement = requirement.nextCallable
  end
  return contract.firstRequirement != null
end

def semanticCheckGenericConstraints(
  owner: BootstrapBinder,
  template: Int,
  arguments: StringBuffer,
  node: Int,
  namespaceOverride: String = ""
): Bool
  return false if !semanticGenericConstraintsValid(owner, template, false, namespaceOverride)
  let source = owner.syntax.nodeAt(template)
  var valid = true
  var index = 0

  while index < source.typeParameters.Length && index < arguments.size
    let capability = semanticGenericCapability(owner, template, index, false, namespaceOverride)

    if capability != ""
      let contract = owner.model.findContract(capability)
      let satisfied = contract == null ? semanticAssignable(
        owner.model,
        capability,
        arguments.get(index)
      ) : semanticTypeSatisfiesContract(
        owner.model,
        arguments.get(index),
        contract
      )

      if !satisfied
        owner.report(
          "NR251",
          node,
          "Type '" + arguments.get(index) + "' does not satisfy '" + capability + "' required by type parameter '" + source.typeParameters[index] + "' of '" + genericName(
            owner,
            template
          ) + "'."
        )
        valid = false
      end
    end
    index = index + 1
  end
  return valid
end

def validateGenericConstraintDeclarations(owner: BootstrapBinder): Void
  var index = 0

  while index < owner.model.genericTemplates.size && owner.checkpoint()
    semanticGenericConstraintsValid(owner, owner.model.genericTemplates.get(index))
    index = index + 1
  end
end
