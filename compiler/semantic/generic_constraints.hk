class SemanticTypeParameter
  public name: String
  public capability: String
  public next: SemanticTypeParameter?

  def init(name: String, capability: String): Void
    this.name = name
    this.capability = capability
  end
end

def semanticGenericConstraint(syntax: SyntaxArena, template: Int, index: Int): String
  let constraints = syntax.nodeAt(template).typeParameterConstraints

  if index < 0 || index >= constraints.Length || constraints[index] < 0
    return ""
  end
  return syntax.dataAt(constraints[index])
end

def semanticGenericConstraintsValid(owner: BootstrapBinder, template: Int, report: Bool = true): Bool
  let source = owner.syntax.nodeAt(template)
  var valid = true

  for constraint in source.typeParameterConstraints
    if constraint >= 0
      let bound = owner.syntax.nodeAt(constraint)
      let supported = source.kind == "Function" && source.typeParameters.Length > 0 && genericOperationName(owner.syntax, template) == "" && bound.kind == "Type" && bound.data == "Equality" && bound.typeArguments.Length == 0 && bound.children.Length == 1 && owner.syntax.kindAt(bound.children[0]) == "QualifiedName"

      if !supported
        valid = false
        if report
          owner.report("NR250", constraint, "A generic module function may require 'Equality' on a type parameter; this constraint has no type arguments and does not apply to classes, enums, or compiler operations.")
        end
      end
    end
  end
  return valid
end

def semanticSupportsEquality(model: SemanticModel, typeName: String): Bool
  let parameter = model.findTypeParameter(typeName)

  if parameter != null
    return parameter.capability == "Equality"
  end
  if semanticEqualityComparable(typeName)
    return true
  end
  let method = semanticOperatorMethod(model, typeName, "==", 1)

  if method == null || method.returnType != "Bool"
    return false
  end
  let operand = method.firstParameter

  return operand != null && operand.typeName == typeName
end

def semanticCheckGenericConstraints(owner: BootstrapBinder, template: Int, arguments: StringBuffer, node: Int): Bool
  let source = owner.syntax.nodeAt(template)

  if !semanticGenericConstraintsValid(owner, template, false)
    return false
  end
  var valid = true
  var index = 0

  while index < source.typeParameters.Length && index < arguments.size
    if semanticGenericConstraint(owner.syntax, template, index) == "Equality" && !semanticSupportsEquality(owner.model, arguments.get(index))
      owner.report("NR251", node, "Type '" + arguments.get(index) + "' does not satisfy 'Equality' required by type parameter '" + source.typeParameters[index] + "' of '" + genericName(owner, template) + "'.")
      valid = false
    end
    index = index + 1
  end
  return valid
end
