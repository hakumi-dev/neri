use host

class BootstrapBodyBinder
  public owner: BootstrapBinder = new BootstrapBinder(new SyntaxArena(), 0, 0)
  public firstLocal: SemanticLocal?
  public lastLocal: SemanticLocal?
  public scopeDepth: Int = 0
  public loopDepth: Int = 0
  public unsafeDepth: Int = 0
  public flowNames: StringBuffer = new StringBuffer()
  public flowTypes: StringBuffer = new StringBuffer()
  public flowDepths: IntBuffer = new IntBuffer()
  public flowActive: IntBuffer = new IntBuffer()
  public flowDepth: Int = 0

  def init(owner: BootstrapBinder): Void
    this.owner = owner
  end

  def syntax(): SyntaxArena
    return this.owner.syntax
  end

  def model(): SemanticModel
    return this.owner.model
  end

  def report(code: String, node: Int, message: String): Void
    this.owner.report(code, node, message)
  end

  def reportLength(code: String, node: Int, length: Int, message: String): Void
    this.owner.reportLength(code, node, length, message)
  end

  def addBound(kind: String, typeName: String, data: String, syntaxNode: Int, children: Int[]): Int
    return this.owner.addBound(kind, typeName, data, syntaxNode, children)
  end

  def addBoundValue(kind: String, typeName: String, data: String, value: String, syntaxNode: Int, children: Int[]): Int
    return this.owner.addBoundValue(kind, typeName, data, value, syntaxNode, children)
  end

  def addBoundSymbol(kind: String, typeName: String, data: String, symbol: String, syntaxNode: Int, children: Int[]): Int
    return this.owner.addBoundSymbol(kind, typeName, data, symbol, syntaxNode, children)
  end

  def resetLocals(): Void
    this.firstLocal = null
    this.lastLocal = null
    this.scopeDepth = 0
    this.loopDepth = 0
    this.unsafeDepth = 0
    this.flowNames = new StringBuffer()
    this.flowTypes = new StringBuffer()
    this.flowDepths = new IntBuffer()
    this.flowActive = new IntBuffer()
    this.flowDepth = 0
  end

  def enterScope(): Void
    this.scopeDepth = this.scopeDepth + 1
  end

  def leaveScope(): Void
    var local = this.firstLocal
    while local != null
      if local.depth == this.scopeDepth
        local.active = false
      end
      local = local.nextLocal
    end
    this.scopeDepth = this.scopeDepth - 1
  end

  def localInCurrentScope(name: String): Bool
    var local = this.firstLocal
    while local != null
      if local.active && local.depth == this.scopeDepth && local.name == name
        return true
      end
      local = local.nextLocal
    end
    return false
  end

  def findLocal(name: String): SemanticLocal?
    var local = this.firstLocal
    var found: SemanticLocal? = null
    while local != null
      if local.active && local.name == name
        found = local
      end
      local = local.nextLocal
    end
    return found
  end

  def declareLocal(name: String, typeName: String, mutable: Bool, syntaxNode: Int): SemanticLocal
    let position = this.syntax().startAt(syntaxNode)
    let identity = this.currentCallable().fullName + "/local@" + this.owner.sourceIdAt(position) + ":" + ((position - this.owner.sourceStartAt(position)) as String)
    let local = new SemanticLocal(identity, name, typeName, mutable, this.scopeDepth, syntaxNode)
    if this.firstLocal == null
      this.firstLocal = local
    else
      let last = this.lastLocal
      if last != null
        last.nextLocal = local
      end
    end
    this.lastLocal = local
    return local
  end

  def findVariableIdentity(name: String): String
    let local = this.findLocal(name)
    if local != null return local.identity end
    let callable = this.owner.currentCallable
    if callable != null
      let parameter = this.owner.findParameter(callable, name)
      if parameter != null return parameter.identity end
    end
    return ""
  end

  def currentCallable(): SemanticCallable
    let callable = this.owner.currentCallable
    if callable != null
      return callable
    end
    return new SemanticCallable("<error>", "<error>", "", "", "Error", false, false, "internal", 0)
  end

  def findVariableType(name: String): String
    var baseType = ""
    let callable = this.owner.currentCallable
    if callable != null
      let parameter = this.owner.findParameter(callable, name)
      if parameter != null
        baseType = parameter.typeName
      end
    end
    if baseType == ""
      let local = this.findLocal(name)
      if local != null
        baseType = local.typeName
      end
    end
    var index = this.flowNames.size - 1
    while index >= 0
      if this.flowActive.get(index) == 1 && this.flowDepths.get(index) <= this.flowDepth && this.flowNames.get(index) == name
        return this.flowTypes.get(index)
      end
      index = index - 1
    end
    return baseType
  end

  def enterFlow(): Void
    this.flowDepth = this.flowDepth + 1
  end

  def leaveFlow(): Void
    var index = 0
    while index < this.flowNames.size
      if this.flowDepths.get(index) == this.flowDepth
        this.flowActive.set(index, 0)
      end
      index = index + 1
    end
    this.flowDepth = this.flowDepth - 1
  end

  def addNarrowing(name: String, typeName: String): Void
    this.flowNames.add(name)
    this.flowTypes.add(typeName)
    this.flowDepths.add(this.flowDepth)
    this.flowActive.add(1)
  end

  def invalidateNarrowing(name: String): Void
    var index = 0
    while index < this.flowNames.size
      if this.flowActive.get(index) == 1 && this.flowNames.get(index) == name
        this.flowActive.set(index, 0)
      end
      index = index + 1
    end
  end

  def applyConditionNarrowing(node: Int, whenTrue: Bool): Void
    let kind = this.syntax().kindAt(node)
    if kind == "Unary" && this.syntax().dataAt(node) == "Bang"
      this.applyConditionNarrowing(this.syntax().childAt(node, 0), !whenTrue)
      return
    end
    if kind != "Binary"
      return
    end
    let operation = this.syntax().dataAt(node)
    if operation == "AmpAmp" && whenTrue
      this.applyConditionNarrowing(this.syntax().childAt(node, 0), true)
      this.applyConditionNarrowing(this.syntax().childAt(node, 1), true)
      return
    else if operation == "PipePipe" && !whenTrue
      this.applyConditionNarrowing(this.syntax().childAt(node, 0), false)
      this.applyConditionNarrowing(this.syntax().childAt(node, 1), false)
      return
    end
    if operation != "EqualEqual" && operation != "BangEqual"
      return
    end
    var nameNode = this.syntax().childAt(node, 0)
    var nullNode = this.syntax().childAt(node, 1)
    if this.syntax().kindAt(nameNode) != "Name" || this.syntax().kindAt(nullNode) != "NullLiteral"
      nameNode = this.syntax().childAt(node, 1)
      nullNode = this.syntax().childAt(node, 0)
    end
    let provesNonNull = (operation == "BangEqual" && whenTrue) || (operation == "EqualEqual" && !whenTrue)
    if provesNonNull && this.syntax().kindAt(nameNode) == "Name" && this.syntax().kindAt(nullNode) == "NullLiteral"
      let name = this.syntax().dataAt(nameNode)
      let typeName = this.findVariableType(name)
      if semanticIsOptional(typeName)
        this.addNarrowing(name, semanticInnerType(typeName))
      end
    end
  end

  def bindClassBodies(): Void
    var classSymbol = this.model().firstClass
    while classSymbol != null
      this.owner.currentClass = classSymbol
      this.owner.currentNamespace = classSymbol.namespaceName
      let classNode = classSymbol.syntaxNode
      var memberOffset = this.owner.classMemberStart(classNode)
      while memberOffset < this.syntax().childCountAt(classNode)
        let fieldNode = this.syntax().childAt(classNode, memberOffset)
        if this.syntax().kindAt(fieldNode) == "Field"
          let fieldName = semanticField(this.syntax().dataAt(fieldNode), 1)
          let field = this.owner.findDeclaredField(classSymbol, fieldName)
          if field != null && this.syntax().childCountAt(fieldNode) > 1
            let initializerNode = this.syntax().childAt(fieldNode, 1)
            let value = this.bindExpression(initializerNode, field.typeName)
            field.boundInitializer = value.boundNode
            if !semanticAssignable(this.model(), field.typeName, value.typeName)
              this.report("NR142", initializerNode, "Cannot assign expression of type '" + value.typeName + "' to variable '" + field.name + "' of type '" + field.typeName + "'.")
            end
          end
        end
        memberOffset = memberOffset + 1
      end
      var method = classSymbol.firstMethod
      while method != null
        this.bindCallable(method)
        method = method.nextCallable
      end
      classSymbol = classSymbol.nextClass
    end
    this.owner.currentClass = null
    this.owner.currentNamespace = ""
    this.owner.currentCallable = null
  end

  def bindFunctionBodies(): Void
    var function = this.model().firstFunction
    while function != null
      this.owner.currentClass = null
      this.owner.currentNamespace = function.namespaceName
      this.bindCallable(function)
      function = function.nextCallable
    end
    this.owner.currentCallable = null
    this.owner.currentNamespace = ""
  end

  def bindCallable(callable: SemanticCallable): Void
    this.owner.currentCallable = callable
    this.resetLocals()
    if callable.isUnsafe
      this.unsafeDepth = 1
    end
    var parameter = callable.firstParameter
    while parameter != null
      if parameter.hasDefault && this.syntax().childCountAt(parameter.syntaxNode) > 1
        let defaultNode = this.syntax().childAt(parameter.syntaxNode, 1)
        let defaultValue = this.bindExpression(defaultNode, parameter.typeName)
        parameter.boundDefault = defaultValue.boundNode
        if !semanticAssignable(this.model(), parameter.typeName, defaultValue.typeName)
          this.report("NR107B", defaultNode, "Default value for parameter '" + parameter.name + "' must be of type '" + parameter.typeName + "', but got '" + defaultValue.typeName + "'.")
        end
      end
      parameter = parameter.nextParameter
    end
    var bodyChildren: Int[] = []
    var index = 0
    while index < callable.bodyCount
      let statement = this.syntax().childAt(callable.syntaxNode, callable.bodyStart + index)
      if this.syntax().kindAt(statement) == "SuperConstructorCall"
        this.bindBaseConstructorCall(callable, statement)
      else
        let boundStatement = this.bindStatement(statement, callable.returnType)
        bodyChildren = appendChild(bodyChildren, boundStatement)
      end
      index = index + 1
    end
    if callable.cAbiSymbol == "" && callable.returnType != "Void" && !this.statementsReturn(callable)
      this.report("NR108", callable.syntaxNode, "Not all code paths return a value in function '" + this.callableDisplayName(callable) + "'.")
    end
    callable.boundNode = this.addBound("Function", callable.returnType, callable.fullName, callable.syntaxNode, bodyChildren)
  end

  def bindBaseConstructorCall(callable: SemanticCallable, node: Int): Void
    callable.hasBaseConstructorCall = true
    let owner = this.owner.currentClass
    if owner == null return end
    let baseClass = this.model().findClass(owner.baseName)
    if baseClass == null return end
    let constructor = this.owner.findDeclaredMethod(baseClass, "init")
    if constructor == null return end
    callable.baseConstructorName = constructor.fullName
    let actual = this.syntax().childCountAt(node)
    this.validateCallCount(baseClass.name + ".init", node, actual, constructor)
    var index = 0
    while index < actual
      var expected = ""
      let parameter = constructor.parameterAt(index)
      if parameter != null expected = parameter.typeName end
      let argument = this.bindExpression(this.syntax().childAt(node, index), expected)
      callable.baseArguments.add(argument.boundNode)
      index = index + 1
    end
  end

  def callableDisplayName(callable: SemanticCallable): String
    if callable.className != ""
      let classSymbol = this.model().findClass(callable.className)
      if classSymbol != null
        return classSymbol.name + "." + callable.name
      end
    end
    return callable.name
  end

  def statementsReturn(callable: SemanticCallable): Bool
    var index = 0
    while index < callable.bodyCount
      let statement = this.syntax().childAt(callable.syntaxNode, callable.bodyStart + index)
      if this.statementReturns(statement)
        return true
      end
      index = index + 1
    end
    return false
  end

  def statementReturns(node: Int): Bool
    let kind = this.syntax().kindAt(node)
    if kind == "Return"
      return true
    else if kind == "If"
      let thenCount = semanticIntField(this.syntax().dataAt(node), 0)
      let elseCount = semanticIntField(this.syntax().dataAt(node), 1)
      if elseCount == 0
        return false
      end
      return this.nodeRangeReturns(node, 1, thenCount) && this.nodeRangeReturns(node, 1 + thenCount, elseCount)
    else if kind == "UnsafeBlock"
      return this.nodeRangeReturns(node, 0, this.syntax().childCountAt(node))
    else if kind == "BorrowBlock"
      return this.nodeRangeReturns(node, 1, this.syntax().childCountAt(node) - 1)
    end
    return false
  end

  def nodeRangeReturns(parent: Int, start: Int, count: Int): Bool
    var index = 0
    while index < count
      if this.statementReturns(this.syntax().childAt(parent, start + index))
        return true
      end
      index = index + 1
    end
    return false
  end

  def statementTerminates(node: Int): Bool
    let kind = this.syntax().kindAt(node)
    if kind == "Return"
      return true
    else if kind == "Break" || kind == "Continue"
      return this.loopDepth > 0
    else if kind == "If"
      let thenCount = semanticIntField(this.syntax().dataAt(node), 0)
      let elseCount = semanticIntField(this.syntax().dataAt(node), 1)
      return elseCount > 0 && this.nodeRangeTerminates(node, 1, thenCount) && this.nodeRangeTerminates(node, 1 + thenCount, elseCount)
    else if kind == "UnsafeBlock"
      return this.nodeRangeTerminates(node, 0, this.syntax().childCountAt(node))
    else if kind == "BorrowBlock"
      return this.nodeRangeTerminates(node, 1, this.syntax().childCountAt(node) - 1)
    end
    return false
  end

  def nodeRangeTerminates(parent: Int, start: Int, count: Int): Bool
    var index = 0
    while index < count
      if this.statementTerminates(this.syntax().childAt(parent, start + index))
        return true
      end
      index = index + 1
    end
    return false
  end

  def bindStatement(node: Int, returnType: String): Int
    let kind = this.syntax().kindAt(node)
    if kind == "Let" || kind == "Var"
      return this.bindVariable(node, kind == "Var")
    else if kind == "Assignment"
      return this.bindAssignment(node)
    else if kind == "Return"
      return this.bindReturn(node, returnType)
    else if kind == "ExpressionStatement"
      let value = this.bindExpression(this.syntax().childAt(node, 0), "")
      return this.addBound("ExpressionStatement", "Void", "", node, appendChild(emptyInts(), value.boundNode))
    else if kind == "If"
      return this.bindIf(node, returnType)
    else if kind == "While"
      return this.bindWhile(node, returnType)
    else if kind == "For"
      return this.bindFor(node, returnType)
    else if kind == "Break"
      if this.loopDepth == 0
        this.report("NR132", node, "'break' statement not within a loop.")
      end
      return this.addBound("Break", "Void", "", node, emptyInts())
    else if kind == "Continue"
      if this.loopDepth == 0
        this.report("NR133", node, "'continue' statement not within a loop.")
      end
      return this.addBound("Continue", "Void", "", node, emptyInts())
    else if kind == "UnsafeBlock"
      this.unsafeDepth = this.unsafeDepth + 1
      let body = this.bindBlock(node, 0, this.syntax().childCountAt(node), returnType, true)
      this.unsafeDepth = this.unsafeDepth - 1
      return this.addBound("UnsafeBlock", "Void", "", node, body)
    else if kind == "BorrowBlock"
      return this.bindBorrow(node, returnType)
    else if kind == "SuperConstructorCall"
      return this.addBound("SuperConstructorCall", "Void", "", node, emptyInts())
    end
    this.report("NR134", node, "Unsupported statement '" + kind + "'.")
    return this.addBound("ErrorStatement", "Error", kind, node, emptyInts())
  end

  def bindVariable(node: Int, mutable: Bool): Int
    let name = this.syntax().dataAt(node)
    var explicitType = ""
    var initializerOffset = 0
    if this.syntax().kindAt(this.syntax().childAt(node, 0)) == "Type"
      let explicitTypeNode = this.syntax().childAt(node, 0)
      explicitType = this.owner.resolveTypeNode(explicitTypeNode, this.owner.currentNamespace, "")
      this.owner.validatePointerType(explicitTypeNode, this.unsafeDepth > 0)
      initializerOffset = 1
    end
    let initializerNode = this.syntax().childAt(node, initializerOffset)
    let value = this.bindExpression(initializerNode, explicitType)
    var typeName = value.typeName
    if explicitType != ""
      typeName = explicitType
      if !semanticAssignable(this.model(), explicitType, value.typeName)
        if value.typeName == "Null" && !semanticIsOptional(explicitType)
          this.report("NR150", node, "Cannot assign null to non-optional type '" + explicitType + "'.")
        else if mutable
          this.report("NR136", node, "Cannot assign expression of type '" + value.typeName + "' to variable '" + name + "' of type '" + explicitType + "'.")
        else
          this.report("NR135", node, "Cannot assign expression of type '" + value.typeName + "' to constant '" + name + "' of type '" + explicitType + "'.")
        end
      end
    else if typeName == "Null"
      this.report("NR137", node, "Type annotation required; cannot infer type from initializer.")
      typeName = "Int"
    end
    if this.localInCurrentScope(name)
      this.report("NR138", node, "Local '" + name + "' is already declared in this scope.")
    end
    let local = this.declareLocal(name, typeName, mutable, node)
    var children = appendChild(emptyInts(), value.boundNode)
    var boundKind = "Let"
    if mutable
      boundKind = "Var"
    end
    return this.addBoundSymbol(boundKind, typeName, name, local.identity, node, children)
  end

  def bindAssignment(node: Int): Int
    let targetNode = this.syntax().childAt(node, 0)
    let valueNode = this.syntax().childAt(node, 1)
    let value = this.bindExpression(valueNode, "")
    let targetKind = this.syntax().kindAt(targetNode)
    if targetKind == "Name"
      let name = this.syntax().dataAt(targetNode)
      let local = this.findLocal(name)
      if local == null
        let callable = this.owner.currentCallable
        if callable != null && this.owner.findParameter(callable, name) != null
          this.report("NR139", targetNode, "Cannot assign to parameter '" + name + "'. Parameters are immutable.")
        else
          this.report("NR140", targetNode, "Undefined variable '" + name + "'.")
        end
        return this.addBound("Assignment", "Error", name, targetNode, appendChild(emptyInts(), value.boundNode))
      end
      if !local.mutable
        this.report("NR141", targetNode, "Cannot assign to '" + name + "' because it is immutable. Use 'var' instead of 'let' for mutable variables.")
      else if !semanticAssignable(this.model(), local.typeName, value.typeName)
        if value.typeName == "Null" && !semanticIsOptional(local.typeName)
          this.report("NR150", targetNode, "Cannot assign null to non-optional type '" + local.typeName + "'.")
        else
          this.report("NR142", targetNode, "Cannot assign expression of type '" + value.typeName + "' to variable '" + name + "' of type '" + local.typeName + "'.")
        end
      end
      this.invalidateNarrowing(name)
      return this.addBoundSymbol("Assignment", local.typeName, name, local.identity, targetNode, appendChild(emptyInts(), value.boundNode))
    end
    let target = this.bindExpression(targetNode, "")
    if !semanticAssignable(this.model(), target.typeName, value.typeName)
      this.report("NR142", valueNode, "Cannot assign expression of type '" + value.typeName + "' to variable 'target' of type '" + target.typeName + "'.")
    end
    var children = appendChild(emptyInts(), target.boundNode)
    children = appendChild(children, value.boundNode)
    return this.addBound("Assignment", target.typeName, "", node, children)
  end

  def bindReturn(node: Int, returnType: String): Int
    if this.syntax().childCountAt(node) == 0
      if returnType != "Void"
        this.report("NR144", node, "Void return in function that expects '" + returnType + "'.")
      end
      return this.addBound("Return", "Void", "", node, emptyInts())
    end
    let expressionNode = this.syntax().childAt(node, 0)
    let value = this.bindExpression(expressionNode, returnType)
    if !semanticAssignable(this.model(), returnType, value.typeName)
      if value.typeName == "Null" && !semanticIsOptional(returnType)
        this.report("NR150", expressionNode, "Cannot assign null to non-optional type '" + returnType + "'.")
      else
        this.report("NR143", expressionNode, "Return type mismatch: expected '" + returnType + "', got '" + value.typeName + "'.")
      end
    end
    return this.addBound("Return", returnType, "", node, appendChild(emptyInts(), value.boundNode))
  end

  def bindIf(node: Int, returnType: String): Int
    let conditionNode = this.syntax().childAt(node, 0)
    let condition = this.bindExpression(conditionNode, "Bool")
    if condition.typeName != "Bool" && condition.typeName != "Error"
      this.report("NR145", conditionNode, "If condition must be of type 'Bool', but got '" + condition.typeName + "'.")
    end
    let thenCount = semanticIntField(this.syntax().dataAt(node), 0)
    let elseCount = semanticIntField(this.syntax().dataAt(node), 1)
    var children = appendChild(emptyInts(), condition.boundNode)
    this.enterFlow()
    this.applyConditionNarrowing(conditionNode, true)
    let thenBody = this.bindBlock(node, 1, thenCount, returnType, true)
    this.leaveFlow()
    for statement in thenBody
      children = host.appendInt(children, statement)
    end
    this.enterFlow()
    this.applyConditionNarrowing(conditionNode, false)
    let elseBody = this.bindBlock(node, 1 + thenCount, elseCount, returnType, true)
    this.leaveFlow()
    for statement in elseBody
      children = host.appendInt(children, statement)
    end
    let thenTerminates = this.nodeRangeTerminates(node, 1, thenCount)
    let elseTerminates = elseCount > 0 && this.nodeRangeTerminates(node, 1 + thenCount, elseCount)
    if thenTerminates && !elseTerminates
      this.applyConditionNarrowing(conditionNode, false)
    else if elseTerminates && !thenTerminates
      this.applyConditionNarrowing(conditionNode, true)
    end
    return this.addBound("If", "Void", (thenCount as String) + "|" + (elseCount as String), node, children)
  end

  def bindWhile(node: Int, returnType: String): Int
    let conditionNode = this.syntax().childAt(node, 0)
    let condition = this.bindExpression(conditionNode, "Bool")
    if condition.typeName != "Bool" && condition.typeName != "Error"
      this.report("NR146", conditionNode, "While condition must be of type 'Bool', but got '" + condition.typeName + "'.")
    end
    this.loopDepth = this.loopDepth + 1
    this.enterFlow()
    this.applyConditionNarrowing(conditionNode, true)
    let body = this.bindBlock(node, 1, this.syntax().childCountAt(node) - 1, returnType, true)
    this.leaveFlow()
    this.loopDepth = this.loopDepth - 1
    var children = appendChild(emptyInts(), condition.boundNode)
    for statement in body
      children = host.appendInt(children, statement)
    end
    return this.addBound("While", "Void", "", node, children)
  end

  def bindFor(node: Int, returnType: String): Int
    let name = semanticField(this.syntax().dataAt(node), 0)
    var offset = 0
    var explicitType = ""
    if this.syntax().kindAt(this.syntax().childAt(node, 0)) == "Type"
      explicitType = this.owner.resolveTypeNode(this.syntax().childAt(node, 0), this.owner.currentNamespace, "")
      offset = 1
    end
    let collectionNode = this.syntax().childAt(node, offset)
    let collection = this.bindExpression(collectionNode, "")
    var elementType = "Error"
    if semanticIsArray(collection.typeName)
      elementType = semanticInnerType(collection.typeName)
    else if semanticIsOptional(collection.typeName)
      this.report("NR169", collectionNode, "Optional value of type '" + collection.typeName + "' must be narrowed before access.")
    else
      this.report("NR147", collectionNode, "For loop expects an Array, but got '" + collection.typeName + "'.")
    end
    if explicitType != ""
      if elementType != "Error" && elementType != explicitType
        this.report("NR148", node, "Type mismatch in for loop: array contains '" + elementType + "', but '" + name + "' is declared as '" + explicitType + "'.")
      end
      elementType = explicitType
    end
    this.enterScope()
    let iterator = this.declareLocal(name, elementType, false, node)
    this.loopDepth = this.loopDepth + 1
    let bodyStart = offset + 1
    let body = this.bindBlock(node, bodyStart, this.syntax().childCountAt(node) - bodyStart, returnType, false)
    this.loopDepth = this.loopDepth - 1
    this.leaveScope()
    var children = appendChild(emptyInts(), collection.boundNode)
    for statement in body
      children = host.appendInt(children, statement)
    end
    return this.addBoundSymbol("For", "Void", name + "|" + elementType, iterator.identity, node, children)
  end

  def bindBorrow(node: Int, returnType: String): Int
    let ownerNode = this.syntax().childAt(node, 0)
    let value = this.bindExpression(ownerNode, "")
    let pointerName = semanticField(this.syntax().dataAt(node), 0)
    var pointerType = "Error"
    if semanticIsArray(value.typeName)
      let elementType = semanticInnerType(value.typeName)
      if elementType == "Int" || elementType == "Bool" || elementType == "Byte" || elementType == "Float"
        pointerType = elementType + "*"
      else
        this.report("NR202", ownerNode, "Scoped borrow requires an array of unmanaged elements, but received '" + value.typeName + "'.")
      end
    else
      this.report("NR202", ownerNode, "Scoped borrow requires an array of unmanaged elements, but received '" + value.typeName + "'.")
    end
    this.enterScope()
    let pointer = this.declareLocal(pointerName, pointerType, false, node)
    let body = this.bindBlock(node, 1, this.syntax().childCountAt(node) - 1, returnType, false)
    this.leaveScope()
    var children = appendChild(emptyInts(), value.boundNode)
    for statement in body
      children = host.appendInt(children, statement)
    end
    return this.addBoundSymbol("BorrowBlock", "Void", pointerName + "|" + pointerType, pointer.identity, node, children)
  end

  def bindBlock(parent: Int, start: Int, count: Int, returnType: String, ownScope: Bool): Int[]
    if ownScope
      this.enterScope()
    end
    var result: Int[] = []
    var index = 0
    while index < count
      result = appendChild(result, this.bindStatement(this.syntax().childAt(parent, start + index), returnType))
      index = index + 1
    end
    if ownScope
      this.leaveScope()
    end
    return result
  end

  def bindExpression(node: Int, expectedType: String): BoundValue
    let kind = this.syntax().kindAt(node)
    let data = this.syntax().dataAt(node)
    if kind == "IntLiteral"
      if host.parseInt(data) == null && data != "9223372036854775808"
        this.report("NR162", node, "Integer literal '" + data + "' is outside the signed 64-bit range.")
      end
      return new BoundValue("Int", this.addBoundValue("IntLiteral", "Int", "", this.syntax().valueAt(node), node, emptyInts()))
    else if kind == "FloatLiteral"
      return new BoundValue("Float", this.addBoundValue("FloatLiteral", "Float", "", this.syntax().valueAt(node), node, emptyInts()))
    else if kind == "StringLiteral"
      return new BoundValue("String", this.addBoundValue("StringLiteral", "String", "", this.syntax().valueAt(node), node, emptyInts()))
    else if kind == "BoolLiteral"
      return new BoundValue("Bool", this.addBoundValue("BoolLiteral", "Bool", "", this.syntax().valueAt(node), node, emptyInts()))
    else if kind == "NullLiteral"
      return new BoundValue("Null", this.addBound("NullLiteral", "Null", "", node, emptyInts()))
    else if kind == "Name"
      return this.bindName(node)
    else if kind == "This"
      return this.bindThis(node)
    else if kind == "Super"
      this.report("NR182", node, "Keyword 'super' is valid only inside a derived instance method or constructor.")
      return new BoundValue("Error", this.addBound("This", "Error", "super", node, emptyInts()))
    else if kind == "Unary"
      return this.bindUnary(node)
    else if kind == "Binary"
      return this.bindBinary(node)
    else if kind == "Ternary"
      return this.bindTernary(node)
    else if kind == "Cast"
      return this.bindCast(node)
    else if kind == "ArrayLiteral"
      return this.bindArray(node, expectedType)
    else if kind == "Index"
      return this.bindIndex(node)
    else if kind == "Member"
      return this.bindMember(node)
    else if kind == "Call"
      return this.bindCall(node)
    else if kind == "New"
      return this.bindNew(node)
    else if kind == "StackAlloc"
      return this.bindStackAlloc(node)
    else if kind == "NativeIntrinsic"
      return this.bindNative(node)
    end
    this.report("NR126", node, "Unsupported expression '" + kind + "'.")
    return new BoundValue("Error", this.addBound("ErrorExpression", "Error", kind, node, emptyInts()))
  end

  def bindName(node: Int): BoundValue
    let name = this.syntax().dataAt(node)
    let typeName = this.findVariableType(name)
    if typeName == ""
      this.report("NR113", node, "Undefined name '" + name + "'.")
      return new BoundValue("Error", this.addBound("Name", "Error", name, node, emptyInts()))
    end
    return new BoundValue(typeName, this.addBoundSymbol("Name", typeName, name, this.findVariableIdentity(name), node, emptyInts()))
  end

  def bindThis(node: Int): BoundValue
    let classSymbol = this.owner.currentClass
    let callable = this.owner.currentCallable
    if classSymbol == null
      this.report("NR126A", node, "Keyword 'this' can only be used inside a class method or constructor.")
      return new BoundValue("Error", this.addBound("This", "Error", "", node, emptyInts()))
    end
    if callable != null && callable.isStatic
      this.report("NR171", node, "Keyword 'this' is not available inside a static method.")
      return new BoundValue("Error", this.addBound("This", "Error", "", node, emptyInts()))
    end
    return new BoundValue(classSymbol.fullName, this.addBound("This", classSymbol.fullName, "", node, emptyInts()))
  end

  def bindUnary(node: Int): BoundValue
    let operation = this.syntax().dataAt(node)
    let operandNode = this.syntax().childAt(node, 0)
    let operand = this.bindExpression(operandNode, "")
    var resultType = operand.typeName
    if operation == "Bang"
      resultType = "Bool"
      if operand.typeName != "Bool" && operand.typeName != "Error"
        this.report("NR114", node, "Unary operator '!' requires operand of type Bool, but got '" + operand.typeName + "'.")
      end
    else if operation == "Plus" || operation == "Minus"
      if operand.typeName != "Int" && operand.typeName != "Float" && operand.typeName != "Error"
        var text = "-"
        if operation == "Plus"
          text = "+"
        end
        this.report("NR116", node, "Unary operator '" + text + "' requires operand of type Int, but got '" + operand.typeName + "'.")
        resultType = "Int"
      end
    else if operation == "Amp"
      if this.unsafeDepth == 0
        this.report("NR192", node, "Unsafe operation '&' requires an unsafe declaration or block.")
      end
      let name = this.syntax().dataAt(operandNode)
      let local = this.findLocal(name)
      if local == null || !local.mutable || !(local.typeName == "Int" || local.typeName == "Bool" || local.typeName == "Byte" || local.typeName == "Float")
        this.report("NR195", operandNode, "Address-of requires a mutable local with an unmanaged type; managed storage requires a scoped borrow.")
        resultType = "Error"
      else
        resultType = local.typeName + "*"
      end
    else if operation == "Star"
      if this.unsafeDepth == 0
        this.report("NR192", node, "Unsafe operation '*' requires an unsafe declaration or block.")
      end
      if semanticIsOptional(operand.typeName) && semanticIsPointer(semanticInnerType(operand.typeName))
        this.report("NR193", operandNode, "Nullable raw pointer '" + operand.typeName + "' must be narrowed before pointer access.")
        resultType = "Error"
      else if !semanticIsPointer(operand.typeName)
        this.report("NR194", operandNode, "Type '" + operand.typeName + "' is not a raw pointer and cannot be dereferenced.")
        resultType = "Error"
      else
        resultType = semanticInnerType(operand.typeName)
        if resultType == "Void"
          this.report("NR198", operandNode, "A 'Void*' pointer must be cast to a typed pointer before dereference or indexing.")
          resultType = "Error"
        end
      end
    else
      this.report("NR115", node, "Unsupported unary operator '" + operation + "'.")
    end
    return new BoundValue(resultType, this.addBound("Unary", resultType, this.operationText(operation), node, appendChild(emptyInts(), operand.boundNode)))
  end

  def operationText(kind: String): String
    if kind == "Plus" return "+" end
    if kind == "Minus" return "-" end
    if kind == "Star" return "*" end
    if kind == "Slash" return "/" end
    if kind == "EqualEqual" return "==" end
    if kind == "BangEqual" return "!=" end
    if kind == "Less" return "<" end
    if kind == "LessEqual" return "<=" end
    if kind == "Greater" return ">" end
    if kind == "GreaterEqual" return ">=" end
    if kind == "AmpAmp" return "&&" end
    if kind == "PipePipe" return "||" end
    if kind == "Bang" return "!" end
    if kind == "Amp" return "&" end
    return kind
  end

  def bindBinary(node: Int): BoundValue
    let operationKind = this.syntax().dataAt(node)
    let operation = this.operationText(operationKind)
    let leftNode = this.syntax().childAt(node, 0)
    let rightNode = this.syntax().childAt(node, 1)
    let left = this.bindExpression(leftNode, "")
    var right = new BoundValue("Error", -1)
    if operationKind == "AmpAmp" || operationKind == "PipePipe"
      this.enterFlow()
      this.applyConditionNarrowing(leftNode, operationKind == "AmpAmp")
      right = this.bindExpression(rightNode, "")
      this.leaveFlow()
    else
      right = this.bindExpression(rightNode, "")
    end
    var resultType = "Int"
    let arithmetic = operation == "+" || operation == "-" || operation == "*" || operation == "/"
    let equality = operation == "==" || operation == "!="
    let comparison = operation == "<" || operation == "<=" || operation == ">" || operation == ">="
    let logical = operation == "&&" || operation == "||"
    let leftPointer = semanticIsPointer(left.typeName) || (semanticIsOptional(left.typeName) && semanticIsPointer(semanticInnerType(left.typeName)))
    let rightPointer = semanticIsPointer(right.typeName) || (semanticIsOptional(right.typeName) && semanticIsPointer(semanticInnerType(right.typeName)))
    if leftPointer || rightPointer
      if this.unsafeDepth == 0
        this.report("NR192", node, "Unsafe operation '" + operation + "' requires an unsafe declaration or block.")
      end
      let nullableNull = equality && ((semanticIsOptional(left.typeName) && semanticIsPointer(semanticInnerType(left.typeName)) && right.typeName == "Null") || (semanticIsOptional(right.typeName) && semanticIsPointer(semanticInnerType(right.typeName)) && left.typeName == "Null"))
      if semanticIsOptional(left.typeName) && semanticIsPointer(semanticInnerType(left.typeName)) && right.typeName != "Null"
        this.report("NR193", leftNode, "Nullable raw pointer '" + left.typeName + "' must be narrowed before pointer access.")
      end
      if semanticIsOptional(right.typeName) && semanticIsPointer(semanticInnerType(right.typeName)) && left.typeName != "Null"
        this.report("NR193", rightNode, "Nullable raw pointer '" + right.typeName + "' must be narrowed before pointer access.")
      end
      var pointerResult = "Bool"
      var pointerChildren = appendChild(emptyInts(), left.boundNode)
      pointerChildren = appendChild(pointerChildren, right.boundNode)
      var validPointerOperation = nullableNull
      if semanticIsPointer(left.typeName) && right.typeName == "Int" && (operation == "+" || operation == "-")
        pointerResult = left.typeName
        validPointerOperation = true
      else if left.typeName == "Int" && semanticIsPointer(right.typeName) && operation == "+"
        pointerResult = right.typeName
        pointerChildren = appendChild(emptyInts(), right.boundNode)
        pointerChildren = appendChild(pointerChildren, left.boundNode)
        validPointerOperation = true
      else if semanticIsPointer(left.typeName) && left.typeName == right.typeName && operation == "-"
        pointerResult = "Int"
        validPointerOperation = true
      else if semanticIsPointer(left.typeName) && left.typeName == right.typeName && (equality || comparison)
        validPointerOperation = true
      end
      if !validPointerOperation
        this.report("NR196", node, "Pointer operation '" + operation + "' is not defined for '" + left.typeName + "' and '" + right.typeName + "'.")
      end
      return new BoundValue(pointerResult, this.addBound("Binary", pointerResult, operation, node, pointerChildren))
    end
    if arithmetic
      if left.typeName == right.typeName && (left.typeName == "Int" || left.typeName == "Float" || (operation == "+" && left.typeName == "String"))
        resultType = left.typeName
      else if semanticIsPointer(left.typeName) && right.typeName == "Int" && (operation == "+" || operation == "-")
        resultType = left.typeName
      else
        this.report("NR117", node, "Binary operator '" + operation + "' requires operands of type (Int, Int) or (Float, Float), but got (" + left.typeName + ", " + right.typeName + "). Strict typing prohibits mixing types without cast.")
      end
    else if equality
      resultType = "Bool"
      let optionalNull = (semanticIsOptional(left.typeName) && right.typeName == "Null") || (semanticIsOptional(right.typeName) && left.typeName == "Null")
      if !optionalNull && left.typeName != right.typeName
        this.report("NR118", node, "Equality operator '" + operation + "' requires both operands to have the same type, but got (" + left.typeName + ", " + right.typeName + ").")
      else if !optionalNull && !semanticEqualityComparable(left.typeName) && left.typeName != "Error"
        this.report("NR119", node, "Type '" + left.typeName + "' does not support equality comparison.")
      end
    else if comparison
      resultType = "Bool"
      if left.typeName != right.typeName || !(left.typeName == "Int" || left.typeName == "Float")
        this.report("NR120", node, "Comparison operator '" + operation + "' requires operands of type (Int, Int) or (Float, Float), but got (" + left.typeName + ", " + right.typeName + ").")
      end
    else if logical
      resultType = "Bool"
      if left.typeName != "Bool" || right.typeName != "Bool"
        this.report("NR121", node, "Logical operator '" + operation + "' requires operands of type (Bool, Bool), but got (" + left.typeName + ", " + right.typeName + ").")
      end
    else
      this.report("NR122", node, "Unsupported binary operator '" + operation + "'.")
    end
    var children = appendChild(emptyInts(), left.boundNode)
    children = appendChild(children, right.boundNode)
    return new BoundValue(resultType, this.addBound("Binary", resultType, operation, node, children))
  end

  def bindTernary(node: Int): BoundValue
    let condition = this.bindExpression(this.syntax().childAt(node, 0), "Bool")
    let thenValue = this.bindExpression(this.syntax().childAt(node, 1), "")
    let elseValue = this.bindExpression(this.syntax().childAt(node, 2), thenValue.typeName)
    if condition.typeName != "Bool"
      this.report("NR123", this.syntax().childAt(node, 0), "Ternary condition must be of type 'Bool', but got '" + condition.typeName + "'.")
    end
    if thenValue.typeName != elseValue.typeName
      this.report("NR124", this.syntax().childAt(node, 2), "Ternary branches must have the same type, but got '" + thenValue.typeName + "' and '" + elseValue.typeName + "'.")
    end
    var children = appendChild(emptyInts(), condition.boundNode)
    children = appendChild(children, thenValue.boundNode)
    children = appendChild(children, elseValue.boundNode)
    return new BoundValue(thenValue.typeName, this.addBound("Ternary", thenValue.typeName, "", node, children))
  end

  def bindCast(node: Int): BoundValue
    let value = this.bindExpression(this.syntax().childAt(node, 0), "")
    let typeNode = this.syntax().childAt(node, 1)
    let target = this.owner.resolveTypeNode(typeNode, this.owner.currentNamespace, "")
    this.owner.validatePointerType(typeNode, this.unsafeDepth > 0)
    let numeric = (value.typeName == "Int" || value.typeName == "Byte" || value.typeName == "Float") && (target == "Int" || target == "Byte" || target == "Float" || target == "String")
    let pointer = semanticIsPointer(value.typeName) && semanticIsPointer(target)
    if value.typeName != target && !numeric && !pointer
      this.report("NR125", typeNode, "Invalid cast from '" + value.typeName + "' to '" + target + "'.")
    end
    return new BoundValue(target, this.addBound("Cast", target, "", node, appendChild(emptyInts(), value.boundNode)))
  end

  def bindArray(node: Int, expectedType: String): BoundValue
    let count = this.syntax().childCountAt(node)
    if count == 0
      if semanticIsArray(expectedType)
        return new BoundValue(expectedType, this.addBound("ArrayLiteral", expectedType, "0", node, emptyInts()))
      end
      this.report("NR127", node, "Cannot infer type of empty array literal. Use explicit type annotation.")
      return new BoundValue("Int[]", this.addBound("ArrayLiteral", "Int[]", "0", node, emptyInts()))
    end
    var children: Int[] = []
    let first = this.bindExpression(this.syntax().childAt(node, 0), "")
    let elementType = first.typeName
    children = host.appendInt(children, first.boundNode)
    var index = 1
    while index < count
      let elementNode = this.syntax().childAt(node, index)
      let element = this.bindExpression(elementNode, elementType)
      children = host.appendInt(children, element.boundNode)
      if element.typeName != elementType
        this.report("NR128", elementNode, "Array element type mismatch. Expected '" + elementType + "', but got '" + element.typeName + "'.")
      end
      index = index + 1
    end
    let typeName = elementType + "[]"
    return new BoundValue(typeName, this.addBound("ArrayLiteral", typeName, count as String, node, children))
  end

  def bindIndex(node: Int): BoundValue
    let collectionNode = this.syntax().childAt(node, 0)
    let indexNode = this.syntax().childAt(node, 1)
    let collection = this.bindExpression(collectionNode, "")
    let indexValue = this.bindExpression(indexNode, "Int")
    if indexValue.typeName != "Int"
      this.report("NR129", node, "Array index must be of type 'Int', but got '" + indexValue.typeName + "'.")
    end
    var typeName = "Error"
    if semanticIsArray(collection.typeName) || semanticIsPointer(collection.typeName)
      typeName = semanticInnerType(collection.typeName)
    else if semanticIsOptional(collection.typeName)
      this.report("NR169", collectionNode, "Optional value of type '" + collection.typeName + "' must be narrowed before access.")
    else
      this.report("NR130", collectionNode, "Cannot index into non-array type '" + collection.typeName + "'.")
    end
    var children = appendChild(emptyInts(), collection.boundNode)
    children = appendChild(children, indexValue.boundNode)
    return new BoundValue(typeName, this.addBound("Index", typeName, "", node, children))
  end

  def findField(classSymbol: SemanticClass, name: String): SemanticField?
    var current: SemanticClass? = classSymbol
    var steps = 0
    while current != null && steps < 256
      let field = this.owner.findDeclaredField(current, name)
      if field != null
        return field
      end
      current = this.model().findClass(current.baseName)
      steps = steps + 1
    end
    return null
  end

  def findMethod(classSymbol: SemanticClass, name: String): SemanticCallable?
    var current: SemanticClass? = classSymbol
    var steps = 0
    while current != null && steps < 256
      let method = this.owner.findDeclaredMethod(current, name)
      if method != null
        return method
      end
      current = this.model().findClass(current.baseName)
      steps = steps + 1
    end
    return null
  end

  def memberAccessible(ownerName: String, access: String): Bool
    if access == "public" || access == "internal"
      return true
    end
    let current = this.owner.currentClass
    if current == null
      return false
    end
    if current.fullName == ownerName
      return true
    end
    if access == "protected"
      return semanticClassAssignable(this.model(), ownerName, current.fullName)
    end
    return false
  end

  def bindMember(node: Int): BoundValue
    let objectNode = this.syntax().childAt(node, 0)
    let objectValue = this.bindExpression(objectNode, "")
    let name = this.syntax().dataAt(node)
    if semanticIsOptional(objectValue.typeName)
      this.report("NR169", objectNode, "Optional value of type '" + objectValue.typeName + "' must be narrowed before access.")
      return new BoundValue("Error", this.addBound("Member", "Error", name, node, appendChild(emptyInts(), objectValue.boundNode)))
    end
    if semanticIsArray(objectValue.typeName) && name == "Length"
      return new BoundValue("Int", this.addBound("Call", "Int", "Array.Length", node, appendChild(emptyInts(), objectValue.boundNode)))
    end
    let classSymbol = this.model().findClass(objectValue.typeName)
    if classSymbol != null
      let field = this.findField(classSymbol, name)
      if field != null
        if !this.memberAccessible(field.owner, field.access)
          this.report("NR153", node, "Cannot access " + field.access + " member '" + name + "' of type '" + field.owner + "'.")
        end
        return new BoundValue(field.typeName, this.addBound("Member", field.typeName, field.owner + "." + name, node, appendChild(emptyInts(), objectValue.boundNode)))
      end
    end
    this.report("NR131", node, "Type '" + objectValue.typeName + "' does not have a member '" + name + "'.")
    return new BoundValue("Error", this.addBound("Member", "Error", name, node, appendChild(emptyInts(), objectValue.boundNode)))
  end

  def resolveFunction(name: String): SemanticCallable?
    if semanticField(name, 1) != ""
      return this.model().findFunction(name)
    end
    let localName = semanticQualifiedName(this.owner.currentNamespace, name)
    let local = this.model().findFunction(localName)
    if local != null
      return local
    end
    var candidate: SemanticCallable? = null
    var index = 0
    while index < this.model().usedNames.size
      let imported = this.model().findFunction(semanticQualifiedName(this.model().usedNames.get(index), name))
      if imported != null
        if candidate != null
          return null
        end
        candidate = imported
      end
      index = index + 1
    end
    if candidate != null
      return candidate
    end
    return this.model().findFunction(name)
  end

  def libraryReturn(library: String, name: String): String
    if library == "math"
      if name == "abs" || name == "max" || name == "min" || name == "pow"
        return "Int"
      end
    else if library == "test"
      if name == "assert" || name == "assertEqual" || name == "assertTrue" || name == "assertFalse"
        return "Void"
      end
    else if library == "ConsoleInteraction"
      if name == "print" || name == "println" return "Void" end
      if name == "read" return "String" end
    else if library == "host"
      if name == "exit" return "Void" end
      if name == "stringByteLength" || name == "argumentCount" return "Int" end
      if name == "stringByteAt" return "Byte" end
      if name == "stringSlice" || name == "errorMessage" return "String" end
      if name == "stringFromBytes" || name == "readText" || name == "pathJoin" || name == "pathAbsolute" || name == "pathFileName" || name == "argumentAt" || name == "environment" return "String?" end
      if name == "parseInt" || name == "run" return "Int?" end
      if name == "parseFloat" return "Float?" end
      if name == "appendByte" return "Byte[]" end
      if name == "appendInt" return "Int[]" end
      if name == "appendString" return "String[]" end
      if name == "writeText" || name == "writeBytes" || name == "removeFile" return "Bool" end
    end
    return ""
  end

  def libraryParameterCount(library: String, name: String): Int
    if library == "math"
      if name == "abs" return 1 end
      if name == "max" || name == "min" || name == "pow" return 2 end
    else if library == "test"
      if name == "assert" || name == "assertTrue" || name == "assertFalse" return 1 end
      if name == "assertEqual" return 2 end
    else if library == "ConsoleInteraction"
      if name == "print" || name == "println" return 1 end
      if name == "read" return 0 end
    else if library == "host"
      if name == "argumentCount" || name == "errorMessage" return 0 end
      if name == "stringByteLength" || name == "stringFromBytes" || name == "parseInt" || name == "parseFloat" || name == "readText" || name == "removeFile" || name == "pathAbsolute" || name == "pathFileName" || name == "argumentAt" || name == "environment" || name == "exit" return 1 end
      if name == "stringByteAt" || name == "appendByte" || name == "appendInt" || name == "appendString" || name == "writeText" || name == "writeBytes" || name == "pathJoin" || name == "run" return 2 end
      if name == "stringSlice" return 3 end
    end
    return -1
  end

  def libraryParameterType(library: String, name: String, index: Int): String
    if library == "math" return "Int" end
    if library == "test"
      if name == "assert" || name == "assertTrue" || name == "assertFalse" return "Bool" end
      return "Any"
    end
    if library == "ConsoleInteraction"
      if name == "print" || name == "println" return "Any" end
      return "Error"
    end
    if library == "host"
      if name == "exit" return "Int" end
      if name == "stringByteLength" || name == "parseInt" || name == "parseFloat" || name == "readText" || name == "removeFile" || name == "pathAbsolute" || name == "pathFileName" || name == "environment" return "String" end
      if name == "argumentAt" return "Int" end
      if name == "stringFromBytes" return "Byte[]" end
      if name == "stringByteAt" return index == 0 ? "String" : "Int" end
      if name == "stringSlice" return index == 0 ? "String" : "Int" end
      if name == "appendByte" return index == 0 ? "Byte[]" : "Byte" end
      if name == "appendInt" return index == 0 ? "Int[]" : "Int" end
      if name == "appendString" return index == 0 ? "String[]" : "String" end
      if name == "writeText" return "String" end
      if name == "writeBytes" return index == 0 ? "String" : "Byte[]" end
      if name == "pathJoin" return "String" end
      if name == "run" return index == 0 ? "String" : "String[]" end
    end
    return "Error"
  end

  def bindArguments(node: Int, start: Int, expectedCount: Int, library: String, name: String, callable: SemanticCallable?): Int[]
    var children: Int[] = []
    let actual = this.syntax().childCountAt(node) - start
    var index = 0
    while index < actual
      var expected = ""
      if callable != null
        let parameter = callable.parameterAt(index)
        if parameter != null
          expected = parameter.typeName
        end
      else if library != ""
        expected = this.libraryParameterType(library, name, index)
      end
      let argumentNode = this.syntax().childAt(node, start + index)
      let argument = this.bindExpression(argumentNode, expected)
      children = host.appendInt(children, argument.boundNode)
      if expected != "" && expected != "Any" && !semanticAssignable(this.model(), expected, argument.typeName)
        this.report("NR112", argumentNode, "Argument " + ((index + 1) as String) + " of '" + semanticQualifiedName(library, name) + "' expects type '" + expected + "', but got '" + argument.typeName + "'.")
      end
      index = index + 1
    end
    return children
  end

  def requiredParameterCount(callable: SemanticCallable): Int
    var count = 0
    var parameter = callable.firstParameter
    while parameter != null
      if parameter.hasDefault
        return count
      end
      count = count + 1
      parameter = parameter.nextParameter
    end
    return count
  end

  def validateCallCount(displayName: String, node: Int, actual: Int, callable: SemanticCallable): Void
    let required = this.requiredParameterCount(callable)
    if actual < required
      var missing = ""
      var index = actual
      while index < required
        let parameter = callable.parameterAt(index)
        if parameter != null
          missing = semanticJoin(missing, ", ", parameter.name + ": " + parameter.typeName)
        end
        index = index + 1
      end
      this.reportLength("NR111A", node, 1, "Function '" + displayName + "' expects " + (required as String) + " arguments (" + missing + "), but got " + (actual as String) + ".")
    else if actual > callable.parameterCount
      this.reportLength("NR111", node, 1, "Function '" + displayName + "' expects " + (callable.parameterCount as String) + " arguments, but got " + (actual as String) + ".")
    end
  end

  def bindCall(node: Int): BoundValue
    let calleeNode = this.syntax().childAt(node, 0)
    let calleeKind = this.syntax().kindAt(calleeNode)
    let actual = this.syntax().childCountAt(node) - 1
    if calleeKind == "Name"
      let name = this.syntax().dataAt(calleeNode)
      let callable = this.resolveFunction(name)
      if callable == null
        this.reportLength("NR110", calleeNode, 1, "Undefined function '" + name + "'.")
        let arguments = this.bindArguments(node, 1, actual, "", name, null)
        return new BoundValue("Error", this.addBound("Call", "Error", name, calleeNode, arguments))
      end
      this.validateCallCount(callable.fullName, calleeNode, actual, callable)
      let arguments = this.bindArguments(node, 1, callable.parameterCount, "", callable.fullName, callable)
      if callable.isUnsafe && this.unsafeDepth == 0
        this.report("NR189", calleeNode, "Unsafe function or method '" + callable.fullName + "' can be called only from an unsafe declaration or block.")
      end
      var targetName = callable.fullName
      if callable.cAbiSymbol != ""
        targetName = callable.cAbiSymbol
        return new BoundValue(callable.returnType, this.addBoundSymbol("Call", callable.returnType, targetName, callable.fullName, calleeNode, arguments))
      end
      return new BoundValue(callable.returnType, this.addBound("Call", callable.returnType, targetName, calleeNode, arguments))
    else if calleeKind == "Member"
      return this.bindMemberCall(node, calleeNode)
    end
    this.report("NR104", calleeNode, "Unsupported call target.")
    return new BoundValue("Error", this.addBound("Call", "Error", "", calleeNode, emptyInts()))
  end

  def bindMemberCall(node: Int, calleeNode: Int): BoundValue
    let objectNode = this.syntax().childAt(calleeNode, 0)
    let memberName = this.syntax().dataAt(calleeNode)
    let actual = this.syntax().childCountAt(node) - 1
    if this.syntax().kindAt(objectNode) == "Super"
      let currentClass = this.owner.currentClass
      if currentClass == null || currentClass.baseName == ""
        this.report("NR182", objectNode, "Keyword 'super' is valid only inside a derived instance method or constructor.")
        return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, emptyInts()))
      end
      let baseClass = this.model().findClass(currentClass.baseName)
      if baseClass == null
        this.report("NR182", objectNode, "Keyword 'super' is valid only inside a derived instance method or constructor.")
        return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, emptyInts()))
      end
      let method = this.findMethod(baseClass, memberName)
      if method == null
        this.report("NR186", calleeNode, "Base type '" + baseClass.fullName + "' does not define an accessible instance method '" + memberName + "'.")
        return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, emptyInts()))
      end
      this.validateCallCount(baseClass.name + "." + memberName, calleeNode, actual, method)
      let arguments = this.bindArguments(node, 1, method.parameterCount, "", baseClass.name + "." + memberName, method)
      var children = appendChild(emptyInts(), this.addBound("This", currentClass.fullName, "", objectNode, emptyInts()))
      for argument in arguments
        children = host.appendInt(children, argument)
      end
      return new BoundValue(method.returnType, this.addBoundValue("InstanceCall", method.returnType, method.fullName, "direct", calleeNode, children))
    end
    if this.syntax().kindAt(objectNode) == "Name"
      let objectName = this.syntax().dataAt(objectNode)
      let variableType = this.findVariableType(objectName)
      if variableType == ""
        let libraryType = this.libraryReturn(objectName, memberName)
        if libraryType != ""
          if objectName != "Array" && !this.model().hasUse(objectName)
            this.report("NR102", objectNode, "Library '" + objectName + "' is not imported.")
          end
          let expectedCount = this.libraryParameterCount(objectName, memberName)
          if actual != expectedCount
            this.reportLength("NR111", calleeNode, 1, "Function '" + objectName + "." + memberName + "' expects " + (expectedCount as String) + " arguments, but got " + (actual as String) + ".")
          end
          let arguments = this.bindArguments(node, 1, expectedCount, objectName, memberName, null)
          return new BoundValue(libraryType, this.addBound("Call", libraryType, objectName + "." + memberName, calleeNode, arguments))
        end
        let classSymbol = this.resolveClassForCall(objectName)
        if classSymbol != null
          let method = this.findMethod(classSymbol, memberName)
          if method == null
            this.report("NR131", calleeNode, "Type '" + classSymbol.fullName + "' does not have a member '" + memberName + "'.")
            return new BoundValue("Error", this.addBound("Call", "Error", classSymbol.fullName + "." + memberName, calleeNode, emptyInts()))
          end
          if !method.isStatic
            this.report("NR180", calleeNode, "Instance method '" + memberName + "' must be called through an instance.")
          end
          this.validateCallCount(classSymbol.name + "." + memberName, calleeNode, actual, method)
          let arguments = this.bindArguments(node, 1, method.parameterCount, "", classSymbol.name + "." + memberName, method)
          return new BoundValue(method.returnType, this.addBound("Call", method.returnType, method.fullName, calleeNode, arguments))
        end
        let namespaced = this.resolveFunction(objectName + "." + memberName)
        if namespaced != null
          this.validateCallCount(namespaced.fullName, calleeNode, actual, namespaced)
          let arguments = this.bindArguments(node, 1, namespaced.parameterCount, "", namespaced.fullName, namespaced)
          return new BoundValue(namespaced.returnType, this.addBound("Call", namespaced.returnType, namespaced.fullName, calleeNode, arguments))
        end
        this.report("NR103", objectNode, "Unknown object or library '" + objectName + "'.")
        return new BoundValue("Error", this.addBound("Call", "Error", objectName + "." + memberName, calleeNode, emptyInts()))
      end
    end
    let instance = this.bindExpression(objectNode, "")
    if semanticIsOptional(instance.typeName)
      this.report("NR169", objectNode, "Optional value of type '" + instance.typeName + "' must be narrowed before access.")
      return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, appendChild(emptyInts(), instance.boundNode)))
    end
    let classSymbol = this.model().findClass(instance.typeName)
    if classSymbol == null
      this.report("NR104", calleeNode, "Unsupported call target.")
      return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, appendChild(emptyInts(), instance.boundNode)))
    end
    let method = this.findMethod(classSymbol, memberName)
    if method == null
      this.report("NR131", calleeNode, "Type '" + classSymbol.fullName + "' does not have a member '" + memberName + "'.")
      return new BoundValue("Error", this.addBound("Call", "Error", memberName, calleeNode, appendChild(emptyInts(), instance.boundNode)))
    end
    if method.isStatic
      this.report("NR181", calleeNode, "Static method '" + memberName + "' must be called through its class.")
    end
    if !this.memberAccessible(method.className, method.access)
      this.report("NR153", calleeNode, "Cannot access " + method.access + " member '" + memberName + "' of type '" + method.className + "'.")
    end
    if method.isUnsafe && this.unsafeDepth == 0
      this.report("NR189", calleeNode, "Unsafe function or method '" + classSymbol.name + "." + memberName + "' can be called only from an unsafe declaration or block.")
    end
    this.validateCallCount(classSymbol.name + "." + memberName, calleeNode, actual, method)
    var children = appendChild(emptyInts(), instance.boundNode)
    let arguments = this.bindArguments(node, 1, method.parameterCount, "", classSymbol.name + "." + memberName, method)
    for argument in arguments
      children = host.appendInt(children, argument)
    end
    return new BoundValue(method.returnType, this.addBound("InstanceCall", method.returnType, method.fullName, calleeNode, children))
  end

  def resolveClassForCall(name: String): SemanticClass?
    let resolved = semanticResolveType(this.model(), name, this.owner.currentNamespace)
    if resolved == "Unknown" || resolved == "Ambiguous"
      return null
    end
    return this.model().findClass(resolved)
  end

  def bindNew(node: Int): BoundValue
    let typeNode = this.syntax().childAt(node, 0)
    let typeName = this.owner.resolveTypeNode(typeNode, this.owner.currentNamespace, "")
    let classSymbol = this.model().findClass(typeName)
    if classSymbol == null
      this.report("NR126B", node, "Cannot create instance of non-class type '" + this.syntax().dataAt(typeNode) + "'.")
      return new BoundValue("Error", this.addBound("New", "Error", typeName, node, emptyInts()))
    end
    let constructor = this.owner.findDeclaredMethod(classSymbol, "init")
    let actual = this.syntax().childCountAt(node) - 1
    if constructor == null
      if actual > 0
        this.report("NR154A", node, "Constructor 'init' was not found for class '" + classSymbol.name + "'.")
      end
      let arguments = this.bindArguments(node, 1, actual, "", classSymbol.name + ".init", null)
      return new BoundValue(typeName, this.addBound("New", typeName, classSymbol.fullName, node, arguments))
    end
    this.validateCallCount(classSymbol.name + ".init", node, actual, constructor)
    let arguments = this.bindArguments(node, 1, constructor.parameterCount, "", classSymbol.name + ".init", constructor)
    return new BoundValue(typeName, this.addBound("New", typeName, classSymbol.fullName, node, arguments))
  end

  def validRawElement(typeName: String): Bool
    return typeName == "Int" || typeName == "Bool" || typeName == "Byte" || typeName == "Float" || typeName == "Void"
  end

  def bindStackAlloc(node: Int): BoundValue
    let typeNode = this.syntax().childAt(node, 0)
    let typeName = this.owner.resolveTypeNode(typeNode, this.owner.currentNamespace, "")
    let countNode = this.syntax().childAt(node, 1)
    let count = this.bindExpression(countNode, "Int")
    if this.unsafeDepth == 0
      this.report("NR192", node, "Unsafe operation 'stackalloc' requires an unsafe declaration or block.")
    end
    if !this.validRawElement(typeName) || typeName == "Void"
      this.report("NR201", typeNode, "Type '" + typeName + "' cannot be allocated as a raw memory element.")
    end
    if count.typeName != "Int"
      this.report("NR112", countNode, "Argument 1 of 'stackalloc' expects type 'Int', but got '" + count.typeName + "'.")
    end
    let resultType = typeName + "*"
    return new BoundValue(resultType, this.addBound("StackAlloc", resultType, typeName, node, appendChild(emptyInts(), count.boundNode)))
  end

  def bindNative(node: Int): BoundValue
    let operation = semanticField(this.syntax().dataAt(node), 0)
    var offset = 0
    var elementType = ""
    if this.syntax().childCountAt(node) > 0 && this.syntax().kindAt(this.syntax().childAt(node, 0)) == "Type"
      elementType = this.owner.resolveTypeNode(this.syntax().childAt(node, 0), this.owner.currentNamespace, "")
      offset = 1
    end
    if this.unsafeDepth == 0
      this.report("NR192", node, "Unsafe operation 'native." + operation + "' requires an unsafe declaration or block.")
    end
    var resultType = "Error"
    if operation == "alloc" || operation == "allocZeroed"
      if elementType == ""
        this.report("NR200", node, "Intrinsic 'native." + operation + "' requires one element type argument.")
      else
        resultType = elementType + "*"
      end
    else if operation == "realloc"
      if elementType != ""
        this.report("NR200", node, "Intrinsic 'native.realloc' does not accept a type argument.")
      end
      if this.syntax().childCountAt(node) > offset
        let pointer = this.bindExpression(this.syntax().childAt(node, offset), "")
        resultType = pointer.typeName
      end
    else if operation == "free"
      resultType = "Void"
      if elementType != ""
        this.report("NR200", node, "Intrinsic 'native.free' does not accept a type argument.")
      end
    else
      this.report("NR199", node, "Unknown unsafe intrinsic 'native." + operation + "'.")
    end
    var children: Int[] = []
    var index = offset
    while index < this.syntax().childCountAt(node)
      let argument = this.bindExpression(this.syntax().childAt(node, index), "")
      children = host.appendInt(children, argument.boundNode)
      index = index + 1
    end
    var boundOperation = operation
    if operation == "allocZeroed"
      boundOperation = "calloc"
    end
    return new BoundValue(resultType, this.addBound("NativeIntrinsic", resultType, boundOperation, node, children))
  end
end
