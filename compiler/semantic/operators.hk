def semanticOperatorMethod(model: SemanticModel, receiverType: String, operation: String, arity: Int): SemanticCallable?
  let requirement = semanticTypeParameterOperator(model, receiverType, operation, arity)

  if requirement != null
    return requirement
  end
  if semanticIsNumeric(receiverType) || receiverType == "Bool" || receiverType == "Void" || receiverType == "Error" || receiverType == "Null"
    return null
  end
  var owner = model.findClass(semanticMutableType(receiverType))
  var steps = 0

  while owner != null && steps < 256
    var method = owner.firstMethod

    while method != null
      if method.operatorName == operation && method.parameterCount == arity
        if !semanticIsReadonly(receiverType) || method.isReadonly
          return method
        end
      end
      method = method.nextCallable
    end
    owner = model.findClass(owner.baseName)
    steps = steps + 1
  end
  return null
end

# Result of a safe built-in operation on operands with the same exact type.
# User-defined operators are resolved through semanticOperatorMethod.
def semanticBuiltinOperatorResult(receiverType: String, operation: String, arity: Int): String
  if arity == 0
    if operation == "!" && receiverType == "Bool"
      return "Bool"
    end
    if (operation == "+" || operation == "-") && semanticIsArithmetic(receiverType)
      return receiverType
    end
    return ""
  end
  if arity != 1
    return ""
  end
  if operation == "==" || operation == "!="
    return semanticEqualityComparable(receiverType) ? "Bool" : ""
  end
  if operation == "+" || operation == "-" || operation == "*" || operation == "/"
    return semanticIsArithmetic(receiverType) || (operation == "+" && receiverType == "String") ? receiverType : ""
  end
  if operation == "<" || operation == "<=" || operation == ">" || operation == ">="
    return semanticIsArithmetic(receiverType) ? "Bool" : ""
  end
  return ""
end

def semanticConversionMethod(model: SemanticModel, sourceType: String, targetType: String): SemanticCallable?
  if semanticIsNumeric(sourceType) || sourceType == "Bool" || sourceType == "Void" || sourceType == "Error" || sourceType == "Null"
    return null
  end
  var owner = model.findClass(semanticMutableType(sourceType))
  var steps = 0

  while owner != null && steps < 256
    var method = owner.firstMethod

    while method != null
      if method.conversion && method.returnType == targetType
        if !semanticIsReadonly(sourceType) || method.isReadonly
          return method
        end
      end
      method = method.nextCallable
    end
    owner = model.findClass(owner.baseName)
    steps = steps + 1
  end
  return null
end
