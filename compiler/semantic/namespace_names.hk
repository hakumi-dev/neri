use host

def semanticIsQualifiedName(name: String): Bool
  return semanticFindByte(name, 46) >= 0
end

def semanticNamespaceRoot(name: String): String
  let separator = semanticFindByte(name, 46)

  return separator < 0 ? name : host::stringSlice(name, 0, separator)
end

def semanticNamespacePrefix(name: String): String
  var index = host::stringByteLength(name) - 1

  while index >= 0
    if host::stringByteAt(name, index) == (46 as Byte)
      return host::stringSlice(name, 0, index)
    end
    index = index - 1
  end
  return ""
end

def semanticNamespaceDisplay(name: String): String
  var result = ""
  var start = 0
  var index = 0

  while index < host::stringByteLength(name)
    if host::stringByteAt(name, index) == (46 as Byte)
      result = result + host::stringSlice(name, start, index - start) + "::"
      start = index + 1
    end
    index = index + 1
  end
  return result + host::stringSlice(name, start, index - start)
end
