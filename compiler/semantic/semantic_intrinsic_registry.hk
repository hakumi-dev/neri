class SemanticIntrinsicRegistry
  public members: SemanticIntrinsicMember[]
  public first: SemanticNativeIntrinsic?
  public last: SemanticNativeIntrinsic?

  def init(domains: IrDomainCatalog): Void
    this.members = [new SemanticIntrinsicMember("array.length", "Array", "Length", "Int", domains.opcode.getArrayLength(), new EffectSet().withRead())]
    abiAddSemanticIntrinsics(this)
  end

  def add(value: SemanticNativeIntrinsic): Void
    if this.first == null
      this.first = value
    else
      let last = this.last

      if last != null
        last.next = value
      end
    end
    this.last = value
  end

  def find(name: String): SemanticNativeIntrinsic?
    var current = this.first

    while current != null
      if current.name == name
        return current
      end
      current = current.next
    end
    return null
  end

end
