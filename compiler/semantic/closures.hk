use host

# Function signatures share a hidden managed class and one virtual call slot.
def semanticFunctionType(owner: BootstrapBinder, parameters: StringBuffer, result: String, node: Int): SemanticClass
  var name = "fn("
  var index = 0
  while index < parameters.size
    if parameters.get(index) == "Void" || semanticContainsPointer(parameters.get(index))
      owner.report("NR212", node, "Callback parameters require safe value types other than Void.")
    end
    if index > 0 name = name + "," end
    name = name + parameters.get(index)
    index = index + 1
  end
  name = name + "):(" + result + ")"
  if semanticContainsPointer(result) owner.report("NR212", node, "Callbacks require a safe return type.") end
  let existing = owner.model.findClass(name)
  if existing != null return existing end
  let signature = new SemanticClass(name, name, "", "internal", node)
  signature.isFunctionType = true
  let invoke = new SemanticCallable(name + ".invoke", "invoke", "", name, result, false, false, "public", node)
  index = 0
  while index < parameters.size
    let parameterName = "argument" + (index as String)
    invoke.addParameter(new SemanticParameter(invoke.fullName + "/" + parameterName, parameterName, parameters.get(index), false, node))
    index = index + 1
  end
  invoke.boundNode = owner.addBound("Function", result, invoke.fullName, node, emptyInts())
  signature.addMethod(invoke)
  owner.model.addClass(signature)
  return signature
end

def closureHasVariable(body: BootstrapBodyBinder, name: String): Bool
  if body.findVariableType(name) != "" return true end
  let outer = body.enclosing
  if outer != null return closureHasVariable(outer, name) end
  return false
end

def bindCapture(body: BootstrapBodyBinder, node: Int, name: String): BoundValue
  let outer = body.enclosing
  let closure = body.closureClass
  if outer == null || closure == null
    body.report("NR211", node, "No enclosing value is available to capture.")
    return new BoundValue("Error", body.addBound("ErrorExpression", "Error", "", node, emptyInts()))
  end
  var index = 0
  var field = closure.firstField
  while field != null
    if body.captureNames.get(index) == name
      let receiver = body.addBound("This", closure.fullName, "", node, emptyInts())
      let typeName = body.findVariableType(name)
      return new BoundValue(typeName, body.addBound("Member", typeName, closure.fullName + "." + field.name, node, [receiver]))
    end
    field = field.nextField
    index = index + 1
  end
  let local = outer.findLocal(name)
  if local != null && local.mutable
    body.report("NR211", node, "Cannot capture mutable binding '" + name + "'; capture an immutable let binding instead.")
  end
  var value = new BoundValue("Error", -1)
  if name == "this" value = outer.bindThis(node) else value = outer.bindName(node) end
  if semanticContainsPointer(value.typeName)
    body.report("NR211", node, "A closure cannot capture a raw pointer or borrowed storage.")
  else if value.typeName == "Void"
    body.report("NR211", node, "A closure cannot capture a Void result.")
  end
  let fieldName = "capture" + (body.captureNames.size as String)
  closure.addField(new SemanticField(closure.fullName, fieldName, value.typeName, "private", node))
  body.captureNames.add(name)
  body.captureValues.add(value.boundNode)
  let receiver = body.addBound("This", closure.fullName, "", node, emptyInts())
  return new BoundValue(value.typeName, body.addBound("Member", value.typeName, closure.fullName + "." + fieldName, node, [receiver]))
end

def bindClosure(body: BootstrapBodyBinder, node: Int, expectedType: String): BoundValue
  let count = semanticIntField(body.syntax().dataAt(node), 0)
  let expectedClass = body.model().findClass(semanticIsOptional(expectedType) ? semanticInnerType(expectedType) : expectedType)
  var expected: SemanticCallable? = null
  if expectedClass != null && expectedClass.isFunctionType expected = expectedClass.firstMethod end
  if expected != null && expected.parameterCount != count
    body.report("NR212", node, "Callback parameter count does not match the expected function type.")
  end
  let parameterTypes = new StringBuffer()
  var index = 0
  while index < count
    let parameterNode = body.syntax().childAt(node, index)
    var typeName = "Error"
    if body.syntax().childCountAt(parameterNode) > 0
      typeName = body.owner.resolveTypeNode(body.syntax().childAt(parameterNode, 0), body.owner.currentNamespace, "")
    else if expected != null
      let parameter = expected.parameterAt(index)
      if parameter != null typeName = parameter.typeName end
    else
      body.report("NR212", parameterNode, "Callback parameter type requires an annotation or an expected function type.")
    end
    parameterTypes.add(typeName)
    index = index + 1
  end
  let resultNode = body.syntax().childAt(node, count)
  var result = "Error"
  if body.syntax().dataAt(resultNode) != ""
    result = body.owner.resolveTypeNode(resultNode, body.owner.currentNamespace, "")
  else if expected != null
    result = expected.returnType
  else
    body.report("NR212", node, "Callback return type requires an annotation or an expected function type.")
  end
  let signature = semanticFunctionType(body.owner, parameterTypes, result, node)
  let name = "$closure" + (body.model().nextClosureId as String)
  body.model().nextClosureId = body.model().nextClosureId + 1
  let closure = new SemanticClass(name, name, body.owner.currentNamespace, "internal", node)
  closure.isClosure = true
  closure.baseName = signature.fullName
  let invoke = new SemanticCallable(name + ".invoke", "invoke", body.owner.currentNamespace, name, result, false, false, "public", node)
  invoke.bodyStart = count + 1
  invoke.bodyCount = body.syntax().childCountAt(node) - invoke.bodyStart
  index = 0
  while index < count
    let parameterNode = body.syntax().childAt(node, index)
    let parameterName = body.syntax().dataAt(parameterNode)
    if body.owner.findParameter(invoke, parameterName) != null
      body.report("NR212", parameterNode, "Duplicate callback parameter '" + parameterName + "'.")
    end
    invoke.addParameter(new SemanticParameter(invoke.fullName + "/parameter" + (index as String), parameterName, parameterTypes.get(index), false, parameterNode))
    index = index + 1
  end
  closure.addMethod(invoke)
  body.model().addClass(closure)
  let owner = new BootstrapBinder(body.syntax(), body.owner.root, body.owner.sourceLength)
  owner.model = body.model()
  owner.sourceIds = body.owner.sourceIds
  owner.sourceStarts = body.owner.sourceStarts
  owner.currentNamespace = body.owner.currentNamespace
  owner.currentClass = closure
  let nested = new BootstrapBodyBinder(owner)
  nested.enclosing = body
  nested.closureClass = closure
  nested.bindCallable(invoke)
  var captures: Int[] = []
  index = 0
  while index < nested.captureValues.size
    captures = host.appendInt(captures, nested.captureValues.get(index))
    index = index + 1
  end
  return new BoundValue(signature.fullName, body.addBound("Closure", signature.fullName, name, node, captures))
end

def bindFunctionCall(body: BootstrapBodyBinder, node: Int, value: BoundValue): BoundValue
  let signature = body.model().findClass(value.typeName)
  if signature != null && signature.isFunctionType
    let invoke = signature.firstMethod
    if invoke != null
      body.validateCallCount(value.typeName, node, body.syntax().childCountAt(node) - 1, invoke)
      var children = [value.boundNode]
      let arguments = body.bindArguments(node, 1, invoke.parameterCount, "", value.typeName, invoke)
      for argument in arguments children = host.appendInt(children, argument) end
      return new BoundValue(invoke.returnType, body.addBound("InstanceCall", invoke.returnType, invoke.fullName, node, children))
    end
  end
  body.report("NR212", node, "Call target must have a non-optional function type.")
  return new BoundValue("Error", body.addBound("ErrorExpression", "Error", "", node, emptyInts()))
end

def bindFunctionValue(body: BootstrapBodyBinder, node: Int, function: SemanticCallable): BoundValue
  if function.isUnsafe || function.cAbiSymbol != ""
    body.report("NR212", node, "Unsafe and C ABI functions require an explicit safe callback wrapper.")
  end
  let parameters = new StringBuffer()
  var parameter = function.firstParameter
  while parameter != null
    parameters.add(parameter.typeName)
    parameter = parameter.nextParameter
  end
  let signature = semanticFunctionType(body.owner, parameters, function.returnType, node)
  let name = "$function." + function.fullName
  if body.model().findClass(name) == null
    let closure = new SemanticClass(name, name, "", "internal", node)
    closure.isClosure = true
    closure.baseName = signature.fullName
    let invoke = new SemanticCallable(name + ".invoke", "invoke", "", name, function.returnType, false, false, "public", node)
    var arguments: Int[] = []
    parameter = function.firstParameter
    while parameter != null
      let identity = invoke.fullName + "/" + parameter.name
      invoke.addParameter(new SemanticParameter(identity, parameter.name, parameter.typeName, false, node))
      arguments = host.appendInt(arguments, body.addBoundSymbol("Name", parameter.typeName, parameter.name, identity, node, emptyInts()))
      parameter = parameter.nextParameter
    end
    let call = body.addBound("Call", function.returnType, function.fullName, node, arguments)
    var statements: Int[] = []
    if function.returnType == "Void"
      statements = [body.addBound("ExpressionStatement", "Void", "", node, [call])]
    else
      statements = [body.addBound("Return", function.returnType, "", node, [call])]
    end
    invoke.boundNode = body.addBound("Function", function.returnType, invoke.fullName, node, statements)
    closure.addMethod(invoke)
    body.model().addClass(closure)
  end
  return new BoundValue(signature.fullName, body.addBound("Closure", signature.fullName, name, node, emptyInts()))
end
