class NativeField
  public name: String = ""
  public typeName: String = ""
  public offset: Int = 0
  public syntaxNode: Int = -1
  public nextField: NativeField?
  def init(name: String, typeName: String, node: Int): Void
    this.name = name
    this.typeName = typeName
    this.syntaxNode = node
  end
end
