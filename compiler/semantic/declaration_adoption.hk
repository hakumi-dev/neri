def semanticAdoptDeclarations(child: SemanticModel, project: SemanticModel): Void
  let lastClass = child.lastClass
  let lastFunction = child.lastFunction
  let lastRecord = child.lastRecord

  if lastClass == null
    child.firstClass = project.firstClass
  else
    lastClass.nextClass = project.firstClass
  end
  if project.lastClass != null
    child.lastClass = project.lastClass
  end
  if lastFunction == null
    child.firstFunction = project.firstFunction
  else
    lastFunction.nextCallable = project.firstFunction
  end
  if project.lastFunction != null
    child.lastFunction = project.lastFunction
  end
  if lastRecord == null
    child.firstRecord = project.firstRecord
  else
    lastRecord.nextRecord = project.firstRecord
  end
  if project.lastRecord != null
    child.lastRecord = project.lastRecord
  end
  let lastContract = child.lastContract

  if lastContract == null
    child.firstContract = project.firstContract
  else
    lastContract.nextContract = project.firstContract
  end
  if project.lastContract != null
    child.lastContract = project.lastContract
  end
  child.parent = null
end
