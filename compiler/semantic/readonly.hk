def semanticIsReadonly(typeName: String): Bool
  return host.stringByteLength(typeName) > 10 && host.stringSlice(typeName, 0, 9) == "readonly(" && semanticEndsWith(typeName, ")")
end

def semanticMutableType(typeName: String): String
  if semanticIsReadonly(typeName)
    return host.stringSlice(typeName, 9, host.stringByteLength(typeName) - 10)
  end
  return typeName
end

# Scalars are values; managed views restrict every reference reached through them.
def semanticReadView(typeName: String): String
  if semanticIsReadonly(typeName) || semanticIsBuiltin(typeName) || typeName == "Error" || typeName == "Null"
    return typeName
  end
  if semanticIsOptional(typeName)
    return semanticReadView(semanticInnerType(typeName)) + "?"
  end
  return "readonly(" + typeName + ")"
end

def semanticViewMember(receiver: String, member: String): String
  if semanticIsReadonly(receiver)
    return semanticReadView(member)
  end
  return member
end
