use ConsoleInteraction
use host

def semanticHexDigit(value: Int): String
  return textSlice("0123456789abcdef", value, 1)
end

def semanticHex(value: String): String
  var result = ""
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    result = result + semanticHexDigit(byte / 16) + semanticHexDigit(byte - (byte / 16) * 16)
    index = index + 1
  end
  return result
end

def emitSemanticDiagnostics(diagnostics: DiagnosticBuffer): Void
  var index = 0
  while index < diagnostics.count()
    ConsoleInteraction.println("D|" + diagnostics.codes.get(index) + "|" + (diagnostics.starts.get(index) as String) + "|" + (diagnostics.lengths.get(index) as String) + "|" + semanticHex(diagnostics.messages.get(index)))
    index = index + 1
  end
end

def emitBoundNode(arena: BoundArena, node: Int, depth: Int): Void
  ConsoleInteraction.println("B|" + (depth as String) + "|" + arena.kindAt(node) + "|" + semanticHex(arena.typeAt(node)) + "|" + semanticHex(arena.dataAt(node)) + "|" + (arena.childCountAt(node) as String))
  var index = 0
  while index < arena.childCountAt(node)
    emitBoundNode(arena, arena.childAt(node, index), depth + 1)
    index = index + 1
  end
end

def emitCallableSymbol(kind: String, callable: SemanticCallable): Void
  let flags = (callable.isStatic ? "static" : "instance") + "|" + (callable.isUnsafe ? "unsafe" : "safe")
  ConsoleInteraction.println("S|" + kind + "|" + semanticHex(callable.fullName) + "|" + semanticHex(callable.returnType) + "|" + (callable.parameterCount as String) + "|" + flags)
  var parameter = callable.firstParameter
  var index = 0
  while parameter != null
    ConsoleInteraction.println("S|parameter|" + semanticHex(callable.fullName + "/parameter[" + (index as String) + "]") + "|" + semanticHex(parameter.name) + "|" + semanticHex(parameter.typeName) + "|" + (parameter.hasDefault ? "default" : "required"))
    parameter = parameter.nextParameter
    index = index + 1
  end
end

def emitSemanticModel(model: SemanticModel): Void
  var classSymbol = model.firstClass
  while classSymbol != null
    ConsoleInteraction.println("S|class|" + semanticHex(classSymbol.fullName) + "|" + semanticHex(classSymbol.baseName) + "|" + classSymbol.access)
    var field = classSymbol.firstField
    while field != null
      ConsoleInteraction.println("S|field|" + semanticHex(field.owner + "." + field.name) + "|" + semanticHex(field.typeName) + "|" + field.access)
      field = field.nextField
    end
    var method = classSymbol.firstMethod
    while method != null
      emitCallableSymbol("method", method)
      if method.boundNode >= 0
        emitBoundNode(model.bound, method.boundNode, 0)
      end
      method = method.nextCallable
    end
    classSymbol = classSymbol.nextClass
  end
  var function = model.firstFunction
  while function != null
    emitCallableSymbol("function", function)
    if function.boundNode >= 0
      emitBoundNode(model.bound, function.boundNode, 0)
    end
    function = function.nextCallable
  end
  emitSemanticDiagnostics(model.diagnostics)
end

def main(): Void
  if host.argumentCount() != 1
    ConsoleInteraction.println("usage: neri-bootstrap-semantic <source.hk>")
    return
  end
  let path = host.argumentAt(0)
  if path == null
    ConsoleInteraction.println("source argument unavailable")
    return
  end
  let source = host.readText(path)
  if source == null
    ConsoleInteraction.println("source read failed: " + host.errorMessage())
    return
  end
  if host.stringByteLength(source) > 1048576
    ConsoleInteraction.println("D|NRB001|0|1|" + semanticHex("Source exceeds the 1048576-byte bootstrap frontend limit."))
    return
  end
  let lexer = new BootstrapLexer(source)
  let tokens = lexer.lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()
  if parser.diagnostics.count() > 0
    emitSemanticDiagnostics(parser.diagnostics)
    return
  end
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
  emitSemanticModel(binder.bind())
end
