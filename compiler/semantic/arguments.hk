use host

class SemanticArgumentMap
  public sourceToParameter: IntBuffer = new IntBuffer()
  public supplied: IntBuffer = new IntBuffer()
  public hasNamed: Bool = false

  def parameterAt(sourceIndex: Int): Int
    if sourceIndex < 0 || sourceIndex >= this.sourceToParameter.size
      return -1
    end
    return this.sourceToParameter.get(sourceIndex)
  end
end

def semanticArgumentExpression(syntax: SyntaxArena, node: Int): Int
  if syntax.kindAt(node) == "NamedArgument" && syntax.childCountAt(node) > 0
    return syntax.childAt(node, 0)
  end
  return node
end

def semanticArgumentLabel(syntax: SyntaxArena, node: Int): String
  if syntax.kindAt(node) == "NamedArgument"
    return syntax.dataAt(node)
  end
  return ""
end

def semanticArgumentParameterIndex(names: StringBuffer, name: String): Int
  var index = 0

  while index < names.size
    if names.get(index) == name
      return index
    end
    index = index + 1
  end
  return -1
end

def semanticMapArguments(owner: BootstrapBinder, node: Int, start: Int, parameterNames: StringBuffer, defaultFlags: IntBuffer, displayName: String, labelsSupported: Bool = true, reportDiagnostics: Bool = true): SemanticArgumentMap
  let result = new SemanticArgumentMap()
  var parameterIndex = 0

  while parameterIndex < parameterNames.size
    result.supplied.add(0)
    parameterIndex = parameterIndex + 1
  end
  let actual = owner.syntax.childCountAt(node) - start
  var nextPositional = 0
  var reportedTooMany = false
  var sourceIndex = 0

  while sourceIndex < actual
    let argumentNode = owner.syntax.childAt(node, start + sourceIndex)
    let label = semanticArgumentLabel(owner.syntax, argumentNode)
    var mapped = -1

    if label != ""
      result.hasNamed = true
      if !labelsSupported
        if reportDiagnostics
          owner.report("NR275", argumentNode, "Named arguments are not supported for callable values because their parameter labels are not part of the function type.")
        end
        while nextPositional < parameterNames.size && result.supplied.get(nextPositional) != 0
          nextPositional = nextPositional + 1
        end
        mapped = nextPositional
      else
        mapped = semanticArgumentParameterIndex(parameterNames, label)
        if mapped < 0 && reportDiagnostics
          owner.report("NR270", argumentNode, "Function '" + displayName + "' has no parameter named '" + label + "'.")
        end
      end
    else
      if result.hasNamed && reportDiagnostics
        owner.report("NR272", argumentNode, "Positional arguments must appear before named arguments.")
      end
      while nextPositional < parameterNames.size && result.supplied.get(nextPositional) != 0
        nextPositional = nextPositional + 1
      end
      mapped = nextPositional
    end
    result.sourceToParameter.add(mapped)
    if mapped >= 0 && mapped < parameterNames.size
      if result.supplied.get(mapped) != 0
        if reportDiagnostics
          owner.report("NR271", argumentNode, "Argument for parameter '" + parameterNames.get(mapped) + "' of function '" + displayName + "' is supplied more than once.")
        end
      else
        result.supplied.set(mapped, 1)
      end
      if mapped == nextPositional
        nextPositional = nextPositional + 1
      end
    else if label == "" && reportDiagnostics && !reportedTooMany
      owner.reportLength("NR274", node, 1, "Function '" + displayName + "' expects at most " + (parameterNames.size as String) + " arguments, but got " + (actual as String) + ".")
      reportedTooMany = true
    end
    sourceIndex = sourceIndex + 1
  end
  if labelsSupported
    parameterIndex = 0
    while parameterIndex < parameterNames.size
      let hasDefault = parameterIndex < defaultFlags.size && defaultFlags.get(parameterIndex) != 0

      if result.supplied.get(parameterIndex) == 0 && !hasDefault && reportDiagnostics
        owner.reportLength("NR273", node, 1, "Function '" + displayName + "' requires argument '" + parameterNames.get(parameterIndex) + "'.")
      end
      parameterIndex = parameterIndex + 1
    end
  end
  return result
end

def semanticCallableArgumentMap(owner: BootstrapBinder, node: Int, start: Int, callable: SemanticCallable, displayName: String, labelsSupported: Bool = true, reportDiagnostics: Bool = true): SemanticArgumentMap
  let names = new StringBuffer()
  let defaults = new IntBuffer()
  var parameter = callable.firstParameter

  while parameter != null
    names.add(parameter.name)
    defaults.add(parameter.hasDefault ? 1 : 0)
    parameter = parameter.nextParameter
  end
  let mapping = semanticMapArguments(owner, node, start, names, defaults, displayName, labelsSupported, reportDiagnostics)

  if reportDiagnostics
    semanticValidateNamedDefaults(owner, node, callable, mapping)
  end
  return mapping
end

def semanticValidateNamedDefaults(owner: BootstrapBinder, node: Int, callable: SemanticCallable, mapping: SemanticArgumentMap): Void
  if !mapping.hasNamed || (!callable.isUnsafe && callable.cAbiSymbol == "")
    return
  end
  var index = 0
  var parameter = callable.firstParameter

  while parameter != null
    if parameter.hasDefault && mapping.supplied.get(index) == 0
      owner.report("NR275", node, "Named calls to unsafe or C ABI declarations require every parameter explicitly; their default adapters are unavailable.")
      return
    end
    parameter = parameter.nextParameter
    index = index + 1
  end
end
