use host

def bindCFunctionCall(body: BootstrapBodyBinder, node: Int, value: BoundValue): BoundValue
  let components = semanticCFunctionComponents(value.typeName)

  if body.unsafeDepth == 0
    body.report("NR189", node, "C function-pointer calls require an unsafe declaration or block.")
  end
  let actual = body.syntax().childCountAt(node) - 1
  let expected = components.size - 1

  if actual != expected
    body.report("NR281", node, "C function pointer expects " + (expected as String) + " arguments, but got " + (actual as String) + ".")
  end
  var children = [value.boundNode]
  var index = 0

  while index < actual
    let argument = body.syntax().childAt(node, index + 1)
    let expression = semanticArgumentExpression(body.syntax(), argument)
    let typeName = index < expected ? components.get(index + 1) : ""
    let bound = body.bindExpression(expression, typeName)

    if semanticArgumentLabel(body.syntax(), argument) != ""
      body.report("NR275", argument, "C function-pointer calls require positional arguments.")
    end
    if index < expected && !semanticAssignable(body.model(), typeName, bound.typeName)
      body.report("NR281", expression, "C function-pointer argument must have type '" + semanticCFunctionDisplay(typeName) + "'.")
    end
    children = host::appendInt(children, bound.boundNode)
    index = index + 1
  end
  return new BoundValue(components.get(0), body.addBound(body.boundKinds().getCCall(), components.get(0), "", node, children))
end
