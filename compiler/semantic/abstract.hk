# This pure query supports source displays before semantic validation runs.
def semanticAbstractClass(syntax: SyntaxArena, node: Int): Bool
  for annotation in syntax.nodeAt(node).classAnnotations
    if syntax.dataAt(annotation) == "abstract"
      return true
    end
  end
  return false
end

def validateAbstractClass(owner: BootstrapBinder, node: Int, reportErrors: Bool = true): Bool
  var found = false
  var valid = true
  var incompatible = false

  for annotation in owner.syntax.nodeAt(node).classAnnotations
    let name = owner.syntax.dataAt(annotation)

    if name == "abstract"
      if found || owner.syntax.childCountAt(annotation) != 0
        owner.report("NR253", annotation, "Annotation '@abstract' applies once to an ordinary class, without arguments.") if reportErrors
        valid = false
      end
      found = true
    end
    incompatible = true if name == "sealed" || name == "representation"
  end
  let role = semanticField(owner.syntax.dataAt(node), 4)

  incompatible = true if role == "resource" || role == "enum"
  if found && incompatible
    owner.report("NR253", node, "An abstract class cannot be sealed, resource-backed, represented, or an alternative type.") if reportErrors
    valid = false
  end
  return found && valid
end

def validateAbstractMethod(owner: BootstrapBinder, node: Int, classIsAbstract: Bool, reportErrors: Bool = true): Bool
  let annotationCount = semanticIntField(owner.syntax.dataAt(node), 1)
  let functionNode = owner.syntax.childAt(node, annotationCount)
  var found = false
  var valid = classIsAbstract
  var index = 0

  while index < annotationCount
    let annotation = owner.syntax.childAt(node, index)

    if owner.syntax.dataAt(annotation) == "abstract"
      if found || owner.syntax.childCountAt(annotation) != 0
        owner.report("NR254", annotation, "Annotation '@abstract' applies once to an abstract instance method, without arguments.") if reportErrors
        valid = false
      end
      found = true
    end
    index = index + 1
  end
  if !found
    return false
  end
  let data = owner.syntax.dataAt(functionNode)
  let name = semanticField(data, 1)
  let bodyCount = semanticIntField(data, 4)
  let isStatic = semanticBoolField(data, 5)
  let isUnsafe = semanticBoolField(data, 6)
  let access = semanticField(owner.syntax.dataAt(node), 0)

  if !classIsAbstract || bodyCount != 0 || name == "init" || isStatic || isUnsafe || access == "private"
    owner.report("NR254", functionNode, "An abstract method belongs to an abstract class and has no body, constructor, static, private, or unsafe modifier.") if reportErrors
    valid = false
  end
  return valid
end

def validateGenericAbstractDeclarations(owner: BootstrapBinder, node: Int): Void
  if owner.syntax.kindAt(node) != "Class"
    return
  end
  let classIsAbstract = validateAbstractClass(owner, node)
  var member = owner.classMemberStart(node)

  while member < owner.syntax.childCountAt(node)
    let declaration = owner.syntax.childAt(node, member)

    validateAbstractMethod(owner, declaration, classIsAbstract) if owner.syntax.kindAt(declaration) == "Method"
    member = member + 1
  end
end

def copyAbstractRequirements(target: SemanticClass, source: SemanticClass): Void
  var requirement = source.firstAbstractRequirement

  while requirement != null
    target.addAbstractRequirement(new SemanticAbstractRequirement(requirement.callable))
    requirement = requirement.nextRequirement
  end
end

def removeAbstractRequirement(classSymbol: SemanticClass, previous: SemanticAbstractRequirement?, current: SemanticAbstractRequirement): Void
  let next = current.nextRequirement

  if previous == null
    classSymbol.firstAbstractRequirement = next
  else
    previous.nextRequirement = next
  end
end

def validateAbstractClassObligations(owner: BootstrapBinder, classSymbol: SemanticClass): Void
  return if classSymbol.abstractValidationState == 2
  return if classSymbol.abstractValidationState == 1
  classSymbol.abstractValidationState = 1
  let base = owner.model.findClass(classSymbol.baseName)

  if base != null
    validateAbstractClassObligations(owner, base)
    copyAbstractRequirements(classSymbol, base)
  end
  var method = classSymbol.firstMethod

  while method != null
    var previous: SemanticAbstractRequirement? = null
    var requirement = classSymbol.firstAbstractRequirement
    var matched = false

    while requirement != null
      let required = requirement.callable

      if !method.isStatic && !required.isStatic && required.name == method.name && owner.compatibleMethods(method, required)
        matched = true
        if method.isAbstract
          requirement.callable = method
        else
          removeAbstractRequirement(classSymbol, previous, requirement)
        end
        break
      end
      previous = requirement
      requirement = requirement.nextRequirement
    end
    if method.isAbstract && !matched
      classSymbol.addAbstractRequirement(new SemanticAbstractRequirement(method))
    end
    method = method.nextCallable
  end
  let pending = classSymbol.firstAbstractRequirement

  if !classSymbol.isAbstract && pending != null
    owner.report("NR255", classSymbol.syntaxNode, "Concrete class '" + classSymbol.fullName + "' must implement abstract method '" + pending.callable.fullName + "'.")
  end
  classSymbol.abstractValidationState = 2
end

def validateAbstractClasses(owner: BootstrapBinder): Void
  var classSymbol = owner.model.firstClass

  while classSymbol != null
    validateAbstractClassObligations(owner, classSymbol)
    classSymbol = classSymbol.nextClass
  end
end
