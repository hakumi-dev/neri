use host
use quotation
namespace neri_data

## An immutable Guid with canonical lowercase hexadecimal text storage.
class Guid
  private value: String = "00000000-0000-0000-0000-000000000000"

  static def empty(): Guid
    return new Guid()
  end

  static def parse(value: String): Guid?
    if host::stringByteLength(value) != 36
      return null
    end
    var canonical = ""
    var index = 0

    while index < 36
      var byte = host::stringByteAt(value, index) as Int

      if index == 8 || index == 13 || index == 18 || index == 23
        if byte != 45
          return null
        end
        canonical = canonical + "-"
      else
        if byte >= 65 && byte <= 70
          byte = byte + 32
        end
        if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102))
          return null
        end
        canonical = canonical + host::stringSlice("0123456789abcdef", byte <= 57 ? byte - 48 : byte - 87, 1)
      end
      index = index + 1
    end
    let result = new Guid()

    result.value = canonical
    return result
  end

  public readonly def toText(): String
    return this.value
  end

  public static def captureQuotation(value: readonly Guid?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toText())
  end

  @operator("==")
  public readonly def equals(other: readonly Guid): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly Guid): Bool
    return this.value != other.value
  end
end
