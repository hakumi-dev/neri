use host
namespace neri_data

def calendarMonthDays(year: Int, month: Int): Int
  if month == 2
    return year - year / 4 * 4 == 0 && (year - year / 100 * 100 != 0 || year - year / 400 * 400 == 0) ? 29 : 28
  end
  return month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31
end

def calendarYearDays(year: Int): Int
  let prior = year - 1

  return prior * 365 + prior / 4 - prior / 100 + prior / 400
end

def calendarDateTimeTicks(value: String): Int
  let year = calendarDigits(value, 0, 4)
  let month = calendarDigits(value, 5, 2)
  var days = calendarYearDays(year) + calendarDigits(value, 8, 2) - 1
  var preceding = 1

  while preceding < month
    days = days + calendarMonthDays(year, preceding)
    preceding = preceding + 1
  end
  return days * 864000000000 + calendarDigits(
    value,
    11,
    2
  ) * 36000000000 + calendarDigits(
    value,
    14,
    2
  ) * 600000000 + calendarDigits(
    value,
    17,
    2
  ) * 10000000 + calendarDigits(
    value,
    20,
    7
  )
end

def calendarPad(value: Int, width: Int): String
  var text = value as String

  while host::stringByteLength(text) < width
    text = "0" + text
  end
  return text
end

def calendarTicksText(ticks: Int): String?
  if ticks < 0 || ticks > 3155378975999999999
    return null
  end
  let days = ticks / 864000000000
  var lower = 1
  var upper = 10000

  while lower + 1 < upper
    let middle = (lower + upper) / 2

    if calendarYearDays(middle) <= days
      lower = middle
    else
      upper = middle
    end
  end
  var remaining = days - calendarYearDays(lower)
  var month = 1

  while remaining >= calendarMonthDays(lower, month)
    remaining = remaining - calendarMonthDays(lower, month)
    month = month + 1
  end
  let daytime = ticks - days * 864000000000
  let hour = daytime / 36000000000
  let minute = daytime / 600000000 - hour * 60
  let second = daytime / 10000000 - (daytime / 600000000) * 60
  let fraction = daytime - (daytime / 10000000) * 10000000

  return calendarPad(
    lower,
    4
  ) + "-" + calendarPad(
    month,
    2
  ) + "-" + calendarPad(
    remaining + 1,
    2
  ) + "T" + calendarPad(
    hour,
    2
  ) + ":" + calendarPad(
    minute,
    2
  ) + ":" + calendarPad(
    second,
    2
  ) + "." + calendarPad(
    fraction,
    7
  ) + "Z"
end
