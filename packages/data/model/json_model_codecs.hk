use json
use result
use host
namespace neri_data

def jsonModelCell(value: json::Value?, kind: String): Cell
  if value == null || value.kind() == "null"
    return Cell.Null()
  end
  let text = value.text()

  if kind == "String" && value.kind() == "string" && text != null
    return Cell.Text(text)
  else if kind == "Int" && value.kind() == "number" && text != null
    let number = host::parseInt(text)

    if number != null
      return Cell.Int(number)
    end
  else if kind == "Bool" && value.kind() == "boolean" && text != null
    return Cell.Bool(text == "true")
  else if kind == "Float" && value.kind() == "number" && text != null
    let number = host::parseFloat(text)

    if number != null && number == number && number - number == 0.0
      return Cell.Float(number)
    end
  else if kind == "Array" && value.kind() == "array"
    match json::stringify(value)
      case result::Result.Ok(encoded)
        return Cell.Text(encoded)
      case result::Result.Error(error)
    end
  end
  return Cell.Binary(new ByteBuffer(1, 0))
end

def jsonModelValue(cell: Cell, array: Bool = false): json::Value
  if array
    match cell
      case Cell.Null()
        return json::Value.nullValue()
      case Cell.Text(value)
        match json::parse(value)
          case result::Result.Ok(parsed)
            return parsed
          case result::Result.Error(error)
            return new json::Value("invalid")
        end
      case Cell.Int(value)
      case Cell.Bool(value)
      case Cell.Float(value)
      case Cell.Binary(value)
        return new json::Value("invalid")
    end
  end
  match cell
    case Cell.Null()
      return json::Value.nullValue()
    case Cell.Bool(value)
      return json::Value.boolean(value)
    case Cell.Int(value)
      return new json::Value("number", value as String)
    case Cell.Float(value)
      return new json::Value("number", value as String)
    case Cell.Text(value)
      return json::Value.string(value)
    case Cell.Binary(value)
      return new json::Value("invalid")
  end
end
