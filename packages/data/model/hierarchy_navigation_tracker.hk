namespace neri_data

## A typed view of the root tracker. Its rows, ownership, and observers remain root-owned.
class HierarchyNavigationTracker<B, D>: NavigationTracker<D>
  private root: NavigationTracker<B>
  private upcast: fn(D): B
  private downcast: fn(B): D?
  private resolver: HierarchyRowResolver<B, D>

  def init(root: NavigationTracker<B>, upcast: fn(D): B, downcast: fn(B): D?): Void
    this.root = root
    this.upcast = upcast
    this.downcast = downcast
    this.resolver = new HierarchyRowResolver<B, D>(root, upcast, downcast)
  end

  internal override def navigationIdentity(): NavigationTrackerIdentity
    return this.root.navigationIdentity()
  end

  internal override def navigationIdentityResolver(): NavigationTracker<D>
    return new HierarchyNavigationTracker<B, D>(this.root.navigationIdentityResolver(), this.upcast, this.downcast)
  end

  internal override def ownsPersistedForNavigation(entity: D): Bool
    return this.root.ownsPersistedForNavigation(this.upcast(entity))
  end

  internal override def visitTracked(visitor: fn(D): Bool): Bool
    let visit: fn(B): Bool = fn(value: B): Bool do
      let child = this.downcast(value)

      return child == null || visitor(child)
    end

    return this.root.visitTracked(visit)
  end

  public override def observeMaterialization(action: fn(): QueryFailure?): Void
    this.root.observeMaterialization(action)
  end

  public override def observeClear(action: fn(): Void): Void
    this.root.observeClear(action)
  end

  public override def stateOf(entity: D): TrackingState?
    return this.root.stateOf(this.upcast(entity))
  end

  public override def original(entity: D): RawRow?
    return this.root.original(this.upcast(entity))
  end

  public override def current(entity: D): RawRow?
    return this.root.current(this.upcast(entity))
  end

  public override def resolveRows(rows: TypedRows<D>): QueryResult<D>
    return this.resolver.resolveRows(rows)
  end
end
