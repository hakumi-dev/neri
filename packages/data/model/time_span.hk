use quotation
namespace neri_data

## A signed duration with exact 100-nanosecond ticks across the Int range.
class TimeSpan
  private value: Int = 0

  static def zero(): TimeSpan
    return new TimeSpan()
  end

  static def fromTicks(ticks: Int): TimeSpan
    let duration = new TimeSpan()

    duration.value = ticks
    return duration
  end

  public readonly def ticks(): Int
    return this.value
  end

  public static def captureQuotation(value: readonly TimeSpan?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Int(value.ticks())
  end

  public readonly def add(other: readonly TimeSpan): TimeSpan?
    if (other.value > 0 && this.value > 9223372036854775807 - other.value) || (other.value < 0 && this.value < -9223372036854775808 - other.value)
      return null
    end
    return TimeSpan.fromTicks(this.value + other.value)
  end

  @operator("==")
  public readonly def equals(other: readonly TimeSpan): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly TimeSpan): Bool
    return this.value != other.value
  end

  @operator("<")
  public readonly def before(other: readonly TimeSpan): Bool
    return this.value < other.value
  end

  @operator("<=")
  public readonly def beforeOrEqual(other: readonly TimeSpan): Bool
    return this.value <= other.value
  end

  @operator(">")
  public readonly def after(other: readonly TimeSpan): Bool
    return this.value > other.value
  end

  @operator(">=")
  public readonly def afterOrEqual(other: readonly TimeSpan): Bool
    return this.value >= other.value
  end
end
