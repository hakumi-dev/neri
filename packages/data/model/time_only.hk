use host
use quotation
namespace neri_data

## A time of day with exact 100-nanosecond resolution and fixed-width storage.
class TimeOnly
  private value: String = "00:00:00.0000000"

  static def minimum(): TimeOnly
    return new TimeOnly()
  end

  static def parse(value: String): TimeOnly?
    let length = host::stringByteLength(value)

    if length < 8 || length > 16 || host::stringByteAt(
      value,
      2
    ) as Int != 58 || host::stringByteAt(
      value,
      5
    ) as Int != 58
      return null
    end
    let hour = calendarDigits(value, 0, 2)
    let minute = calendarDigits(value, 3, 2)
    let second = calendarDigits(value, 6, 2)

    if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59
      return null
    end
    var fraction = ""

    if length > 8
      if length < 10 || host::stringByteAt(value, 8) as Int != 46 || calendarDigits(value, 9, length - 9) < 0
        return null
      end
      fraction = host::stringSlice(value, 9, length - 9)
    end
    while host::stringByteLength(fraction) < 7
      fraction = fraction + "0"
    end
    let result = new TimeOnly()

    result.value = host::stringSlice(value, 0, 8) + "." + fraction
    return result
  end

  public readonly def toText(): String
    return this.value
  end

  public static def captureQuotation(value: readonly TimeOnly?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toText())
  end

  @operator("==")
  public readonly def equals(other: readonly TimeOnly): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly TimeOnly): Bool
    return this.value != other.value
  end

  @operator("<")
  public readonly def before(other: readonly TimeOnly): Bool
    return compareScalarText(this.value, other.value) < 0
  end

  @operator("<=")
  public readonly def beforeOrEqual(other: readonly TimeOnly): Bool
    return compareScalarText(this.value, other.value) <= 0
  end

  @operator(">")
  public readonly def after(other: readonly TimeOnly): Bool
    return compareScalarText(this.value, other.value) > 0
  end

  @operator(">=")
  public readonly def afterOrEqual(other: readonly TimeOnly): Bool
    return compareScalarText(this.value, other.value) >= 0
  end
end
