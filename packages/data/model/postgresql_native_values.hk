use host
namespace neri_data

def postgresNativeTextFits(physical: String, oid: Int, canonical: String): Bool
  if oid == 1700
    let facet = postgresNativeNumericFacet(physical)

    if facet == null
      return true
    end
    let sign = canonical.startsWith("-") ? 1 : 0
    let scale = decimalScale(canonical)
    let whole = host::stringByteLength(canonical) - sign - (scale > 0 ? scale + 1 : 0)

    return scale <= facet.fractionDigits && (whole <= facet.integralDigits || (whole == 1 && (host::stringByteAt(
            canonical,
            sign
          ) as Int) == 48))
  end
  if oid == 1082
    return true
  end
  let precision = postgresNativeTemporalPrecision(physical, oid)
  let start = oid == 1083 ? 9 : 20
  var index = start + precision

  while index < start + 7
    if (host::stringByteAt(canonical, index) as Int) != 48
      return false
    end
    index = index + 1
  end
  return true
end

def postgresNativeIntervalFits(ticks: Int, precision: Int): Bool
  var divisor = 10
  var remaining = 6 - precision

  while remaining > 0
    divisor = divisor * 10
    remaining = remaining - 1
  end
  return ticks / divisor * divisor == ticks
end

## Validates canonical generated values before an entity is changed.
def postgresNativeGeneratedValueValid(value: readonly Cell, column: readonly ResultColumn): Bool
  let physical = column.postgresqlType()

  if physical == null
    return true
  end
  let oid = postgresNativeScalarOid(physical)

  match value
    case Cell.Null()
      return oid != 0
    case Cell.Int(ticks)
      return oid == 1186 && postgresNativeIntervalFits(ticks, postgresNativeTemporalPrecision(physical, oid))
    case Cell.Text(text)
      if oid == 1700
        let parsed = Decimal.parse(text)

        return parsed != null && parsed.text() == text && postgresNativeTextFits(physical, oid, text)
      end
      if oid == 1082
        let parsed = DateOnly.parse(text)

        return parsed != null && parsed.toText() == text
      end
      if oid == 1083
        let parsed = TimeOnly.parse(text)

        return parsed != null && parsed.toText() == text && postgresNativeTextFits(physical, oid, text)
      end
      if oid == 1114 || oid == 1184
        let parsed = DateTime.parse(text)

        return parsed != null && parsed.toText() == text && postgresNativeTextFits(physical, oid, text)
      end
      return false
    case Cell.Bool(unused)
      return false
    case Cell.Float(unused)
      return false
    case Cell.Binary(unused)
      return false
  end
end
