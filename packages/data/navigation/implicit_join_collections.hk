use reference
namespace neri_data

## Stores hidden join collections within one generated context's identity scope.
class ImplicitJoinCollections<E, J>
  private first: ImplicitJoinCollection<E, J>?

  def get(owner: E): J[]
    var current = this.first

    while current != null
      if reference::same(current.owner, owner)
        return current.values
      end
      current = current.next
    end
    return []
  end

  def set(owner: E, values: J[]): Void
    var current = this.first

    while current != null
      if reference::same(current.owner, owner)
        current.values = values
        return
      end
      current = current.next
    end
    let entry = new ImplicitJoinCollection<E, J>(owner, values)

    entry.next = this.first
    this.first = entry
  end

  def clear(): Void
    this.first = null
  end
end
