namespace neri_data

## Tracking operations shared by a root entity set and its typed navigation views.
abstract class NavigationTracker<T>: AsyncRowResolver<T>
  internal abstract def navigationIdentity(): NavigationTrackerIdentity
  internal abstract def navigationIdentityResolver(): NavigationTracker<T>
  internal abstract def ownsPersistedForNavigation(entity: T): Bool
  internal abstract def visitTracked(visitor: fn(T): Bool): Bool
  public abstract def observeMaterialization(action: fn(): QueryFailure?): Void
  public abstract def observeClear(action: fn(): Void): Void
  public abstract def stateOf(entity: T): TrackingState?
  public abstract def original(entity: T): RawRow?
  public abstract def current(entity: T): RawRow?
end
