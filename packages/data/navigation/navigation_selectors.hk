namespace neri_data

## Opaque tracker identity shared by descriptors without materializing entity types.
class NavigationTrackerIdentity
  def init(): Void
  end
end

def navigationTrackerIdentity<T>(tracker: EntityTracker<T>?): NavigationTrackerIdentity?
  if tracker == null
    return null
  end
  return tracker.navigationIdentity()
end

## Context-owned navigation metadata with a checked typed descriptor payload.
class NavigationRegistrationEntry
  public sourceType: String
  public member: String
  public resultType: String
  public next: NavigationRegistrationEntry?

  def init(sourceType: String, member: String, resultType: String, next: NavigationRegistrationEntry?): Void
    this.sourceType = sourceType
    this.member = member
    this.resultType = resultType
    this.next = next
  end
end

class NavigationRegistration<A, B>: NavigationRegistrationEntry
  public step: NavigationStep<A, B>

  def init(
    sourceType: String,
    member: String,
    resultType: String,
    step: NavigationStep<A, B>,
    next: NavigationRegistrationEntry?
  ): Void
    super(sourceType, member, resultType, next)
    this.step = step
  end
end

## Invalid selectors produce deferred failures before any load is started.
def failedNavigationStep<A, B>(failure: QueryFailure): NavigationStep<A, B>
  let check: fn(Bool): QueryFailure? = fn(asynchronous: Bool): QueryFailure? do
    return failure
  end
  let execute: fn(
    TypedRows<A>,
    NavigationJournal
  ): QueryResult<B> = fn(
    rows: TypedRows<A>,
    journal: NavigationJournal
  ): QueryResult<B> do
    return QueryResult<B>.Failure(failure)
  end
  let executeAsync: fn(TypedRows<A>, NavigationJournal, StreamOptions?): AsyncLoadDriver<B> = fn(
    rows: TypedRows<A>, journal: NavigationJournal, options: StreamOptions?
  ): AsyncLoadDriver<B> do
    return new AsyncCompletedLoad<B>(QueryResult<B>.Failure(failure))
  end

  return new NavigationStep<A, B>(execute, check, null, null, null, null, executeAsync: executeAsync)
end

def navigationSelectorStep<A, B>(owner: ChangeContext?, tree: readonly quotation::Tree): NavigationStep<A, B>
  if owner == null
    return failedNavigationStep<A, B>(QueryFailure.UnsupportedCapability("navigation selector requires a registered change context"))
  end
  return owner.resolveNavigation<A, B>(tree)
end
