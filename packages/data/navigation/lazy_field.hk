namespace neri_data

## A bound navigation accessor suitable for an entity's declared lazy field.
## Reading get() loads once; SQL failures remain explicit typed results.
class LazyField<T>
  private read: fn(): QueryResult<T>
  private readAsync: fn(StreamOptions?): AsyncLoadStart<T>

  def init(read: fn(): QueryResult<T>, readAsync: fn(StreamOptions?): AsyncLoadStart<T>): Void
    this.read = read
    this.readAsync = readAsync
  end

  public def get(): QueryResult<T>
    return this.read()
  end

  public def getAsync(options: StreamOptions? = null): result::Result<AsyncLoad<T>, QueryFailure>
    match this.readAsync(options)
      case AsyncLoadStart.Failure(error)
        return result::Result<AsyncLoad<T>, QueryFailure>.Error(error)
      case AsyncLoadStart.Started(driver)
        let owned = new AsyncLoad<T>(driver)

        return result::Result<AsyncLoad<T>, QueryFailure>.Ok(transfer owned)
    end
  end
end

def lazyCollectionField<P, D>(
  principals: Query<P>,
  dependents: Query<D>,
  relation: CollectionNavigation<P, D>,
  entity: P
): LazyField<D>
  let read: fn(): QueryResult<D> = fn(): QueryResult<D> do
    return lazyCollection(principals, dependents, relation, entity)
  end
  let readAsync: fn(StreamOptions?): AsyncLoadStart<D> = fn(options: StreamOptions?): AsyncLoadStart<D> do
    return prepareLazyCollection(principals, dependents, relation, entity, options)
  end

  return new LazyField<D>(read, readAsync)
end

def lazyReferenceField<P, D>(
  dependents: Query<D>,
  principals: Query<P>,
  relation: CollectionNavigation<P, D>,
  entity: D
): LazyField<P>
  let read: fn(): QueryResult<P> = fn(): QueryResult<P> do
    return lazyReference(dependents, principals, relation, entity)
  end
  let readAsync: fn(StreamOptions?): AsyncLoadStart<P> = fn(options: StreamOptions?): AsyncLoadStart<P> do
    return prepareLazyReference(dependents, principals, relation, entity, options)
  end

  return new LazyField<P>(read, readAsync)
end
