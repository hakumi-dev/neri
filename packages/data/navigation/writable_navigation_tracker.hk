namespace neri_data

## Physical write operations implemented by root trackers.
abstract class WritableNavigationTracker<T>: NavigationTracker<T>
  public abstract def handle(entity: T): TrackHandleResult<T>
  public abstract def add(entity: T): QueryFailure?
  public abstract def attach(entity: T): QueryFailure?
  public abstract def addWithHandle(entity: T): TrackHandleResult<T>
  public abstract def attachWithHandle(entity: T): TrackHandleResult<T>
  public abstract def remove(entity: T): QueryFailure?
  public abstract def detach(entity: T): QueryFailure?
  public abstract def rebase(entity: T, databaseEntity: T): QueryFailure?
  public abstract def refreshFrom(entity: T, databaseEntity: T): QueryFailure?
  internal abstract def cascadeHandle(entity: T): TrackHandleResult<T>
  internal abstract def validateMaterializationIdentity(entity: T, accepts: fn(T): Bool): QueryFailure?
  internal abstract readonly def hasTableSegments(): Bool
  internal abstract def setColumnSegment(column: String): TrackedWriteLayout?
  internal abstract def setWriteFailure(columns: String[]): String?
end
