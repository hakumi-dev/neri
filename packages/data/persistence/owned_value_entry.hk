namespace neri_data

class OwnedValueEntry<B, O>
  public owner: B
  public value: O
  public token: OwnedValueToken = new OwnedValueToken()
  public next: OwnedValueEntry<B, O>?

  def init(owner: B, value: O, next: OwnedValueEntry<B, O>?): Void
    this.owner = owner
    this.value = value
    this.next = next
  end
end
