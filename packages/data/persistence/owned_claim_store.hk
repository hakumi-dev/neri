use reference
namespace neri_data

## Coordinates instance identity across every defining owned navigation of one model type.
class OwnedClaimStore<O>
  private first: OwnedClaimEntry<O>?
  private checkpoint: OwnedClaimEntry<O>?
  private saveCheckpoint: OwnedClaimEntry<O>?
  private count: Int = 0
  private checkpointCount: Int = 0
  private saveCheckpointCount: Int = 0
  private maximum: Int

  def init(maximum: Int = 10000): Void
    this.maximum = maximum
  end

  public def claim(value: O, token: OwnedValueToken, live: fn(): Bool): QueryFailure?
    var entry = this.first

    while entry != null
      if reference::same(entry.value, value) && entry.live()
        if !reference::same(entry.token, token)
          return QueryFailure.Provider(ProviderFailure.State("an owned instance cannot be shared or moved between defining navigations"))
        end
        return null
      end
      entry = entry.next
    end
    if this.maximum < 1 || this.count >= this.maximum
      return QueryFailure.Provider(ProviderFailure.State("owned claim history exceeded its configured limit"))
    end
    this.first = new OwnedClaimEntry<O>(value, token, live, this.first)
    this.count = this.count + 1
    return null
  end

  public def register(changes: ChangeContext): Void
    let noWrite: fn(WriteBatch, SqlDialect): String? = fn(batch: WriteBatch, dialect: SqlDialect): String? do
      return null
    end
    let nothing: fn(): Void = fn(): Void do
    end
    let clear: fn(): Void = fn(): Void do
      this.first = null
      this.count = 0
    end
    let checkpoint: fn(): Void = fn(): Void do
      this.checkpoint = this.first
      this.checkpointCount = this.count
    end
    let restore: fn(): Void = fn(): Void do
      this.first = this.checkpoint
      this.count = this.checkpointCount
    end
    let checkpointSave: fn(): Void = fn(): Void do
      this.saveCheckpoint = this.first
      this.saveCheckpointCount = this.count
    end
    let restoreSave: fn(): Void = fn(): Void do
      this.first = this.saveCheckpoint
      this.count = this.saveCheckpointCount
    end
    let returned: fn(readonly WriteReturnedRows): String? = fn(rows: readonly WriteReturnedRows): String? do
      return null
    end
    let actions: fn(WriteActionList): String? = fn(list: WriteActionList): String? do
      return null
    end
    let snapshot: fn(GraphJournal): Void = fn(journal: GraphJournal): Void do
      let first = this.first
      let count = this.count
      let undo: fn(): Void = fn(): Void do
        this.first = first
        this.count = count
      end

      journal.record(undo)
    end

    changes.register(new ChangeSet(
        noWrite,
        nothing,
        clear,
        checkpoint,
        restore,
        nothing,
        returned,
        nothing,
        actions,
        checkpointSave,
        restoreSave,
        nothing,
        snapshot
      ))
  end
end
