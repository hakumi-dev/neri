use fields
use quotation
namespace neri_data

## Carries a generated mapping's filter labels through entity queries.
class MappedQuery<T, Filters>
  private inner: Query<T>

  def init(query: Query<T>): Void
    this.inner = query
  end

  ## Exposes the ordinary query for APIs that take a dynamic mapping.
  public def query(): Query<T>
    return this.inner
  end

  private def wrap(query: Query<T>): MappedQuery<T, Filters>
    return new MappedQuery<T, Filters>(query)
  end

  public def where(labels filters: fields of Filters): MappedQuery<T, Filters>
    return this.wrap(this.inner.whereFields(filters.pack(), mappedLabels: true))
  end

  public def matching(predicate: quote fn(T): Bool): MappedQuery<T, Filters>
    return this.wrap(this.inner.matching(predicate))
  end

  public def matchingComputed(predicate: ComputedPredicate<T>): MappedQuery<T, Filters>
    return this.wrap(this.inner.matchingComputed(predicate))
  end

  public def matchingDecimal(predicate: DecimalPredicate<T>): MappedQuery<T, Filters>
    return this.wrap(this.inner.matchingDecimal(predicate))
  end

  public def whereMappedCell(name: String, value: Cell): MappedQuery<T, Filters>
    return this.wrap(this.inner.whereMappedCell(name, value))
  end

  public def whereBinary(column: String, value: ByteBuffer): MappedQuery<T, Filters>
    return this.wrap(this.inner.whereBinary(column, value))
  end

  public def whereDecimal(column: String, value: Decimal): MappedQuery<T, Filters>
    return this.wrap(this.inner.whereDecimal(column, value))
  end

  public def take(count: Int): MappedQuery<T, Filters>
    return this.wrap(this.inner.take(count))
  end

  public def skip(count: Int): MappedQuery<T, Filters>
    return this.wrap(this.inner.skip(count))
  end

  public def distinct(): MappedQuery<T, Filters>
    return this.wrap(this.inner.distinct())
  end

  public def orderBy(field: quote fn(T): Int, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.orderBy(field, descending))
  end

  public def orderByValue<R>(
    codec: ScalarCodec<R>,
    field: quote fn(T): R,
    descending: Bool = false
  ): MappedQuery<T, Filters>
    return this.wrap(this.inner.orderByValue<R>(codec, field, descending))
  end

  public def orderByString(field: quote fn(T): String, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.orderByString(field, descending))
  end

  public def orderByBool(field: quote fn(T): Bool, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.orderByBool(field, descending))
  end

  public def orderByFloat(field: quote fn(T): Float, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.orderByFloat(field, descending))
  end

  public def thenBy(field: quote fn(T): Int, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.thenBy(field, descending))
  end

  public def thenByValue<R>(
    codec: ScalarCodec<R>,
    field: quote fn(T): R,
    descending: Bool = false
  ): MappedQuery<T, Filters>
    return this.wrap(this.inner.thenByValue<R>(codec, field, descending))
  end

  public def thenByString(field: quote fn(T): String, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.thenByString(field, descending))
  end

  public def thenByBool(field: quote fn(T): Bool, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.thenByBool(field, descending))
  end

  public def thenByFloat(field: quote fn(T): Float, descending: Bool = false): MappedQuery<T, Filters>
    return this.wrap(this.inner.thenByFloat(field, descending))
  end

  public def asNoTracking(): MappedQuery<T, Filters>
    return this.wrap(this.inner.asNoTracking())
  end

  public def asNoTrackingWithIdentityResolution(): MappedQuery<T, Filters>
    return this.wrap(this.inner.asNoTrackingWithIdentityResolution())
  end

  public def asTracking(): MappedQuery<T, Filters>
    return this.wrap(this.inner.asTracking())
  end

  public def detachedGraph(): MappedQuery<T, Filters>
    return this.wrap(this.inner.detachedGraph())
  end

  public def tagWith(tag: String): MappedQuery<T, Filters>
    return this.wrap(this.inner.tagWith(tag))
  end

  public def withGlobalFilter(predicate: quote fn(T): Bool): MappedQuery<T, Filters>
    return this.wrap(this.inner.withGlobalFilter(predicate))
  end

  public def withNamedGlobalFilter(name: String, predicate: quote fn(T): Bool): MappedQuery<T, Filters>
    return this.wrap(this.inner.withNamedGlobalFilter(name, predicate))
  end

  public def ignoreQueryFilters(names: String[]? = null): MappedQuery<T, Filters>
    return this.wrap(this.inner.ignoreQueryFilters(names))
  end

  public def fromSql(sql: String, parameters: readonly ParameterValues): MappedQuery<T, Filters>
    return this.wrap(this.inner.fromSql(sql, parameters))
  end

  public def fromMappedSql(sql: String, parameters: readonly ParameterValues): MappedQuery<T, Filters>
    return this.wrap(this.inner.fromMappedSql(sql, parameters))
  end

  public def asRelation(): Relation<T>
    return this.inner.asRelation()
  end

  public def unionWith(other: MappedQuery<T, Filters>): Relation<T>
    return this.inner.unionWith(other.query())
  end

  public def concat(other: MappedQuery<T, Filters>): Relation<T>
    return this.inner.concat(other.query())
  end

  public def intersect(other: MappedQuery<T, Filters>): Relation<T>
    return this.inner.intersect(other.query())
  end

  public def except(other: MappedQuery<T, Filters>): Relation<T>
    return this.inner.except(other.query())
  end

  public def select<R>(codec: ScalarCodec<R>, selector: quote fn(T): R): ShapeProjection<T, R>
    return this.inner.select<R>(codec, selector)
  end

  public def selectShape<R>(shape: RowShape<T, R>): ShapeProjection<T, R>
    return this.inner.selectShape<R>(shape)
  end

  public def selectDecimal(expression: DecimalExpression<T>): ShapeProjection<T, Decimal>
    return this.inner.selectDecimal(expression)
  end

  public def selectOptionalDecimal(expression: OptionalDecimalExpression<T>): ShapeProjection<T, Decimal?>
    return this.inner.selectOptionalDecimal(expression)
  end

  public def orderByDecimal(expression: DecimalExpression<T>, descending: Bool = false): Relation<T>
    return this.inner.orderByDecimal(expression, descending)
  end

  public def orderByOptionalDecimal(expression: OptionalDecimalExpression<T>, descending: Bool = false): Relation<T>
    return this.inner.orderByOptionalDecimal(expression, descending)
  end

  public def include<U>(selector: quote fn(T): U): NavigationQuery<T, element of U>
    return this.inner.include<U>(selector)
  end

  public def includeStep<U>(step: NavigationStep<T, U>): NavigationQuery<T, U>
    return this.inner.includeStep<U>(step)
  end

  public def compileQuery(dialect: SqlDialect? = null): CompiledQueryResult<T>
    return this.inner.compileQuery(dialect)
  end

  public def buildPlan(dialect: SqlDialect = SqlDialect.QuestionMark()): CompileResult<T>
    return this.inner.buildPlan(dialect)
  end

  public def stream(visit: fn(T): Bool, options: StreamOptions? = null): StreamResult
    return this.inner.stream(visit, options)
  end

  public def streamWith(provider: Provider, visit: fn(T): Bool, options: StreamOptions? = null): StreamResult
    return this.inner.streamWith(provider, visit, options)
  end

  public def all(provider: Provider? = null): QueryResult<T>
    return this.inner.all(provider)
  end

  public def first(provider: Provider? = null): QueryValue<T>
    return this.inner.first(provider)
  end

  public def firstOrDefault(provider: Provider? = null): QueryValue<T?>
    return this.inner.firstOrDefault(provider)
  end

  public def single(provider: Provider? = null): QueryValue<T>
    return this.inner.single(provider)
  end

  public def singleOrDefault(provider: Provider? = null): QueryValue<T?>
    return this.inner.singleOrDefault(provider)
  end

  public def any(provider: Provider? = null): QueryValue<Bool>
    return this.inner.any(provider)
  end

  public def count(provider: Provider? = null): QueryValue<Int>
    return this.inner.count(provider)
  end

  public def executeDelete(): WriteResult
    return this.inner.executeDelete()
  end

  public def executeUpdate(labels changes: fields of T): WriteResult
    return this.inner.executeUpdateFields(changes.pack())
  end

  public def executeUpdateSet(setters: UpdateSet<T>): WriteResult
    return this.inner.executeUpdateSet(setters)
  end

  public def executeUpdateMappedCell(name: String, value: Cell): WriteResult
    return this.inner.executeUpdateMappedCell(name, value)
  end

  public def handle(entity: T): TrackHandleResult<T>
    return this.inner.handle(entity)
  end

  public def add(entity: T): QueryFailure?
    return this.inner.add(entity)
  end

  public def attach(entity: T): QueryFailure?
    return this.inner.attach(entity)
  end

  public def addWithHandle(entity: T): TrackHandleResult<T>
    return this.inner.addWithHandle(entity)
  end

  public def attachWithHandle(entity: T): TrackHandleResult<T>
    return this.inner.attachWithHandle(entity)
  end

  public def remove(entity: T): QueryFailure?
    return this.inner.remove(entity)
  end

  public def stateOf(entity: T): TrackingState?
    return this.inner.stateOf(entity)
  end

  public def original(entity: T): RawRow?
    return this.inner.original(entity)
  end

  public def current(entity: T): RawRow?
    return this.inner.current(entity)
  end

  public def detach(entity: T): QueryFailure?
    return this.inner.detach(entity)
  end

  public def rebase(entity: T, databaseEntity: T): QueryFailure?
    return this.inner.rebase(entity, databaseEntity)
  end

  public def refreshFrom(entity: T, databaseEntity: T): QueryFailure?
    return this.inner.refreshFrom(entity, databaseEntity)
  end


  ## Starts a typed nonblocking read; the caller owns and polls the operation.

  public def allAsync(options: StreamOptions? = null): result::Result<AsyncQuery<T>, QueryFailure>
    match this.inner.allAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncQuery<T>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncQuery<T>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def firstAsync(options: StreamOptions? = null): result::Result<AsyncValue<T>, QueryFailure>
    match this.inner.firstAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<T>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<T>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def firstOrDefaultAsync(options: StreamOptions? = null): result::Result<AsyncValue<T?>, QueryFailure>
    match this.inner.firstOrDefaultAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<T?>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<T?>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def singleAsync(options: StreamOptions? = null): result::Result<AsyncValue<T>, QueryFailure>
    match this.inner.singleAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<T>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<T>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def singleOrDefaultAsync(options: StreamOptions? = null): result::Result<AsyncValue<T?>, QueryFailure>
    match this.inner.singleOrDefaultAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<T?>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<T?>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def anyAsync(options: StreamOptions? = null): result::Result<AsyncValue<Bool>, QueryFailure>
    match this.inner.anyAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<Bool>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<Bool>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def countAsync(options: StreamOptions? = null): result::Result<AsyncValue<Int>, QueryFailure>
    match this.inner.countAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncValue<Int>, QueryFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncValue<Int>, QueryFailure>.Ok(transfer operation)
    end
  end

  public def executeDeleteAsync(options: StreamOptions? = null): result::Result<AsyncWrite, WriteFailure>
    match this.inner.executeDeleteAsync(options)
      case result::Result.Error(error)
        return result::Result<AsyncWrite, WriteFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncWrite, WriteFailure>.Ok(transfer operation)
    end
  end

  public def executeUpdateAsync(
    options: StreamOptions? = null,
    labels changes: fields of T
  ): result::Result<AsyncWrite, WriteFailure>
    match this.inner.startUpdateFieldsAsync(changes.pack(), options)
      case AsyncWriteStart.Failure(error)
        return result::Result<AsyncWrite, WriteFailure>.Error(error)
      case AsyncWriteStart.Started(driver)
        let operation = new AsyncWrite(driver)

        return result::Result<AsyncWrite, WriteFailure>.Ok(transfer operation)
    end
  end

  public def executeUpdateSetAsync(
    setters: UpdateSet<T>, options: StreamOptions? = null
  ): result::Result<AsyncWrite, WriteFailure>
    match this.inner.executeUpdateSetAsync(setters, options)
      case result::Result.Error(error)
        return result::Result<AsyncWrite, WriteFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncWrite, WriteFailure>.Ok(transfer operation)
    end
  end

  public def executeUpdateMappedCellAsync(
    name: String, value: Cell, options: StreamOptions? = null
  ): result::Result<AsyncWrite, WriteFailure>
    match this.inner.executeUpdateMappedCellAsync(name, value, options)
      case result::Result.Error(error)
        return result::Result<AsyncWrite, WriteFailure>.Error(error)
      case result::Result.Ok(operation)
        return result::Result<AsyncWrite, WriteFailure>.Ok(transfer operation)
    end
  end

end
