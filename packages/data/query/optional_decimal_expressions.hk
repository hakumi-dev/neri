namespace neri_data

## Nullable exact arithmetic propagates NULL; coalesce chooses an explicit fallback.
class OptionalDecimalExpression<T>
  private value: DecimalExpression<T>

  def init(value: DecimalExpression<T>): Void
    this.value = value
  end

  internal def expression(): DecimalExpression<T>
    return this.value
  end

  public def add(other: OptionalDecimalExpression<T>): OptionalDecimalExpression<T>
    return new OptionalDecimalExpression<T>(decimalBinary(this.value, other.value, "+", optional: true))
  end

  public def subtract(other: OptionalDecimalExpression<T>): OptionalDecimalExpression<T>
    return new OptionalDecimalExpression<T>(decimalBinary(this.value, other.value, "-", optional: true))
  end

  public def multiply(other: OptionalDecimalExpression<T>): OptionalDecimalExpression<T>
    return new OptionalDecimalExpression<T>(decimalBinary(this.value, other.value, "*", optional: true))
  end

  public def divideTruncated(other: OptionalDecimalExpression<T>, scale: Int): OptionalDecimalExpression<T>
    return new OptionalDecimalExpression<T>(decimalBinary(this.value, other.value, "/", scale, true))
  end

  public def lessThan(other: OptionalDecimalExpression<T>): DecimalPredicate<T>
    return decimalCompare(this.value, other.value, "<")
  end

  public def lessThanOrEqual(other: OptionalDecimalExpression<T>): DecimalPredicate<T>
    return decimalCompare(this.value, other.value, "<=")
  end

  public def greaterThan(other: OptionalDecimalExpression<T>): DecimalPredicate<T>
    return decimalCompare(this.value, other.value, ">")
  end

  public def greaterThanOrEqual(other: OptionalDecimalExpression<T>): DecimalPredicate<T>
    return decimalCompare(this.value, other.value, ">=")
  end

  ## Equality treats two NULL values as equal; ordered comparisons exclude NULL.
  public def equalTo(other: OptionalDecimalExpression<T>): DecimalPredicate<T>
    let left = this.value
    let right = other.value
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      match left.buildSql(mapping, state, dialect)
        case ScalarSqlResult.Failure(error)
          return ScalarSqlResult.Failure(error)
        case ScalarSqlResult.Value(first)
          match right.buildSql(mapping, state, dialect)
            case ScalarSqlResult.Failure(error)
              return ScalarSqlResult.Failure(error)
            case ScalarSqlResult.Value(second)
              let a = "\"__neri_decimal_equal\".\"a\""
              let b = "\"__neri_decimal_equal\".\"b\""
              var compare = ""

              match dialect
                case SqlDialect.QuestionMark()
                  compare = "__neri_decimal_compare(" + a + ", " + b + ") = 0"
                case SqlDialect.PostgreSql()
                  compare = "CAST(" + a + " AS NUMERIC) = CAST(" + b + " AS NUMERIC)"
              end
              return ScalarSqlResult.Value(new ScalarSql(
                  "(SELECT coalesce(" + compare + ", " + a + " IS NULL AND " + b + " IS NULL) FROM (SELECT " + first.sql + " AS \"a\", " + second.sql + " AS \"b\") AS \"__neri_decimal_equal\")",
                  true
                ))
          end
      end
    end

    return new DecimalPredicate<T>(build)
  end

  public def isNull(): DecimalPredicate<T>
    let value = this.value
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      match value.buildSql(mapping, state, dialect)
        case ScalarSqlResult.Failure(error)
          return ScalarSqlResult.Failure(error)
        case ScalarSqlResult.Value(expression)
          return ScalarSqlResult.Value(new ScalarSql("(" + expression.sql + " IS NULL)", true))
      end
    end

    return new DecimalPredicate<T>(build)
  end

  public def coalesce(fallback: DecimalExpression<T>): DecimalExpression<T>
    let value = this.value
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      match value.buildSql(mapping, state, dialect)
        case ScalarSqlResult.Failure(error)
          return ScalarSqlResult.Failure(error)
        case ScalarSqlResult.Value(expression)
          match fallback.buildSql(mapping, state, dialect)
            case ScalarSqlResult.Failure(error)
              return ScalarSqlResult.Failure(error)
            case ScalarSqlResult.Value(replacement)
              return ScalarSqlResult.Value(new ScalarSql(
                  "coalesce(" + expression.sql + ", " + replacement.sql + ")",
                  true
                ))
          end
      end
    end

    return new DecimalExpression<T>(build, value.expressionSize() + fallback.expressionSize() + 1)
  end
end

def optionalDecimalField<T>(field: quote fn(T): Decimal?): OptionalDecimalExpression<T>
  let build: fn(
    EntityMapping,
    CompileState,
    SqlDialect
  ): ScalarSqlResult = fn(
    mapping: EntityMapping,
    state: CompileState,
    dialect: SqlDialect
  ): ScalarSqlResult do
    match translateSelection(mapping, field.tree())
      case SelectionResult.Failure(error)
        return ScalarSqlResult.Failure(error)
      case SelectionResult.Column(column)
        if column.typeName() != "neri_data.Decimal?" && column.typeName() != "Decimal?"
          return scalarSqlFailure("optional decimal field requires a Decimal? mapping")
        end
        return ScalarSqlResult.Value(new ScalarSql(
            decimalCheckedSql(quoted(mapping.table(), column.column()), dialect, true),
            true
          ))
    end
  end

  return new OptionalDecimalExpression<T>(new DecimalExpression<T>(build))
end

def optionalDecimalValue<T>(value: readonly Decimal?): OptionalDecimalExpression<T>
  if value != null
    return decimalValue<T>(value).asOptional()
  end
  let build: fn(
    EntityMapping,
    CompileState,
    SqlDialect
  ): ScalarSqlResult = fn(
    mapping: EntityMapping,
    state: CompileState,
    dialect: SqlDialect
  ): ScalarSqlResult do
    return ScalarSqlResult.Value(new ScalarSql("NULL", true))
  end

  return new OptionalDecimalExpression<T>(new DecimalExpression<T>(build))
end

def optionalDecimalShape<T>(expression: OptionalDecimalExpression<T>): RowShape<T, Decimal?>
  let build: fn(
    EntityMapping,
    Int,
    CompileState,
    SqlDialect,
    String?
  ): ShapeCompileResult<Decimal?> = fn(
    mapping: EntityMapping,
    offset: Int,
    state: CompileState,
    dialect: SqlDialect,
    presence: String?
  ): ShapeCompileResult<Decimal?> do
    match expression.expression().buildSql(mapping, state, dialect)
      case ScalarSqlResult.Failure(error)
        return ShapeCompileResult<Decimal?>.Failure(error)
      case ScalarSqlResult.Value(value)
        let alias = "__neri_shape_" + (offset as String)
        let columns = new ResultColumns([new ResultColumn(alias, ResultColumnKind.Text(), true)])
        let prepare: fn(RawRow): ShapePrepareResult<Decimal?> = fn(row: RawRow): ShapePrepareResult<Decimal?> do
          match decodeNullableDecimal(row, alias)
            case DecodeResult.Failure(error)
              return ShapePrepareResult<Decimal?>.Failure(error)
            case DecodeResult.Value(decimal)
              let make: fn(): Decimal? = fn(): Decimal? do
                return decimal
              end

              return ShapePrepareResult<Decimal?>.Ready(new ShapePrepared<Decimal?>(make))
          end
        end

        return ShapeCompileResult<Decimal?>.Plan(new ShapePlan<Decimal?>(
            value.sql + " AS \"" + alias + "\"",
            columns,
            1,
            prepare,
            true,
            scalar: alias,
            scalarType: "neri_data.Decimal?"
          ))
    end
  end

  return new RowShape<T, Decimal?>(build)
end
