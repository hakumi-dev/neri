use host
namespace neri_data

class SchemaScaffoldOptions
  public tables: String[] = []
  public modelNamespace: String = "scaffolded_model"
  public dataNamespace: String = "scaffolded_data"
  public context: String = "ScaffoldedContext"
  public project: String = "manifest.json"
  public unit: String = "entities"
  public output: String = "generated"
end

## Provider adapters supply visible columns in relation and physical column order.
class SchemaScaffoldColumn
  public table: String
  public name: String
  public type: String
  public nullable: Bool
  public keyPosition: Int
  public generatedOnAdd: Bool
  public generatedOnUpdate: Bool
  public view: Bool
  public defaultSql: String?
  public computedSql: String?
  public computedStored: Bool
  public checkSql: String?
  public collation: String?
  public postgresqlType: String?

  def init(
    table: String,
    name: String,
    type: String,
    nullable: Bool,
    keyPosition: Int = 0,
    generatedOnAdd: Bool = false,
    generatedOnUpdate: Bool = false,
    view: Bool = false,
    defaultSql: String? = null,
    computedSql: String? = null,
    computedStored: Bool = true,
    checkSql: String? = null,
    collation: String? = null,
    postgresqlType: String? = null
  ): Void
    this.table = table
    this.name = name
    this.type = type
    this.nullable = nullable
    this.keyPosition = keyPosition
    this.generatedOnAdd = generatedOnAdd
    this.generatedOnUpdate = generatedOnUpdate
    this.view = view
    this.defaultSql = defaultSql
    this.computedSql = computedSql
    this.computedStored = computedStored
    this.checkSql = checkSql
    this.collation = collation
    this.postgresqlType = postgresqlType
  end
end

enum SchemaScaffoldResult
  case Source(modelSource: String, mappingJson: String)
  case Failure(error: ProviderFailure)
end

def scaffoldJson(value: String): String
  var output = "\""
  var index = 0
  var start = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    if byte == 34 || byte == 92 || byte < 32
      output = output + host::stringSlice(value, start, index - start)
      if byte == 34 || byte == 92
        output = output + "\\" + host::stringSlice(value, index, 1)
      else
        output = output + "\\u00" + schemaSeedHex([byte as Byte])
      end
      start = index + 1
    end
    index = index + 1
  end
  return output + host::stringSlice(value, start, host::stringByteLength(value) - start) + "\""
end

## Prefixes prevent keyword collisions; UTF-8 bytes use an unambiguous ASCII escape.
def scaffoldIdentifier(value: String, prefix: String): String
  var output = prefix
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)

    if letter || (byte >= 48 && byte <= 57)
      output = output + host::stringSlice(value, index, 1)
    else
      output = output + "_" + schemaSeedHex([byte as Byte]) + "_"
    end
    index = index + 1
  end
  return output
end

def scaffoldTypeSupported(value: String): Bool
  return value == "Int" || value == "Bool" || value == "Float" || value == "String" || value == "ByteBuffer" || value == "Decimal" || value == "DateOnly" || value == "TimeOnly" || value == "DateTime" || value == "TimeSpan"
end

def scaffoldCodeIdentifierValid(value: String): Bool
  if !identifierValid(value)
    return false
  end
  for keyword in [
    "class",
    "namespace",
    "use",
    "public",
    "internal",
    "private",
    "protected",
    "def",
    "static",
    "var",
    "let",
    "return",
    "if",
    "else",
    "end",
    "while",
    "for",
    "in",
    "do",
    "match",
    "case",
    "enum",
    "true",
    "false",
    "null",
    "readonly",
    "transfer",
    "resource",
    "using",
    "override",
    "abstract",
    "base",
    "this",
    "new",
    "as",
    "labels",
    "out",
    "ref",
    "break",
    "continue"
  ]
    if value == keyword
      return false
    end
  end
  return true
end

def scaffoldInitialValue(column: readonly SchemaScaffoldColumn): String
  if !column.nullable
    if column.type == "Decimal" || column.type == "TimeSpan"
      return column.type + ".zero()"
    end
    if column.type == "DateOnly" || column.type == "TimeOnly" || column.type == "DateTime"
      return column.type + ".minimum()"
    end
  end
  if column.nullable
    return "null"
  end
  if column.type == "Int"
    return "0"
  end
  if column.type == "Float"
    return "0.0"
  end
  if column.type == "Bool"
    return "false"
  end
  return column.type == "String" ? "\"\"" : "new ByteBuffer(33554432, 0)"
end

def scaffoldSelectionNameValid(table: String): Bool
  return host::stringByteLength(table) <= 63 && identifierValid(table)
end

def scaffoldSelectionFailure(options: readonly SchemaScaffoldOptions?): ProviderFailure?
  if options == null
    return null
  end
  if options.tables.Length > 1000
    return ProviderFailure.State("schema scaffolding exceeds 1000 selected tables")
  end
  var index = 0

  for table in options.tables
    if !scaffoldSelectionNameValid(table)
      return ProviderFailure.State("schema scaffolding selected table identifier is invalid")
    end
    var earlier = 0

    while earlier < index
      if options.tables[earlier] == table
        return ProviderFailure.State("schema scaffolding has a duplicate selected table: " + table)
      end
      earlier = earlier + 1
    end
    index = index + 1
  end
  return null
end

## Provider entries report invalid selections. This builder validates its SQL fragments.
def scaffoldSelectionSql(options: readonly SchemaScaffoldOptions?, column: String): String
  if options == null || options.tables.Length == 0
    return ""
  end
  if options.tables.Length > 1000 || (column != "s.name" && column != "s.tbl_name" && column != "f.\"table\"" && column != "c.relname" && column != "p.relname")
    return " AND 1=0"
  end
  var values = ""

  for table in options.tables
    if !scaffoldSelectionNameValid(table)
      return " AND 1=0"
    end
    values = values + (values == "" ? "" : ",") + "'" + table + "'"
  end
  return " AND " + column + " IN (" + values + ")"
end

def scaffoldTableSelected(options: readonly SchemaScaffoldOptions, table: String): Bool
  if options.tables.Length == 0
    return true
  end
  for selected in options.tables
    if selected == table
      return true
    end
  end
  return false
end

def scaffoldSchema(
  columns: readonly SchemaScaffoldColumn[],
  options: SchemaScaffoldOptions? = null,
  references: readonly SchemaScaffoldReference[] = [],
  indexes: readonly SchemaScaffoldIndex[] = []
): SchemaScaffoldResult
  let settings = options == null ? new SchemaScaffoldOptions() : options

  if !scaffoldCodeIdentifierValid(settings.modelNamespace) || !scaffoldCodeIdentifierValid(settings.dataNamespace) || !scaffoldCodeIdentifierValid(settings.context) || !scaffoldCodeIdentifierValid(settings.unit) || settings.project == "" || settings.output == ""
    return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding requires valid namespace, context, unit and output options"))
  end
  if columns.Length > 1000 || references.Length > 1000 || indexes.Length > 1000
    return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding exceeds 1000 columns"))
  end
  let invalidSelection = scaffoldSelectionFailure(settings)

  if invalidSelection != null
    return SchemaScaffoldResult.Failure(invalidSelection)
  end

  for selected in settings.tables
    var found = false

    for column in columns
      if column.table == selected
        found = true
      end
    end
    if !found
      return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding selected table was not found: " + selected))
    end
  end
  var source = "use buffers\nnamespace " + settings.modelNamespace + "\n\n# Database scaffolding preserves query/write and database schema metadata.\n"
  var usesNativeScalars = false
  var entities = ""
  var index = 0

  while index < columns.Length
    let table = columns[index].table

    if !scaffoldTableSelected(settings, table)
      while index < columns.Length && columns[index].table == table
        index = index + 1
      end
      continue
    end
    let entity = scaffoldIdentifier(table, "Entity_")
    let set = scaffoldIdentifier(table, "set_")
    let start = index
    var keys = 0

    if !schemaTableValid(table)
      return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding cannot represent this physical table identifier: " + table))
    end
    var earlier = 0

    while earlier < start
      if scaffoldTableSelected(settings, columns[earlier].table) && (schemaSameIdentifier(
          columns[earlier].table,
          table
        ) || scaffoldIdentifier(
          columns[earlier].table,
          "Entity_"
        ) == entity)
        return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding has a relation identifier collision or noncontiguous relation"))
      end
      earlier = earlier + 1
    end
    while index < columns.Length && columns[index].table == table
      let column = columns[index]

      if !identifierValid(column.name) || !scaffoldTypeSupported(column.type) || column.keyPosition < 0 || column.view != columns[start].view || (column.generatedOnUpdate && !column.generatedOnAdd)
        return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding has unsupported column metadata: " + table + "." + column.name))
      end
      if column.generatedOnUpdate && column.computedSql == null
        return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding could not preserve the computed expression: " + table + "." + column.name))
      end
      if column.keyPosition > 0
        keys = keys + 1
        if column.nullable || column.view
          return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding requires non-null table primary keys"))
        end
      end
      var prior = start

      while prior < index
        if schemaSameIdentifier(
          columns[prior].name,
          column.name
        ) || scaffoldIdentifier(
          columns[prior].name,
          "field_"
        ) == scaffoldIdentifier(
          column.name,
          "field_"
        )
          return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding has a field identifier collision"))
        end
        prior = prior + 1
      end
      index = index + 1
    end
    var keyJson = ""
    var ordinal = 1
    var generatedKey = false

    while ordinal <= keys
      var found = false
      var position = start

      while position < index
        let column = columns[position]

        if column.keyPosition == ordinal
          if found || (column.generatedOnAdd && (keys != 1 || column.type != "Int" || column.generatedOnUpdate))
            return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding has an unsupported generated or duplicate primary key"))
          end
          found = true
          generatedKey = generatedKey || column.generatedOnAdd
          keyJson = keyJson + (ordinal == 1 ? "" : ",") + scaffoldJson(scaffoldIdentifier(column.name, "field_"))
        end
        position = position + 1
      end
      if !found
        return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding primary-key order is not contiguous"))
      end
      ordinal = ordinal + 1
    end
    let keyless = keys == 0

    source = source + "\nclass " + entity + "\n"
    var fields = ""
    var position = start

    while position < index
      let column = columns[position]
      let member = scaffoldIdentifier(column.name, "field_")
      let defaultSql = column.defaultSql
      let computedSql = column.computedSql
      let expression = computedSql == null ? defaultSql : computedSql

      if expression != null
        source = source + "  # Database expression: " + scaffoldJson(expression) + "\n"
      end
      usesNativeScalars = true if column.type == "Decimal" || column.type == "DateOnly" || column.type == "TimeOnly" || column.type == "DateTime" || column.type == "TimeSpan"
      source = source + "  public " + member + ": " + column.type + (column.nullable ? "?" : "") + " = " + scaffoldInitialValue(column) + "\n"
      fields = fields + (position == start ? "" : ",") + "{\"member\":" + scaffoldJson(member) + ",\"column\":" + scaffoldJson(column.name)
      if !keyless && column.keyPosition == 0 && column.generatedOnAdd
        fields = fields + ",\"valueGeneration\":" + scaffoldJson(column.generatedOnUpdate ? "onAddOrUpdate" : "onAdd")
      end
      for facet in ["defaultSql", "computedSql", "checkSql", "collation", "postgresqlType"]
        var value: String? = null

        if facet == "defaultSql" && column.keyPosition == 0 && column.computedSql == null
          value = column.defaultSql
        else if facet == "computedSql"
          value = column.computedSql
        else if facet == "checkSql"
          value = column.checkSql
        else if facet == "collation"
          value = column.collation
        else if facet == "postgresqlType"
          value = column.postgresqlType
        end
        if value != null
          fields = fields + "," + scaffoldJson(facet) + ":" + scaffoldJson(value)
        end
      end
      if column.computedSql != null && !column.computedStored
        fields = fields + ",\"computedStored\":false"
      end
      fields = fields + "}"
      position = position + 1
    end
    source = source + "end\n"
    entities = entities + (entities == "" ? "" : ",") + "{\"type\":" + scaffoldJson(settings.modelNamespace + "." + entity) + ",\"set\":" + scaffoldJson(set)
    entities = entities + (columns[start].view ? ",\"view\":" : ",\"table\":") + scaffoldJson(table)
    entities = entities + (keyless ? ",\"keyless\":true" : ",\"key\":[" + keyJson + "]")
    entities = entities + (generatedKey ? ",\"keyGeneration\":\"onAdd\"" : "") + ",\"columns\":[" + fields + "]"
    var indexJson = ""

    for definition in indexes
      if definition.table == table
        if !identifierValid(definition.name)
          return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding cannot represent an index name"))
        end
        indexJson = indexJson + (indexJson == "" ? "" : ",") + "{\"name\":" + scaffoldJson(definition.name) + ",\"members\":" + scaffoldMembers(definition.fields) + ",\"unique\":" + (definition.unique ? "true" : "false")
        if definition.descending.Length > 0
          var direction = ""

          for descending in definition.descending
            direction = direction + (direction == "" ? "" : ",") + (descending ? "true" : "false")
          end
          indexJson = indexJson + ",\"descending\":[" + direction + "]"
        end
        if definition.expressions.Length > 0
          indexJson = indexJson + ",\"expressions\":" + scaffoldStrings(definition.expressions)
        end
        if definition.included.Length > 0
          indexJson = indexJson + ",\"include\":" + scaffoldMembers(definition.included)
        end
        let predicate = definition.predicate

        if predicate != null
          indexJson = indexJson + ",\"predicate\":" + scaffoldJson(predicate)
        end
        indexJson = indexJson + "}"
      end
    end
    entities = entities + (indexJson == "" ? "" : ",\"indexes\":[" + indexJson + "]") + "}"
  end
  var relations = ""

  for reference in references
    if !scaffoldTableSelected(settings, reference.table) || !scaffoldTableSelected(settings, reference.parent)
      continue
    end
    if reference.fields.Length == 0 || reference.fields.Length != reference.keys.Length || !schemaTableValid(reference.table) || !schemaTableValid(reference.parent) || (reference.deleteBehavior != "NO ACTION" && reference.deleteBehavior != "RESTRICT" && reference.deleteBehavior != "CASCADE" && reference.deleteBehavior != "SET NULL")
      return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding has invalid foreign-key metadata"))
    end
    var component = 0

    while component < reference.fields.Length
      var fieldFound = false
      var keyFound = false

      for column in columns
        if column.table == reference.table && column.name == reference.fields[component] && !column.view
          fieldFound = true
        end
        if column.table == reference.parent && column.name == reference.keys[component] && !column.view && !column.nullable
          keyFound = true
        end
      end
      if !fieldFound || !keyFound
        return SchemaScaffoldResult.Failure(ProviderFailure.State("schema scaffolding foreign key references an unmapped or nullable principal field"))
      end
      component = component + 1
    end
    relations = relations + (relations == "" ? "" : ",") + "{\"principal\":" + scaffoldJson(settings.modelNamespace + "." + scaffoldIdentifier(
        reference.parent,
        "Entity_"
      )) + ",\"dependent\":" + scaffoldJson(settings.modelNamespace + "." + scaffoldIdentifier(
        reference.table,
        "Entity_"
      )) + ",\"key\":" + scaffoldMembers(reference.keys) + ",\"foreignKey\":" + scaffoldMembers(reference.fields) + ",\"databaseOnDelete\":" + scaffoldJson(reference.deleteBehavior) + (reference.deferred ? ",\"deferred\":true" : "") + "}"
  end
  let mapping = "{\"version\":1,\"project\":" + scaffoldJson(settings.project) + ",\"unit\":" + scaffoldJson(settings.unit) + ",\"namespace\":" + scaffoldJson(settings.dataNamespace) + ",\"context\":" + scaffoldJson(settings.context) + ",\"output\":" + scaffoldJson(settings.output) + ",\"entities\":[" + entities + "],\"relations\":[" + relations + "]}"

  return SchemaScaffoldResult.Source(usesNativeScalars ? "use neri_data\n" + source : source, mapping)
end


def scaffoldStrings(values: readonly String[]): String
  var json = "["
  var index = 0

  for value in values
    json = json + (index == 0 ? "" : ",") + scaffoldJson(value)
    index = index + 1
  end
  return json + "]"
end

def scaffoldMembers(values: readonly String[]): String
  let members = arrays::generate<String>(values.Length) do |index|
    return scaffoldIdentifier(values[index], "field_")
  end

  return scaffoldStrings(members)
end
