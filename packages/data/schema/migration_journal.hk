use crypto
use host
use result
namespace neri_data

enum MigrationRecoveryDecision
  case ConfirmCompleted()
  case ConfirmReverted()
end

enum MigrationJournalResult
  case Loaded(stamps: MigrationStamp[], pending: MigrationProgress?)
  case Failure(error: MigrationFailure)
end

class MigrationProgress
  private storedId: String
  private storedSignature: String
  private storedForward: Bool
  private storedAttempt: String

  def init(id: String, signature: String, forward: Bool, attemptId: String): Void
    this.storedId = id
    this.storedSignature = signature
    this.storedForward = forward
    this.storedAttempt = attemptId
  end

  public readonly def id(): String
    return this.storedId
  end

  public readonly def forward(): Bool
    return this.storedForward
  end

  public readonly def attemptId(): String
    return this.storedAttempt
  end

  public readonly def stamp(): MigrationStamp
    return new MigrationStamp(this.storedId, this.storedSignature)
  end

  public readonly def marker(): MigrationStamp
    let version = this.storedForward ? "p1u:" : "p1d:"

    return new MigrationStamp(this.storedId, version + this.storedAttempt + this.storedSignature)
  end

  public readonly def sameAttempt(other: readonly MigrationProgress): Bool
    return this.storedId == other.storedId && this.storedSignature == other.storedSignature && this.storedForward == other.storedForward && this.storedAttempt == other.storedAttempt
  end
end

def createMigrationProgress(migration: readonly Migration, forward: Bool): MigrationProgress?
  match crypto::randomBytesOutcome(16)
    case result::Result.Error(error)
      return null
    case result::Result.Ok(bytes)
      let attempt = crypto::encodeHex(bytes)

      return attempt == null ? null : new MigrationProgress(migration.id(), migration.signature(), forward, attempt)
  end
end

def parseMigrationProgress(id: String, signature: String): MigrationProgress?
  let length = host::stringByteLength(signature)

  if !identifierValid(id) || schemaReserved(id) || length < 38
    return null
  end
  let version = host::stringSlice(signature, 0, 4)

  if version != "p1u:" && version != "p1d:"
    return null
  end
  var index = 4

  while index < 36
    let byte = host::stringByteAt(signature, index) as Int

    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102))
      return null
    end
    index = index + 1
  end
  let attempt = host::stringSlice(signature, 4, 32)
  let migrationSignature = host::stringSlice(signature, 36, length - 36)

  return new MigrationProgress(id, migrationSignature, version == "p1u:", attempt)
end

def migrationPendingFailure(progress: readonly MigrationProgress): MigrationFailure
  let direction = progress.forward() ? "up" : "down"

  return MigrationFailure.Drift("migration " + progress.id() + " requires recovery of outside-transaction " + direction + " attempt " + progress.attemptId())
end

def migrationHistoryFromJournal(journal: MigrationJournalResult): MigrationHistoryResult
  match journal
    case MigrationJournalResult.Failure(error)
      return MigrationHistoryResult.Failure(error)
    case MigrationJournalResult.Loaded(stamps, pending)
      return pending == null ? MigrationHistoryResult.Loaded(stamps) : MigrationHistoryResult.Failure(migrationPendingFailure(pending))
  end
end

def migrationRecoveryOrdinal(catalog: readonly MigrationSet, applied: Int, pending: readonly MigrationProgress): Int
  let index = pending.forward() ? applied : applied - 1
  let migration = catalog.at(index)
  let stamp = pending.stamp()

  if migration == null || migration.id() != stamp.id() || migration.signature() != stamp.signature() || !migration.executesOutsideTransaction(pending.forward())
    return -1
  end
  return index + 1
end
