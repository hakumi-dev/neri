use host
namespace neri_data

## The PostgreSQL 14 numeric typmod's exact integral and fractional bounds.
class PostgreSQLNumericFacet
  public integralDigits: Int
  public fractionDigits: Int

  def init(precision: Int, scale: Int): Void
    this.integralDigits = precision - scale
    this.fractionDigits = scale
  end
end

def postgresNativeNumericFacet(value: String): PostgreSQLNumericFacet?
  let length = host::stringByteLength(value)

  if length < 12 || length > 18 || !value.startsWith("numeric(") || !value.endsWith(")")
    return null
  end
  var comma = 8

  while comma < length - 1 && (host::stringByteAt(value, comma) as Int) != 44
    comma = comma + 1
  end
  if comma == 8 || comma >= length - 2
    return null
  end
  let precisionText = host::stringSlice(value, 8, comma - 8)
  let scaleText = host::stringSlice(value, comma + 1, length - comma - 2)
  let precision = host::parseInt(precisionText)
  let scale = host::parseInt(scaleText)

  if precision == null || scale == null || precision < 1 || precision > 1000 || scale < 0 || scale > precision || (precision as String) != precisionText || (scale as String) != scaleText
    return null
  end
  return new PostgreSQLNumericFacet(precision, scale)
end

def postgresNativeTemporalPrecision(value: String, oid: Int): Int
  var name = "timestamp"
  var suffix = " without time zone"

  if oid == 1083
    name = "time"
  else if oid == 1184
    suffix = " with time zone"
  else if oid == 1186
    name = "interval"
    suffix = ""
  else if oid != 1114
    return -1
  end
  if value == name + suffix
    return 6
  end
  let nameLength = host::stringByteLength(name)

  if host::stringByteLength(value) != nameLength + 3 + host::stringByteLength(suffix) || !value.startsWith(name + "(") || !value.endsWith(")" + suffix)
    return -1
  end
  let precision = (host::stringByteAt(value, nameLength + 1) as Int) - 48

  return precision >= 0 && precision <= 6 ? precision : -1
end

## Native scalar types keep the existing logical Cell representation.
def postgresNativeScalarOid(value: String?): Int
  if value == null
    return 0
  end
  if value == "numeric" || postgresNativeNumericFacet(value) != null
    return 1700
  end
  if value == "date"
    return 1082
  end
  if value == "time without time zone" || (value.startsWith("time(") && postgresNativeTemporalPrecision(
      value,
      1083
    ) >= 0)
    return 1083
  end
  if value == "timestamp without time zone" || (value.startsWith("timestamp(") && postgresNativeTemporalPrecision(
      value,
      1114
    ) >= 0)
    return 1114
  end
  if value == "timestamp with time zone" || (value.startsWith("timestamp(") && postgresNativeTemporalPrecision(
      value,
      1184
    ) >= 0)
    return 1184
  end
  if value == "interval" || (value.startsWith("interval(") && postgresNativeTemporalPrecision(value, 1186) >= 0)
    return 1186
  end
  return 0
end

def postgresNativeLogicalType(value: String): String
  let oid = postgresNativeScalarOid(value)

  if oid == 1700
    return "Decimal"
  end
  if oid == 1082
    return "DateOnly"
  end
  if oid == 1083
    return "TimeOnly"
  end
  if oid == 1114 || oid == 1184
    return "DateTime"
  end
  if oid == 1186
    return "TimeSpan"
  end
  return ""
end
