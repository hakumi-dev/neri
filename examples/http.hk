use http
use console
use host

def main(): Void
  var port = "8080"
  let configuredPort = host.environment("PORT")
  port = configuredPort if configuredPort != null
  let options = new http.Options()
  options.onListening = fn(address)
    console.println("Listening on http://" + address)
  end
  let logging = host.environment("HTTP_LOG")
  if logging != null && logging == "1"
    options.log = fn(message)
      console.println(message)
    end
  end
  let handler: fn(http.Request): http.Response = fn(request)
    return http.text(200, "Hello, world!")
  end
  let error = http.serve("127.0.0.1:" + port, handler, options)
  console.println(error)
  host.exit(1)
end
