use console
use host

struct UserEvent
  type: UInt32
  reserved: UInt32
  timestamp: UInt64
  windowID: UInt32
  code: Int32
  data1: Void*?
  data2: Void*?
end

union Event
  type: UInt32
  user: UserEvent
  padding: Byte[128]
end

@library("SDL3")
@cabi("SDL_Init")
def unsafe initialize(flags: UInt32): Bool
end

@library("SDL3")
@cabi("SDL_RegisterEvents")
def unsafe registerEvents(count: Int32): UInt32
end

@library("SDL3")
@cabi("SDL_PushEvent")
def unsafe push(event: Event*): Bool
end

@library("SDL3")
@cabi("SDL_PollEvent")
def unsafe poll(event: Event*): Bool
end

@library("SDL3")
@cabi("SDL_Quit")
def unsafe quit(): Void
end

def main(): Void
  unsafe
    if !initialize(16384 as UInt32)
      console.println("Could not initialize SDL events.")
      host.exit(1)
    end
    let eventType = registerEvents(1 as Int32)
    if eventType == (0 as UInt32)
      quit()
      host.exit(1)
    end
    let event = native.allocZeroed<Event>(1)
    event.user.type = eventType
    event.user.code = 42 as Int32
    if !push(event)
      native.free(event)
      quit()
      host.exit(1)
    end
    var received = false
    while poll(event)
      if event.type == eventType
        console.println("SDL event: " + ((event.user.code as Int) as String))
        received = true
      end
    end
    native.free(event)
    quit()
    if !received
      host.exit(1)
    end
  end
end
