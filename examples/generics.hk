use console

class Box<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end
end

def transform<T, U>(value: T, convert: fn(T): U): U
  return convert(value)
end

def main(): Void
  let number = new Box<Int>(42)
  let message: String = transform(number.value, fn(value)
    return "The answer is " + (value as String)
  end)
  console.println(message)
end
