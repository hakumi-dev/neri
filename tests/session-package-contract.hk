use host
use test

def main(): Void
  let project = host::argumentAt(0)
  let compiler = host::argumentAt(1)
  let work = host::argumentAt(2)

  test::assertTrue(project != null && compiler != null && work != null)
  if project == null || compiler == null || work == null
    return
  end
  let root = bootstrapTemporaryDirectory(work, "session-package")

  test::assertTrue(root != null)
  if root == null
    return
  end
  let generator = root + "/neri-session-package"
  let built = host::run(compiler, ["build", "--project", project, "--unit", "session-package-generator", "--output", generator])

  test::assertTrue(built != null && built == 0)
  if built == null || built != 0
    return
  end
  let manifest = root + "/manifest.json"
  let output = root + "/session.json"
  let source = "{\"version\":2,\"defaultUnit\":\"other\",\"units\":{\"base\":{\"kind\":\"library\",\"sources\":[\"base.hk\"]},\"middle\":{\"kind\":\"library\",\"sources\":[\"middle.hk\"],\"references\":[\"base\"]},\"session\":{\"kind\":\"library\",\"sources\":[\"session.hk\"],\"exclude\":[\"ignored.hk\"],\"references\":[\"middle\"]},\"other\":{\"kind\":\"executable\",\"sources\":[\"other.hk\"]}}}"

  test::assertTrue(host::writeText(manifest, source))
  for name in ["base", "middle", "session", "other"]
    test::assertTrue(host::writeText(root + "/" + name + ".hk", "namespace " + name + "\n"))
  end
  let success = host::run(generator, [manifest, "session", output])
  let generated = host::readText(output)

  test::assertTrue(success != null && success == 0)
  test::assertTrue(generated != null)
  if generated == null
    return
  end
  let original = (new LspJsonParser(source)).parse().get("units")
  let published = (new LspJsonParser(generated)).parse()
  let units = published.get("units")

  test::assertEqual(published.get("defaultUnit").scalarText(), "session")
  test::assertTrue(units.get("base").isObject() && units.get("middle").isObject() && units.get("session").isObject())
  test::assertTrue(units.get("other").isMissing())
  test::assertEqual(lspJsonStringify(units.get("session")), lspJsonStringify(original.get("session")))
  let cycle = "{\"version\":2,\"defaultUnit\":\"session\",\"units\":{\"base\":{\"kind\":\"library\",\"sources\":[\"base.hk\"],\"references\":[\"session\"]},\"session\":{\"kind\":\"library\",\"sources\":[\"session.hk\"],\"references\":[\"base\"]}}}"

  test::assertTrue(host::writeText(manifest, cycle))
  let cyclic = host::run(generator, [manifest, "session", root + "/cyclic.json"])

  test::assertTrue(cyclic != null && cyclic != 0)
  test::assertTrue(host::readText(root + "/cyclic.json") == null)
  let external = "{\"version\":2,\"defaultUnit\":\"session\",\"units\":{\"session\":{\"kind\":\"library\",\"sources\":[\"session.hk\"],\"references\":[{\"project\":\"other/manifest.json\",\"unit\":\"base\"}]}}}"

  test::assertTrue(host::writeText(manifest, external))
  let rejected = host::run(generator, [manifest, "session", root + "/rejected.json"])

  test::assertTrue(rejected != null && rejected != 0)
  test::assertTrue(host::readText(root + "/rejected.json") == null)
end
