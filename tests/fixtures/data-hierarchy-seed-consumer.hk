use neri_data
use neri_data_sqlite

def seedMigrationApplied(result: MigrationResult): Void
  match result
    case MigrationResult.Applied(count)
      test::assertEqual(count, 1)
    case MigrationResult.Failure(error)
      test::assertTrue(false)
  end
end

def verifyHierarchySeeds(path: String, expectedSignature: String): Void
  match diffSchema("initial", new SchemaModel([]), schema_SeedDatabase())
    case SchemaDiffResult.Unchanged()
      test::assertTrue(false)
    case SchemaDiffResult.Failure(error)
      test::assertTrue(false)
    case SchemaDiffResult.Plan(plan)
      let migration = plan.migration()
      let catalog = new MigrationSet([migration])

      test::assertEqual(migration.signature(), expectedSignature)
      match SQLiteProvider.createWritable(path)
        case SQLiteOpenResult.Failure(error)
          test::assertTrue(false)
        case SQLiteOpenResult.Opened(provider)
          seedMigrationApplied(provider.migrate(catalog))
          let database = new SeedDatabase(provider)

          match database.roots.all()
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 3)
            case QueryResult.Failure(error)
              test::assertTrue(false)
          end
          match database.ofType_SeedLeaf().all()
            case QueryResult.Rows(rows)
              let leaf = rows.first()

              test::assertTrue(leaf != null && leaf.value.id == 2 && leaf.value.tenant == 7 && leaf.value.rank == 9 && leaf.value.enabled)
            case QueryResult.Failure(error)
              test::assertTrue(false)
          end
          seedMigrationApplied(provider.migrate(catalog, ""))
          seedMigrationApplied(provider.migrate(catalog))

          test::assertTrue(provider.close())
      end
  end
end
