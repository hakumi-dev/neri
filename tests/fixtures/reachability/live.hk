use console

def callbackTarget(value: Int): Int
  return value + 1
end

def main(): Void
  let base: reachability::Base = new reachability::Child()

  let called = reachability::live()
  let callback = reachability::callbackApply(callbackTarget)
  let generic = reachability::identity<String>("generic")

  console::println((called as String) + ":" + (callback as String) + ":" + generic + ":" + (base.value() as String))
end
