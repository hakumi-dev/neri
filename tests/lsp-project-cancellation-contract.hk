use test

def lspProjectCancellationContract(root: String): Void
  let directory = root + "/tests/lsp/manifest-workspace"
  let project = new NeriProject()
  let unit = (new LspJsonParser("{\"sources\":[\"main.hk\",\"helper.hk\"]}")).parse()
  let control = new AnalysisControl() do
    return project.sources.size == 0
  end

  project.control = control
  let loaded = neriLoadUnitSources(project, directory, "app", true, unit)

  project.control = null

  test::assertFalse(loaded)
  test::assertTrue(control.isCancelled())
  test::assertEqual(project.error(), "")

  let recovered = neriProjectForSource(directory, directory + "/main.hk")

  test::assertEqual(recovered.error(), "")
  test::assertTrue(neriProjectContains(recovered, directory + "/main.hk"))
  test::assertTrue(neriProjectContains(recovered, directory + "/helper.hk"))
end
