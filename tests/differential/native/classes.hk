use test

class Base
  public seed: Int = 1

  def init(seed: Int = 7): Void
    this.seed = seed
  end
end

class Derived : Base
  public doubled: Int = this.seed * 2

  def init(seed: Int): Void
    super(seed)
    this.doubled = this.doubled + 1
  end
end

class Calculator
  def static two(): Int
    return 2
  end
end

def main(): Void
  let derived = new Derived(20)
  let base = new Base()
  test.assertEqual(derived.seed, 20)
  test.assertEqual(derived.doubled, 41)
  test.assertEqual(base.seed, 7)
  test.assertEqual(Calculator.two(), 2)
end
