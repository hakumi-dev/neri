use ConsoleInteraction

def main(): Void
  let numbers = [10, 20, 30]
  var total = 0
  for number in numbers
    total = total + number
  end

  let flags = [true, false, true]
  if flags[0] && !flags[1] && flags[2]
    total = total + flags.Length
  end

  let bytes = [1 as Byte, 255 as Byte]
  let floats = [1.5, 2.5]
  if floats[0] + floats[1] == 4.0
    total = total + (bytes[1] as Int) + 1
  end

  let words = ["typed" + "", "arrays" + ""]
  let empty: Int[] = []
  let rows = [[1, 2], [7, 8]]
  total = total + empty.Length + rows[1][0]

  ConsoleInteraction.println(words[0] + " " + words[1] + "=" + (total as String))
  return
end
