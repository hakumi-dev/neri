use test

def fieldPackFirst(arena: SyntaxArena, node: Int, kind: readonly SyntaxKind, data: String = ""): Int
  if node < 0
    return -1
  end
  if arena.kindAt(node).same(kind) && (data == "" || arena.dataAt(node) == data)
    return node
  end
  var index = 0

  while index < arena.childCountAt(node)
    let found = fieldPackFirst(arena, arena.childAt(node, index), kind, data)

    if found >= 0
      return found
    end
    index = index + 1
  end
  return -1
end

def main(): Void
  let source = "def collect<T>(labels filters: fields of T, fields: fields, maybe: (fields of T)?): Void\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)
  let function = fieldPackFirst(parser.arena, root, parser.arena.kinds.getFunction())

  test::assertTrue(function >= 0)
  if function >= 0
    let filters = parser.arena.childAt(function, 0)
    let fieldsType = parser.arena.childAt(filters, 0)
    let ordinary = parser.arena.childAt(function, 1)
    let grouped = parser.arena.childAt(parser.arena.childAt(function, 2), 0)

    test::assertEqual(parser.arena.dataAt(filters), "filters")
    test::assertTrue(parser.arena.nodeAt(filters).parameterMode.isLabels())
    test::assertTrue(parser.arena.typeAt(fieldsType).kind.isFields())
    test::assertEqual(parser.arena.typeAt(parser.arena.childAt(fieldsType, 0)).name, "T")
    test::assertTrue(parser.arena.nodeAt(ordinary).parameterMode.isOrdinary())
    let ordinaryType = parser.arena.typeAt(parser.arena.childAt(ordinary, 0))
    let groupedType = parser.arena.typeAt(grouped)
    let optional = groupedType.suffixes

    test::assertTrue(ordinaryType.kind.isNominal())
    test::assertEqual(ordinaryType.name, "fields")
    test::assertTrue(groupedType.kind.isGrouped())
    test::assertTrue(optional != null)
    if optional != null
      test::assertTrue(optional.kind.isOptional())
      test::assertTrue(optional.inner == null)
    end

    test::assertTrue(parser.arena.typeAt(parser.arena.childAt(grouped, 0)).kind.isFields())
    let arguments = new StringBuffer()

    arguments.add("Customer")
    let clone = genericClone(new BootstrapBinder(parser.arena, root, 0), filters, ["T"], arguments)

    test::assertTrue(parser.arena.nodeAt(clone).parameterMode.isLabels())
    test::assertTrue(parser.arena.typeAt(parser.arena.childAt(clone, 0)).kind.isFields())
    let substituted = parser.arena.typeAt(parser.arena.childAt(parser.arena.childAt(clone, 0), 0))

    test::assertTrue(substituted.kind.isResolved())
    test::assertEqual(substituted.name, "Customer")
  end

  let invalid = "enum Choice\n  case Value(labels values: fields of Int)\nend\n"
  let invalidParser = new BootstrapParser((new BootstrapLexer(invalid)).lex())

  invalidParser.parseProgram()

  test::assertTrue(invalidParser.diagnostics.count() > 0)
end
