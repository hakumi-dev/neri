use test

def main(): Void
  let source = "class Box<T>\n  public value: T\n\n  def init(value: T): Void\n    this.value = value\n  end\n\n  public readonly def read(): T\n    return this.value\n  end\nend\n\ndef identity<T>(value: T): T\n  return value\nend\n\ndef apply(value: Int, operation: fn(Int): Int): Int\n  return operation(value)\nend\n\ndef main(): Void\n  let box = new Box<Int>(identity(42))\n  let applied = apply(box.read()) do |value|\n    return value + 1\n  end\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)

  let model = (new BootstrapBinder(parser.arena, root, (new IrSourceMap(source)).utf16Length())).bind()

  test::assertEqual(model.diagnostics.count(), 0)
  test::assertTrue(model.genericInstances >= 2)
  test::assertTrue(model.findClass("Box<Int>") != null)
  test::assertTrue(model.findFunction("identity<Int>") != null)

  let encoded = semanticSnapshotEncode(model, root)

  test::assertTrue(encoded != null)
  if encoded == null
    return
  end
  let restored = semanticSnapshotDecode(encoded)

  test::assertTrue(restored != null)
  if restored == null
    return
  end
  let restoredBox = restored.model.findClass("Box<Int>")
  let restoredIdentity = restored.model.findFunction("identity<Int>")

  test::assertTrue(restoredBox != null && restoredBox.firstField != null)
  test::assertTrue(restoredIdentity != null && restoredIdentity.boundNode >= 0)

  let consumer = "def consume(): String\n  return identity(\"hydrated\")\nend\n"
  let consumerLexer = new BootstrapLexer(consumer)

  consumerLexer.utf16Position = (new IrSourceMap(source)).utf16Length()
  let consumerTokens = consumerLexer.lex()
  let consumerParser = new BootstrapParser(consumerTokens, restored.syntax)
  let consumerRoot = consumerParser.parseProgram()
  let childSourceLength = consumerTokens.startAt(consumerTokens.count() - 1)
  let child = new BootstrapBinder(consumerParser.arena, consumerRoot, childSourceLength, restored.model)

  child.requireEntryPoint = false
  let childModel = child.bind()

  test::assertEqual(childModel.diagnostics.count(), 0)
  test::assertTrue(childModel.genericInstances > restored.model.genericInstances)
  test::assertTrue(childModel.findFunction("identity<String>") != null)
  test::assertTrue(semanticSnapshotEncode(childModel, consumerRoot) == null)

  test::assertTrue(semanticSnapshotDecode("") == null)
  test::assertTrue(semanticSnapshotDecode(host::stringSlice(encoded, 0, host::stringByteLength(encoded) - 1)) == null)
  test::assertTrue(semanticSnapshotEncode(model, parser.arena.count()) == null)

  let programNode = parser.arena.nodeAt(root)
  let originalProgramChildren = programNode.children

  programNode.children = [parser.arena.count()]
  let malformedSyntax = semanticSnapshotEncode(model, root)

  test::assertTrue(malformedSyntax != null)
  if malformedSyntax != null
    test::assertTrue(semanticSnapshotDecode(malformedSyntax) == null)
  end
  programNode.children = originalProgramChildren
  if model.bound.count() > 0
    let boundNode = model.bound.nodeAt(model.bound.count() - 1)
    let originalBoundChildren = boundNode.children

    boundNode.children = [model.bound.count()]
    let malformedBound = semanticSnapshotEncode(model, root)

    test::assertTrue(malformedBound != null)
    if malformedBound != null
      test::assertTrue(semanticSnapshotDecode(malformedBound) == null)
    end
    boundNode.children = originalBoundChildren
  end
  var modifierIndex = 0

  while modifierIndex < parser.arena.count() && !parser.arena.kindAt(modifierIndex).isModifier()
    modifierIndex = modifierIndex + 1
  end

  test::assertTrue(modifierIndex > 0 && modifierIndex < parser.arena.count())
  if modifierIndex > 0 && modifierIndex < parser.arena.count()
    let modifierNode = parser.arena.nodeAt(modifierIndex)
    let originalModifierChildren = modifierNode.children

    modifierNode.children = [0]
    let malformedModifier = semanticSnapshotEncode(model, root)

    test::assertTrue(malformedModifier != null)
    if malformedModifier != null
      test::assertTrue(semanticSnapshotDecode(malformedModifier) == null)
    end
    modifierNode.children = originalModifierChildren
  end
  parser.arena.add(parser.arena.kinds.getInvalid(), "", [])
  let invalidSyntaxKind = semanticSnapshotEncode(model, root)

  test::assertTrue(invalidSyntaxKind != null)
  if invalidSyntaxKind != null
    test::assertTrue(semanticSnapshotDecode(invalidSyntaxKind) == null)
  end
  restored.model.bound.add(restored.model.bound.kinds.getInvalid(), "", "", 0, 1, [])
  let invalidBoundKind = semanticSnapshotEncode(restored.model, restored.root)

  test::assertTrue(invalidBoundKind != null)
  if invalidBoundKind != null
    test::assertTrue(semanticSnapshotDecode(invalidBoundKind) == null)
  end
end
