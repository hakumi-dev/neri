use host
use test

class ConfigContractRule: NeriCodeStyleRule
  def init(): Void
    this.ruleId = "NRSTYLE001"
    this.optionKey = "neri_blank_line_after_declarations"
    this.defaultSeverity = NeriCodeStyleSeverity.suggestion()
  end

  override def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
  end
end

def configWrite(path: String, text: String): Void
  let written = host::writeText(path, text)

  test::assertTrue(written)
end

def configDirectory(path: String): Void
  let status = host::run("mkdir", ["-p", path])

  test::assertTrue(status != null && status == 0)
end

def main(): Void
  let root = host::argumentAt(0)

  test::assertTrue(root != null)
  if root == null
    return
  end
  let fixture = root + "/build/codestyle-config-contract"
  let nested = fixture + "/nested"
  let invalid = fixture + "/invalid"
  let invalidValue = fixture + "/invalid-value"

  configDirectory(nested)
  configDirectory(invalid)
  configDirectory(invalidValue)
  configWrite(fixture + "/.editorconfig", "root = true\n\n[*.hk]\nneri_blank_line_after_declarations = false\nneri_blank_line_before_assertions = false\nneri_diagnostic.NRSTYLE001.severity = error\nneri_assertion_helpers = Verify/Exact, Check/*\n\n[nested/{source{1,2},item{10..12}}.hk]\nneri_blank_line_before_assertions = true\n")
  configWrite(nested + "/.editorconfig", "[*.hk]\nneri_blank_line_after_declarations = unset\nneri_diagnostic.NRSTYLE001.severity = unset\n")
  configWrite(invalid + "/.editorconfig", "[item{1..1}.hk]\nneri_blank_line_after_declarations = false\n")
  configWrite(nested + "/item11.hk", "")
  configWrite(nested + "/plain.hk", "")
  configWrite(invalid + "/item1.hk", "")
  configWrite(invalidValue + "/.editorconfig", "[*.hk]\nneri_blank_line_before_assertions = sometimes\n")
  configWrite(invalidValue + "/item.hk", "")
  let matched = codeStyleOptionsFor(nested + "/item11.hk")
  let plain = codeStyleOptionsFor(nested + "/plain.hk")
  let malformed = codeStyleOptionsFor(invalid + "/item1.hk")
  let invalidOption = codeStyleOptionsFor(invalidValue + "/item.hk")
  let rule = new ConfigContractRule()

  test::assertEqual(matched.error, "")
  test::assertEqual(matched.options.boolean("neri_blank_line_after_declarations", true), true)
  test::assertEqual(matched.options.boolean("neri_blank_line_before_assertions", true), true)
  test::assertTrue(matched.options.severity(rule).isSuggestion())
  test::assertEqual(matched.options.assertionHelpers.size, 2)
  test::assertEqual(matched.options.assertionHelpers.get(0), "Verify.Exact")
  test::assertEqual(matched.options.assertionHelpers.get(1), "Check.*")
  test::assertEqual(plain.error, "")
  test::assertEqual(plain.options.boolean("neri_blank_line_after_declarations", true), true)
  test::assertEqual(plain.options.boolean("neri_blank_line_before_assertions", true), false)
  test::assertTrue(malformed.error != "")
  test::assertTrue(invalidOption.error != "")
  test::assertTrue(codeStyleGlob("?.hk", "é.hk"))
  test::assertTrue(codeStyleGlob("**/item.hk", "item.hk"))
  test::assertTrue(codeStyleGlob("[{}].hk", "nested/{.hk"))
  test::assertTrue(codeStyleGlob("file\\{one,two\\}.hk", "file{one,two}.hk"))
  test::assertTrue(codeStyleGlob("[a/].hk", "nested/a.hk"))
  test::assertTrue(!codeStyleGlob("{1..2}.hk", "1/item.hk"))
  test::assertTrue(!codeStyleHelpersValid("test."))
  test::assertTrue(!codeStyleHelpersValid("test/"))
  test::assertTrue(!codeStyleHelpersValid("test//assert*"))
  test::assertTrue(codeStyleValueError("indent_size", "0") != "")
  test::assertEqual(codeStyleValueError("indent_size", "tab"), "")
  test::assertEqual(codeStyleValueError("tab_width", "4"), "")
  test::assertTrue(codeStyleValueError("insert_final_newline", "sometimes") != "")

  let helpers = new NeriCodeStyleOptions()

  codeStyleApply(helpers, "neri_assertion_helpers", "test/assert*, assert, styleExit")

  test::assertEqual(helpers.assertionHelpers.size, 3)
  test::assertEqual(helpers.assertionHelpers.get(0), "test.assert*")
  test::assertEqual(helpers.assertionHelpers.get(2), "styleExit")

  codeStyleApply(helpers, "neri_assertion_helpers", "Verify.Exact")

  test::assertEqual(helpers.assertionHelpers.size, 1)
  test::assertEqual(helpers.assertionHelpers.get(0), "Verify.Exact")

  codeStyleApply(helpers, "neri_assertion_helpers", "unset")

  test::assertEqual(helpers.assertionHelpers.size, 2)
  test::assertEqual(helpers.assertionHelpers.get(0), "test.assert*")
end
