use console
use host
use test

def templateEntry(id: String, prefix: String, header: String, body: String[], context: String = "global", provider: String = "classDeclaration"): String
  var lines = ""

  for line in body
    lines = lines + (lines == "" ? "" : ",") + lspQuote(line)
  end
  return "{\"id\":" + lspQuote(id) + ",\"prefix\":" + lspQuote(prefix) + ",\"label\":" + lspQuote(id) + ",\"detail\":\"Custom declaration\",\"context\":" + lspQuote(context) + ",\"provider\":" + lspQuote(provider) + ",\"header\":" + lspQuote(header) + ",\"body\":{\"kind\":\"block\",\"lines\":[" + lines + "]}}"
end

def templateCatalog(entries: String): String
  return "{\"version\":1,\"templates\":[" + entries + "]}"
end

def templateItems(catalog: LspDeclarationCatalog, marked: String, snippets: Bool = false): LspJson
  let marker = bootstrapFindText(marked, "|")
  let document = new LspDocument()

  test.assertTrue(marker >= 0)
  document.uri = "untitled:catalog-contract"
  document.text = host.stringSlice(marked, 0, marker) + host.stringSlice(marked, marker + 1, host.stringByteLength(marked) - marker - 1)
  document.publishDiagnostics = false
  let position = (new IrSourceMap(host.stringSlice(marked, 0, marker))).utf16Length()
  let response = lspDeclarationCompletion(document, position, snippets, catalog)

  console.println("Missing template response: " + marked + "\n" + catalog.error) if response == null

  test.assertTrue(response != null)
  if response == null
    return new LspJson()
  end
  return (new LspJsonParser(response)).parse().get("items")
end

def templateExpansion(catalog: LspDeclarationCatalog, marked: String, expected: String, snippets: Bool = false): Void
  let item = templateItems(catalog, marked, snippets).first

  console.println("Missing template item: " + marked) if item == null

  test.assertTrue(item != null)
  if item == null
    return
  end
  let marker = bootstrapFindText(marked, "|")
  let source = host.stringSlice(marked, 0, marker) + host.stringSlice(marked, marker + 1, host.stringByteLength(marked) - marker - 1)
  let edit = item.get("textEdit")
  let start = lspByteOffset(source, edit.get("range").get("start"))
  let finish = lspByteOffset(source, edit.get("range").get("end"))
  let actual = host.stringSlice(source, 0, start) + edit.get("newText").scalarText() + host.stringSlice(source, finish, host.stringByteLength(source) - finish)

  console.println("Template input: " + marked + "\nExpected: " + expected + "\nActual: " + actual) if actual != expected

  test.assertEqual(actual, expected)
end

def invalidTemplate(text: String, message: String): Void
  let catalog = lspParseDeclarationCatalog(text, "catalog.json")

  console.println("Expected catalog error containing " + message + ": " + catalog.error) if bootstrapFindText(catalog.error, message) < 0

  test.assertTrue(bootstrapStartsWith(catalog.error, "catalog.json:"))
  test.assertTrue(bootstrapFindText(catalog.error, message) >= 0)
  test.assertTrue(catalog.first == null)
end

def main(): Void
  let bundled = lspConfiguredDeclarationCatalog()

  test.assertEqual(bundled.error, "")
  let custom = templateEntry("custom", "factory", "class ${1:Widget}<T>: Base<T>", ["public marker: String", "$0"])
  let catalog = lspParseDeclarationCatalog(templateCatalog(custom), "catalog.json")

  test.assertEqual(catalog.error, "")
  templateExpansion(catalog, "factory|", "class Widget<T>: Base<T>\n  public marker: String\n  \nend")
  templateExpansion(catalog, "class Written|", "class Written<T>: Base<T>\n  public marker: String\n  \nend")
  let function = templateEntry("function", "def", "def ${1:select}<T>(${2:value: T}): ${3:T}", ["return value", "$0"], "global", "functionDeclaration")
  let functions = lspParseDeclarationCatalog(templateCatalog(function), "catalog.json")

  test.assertEqual(functions.error, "")
  templateExpansion(functions, "de|", "def select<T>(value: T): T\n  return value\n  \nend")
  templateExpansion(functions, "def written|", "def written<T>(value: T): T\n  return value\n  \nend")
  let unicode = templateEntry("unicode", "def", "def ${1:read}(${2:value: String = \"🙂\"}): ${3:String}", ["return value", "$0"], "global", "functionDeclaration")
  let unicodeCatalog = lspParseDeclarationCatalog(templateCatalog(unicode), "catalog.json")

  test.assertEqual(unicodeCatalog.error, "")
  templateExpansion(unicodeCatalog, "def written(value: String = \"🙂\")|", "def written(value: String = \"🙂\"): String\n  return value\n  \nend")
  let alternatives = lspParseDeclarationCatalog(templateCatalog(custom + "," + templateEntry("second", "factory", "class ${1:Second}", ["$0"])), "catalog.json")
  let choices = templateItems(alternatives, "fac|")
  let first = choices.first

  test.assertTrue(first != null)
  if first != null
    let second = first.next

    test.assertTrue(second != null && second.next == null)
  end
  let escaped = templateEntry("escaped", "literal", "class ${1:Literal}", ["public value: String = \"literal \\$0 and \\\\\\\\ path (paired)\"$0"])
  let literals = lspParseDeclarationCatalog(templateCatalog(escaped), "catalog.json")

  test.assertEqual(literals.error, "")
  templateExpansion(literals, "literal|", "class Literal\n  public value: String = \"literal $0 and \\\\ path (paired)\"\nend")
  let nested = lspParseDeclarationCatalog(templateCatalog(templateEntry("nested", "nested", "class ${1:Nested}", ["def value(): Int", "\treturn 1", "end", "$0"])), "catalog.json")

  test.assertEqual(nested.error, "")
  templateExpansion(nested, "nested|", "class Nested\n  def value(): Int\n    return 1\n  end\n  \nend")
  invalidTemplate("{\"version\":2,\"templates\":[]}", "version")
  invalidTemplate("{\"version\":1,\"templates\":[],\"extra\":true}", "Unknown property")
  let located = lspParseDeclarationCatalog("{\n  \"version\":1,\n  \"templates\":[],\n  \"extra\":true\n}", "catalog.json")

  test.assertTrue(bootstrapStartsWith(located.error, "catalog.json:4:3:"))
  invalidTemplate("{\"version\":1,\"version\":1,\"templates\":[]}", "Duplicate property")
  invalidTemplate(templateCatalog(custom + "," + custom), "Duplicate template id")
  invalidTemplate(templateCatalog(custom) + " trailing", "Invalid JSON")
  invalidTemplate(templateCatalog(templateEntry("bad", "x", "class ${1:X}", ["$0"], "method")), "Context")
  invalidTemplate(templateCatalog(templateEntry("bad", "x", "class ${1:X}", ["$0"], "global", "unknown")), "provider")
  invalidTemplate(templateCatalog(templateEntry("bad", "x", "class ${2:X}", ["$0"])), "contiguous")
  invalidTemplate(templateCatalog(templateEntry("bad", "x", "class ${1|X,Y|}", ["$0"])), "placeholder")
  invalidTemplate(templateCatalog(templateEntry("bad", "x", "class ${1:X}\nend\nclass Y", ["$0"])), "line")
  invalidTemplate(templateCatalog(templateEntry("bad", "def", "def ${1:f}${2:(value: Int): Int}", ["$0"], "global", "functionDeclaration")), "continuation")
  let directory = bootstrapTemporaryDirectory("build", "template-catalog-contract")

  test.assertTrue(directory != null)
  if directory == null
    return
  end
  let path = directory + "/catalog.json"

  test.assertTrue(host.writeText(path, templateCatalog(custom)))
  let server = new LspServer(path)

  test.assertTrue(host.writeText(path, "invalid"))
  templateExpansion(server.declarationCatalog, "factory|", "class Widget<T>: Base<T>\n  public marker: String\n  \nend")
  let restarted = new LspServer(path)

  test.assertTrue(restarted.declarationCatalog.error != "" && restarted.declarationCatalog.first == null)
  test.assertTrue(host.removeFile(path))
  bootstrapRemoveEmptyDirectory(directory)
end
