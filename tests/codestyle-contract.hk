use test

def findingCount(result: NeriCodeStyleResult): Int
  var count = 0
  var finding = result.findings

  while finding != null
    count = count + 1
    finding = finding.next
  end
  return count
end

def editCount(edits: NeriCodeStyleEdit?): Int
  var count = 0
  var edit = edits

  while edit != null
    count = count + 1
    edit = edit.next
  end
  return count
end

class ContractRule: NeriCodeStyleRule
  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let finding = new NeriCodeStyleFinding()

    finding.ruleId = "contract"
    finding.next = result.findings
    result.findings = finding
  end
end

def main(): Void
  let options = new NeriCodeStyleOptions()
  let source = "def main(): Void\n  let first = 1\n  var second = 2\n  work()\n  test.assertTrue(true)\n  test.assertEqual(1, 1)\nend\n"
  let result = neriCodeStyleAnalyzeText(source, options)
  let formatted = neriCodeStyleApply(source, result.edits)
  let repeat = neriCodeStyleAnalyzeText(formatted, options)
  let checked = neriCodeStyleApplyChecked(source, result.edits)

  test.assertTrue(result.valid)
  test.assertEqual(findingCount(result), 2)
  test.assertEqual(formatted, "def main(): Void\n  let first = 1\n  var second = 2\n\n  work()\n\n  test.assertTrue(true)\n  test.assertEqual(1, 1)\nend\n")
  test.assertEqual(findingCount(repeat), 0)

  let comments = "def main(): Void\n  let item = 1\n  # explains work\n  work()\nend\n"
  let commentResult = neriCodeStyleAnalyzeText(comments, options)
  let crlf = "def main(): Void\r\n  work()\r\n  assert(true)\r\nend\r\n"
  let crlfResult = neriCodeStyleAnalyzeText(crlf, options)
  let malformed = neriCodeStyleAnalyzeText("def main(: Void\nend\n", options)
  let extensionRule: NeriCodeStyleRule? = new ContractRule()
  let extension = neriCodeStyleAnalyzeWithRules(neriCodeStyleContext(source), options, extensionRule)
  let deleteComment = new NeriCodeStyleEdit()

  deleteComment.start = bootstrapFindText(comments, "#")
  deleteComment.length = 1
  let malformedEdit = neriCodeStyleApplyChecked(comments, deleteComment)
  let duplicate = new NeriCodeStyleEdit()

  duplicate.start = 0
  duplicate.replacement = "\n"
  let first = new NeriCodeStyleEdit()

  first.start = 0
  first.replacement = "\n"
  first.next = duplicate
  let overlapping = neriCodeStyleApplyChecked(source, first)
  let insideLine = new NeriCodeStyleEdit()

  insideLine.start = bootstrapFindText(source, "first") + 1
  insideLine.replacement = "\n"
  let invalidLineEdit = neriCodeStyleApplyChecked(source, insideLine)
  let closure = "def main(): Void\n  let box = new Box() do\n    assert(true)\n  end\n  work()\nend\n"
  let closureResult = neriCodeStyleAnalyzeText(closure, options)
  let branches = "def main(): Void\n  if true\n    work()\n  else\n    assert(true)\n  end\n  match value\n    case Ready()\n      assert(true)\n  end\nend\n"
  let branchResult = neriCodeStyleAnalyzeText(branches, options)
  let afterIf = "def main(): Void\n  if true\n    work()\n  else\n    work()\n  end\n  assert(true)\nend\n"
  let afterIfResult = neriCodeStyleAnalyzeText(afterIf, options)
  let declarationAssert = "def main(): Void\n  let item = 1\n  assert(true)\nend\n"
  let declarationAssertResult = neriCodeStyleAnalyzeText(declarationAssert, options)
  let unicode = "def main(): Void\r\n  let café = \"😀\"\r\n  work()\r\nend\r\n"
  let unicodeResult = neriCodeStyleAnalyzeText(unicode, options)
  let inlineComment = "def main(): Void\n  let item = 1 # keeps item\n  work()\nend\n"
  let inlineCommentResult = neriCodeStyleAnalyzeText(inlineComment, options)
  let unsafeSource = "def main(): Int\n  return  1\nend\n"
  let unsafeEdit = new NeriCodeStyleEdit()

  unsafeEdit.start = bootstrapFindText(unsafeSource, "  1") + 1
  unsafeEdit.replacement = "\n"
  let unsafeApply = neriCodeStyleApplyChecked(unsafeSource, unsafeEdit)

  test.assertEqual(findingCount(commentResult), 1)
  test.assertEqual(neriCodeStyleApply(comments, commentResult.edits), "def main(): Void\n  let item = 1\n\n  # explains work\n  work()\nend\n")
  test.assertEqual(neriCodeStyleApply(crlf, crlfResult.edits), "def main(): Void\r\n  work()\r\n\r\n  assert(true)\r\nend\r\n")
  test.assertTrue(!malformed.valid)
  test.assertTrue(checked.valid)
  test.assertTrue(neriCodeStyleTokensEquivalent(source, formatted))
  test.assertEqual(findingCount(extension), 1)
  test.assertTrue(!malformedEdit.valid)
  test.assertTrue(!overlapping.valid)
  test.assertTrue(!invalidLineEdit.valid)
  test.assertEqual(findingCount(closureResult), 1)
  test.assertEqual(neriCodeStyleApply(closure, closureResult.edits), "def main(): Void\n  let box = new Box() do\n    assert(true)\n  end\n\n  work()\nend\n")
  test.assertTrue(branchResult.valid)
  test.assertEqual(findingCount(branchResult), 0)
  test.assertEqual(findingCount(afterIfResult), 1)
  test.assertEqual(neriCodeStyleApply(afterIf, afterIfResult.edits), "def main(): Void\n  if true\n    work()\n  else\n    work()\n  end\n\n  assert(true)\nend\n")
  test.assertEqual(findingCount(declarationAssertResult), 2)
  test.assertEqual(editCount(declarationAssertResult.edits), 1)
  test.assertEqual(neriCodeStyleApply(declarationAssert, declarationAssertResult.edits), "def main(): Void\n  let item = 1\n\n  assert(true)\nend\n")
  test.assertEqual(neriCodeStyleApply(unicode, unicodeResult.edits), "def main(): Void\r\n  let café = \"😀\"\r\n\r\n  work()\r\nend\r\n")
  test.assertEqual(neriCodeStyleApply(inlineComment, inlineCommentResult.edits), "def main(): Void\n  let item = 1 # keeps item\n\n  work()\nend\n")
  test.assertTrue(!unsafeApply.valid)
end
