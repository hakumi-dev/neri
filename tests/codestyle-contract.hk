use test

def findingCount(result: NeriCodeStyleResult): Int
  var count = 0
  var finding = result.findings

  while finding != null
    count = count + 1
    finding = finding.next
  end
  return count
end

def editCount(edits: NeriCodeStyleEdit?): Int
  var count = 0
  var edit = edits

  while edit != null
    count = count + 1
    edit = edit.next
  end
  return count
end

def findingHas(result: NeriCodeStyleResult, ruleId: String): Bool
  var finding = result.findings

  while finding != null
    if finding.ruleId == ruleId
      return true
    end
    finding = finding.next
  end
  return false
end

class ContractRule: NeriCodeStyleRule
  def evaluate(context: NeriCodeStyleContext, options: NeriCodeStyleOptions, result: NeriCodeStyleResult): Void
    let finding = new NeriCodeStyleFinding(this, options.severity(this))

    finding.ruleId = "contract"
    finding.next = result.findings
    result.findings = finding
  end
end

def assertFormatted(options: NeriCodeStyleOptions, source: String, expected: String): Void
  let result = neriCodeStyleAnalyzeText(source, options)
  let formatted = neriCodeStyleApply(source, result.edits)
  let repeat = neriCodeStyleAnalyzeText(formatted, options)

  test::assertTrue(result.valid)
  test::assertEqual(formatted, expected)
  test::assertEqual(findingCount(repeat), 0)
  test::assertTrue(neriCodeStyleTokensEquivalent(source, formatted))
end

def codeStyleBasicContracts(options: NeriCodeStyleOptions): Void
  let source = "def main(): Void\n  let first = 1\n  var second = 2\n  work()\n  test::assertTrue(true)\n  test::assertEqual(1, 1)\nend\n"
  let result = neriCodeStyleAnalyzeText(source, options)
  let formatted = neriCodeStyleApply(source, result.edits)
  let repeat = neriCodeStyleAnalyzeText(formatted, options)
  let checked = neriCodeStyleApplyChecked(source, result.edits)

  test::assertTrue(result.valid)
  test::assertEqual(findingCount(result), 2)
  test::assertEqual(
    formatted,
    "def main(): Void\n  let first = 1\n  var second = 2\n\n  work()\n\n  test::assertTrue(true)\n  test::assertEqual(1, 1)\nend\n"
  )
  test::assertEqual(findingCount(repeat), 0)
  test::assertTrue(checked.valid)
  test::assertTrue(neriCodeStyleTokensEquivalent(source, formatted))
end

def codeStyleTextContracts(options: NeriCodeStyleOptions): Void
  assertFormatted(
    options,
    "def main(): Void\n  let item = 1\n  # explains work\n  work()\nend\n",
    "def main(): Void\n  let item = 1\n\n  # explains work\n  work()\nend\n"
  )
  assertFormatted(
    options,
    "def main(): Void\r\n  work()\r\n  assert(true)\r\nend\r\n",
    "def main(): Void\r\n  work()\r\n\r\n  assert(true)\r\nend\r\n"
  )
  assertFormatted(
    options,
    "def main(): Void\r\n  let café = \"😀\"\r\n  work()\r\nend\r\n",
    "def main(): Void\r\n  let café = \"😀\"\r\n\r\n  work()\r\nend\r\n"
  )
  assertFormatted(
    options,
    "def main(): Void\n  let item = 1 # keeps item\n  work()\nend\n",
    "def main(): Void\n  let item = 1 # keeps item\n\n  work()\nend\n"
  )
end

def codeStyleMalformedContracts(options: NeriCodeStyleOptions): Void
  let malformed = neriCodeStyleAnalyzeText("def main(: Void\nend\n", options)
  let comments = "def main(): Void\n  let item = 1\n  # explains work\n  work()\nend\n"
  let deleteComment = new NeriCodeStyleEdit()

  deleteComment.start = bootstrapFindText(comments, "#")
  deleteComment.length = 1
  let malformedEdit = neriCodeStyleApplyChecked(comments, deleteComment)

  test::assertTrue(!malformed.valid)
  test::assertTrue(!malformedEdit.valid)
end

def codeStyleOverlappingEditContract(): Void
  let duplicate = new NeriCodeStyleEdit()

  duplicate.start = 0
  duplicate.replacement = "\n"
  let first = new NeriCodeStyleEdit()

  first.start = 0
  first.replacement = "\n"
  first.next = duplicate
  let source = "def main(): Void\n  let first = 1\n  work()\nend\n"
  let overlapping = neriCodeStyleApplyChecked(source, first)

  test::assertTrue(!overlapping.valid)
end

def codeStyleUnsafeEditContracts(): Void
  let declaration = new BootstrapParser((new BootstrapLexer("public class Entry\nend\n")).lex())
  let changedAccess = new BootstrapParser((new BootstrapLexer("private class Entry\nend\n")).lex())
  let changedName = new BootstrapParser((new BootstrapLexer("public class Other\nend\n")).lex())
  let declarationRoot = declaration.parseProgram()
  let accessRoot = changedAccess.parseProgram()
  let nameRoot = changedName.parseProgram()

  test::assertTrue(!neriCodeStyleSyntaxEquivalent(declaration.arena, declarationRoot, changedAccess.arena, accessRoot))
  test::assertTrue(!neriCodeStyleSyntaxEquivalent(declaration.arena, declarationRoot, changedName.arena, nameRoot))
  let source = "def main(): Void\n  let first = 1\n  work()\nend\n"
  let insideLine = new NeriCodeStyleEdit()

  insideLine.start = bootstrapFindText(source, "first") + 1
  insideLine.replacement = "\n"
  let invalidLineEdit = neriCodeStyleApplyChecked(source, insideLine)
  let unsafeSource = "def main(): Int\n  return  1\nend\n"
  let unsafeEdit = new NeriCodeStyleEdit()

  unsafeEdit.start = bootstrapFindText(unsafeSource, "  1") + 1
  unsafeEdit.replacement = "\n"
  let unsafeApply = neriCodeStyleApplyChecked(unsafeSource, unsafeEdit)

  test::assertTrue(!invalidLineEdit.valid)
  test::assertTrue(!unsafeApply.valid)
end

def codeStyleBodyContracts(options: NeriCodeStyleOptions): Void
  let closure = "def main(): Void\n  let box = new Box() do\n    assert(true)\n  end\n  work()\nend\n"
  let expression = "def main(): Void\n  let callback: fn(Int): Int = fn(value)  do\n    return value\n  end\nend\n"
  let afterIf = "def main(): Void\n  if true\n    work()\n  else\n    work()\n  end\n  assert(true)\nend\n"

  assertFormatted(
    options,
    closure,
    "def main(): Void\n  let box = new Box() do\n    assert(true)\n  end\n\n  work()\nend\n"
  )
  assertFormatted(
    options,
    expression,
    "def main(): Void\n  let callback: fn(Int): Int = fn(value) do\n    return value\n  end\nend\n"
  )
  assertFormatted(
    options,
    afterIf,
    "def main(): Void\n  if true\n    work()\n  else\n    work()\n  end\n\n  assert(true)\nend\n"
  )
end

def codeStyleBranchBoundaryContract(options: NeriCodeStyleOptions): Void
  let branches = "def main(): Void\n  if true\n    work()\n  else\n    assert(true)\n  end\n  match value\n    case Ready()\n      assert(true)\n  end\nend\n"
  let result = neriCodeStyleAnalyzeText(branches, options)

  test::assertTrue(result.valid)
  test::assertEqual(findingCount(result), 0)
end

def codeStyleOverlappingRulesContract(options: NeriCodeStyleOptions): Void
  let declarationAssert = "def main(): Void\n  let item = 1\n  assert(true)\nend\n"
  let declarationAssertResult = neriCodeStyleAnalyzeText(declarationAssert, options)

  test::assertEqual(findingCount(declarationAssertResult), 2)
  test::assertEqual(editCount(declarationAssertResult.edits), 1)
  test::assertTrue(findingHas(declarationAssertResult, "NRSTYLE001"))
  test::assertTrue(findingHas(declarationAssertResult, "NRSTYLE002"))
  test::assertEqual(
    neriCodeStyleApply(declarationAssert, declarationAssertResult.edits),
    "def main(): Void\n  let item = 1\n\n  assert(true)\nend\n"
  )
end

def codeStyleExtensionContract(options: NeriCodeStyleOptions): Void
  let source = "def main(): Void\nend\n"
  let extensionRule: NeriCodeStyleRule? = new ContractRule()
  let extension = neriCodeStyleAnalyzeWithRules(neriCodeStyleContext(source), options, extensionRule)

  test::assertEqual(findingCount(extension), 1)
end

def main(): Void
  let options = new NeriCodeStyleOptions()

  codeStyleBasicContracts(options)
  codeStyleTextContracts(options)
  codeStyleMalformedContracts(options)
  codeStyleOverlappingEditContract()
  codeStyleUnsafeEditContracts()
  codeStyleBodyContracts(options)
  codeStyleBranchBoundaryContract(options)
  codeStyleOverlappingRulesContract(options)
  codeStyleExtensionContract(options)
  codeStyleLayoutContracts(options)
  codeStyleIndentationContracts(options)
  codeStyleSpacingContract()
  codeStyleSpacingRolesContract()
  codeStyleSpacingTextContract()
  codeStyleOneClassPerFileContract()
  codeStyleLineLengthContract()
  codeStyleCompileForContract()
end

def codeStyleCompileForContract(): Void
  let tokens = (new BootstrapLexer("compile for compiled")).lex()
  let source = "def main(): Void\n  compile for field in reflect.fields<Input>()\n    useField(field.name)\n  end\nend\n"
  let reservedName = neriCodeStyleContext("def main(): Void\n  let compile = 1\nend\n")

  test::assertTrue(tokens.kindAt(0).isCompile())
  test::assertTrue(tokens.kindAt(1).isFor())
  test::assertTrue(tokens.kindAt(2).isIdentifier())
  test::assertTrue(!reservedName.valid)
  assertFormatted(new NeriCodeStyleOptions(), source, source)
end

def codeStyleLineLengthContract(): Void
  let options = new NeriCodeStyleOptions()

  options.setMaxLineLength(39)

  assertFormatted(
    options,
    "def main(): Void\n  let values = [pair(firstArgument, secondArgument), pair(thirdArgument, fourthArgument)]\nend\n",
    "def main(): Void\n  let values = [\n    pair(\n      firstArgument,\n      secondArgument\n    ),\n    pair(thirdArgument, fourthArgument)\n  ]\nend\n"
  )
  options.setMaxLineLength(40)

  assertFormatted(
    options,
    "def main(): Void\n  chain(quote do |value: Int|: Int\n      return value\n    end).pair(firstArgument, secondArgument)\nend\n",
    "def main(): Void\n  chain(quote do |value: Int|: Int\n      return value\n    end).pair(\n    firstArgument,\n    secondArgument\n  )\nend\n"
  )
  assertFormatted(
    options,
    "def work(): Int\n  return pair(firstArgument, secondArgument) + pair(thirdArgument, fourthArgument)\nend\n",
    "def work(): Int\n  return pair(\n    firstArgument,\n    secondArgument\n  ) + pair(\n    thirdArgument,\n    fourthArgument\n  )\nend\n"
  )
  assertFormatted(
    options,
    "def main(): Void\n  let values = [first(11, 22), second(33, 44), third(55, 66)]\nend\n",
    "def main(): Void\n  let values = [\n    first(11, 22),\n    second(33, 44),\n    third(55, 66)\n  ]\nend\n"
  )
  assertFormatted(
    options,
    "def work(first: String, second: String): Void\nend\n",
    "def work(\n  first: String,\n  second: String\n): Void\nend\n"
  )
  let literal = "def main(): Void\n  let text = \"A long string, with commas, stays intact.\"\nend\n"
  let result = neriCodeStyleAnalyzeText(literal, options)

  test::assertTrue(result.valid)
  test::assertTrue(!findingHas(result, "NRSTYLE008"))
  test::assertEqual(neriCodeStyleApply(literal, result.edits), literal)
  assertFormatted(
    options,
    "def main(): Void\n  work(firstArgument, secondArgument) if condition\nend\n",
    "def main(): Void\n  work(firstArgument, secondArgument) if condition\nend\n"
  )
  options.setMaxLineLength(0)

  test::assertTrue(!findingHas(neriCodeStyleAnalyzeText(literal, options), "NRSTYLE008"))
end
