use test

def main(): Void
  let domain = CacheDomain.runObject()
  let baseline = cacheIdentity(domain, "producer", "object", ["ab", "c"])

  test::assertTrue(baseline != cacheIdentity(domain, "producer", "object", ["a", "bc"]))
  test::assertTrue(baseline != cacheIdentity(domain, "producer", "object", ["c", "ab"]))
  test::assertTrue(baseline != cacheIdentity(CacheDomain.runExecutable(), "producer", "object", ["ab", "c"]))
  test::assertTrue(baseline != cacheIdentity(domain, "other-producer", "object", ["ab", "c"]))
  test::assertTrue(baseline != cacheIdentity(domain, "producer", "other-format", ["ab", "c"]))
  test::assertTrue(cacheFormatIdentity(domain, "producer") != cacheFormatIdentity(domain, "other-producer"))

  let module = new IrModule("main", "")
  let payload = sha256FastText("payload")
  let envelope = irEnvelopeIdentity(module, 7, payload)

  test::assertTrue(envelope != irEnvelopeIdentity(module, 8, payload))
  test::assertTrue(envelope != irEnvelopeIdentity(module, 7, sha256FastText("changed payload")))
  module.requiredFeatures.requireDebugScopes()

  test::assertTrue(envelope != irEnvelopeIdentity(module, 7, payload))
end
