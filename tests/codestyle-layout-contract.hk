use test

def codeStyleLayoutContracts(options: NeriCodeStyleOptions): Void
  let source = "def main(): Void  \r\n  let café = \"😀  \" # literal and comment  \r\n  consume(café)\t\r\nend  "
  let expected = "def main(): Void\r\n  let café = \"😀  \" # literal and comment\r\n\r\n  consume(café)\r\nend\r\n"

  assertFormatted(options, source, expected)
  assertFormatted(options, "use console\n\ndef main():Void\nlet café=\"😀\"\nconsole.println( café )  \nend", "use console\n\ndef main(): Void\n  let café = \"😀\"\n\n  console.println(café)\nend\n")
  let disabled = new NeriCodeStyleOptions()

  disabled.set("trim_trailing_whitespace", "false")
  disabled.set("insert_final_newline", "false")

  assertFormatted(disabled, "def main(): Void  \nend  ", "def main(): Void  \nend  ")
  let commentSource = "# first second\ndef main(): Void\nend\n"
  let commentEdit = new NeriCodeStyleEdit()

  commentEdit.start = 7
  commentEdit.replacement = " "
  let commentResult = neriCodeStyleApplyChecked(commentSource, commentEdit)

  test.assertTrue(!commentResult.valid)
end
