use test

def codeStyleLayoutContracts(options: NeriCodeStyleOptions): Void
  let source = "def main(): Void  \r\n  let café = \"😀  \" # literal and comment  \r\n  consume(café)\t\r\nend  "
  let expected = "def main(): Void\r\n  let café = \"😀  \" # literal and comment\r\n\r\n  consume(café)\r\nend\r\n"

  assertFormatted(options, source, expected)
  assertFormatted(
    options,
    "use console\n\ndef main():Void\nlet café=\"😀\"\nconsole::println( café )  \nend",
    "use console\n\ndef main(): Void\n  let café = \"😀\"\n\n  console::println(café)\nend\n"
  )
  let disabled = new NeriCodeStyleOptions()

  disabled.setBoolean("trim_trailing_whitespace", false)
  disabled.setBoolean("insert_final_newline", false)

  assertFormatted(disabled, "def main(): Void  \nend  ", "def main(): Void  \nend  ")
  let commentSource = "# first second\ndef main(): Void\nend\n"
  let commentEdit = new NeriCodeStyleEdit()

  commentEdit.start = 7
  commentEdit.replacement = " "
  let commentResult = neriCodeStyleApplyChecked(commentSource, commentEdit)

  test::assertTrue(!commentResult.valid)
end

def codeStyleFunctionSpacingContract(options: NeriCodeStyleOptions): Void
  let source = "class Example\n  private tag: Int\n  def init(): Void\n  end\n  public def first(): Void\n    if true\n      work()\n    end\n    work()\n  end # first\n  # explains second\n  @tag\n  private static def second(): Void\n  end\n  protected def third(): Void\n  end\n  public value: Int\nend\ndef outside(): Void\nend\nclass After\nend\n"
  let expected = "class Example\n  private tag: Int\n\n  def init(): Void\n  end\n\n  public def first(): Void\n    if true\n      work()\n    end\n    work()\n  end # first\n\n  # explains second\n  @tag\n  private static def second(): Void\n  end\n\n  protected def third(): Void\n  end\n\n  public value: Int\nend\n\ndef outside(): Void\nend\n\nclass After\nend\n"

  assertFormatted(options, source, expected)
  assertFormatted(
    options,
    "class Example\r\n  static def first(): Void\r\n  end\r\n  static def second(): Void\r\n  end\r\nend\r\n",
    "class Example\r\n  static def first(): Void\r\n  end\r\n\r\n  static def second(): Void\r\n  end\r\nend\r\n"
  )
  let disabled = new NeriCodeStyleOptions()
  let adjacent = "def first(): Void\nend\ndef second(): Void\nend\n"

  disabled.setBoolean("neri_blank_line_around_functions", false)

  assertFormatted(disabled, adjacent, adjacent)
end
