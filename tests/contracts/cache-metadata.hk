use crypto
use files
use host
use resources
use result
use test

@cabiImport("neri_rt_v1_cache_metadata")
unsafe def cacheMetadata(path: Byte*, length: Int, follow: Int, kind: Int*, permissions: Int*, owned: Int*, fingerprint: Byte*): Int
end

def run(command: String, arguments: String[]): Void
  let status = host::run(command, arguments)

  test::assertTrue(status != null && status == 0)
end

def snapshot(path: String, follow: Bool, expectedKind: Int, expectedPermissions: Int = -1): String
  let length = host::stringByteLength(path)

  unsafe
    let bytes = native::alloc<Byte>(length)
    let kind = stackalloc Int[1]
    let permissions = stackalloc Int[1]
    let owned = stackalloc Int[1]
    let digest = stackalloc Byte[32]
    var index = 0

    while index < length
      bytes[index] = host::stringByteAt(path, index)
      index = index + 1
    end
    let status = cacheMetadata(bytes, length, follow ? 1 : 0, kind, permissions, owned, digest)

    native::free(bytes)

    test::assertEqual(status, 0)
    test::assertEqual(kind[0], expectedKind)
    test::assertEqual(owned[0], 1)
    if expectedPermissions >= 0
      test::assertEqual(permissions[0], expectedPermissions)
    end
    var output: Byte[] = []

    index = 0
    while index < 32
      output = host::appendByte(output, digest[index])
      index = index + 1
    end
    let encoded = crypto::encodeHex(output)

    test::assertTrue(encoded != null)
    if encoded != null
      return encoded
    end
    return ""
  end
end

def verifyMetadata(): resources::Outcome<Int, result::Failure>
  using directory <- files::TemporaryDirectory.create("cache-metadata-")
    let root = directory.path()
    let path = root + "/file"
    let link = root + "/link"

    snapshot(root, false, 2, 448)

    test::assertTrue(host::writeText(path, "before"))
    run("/bin/chmod", ["600", path])

    let before = snapshot(path, false, 1, 384)
    let read = host::readText(path)

    test::assertTrue(read != null && read == "before")
    test::assertEqual(snapshot(path, false, 1, 384), before)
    run("/bin/ln", ["-s", path, link])

    test::assertEqual(snapshot(link, true, 1, 384), before)
    test::assertTrue(snapshot(link, false, 3) != before)
    test::assertTrue(host::writeText(path, "different contents"))
    test::assertTrue(snapshot(path, false, 1, 384) != before)

    let changed = snapshot(path, false, 1, 384)

    run("/bin/chmod", ["644", path])

    test::assertTrue(snapshot(path, false, 1, 420) != changed)
    return 0
  end
  return 1
end

def main(): Void
  if host::environment("OS") == "Windows_NT"
    unsafe
      let path = stackalloc Byte[1]
      let kind = stackalloc Int[1]
      let permissions = stackalloc Int[1]
      let owned = stackalloc Int[1]
      let fingerprint = stackalloc Byte[32]

      path[0] = 46 as Byte
      kind[0] = 99
      permissions[0] = 99
      owned[0] = 99
      var index = 0

      while index < 32
        fingerprint[index] = 255 as Byte
        index = index + 1
      end
      let status = cacheMetadata(path, 1, 0, kind, permissions, owned, fingerprint)

      test::assertEqual(status, -1)
      test::assertEqual(kind[0], 0)
      test::assertEqual(permissions[0], 0)
      test::assertEqual(owned[0], 0)
      index = 0

      while index < 32
        test::assertEqual(fingerprint[index] as Int, 0)
        index = index + 1
      end
    end
    return
  end
  let completed = verifyMetadata()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
