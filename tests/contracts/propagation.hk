use test

@propagation("Value", "Failure")
enum Source<T, E>
  case Value(value: T)
  case Failure(error: E)
end

@propagation("Resolved", "Broken")
enum Target<T, E>
  case Broken(error: E)
  case Resolved(value: T)
end

class FailureBase
  public message: String = "failed"
end

class FailureChild: FailureBase
end

class Probe
  public calls: Int = 0

  def read(fail: Bool): Source<Int, FailureChild>
    this.calls = this.calls + 1
    if fail
      return Source<Int, FailureChild>.Failure(new FailureChild())
    end
    return Source<Int, FailureChild>.Value(6)
  end
end

def resolved(probe: Probe, fail: Bool): Target<Bool, FailureBase>
  let value = try probe.read(fail)

  return Target<Bool, FailureBase>.Resolved(value == 6)
end

def nested(probe: Probe): Target<Int, FailureBase>
  return Target<Int, FailureBase>.Resolved((try probe.read(false)) + 1)
end

def readonlyValue(value: readonly Source<Probe, String>): Target<Int, String>
  let probe = try value

  return Target<Int, String>.Resolved(probe.calls)
end

def chained(probe: Probe): Target<Int, FailureBase>
  let first = try probe.read(true)
  let second = try probe.read(false)

  return Target<Int, FailureBase>.Resolved(first + second)
end

def inClosure(probe: Probe): Target<Int, FailureBase>
  let callback: fn(): Target<Int, FailureBase> = fn(): Target<Int, FailureBase>
    let value = try probe.read(false)

    return Target<Int, FailureBase>.Resolved(value)
  end

  return callback()
end

def main(): Void
  let probe = new Probe()

  match resolved(probe, false)
    case Target.Resolved(value)
      test::assertTrue(value)
    case Target.Broken(error)
      test::assertTrue(false)
  end

  test::assertEqual(probe.calls, 1)

  match resolved(probe, true)
    case Target.Resolved(value)
      test::assertTrue(false)
    case Target.Broken(error)
      test::assertEqual(error.message, "failed")
  end

  test::assertEqual(probe.calls, 2)

  match nested(probe)
    case Target.Resolved(value)
      test::assertEqual(value, 7)
    case Target.Broken(error)
      test::assertTrue(false)
  end

  test::assertEqual(probe.calls, 3)

  match readonlyValue(Source<Probe, String>.Value(probe))
    case Target.Resolved(value)
      test::assertEqual(value, 3)
    case Target.Broken(error)
      test::assertTrue(false)
  end

  match chained(probe)
    case Target.Resolved(value)
      test::assertTrue(false)
    case Target.Broken(error)
      test::assertEqual(error.message, "failed")
  end

  test::assertEqual(probe.calls, 4)

  match inClosure(probe)
    case Target.Resolved(value)
      test::assertEqual(value, 6)
    case Target.Broken(error)
      test::assertTrue(false)
  end

  test::assertEqual(probe.calls, 5)
end
