def accept(operation: fn(Int): Int): Void
end

def wrongParameter(): Void
  accept() do |value: String|: Int
    return 0
  end
end

def wrongReturn(): Void
  accept() do |value|
    return "wrong"
  end
end

def missingReturn(): Void
  accept() do |value|
    if value > 0
      return value
    end
  end
end

def mutableCapture(): fn(): Int
  var value = 1
  return fn()
    return value
  end
end

def unsafeCapture(): Void
  unsafe
    let pointer = stackalloc Int[1]
    let read = fn(): Int
      unsafe
        return pointer[0]
      end
    end
  end
end

def groupedPointer(pointer: (Int*)): Void
end

def main(): Void
  let unknown = fn(value)
    return value
  end
end
