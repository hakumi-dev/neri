use host

def main(): Void
  let caseName = host.argumentAt(0)
  if caseName == null
    host.exit(2)
    return
  end
  if caseName == "i32"
    let result = 2147483648 as Int32
  else if caseName == "u32"
    let result = 4294967296 as UInt32
  else if caseName == "negative"
    let result = -1 as UInt64
  else if caseName == "signed"
    let result = ((9223372036854775807 as UInt64) + (1 as UInt64)) as Int
  else if caseName == "float"
    let result = (4294967296.0 as Float32) as UInt32
  else if caseName == "nan"
    let result = ((0.0 as Float32) / (0.0 as Float32)) as Int32
  else if caseName == "narrow"
    let result = (100000000000000000000.0 * 100000000000000000000.0) as Float32
  else if caseName == "add"
    let result = (2147483647 as Int32) + (1 as Int32)
  else if caseName == "subtract"
    let result = (0 as UInt32) - (1 as UInt32)
  else if caseName == "multiply"
    let result = (4294967295 as UInt32) * (2 as UInt32)
  else if caseName == "divide"
    let result = (-2147483648 as Int32) / (-1 as Int32)
  else if caseName == "zero"
    let result = (1 as UInt64) / (0 as UInt64)
  end
  host.exit(2)
end
