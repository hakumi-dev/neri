use result

@propagation("First", "Second")
enum Malformed
  case First()
  case Second(error: String)
end

@propagation("Value", "Failure")
class NotAnEnum
end

@propagation("Value", "Failure")
def notAType(): Void
end

enum Unmarked
  case Value(value: Int)
  case Failure(error: String)
end

@propagation("Value", "Failure")
enum Source<T, E>
  case Value(value: T)
  case Failure(error: E)
end

@propagation("Done", "Broken")
enum Target<T, E>
  case Broken(error: E)
  case Done(value: T)
end

resource class Handle
  def close(): result::Failure?
    return null
  end
end

def unmarked(): Target<Int, String>
  let value = try Unmarked.Value(3)

  return Target<Int, String>.Done(value)
end

def wrongError(): Target<Int, Int>
  let value = try Source<Int, String>.Failure("failed")

  return Target<Int, Int>.Done(value)
end

def resourcePayload(): Source<Handle, String>
  return Source<Handle, String>.Value(new Handle())
end

def resourceUnwrap(): Target<Int, String>
  let handle = try resourcePayload()

  return Target<Int, String>.Done(1)
end

def main(): Void
end
