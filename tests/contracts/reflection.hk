use result
use test

class Entity
  public id: Int = 7
  private secret: String = "hidden"
end

class User: Entity
  public name: String = "Ana\n\"quoted\""
end

class Envelope<T>
  public item: T

  def init(item: T): Void
    this.item = item
  end
end

class Empty
  private hidden: Int = 1
end

class Probe
  public calls: Int = 0
  public user: User = new User()

  def next(): User
    this.calls = this.calls + 1
    return this.user
  end

  def replacement(): Int
    this.calls = this.calls * 10
    return 31
  end
end

def encode<T>(value: T): result::Result<String, json::Failure>
  let object = json::Value.object()

  compile for field in reflect.fields<T>()
    let content = field.read(value) as String

    if field.typeName == "String"
      object.put(field.name, json::Value.string(content))
    else
      let number = json::Value.number(content)

      if number == null
        return result::Result<String, json::Failure>.Error(new json::Failure("unsupported_number"))
      end
      object.put(field.name, number)
    end
  end
  return json::stringify(object)
end

def describe<T>(value: T): String
  var result = ""

  compile for field in reflect.fields<T>()
    let item = field.read(value)
    let describe = fn(): String do
      return field.name + ":" + field.typeName + "=" + (item as String) + ";"
    end

    result = result + describe()
  end
  return result
end

def copyFields<T>(target: T, source: T): Void
  compile for field in reflect.fields<T>()
    field.write(target, field.read(source))
  end
end

def main(): Void
  let user = new User()

  match encode(user)
    case Result.Ok(value)
      test::assertEqual(value, "{\"id\":7,\"name\":\"Ana\\u000a\\\"quoted\\\"\"}")
    case Result.Error(error)
      test::assertTrue(false)
  end

  test::assertEqual(describe(new Envelope<Int>(42)), "item:Int=42;")
  test::assertEqual(describe(new Envelope<String>("text")), "item:String=text;")
  test::assertEqual(describe(new Empty()), "")
  test::assertEqual(describe(user), "id:Int=7;name:String=Ana\n\"quoted\";")
  let probe = new Probe()
  var owners = ""

  compile for field in reflect.fields<User>()
    let value = field.read(probe.next())

    owners = owners + field.declaringType + ";"
    compile for nested in reflect.fields<Entity>()
      test::assertEqual(nested.read(user), 7)
    end
  end

  test::assertEqual(probe.calls, 2)
  test::assertEqual(owners, "Entity;User;")
  let flag = new Envelope<Bool>(true)

  compile for field in reflect.fields<Envelope<Bool>>()
    test::assertTrue(field.read(flag))
  end
  let copied = new User()

  user.id = 19
  user.name = "copied"
  copyFields(copied, user)

  test::assertEqual(copied.id, 19)
  test::assertEqual(copied.name, "copied")
  let replacement = new Envelope<Bool>(false)

  copyFields(flag, replacement)

  test::assertFalse(flag.item)
  let optional = new Envelope<Int?>(5)

  copyFields(optional, new Envelope<Int?>(null))

  test::assertTrue(optional.item == null)
  probe.calls = 0
  compile for field in reflect.fields<Entity>()
    field.write(probe.next(), probe.replacement())
  end

  test::assertEqual(probe.calls, 10)
  test::assertEqual(probe.user.id, 31)
end
