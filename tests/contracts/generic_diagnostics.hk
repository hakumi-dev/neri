def pass<T>(value: T): T
  return value
end

def grow<T>(value: T): Int
  return pass(grow([value])) + 1
end

def independent<Observed, Missing>(value: Observed): Missing?
  return null
end

def fromContext<Expected>(): Expected?
  return null
end

def choose<T>(first: T, fallback: T, useFirst: Bool): T
  return useFirst ? first : fallback
end

def main(): Void
  let rejected = grow(1)
  let unresolved = independent(unknownForInference)
  let unresolvedHint: (UnknownExpectedType)? = fromContext()
  let recovered = choose(unknownForFallback, 1, false)
  let mismatch = recovered + "text"
  let explicitlyRejected = choose<UnknownExplicitType>(1, 2, true)
  let dependent = explicitlyRejected + "text"
end
