use console
use host
use tasks

def indirect(again: Bool): Void
  indirect(false) if again
  console::println("effect")
end

class Service
  public readonly def run(): Void
    indirect(false)
  end
end

class Inherited: Service
end

def main(): Void
  let service = new Inherited()
  let shared: shared fn(): Void = fn() do
    return
  end
  let io: Int[] = tasks::generate(2) do |index|
    indirect(true)
    return index
  end
  let dispatch: parallel fn(): Void = fn() do
    service.run()
  end
  let callback: parallel fn(): Void = fn() do
    shared()
  end
  let nativeCallback: parallel fn(): Void = fn() do
    unsafe
      let buffer = native::alloc<Int>(1)

      native::free(buffer)
    end
  end
  let process: parallel fn(): Int = fn() do
    return host::argumentCount()
  end
end
