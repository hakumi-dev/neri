use console
use host
use tasks

def indirect(again: Bool): Void
  indirect(false) if again
  console.println("effect")
end

class Service
  @readonly
  public def run(): Void
    indirect(false)
  end
end

class Inherited : Service
end

def main(): Void
  let service = new Inherited()
  let shared: shared fn(): Void = fn()
    return
  end
  let io: Int[] = tasks.generate(2) do |index|
    indirect(true)
    return index
  end
  let dispatch: parallel fn(): Void = fn()
    service.run()
  end
  let callback: parallel fn(): Void = fn()
    shared()
  end
  let nativeCallback: parallel fn(): Void = fn()
    unsafe
      let buffer = native.alloc<Int>(1)
      native.free(buffer)
    end
  end
  let process: parallel fn(): Int = fn()
    return host.argumentCount()
  end
end
