use quotation

class Customer
  public active: Bool = false

  public def activate(): Bool
    this.active = true
    return this.active
  end
end

class Order
  public active: Bool = false
end

def wrongQuotationType(): quote fn(Customer): Bool
  return quote do |order: Order|: Bool
    return order.active
  end
end

def callQuotation(expression: quote fn(Customer): Bool, customer: Customer): Bool
  return expression(customer)
end

def quoteEffect(): quote fn(Customer): Bool
  return quote do |customer: Customer|: Bool
    return customer.activate()
  end
end

def invalidQuotationType(expression: quote fn(Missing): Bool): Void
end

def invalidQuotationMember(): quote fn(Customer): Bool
  return quote do |customer: Customer|: Bool
    return customer.missing
  end
end

def main(): Void
end
