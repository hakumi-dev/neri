class Base
end

class Derived : Base
end

class InvalidMethod
  @exact
  def compare(value: Base): Void
  end
end

@exact("arguments")
def invalidAnnotation<T>(value: T): Void
end

@exact
def acceptExact(value: Base): Void
end

@exact
def same<T>(left: T, right: T): Void
end

def main(): Void
  acceptExact(new Derived())
  same(new Base(), new Derived())
end
