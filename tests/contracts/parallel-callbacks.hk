use test
use console

class Node
  public value: Int = 3
end

class Noisy
  @readonly
  public def read(): Int
    console.println("unused")
    return 0
  end
end

class Quiet : Noisy
  @override
  @readonly
  public def read(): Int
    return 7
  end
end

def apply<T>(value: T, callback: parallel fn(T): T): T
  return callback(value)
end

def identity<T>(value: T): T
  return value
end

def main(): Void
  let node = new Node()
  let quiet = new Quiet()
  let pure: parallel fn(Int): Int = fn(value)
    let local = new Node()
    local.value = value + node.value + quiet.read()
    return local.value
  end
  let noisy: shared fn(Int): Int = fn(value)
    console.println("unused")
    return value
  end
  let nested: parallel fn(Int): Int = fn(value)
    return pure(value)
  end
  node.value = 5
  test.assertEqual(nested(2), 14)
  let shared: shared fn(Int): Int = nested
  let ordinary: fn(Int): Int = shared
  test.assertEqual(ordinary(3), 15)
  test.assertEqual(apply(4, identity), 4)
  let parallel = apply(5) do |value|
    return value + node.value
  end
  test.assertEqual(parallel, 10)
  let make: parallel fn(): Node = fn()
    return new Node()
  end
  test.assertEqual(make().value, 3)
end
