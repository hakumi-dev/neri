class Invalid
  @operator("&&")
  public def logical(other: Invalid): Bool
    return true
  end

  @operator("+")
  private def hidden(other: Invalid): Invalid
    return this
  end

  @conversion
  public def consume(value: Int): Int
    return value
  end
end

class Guarded
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  static def forgeDerived(): ImplicitBypass
    return new ImplicitBypass()
  end
end

class Bypass : Guarded
  def init(): Void
    super(1)
  end
end

class ImplicitBypass : Guarded
end

class ImplicitConstructorBypass : Guarded
  def init(): Void
  end
end

class ConversionTrap
  @conversion
  public def integer(): Int
    return 1
  end

  @conversion
  public def identity(): ConversionTrap
    return this
  end
end

class MiddleBypass : Guarded
end

class LeafBypass : MiddleBypass
end

class LeafExplicitBypass : MiddleBypass
  def init(): Void
    super()
  end
end

class PublicBase
  def init(): Void
  end
end

class MisplacedBaseCall : PublicBase
  def init(): Void
    let before = 1

    super()
  end

  def ordinary(): Void
    if true
      super()
    end
  end
end

class RepeatedBaseCall : PublicBase
  def init(): Void
    super()
    super()
  end
end

def main(): Void
  let explicit = new Bypass()
  let implicit = new ImplicitBypass()
  let implicitConstructor = new ImplicitConstructorBypass()
  let trap = new ConversionTrap()
  let implicitConversion: Int = trap
  let leaf = new LeafBypass()
  let explicitLeaf = new LeafExplicitBypass()
end
