use test

class Box
  public value: Int

  def init(value: Int): Void
    this.value = value
  end
end

def generic<T>(left: T, right: T): Bool
  return reference::same(left, right)
end

class BaseBox
  public value: Int = 5
end

class DerivedBox: BaseBox
  public extra: Int = 9
end

class GrandBox: DerivedBox
end

class SiblingBox: BaseBox
end

class GenericBaseBox<T>
  public value: T?
end

class GenericDerivedBox<T>: GenericBaseBox<T>
end

def genericCast<T>(value: T): DerivedBox?
  return reference::cast<DerivedBox, T>(value)
end

def main(): Void
  let first = new Box(7)
  let same = first
  let distinct = new Box(7)
  let readonlyFirst: readonly Box = first
  let readonlySame: readonly Box = same

  test::assertTrue(reference::same(first, same))
  test::assertFalse(reference::same(first, distinct))
  test::assertTrue(generic(first, same))
  test::assertTrue(reference::same(readonlyFirst, readonlySame))
  let derived = new DerivedBox()
  let base: BaseBox = derived
  let grand: BaseBox = new GrandBox()
  let sibling: BaseBox = new SiblingBox()
  let cast = reference::cast<DerivedBox, BaseBox>(base)

  test::assertTrue(cast != null)
  if cast != null
    cast.extra = 11

    test::assertTrue(reference::same(cast, derived))
    test::assertEqual(derived.extra, 11)
  end

  test::assertTrue(genericCast(base) != null)
  test::assertTrue(reference::cast<DerivedBox, BaseBox>(grand) != null)
  test::assertTrue(reference::cast<GrandBox, BaseBox>(grand) != null)
  test::assertTrue(reference::cast<DerivedBox, BaseBox>(sibling) == null)
  test::assertTrue(reference::cast<Box, BaseBox>(base) == null)
  test::assertTrue(reference::cast<BaseBox, DerivedBox>(derived) != null)
  let genericBase: GenericBaseBox<Int> = new GenericDerivedBox<Int>()

  test::assertTrue(reference::cast<GenericDerivedBox<Int>, GenericBaseBox<Int>>(genericBase) != null)
end
