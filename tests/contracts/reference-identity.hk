use reference
use test

class Box
  public value: Int

  def init(value: Int): Void
    this.value = value
  end
end

def generic<T>(left: T, right: T): Bool
  return reference::same(left, right)
end

def main(): Void
  let first = new Box(7)
  let same = first
  let distinct = new Box(7)
  let readonlyFirst: readonly Box = first
  let readonlySame: readonly Box = same

  test::assertTrue(reference::same(first, same))
  test::assertFalse(reference::same(first, distinct))
  test::assertTrue(generic(first, same))
  test::assertTrue(reference::same(readonlyFirst, readonlySame))
end
