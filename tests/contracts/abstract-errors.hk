@abstract
class AbstractValue
  @abstract
  def value(): Int
  end
end

@abstract("unexpected")
class ArgumentAbstract
end

@abstract
@abstract
class RepeatedAbstract
end

class MissingValue: AbstractValue
end

class WrongSignature: AbstractValue
  @override
  def value(input: Int): Int
    return input
  end
end

class CallsAbstractBase: AbstractValue
  @override
  def value(): Int
    return super.value()
  end
end

@abstract
class AbstractGeneric<T>
  @abstract
  def value(): T
  end
end

@abstract
@sealed
class SealedAbstract
end

@abstract
resource class ResourceAbstract
  public def close(): Void
  end
end

@abstract
@representation("utf8")
public class RepresentedAbstract
end

@abstract
class InvalidAbstractMembers
  @abstract
  private def hidden(): Int
  end

  @abstract
  def static create(): InvalidAbstractMembers
  end

  @abstract
  def init(): Void
  end

  @abstract
  def unsafe dangerous(): Void
  end

  @abstract
  def withBody(): Int
    return 1
  end
end

class ConcreteAbstractMember
  @abstract
  def missingOwner(): Int
  end
end

class InvalidGenericAbstract<T>
  @abstract
  def value(): T
  end
end

def main(): Void
  let direct = new AbstractValue()
  let generic = new AbstractGeneric<Int>()
end
