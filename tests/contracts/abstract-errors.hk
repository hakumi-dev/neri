abstract class AbstractValue
  abstract def value(): Int
end

class MissingValue: AbstractValue
end

class WrongSignature: AbstractValue
  override def value(input: Int): Int
    return input
  end
end

class CallsAbstractBase: AbstractValue
  override def value(): Int
    return super.value()
  end
end

abstract class AbstractGeneric<T>
  abstract def value(): T
end

abstract sealed class SealedAbstract
end

abstract resource class ResourceAbstract
  public def close(): Void
  end
end

@representation("utf8")
public abstract class RepresentedAbstract
end

abstract class InvalidAbstractMembers
  private abstract def hidden(): Int

  abstract static def create(): InvalidAbstractMembers

  abstract def init(): Void

  abstract unsafe def dangerous(): Void
end

class ConcreteAbstractMember
  abstract def missingOwner(): Int
end

class InvalidGenericAbstract<T>
  abstract def value(): T
end

def main(): Void
  let direct = new AbstractValue()
  let generic = new AbstractGeneric<Int>()
end
