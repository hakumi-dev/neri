contract Named
  @readonly
  def label(): String
  end
end

contract Related
  def relate(other: Self): Self
  end
end

class Missing
end

class WrongReturn
  @readonly
  def label(): Int
    return 1
  end
end

class WrongParameter
  def relate(other: String): WrongParameter
    return this
  end
end

class PrivateMethod
  @readonly
  private def label(): String
    return "private"
  end
end

class StaticMethod
  def static label(): String
    return "static"
  end
end

class MutableMethod
  def label(): String
    return "mutable"
  end
end

def invalidBody<T: Named>(value: T): String
  return value.missing()
end

def read<T: Named>(value: T): String
  return value.label()
end

def relate<T: Related>(left: T, right: T): T
  return left.relate(right)
end

def main(): Void
  let missing = read(new Missing())
  let wrongReturn = read(new WrongReturn())
  let wrongParameter = relate(new WrongParameter(), new WrongParameter())
  let privateMethod = read(new PrivateMethod())
  let staticMethod = read(new StaticMethod())
  let mutableMethod = read(new MutableMethod())
end
