use fields
use quotation
use test

class Customer
  public active: Bool = true
  public id: Int = 0
  public nickname: String?
end

class Trace
  public order: String = ""

  def flag(): Bool
    this.order = this.order + "1"
    return false
  end

  def number(value: Int): Int
    this.order = this.order + (value as String)
    return value
  end

  def text(value: String?): String?
    this.order = this.order + "4"
    return value
  end
end

class Collector<T>
  def collect(labels values: fields of T): fields of T
    return values
  end
end

def collect<T>(target: T, tag: Int = 0, labels values: fields of T): fields of T
  return values
end

def main(): Void
  let trace = new Trace()
  let captured = collect(target: new Customer(), active: trace.flag(), tag: trace.number(2), id: trace.number(3), nickname: trace.text(null))
  let pack = captured.pack()
  let active = pack.entryAt(0)
  let id = pack.entryAt(1)
  let nickname = pack.entryAt(2)

  test::assertEqual(trace.order, "1234")
  test::assertEqual(pack.entityType(), "Customer")
  test::assertEqual(pack.count(), 3)
  test::assertTrue(active != null && id != null && nickname != null)
  if active != null && id != null && nickname != null
    test::assertEqual(active.identity(), "Customer.active")
    test::assertEqual(id.identity(), "Customer.id")
    test::assertEqual(nickname.identity(), "Customer.nickname")
    test::assertEqual(nickname.typeName(), "String?")
    match active.value()
      case CaptureValue.Bool(value)
        test::assertTrue(!value)
      case CaptureValue.Int(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
      case CaptureValue.Null()
        test::assertTrue(false)
    end
    match nickname.value()
      case CaptureValue.Null()
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Int(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
    end
  end
  let collector = new Collector<Customer>()
  let omitted = collector.collect()
  let defaulted = collect(new Customer(), id: 7)
  let present = collector.collect(nickname: trace.text("Ada"))
  let text = present.pack().entryAt(0)

  test::assertEqual(omitted.pack().count(), 0)
  test::assertEqual(defaulted.pack().count(), 1)
  test::assertTrue(pack.entryAt(-1) == null && pack.entryAt(3) == null)
  test::assertTrue(text != null)
  if text != null
    match text.value()
      case CaptureValue.Text(value)
        test::assertEqual(value, "Ada")
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Int(value)
        test::assertTrue(false)
      case CaptureValue.Null()
        test::assertTrue(false)
    end
  end
end
