use test
use named_values

def main(): Void
  let first = new Name("first")
  let second = new Name("second")

  test::assertEqual(read(first), "first")
  test::assertEqual(follow(first, second).label(), "second")
  test::assertTrue(same(first, new Name("first")))
  test::assertTrue(namedSame(first, new Name("first")))
end

namespace named_values

contract Named
  readonly def label(): String
  end
end

contract Linked
  readonly def connect(other: Self): Self
  end
end

contract Comparable
  @operator("==")
  readonly def equals(other: Self): Bool
  end
end

contract NamedEquality
  def equals(other: Self): Bool
  end
end

class Name
  private value: String

  def init(value: String): Void
    this.value = value
  end

  readonly def label(): String
    return this.value
  end

  readonly def connect(other: Name): Name
    return other
  end

  @operator("==")
  readonly def equals(other: Name): Bool
    return this.value == other.value
  end
end

def read<T: Named>(value: T): String
  return value.label()
end

def follow<T: Linked>(left: T, right: T): T
  return left.connect(right)
end

def same<T: Comparable>(left: T, right: T): Bool
  test::assertEqual(left, right)
  return true
end

def namedSame<T: NamedEquality>(left: T, right: T): Bool
  return left.equals(right)
end
