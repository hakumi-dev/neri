use test

class Amount
  private value: Int

  def init(value: Int): Void
    this.value = value
  end

  @operator("==")
  readonly def equals(other: Amount): Bool
    return this.value == other.value
  end
end

class AmountSource
  public calls: Int = 0

  def next(): Amount
    this.calls = this.calls + 1
    return new Amount(42)
  end
end

def same<T: Equality>(left: T, right: T): Bool
  return left == right
end

def different<T: Equality>(left: T, right: T): Bool
  return left != right
end

def forward<T: Equality>(value: T): T
  return value
end

def nested<T: Equality>(value: T): Bool
  return same(value, forward(value))
end

def mixedIntEqual(required: Int, optional: Int?): Bool
  return required == optional && optional == required
end

def mixedIntDifferent(required: Int, optional: Int?): Bool
  return required != optional && optional != required
end

def mixedFloatEqual(required: Float, optional: Float?): Bool
  return required == optional && optional == required
end

def mixedFloatDifferent(required: Float, optional: Float?): Bool
  return required != optional && optional != required
end

def mixedBoolEqual(required: Bool, optional: Bool?): Bool
  return required == optional && optional == required
end

def mixedBoolDifferent(required: Bool, optional: Bool?): Bool
  return required != optional && optional != required
end

def mixedStringEqual(required: String, optional: String?): Bool
  return required == optional && optional == required
end

def mixedStringDifferent(required: String, optional: String?): Bool
  return required != optional && optional != required
end

def main(): Void
  let source = new AmountSource()
  let optionalLeft: Int? = 7
  let optionalRight: Int? = 7
  let compare: fn(Int, Int): Bool = same

  test::assertTrue(nested(7))
  test::assertTrue(same("Neri", "Neri"))
  test::assertTrue(same<Int>(7, 7))
  test::assertTrue(compare(9, 9))
  test::assertTrue(same(optionalLeft, optionalRight))
  test::assertTrue(same(source.next(), source.next()))
  test::assertFalse(different(source.next(), source.next()))

  let intPresent: Int? = 7
  let intOther: Int? = 8
  let intMissing: Int? = null

  test::assertTrue(mixedIntEqual(7, intPresent))
  test::assertFalse(mixedIntEqual(7, intOther))
  test::assertFalse(mixedIntEqual(7, intMissing))
  test::assertTrue(mixedIntDifferent(7, intOther))
  test::assertTrue(mixedIntDifferent(7, intMissing))

  let floatPresent: Float? = 1.5
  let floatOther: Float? = 2.5
  let floatMissing: Float? = null

  test::assertTrue(mixedFloatEqual(1.5, floatPresent))
  test::assertFalse(mixedFloatEqual(1.5, floatOther))
  test::assertFalse(mixedFloatEqual(1.5, floatMissing))
  test::assertTrue(mixedFloatDifferent(1.5, floatOther))
  test::assertTrue(mixedFloatDifferent(1.5, floatMissing))

  let boolPresent: Bool? = true
  let boolOther: Bool? = false
  let boolMissing: Bool? = null

  test::assertTrue(mixedBoolEqual(true, boolPresent))
  test::assertFalse(mixedBoolEqual(true, boolOther))
  test::assertFalse(mixedBoolEqual(true, boolMissing))
  test::assertTrue(mixedBoolDifferent(true, boolOther))
  test::assertTrue(mixedBoolDifferent(true, boolMissing))

  let dynamicText = "N" + "e" + (1 as String)
  let equalDynamicText = "Ne" + (1 as String)
  let textPresent: String? = equalDynamicText
  let textOther: String? = "Neri!"
  let textMissing: String? = null

  test::assertTrue(mixedStringEqual(dynamicText, textPresent))
  test::assertFalse(mixedStringEqual(dynamicText, textOther))
  test::assertFalse(mixedStringEqual(dynamicText, textMissing))
  test::assertTrue(mixedStringDifferent(dynamicText, textOther))
  test::assertTrue(mixedStringDifferent(dynamicText, textMissing))

  test::assertEqual(source.calls, 4)
end
