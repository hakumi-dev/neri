class Node
  public value: Int = 0
  public child: Node?

  public def badReader(): shared fn(): Void
    return fn()
      this.value = 1
    end
  end
end

def mutate(value: Node): Void
  value.value = 2
end

def main(): Void
  let node = new Node()
  let values = [node]
  let ordinary: fn(): Void = fn()
    node.value = 3
  end
  let shared: shared fn(): Void = fn()
    node.value = 4
    values[0].value = 5
    let child = node.child
    if child != null
      child.value = 6
    end
    mutate(node)
    ordinary()
    let nested: fn(): Void = fn()
      node.value = 7
    end
  end
  let upgrade: shared fn(): Void = ordinary
  let cast = ordinary as (shared fn(): Void)
  let parallel: parallel fn(): Void = fn()
    node.value = 8
  end
  let parallelUpgrade: parallel fn(): Void = shared
  let parallelCast = shared as (parallel fn(): Void)
end
