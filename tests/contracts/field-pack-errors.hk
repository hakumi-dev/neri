use fields

class Date
end

class Customer
  public active: Bool = false
  public nickname: String?
  public joined: Date = new Date()
  private secret: Int = 0
end

class Order
  public active: Bool = false
end

def customers(labels filters: fields of Customer): fields of Customer
  return filters
end

def orders(labels filters: fields of Order): fields of Order
  return filters
end

def acceptCustomer(filters: fields of Customer): Void
end

def badPosition(labels filters: fields of Customer, tail: Int): Void
end

def badDefault(labels filters: fields of Customer = null): Void
end

class BadConstructor
  def init(labels filters: fields of Customer): Void
  end
end

def main(): Void
  let unknown = customers(missing: true)
  let hidden = customers(secret: 1)
  let wrong = customers(active: "yes", nickname: 4)
  let missing = customers(active: null)
  let duplicate = customers(active: true, active: false)
  let unsupported = customers(joined: new Date())
  let supportedOtherField = customers(active: true)
  let invariant: fields of Customer = orders(active: true)

  acceptCustomer(orders(active: true))
  let forged = new fields of Customer()
  let positional = customers(null)
end
