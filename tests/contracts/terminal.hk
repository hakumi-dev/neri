use terminal
use clock
use console
use test

def expectKey(session: terminal.Session, expected: String): Void
  let key = session.readKey(3000)
  if key != null
    test.assertEqual(key, expected)
  else
    test.assertTrue(false)
  end
end

def main(): Void
  let session = terminal.open()
  if session == null
    test.assertTrue(false)
    return
  end
  test.assertTrue(terminal.open() == null)
  test.assertTrue(session.columns() == 80 && session.rows() == 30)
  console.println("READY")
  expectKey(session, "up")
  expectKey(session, "w")
  let before = clock.milliseconds()
  test.assertTrue(session.readKey(20) == null)
  let after = clock.milliseconds()
  if before != null && after != null
    test.assertTrue(after >= before + 15)
  else
    test.assertTrue(false)
  end
  console.println("INTERRUPT")
  expectKey(session, "closed")
  test.assertTrue(!session.isOpen())
  let again = terminal.open()
  if again == null
    test.assertTrue(false)
    return
  end
  session.close()
  test.assertTrue(again.columns() == 80)
  again.close()
  expectKey(again, "closed")
  console.println("DONE")
  test.assertEqual(console.read(), "finish")
end
