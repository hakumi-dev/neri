use test

class IntStored: StoredChild<Int>
  public sibling: StoredChild<String>?

  def init(input: Int = 41): Void
    super(input)
  end

  override def transform(input: Int): Int
    return input + 1
  end
end

class StoredChild<Input>: Stored<Input>
  def init(input: Input): Void
    super(input)
  end

  override def transform(input: Input): Input
    return input
  end

  override readonly def label(): String
    return super.label() + " child"
  end
end

abstract class Stored<Input>: Root
  public value: Input

  def init(input: Input): Void
    this.value = input
  end

  abstract def transform(input: Input): Input

  def apply(): Input
    return this.transform(this.value)
  end

  static def identity<Value>(input: Value): Value
    return input
  end
end

class Root
  public marker: Int = 7

  readonly def label(): String
    return "root"
  end
end

class Factory<Product, Input>
  static def create(input: Input): Product
    return new Product(input)
  end
end

class Message: Factory<Message, String>
  public text: String

  def init(text: String): Void
    this.text = text
  end
end

def main(): Void
  let stored: Stored<Int> = new IntStored()
  let text: Stored<String> = new StoredChild<String>("typed")
  let message = Message.create("created")

  test::assertEqual(stored.apply(), 42)
  test::assertEqual(stored.value, 41)
  test::assertEqual(stored.marker, 7)
  test::assertEqual(stored.label(), "root child")
  test::assertEqual(text.apply(), "typed")
  test::assertEqual(IntStored.identity<String>("inherited"), "inherited")
  test::assertEqual(message.text, "created")
end
