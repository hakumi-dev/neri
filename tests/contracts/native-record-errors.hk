struct ManagedField
  name: String
end

union Empty
end

struct Recursive
  value: Recursive
end

struct InvalidArray
  bytes: Byte[0]
end

class SharedName<T>
end

struct SharedName
  value: Int
end

struct Plain
  value: Int
end

def main(): Void
  let missing = native.offsetOf<Recursive>("missing")
  unsafe
    let pointer = native.allocZeroed<Plain>(1)
    let immutable = *pointer
    immutable.value = 1
    pointer.value = true
    native.free(pointer)
  end
end
