namespace method_library

class MethodPair<A, B>
  public first: A
  public second: B

  def init(first: A, second: B): Void
    this.first = first
    this.second = second
  end
end

class MethodBox<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end

  public def identity<U>(value: U): U
    return value
  end

  public def combine<U>(other: U): MethodPair<T, U>
    return new MethodPair<T, U>(this.value, other)
  end

  public readonly def readonlyIdentity<U>(value: U): U
    return value
  end

  private def hidden<U>(value: U): U
    return value
  end

  public def throughHidden<U>(value: U): U
    return this.hidden(value)
  end
end

class PlainMethodReceiver
  public def identity<U>(value: U): U
    return value
  end
end

class DerivedMethodReceiver: PlainMethodReceiver
end

class MethodFactory
  public static def identity<U>(value: U): U
    return value
  end
end

class MethodSelector<T>
  public def select<U>(selector: quote fn(T): U): quote fn(T): U
    return selector
  end
end
