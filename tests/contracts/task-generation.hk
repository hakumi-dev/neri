use tasks
use test

class Node
  public value: Int = 0
  public next: Node?
end

def square(index: Int): Int
  return index * index
end

def map<T, R>(input: readonly T[], callback: parallel fn(readonly T): R): R[]
  return tasks.generate(input.Length) do |index|
    return callback(input[index])
  end
end

def main(): Void
  let input = [2, 3, 5]
  let values: Int[] = map(input, square)
  test.assertEqual(values[2], 25)
  for workers in [1, 2, 0]
    let nodes: Node[] = tasks.generate(37, workers) do |index|
      let children: Node[] = tasks.generate(3, 2) do |child|
        let node = new Node()
        node.value = index * 3 + child
        node.next = node
        return node
      end
      return children[2]
    end
    var index = 0
    while index < 37
      test.assertEqual(nodes[index].value, index * 3 + 2)
      let next = nodes[index].next
      test.assertTrue(next != null)
      if next != null
        next.value = -index
        test.assertEqual(nodes[index].value, -index)
      end
      index = index + 1
    end
    nodes[0].value = 100
    test.assertEqual(nodes[0].value, 100)
  end
  let strings = tasks.generate<String>(3) do |index|
    return "item-" + (index as String)
  end
  test.assertEqual(strings[2], "item-2")
  let optional: Node?[] = tasks.generate(2) do |index|
    return null if index == 0
    return new Node()
  end
  test.assertTrue(optional[0] == null)
  test.assertTrue(optional[1] != null)
  let flags: Bool[] = tasks.generate(3) do |index|
    return index == 2
  end
  test.assertTrue(flags[2])
  let empty = tasks.generate(0, square)
  test.assertEqual(empty.Length, 0)
end
