use test

def main(): Void
  unsafe
    native_pointer_owner::verify()
  end
end

namespace native_pointer_owner

struct Cell
  value: Int
end

unsafe def identity(value: Cell*): Cell*
  let local: Cell* = value

  return local
end

unsafe def verify(): Void
  let cell = stackalloc Cell[1]

  cell.value = 37

  test::assertEqual(identity(cell).value, 37)
end

namespace native_pointer_other

class Cell
end
