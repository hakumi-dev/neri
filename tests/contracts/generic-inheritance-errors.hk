abstract class Required<T>
  abstract def value(): T
end

class Missing<T>: Required<T>
end

class Wrong<T>: Required<T>
  override def value(): String
    return "wrong"
  end
end

class Storage<T>
  public item: T?
end

class Duplicate<T>: Storage<T>
  public item: T?
end

class SelfCycle<T>: SelfCycle<T>
end

class First<T>: Second<T>
end

class Second<T>: First<T>
end

sealed class Closed<T>
end

class SealedChild<T>: Closed<T>
end

class WrongArity: Storage<Int, String>
end

class IntStorage: Storage<Int>
end

def main(): Void
  let missing = new Missing<Int>()
  let wrong = new Wrong<Int>()
  let duplicate = new Duplicate<Int>()
  let selfCycle = new SelfCycle<Int>()
  let cycle = new First<Int>()
  let sealedChild = new SealedChild<Int>()
  let invariant: Storage<String> = new IntStorage()
end
