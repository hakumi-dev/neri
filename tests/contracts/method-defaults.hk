use test

class BaseDefault
  def value(enabled: Bool = true): Int
    return enabled ? 10 : 0
  end
end

class DerivedDefault: BaseDefault
  override def value(enabled: Bool = false): Int
    return enabled ? 42 : 1
  end

  def baseValue(): Int
    return super.value()
  end
end

def viaBase(value: BaseDefault): Int
  return value.value()
end

class UnsafeBaseDefault
  unsafe def value(enabled: Bool = true): Int
    return enabled ? 10 : 0
  end
end

class UnsafeDerivedDefault: UnsafeBaseDefault
  override unsafe def value(enabled: Bool = false): Int
    return enabled ? 42 : 1
  end
end

unsafe def unsafeModuleDefault(value: Int = 7): Int
  return value * 3
end

def main(): Void
  let value = new DerivedDefault()

  test::assertEqual(viaBase(value), 42)
  test::assertEqual(value.value(), 1)
  test::assertEqual(value.value(true), 42)
  test::assertEqual(value.baseValue(), 10)

  let unsafeValue: UnsafeBaseDefault = new UnsafeDerivedDefault()

  unsafe
    test::assertEqual(unsafeValue.value(), 42)
    test::assertEqual(unsafeValue.value(false), 1)
    test::assertEqual(unsafeModuleDefault(), 21)
    test::assertEqual(unsafeModuleDefault(5), 15)
  end
end
