@cabiExport("bad_managed")
unsafe def managed(value: String): String
  return value
end

@cabiExport("bad_safe")
def safeExport(value: Int32): Int32
  return value
end

@cabiExport("valid_callback")
unsafe def callback(value: Int32): Int32
  return value
end

unsafe def incompatible(): Void
  let mismatch: cabi fn(Float32): Int32 = callback
  let closure: cabi fn(Int32): Int32 = fn(value: Int32)
    return value
  end
end

unsafe def invalidArrays(operation: cabi fn(Int32): Int32): Void
  let inferred = [operation]
  let annotated: (cabi fn(Int32): Int32)[] = []
end

def unsafeCall(operation: cabi fn(Int32): Int32): Int32
  return operation(1 as Int32)
end

def invalidInteger(): UInt64
  return 9223372036854775808 as UInt64
end

@cabiImport("neri_rt_v1_foreign_enter")
unsafe def forbiddenEnter(): Void
end

@cabiImport("neri_rt_v1_foreign_leave")
unsafe def forbiddenLeave(): Void
end

def main(): Void
end
