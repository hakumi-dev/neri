use test
use text
use tasks

def scalarValue(value: String, index: Int): Int
  let item = scalarAt(value, index)

  if item == null
    return -1
  end
  return item
end

def main(): Void
  for code in [0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111]
    let scalar = Scalar.fromInt(code)

    test.assertTrue(scalar != null)
    if scalar != null
      let encoded = scalar.toString()

      test.assertTrue(encoded != null)
      if encoded != null
        test.assertEqual(scalarValue(encoded, 0), code)
        test.assertEqual(scalarCount(encoded), 1)
      end
    end
  end
  let value = "Aé😀"

  test.assertEqual(byteLength(value), 7)
  test.assertTrue(isScalarBoundary(value, 0))
  test.assertTrue(isScalarBoundary(value, 1))
  test.assertTrue(isScalarBoundary(value, 3))
  test.assertTrue(isScalarBoundary(value, 7))
  test.assertTrue(!isScalarBoundary(value, 2))
  test.assertTrue(!isScalarBoundary(value, 4))
  test.assertTrue(!isScalarBoundary(value, 5))
  test.assertTrue(!isScalarBoundary(value, 6))
  let first = byteAt(value, 0)

  test.assertTrue(first != null)
  if first != null
    test.assertEqual(first, 65 as Byte)
  end

  test.assertTrue(byteAt(value, -1) == null)
  test.assertTrue(byteAt(value, 7) == null)
  let accented = sliceBytes(value, 1, 2)

  test.assertTrue(accented != null)
  if accented != null
    test.assertEqual(accented, "é")
  end

  test.assertTrue(sliceBytes(value, 2, 1) == null)
  test.assertTrue(sliceBytes(value, 7, 1) == null)
  let empty = sliceBytes(value, 7, 0)

  test.assertTrue(empty != null)
  if empty != null
    test.assertEqual(empty, "")
  end
  let combining = "é"

  test.assertEqual(scalarCount(value), 3)
  test.assertEqual(scalarCount(combining), 2)
  test.assertEqual(scalarValue(value, 0), 65)
  test.assertEqual(scalarValue(value, 1), 233)
  test.assertEqual(scalarValue(value, 2), 128512)
  test.assertEqual(scalarValue(combining, 0), 101)
  test.assertEqual(scalarValue(combining, 1), 769)
  test.assertTrue(scalarAt(value, 3) == null)
  let scalar = Scalar.fromInt(128512)

  test.assertTrue(scalar != null)
  if scalar != null
    let scalarCode = scalar as Int

    test.assertEqual(scalarCode, 128512)
    test.assertEqual(scalar.value(), 128512)
    test.assertTrue(scalar == scalar)
    let scalarBytes = scalar.utf8()

    test.assertEqual(scalarBytes.Length, 4)
    test.assertEqual(scalarBytes[0], 240 as Byte)
    test.assertEqual(scalarBytes[1], 159 as Byte)
    test.assertEqual(scalarBytes[2], 152 as Byte)
    test.assertEqual(scalarBytes[3], 128 as Byte)
    let scalarText = scalar.toString()

    test.assertTrue(scalarText != null)
    if scalarText != null
      test.assertEqual(scalarText, "😀")
    end
  end

  test.assertTrue(Scalar.fromInt(-1) == null)
  test.assertTrue(Scalar.fromInt(1114112) == null)
  test.assertTrue(Scalar.fromInt(55296) == null)
  test.assertTrue(Scalar.fromInt(57343) == null)
  let original = "é"
  let copied = bytes(original)

  test.assertEqual(copied.Length, 2)
  copied[0] = 0 as Byte

  test.assertEqual(original, "é")
  test.assertTrue(fromBytes(copied) == null)
  let target: Byte[] = tasks.generate(5, 1) do |index|
    return 0 as Byte
  end

  test.assertTrue(copyBytes("é", target, 1))
  test.assertEqual(target[1], 195 as Byte)
  test.assertEqual(target[2], 169 as Byte)
  test.assertTrue(!copyBytes("é", target, 4))
  test.assertTrue(!copyBytes("é", target, -1))
  test.assertTrue(equal("é", "é"))
  test.assertTrue(!equal("é", "e"))
  test.assertEqual(concat("Ne", "ri"), "Neri")
  let valid = fromBytes([240 as Byte, 159 as Byte, 152 as Byte, 128 as Byte])

  test.assertTrue(valid != null)
  if valid != null
    test.assertEqual(valid, "😀")
  end

  test.assertTrue(fromBytes([195 as Byte]) == null)
end
