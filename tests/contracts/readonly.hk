use test

class Node
  public value: Int = 7
  public child: Node?

  @readonly
  public def read(): Int
    return this.value
  end
end

class Derived : Node
  @override
  @readonly
  public def read(): Int
    return super.read() + 1
  end
end

def view<T>(value: readonly T): readonly T
  return value
end

def sum(values: readonly Node[]): Int
  var result = 0
  for value in values
    result = result + value.read()
  end
  return result
end

def main(): Void
  let node = new Node()
  node.child = new Node()
  let shared: readonly Node = node
  let nested = shared.child
  if nested != null
    test.assertEqual(nested.read(), 7)
  end
  let values: readonly Node[] = [node]
  test.assertEqual(sum(values), 7)
  let generic = view(node)
  node.value = 9
  # A view observes the same object; it neither copies nor freezes other aliases.
  test.assertEqual(generic.read(), 9)
  let references: (readonly Node)[] = [shared]
  references[0] = new Node()
  test.assertEqual(references[0].read(), 7)
  test.assertEqual(view(references).Length, 1)
  let empty: readonly Int[] = []
  test.assertEqual(empty.Length, 0)
  let derived: readonly Node = new Derived()
  test.assertEqual(derived.read(), 8)
end
