use test
use host

def length(value: String?): Int
  return host.stringByteLength(value) if value != null
  return 0
end

def main(): Void
  var total = 0
  let value: Int? = 3
  total = total + value if value != null
  for index in [1, 2, 3, 4]
    continue if index == 2
    break if index == 4
    total = total + index
  end
  test.assertEqual(total, 7)
  test.assertEqual(length("abc"), 3)
  test.assertEqual(length(null), 0)
  test.assertFalse(true) if false
  return if total == 7
  test.assertFalse(true)
end
