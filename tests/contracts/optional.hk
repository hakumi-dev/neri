use test

def choose(present: Bool): Int?
  if present
    return 42
  end
  return null
end

def main(): Void
  var value: Int? = choose(true)
  if value != null
    test.assertEqual(value + 1, 43)
  end
  value = choose(false)
  test.assertTrue(value == null)
  test.assertFalse(false && (1 / 0 == 0))
  test.assertTrue(true || (1 / 0 == 0))
end
