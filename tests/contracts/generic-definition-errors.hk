use files
use reference

def unusedGenericDefinition<T>(value: T): Int
  return "wrong"
end

def emptyGenericDefinition<T>(): Int
end

class UnusedGenericDefinition<T>
  public def bad(): Int
    return "wrong"
  end
end

class UnusedGenericMethods
  public def bad<T>(value: T): Int
    return "wrong"
  end
end

def opaqueReference<T>(left: T, right: T): Bool
  return reference::same<T>(left, right)
end

def opaqueProjection<T>(value: T): element of T
  return value
end

class GenericDefinitionEntity
end

class NeedsClass<T: class>
end

def main(): Void
  let scalar = new NeedsClass<Int>()
  let optional = new NeedsClass<GenericDefinitionEntity?>()
  let readonlyView = new NeedsClass<readonly GenericDefinitionEntity>()
  let resourceValue = new NeedsClass<files::ScopedRoot>()
end
