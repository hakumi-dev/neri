use test

def byteValue(value: String, offset: Int): Int
  let item = value.byteAt(offset)

  if item == null
    return -1
  end
  return item as Int
end

def scalarValue(value: String, index: Int): Int
  let item = value.scalarAt(index)

  if item == null
    return -1
  end
  return item
end

def main(): Void
  let value = "Aé😀"

  test::assertEqual(value.byteLength(), 7)
  test::assertEqual(byteValue(value, 0), 65)
  test::assertEqual(byteValue(value, 1), 195)
  test::assertEqual(byteValue(value, 7), -1)
  let accented = value.sliceBytes(1, 2)

  test::assertTrue(accented != null)
  if accented != null
    test::assertEqual(accented, "é")
  end

  test::assertTrue(value.sliceBytes(2, 1) == null)
  test::assertEqual(value.scalarCount(), 3)
  test::assertEqual(scalarValue(value, 0), 65)
  test::assertEqual(scalarValue(value, 1), 233)
  test::assertEqual(scalarValue(value, 2), 128512)
  test::assertEqual(scalarValue(value, 3), -1)
  let decoded = String.fromBytes([240 as Byte, 159 as Byte, 152 as Byte, 128 as Byte])

  test::assertTrue(decoded != null)
  if decoded != null
    test::assertEqual(decoded, "😀")
  end

  test::assertTrue(String.fromBytes([195 as Byte]) == null)
  test::assertEqual(value.concat("!"), "Aé😀!")
  test::assertTrue(value.equals("Aé😀"))
  test::assertTrue(value.notEquals("Aé"))
  test::assertEqual("Ne" + "ri", "Neri")
  test::assertTrue("Neri" == "Neri")
  test::assertTrue("Neri" != "Nera")
  let length: fn(): Int = fn()
    return value.byteLength()
  end

  test::assertEqual(length(), 7)
end
