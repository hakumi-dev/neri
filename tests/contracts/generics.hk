use test
use console
use generic_contracts

@cabi("neri_rt_v1_gc_collect")
def unsafe collect(): Void
end

def retained(): Box<fn(Int): String>
  let saved = new Box<String>("Ne" + "ri")
  return new Box<fn(Int): String>() do |value|
    return identity(saved.get()) + (value as String)
  end
end

def main(): Void
  let number = new Box<Int>(identity(42))
  let word = new Box<String>("Neri")
  test.assertEqual(unwrap(number), 42)
  test.assertEqual(word.get(), "Neri")
  let nested = new Box<Box<String>?>(word)
  let value = nested.get()
  if value != null
    test.assertEqual(value.get(), "Neri")
  else
    test.assertTrue(false)
  end
  let missing: String? = absent()
  test.assertTrue(missing == null)
  let convert: fn(Int): Int = identity
  test.assertEqual(convert(7), 7)
  let rendered: String = transform(42) do |value|
    return value as String
  end
  test.assertEqual(rendered, "42")
  let annotated = transform(7) do |value|: String
    return value as String
  end
  test.assertEqual(annotated, "7")
  test.assertEqual(identity<
    String
  >("explicit"), "explicit")
  let handler = retained()
  unsafe
    collect()
  end
  test.assertEqual(handler.value(9), "Neri9")
  test.assertEqual(generic_contracts.repeat("recursive", 3), "recursive")
  test.assertEqual(first([2, 3]), 2)
  console.println("Generic contracts passed")
end
