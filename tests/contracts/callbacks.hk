use test

@cabi("neri_rt_v1_gc_collect")
def unsafe collect(): Void
end

def twice(value: Int): Int
  return value * 2
end

def apply(value: Int, operation: fn(Int): Int): Int
  return operation(value)
end

class Holder
  private offset: Int = 0

  def init(offset: Int): Void
    this.offset = offset
  end

  def add(value: Int): Int
    return this.offset + value
  end

  def callback(): fn(Int): Int
    return fn(value)
      return this.offset + value
    end
  end
end

class Handler
  public action: fn(Int): Int

  def init(action: fn(Int): Int): Void
    this.action = action
  end
end

class DefaultHandler
  private offset: Int = 40
  public action: fn(Int): Int = fn(value)
    return this.offset + value
  end
end

def makeAdder(offset: Int): fn(Int): Int
  let holder = new Holder(offset)
  return fn(value)
    return holder.add(value)
  end
end

def wrap(next: fn(Int): Int): fn(Int): Int
  return fn(value)
    return next(value) + 1
  end
end

def nested(offset: Int): fn(Int): fn(Int): Int
  return fn(first)
    return fn(second)
      return offset + first + second
    end
  end
end

def optionalCapture(value: Int?): fn(): Int
  return fn()
    if value != null return value end
    return 0
  end
end

def nothing(): Void
end

def main(): Void
  test.assertEqual(apply(21, twice), 42)
  test.assertEqual(apply(40, fn(value)
    return value + 2
  end), 42)
  let add = makeAdder(40)
  let handler = new Handler(wrap(add))
  let defaultHandler = new DefaultHandler()
  let fromThis = new Holder(40).callback()
  let nestedAdd = nested(30)(10)
  let optional = optionalCapture(42)
  let operations: (fn(Int): Int)[] = [add, twice]
  let maybe: (fn(Int): Int)? = fn(value)
    return value + 1
  end
  let noResult = nothing
  let explicit = fn(value: Int): Int
    return value + 2
  end
  unsafe
    collect()
  end
  test.assertEqual(add(2), 42)
  test.assertEqual(handler.action(1), 42)
  test.assertEqual(defaultHandler.action(2), 42)
  test.assertEqual(fromThis(2), 42)
  test.assertEqual(nestedAdd(2), 42)
  test.assertEqual(explicit(40), 42)
  test.assertEqual(optional(), 42)
  test.assertEqual(operations[1](21), 42)
  if maybe != null test.assertEqual(maybe(41), 42) end
  handler.action = fn(value)
    return value + 10
  end
  test.assertEqual(handler.action(32), 42)
  noResult()
end
