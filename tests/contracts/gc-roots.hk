use test

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

class Node
  public value: Int = 42
  public child: Node?
end

def makeOwner(): Node
  let owner = new Node()

  owner.child = new Node()
  return owner
end

# No local allocation: a foreign collection must still see the detached value.
def detachAndCollect(owner: Node): Int
  let saved = owner.child

  owner.child = null
  unsafe
    collect()
  end
  if saved != null
    return saved.value
  end
  return -1
end

def discardNode(): Void
  let discarded = new Node()
end

def mixedChain(): Node?
  discardNode()
  var head: Node? = null
  var index = 0

  while index < 1024
    let node = new Node()

    node.value = index
    node.child = head
    head = node
    discardNode()
    discardNode()
    index = index + 1
  end
  return head
end

def discardChain(): Void
  let discarded = mixedChain()
end

def survivingSum(head: Node?): Int
  unsafe
    collect()
  end
  var node = head
  var sum = 0

  while node != null
    sum = sum + node.value
    node = node.child
  end
  return sum
end

def consumeChain(selectChain: Bool): Int
  var node: Node? = null

  if selectChain
    node = mixedChain()
  else
    node = new Node()
  end
  var sum = 0

  while node != null
    unsafe
      collect()
    end
    sum = sum + node.value
    node = node.child
  end
  return sum
end

def main(): Void
  test::assertEqual(consumeChain(true), 523776)
  test::assertEqual(consumeChain(false), 42)

  let owner = makeOwner()

  test::assertEqual(detachAndCollect(owner), 42)

  let head = mixedChain()

  test::assertEqual(survivingSum(head), 523776)

  var round = 0

  while round < 4
    discardChain()
    unsafe
      collect()
    end
    round = round + 1
  end

  test::assertEqual(survivingSum(head), 523776)
end
