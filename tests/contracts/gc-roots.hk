use test

@cabi("neri_rt_v1_gc_collect")
def unsafe collect(): Void
end

class Node
  public value: Int = 42
  public child: Node?
end

def makeOwner(): Node
  let owner = new Node()
  owner.child = new Node()
  return owner
end

# No local allocation: a foreign collection must still see the detached value.
def detachAndCollect(owner: Node): Int
  let saved = owner.child
  owner.child = null
  unsafe
    collect()
  end
  if saved != null
    return saved.value
  end
  return -1
end

def main(): Void
  let owner = makeOwner()
  test.assertEqual(detachAndCollect(owner), 42)
end
