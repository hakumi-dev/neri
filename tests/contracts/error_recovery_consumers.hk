use arrays
use fields
use tasks

class Uncomparable
end

class Requires<T: Equality>
end

class Initialized
  public dependent: Int = missingFieldInitializer
  public genuine: Int = false
end

class PackedFields
  public rejected: Requires<Uncomparable>
  public count: Int = 0
end

def identity<T>(value: T): T
  return value
end

def addOne(value: Int): Int
  return value + 1
end

def rejected(): Int
  let value = new Requires<Uncomparable>(missingArgument)
  let typed: Int = value
  var writable = 0

  writable = value
  let fixed = 1

  fixed = value
  let genericArgument = identity<Int>(value)
  let ordinaryArgument = addOne(value)

  return value
end

def genuine(): Int
  let typed: Int = false
  var writable = 0

  writable = false
  let genericArgument = identity<Int>("wrong")
  let ordinaryArgument = addOne(false)
  let instance = new Int()

  return false
end

def collectFields(labels values: fields of PackedFields): Void
end

def collectRejectedFields(labels values: fields of Requires<Uncomparable>): Void
end

unsafe def rejectedSpecializedConsumers(deferred: Requires<Uncomparable>): Void
  let rejected = new Requires<Uncomparable>()
  let field = deferred.unknownField

  deferred.unknownMethod(label: missingMemberArgument, label: 0, missingPositionalArgument)
  let staticCall = Requires<Uncomparable>.unknownMethod(missingStaticArgument)

  deferred() do |index|
    return missingCallableArgument
  end
  let literal = [rejected, 1, false]
  let callback: fn(Bool): Requires<Uncomparable> = fn(index) do
    return missingArrayCallback
  end
  let array: Requires<Uncomparable>[] = arrays::generate(false, callback)
  let task = tasks::generate<Requires<Uncomparable>>(rejected, false) do |index|
    return missingTaskCallback
  end
  let memory = stackalloc Requires<Uncomparable>[false]

  collectFields(rejected: rejected, count: false)
  collectRejectedFields(value: missingPackArgument)
end

def main(): Void
end
