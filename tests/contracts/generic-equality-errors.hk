def arithmetic<T: Equality>(value: T): T
  return value + value
end

def unconstrainedSibling<T: Equality, U>(left: U, right: U): Bool
  return left == right
end

def same<T: Equality>(left: T, right: T): Bool
  return left == right
end

def unknown<T: Missing>(value: T): T
  return value
end

class EqualityCarrier<T: Equality>
  public value: T

  def init(value: T): Void
    this.value = value
  end
end

def requireEquality<T: Equality>(): Int
  return 1
end

class Invalid<T: Equality, U>
  public field: EqualityCarrier<U>?
  public count: Int = requireEquality<U>()

  def init(value: T): Void
    value.unavailableAtInitialization()
  end

  public def read(value: T): Int
    return value.unavailableInMethod()
  end
end

def rejectedSignature(value: EqualityCarrier<String[]>): Void
end

def main(): Void
  let values = [1]
  let rejected = same(values, values)
  let rejectedClass = new EqualityCarrier<Int[]>(values)
end

def malformed<T: Equality<Int>>(value: T): T
  return value
end
