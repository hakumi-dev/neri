def arithmetic<T: Equality>(value: T): T
  return value + value
end

def unconstrainedSibling<T: Equality, U>(left: U, right: U): Bool
  return left == right
end

def same<T: Equality>(left: T, right: T): Bool
  return left == right
end

def unknown<T: Missing>(value: T): T
  return value
end

class Invalid<T: Equality>
end

def main(): Void
  let values = [1]
  let rejected = same(values, values)
end

def malformed<T: Equality<Int>>(value: T): T
  return value
end
