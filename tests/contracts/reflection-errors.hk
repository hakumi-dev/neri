use result

resource class ReflectedResource
  public def close(): result::Failure?
    return null
  end
end

class Record
  public value: Int = 1
end

class Other
  public value: String = "text"
end

def main(): Void
  let record = new Record()

  compile for field in reflect.fields<Record>()
    let escaped = field
    let unknown = field.missing
    let wrong: String = field.read(record)
    let receiver = field.read(new Other())
    let arity = field.read()

    field.write(record, "wrong")
    field.write(record)
    field.write(new Other(), 1)
    field.write(record, new ReflectedResource())

    break
  end
  compile for field in reflect.fields<Int>()
  end
  compile for field in [1, 2]
  end
  let runtime = reflect.fields<Record>()
end

def rejectReadonly(record: readonly Record): Void
  compile for field in reflect.fields<Record>()
    field.write(record, 2)
  end
end

def rejectOptional(record: Record?): Void
  compile for field in reflect.fields<Record>()
    field.write(record, 2)
  end
end
