@representation("utf8")
public class String
end

@representation("utf8")
public class Pretender
end

@sealed
class Closed
end

class Opened : Closed
end

class IntrinsicMethod
  @intrinsic("string.equal")
  def equal(left: String, right: String): Bool
  end
end

@intrinsic("string.concat")
def wrongIntrinsic(value: String): String
  return value
end

def main(): Void
  let invalid = new String()
end
