use workers

def entry(config: Byte[]): Void
end

unsafe def unsafeEntry(config: Byte[]): Void
end

def wrongResult(config: Byte[]): Int
  return 1
end

def genericEntry<T>(config: Byte[]): Void
end

class Receiver
  def run(config: Byte[]): Void
  end
end

def main(): Void
  let options = new workers::Options()
  let callback: fn(Byte[]): Void = entry
  let receiver = new Receiver()
  let captured: fn(Byte[]): Void = fn(config)
    options.workers = 2
  end
  let closure = workers::start(captured, [], options)
  let local = workers::start(callback, [], options)
  let method = workers::start(receiver.run, [], options)
  let unsafeTarget = workers::start(unsafeEntry, [], options)
  let invalidReturn = workers::start(wrongResult, [], options)
  let genericTarget = workers::start(genericEntry<Int>, [], options)
  let entry: fn(Byte[]): Void = callback
  let shadowed = workers::start(entry, [], options)
  let factory = workers::start
end
