use quotation
use test

def main(): Void
  let nodes = [
    new Node(NodeKind.Parameter(), "Customer", index: 0),
    new Node(NodeKind.Member(), "Bool", first: 0, identity: "example.Customer.active"),
    new Node(NodeKind.Capture(), "Bool", index: 0),
    new Node(NodeKind.Equal(), "Bool", first: 1, second: 2)
  ]
  let tree = new Tree(nodes, [CaptureValue.Bool(true)], 3, ["Customer"], "Bool")
  let member = tree.nodeAt(1)
  let parameter = tree.parameterTypeAt(0)

  test.assertEqual(tree.count(), 4)
  test.assertEqual(tree.root(), 3)
  test.assertTrue(parameter != null)
  if parameter != null
    test.assertEqual(parameter, "Customer")
  end

  test.assertEqual(tree.resultType(), "Bool")
  test.assertEqual(tree.captureCount(), 1)
  test.assertTrue(member != null)
  if member != null
    test.assertEqual(member.identity(), "example.Customer.active")
    test.assertEqual(member.first(), 0)
  end

  test.assertTrue(tree.nodeAt(-1) == null)
  test.assertTrue(tree.nodeAt(4) == null)
  test.assertTrue(tree.captureAt(1) == null)
  test.assertTrue(tree.parameterTypeAt(1) == null)
end
