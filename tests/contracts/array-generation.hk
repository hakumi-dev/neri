use arrays
use reference
use test

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

class ArrayItem
  public value: Int

  def init(value: Int): Void
    this.value = value
  end
end

class ArrayCursor
  public values: ArrayItem[]
  public nextIndex: Int = 0

  def init(values: ArrayItem[]): Void
    this.values = values
  end

  def next(index: Int): ArrayItem
    test::assertEqual(index, this.nextIndex)
    this.nextIndex = this.nextIndex + 1
    return this.values[index]
  end
end

def main(): Void
  let first = new ArrayItem(7)
  let second = new ArrayItem(9)
  let cursor = new ArrayCursor([first, second])
  let items = arrays::generate<ArrayItem>(2) do |index|
    return cursor.next(index)
  end

  test::assertEqual(items.Length, 2)
  test::assertEqual(cursor.nextIndex, 2)
  test::assertTrue(reference::same(first, items[0]))
  test::assertTrue(reference::same(second, items[1]))

  let empty = arrays::generate<ArrayItem>(0) do |index|
    return cursor.next(index)
  end

  test::assertEqual(empty.Length, 0)
  test::assertEqual(cursor.nextIndex, 2)

  let numbers = arrays::generate<Int>(3) do |index|
    return index * 2
  end
  let words = arrays::generate<String>(2) do |index|
    unsafe
      collect()
    end
    return "item-" + (index as String)
  end
  let optional = arrays::generate<ArrayItem?>(2) do |index|
    if index == 0
      return first
    end
    return null
  end
  let rooted = arrays::generate<ArrayItem>(3) do |index|
    unsafe
      collect()
    end
    return new ArrayItem(index + 10)
  end

  unsafe
    collect()
  end

  test::assertEqual(numbers[0], 0)
  test::assertEqual(numbers[2], 4)
  test::assertEqual(words[0], "item-0")
  test::assertEqual(words[1], "item-1")
  test::assertTrue(optional[0] != null)
  test::assertTrue(optional[1] == null)
  test::assertEqual(rooted[0].value, 10)
  test::assertEqual(rooted[1].value, 11)
  test::assertEqual(rooted[2].value, 12)
  let maybeFirst = optional[0]

  if maybeFirst != null
    test::assertTrue(reference::same(first, maybeFirst))
  end
end
