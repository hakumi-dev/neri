class Node
  public value: Int = 0
  public child: Node?

  public def mutate(): Void
    this.value = 1
  end

  @readonly
  public def escape(): Node
    return this
  end
end

def mutableArgument(value: Node): Void
end

def reject(value: readonly Node, values: readonly Node[], numbers: readonly Int[]): Void
  value.value = 1
  let child = value.child
  if child != null
    child.value = 2
  end
  values[0] = new Node()
  let references: (readonly Node)[] = [value]
  references[0].value = 4
  for item in values
    item.value = 3
  end
  mutableArgument(value)
  value.mutate()
  let mutable = value as Node
  unsafe
    borrow numbers as pointer
      pointer[0] = 1
    end
  end
end

def main(): Void
end
