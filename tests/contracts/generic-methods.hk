use quotation
use test
use method_library

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

class MethodRecord
  public id: Int = 0
  public name: String = ""
end

class MethodValueProbe
  public evaluations: Int = 0
  public calls: Int = 0

  public def receiver(): MethodValueProbe
    this.evaluations = this.evaluations + 1
    return this
  end

  public def record<T>(value: T): Int
    this.calls = this.calls + 1
    return this.calls
  end

  public def empty<T>(): T?
    return null
  end
end

def detachedMethodValue(): fn(String): Int
  return new MethodValueProbe().record
end

def main(): Void
  let box = new method_library::MethodBox<Int>(42)
  let inferred: String = box.identity("inferred")
  let explicit: String = box.identity<String>("explicit")
  let callerType: MethodRecord = box.identity<MethodRecord>(new MethodRecord())
  let pair = box.combine("combined")
  let textBox = new method_library::MethodBox<String>("receiver")
  let reversePair = textBox.combine(21)
  let readonlyBox: readonly method_library::MethodBox<Int> = box
  let readonlyValue: String = readonlyBox.readonlyIdentity("readonly")
  let privateForwarded: Int = box.throughHidden(5)
  let plain = new method_library::PlainMethodReceiver()
  let plainInferred: Int = plain.identity(6)
  let plainExplicit: String = plain.identity<String>("plain")
  let derived = new method_library::DerivedMethodReceiver()
  let inherited: String = derived.identity("inherited")

  test::assertEqual(inferred, "inferred")
  test::assertEqual(explicit, "explicit")
  test::assertEqual(callerType.id, 0)
  test::assertEqual(pair.first, 42)
  test::assertEqual(pair.second, "combined")
  test::assertEqual(reversePair.first, "receiver")
  test::assertEqual(reversePair.second, 21)
  test::assertEqual(readonlyValue, "readonly")
  test::assertEqual(privateForwarded, 5)
  test::assertEqual(plainInferred, 6)
  test::assertEqual(plainExplicit, "plain")
  test::assertEqual(inherited, "inherited")

  let staticInferred: Int = method_library::MethodFactory.identity(9)
  let staticExplicit: String = method_library::MethodFactory.identity<String>("factory")

  test::assertEqual(staticInferred, 9)
  test::assertEqual(staticExplicit, "factory")

  let selector = new method_library::MethodSelector<MethodRecord>()
  let quoted = selector.select(quote do |record|: Int
      return record.id
    end)
  let tree = quoted.tree()
  let parameterType = tree.parameterTypeAt(0)

  test::assertTrue(parameterType != null)
  if parameterType != null
    test::assertEqual(parameterType, "MethodRecord")
  end

  test::assertEqual(tree.resultType(), "Int")

  let probe = new MethodValueProbe()
  let callback: fn(String): Int = probe.receiver().record
  let emptyCallback: fn(): String? = probe.empty
  let combineInt = box.combine<String>
  let combineText = textBox.combine<String>
  let inheritedBox = new method_library::DerivedMethodBox(73)
  let inheritedCallback: fn(String): method_library::MethodPair<Int, String> = inheritedBox.combine
  let readonlyCallback: fn(Int): Int = readonlyBox.readonlyIdentity
  let staticCallback: fn(Int): Int = method_library::MethodFactory.identity
  let detached = detachedMethodValue()

  unsafe
    collect()
  end

  test::assertEqual(callback("first"), 1)
  test::assertEqual(callback("second"), 2)
  test::assertEqual(probe.evaluations, 1)
  test::assertTrue(emptyCallback() == null)
  test::assertEqual(combineInt("explicit callback").first, 42)
  test::assertEqual(combineText("explicit callback").first, "receiver")
  test::assertEqual(inheritedCallback("inherited callback").first, 73)
  test::assertEqual(readonlyCallback(12), 12)
  test::assertEqual(staticCallback(13), 13)
  test::assertEqual(detached("collected receiver"), 1)
end
