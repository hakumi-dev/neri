use test

class Node
  public value: Int = 7
  public child: Node?

  public def reader(): shared fn(): Int
    return fn(): Int
      return this.value
    end
  end
end

def apply<T>(value: T, callback: shared fn(T): T): T
  return callback(value)
end

def identity<T>(value: T): T
  return value
end

def main(): Void
  let node = new Node()
  node.child = new Node()
  let nodes = [node]
  let read: shared fn(): Int = fn()
    let child = node.child
    var childValue = 0
    if child != null
      childValue = child.value
    end
    return node.value + nodes[0].value + childValue
  end
  node.value = 9
  # Captures observe the same objects, without freezing sequential aliases.
  test.assertEqual(read(), 25)
  let ordinary: fn(): Int = read
  test.assertEqual(ordinary(), 25)
  let nested: shared fn(): Int = fn()
    return read()
  end
  let view: readonly (shared fn(): Int) = nested
  test.assertEqual(view.invoke(), 25)
  test.assertEqual(node.reader()(), 9)
  let result = apply(3) do |value|
    let local = new Node()
    local.value = value + node.value
    return local.value
  end
  test.assertEqual(result, 12)
  let named: shared fn(Int): Int = identity
  test.assertEqual(named(6), 6)
  test.assertEqual(apply(5, support.increment), 6)
end

namespace support

def increment(value: Int): Int
  return value + 1
end
