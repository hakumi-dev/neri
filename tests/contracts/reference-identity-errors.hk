use reference
use result

class PlainBox
end

resource class OwnedBox
  public def close(): result::Failure?
    return null
  end
end

@intrinsic("reference.same")
def renamed<T>(left: T, right: T): Bool
end

def main(): Void
  let invalid = reference::same(1, 1)
  let renamedInvalid = renamed(1, 1)
  let plain = new PlainBox()
  let optional: PlainBox? = plain
  let view: readonly PlainBox = plain
  let scalarCast = reference::cast<PlainBox, Int>(1)
  let optionalCast = reference::cast<PlainBox, PlainBox?>(optional)
  let readonlyCast = reference::cast<PlainBox, readonly PlainBox>(view)
  let resourceCast = reference::cast<OwnedBox, PlainBox>(plain)
end
