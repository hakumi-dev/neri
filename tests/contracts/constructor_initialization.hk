use test

class Payload
  public number: Int

  def init(number: Int): Void
    this.number = number
  end
end

enum Input
  case Number(value: Int)
  case Default()
end

sealed class Record: Base
  public payload: Payload
  public text: String
  public fallback: Payload?
  public result: Int

  def init(input: Input): Void
    match input
      case Input.Number(value)
        this.payload = new Payload(value)
      case Input.Default()
        this.payload = super.makePayload()
    end
    this.result = this.calculate()
  end

  private def calculate(): Int
    return this.payload.number + this.base.number
  end
end

class Base
  public base: Payload = new Payload(7)

  protected def makePayload(): Payload
    return this.base
  end
end

class LoopRecord
  public payload: Payload

  def init(first: Bool, early: Bool): Void
    if early
      this.payload = new Payload(5)
      return
    end
    while true
      if first
        this.payload = new Payload(11)
        break
      end
      this.payload = new Payload(17)
      break
    end
  end
end

def main(): Void
  let explicit = new Record(Input.Number(3))
  let fallback = new Record(Input.Default())
  let early = new LoopRecord(false, true)
  let firstBreak = new LoopRecord(true, false)
  let secondBreak = new LoopRecord(false, false)

  test::assertEqual(explicit.result, 10)
  test::assertEqual(fallback.result, 14)
  test::assertEqual(explicit.text, "")
  test::assertTrue(fallback.fallback == null)
  test::assertEqual(early.payload.number, 5)
  test::assertEqual(firstBreak.payload.number, 11)
  test::assertEqual(secondBreak.payload.number, 17)
end
