use test

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

class Node
  public value: Int
  public next: Node?
end

def chain(count: Int): Node?
  var head: Node? = null
  var index = 0

  while index < count
    let node = new Node()

    node.value = index
    node.next = head
    head = node
    index = index + 1
  end
  return head
end

def sum(head: Node?): Int
  var node = head
  var result = 0

  while node != null
    result = result + node.value
    node = node.next
  end
  return result
end

# The callee returns a graph, but only a scalar leaves this allocation scope.
def temporary(count: Int, early: Bool): Int
  let head = chain(count)

  if early
    return -1
  end
  return sum(head)
end

def nested(): Int
  let outer = chain(2048)
  let inner = temporary(200000, false)

  return inner + sum(outer)
end

# A graph stored in an incoming object belongs to the caller's lifetime.
def retain(owner: Node, count: Int): Int
  owner.next = chain(count)
  return count
end

# Unknown native calls keep the existing heap and rooting contract.
def collecting(count: Int): Int
  let head = chain(count)

  unsafe
    collect()
  end
  return sum(head)
end

def main(): Void
  let owner = new Node()
  let escaped = chain(1024)

  test::assertEqual(retain(owner, 2048), 2048)
  test::assertEqual(nested(), 20001996128)
  test::assertEqual(temporary(200000, true), -1)
  test::assertEqual(collecting(1024), 523776)

  unsafe
    collect()
  end

  test::assertEqual(sum(escaped), 523776)
  test::assertEqual(sum(owner.next), 2096128)
end
