use quotation
use fields
use test

class CapturedCode
  public value: String

  def init(value: String): Void
    this.value = value
  end

  public static def captureQuotation(value: readonly CapturedCode?): CaptureValue
    return value == null ? CaptureValue.Null() : CaptureValue.Text(value.value)
  end

  @operator("==")
  public readonly def equals(other: readonly CapturedCode): Bool
    return this.value == other.value
  end
end

class ConvertedCustomer
  public code: CapturedCode = new CapturedCode("")
end

def convertedFields(labels values: fields of ConvertedCustomer): fields of ConvertedCustomer
  return values
end

def verifyConvertedFields(): Void
  let mutable = new CapturedCode("field snapshot")
  let view: readonly CapturedCode = mutable
  let values = convertedFields(code: view)

  mutable.value = "changed"
  let entry = values.pack().entryAt(0)

  test::assertTrue(entry != null)
  if entry == null
    return
  end

  test::assertEqual(entry.typeName(), "CapturedCode")

  match entry.value()
    case CaptureValue.Text(value)
      test::assertEqual(value, "field snapshot")
    case CaptureValue.Null()
    case CaptureValue.Bool(value)
    case CaptureValue.Int(value)
    case CaptureValue.Float(value)
      test::assertTrue(false)
  end
end

def convertedMatches(value: readonly CapturedCode): quote fn(ConvertedCustomer): Bool
  return quote do |customer|
    return customer.code == value
  end
end

def optionalConvertedCapture(value: CapturedCode?): quote fn(Int): CapturedCode?
  return quote do |unused: Int|: CapturedCode?
    return value
  end
end

def verifyConvertedCaptures(): Void
  let value = new CapturedCode("original")
  let tree = convertedMatches(value).tree()

  value.value = "later"
  let captured = tree.captureAt(0)

  test::assertTrue(captured != null)
  if captured == null
    return
  end
  match captured
    case CaptureValue.Text(text)
      test::assertEqual(text, "original")
    case CaptureValue.Bool(value)
    case CaptureValue.Int(value)
    case CaptureValue.Float(value)
    case CaptureValue.Null()
      test::assertTrue(false)
  end
  let nullable = optionalConvertedCapture(null).tree()
  let first: readonly CapturedCode = new CapturedCode("same")
  let second: readonly CapturedCode = new CapturedCode("same")
  let nullCapture = nullable.captureAt(0)

  test::assertTrue(first == second)
  test::assertTrue(nullCapture != null)
  if nullCapture == null
    return
  end
  match nullCapture
    case CaptureValue.Null()
    case CaptureValue.Bool(value)
    case CaptureValue.Int(value)
    case CaptureValue.Float(value)
    case CaptureValue.Text(value)
      test::assertTrue(false)
  end
end

class Customer
  public active: Bool = false
  public id: Int = 0
  public optionalId: Int? = null
  public amount: Float = 0.0
  public name: String = ""
  public otherName: String = ""
end

def predicate(minimum: Int): quote fn(Customer): Bool
  return quote do |customer|
    return customer.active && customer.id > minimum && customer.id != minimum
  end
end

def inspect<T>(expression: quote fn(T): Bool): readonly Tree
  return expression.tree()
end

def optionalMatches(value: Int?): quote fn(Customer): Bool
  return quote do |customer|
    return customer.optionalId == value
  end
end

def floatMatches(value: Float): quote fn(Customer): Bool
  return quote do |customer|
    return customer.amount == value
  end
end

def floatLiteral(): quote fn(Customer): Bool
  return quote do |customer|
    return customer.amount > 1.25
  end
end

def stringFieldsEqual(): quote fn(Customer): Bool
  return quote do |customer|
    return customer.name == customer.otherName
  end
end

def stringFieldsNotEqual(): quote fn(Customer): Bool
  return quote do |customer|
    return customer.name != customer.otherName
  end
end

def stringCaptureEqual(expected: String): quote fn(Customer): Bool
  return quote do |customer|
    return customer.name == expected
  end
end

def stringCaptureNotEqual(expected: String): quote fn(Customer): Bool
  return quote do |customer|
    return customer.name != expected
  end
end

def integerArithmetic(delta: Int): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return (customer.id + delta) * 2 - 4 / 2
  end
end

def floatArithmetic(scale: Float): quote fn(Customer): Float
  return quote do |customer: Customer|: Float
    return customer.amount / scale + 1.0
  end
end

def stringConcatenation(prefix: String): quote fn(Customer): String
  return quote do |customer: Customer|: String
    return prefix + customer.name
  end
end

def conditionalName(active: Bool): quote fn(Customer): String
  return quote do |customer: Customer|: String
    return active ? customer.name : customer.otherName
  end
end

def optionalConditionalName(active: Bool): quote fn(Customer): String?
  return quote do |customer: Customer|: String?
    return active ? customer.name : null
  end
end

def optionalPairName(): quote fn(Customer, Customer?): String
  return quote do |left: Customer, right: Customer?|: String
    return right == null ? "absent" : right.name
  end
end

def optionalPairNameReversed(): quote fn(Customer, Customer?): String
  return quote do |left: Customer, right: Customer?|: String
    return right != null ? right.name : "absent"
  end
end

def chooseOptionalCustomerName(value: Customer?): String
  return value == null ? "absent" : value.name
end

def chooseOptionalCustomerNameReversed(value: Customer?): String
  return value != null ? value.name : "absent"
end

def chooseName(active: Bool, name: String): String?
  return active ? name : null
end

def chooseNameReversed(active: Bool, name: String): String?
  return active ? null : name
end

def chooseId(active: Bool, required: Int, optional: Int?): Int?
  return active ? required : optional
end

def chooseIdReversed(active: Bool, required: Int, optional: Int?): Int?
  return active ? optional : required
end

def nodeKindName(kind: readonly NodeKind): String
  match kind
    case NodeKind.Equal()
      return "Equal"
    case NodeKind.NotEqual()
      return "NotEqual"
    case NodeKind.Parameter()
      return "Parameter"
    case NodeKind.Capture()
      return "Capture"
    case NodeKind.Member()
      return "Member"
    case NodeKind.FloatLiteral()
      return "FloatLiteral"
    case NodeKind.IntLiteral()
      return "IntLiteral"
    case NodeKind.BoolLiteral()
      return "BoolLiteral"
    case NodeKind.TextLiteral()
      return "TextLiteral"
    case NodeKind.NullLiteral()
      return "NullLiteral"
    case NodeKind.Less()
      return "Less"
    case NodeKind.LessEqual()
      return "LessEqual"
    case NodeKind.Greater()
      return "Greater"
    case NodeKind.GreaterEqual()
      return "GreaterEqual"
    case NodeKind.Add()
      return "Add"
    case NodeKind.Subtract()
      return "Subtract"
    case NodeKind.Multiply()
      return "Multiply"
    case NodeKind.Divide()
      return "Divide"
    case NodeKind.Concat()
      return "Concat"
    case NodeKind.Conditional()
      return "Conditional"
    case NodeKind.StringContains()
      return "StringContains"
    case NodeKind.StringStartsWith()
      return "StringStartsWith"
    case NodeKind.StringEndsWith()
      return "StringEndsWith"
    case NodeKind.StringByteLength()
      return "StringByteLength"
    case NodeKind.And()
      return "And"
    case NodeKind.Or()
      return "Or"
    case NodeKind.Not()
      return "Not"
    case NodeKind.Negate()
      return "Negate"
  end
end

def rootKindName(tree: readonly Tree): String
  let root = tree.nodeAt(tree.root())

  if root == null
    return ""
  end
  return nodeKindName(root.kind())
end

class ArrowPublisher
  public name: String = "Publisher"
end

class ArrowBook
  public publisher: ArrowPublisher? = null
  public publisherRequired: ArrowPublisher = new ArrowPublisher()
  public publishers: ArrowPublisher[] = []
end

class ArrowSelection<T>
  public resultType: String

  def init(resultType: String): Void
    this.resultType = resultType
  end

  public def select<U>(selector: quote fn(T): U): ArrowSelection<element of U>
    return new ArrowSelection<element of U>(selector.tree().resultType())
  end
end

def arrowResult<T, R>(value: T, selector: quote fn(T): R): String
  return selector.tree().resultType()
end

def arrowApply<T, R>(value: T, selector: fn(T): R): R
  return selector(value)
end

def projectionIdentity<T>(value: element of T): element of T
  return value
end

def verifyArrowInference(): Void
  let books = new ArrowSelection<ArrowBook>("")
  let optional: ArrowSelection<ArrowPublisher> = books.select(book => book.publisher)
  let collection: ArrowSelection<ArrowPublisher> = books.select(book => book.publishers)
  let required: ArrowSelection<ArrowPublisher> = books.select(book => book.publisherRequired)
  let chained = books.select(book => book.publishers).select(publisher => publisher.name)
  let optionalChained = books.select(book => book.publisher).select(publisher => publisher.name)
  let quoted: quote fn(ArrowBook): ArrowPublisher? = book => book.publisher
  let integer: Int = projectionIdentity<Int?>(7)
  let nestedOptional: Int? = projectionIdentity<Int?[]>(null)
  let nestedCollection: Int[] = projectionIdentity<Int[][]>([1, 2])

  test::assertEqual(optional.resultType, "ArrowPublisher?")
  test::assertEqual(collection.resultType, "ArrowPublisher[]")
  test::assertEqual(required.resultType, "ArrowPublisher")
  test::assertEqual(chained.resultType, "String")
  test::assertEqual(optionalChained.resultType, "String")
  test::assertEqual(arrowApply(4, value => value + 1), 5)
  test::assertEqual(quoted.tree().resultType(), "ArrowPublisher?")
  test::assertEqual(arrowResult(new ArrowBook(), book => book.publisher), "ArrowPublisher?")
  test::assertEqual(integer, 7)
  test::assertTrue(nestedOptional == null)
  test::assertEqual(nestedCollection.Length, 2)
end

def main(): Void
  verifyArrowInference()
  verifyConvertedFields()
  verifyConvertedCaptures()
  let contains: quote fn(Customer): Bool = quote do |customer|
    return customer.name.contains("é")
  end
  let starts: quote fn(Customer): Bool = quote do |customer|
    return customer.name.startsWith("")
  end
  let ends: quote fn(Customer): Bool = quote do |customer|
    return customer.name.endsWith("😀")
  end
  let bytes: quote fn(Customer): Int = quote do |customer|
    return customer.name.byteLength()
  end

  test::assertEqual(rootKindName(contains.tree()), "StringContains")
  test::assertEqual(rootKindName(starts.tree()), "StringStartsWith")
  test::assertEqual(rootKindName(ends.tree()), "StringEndsWith")
  test::assertEqual(rootKindName(bytes.tree()), "StringByteLength")
  test::assertTrue("café 😀".contains("é"))
  test::assertFalse("café 😀".contains("É"))
  test::assertTrue("café 😀".startsWith("café"))
  test::assertTrue("café 😀".endsWith("😀"))
  test::assertTrue("".contains(""))
  test::assertTrue("".startsWith(""))
  test::assertTrue("".endsWith(""))

  let expression = predicate(42)
  let tree = inspect(expression)
  let parameterType = tree.parameterTypeAt(0)
  let captured = tree.captureAt(0)
  var activeIdentity = ""
  var idIdentity = ""
  var index = 0

  while index < tree.count()
    let node = tree.nodeAt(index)

    if node != null && node.identity() != ""
      if node.typeName() == "Bool"
        activeIdentity = node.identity()
      else if node.typeName() == "Int"
        idIdentity = node.identity()
      end
    end
    index = index + 1
  end

  test::assertTrue(parameterType != null)
  if parameterType != null
    test::assertEqual(parameterType, "Customer")
  end

  test::assertEqual(tree.resultType(), "Bool")
  test::assertEqual(activeIdentity, "Customer.active")
  test::assertEqual(idIdentity, "Customer.id")
  test::assertEqual(tree.captureCount(), 1)
  test::assertTrue(captured != null)
  if captured != null
    match captured
      case CaptureValue.Int(value)
        test::assertEqual(value, 42)
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Float(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
      case CaptureValue.Null()
        test::assertTrue(false)
    end
  end
  let contextual = inspect<Customer>() do |customer|
    return customer.active
  end

  test::assertEqual(contextual.resultType(), "Bool")
  test::assertEqual(contextual.captureCount(), 0)

  let optionalPresent = optionalMatches(7)
  let optionalPresentCapture = optionalPresent.tree().captureAt(0)

  test::assertTrue(optionalPresentCapture != null)
  if optionalPresentCapture != null
    match optionalPresentCapture
      case CaptureValue.Int(value)
        test::assertEqual(value, 7)
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Float(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
      case CaptureValue.Null()
        test::assertTrue(false)
    end
  end

  let optionalNull: Int? = null
  let optionalAbsent = optionalMatches(optionalNull)
  let optionalNullCapture = optionalAbsent.tree().captureAt(0)

  test::assertTrue(optionalNullCapture != null)
  if optionalNullCapture != null
    match optionalNullCapture
      case CaptureValue.Null()
        test::assertTrue(true)
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Float(value)
        test::assertTrue(false)
      case CaptureValue.Int(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
    end
  end

  let fieldsEqual = stringFieldsEqual().tree()
  let fieldsNotEqual = stringFieldsNotEqual().tree()
  let captureEqual = stringCaptureEqual("Ada").tree()
  let captureNotEqual = stringCaptureNotEqual("Bea").tree()

  test::assertEqual(rootKindName(fieldsEqual), "Equal")
  test::assertEqual(rootKindName(fieldsNotEqual), "NotEqual")
  test::assertEqual(rootKindName(captureEqual), "Equal")
  test::assertEqual(rootKindName(captureNotEqual), "NotEqual")
  test::assertEqual(fieldsEqual.captureCount(), 0)
  test::assertEqual(captureEqual.captureCount(), 1)
  test::assertEqual(captureNotEqual.captureCount(), 1)

  let floatCapture = floatMatches(1.25).tree()
  let floatCaptureValue = floatCapture.captureAt(0)
  let floatLiteralTree = floatLiteral().tree()
  let floatRoot = floatLiteralTree.nodeAt(floatLiteralTree.root())

  test::assertTrue(floatRoot != null)
  if floatRoot != null
    let floatValueNode = floatLiteralTree.nodeAt(floatRoot.second())

    test::assertTrue(floatValueNode != null)
    if floatValueNode != null
      test::assertEqual(floatValueNode.floatValue(), 1.25)
    end
  end

  test::assertTrue(floatCaptureValue != null)
  if floatCaptureValue != null
    match floatCaptureValue
      case CaptureValue.Float(value)
        test::assertEqual(value, 1.25)
      case CaptureValue.Bool(value)
        test::assertTrue(false)
      case CaptureValue.Int(value)
        test::assertTrue(false)
      case CaptureValue.Text(value)
        test::assertTrue(false)
      case CaptureValue.Null()
        test::assertTrue(false)
    end
  end

  let fieldsRoot = fieldsEqual.nodeAt(fieldsEqual.root())
  let captureRoot = captureEqual.nodeAt(captureEqual.root())

  test::assertTrue(fieldsRoot != null)
  test::assertTrue(captureRoot != null)
  if fieldsRoot != null
    let right = fieldsEqual.nodeAt(fieldsRoot.second())

    test::assertTrue(right != null)
    if right != null
      test::assertEqual(right.identity(), "Customer.otherName")
    end
  end
  if captureRoot != null
    let right = captureEqual.nodeAt(captureRoot.second())

    test::assertTrue(right != null)
    if right != null
      test::assertEqual(right.typeName(), "String")
      test::assertEqual(right.index(), 0)
    end
  end

  let integerTree = integerArithmetic(7).tree()
  let integerRoot = integerTree.nodeAt(integerTree.root())

  test::assertEqual(rootKindName(integerTree), "Subtract")
  test::assertEqual(integerTree.captureCount(), 1)
  test::assertTrue(integerRoot != null)
  if integerRoot != null
    let multiply = integerTree.nodeAt(integerRoot.first())
    let divide = integerTree.nodeAt(integerRoot.second())

    test::assertTrue(multiply != null && divide != null)
    if multiply != null && divide != null
      let add = integerTree.nodeAt(multiply.first())

      test::assertTrue(add != null)
      if add != null
        test::assertEqual(nodeKindName(add.kind()), "Add")
      end

      test::assertEqual(nodeKindName(multiply.kind()), "Multiply")
      test::assertEqual(nodeKindName(divide.kind()), "Divide")
    end
  end

  let floatTree = floatArithmetic(2.0).tree()
  let floatArithmeticRoot = floatTree.nodeAt(floatTree.root())

  test::assertEqual(rootKindName(floatTree), "Add")
  test::assertEqual(floatTree.captureCount(), 1)
  test::assertTrue(floatArithmeticRoot != null)
  if floatArithmeticRoot != null
    let divide = floatTree.nodeAt(floatArithmeticRoot.first())

    test::assertTrue(divide != null)
    if divide != null
      test::assertEqual(nodeKindName(divide.kind()), "Divide")
      test::assertEqual(divide.typeName(), "Float")
    end
  end

  let concatTree = stringConcatenation("Hi ").tree()
  let concatRoot = concatTree.nodeAt(concatTree.root())
  let conditionalTree = conditionalName(true).tree()
  let conditionalRoot = conditionalTree.nodeAt(conditionalTree.root())
  let optionalConditionalTree = optionalConditionalName(true).tree()
  let optionalConditionalRoot = optionalConditionalTree.nodeAt(optionalConditionalTree.root())

  test::assertEqual(rootKindName(concatTree), "Concat")
  test::assertEqual(concatTree.captureCount(), 1)
  test::assertEqual(rootKindName(conditionalTree), "Conditional")
  test::assertEqual(optionalConditionalTree.resultType(), "String?")
  test::assertTrue(optionalConditionalRoot != null)
  if optionalConditionalRoot != null
    test::assertEqual(optionalConditionalRoot.typeName(), "String?")
  end

  test::assertTrue(chooseName(true, "Ada") == "Ada")
  test::assertTrue(chooseName(false, "Ada") == null)
  test::assertTrue(chooseNameReversed(true, "Ada") == null)
  test::assertTrue(chooseNameReversed(false, "Ada") == "Ada")
  test::assertTrue(chooseId(true, 7, null) == 7)
  test::assertTrue(chooseId(false, 7, null) == null)
  test::assertTrue(chooseIdReversed(true, 7, null) == null)
  test::assertTrue(chooseIdReversed(false, 7, null) == 7)
  let present = new Customer()

  present.name = "Ada"

  test::assertEqual(chooseOptionalCustomerName(null), "absent")
  test::assertEqual(chooseOptionalCustomerName(present), "Ada")
  test::assertEqual(chooseOptionalCustomerNameReversed(null), "absent")
  test::assertEqual(chooseOptionalCustomerNameReversed(present), "Ada")
  let optionalPairTree = optionalPairName().tree()
  let reversedPairTree = optionalPairNameReversed().tree()
  let optionalPairRoot = optionalPairTree.nodeAt(optionalPairTree.root())
  let reversedPairRoot = reversedPairTree.nodeAt(reversedPairTree.root())

  test::assertTrue(optionalPairTree.parameterTypeAt(1) == "Customer?")
  test::assertEqual(rootKindName(optionalPairTree), "Conditional")
  test::assertEqual(rootKindName(reversedPairTree), "Conditional")
  test::assertTrue(optionalPairRoot != null && reversedPairRoot != null)
  if optionalPairRoot != null && reversedPairRoot != null
    let whenPresent = optionalPairTree.nodeAt(optionalPairRoot.third())
    let reversedPresent = reversedPairTree.nodeAt(reversedPairRoot.second())

    test::assertTrue(whenPresent != null && reversedPresent != null)
    if whenPresent != null && reversedPresent != null
      test::assertEqual(whenPresent.identity(), "Customer.name")
      test::assertEqual(reversedPresent.identity(), "Customer.name")
    end
  end

  test::assertTrue(concatRoot != null && conditionalRoot != null)
  if conditionalRoot != null
    let condition = conditionalTree.nodeAt(conditionalRoot.first())
    let whenTrue = conditionalTree.nodeAt(conditionalRoot.second())
    let whenFalse = conditionalTree.nodeAt(conditionalRoot.third())

    test::assertTrue(condition != null && whenTrue != null && whenFalse != null)
    if condition != null && whenTrue != null && whenFalse != null
      test::assertEqual(nodeKindName(condition.kind()), "Capture")
      test::assertEqual(condition.index(), 0)
      test::assertEqual(whenTrue.identity(), "Customer.name")
      test::assertEqual(whenFalse.identity(), "Customer.otherName")
    end
  end
  if concatRoot != null
    test::assertEqual(concatRoot.third(), -1)
  end
end
