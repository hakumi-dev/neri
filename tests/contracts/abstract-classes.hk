use test

abstract class Measured
  abstract def value(adjustment: Int = 1): Int

  abstract readonly def name(): String

  def doubled(): Int
    return this.value() * 2
  end
end

abstract class NamedMeasured: Measured
  abstract override readonly def name(): String
end

class FixedMeasured: NamedMeasured
  override def value(adjustment: Int = 5): Int
    return 20 + adjustment
  end

  override readonly def name(): String
    return "fixed"
  end
end

abstract class RenamedMeasured: FixedMeasured
  abstract override readonly def name(): String
end

class FinalMeasured: RenamedMeasured
  override readonly def name(): String
    return "final"
  end
end

def main(): Void
  let measured: Measured = new FixedMeasured()
  let named: readonly NamedMeasured = new FinalMeasured()

  test::assertEqual(measured.doubled(), 42)
  test::assertEqual(named.name(), "final")
end
