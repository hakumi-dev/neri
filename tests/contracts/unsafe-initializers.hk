use test

class UnsafeInitializerBase
  public value: Int

  unsafe def init(value: Int = 7): Void
    this.value = value
  end
end

class UnsafeInitializerDefault: UnsafeInitializerBase
end

class UnsafeInitializerExplicit: UnsafeInitializerBase
  unsafe def init(value: Int = 9): Void
    super(value)
  end
end

def main(): Void
  unsafe
    let direct = new UnsafeInitializerBase()
    let inherited = new UnsafeInitializerDefault()
    let explicit = new UnsafeInitializerExplicit()

    test::assertEqual(direct.value, 7)
    test::assertEqual(inherited.value, 7)
    test::assertEqual(explicit.value, 9)
  end
end
