use host
use test
use files

def failureCode(result: files::ReadResult): String
  let failure = result.failure

  test::assertTrue(failure != null)
  if failure != null
    return failure.code
  end
  return ""
end

def main(): Void
  let path = host::argumentAt(0)

  test::assertTrue(path != null)
  if path == null
    return
  end

  test::assertTrue(host::writeBytes(path + "/nested/水.bin", [0 as Byte, 1 as Byte, 2 as Byte, 3 as Byte, 255 as Byte]))
  let opened = files::Root.open(path)

  test::assertTrue(opened.failure == null && opened.root != null)
  let root = opened.root

  if root == null
    return
  end

  let exact = root.readBytes("nested/水.bin", 5)

  test::assertTrue(exact.failure == null && exact.closeFailure == null)
  let bytes = exact.bytes

  test::assertTrue(bytes != null)
  if bytes != null
    test::assertEqual(bytes.Length, 5)
    test::assertEqual(bytes[0] as Int, 0)
    test::assertEqual(bytes[4] as Int, 255)
  end

  test::assertEqual(failureCode(root.readBytes("nested/水.bin", 4)), "limit_exceeded")
  test::assertEqual(failureCode(root.readBytes("../outside.bin", 16)), "invalid_path")
  test::assertEqual(failureCode(root.readBytes("nested//水.bin", 16)), "invalid_path")
  test::assertEqual(failureCode(root.readBytes("/nested/水.bin", 16)), "invalid_path")
  test::assertEqual(failureCode(root.readBytes("nested\\水.bin", 16)), "invalid_path")
  test::assertEqual(failureCode(root.readBytes("nested/C:drive", 16)), "invalid_path")
  # The complete lexical path is rejected before a missing prefix is consulted.
  test::assertEqual(failureCode(root.readBytes("missing/../outside.bin", 16)), "invalid_path")
  test::assertEqual(failureCode(root.readBytes("missing.bin", 16)), "component_missing")
  let escape = failureCode(root.readBytes("escape/outside.bin", 16))

  test::assertTrue(escape == "symlink_disallowed" || escape == "wrong_type")
  let linked = failureCode(root.readBytes("linked.bin", 16))

  test::assertTrue(linked == "symlink_disallowed" || linked == "wrong_type")
  test::assertEqual(failureCode(root.readBytes("nested", 16)), "not_regular")

  let firstClose = root.close()

  test::assertTrue(firstClose == null)
  test::assertTrue(root.close() == null)
  test::assertTrue(root.isClosed())
  test::assertEqual(failureCode(root.readBytes("nested/水.bin", 5)), "closed")

  let alias = files::Root.open(path + "/root-link")
  let aliasFailure = alias.failure

  test::assertTrue(alias.root == null && aliasFailure != null)
  if aliasFailure != null
    test::assertTrue(aliasFailure.code == "symlink_disallowed" || aliasFailure.code == "root_not_directory")
  end
  let relative = files::Root.open("relative")
  let trailing = files::Root.open(path + "/root-link/")

  test::assertTrue(trailing.root == null && trailing.failure != null)
  let relativeFailure = relative.failure

  test::assertTrue(relativeFailure != null)
  if relativeFailure != null
    test::assertEqual(relativeFailure.code, "invalid_root")
  end
end
