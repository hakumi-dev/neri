use test

@library("neri-ffi-contract")
@cabi("neri_ffi_double")
def unsafe twice(value: Float): Float
end

@cabi("neri_ffi_half")
@library("neri-ffi-contract")
def unsafe half(value: Float): Float
end

def main(): Void
  unsafe
    test.assertTrue(twice(21.0) == 42.0 && half(84.0) == 42.0)
  end
end
