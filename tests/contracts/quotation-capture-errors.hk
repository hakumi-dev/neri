use quotation

class PrivateCapture
  private static def captureQuotation(value: PrivateCapture?): CaptureValue
    return CaptureValue.Text("hidden")
  end
end

class UnsafeCapture
  public static unsafe def captureQuotation(value: UnsafeCapture?): CaptureValue
    return CaptureValue.Text("unsafe")
  end
end

class WrongCapture
  public static def captureQuotation(value: WrongCapture?): String
    return "wrong result"
  end
end

def privateCapture(value: PrivateCapture): quote fn(Int): PrivateCapture
  return quote do |unused: Int|: PrivateCapture
    return value
  end
end

def unsafeCapture(value: UnsafeCapture): quote fn(Int): UnsafeCapture
  return quote do |unused: Int|: UnsafeCapture
    return value
  end
end

def wrongCapture(value: WrongCapture): quote fn(Int): WrongCapture
  return quote do |unused: Int|: WrongCapture
    return value
  end
end

def main(): Void
end
