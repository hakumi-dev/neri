use test
use host

struct CRecord
  tag: Byte
  real: Float32
  wide: UInt64
  coordinates: Int32[3]
end

struct CNested
  tag: Byte
  value: CRecord
  next: Void*
end

union CEvent
  type: UInt32
  value: CRecord
  padding: Byte[128]
end

struct CNode
  tag: UInt32
  next: CNode*?
end

@library("neri-ffi-contract")
@cabi("neri_ffi_layout")
def unsafe cLayout(query: Int): Int
end

@library("neri-ffi-contract")
@cabi("neri_ffi_record_fill")
def unsafe cFill(value: CRecord*): Void
end

@library("neri-ffi-contract")
@cabi("neri_ffi_record_check")
def unsafe cCheck(value: CRecord*): Int
end

@library("neri-ffi-contract")
@cabi("neri_ffi_event_fill")
def unsafe cFillEvent(value: CEvent*): Void
end

@library("neri-ffi-contract")
@cabi("neri_ffi_real_store")
def unsafe cStoreReal(value: Float32*): Void
end

def copyRecord(value: CRecord): CRecord
  return value
end

def main(): Void
  let requested = host.argumentAt(0)
  if requested != null
    let index = host.parseInt(requested)
    if index != null
      unsafe
        let record = native.allocZeroed<CRecord>(1)
        let value = record.coordinates[index]
        native.free(record)
        host.exit(value as Int)
      end
    end
  end
  let layouts = [native.sizeOf<CRecord>(), native.alignOf<CRecord>(),
    native.offsetOf<CRecord>("real"), native.offsetOf<CRecord>("coordinates"),
    native.sizeOf<CNested>(), native.offsetOf<CNested>("value"),
    native.offsetOf<CNested>("next"), native.sizeOf<CEvent>(),
    native.alignOf<CEvent>(), native.offsetOf<CEvent>("value"),
    native.sizeOf<CNode>(), native.sizeOf<Float32[3][2]>()]
  var index = 0
  while index < layouts.Length
    unsafe
      test.assertEqual(layouts[index], cLayout(index))
    end
    index = index + 1
  end
  unsafe
    let records = native.allocZeroed<CRecord>(2)
    let value = records + 1
    cFill(value)
    test.assertEqual(value.tag as Int, 7)
    test.assertEqual(value.real as Float, 1.25)
    test.assertEqual(value.coordinates[0] as Int, -10)
    value.coordinates[1] = -20 as Int32
    test.assertEqual(value.coordinates[1] as Int, -20)
    test.assertTrue(value.wide > (9223372036854775807 as UInt64))
    value.tag = 9 as Byte
    value.wide = 42 as UInt64
    cStoreReal(&value.real)
    test.assertEqual(cCheck(value), 1)
    var copied = copyRecord(*value)
    if cCheck(value) == 1
      copied.tag = 3 as Byte
    end
    test.assertEqual(value.tag as Int, 9)
    test.assertEqual(copied.tag as Int, 3)
    test.assertEqual(cCheck(&copied), 0)
    let event = stackalloc CEvent[1]
    cFillEvent(event)
    test.assertEqual(event.value.real as Float, 1.25)
    event.value = *value
    test.assertEqual(cCheck(&event.value), 1)
    records[0].tag = 6 as Byte
    test.assertEqual(records[0].tag as Int, 6)
    let node = native.allocZeroed<CNode>(1)
    test.assertTrue(node.next == null)
    node.next = node
    let next = node.next
    if next != null
      next.tag = 13 as UInt32
    end
    test.assertEqual(node.tag as Int, 13)
    native.free(node)
    native.free(records)
  end
end
