use result

resource class MethodErrorResource
  public def close(): result::Failure?
    return null
  end

  public def identity<T>(value: T): T
    return value
  end
end

class MethodErrorBox<T>
  public def plain(): Int
    return 1
  end

  public def identity<U>(value: U): U
    return value
  end

  public def noInput<U>(): Int
    return 1
  end

  private def hidden<U>(value: U): U
    return value
  end

  public def shadow<T>(value: T): T
    return value
  end
end

def main(): Void
  let box = new MethodErrorBox<Int>()
  let nonGenericExplicit = box.plain<Int>()
  let wrongTypeArgumentCount = box.identity<Int, String>(1, "extra")
  let wrongValueType = box.identity<Int>("not an int")
  let methodReference = box.identity
  let uninferred: fn(): Int = box.noInput
  let inaccessible = box.hidden(1)
  let readonlyBox: readonly MethodErrorBox<Int> = box
  let readonlyCallback: fn(Int): Int = readonlyBox.identity
  let mismatchedCallback: fn(Int): String = box.identity
  let sharedCallback: shared fn(Int): Int = box.identity
  let owned = new MethodErrorResource()
  let ownedCallback: fn(Int): Int = owned.identity

  box.identity = box.identity<Int>
end
