def wrong(value: Int): String
  value + 1
end

def sum(left: Int, right: Int): Int
  left + right
end

def missing(flag: Bool, left: Int, right: Int): Int
  if flag
    return left
  else
    sum(left, right)
  end
end

def ping(): Void
end

def contextualVoid(): Void
  let callback: fn(): Void = fn() do
    (ping)()
  end

  callback()
end

def unreachable(value: Int): Int
  return value
  value + 1
end

def main(): Void
end
