use files
use host
use test
use tasks

def main(): Void
  let path = host::argumentAt(0)

  test::assertTrue(path != null)
  if path == null
    return
  end
  let bytes: Byte[] = tasks::generate(4097, 1) do |index|
    return (index - (index / 256) * 256) as Byte
  end

  test::assertTrue(host::writeBytes(path, bytes))
  let loaded = files::readBytes(path, bytes.Length)

  test::assertTrue(loaded.failure == null && loaded.closeFailure == null)
  let actual = loaded.bytes

  test::assertTrue(actual != null)
  if actual != null
    test::assertEqual(actual.Length, bytes.Length)
    var same = true
    var index = 0

    while index < actual.Length
      same = same && actual[index] == bytes[index]
      index = index + 1
    end

    test::assertTrue(same)
  end
  let tooLarge = files::readBytes(path, bytes.Length - 1)
  let limitError = tooLarge.failure

  test::assertTrue(tooLarge.bytes == null && limitError != null)
  if limitError != null
    test::assertEqual(limitError.code, "limit_exceeded")
  end

  test::assertTrue(host::writeBytes(path, []))
  let empty = files::readBytes(path, 0).bytes

  test::assertTrue(empty != null)
  if empty != null
    test::assertEqual(empty.Length, 0)
  end

  test::assertTrue(host::removeFile(path))
  let missing = files::readBytes(path, 1).failure

  test::assertTrue(missing != null)
  if missing != null
    test::assertEqual(missing.code, "open_failed")
    test::assertTrue(missing.osCode != 0)
  end
end
