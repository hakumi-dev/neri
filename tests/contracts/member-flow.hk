use quotation
use test

class Leaf
  public total: Int = 0
  public optionalTotal: Int? = null
end

class Branch
  public right: Leaf? = null
end

class Row
  public branch: Branch = new Branch()
end

def selected(row: Row): Int?
  return row.branch.right != null ? row.branch.right.total : null
end

def selectedReadonly(row: readonly Row): Int?
  return row.branch.right != null ? row.branch.right.total : null
end

def selectedScalar(row: Row): Int?
  return row.branch.right != null && row.branch.right.optionalTotal != null ? row.branch.right.optionalTotal : null
end

def reversed(row: Row): Int?
  return row.branch.right == null ? null : row.branch.right.total
end

def negated(row: Row): Int?
  return !(row.branch.right == null) ? row.branch.right.total : null
end

def guarded(row: Row): Int
  if row.branch.right != null && row.branch.right.total > 0
    return row.branch.right.total
  end
  return 0
end

def shortCircuit(row: Row): Bool
  return row.branch.right != null && row.branch.right.total > 0
end

def clearGuarded(row: Row): Void
  if row.branch.right != null
    row.branch.right = null
  end
end

def identity(value: Int): Int
  return value
end

def callWithGuardedArgument(row: Row): Int
  if row.branch.right != null
    return identity(row.branch.right.total)
  end
  return 0
end

def afterTerminatingBranch(row: Row): Int
  if row.branch.right == null
    return 0
  end
  return row.branch.right.total
end

def clearAndCount(row: Row): Int
  row.branch.right = null
  return 1
end

def branchIsolated(row: Row, clear: Bool): Int
  if row.branch.right != null
    return clear ? clearAndCount(row) : row.branch.right.total
  end
  return 0
end

def quoted(): quote fn(Row): Int?
  return quote do |row: Row|: Int?
    return row.branch.right != null ? row.branch.right.total : null
  end
end

def main(): Void
  let row = new Row()

  test::assertTrue(selected(row) == null)
  test::assertTrue(selectedReadonly(row) == null)
  test::assertTrue(selectedScalar(row) == null)
  test::assertTrue(reversed(row) == null)
  test::assertTrue(negated(row) == null)
  test::assertEqual(guarded(row), 0)
  test::assertTrue(!shortCircuit(row))
  test::assertEqual(callWithGuardedArgument(row), 0)
  test::assertEqual(afterTerminatingBranch(row), 0)
  row.branch.right = new Leaf()
  let right = row.branch.right

  if right != null
    right.total = 7
  end

  test::assertTrue(selectedScalar(row) == null)
  if right != null
    right.optionalTotal = 5
  end

  test::assertTrue(selected(row) == 7)
  test::assertTrue(selectedReadonly(row) == 7)
  test::assertTrue(selectedScalar(row) == 5)
  test::assertTrue(reversed(row) == 7)
  test::assertTrue(negated(row) == 7)
  test::assertEqual(guarded(row), 7)
  test::assertTrue(shortCircuit(row))
  test::assertEqual(callWithGuardedArgument(row), 7)
  test::assertEqual(afterTerminatingBranch(row), 7)
  test::assertEqual(branchIsolated(row, false), 7)
  test::assertEqual(quoted().tree().resultType(), "Int?")
  clearGuarded(row)

  test::assertTrue(selected(row) == null)
end
