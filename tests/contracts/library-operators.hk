use test

class Amount
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  static def create(value: Int): Amount
    return new Amount(value)
  end

  @operator("+")
  public def plus(other: Amount): Amount
    return new Amount(this.value + other.value)
  end

  @operator("-")
  public def negate(): Amount
    return new Amount(-this.value)
  end

  @operator("==")
  public readonly def same(other: Amount): Bool
    return this.value == other.value
  end

  @conversion
  public readonly def integer(): Int
    return this.value
  end
end

class AmountSource
  public calls: Int = 0

  def next(): Amount
    this.calls = this.calls + 1
    return Amount.create(this.calls)
  end
end

class Choice<T>
  private value: T

  private def init(value: T): Void
    this.value = value
  end

  static def create(value: T): Choice<T>
    return new Choice<T>(value)
  end

  @operator("+")
  public def choose(other: Choice<T>): Choice<T>
    return other
  end

  def get(): T
    return this.value
  end
end

class InitializedBase
  public value: Int

  def init(value: Int = 7): Void
    this.value = value
  end
end

class InitializedDerived : InitializedBase
  def init(): Void
  end
end

class InitializedMiddle : InitializedBase
end

class InitializedLeaf : InitializedMiddle
end

class ProtectedInitializedBase
  public value: Int

  protected def init(value: Int = 9): Void
    this.value = value
  end
end

class ProtectedInitializedLeaf : ProtectedInitializedBase
end

def main(): Void
  let source = new AmountSource()
  let total = source.next() + source.next()
  let view: readonly Amount = total

  test.assertEqual(total as Int, 3)
  test.assertEqual(view as Int, 3)
  test.assertEqual(source.calls, 2)
  test.assertEqual(total, Amount.create(3))
  test.assertTrue(-total == Amount.create(-3))
  test.assertEqual((Choice<Int>.create(1) + Choice<Int>.create(42)).get(), 42)
  test.assertEqual(new InitializedDerived().value, 7)
  let initializedLeaf = new InitializedLeaf()

  test.assertEqual(initializedLeaf.value, 7)
  test.assertEqual(new ProtectedInitializedLeaf().value, 9)
end
