enum Choice<T>
  case Value(value: T)
  case Empty()
end

enum Other
  case Value(value: Int)
end

enum Plain
  case Only()
end

class Forged : Plain
end

def incomplete(value: Choice<Int>): Int
  match value
    case Choice.Value(number)
      return number
  end
end

def redundant(value: Choice<Int>): Int
  match value
    case Choice.Value(first)
      return first
    case Choice.Value(second)
      return second
    case Choice.Empty()
      return 0
  end
end

def invalid(value: Choice<Int>): Int
  match value
    case Other.Value(number)
      return number
    case Choice.Empty(extra)
      return 0
  end
end

def forged(): Choice<Int>
  return new Choice<Int>()
end

def wrongPayload(): Choice<Int>
  return Choice<Int>.Value("wrong")
end

def main(): Void
  return
end
