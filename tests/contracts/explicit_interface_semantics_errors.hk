interface Reader<T>
  def read(): T
end

interface NumberReader: Reader<Int>
end

class StructuralReader
  public def read(): Int
    return 4
  end
end

class WrongResult<T> implements Reader<T>
  public def read(): String
    return "four"
  end
end

class MissingMethod implements NumberReader
end

interface WrongParent: StructuralReader
end

interface First: Second
end

interface Second: First
end

interface ConflictingReader: Reader<Int>, Reader<String>
end

resource interface OwnedReader
  def read(): Int
end

class ResourceSlot<T: OwnedReader>
  public value: T
end

class WrongOwnership implements OwnedReader
  public def read(): Int
    return 7
  end
end

def readNumber<T: Reader<Int>>(reader: T): Int
  return reader.read()
end

def unsupported<T: Reader<T>>(reader: T): Void
end

sealed interface InvalidTemplate<T>
  public value: T
  def init(): Void
  static def staticRead(): T
  def genericRead<U>(value: U): T
  def defaultRead(value: T = null): T
end

def main(): Void
  let invalid: NumberReader = new StructuralReader()
  let nominal = new NumberReader()
  let wrong = new WrongResult<Int>()

  readNumber(new StructuralReader())
end
