use result

resource class Handle
  public def init(): Void
  end

  public def close(): result.Failure?
    return null
  end
end

class Holder
  public handle: Handle?
end

def copied(): Void
  let first = new Handle()
  let second = first
end

def captured(): Void
  let handle = new Handle()
  let callback: fn(): Void = fn()
    handle.close()
  end
end

def ordinary(handle: Handle): Void
end

def passed(): Void
  let handle = new Handle()
  ordinary(handle)
end

def stored(): Void
  let handle = new Handle()
  let items = [handle]
end

def implicitReturn(): Handle
  let handle = new Handle()
  return handle
end

def copiedPayload(): result.Result<Handle, String>
  let handle = new Handle()
  return result.Result<Handle, String>.Ok(handle)
end

def main(): Void
end
