namespace generic_contracts

class Box<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end

  def get(): T
    return this.value
  end
end

def identity<T>(value: T): T
  return value
end

def transform<T, U>(value: T, convert: fn(T): U): U
  return convert(value)
end

def absent<T>(): T?
  return null
end

def unwrap<T>(value: Box<T>): T
  return value.get()
end

def repeat<T>(value: T, count: Int): T
  if count == 0
    return value
  end
  return repeat(value, count - 1)
end

def first<T>(values: T[]): T
  return values[0]
end
