class Parent
end

class Child: Parent
end

class Box<T>
  public value: T
  def init(value: T): Void
    this.value = value
  end
end

def identity<T>(value: T): T
  return value
end

def absent<T>(): T?
  return null
end

def increment<T>(value: T): T
  return value + 1
end

def main(): Void
  let ambiguous = absent()
  let wrong = identity<Int>("text")
  let arity = identity<Int, String>(1)
  let box = new Box<Int>(1)
  box.value = "text"
  let invariant: Box<Parent> = new Box<Child>(new Child())
  let invalidBody = increment("text")
end
