use console

class Quiet
  public def act(): Void
    return
  end
end

class Loud: Quiet
  public override def act(): Void
    console::println("virtual")
  end
end

def cycleFirst(again: Bool): Void
  cycleSecond(again)
end

def cycleSecond(again: Bool): Void
  cycleFirst(false) if again
  console::println("cycle")
end

def dispatch(value: Quiet): Void
  value.act()
end

def invoke(action: fn(): Void): Void
  action()
end

def untouched(): Void
  return
end

unsafe def releaseOnly(value: Byte*): Void
  native::free(value)
end

def main(): Void
  cycleFirst(false)
  dispatch(new Loud())
  invoke() do
    console::println("callback")
  end
  unsafe
    let pointer = native::alloc<Byte>(1)

    releaseOnly(pointer)
  end
end
