use console

class Quiet
  public def act(): Void
    return
  end
end

class Loud : Quiet
  @override
  public def act(): Void
    console.println("virtual")
  end
end

def cycleFirst(again: Bool): Void
  cycleSecond(again)
end

def cycleSecond(again: Bool): Void
  cycleFirst(false) if again
  console.println("cycle")
end

def dispatch(value: Quiet): Void
  value.act()
end

def invoke(action: fn(): Void): Void
  action()
end

def untouched(): Void
  return
end

def main(): Void
  cycleFirst(false)
  dispatch(new Loud())
  invoke(fn(): Void
    console.println("callback")
  end)
end
