use result
use resources

resource class Handle
  public def close(): result.Failure?
    return null
  end
end

resource class UnsafeHandle
  public unsafe def close(): result.Failure?
    return null
  end
end

def dropped(): Void
  let handle = new Handle()
  return
end

def fresh(): Handle
  let handle = new Handle()
  return transfer handle
end

def discarded(): Void
  fresh()
end

def optionalBinding(): Void
  let handle: Handle? = new Handle()
end

def branch(flag: Bool): result.Result<Handle, String>
  let handle = new Handle()
  if flag
    return result.Result<Handle, String>.Ok(transfer handle)
  end
  return result.Result<Handle, String>.Error("failed")
end

def branchUse(flag: Bool): resources.Outcome<Int, String>
  let handle = new Handle()
  if flag
    using active <- handle
    end
  end
  using active <- handle
    return 1
  end
  return 0
end

def loopUse(flag: Bool): resources.Outcome<Int, String>
  let handle = new Handle()
  while flag
    using active <- handle
    end
  end
  return 0
end

def forUse(values: Int[]): resources.Outcome<Int, String>
  let handle = new Handle()
  for value in values
    using active <- handle
    end
  end
  return 0
end

def nestedFactory(): result.Result<result.Result<Handle, String>, String>
  let handle = new Handle()
  return result.Result<result.Result<Handle, String>, String>.Ok(result.Result<Handle, String>.Ok(transfer handle))
end

def nestedResult(): resources.Outcome<Int, String>
  using handle <- nestedFactory()
    return 1
  end
  return 0
end

def optionalUsing(handle: Handle?): resources.Outcome<Int, String>
  using active <- handle
    return 1
  end
  return 0
end

def unsafeClose(): resources.Outcome<Int, String>
  let handle = new UnsafeHandle()
  using active <- handle
    return 1
  end
  return 0
end

def main(): Void
end
