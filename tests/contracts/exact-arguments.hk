use test

class Base
end

class Derived : Base
end

class Counter
  public value: Int = 0

  def next(): Int
    this.value = this.value + 1
    return this.value
  end
end

def acceptBase(value: Base): Void
end

@exact
def same<T>(left: T, right: T): Bool
  return left == right
end

def main(): Void
  acceptBase(new Derived())
  let counter = new Counter()
  let equal = same(counter.next(), counter.next())

  test.assertTrue(!equal)
  test.assertEqual(counter.value, 2)
end
