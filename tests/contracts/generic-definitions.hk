use reference
use test

class GenericDefinitionRoot
end

class GenericDefinitionChild: GenericDefinitionRoot
end

class GenericDefinitionHolder<T: class>
  private value: T

  def init(value: T): Void
    this.value = value
  end

  public readonly def same(other: readonly T): Bool
    return reference::same<readonly T>(this.value, other)
  end
end

class GenericDefinitionMethods
  public def cast<T: class, U: class>(value: T): U?
    return reference::cast<U, T>(value)
  end
end

def genericDefinitionProject<T>(value: element of T): element of T
  return value
end

def main(): Void
  let child = new GenericDefinitionChild()
  let holder = new GenericDefinitionHolder<GenericDefinitionRoot>(child)
  let methods = new GenericDefinitionMethods()
  let cast = methods.cast<GenericDefinitionRoot, GenericDefinitionChild>(child)

  test::assertTrue(holder.same(child))
  test::assertTrue(cast != null && reference::same(child, cast))
  test::assertEqual(genericDefinitionProject<Int[]>(42), 42)
end
