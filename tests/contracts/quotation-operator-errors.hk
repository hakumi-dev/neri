use quotation

class Token
  public value: Int = 0

  @operator("==")
  readonly def equals(other: Token): Bool
    return this.value == other.value
  end

  @operator("+")
  readonly def combine(other: Token): Token
    return this
  end
end

class Customer
  public token: Token = new Token()
  public name: String = ""
end

def quoteUserOperator(): quote fn(Customer): Bool
  return quote do |customer|
    return customer.token == customer.token
  end
end

def quoteDirectStringMethod(): quote fn(Customer): Bool
  return quote do |customer|
    return customer.name.equals(customer.name)
  end
end

def quoteUserAddition(): quote fn(Customer): Token
  return quote do |customer|
    return customer.token + customer.token
  end
end

def quoteDirectStringConcat(): quote fn(Customer): String
  return quote do |customer|
    return customer.name.concat(customer.name)
  end
end

def main(): Void
end
