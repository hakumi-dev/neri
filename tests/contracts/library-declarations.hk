use math
use test

@intrinsic("integer.abs")
def magnitude(value: Int): Int
end

class Amount
  private value: Int

  def init(value: Int): Void
    this.value = value
  end

  @operator("==")
  @readonly
  def equals(other: Amount): Bool
    return this.value == other.value
  end
end

class AmountSource
  public calls: Int = 0

  def value(number: Int): Amount
    this.calls = this.calls + 1
    return new Amount(number)
  end
end

def main(): Void
  test.assertEqual(magnitude(-7), 7)
  test.assertEqual(math.min(8, 3), 3)
  test.assertEqual(math.max(8, 3), 8)
  let source = new AmountSource()

  test.assertEqual(source.value(42), source.value(42))
  test.assertEqual(source.calls, 2)
end
