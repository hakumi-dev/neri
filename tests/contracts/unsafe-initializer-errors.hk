class UnsafeInitializerBase
  unsafe def init(value: Int = 7): Void
  end
end

class UnsafeInitializerDefault: UnsafeInitializerBase
end

class InvalidImplicitInitializer: UnsafeInitializerBase
  def init(): Void
  end
end

class InvalidExplicitInitializer: UnsafeInitializerBase
  def init(): Void
    super()
  end
end

def main(): Void
  let direct = new UnsafeInitializerBase()
  let inherited = new UnsafeInitializerDefault()
end
