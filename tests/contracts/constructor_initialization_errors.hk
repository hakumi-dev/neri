class Payload
  public number: Int
end

class Conditional
  public payload: Payload

  def init(load: Bool): Void
    if load
      this.payload = new Payload()
    end
  end
end

class EarlyExit
  public payload: Payload

  def init(skip: Bool): Void
    if skip
      return
    end
    this.payload = new Payload()
  end
end

class Loop
  public payload: Payload

  def init(values: Int[]): Void
    for value in values
      this.payload = new Payload()
      break
    end
  end
end

class EarlyRead
  public payload: Payload
  public number: Int

  def init(): Void
    this.number = this.payload.number
    this.payload = new Payload()
  end
end

class FieldInitializerOrder
  public number: Int = this.payload.number
  public payload: Payload = new Payload()
end

class ReceiverEscape
  public payload: Payload

  def init(): Void
    let captured: fn(): Int = fn(): Int do
      return this.payload.number
    end

    this.payload = new Payload()
  end
end

class Base
  def init(): Void
    let value = this.read()
  end

  public def read(): Int
    return 0
  end
end

class Derived: Base
  public payload: Payload = new Payload()

  public override def read(): Int
    return this.payload.number
  end
end

class MissingDefaults
  public values: Int[]
  public callback: fn(): Int
end

def main(): Void
end
