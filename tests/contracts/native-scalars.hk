use test

@library("neri-ffi-contract")
@cabi("neri_ffi_i32")
def unsafe cSigned(value: Int32): Int32
end
@library("neri-ffi-contract")
@cabi("neri_ffi_u32")
def unsafe cUnsigned(value: UInt32): UInt32
end
@library("neri-ffi-contract")
@cabi("neri_ffi_u64")
def unsafe cWide(value: UInt64): UInt64
end
@library("neri-ffi-contract")
@cabi("neri_ffi_f32")
def unsafe cFloat(value: Float32): Float32
end
@library("neri-ffi-contract")
@cabi("neri_ffi_scalars")
def unsafe cMemory(a: Int32*, b: UInt32*, c: Float32*): Void
end

class ScalarBox<T>
  public value: T
  def init(value: T): Void
    this.value = value
  end
end

class ZeroScalars
  public signed: Int32
  public unsigned: UInt32
  public wide: UInt64
  public real: Float32
end

def optional(value: Float32?): Float32?
  return value
end

def main(): Void
  let negative = -2147483648 as Int32
  let unsigned = 4294967295 as UInt32
  test.assertTrue((negative as Int) == -2147483648 && (unsigned as UInt64) > (2147483647 as UInt64))
  let zero = new ZeroScalars()
  test.assertTrue(zero.signed == (0 as Int32) && zero.unsigned == (0 as UInt32) && zero.wide == (0 as UInt64) && zero.real == (0.0 as Float32))
  let small = (7 as Int32) + (5 as Int32)
  test.assertTrue(small / (3 as Int32) == (4 as Int32) && -(5 as Int32) == (-5 as Int32))
  test.assertTrue((unsigned / (3 as UInt32)) as Int == 1431655765)
  let box = new ScalarBox<Float32>(1.5 as Float32)
  let values = [box.value, 2.5 as Float32]
  test.assertTrue(((values[0] + values[1]) * (2.0 as Float32)) as Float == 8.0)
  let present = optional(values[0])
  if present != null
    test.assertTrue(present == (1.5 as Float32))
  else
    test.assertTrue(false)
  end
  test.assertTrue(optional(null) == null)
  unsafe
    test.assertTrue(cSigned(negative) == negative && cUnsigned(unsigned) == unsigned)
    let maximum = cWide(0 as UInt64)
    test.assertTrue(maximum > (9223372036854775807 as UInt64))
    test.assertTrue((maximum / (3 as UInt64)) as Int == 6148914691236517205)
    test.assertTrue(cFloat(box.value) == (2.0 as Float32))
    let a = stackalloc Int32[2]
    let b = stackalloc UInt32[2]
    let c = stackalloc Float32[2]
    a[0] = 42 as Int32
    b[0] = 43 as UInt32
    c[0] = 44.0 as Float32
    cMemory(a, b, c)
    test.assertTrue(a[0] == (42 as Int32) && a[1] == negative)
    test.assertTrue(b[0] == (43 as UInt32) && b[1] == unsigned)
    test.assertTrue(c[0] == (44.0 as Float32) && c[1] == (1.25 as Float32))
    var local = 3 as Int32
    let address = &local
    *address = 4 as Int32
    test.assertTrue(local == (4 as Int32))
  end
end
