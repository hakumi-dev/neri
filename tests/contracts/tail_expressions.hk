use test
use resources
use result
use quotation

def apply(value: Int, operation: fn(Int): Int): Int
  operation(value)
end

def offsetBy(offset: Int): fn(Int): Int
  fn(value) do
    return value + offset
  end
end

class Price
  private base: Int

  def init(base: Int): Void
    this.base = base
  end

  public readonly def withFee(fee: Int): Int
    this.base + fee
  end
end

def choose(flag: Bool, left: Int, right: Int): Int
  return left if flag
  left + right
end

def above(minimum: Int): quote fn(Int): Bool
  quote do |value|
    value > minimum
  end
end

def temporaryFile(contents: String): resources::Outcome<String, result::Failure>
  var path = ""

  using directory <- files::TemporaryDirectory.create("tail-expressions-")
    path = directory.path() + "/message"

    test::assertTrue(host::writeText(path, contents))
  end
  path
end

def main(): Void
  let double: fn(Int): Int = fn(value) do
    value + value
  end
  let price = new Price(35)
  let temporary = temporaryFile("scoped text")

  test::assertEqual(apply(40, offsetBy(2)), 42)
  test::assertEqual(double(21), 42)
  test::assertEqual(price.withFee(7), 42)
  test::assertEqual(choose(true, 31, 11), 31)
  test::assertEqual(choose(false, 31, 11), 42)
  test::assertEqual(above(10).tree().resultType(), "Bool")
  test::assertEqual(temporary.closeFailures.count(), 0)

  match temporary.completion
    case resources::Completion.Value(path)
      test::assertTrue(host::readText(path) == null)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end
