use arrays
use tasks
use test

class OptionalArrayView<T>
  private item: T

  def init(item: T): Void
    this.item = item
  end

  public readonly def inspectItems(limit: Int): (readonly T)[]
    if limit <= 0
      return []
    end
    return tasks::generate(limit, 1) do |index|
      return this.item
    end
  end
end

def main(): Void
  let integers: Int?[] = [null, 7, null]

  integers[0] = 42
  integers[1] = null
  let booleans: Bool?[] = [true, null, false]

  booleans[1] = false
  let floats: Float?[] = [null, 1.5]

  floats[0] = -2.25

  test::assertTrue(integers[0] == 42)
  test::assertTrue(integers[1] == null)
  test::assertTrue(integers[2] == null)
  test::assertTrue(booleans[0] == true)
  test::assertTrue(booleans[1] == false)
  test::assertTrue(booleans[2] == false)
  test::assertTrue(floats[0] == -2.25)
  test::assertTrue(floats[1] == 1.5)

  let sequential = arrays::generate<Int?>(4) do |index|
    return index == 1 ? null : index
  end
  let parallel = tasks::generate<Bool?>(4, 1) do |index|
    return index == 1 ? null : index == 2
  end
  let parallelFloats = tasks::generate<Float?>(4, 1) do |index|
    return index == 2 ? null : (index as Float) + 0.5
  end

  test::assertTrue(sequential[0] == 0)
  test::assertTrue(sequential[1] == null)
  test::assertTrue(sequential[3] == 3)
  test::assertTrue(parallel[0] == false)
  test::assertTrue(parallel[1] == null)
  test::assertTrue(parallel[2] == true)
  test::assertTrue(parallelFloats[1] == 1.5)
  test::assertTrue(parallelFloats[2] == null)
  test::assertTrue(parallelFloats[3] == 3.5)

  let present = new OptionalArrayView<Int?>(9)
  let absent = new OptionalArrayView<Int?>(null)
  let empty = present.inspectItems(0)
  let values = present.inspectItems(3)
  let missing = absent.inspectItems(2)

  test::assertEqual(empty.Length, 0)
  test::assertTrue(values[2] == 9)
  test::assertTrue(missing[0] == null)
  test::assertTrue(missing[1] == null)
end
