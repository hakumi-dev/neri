@operation("tasks.generate")
def malformed<Value>(count: Int, callback: fn(Int): Value): Value[]
end

@operation("tasks.generate")
@operation("tasks.generate")
def repeated<Element>(count: Int, parallelism: Int = 0, callback: parallel fn(Int): Element): Element[]
end

@exact
@operation("tasks.generate")
def mixed<Item>(count: Int, parallelism: Int = 0, callback: parallel fn(Int): Item): Item[]
end

def main(): Void
end
