class Leaf
  public total: Int = 0
end

class Row
  public right: Leaf? = null
end

enum Choice
  case First()
  case Second()
end

def clear(row: Row): Bool
  row.right = null
  return true
end

def wrongBranch(row: Row): Int
  return row.right == null ? row.right.total : 0
end

def callInvalidates(row: Row): Int
  if row.right != null
    clear(row)
    return row.right.total
  end
  return 0
end

def aliasWriteInvalidates(row: Row, alias: Row): Int
  if row.right != null
    alias.right = null
    return row.right.total
  end
  return 0
end

def conditionMutation(row: Row): Int
  if row.right != null && clear(row)
    return row.right.total
  end
  return 0
end

def postConditionalLeak(row: Row): Int
  let chosen = row.right != null ? row.right.total : 0

  return row.right.total
end

def mutatedSurvivingBranch(row: Row): Int
  if row.right != null
    clear(row)
  else
    return 0
  end
  return row.right.total
end

def postMergeMutation(row: Row, mutate: Bool): Int
  if row.right != null
    let selected = mutate ? clear(row) : true

    return row.right.total
  end
  return 0
end

def loopBackedge(row: Row, repeat: Bool): Int
  if row.right != null
    while repeat
      let current = row.right.total

      clear(row)
    end
  end
  return 0
end

def matchCaseLeak(row: Row, choice: Choice): Int
  match choice
    case Choice.First()
      if row.right == null
        return 0
      end
    case Choice.Second()
      return row.right.total
  end
  return 0
end

def main(): Void
end
