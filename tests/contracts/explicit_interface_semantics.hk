use reference
use resources
use result
use test

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collectGarbage(): Void
end

interface Reader<T>
  def read(): T
end

interface Named
  def name(): String
end

interface NamedReader: Reader<String>, Named
end

class TextReader implements NamedReader
  public value: String

  def init(value: String): Void
    this.value = value
  end

  public def read(): String
    return this.value
  end

  public def name(): String
    return "text"
  end
end

class DerivedReader: TextReader
  def init(value: String): Void
    super(value)
  end

  public override def read(): String
    return this.value + "!"
  end
end

class Shelf
  public reader: NamedReader

  def init(reader: NamedReader): Void
    this.reader = reader
  end
end

abstract class DeferredReader<T> implements Reader<T>
end

class Cell<T>: DeferredReader<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end

  public def read(): T
    return this.value
  end
end

def readText<T: Reader<String>>(reader: T): String
  return reader.read()
end

def readNumber(reader: DeferredReader<Int>): Int
  return reader.read()
end

resource interface ResourceReader
  def read(): Int
  def close(): result::Failure?
end

resource class CountingReader implements ResourceReader
  public def read(): Int
    return 9
  end

  public def close(): result::Failure?
    return new result::Failure("close_failed", "reader.close")
  end
end

def openReader(): ResourceReader
  let reader: ResourceReader = new CountingReader()

  return transfer reader
end

def readResource<T: ResourceReader>(open: fn(): T): resources::Outcome<Int, String>
  using reader <- open()
    return reader.read()
  end
  return 0
end

def main(): Void
  let shelf = new Shelf(new DerivedReader("page"))
  let number = new Cell<Int>(42)
  let outcome = readResource<ResourceReader>(openReader)

  unsafe
    collectGarbage()
  end

  test::assertEqual(shelf.reader.name(), "text")
  test::assertEqual(readText(shelf.reader), "page!")
  let reader: Reader<String> = shelf.reader
  let roundTrip = reference::cast<DerivedReader, Reader<String>>(reader)

  test::assertTrue(reference::cast<NamedReader, Reader<String>>(reader) != null)
  test::assertTrue(reference::cast<NamedReader, Shelf>(shelf) == null)
  if roundTrip != null
    let restored: Reader<String> = roundTrip

    test::assertTrue(reference::same(reader, restored))
  else
    test::assertTrue(false)
  end

  test::assertEqual(readNumber(number), 42)
  test::assertEqual(outcome.closeFailures.count(), 1)
  outcome.closeFailures.each() do |failure|
    test::assertEqual(failure.code, "close_failed")
  end
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 9)
    case resources::Completion.Failure(failure)
      test::assertTrue(false)
  end
end
