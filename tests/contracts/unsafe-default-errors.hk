class UnsafeDefaultValue
  unsafe def value(enabled: Bool = true): Int
    return enabled ? 42 : 0
  end
end

class UnsafeDefaultDerived: UnsafeDefaultValue
  override unsafe def value(enabled: Bool = false): Int
    return enabled ? 84 : 1
  end
end

unsafe def unsafeDefault(value: Int = 42): Int
  return value
end

def main(): Void
  let instance: UnsafeDefaultValue = new UnsafeDefaultDerived()
  let methodValue = instance.value()
  let moduleValue = unsafeDefault()
end
