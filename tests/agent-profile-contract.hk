use host
use process
use test

def profileContractWrite(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def profileContractRun(compiler: String, root: String): LspJson
  let options = new process.SpawnOptions(compiler)

  options.arguments = ["profile", "--project", root, "--operation", "profile-contract"]
  let result = new AgentProcessResult()

  result.run(options, 30000)

  test.assertEqual(result.status, "completed")
  test.assertEqual(result.exitKind, "exit")
  test.assertEqual(result.exitCode, 0)
  test.assertTrue(!result.stdoutTruncated)
  let parser = new LspJsonParser(result.stdout)
  let output = parser.parse()

  parser.spaces()

  test.assertTrue(!parser.failed && parser.position == host.stringByteLength(result.stdout))
  return output
end

def main(): Void
  let compiler = host.argumentAt(1)
  let parent = host.argumentAt(2)

  test.assertTrue(compiler != null && parent != null)
  if compiler == null || parent == null
    return
  end
  let root = bootstrapTemporaryDirectory(parent, "agent-profile")

  test.assertTrue(root != null)
  if root == null
    return
  end
  let marker = root + "/executed"

  profileContractWrite(root + "/app.hk", "use host\ndef main(): Void\n  host.writeText(" + lspQuote(marker) + ", \"executed\")\nend\n")
  profileContractWrite(root + "/lib.hk", "def answer(): Int\n  return 1\nend\n")
  profileContractWrite(root + "/manifest.json", "{\"version\":2,\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"app.hk\"],\"references\":[\"lib\"]},\"lib\":{\"kind\":\"library\",\"sources\":[\"lib.hk\"]}}}")
  let output = profileContractRun(compiler, root)
  var unit = output.get("units").first
  var count = 0

  test.assertEqual(output.get("status").scalarText(), "valid")
  test.assertTrue(output.get("complete").isTrue())
  test.assertEqual(output.get("unitsTotal").scalarText(), "2")
  test.assertEqual(output.get("snapshotBefore").scalarText(), output.get("snapshotAfter").scalarText())
  test.assertTrue(host.readText(marker) == null)
  while unit != null
    var timing = unit.get("timings").first
    var completed = false

    test.assertEqual(unit.get("status").scalarText(), "valid")
    test.assertEqual(host.stringByteLength(unit.get("artifactDigest").scalarText()), 64)
    while timing != null
      if timing.get("phase").scalarText() == "build-complete"
        completed = true
      end
      let duration = agentInputInteger(timing.get("durationMs"))

      test.assertTrue(duration != null)
      if duration != null
        test.assertTrue(duration >= 0)
      end
      timing = timing.next
    end

    test.assertTrue(completed)
    count = count + 1
    unit = unit.next
  end

  test.assertEqual(count, 2)
  let partial = new AgentPhaseProfile("{\"schemaVersion\":1,\"phase\":\"frontend\",\"durationMs\":1}\n")

  test.assertTrue(!partial.complete && partial.error != "")
end
