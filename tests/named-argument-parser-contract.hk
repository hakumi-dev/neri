use host
use test

def firstKind(arena: SyntaxArena, node: Int, kind: String): Int
  if node < 0
    return -1
  end
  if arena.kindAt(node) == kind
    return node
  end
  var offset = 0

  while offset < arena.childCountAt(node)
    let found = firstKind(arena, arena.childAt(node, offset), kind)

    if found >= 0
      return found
    end
    offset = offset + 1
  end
  return -1
end

def countKind(arena: SyntaxArena, node: Int, kind: String): Int
  if node < 0
    return 0
  end
  var result = arena.kindAt(node) == kind ? 1 : 0
  var offset = 0

  while offset < arena.childCountAt(node)
    result = result + countKind(arena, arena.childAt(node, offset), kind)
    offset = offset + 1
  end
  return result
end

def main(): Void
  let namedSource = "def main(): Void\n  target(first: 1, second: 2)\nend\n"
  let namedParser = new BootstrapParser((new BootstrapLexer(namedSource)).lex())
  let namedRoot = namedParser.parseProgram()

  test.assertEqual(namedParser.diagnostics.count(), 0)
  let namedCall = firstKind(namedParser.arena, namedRoot, "Call")

  test.assertTrue(namedCall >= 0)
  if namedCall >= 0
    test.assertEqual(namedParser.arena.childCountAt(namedCall), 3)
    let first = namedParser.arena.childAt(namedCall, 1)
    let second = namedParser.arena.childAt(namedCall, 2)

    test.assertEqual(namedParser.arena.kindAt(first), "NamedArgument")
    test.assertEqual(namedParser.arena.dataAt(first), "first")
    test.assertEqual(namedParser.arena.startAt(first), bootstrapFindText(namedSource, "first"))
    test.assertEqual(namedParser.arena.lengthAt(first), 5)
    test.assertEqual(namedParser.arena.secondaryStartAt(first), bootstrapFindText(namedSource, "first:") + 5)
    test.assertEqual(namedParser.arena.secondaryLengthAt(first), 1)
    test.assertEqual(namedParser.arena.kindAt(namedParser.arena.childAt(first, 0)), "IntLiteral")
    test.assertEqual(namedParser.arena.dataAt(second), "second")
  end

  let ordinarySource = "def main(): Void\n  target(1, 2)\nend\n"
  let ordinaryParser = new BootstrapParser((new BootstrapLexer(ordinarySource)).lex())
  let ordinaryRoot = ordinaryParser.parseProgram()

  test.assertEqual(ordinaryParser.diagnostics.count(), 0)
  let ordinaryCall = firstKind(ordinaryParser.arena, ordinaryRoot, "Call")

  test.assertTrue(ordinaryCall >= 0)
  if ordinaryCall >= 0
    test.assertEqual(ordinaryParser.arena.kindAt(ordinaryParser.arena.childAt(ordinaryCall, 1)), "IntLiteral")
    test.assertEqual(countKind(ordinaryParser.arena, ordinaryCall, "NamedArgument"), 0)
  end

  let newSource = "def main(): Void\n  let item = new Box(value: 1)\nend\n"
  let newParser = new BootstrapParser((new BootstrapLexer(newSource)).lex())
  let newRoot = newParser.parseProgram()

  test.assertEqual(newParser.diagnostics.count(), 0)
  let newNode = firstKind(newParser.arena, newRoot, "New")

  test.assertTrue(newNode >= 0)
  if newNode >= 0
    test.assertEqual(newParser.arena.kindAt(newParser.arena.childAt(newNode, 1)), "NamedArgument")
  end

  let rejectedSource = "def main(): Void\n  let values = [value: 1]\n  native.print(value: 1)\nend\n"
  let rejectedParser = new BootstrapParser((new BootstrapLexer(rejectedSource)).lex())
  let rejectedRoot = rejectedParser.parseProgram()

  test.assertTrue(rejectedParser.diagnostics.count() >= 2)
  let array = firstKind(rejectedParser.arena, rejectedRoot, "ArrayLiteral")
  let intrinsic = firstKind(rejectedParser.arena, rejectedRoot, "NativeIntrinsic")

  test.assertTrue(array >= 0)
  test.assertTrue(intrinsic >= 0)
  if array >= 0
    test.assertEqual(countKind(rejectedParser.arena, array, "NamedArgument"), 0)
  end
  if intrinsic >= 0
    test.assertEqual(countKind(rejectedParser.arena, intrinsic, "NamedArgument"), 0)
  end

  let incompleteSource = "target(value:\ndef next(): Void\nend\n"
  let incompleteParser = new BootstrapParser((new BootstrapLexer(incompleteSource)).lex())
  let submission = incompleteParser.parseSubmission()

  test.assertTrue(incompleteParser.diagnostics.count() > 0)
  let incomplete = firstKind(incompleteParser.arena, submission.entry, "NamedArgument")

  test.assertTrue(incomplete >= 0)
  if incomplete >= 0
    test.assertEqual(incompleteParser.arena.dataAt(incomplete), "value")
    let missing = incompleteParser.arena.childAt(incomplete, 0)

    test.assertEqual(incompleteParser.arena.kindAt(missing), "MissingExpression")
    test.assertEqual(incompleteParser.arena.startAt(missing), bootstrapFindText(incompleteSource, "value:") + 5)
    test.assertEqual(incompleteParser.arena.lengthAt(missing), 1)
  end

  test.assertTrue(countKind(incompleteParser.arena, submission.root, "Function") >= 2)
end
