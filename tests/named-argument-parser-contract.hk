use host
use test

def firstKind(arena: SyntaxArena, node: Int, kind: readonly SyntaxKind): Int
  if node < 0
    return -1
  end
  if arena.kindAt(node).same(kind)
    return node
  end
  var offset = 0

  while offset < arena.childCountAt(node)
    let found = firstKind(arena, arena.childAt(node, offset), kind)

    if found >= 0
      return found
    end
    offset = offset + 1
  end
  return -1
end

def countKind(arena: SyntaxArena, node: Int, kind: readonly SyntaxKind): Int
  if node < 0
    return 0
  end
  var result = arena.kindAt(node).same(kind) ? 1 : 0
  var offset = 0

  while offset < arena.childCountAt(node)
    result = result + countKind(arena, arena.childAt(node, offset), kind)
    offset = offset + 1
  end
  return result
end

def main(): Void
  namespaceQualificationContracts()
  let namedSource = "def main(): Void\n  target(first: 1, second: 2)\nend\n"
  let namedParser = new BootstrapParser((new BootstrapLexer(namedSource)).lex())
  let namedRoot = namedParser.parseProgram()

  test::assertEqual(namedParser.diagnostics.count(), 0)
  let namedCall = firstKind(namedParser.arena, namedRoot, namedParser.arena.kinds.getCall())

  test::assertTrue(namedCall >= 0)
  if namedCall >= 0
    test::assertEqual(namedParser.arena.childCountAt(namedCall), 3)
    let first = namedParser.arena.childAt(namedCall, 1)
    let second = namedParser.arena.childAt(namedCall, 2)

    test::assertTrue(namedParser.arena.kindAt(first).isNamedArgument())
    test::assertEqual(namedParser.arena.dataAt(first), "first")
    test::assertEqual(namedParser.arena.startAt(first), bootstrapFindText(namedSource, "first"))
    test::assertEqual(namedParser.arena.lengthAt(first), 5)
    test::assertEqual(namedParser.arena.secondaryStartAt(first), bootstrapFindText(namedSource, "first:") + 5)
    test::assertEqual(namedParser.arena.secondaryLengthAt(first), 1)
    test::assertTrue(namedParser.arena.kindAt(namedParser.arena.childAt(first, 0)).isIntLiteral())
    test::assertEqual(namedParser.arena.dataAt(second), "second")
  end

  let ordinarySource = "def main(): Void\n  target(1, 2)\nend\n"
  let ordinaryParser = new BootstrapParser((new BootstrapLexer(ordinarySource)).lex())
  let ordinaryRoot = ordinaryParser.parseProgram()

  test::assertEqual(ordinaryParser.diagnostics.count(), 0)
  let ordinaryCall = firstKind(ordinaryParser.arena, ordinaryRoot, ordinaryParser.arena.kinds.getCall())

  test::assertTrue(ordinaryCall >= 0)
  if ordinaryCall >= 0
    test::assertTrue(ordinaryParser.arena.kindAt(ordinaryParser.arena.childAt(ordinaryCall, 1)).isIntLiteral())
    test::assertEqual(countKind(ordinaryParser.arena, ordinaryCall, ordinaryParser.arena.kinds.getNamedArgument()), 0)
  end

  let newSource = "def main(): Void\n  let item = new Box(value: 1)\nend\n"
  let newParser = new BootstrapParser((new BootstrapLexer(newSource)).lex())
  let newRoot = newParser.parseProgram()

  test::assertEqual(newParser.diagnostics.count(), 0)
  let newNode = firstKind(newParser.arena, newRoot, newParser.arena.kinds.getNew())

  test::assertTrue(newNode >= 0)
  if newNode >= 0
    test::assertTrue(newParser.arena.kindAt(newParser.arena.childAt(newNode, 1)).isNamedArgument())
  end

  let rejectedSource = "def main(): Void\n  let values = [value: 1]\n  native::free(value: 1)\nend\n"
  let rejectedParser = new BootstrapParser((new BootstrapLexer(rejectedSource)).lex())
  let rejectedRoot = rejectedParser.parseProgram()

  test::assertTrue(rejectedParser.diagnostics.count() >= 2)
  let array = firstKind(rejectedParser.arena, rejectedRoot, rejectedParser.arena.kinds.getArrayLiteral())
  let intrinsic = firstKind(rejectedParser.arena, rejectedRoot, rejectedParser.arena.kinds.getNativeIntrinsic())

  test::assertTrue(array >= 0)
  test::assertTrue(intrinsic >= 0)
  if array >= 0
    test::assertEqual(countKind(rejectedParser.arena, array, rejectedParser.arena.kinds.getNamedArgument()), 0)
  end
  if intrinsic >= 0
    test::assertEqual(countKind(rejectedParser.arena, intrinsic, rejectedParser.arena.kinds.getNamedArgument()), 0)
  end

  let incompleteSource = "target(value:\ndef next(): Void\nend\n"
  let incompleteParser = new BootstrapParser((new BootstrapLexer(incompleteSource)).lex())
  let submission = incompleteParser.parseSubmission()

  test::assertTrue(incompleteParser.diagnostics.count() > 0)
  let incomplete = firstKind(incompleteParser.arena, submission.entry, incompleteParser.arena.kinds.getNamedArgument())

  test::assertTrue(incomplete >= 0)
  if incomplete >= 0
    test::assertEqual(incompleteParser.arena.dataAt(incomplete), "value")
    let missing = incompleteParser.arena.childAt(incomplete, 0)

    test::assertTrue(incompleteParser.arena.kindAt(missing).isMissingExpression())
    test::assertEqual(incompleteParser.arena.startAt(missing), bootstrapFindText(incompleteSource, "value:") + 5)
    test::assertEqual(incompleteParser.arena.lengthAt(missing), 1)
  end

  test::assertTrue(countKind(incompleteParser.arena, submission.root, incompleteParser.arena.kinds.getFunction()) >= 2)
end

def namespaceContractModel(source: String, parent: SemanticModel? = null): SemanticModel
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, root, host::stringByteLength(source), parent)

  binder.requireEntryPoint = false
  binder.recordSourceSymbols = true
  return binder.bind()
end

def namespaceQualificationContracts(): Void
  let definitions = "namespace App::Nested\nclass Box\n  public static def answer(): Int\n    return 42\n  end\nend\ndef answer(): Int\n  return 42\nend\ndef identity<T>(value: T): T\n  return value\nend\n"
  let source = "use Short = App::Nested\ndef probe(): Int\n  let App = 1\n  let Short = 2\n  let box: Short::Box = new App::Nested::Box()\n  Short::answer()\n  return App::Nested::Box.answer() + Short::identity<Int>(Short::answer())\nend\n" + definitions
  let valid = namespaceContractModel(source)

  test::assertEqual(valid.diagnostics.count(), 0)
  test::assertTrue(valid.namespaceAliasReferenced("Short"))
  test::assertFalse(valid.hasUse("App.Nested"))
  test::assertTrue(valid.findClass("App.Nested.Box") != null)
  let duplicate = namespaceContractModel("use Same = App::Nested\nuse Same = App::Nested\n" + definitions)
  let collision = namespaceContractModel("use App = App::Nested\n" + definitions)
  let unopened = namespaceContractModel("use Short = App::Nested\ndef probe(): Int\n  return answer()\nend\n" + definitions)
  let chained = namespaceContractModel("use First = App::Nested\nuse Second = First\n" + definitions)

  test::assertTrue(duplicate.diagnostics.count() > 0)
  test::assertTrue(collision.diagnostics.count() > 0)
  test::assertTrue(unopened.diagnostics.count() > 0)
  test::assertTrue(chained.diagnostics.count() > 0)
  let parent = namespaceContractModel("use Kept = App::Nested\n" + definitions)
  let failed = namespaceContractModel("use Pending = App::Nested\nuse Pending = App::Nested\n", parent)

  test::assertTrue(failed.diagnostics.count() > 0)
  test::assertTrue(parent.findNamespaceAlias("Kept") != null)
  test::assertTrue(parent.findNamespaceAlias("Pending") == null)
end
