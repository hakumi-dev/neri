use host
use test

def declarations(): String
  return "## Combines typed options.\ndef configure(first: Int, second: Bool = false): Int\n  return second ? first : 0\nend\n\nenum Mode\n  case Safe()\n  case Fast(level: Int)\nend\n\ndef choose(enabled: Bool? = null, mode: Mode = Mode.Safe()): Int\n  return 0\nend\n\ndef headOr<T>(values: T[], fallback: T): T\n  return values.Length > 0 ? values[0] : fallback\nend\n\nunsafe def raw(first: Int, second: Int = 0): Int\n  return first + second\nend\n"
end

def countText(text: String, part: String): Int
  var count = 0
  var remaining = text
  var found = bootstrapFindText(remaining, part)

  while found >= 0
    count = count + 1
    let consumed = found + host.stringByteLength(part)

    remaining = host.stringSlice(remaining, consumed, host.stringByteLength(remaining) - consumed)
    found = bootstrapFindText(remaining, part)
  end
  return count
end

def assertDiagnostic(expression: String, code: String): Void
  let source = declarations() + "\ndef main(): Void\n  let result = " + expression + "\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)

  let binder = new BootstrapBinder(parser.arena, root, utf16Length(source))
  let model = binder.bind()
  var found = false
  var index = 0

  while index < model.diagnostics.count()
    found = true if model.diagnostics.codes.get(index) == code
    index = index + 1
  end

  test.assertTrue(found)
end

def markedDocument(source: String): LspDocument
  let marker = bootstrapFindText(source, "|")
  let document = new LspDocument()

  test.assertTrue(marker >= 0)

  document.uri = "untitled:named-arguments"
  document.text = host.stringSlice(source, 0, marker) + host.stringSlice(source, marker + 1, host.stringByteLength(source) - marker - 1)
  document.publishDiagnostics = false
  let server = new LspServer()

  server.analyze(document)
  return document
end

def appendDocumentSource(document: LspDocument, uri: String, text: String): Void
  document.sourceUris.add(uri)
  document.sourceTexts.add(text)
  document.sourceVersions.add(-1)
  let starts = new IntBuffer()
  var source = ""
  var index = 0

  while index < document.sourceTexts.size
    starts.add((new IrSourceMap(source)).utf16Length())
    source = source + document.sourceTexts.get(index) + "\n"
    index = index + 1
  end
  let tokens = (new BootstrapLexer(source)).lex()
  let parser = new BootstrapParser(tokens)

  index = 0
  while index < starts.size
    parser.addSourceBoundary(starts.get(index))
    index = index + 1
  end
  document.sourceStarts = starts
  document.tokens = tokens
  document.syntaxRoot = parser.parseProgram()
  document.syntax = parser.arena
  document.semantic = null
end

def markerPosition(source: String): Int
  let marker = bootstrapFindText(source, "|")

  return (new IrSourceMap(host.stringSlice(source, 0, marker))).utf16Length()
end

def completionItem(source: String, label: String): LspJson?
  let document = markedDocument(source)
  let result = lspCompletion(document, bootstrapFindText(source, "|"))
  let items = (new LspJsonParser(result)).parse()
  var item = items.first

  while item != null
    if item.get("label").value == label
      return item
    end
    item = item.next
  end
  return null
end

def completionLabelAt(source: String, index: Int): String
  let document = markedDocument(source)
  let items = (new LspJsonParser(lspCompletion(document, bootstrapFindText(source, "|")))).parse()
  var item = items.first
  var current = 0

  while item != null
    if current == index
      return item.get("label").value
    end
    current = current + 1
    item = item.next
  end
  return ""
end

def main(): Void
  assertDiagnostic("configure(unknown: 1)", "NR270")
  assertDiagnostic("configure(1, first: 2)", "NR271")
  assertDiagnostic("configure(first: 1, 2)", "NR272")
  assertDiagnostic("configure(second: true)", "NR273")
  assertDiagnostic("configure(second: 2, first: 1)", "NR112")
  assertDiagnostic("headOr(values: [1], fallback: false)", "NR112")
  assertDiagnostic("raw(first: 1)", "NR275")

  let source = declarations() + "\ndef main(): Void\n  let result = configure(sec|: true, first: 1)\nend\n"
  let item = completionItem(source, "second")

  test.assertTrue(item != null)
  test.assertTrue(completionItem(source, "first") == null)
  if item != null
    test.assertEqual(item.get("detail").value, "second: Bool")
    test.assertEqual(item.get("textEdit").get("newText").value, "second")
  end

  let emptyCall = declarations() + "\ndef main(): Void\n  let result = configure(|)\nend\n"
  let first = completionItem(emptyCall, "first")

  test.assertTrue(first != null)
  if first != null
    test.assertEqual(first.get("textEdit").get("newText").value, "first: ")
  end

  let valueSource = declarations() + "\ndef main(): Void\n  let count = 3\n  let result = configure(cou|)\nend\n"

  test.assertTrue(completionItem(valueSource, "count") != null)

  let namedValueSource = declarations() + "\ndef main(): Void\n  let trusted = true\n  let result = configure(first: 1, second: |)\nend\n"

  test.assertTrue(completionItem(namedValueSource, "true") != null)
  test.assertTrue(completionItem(namedValueSource, "trusted") != null)
  test.assertTrue(completionItem(namedValueSource, "second") == null)

  let afterNamedSource = declarations() + "\ndef main(): Void\n  let trusted = true\n  let result = configure(first: 1, |)\nend\n"

  test.assertTrue(completionItem(afterNamedSource, "second") != null)
  test.assertTrue(completionItem(afterNamedSource, "trusted") == null)

  let signatureSource = declarations() + "\ndef main(): Void\n  let result = configure(second: |)\nend\n"
  let document = markedDocument(signatureSource)
  let signature = (new LspJsonParser(lspSignatureHelp(document, bootstrapFindText(signatureSource, "|")))).parse()

  test.assertEqual(signature.get("activeParameter").value, "1")

  let expectedBoolSource = declarations() + "\ndef main(): Void\n  let db = 1\n  let enabled = true\n  let result = choose(enabled: |)\nend\n"
  let expectedModeSource = declarations() + "\ndef main(): Void\n  let db = 1\n  let result = choose(mode: |)\nend\n"
  let qualifiedModeSource = declarations() + "\ndef main(): Void\n  let result = choices.choose(mode: |)\nend\n\nnamespace choices\n\nenum Mode\n  case Safe()\nend\n\ndef choose(mode: Mode): Int\n  return 0\nend\n"
  let genericModeSource = declarations() + "\ndef main(): Void\n  let result = choices.chooseGeneric(value: |)\nend\n\nnamespace choices\n\nenum Choice<T>\n  case Some(value: T)\n  case None()\nend\n\ndef chooseGeneric(value: Choice<Int>): Int\n  return 0\nend\n"
  let genericModeItem = completionItem(genericModeSource, "choices.Choice<Int>.Some")
  let rankedTrue = completionItem(expectedBoolSource, "true")

  test.assertEqual(completionLabelAt(expectedBoolSource, 0), "enabled")
  test.assertEqual(completionLabelAt(expectedBoolSource, 1), "false")
  test.assertEqual(completionLabelAt(expectedBoolSource, 2), "true")
  test.assertEqual(completionLabelAt(expectedBoolSource, 3), "null")
  test.assertEqual(completionLabelAt(expectedModeSource, 0), "Mode.Safe")
  test.assertEqual(completionLabelAt(expectedModeSource, 1), "Mode.Fast")
  test.assertEqual(completionLabelAt(qualifiedModeSource, 0), "choices.Mode.Safe")
  test.assertTrue(genericModeItem != null)
  test.assertTrue(rankedTrue != null)
  if rankedTrue != null
    test.assertEqual(rankedTrue.get("sortText").value, "002")
  end
  if genericModeItem != null
    test.assertEqual(genericModeItem.get("data").get("identity").value, "alternative:choices.Choice.Some")
  end

  let incompleteHoverSource = "def main(): Void\n  let result = configureText(\"🙂\", sec|ond: )\nend\n"
  let incompleteHoverDocument = markedDocument(incompleteHoverSource)

  appendDocumentSource(incompleteHoverDocument, "untitled:named-argument-declarations", "def configureText(first: String, second: Bool = false): String\n  return first\nend\n")
  let incompleteHover = (new LspJsonParser(lspHover(incompleteHoverDocument, markerPosition(incompleteHoverSource)))).parse()
  let incompleteHoverStart = lspByteOffset(incompleteHoverDocument.text, incompleteHover.get("range").get("start"))
  let incompleteHoverEnd = lspByteOffset(incompleteHoverDocument.text, incompleteHover.get("range").get("end"))

  test.assertEqual(incompleteHover.get("contents").get("value").value, "second: Bool")
  test.assertEqual(incompleteHoverStart, bootstrapFindText(incompleteHoverDocument.text, "second:"))
  test.assertEqual(incompleteHoverEnd - incompleteHoverStart, host.stringByteLength("second"))

  let renameSource = declarations() + "\ndef main(): Void\n  let result = configure(second: true, first: 1)\nend\n"
  let snapshotForRename = new LspSemanticSnapshot()

  snapshotForRename.projectKey = "named-rename"
  snapshotForRename.projectRevision = 1
  snapshotForRename.renameClosedWorld = true
  snapshotForRename.sourceUris.add("file:///project/options.hk")
  snapshotForRename.renameOwnedSourceUris.add("file:///project/options.hk")
  snapshotForRename.sourceVersions.add(1)
  snapshotForRename.sourceTexts.add(renameSource)
  let analysis = lspAnalyzeRenameSnapshot(snapshotForRename, null, "")

  snapshotForRename.semantic = analysis.semantic
  snapshotForRename.sourceStarts = analysis.sourceStarts
  let renamed = lspRename(snapshotForRename, bootstrapFindText(renameSource, "first: Int"), "count")

  test.assertEqual(renamed.error, "")
  test.assertTrue(bootstrapFindText(renamed.value, "count") >= 0)

  let genericSource = declarations() + "\ndef main(): Void\n  let result = headOr(values: [1], fallback: 0)\nend\n"
  let genericSnapshot = new LspSemanticSnapshot()

  genericSnapshot.projectKey = "generic-named-rename"
  genericSnapshot.projectRevision = 1
  genericSnapshot.renameClosedWorld = true
  genericSnapshot.sourceUris.add("file:///project/generic-options.hk")
  genericSnapshot.renameOwnedSourceUris.add("file:///project/generic-options.hk")
  genericSnapshot.sourceVersions.add(1)
  genericSnapshot.sourceTexts.add(genericSource)
  let genericAnalysis = lspAnalyzeRenameSnapshot(genericSnapshot, null, "")

  genericSnapshot.semantic = genericAnalysis.semantic
  genericSnapshot.sourceStarts = genericAnalysis.sourceStarts
  let genericRenamed = lspRename(genericSnapshot, bootstrapFindText(genericSource, "fallback: 0"), "otherwise")

  test.assertEqual(genericRenamed.error, "")
  test.assertEqual(countText(genericRenamed.value, "\"newText\":\"otherwise\""), 3)

  let genericMarked = declarations() + "\ndef main(): Void\n  let result = headOr(values: [1], fall|back: 0)\nend\n"
  let genericDocument = markedDocument(genericMarked)
  let genericPosition = bootstrapFindText(genericMarked, "|")
  let genericDefinition = (new LspJsonParser(lspDefinition(genericDocument, genericPosition))).parse()
  let definitionStart = lspByteOffset(genericDocument.text, genericDefinition.get("range").get("start"))
  let genericHover = lspHover(genericDocument, genericPosition)

  test.assertEqual(definitionStart, bootstrapFindText(genericDocument.text, "fallback: T"))
  test.assertTrue(bootstrapFindText(genericHover, "fallback: Int") >= 0)

  let ambiguousGenericSource = "def identity<T>(value: T): T\n  return value\nend\n\ndef forward<T>(value: T): T\n  return iden|tity(value)\nend\n\ndef main(): Void\n  let number = forward(1)\n  let text = forward(\"value\")\nend\n"
  let ambiguousGenericDocument = markedDocument(ambiguousGenericSource)

  test.assertEqual(lspHover(ambiguousGenericDocument, markerPosition(ambiguousGenericSource)), "null")

  let snapshot = new SessionSourceSnapshot()

  snapshot.add("options.hk", declarations())
  let environment = new SessionEnvironment("named-options", snapshot)
  let invalid = environment.prepare("let result = configure(first: 1, second: 2)")

  test.assertEqual(invalid.status, "invalid")

  let parser = new BootstrapParser((new BootstrapLexer(declarations())).lex())
  let root = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, root, utf16Length(declarations()))

  binder.requireEntryPoint = false
  let retained = new SessionCompilation(binder.bind(), parser.arena, declarations())
  let query = "configure(sec: true, first: 1)"
  let completion = sessionCompleteSource(query, 13, 0, null, retained, null, "", new StringBuffer())
  var candidate = completion.first
  var second = false

  while candidate != null
    second = true if candidate.name == "second" && candidate.detail == "second: Bool"
    candidate = candidate.next
  end

  test.assertTrue(second)
end
