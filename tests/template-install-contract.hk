use console
use host
use process
use test

def templateFrame(text: String): String
  return "Content-Length: " + (host.stringByteLength(text) as String) + "\r\n\r\n" + text
end

def templateInstalledResponse(launcher: String, directory: String, source: String): LspJson
  let options = new process.SpawnOptions(launcher)
  let initialization = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"textDocument\":{\"completion\":{\"completionItem\":{\"snippetSupport\":true}}}}}}"
  let opened = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"untitled:installed-template\",\"version\":1,\"text\":" + lspQuote(source) + "}}}"
  let completion = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"untitled:installed-template\"},\"position\":{\"line\":0,\"character\":" + ((new IrSourceMap(source)).utf16Length() as String) + "}}}"
  let input = templateFrame(initialization) + templateFrame(opened) + templateFrame(completion) + templateFrame("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}") + templateFrame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
  var bytes: Byte[] = []
  var index = 0

  while index < host.stringByteLength(input)
    bytes = host.appendByte(bytes, host.stringByteAt(input, index))
    index = index + 1
  end
  options.arguments = ["lsp"]
  options.input = bytes
  options.workingDirectory = directory
  options.environment = [new process.EnvironmentEntry("NERI_TEMPLATE_CATALOG", "")]
  let started = process.spawn(options)
  let child = started.child()

  test.assertTrue(started.failure() == null && child != null)
  if child == null
    return new LspJson()
  end
  let completed = child.wait(30000)
  let status = completed.exit
  let text = host.stringFromBytes(completed.stdout)
  let errors = host.stringFromBytes(completed.stderr)

  console.println(errors) if errors != null && errors != ""

  test.assertTrue(!completed.running && completed.failure == null && status != null && status.value() == 0)
  test.assertTrue(child.dispose())
  test.assertTrue(text != null && !completed.stdoutTruncated)
  if text == null
    return new LspJson()
  end
  var remaining = text

  while host.stringByteLength(remaining) > 0
    let separator = bootstrapFindText(remaining, "\r\n\r\n")

    test.assertTrue(separator >= 0 && bootstrapStartsWith(remaining, "Content-Length: "))
    if separator < 0
      break
    end
    let length = host.parseInt(host.stringSlice(remaining, 16, separator - 16))

    test.assertTrue(length != null && length >= 0 && separator + 4 + length <= host.stringByteLength(remaining))
    if length == null
      break
    end
    let message = (new LspJsonParser(host.stringSlice(remaining, separator + 4, length))).parse()

    if message.get("id").scalarText() == "2"
      return message.get("result")
    end
    remaining = host.stringSlice(remaining, separator + 4 + length, host.stringByteLength(remaining) - separator - 4 - length)
  end

  test.assertTrue(false)
  return new LspJson()
end

def main(): Void
  let launcher = host.argumentAt(0)
  let catalogPath = host.argumentAt(1)
  let directory = host.argumentAt(2)
  let fixturePath = host.argumentAt(3)

  test.assertTrue(launcher != null && catalogPath != null && directory != null && fixturePath != null)
  if launcher == null || catalogPath == null || directory == null || fixturePath == null
    return
  end
  let original = host.readText(catalogPath)
  let fixture = host.readText(fixturePath)

  test.assertTrue(original != null && fixture != null)
  if original == null || fixture == null
    return
  end
  let baseline = templateInstalledResponse(launcher, directory, "de")

  test.assertTrue(baseline.get("items").first != null)
  let catalog = (new LspJsonParser(original)).parse()
  let entry = (new LspJsonParser(fixture)).parse().get("templates").first

  test.assertTrue(entry != null)
  if entry == null
    return
  end

  catalog.get("templates").add(entry)

  test.assertTrue(host.writeText(catalogPath, lspJsonStringify(catalog)))
  let extended = templateInstalledResponse(launcher, directory, entry.get("prefix").scalarText())
  let restored = host.writeText(catalogPath, original)
  let item = extended.get("items").first

  test.assertTrue(restored)
  test.assertTrue(item != null && item.get("label").scalarText() == entry.get("label").scalarText())
  if item != null
    test.assertEqual(item.get("insertTextFormat").scalarText(), "2")
    test.assertTrue(bootstrapFindText(item.get("textEdit").get("newText").scalarText(), "$0") >= 0)
  end
  console.println("Installed template discovery and data-only restart passed.")
end
