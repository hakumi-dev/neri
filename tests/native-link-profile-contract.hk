use host
use test
use console

def append32le(bytes: Byte[], value: Int): Byte[]
  var result = bytes
  var factor = 1

  while factor < 4294967296
    result = host::appendByte(result, ((value / factor) - (value / (factor * 256)) * 256) as Byte)
    factor = factor * 256
  end
  return result
end

def macOSImage(): Byte[]
  var bytes: Byte[] = []

  bytes = host::appendByte(bytes, 207 as Byte)
  bytes = host::appendByte(bytes, 250 as Byte)
  bytes = host::appendByte(bytes, 237 as Byte)
  bytes = host::appendByte(bytes, 254 as Byte)
  bytes = append32le(bytes, 16777228)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 2)
  bytes = append32le(bytes, 1)
  bytes = append32le(bytes, 24)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 50)
  bytes = append32le(bytes, 24)
  bytes = append32le(bytes, 1)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  return bytes
end

def append32be(bytes: Byte[], value: Int): Byte[]
  var result = bytes
  var factor = 16777216

  while factor > 0
    result = host::appendByte(result, ((value / factor) - (value / (factor * 256)) * 256) as Byte)
    factor = factor / 256
  end
  return result
end

def appendFatSlice(bytes: Byte[], image: Byte[], offset: Int, wide: Bool): Byte[]
  var result = append32be(bytes, nativeLinkObjectWord(image, 4))

  result = append32be(result, nativeLinkObjectWord(image, 8))
  result = append32be(result, 0) if wide
  result = append32be(result, offset)
  result = append32be(result, 0) if wide
  result = append32be(result, image.Length)
  result = append32be(result, 7)
  result = append32be(result, 0) if wide
  return result
end

def universalImage(first: Byte[], second: Byte[], wide: Bool): Byte[]
  var result = append32be([], wide ? 3405691583 : 3405691582)

  result = append32be(result, 2)
  # Deliberately reverse the table order: offsets determine the stream order.
  result = appendFatSlice(result, second, 256, wide)
  result = appendFatSlice(result, first, 128, wide)
  while result.Length < 128 result = host::appendByte(result, 0 as Byte) end
  for byte in first result = host::appendByte(result, byte) end
  while result.Length < 256 result = host::appendByte(result, 0 as Byte) end
  for byte in second result = host::appendByte(result, byte) end
  return result
end

def main(): Void
  let work = host::argumentAt(0)

  test::assertTrue(work != null)
  if work == null
    return
  end
  let directory = work + "/native-link-profile"
  let created = host::run("mkdir", ["-p", directory])
  let path = directory + "/tool"
  let valid = macOSImage()

  test::assertTrue(created != null && created == 0)
  test::assertTrue(host::writeBytes(path, valid))
  test::assertTrue(nativeLinkProfile(path))

  var embedded = valid

  embedded = append32le(embedded, 2147483687)
  embedded = append32le(embedded, 16)
  embedded = append32le(embedded, 0)
  embedded = append32le(embedded, 0)
  embedded[16] = 2 as Byte
  embedded[20] = 40 as Byte

  test::assertTrue(host::writeBytes(path, embedded))
  test::assertTrue(!nativeLinkProfile(path))

  var wrongPlatform = valid

  wrongPlatform[40] = 2 as Byte

  test::assertTrue(host::writeBytes(path, wrongPlatform))
  test::assertTrue(!nativeLinkProfile(path))

  var malformed = valid

  malformed[36] = 0 as Byte
  malformed[37] = 0 as Byte
  malformed[38] = 0 as Byte
  malformed[39] = 0 as Byte

  test::assertTrue(host::writeBytes(path, malformed))
  test::assertTrue(!nativeLinkProfile(path))

  var truncated = valid

  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated[16] = 2 as Byte
  truncated[20] = 28 as Byte

  test::assertTrue(host::writeBytes(path, truncated))
  test::assertTrue(!nativeLinkProfile(path))

  var unsupported = valid

  unsupported[0] = 202 as Byte
  unsupported[1] = 254 as Byte
  unsupported[2] = 186 as Byte
  unsupported[3] = 190 as Byte

  test::assertTrue(host::writeBytes(path, unsupported))
  test::assertTrue(!nativeLinkProfile(path))

  var arm64e = macOSImage()

  arm64e[8] = 2 as Byte
  arm64e[11] = 128 as Byte

  test::assertTrue(host::writeBytes(path, arm64e))
  test::assertTrue(nativeLinkProfile(path))

  for subtype in [1, 3, 12, 4]
    var image = macOSImage()

    image[8] = subtype as Byte

    test::assertTrue(host::writeBytes(path, image))
    test::assertEqual(nativeLinkProfile(path), subtype != 4)
  end

  var x86 = macOSImage()

  x86[4] = 7 as Byte
  x86[8] = 3 as Byte
  for wide in [false, true]
    let universal = universalImage(x86, arm64e, wide)

    test::assertTrue(host::writeBytes(path, universal))
    test::assertTrue(nativeLinkProfile(path))
    test::assertTrue(host::writeBytes(path, universalImage(macOSImage(), arm64e, wide)))
    test::assertTrue(nativeLinkProfile(path))
    test::assertTrue(host::writeBytes(path, universalImage(embedded, arm64e, wide)))
    test::assertTrue(!nativeLinkProfile(path))
    test::assertTrue(host::writeBytes(path, universalImage(x86, wrongPlatform, wide)))
    test::assertTrue(!nativeLinkProfile(path))
    test::assertTrue(host::writeBytes(path, universalImage(x86, x86, wide)))
    test::assertTrue(!nativeLinkProfile(path))

    var mismatch = universalImage(x86, arm64e, wide)

    mismatch[264] = 0 as Byte

    test::assertTrue(host::writeBytes(path, mismatch))
    test::assertTrue(!nativeLinkProfile(path))

    var overlap = universalImage(x86, arm64e, wide)
    let offset = wide ? 20 : 16

    overlap[offset + 2] = 0 as Byte
    overlap[offset + 3] = 128 as Byte

    test::assertTrue(host::writeBytes(path, overlap))
    test::assertTrue(!nativeLinkProfile(path))

    var outside = universalImage(x86, arm64e, wide)

    outside[offset] = 127 as Byte

    test::assertTrue(host::writeBytes(path, outside))
    test::assertTrue(!nativeLinkProfile(path))

    var unaligned = universalImage(x86, arm64e, wide)

    unaligned[offset + 3] = 1 as Byte

    test::assertTrue(host::writeBytes(path, unaligned))
    test::assertTrue(!nativeLinkProfile(path))

    if wide
      var overflow = universalImage(x86, arm64e, wide)

      overflow[16] = 1 as Byte

      test::assertTrue(host::writeBytes(path, overflow))
      test::assertTrue(!nativeLinkProfile(path))
    end
  end

  # Additional real tools let the same contract validate host-provided images.
  var argument = 1
  var tool = host::argumentAt(argument)

  while tool != null
    console::println("Checking host Mach-O profile: " + tool)

    test::assertTrue(nativeLinkProfile(tool))
    argument = argument + 1
    tool = host::argumentAt(argument)
  end

  test::assertTrue(host::removeFile(path))
end
