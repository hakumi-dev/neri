use host
use test

def append32le(bytes: Byte[], value: Int): Byte[]
  var result = bytes
  var factor = 1

  while factor < 4294967296
    result = host::appendByte(result, ((value / factor) - (value / (factor * 256)) * 256) as Byte)
    factor = factor * 256
  end
  return result
end

def macOSImage(): Byte[]
  var bytes: Byte[] = []

  bytes = host::appendByte(bytes, 207 as Byte)
  bytes = host::appendByte(bytes, 250 as Byte)
  bytes = host::appendByte(bytes, 237 as Byte)
  bytes = host::appendByte(bytes, 254 as Byte)
  bytes = append32le(bytes, 16777228)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 2)
  bytes = append32le(bytes, 1)
  bytes = append32le(bytes, 24)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 50)
  bytes = append32le(bytes, 24)
  bytes = append32le(bytes, 1)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  bytes = append32le(bytes, 0)
  return bytes
end

def main(): Void
  let work = host::argumentAt(0)

  test::assertTrue(work != null)
  if work == null
    return
  end
  let directory = work + "/native-link-profile"
  let created = host::run("mkdir", ["-p", directory])
  let path = directory + "/tool"
  let valid = macOSImage()

  test::assertTrue(created != null && created == 0)
  test::assertTrue(host::writeBytes(path, valid))
  test::assertTrue(nativeLinkProfile(path))

  var embedded = valid

  embedded = append32le(embedded, 2147483687)
  embedded = append32le(embedded, 16)
  embedded = append32le(embedded, 0)
  embedded = append32le(embedded, 0)
  embedded[16] = 2 as Byte
  embedded[20] = 40 as Byte

  test::assertTrue(host::writeBytes(path, embedded))
  test::assertTrue(!nativeLinkProfile(path))

  var wrongPlatform = valid

  wrongPlatform[40] = 2 as Byte

  test::assertTrue(host::writeBytes(path, wrongPlatform))
  test::assertTrue(!nativeLinkProfile(path))

  var malformed = valid

  malformed[36] = 0 as Byte
  malformed[37] = 0 as Byte
  malformed[38] = 0 as Byte
  malformed[39] = 0 as Byte

  test::assertTrue(host::writeBytes(path, malformed))
  test::assertTrue(!nativeLinkProfile(path))

  var truncated = valid

  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated = host::appendByte(truncated, 0 as Byte)
  truncated[16] = 2 as Byte
  truncated[20] = 28 as Byte

  test::assertTrue(host::writeBytes(path, truncated))
  test::assertTrue(!nativeLinkProfile(path))

  var unsupported = valid

  unsupported[0] = 202 as Byte
  unsupported[1] = 254 as Byte
  unsupported[2] = 186 as Byte
  unsupported[3] = 190 as Byte

  test::assertTrue(host::writeBytes(path, unsupported))
  test::assertTrue(!nativeLinkProfile(path))
  test::assertTrue(host::removeFile(path))
end
