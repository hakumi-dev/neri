use math

def add(left: Int, right: Int): Int
  return left + right
end

def twice(value: Int): Int
  return add(value, value)
end

def integer_mix(left: Int, right: Int): Int
  return ((-left + right) * 3 - 6) / 3
end

def choose(flag: Bool, left: Int, right: Int): Int
  if flag
    return left
  else
    return right
  end
end

def sum_to(limit: Int): Int
  var index = 0
  var total = 0

  while index < limit
    index = index + 1
    total = total + index
  end
  return total
end

def float_mix(left: Float, right: Float): Float
  return (-left + right) * 2.0
end

def float_divide(left: Float, right: Float): Float
  return (left - right) / right
end

def float_equal(left: Float, right: Float): Bool
  return left == right
end

def float_less(left: Float, right: Float): Bool
  return left < right
end

def bool_logic(left: Bool, right: Bool): Bool
  return !left || right
end

def byte_roundtrip(value: Int): Int
  let narrowed = value as Byte

  return narrowed as Int
end

def cast_roundtrip(value: Int): Int
  return (value as Float) as Int
end

def optional_some(value: Int): Int?
  return value
end

def optional_identity(value: Int?): Int?
  return value
end

def optional_via_call(value: Int?): Int?
  return optional_identity(value)
end

def optional_none(): Int?
  return null
end

def optional_get(value: Int?): Int
  if value != null
    return value
  end
  return 0
end

def optional_equal(left: Int?, right: Int?): Bool
  return left == right
end

def reference_result(): Int
  let arithmetic = integer_mix(2, 10)
  let called = twice(18)
  let branched = choose(false, 100, 10)
  let looped = sum_to(4)

  return arithmetic + called + branched - looped
end

def runtime_roundtrip(value: Int): Int
  return math::abs(value)
end

def main(): Void
  return
end
