class __NeriSessionState0
  public value: Int

  def init(value: Int): Void
    this.value = value
  end
end

class __NeriSessionState1
  public __neri_session_previous: __NeriSessionState0
  public observed: Int

  def init(previous: __NeriSessionState0, observed: Int): Void
    this.__neri_session_previous = previous
    this.observed = observed
  end
end

def __neri_session_entry(previous: __NeriSessionState0): __NeriSessionState1
  previous.value = previous.value + 1
  return new __NeriSessionState1(previous, previous.value)
end
