use test

def modelParityEntities(): String
  return "\nclass Animal\n  public id: Int\n  public label: String\nend\n\nclass Dog: Animal\n  public barks: Bool\nend\n\nclass Cat: Animal\n  public lives: Int\nend\n\nclass LeftSide\n  public id: Int\n  public links: SideLink[] = []\n  public partners: RightSide[] = []\nend\n\nclass RightSide\n  public id: Int\n  public links: SideLink[] = []\n  public partners: LeftSide[] = []\nend\n\nclass SideLink\n  public leftId: Int\n  public rightId: Int\n  public left: LeftSide?\n  public right: RightSide?\nend\n"
end

def modelParityMapping(): String
  var output = "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"mapped_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":["

  output = output + "{\"type\":\"model.Animal\",\"set\":\"animals\",\"table\":\"animals\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"label\",\"column\":\"label\"}],\"hierarchy\":{\"strategy\":\"tph\",\"discriminatorColumn\":\"kind\",\"value\":\"animal\",\"derivedTypes\":[{\"type\":\"model.Dog\",\"value\":\"dog\",\"columns\":[{\"member\":\"barks\",\"column\":\"barks\"}]},{\"type\":\"model.Cat\",\"value\":\"cat\",\"columns\":[{\"member\":\"lives\",\"column\":\"lives\"}]}]}} ,"
  output = output + "{\"type\":\"model.LeftSide\",\"set\":\"lefts\",\"table\":\"lefts\",\"key\":\"id\",\"keyGeneration\":\"onAdd\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"}]},"
  output = output + "{\"type\":\"model.RightSide\",\"set\":\"rights\",\"table\":\"rights\",\"key\":\"id\",\"keyGeneration\":\"onAdd\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"}]},"
  output = output + "{\"type\":\"model.SideLink\",\"set\":\"links\",\"table\":\"links\",\"key\":[\"leftId\",\"rightId\"],\"columns\":[{\"member\":\"leftId\",\"column\":\"left_id\"},{\"member\":\"rightId\",\"column\":\"right_id\"}]},"
  output = output + "{\"type\":\"model.BoolRecord\",\"set\":\"flags\",\"table\":\"flags\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"flag\",\"column\":\"flag\",\"conversion\":\"boolToInt\"},{\"member\":\"optionalFlag\",\"column\":\"optional_flag\",\"conversion\":\"boolToInt\"}],\"seeds\":[{\"id\":9,\"flag\":true,\"optionalFlag\":null}] }],"
  output = output + "\"relations\":[{\"principal\":\"model.LeftSide\",\"dependent\":\"model.SideLink\",\"key\":\"id\",\"foreignKey\":\"leftId\",\"collection\":\"links\",\"reference\":\"left\"},{\"principal\":\"model.RightSide\",\"dependent\":\"model.SideLink\",\"key\":\"id\",\"foreignKey\":\"rightId\",\"collection\":\"links\",\"reference\":\"right\"}],"
  output = output + "\"manyToMany\":[{\"name\":\"partners\",\"left\":\"model.LeftSide\",\"right\":\"model.RightSide\",\"join\":\"model.SideLink\",\"leftForeignKey\":\"leftId\",\"rightForeignKey\":\"rightId\",\"leftCollection\":\"partners\",\"rightCollection\":\"partners\"}]}"
  return output
end

def schemaMappingCheckModelParity(root: String): Void
  let mapping = schemaMappingLoad(root, modelParityMapping())

  test::assertEqual(mapping.error, "")
  let declarations = "use reference\nuse neri_data\nuse neri_data_sqlite\nuse neri_data_sqlite_fixture\n\ndef one<T>(rows: QueryResult<T>): T?\n  match rows\n    case QueryResult.Rows(value)\n      let first = value.first()\n\n      return first == null ? null : first.value\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n      return null\n  end\nend\n\ndef saved(result: WriteResult, count: Int): Void\n  match result\n    case WriteResult.Saved(actual)\n      test::assertEqual(actual, count)\n    case WriteResult.SavedWithValues(actual, unused)\n      test::assertEqual(actual, count)\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n\n      test::assertTrue(false)\n  end\nend\n\n"
  let schema = "CREATE TABLE animals(id INTEGER PRIMARY KEY,label TEXT NOT NULL,barks INTEGER,lives INTEGER,kind TEXT NOT NULL); INSERT INTO animals VALUES(1,'dog',1,NULL,'dog'),(2,'base',NULL,NULL,'animal'),(3,'other dog',0,NULL,'dog'); CREATE TABLE lefts(id INTEGER PRIMARY KEY); CREATE TABLE rights(id INTEGER PRIMARY KEY); CREATE TABLE links(left_id INTEGER NOT NULL REFERENCES lefts(id),right_id INTEGER NOT NULL REFERENCES rights(id),PRIMARY KEY(left_id,right_id)); INSERT INTO lefts VALUES(1); INSERT INTO rights VALUES(1); INSERT INTO links VALUES(1,1);"
  let body = "  let schema = schema_Database()\n  let flags = schema.find(\"model.BoolRecord\")\n\n  test::assertTrue(schema.validate() == null)\n  test::assertTrue(flags != null)\n  if flags != null\n    test::assertEqual(flags.seedCount(), 1)\n  end\n  let path = " + lspQuote(root + "/model-parity.sqlite") + "\n\n  test::assertTrue(createSQLiteFixture(path, " + lspQuote(schema) + "))\n  match SQLiteProvider.openWritable(path)\n    case SQLiteOpenResult.Failure(message)\n      test::assertTrue(false)\n    case SQLiteOpenResult.Opened(provider)\n      let database = new Database(provider)\n      let root = one(database.animals.where(id: 1).all())\n      let typed = one(database.ofType_Dog().take(10).all())\n\n      test::assertTrue(root != null && typed != null)\n      if root != null && typed != null\n        test::assertTrue(reference::same(root, typed))\n        typed.barks = false\n        saved(database.saveChanges(), 1)\n        let fresh = new Database(provider)\n        let stored = one(fresh.ofType_Dog().take(10).all())\n\n        test::assertTrue(stored != null)\n        if stored != null\n          test::assertFalse(stored.barks)\n        end\n      end\n      let rejected = new Database(provider)\n      let wrong = new model::Cat()\n\n      wrong.id = 1\n      wrong.label = \"wrong subtype\"\n      wrong.lives = 9\n\n      test::assertTrue(rejected.animals.attach(wrong) == null)\n      match rejected.ofType_Dog().take(10).all()\n        case QueryResult.Rows(rows)\n          test::assertTrue(false)\n        case QueryResult.Failure(error)\n          test::assertTrue(true)\n      end\n      match rejected.animals.take(10).all()\n        case QueryResult.Rows(rows)\n          test::assertTrue(false)\n        case QueryResult.Failure(error)\n          test::assertTrue(true)\n      end\n      let untouched = new model::Dog()\n\n      untouched.id = 3\n      untouched.label = \"other dog\"\n      untouched.barks = false\n\n      test::assertTrue(rejected.animals.stateOf(untouched) == null)\n      let left = one(database.include_partners())\n\n      test::assertTrue(left != null)\n      if left != null\n        test::assertEqual(left.partners.Length, 1)\n        let right = left.partners[0]\n\n        test::assertEqual(right.partners.Length, 1)\n        test::assertTrue(reference::same(right.partners[0], left))\n      end\n      verifySkipRollback(provider)\n      verifySkipAsync(path)\n\n      let newLeft = new model::LeftSide()\n      let newRight = new model::RightSide()\n\n      newLeft.id = 0\n      newRight.id = 0\n\n      test::assertTrue(database.link_partners(newLeft, newRight) == null)\n      let secondLeft = new model::LeftSide()\n      let secondRight = new model::RightSide()\n\n      test::assertTrue(database.link_partners(secondLeft, secondRight) == null)\n      let temporaryLeft = newLeft.id\n      let temporaryRight = newRight.id\n      let temporarySecondLeft = secondLeft.id\n      let temporarySecondRight = secondRight.id\n\n      test::assertTrue(temporaryLeft < 0 && temporaryRight < 0)\n      test::assertTrue(temporarySecondLeft < 0 && temporarySecondRight < 0)\n      test::assertTrue(temporaryLeft != temporarySecondLeft && temporaryRight != temporarySecondRight)\n      saved(database.beginTransaction(), 0)\n      saved(database.saveChanges(), 6)\n\n      test::assertTrue(newLeft.id > 1 && newRight.id > 1)\n      test::assertTrue(secondLeft.id > 1 && secondRight.id > 1)\n      test::assertEqual(newLeft.links.Length, 1)\n      test::assertEqual(secondLeft.links.Length, 1)\n      test::assertEqual(newLeft.links[0].leftId, newLeft.id)\n      test::assertEqual(newLeft.links[0].rightId, newRight.id)\n      test::assertEqual(secondLeft.links[0].leftId, secondLeft.id)\n      test::assertEqual(secondLeft.links[0].rightId, secondRight.id)\n      saved(database.rollbackTransaction(), 0)\n\n      test::assertEqual(newLeft.id, temporaryLeft)\n      test::assertEqual(newRight.id, temporaryRight)\n      test::assertEqual(secondLeft.id, temporarySecondLeft)\n      test::assertEqual(secondRight.id, temporarySecondRight)\n      test::assertEqual(newLeft.links[0].leftId, temporaryLeft)\n      test::assertEqual(newLeft.links[0].rightId, temporaryRight)\n      test::assertEqual(secondLeft.links[0].leftId, temporarySecondLeft)\n      test::assertEqual(secondLeft.links[0].rightId, temporarySecondRight)\n      test::assertTrue(reference::same(newLeft.partners[0], newRight))\n      test::assertTrue(reference::same(secondLeft.partners[0], secondRight))\n      saved(database.saveChanges(), 6)\n      saved(database.saveChanges(), 0)\n\n      test::assertTrue(newLeft.id > 1 && newRight.id > 1)\n      test::assertTrue(secondLeft.id > 1 && secondRight.id > 1)\n      test::assertEqual(newLeft.links[0].leftId, newLeft.id)\n      test::assertEqual(newLeft.links[0].rightId, newRight.id)\n      test::assertEqual(secondLeft.links[0].leftId, secondLeft.id)\n      test::assertEqual(secondLeft.links[0].rightId, secondRight.id)\n      let unlinking = new Database(provider)\n      let loaded = one(unlinking.include_partners())\n\n      test::assertTrue(loaded != null)\n      if loaded != null\n        let partner = loaded.partners[0]\n\n        test::assertTrue(unlinking.unlink_partners(loaded, partner) == null)\n        saved(unlinking.saveChanges(), 1)\n\n        test::assertEqual(loaded.partners.Length, 0)\n        test::assertEqual(partner.partners.Length, 0)\n      end\n      test::assertTrue(provider.close())\n  end\n"

  schemaMappingRunConsumer(
    root,
    mapping,
    "model-parity-consumer",
    body,
    declarations + modelParityRollbackDeclarations(),
    sqlite: true
  )
end

def modelParityRollbackDeclarations(): String
  var result = "class RollbackProvider: Provider\n  private inner: SQLiteProvider\n  private reads: Int = 0\n\n  def init(inner: SQLiteProvider): Void\n    this.inner = inner\n  end\n\n  public override readonly def dialect(): SqlDialect\n    return this.inner.dialect()\n  end\n\n  public override readonly def supports(capability: ProviderCapability): Bool\n    return this.inner.supports(capability)\n  end\n\n  public override def execute(plan: readonly SqlPlan): ProviderResult\n    this.reads = this.reads + 1\n    if this.reads == 6\n      return ProviderResult.Failure(ProviderFailure.State(\"right read failed\"))\n    end\n    return this.inner.execute(plan)\n  end\n\n  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult\n    this.reads = this.reads + 1\n    if this.reads == 6\n      return StreamResult.Failure(QueryFailure.Provider(ProviderFailure.State(\"right read failed\")), 0)\n    end\n    return this.inner.stream(plan, visit)\n  end\nend\n\n"

  result = result + "def loadState(state: NavigationLoadState): Int\n  match state\n    case NavigationLoadState.Unknown()\n      return 0\n    case NavigationLoadState.Loading()\n      return 1\n    case NavigationLoadState.Partial()\n      return 2\n    case NavigationLoadState.Loaded()\n      return 3\n  end\nend\n\n"
  result = result + "def verifySkipRollback(provider: SQLiteProvider): Void\n  let database = new Database(new RollbackProvider(provider))\n  let left = one(database.lefts.all())\n  let join = one(database.links.all())\n  let right = one(database.rights.all())\n\n  test::assertTrue(left != null && join != null && right != null)\n  if left == null || join == null || right == null\n    return\n  end\n  let beforeLeft = left.links\n  let beforeRight = right.links\n  let beforeLeftPartners = left.partners\n  let beforeRightPartners = right.partners\n  let leftState = loadState(database.collectionState_linksFor_LeftSide_by_leftId(left))\n  let rightState = loadState(database.collectionState_linksFor_RightSide_by_rightId(right))\n  let beforeLeftRef = join.left\n  let beforeRightRef = join.right\n\n  match database.include_partners()\n    case QueryResult.Rows(rows)\n      test::assertTrue(false)\n    case QueryResult.Failure(error)\n      test::assertTrue(true)\n  end\n\n  test::assertEqual(left.links.Length, beforeLeft.Length)\n  if left.links.Length > 0 && beforeLeft.Length > 0\n    test::assertTrue(reference::same(left.links[0], beforeLeft[0]))\n  end\n  test::assertEqual(right.links.Length, beforeRight.Length)\n  if right.links.Length > 0 && beforeRight.Length > 0\n    test::assertTrue(reference::same(right.links[0], beforeRight[0]))\n  end\n  test::assertEqual(left.partners.Length, beforeLeftPartners.Length)\n  test::assertEqual(right.partners.Length, beforeRightPartners.Length)\n  test::assertEqual(beforeLeftPartners.Length, 1)\n  test::assertEqual(beforeRightPartners.Length, 1)\n  if left.partners.Length > 0 && beforeLeftPartners.Length > 0\n    test::assertTrue(reference::same(left.partners[0], beforeLeftPartners[0]))\n  end\n  if right.partners.Length > 0 && beforeRightPartners.Length > 0\n    test::assertTrue(reference::same(right.partners[0], beforeRightPartners[0]))\n  end\n  test::assertEqual(loadState(database.collectionState_linksFor_LeftSide_by_leftId(left)), leftState)\n  test::assertEqual(loadState(database.collectionState_linksFor_RightSide_by_rightId(right)), rightState)\n  test::assertTrue(beforeLeftRef != null && beforeRightRef != null)\n  let afterLeft = join.left\n  let afterRight = join.right\n  if beforeLeftRef != null && beforeRightRef != null && afterLeft != null && afterRight != null\n    test::assertTrue(reference::same(beforeLeftRef, afterLeft))\n    test::assertTrue(reference::same(beforeRightRef, afterRight))\n  else\n    test::assertTrue(false)\n  end\nend\n\n"
  result = result + "def loadSkipAsync(database: Database): resources::Outcome<Int, QueryFailure>\n  using operation <- database.include_partnersAsync(options: new StreamOptions(timeoutMilliseconds: 10000))\n    while true\n      match operation.poll()\n        case AsyncQueryPoll.Pending(socket, interest)\n          continue\n        case AsyncQueryPoll.Completed(result)\n          match result\n            case QueryResult.Failure(error)\n              return error\n            case QueryResult.Rows(rows)\n              let left = rows.first()\n\n              test::assertTrue(left != null)\n              if left != null\n                test::assertEqual(left.value.partners.Length, 1)\n                let right = left.value.partners[0]\n\n                test::assertEqual(right.partners.Length, 1)\n                test::assertTrue(reference::same(right.partners[0], left.value))\n              end\n              return rows.count()\n          end\n      end\n    end\n    return QueryFailure.UnsupportedCapability(\"async skip navigation did not complete\")\n  end\n  return 1\nend\n\ndef verifySkipAsync(path: String): Void\n  match SQLiteAsyncProvider.open(path)\n    case result::Result.Error(error)\n      test::assertTrue(false)\n    case result::Result.Ok(provider)\n      let outcome = loadSkipAsync(new Database(provider))\n\n      test::assertEqual(outcome.closeFailures.count(), 0)\n      match outcome.completion\n        case resources::Completion.Value(count)\n          test::assertEqual(count, 1)\n        case resources::Completion.Failure(error)\n          test::assertTrue(false)\n      end\n\n      test::assertTrue(provider.closeFailure() == null)\n  end\nend\n"
  return result
end
