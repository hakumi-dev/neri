use host
use process
use test

def capture(options: process.SpawnOptions): process.PollResult
  let started = process.spawn(options)
  let child = started.child()

  test.assertTrue(started.failure() == null && child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(5000)
  let disposed = child.dispose()
  let status = completed.exit

  test.assertTrue(disposed)
  test.assertTrue(completed.failure == null && !completed.running && status != null)
  if status != null
    test.assertTrue(status.isExited())
    test.assertEqual(status.value(), 0)
  end
  return completed
end

def main(): Void
  let fixture = host.argumentAt(1)

  test.assertTrue(fixture != null)
  if fixture == null
    return
  end
  let options = new process.SpawnOptions(fixture)
  let redirected = capture(options)
  let redirectedText = host.stringFromBytes(redirected.stdout)

  test.assertTrue(redirectedText != null && redirectedText == "redirected\n")
  options.terminal = true
  let terminal = capture(options)
  let terminalText = host.stringFromBytes(terminal.stdout)

  test.assertTrue(terminalText != null && terminalText == "terminal\r\n")
  test.assertEqual(terminal.stderr.Length, 0)
  test.assertTrue(!terminal.stdoutTruncated)
  options.arguments = ["burst"]
  options.stdoutLimit = 31
  let burst = capture(options)

  test.assertEqual(burst.stdout.Length, 31)
  test.assertTrue(burst.stdoutTruncated)
  let missingOptions = new process.SpawnOptions(fixture + ".missing")

  missingOptions.terminal = true
  let missing = process.spawn(missingOptions)

  test.assertTrue(missing.child() == null && missing.failure() != null)
  options.input = [1 as Byte]
  let invalid = process.spawn(options)

  test.assertTrue(invalid.child() == null && invalid.failure() != null)
end
