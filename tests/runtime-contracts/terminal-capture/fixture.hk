use console
use host

@cabi("isatty")
unsafe def isTerminal(fd: Int32): Int32
end

def main(): Void
  var attached = false

  unsafe
    attached = isTerminal(0 as Int32) == (1 as Int32) && isTerminal(1 as Int32) == (1 as Int32) && isTerminal(2 as Int32) == (1 as Int32)
  end
  let mode = host.argumentAt(0)

  if mode != null && mode == "burst"
    var index = 0

    while index < 16384
      console.print("0123456789abcdef")
      index = index + 1
    end
  else if attached
    console.println("terminal")
  else
    console.println("redirected")
  end
end
