use host
use http
use httpclient
use process
use result
use test

def fetch(port: Int, method: String, path: String): httpclient.Response?
  match httpclient.request(port, method, path)
    case result.Result.Ok(response)
      return response
    case result.Result.Error(failure)
      return null
  end
end

def main(): Void
  let fixture = host.argumentAt(1)

  test.assertTrue(fixture != null)
  if fixture == null
    return
  end
  let spawnOptions = new process.SpawnOptions(fixture)
  let child = process.spawn(spawnOptions).child()

  test.assertTrue(child != null)
  if child == null
    return
  end
  var port: Int? = null
  let deadline = httpclient.now() + 5000

  while port == null && httpclient.now() < deadline
    let snapshot = child.wait(20)

    if snapshot.stdout.Length > 0
      let text = host.stringFromBytes(snapshot.stdout)

      if text != null
        let newline = http.find(text, "\n", 0)

        if newline > 0
          port = host.parseInt(host.stringSlice(text, 0, newline))
        end
      end
    end
  end

  test.assertTrue(port != null)
  if port == null
    child.cancel()
    child.dispose()
    return
  end
  let raw = fetch(port, "GET", "/../a%2Fb?q=%E2%82%AC")

  test.assertTrue(raw != null)
  if raw != null
    test.assertEqual(raw.status, 200)
    test.assertEqual(raw.headerValues("set-cookie").Length, 2)
    let text = raw.text()

    test.assertTrue(text != null)
    if text != null
      test.assertEqual(text, "GET /../a%2Fb?q=%E2%82%AC")
    end
  end
  let headed = fetch(port, "HEAD", "/")

  test.assertTrue(headed != null)
  if headed != null
    test.assertEqual(headed.body.Length, 0)
  end
  let binary = fetch(port, "GET", "/binary")

  test.assertTrue(binary != null)
  if binary != null
    test.assertEqual(binary.body.Length, 9000)
    test.assertEqual(binary.body[0] as Int, 0)
    test.assertEqual(binary.body[4097] as Int, 81)
    test.assertEqual(binary.body[8999] as Int, 214)
  end
  let posted = fetch(port, "POST", "/sent")

  test.assertTrue(posted != null)
  if posted != null
    test.assertEqual(posted.status, 405)
    let allow = posted.header("Allow")

    test.assertTrue(allow != null)
    if allow != null
      test.assertEqual(allow, "GET, HEAD")
    end
  end
  let timeoutOptions = new httpclient.Options()

  timeoutOptions.timeoutMilliseconds = 40
  match httpclient.get(port, "/timeout", null, timeoutOptions)
    case result.Result.Ok(response)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.code, "timeout")
      test.assertEqual(failure.operation, "response.read")
  end
  let completed = child.wait(5000)
  let exited = completed.exit

  test.assertTrue(completed.failure == null && !completed.running && exited != null)
  if exited != null
    test.assertEqual(exited.value(), 0)
  end

  test.assertTrue(child.dispose())
end
