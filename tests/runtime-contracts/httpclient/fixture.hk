use console
use http
use tasks

@cabiImport("neri_rt_v1_net_local_port")
unsafe def localPort(fd: Int): Int
end

def main(): Void
  unsafe
    let listener = http.netOpen()

    if listener < 0 || http.netConfigure(listener) != 0 || http.netBind(listener, 0) != 0 || http.netListen(listener) != 0
      http.netClose(listener) if listener >= 0
      return
    end
    let port = localPort(listener)

    if port < 1
      http.netClose(listener)
      return
    end
    console.println(port as String)
    var requests = 0

    while requests < 5
      if http.netPoll(listener, 0, 5000) <= 0
        http.netClose(listener)
        return
      end
      let client = http.netAccept(listener)

      if client >= 0
        http.netConfigure(client)
        requests = requests + 1
        if requests == 5
          http.readHead(client)
          let deadline = http.netMilliseconds() + 250

          while http.netMilliseconds() < deadline
          end
          http.netClose(client)
        else
          let binary: Byte[] = tasks.generate(9000, 1) do |index|
            return (index - (index / 251) * 251) as Byte
          end
          let handler: fn(http.Request): http.Response = fn(request)
            var response = http.binary(200, binary)

            if request.path != "/binary"
              if request.method == "HEAD"
                response = http.text(200, "not sent")
              else
                response = http.text(200, request.method + " " + request.path + "?" + request.query)
              end
            end
            response.headers.add("Set-Cookie", "a=1")
            response.headers.add("set-cookie", "b=2")
            return response
          end

          http.connection(client, handler, null)
        end
      end
    end
    http.netClose(listener)
  end
end
