use console
use host
use process
use test

@cabi("getpid")
def unsafe processId(): Int32
end

def outputText(bytes: Byte[]): String
  let text = host.stringFromBytes(bytes)
  if text != null
    return text
  end
  return "<non-utf8 output>"
end

def runCase(executable: String, mode: String, port: Int, expected: Int): Void
  let options = new process.SpawnOptions(executable)
  options.arguments = [mode, port as String]
  let started = process.spawn(options)
  let child = started.child()
  test.assertTrue(child != null)
  if child == null
    return
  end
  let completed = child.wait(5000)
  let exit = completed.exit
  let disposed = child.dispose()
  var failed = completed.running || completed.failure != null || exit == null || !disposed
  if exit != null && exit.value != expected
    failed = true
  end
  if failed
    console.println("HTTP drain failure mode=" + mode + " expected=" + (expected as String))
    if exit != null
      console.println("exit=" + (exit.value as String) + " kind=" + exit.kind)
    else
      console.println("exit=<none>")
    end
    console.println("stdout: " + outputText(completed.stdout))
    console.println("stderr: " + outputText(completed.stderr))
  end
  test.assertTrue(disposed && !completed.running && completed.failure == null && exit != null)
  if exit != null
    test.assertEqual(exit.value, expected)
  end
end

def main(): Void
  let fixture = host.argumentAt(1)
  test.assertTrue(fixture != null)
  if fixture == null
    return
  end
  var port = 0
  unsafe
    let pid = processId() as Int
    port = 40000 + pid - (pid / 10000) * 10000
  end
  runCase(fixture, "normal", port, 0)
  runCase(fixture, "forced-stop", port, 124)
  runCase(fixture, "forced-signal", port, 124)
  runCase(fixture, "idle-signal", port, 0)
  runCase(fixture, "normal", port, 0)
end
