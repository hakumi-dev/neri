use host
use http
use resources
use result
use test

@cabiImport("neri_rt_v1_net_connect")
unsafe def connectLocal(fd: Int, port: Int): Int
end
@cabiImport("getpid")
unsafe def processId(): Int32
end
@cabiImport("kill")
unsafe def sendSignal(process: Int32, signal: Int32): Int32
end

def signalSelf(): Int
  unsafe
    return sendSignal(processId(), 15 as Int32) as Int
  end
end

class State
  public client: Int = -1
  public responseComplete: Bool = false
end

def serveOnce(port: Int, mode: String): Void
  let stop = new http::Stop()
  let options = new http::Options()
  let state = new State()

  options.stop = stop
  options.forceExitAfterStopMilliseconds = 100
  options.handleInterrupts = mode == "forced-signal" || mode == "idle-signal"
  options.onListening = fn(address)
    if mode == "idle-signal"
      test::assertEqual(signalSelf(), 0)
    else
      unsafe
        state.client = http::netOpen()

        test::assertEqual(connectLocal(state.client, port), 0)
        test::assertEqual(http::netConfigure(state.client), 0)
      end

      test::assertTrue(http::writeText(state.client, "GET / HTTP/1.1\r\nHost: local\r\n\r\n"))
    end
  end
  options.onConnection = fn(outcome)
    match outcome
      case result::Result.Ok(exchange)
        state.responseComplete = exchange.status == 200 && exchange.bytesWritten > 0
      case result::Result.Error(failure)
        state.responseComplete = false
    end
  end
  let handler: fn(http::Request): http::Response = fn(request)
    if mode == "forced-stop"
      stop.request()
      while true
      end
    end
    if mode == "forced-signal"
      test::assertEqual(signalSelf(), 0)
      while true
      end
    end
    stop.request()
    return http::text(200, "complete")
  end

  test::assertTrue(http::serveResult("127.0.0.1:" + (port as String), handler, options) == null)
  if state.client >= 0
    test::assertTrue(state.responseComplete)
    let response = http::readHead(state.client)

    test::assertTrue(response.failure == null)
    unsafe
      http::netClose(state.client)
    end
  end
end

def nestedLifetime(stop: http::Stop): resources::Outcome<Bool, result::Failure>
  using lifetime <- http::Lifetime.open(stop: stop)
    return true
  end
  return false
end

def forceLifetimeStop(): resources::Outcome<Bool, result::Failure>
  using lifetime <- http::Lifetime.open(false, 100)
    lifetime.requestStop()

    test::assertTrue(lifetime.isStopping())
    while true
    end
  end
  return false
end

def lifetimeReuse(): resources::Outcome<Bool, result::Failure>
  let stop = new http::Stop()

  using lifetime <- http::Lifetime.open(stop: stop)
    test::assertEqual(lifetime.pollMilliseconds(), -1)
    test::assertTrue(!lifetime.isStopping())
    let nested = nestedLifetime(stop)

    match nested.completion
      case resources::Completion.Value(value)
        test::assertTrue(false)
      case resources::Completion.Failure(failure)
        test::assertTrue(failure != null)
        if failure != null
          test::assertEqual(failure.code, "stop_unavailable")
        end
    end

    test::assertEqual(nested.closeFailures.count(), 0)
    test::assertTrue(lifetime.close() == null)
    test::assertTrue(lifetime.close() == null)
    using reused <- http::Lifetime.open(stop: stop)
      stop.request()

      test::assertTrue(reused.isStopping())
      return true
    end
  end
  return false
end

def main(): Void
  let mode = host::argumentAt(0)
  let portText = host::argumentAt(1)

  test::assertTrue(mode != null && portText != null)
  if mode == null || portText == null
    return
  end
  let port = host::parseInt(portText)

  test::assertTrue(port != null)
  if port == null
    return
  end
  if mode == "forced-lifetime"
    forceLifetimeStop()
  else if mode == "lifetime"
    let outcome = lifetimeReuse()

    test::assertEqual(outcome.closeFailures.count(), 0)
    match outcome.completion
      case resources::Completion.Value(value)
        test::assertTrue(value)
      case resources::Completion.Failure(failure)
        test::assertTrue(false)
    end
  else if mode == "normal"
    serveOnce(port, mode)
    serveOnce(port, mode)
  else
    serveOnce(port, mode)
  end
end
