use console
use host
use process
use test

def main(): Void
  let executable = host::argumentAt(1)

  test::assertTrue(executable != null)
  if executable == null
    return
  end
  let started = process::spawn(new process::SpawnOptions(executable))

  test::assertTrue(started.failure() == null)
  let child = started.child()

  test::assertTrue(child != null)
  if child == null
    return
  end
  let completed = child.wait(10000)
  let disposed = child.dispose()
  let status = completed.exit
  let succeeded = completed.failure == null && !completed.running && status != null && status.isExited() && status.value() == 0

  if !succeeded
    let stdout = host::stringFromBytes(completed.stdout)
    let stderr = host::stringFromBytes(completed.stderr)

    console::println("Worker fixture did not exit successfully within ten seconds")
    console::println(stdout) if stdout != null
    console::println(stderr) if stderr != null
  end

  test::assertTrue(disposed)
  test::assertTrue(succeeded)
end
