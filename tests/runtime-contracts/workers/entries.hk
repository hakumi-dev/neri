use workers
use result
use test
use text
namespace worker_fixture

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

def echo(config: Byte[]): Void
  match workers::ready()
    case result::Result.Ok(value)
      test::assertTrue(value)
    case result::Result.Error(failure)
      test::assertTrue(false)
      return
  end
  while true
    match workers::receive()
      case result::Result.Ok(input)
        if input == null
          return
        end
        unsafe
          collect()
        end

        test::assertEqual(config.Length, 1)
        test::assertEqual(config[0] as Int, 42)
        test::assertEqual(input.Length, 1)
        let output: Byte[] = [config[0], input[0]]

        match workers::reply(output)
          case result::Result.Ok(value)
            test::assertTrue(value)
          case result::Result.Error(failure)
            test::assertTrue(false)
            return
        end
      case result::Result.Error(failure)
        test::assertTrue(false)
        return
    end
  end
end

def startupFailure(config: Byte[]): Void
  workers::fail(text::bytes("entry initialization failed"))
end

def cleanupFailure(config: Byte[]): Void
  match workers::ready()
    case result::Result.Ok(value)
      test::assertTrue(value)
    case result::Result.Error(failure)
      test::assertTrue(false)
      return
  end
  match workers::receive()
    case result::Result.Ok(input)
      test::assertTrue(input == null)
    case result::Result.Error(failure)
      test::assertTrue(false)
  end
  workers::fail(text::bytes("entry cleanup failed"))
end
