use host

@cabi("mkdir")
def unsafe makeDirectory(path: Byte*, mode: Int32): Int32
end
@cabi("rmdir")
def unsafe removeDirectory(path: Byte*): Int32
end

def malformedName(parent: String, remove: Bool): Int
  unsafe
    let length = host.stringByteLength(parent)
    let path = native.alloc<Byte>(length + 3)
    var index = 0
    while index < length
      path[index] = host.stringByteAt(parent, index)
      index = index + 1
    end
    path[length] = 47 as Byte
    path[length + 1] = 255 as Byte
    path[length + 2] = 0 as Byte
    let status = remove ? removeDirectory(path) : makeDirectory(path, 448 as Int32)
    native.free(path)
    return status == (0 as Int32) ? 0 : 1
  end
end

def main(): Void
  let action = host.argumentAt(0)
  let path = host.argumentAt(1)
  if action == null || path == null
    host.exit(2)
    return
  end
  var status: Int? = 2
  if action == "write"
    let text = host.argumentAt(2)
    if text != null
      status = host.writeText(path, text) ? 0 : 1
    end
  else if action == "delete"
    status = host.removeFile(path) ? 0 : 1
  else if action == "symlink"
    status = host.run("ln", ["-s", "missing-target", path])
  else if action == "mkdir"
    status = host.run("mkdir", [path])
  else if action == "rmdir"
    status = host.run("rmdir", [path])
  else if action == "rename"
    let destination = host.argumentAt(2)
    if destination != null
      status = host.run("mv", [path, destination])
    end
  else if action == "malformed" || action == "delete-malformed"
    status = malformedName(path, action == "delete-malformed")
  end
  if status != null
    host.exit(status)
  else
    host.exit(1)
  end
end
