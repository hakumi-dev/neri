use changes
use files
use host
use process
use test

def run(helper: String, arguments: String[]): Void
  let options = new process::SpawnOptions(helper)

  options.arguments = arguments
  let started = process::spawn(options)
  let child = started.child()

  test::assertTrue(child != null)
  if child == null
    return
  end
  let completed = child.wait(5000)

  test::assertTrue(completed.failure == null && !completed.running)
  let status = completed.exit

  test::assertTrue(status != null)
  if status != null
    test::assertEqual(status.value(), 0)
  end

  test::assertTrue(child.dispose())
end

def main(): Void
  let rootPath = host::argumentAt(0)
  let helper = host::argumentAt(1)

  test::assertTrue(rootPath != null)
  test::assertTrue(helper != null)
  if rootPath == null || helper == null
    return
  end
  run(helper, ["write", rootPath + "/sample", "aaaa"])
  let rootResult = files::Root.open(rootPath)

  test::assertTrue(rootResult.failure == null)
  let root = rootResult.root

  if root == null
    return
  end
  let scanner = new changes::Scanner()
  let first = scanner.poll(root)

  test::assertTrue(first.failure == null && !first.changed && first.digest != null)
  let second = scanner.poll(root)

  test::assertTrue(second.failure == null && !second.changed)
  let publicDigest = second.digest

  if publicDigest != null
    publicDigest[0] = publicDigest[0] == (0 as Byte) ? 1 as Byte : 0 as Byte
  end

  test::assertTrue(!scanner.poll(root).changed)
  run(helper, ["write", rootPath + "/sample", "bbbb"])
  let rewritten = scanner.poll(root)

  test::assertTrue(rewritten.failure == null && rewritten.changed)
  run(helper, ["write", rootPath + "/created", "new"])

  test::assertTrue(scanner.poll(root).changed)
  run(helper, ["delete", rootPath + "/created"])

  test::assertTrue(scanner.poll(root).changed)

  run(helper, ["mkdir", rootPath + "/empty"])

  test::assertTrue(scanner.poll(root).changed)
  run(helper, ["rmdir", rootPath + "/empty"])

  test::assertTrue(scanner.poll(root).changed)
  let stable = scanner.poll(root)

  test::assertTrue(stable.failure == null && !stable.changed)
  run(helper, ["symlink", rootPath + "/link"])
  let rejected = scanner.poll(root)
  let rejectedFailure = rejected.failure

  test::assertTrue(rejectedFailure != null)
  if rejectedFailure != null
    test::assertEqual(rejectedFailure.code, "unsupported_entry")
  end
  run(helper, ["delete", rootPath + "/link"])
  let preserved = scanner.poll(root)

  test::assertTrue(preserved.failure == null && !preserved.changed)
  let malformed = root.list("../bad")

  test::assertTrue(malformed.failure != null)
  let targetName = host::argumentAt(2)
  var target: TargetPlatform? = null

  target = TargetPlatform.parse(targetName) if targetName != null

  test::assertTrue(target != null)
  if target != null && target.isLinux()
    run(helper, ["malformed", rootPath])
    let invalidName = root.list("").failure

    test::assertTrue(invalidName != null)
    if invalidName != null
      test::assertEqual(invalidName.code, "invalid_name")
    end
    run(helper, ["delete-malformed", rootPath])

    test::assertTrue(!scanner.poll(root).changed)
  end

  let moved = rootPath + ".moved"

  run(helper, ["rename", rootPath, moved])

  test::assertTrue(!scanner.poll(root).changed)
  run(helper, ["write", moved + "/sample", "cccc"])

  test::assertTrue(scanner.poll(root).changed)
  test::assertTrue(root.close() == null)
end
