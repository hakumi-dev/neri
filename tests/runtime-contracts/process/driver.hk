use clock
use host
use process
use result
use test
use tasks

def requireChild(result: process::SpawnResult): process::Child?
  test::assertTrue(result.failure() == null)
  let child = result.child()

  test::assertTrue(child != null)
  return child
end

def main(): Void
  let executable = host::argumentAt(1)

  test::assertTrue(executable != null)
  if executable == null
    return
  end

  let options = new process::SpawnOptions(executable)

  options.arguments = ["report", "with spaces", "Español", "", "$HOME", "semi;colon"]
  options.environment = [new process::EnvironmentEntry("NERI_PROCESS_TEST", "válido")]
  options.inheritEnvironment = false
  let child = requireChild(process::spawn(options))

  if child == null
    return
  end
  let completed = child.wait(5000)

  test::assertTrue(completed.failure == null && !completed.running)
  let completedExit = completed.exit

  test::assertTrue(completedExit != null)
  if completedExit != null
    test::assertTrue(completedExit.isExited())
    test::assertEqual(completedExit.value(), 7)
  end

  test::assertTrue(completed.stdout.Length > 0)
  test::assertTrue(completed.stdout[0] == (111 as Byte) && completed.stdout[3] == (0 as Byte) && completed.stdout[4] == (255 as Byte))
  test::assertTrue(completed.stderr.Length == 5)
  test::assertTrue(completed.stderr[0] == (101 as Byte) && completed.stderr[3] == (0 as Byte) && completed.stderr[4] == (254 as Byte))
  test::assertTrue(!completed.stdoutTruncated && !completed.stderrTruncated)
  test::assertTrue(child.dispose() && child.dispose())

  let burstOptions = new process::SpawnOptions(executable)

  burstOptions.arguments = ["burst"]
  burstOptions.stdoutLimit = 31
  let burst = requireChild(process::spawn(burstOptions))

  if burst == null
    return
  end
  let bounded = burst.wait(5000)

  test::assertTrue(!bounded.running && bounded.stdout.Length == 31 && bounded.stdoutTruncated)
  test::assertTrue(burst.dispose())

  let exchangeOptions = new process::SpawnOptions(executable)

  exchangeOptions.arguments = ["exchange"]
  exchangeOptions.input = tasks::generate(131072, 1) do |index|
    return 42 as Byte
  end
  let exchange = requireChild(process::spawn(exchangeOptions))

  if exchange == null
    return
  end
  let exchanged = exchange.wait(5000)

  test::assertTrue(exchanged.failure == null && !exchanged.running)
  test::assertEqual(exchanged.stdout.Length, 131072)
  test::assertEqual(exchanged.stderr.Length, exchangeOptions.input.Length)
  test::assertTrue(exchanged.stderr[0] == (42 as Byte) && exchanged.stderr[131071] == (42 as Byte))
  test::assertTrue(exchange.dispose())

  let closedInputOptions = new process::SpawnOptions(executable)

  closedInputOptions.arguments = ["build-success"]
  closedInputOptions.input = tasks::generate(131072, 1) do |index|
    return 42 as Byte
  end
  let closedInput = requireChild(process::spawn(closedInputOptions))

  if closedInput == null
    return
  end
  let closedInputResult = closedInput.wait(5000)

  test::assertTrue(closedInputResult.failure == null && !closedInputResult.running)
  test::assertTrue(closedInput.dispose())

  let exitedOptions = new process::SpawnOptions(executable)

  exitedOptions.arguments = ["build-success"]
  let exitedBeforeInterrupt = requireChild(process::spawn(exitedOptions))

  if exitedBeforeInterrupt == null
    return
  end
  let beforeExitDelay = clock::milliseconds()

  if beforeExitDelay == null
    test::assertTrue(exitedBeforeInterrupt.dispose())
    return
  end
  while true
    let current = clock::milliseconds()

    if current != null && current >= beforeExitDelay + 100
      break
    end
  end

  test::assertTrue(exitedBeforeInterrupt.interrupt())
  test::assertTrue(exitedBeforeInterrupt.dispose())

  let runOptions = new process::SpawnOptions(executable)

  runOptions.arguments = ["build-success"]
  match process::run(runOptions, 5000)
    case result::Result.Ok(runResult)
      let runStatus = runResult.exit

      test::assertTrue(runStatus != null)
      if runStatus != null
        test::assertTrue(runStatus.isExited())
        test::assertEqual(runStatus.value(), 0)
      end
    case result::Result.Error(failure)
      test::assertTrue(false)
  end

  let runTimeoutOptions = new process::SpawnOptions(executable)

  runTimeoutOptions.arguments = ["stay"]
  match process::run(runTimeoutOptions, 10)
    case result::Result.Ok(runResult)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "timeout")
      test::assertEqual(failure.operation, "process.run")
  end

  let exit127Options = new process::SpawnOptions(executable)

  exit127Options.arguments = ["exit127"]
  let exit127 = requireChild(process::spawn(exit127Options))

  if exit127 == null
    return
  end
  let exit127Result = exit127.wait(5000)
  let exit127Status = exit127Result.exit

  test::assertTrue(exit127Status != null)
  if exit127Status != null
    test::assertTrue(exit127Status.isExited())
    test::assertEqual(exit127Status.value(), 127)
  end

  test::assertTrue(exit127.dispose())

  let escapeOptions = new process::SpawnOptions(executable)

  escapeOptions.arguments = ["escape"]
  let escape = requireChild(process::spawn(escapeOptions))

  if escape == null
    return
  end
  let escaped = escape.wait(1000)

  test::assertTrue(!escaped.running)
  test::assertTrue(escape.dispose())

  let currentOptions = new process::SpawnOptions(executable)

  currentOptions.arguments = ["stay"]
  let current = requireChild(process::spawn(currentOptions))

  if current == null
    return
  end
  let missing = process::spawn(new process::SpawnOptions(executable + ".missing"))

  test::assertTrue(missing.child() == null && missing.failure() != null)
  let missingFailure = missing.failure()

  if missingFailure != null
    test::assertEqual(missingFailure.code(), "spawn_failed")
    test::assertEqual(missingFailure.operation, "process.spawn")
    test::assertTrue(missingFailure.osCode != 0)
  end

  let currentAfterMissingCandidate = current.poll()

  test::assertTrue(currentAfterMissingCandidate.running)

  let interruptedOptions = new process::SpawnOptions(executable)

  interruptedOptions.arguments = ["stay"]
  let interrupted = requireChild(process::spawn(interruptedOptions))

  if interrupted == null
    test::assertTrue(current.cancel() && current.dispose())
    return
  end

  test::assertTrue(interrupted.interrupt())
  let interruptedResult = interrupted.wait(5000)
  let interruptedStatus = interruptedResult.exit

  test::assertTrue(interruptedResult.failure == null && !interruptedResult.running)
  test::assertTrue(interruptedStatus != null)
  if interruptedStatus != null
    test::assertTrue(!interruptedStatus.isCancelled())
  end

  test::assertTrue(interrupted.dispose())

  let failedBuildOptions = new process::SpawnOptions(executable)

  failedBuildOptions.arguments = ["exit127"]
  let failedBuild = requireChild(process::spawn(failedBuildOptions))

  if failedBuild == null
    test::assertTrue(current.cancel() && current.dispose())
    return
  end
  let failedBuildResult = failedBuild.wait(5000)

  test::assertTrue(failedBuildResult.failure == null && !failedBuildResult.running)
  let failedBuildStatus = failedBuildResult.exit

  test::assertTrue(failedBuildStatus != null)
  if failedBuildStatus != null
    test::assertTrue(failedBuildStatus.isExited())
    test::assertEqual(failedBuildStatus.value(), 127)
  end

  test::assertTrue(failedBuild.dispose())
  let currentAfterBuildFailure = current.poll()

  test::assertTrue(currentAfterBuildFailure.running)

  let successfulBuildOptions = new process::SpawnOptions(executable)

  successfulBuildOptions.arguments = ["build-success"]
  let successfulBuild = requireChild(process::spawn(successfulBuildOptions))

  if successfulBuild == null
    test::assertTrue(current.cancel() && current.dispose())
    return
  end
  let successfulBuildResult = successfulBuild.wait(5000)

  test::assertTrue(successfulBuildResult.failure == null && !successfulBuildResult.running)
  let successfulBuildStatus = successfulBuildResult.exit

  test::assertTrue(successfulBuildStatus != null)
  if successfulBuildStatus != null
    test::assertTrue(successfulBuildStatus.isExited())
    test::assertEqual(successfulBuildStatus.value(), 0)
  end

  test::assertTrue(successfulBuild.dispose())
  let currentAfterSuccessfulBuild = current.poll()

  test::assertTrue(currentAfterSuccessfulBuild.running)

  let candidateOptions = new process::SpawnOptions(executable)

  candidateOptions.arguments = ["stay"]
  let replacement = requireChild(process::spawn(candidateOptions))

  if replacement == null
    test::assertTrue(current.cancel() && current.dispose())
    return
  end

  let replacementBeforeHandoff = replacement.poll()

  test::assertTrue(replacementBeforeHandoff.running)
  test::assertTrue(current.cancel())
  let stoppedCurrent = current.wait(5000)

  test::assertTrue(stoppedCurrent.failure == null && !stoppedCurrent.running)
  test::assertTrue(current.dispose())
  let disposedCurrent = current.poll()

  test::assertTrue(disposedCurrent.failure != null)
  test::assertTrue(replacement.poll().running)
  test::assertTrue(replacement.cancel())
  let stoppedReplacement = replacement.wait(5000)

  test::assertTrue(stoppedReplacement.failure == null && !stoppedReplacement.running)
  test::assertTrue(replacement.dispose() && replacement.dispose())

  let invalid = new process::SpawnOptions(executable)

  invalid.environment = [new process::EnvironmentEntry("PATH", "one"), new process::EnvironmentEntry("Path", "two")]

  test::assertTrue(process::spawn(invalid).failure() != null)
end
