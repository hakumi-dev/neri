use console
use host

@cabiImport("write")
unsafe def writeDescriptor(fd: Int32, bytes: Byte*, length: Int): Int
end
@cabiImport("read")
unsafe def readDescriptor(fd: Int32, bytes: Byte*, length: Int): Int
end
@cabiImport("_exit")
unsafe def nativeExit(status: Int32): Void
end
@library("neri-process-test")
@cabiImport("neri_test_process_escape_with_pipes")
unsafe def escapeWithPipes(): Int
end

def main(): Void
  let mode = host.argumentAt(0)

  if mode != null && mode == "stay"
    while true
    end
  end
  if mode != null && mode == "burst"
    var index = 0

    while index < 4096
      console.print("0123456789abcdef")
      index = index + 1
    end
    return
  end
  if mode != null && mode == "exchange"
    var emitted = 0

    while emitted < 131072
      console.print("0123456789abcdef")
      emitted = emitted + 16
    end
    unsafe
      let input = stackalloc Byte[8192]
      var count = readDescriptor(0 as Int32, input, 8192)

      while count > 0
        if writeDescriptor(2 as Int32, input, count) != count
          nativeExit(2 as Int32)
        end
        count = readDescriptor(0 as Int32, input, 8192)
      end
      if count < 0
        nativeExit(2 as Int32)
      end
    end
    return
  end
  if mode != null && mode == "exit127"
    unsafe
      nativeExit(127 as Int32)
    end
    return
  end
  if mode != null && mode == "build-success"
    return
  end
  if mode != null && mode == "escape"
    unsafe
      if escapeWithPipes() != 0
        host.exit(2)
      end
    end
    return
  end
  let output = [111 as Byte, 117 as Byte, 116 as Byte, 0 as Byte, 255 as Byte]
  let errors = [101 as Byte, 114 as Byte, 114 as Byte, 0 as Byte, 254 as Byte]

  unsafe
    borrow output as pointer
      if writeDescriptor(1 as Int32, pointer, output.Length) != output.Length
        nativeExit(2 as Int32)
      end
    end
    borrow errors as pointer
      if writeDescriptor(2 as Int32, pointer, errors.Length) != errors.Length
        nativeExit(2 as Int32)
      end
    end
  end
  var index = 0

  while index < host.argumentCount()
    let argument = host.argumentAt(index)

    if argument != null
      console.print("[" + argument + "]")
    end
    index = index + 1
  end
  let value = host.environment("NERI_PROCESS_TEST")

  if value != null
    console.print("{" + value + "}")
  end
  host.exit(7)
end
