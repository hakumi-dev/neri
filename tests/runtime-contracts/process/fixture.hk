use console
use host

@cabi("write")
def unsafe writeDescriptor(fd: Int32, bytes: Byte*, length: Int): Int
end
@cabi("_exit")
def unsafe nativeExit(status: Int32): Void
end
@library("neri-process-test")
@cabi("neri_test_process_escape_with_pipes")
def unsafe escapeWithPipes(): Int
end

def main(): Void
  let mode = host.argumentAt(0)
  if mode != null && mode == "stay"
    while true
    end
  end
  if mode != null && mode == "burst"
    var index = 0
    while index < 4096
      console.print("0123456789abcdef")
      index = index + 1
    end
    return
  end
  if mode != null && mode == "exit127"
    unsafe
      nativeExit(127 as Int32)
    end
    return
  end
  if mode != null && mode == "escape"
    unsafe
      if escapeWithPipes() != 0
        host.exit(2)
      end
    end
    return
  end
  let output = [111 as Byte, 117 as Byte, 116 as Byte, 0 as Byte, 255 as Byte]
  let errors = [101 as Byte, 114 as Byte, 114 as Byte, 0 as Byte, 254 as Byte]
  unsafe
    borrow output as pointer
      if writeDescriptor(1 as Int32, pointer, output.Length) != output.Length
        nativeExit(2 as Int32)
      end
    end
    borrow errors as pointer
      if writeDescriptor(2 as Int32, pointer, errors.Length) != errors.Length
        nativeExit(2 as Int32)
      end
    end
  end
  var index = 0
  while index < host.argumentCount()
    let argument = host.argumentAt(index)
    if argument != null
      console.print("[" + argument + "]")
    end
    index = index + 1
  end
  let value = host.environment("NERI_PROCESS_TEST")
  if value != null
    console.print("{" + value + "}")
  end
  host.exit(7)
end
