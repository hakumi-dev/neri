use host
use test

def completionHas(result: SessionCompletionResult, name: String): Bool
  var item = result.first

  while item != null
    if item.name == name
      return true
    end
    item = item.next
  end
  return false
end

def completionDetail(result: SessionCompletionResult, name: String): String
  var item = result.first

  while item != null
    if item.name == name
      return item.detail
    end
    item = item.next
  end
  return ""
end

def sessionCompletionExecutionContracts(toolchain: SessionToolchain, root: String): Void
  let session = new ExecutableSession(toolchain)
  let other = new ExecutableSession(toolchain)
  let initialized = session.initializeProject(root + "/tests/session-initializer/manifest.json", "service", "services.createSessionService", "app", "use services")

  test.assertTrue(initialized.succeeded)
  test.assertTrue(completionHas(session.complete("app.", 4), "value"))
  test.assertTrue(!completionHas(other.complete("app", 3), "app"))
  test.assertTrue(session.submit("use test\nlet greeting = \"hé😀\"").execution.succeeded)
  let bounded = session.prepare("def same<T: Equality>(left: T, right: T): Bool\n  return left == right\nend")

  test.assertEqual(bounded.status, "complete")
  test.assertTrue(session.execute(bounded).succeeded)
  let boundedCall = session.prepare("test.assertTrue(same(7, 7))")

  test.assertEqual(boundedCall.status, "complete")
  test.assertTrue(bootstrapFindText(completionDetail(session.complete("sam", 3), "same"), "T: Equality") >= 0)
  test.assertTrue(session.execute(boundedCall).succeeded)
  let rejectedBound = session.prepare("let invalidEquality = same([1], [1])")

  test.assertEqual(rejectedBound.status, "invalid")
  test.assertEqual(diagnosticCode(rejectedBound), "NR251")
  let contractDeclaration = session.prepare("contract Named\n  readonly def label(): String\n  end\nend\n\nclass SessionName\n  readonly def label(): String\n    return \"session\"\n  end\nend\n\ndef readName<T: Named>(value: T): String\n  return value.label()\nend")

  test.assertEqual(contractDeclaration.status, "complete")
  test.assertTrue(session.execute(contractDeclaration).succeeded)
  let contractCall = session.prepare("test.assertEqual(readName(new SessionName()), \"session\")")

  test.assertEqual(contractCall.status, "complete")
  test.assertTrue(bootstrapFindText(completionDetail(session.complete("readN", 5), "readName"), "T: Named") >= 0)
  test.assertTrue(!contractCall.consumed)
  test.assertTrue(session.execute(contractCall).succeeded)
  let rejectedContract = session.prepare("let invalidName = readName([1])")

  test.assertEqual(rejectedContract.status, "invalid")
  test.assertEqual(diagnosticCode(rejectedContract), "NR251")
  test.assertTrue(!completionHas(session.complete("invalidN", 8), "invalidName"))
  let textPreparation = session.prepare("test.assertEqual(greeting.scalarCount(), 3)")

  test.assertTrue(completionHas(session.complete("greeting.", 9), "byteLength"))
  test.assertTrue(completionHas(session.complete("String.", 7), "fromBytes"))
  test.assertTrue(!textPreparation.consumed)
  test.assertTrue(session.execute(textPreparation).succeeded)
  test.assertTrue(!session.execute(textPreparation).succeeded)
  test.assertTrue(session.submit("use test\nvar count = 0").execution.succeeded)
  let pending = session.prepare("count = count + 1")
  let generation = session.completionGeneration()
  let completion = session.complete("count = count + 100\napp.", 24)

  test.assertEqual(completion.generation, generation)
  test.assertTrue(completionHas(completion, "value"))
  test.assertEqual(session.completionGeneration(), generation)
  test.assertTrue(!pending.consumed)
  test.assertTrue(session.execute(pending).succeeded)
  test.assertTrue(!session.execute(pending).succeeded)
  test.assertTrue(session.completionGeneration() > generation)
  test.assertTrue(session.submit("test.assertEqual(count, 1)").execution.succeeded)
  let scalar = session.submit("use text\nlet letter = text.Scalar.fromInt(233)")

  test.assertTrue(scalar.execution.succeeded)
  let conversion = session.prepare("if letter != null\n  test.assertEqual(letter as Int, 233)\n  test.assertTrue(letter == letter)\nend")

  test.assertTrue(completionHas(session.complete("text.Sc", 7), "Scalar"))
  test.assertTrue(!conversion.consumed)
  test.assertTrue(session.execute(conversion).succeeded)
  test.assertTrue(!session.execute(conversion).succeeded)
  let beforeError = session.completionGeneration()
  let failed = session.submit("let absent: Int = \"invalid\"")

  test.assertTrue(!failed.execution.succeeded)
  test.assertEqual(session.completionGeneration(), beforeError)
  test.assertTrue(!completionHas(session.complete("abs", 3), "absent"))
  test.assertTrue(session.reset().succeeded)
  test.assertTrue(session.completionGeneration() > beforeError)
  test.assertTrue(!completionHas(session.complete("app", 3), "app"))
  test.assertTrue(!completionHas(session.complete("readN", 5), "readName"))
  test.assertTrue(session.dispose().succeeded)
  test.assertEqual(session.complete("", 0).status, "disposed")
  test.assertTrue(other.dispose().succeeded)
end

def sessionCompletionContracts(): Void
  let snapshot = new SessionSourceSnapshot()

  snapshot.add("tools.hk", "namespace tools\n\nclass Hammer\nend\n")
  snapshot.captureLibraries("use console\nuse tasks\n")
  let environment = new SessionEnvironment("completion-contract", snapshot)
  let declaration = environment.prepare("var counter = 123")

  test.assertEqual(declaration.status, "complete")
  test.assertTrue(environment.commit(declaration))
  let pending = environment.prepare("counter = 124")
  let completed = environment.complete("cou", 3)

  test.assertEqual(completed.status, "complete")
  test.assertTrue(completionHas(completed, "counter"))
  test.assertEqual(environment.currentGeneration(), 1)
  test.assertTrue(!pending.consumed)
  let first = completed.first

  test.assertTrue(first != null)
  if first != null
    test.assertEqual(first.replacementStart, 0)
    test.assertEqual(first.replacementEnd, 3)
  end

  test.assertTrue(environment.commit(pending))
  test.assertTrue(!environment.commit(pending))

  let members = environment.prepare("class Counter\n  public value: Int = 0\n  def increment(): Int\n    return this.value + 1\n  end\nend\n\nclass Box<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\n\ndef identity<T>(value: T): T\n  return value\nend\n\ndef answer(): Int\n  return 42\nend\n\nlet app = new Counter()")

  test.assertEqual(members.status, "complete")
  test.assertTrue(environment.commit(members))
  let memberCompletion = environment.complete("app.", 4)

  test.assertTrue(completionHas(memberCompletion, "value"))
  test.assertTrue(completionHas(memberCompletion, "increment"))
  test.assertTrue(completionHas(environment.complete("ans", 3), "answer"))
  test.assertTrue(completionHas(environment.complete("new Cou", 7), "Counter"))
  test.assertTrue(completionHas(environment.complete("new Bo", 6), "Box"))
  test.assertTrue(completionHas(environment.complete("ide", 3), "identity"))
  test.assertTrue(completionHas(environment.complete("use con", 7), "console"))
  let consoleMemberSource = "use console\nconsole.pr"

  test.assertTrue(completionHas(environment.complete(consoleMemberSource, host.stringByteLength(consoleMemberSource)), "println"))
  test.assertTrue(completionHas(environment.complete("use too", 7), "tools"))
  test.assertTrue(completionHas(environment.complete("if true\n  cou", 13), "counter"))
  test.assertTrue(completionHas(environment.complete("answer(cou", 10), "counter"))
  let genericPending = environment.prepare("counter = 125")
  let genericGeneration = environment.currentGeneration()
  let genericSource = "let boxed = new Box<Int>(7)\nboxed."
  let genericMember = environment.complete(genericSource, host.stringByteLength(genericSource))

  test.assertTrue(completionHas(genericMember, "value"))
  test.assertTrue(completionHas(genericMember, "item"))
  test.assertTrue(!completionHas(environment.complete("box", 3), "boxed"))
  test.assertEqual(environment.currentGeneration(), genericGeneration)
  test.assertTrue(!genericPending.consumed)
  test.assertTrue(environment.commit(genericPending))
  let unicode = environment.complete("\"😀\"\ncou", 10)
  let unicodeItem = unicode.first

  test.assertTrue(completionHas(unicode, "counter"))
  test.assertTrue(unicodeItem != null)
  if unicodeItem != null
    test.assertEqual(unicodeItem.replacementStart, 7)
    test.assertEqual(unicodeItem.replacementEnd, 10)
  end
  let middle = environment.complete("counter", 3)
  let middleItem = middle.first

  test.assertTrue(completionHas(middle, "counter"))
  test.assertTrue(middleItem != null)
  if middleItem != null
    test.assertEqual(middleItem.replacementStart, 0)
    test.assertEqual(middleItem.replacementEnd, 7)
  end
  var many = ""
  var completionIndex = 0

  while completionIndex < 140
    many = many + "let completionValue" + (completionIndex as String) + " = " + (completionIndex as String) + "\n"
    completionIndex = completionIndex + 1
  end
  many = many + "completion"
  let limited = environment.complete(many, host.stringByteLength(many))

  test.assertEqual(limited.count, 128)
  test.assertTrue(limited.truncated)

  let other = new SessionEnvironment("completion-other")

  test.assertTrue(!completionHas(other.complete("cou", 3), "counter"))
  test.assertEqual(environment.complete("", -1).status, "invalid-position")
  test.assertEqual(environment.complete("", 1).status, "invalid-position")
  test.assertEqual(environment.complete("é", 1).status, "invalid-position")
  test.assertEqual(environment.complete("😀", 3).status, "invalid-position")
  test.assertEqual(sessionCompletionPosition("é😀x", 6), 3)
  test.assertEqual(sessionCompletionPosition("é😀x", 7), 4)
  environment.dispose()
  other.dispose()
end
