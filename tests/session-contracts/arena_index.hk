use test

def arenaIndexContracts(): Void
  let syntax = new SyntaxArena()
  var index = 0

  while index < 257
    syntax.add(syntax.kinds.getIntLiteral(), index as String, [index])
    index = index + 1
  end

  test::assertEqual(syntax.dataAt(256), "256")
  test::assertEqual(syntax.dataAt(128), "128")
  test::assertEqual(syntax.dataAt(127), "127")
  test::assertEqual(syntax.dataAt(0), "0")
  let child = new SyntaxArena(syntax)

  index = 0
  while index < 129
    child.add(child.kinds.getIntLiteral(), index as String, [index])
    index = index + 1
  end

  test::assertEqual(child.dataAt(128), "128")
  test::assertEqual(child.dataAt(257), "0")
  test::assertEqual(child.dataAt(385), "128")
  let parentBoundary = syntax.nodeAt(128)
  let childBoundary = child.nodeAt(257)

  parentBoundary.value = "parent-identity"
  childBoundary.value = "child-identity"

  test::assertEqual(child.valueAt(128), "parent-identity")
  test::assertEqual(child.valueAt(257), "child-identity")
  let parentBound = new BoundArena()

  parentBound.add(parentBound.kinds.getIntLiteral(), "Int", "parent", 0, 1, [0])
  let bound = new BoundArena(parentBound)

  index = 0
  while index < 257
    bound.add(bound.kinds.getIntLiteral(), "Int", index as String, index, 1, [index])
    index = index + 1
  end

  test::assertEqual(bound.dataAt(257), "256")
  test::assertEqual(bound.dataAt(129), "128")
  test::assertEqual(bound.dataAt(128), "127")
  test::assertEqual(bound.dataAt(1), "0")
  let boundParentIdentity = parentBound.nodeAt(0)
  let boundChildIdentity = bound.nodeAt(129)

  boundParentIdentity.value = "parent-identity"
  boundChildIdentity.value = "child-identity"

  test::assertEqual(bound.valueAt(0), "parent-identity")
  test::assertEqual(bound.valueAt(129), "child-identity")
end
