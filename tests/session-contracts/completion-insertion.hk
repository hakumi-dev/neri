use host
use test

def completionInsertionSource(): String
  return "class Parent\n  def read(): Int\n    return 1\n  end\nend\nclass EditorValue: Parent\n  public value: Int = 0\n  def write(value: Int): Void\n    this.value = value\n  end\n  static def create(): EditorValue\n    return new EditorValue()\n  end\nend\ndef __neri_helper(): Int\n  return 7\nend\ndef identity<T>(value: T): T\n  return value\nend\ndef consume(action: fn(): Int): Int\n  return action()\nend\n"
end

def assertSessionInsertion(environment: SessionEnvironment, source: String, position: Int, name: String, expected: String, cursor: Int): Void
  let result = environment.complete(source, position)
  var item = result.first

  while item != null && item.name != name
    item = item.next
  end

  test.assertEqual(result.status, "complete")
  test.assertTrue(item != null)
  if item != null
    test.assertEqual(item.insertText, expected)
    test.assertEqual(item.cursorByteOffset, cursor)
  end
end

def completionInsertionContracts(): Void
  let snapshot = new SessionSourceSnapshot()

  snapshot.add("helpers.hk", "def __neri_session_helper(): Int\n  return 1\nend\nclass __NeriSessionStateExtra\nend\n")
  let environment = new SessionEnvironment("insertion-contract", snapshot)
  let prepared = environment.prepare(completionInsertionSource() + "let item = new EditorValue()\nlet callback: fn(): Int = __neri_helper")

  test.assertEqual(prepared.status, "complete")
  test.assertTrue(environment.commit(prepared))
  assertSessionInsertion(environment, "item.rea", 8, "read", "read()", 6)
  assertSessionInsertion(environment, "item.wri", 8, "write", "write()", 6)
  assertSessionInsertion(environment, "EditorValue.cre", 15, "create", "create()", 8)
  assertSessionInsertion(environment, "ide", 3, "identity", "identity()", 9)
  assertSessionInsertion(environment, "item.val", 8, "value", "value", 5)
  assertSessionInsertion(environment, "callb", 5, "callback", "callback", 8)
  assertSessionInsertion(environment, "new Edi", 7, "EditorValue", "EditorValue", 11)
  assertSessionInsertion(environment, "__neri_he", 9, "__neri_helper", "__neri_helper()", 15)
  assertSessionInsertion(environment, "item.rea()", 8, "read", "read", 4)
  assertSessionInsertion(environment, "item.rea < 10", 8, "read", "read()", 6)
  assertSessionInsertion(environment, "ide<Int>(1)", 3, "identity", "identity", 8)
  let reference = "let action: fn(): Int = __neri_he"
  let argument = "consume(__neri_he)"

  assertSessionInsertion(environment, reference, host.stringByteLength(reference), "__neri_helper", "__neri_helper", 13)
  assertSessionInsertion(environment, argument, host.stringByteLength(argument) - 1, "__neri_helper", "__neri_helper", 13)
  let names = environment.complete("__", 2)

  test.assertTrue(completionHas(names, "__neri_helper"))
  test.assertTrue(completionHas(names, "__neri_session_helper"))
  test.assertTrue(completionHas(names, "__NeriSessionStateExtra"))
  test.assertTrue(!completionHas(names, "__neri_session_entry"))
  test.assertTrue(!completionHas(names, "__NeriSessionState0"))
end

def insertionItem(items: LspJson, name: String): LspJson
  var item = items.first

  while item != null
    if item.get("label").value == name
      return item
    end
    item = item.next
  end

  test.assertTrue(false)
  return new LspJson()
end

def lspInsertionDocument(query: String): LspDocument
  let document = new LspDocument()
  let server = new LspServer()

  document.uri = "file:///completion-insertion.hk"
  document.text = completionInsertionSource() + "def main(): Void\n  let item = new EditorValue()\n  " + query + "\nend\n"
  server.codeStyleDiagnostics = false
  server.documents = document
  server.analyze(document)

  test.assertTrue(document.tokens != null)
  return document
end

def lspCompletionInsertionContracts(): Void
  let document = lspInsertionDocument("item.wri")
  let position = utf16Length(document.text) - 5
  let plain = insertionItem(new LspJsonParser(lspCompletion(document, position)).parse(), "write")
  let snippet = insertionItem(new LspJsonParser(lspCompletion(document, position, true)).parse(), "write")

  test.assertEqual(plain.get("textEdit").get("newText").value, "write()")
  test.assertEqual(plain.get("insertTextFormat").value, "1")
  test.assertEqual(snippet.get("textEdit").get("newText").value, "write($0)")
  test.assertEqual(snippet.get("insertTextFormat").value, "2")
  test.assertEqual(snippet.get("filterText").value, "write")
  let completed = lspInsertionDocument("item.rea()")
  let existing = insertionItem(new LspJsonParser(lspCompletion(completed, utf16Length(completed.text) - 7, true)).parse(), "read")
  let named = lspInsertionDocument("let action: fn(): Int = __neri_he")
  let reference = insertionItem(new LspJsonParser(lspCompletion(named, utf16Length(named.text) - 5, true)).parse(), "__neri_helper")

  test.assertEqual(existing.get("textEdit").get("newText").value, "read")
  test.assertEqual(existing.get("insertTextFormat").value, "1")
  test.assertEqual(reference.get("textEdit").get("newText").value, "__neri_helper")
  test.assertEqual(reference.get("insertTextFormat").value, "1")
end
