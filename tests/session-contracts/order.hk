use host
use test

def orderedModule(reverse: Bool): IrModule
  let module = new IrModule("ordered", "")
  let alpha = new IrFunction(irSymbol("ordered", module.domains.symbolKind.getFunction(), "alpha"), "void", module.domains.functionKind.getFunction(), false, irNoLocation())
  let omega = new IrFunction(irSymbol("ordered", module.domains.symbolKind.getFunction(), "omega"), "void", module.domains.functionKind.getFunction(), false, irNoLocation())

  if reverse
    module.addFunction(omega)
    module.addFunction(alpha)
  else
    module.addFunction(alpha)
    module.addFunction(omega)
  end
  return module
end

def orderedValues(values: IrOrderList<String>): String
  var current = values.sorted()
  var result = ""

  while current != null
    result = result + current.value + "\n"
    current = current.next
  end
  return result
end

def irOrderingContracts(): Void
  test::assertEqual(irSerializeEnvelopeHex(orderedModule(false)), irSerializeEnvelopeHex(orderedModule(true)))
  let values = new IrOrderList<String>()

  values.add("last", 2, "last")
  values.add("tie-first", 1, "same")
  values.add("tie-second", 1, "same")
  let first = orderedValues(values)
  let repeated = orderedValues(values)

  test::assertEqual(first, "tie-first\ntie-second\nlast\n")
  test::assertEqual(repeated, first)
end

def wireHexContracts(): Void
  let domains = new IrDomainCatalog()
  let empty = new IrWireBuffer(domains)

  test::assertEqual(empty.toHex(), "")
  let wire = new IrWireBuffer(domains)
  var value = 0

  while value <= 32
    wire.writeByte(value)
    value = value + 1
  end
  wire.writeByte(255)

  test::assertEqual(wire.toHex(), "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20ff")
  test::assertEqual(sha256FastWire(wire.bytes), sha256Buffer(wire.bytes.unpack()))
  let packed = new IrWireBytes()

  value = 0
  while value < 255
    packed.add(0)
    value = value + 1
  end
  packed.add(254)
  packed.add(255)

  test::assertEqual(packed.size, 257)
  test::assertEqual(packed.get(255), 254)
  test::assertEqual(packed.get(256), 255)
  test::assertEqual(packed.get(0), 0)
  let crossing = new IrWireBuffer(domains)

  crossing.bytes = packed
  let encoded = crossing.toHex()

  test::assertEqual(host::stringByteLength(encoded), 514)
  test::assertEqual(host::stringSlice(encoded, 510, 4), "feff")
end

def shaFastContracts(): Void
  let bytes = new IntBuffer()
  var value = 0

  while value < 256
    bytes.add(value)
    value = value + 1
  end

  test::assertEqual(sha256FastBuffer(bytes), sha256Buffer(bytes))

  let unicode = "Neri résumé ☃\n"

  test::assertEqual(sha256FastText(unicode), sha256Text(unicode))

  let empty = new IntBuffer()

  test::assertEqual(sha256FastBuffer(empty), sha256Buffer(empty))
end
