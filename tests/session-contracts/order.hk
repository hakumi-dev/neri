use host
use test

def orderedModule(reverse: Bool): IrModule
  let module = new IrModule("ordered", "")
  let alpha = new IrFunction(irSymbol("ordered", module.domains.symbolKind.getFunction(), "alpha"), "void", module.domains.functionKind.getFunction(), false, irNoLocation())
  let omega = new IrFunction(irSymbol("ordered", module.domains.symbolKind.getFunction(), "omega"), "void", module.domains.functionKind.getFunction(), false, irNoLocation())

  if reverse
    module.addFunction(omega)
    module.addFunction(alpha)
  else
    module.addFunction(alpha)
    module.addFunction(omega)
  end
  return module
end

def orderedValues(values: IrOrderList<String>): String
  var current = values.sorted()
  var result = ""

  while current != null
    result = result + current.value + "\n"
    current = current.next
  end
  return result
end

def irOrderingContracts(): Void
  let fragments = new StringBuffer()

  test::assertEqual(fragments.join(), "")
  fragments.add("é")
  fragments.add("")
  fragments.add("😀")

  test::assertEqual(fragments.join(), "é😀")
  test::assertEqual(irSerializeEnvelopeHex(orderedModule(false)), irSerializeEnvelopeHex(orderedModule(true)))
  let values = new IrOrderList<String>()

  values.add("last", 2, "last")
  values.add("tie-first", 1, "same")
  values.add("tie-second", 1, "same")
  let first = orderedValues(values)
  let repeated = orderedValues(values)

  test::assertEqual(first, "tie-first\ntie-second\nlast\n")
  test::assertEqual(repeated, first)
end

def irGraphIndexContracts(): Void
  let module = new IrModule("graph", "")
  let function = new IrFunction(irSymbol("graph", module.domains.symbolKind.getFunction(), "walk"), "void", module.domains.functionKind.getFunction(), false, irNoLocation())
  let entry = function.createBlock()
  let left = function.createBlock()
  let right = function.createBlock()
  let finish = function.createBlock()
  let split = new IrTerminator(module.domains.terminatorKind.getConditionalBranch(), irNoLocation())

  split.firstTarget = right.id
  split.secondTarget = left.id
  entry.terminator = split
  let rightBranch = new IrTerminator(module.domains.terminatorKind.getBranch(), irNoLocation())

  rightBranch.firstTarget = left.id
  right.terminator = rightBranch
  let leftBranch = new IrTerminator(module.domains.terminatorKind.getBranch(), irNoLocation())

  leftBranch.firstTarget = finish.id
  left.terminator = leftBranch
  finish.terminator = new IrTerminator(module.domains.terminatorKind.getReturn(), irNoLocation())
  let order = irBlockOrder(function)
  let firstBlock = order.get(0)
  let secondBlock = order.get(1)
  let thirdBlock = order.get(2)
  let fourthBlock = order.get(3)

  test::assertEqual(order.size, 4)
  test::assertTrue(firstBlock != null && secondBlock != null && thirdBlock != null && fourthBlock != null)
  if firstBlock != null && secondBlock != null && thirdBlock != null && fourthBlock != null
    test::assertEqual(firstBlock.id, entry.id)
    test::assertEqual(secondBlock.id, right.id)
    test::assertEqual(thirdBlock.id, left.id)
    test::assertEqual(fourthBlock.id, finish.id)
  end
  let duplicateSources = new IrModule("duplicates", "")

  duplicateSources.addSource(new IrSource("other", "", 0))
  duplicateSources.addSource(new IrSource("main", "", 0))
  duplicateSources.addSource(new IrSource("other", "", 0))
  duplicateSources.addSource(new IrSource("main", "", 0))
  let errors = irVerify(duplicateSources).errors

  test::assertEqual(errors.size, 4)
  test::assertEqual(errors.get(0), "duplicate source 'main'")
  test::assertEqual(errors.get(1), "duplicate source 'main'")
  test::assertEqual(errors.get(2), "duplicate source 'other'")
  test::assertEqual(errors.get(3), "duplicate source 'main'")
end

def wireHexContracts(): Void
  let domains = new IrDomainCatalog()
  let empty = new IrWireBuffer(domains)

  test::assertEqual(empty.toHex(), "")
  let wire = new IrWireBuffer(domains)
  var value = 0

  while value <= 32
    wire.writeByte(value)
    value = value + 1
  end
  wire.writeByte(255)

  test::assertEqual(wire.toHex(), "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20ff")
  test::assertEqual(sha256FastWire(wire.bytes), sha256Buffer(wire.bytes.unpack()))
  let packed = new IrWireBytes()

  value = 0
  while value < 255
    packed.add(0)
    value = value + 1
  end
  packed.add(254)
  packed.add(255)

  test::assertEqual(packed.size, 257)
  test::assertEqual(packed.get(255), 254)
  test::assertEqual(packed.get(256), 255)
  test::assertEqual(packed.get(0), 0)
  let crossing = new IrWireBuffer(domains)

  crossing.bytes = packed
  let encoded = crossing.toHex()
  var expected = ""

  value = 0

  while value < 255
    expected = expected + "00"
    value = value + 1
  end

  test::assertEqual(host::stringByteLength(encoded), 514)
  test::assertEqual(encoded, expected + "feff")
  let utf8 = new IrWireBytes()
  var text = ""

  value = 0

  while value < 255
    utf8.add(97)
    text = text + "a"
    value = value + 1
  end
  utf8.add(195)
  utf8.add(169)
  let decoded = utf8.text()

  test::assertTrue(decoded != null)
  if decoded != null
    test::assertEqual(decoded, text + "é")
  end
  utf8.add(255)

  test::assertTrue(utf8.text() == null)
end

def shaFastContracts(): Void
  let bytes = new IntBuffer()
  var value = 0

  while value < 256
    bytes.add(value)
    value = value + 1
  end

  test::assertEqual(sha256FastBuffer(bytes), sha256Buffer(bytes))

  let unicode = "Neri résumé ☃\n"

  test::assertEqual(sha256FastText(unicode), sha256Text(unicode))

  let empty = new IntBuffer()

  test::assertEqual(sha256FastBuffer(empty), sha256Buffer(empty))
end
