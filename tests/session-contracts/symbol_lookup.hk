use test

def assertClassLookup(actual: SemanticClass?, expected: SemanticClass): Void
  test::assertTrue(actual != null && actual.syntaxNode == expected.syntaxNode)
end

def assertFunctionLookup(actual: SemanticCallable?, expected: SemanticCallable): Void
  test::assertTrue(actual != null && actual.syntaxNode == expected.syntaxNode)
end

def symbolLookupContracts(): Void
  let parent = new SemanticModel()
  let inheritedClass = new SemanticClass("Entity", "Entity", "", parent.accesses.getPublic(), 0)
  let inheritedFunction = new SemanticCallable("read", "read", "", "", "Int", true, false, parent.accesses.getPublic(), 0)

  parent.addClass(inheritedClass)
  parent.addFunction(inheritedFunction)
  let child = new SemanticModel(parent)

  assertClassLookup(child.findClass("Entity"), inheritedClass)
  assertFunctionLookup(child.findFunction("read"), inheritedFunction)

  test::assertTrue(child.findClass("Later") == null)
  test::assertTrue(child.findFunction("later") == null)
  let localClass = new SemanticClass("Entity", "Entity", "", parent.accesses.getPublic(), 1)
  let localFunction = new SemanticCallable("read", "read", "", "", "String", true, false, parent.accesses.getPublic(), 1)

  child.addClass(localClass)
  child.addFunction(localFunction)

  assertClassLookup(child.findClass("Entity"), localClass)
  assertFunctionLookup(child.findFunction("read"), localFunction)
  let laterClass = new SemanticClass("Later", "Later", "", parent.accesses.getPublic(), 2)
  let laterFunction = new SemanticCallable("later", "later", "", "", "Void", true, false, parent.accesses.getPublic(), 2)

  parent.addClass(laterClass)
  parent.addFunction(laterFunction)
  sessionOwnInitializerDeclarations(child, parent)

  assertClassLookup(child.findClass("Entity"), localClass)
  assertFunctionLookup(child.findFunction("read"), localFunction)
  assertClassLookup(child.findClass("Later"), laterClass)
  assertFunctionLookup(child.findFunction("later"), laterFunction)

  localFunction.boundNode = 42
  let resolved = child.findFunction("read")

  test::assertTrue(resolved != null && resolved.boundNode == 42)
  let inheritedMethod = new SemanticCallable("Entity.read", "read", "", "Entity", "Int", false, false, parent.accesses.getPublic(), 3)
  let localMethod = new SemanticCallable("Entity.read", "read", "", "Entity", "String", false, false, parent.accesses.getPublic(), 4)

  inheritedClass.addMethod(inheritedMethod)
  localClass.addMethod(localMethod)
  inheritedClass.addField(new SemanticField("Entity", "value", "Int", parent.accesses.getPublic(), 5))
  localClass.addField(new SemanticField("Entity", "value", "String", parent.accesses.getPublic(), 6))
  let lowerer = new IrLowerer(child, new SyntaxArena(), "", "lookup")

  assertFunctionLookup(lowerer.findCallable("read"), localFunction)
  assertFunctionLookup(lowerer.findCallable("Entity.read"), localMethod)
  let field = lowerer.findField("Entity.value")

  test::assertTrue(field != null && field.syntaxNode == 6)
end

def semanticSequenceContracts(): Void
  let parent = new SemanticModel()
  var index = 0

  while index < 1050
    parent.genericTemplates.add(index)
    index = index + 1
  end
  parent.usedNames.add("base")
  parent.declaredNamespaces.add("root")
  let child = new SemanticModel(parent)
  let sibling = new SemanticModel(parent)

  parent.genericTemplates.add(1050)
  child.genericTemplates.add(2050)
  sibling.genericTemplates.add(3050)
  parent.usedNames.add("parent")
  child.usedNames.add("child")
  sibling.usedNames.add("sibling")
  parent.declaredNamespaces.add("parent")
  child.declaredNamespaces.add("child")
  let grandchild = new SemanticModel(child)

  child.usedNames.add("later")
  grandchild.usedNames.add("grandchild")

  test::assertEqual(child.genericTemplates.size, 1051)
  test::assertEqual(child.genericTemplates.get(31), 31)
  test::assertEqual(child.genericTemplates.get(32), 32)
  test::assertEqual(child.genericTemplates.get(1023), 1023)
  test::assertEqual(child.genericTemplates.get(1024), 1024)
  test::assertEqual(child.genericTemplates.get(1050), 2050)
  test::assertEqual(parent.genericTemplates.get(1050), 1050)
  test::assertEqual(sibling.genericTemplates.get(1050), 3050)
  test::assertEqual(child.usedNames.get(0), "base")
  test::assertEqual(child.usedNames.get(1), "child")
  test::assertEqual(sibling.usedNames.get(1), "sibling")
  test::assertEqual(child.usedNames.get(2), "later")
  test::assertEqual(grandchild.usedNames.get(2), "grandchild")
  test::assertEqual(child.declaredNamespaces.get(1), "child")
  test::assertEqual(sibling.declaredNamespaces.size, 1)
end
