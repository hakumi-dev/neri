use test

def codegenFailureProgressContracts(): Void
  let ended = [false]
  let progress = fn(phase: String, completed: Int, total: Int, detail: String, sourceOffset: Int): Void
    ended[0] = phase == "end"
  end
  let module = new IrModule("progress-failure", "")
  let succeeded = bootstrapInvokeCodegen(module, EmissionKind.neriIR(), "", TargetPlatform.macOS(), false, null, "", "", progress)

  test::assertTrue(!succeeded)
  test::assertTrue(ended[0])
end
