use test

def namespaceSessionContracts(): Void
  let session = new SessionEnvironment("namespace-aliases")
  let imported = session.prepare("use Output = console\n")

  test::assertTrue(imported.status.isComplete())
  test::assertTrue(session.commit(imported))
  let retained = session.prepare("Output::println(\"retained\")\n")

  test::assertTrue(retained.status.isComplete())
  test::assertTrue(session.commit(retained))
  let rejected = session.prepare("use Failed = console\nlet broken: Int = \"wrong\"\n")

  test::assertTrue(rejected.status.isInvalid())
  test::assertTrue(session.discard(rejected))
  let isolated = session.prepare("Failed::println(\"missing\")\n")

  test::assertTrue(isolated.status.isInvalid())
  let recovered = session.prepare("use Failed = console\nFailed::println(\"available\")\n")

  test::assertTrue(recovered.status.isComplete())
  test::assertTrue(session.commit(recovered))
end
