use test

def abstractDiagnosticCount(prepared: PreparedSubmission, code: String): Int
  var result = 0
  var diagnostic = prepared.diagnostics

  while diagnostic != null
    result = result + 1 if diagnostic.code == code
    diagnostic = diagnostic.next
  end
  return result
end

def abstractSyntaxError(name: String, source: String): Void
  let prepared = new SessionEnvironment("abstract-syntax-" + name).prepare(source)

  test::assertTrue(prepared.status.isInvalid())
  test::assertTrue(abstractDiagnosticCount(prepared, "NR001") > 0)
end

def abstractIncompleteSyntax(name: String, source: String): Void
  let prepared = new SessionEnvironment("abstract-incomplete-" + name).prepare(source)

  test::assertTrue(prepared.status.isIncomplete())
  test::assertTrue(abstractDiagnosticCount(prepared, "NR001") > 0)
end

def abstractDiagnosticContracts(): Void
  let reabstracted = new SessionEnvironment("abstract-reabstract").prepare("abstract class ConcreteBase\n  def value(): Int\n    return 1\n  end\nend\n\nabstract class Reabstracted: ConcreteBase\n  abstract override def value(): Int\nend\n\nclass MissingReabstracted: Reabstracted\nend\n")

  test::assertTrue(reabstracted.status.isInvalid())
  test::assertEqual(diagnosticCode(reabstracted), "NR255")
  let incompatible = new SessionEnvironment("abstract-incompatible").prepare("abstract class ReadonlyRequired\n  abstract readonly def label(): String\nend\n\nclass MutableLabel: ReadonlyRequired\n  def label(): String\n    return \"mutable\"\n  end\nend\n\nabstract class VisibleRequired\n  abstract def value(): Int\nend\n\nclass PrivateValue: VisibleRequired\n  private def value(): Int\n    return 1\n  end\nend\n")

  test::assertTrue(incompatible.status.isInvalid())
  test::assertEqual(abstractDiagnosticCount(incompatible, "NR177"), 2)
  abstractSyntaxError("legacy", "@abstract\nclass LegacyAbstract\nend\n")
  abstractSyntaxError("argument", "@abstract(\"unexpected\")\nclass ArgumentAbstract\nend\n")
  abstractSyntaxError("repeated", "abstract class RepeatedAbstract\n  abstract abstract def value(): Int\nend\n")
  abstractSyntaxError("order", "class OrderedModifiers\n  readonly override def value(): Int\n    return 1\n  end\nend\n")
  abstractSyntaxError("after-def", "class ModifierAfterDef\n  def static value(): Int\n    return 1\n  end\nend\n")
  abstractSyntaxError("body", "abstract class AbstractBody\n  abstract def value(): Int\n    return 1\n  end\nend\n")
  abstractIncompleteSyntax("resource", "resource")
  abstractIncompleteSyntax("public-resource", "public resource")
  let moduleReadonly = new SessionEnvironment("abstract-module-readonly").prepare("readonly def value(): Int\n  return 1\nend\n")

  test::assertTrue(moduleReadonly.status.isInvalid())
  test::assertEqual(diagnosticCode(moduleReadonly), "NR172")
  let genericModifier = new SessionEnvironment("abstract-generic-modifier").prepare("override def value<T>(input: T): T\n  return input\nend\n\nlet genericValue = value(1)\n")

  test::assertTrue(genericModifier.status.isInvalid())
  test::assertEqual(abstractDiagnosticCount(genericModifier, "NR172"), 1)
  let contextualNames = new SessionEnvironment("abstract-contextual-names").prepare("contract ContextualNames\n  readonly def readonly(): Int\n  end\nend\n\nabstract class ContextualBase\n  abstract readonly def abstract(): Int\nend\n\nclass ContextualValue: ContextualBase\n  override readonly def abstract(): Int\n    return 1\n  end\n\n  public static unsafe def create(): ContextualValue\n    return new ContextualValue()\n  end\n\n  def override(): Int\n    return this.abstract()\n  end\n\n  def readonly(): Int\n    return this.override()\n  end\nend\n")

  test::assertTrue(contextualNames.status.isComplete())
  let alternative = new SessionEnvironment("abstract-alternative").prepare("abstract enum AbstractChoice\n  case Value()\nend\n")

  test::assertTrue(alternative.status.isInvalid())
  test::assertEqual(diagnosticCode(alternative), "NR253")
  let representedAlternative = new SessionEnvironment("represented-alternative").prepare("@representation(\"utf8\")\nenum RepresentedChoice\n  case Value()\nend\n")

  test::assertEqual(diagnosticCode(representedAlternative), "NR245")
  let construction = new SessionEnvironment("abstract-construction").prepare("abstract class EmptyAbstract\nend\n\nlet value = new EmptyAbstract()\n")

  test::assertTrue(construction.status.isInvalid())
  test::assertEqual(diagnosticCode(construction), "NR256")
end

def abstractSessionContracts(): Void
  abstractDiagnosticContracts()
  let session = new SessionEnvironment("abstract-session")
  let abstractBase = session.prepare("abstract class SessionMeasured\n  abstract def value(): Int\nend\n")

  test::assertTrue(abstractBase.status.isComplete())
  test::assertTrue(session.commit(abstractBase))
  test::assertEqual(session.currentGeneration(), 1)
  let rejected = session.prepare("class MissingSessionMeasured: SessionMeasured\nend\n")

  test::assertTrue(rejected.status.isInvalid())
  test::assertEqual(diagnosticCode(rejected), "NR255")
  test::assertEqual(session.currentGeneration(), 1)
  let concrete = session.prepare("class CompleteSessionMeasured: SessionMeasured\n  override def value(): Int\n    return 34\n  end\nend\n\nlet measured: SessionMeasured = new CompleteSessionMeasured()\n")

  test::assertTrue(concrete.status.isComplete())
  test::assertTrue(hasBinding(concrete, "measured", "SessionMeasured"))
  test::assertTrue(session.commit(concrete))
  test::assertEqual(session.currentGeneration(), 2)
  let stillMissing = session.prepare("class StillMissing: SessionMeasured\nend\n")

  test::assertEqual(diagnosticCode(stillMissing), "NR255")
  test::assertEqual(session.currentGeneration(), 2)
  let independent = new SessionEnvironment("abstract-independent")
  let isolated = independent.prepare("class SessionMeasured\nend\n\nlet value = new SessionMeasured()\n")

  test::assertTrue(isolated.status.isComplete())
  test::assertTrue(independent.commit(isolated))
end

def abstractExecutionContracts(toolchain: SessionToolchain): Void
  let session = new ExecutableSession(toolchain)
  let abstractBase = session.submit("abstract class ExecutedMeasured\n  abstract def value(): Int\nend\n")

  test::assertTrue(abstractBase.execution.succeeded())
  let rejected = session.prepare("class MissingExecutedMeasured: ExecutedMeasured\nend\n")

  test::assertTrue(rejected.status.isInvalid())
  test::assertEqual(diagnosticCode(rejected), "NR255")
  let concrete = session.submit("class CompleteExecutedMeasured: ExecutedMeasured\n  override def value(): Int\n    return 34\n  end\nend\n\nlet measured: ExecutedMeasured = new CompleteExecutedMeasured()\n")

  test::assertTrue(concrete.execution.succeeded())
  let dispatched = session.submit("measured.value()\n")

  test::assertTrue(dispatched.execution.succeeded())
  test::assertEqual(dispatched.execution.resultType, "Int")
  test::assertEqual(dispatched.execution.resultText, "34")
  test::assertTrue(session.reset().succeeded())
  let afterReset = session.submit("class ExecutedMeasured\nend\n\nnew ExecutedMeasured()\n")

  test::assertTrue(afterReset.execution.succeeded())
  test::assertTrue(session.dispose().succeeded())
end
