use test

def abstractDiagnosticCount(prepared: PreparedSubmission, code: String): Int
  var result = 0
  var diagnostic = prepared.diagnostics

  while diagnostic != null
    result = result + 1 if diagnostic.code == code
    diagnostic = diagnostic.next
  end
  return result
end

def abstractDiagnosticContracts(): Void
  let reabstracted = new SessionEnvironment("abstract-reabstract").prepare("@abstract\nclass ConcreteBase\n  def value(): Int\n    return 1\n  end\nend\n\n@abstract\nclass Reabstracted: ConcreteBase\n  @abstract\n  @override\n  def value(): Int\n  end\nend\n\nclass MissingReabstracted: Reabstracted\nend\n")

  test.assertEqual(reabstracted.status, "invalid")
  test.assertEqual(diagnosticCode(reabstracted), "NR255")
  let incompatible = new SessionEnvironment("abstract-incompatible").prepare("@abstract\nclass ReadonlyRequired\n  @abstract\n  @readonly\n  def label(): String\n  end\nend\n\nclass MutableLabel: ReadonlyRequired\n  def label(): String\n    return \"mutable\"\n  end\nend\n\n@abstract\nclass VisibleRequired\n  @abstract\n  def value(): Int\n  end\nend\n\nclass PrivateValue: VisibleRequired\n  private def value(): Int\n    return 1\n  end\nend\n")

  test.assertEqual(incompatible.status, "invalid")
  test.assertEqual(abstractDiagnosticCount(incompatible, "NR177"), 2)
  let invalidAnnotations = new SessionEnvironment("abstract-annotations").prepare("@abstract\nclass InvalidAnnotations\n  @abstract\n  @abstract\n  def repeated(): Int\n  end\n\n  @abstract(\"unexpected\")\n  def argument(): Int\n  end\nend\n")

  test.assertEqual(invalidAnnotations.status, "invalid")
  test.assertEqual(abstractDiagnosticCount(invalidAnnotations, "NR254"), 2)
  let alternative = new SessionEnvironment("abstract-alternative").prepare("@abstract\nenum AbstractChoice\n  case Value()\nend\n")

  test.assertEqual(alternative.status, "invalid")
  test.assertEqual(diagnosticCode(alternative), "NR253")
  let representedAlternative = new SessionEnvironment("represented-alternative").prepare("@representation(\"utf8\")\nenum RepresentedChoice\n  case Value()\nend\n")

  test.assertEqual(diagnosticCode(representedAlternative), "NR245")
  let construction = new SessionEnvironment("abstract-construction").prepare("@abstract\nclass EmptyAbstract\nend\n\nlet value = new EmptyAbstract()\n")

  test.assertEqual(construction.status, "invalid")
  test.assertEqual(diagnosticCode(construction), "NR256")
end

def abstractSessionContracts(): Void
  abstractDiagnosticContracts()
  let session = new SessionEnvironment("abstract-session")
  let abstractBase = session.prepare("@abstract\nclass SessionMeasured\n  @abstract\n  def value(): Int\n  end\nend\n")

  test.assertEqual(abstractBase.status, "complete")
  test.assertTrue(session.commit(abstractBase))
  test.assertEqual(session.currentGeneration(), 1)
  let rejected = session.prepare("class MissingSessionMeasured: SessionMeasured\nend\n")

  test.assertEqual(rejected.status, "invalid")
  test.assertEqual(diagnosticCode(rejected), "NR255")
  test.assertEqual(session.currentGeneration(), 1)
  let concrete = session.prepare("class CompleteSessionMeasured: SessionMeasured\n  @override\n  def value(): Int\n    return 34\n  end\nend\n\nlet measured: SessionMeasured = new CompleteSessionMeasured()\n")

  test.assertEqual(concrete.status, "complete")
  test.assertTrue(hasBinding(concrete, "measured", "SessionMeasured"))
  test.assertTrue(session.commit(concrete))
  test.assertEqual(session.currentGeneration(), 2)
  let stillMissing = session.prepare("class StillMissing: SessionMeasured\nend\n")

  test.assertEqual(diagnosticCode(stillMissing), "NR255")
  test.assertEqual(session.currentGeneration(), 2)
  let independent = new SessionEnvironment("abstract-independent")
  let isolated = independent.prepare("class SessionMeasured\nend\n\nlet value = new SessionMeasured()\n")

  test.assertEqual(isolated.status, "complete")
  test.assertTrue(independent.commit(isolated))
end

def abstractExecutionContracts(toolchain: SessionToolchain): Void
  let session = new ExecutableSession(toolchain)
  let abstractBase = session.submit("@abstract\nclass ExecutedMeasured\n  @abstract\n  def value(): Int\n  end\nend\n")

  test.assertTrue(abstractBase.execution.succeeded)
  let rejected = session.prepare("class MissingExecutedMeasured: ExecutedMeasured\nend\n")

  test.assertEqual(rejected.status, "invalid")
  test.assertEqual(diagnosticCode(rejected), "NR255")
  let concrete = session.submit("class CompleteExecutedMeasured: ExecutedMeasured\n  @override\n  def value(): Int\n    return 34\n  end\nend\n\nlet measured: ExecutedMeasured = new CompleteExecutedMeasured()\n")

  test.assertTrue(concrete.execution.succeeded)
  let dispatched = session.submit("measured.value()\n")

  test.assertTrue(dispatched.execution.succeeded)
  test.assertEqual(dispatched.execution.resultType, "Int")
  test.assertEqual(dispatched.execution.resultText, "34")
  test.assertTrue(session.reset().succeeded)
  let afterReset = session.submit("class ExecutedMeasured\nend\n\nnew ExecutedMeasured()\n")

  test.assertTrue(afterReset.execution.succeeded)
  test.assertTrue(session.dispose().succeeded)
end
