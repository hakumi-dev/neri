use test
use host

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collectGarbage(): Void
end

def sessionFunction(module: IrModule, name: String): IrFunction?
  var function = module.firstFunction

  while function != null
    if function.symbol.name == name
      return function
    end
    function = function.nextFunction
  end
  return null
end

def incrementalPreparationContracts(): Void
  let typedSession = new SessionEnvironment("typed-session")
  let value = typedSession.prepare("1 + 2\n")

  test.assertEqual(value.status, "complete")
  test.assertEqual(value.resultType, "Int")
  test.assertTrue(typedSession.discard(value))

  let ordinary = typedSession.prepare("def ordinary(): Void\n  1 + 2\nend\n")

  test.assertEqual(ordinary.status, "invalid")

  let effectful = typedSession.prepare("use host\nhost.readText(\"session-effect-probe\")\n")

  test.assertEqual(effectful.status, "complete")
  test.assertEqual(effectful.resultType, "String?")
  test.assertTrue(typedSession.discard(effectful))

  let session = new SessionEnvironment("retained-session")
  let parent = session.prepare("class Base\n  def value(): Int\n    return 7\n  end\nend\n\ndef identity<T>(value: T): T\n  return value\nend\n")

  test.assertEqual(parent.status, "complete")
  let parentExecution = session.claimExecution(parent)
  let parentModule = session.claimedModule(parent)

  test.assertTrue(parentExecution != null)
  test.assertTrue(parentModule != null)
  var parentSourceId = ""

  if parentModule != null
    let source = parentModule.firstSource

    if source != null
      parentSourceId = source.id
    end
  end

  test.assertTrue(parentSourceId != "")
  test.assertTrue(session.releaseExecution(parent))
  test.assertTrue(session.commit(parent))

  let child = session.prepare("class Derived: Base\nend\n\nlet derived = new Derived()\nlet inherited = derived.value()\nlet generic = identity(41)\n")

  test.assertEqual(child.status, "complete")
  test.assertTrue(hasBinding(child, "inherited", "Int"))
  test.assertTrue(hasBinding(child, "generic", "Int"))
  let childExecution = session.claimExecution(child)
  let childModule = session.claimedModule(child)

  test.assertTrue(childExecution != null)
  test.assertTrue(childModule != null)
  if childModule != null
    let genericFunction = sessionFunction(childModule, "identity<Int>")

    test.assertTrue(genericFunction != null)
    if genericFunction != null
      test.assertEqual(genericFunction.location.sourceId, parentSourceId)
    end
  end

  test.assertTrue(session.releaseExecution(child))
  test.assertTrue(session.commit(child))

  let rejected = session.prepare("let broken: Int = \"wrong\"\n")

  test.assertEqual(rejected.status, "invalid")

  let afterRejected = session.prepare("let retained = identity(42) + inherited\n")

  test.assertEqual(afterRejected.status, "complete")
  test.assertTrue(hasBinding(afterRejected, "retained", "Int"))
  test.assertTrue(session.discard(afterRejected))
end

def executionResultContracts(toolchain: SessionToolchain): Void
  let session = new ExecutableSession(toolchain)
  let first = session.submit("class Counter\n  public count: Int = 0\n\n  def next(): Int\n    this.count = this.count + 1\n    return this.count\n  end\nend\n\nlet counter = new Counter()\ncounter.next()\n")

  test.assertTrue(first.execution.succeeded)
  test.assertEqual(first.execution.resultType, "Int")
  test.assertEqual(first.execution.resultText, "1")

  let retained = session.submit("counter.count\n")

  test.assertTrue(retained.execution.succeeded)
  test.assertEqual(retained.execution.resultType, "Int")
  test.assertEqual(retained.execution.resultText, "1")
  test.assertTrue(session.dispose().succeeded)

  let literalSession = new ExecutableSession(toolchain)
  let literal = literalSession.submit("\"résultat ☃\"\n")
  let savedResultText = literal.execution.resultText

  test.assertTrue(literal.execution.succeeded)
  test.assertEqual(savedResultText, "résultat ☃")
  test.assertTrue(literalSession.dispose().succeeded)

  let nextSession = new ExecutableSession(toolchain)
  let next = nextSession.submit("\"next\"\n")

  test.assertTrue(next.execution.succeeded)
  test.assertEqual(next.execution.resultText, "next")
  test.assertTrue(nextSession.dispose().succeeded)

  unsafe
    collectGarbage()
  end

  test.assertEqual(savedResultText, "résultat ☃")
end

def sessionSymbolIsolationContracts(toolchain: SessionToolchain): Void
  let first = new ExecutableSession(toolchain)
  let firstDefinition = first.submit("class SessionValue\n  def value(): Int\n    return 11\n  end\nend\n")

  test.assertTrue(firstDefinition.execution.succeeded)

  let second = new ExecutableSession(toolchain)
  let secondDefinition = second.submit("class SessionValue\n  def value(): Int\n    return 22\n  end\nend\n")

  test.assertTrue(secondDefinition.execution.succeeded)

  let firstValue = first.submit("new SessionValue().value()\n")

  test.assertTrue(firstValue.execution.succeeded)
  test.assertEqual(firstValue.execution.resultText, "11")

  let secondValue = second.submit("new SessionValue().value()\n")

  test.assertTrue(secondValue.execution.succeeded)
  test.assertEqual(secondValue.execution.resultText, "22")
  test.assertTrue(first.dispose().succeeded)
  test.assertTrue(second.dispose().succeeded)
end

def retainedPruningContracts(toolchain: SessionToolchain): Void
  let session = new ExecutableSession(toolchain)
  let definitions = session.submit("struct SessionRecord\n  value: Int32\nend\n\ndef retainedFunction(): Int\n  return 7\nend\n\nclass Parent\n  def value(enabled: Bool = true): Int\n    return enabled ? 10 : 0\n  end\nend\n\nclass Child: Parent\n  override def value(enabled: Bool = false): Int\n    return enabled ? 42 : 1\n  end\nend\n\nlet parent: Parent = new Child()\n")

  test.assertTrue(definitions.execution.succeeded)
  test.assertTrue(session.submit("let unused = 0\n").execution.succeeded)

  let retainedFunction = session.submit("retainedFunction()\n")

  test.assertTrue(retainedFunction.execution.succeeded)
  test.assertEqual(retainedFunction.execution.resultText, "7")

  let virtualDefault = session.submit("parent.value()\n")

  test.assertTrue(virtualDefault.execution.succeeded)
  test.assertEqual(virtualDefault.execution.resultText, "42")

  let nativeRecord = session.submit("native.sizeOf<SessionRecord>()\n")

  test.assertTrue(nativeRecord.execution.succeeded)
  test.assertEqual(nativeRecord.execution.resultText, "4")
  test.assertTrue(session.dispose().succeeded)
end

def cacheContractsEnabled(toolchain: SessionToolchain): Bool
  let cacheDirectory = host.environment("NERI_CACHE_DIR")
  let fixtureDirectory = host.environment("NERI_SESSION_CACHE_TEST_DIR")
  let linker = host.environment("NERI_LINKER")
  let manifest = host.environment("NERI_SESSION_CACHE_TEST_MANIFEST")

  return toolchain.cacheEnabled && toolchain.target.isMacOS() && runCacheSupportedHost() && cacheDirectory != null && fixtureDirectory != null && linker != null && manifest != null && cacheDirectory == fixtureDirectory && linker == toolchain.linker && bootstrapStartsWith(cacheDirectory, "/")
end

def objectCacheContractsEnabled(toolchain: SessionToolchain): Bool
  let bridge = host.environment("NERI_SESSION_CACHE_TEST_BRIDGE")
  let selected = host.environment("NERI_SESSION_OBJECT_LINKER")

  if bridge == null || bridge == ""
    return false
  end
  if selected != null
    return cacheContractsEnabled(toolchain) && selected == bridge
  end
  let manifest = host.environment("NERI_RUNTIME_MANIFEST")

  return manifest != null && cacheContractsEnabled(toolchain) && bootstrapDirectory(manifest) + "/libneri-session-object-linker.dylib" == bridge
end

def sessionCacheContracts(toolchain: SessionToolchain, root: String): Void
  if !cacheContractsEnabled(toolchain)
    return
  end
  let project = root + "/tests/session-initializer/manifest.json"
  let firstInitializer = new ExecutableSession(toolchain)
  let firstInitialization = firstInitializer.initializeProject(project, "service", "services.createSessionService", "cachedService", "use console\n")

  test.assertTrue(firstInitialization.succeeded)
  test.assertTrue(!firstInitialization.cacheHit)
  test.assertTrue(firstInitializer.dispose().succeeded)

  let secondInitializer = new ExecutableSession(toolchain)
  let secondInitialization = secondInitializer.initializeProject(project, "service", "services.createSessionService", "cachedService", "use console\n")

  test.assertTrue(secondInitialization.succeeded)
  test.assertTrue(secondInitialization.cacheHit)
  test.assertTrue(secondInitializer.dispose().succeeded)

  let source = "1 + 2\n"
  let first = new ExecutableSession(toolchain)
  let firstResult = first.submit(source)

  test.assertTrue(firstResult.execution.succeeded)
  test.assertTrue(!firstResult.execution.cacheHit)
  test.assertTrue(first.dispose().succeeded)

  let second = new ExecutableSession(toolchain)
  let secondResult = second.submit(source)

  test.assertTrue(secondResult.execution.succeeded)
  test.assertTrue(secondResult.execution.cacheHit)
  test.assertTrue(second.dispose().succeeded)

  let releaseToolchain = new SessionToolchain(toolchain.compiler, toolchain.linker,
    toolchain.target, toolchain.workRoot, true)
  let release = new ExecutableSession(releaseToolchain)
  let releaseResult = release.submit(source)

  test.assertTrue(releaseResult.execution.succeeded)
  test.assertTrue(!releaseResult.execution.cacheHit)
  test.assertTrue(release.dispose().succeeded)

  let changed = new ExecutableSession(toolchain)
  let changedResult = changed.submit("1 + 3\n")

  test.assertTrue(changedResult.execution.succeeded)
  test.assertTrue(!changedResult.execution.cacheHit)
  test.assertTrue(changed.dispose().succeeded)

  let manifestPath = host.environment("NERI_SESSION_CACHE_TEST_MANIFEST")

  if manifestPath == null
    test.assertTrue(false)
    return
  end
  let originalManifest = host.readText(manifestPath)

  if originalManifest == null
    test.assertTrue(false)
    return
  end
  let manifestSource = "1 + 4\n"
  let manifestFirst = new ExecutableSession(toolchain)
  let manifestFirstResult = manifestFirst.submit(manifestSource)

  test.assertTrue(manifestFirstResult.execution.succeeded)
  test.assertTrue(!manifestFirstResult.execution.cacheHit)
  test.assertTrue(manifestFirst.dispose().succeeded)

  let manifestSecond = new ExecutableSession(toolchain)
  let manifestSecondResult = manifestSecond.submit(manifestSource)

  test.assertTrue(manifestSecondResult.execution.succeeded)
  test.assertTrue(manifestSecondResult.execution.cacheHit)
  test.assertTrue(manifestSecond.dispose().succeeded)
  test.assertTrue(host.writeText(manifestPath, originalManifest + "\n"))

  let manifestChanged = new ExecutableSession(toolchain)
  let manifestChangedResult = manifestChanged.submit(manifestSource)

  test.assertTrue(manifestChangedResult.execution.succeeded)
  test.assertTrue(!manifestChangedResult.execution.cacheHit)
  test.assertTrue(manifestChanged.dispose().succeeded)
  test.assertTrue(host.writeText(manifestPath, originalManifest))

  if objectCacheContractsEnabled(toolchain)
    let bridgePath = host.environment("NERI_SESSION_CACHE_TEST_BRIDGE")

    if bridgePath == null
      test.assertTrue(false)
      return
    end
    let bridgeSource = "1 + 5\n"
    let bridgeFirst = new ExecutableSession(toolchain)
    let bridgeFirstResult = bridgeFirst.submit(bridgeSource)

    test.assertTrue(bridgeFirstResult.execution.succeeded)
    test.assertTrue(!bridgeFirstResult.execution.cacheHit)
    test.assertTrue(bridgeFirst.dispose().succeeded)

    let bridgeSecond = new ExecutableSession(toolchain)
    let bridgeSecondResult = bridgeSecond.submit(bridgeSource)

    test.assertTrue(bridgeSecondResult.execution.succeeded)
    test.assertTrue(bridgeSecondResult.execution.cacheHit)
    test.assertTrue(bridgeSecond.dispose().succeeded)
    let touched = host.run("touch", [bridgePath])

    if touched == null
      test.assertTrue(false)
      return
    end

    test.assertEqual(touched, 0)

    let bridgeChanged = new ExecutableSession(toolchain)
    let bridgeChangedResult = bridgeChanged.submit(bridgeSource)

    test.assertTrue(bridgeChangedResult.execution.succeeded)
    test.assertTrue(!bridgeChangedResult.execution.cacheHit)
    test.assertTrue(bridgeChanged.dispose().succeeded)
  end

  let reset = new ExecutableSession(toolchain)
  let retained = reset.submit("let previous = 7\n")

  test.assertTrue(retained.execution.succeeded)
  test.assertTrue(reset.reset().succeeded)

  let missing = reset.prepare("previous\n")

  test.assertEqual(missing.status, "invalid")
  test.assertTrue(reset.submit("let fresh = 8\n").execution.succeeded)
  test.assertTrue(reset.dispose().succeeded)
end
