use test

def initializerContracts(toolchain: SessionToolchain, root: String): Void
  let project = root + "/tests/session-initializer/manifest.json"
  let first = new ExecutableSession(toolchain)
  let second = new ExecutableSession(toolchain)
  let rejected = first.initializeProject(project, "service", "services.createSessionService", "app", "test.assertTrue(false)\n")

  test.assertTrue(!rejected.succeeded())
  test.assertTrue(first.initializeProject(project, "service", "services.createSessionService", "app", "use test\n").succeeded())
  test.assertTrue(second.initializeProject(project, "service", "services.createSessionService").succeeded())
  test.assertTrue(first.submit("test.assertEqual(app.value, 17)\napp.value = 38\n").execution.succeeded())
  test.assertTrue(second.submit("use test\ntest.assertEqual(service.value, 17)\n").execution.succeeded())
  test.assertTrue(!first.initializeProject(project, "service", "services.createSessionService", "app").succeeded())
  test.assertTrue(first.reset().succeeded())
  test.assertTrue(first.initializeProject(project, "service", "services.createSessionService", "app", "use test\n").succeeded())
  test.assertTrue(first.submit("test.assertEqual(app.value, 17)\n").execution.succeeded())
  test.assertTrue(first.dispose().succeeded())
  test.assertTrue(second.dispose().succeeded())
end
