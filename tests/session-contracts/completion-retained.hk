use host
use test

def retainedCompletionContracts(): Void
  let source = "class CompletionBox<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\nend\n"
  let tokens = new BootstrapLexer(source).lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, root, utf16Length(source))

  binder.requireEntryPoint = false
  let model = binder.bind()
  let retained = new SessionCompilation(model, parser.arena, source)
  let syntaxCount = parser.arena.count()
  let boundCount = model.bound.count()
  let query = "let box = new CompletionBox<Int>(1)\nbox."
  let result = sessionCompleteSource(query, host.stringByteLength(query), 0, null,
    retained, null, "", new StringBuffer())

  test.assertTrue(completionHas(result, "value"))
  test.assertEqual(parser.arena.count(), syntaxCount)
  test.assertEqual(model.bound.count(), boundCount)
  test.assertEqual(model.genericInstances, 0)
  test.assertTrue(model.firstClass == null)
end
