use test

def snapshotContracts(): Void
  let source = new SessionSourceSnapshot()

  source.add("base.hk", "def base(): Int\n  return 1\nend\n")
  let environment = new SessionEnvironment("snapshot-contract", source)

  source.add("late.hk", "fail(\"caller mutation\")\n")

  let prepared = environment.prepare("let value = base() + 1\n")

  test::assertTrue(prepared.status.isComplete())
  let execution = environment.claimExecution(prepared)

  test::assertTrue(execution != null)
  let frozen = environment.claimedSnapshot(prepared)

  test::assertTrue(frozen != null)
  if frozen != null
    test::assertEqual(frozen.count(), 1)
    # A returned view is another copy and cannot alter the pending candidate.
    frozen.add("forged.hk", "fail(\"forged\")\n")
  end
  let secondView = environment.claimedSnapshot(prepared)

  test::assertTrue(secondView != null)
  if secondView != null
    test::assertEqual(secondView.count(), 1)
  end

  test::assertTrue(environment.releaseExecution(prepared))
  test::assertTrue(environment.discard(prepared))

  var megabyte = " "

  while host::stringByteLength(megabyte) < 1048576
    megabyte = megabyte + megabyte
  end
  let large = new SessionSourceSnapshot()

  large.add("first.hk", megabyte)
  large.add("second.hk", megabyte)
  large.add("third.hk", megabyte)

  test::assertEqual(large.error, "")
  test::assertEqual(large.frozenCopy().count(), 3)
  large.add("fourth.hk", megabyte)

  test::assertEqual(large.error, "Project and standard-library snapshot exceeds 4194304 bytes.")
  test::assertEqual(large.count(), 3)
  let limited = new SessionEnvironment("submission-limit")
  let oversized = limited.prepare(megabyte + " ")
  let diagnostic = oversized.diagnostics

  test::assertTrue(oversized.status.isInvalid())
  test::assertTrue(diagnostic != null)
  if diagnostic != null
    test::assertEqual(diagnostic.code, "NR_SESSION_LIMIT")
  end
end
