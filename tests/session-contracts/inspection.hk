use test
use console

def inspectionAssertSucceeded(response: SessionResponse, label: String): Void
  if !response.execution.succeeded()
    console::println(label + ": " + response.format())
  end

  test::assertTrue(response.execution.succeeded())
end

def sessionInspectionContracts(toolchain: SessionToolchain): Void
  let session = new ExecutableSession(toolchain)
  let declaration = session.submit("class InspectionEntity\n  public name: String\n  public value: Int\n  private secret: String\n\n  def init(name: String, value: Int): Void\n    this.name = name\n    this.value = value\n    this.secret = \"hidden\"\n  end\nend\n\nclass InspectionRows<T>\n  private items: T[]\n\n  def init(items: T[]): Void\n    this.items = items\n  end\n\n  public def inspectItems(limit: Int): T[]\n    return this.items\n  end\nend\n\nenum InspectionResult<T>\n  case Rows(rows: InspectionRows<T>)\n  case Failure(message: String)\nend\n\nclass InspectionProbe\n  public calls: Int = 0\n\n  def result(): InspectionResult<InspectionEntity>\n    this.calls = this.calls + 1\n    return InspectionResult<InspectionEntity>.Rows(new InspectionRows<InspectionEntity>([new InspectionEntity(\"line\\nfeed\", 7)]))\n  end\nend\n\nlet probe = new InspectionProbe()\n")

  inspectionAssertSucceeded(declaration, "declaration")
  let rows = session.submit("probe.result()\n")

  inspectionAssertSucceeded(rows, "rows")

  test::assertEqual(rows.execution.resultText, "InspectionResult<InspectionEntity>.Rows(rows: InspectionRows<InspectionEntity>{items: [InspectionEntity{name: \"line\\nfeed\", value: 7}]})")
  let calls = session.submit("probe.calls\n")

  inspectionAssertSucceeded(calls, "calls")

  test::assertEqual(calls.execution.resultText, "1")
  let failure = session.submit("InspectionResult<InspectionEntity>.Failure(\"bad\")\n")

  inspectionAssertSucceeded(failure, "failure")

  test::assertEqual(failure.execution.resultText, "InspectionResult<InspectionEntity>.Failure(message: \"bad\")")
  let bounded = session.submit("[1, 2, 3, 4, 5, 6, 7, 8, 9]\n")

  inspectionAssertSucceeded(bounded, "bounded")

  test::assertEqual(bounded.execution.resultText, "[1, 2, 3, 4, 5, 6, 7, 8...]")
  let nullable = session.submit("let optional: InspectionEntity? = new InspectionEntity(\"safe\", 8)\noptional\n")

  inspectionAssertSucceeded(nullable, "nullable")

  test::assertEqual(nullable.execution.resultText, "InspectionEntity{name: \"safe\", value: 8}")
  let readOnly = session.submit("let snapshot: readonly InspectionEntity = new InspectionEntity(\"frozen\", 9)\nsnapshot\n")

  inspectionAssertSucceeded(readOnly, "readonly")

  test::assertEqual(readOnly.execution.resultText, "InspectionEntity{name: \"frozen\", value: 9}")
  test::assertTrue(session.dispose().succeeded())
end
