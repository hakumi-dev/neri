use test

def partitionLocation(sourceId: String): IrLocation
  let location = new IrLocation(true, 0, 1)

  location.sourceId = sourceId
  return location
end

def partitionFunction(module: IrModule, name: String, sourceId: String, literal: String): IrFunction
  let function = new IrFunction(irSymbol("partition", module.domains.symbolKind.getFunction(), name), "void", module.domains.functionKind.getFunction(), false, partitionLocation(sourceId))
  let block = function.createBlock()

  if literal != ""
    block.addInstruction(new IrInstruction(module.domains.opcode.getConstant(), 0, "string", [], [], null, module.domains.constantKind.getStringGlobal(), literal, null, false, partitionLocation(sourceId)))
  end
  block.terminator = new IrTerminator(module.domains.terminatorKind.getReturn(), partitionLocation(sourceId))
  return function
end

def partitionUnit(first: IrCompilationUnit?, owner: String): IrCompilationUnit?
  var unit = first

  while unit != null
    if unit.owner == owner
      return unit
    end
    unit = unit.next
  end
  return null
end

def partitionFunctionState(unit: IrCompilationUnit?, name: String): String
  if unit == null
    return "missing"
  end
  var function = unit.module.firstFunction

  while function != null
    if function.symbol.name == name
      return function.retained ? "retained" : "owned"
    end
    function = function.nextFunction
  end
  return "missing"
end

def partitionGlobalCount(unit: IrCompilationUnit?): Int
  if unit == null
    return -1
  end
  return unit.module.globalCount
end

def partitionImportCount(unit: IrCompilationUnit?): Int
  if unit == null
    return -1
  end
  return unit.module.importCount
end

class PartitionLowered
  public module: IrModule
  public semantic: SemanticModel

  def init(module: IrModule, semantic: SemanticModel): Void
    this.module = module
    this.semantic = semantic
  end
end

def lowerPartitionSources(): PartitionLowered
  let librarySource = "class StableLibrary\nend\n"
  let consumerSource = "def main(): Void\nend\n"
  let source = librarySource + consumerSource
  let boundary = (new IrSourceMap(librarySource)).utf16Length()
  let tokens = (new BootstrapLexer(source)).lex()
  let parser = new BootstrapParser(tokens)

  parser.addSourceBoundary(0)
  parser.addSourceBoundary(boundary)
  let root = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

  binder.clearSources()
  binder.addSource("library", 0)
  binder.addSource("consumer", boundary)
  let semantic = binder.bind()
  let lowerer = new IrLowerer(semantic, parser.arena, source, "partition-lowered")
  let ids = new StringBuffer()
  let texts = new StringBuffer()
  let starts = new IntBuffer()

  ids.add("library")
  texts.add(librarySource)
  starts.add(0)
  ids.add("consumer")
  texts.add(consumerSource)
  starts.add(boundary)
  lowerer.setSources(ids, texts, starts)
  return new PartitionLowered(lowerer.lower(), semantic)
end

def partitionClassSource(unit: IrCompilationUnit?, name: String): String
  if unit == null
    return ""
  end
  var classValue = unit.module.firstClass

  while classValue != null
    if classValue.symbol.name == name
      return classValue.declarationSourceId
    end
    classValue = classValue.nextClass
  end
  return ""
end

def partitionSourceCount(unit: IrCompilationUnit?): Int
  if unit == null
    return -1
  end
  return unit.module.sourceCount
end

def partitionSample(consumerLiteral: String, consumerTasks: Bool = true): IrCompilationUnit?
  let module = new IrModule("partition", "")

  module.clearSources()
  module.addSource(new IrSource("consumer", "consumer source", 0))
  module.addSource(new IrSource("library", "library source", 16))
  let library = partitionFunction(module, "libraryWork", "library", "literal.library")

  library.callees.add("consumerHelper")
  module.addFunction(library)
  module.addFunction(partitionFunction(module, "main", "consumer", ""))
  module.addFunction(partitionFunction(module, "consumerHelper", "consumer", consumerLiteral))
  let generic = partitionFunction(module, "generic.Int", "library", "")

  module.addFunction(generic)
  module.addClass(new IrClass(irSymbol("partition", module.domains.symbolKind.getClass(), "ManualLibrary"), null, module.domains.access.getInternal(), partitionLocation("library")))
  let manualMethod = partitionFunction(module, "ManualLibrary.helper", "consumer", "")

  manualMethod.declaringClass = irSymbol("partition", module.domains.symbolKind.getClass(), "ManualLibrary")
  module.addFunction(manualMethod)
  module.addGlobal(new IrGlobal(irSymbol("partition", module.domains.symbolKind.getGlobal(), "literal.library"), "library", irNoLocation()))
  module.addGlobal(new IrGlobal(irSymbol("partition", module.domains.symbolKind.getGlobal(), consumerLiteral), consumerLiteral, irNoLocation()))
  module.addImport(new IrImport(irSymbol("partition", module.domains.symbolKind.getLibraryFunction(), "runtime.import.library"), "void", module.domains.importKind.getRuntime(), "neri_rt_v1_library", new EffectSet(), partitionLocation("library")))
  module.requiredFeatures.requireScopedTasks() if consumerTasks
  let semantic = new SemanticModel()

  semantic.addClass(new SemanticClass("ManualLibrary", "ManualLibrary", "", "internal", 0))
  let specialization = new SemanticCallable("generic.Int", "generic", "", "", "Void", true, false, "internal", -1)

  specialization.genericOrigin = 0
  semantic.addFunction(specialization)
  let ids = new StringBuffer()
  let owners = new StringBuffer()

  ids.add("consumer")
  owners.add("consumer-owner")
  ids.add("library")
  owners.add("library-owner")
  return irPartitionModule(module, semantic, ids, owners, "consumer-owner")
end

def parserSourceBoundaryCase(user: String): Void
  let library = "sealed class LibraryType\nend\n"
  let boundary = utf16Length(user)
  let tokens = (new BootstrapLexer(user + library)).lex()
  let parser = new BootstrapParser(tokens)

  parser.addSourceBoundary(0)
  parser.addSourceBoundary(boundary)
  let root = parser.parseProgram()
  var libraryParsed = false
  var index = 0

  while index < parser.arena.childCountAt(root)
    let node = parser.arena.childAt(root, index)

    if parser.arena.kindAt(node).isClass() && semanticField(parser.arena.dataAt(node), 2) == "LibraryType"
      libraryParsed = true
    end
    index = index + 1
  end

  test.assertTrue(parser.diagnostics.count() > 0)
  test.assertTrue(libraryParsed)
  index = 0

  while index < parser.diagnostics.count()
    test.assertTrue(parser.diagnostics.starts.get(index) < boundary)
    index = index + 1
  end
end

def parserSourceBoundaryContracts(): Void
  parserSourceBoundaryCase("def outer(value: String, fallback: Int): Void\nend\ndef main(): Void\n  outer(unknown(\nend\n")
  parserSourceBoundaryCase("def main(): Void\n  let value =\n")
  parserSourceBoundaryCase("def main(\n")
end

def partitionContracts(): Void
  parserSourceBoundaryContracts()
  let first = partitionSample("literal.consumer.one")
  let library = partitionUnit(first, "library-owner")
  let consumer = partitionUnit(first, "consumer-owner")

  test.assertEqual(partitionFunctionState(library, "libraryWork"), "owned")
  test.assertEqual(partitionFunctionState(library, "ManualLibrary.helper"), "owned")
  test.assertEqual(partitionFunctionState(consumer, "ManualLibrary.helper"), "missing")
  test.assertEqual(partitionFunctionState(library, "consumerHelper"), "retained")
  test.assertEqual(partitionFunctionState(consumer, "consumerHelper"), "owned")
  test.assertEqual(partitionFunctionState(consumer, "generic.Int"), "owned")
  test.assertEqual(partitionGlobalCount(library), 1)
  test.assertEqual(partitionGlobalCount(consumer), 1)
  test.assertEqual(partitionImportCount(library), 0)
  test.assertEqual(partitionImportCount(consumer), 1)
  test.assertTrue(library != null && library.module.requiredFeatures.hasNativeStrings())
  test.assertTrue(library != null && library.module.requiredFeatures.hasStringData())
  test.assertTrue(library != null && !library.module.requiredFeatures.hasScopedTasks())
  test.assertTrue(consumer != null && consumer.module.requiredFeatures.hasScopedTasks())
  let withoutTasks = partitionSample("literal.consumer.one", false)
  let libraryWithoutTasks = partitionUnit(withoutTasks, "library-owner")

  if library != null && libraryWithoutTasks != null
    test.assertEqual(irSerializeEnvelopeHex(library.module), irSerializeEnvelopeHex(libraryWithoutTasks.module))
  else
    test.assertTrue(false)
  end
  let second = partitionSample("literal.consumer.two")
  let secondLibrary = partitionUnit(second, "library-owner")

  if library != null && secondLibrary != null
    test.assertEqual(irSerializeEnvelopeHex(library.module), irSerializeEnvelopeHex(secondLibrary.module))
  else
    test.assertTrue(false)
  end
end

def loweredPartitionContracts(): Void
  let lowered = lowerPartitionSources()
  let ids = new StringBuffer()
  let owners = new StringBuffer()

  ids.add("library")
  owners.add("library-owner")
  ids.add("consumer")
  owners.add("consumer-owner")
  let units = irPartitionModule(lowered.module, lowered.semantic, ids, owners, "consumer-owner")
  let library = partitionUnit(units, "library-owner")
  let consumer = partitionUnit(units, "consumer-owner")

  test.assertEqual(partitionClassSource(library, "StableLibrary"), "library")
  test.assertEqual(partitionSourceCount(library), 1)
  test.assertEqual(partitionFunctionState(consumer, "main"), "owned")
end
