use console
use host
use test

def declarationItems(source: String, snippets: Bool = false): LspJson
  let marker = bootstrapFindText(source, "|")

  test.assertTrue(marker >= 0)
  let text = host.stringSlice(source, 0, marker) + host.stringSlice(source, marker + 1, host.stringByteLength(source) - marker - 1)
  let position = (new IrSourceMap(host.stringSlice(source, 0, marker))).utf16Length()
  let document = new LspDocument()

  document.uri = "untitled:declaration"
  document.text = text
  document.publishDiagnostics = false
  var result = lspDeclarationCompletion(document, position, snippets, lspConfiguredDeclarationCatalog())

  if result == null
    let server = new LspServer()

    server.analyze(document)
    result = lspCompletion(document, position, snippets)
  end
  if result != null
    let parsed = (new LspJsonParser(result)).parse()

    return parsed.kind == "array" ? parsed : parsed.get("items")
  end
  return new LspJson()
end

def assertDeclaration(source: String, expected: String, snippets: Bool = false): Void
  let items = declarationItems(source, snippets)
  let item = items.first

  console.println("Missing declaration: " + source) if item == null

  test.assertTrue(item != null)
  if item == null
    return
  end
  let edit = item.get("textEdit")
  let marker = bootstrapFindText(source, "|")
  let original = host.stringSlice(source, 0, marker) + host.stringSlice(source, marker + 1, host.stringByteLength(source) - marker - 1)
  let start = lspByteOffset(original, edit.get("range").get("start"))
  let finish = lspByteOffset(original, edit.get("range").get("end"))
  let actual = host.stringSlice(original, 0, start) + edit.get("newText").value + host.stringSlice(original, finish, host.stringByteLength(original) - finish)

  if actual != expected
    console.println("Declaration input: " + source + "\nExpected: " + expected + "\nActual: " + actual)
  end

  test.assertEqual(actual, expected)
  test.assertEqual(item.get("insertTextFormat").value, snippets ? "2" : (item.get("kind").value == "15" ? "1" : ""))
  if !snippets
    let parser = new BootstrapParser((new BootstrapLexer(actual)).lex())

    parser.parseProgram()

    test.assertEqual(parser.diagnostics.count(), 0)
  end
end

def assertTypeSuggestion(source: String, name: String, expected: Bool): Void
  let items = declarationItems(source)
  var item = items.first
  var found = false

  while item != null
    found = true if item.get("label").value == name
    item = item.next
  end

  console.println("Type suggestion " + name + " for " + source + ": " + boolText(found)) if found != expected

  test.assertEqual(found, expected)
end

def main(): Void
  assertDeclaration("cl|", "class Name\n  \nend")
  assertDeclaration("class Box|", "class Box\n  \nend")
  assertDeclaration("class Box<T>|", "class Box<T>\n  \nend")
  assertDeclaration("de|", "def ${1:method}(${2:}): ${3:Void}\n  $0\nend", true)
  assertDeclaration("def blabla()|", "def blabla(): ${1:Void}\n  $0\nend", true)
  assertDeclaration("def blabla(value: String)|", "def blabla(value: String): Void\n  \nend")
  assertDeclaration("def run(|", "def run(${1:}): ${2:Void}\n  $0\nend", true)
  assertDeclaration("class Box\n  def run()|\nend", "class Box\n  def run(): Void\n    \n  end\nend")
  assertDeclaration("class Box\n  def run()|\n  end\nend", "class Box\n  def run(): Void\n    \n  end\nend")
  assertDeclaration("# 🙂\r\nclass Box\r\n\tdef run()|\r\nend", "# 🙂\r\nclass Box\r\n\tdef run(): Void\r\n\t\t\r\n\tend\r\nend")
  assertDeclaration("abstract class Shape\n  abstract def draw()|\nend", "abstract class Shape\n  abstract def draw(): Void\nend")
  assertDeclaration("abstract class Shape\n  abstract def draw()|\nend", "abstract class Shape\n  abstract def draw(): ${1:Void}$0\nend", true)
  assertDeclaration("def  render(value: String = \"$name\")|", "def  render(value: String = \"$name\"): ${1:Void}\n  $0\nend", true)
  for source in ["# def|", "def main(): Void\n  de|\nend", "class Box\n  cl|\nend", "def main(): Void\n  let text = \"def|\"\nend", "static class Nope|", "sealed def nope()|", "public def nope()|"]
    let items = declarationItems(source)

    test.assertTrue(items.first == null)
  end
  let base = "class Base\n  protected readonly def draw(value: Int): Void\n  end\n  private def hidden(): Void\n  end\n  static def utility(): Void\n  end\nend\n"

  assertDeclaration(base + "class Child: Base\n  override def dr|\nend", base + "class Child: Base\n  protected override readonly def draw(value: Int): Void\n    \n  end\nend")
  let remaining = declarationItems(base + "class Child: Base\n  protected override readonly def draw(value: Int): Void\n  end\n  override |\nend")

  test.assertTrue(remaining.first == null)
  assertTypeSuggestion("def run(value: I|", "Int", true)
  assertTypeSuggestion("def run(value: |): Void\nend", "Int", true)
  assertTypeSuggestion("class Box\n  def run(): |\n  end\nend", "Void", true)
  assertTypeSuggestion("def run(value: V|", "Void", false)
  assertTypeSuggestion("def run(): V|", "Void", true)
  assertTypeSuggestion("def run(value: Str|", "String", true)
  assertDeclaration("def run(label: String = \"🙂\", value: Str|ing): Void\nend", "def run(label: String = \"🙂\", value: String): Void\nend")
  assertTypeSuggestion("def run<T>(value: T|", "T", true)
  assertTypeSuggestion("class Box<T>\n  def run(value: T|\nend", "T", true)
  let genericBase = "class Base<T>\n  def accept(value: T): Void\n  end\nend\n"

  let unresolvedBase = declarationItems(genericBase + "class Child: Base<Int>\n  override |\nend")

  test.assertTrue(unresolvedBase.first == null)
end
