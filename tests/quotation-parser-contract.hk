use test

def quotationFirst(arena: SyntaxArena, node: Int, kind: String, data: String = ""): Int
  if node < 0
    return -1
  end
  if arena.kindAt(node) == kind && (data == "" || arena.dataAt(node) == data)
    return node
  end
  var index = 0

  while index < arena.childCountAt(node)
    let found = quotationFirst(arena, arena.childAt(node, index), kind, data)

    if found >= 0
      return found
    end
    index = index + 1
  end
  return -1
end

def quotationCount(arena: SyntaxArena, node: Int, kind: String): Int
  if node < 0
    return 0
  end
  var count = arena.kindAt(node) == kind ? 1 : 0
  var index = 0

  while index < arena.childCountAt(node)
    count = count + quotationCount(arena, arena.childAt(node, index), kind)
    index = index + 1
  end
  return count
end

def main(): Void
  let source = "def apply(callback: quote fn(Int): String, ordinary: quote): Void\nend\n\ndef quote(): Int\n  return 1\nend\n\ndef main(): Void\n  let quoted = quote do |value: Int|: String\n    return value as String\n  end\n  let ordinary = quote()\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)
  let quoteType = quotationFirst(parser.arena, root, "Type", "quote fn")
  let expression = quotationFirst(parser.arena, root, "QuoteExpression")

  test.assertTrue(quoteType >= 0)
  test.assertTrue(expression >= 0)
  test.assertTrue(quotationFirst(parser.arena, root, "Type", "quote") >= 0)
  test.assertTrue(quotationFirst(parser.arena, root, "Name", "quote") >= 0)
  if quoteType >= 0
    test.assertEqual(parser.arena.childCountAt(quoteType), 2)
  end
  if expression >= 0
    test.assertEqual(parser.arena.childCountAt(expression), 1)
    test.assertEqual(parser.arena.kindAt(parser.arena.childAt(expression, 0)), "Closure")
  end

  let malformedSource = "def main(): Void\n  let broken = quote do |value: Int|: Int return value\n  end\n  let recovered = 1\nend\n"
  let malformed = new BootstrapParser((new BootstrapLexer(malformedSource)).lex())
  let malformedRoot = malformed.parseProgram()

  test.assertTrue(malformed.diagnostics.count() > 0)
  test.assertEqual(quotationCount(malformed.arena, malformedRoot, "QuoteExpression"), 1)
  test.assertTrue(quotationFirst(malformed.arena, malformedRoot, "Let", "recovered") >= 0)
end
