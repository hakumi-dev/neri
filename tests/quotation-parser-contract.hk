use test

def quotationFirst(arena: SyntaxArena, node: Int, kind: readonly SyntaxKind, data: String = ""): Int
  if node < 0
    return -1
  end
  if arena.kindAt(node).same(kind) && (data == "" || arena.dataAt(node) == data)
    return node
  end
  var index = 0

  while index < arena.childCountAt(node)
    let found = quotationFirst(arena, arena.childAt(node, index), kind, data)

    if found >= 0
      return found
    end
    index = index + 1
  end
  return -1
end

def quotationCount(arena: SyntaxArena, node: Int, kind: readonly SyntaxKind): Int
  if node < 0
    return 0
  end
  var count = arena.kindAt(node).same(kind) ? 1 : 0
  var index = 0

  while index < arena.childCountAt(node)
    count = count + quotationCount(arena, arena.childAt(node, index), kind)
    index = index + 1
  end
  return count
end

def main(): Void
  let source = "def apply(callback: quote fn(Int): String, ordinary: quote): Void\nend\n\ndef quote(): Int\n  return 1\nend\n\ndef main(): Void\n  let quoted = quote do |value: Int|: String\n    return value as String\n  end\n  let ordinary = quote()\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)
  let function = quotationFirst(parser.arena, root, parser.arena.kinds.getFunction())

  test::assertTrue(function >= 0)
  let declaration = parser.arena.declarationAt(function)

  test::assertTrue(declaration != null)
  if declaration != null
    test::assertEqual(declaration.name, "apply")
  end
  let quoteType = parser.arena.childAt(parser.arena.childAt(function, 0), 0)
  let ordinaryType = parser.arena.typeAt(parser.arena.childAt(parser.arena.childAt(function, 1), 0))
  let expression = quotationFirst(parser.arena, root, parser.arena.kinds.getQuoteExpression())

  test::assertTrue(quoteType >= 0)
  test::assertTrue(parser.arena.typeAt(quoteType).kind.isFunction())
  test::assertTrue(parser.arena.typeAt(quoteType).flavor.isQuotation())
  test::assertTrue(expression >= 0)
  test::assertTrue(ordinaryType.kind.isNominal())
  test::assertEqual(ordinaryType.name, "quote")
  test::assertTrue(quotationFirst(parser.arena, root, parser.arena.kinds.getName(), "quote") >= 0)
  if quoteType >= 0
    test::assertEqual(parser.arena.childCountAt(quoteType), 2)
  end
  if expression >= 0
    test::assertEqual(parser.arena.childCountAt(expression), 1)
    test::assertTrue(parser.arena.kindAt(parser.arena.childAt(expression, 0)).isClosure())
  end

  let malformedSource = "def main(): Void\n  let broken = quote do |value: Int|: Int return value\n  end\n  let recovered = 1\nend\n"
  let malformed = new BootstrapParser((new BootstrapLexer(malformedSource)).lex())
  let malformedRoot = malformed.parseProgram()

  test::assertTrue(malformed.diagnostics.count() > 0)
  test::assertEqual(quotationCount(malformed.arena, malformedRoot, malformed.arena.kinds.getQuoteExpression()), 1)
  test::assertTrue(quotationFirst(malformed.arena, malformedRoot, malformed.arena.kinds.getLet(), "recovered") >= 0)
end
