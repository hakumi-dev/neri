use host
use test

def rejectsDeclarationType(payload: String, types: IrTypePool): Void
  let reader = new SemanticSnapshotReader(payload)

  libraryDeclarationReadType(reader, types)

  test::assertTrue(reader.failed)
end

def structuralDeclarationTypes(): Void
  let types = new IrTypePool()
  let signature = types.cFunction(types.pointer(types.record("geometry.Point")), [types.pointer(types.intType()), types.optional(types.pointer(types.record("geometry.Point"))), types.fixedArray(types.byteType(), 4)])
  let writer = new SemanticSnapshotWriter()

  libraryDeclarationWriteType(writer, signature)
  let payload = writer.finish()

  test::assertTrue(payload != null)
  if payload != null
    let reader = new SemanticSnapshotReader(payload)
    let restored = libraryDeclarationReadType(reader, new IrTypePool())

    test::assertFalse(reader.failed)
    test::assertTrue(restored.same(signature))
    test::assertEqual(reader.position, host::stringByteLength(payload))
  end

  rejectsDeclarationType("999\n", types)
  rejectsDeclarationType("22\n0\n", types)
  rejectsDeclarationType("21\n0\n3\n", types)
  rejectsDeclarationType("21\n4294967296\n3\n", types)
  rejectsDeclarationType("22\n2\n1\n1\n", types)

  var nested: readonly IrType = types.intType()
  var encoded = ""
  var depth = 0

  while depth < 127
    nested = types.pointer(nested)
    encoded = encoded + "19\n"
    depth = depth + 1
  end
  let boundary = new SemanticSnapshotWriter()

  libraryDeclarationWriteType(boundary, nested)

  test::assertFalse(boundary.failed)

  let tooDeep = new SemanticSnapshotWriter()

  libraryDeclarationWriteType(tooDeep, types.pointer(nested))

  test::assertTrue(tooDeep.failed)

  rejectsDeclarationType(encoded + "19\n4\n", types)
end

def main(): Void
  structuralDeclarationTypes()
  let module = new IrModule("provider", "")
  let kinds = module.domains.symbolKind
  let access = module.domains.access
  let base = new IrClass(irSymbol(module.id, kinds.getClass(), "lib.Base"), null, access.getPublic(), irNoLocation())
  let slot = irSymbol(module.id, kinds.getMethod(), "lib.Base.read")

  base.addField(new IrField(irSymbol(module.id, kinds.getField(), "lib.Base.value"), module.types.intType(), access.getProtected(), irNoLocation()))
  base.addMethod(new IrMethod(slot, module.domains.dispatchKind.getVirtual(), slot, irNoLocation()))
  module.addClass(base)
  let derived = new IrClass(irSymbol(module.id, kinds.getClass(), "lib.Box<Int>"), base.symbol, access.getPublic(), irNoLocation())
  let read = irSymbol(module.id, kinds.getMethod(), "lib.Box<Int>.read")

  derived.addField(new IrField(irSymbol(module.id, kinds.getField(), "lib.Box<Int>.items"), module.types.array(module.types.optional(module.types.classType("lib.Base"))), access.getPrivate(), irNoLocation()))
  derived.addMethod(new IrMethod(read, module.domains.dispatchKind.getVirtual(), slot, irNoLocation()))
  module.addClass(derived)
  let baseRead = new IrFunction(slot, module.types.intType(), module.domains.functionKind.getInstanceMethod(), false, irNoLocation())

  baseRead.parameterTypes.add(module.types.classType("lib.Base"))
  baseRead.effects = new EffectSet().withRead()
  module.addFunction(baseRead)
  let boxRead = new IrFunction(read, module.types.intType(), module.domains.functionKind.getInstanceMethod(), false, irNoLocation())

  boxRead.parameterTypes.add(module.types.classType("lib.Box<Int>"))
  boxRead.declaringClass = derived.symbol
  boxRead.dispatchSlot = slot
  boxRead.effects = new EffectSet().withRead().withMayPanic()
  module.addFunction(boxRead)
  let identity = new IrFunction(irSymbol(module.id, kinds.getFunction(), "lib.identity<Int>"), module.types.intType(), module.domains.functionKind.getFunction(), false, irNoLocation())

  identity.parameterTypes.add(module.types.intType())
  module.addFunction(identity)
  let record = new IrNativeRecord(irSymbol(module.id, kinds.getNativeRecord(), "lib.Point"), false)

  record.addField(new IrField(irSymbol(module.id, kinds.getField(), "lib.Point.x"), module.types.float32Type(), access.getPublic(), irNoLocation()))
  record.addField(new IrField(irSymbol(module.id, kinds.getField(), "lib.Point.y"), module.types.fixedArray(module.types.int32Type(), 4), access.getPublic(), irNoLocation()))
  module.firstRecord = record
  module.lastRecord = record
  module.recordCount = 1
  module.requiredFeatures.requireNativeRecords()
  let importValue = new IrImport(irSymbol(module.id, kinds.getFunction(), "lib.native"), module.types.pointer(module.types.record("lib.Point")), module.domains.importKind.getCAbi(), "lib_native", new EffectSet().withUnsafe(), irNoLocation())

  importValue.parameterTypes.add(module.types.pointer(module.types.record("lib.Point")))
  importValue.nativeLibrary = "libnative"
  importValue.runtimeFeatures = new RuntimeFeatures().withNativeMemory().withExtendedScalars()
  module.addImport(importValue)
  module.requiredFeatures.requireCInterop()
  module.requiredFeatures.requireExtendedScalars()
  module.requiredFeatures.requireNativeLibraries()
  let encoded = libraryDeclarationsEncode(module)

  test::assertTrue(encoded != null)
  if encoded == null
    return
  end
  let restored = libraryDeclarationsDecode(encoded, "consumer", module.domains)

  test::assertTrue(restored != null)
  if restored == null
    return
  end
  let restoredBase = restored.firstClass
  let restoredBox = restoredBase == null ? null : restoredBase.nextClass
  let restoredRecord = restored.firstRecord
  let restoredFunction = restored.firstFunction
  let restoredImport = restored.firstImport

  test::assertEqual(restored.id, "consumer")
  test::assertEqual(restored.classCount, 2)
  test::assertEqual(restored.functionCount, 3)
  test::assertTrue(restoredBase != null && restoredBase.retained && restoredBase.symbol.moduleName == "consumer")
  test::assertTrue(restoredBox != null && restoredBox.baseSymbol != null && restoredBox.baseSymbol.name == "lib.Base" && restoredBox.fieldCount == 1)
  test::assertTrue(restoredBox != null && restoredBox.firstField != null && restoredBox.firstField.typeName.same(module.types.array(module.types.optional(module.types.classType("lib.Base")))))
  test::assertTrue(restoredBox != null && restoredBox.firstMethod != null && restoredBox.firstMethod.dispatchSlot != null && restoredBox.firstMethod.dispatchSlot.name == "lib.Base.read")
  test::assertTrue(restoredRecord != null && restoredRecord.fieldCount == 2 && restoredRecord.lastField != null && restoredRecord.lastField.typeName.same(module.types.fixedArray(module.types.int32Type(), 4)))
  test::assertTrue(restoredFunction != null && restoredFunction.retained && restoredFunction.effects.hasRead())
  test::assertTrue(restoredImport != null && restoredImport.runtimeFeatures.sameAs(importValue.runtimeFeatures) && restoredImport.nativeLibrary == "libnative")
  test::assertTrue(irVerify(restored).succeeded())

  test::assertTrue(libraryDeclarationsDecode("", "consumer") == null)
  test::assertTrue(libraryDeclarationsDecode(host::stringSlice(encoded, 0, host::stringByteLength(encoded) - 1), "consumer") == null)
  test::assertTrue(libraryDeclarationsDecode(encoded + "trailing", "consumer") == null)
  test::assertTrue(libraryDeclarationsDecode(encoded, "") == null)
end
