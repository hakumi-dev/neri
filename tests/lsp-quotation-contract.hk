use host
use test

def quotationCompletion(source: String): LspJson
  let marker = bootstrapFindText(source, "<caret>")
  let document = new LspDocument()

  test.assertTrue(marker >= 0)

  document.uri = "untitled:quotation-completion"
  document.text = host.stringSlice(source, 0, marker) + host.stringSlice(source, marker + 7, host.stringByteLength(source) - marker - 7)
  document.publishDiagnostics = false
  let server = new LspServer()

  server.analyze(document)
  return (new LspJsonParser(lspCompletion(document, marker))).parse()
end

def main(): Void
  let declarations = "use quotation\n\nclass Customer\n  public active: Bool = false\nend\n\ndef inspect(expression: quote fn(Customer): Bool): Void\nend\n\n"
  let members = quotationCompletion(declarations + "def main(): Void\n  inspect() do |customer|\n    return customer.<caret>\n  end\nend\n")
  var member = members.first
  var foundActive = false

  while member != null
    if member.get("label").scalarText() == "active"
      foundActive = bootstrapFindText(member.get("detail").scalarText(), "Bool") >= 0
    end
    member = member.next
  end

  test.assertTrue(foundActive)

  let types = quotationCompletion(declarations + "def main(): Void\n  let expression: quote fn(Customer): Bool = quote do |customer|\n    return customer.active\n  end\n  let value: <caret>\nend\n")
  var item = types.first
  var foundWrapper = false

  while item != null
    foundWrapper = true if bootstrapStartsWith(item.get("label").scalarText(), "quote fn(")
    item = item.next
  end

  test.assertTrue(!foundWrapper)
end
