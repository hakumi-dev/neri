use test

def invalidQuotationAbi(): String
  return "namespace quotation\n\npublic enum NodeKind\n  case Parameter()\n  case Capture()\n  case Member()\n  case IntLiteral()\n  case BoolLiteral()\n  case TextLiteral()\n  case NullLiteral()\n  case Equal()\n  case NotEqual()\n  case Less()\n  case LessEqual()\n  case Greater()\n  case GreaterEqual()\n  case And()\n  case Or()\n  case Not()\n  case Negate()\nend\n\npublic enum CaptureValue\n  case Bool(value: Bool)\n  case Int(value: Int)\n  case Text(value: String)\n  case Null()\nend\n\npublic class Node\n  def init(kind: NodeKind, typeName: String, first: Int = -1, second: Int = -1, index: Int = -1, identity: String = \"\", intValue: Int = 0, boolValue: Bool = false, textValue: Int = 0): Void\n  end\nend\n\npublic class Tree\n  def init(nodes: Node[], captures: CaptureValue[], root: Int, parameterTypes: String[], resultType: String): Void\n  end\nend\n\nnamespace fixture\n\nuse quotation\n\nclass Customer\n  public active: Bool\nend\n\ndef inspect(predicate: quote fn(Customer): Bool): Void\nend\n\ndef exercise(): Void\n  inspect() do |customer|\n    return customer.active\n  end\nend\n"
end

def main(): Void
  let source = invalidQuotationAbi()
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)

  let model = (new BootstrapBinder(parser.arena, root, (new IrSourceMap(source)).utf16Length())).bind()
  var abiFailure = false
  var index = 0

  while index < model.diagnostics.count()
    abiFailure = true if model.diagnostics.codes.get(index) == "NR276"
    index = index + 1
  end

  test::assertTrue(abiFailure)
end
