use host
use test

def agentContextDocument(primary: String, secondary: String): LspDocument
  let document = new LspDocument()

  document.uri = "untitled:agent-context-main"
  document.text = primary
  document.requireEntryPoint = false
  document.sourceUris.add(document.uri)
  document.sourceUris.add("untitled:agent-context-support")
  document.sourceTexts.add(primary)
  document.sourceTexts.add(secondary)
  document.sourceStarts.add(0)
  document.sourceStarts.add((new IrSourceMap(primary + "\n")).utf16Length())
  document.tokens = (new BootstrapLexer(primary)).lex()
  return document
end

def agentContextCandidate(context: LspJson, name: String): LspJson?
  var candidate = context.get("candidates").first

  while candidate != null
    if candidate.get("name").scalarText() == name
      return candidate
    end
    candidate = candidate.next
  end
  return null
end

def main(): Void
  agentContextNamespaces()
  let primary = "use support\n\ndef choose(local: support::Box): Void\n  support::consume()\nend\n"
  let secondary = "namespace support\n\nclass Box\nend\n\ndef consume(value: Box): Void\n  return\nend\n"
  let position = bootstrapFindText(primary, "consume(") + 8
  let document = agentContextDocument(primary, secondary)
  let serialized = lspAgentContext(document, position)
  let parser = new LspJsonParser(serialized)
  let context = parser.parse()

  parser.spaces()

  test::assertTrue(!parser.failed)
  test::assertEqual(parser.position, host::stringByteLength(serialized))
  test::assertEqual(context.get("status").scalarText(), "complete")
  test::assertEqual(context.get("expectedType").get("kind").scalarText(), "class")
  test::assertEqual(context.get("expectedType").get("semanticIdentity").scalarText(), "type:support.Box")
  test::assertEqual(context.get("expectedType").get("identityStatus").scalarText(), "canonical")
  test::assertEqual(context.get("expectedType").get("identity").scalarText(), "type:support.Box|untitled:agent-context-support|" + (bootstrapFindText(secondary, "Box") as String))
  test::assertEqual(context.get("callableSemanticIdentity").scalarText(), "callable:support.consume")
  test::assertEqual(context.get("callableIdentityStatus").scalarText(), "canonical")
  test::assertEqual(context.get("callableIdentity").scalarText(), "callable:support.consume|untitled:agent-context-support|" + (bootstrapFindText(secondary, "consume") as String))
  let local = agentContextCandidate(context, "local")

  test::assertTrue(local != null)
  if local != null
    test::assertEqual(local.get("identityStatus").scalarText(), "canonical")
    test::assertTrue(bootstrapStartsWith(local.get("identity").scalarText(), local.get("semanticIdentity").scalarText() + "|untitled:agent-context-main|"))
  end
  let model = new SemanticModel()

  model.addTypeParameter(new SemanticTypeParameter("T", ""))

  test::assertEqual(lspAgentTypeKind(model, "Byte*"), "pointer")
  test::assertEqual(lspAgentTypeKind(model, "T"), "typeParameter")
  test::assertEqual(lspAgentTypeKind(model, "Missing"), "unknown")
end

def agentContextNamespaces(): Void
  let support = "namespace App::Nested\n\nclass Box\nend\n\ncontract Named\n  readonly def label(): String\n  end\nend\n\ndef consume(): Void\nend\n"
  let primary = "use IO = App::Nested\n\ndef choose(): Void\n  IO::\nend\n"
  let position = bootstrapFindText(primary, "IO::") + 4
  let context = (new LspJsonParser(lspAgentContext(agentContextDocument(primary, support), position))).parse()
  let consume = agentContextCandidate(context, "consume")


  test::assertEqual(context.get("status").scalarText(), "complete")
  test::assertTrue(consume != null)
  if consume != null
    test::assertEqual(consume.get("semanticIdentity").scalarText(), "callable:App.Nested.consume")
  end
  let importSource = "use IO = App::\n"
  let imported = (new LspJsonParser(lspAgentContext(agentContextDocument(importSource, support), host::stringByteLength(importSource) - 1))).parse()


  test::assertTrue(agentContextCandidate(imported, "Nested") != null)
  let construction = "use IO = App::Nested\n\ndef choose(): Void\n  let value = new IO::\nend\n"
  let constructed = (new LspJsonParser(lspAgentContext(agentContextDocument(construction, support), bootstrapFindText(construction, "new IO::") + 8))).parse()


  test::assertTrue(agentContextCandidate(constructed, "Box") != null)
  let annotation = "use IO = App::Nested\n\ndef choose(value: IO::): Void\nend\n"
  let annotated = lspSignatureTypeCompletion(agentContextDocument(annotation, support), bootstrapFindText(annotation, "value: IO::") + 11)

  test::assertTrue(annotated != null)
  if annotated != null
    test::assertTrue(bootstrapFindText(annotated, "\"label\":\"Box\"") >= 0)
  end
  let constraint = "use IO = App::Nested\n\ndef choose<T: IO::>(): Void\nend\n"
  let constrained = (new LspJsonParser(lspAgentContext(agentContextDocument(constraint, support), bootstrapFindText(constraint, "T: IO::") + 7))).parse()

  test::assertTrue(agentContextCandidate(constrained, "Named") != null)
end
