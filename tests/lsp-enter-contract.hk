use host
use test

def enterEdit(source: String, spaces: Bool = true): LspJson
  let marker = bootstrapFindText(source, "|")

  test::assertTrue(marker >= 0)
  let text = host::stringSlice(source, 0, marker) + host::stringSlice(source, marker + 1, host::stringByteLength(source) - marker - 1)
  let edits = (new LspJsonParser(lspOnEnter(text, marker, 2, spaces))).parse()

  test::assertTrue(edits.isArray())
  return edits
end

def inserted(source: String, spaces: Bool = true): String
  let edits = enterEdit(source, spaces)
  let first = edits.first

  test::assertTrue(first != null)
  if first != null
    test::assertTrue(first.next == null)
    return first.get("newText").scalarText()
  end
  return ""
end

def main(): Void
  for header in ["def run(): Void", "class Box<T>", "abstract class Shape", "enum Result<T>", "contract Printable", "struct Point", "union Value"]
    let text = inserted(header + "\n|")

    test::assertEqual(text, "  \nend")
  end
  for header in ["if ready", "while ready", "for item in items", "unsafe", "borrow owner as pointer", "using value <- acquire()", "match value", "let callback = fn(): Int", "let box = new Box() do"]
    let text = inserted("def main(): Void\n  " + header + "\n  |\nend")

    test::assertEqual(text, "    \n  end")
  end
  let existing = inserted("def main(): Void\n  if ready\n  |\n  end\nend")
  let branch = inserted("def main(): Void\n  if ready\n    run()\n  else if waiting\n  |\n  end\nend")
  let alternative = inserted("def main(): Void\n  if ready\n    run()\n  else\n  |\n  end\nend")
  let arm = inserted("def main(): Void\n  match value\n    case Choice.Yes()\n    |\n  end\nend")
  let unicode = enterEdit("# 🙂\r\nclass Box # comment\r\n\t|")
  let tabs = inserted("class Box\n\tdef run(): Void\n\t|\nend", false)
  let multiline = inserted("def run(\n  value: Int\n): Void\n|")
  let unindented = inserted("def main(): Void\n  if ready\n|\nend\nend")

  test::assertEqual(existing, "    ")
  test::assertEqual(branch, "    ")
  test::assertEqual(alternative, "    ")
  test::assertEqual(arm, "      ")
  test::assertEqual(tabs, "\t\t\n\tend")
  test::assertEqual(multiline, "  \nend")
  test::assertEqual(unindented, "    ")
  let edit = unicode.first

  test::assertTrue(edit != null)
  if edit != null
    test::assertEqual(edit.get("newText").scalarText(), "  \r\nend")
    test::assertEqual(edit.get("range").get("start").get("line").scalarText(), "2")
    test::assertEqual(edit.get("range").get("end").get("character").scalarText(), "1")
  end
  for source in ["abstract class Shape\n  abstract def area(): Int\n  |\nend", "# def run(): Void\n|", "def run(\n|", "def run():\n|", "let callback: fn(): Int\n|", "use console\n|", "class Box\n|existing\nend", "def main(): Void\n  call() if ready\n|\nend"]
    let edits = enterEdit(source)

    test::assertTrue(edits.first == null)
  end
end
