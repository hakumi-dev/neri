use host
use process
use test
use console

@cabiImport("neri_rt_v1_cache_supported")
unsafe def executableCacheSupported(): Int
end

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    var equal = true
    var index = 0

    while index < host::stringByteLength(part)
      if host::stringByteAt(text, offset + index) != host::stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def write(path: String, value: String): Void
  let succeeded = host::writeText(path, value)

  if !succeeded
    console::println("Could not write contract fixture: " + path)
  end

  test::assertTrue(succeeded)
end

def directory(path: String): Void
  let status = host::run("mkdir", ["-p", path])

  if status == null || status != 0
    console::println("Could not create contract directory: " + path)
  end

  test::assertTrue(status != null && status == 0)
end

def invoke(executable: String, arguments: String[], cache: String = ""): process::PollResult
  let options = new process::SpawnOptions(executable)

  options.arguments = arguments
  options.environment = [new process::EnvironmentEntry("NERI_CACHE_DIR", cache)] if cache != ""
  let started = process::spawn(options)
  let spawnFailure = started.failure()

  if spawnFailure != null
    console::println("Could not start " + executable + " " + arguments[0] + ": " + spawnFailure.code() + " (" + spawnFailure.operation + ", OS " + (spawnFailure.osCode as String) + ")")
  end

  test::assertTrue(spawnFailure == null)
  let child = started.child()

  if child == null
    console::println("Process start returned no child for " + executable + " " + arguments[0])
  end

  test::assertTrue(child != null)
  if child == null
    return new process::PollResult()
  end
  let completed = child.wait(60000)
  let waitFailure = completed.failure

  if waitFailure != null || completed.running
    console::println("Process wait failed for " + executable + " " + arguments[0] + ": " + (waitFailure == null ? "still running after timeout" : waitFailure.code() + " (" + waitFailure.operation + ", OS " + (waitFailure.osCode as String) + ")") + "; stdout: " + text(completed.stdout) + "; stderr: " + text(completed.stderr))
  end

  test::assertTrue(waitFailure == null && !completed.running)
  test::assertTrue(child.dispose())
  return completed
end

def text(bytes: Byte[]): String
  let decoded = host::stringFromBytes(bytes)

  test::assertTrue(decoded != null)
  if decoded != null
    return decoded
  end
  return ""
end

def exited(result: process::PollResult, expected: Int): Void
  let status = result.exit

  if status == null || !status.isExited() || status.value() != expected
    console::println("Unexpected process result. stdout: " + text(result.stdout) + " stderr: " + text(result.stderr))
  end

  test::assertTrue(status != null)
  if status != null
    test::assertTrue(status.isExited())
    test::assertEqual(status.value(), expected)
  end
end

def build(compiler: String, manifest: String, unit: String, output: String, cache: String, release: Bool = true, noCache: Bool = false): process::PollResult
  var arguments = ["build", "--project", manifest, "--unit", unit]

  if release
    arguments = host::appendString(arguments, "--release")
  end
  arguments = host::appendString(arguments, "--timings")
  arguments = host::appendString(arguments, "--output")
  arguments = host::appendString(arguments, output)
  if noCache
    arguments = host::appendString(arguments, "--no-cache")
  end
  return invoke(compiler, arguments, cache)
end

def run(path: String): process::PollResult
  return invoke(path, [])
end

def firstLine(value: String): String
  var offset = 0

  while offset < host::stringByteLength(value) && host::stringByteAt(value, offset) != (10 as Byte)
    offset = offset + 1
  end
  return host::stringSlice(value, 0, offset)
end

def assertRuns(path: String, expected: String): Void
  let result = run(path)

  exited(result, 0)
  let actual = text(result.stdout)

  if actual != expected
    console::println("Unexpected program output from " + path + ": expected " + expected + " but received " + actual + "; stderr: " + text(result.stderr))
  end

  test::assertEqual(actual, expected)
end

def assertDependencyCache(result: process::PollResult, expected: String): Void
  let timings = text(result.stderr)

  exited(result, 0)

  let wanted = "dependency-native-" + expected
  let unwanted = "dependency-native-" + (expected == "hit" ? "miss" : "hit")

  if !containsText(timings, wanted) || containsText(timings, unwanted)
    console::println("Unexpected dependency-native cache timing; expected " + wanted + " without " + unwanted + ". stderr: " + timings)
  end

  test::assertTrue(containsText(timings, wanted))
  test::assertTrue(!containsText(timings, unwanted))
end

def librarySource(value: Int): String
  return "namespace separation\n\nabstract class Parent\n  abstract def value(): Int\nend\n\nclass Child: Parent\n  override def value(): Int\n    return " + (value as String) + "\n  end\nend\n\nclass Store\n  public def identity<T>(value: T): T\n    return value\n  end\n\n  public static def staticIdentity<T>(value: T): T\n    return value\n  end\nend\n\ndef identity<T>(value: T): T\n  return value\nend\n"
end

def main(): Void
  let compiler = host::argumentAt(1)
  let work = host::argumentAt(2)

  if compiler == null || work == null
    console::println("Expected test arguments: {project} {compiler} {work}")

    test::assertTrue(compiler != null && work != null)
    return
  end
  let root = work + "/library-separation-contract"
  let sources = root + "/src"
  let dependencies = root + "/dependencies"
  let dependencyManifest = dependencies + "/manifest.json"
  let manifest = root + "/manifest.json"
  let cache = root + "/cache"
  let firstOutput = root + "/first-app"
  let secondOutput = root + "/second-app"
  let recoveredOutput = root + "/recovered-app"
  let debugOutput = root + "/debug-app"
  let debugHitOutput = root + "/debug-hit-app"
  let changedOutput = root + "/changed-app"
  let uncachedOutput = root + "/uncached-app"

  let cleared = host::run("rm", ["-rf", root])

  test::assertTrue(cleared != null && cleared == 0)
  directory(sources)
  directory(dependencies)
  directory(cache)
  let protectedCache = host::run("chmod", ["700", cache])

  if protectedCache == null || protectedCache != 0
    console::println("Could not restrict contract cache directory permissions: " + cache)
  end

  test::assertTrue(protectedCache != null && protectedCache == 0)
  write(dependencies + "/library.hk", librarySource(10))
  write(dependencyManifest, "{\"version\":2,\"defaultUnit\":\"library\",\"units\":{\"library\":{\"kind\":\"library\",\"sources\":[\"library.hk\"]}}}\n")
  write(sources + "/first.hk", "use console\nuse separation\n\ndef main(): Void\n  let parent: Parent = new Child()\n  let store = new Store()\n  console::println((parent.value() + identity(1) + store.identity(2) + Store.staticIdentity(3)) as String)\nend\n")
  write(sources + "/second.hk", "use console\nuse separation\n\ndef main(): Void\n  let parent: Parent = new Child()\n  let store = new Store()\n  console::println((parent.value() as String) + identity(\"consumer\") + store.identity<String>(\"instance\") + Store.staticIdentity<String>(\"static\"))\nend\n")
  write(manifest, "{\"version\":2,\"defaultUnit\":\"first\",\"units\":{\"first\":{\"kind\":\"executable\",\"sources\":[\"src/first.hk\"],\"references\":[{\"project\":\"dependencies/manifest.json\",\"unit\":\"library\"}]},\"second\":{\"kind\":\"executable\",\"sources\":[\"src/second.hk\"],\"references\":[{\"project\":\"dependencies/manifest.json\",\"unit\":\"library\"}]}}}\n")
  let first = build(compiler, manifest, "first", firstOutput, cache)

  assertDependencyCache(first, "miss")
  assertRuns(firstOutput, "16\n")

  # The second executable has a distinct output and module name. It also asks
  # the generic declaration for a new String specialization.
  let second = build(compiler, manifest, "second", secondOutput, cache)

  assertDependencyCache(second, "hit")
  assertRuns(secondOutput, "10consumerinstancestatic\n")

  let metadataFiles = invoke("find", [cache, "-name", "*.nlib"])

  exited(metadataFiles, 0)
  let metadataPath = firstLine(text(metadataFiles.stdout))

  if metadataPath == ""
    console::println("No dependency library metadata file found under " + cache + "; find output: " + text(metadataFiles.stdout) + "; stderr: " + text(metadataFiles.stderr))
  end

  test::assertTrue(metadataPath != "")
  write(metadataPath, "corrupt dependency library metadata")
  let recovered = build(compiler, manifest, "second", recoveredOutput, cache)

  assertDependencyCache(recovered, "miss")
  assertRuns(recoveredOutput, "10consumerinstancestatic\n")

  let debug = build(compiler, manifest, "second", debugOutput, cache, false)

  assertDependencyCache(debug, "miss")
  assertRuns(debugOutput, "10consumerinstancestatic\n")
  let debugHit = build(compiler, manifest, "second", debugHitOutput, cache, false)

  assertDependencyCache(debugHit, "hit")
  assertRuns(debugHitOutput, "10consumerinstancestatic\n")

  test::assertTrue(containsText(text(debug.stderr), "neri timing partition "))
  unsafe
    if executableCacheSupported() == 1
      test::assertTrue(containsText(text(debug.stderr), "neri timing object-cache-miss "))
      test::assertTrue(containsText(text(debugHit.stderr), "neri timing object-cache-hit "))
      test::assertTrue(!containsText(text(debugHit.stderr), "neri timing object-cache-miss "))
    else
      test::assertTrue(containsText(text(debug.stderr), "neri timing object-cache-miss "))
      test::assertTrue(containsText(text(debugHit.stderr), "neri timing object-cache-miss "))
      test::assertTrue(!containsText(text(debug.stderr), "neri timing object-cache-hit "))
      test::assertTrue(!containsText(text(debugHit.stderr), "neri timing object-cache-hit "))
    end
  end

  write(dependencies + "/library.hk", librarySource(20))
  let changed = build(compiler, manifest, "second", changedOutput, cache)

  assertDependencyCache(changed, "miss")
  assertRuns(changedOutput, "20consumerinstancestatic\n")

  let uncached = build(compiler, manifest, "second", uncachedOutput, cache, true, true)

  exited(uncached, 0)

  test::assertTrue(!containsText(text(uncached.stderr), "dependency-native-hit"))
  assertRuns(uncachedOutput, "20consumerinstancestatic\n")

  let externalRoot = root + "/mixed/a-external"
  let localRoot = root + "/mixed/z-local"
  let externalManifest = externalRoot + "/manifest.json"
  let localManifest = localRoot + "/manifest.json"
  let localFirstOutput = root + "/local-first-app"
  let localChangedOutput = root + "/local-changed-app"

  directory(externalRoot)
  directory(localRoot + "/app")
  directory(localRoot + "/web")
  write(externalRoot + "/library.hk", "namespace externalLibrary\n\ndef base(): Int\n  return 30\nend\n")
  write(externalManifest, "{\"version\":2,\"defaultUnit\":\"library\",\"units\":{\"library\":{\"kind\":\"library\",\"sources\":[\"library.hk\"]}}}\n")
  write(localRoot + "/app/routes.hk", "namespace localApp\n\ndef extra(): Int\n  return 1\nend\n")
  write(localRoot + "/web/main.hk", "use console\nuse externalLibrary\nuse localApp\n\ndef main(): Void\n  console::println((base() + extra()) as String)\nend\n")
  write(localManifest, "{\"version\":2,\"defaultUnit\":\"web\",\"units\":{\"app\":{\"kind\":\"library\",\"sources\":[\"app/routes.hk\"]},\"web\":{\"kind\":\"executable\",\"sources\":[\"web/main.hk\"],\"references\":[\"app\",{\"project\":\"../a-external/manifest.json\",\"unit\":\"library\"}]}}}\n")
  let localFirst = build(compiler, localManifest, "web", localFirstOutput, cache)

  assertDependencyCache(localFirst, "miss")
  assertRuns(localFirstOutput, "31\n")

  write(localRoot + "/app/routes.hk", "namespace localApp\n\ndef extra(): Int\n  return 2\nend\n")
  let localChanged = build(compiler, localManifest, "web", localChangedOutput, cache)

  assertDependencyCache(localChanged, "hit")
  assertRuns(localChangedOutput, "32\n")
end
