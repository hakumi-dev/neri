use test

def closureDiagnostics(source: String): Int
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())

  parser.parseProgram()
  return parser.diagnostics.count()
end

def main(): Void
  let inferred = "def main(): Void\n  let callback: fn(Int): Int = fn(value) do\n    return value + 1\n  end\nend\n"
  let explicit = "def make(): fn(Int): Int\n  return fn(value: Int): Int do\n    return value\n  end\nend\n"
  let empty = "def main(): Void\n  let callback: fn(): Int = fn() do\n    return 1\n  end\nend\n"
  let functionType = "def apply(callback: fn(Int): Int): Int\n  return callback(1)\nend\n"

  test::assertEqual(closureDiagnostics(inferred), 0)
  test::assertEqual(closureDiagnostics(explicit), 0)
  test::assertEqual(closureDiagnostics(empty), 0)
  test::assertEqual(closureDiagnostics(functionType), 0)

  let legacy = "def main(): Void\n  let callback: fn(Int): Int = fn(value)\n    return value\n  end\nend\n"
  let legacyExplicit = "def make(): fn(Int): Int\n  return fn(value: Int): Int\n    return value\n  end\nend\n"
  let brokenBody = "def main(): Void\n  let callback: fn(): Int = fn() do return 1\n  end\nend\n"

  test::assertTrue(closureDiagnostics(legacy) > 0)
  test::assertTrue(closureDiagnostics(legacyExplicit) > 0)
  test::assertTrue(closureDiagnostics(brokenBody) > 0)
end
