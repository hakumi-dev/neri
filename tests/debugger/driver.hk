use console
use host
use process
use result
use test

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def findText(text: String, part: String, start: Int): Int
  var offset = start

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    if containsText(host.stringSlice(text, offset, host.stringByteLength(part)), part)
      return offset
    end
    offset = offset + 1
  end
  return -1
end

def output(completed: process.PollResult): String
  let stdout = host.stringFromBytes(completed.stdout)
  let stderr = host.stringFromBytes(completed.stderr)

  test.assertTrue(stdout != null && stderr != null)
  if stdout == null || stderr == null
    return ""
  end
  return stdout + stderr
end

def exited(completed: process.PollResult): Int
  let status = completed.exit

  test.assertTrue(status != null)
  if status == null
    return -1
  end

  test.assertTrue(status.isExited())
  return status.value()
end

def main(): Void
  let executable = host.argumentAt(0)

  test.assertTrue(executable != null)
  if executable == null
    return
  end
  let options = new process.SpawnOptions("xcrun")

  options.arguments = ["lldb", "-b", "-x", "--no-use-colors",
    "-o", "settings set target.inline-breakpoint-strategy always",
    "-o", "breakpoint set --file fixture.hk --source-pattern debugger-breakpoint",
    "-o", "breakpoint set --file fixture.hk --source-pattern debugger-shadow",
    "-o", "breakpoint set --file fixture.hk --source-pattern debugger-join",
    "-o", "run",
    "-o", "frame variable -P 1 scalar state",
    "-o", "thread step-over",
    "-o", "frame variable -P 1 scalar state",
    "-o", "continue",
    "-o", "frame variable scalar",
    "-o", "continue",
    "-o", "frame variable scalar joined",
    "-o", "continue", executable]
  match process.run(options, 60000)
    case result.Result.Error(failure)
      test.assertTrue(false)
    case result.Result.Ok(completed)
      let text = output(completed)
      let initialStart = findText(text, "(lldb) frame variable -P 1 scalar state\n", 0)
      let initialEnd = findText(text, "(lldb) thread step-over", initialStart + 1)
      let updatedStart = findText(text, "(lldb) frame variable -P 1 scalar state\n", initialEnd + 1)
      let updatedEnd = findText(text, "(lldb) continue", updatedStart + 1)
      let shadowStart = findText(text, "(lldb) frame variable scalar\n", 0)
      let shadowEnd = findText(text, "(lldb) continue", shadowStart + 1)
      let finalStart = findText(text, "(lldb) frame variable scalar joined\n", shadowEnd + 1)
      let finalEnd = findText(text, "(lldb) continue", finalStart + 1)

      console.print(text)

      test.assertEqual(exited(completed), 0)
      test.assertTrue(initialStart >= 0 && initialEnd > initialStart && updatedStart > initialEnd && updatedEnd > updatedStart)
      test.assertTrue(shadowStart >= 0 && shadowEnd > shadowStart && finalStart > shadowEnd && finalEnd > finalStart)
      test.assertTrue(containsText(text, "Breakpoint 1: where ="))
      test.assertTrue(containsText(text, "stop reason = breakpoint"))
      test.assertTrue(containsText(text, " at fixture.hk:"))
      test.assertTrue(containsText(text, "count = 7"))
      test.assertTrue(containsText(text, "enabled = true"))
      if initialStart >= 0 && initialEnd > initialStart
        let initial = host.stringSlice(text, initialStart, initialEnd - initialStart)

        test.assertTrue(containsText(initial, "scalar = 41"))
        test.assertTrue(!containsText(initial, "scalar = 42"))
      end
      if updatedStart >= 0 && updatedEnd > updatedStart
        let updated = host.stringSlice(text, updatedStart, updatedEnd - updatedStart)

        test.assertTrue(containsText(updated, "scalar = 42"))
        test.assertTrue(!containsText(updated, "scalar = 41"))
      end
      if shadowStart >= 0 && shadowEnd > shadowStart
        let shadow = host.stringSlice(text, shadowStart, shadowEnd - shadowStart)

        test.assertTrue(containsText(shadow, "scalar = 100"))
        test.assertTrue(!containsText(shadow, "scalar = 42"))
      end
      if finalStart >= 0 && finalEnd > finalStart
        let finalFrame = host.stringSlice(text, finalStart, finalEnd - finalStart)

        test.assertTrue(containsText(finalFrame, "scalar = 42"))
        test.assertTrue(containsText(finalFrame, "joined = 4"))
        test.assertTrue(!containsText(finalFrame, "scalar = 100"))
      end
  end
end
