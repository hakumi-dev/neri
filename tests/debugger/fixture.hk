use host

class DebugState
  public count: Int = 7
  public enabled: Bool = true
end

def main(): Void
  var scalar = 41
  let state = new DebugState()

  scalar = scalar + 1 # debugger-breakpoint
  if state.enabled
    let scalar = 100

    state.count = state.count + scalar # debugger-shadow
  end
  var joined = 1

  if state.enabled
    joined = 2
  else
    joined = 3
  end
  while joined < 4
    joined = joined + 1
  end
  state.count = 49 # debugger-join
  if !state.enabled || state.count != 49 || scalar != 42 || joined != 4
    host::exit(1)
  end
end
