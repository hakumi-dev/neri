use console
use host

def main(): Void
  let compiler = host::argumentAt(0)
  let linker = host::argumentAt(1)
  let target = host::argumentAt(2)
  let work = host::argumentAt(3)
  let project = host::argumentAt(4)

  if compiler == null || linker == null || target == null || work == null || project == null
    host::exit(2)
    return
  end
  let platform = TargetPlatform.parse(target)

  if platform == null
    host::exit(2)
    return
  end
  let session = new ExecutableSession(new SessionToolchain(compiler, linker, platform, work))
  let initialized = session.initializeProject(project, "service", "createPackageSessionService", "app", "use console\n")

  if !initialized.succeeded()
    console::println(initialized.message)
    host::exit(1)
    return
  end
  let textContract = session.submit("use text\nuse test\nlet scalar = text::Scalar.fromInt(233)\ntest::assertTrue(scalar != null)\nif scalar != null\n  test::assertEqual(scalar as Int, 233)\n  test::assertEqual(scalar, scalar)\nend\n")

  if !textContract.execution.succeeded()
    console::println(textContract.format())
    host::exit(1)
    return
  end
  let imports = session.complete("use buf", 7)
  let imported = imports.first

  if imported == null || imported.name != "buffers" || imported.category != "namespace"
    host::exit(1)
    return
  end
  let prepared = session.prepare("app.increment()\n")

  if !prepared.status.isComplete() || prepared.resultType != "Int"
    host::exit(1)
    return
  end
  let completion = session.complete("app.inc", 7)
  let item = completion.first

  if !completion.status.isComplete() || completion.generation != session.completionGeneration() || item == null
    host::exit(1)
    return
  end
  if item.name != "increment" || item.category != "method" || item.replacementStart != 4 || item.replacementEnd != 7 || prepared.consumed
    host::exit(1)
    return
  end
  let executed = session.execute(prepared)

  if !executed.succeeded() || executed.resultType != "Int" || executed.resultText != "18" || session.completionGeneration() <= completion.generation
    host::exit(1)
    return
  end
  let observed = session.submit("app.value\n")

  if !observed.execution.succeeded() || observed.execution.resultText != "18"
    host::exit(1)
    return
  end
  let response = session.submit("console::println(app.value as String)\n")

  if !response.execution.succeeded()
    console::println(response.format())
    host::exit(1)
    return
  end
  if !session.reset().succeeded() || !session.dispose().succeeded()
    host::exit(1)
  end
end
