use console
use host

def main(): Void
  let compiler = host.argumentAt(0)
  let linker = host.argumentAt(1)
  let target = host.argumentAt(2)
  let work = host.argumentAt(3)
  let project = host.argumentAt(4)
  if compiler == null || linker == null || target == null || work == null || project == null
    host.exit(2)
    return
  end
  let session = new ExecutableSession(new SessionToolchain(compiler, linker, target, work))
  let initialized = session.initializeProject(project, "service", "createPackageSessionService")
  if !initialized.succeeded
    console.println(initialized.message)
    host.exit(1)
    return
  end
  let response = session.submit("use console\nconsole.println(service.value as String)\n")
  if !response.execution.succeeded
    console.println(response.format())
    host.exit(1)
    return
  end
  if !session.reset().succeeded || !session.dispose().succeeded
    host.exit(1)
  end
end
