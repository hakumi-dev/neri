use host
use test

def abiContainsText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def typedAbiSets(): Void
  let empty = new EffectSet()
  let read = empty.withRead()
  let combined = read.mergedWith(new EffectSet().withWrite().withMayPanic()).withNoReturn()

  test.assertEqual(empty.bits(), 0)
  test.assertEqual(read.bits(), 1)
  test.assertEqual(combined.bits(), 135)
  test.assertTrue(combined.mergedWith(read).sameAs(combined))
  test.assertEqual(combined.withoutNoReturn().render(), "[read, write, may-panic]")
  test.assertTrue(combined.hasNoReturn())

  let features = new RuntimeFeatures().withSessionModules().withSocketEndpoints()
  let extended = features.mergedWith(new RuntimeFeatures().withCrypto())

  test.assertEqual(features.bits(), 276824064)
  test.assertTrue(extended.isSatisfiedByBits(536869631))
  test.assertFalse(extended.isSatisfiedByBits(features.bits()))
  test.assertTrue(features.withoutSessionModules().sameAs(new RuntimeFeatures().withSocketEndpoints()))
end

def canonicalRuntimeImportIdentity(): Void
  let alias = abiRuntimeContract("sessionBridgeCreate")
  let nativeContract = abiRuntimeContract("neri_rt_v1_session_create")

  test.assertTrue(alias != null && nativeContract != null)
  if alias != null && nativeContract != null
    test.assertEqual(nativeContract.name, "sessionBridgeCreate")
    test.assertEqual(nativeContract.importName, "runtime.import.6.sessionBridgeCreate")
    test.assertEqual(alias.importName, nativeContract.importName)
  end
end

def typedIrFeatures(): Void
  let features = new IrFeatureSet()

  features.requireNativeStrings()
  features.requireCInterop()
  features.requireNativeStrings()
  features.requireScopedTasks()
  var names = ""

  for name in features.orderedNames()
    names = names + name + ";"
  end

  test.assertEqual(names, "c-interop-v1;native-strings-v1;scoped-tasks-v1;")
  test.assertEqual(features.minimumTransportMinor(), 8)
  test.assertEqual(features.minimumRuntimeMinor(), 27)
  test.assertTrue(features.runtimeFeatures().sameAs(new RuntimeFeatures().withNativeStrings().withScopedTasks()))

  let copy = new IrFeatureSet()

  copy.merge(features)
  copy.requireDebugScopes()

  test.assertFalse(features.hasDebugScopes())
  test.assertTrue(copy.hasCInterop())
end

def runtimeSymbolRequirements(): Void
  let files = abiRuntimeSymbolFeatures("neri_rt_v1_file_wait_readable")
  let clock = abiRuntimeSymbolFeatures("neri_rt_v1_clock_wall_now")

  test.assertEqual(abiRuntimeSymbolMinimumMinor("neri_rt_v1_file_wait_readable"), 25)
  test.assertTrue(files.sameAs(new RuntimeFeatures().withFiles()))
  test.assertEqual(abiRuntimeSymbolMinimumMinor("neri_rt_v1_host_canonical_path"), 23)
  test.assertTrue(abiRuntimeSymbolFeatures("neri_rt_v1_host_canonical_path").hasBootstrapHost())
  test.assertTrue(clock.sameAs(new RuntimeFeatures().withWallClock().withInteractiveIo()))
  test.assertEqual(abiRuntimeSymbolMinimumMinor("neri_rt_v1_clock_wall_now"), 13)
  test.assertEqual(abiRuntimeSymbolMinimumMinor("external_function"), 0)
  test.assertEqual(abiRuntimeSymbolFeatures("external_function").bits(), 0)
end

def emittedRuntimeRequirements(compiler: String, directory: String, name: String, symbol: String, minor: Int, features: Int): Void
  let source = directory + "/" + name + ".hk"
  let output = directory + "/" + name + ".ll"
  let program = "@cabiImport(\"" + symbol + "\")\nunsafe def probe(): Void\nend\n\ndef main(): Void\n  unsafe\n    probe()\n  end\nend\n"

  test.assertTrue(host.writeText(source, program))
  let status = host.run(compiler, ["check", source, "--emit=llvm-ir", "--output", output])

  test.assertTrue(status != null && status == 0)
  let llvm = host.readText(output)

  test.assertTrue(llvm != null)
  if llvm == null
    return
  end

  test.assertTrue(abiContainsText(llvm, "@neri_program_v1_abi_requirements"))
  test.assertTrue(abiContainsText(llvm, "i16 " + (minor as String) + ", i64 " + (features as String)))
end

def rejectMixedAbiSets(root: String): Void
  let effects = host.readText(root + "/compiler/abi/effects.hk")
  let features = host.readText(root + "/compiler/abi/features.hk")

  test.assertTrue(effects != null && features != null)

  if effects == null || features == null
    return
  end
  let source = effects + "\n" + features + "\ndef main(): Void\n  let invalid = new EffectSet().mergedWith(new RuntimeFeatures())\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let syntax = parser.parseProgram()
  let model = (new BootstrapBinder(parser.arena, syntax, (new IrSourceMap(source)).utf16Length())).bind()
  var mixedTypeError = false
  var index = 0

  while index < model.diagnostics.count()
    mixedTypeError = true if model.diagnostics.codes.get(index) == "NR112"
    index = index + 1
  end

  test.assertEqual(parser.diagnostics.count(), 0)
  test.assertTrue(mixedTypeError)
end

def main(): Void
  let root = host.argumentAt(0)
  let compiler = host.argumentAt(1)
  let directory = host.argumentAt(2)

  test.assertTrue(root != null && compiler != null && directory != null)

  if root == null || compiler == null || directory == null
    return
  end
  typedAbiSets()
  canonicalRuntimeImportIdentity()
  typedIrFeatures()
  runtimeSymbolRequirements()
  emittedRuntimeRequirements(compiler, directory, "file-wait-readable", "neri_rt_v1_file_wait_readable", 25, 34912)
  emittedRuntimeRequirements(compiler, directory, "canonical-path", "neri_rt_v1_host_canonical_path", 23, 2144)
  rejectMixedAbiSets(root)
end
