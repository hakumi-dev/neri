use host
use test

def describeWrite(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def describeObject(text: String): LspJson
  let parser = new LspJsonParser(text)
  let value = parser.parse()

  parser.spaces()

  test.assertTrue(!parser.failed && parser.position == host.stringByteLength(text) && value.isObject())
  return value
end

def describeArraySize(value: LspJson): Int
  var count = 0
  var item = value.first

  while item != null
    count = count + 1
    item = item.next
  end
  return count
end

def describeResultContract(result: LspJson, modelUri: String): Void
  test.assertEqual(result.get("name").scalarText(), "double")
  test.assertTrue(result.get("symbolKind").isNumber())
  test.assertTrue(bootstrapFindText(result.get("signature").scalarText(), "double") >= 0)
  test.assertTrue(bootstrapFindText(result.get("type").scalarText(), "Int") >= 0)
  test.assertEqual(result.get("documentation").scalarText(), "Doubles the supplied value.")
  test.assertEqual(result.get("identity").scalarText(), "callable:model.double")
  test.assertEqual(result.get("uri").scalarText(), modelUri)
  test.assertTrue(result.get("range").get("start").get("line").isNumber())
  test.assertTrue(result.get("range").get("end").get("character").isNumber())
  test.assertTrue(result.get("projectKey").scalarText() != "")
end

def describeMemberContract(workspace: String, memberUri: String): Void
  let selected = new NeriAgentWorkspace(workspace, "model")
  let request: AgentToolRequest = new AgentDescribeRequest("describe-member", "memberValue")
  let response = describeObject(request.execute(selected))

  test.assertEqual(response.get("status").scalarText(), "valid")
  test.assertTrue(response.get("complete").isTrue())
  test.assertEqual(response.get("unitsTotal").scalarText(), "3")
  test.assertEqual(response.get("unitsAnalyzed").scalarText(), "3")
  test.assertEqual(describeArraySize(response.get("results")), 1)
  let result = response.get("results").first

  test.assertTrue(result != null)
  if result != null
    test.assertEqual(result.get("name").scalarText(), "memberValue")
    test.assertEqual(result.get("documentation").scalarText(), "Returns a member-only value.")
    test.assertEqual(result.get("identity").scalarText(), "callable:member.memberValue")
    test.assertEqual(result.get("uri").scalarText(), memberUri)
  end
end

def describeValidContract(workspace: String, modelUri: String): Void
  let tool = new AgentDescribeTool()
  let schema = describeObject(tool.outputSchema())

  test.assertEqual(tool.name(), "neri.describe")
  test.assertEqual(schema.get("properties").get("resultsTruncated").get("type").scalarText(), "boolean")
  let request = tool.decode(describeObject("{\"operationId\":\"describe-valid\",\"query\":\"DOUBLE\"}"))

  test.assertTrue(request != null)
  if request == null
    return
  end
  let selected = new NeriAgentWorkspace(workspace, "model")
  let output = request.execute(selected)

  let response = describeObject(output)

  test.assertEqual(response.get("schemaVersion").scalarText(), "1")
  test.assertEqual(response.get("operationId").scalarText(), "describe-valid")
  test.assertEqual(response.get("query").scalarText(), "DOUBLE")
  test.assertEqual(response.get("status").scalarText(), "valid")
  test.assertEqual(response.get("message").scalarText(), "")
  test.assertTrue(response.get("complete").isTrue())
  test.assertTrue(response.get("resultsTruncated").isFalse())
  test.assertEqual(response.get("unitsTotal").scalarText(), "3")
  test.assertEqual(response.get("unitsAnalyzed").scalarText(), "3")
  test.assertTrue(response.get("snapshot").scalarText() != "")
  test.assertEqual(describeArraySize(response.get("omittedUnits")), 0)
  test.assertEqual(describeArraySize(response.get("results")), 2)
  var result = response.get("results").first

  while result != null
    describeResultContract(result, modelUri)
    result = result.next
  end
end

def describeIncompleteContract(workspace: String, modelUri: String): Void
  describeWrite(workspace + "/broken.hk", "namespace broken\n\ndef unfinished(value: Int): Int\n  return\nend\n")
  describeWrite(workspace + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"projects\":[\"member/manifest.json\"],\"units\":{\"model\":{\"kind\":\"library\",\"sources\":[\"model.hk\"]},\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"],\"references\":[\"model\"]},\"broken\":{\"kind\":\"library\",\"sources\":[\"broken.hk\"]}}}\n")
  let output = (new AgentDescribeService(workspace)).describe("describe-partial", "double")

  let response = describeObject(output)

  test.assertEqual(response.get("status").scalarText(), "valid")
  test.assertTrue(response.get("complete").isFalse())
  test.assertTrue(response.get("resultsTruncated").isFalse())
  test.assertEqual(response.get("unitsTotal").scalarText(), "4")
  test.assertEqual(response.get("unitsAnalyzed").scalarText(), "3")
  test.assertEqual(describeArraySize(response.get("omittedUnits")), 1)
  test.assertEqual(describeArraySize(response.get("results")), 2)
  test.assertTrue(response.get("message").scalarText() != "")
  let first = response.get("results").first

  test.assertTrue(first != null)
  if first != null
    describeResultContract(first, modelUri)
  end
end

def describeProjectValidationContract(workspace: String): Void
  let fixture = workspace + "/validation"
  let made = host.run("mkdir", ["-p", fixture])

  test.assertTrue(made != null && made == 0)
  describeWrite(fixture + "/main.hk", "def main(): Void\nend\n")
  describeWrite(fixture + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"projects\":42,\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n")
  let nonarray = neriLoadProject(fixture, "app")

  test.assertTrue(bootstrapFindText(nonarray.error(), "must be an array") >= 0)
  describeWrite(fixture + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"projects\":[\"/absolute/manifest.json\"],\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n")
  let invalidPath = neriLoadProject(fixture, "app")

  test.assertTrue(bootstrapFindText(invalidPath.error(), "relative manifest.json or neri.json paths") >= 0)
  describeWrite(fixture + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"projects\":[\"member/manifest.json\",\"member/manifest.json\"],\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n")
  let duplicate = neriLoadProject(fixture, "app")

  test.assertTrue(bootstrapFindText(duplicate.error(), "Duplicate project member") >= 0)
end

def main(): Void
  let root = host.argumentAt(0)
  let compiler = host.argumentAt(1)
  let work = host.argumentAt(2)

  test.assertTrue(root != null && compiler != null && work != null)
  if root == null || compiler == null || work == null
    return
  end
  let workspace = work + "/agent-describe-project"
  let cleared = host.run("rm", ["-rf", workspace])

  test.assertTrue(cleared != null && cleared == 0)
  let made = host.run("mkdir", ["-p", workspace + "/member"])

  test.assertTrue(made != null && made == 0)
  describeWrite(workspace + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"projects\":[\"member/manifest.json\"],\"units\":{\"model\":{\"kind\":\"library\",\"sources\":[\"model.hk\"]},\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"],\"references\":[\"model\"]}}}\n")
  describeWrite(workspace + "/model.hk", "namespace model\n\n## Doubles the supplied value.\ndef double(value: Int): Int\n  return value + value\nend\n")
  describeWrite(workspace + "/main.hk", "use model\n\ndef main(): Void\n  let value: Int = model.double(21)\nend\n")
  describeWrite(workspace + "/member/manifest.json", "{\"version\":2,\"defaultUnit\":\"support\",\"units\":{\"support\":{\"kind\":\"library\",\"sources\":[\"support.hk\"]}}}\n")
  describeWrite(workspace + "/member/support.hk", "namespace member\n\n## Returns a member-only value.\ndef memberValue(): String\n  return \"member\"\nend\n")
  let canonicalModel = neriCanonicalPath(workspace + "/model.hk")
  let canonicalMember = neriCanonicalPath(workspace + "/member/support.hk")

  test.assertTrue(canonicalModel != null && canonicalMember != null)
  if canonicalModel == null || canonicalMember == null
    return
  end
  let modelUri = lspUri(canonicalModel)
  let memberUri = lspUri(canonicalMember)

  describeValidContract(workspace, modelUri)
  describeMemberContract(workspace, memberUri)
  describeIncompleteContract(workspace, modelUri)
  describeProjectValidationContract(workspace)
end
