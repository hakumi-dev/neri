use host
use test
use files

def itoWrite(path: String, content: String): Void
  test::assertTrue(host::writeText(path, content))
end

def itoDirectory(path: String): Void
  let created = files::createDirectory(path, true)

  test::assertTrue(created.failure == null)
end

def main(): Void
  let repository = host::argumentAt(0)

  test::assertTrue(repository != null)
  if repository == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(repository + "/build", "lsp-ito-contract")

  test::assertTrue(temporary != null)
  if temporary == null
    return
  end
  let package = temporary + "/package"
  let library = temporary + "/library"
  let ito = package + "/.neri/ito"
  let snapshot = ito + "/sources/fixture"
  let liveApp = package + "/app/form.hk"
  let liveNew = package + "/app/new.hk"
  let liveGenerated = package + "/data/generated/model.hk"
  let manifest = ito + "/manifest.json"

  itoDirectory(snapshot + "/app")
  itoDirectory(snapshot + "/data/generated")
  itoDirectory(package + "/app")
  itoDirectory(package + "/data/generated")
  itoDirectory(library)
  itoWrite(package + "/package.json", "{\"name\":\"fixture\",\"neri\":{\"sources\":[\"app\",\"data/generated\"]}}\n")
  itoWrite(snapshot + "/package.json", "{\"name\":\"fixture\"}\n")
  itoWrite(package + "/data/generated/manifest.json", "{\"version\":1,\"generator\":\"fixture\",\"generatorVersion\":\"1\",\"inputs\":[],\"outputs\":[]}\n")
  itoWrite(library + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"core\",\"units\":{\"core\":{\"kind\":\"library\",\"sources\":[\"core.hk\"]}}}\n")
  itoWrite(library + "/core.hk", "namespace dependency\ndef answer(): Int\n  return 7\nend\n")
  itoWrite(snapshot + "/app/form.hk", "def obsolete(): Int\n  return 1\nend\n")
  itoWrite(snapshot + "/data/generated/model.hk", "namespace demo_model\nclass DemoProject\n  public obsolete: Int = 0\nend\n")
  let liveSource = "use demo_model\nnamespace example\ndef edited(project: DemoProject): Int\n  return dependency::answer() + project.value\nend\n"

  itoWrite(liveApp, liveSource)
  itoWrite(liveNew, "def added(): Int\n  return 3\nend\n")
  itoWrite(liveGenerated, "namespace demo_model\nclass DemoProject\n  public value: Int = 2\nend\n")
  itoWrite(manifest, "{\"version\":2,\"defaultUnit\":\"app\",\"sourceMap\":{\"sources/fixture\":\"../..\"},\"units\":{\"app\":{\"kind\":\"library\",\"sources\":[\"sources/fixture/app/form.hk\",\"sources/fixture/data/generated/model.hk\"],\"references\":[{\"project\":\"../../../library/manifest.json\",\"unit\":\"core\"}]}}}\n")
  let server = new LspServer()

  server.rootPath = package
  let selected = server.nearestProjectRoot(liveGenerated)
  let project = lspItoProjectForSource(selected, liveApp, "", null)
  let added = lspItoProjectForSource(server.nearestProjectRoot(liveNew), liveNew, "", null)
  let current = neriProjectVerifiedText(project, liveApp)

  test::assertEqual(selected, manifest)
  test::assertEqual(server.nearestProjectRoot(liveApp), manifest)
  test::assertEqual(project.error(), "")
  test::assertTrue(neriProjectContains(project, liveApp))
  test::assertTrue(neriProjectContains(project, liveGenerated))
  test::assertTrue(current != null && bootstrapFindText(current, "edited") >= 0)
  test::assertEqual(added.error(), "")
  test::assertTrue(neriProjectContains(added, liveNew))
  let document = new LspDocument()

  document.uri = lspUri(liveApp)
  document.text = liveSource
  document.version = 1
  document.publishDiagnostics = false
  server.documents = document
  server.analyze(document)

  test::assertEqual(document.lastPublishedDiagnostics, "[]")
  document.text = "use demo_model\nnamespace example\ndef edited(project: DemoProject): Int\n  return dependency::answer() + project.missing\nend\n"
  document.version = 2
  server.analyze(document)

  test::assertTrue(bootstrapFindText(document.lastPublishedDiagnostics, "missing") >= 0)
  let cached = new LspDocument()

  cached.uri = lspUri(snapshot + "/app/form.hk")
  cached.text = "def obsolete(): Int\n  return 1\nend\n"
  cached.version = 1
  cached.publishDiagnostics = false
  server.analyze(cached)

  test::assertEqual(server.nearestProjectRoot(snapshot + "/app/form.hk"), "")
  test::assertTrue(bootstrapFindText(cached.lastPublishedDiagnostics, "Ito build snapshot") >= 0)
end
