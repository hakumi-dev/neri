use test

def oneClassPerFileAnalyze(source: String, enabled: Bool): NeriCodeStyleResult
  let options = new NeriCodeStyleOptions()
  let rule: NeriCodeStyleRule? = new NeriCodeStyleOneClassPerFileRule()

  options.set("neri_one_class_per_file", enabled ? "true" : "false")
  return neriCodeStyleAnalyzeWithRules(neriCodeStyleContext(source), options, rule)
end

def codeStyleOneClassPerFileContract(): Void
  let source = "class First\nend\n\nenum Second\n  case Ready()\nend\n"
  let disabled = oneClassPerFileAnalyze(source, false)
  let enabled = oneClassPerFileAnalyze(source, true)
  let finding = enabled.findings

  test.assertTrue(disabled.valid)
  test.assertTrue(disabled.findings == null)
  test.assertTrue(disabled.edits == null)
  test.assertTrue(enabled.valid)
  test.assertTrue(finding != null)
  if finding != null
    test.assertEqual(finding.ruleId, "NRSTYLE007")
    test.assertEqual(finding.message, "Keep one class or enum declaration per file.")
    test.assertFalse(finding.safeFix)
    test.assertTrue(finding.next == null)
  end

  test.assertTrue(enabled.edits == null)

  let single = oneClassPerFileAnalyze("# class Example\nclass Only\n  public label: String = \"class Literal\"\nend\n", true)

  test.assertTrue(single.valid)
  test.assertTrue(single.findings == null)

  let defaultOptions = new NeriCodeStyleOptions()
  let defaultRule: NeriCodeStyleRule? = new NeriCodeStyleOneClassPerFileRule()
  let defaultResult = neriCodeStyleAnalyzeWithRules(neriCodeStyleContext(source), defaultOptions, defaultRule)

  test.assertTrue(defaultResult.findings == null)
  test.assertTrue(defaultResult.edits == null)
end
