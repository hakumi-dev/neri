use host
use process
use test

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def write(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def directory(path: String): Void
  let status = host.run("mkdir", ["-p", path])

  test.assertTrue(status != null && status == 0)
end

def invoke(compiler: String, arguments: String[]): process.PollResult
  let options = new process.SpawnOptions(compiler)

  options.arguments = arguments
  let started = process.spawn(options)

  test.assertTrue(started.failure() == null)
  let child = started.child()

  test.assertTrue(child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(30000)

  test.assertTrue(completed.failure == null && !completed.running)
  test.assertTrue(child.dispose())
  return completed
end

def output(result: process.PollResult): String
  let decoded = host.stringFromBytes(result.stdout)

  test.assertTrue(decoded != null)
  if decoded != null
    return decoded
  end
  return ""
end

def exited(result: process.PollResult, expected: Int): Void
  let status = result.exit

  test.assertTrue(status != null)
  if status != null
    test.assertEqual(status.kind, "exit")
    test.assertEqual(status.value, expected)
  end
end

def main(): Void
  let compiler = host.argumentAt(0)
  let work = host.argumentAt(1)
  let target = host.argumentAt(2)
  let root = host.argumentAt(3)

  test.assertTrue(compiler != null && work != null && target != null && root != null)
  if compiler == null || work == null || target == null || root == null
    return
  end

  packageDocumentsContracts(root)

  let implicit = work + "/implicit"

  directory(implicit + "/nested")
  write(implicit + "/main.hk", "use console\ndef main(): Void\n  console.println(message())\nend\n")
  write(implicit + "/nested/helper.hk", "def message(): String\n  return \"implicit-ok\"\nend\n")
  let ran = invoke(compiler, ["run", "--target", target, "--project", implicit, "--no-cache"])

  exited(ran, 0)

  test.assertEqual(output(ran), "implicit-ok\n")
  let unknown = invoke(compiler, ["check", "--project", implicit, "--unit", "worker", "--no-cache"])

  exited(unknown, 2)

  test.assertTrue(containsText(output(unknown), "/manifest.json to declare additional units."))

  let legacy = work + "/legacy"

  directory(legacy)
  write(legacy + "/main.hk", "def main(): Void\nend\n")
  write(legacy + "/neri.json", "{\"version\":2,\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n")
  exited(invoke(compiler, ["check", "--project", legacy, "--unit", "main", "--no-cache"]), 0)

  let inventory = work + "/unit-inventory"

  directory(inventory)
  write(inventory + "/first.hk", "def main(): Void\nend\n")
  write(inventory + "/second.hk", "def main(): Void\nend\n")
  write(inventory + "/third.hk", "def main(): Void\nend\n")
  write(inventory + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"renamed-lsp\",\"units\":{\"renamed-lsp\":{\"kind\":\"executable\",\"sources\":[\"first.hk\"]},\"support\":{\"kind\":\"library\",\"sources\":[\"second.hk\"]},\"renamed-codestyle\":{\"kind\":\"executable\",\"sources\":[\"third.hk\"]}}}\n")
  let units = invoke(compiler, ["project-units", "--project", inventory])

  exited(units, 0)

  test.assertTrue(containsText(output(units), "renamed-lsp\t" + inventory + "/first.hk\n"))
  test.assertTrue(containsText(output(units), "renamed-codestyle\t" + inventory + "/third.hk\n"))

  let unsafeUnit = work + "/unsafe-unit-inventory"

  directory(unsafeUnit)
  write(unsafeUnit + "/safe.hk", "def main(): Void\nend\n")
  write(unsafeUnit + "/unsafe.hk", "def main(): Void\nend\n")
  write(unsafeUnit + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"safe\",\"units\":{\"safe\":{\"kind\":\"executable\",\"sources\":[\"safe.hk\"]},\"unsafe\\tunit\":{\"kind\":\"executable\",\"sources\":[\"unsafe.hk\"]}}}\n")
  let unsafeUnitOutput = invoke(compiler, ["project-units", "--project", unsafeUnit])

  exited(unsafeUnitOutput, 2)

  test.assertTrue(containsText(output(unsafeUnitOutput), "cannot represent a unit or source containing a tab or line break."))
  test.assertTrue(!containsText(output(unsafeUnitOutput), "safe\t"))

  let unsafeSource = work + "/unsafe-source-inventory"

  directory(unsafeSource + "/folder\tname")
  write(unsafeSource + "/safe.hk", "def main(): Void\nend\n")
  write(unsafeSource + "/folder\tname/unsafe.hk", "def main(): Void\nend\n")
  write(unsafeSource + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"safe\",\"units\":{\"safe\":{\"kind\":\"executable\",\"sources\":[\"safe.hk\"]},\"unsafe\":{\"kind\":\"executable\",\"sources\":[\"folder\\tname/unsafe.hk\"]}}}\n")
  let unsafeSourceOutput = invoke(compiler, ["project-units", "--project", unsafeSource])

  exited(unsafeSourceOutput, 2)

  test.assertTrue(containsText(output(unsafeSourceOutput), "cannot represent a unit or source containing a tab or line break."))
  test.assertTrue(!containsText(output(unsafeSourceOutput), "safe\t"))

  let strict = work + "/strict"

  directory(strict)
  write(strict + "/main.hk", "def main(): Void\nend\n")
  write(strict + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]},\"unused\":{\"kind\":\"library\",\"sources\":42}}}\n")
  let invalidUnused = invoke(compiler, ["check", "--project", strict, "--no-cache"])

  exited(invalidUnused, 2)

  test.assertTrue(containsText(output(invalidUnused), "Unit sources must be a nonempty array: unused"))

  let unknownKey = work + "/unknown-key"

  directory(unknownKey)
  write(unknownKey + "/main.hk", "def main(): Void\nend\n")
  write(unknownKey + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"],\"mystery\":true}}}\n")
  let unknownField = invoke(compiler, ["check", "--project", unknownKey, "--no-cache"])

  exited(unknownField, 2)

  test.assertTrue(containsText(output(unknownField), "Unknown unit main key: mystery"))

  let duplicate = work + "/duplicate"

  directory(duplicate)
  write(duplicate + "/main.hk", "def main(): Void\nend\n")
  write(duplicate + "/manifest.json", "{\"version\":2,\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n")
  let repeated = invoke(compiler, ["check", "--project", duplicate, "--no-cache"])

  exited(repeated, 2)

  test.assertTrue(containsText(output(repeated), "Duplicate project key: version"))

  let trailing = work + "/trailing"

  directory(trailing)
  write(trailing + "/main.hk", "def main(): Void\nend\n")
  write(trailing + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}} trailing\n")
  let extra = invoke(compiler, ["check", "--project", trailing, "--no-cache"])

  exited(extra, 2)

  test.assertTrue(containsText(output(extra), "exactly one JSON value"))

  let ambiguous = work + "/ambiguous"

  directory(ambiguous)
  write(ambiguous + "/main.hk", "def main(): Void\nend\n")
  let valid = "{\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"]}}}\n"

  write(ambiguous + "/manifest.json", valid)
  write(ambiguous + "/neri.json", valid)
  let both = invoke(compiler, ["check", "--project", ambiguous + "/manifest.json", "--no-cache"])

  exited(both, 2)

  test.assertTrue(containsText(output(both), "contains both manifest.json and neri.json"))
end
