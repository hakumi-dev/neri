use host
use test

def lspFeedFragment(reader: LspMessageReader, fragment: String): String?
  var result: String? = null
  var index = 0

  while index < host::stringByteLength(fragment)
    let completed = reader.feedByte(host::stringByteAt(fragment, index))

    if completed != null
      result = completed
    end
    index = index + 1
  end
  return result
end

def lspMessageReaderContracts(): Void
  let reader = new LspMessageReader(new LspInput())
  let header = lspFeedFragment(reader, "Content-Len")

  test::assertTrue(header == null && reader.hasPendingFrame() && !reader.isClosed())
  let partial = lspFeedFragment(reader, "gth: 4\r\n\r\n")
  let emoji = "🙂"

  test::assertTrue(partial == null)
  test::assertTrue(reader.feedByte(host::stringByteAt(emoji, 0)) == null)
  test::assertTrue(reader.feedByte(host::stringByteAt(emoji, 1)) == null)
  test::assertTrue(reader.feedByte(host::stringByteAt(emoji, 2)) == null)
  let completed = reader.feedByte(host::stringByteAt(emoji, 3))
  let empty = lspFeedFragment(reader, "content-length:\t0\r\n\r\n")

  test::assertTrue(completed != null && completed == emoji)
  test::assertTrue(empty != null && empty == "" && !reader.hasPendingFrame())
  var longBody = ""
  var index = 0

  while index < 255
    longBody = longBody + "a"
    index = index + 1
  end
  longBody = longBody + emoji + "z"
  let longResult = lspFeedFragment(reader, "Content-Length: " + (host::stringByteLength(longBody) as String) + "\r\n\r\n" + longBody)

  test::assertTrue(longResult != null && longResult == longBody && !reader.isClosed())
  for malformed in ["Content-Length: 0\r\ncontent-length: 0\r\n\r\n", "Content-Length: 2097153\r\n\r\n", "Content-Length: -1\r\n\r\n", "Content-Length: 0\n\n", "Other: value\r\n\r\n"]
    let invalid = new LspMessageReader(new LspInput())
    let rejected = lspFeedFragment(invalid, malformed)

    test::assertTrue(rejected == null && invalid.isClosed())
  end
  let invalidUtf8 = new LspMessageReader(new LspInput())

  lspFeedFragment(invalidUtf8, "Content-Length: 1\r\n\r\n")
  let invalidResult = invalidUtf8.feedByte(255 as Byte)

  test::assertTrue(invalidResult == null && invalidUtf8.isClosed())
  let repeatedLead = new LspMessageReader(new LspInput())

  lspFeedFragment(repeatedLead, "Content-Length: 2097152\r\n\r\n")
  repeatedLead.feedByte(194 as Byte)
  repeatedLead.feedByte(194 as Byte)

  test::assertTrue(repeatedLead.isClosed())
  let truncated = new LspMessageReader(new LspInput())

  lspFeedFragment(truncated, "Content-Length: 2\r\n\r\nx")
  truncated.finish()

  test::assertTrue(truncated.isClosed() && !truncated.hasPendingFrame())
  test::assertTrue(truncated.feedByte(120 as Byte) == null)
  let oversizedHeader = new LspMessageReader(new LspInput())

  index = 0
  while index < 8193
    oversizedHeader.feedByte(65 as Byte)
    index = index + 1
  end

  test::assertTrue(oversizedHeader.isClosed())
end
