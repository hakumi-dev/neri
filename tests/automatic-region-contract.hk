use host
use test

def contains(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    if host::stringSlice(text, offset, host::stringByteLength(part)) == part
      return true
    end
    offset = offset + 1
  end
  return false
end

def emission(
  compiler: String,
  directory: String,
  name: String,
  body: String[],
  invocation: String,
  expected: Bool
): Void
  var source = "use console\nclass Node\n  public value: Int = 7\n  public child: Node?\nend\n"

  for line in [
    "def graph(count: Int): Node",
    "  var head = new Node()",
    "  var index = 0",
    "  while index < count",
    "    let next = new Node()",
    "    next.child = head",
    "    head = next",
    "    index = index + 1",
    "  end",
    "  return head",
    "end"
  ]
    source = source + line + "\n"
  end
  for line in body
    source = source + line + "\n"
  end
  source = source + "def main(): Void\n  console::println((" + invocation + ") as String)\nend\n"
  let input = directory + "/region-" + name + ".hk"
  let output = directory + "/region-" + name + ".ll"

  test::assertTrue(host::writeText(input, source))

  let status = host::run(compiler, ["check", input, "--release", "--emit=llvm-ir", "--output", output])
  let llvm = host::readText(output)

  test::assertTrue(status != null && status == 0 && llvm != null)
  if llvm != null
    test::assertEqual(contains(llvm, "call ptr @neri_rt_v1_region_enter()"), expected)
  end
end

def main(): Void
  let compiler = host::argumentAt(0)
  let directory = host::argumentAt(1)

  test::assertTrue(compiler != null && directory != null)
  if compiler == null || directory == null
    return
  end
  emission(compiler, directory, "local", [
      "def probe(): Int",
      "  let head = graph(20)",
      "  return head.value",
      "end"
    ], "probe()", true)
  emission(compiler, directory, "returned", [
      "def probe(): Node",
      "  return graph(20)",
      "end"
    ], "probe().value", false)
  emission(compiler, directory, "stored", [
      "def probe(owner: Node): Int",
      "  owner.child = graph(20)",
      "  return owner.value",
      "end"
    ], "probe(new Node())", false)
  emission(compiler, directory, "foreign", [
      "@cabiImport(\"neri_rt_v1_gc_collect\")",
      "unsafe def collect(): Void",
      "end",
      "def probe(): Int",
      "  let head = graph(20)",
      "  unsafe",
      "    collect()",
      "  end",
      "  return head.value",
      "end"
    ], "probe()", false)
  emission(compiler, directory, "recursive", [
      "def probe(count: Int): Int",
      "  if count <= 0",
      "    return 0",
      "  end",
      "  let head = graph(20)",
      "  return head.value + probe(count - 1)",
      "end"
    ], "probe(2)", false)
end
