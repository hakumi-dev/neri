use console
use host
use result
use test
use neri_data
use neri_data_postgresql

def main(): Void
  match PostgreSQLProvider.open("neri_invalid_package_option=value")
    case result::Result.Error(error)
      test::assertTrue(providerFailureMessage(error) != "")
    case result::Result.Ok(provider)
      provider.closeFailure()

      test::assertTrue(false)
  end
  let connection = host::environment("NERI_POSTGRES_CONNINFO")

  if connection != null && connection != ""
    match PostgreSQLProvider.open(connection)
      case result::Result.Error(error)
        console::println(providerFailureMessage(error))

        test::assertTrue(false)
      case result::Result.Ok(provider)
        let columns = new ResultColumns([new ResultColumn("value", ResultColumnKind.Int())])
        let plan = new SqlPlan("SELECT 31 AS value", new ParameterValues(), 1, columns)

        match provider.execute(plan)
          case ProviderResult.Rows(rows)
            test::assertEqual(rows.Length, 1)
          case ProviderResult.Failure(error)
            console::println(providerFailureMessage(error))

            test::assertTrue(false)
        end

        test::assertTrue(provider.closeFailure() == null)
    end
  end
  console::println("Installed Neri Data PostgreSQL consumer passed")
end
