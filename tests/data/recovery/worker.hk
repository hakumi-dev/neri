use console
use host
use app_data
use model
use neri_data
use neri_data_recovery
use neri_data_sqlite

def requireSaved(result: WriteResult, expected: Int): Bool
  match result
    case WriteResult.Saved(count)
      return count == expected
    case WriteResult.SavedWithValues(count, outputs)
      return false
    case WriteResult.Failure(error)
      return false
  end
end

def main(): Void
  let path = host::argumentAt(0)
  let mode = host::argumentAt(1)

  if path == null || mode == null
    console::println("usage: recovery-worker <database> <delete|wal>")
    return
  end
  var options = new SQLiteOptions(SQLiteJournalMode.Delete())

  if mode == "wal"
    options = new SQLiteOptions(SQLiteJournalMode.Wal())
  else if mode != "delete"
    console::println("unsupported journal mode")
    return
  end
  if !recoveryCreateDatabase(path)
    console::println("database setup failed")
    return
  end
  match SQLiteProvider.openWritable(path, options)
    case SQLiteOpenResult.Failure(error)
      console::println(providerFailureMessage(error))
    case SQLiteOpenResult.Opened(provider)
      let db = new Database(provider)

      if db.customers.add(new Customer(1, "committed", true)) != null || !requireSaved(db.saveChanges(), 1)
        console::println("committed seed failed")
        provider.close()
        return
      end
      if !requireSaved(db.beginTransaction(), 0)
        console::println("transaction begin failed")
        provider.close()
        return
      end
      if db.customers.add(new Customer(2, "uncommitted", true)) != null || !requireSaved(db.saveChanges(), 1)
        console::println("uncommitted write failed")
        provider.close()
        return
      end
      console::println("READY")
      while true
        recoveryPause(50)
      end
  end
end
