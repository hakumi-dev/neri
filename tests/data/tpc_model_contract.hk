use test

def schemaMappingCheckTPC(root: String): Void
  schemaMappingWrite(
    root + "/entities.hk",
    "namespace model\n\nabstract class TpcRoot\n  public id: Int\n  public label: String = \"\"\nend\n\nabstract class TpcMiddle: TpcRoot\n  public rank: Int\nend\n\nclass TpcLeaf: TpcMiddle\n  public enabled: Bool\nend\n\nclass TpcOther: TpcRoot\n  public weight: Int\nend\n"
  )
  let mapping = schemaMappingLoad(
    root,
    "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"mapped_data\",\"context\":\"TpcDatabase\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.TpcRoot\",\"set\":\"roots\",\"table\":\"tpc_root\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"label\",\"column\":\"label\"}],\"hierarchy\":{\"strategy\":\"tpc\",\"discriminatorColumn\":\"kind\",\"value\":\"root\",\"derivedTypes\":[{\"type\":\"model.TpcMiddle\",\"value\":\"middle\",\"columns\":[{\"member\":\"rank\",\"column\":\"rank\"}]},{\"type\":\"model.TpcLeaf\",\"value\":\"leaf\",\"table\":\"tpc_leaves\",\"columns\":[{\"member\":\"enabled\",\"column\":\"enabled\"}]},{\"type\":\"model.TpcOther\",\"value\":\"other\",\"table\":\"tpc_others\",\"columns\":[{\"member\":\"weight\",\"column\":\"weight\"}]}]}}]}"
  )

  if mapping.error != ""
    console::println(mapping.error)
  end

  test::assertEqual(mapping.error, "")
  let body = "  let schema = schema_TpcDatabase()\n\n  test::assertTrue(schema.validate() == null)\n  test::assertTrue(schema.find(\"model.TpcRoot\") == null)\n  test::assertTrue(schema.find(\"model.TpcMiddle\") == null)\n  test::assertTrue(schema.find(\"model.TpcLeaf\") != null)\n  let path = " + lspQuote(root + "/tpc-model.sqlite") + "\n\n  test::assertTrue(createSQLiteFixture(path, \"CREATE TABLE tpc_leaves(id INTEGER PRIMARY KEY,label TEXT NOT NULL,rank INTEGER NOT NULL,enabled INTEGER NOT NULL); CREATE TABLE tpc_others(id INTEGER PRIMARY KEY,label TEXT NOT NULL,weight INTEGER NOT NULL)\"))\n  match SQLiteProvider.openWritable(path)\n    case SQLiteOpenResult.Failure(error)\n      test::assertTrue(false)\n    case SQLiteOpenResult.Opened(provider)\n      let database = new TpcDatabase(provider)\n      let leaf = new model::TpcLeaf()\n      let other = new model::TpcOther()\n\n      leaf.id = 1\n      leaf.label = \"leaf\"\n      leaf.rank = 7\n      leaf.enabled = true\n      other.id = 2\n      other.label = \"other\"\n      other.weight = 9\n\n      test::assertTrue(database.roots.add(leaf) == null)\n      test::assertTrue(database.roots.add(other) == null)\n      saved(database.saveChanges(), 2)\n      test::assertTrue(createSQLiteFixture(path, \"INSERT INTO tpc_others VALUES(1,'duplicate',3)\"))\n      match new TpcDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(true)\n        case QueryResult.Rows(rows)\n          test::assertTrue(false)\n      end\n\n      test::assertTrue(createSQLiteFixture(path, \"DELETE FROM tpc_others WHERE id=1\"))\n      let fresh = new TpcDatabase(provider)\n      let loaded = one(fresh.ofType_TpcLeaf().all())\n      let root = one(fresh.roots.where(id: 1).all())\n\n      test::assertTrue(loaded != null && root != null)\n      if loaded != null && root != null\n        test::assertTrue(reference::same<model::TpcRoot>(loaded, root))\n        loaded.rank = 10\n        saved(fresh.beginTransaction(), 0)\n        saved(fresh.saveChanges(), 1)\n        saved(fresh.rollbackTransaction(), 0)\n        let before = one(new TpcDatabase(provider).ofType_TpcLeaf().all())\n\n        test::assertTrue(before != null)\n        if before != null\n          test::assertEqual(before.rank, 7)\n        end\n        saved(fresh.saveChanges(), 1)\n        let stored = one(new TpcDatabase(provider).ofType_TpcLeaf().all())\n\n        test::assertTrue(stored != null)\n        if stored != null\n          test::assertEqual(stored.rank, 10)\n        end\n        test::assertTrue(fresh.roots.remove(loaded) == null)\n        saved(fresh.saveChanges(), 1)\n      end\n      match new TpcDatabase(provider).ofType_TpcMiddle().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 0)\n      end\n      match new TpcDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n\n      let bulk = new TpcDatabase(provider)\n\n      match bulk.roots.executeUpdate(label: \"bulk\")\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n      match bulk.roots.executeDelete()\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      for detached in [bulk.roots.asNoTracking(), bulk.roots.asNoTrackingWithIdentityResolution()]\n        match detached.executeUpdate(label: \"bulk\")\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        match detached.executeDelete()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n      end\n\n      test::assertTrue(provider.close())\n  end\n"

  schemaMappingRunConsumer(
    root,
    mapping,
    "tpc-model-consumer",
    body,
    "use neri_data\nuse reference\nuse neri_data_sqlite\nuse neri_data_sqlite_fixture\n\ndef one<T>(rows: QueryResult<T>): T?\n  match rows\n    case QueryResult.Rows(value)\n      let first = value.first()\n\n      return first == null ? null : first.value\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n      return null\n  end\nend\n\ndef saved(value: WriteResult, expected: Int): Void\n  match value\n    case WriteResult.Saved(count)\n      test::assertEqual(count, expected)\n    case WriteResult.SavedWithValues(count, unused)\n      test::assertEqual(count, expected)\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n\n      test::assertTrue(false)\n  end\nend\n",
    sqlite: true
  )
  schemaMappingRunConsumer(
    root,
    mapping,
    "tpc-model-postgresql-consumer",
    "  let schema = schema_TpcDatabase()\n\n  test::assertTrue(schema.validate() == null)\n  test::assertTrue(schema.find(\"model.TpcRoot\") == null)\n  test::assertTrue(schema.find(\"model.TpcMiddle\") == null)\n  test::assertTrue(schema.find(\"model.TpcLeaf\") != null)\n  let conninfo = host::environment(\"NERI_POSTGRES_CONNINFO\")\n\n  if conninfo == null\n    return\n  end\n  match PostgreSQLProvider.open(conninfo)\n    case result::Result.Error(error)\n      test::assertTrue(false)\n    case result::Result.Ok(provider)\n      for statement in [\"CREATE TEMP TABLE tpc_leaves(id BIGINT PRIMARY KEY,label TEXT NOT NULL,rank BIGINT NOT NULL,enabled BOOLEAN NOT NULL)\", \"CREATE TEMP TABLE tpc_others(id BIGINT PRIMARY KEY,label TEXT NOT NULL,weight BIGINT NOT NULL)\"]\n        test::assertTrue(pgFixture(provider, statement))\n      end\n      let database = new TpcDatabase(provider)\n      let leaf = new model::TpcLeaf()\n      let other = new model::TpcOther()\n\n      leaf.id = 1\n      leaf.label = \"leaf\"\n      leaf.rank = 7\n      leaf.enabled = true\n      other.id = 2\n      other.label = \"other\"\n      other.weight = 9\n\n      test::assertTrue(database.roots.add(leaf) == null)\n      test::assertTrue(database.roots.add(other) == null)\n      saved(database.saveChanges(), 2)\n      test::assertTrue(pgFixture(provider, \"INSERT INTO tpc_others VALUES(1,'duplicate',3)\"))\n      match new TpcDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(true)\n        case QueryResult.Rows(rows)\n          test::assertTrue(false)\n      end\n\n      test::assertTrue(pgFixture(provider, \"DELETE FROM tpc_others WHERE id=1\"))\n      let fresh = new TpcDatabase(provider)\n      let loaded = one(fresh.ofType_TpcLeaf().all())\n      let root = one(fresh.roots.where(id: 1).all())\n\n      test::assertTrue(loaded != null && root != null)\n      if loaded != null && root != null\n        test::assertTrue(reference::same<model::TpcRoot>(loaded, root))\n        loaded.rank = 10\n        saved(fresh.beginTransaction(), 0)\n        saved(fresh.saveChanges(), 1)\n        saved(fresh.rollbackTransaction(), 0)\n        let before = one(new TpcDatabase(provider).ofType_TpcLeaf().all())\n\n        test::assertTrue(before != null)\n        if before != null\n          test::assertEqual(before.rank, 7)\n        end\n        saved(fresh.saveChanges(), 1)\n        let stored = one(new TpcDatabase(provider).ofType_TpcLeaf().all())\n\n        test::assertTrue(stored != null)\n        if stored != null\n          test::assertEqual(stored.rank, 10)\n        end\n        test::assertTrue(fresh.roots.remove(loaded) == null)\n        saved(fresh.saveChanges(), 1)\n      end\n      match new TpcDatabase(provider).ofType_TpcMiddle().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 0)\n      end\n      match new TpcDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n\n      let bulk = new TpcDatabase(provider)\n\n      match bulk.roots.executeUpdate(label: \"bulk\")\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n      match bulk.roots.executeDelete()\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      for detached in [bulk.roots.asNoTracking(), bulk.roots.asNoTrackingWithIdentityResolution()]\n        match detached.executeUpdate(label: \"bulk\")\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        match detached.executeDelete()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n      end\n\n      test::assertTrue(provider.closeFailure() == null)\n  end\n",
    "use neri_data\nuse reference\nuse host\nuse result\nuse neri_data_postgresql\n\ndef one<T>(rows: QueryResult<T>): T?\n  match rows\n    case QueryResult.Rows(value)\n      let first = value.first()\n\n      return first == null ? null : first.value\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n      return null\n  end\nend\n\ndef saved(value: WriteResult, expected: Int): Void\n  match value\n    case WriteResult.Saved(count)\n      test::assertEqual(count, expected)\n    case WriteResult.SavedWithValues(count, unused)\n      test::assertEqual(count, expected)\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n\n      test::assertTrue(false)\n  end\nend\n\ndef pgFixture(provider: PostgreSQLProvider, sql: String): Bool\n  match provider.executeSet(new SetWritePlan(sql, new WriteValues()))\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n      return false\n    case WriteResult.Saved(count)\n      return true\n    case WriteResult.SavedWithValues(count, values)\n      return true\n  end\nend\n\n",
    postgresql: true
  )
end
