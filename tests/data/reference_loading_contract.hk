use neri_data
use test
use resources

class ReferenceParent
  public id: Int
  public name: String
  public children: ReferenceChild[] = []

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class ReferenceChild
  public id: Int
  public parentId: Int?
  public title: String
  public parent: ReferenceParent? = null

  def init(id: Int, parentId: Int?, title: String): Void
    this.id = id
    this.parentId = parentId
    this.title = title
  end
end

class ReferenceProbe: Provider
  public reads: Int = 0
  public streams: Int = 0
  public firstId: Int = 10
  public secondRow: Bool = false
  public parentId: Int? = 1
  public principalRows: Int = 1
  public badPrincipal: Bool = false
  public failPublication: Bool = false
  public failRoot: Bool = false

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.reads = this.reads + 1
    let first = new RawRow([
        new RawColumn("id", Cell.Int(this.firstId)),
        new RawColumn("parent_id", cellOptionalInt(this.parentId)),
        new RawColumn("title", Cell.Text("first"))
      ])

    if this.secondRow
      return ProviderResult.Rows([
          first,
          new RawRow([
              new RawColumn("id", Cell.Int(11)),
              new RawColumn("parent_id", cellOptionalInt(this.parentId)),
              new RawColumn("title", Cell.Text("second"))
            ])
        ])
    end
    return ProviderResult.Rows([first])
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.streams = this.streams + 1
    var count = 0

    while count < this.principalRows
      let row = this.badPrincipal ? new RawRow([]) : new RawRow([
          new RawColumn("id", Cell.Int(1)),
          new RawColumn("name", Cell.Text("group"))
        ])
      let keep = visit(row)

      count = count + 1
      if !keep
        return StreamResult.Stopped(count)
      end
    end
    return StreamResult.Completed(count)
  end

  public override def beginReadAsync(
    plan: readonly SqlPlan,
    options: StreamOptions? = null,
    maximumRows: Int? = null
  ): AsyncReadStart
    if plan.columns().count() == 3
      match this.execute(plan)
        case ProviderResult.Rows(rows)
          return AsyncReadStart.Started(new ReferenceAsyncRead(rows))
        case ProviderResult.Failure(error)
          return AsyncReadStart.Failure(error)
      end
    end
    this.streams = this.streams + 1
    let rows = arrays::generate<RawRow>(this.principalRows) do |index|
      return this.badPrincipal ? new RawRow([]) : new RawRow([
          new RawColumn("id", Cell.Int(1)), new RawColumn("name", Cell.Text("group"))
        ])
    end

    return AsyncReadStart.Started(new ReferenceAsyncRead(rows))
  end
end

class ReferenceAsyncRead: AsyncReadDriver
  private rows: RawRow[]
  private index: Int = 0
  private cancelled: Bool = false

  def init(rows: RawRow[]): Void
    this.rows = rows
  end

  public override def poll(): AsyncReadPoll
    if this.cancelled
      return AsyncReadPoll.Failure(ProviderFailure.State("cancelled reference fixture"))
    end
    if this.index == this.rows.Length
      return AsyncReadPoll.Completed()
    end
    let row = this.rows[this.index]

    this.index = this.index + 1
    return AsyncReadPoll.Row(row)
  end

  public override def cancel(): Void
    this.cancelled = true
  end

  public override def close(): ProviderFailure?
    return null
  end
end

def decodeReferenceParent(row: RawRow): DecodeResult<ReferenceParent>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<ReferenceParent>.Failure(error)
    case DecodeResult.Value(id)
      match decodeString(row, "name")
        case DecodeResult.Failure(error)
          return DecodeResult<ReferenceParent>.Failure(error)
        case DecodeResult.Value(name)
          return DecodeResult<ReferenceParent>.Value(new ReferenceParent(id, name))
      end
  end
end

def decodeReferenceChild(row: RawRow): DecodeResult<ReferenceChild>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<ReferenceChild>.Failure(error)
    case DecodeResult.Value(id)
      match decodeNullableInt(row, "parent_id")
        case DecodeResult.Failure(error)
          return DecodeResult<ReferenceChild>.Failure(error)
        case DecodeResult.Value(parentId)
          match decodeString(row, "title")
            case DecodeResult.Failure(error)
              return DecodeResult<ReferenceChild>.Failure(error)
            case DecodeResult.Value(title)
              return DecodeResult<ReferenceChild>.Value(new ReferenceChild(id, parentId, title))
          end
      end
  end
end

def captureReferenceParent(value: ReferenceParent): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(value.id)), new RawColumn("name", Cell.Text(value.name))])
end

def captureReferenceChild(value: ReferenceChild): RawRow
  return new RawRow([
      new RawColumn("id", Cell.Int(value.id)),
      new RawColumn("parent_id", cellOptionalInt(value.parentId)),
      new RawColumn("title", Cell.Text(value.title))
    ])
end

def referenceParentKey(value: ReferenceParent): Cell
  return Cell.Int(value.id)
end

def referenceChildKey(value: ReferenceChild): Cell
  return Cell.Int(value.id)
end

def referenceForeignKey(value: ReferenceChild): Cell
  return cellOptionalInt(value.parentId)
end

def referenceGetChildren(value: ReferenceParent): ReferenceChild[]
  return value.children
end

def referenceSetChildren(value: ReferenceParent, children: ReferenceChild[]): Void
  value.children = children
end

def referenceGetParent(value: ReferenceChild): ReferenceParent?
  return value.parent
end

def referenceSetParent(value: ReferenceChild, parent: ReferenceParent?): Void
  value.parent = parent
end

def referenceRows(result: QueryResult<ReferenceChild>): TypedRows<ReferenceChild>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def referenceFailure(result: QueryResult<ReferenceChild>): Void
  match result
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      return
  end
end

def main(): Void
  let provider = new ReferenceProbe()
  let changes = new ChangeContext(provider)
  let parentColumns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("name", ResultColumnKind.Text())
    ])
  let childColumns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("parent_id", ResultColumnKind.Int(), true),
      new ResultColumn("title", ResultColumnKind.Text())
    ])
  let parentTracker = new EntityTracker<ReferenceParent>("parents", "id", parentColumns, captureReferenceParent)
  let childTracker = new EntityTracker<ReferenceChild>("children", "id", childColumns, captureReferenceChild)

  changes.register(parentTracker.changeSet())
  changes.register(childTracker.changeSet())
  let parentMapping = new EntityMapping(
    "ReferenceParent",
    "parents",
    [new MappingColumn("ReferenceParent.id", "Int", "id"), new MappingColumn("ReferenceParent.name", "String", "name")],
    "id"
  )
  let childMapping = new EntityMapping(
    "ReferenceChild",
    "children",
    [
      new MappingColumn("ReferenceChild.id", "Int", "id"),
      new MappingColumn("ReferenceChild.parentId", "Int?", "parent_id"),
      new MappingColumn("ReferenceChild.title", "String", "title")
    ],
    "id"
  )
  let parents = new Query<ReferenceParent>(
    "parents",
    new Decoder<ReferenceParent>(decodeReferenceParent, parentColumns),
    mapping: parentMapping,
    provider: provider,
    tracker: parentTracker,
    changes: changes
  )
  let children = new Query<ReferenceChild>(
    "children",
    new Decoder<ReferenceChild>(decodeReferenceChild, childColumns),
    mapping: childMapping,
    provider: provider,
    tracker: childTracker,
    changes: changes
  )
  let relation = new CollectionNavigation<ReferenceParent, ReferenceChild>(
    referenceParentKey,
    referenceChildKey,
    referenceForeignKey,
    "parent_id",
    referenceGetChildren,
    referenceSetChildren,
    referenceGetParent,
    referenceSetParent
  )

  referenceFailure(includeReference(children.take(1), parents.take(1), relation).all())

  test::assertEqual(provider.reads, 0)
  let firstRows = referenceRows(includeReference(children.take(1), parents, relation).all())

  test::assertTrue(firstRows != null)
  if firstRows == null
    return
  end
  let firstNode = firstRows.first()

  test::assertTrue(firstNode != null)
  if firstNode == null
    return
  end
  let first = firstNode.value
  let parent = first.parent

  test::assertTrue(parent != null)
  if parent == null
    return
  end

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], first))
  let asyncOutcome = verifyAsyncReference(children.take(1), parents, relation, firstRows)

  test::assertEqual(asyncOutcome.closeFailures.count(), 0)
  match asyncOutcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
  let cachedStreams = provider.streams
  let lazyOutcome = verifyAsyncLazyReference(children, parents, relation, first)

  test::assertEqual(lazyOutcome.closeFailures.count(), 0)
  test::assertEqual(provider.streams, cachedStreams)
  let conflicting = new ReferenceParent(99, "conflicting")
  let failedFixup: fn(): QueryFailure? = fn(): QueryFailure? do
    if provider.failPublication
      parent.children = []
      first.parent = conflicting
      relation.markCollection(parent, NavigationLoadState.Unknown())
      relation.markReference(first, NavigationLoadState.Unknown())
      return QueryFailure.Provider(ProviderFailure.State("publication observer failed"))
    end
    return null
  end

  parentTracker.observeMaterialization(failedFixup)
  provider.failPublication = true
  referenceFailure(includeReference(children, parents, relation).load(firstRows))
  provider.failPublication = false

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], first))
  test::assertTrue(first.parent != null && reference::same(first.parent, parent))
  match relation.referenceState(first)
    case NavigationLoadState.Loaded()
    case NavigationLoadState.Unknown()
      test::assertTrue(false)
    case NavigationLoadState.Loading()
      test::assertTrue(false)
    case NavigationLoadState.Partial()
      test::assertTrue(false)
  end
  let rootFixup: fn(): QueryFailure? = fn(): QueryFailure? do
    if provider.failRoot
      parent.children = []
      first.parent = conflicting
      relation.markReference(first, NavigationLoadState.Unknown())
    end
    return null
  end

  childTracker.observeMaterialization(rootFixup)
  provider.failRoot = true
  referenceFailure(includeReference(children.take(1), parents, relation).all())
  let failedAsyncRoot = verifyAsyncRootReference(children.take(1), parents, relation)

  test::assertEqual(failedAsyncRoot.closeFailures.count(), 0)
  match failedAsyncRoot.completion
    case resources::Completion.Failure(error)
    case resources::Completion.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], first))
  test::assertTrue(first.parent != null && reference::same(first.parent, parent))
  provider.failRoot = false
  first.title = "local scalar edit"
  let repeated = referenceRows(includeReference(children.take(1), parents, relation).all())

  test::assertTrue(repeated != null)
  test::assertEqual(first.title, "local scalar edit")
  test::assertEqual(parent.children.Length, 1)
  provider.parentId = null
  provider.firstId = 12
  let beforeNullStreams = provider.streams
  let nullRows = referenceRows(includeReference(children.take(1), parents, relation).all())

  test::assertTrue(nullRows != null)
  test::assertEqual(provider.streams, beforeNullStreams)
  if nullRows != null
    let nullNode = nullRows.first()

    test::assertEqual(nullRows.count(), 1)
    test::assertTrue(nullNode != null)
    if nullNode != null
      test::assertTrue(nullNode.value.parent == null)
      parent.children = [first, nullNode.value]
      referenceFailure(includeReference(children.take(1), parents, relation).load(nullRows))

      test::assertEqual(provider.streams, beforeNullStreams)
      test::assertEqual(parent.children.Length, 2)
      test::assertTrue(nullNode.value.parent == null)
      parent.children = [first]
    end
  end
  provider.parentId = 1
  provider.firstId = 13
  provider.principalRows = 0
  referenceFailure(includeReference(children.take(1), parents, relation).all())

  test::assertEqual(parent.children.Length, 1)
  provider.principalRows = 1
  first.parentId = 2
  provider.parentId = 2
  provider.firstId = 10
  let beforePendingStreams = provider.streams

  referenceFailure(includeReference(children.take(1), parents, relation).all())

  test::assertEqual(parent.children.Length, 1)
  test::assertEqual(provider.streams, beforePendingStreams)
  first.parentId = 1
  provider.parentId = 1
  let unknown = new ReferenceChild(14, 1, "added")

  test::assertTrue(childTracker.add(unknown) == null)
  provider.firstId = 14
  referenceFailure(includeReference(children.take(1), parents, relation).all())

  test::assertEqual(parent.children.Length, 1)
end

def verifyAsyncReference(
  children: Query<ReferenceChild>,
  parents: Query<ReferenceParent>,
  relation: CollectionNavigation<ReferenceParent, ReferenceChild>,
  rows: TypedRows<ReferenceChild>
): resources::Outcome<Int, QueryFailure>
  using operation <- includeReference(children, parents, relation).loadAsync(rows)
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(loaded)
              test::assertEqual(loaded.count(), rows.count())

              return 0
            case QueryResult.Failure(error)
              match error
                case QueryFailure.Provider(failure)
                  console::println(providerFailureMessage(failure))
                case QueryFailure.InvalidIdentifier(name)
                case QueryFailure.InvalidLimit(value, maximum)
                case QueryFailure.MissingLimit(maximum)
                case QueryFailure.SourceMismatch(expected, actual)
                case QueryFailure.UnsupportedCapability(name)
                  console::println(name)
                case QueryFailure.Cleanup(cleanup)
                case QueryFailure.MissingColumn(name)
                  console::println(name)
                case QueryFailure.TypeMismatch(column, expected, actual)
                  console::println(column + expected + actual)
                case QueryFailure.Cardinality(expected, actual)
              end
              return error
          end
      end
    end
  end
  return 1
end

def verifyAsyncRootReference(
  children: Query<ReferenceChild>, parents: Query<ReferenceParent>, relation: CollectionNavigation<ReferenceParent, ReferenceChild>
): resources::Outcome<Int, QueryFailure>
  using operation <- includeReference(children, parents, relation).allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Failure(error)
              return error
            case QueryResult.Rows(rows)
              return 0
          end
      end
    end
  end
  return 1
end

def verifyAsyncLazyReference(
  children: Query<ReferenceChild>,
  parents: Query<ReferenceParent>,
  relation: CollectionNavigation<ReferenceParent, ReferenceChild>,
  child: ReferenceChild
): resources::Outcome<Int, QueryFailure>
  using operation <- lazyReferenceAsync(children, parents, relation, child)
    match operation.poll()
      case AsyncQueryPoll.Pending(socket, interest)
        test::assertTrue(false)
      case AsyncQueryPoll.Completed(result)
        match result
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 1)

            return 0
          case QueryResult.Failure(error)
            return error
        end
    end
    return 1
  end
  return 1
end
