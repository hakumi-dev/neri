use neri_data
use test
use resources

class LoadingParent
  public id: Int
  public children: LoadingChild[] = []
  public peers: LoadingParent[] = []

  def init(id: Int): Void
    this.id = id
  end
end

class LoadingChild
  public id: Int
  public parentId: Int
  public parent: LoadingParent? = null

  def init(id: Int, parentId: Int): Void
    this.id = id
    this.parentId = parentId
  end
end

class LoadingProvider: Provider
  public children: Int = 1
  public brokenChild: Bool = false
  public brokenOnStream: Int = 0
  public parentCount: Int = 1
  public duplicateParent: Bool = false
  public reads: Int = 0
  public streams: Int = 0
  public failPublication: Bool = false
  public failRoot: Bool = false

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.reads = this.reads + 1
    let rows: RawRow[] = arrays::generate<RawRow>(this.parentCount) do |index|
      return new RawRow([new RawColumn("id", Cell.Int(this.duplicateParent ? 1 : index + 1))])
    end

    return ProviderResult.Rows(rows)
  end

  public override def beginReadAsync(
    plan: readonly SqlPlan,
    options: StreamOptions? = null,
    maximumRows: Int? = null
  ): AsyncReadStart
    if plan.columns().count() == 1
      match this.execute(plan)
        case ProviderResult.Rows(rows)
          return AsyncReadStart.Started(new LoadingAsyncRead(rows))
        case ProviderResult.Failure(error)
          return AsyncReadStart.Failure(error)
      end
    end
    this.streams = this.streams + 1
    let rows = arrays::generate<RawRow>(this.children) do |index|
      return this.brokenChild ? new RawRow([]) : new RawRow([
          new RawColumn("id", Cell.Int(10 + index)), new RawColumn("parent_id", Cell.Int(1))
        ])
    end

    return AsyncReadStart.Started(new LoadingAsyncRead(rows))
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.streams = this.streams + 1
    if this.parentCount > 1 && this.streams == 2
      return StreamResult.Completed(0)
    end
    var count = 0

    while count < this.children
      let row = this.brokenChild || this.brokenOnStream == this.streams ? new RawRow([]) : new RawRow([
          new RawColumn("id", Cell.Int(10 + count)),
          new RawColumn("parent_id", Cell.Int(1))
        ])
      let keep = visit(row)

      count = count + 1
      if !keep
        return StreamResult.Stopped(count)
      end
    end
    return StreamResult.Completed(count)
  end
end

class LoadingAsyncRead: AsyncReadDriver
  private rows: RawRow[]
  private index: Int = 0
  private paused: Bool = false
  private cancelled: Bool = false

  def init(rows: RawRow[]): Void
    this.rows = rows
  end

  public override def poll(): AsyncReadPoll
    if this.cancelled
      return AsyncReadPoll.Failure(ProviderFailure.State("cancelled navigation fixture"))
    end
    if !this.paused
      this.paused = true
      return AsyncReadPoll.Pending(-1, AsyncInterest.Read())
    end
    if this.index == this.rows.Length
      return AsyncReadPoll.Completed()
    end
    let row = this.rows[this.index]

    this.index = this.index + 1
    return AsyncReadPoll.Row(row)
  end

  public override def cancel(): Void
    this.cancelled = true
  end

  public override def close(): ProviderFailure?
    return null
  end
end

def decodeLoadingParent(row: RawRow): DecodeResult<LoadingParent>
  match decodeInt(row, "id")
    case DecodeResult.Value(id)
      return DecodeResult<LoadingParent>.Value(new LoadingParent(id))
    case DecodeResult.Failure(error)
      return DecodeResult<LoadingParent>.Failure(error)
  end
end

def decodeLoadingChild(row: RawRow): DecodeResult<LoadingChild>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<LoadingChild>.Failure(error)
    case DecodeResult.Value(id)
      match decodeInt(row, "parent_id")
        case DecodeResult.Failure(error)
          return DecodeResult<LoadingChild>.Failure(error)
        case DecodeResult.Value(parentId)
          return DecodeResult<LoadingChild>.Value(new LoadingChild(id, parentId))
      end
  end
end

def captureLoadingParent(value: LoadingParent): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(value.id))])
end

def captureLoadingChild(value: LoadingChild): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(value.id)), new RawColumn("parent_id", Cell.Int(value.parentId))])
end

def parentKey(value: LoadingParent): Cell
  return Cell.Int(value.id)
end

def wrongParentKey(value: LoadingParent): Cell
  return Cell.Int(value.id + 1)
end

def childKey(value: LoadingChild): Cell
  return Cell.Int(value.id)
end

def childForeignKey(value: LoadingChild): Cell
  return Cell.Int(value.parentId)
end

def getChildren(value: LoadingParent): LoadingChild[]
  return value.children
end

def setChildren(value: LoadingParent, children: LoadingChild[]): Void
  value.children = children
end

def getParent(value: LoadingChild): LoadingParent?
  return value.parent
end

def setParent(value: LoadingChild, parent: LoadingParent?): Void
  value.parent = parent
end

def expectRows(result: QueryResult<LoadingParent>): TypedRows<LoadingParent>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def expectFailure(result: QueryResult<LoadingParent>): Void
  match result
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      return
  end
end

def main(): Void
  let provider = new LoadingProvider()
  let changes = new ChangeContext(provider)
  let parentColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
  let childColumns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("parent_id", ResultColumnKind.Int())
    ])
  let parentTracker = new EntityTracker<LoadingParent>("parents", "id", parentColumns, captureLoadingParent)
  let childTracker = new EntityTracker<LoadingChild>("children", "id", childColumns, captureLoadingChild)

  changes.register(parentTracker.changeSet())
  changes.register(childTracker.changeSet())
  let parentMapping = new EntityMapping(
    "LoadingParent",
    "parents",
    [new MappingColumn("LoadingParent.id", "Int", "id")],
    "id"
  )
  let childMapping = new EntityMapping(
    "LoadingChild",
    "children",
    [new MappingColumn("LoadingChild.id", "Int", "id"), new MappingColumn("LoadingChild.parentId", "Int", "parent_id")],
    "id"
  )
  let parents = new Query<LoadingParent>(
    "parents",
    new Decoder<LoadingParent>(decodeLoadingParent, parentColumns),
    mapping: parentMapping,
    provider: provider,
    tracker: parentTracker,
    changes: changes
  )
  let children = new Query<LoadingChild>(
    "children",
    new Decoder<LoadingChild>(decodeLoadingChild, childColumns),
    mapping: childMapping,
    provider: provider,
    tracker: childTracker,
    changes: changes
  )
  let relation = new CollectionNavigation<LoadingParent, LoadingChild>(
    parentKey,
    childKey,
    childForeignKey,
    "parent_id",
    getChildren,
    setChildren,
    getParent,
    setParent
  )
  let loaded = expectRows(include(parents.take(10), children, relation).all())

  test::assertTrue(loaded != null)
  if loaded == null
    return
  end
  let node = loaded.first()

  test::assertTrue(node != null)
  if node == null
    return
  end
  let parent = node.value

  test::assertEqual(parent.children.Length, 1)
  let inverse = parent.children[0].parent

  test::assertTrue(inverse != null)
  if inverse != null
    test::assertTrue(reference::same(inverse, parent))
  end
  let original = parent.children[0]
  let asyncOutcome = verifyAsyncCollection(parents.take(10), children, relation, loaded)

  test::assertEqual(asyncOutcome.closeFailures.count(), 0)
  match asyncOutcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end

  let conflicting = new LoadingParent(99)
  let failedFixup: fn(): QueryFailure? = fn(): QueryFailure? do
    if provider.failPublication
      parent.children = []
      original.parent = conflicting
      relation.markCollection(parent, NavigationLoadState.Unknown())
      relation.markReference(original, NavigationLoadState.Unknown())
    end
    return null
  end

  childTracker.observeMaterialization(failedFixup)
  provider.failPublication = true
  expectFailure(include(parents.take(10), children, relation).load(loaded))
  provider.failPublication = false

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], original))
  test::assertTrue(original.parent != null && reference::same(original.parent, parent))
  match relation.collectionState(parent)
    case NavigationLoadState.Loaded()
    case NavigationLoadState.Unknown()
      test::assertTrue(false)
    case NavigationLoadState.Loading()
      test::assertTrue(false)
    case NavigationLoadState.Partial()
      test::assertTrue(false)
  end
  let rootFixup: fn(): QueryFailure? = fn(): QueryFailure? do
    if provider.failRoot
      parent.children = []
      original.parent = conflicting
      relation.markCollection(parent, NavigationLoadState.Unknown())
    end
    return null
  end

  parentTracker.observeMaterialization(rootFixup)
  provider.failRoot = true
  expectFailure(include(parents.take(10), children, relation).all())
  let failedAsyncRoot = verifyAsyncRootCollection(parents.take(10), children, relation)

  test::assertEqual(failedAsyncRoot.closeFailures.count(), 0)
  match failedAsyncRoot.completion
    case resources::Completion.Failure(error)
    case resources::Completion.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], original))
  test::assertTrue(original.parent != null && reference::same(original.parent, parent))
  provider.failRoot = false

  let removedRight = new LoadingParent(2)
  let getPeers: fn(LoadingParent): LoadingParent[] = fn(value: LoadingParent): LoadingParent[] do
    return value.peers
  end
  let setPeers: fn(LoadingParent, LoadingParent[]): Void = fn(value: LoadingParent, peers: LoadingParent[]): Void do
    value.peers = peers
  end
  let createJoin: fn(LoadingParent, LoadingParent): LoadingChild = fn(
    left: LoadingParent, right: LoadingParent
  ): LoadingChild do
    let join = new LoadingChild(100, left.id)

    join.parent = right
    return join
  end
  let skip = new ManyToManyNavigation<LoadingParent, LoadingChild, LoadingParent>(
    relation, relation, getPeers, setPeers, getPeers, setPeers, createJoin
  )

  parent.peers = [removedRight]
  removedRight.peers = [parent]
  parent.children = []
  original.parent = null
  provider.children = 0
  let refreshedSkip = expectRows(skip.load(parents, children, parents, loaded))

  test::assertTrue(refreshedSkip != null)
  test::assertEqual(parent.peers.Length, 0)
  test::assertEqual(removedRight.peers.Length, 0)
  parent.children = [original]
  original.parent = parent
  provider.children = 1
  let impostor = new LoadingChild(original.id, parent.id)

  impostor.parent = removedRight
  parent.children = [impostor]
  removedRight.children = [impostor]
  let refusedUnlink = skip.unlink(children, parent, removedRight)
  let retainedState = children.stateOf(original)

  test::assertTrue(refusedUnlink != null)
  test::assertTrue(retainedState != null)
  if retainedState != null
    match retainedState
      case TrackingState.Unchanged()
      case TrackingState.Detached()
        test::assertTrue(false)
      case TrackingState.Added()
        test::assertTrue(false)
      case TrackingState.Modified()
        test::assertTrue(false)
      case TrackingState.Deleted()
        test::assertTrue(false)
    end
  end
  parent.children = [original]
  removedRight.children = []

  let beforeCancelled = provider.streams
  let token = new CancellationToken()

  token.cancel()
  let cancelled = verifyCancelledAsyncCollection(parents.take(10), children, relation, loaded, token)

  test::assertEqual(cancelled.closeFailures.count(), 0)
  test::assertEqual(provider.streams, beforeCancelled)
  test::assertTrue(reference::same(parent.children[0], original))
  let lazyCancelled = verifyAsyncLazyCollection(parents, children, relation, parent, token)

  test::assertEqual(lazyCancelled.closeFailures.count(), 0)
  match lazyCancelled.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end

  let beforeInvalidParent = provider.streams

  parent.id = 2
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(provider.streams, beforeInvalidParent)
  parent.id = 1

  provider.brokenChild = true
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], original))

  provider.brokenChild = false
  original.parentId = 2
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 1)
  original.parentId = 1
  original.parent = null
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 1)
  original.parent = parent
  let reparented = new LoadingChild(20, 2)

  test::assertTrue(childTracker.attach(reparented) == null)
  reparented.parentId = 1
  reparented.parent = parent
  parent.children = [original, reparented]
  provider.children = 0
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 2)
  test::assertTrue(reference::same(parent.children[1], reparented))
  test::assertTrue(reparented.parent != null)
  parent.children = [original]
  reparented.parent = null
  reparented.parentId = 2

  test::assertTrue(childTracker.detach(reparented) == null)
  parent.children = []
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 0)
  test::assertTrue(original.parent != null)
  parent.children = [original]
  let emptied = expectRows(include(parents.take(10), children, relation).load(loaded))

  test::assertTrue(emptied != null)
  test::assertEqual(parent.children.Length, 1)
  test::assertTrue(reference::same(parent.children[0], original))
  test::assertTrue(original.parent != null)
  test::assertTrue(childTracker.detach(original) == null)
  parent.children = []
  let detachedReload = expectRows(include(parents.take(10), children, relation).load(loaded))

  test::assertTrue(detachedReload != null)
  provider.children = 1
  let pendingChild = new LoadingChild(10, 1)

  test::assertTrue(childTracker.add(pendingChild) == null)
  expectFailure(include(parents.take(10), children, relation).load(loaded))

  test::assertEqual(parent.children.Length, 0)

  let foreignProvider = new LoadingProvider()
  let foreignChanges = new ChangeContext(foreignProvider)
  let foreignTracker = new EntityTracker<LoadingParent>("parents", "id", parentColumns, captureLoadingParent)

  foreignChanges.register(foreignTracker.changeSet())
  let foreignQuery = new Query<LoadingParent>(
    "parents",
    new Decoder<LoadingParent>(decodeLoadingParent, parentColumns),
    mapping: parentMapping,
    provider: foreignProvider,
    tracker: foreignTracker,
    changes: foreignChanges
  )
  let rogue = expectRows(foreignQuery.take(1).all())

  test::assertTrue(rogue != null)
  if rogue == null
    return
  end
  let previousStreams = provider.streams

  expectFailure(include(parents.take(10), children, relation).load(rogue))
  expectFailure(include(parents.take(10), children.take(1), relation).load(loaded))

  test::assertEqual(provider.streams, previousStreams)

  let wrongDescriptor = new CollectionNavigation<LoadingParent, LoadingChild>(
    wrongParentKey,
    childKey,
    childForeignKey,
    "parent_id",
    getChildren,
    setChildren,
    getParent,
    setParent
  )

  expectFailure(include(parents.take(10), children, wrongDescriptor).load(loaded))

  test::assertEqual(provider.streams, previousStreams)

  let badForeignMapping = new EntityMapping(
    "LoadingChild",
    "children",
    [
      new MappingColumn("LoadingChild.id", "Int", "id"),
      new MappingColumn("LoadingChild.parentId", "Bool", "parent_id")
    ],
    "id"
  )
  let wrongForeignQuery = new Query<LoadingChild>(
    "children",
    new Decoder<LoadingChild>(decodeLoadingChild, childColumns),
    mapping: badForeignMapping,
    provider: provider,
    tracker: childTracker,
    changes: changes
  )
  let previousReads = provider.reads

  expectFailure(include(parents.take(10), wrongForeignQuery, relation).all())

  test::assertEqual(provider.reads, previousReads)

  let manyProvider = new LoadingProvider()

  manyProvider.parentCount = 51
  let manyChanges = new ChangeContext(manyProvider)
  let manyParentTracker = new EntityTracker<LoadingParent>("parents", "id", parentColumns, captureLoadingParent)
  let manyChildTracker = new EntityTracker<LoadingChild>("children", "id", childColumns, captureLoadingChild)

  manyChanges.register(manyParentTracker.changeSet())
  manyChanges.register(manyChildTracker.changeSet())
  let manyParents = new Query<LoadingParent>(
    "parents",
    new Decoder<LoadingParent>(decodeLoadingParent, parentColumns),
    mapping: parentMapping,
    provider: manyProvider,
    tracker: manyParentTracker,
    changes: manyChanges
  )
  let manyChildren = new Query<LoadingChild>(
    "children",
    new Decoder<LoadingChild>(decodeLoadingChild, childColumns),
    mapping: childMapping,
    provider: manyProvider,
    tracker: manyChildTracker,
    changes: manyChanges
  )
  let wide = expectRows(include(manyParents.take(100), manyChildren, relation).all())

  test::assertTrue(wide != null)
  test::assertEqual(manyProvider.streams, 2)
  if wide == null
    return
  end
  let firstWide = wide.first()

  test::assertTrue(firstWide != null)
  if firstWide == null
    return
  end
  let linked = firstWide.value.children[0]

  manyProvider.brokenOnStream = 4
  expectFailure(include(manyParents.take(100), manyChildren, relation).load(wide))

  test::assertEqual(manyProvider.streams, 4)
  test::assertEqual(firstWide.value.children.Length, 1)
  test::assertTrue(reference::same(firstWide.value.children[0], linked))
  var wideNode = firstWide.next

  while wideNode != null
    test::assertEqual(wideNode.value.children.Length, 0)
    wideNode = wideNode.next
  end

  manyProvider.parentCount = 2
  manyProvider.duplicateParent = true
  manyProvider.brokenOnStream = 0
  let duplicated = expectRows(include(manyParents.take(100), manyChildren, relation).all())

  test::assertTrue(duplicated != null)
  if duplicated != null
    test::assertEqual(duplicated.count(), 2)
    let firstDuplicate = duplicated.first()

    if firstDuplicate != null
      let secondDuplicate = firstDuplicate.next

      if secondDuplicate != null
        test::assertTrue(reference::same(firstDuplicate.value, secondDuplicate.value))
        test::assertEqual(firstDuplicate.value.children.Length, 1)
      end
    end
  end

  test::assertTrue(manyChildTracker.remove(linked) == null)
  if duplicated != null
    expectFailure(include(manyParents.take(100), manyChildren, relation).load(duplicated))
  end

  test::assertEqual(firstWide.value.children.Length, 1)
end

def verifyAsyncCollection(
  parents: Query<LoadingParent>,
  children: Query<LoadingChild>,
  relation: CollectionNavigation<LoadingParent, LoadingChild>,
  rows: TypedRows<LoadingParent>
): resources::Outcome<Int, QueryFailure>
  using operation <- include(parents, children, relation).loadAsync(rows)
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(loaded)
              test::assertEqual(loaded.count(), rows.count())

              return 0
            case QueryResult.Failure(error)
              match error
                case QueryFailure.Provider(failure)
                  console::println(providerFailureMessage(failure))
                case QueryFailure.InvalidIdentifier(name)
                case QueryFailure.InvalidLimit(value, maximum)
                case QueryFailure.MissingLimit(maximum)
                case QueryFailure.SourceMismatch(expected, actual)
                case QueryFailure.UnsupportedCapability(name)
                  console::println(name)
                case QueryFailure.Cleanup(cleanup)
                case QueryFailure.MissingColumn(name)
                  console::println(name)
                case QueryFailure.TypeMismatch(column, expected, actual)
                  console::println(column + expected + actual)
                case QueryFailure.Cardinality(expected, actual)
              end
              return error
          end
      end
    end
  end
  return 1
end

def verifyAsyncRootCollection(
  parents: Query<LoadingParent>, children: Query<LoadingChild>, relation: CollectionNavigation<LoadingParent, LoadingChild>
): resources::Outcome<Int, QueryFailure>
  using operation <- include(parents, children, relation).allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Failure(error)
              return error
            case QueryResult.Rows(rows)
              return 0
          end
      end
    end
  end
  return 1
end

def verifyCancelledAsyncCollection(
  parents: Query<LoadingParent>,
  children: Query<LoadingChild>,
  relation: CollectionNavigation<LoadingParent, LoadingChild>,
  rows: TypedRows<LoadingParent>,
  token: CancellationToken
): resources::Outcome<Int, QueryFailure>
  using operation <- include(parents, children, relation).loadAsync(rows, new StreamOptions(token: token))
    match operation.poll()
      case AsyncQueryPoll.Pending(socket, interest)
        test::assertTrue(false)
      case AsyncQueryPoll.Completed(result)
        match result
          case QueryResult.Rows(rows)
            test::assertTrue(false)
          case QueryResult.Failure(error)
            return 0
        end
    end
    return 1
  end
  return 1
end

def verifyAsyncLazyCollection(
  parents: Query<LoadingParent>,
  children: Query<LoadingChild>,
  relation: CollectionNavigation<LoadingParent, LoadingChild>,
  entity: LoadingParent,
  token: CancellationToken
): resources::Outcome<Int, QueryFailure>
  relation.markCollection(entity, NavigationLoadState.Unknown())
  using operation <- lazyCollectionAsync(parents, children, relation, entity, new StreamOptions(token: token))
    match relation.collectionState(entity)
      case NavigationLoadState.Loading()
      case NavigationLoadState.Loaded()
        test::assertTrue(false)
      case NavigationLoadState.Partial()
        test::assertTrue(false)
      case NavigationLoadState.Unknown()
        test::assertTrue(false)
    end
    match operation.poll()
      case AsyncQueryPoll.Pending(socket, interest)
        test::assertTrue(false)
      case AsyncQueryPoll.Completed(result)
        match result
          case QueryResult.Rows(rows)
            test::assertTrue(false)
          case QueryResult.Failure(error)
        end
    end
    match relation.collectionState(entity)
      case NavigationLoadState.Unknown()
      case NavigationLoadState.Loading()
        test::assertTrue(false)
      case NavigationLoadState.Loaded()
        test::assertTrue(false)
      case NavigationLoadState.Partial()
        test::assertTrue(false)
    end
    return 0
  end
  return 1
end
