use host
use neri_data
use neri_data_postgresql
use test

def nativeCodecContains(text: String, expected: String): Bool
  let width = host::stringByteLength(expected)
  let last = host::stringByteLength(text) - width
  var start = 0

  while start <= last
    if host::stringSlice(text, start, width) == expected
      return true
    end
    start = start + 1
  end
  return false
end

def verifyNativeScaffolding(): Void
  let snapshot = new PostgreSQLSchemaSnapshot()

  snapshot.add(new PostgreSQLSchemaColumn("public", "records", "id", "bigint", null, true, 1, "", "", false))
  snapshot.add(new PostgreSQLSchemaColumn("public", "records", "amount", "numeric(12,3)", null, true, 0, "", "", false))
  snapshot.add(new PostgreSQLSchemaColumn("public", "records", "day", "date", null, true, 0, "", "", false))
  snapshot.add(new PostgreSQLSchemaColumn(
      "public",
      "records",
      "time",
      "time(3) without time zone",
      null,
      false,
      0,
      "",
      "",
      false
    ))
  snapshot.add(new PostgreSQLSchemaColumn(
      "public",
      "records",
      "instant",
      "timestamp(6) with time zone",
      null,
      true,
      0,
      "",
      "",
      false
    ))
  snapshot.add(new PostgreSQLSchemaColumn("public", "records", "duration", "interval(4)", null, true, 0, "", "", false))

  match pgScaffoldSchema(snapshot, null)
    case SchemaScaffoldResult.Failure(error)
      test::assertTrue(false)
    case SchemaScaffoldResult.Source(source, mapping)
      test::assertTrue(nativeCodecContains(source, "field_amount: Decimal = Decimal.zero()"))
      test::assertTrue(nativeCodecContains(source, "field_day: DateOnly = DateOnly.minimum()"))
      test::assertTrue(nativeCodecContains(source, "field_time: TimeOnly? = null"))
      test::assertTrue(nativeCodecContains(source, "field_instant: DateTime = DateTime.minimum()"))
      test::assertTrue(nativeCodecContains(source, "field_duration: TimeSpan = TimeSpan.zero()"))
      test::assertTrue(nativeCodecContains(mapping, "\"postgresqlType\":\"numeric(12,3)\""))
      test::assertTrue(nativeCodecContains(mapping, "\"postgresqlType\":\"interval(4)\""))
  end
end

def main(): Void
  test::assertTrue(pgNativeScalarText(1700, "-123.4500") == "-123.45")
  test::assertTrue(pgNativeScalarText(1700, "NaN") == null)
  test::assertTrue(postgresNativeTextFits("numeric(5,2)", 1700, "999.99"))
  test::assertFalse(postgresNativeTextFits("numeric(5,2)", 1700, "999.991"))
  test::assertTrue(pgNativeScalarText(1082, "2024-02-29") == "2024-02-29")
  test::assertTrue(pgNativeScalarText(1082, "infinity") == null)
  test::assertTrue(pgNativeScalarText(1083, "12:34:56.1234") == "12:34:56.1234000")
  test::assertTrue(pgNativeScalarParameter(1083, "12:34:56.1234567") == null)
  test::assertFalse(postgresNativeTextFits("time(3) without time zone", 1083, "12:34:56.1234000"))
  test::assertTrue(pgNativeScalarText(1114, "2024-02-29 03:02:01") == "2024-02-29T03:02:01.0000000Z")
  test::assertTrue(pgNativeScalarText(1184, "2024-03-01 00:02:00+02:30:15") == "2024-02-29T21:31:45.0000000Z")
  test::assertTrue(pgNativeIntervalTicks("-256204778:48:05.477580") == -9223372036854775800)
  test::assertTrue(pgNativeIntervalTicks("1 day 00:00:00") == null)
  test::assertTrue(pgNativeIntervalParameter(10, 5) == null)
  let interval = pgNativeIntervalParameter(-10)

  test::assertTrue(interval != null)
  if interval != null
    test::assertTrue(interval.Length == 16 && interval[0] == 255 as Byte && interval[7] == 255 as Byte && interval[8] == 0 as Byte && interval[15] == 0 as Byte)
  end
  let dateColumn = new ResultColumn("day", ResultColumnKind.Text(), postgresqlType: "date")

  test::assertTrue(postgresNativeGeneratedValueValid(Cell.Text("2024-02-29"), dateColumn))
  test::assertFalse(postgresNativeGeneratedValueValid(Cell.Text("2024-02-30"), dateColumn))
  verifyNativeScaffolding()
end
