use json_fixture
use json_fixture_data
use neri_data
use reference
use test

def main(): Void
  let source = new SpecialDetails()

  source.address.city = "Seville"
  source.revision = 9
  source.enabled = true
  let stored = encode_json_JsonRow_details(source)
  let row = new RawRow([new RawColumn("details", stored)])

  test::assertEqual(initial_json_JsonRow_details().revision, 41)
  test::assertTrue(value_json_JsonRow_details(source).get("runtimeOnly") == null)
  match decode_json_JsonRow_details(row, "details")
    case DecodeResult.Failure(error)
      test::assertTrue(false)
    case DecodeResult.Value(decoded)
      test::assertEqual(decoded.address.city, "Seville")
      test::assertEqual(decoded.revision, 9)
      test::assertTrue(decoded.enabled)
      test::assertTrue(reference::cast<SpecialDetails, Details>(decoded) == null)
  end
end
