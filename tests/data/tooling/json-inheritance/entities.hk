namespace json_fixture

class Address
  public city: String = ""
end

class DetailsBase
  public address: Address = new Address()
  public revision: Int = 0

  def init(revision: Int = 41): Void
    this.revision = revision
  end
end

class Details: DetailsBase
  public enabled: Bool = false
end

class SpecialDetails: Details
  public runtimeOnly: String = "extra"
end

class JsonRow
  public id: Int = 0
  public details: Details = new Details()
end

class RequiredDetails: DetailsBase
  public label: String = ""

  def init(label: String): Void
    this.label = label
  end
end

class RequiredRow
  public id: Int = 0
  public details: RequiredDetails = new RequiredDetails("required")
end
