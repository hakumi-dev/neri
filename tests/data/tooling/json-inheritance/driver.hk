use console
use host
use test

def jsonFixtureMapping(entity: String): String
  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"json_fixture_data\",\"context\":\"JsonFixtureDatabase\",\"output\":\"generated\",\"entities\":[{\"type\":" + lspQuote(entity) + ",\"set\":\"rows\",\"table\":\"json_rows\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"details\",\"column\":\"details\",\"json\":true}]}]}"
end

def main(): Void
  let root = host::argumentAt(0)
  let compiler = host::argumentAt(1)

  test::assertTrue(root != null && compiler != null)
  if root == null || compiler == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "json-inheritance-contract")

  test::assertTrue(temporary != null)
  if temporary == null
    return
  end
  for source in ["entities.hk", "round_trip.hk"]
    let input = host::readText(root + "/tests/data/tooling/json-inheritance/" + source)

    test::assertTrue(input != null && host::writeText(temporary + "/" + source, input))
  end
  let manifest = "{\"version\":2,\"defaultUnit\":\"contract\",\"units\":{\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]},\"data\":{\"kind\":\"library\",\"sources\":[\"bridge.hk\"],\"generated\":[\"generated/manifest.json\"],\"references\":[\"entities\",{\"project\":\"../../packages/data/manifest.json\",\"unit\":\"runtime\"}]},\"contract\":{\"kind\":\"executable\",\"sources\":[\"round_trip.hk\"],\"references\":[\"data\"]}}}"

  test::assertTrue(host::writeText(temporary + "/manifest.json", manifest))
  test::assertTrue(host::writeText(temporary + "/bridge.hk", "namespace json_fixture_data\n"))
  test::assertTrue(host::writeText(temporary + "/mapping.json", jsonFixtureMapping("json_fixture.JsonRow")))
  test::assertTrue(host::writeText(temporary + "/required.json", jsonFixtureMapping("json_fixture.RequiredRow")))
  let required = dataLoadMapping(temporary + "/required.json")
  let rejected = dataJsonContains(required.error, "requires accessible zero-argument construction")

  console::println("Required initializer mapping: " + required.error) if !rejected

  test::assertTrue(rejected)
  let mapping = dataLoadMapping(temporary + "/mapping.json")

  console::println(mapping.error) if mapping.error != ""

  test::assertEqual(mapping.error, "")
  let emission = dataEmit(mapping)

  console::println(emission.error) if emission.error != ""

  test::assertEqual(emission.error, "")
  let published = dataPublish(mapping, emission)

  console::println(mapping.error) if !published

  test::assertTrue(published)
  let status = host::run(compiler, ["run", "--project", temporary + "/manifest.json", "--unit", "contract"])

  test::assertTrue(status != null && status == 0)
  test::assertTrue(files::removeTree(temporary).failure == null)
end
