namespace cascade_model

class Root
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class Branch
  public id: Int
  public rootId: Int
  public name: String

  def init(id: Int, rootId: Int, name: String): Void
    this.id = id
    this.rootId = rootId
    this.name = name
  end
end

class Leaf
  public id: Int
  public leftId: Int?
  public rightId: Int
  public name: String

  def init(id: Int, leftId: Int?, rightId: Int, name: String): Void
    this.id = id
    this.leftId = leftId
    this.rightId = rightId
    this.name = name
  end
end

class Node
  public id: Int
  public parentId: Int?

  def init(id: Int, parentId: Int?): Void
    this.id = id
    this.parentId = parentId
  end
end

class CodeRoot
  public code: String

  def init(code: String): Void
    this.code = code
  end
end

class TextChild
  public id: Int
  public codeValue: String?

  def init(id: Int, codeValue: String?): Void
    this.id = id
    this.codeValue = codeValue
  end
end

class RequiredTextChild
  public id: Int
  public codeValue: String

  def init(id: Int, codeValue: String): Void
    this.id = id
    this.codeValue = codeValue
  end
end
