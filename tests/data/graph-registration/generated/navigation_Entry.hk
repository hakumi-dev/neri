namespace graph_registration_data

class NavigationSet_GraphRegistrationDatabase_Entry
  public account: neri_data::NavigationStep<graph_registration_model::Entry, graph_registration_model::Account>
  public notes: neri_data::NavigationStep<graph_registration_model::Entry, graph_registration_model::Note>
  public children: neri_data::NavigationStep<graph_registration_model::Entry, graph_registration_model::Entry>
  public parent: neri_data::NavigationStep<graph_registration_model::Entry, graph_registration_model::Entry>

  def init(context: GraphRegistrationDatabase): Void
    this.account = context.referenceStep_entriesFor_Account_by_accountId()
    this.notes = context.collectionStep_notesFor_Entry_by_entryId()
    this.children = context.collectionStep_entriesFor_Entry_by_parentId()
    this.parent = context.referenceStep_entriesFor_Entry_by_parentId()
  end
end
