namespace graph_registration_model

class Account
  public id: Int
  public name: String
  public entries: Entry[]

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
    this.entries = []
  end
end

class Entry
  public id: Int
  public accountId: Int
  public parentId: Int?
  public title: String
  public account: Account?
  public parent: Entry?
  public children: Entry[]
  public notes: Note[]

  def init(id: Int, accountId: Int, parentId: Int?, title: String): Void
    this.id = id
    this.accountId = accountId
    this.parentId = parentId
    this.title = title
    this.account = null
    this.parent = null
    this.children = []
    this.notes = []
  end
end

class Note
  public id: Int
  public entryId: Int
  public body: String
  public entry: Entry?

  def init(id: Int, entryId: Int, body: String): Void
    this.id = id
    this.entryId = entryId
    this.body = body
    this.entry = null
  end
end
