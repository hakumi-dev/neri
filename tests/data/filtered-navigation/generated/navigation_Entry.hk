namespace filtered_navigation_data

class NavigationSet_FilteredNavigationDatabase_Entry
  public account: neri_data::NavigationStep<filtered_navigation_model::Entry, filtered_navigation_model::Account>
  public notes: neri_data::NavigationStep<filtered_navigation_model::Entry, filtered_navigation_model::Note>

  def init(context: FilteredNavigationDatabase): Void
    this.account = context.referenceStep_entriesFor_Account_by_accountCode()
    this.notes = context.collectionStep_notesFor_Entry_by_entryId()
  end
end
