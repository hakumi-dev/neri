namespace filtered_navigation_data

class Navigation_FilteredNavigationDatabase
  public accounts: NavigationSet_FilteredNavigationDatabase_Account
  public entries: NavigationSet_FilteredNavigationDatabase_Entry
  public notes: NavigationSet_FilteredNavigationDatabase_Note

  def init(context: FilteredNavigationDatabase): Void
    this.accounts = new NavigationSet_FilteredNavigationDatabase_Account(context)
    this.entries = new NavigationSet_FilteredNavigationDatabase_Entry(context)
    this.notes = new NavigationSet_FilteredNavigationDatabase_Note(context)
  end
end
