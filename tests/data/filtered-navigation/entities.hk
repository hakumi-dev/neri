namespace filtered_navigation_model

class Account
  public code: String
  public name: String
  public entries: Entry[]

  def init(code: String, name: String): Void
    this.code = code
    this.name = name
    this.entries = []
  end
end

class Entry
  public id: Int
  public accountCode: String?
  public rank: Int
  public sentinel: Int
  public label: String
  public account: Account?
  public notes: Note[]

  def init(id: Int, accountCode: String?, rank: Int, sentinel: Int, label: String): Void
    this.id = id
    this.accountCode = accountCode
    this.rank = rank
    this.sentinel = sentinel
    this.label = label
    this.account = null
    this.notes = []
  end
end

class Note
  public id: Int
  public entryId: Int
  public body: String
  public entry: Entry?

  def init(id: Int, entryId: Int, body: String): Void
    this.id = id
    this.entryId = entryId
    this.body = body
    this.entry = null
  end
end
