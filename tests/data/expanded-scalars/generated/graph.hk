namespace expanded_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_ExpandedDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Account: neri_data::EntityTracker<expanded_model::Account>
  private visits_Account: neri_data::GraphVisitList<expanded_model::Account>
  private tracker_Item: neri_data::EntityTracker<expanded_model::Item>
  private visits_Item: neri_data::GraphVisitList<expanded_model::Item>

  def init(
    changes: neri_data::ChangeContext,
    tracker_Account: neri_data::EntityTracker<expanded_model::Account>,
    tracker_Item: neri_data::EntityTracker<expanded_model::Item>
  ): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Account = tracker_Account
    this.visits_Account = new neri_data::GraphVisitList<expanded_model::Account>(this.graph)
    this.tracker_Item = tracker_Item
    this.visits_Item = new neri_data::GraphVisitList<expanded_model::Item>(this.graph)
  end

  def add_accounts(root: expanded_model::Account): neri_data::TrackHandleResult<expanded_model::Account>
    match this.discover_accounts(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<expanded_model::Account>.Failure(error)
    end
  end

  private def discover_accounts(entity: expanded_model::Account): neri_data::GraphVisitResult<expanded_model::Account>
    match this.visits_Account.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<expanded_model::Account>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<expanded_model::Account>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Account)

        if staged != null
          return neri_data::GraphVisitResult<expanded_model::Account>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure? do
          return this.scan_accounts(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<expanded_model::Account>.Failure(queued)
        end
        return neri_data::GraphVisitResult<expanded_model::Account>.New(slot)
    end
  end

  private def scan_accounts(
    entity: expanded_model::Account,
    owner: neri_data::GraphSlot<expanded_model::Account>
  ): neri_data::QueryFailure?
    for child in entity.items
      let inverse = child.account

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider(neri_data::ProviderFailure.State("graph navigation inverse disagrees with collection: itemsFor_Account_by_tenant_accountExternalId"))
      end
      var related: neri_data::GraphSlot<expanded_model::Item>? = null

      match this.discover_items(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Account_by_tenant_accountExternalId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    for child in entity.approvedItems
      let inverse = child.approver

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider(neri_data::ProviderFailure.State("graph navigation inverse disagrees with collection: itemsFor_Account_by_tenant_approverExternalId"))
      end
      var related: neri_data::GraphSlot<expanded_model::Item>? = null

      match this.discover_items(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Account_by_tenant_approverExternalId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_items(root: expanded_model::Item): neri_data::TrackHandleResult<expanded_model::Item>
    match this.discover_items(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<expanded_model::Item>.Failure(error)
    end
  end

  private def discover_items(entity: expanded_model::Item): neri_data::GraphVisitResult<expanded_model::Item>
    match this.visits_Item.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<expanded_model::Item>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<expanded_model::Item>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Item)

        if staged != null
          return neri_data::GraphVisitResult<expanded_model::Item>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure? do
          return this.scan_items(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<expanded_model::Item>.Failure(queued)
        end
        return neri_data::GraphVisitResult<expanded_model::Item>.New(slot)
    end
  end

  private def scan_items(
    entity: expanded_model::Item,
    owner: neri_data::GraphSlot<expanded_model::Item>
  ): neri_data::QueryFailure?
    let principal_itemsFor_Account_by_tenant_accountExternalId = entity.account

    if principal_itemsFor_Account_by_tenant_accountExternalId != null
      var related: neri_data::GraphSlot<expanded_model::Account>? = null

      match this.discover_accounts(principal_itemsFor_Account_by_tenant_accountExternalId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Account_by_tenant_accountExternalId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    let principal_itemsFor_Account_by_tenant_approverExternalId = entity.approver

    if principal_itemsFor_Account_by_tenant_approverExternalId != null
      var related: neri_data::GraphSlot<expanded_model::Account>? = null

      match this.discover_accounts(principal_itemsFor_Account_by_tenant_approverExternalId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Account_by_tenant_approverExternalId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  private def link_itemsFor_Account_by_tenant_accountExternalId(
    principal: neri_data::GraphSlot<expanded_model::Account>,
    dependent: neri_data::GraphSlot<expanded_model::Item>,
    entity: expanded_model::Item
  ): neri_data::QueryFailure?
    let previous = entity.tenant
    let restore: fn(): Void = fn(): Void do
      entity.tenant = previous
    end

    return this.graph.stageLink(principal, dependent, edge_itemsFor_Account_by_tenant_accountExternalId, restore)
  end

  private def link_itemsFor_Account_by_tenant_approverExternalId(
    principal: neri_data::GraphSlot<expanded_model::Account>,
    dependent: neri_data::GraphSlot<expanded_model::Item>,
    entity: expanded_model::Item
  ): neri_data::QueryFailure?
    let previous = entity.tenant
    let restore: fn(): Void = fn(): Void do
      entity.tenant = previous
    end

    return this.graph.stageLink(principal, dependent, edge_itemsFor_Account_by_tenant_approverExternalId, restore)
  end
end
