use test

def codeStyleIndentationContracts(options: NeriCodeStyleOptions): Void
  let nested = "def main(): Void\nif true\nwork()\nelse\n# alternative\nwork()\nend\nmatch value\ncase Choice.Yes()\nwork()\nend\nend\n"
  let nestedExpected = "def main(): Void\n  if true\n    work()\n  else\n    # alternative\n    work()\n  end\n  match value\n    case Choice.Yes()\n      work()\n  end\nend\n"
  let arguments = "def main(): Void\n  consume(\nvalue,\nother(\nnext\n)\n)\nend\n"
  let argumentsExpected = "def main(): Void\n  consume(\n    value,\n    other(\n      next\n    )\n  )\nend\n"
  let crlf = "def main(): Void\r\nif true\r\n# body\r\nlet text = \"(literal)\"\r\nend\r\nend\r\n"
  let crlfExpected = "def main(): Void\r\n  if true\r\n    # body\r\n    let text = \"(literal)\"\r\n  end\r\nend\r\n"
  let matchBoundary = "def choose(value: Choice): Void\nmatch value\ncase Choice.One()\nwork()\ncase Choice.Two()\nwork()\nend\nend\ndef after(): Void\nwork()\nend\n"
  let matchBoundaryExpected = "def choose(value: Choice): Void\n  match value\n    case Choice.One()\n      work()\n    case Choice.Two()\n      work()\n  end\nend\ndef after(): Void\n  work()\nend\n"

  assertFormatted(options, nested, nestedExpected)
  assertFormatted(options, arguments, argumentsExpected)
  assertFormatted(options, crlf, crlfExpected)
  assertFormatted(options, matchBoundary, matchBoundaryExpected)
  let tabs = new NeriCodeStyleOptions()

  tabs.set("indent_style", "tab")
  tabs.set("tab_width", "4")

  assertFormatted(tabs, "def main(): Void\nwork()\nend\n", "def main(): Void\n\twork()\nend\n")
  tabs.set("indent_size", "6")

  assertFormatted(tabs, "def main(): Void\nwork()\nend\n", "def main(): Void\n\t  work()\nend\n")
  let disabled = new NeriCodeStyleOptions()

  disabled.set("neri_indentation", "false")
  let disabledResult = neriCodeStyleAnalyzeText("def main(): Void\nwork()\nend\n", disabled)

  test.assertTrue(disabledResult.valid)
  test.assertTrue(!findingHas(disabledResult, "NRSTYLE005"))
end
