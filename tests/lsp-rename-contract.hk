use host
use test

def renameFind(text: String, part: String): Int
  var start = 0
  while start + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var offset = 0
    while offset < host.stringByteLength(part)
      if host.stringByteAt(text, start + offset) != host.stringByteAt(part, offset)
        equal = false
      end
      offset = offset + 1
    end
    if equal
      return start
    end
    start = start + 1
  end
  return -1
end

def renameCount(text: String, part: String): Int
  var count = 0
  var remaining = text
  var found = renameFind(remaining, part)
  while found >= 0
    count = count + 1
    remaining = host.stringSlice(remaining, found + host.stringByteLength(part), host.stringByteLength(remaining) - found - host.stringByteLength(part))
    found = renameFind(remaining, part)
  end
  return count
end

def renameSnapshot(first: String, second: String): LspSemanticSnapshot
  let snapshot = new LspSemanticSnapshot()
  snapshot.projectKey = "rename-contract"
  snapshot.projectRevision = 1
  snapshot.requireEntryPoint = false
  snapshot.renameClosedWorld = true
  snapshot.sourceUris.add("file:///project/counter.hk")
  snapshot.sourceUris.add("file:///project/use.hk")
  snapshot.renameOwnedSourceUris.add("file:///project/counter.hk")
  snapshot.renameOwnedSourceUris.add("file:///project/use.hk")
  snapshot.sourceVersions.add(7)
  snapshot.sourceVersions.add(11)
  snapshot.sourceTexts.add(first)
  snapshot.sourceTexts.add(second)
  let analysis = lspAnalyzeRenameSnapshot(snapshot, null, "")

  test.assertTrue(analysis.semantic != null)
  snapshot.semantic = analysis.semantic
  snapshot.sourceStarts = analysis.sourceStarts
  return snapshot
end

def main(): Void
  let declaration = "class Counter\n  public value: Int\n\n  def read(): Int\n    return this.value\n  end\nend\n"
  let usage = "def consume(counter: Counter): Int\n  # value stays in a comment\n  let text = \"value\"\n  return counter.value\nend\n"
  let snapshot = renameSnapshot(declaration, usage)
  let field = snapshot.sourceStarts.get(0) + renameFind(declaration, "value")
  let prepared = lspPrepareRename(snapshot, field)

  test.assertEqual(prepared.error, "")
  test.assertTrue(renameFind(prepared.value, "\"placeholder\":\"value\"") >= 0)
  let renamed = lspRename(snapshot, field, "amount")

  test.assertEqual(renamed.error, "")
  test.assertEqual(renameCount(renamed.value, "\"newText\":\"amount\""), 3)
  test.assertTrue(renameFind(renamed.value, "\"version\":7") >= 0)
  test.assertTrue(renameFind(renamed.value, "\"version\":11") >= 0)
  let json = new LspJsonParser(renamed.value)
  let workspaceEdit = json.parse()
  json.spaces()

  test.assertTrue(!json.failed)
  test.assertEqual(json.position, host.stringByteLength(renamed.value))
  let documentChanges = workspaceEdit.get("documentChanges")
  var documentCount = 0
  var documentEdit = documentChanges.first
  while documentEdit != null
    documentCount = documentCount + 1
    documentEdit = documentEdit.next
  end
  test.assertEqual(documentChanges.kind, "array")
  test.assertEqual(documentCount, 2)

  let collisionSource = "class Pair\n  public left: Int\n  public right: Int\n\n  def read(): Int\n    return this.left + this.right\n  end\nend\n"
  let collision = renameSnapshot(collisionSource, "")
  let left = renameFind(collisionSource, "left")
  let rejected = lspRename(collision, left, "right")

  test.assertTrue(rejected.error != "")
  test.assertEqual(rejected.value, "null")

  let localSource = "def value(input: Int): Int\n  let current = input\n  return current\nend\n"
  let local = renameSnapshot(localSource, "")
  let current = renameFind(localSource, "current")
  let localRename = lspRename(local, current, "result")

  test.assertEqual(localRename.error, "")
  test.assertEqual(renameCount(localRename.value, "\"newText\":\"result\""), 2)
  test.assertTrue(lspRename(local, current, "return").error != "")

  let genericDeclaration = "class Box<T>\n  public value: T\nend\n"
  let genericUsage = "def make(value: Int): Box<Int>\n  let box = new Box<Int>()\n  box.value = value\n  return box\nend\n"
  let generic = renameSnapshot(genericDeclaration, genericUsage)
  let boxType = renameFind(genericDeclaration, "Box")
  let genericRename = lspRename(generic, boxType, "Crate")

  test.assertEqual(genericRename.error, "")
  test.assertEqual(renameCount(genericRename.value, "\"newText\":\"Crate\""), 3)

  let captureSource = "def original(): Int\n  return 1\nend\n\ndef caller(): Int\n  let captured = 2\n  return original()\nend\n"
  let capture = renameSnapshot(captureSource, "")
  let original = renameFind(captureSource, "original")

  test.assertTrue(lspRename(capture, original, "captured").error != "")

  let hierarchySource = "class Base\n  def value(): Int\n    return 1\n  end\nend\n\nclass Derived: Base\n  override def value(): Int\n    return 2\n  end\nend\n"
  let hierarchy = renameSnapshot(hierarchySource, "")
  let baseMethod = renameFind(hierarchySource, "value")

  test.assertTrue(lspRename(hierarchy, baseMethod, "amount").error != "")

  let lazySource = "class Counter\nend\n\ndef factory<T>(): Counter\n  return new Counter()\nend\n"
  let lazy = renameSnapshot(lazySource, "")
  let lazyCounter = renameFind(lazySource, "Counter")
  let lazyRename = lspRename(lazy, lazyCounter, "Meter")

  test.assertTrue(lazyRename.error != "")
  test.assertEqual(lazyRename.value, "null")
end
