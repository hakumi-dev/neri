use host
use process
use files
use test
use console

def dynamicCacheRoundtrip(toolchain: SessionToolchain, hit: Bool, retained: Bool): Void
  let session = new ExecutableSession(toolchain)
  let result = session.submit("def retainedDynamicValue(): Int\n  return 41\nend\nretainedDynamicValue()\n")

  test::assertTrue(result.execution.succeeded())
  test::assertEqual(result.execution.resultText, "41")
  test::assertEqual(result.execution.cacheHit, hit)
  if retained
    let next = session.submit("retainedDynamicValue() + 1\n")

    test::assertTrue(next.execution.succeeded())
    test::assertEqual(next.execution.resultText, "42")
  end

  test::assertTrue(session.dispose().succeeded())
end

def dynamicCacheReceipt(cache: String): String
  let root = files::Root.open(cache).root

  test::assertTrue(root != null)
  if root == null
    return ""
  end
  let listed = root.list("", 4096)
  let closed = root.close()
  var found = ""
  var count = 0

  test::assertTrue(listed.failure == null && closed == null)
  for entry in listed.entries
    if entry.kind.isDirectory()
      let path = cache + "/" + entry.name + "/receipt"
      let checked = files::status(path)
      let status = checked.status

      if checked.failure == null && status != null && status.exists && status.kind.isFile() && !status.symlink
        found = path
        count = count + 1
      end
    end
  end

  test::assertEqual(count, 1)
  return found
end

def main(): Void
  let compiler = host::argumentAt(0)
  let work = host::argumentAt(1)
  let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")
  let linker = host::environment("NERI_LINKER")

  test::assertTrue(compiler != null && work != null && manifestPath != null && linker != null)
  if compiler == null || work == null || manifestPath == null || linker == null
    return
  end
  let manifest = host::readText(manifestPath)

  test::assertTrue(manifest != null)
  if manifest == null
    return
  end
  let target = TargetPlatform.parse(bootstrapManifestString(manifest, "target"))

  test::assertTrue(target != null)
  if target == null || !target.isMacOS()
    return
  end
  if host::argumentAt(2) == "--dynamic-child"
    let selected = host::environment("NERI_SESSION_OBJECT_LINKER")
    let cache = host::environment("NERI_CACHE_DIR")

    test::assertTrue(selected != null && selected == "" && cache != null && cache == work)
    let toolchain = new SessionToolchain(compiler, linker, target, work)

    dynamicCacheRoundtrip(toolchain, false, false)
    let receipt = dynamicCacheReceipt(work)

    dynamicCacheRoundtrip(toolchain, true, true)

    test::assertTrue(receipt != "" && host::writeText(receipt, "corrupt native receipt\n"))
    dynamicCacheRoundtrip(toolchain, false, true)
    return
  end
  let executable = host::executablePath()
  let directory = bootstrapTemporaryDirectory(work, "session-dynamic-cache")

  test::assertTrue(executable != null && directory != null)
  if executable == null || directory == null
    return
  end
  let options = new process::SpawnOptions(executable)

  options.arguments = [compiler, directory, "--dynamic-child"]
  options.environment = [new process::EnvironmentEntry("NERI_SESSION_OBJECT_LINKER", ""),
    new process::EnvironmentEntry("NERI_CACHE_DIR", directory)]
  let started = process::spawn(options)
  let child = started.child()

  test::assertTrue(started.failure() == null && child != null)
  if child == null
    return
  end
  let result = child.wait(60000)
  var stopped = true

  if result.running || result.failure != null
    stopped = child.cancel()
    let final = child.wait(5000)

    stopped = stopped && !final.running
  end
  let disposed = child.dispose()
  let status = result.exit

  if result.failure != null || result.running || status == null || !status.isExited() || status.value() != 0
    let stdout = host::stringFromBytes(result.stdout)
    let stderr = host::stringFromBytes(result.stderr)

    console::println(stdout) if stdout != null
    console::println(stderr) if stderr != null
  end

  test::assertTrue(stopped && disposed && result.failure == null && !result.running)
  test::assertTrue(status != null && status.isExited() && status.value() == 0)
end
