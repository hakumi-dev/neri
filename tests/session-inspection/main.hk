use host
use test

def main(): Void
  let compiler = host::argumentAt(0)
  let linker = host::argumentAt(1)
  let target = host::argumentAt(2)
  let work = host::argumentAt(3)

  test::assertTrue(compiler != null && linker != null && target != null && work != null)
  if compiler == null || linker == null || target == null || work == null
    return
  end
  let platform = TargetPlatform.parse(target)

  test::assertTrue(platform != null)
  if platform == null
    return
  end
  sessionInspectionContracts(new SessionToolchain(compiler, linker, platform, work))
end
