use host
use files
use crypto
use test
use json
use result

def seedBundleContractTarget(): TargetPlatform?
  let path = host::environment("NERI_RUNTIME_MANIFEST")

  if path == null
    return null
  end
  let bytes = seedBundleRead(path, 1048576)

  if bytes == null
    return null
  end
  match json::parseBytes(bytes)
    case result::Result.Ok(value)
      let name = seedBundleString(value, "target")

      return name == null ? null : TargetPlatform.parse(name)
    case result::Result.Error(error)
      return null
  end
end

def seedBundleContractText(path: String): String
  let text = host::readText(path)

  test::assertTrue(text != null)
  return text == null ? "" : text
end

def main(): Void
  let compiler = host::argumentAt(0)
  let work = host::argumentAt(1)

  test::assertTrue(compiler != null && work != null)
  if compiler == null || work == null
    return
  end
  let target = seedBundleContractTarget()

  test::assertTrue(target != null)
  if target == null
    return
  end
  let directory = work + "/seed-bundle-contract"

  test::assertTrue(files::createDirectory(directory, true).failure == null)
  let source = directory + "/fixture.hk"
  let program = directory + "/fixture"

  test::assertTrue(host::writeText(source, "def main(): Void\nend\n"))
  let compiled = host::run(compiler, ["build", source, "--release", "--save-temps", "--no-cache", "--output", program])

  test::assertTrue(compiled != null && compiled == 0)
  var retained = program + ".temps"
  let windows = files::status(program + ".exe.temps").status

  if windows != null && windows.exists
    retained = program + ".exe.temps"
  end
  let bundle = new SeedBundle(retained)

  test::assertTrue(bundle.load())
  test::assertTrue(bundle.count > 0)
  let output = directory + "/binary"

  test::assertTrue(files::createDirectory(output).failure == null)
  test::assertTrue(bundle.copyBinary(output))
  test::assertTrue(bundle.verifyBinary(output))
  test::assertEqual(seedBundleContractText(output + "/UNITS.sha256"), bundle.unitManifest)
  var index = 0

  while index < bundle.count
    let transport = seedBundleContractText(retained + "/unit-" + (index as String) + ".o.nir.hex")
    let expected = crypto::decodeHex(transport, 134217728).bytes()
    let actual = seedBundleRead(output + "/unit-" + (index as String) + ".nir", 134217728)

    test::assertTrue(expected != null && actual != null)
    if expected != null && actual != null
      test::assertEqual(seedBundleDigest(actual), seedBundleDigest(expected))
    end
    index = index + 1
  end
  let binaryPath = output + "/unit-0.nir"
  let binary = seedBundleRead(binaryPath, 134217728)

  test::assertTrue(binary != null)
  if binary != null
    test::assertTrue(host::writeText(binaryPath, "corrupt"))
    test::assertTrue(!bundle.verifyBinary(output))
    test::assertTrue(!bundle.archive(output, directory + "/corrupt.tar", target))
    test::assertTrue(host::writeBytes(binaryPath, binary))
    test::assertTrue(bundle.verifyBinary(output))
  end
  if !target.isWindows()
    test::assertTrue(bundle.archive(output, directory + "/first.tar", target))
    test::assertTrue(bundle.archive(output, directory + "/second.tar", target))
    let first = seedBundleRead(directory + "/first.tar", 134217728)
    let second = seedBundleRead(directory + "/second.tar", 134217728)

    test::assertTrue(first != null && second != null)
    if first != null && second != null
      test::assertEqual(seedBundleDigest(first), seedBundleDigest(second))
    end
  end

  test::assertTrue(!bundle.copyBinary(output))
  for name in ["unit-0.o", "unit-0.o.nir.hex", "manifest.json"]
    let path = retained + "/" + name
    let original = seedBundleRead(path, 134217728)

    test::assertTrue(original != null)
    if original != null
      test::assertTrue(host::writeText(path, "corrupt"))
      test::assertTrue(!bundle.verify())
      test::assertTrue(!(new SeedBundle(retained)).load())
      test::assertTrue(host::writeBytes(path, original))
      test::assertTrue(bundle.verify())
    end
  end
  let extra = retained + "/unexpected.nir.hex"

  test::assertTrue(host::writeText(extra, "00"))
  test::assertTrue(!(new SeedBundle(retained)).load())
  test::assertTrue(files::removeFile(extra).failure == null)
  test::assertTrue(bundle.verify())
  let transport = retained + "/unit-0.o.nir.hex"

  test::assertTrue(files::move(transport, directory + "/missing-transport").failure == null)
  test::assertTrue(!(new SeedBundle(retained)).load())
  test::assertTrue(files::move(directory + "/missing-transport", transport).failure == null)
  test::assertTrue(bundle.verify())
end
