use host
use process
use test

def stdlibModuleWrite(path: String, value: String): Void
  test.assertTrue(host.writeText(path, value))
end

def stdlibModuleDirectory(path: String): Void
  let status = host.run("mkdir", ["-p", path])

  test.assertTrue(status != null && status == 0)
end

def stdlibModuleInvoke(compiler: String, library: String, arguments: String[]): process.PollResult
  let options = new process.SpawnOptions(compiler)

  options.arguments = arguments
  options.environment = [new process.EnvironmentEntry("NERI_STDLIB", library)]
  let started = process.spawn(options)

  test.assertTrue(started.failure() == null)
  let child = started.child()

  test.assertTrue(child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(30000)

  test.assertTrue(completed.failure == null && !completed.running && !completed.stdoutTruncated && !completed.stderrTruncated)
  test.assertTrue(child.dispose())
  return completed
end

def stdlibModuleOutput(result: process.PollResult): String
  let stdout = host.stringFromBytes(result.stdout)
  let stderr = host.stringFromBytes(result.stderr)
  var value = ""

  test.assertTrue(stdout != null && stderr != null)
  if stdout != null
    value = stdout
  end
  if stderr != null
    value = value + stderr
  end
  return value
end

def stdlibModuleExited(result: process.PollResult, expected: Int): Void
  let status = result.exit

  test.assertTrue(status != null)
  if status != null
    test.assertEqual(status.kind, "exit")
    test.assertEqual(status.value, expected)
  end
end

def main(): Void
  let root = host.argumentAt(0)
  let compiler = host.argumentAt(1)
  let work = host.argumentAt(2)

  test.assertTrue(root != null && compiler != null && work != null)
  if root == null || compiler == null || work == null
    return
  end
  let library = work + "/stdlib-module"
  let mainSource = work + "/stdlib-module-main.hk"
  let rendered = work + "/stdlib-module.nir"
  let documentation = work + "/stdlib-module-documentation.json"
  let core = host.readText(root + "/stdlib/core.hk")

  test.assertTrue(core != null)
  if core == null
    return
  end
  stdlibModuleDirectory(library + "/alpha")
  stdlibModuleDirectory(library + "/beta")
  stdlibModuleWrite(library + "/core.hk", core)
  stdlibModuleWrite(library + "/alpha/api.hk", "namespace alpha\n\ndef marker(): Int\n  return 1\nend\n")
  stdlibModuleWrite(library + "/alpha/implementation.hk", "use beta\nnamespace alpha\n\ndef answer(): Int\n  return beta.value()\nend\n")
  stdlibModuleWrite(library + "/beta/api.hk", "namespace beta\n\ndef value(): Int\n  return 42\nend\n")
  stdlibModuleWrite(mainSource, "use alpha\n\ndef main(): Void\n  let marker = alpha.marker()\n  let answer = alpha.answer()\nend\n")
  let manifest = "{\"version\":2,\"defaultUnit\":\"core\",\"units\":{\"core\":{\"kind\":\"library\",\"sources\":[\"core.hk\"]},\"alpha\":{\"kind\":\"library\",\"sources\":[\"alpha/api.hk\",\"alpha/implementation.hk\"]},\"beta\":{\"kind\":\"library\",\"sources\":[\"beta/api.hk\"]}}}\n"

  stdlibModuleWrite(library + "/manifest.json", manifest)
  let compiled = stdlibModuleInvoke(compiler, library, ["build", mainSource, "--emit=neri-ir", "--output", rendered, "--no-cache"])

  stdlibModuleExited(compiled, 0)
  let ir = host.readText(rendered)

  test.assertTrue(ir != null)
  if ir != null
    test.assertTrue(bootstrapFindText(ir, "source \"@stdlib/core.hk\"") >= 0)
    test.assertTrue(bootstrapFindText(ir, "source \"@stdlib/alpha/api.hk\"") >= 0)
    test.assertTrue(bootstrapFindText(ir, "source \"@stdlib/alpha/implementation.hk\"") >= 0)
    test.assertTrue(bootstrapFindText(ir, "source \"@stdlib/beta/api.hk\"") >= 0)
  end
  let indexed = stdlibModuleInvoke(compiler, library, ["documentation-index", "--output", documentation, library + "/alpha/api.hk", library + "/beta/api.hk"])

  stdlibModuleExited(indexed, 0)
  let documentationText = host.readText(documentation)

  test.assertTrue(documentationText != null)
  if documentationText != null
    test.assertTrue(bootstrapFindText(documentationText, "\"path\":\"alpha/api.hk\"") >= 0)
    test.assertTrue(bootstrapFindText(documentationText, "\"path\":\"beta/api.hk\"") >= 0)
  end
  let invalid = "{\"version\":2,\"defaultUnit\":\"core\",\"units\":{\"core\":{\"kind\":\"library\",\"sources\":[\"core.hk\"]},\"alpha\":{\"kind\":\"executable\",\"sources\":[\"alpha/api.hk\",\"alpha/implementation.hk\"]},\"beta\":{\"kind\":\"library\",\"sources\":[\"beta/api.hk\"]}}}\n"

  stdlibModuleWrite(library + "/manifest.json", invalid)
  let rejected = stdlibModuleInvoke(compiler, library, ["check", mainSource, "--no-cache"])

  stdlibModuleExited(rejected, 2)

  test.assertTrue(bootstrapFindText(stdlibModuleOutput(rejected), "Standard-library modules must be library units: alpha") >= 0)
end
