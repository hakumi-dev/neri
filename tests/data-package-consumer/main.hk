use console
use host
use test
use resources
use result
use data_package_consumer_data
use data_package_consumer_data::migrations
use data_package_consumer_model
use neri_data
use neri_data_sqlite

def rankOrder(): quote fn(data_package_consumer_model::Entry): Int
  return quote do |entry: data_package_consumer_model::Entry|: Int
    return entry.rank
  end
end

def expectSaved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertEqual(count, expected)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def expectApplied(result: MigrationResult, expected: Int): Void
  match result
    case MigrationResult.Applied(count)
      test::assertEqual(count, expected)
    case MigrationResult.Failure(error)
      console::println("installed migration failed")

      test::assertTrue(false)
  end
end

def verifyConsumer(provider: SQLiteProvider): Void
  let expected = schema_PackageDatabase()
  let historical = snapshot_initial()

  test::assertTrue(expected.validate() == null)
  test::assertEqual(historical.signature(), expected.signature())
  expectApplied(provider.migrate(new MigrationSet([migration_initial()])), 1)
  let db = new PackageDatabase(provider)
  let first = new Account(1, "Ada")
  let second = new Account(2, "Grace")
  let firstHigh = new data_package_consumer_model::Entry(10, 1, 2, "high")
  let firstLow = new data_package_consumer_model::Entry(11, 1, 1, "low")
  let secondHigh = new data_package_consumer_model::Entry(20, 2, 2, "high")
  let secondLow = new data_package_consumer_model::Entry(21, 2, 1, "low")

  test::assertTrue(db.accounts.add(first) == null)
  test::assertTrue(db.accounts.add(second) == null)
  test::assertTrue(db.entries.add(firstHigh) == null)
  test::assertTrue(db.entries.add(firstLow) == null)
  test::assertTrue(db.entries.add(secondHigh) == null)
  test::assertTrue(db.entries.add(secondLow) == null)
  expectSaved(db.saveChanges(), 6)
  let reading = new PackageDatabase(provider)

  match reading.include_entriesFor_Account_by_accountId(reading.accounts.take(2)).children(reading.entries.orderBy(rankOrder()).take(1)).all()
    case QueryResult.Failure(error)
      console::println("installed filtered include failed")

      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var seen = 0
      var current = rows.first()

      while current != null
        let account = current.value

        test::assertEqual(account.entries.Length, 1)
        if account.entries.Length == 1
          test::assertEqual(account.entries[0].rank, 1)
          test::assertEqual(account.entries[0].accountId, account.id)
          seen = seen + 1
        end
        current = current.next
      end

      test::assertEqual(seen, 2)
  end
  firstLow.label = "updated"

  test::assertTrue(db.entries.remove(secondHigh) == null)
  expectSaved(db.saveChanges(), 2)
  let finalRead = new PackageDatabase(provider)

  match finalRead.entries.where(id: 11).first()
    case QueryValue.Value(entry)
      test::assertTrue(entry != null)
      if entry != null
        test::assertEqual(entry.label, "updated")
      end
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match finalRead.entries.where(id: 20).first()
    case QueryValue.Value(entry)
      test::assertTrue(entry == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def runConsumer(databasePath: String): resources::Outcome<Bool, result::Failure>
  using session <- SQLiteSession.createWritable(databasePath)
    verifyConsumer(session.provider())
    return true
  end
  return false
end

def main(): Void
  let databasePath = host::argumentAt(0)
  let scaffoldPath = host::argumentAt(1)

  if host::argumentCount() != 2 || databasePath == null || scaffoldPath == null
    console::println("usage: data-package-consumer <database.sqlite> <scaffold-directory>")
    host::exit(2)
    return
  end

  test::assertTrue(host::readText(scaffoldPath + "/snapshot.json") != null)
  test::assertTrue(host::readText(scaffoldPath + "/scaffold.json") != null)
  let completed = runConsumer(databasePath)

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Failure(error)
      console::println(error.detail) if error != null
      host::exit(1)
    case resources::Completion.Value(value)
      test::assertTrue(value)
  end
  console::println("Installed Neri Data consumer passed")
end
