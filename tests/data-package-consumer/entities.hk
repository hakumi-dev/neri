namespace data_package_consumer_model

class Account
  public id: Int
  public name: String
  public entries: Entry[]

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
    this.entries = []
  end
end

class Entry
  public id: Int
  public accountId: Int
  public rank: Int
  public label: String
  public account: Account?

  def init(id: Int, accountId: Int, rank: Int, label: String): Void
    this.id = id
    this.accountId = accountId
    this.rank = rank
    this.label = label
    this.account = null
  end
end
