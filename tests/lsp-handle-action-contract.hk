use console
use host
use test

@cabi("open")
def unsafe openOutputDescriptor(path: Byte*, flags: Int32): Int32
end

def openOutput(path: String): Int
  var bytes: Byte[] = []
  var index = 0
  while index < host.stringByteLength(path)
    bytes = host.appendByte(bytes, host.stringByteAt(path, index))
    index = index + 1
  end
  bytes = host.appendByte(bytes, 0 as Byte)
  unsafe
    borrow bytes as pointer
      return openOutputDescriptor(pointer, 513 as Int32) as Int
    end
  end
end

@cabi("dup")
def unsafe duplicateDescriptor(fd: Int32): Int32
end

@cabi("dup2")
def unsafe replaceDescriptor(source: Int32, target: Int32): Int32
end

@cabi("close")
def unsafe closeDescriptor(fd: Int32): Int32
end

def request(server: LspServer, json: String): Void
  let message = (new LspJsonParser(json)).parse()

  test.assertTrue(message.kind != "missing")
  server.handle(message)
end

def requiredHandleText(path: String): String
  let text = host.readText(path)

  test.assertTrue(text != null)
  if text != null
    return text
  end
  return ""
end

def findHandleText(text: String, part: String, from: Int): Int
  var offset = from
  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0
    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return offset
    end
    offset = offset + 1
  end
  return -1
end

def responseFor(text: String, wanted: String): LspJson
  var offset = 0
  while offset < host.stringByteLength(text)
    let separator = findHandleText(text, "\r\n\r\n", offset)
    if separator < 0
      return new LspJson()
    end
    let length = host.parseInt(host.stringSlice(text, offset + 16, separator - offset - 16))
    if length == null
      return new LspJson()
    end
    let bodyStart = separator + 4
    let body = (new LspJsonParser(host.stringSlice(text, bodyStart, length))).parse()
    if body.get("id").value == wanted
      return body
    end
    offset = bodyStart + length
  end
  return new LspJson()
end

def main(): Void
  let root = host.argumentAt(0)

  test.assertTrue(root != null)
  if root == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "lsp-handle-contract")

  test.assertTrue(temporary != null)
  if temporary == null
    return
  end
  let outputPath = temporary + "/responses"
  let workspace = root + "/tests/lsp/manifest-workspace"
  let mainPath = workspace + "/main.hk"
  let mainText = requiredHandleText(mainPath)
  let mainUri = lspUri(mainPath)
  let server = new LspServer()
  var saved = -1
  var output = -1
  host.writeText(outputPath, "")
  unsafe
    output = openOutput(outputPath)
    saved = duplicateDescriptor(1 as Int32) as Int

    test.assertTrue(output >= 0 && saved >= 0 && replaceDescriptor(output as Int32, 1 as Int32) >= (0 as Int32))
  end
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":" + lspQuote(lspUri(workspace)) + ",\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}},\"textDocument\":{\"codeAction\":{\"codeActionLiteralSupport\":{\"codeActionKind\":{\"valueSet\":[\"quickfix\"]}}}}}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + ",\"languageId\":\"neri\",\"version\":3,\"text\":" + lspQuote(mainText) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/rename\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"position\":{\"line\":3,\"character\":20},\"newName\":\"renamed\"}}")
  let actionUri = "untitled:code-action"
  let actionText = "use console # retained\n\ndef main(): Void\nend\n"
  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + ",\"languageId\":\"neri\",\"version\":9,\"text\":" + lspQuote(actionText) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[\"quickfix\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"workspace/symbol\",\"params\":{\"query\":\"helper\"}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/typeDefinition\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"position\":{\"line\":3,\"character\":20}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[\"source\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[]}}}")
  let opened = server.find(actionUri)

  test.assertTrue(opened != null)
  if opened != null
    test.assertEqual(opened.text, actionText)
    test.assertEqual(opened.version, 9)
  end
  unsafe
    test.assertTrue(replaceDescriptor(saved as Int32, 1 as Int32) >= (0 as Int32))
    closeDescriptor(saved as Int32)
    closeDescriptor(output as Int32)
  end
  let response = requiredHandleText(outputPath)
  let initialized = responseFor(response, "1")
  let renamed = responseFor(response, "2").get("result")
  let quickFix = responseFor(response, "3").get("result")
  let symbols = responseFor(response, "4").get("result")
  let typeDefinition = responseFor(response, "5").get("result")
  let organized = responseFor(response, "6").get("result")
  let empty = responseFor(response, "7").get("result")

  test.assertTrue(initialized.get("result").get("capabilities").get("codeActionProvider").kind == "object")
  test.assertTrue(renamed.kind == "object" && renamed.get("documentChanges").kind == "array")
  let quickAction = quickFix.first

  test.assertTrue(quickFix.kind == "array" && quickAction != null)
  if quickAction != null
    let changes = quickAction.get("edit").get("documentChanges")
    let change = changes.first

    test.assertTrue(change != null)
    if change != null
      test.assertEqual(change.get("textDocument").get("version").value, "9")
    end
  end
  test.assertTrue(symbols.kind == "array" && symbols.first != null)
  test.assertTrue(typeDefinition.kind == "literal" && typeDefinition.value == "null")
  let organizeAction = organized.first

  test.assertTrue(organized.kind == "array" && organizeAction != null)
  if organizeAction != null
    test.assertEqual(organizeAction.get("kind").value, "source.organizeImports")
  end
  test.assertTrue(empty.kind == "array" && empty.first == null)
  host.removeFile(outputPath)
  bootstrapRemoveEmptyDirectory(temporary)
end
