use console
use host
use test

@cabi("open")
unsafe def openOutputDescriptor(path: Byte*, flags: Int32): Int32
end

def openOutput(path: String): Int
  var bytes: Byte[] = []
  var index = 0

  while index < host.stringByteLength(path)
    bytes = host.appendByte(bytes, host.stringByteAt(path, index))
    index = index + 1
  end
  bytes = host.appendByte(bytes, 0 as Byte)
  unsafe
    borrow bytes as pointer
      return openOutputDescriptor(pointer, 513 as Int32) as Int
    end
  end
end

@cabi("dup")
unsafe def duplicateDescriptor(fd: Int32): Int32
end

@cabi("dup2")
unsafe def replaceDescriptor(source: Int32, target: Int32): Int32
end

@cabi("close")
unsafe def closeDescriptor(fd: Int32): Int32
end

def request(server: LspServer, json: String): Void
  let message = (new LspJsonParser(json)).parse()

  test.assertTrue(message.kind != "missing")
  server.handle(message)
end

def requiredHandleText(path: String): String
  let text = host.readText(path)

  test.assertTrue(text != null)
  if text != null
    return text
  end
  return ""
end

def findHandleText(text: String, part: String, from: Int): Int
  var offset = from

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return offset
    end
    offset = offset + 1
  end
  return -1
end

def responseFor(text: String, wanted: String): LspJson
  var offset = 0

  while offset < host.stringByteLength(text)
    let separator = findHandleText(text, "\r\n\r\n", offset)

    if separator < 0
      return new LspJson()
    end
    let length = host.parseInt(host.stringSlice(text, offset + 16, separator - offset - 16))

    if length == null
      return new LspJson()
    end
    let bodyStart = separator + 4
    let body = (new LspJsonParser(host.stringSlice(text, bodyStart, length))).parse()

    if body.get("id").value == wanted
      return body
    end
    offset = bodyStart + length
  end
  return new LspJson()
end

def publicationFor(text: String, uri: String, version: String): LspJson
  var offset = 0

  while offset < host.stringByteLength(text)
    let separator = findHandleText(text, "\r\n\r\n", offset)

    if separator < 0
      return new LspJson()
    end
    let length = host.parseInt(host.stringSlice(text, offset + 16, separator - offset - 16))

    if length == null
      return new LspJson()
    end
    let bodyStart = separator + 4
    let body = (new LspJsonParser(host.stringSlice(text, bodyStart, length))).parse()
    let params = body.get("params")

    if body.get("method").value == "textDocument/publishDiagnostics" && params.get("uri").value == uri && params.get("version").value == version
      return params.get("diagnostics")
    end
    offset = bodyStart + length
  end
  return new LspJson()
end

def applyHandleEdit(source: String, edit: LspJson): String
  let range = edit.get("range")
  let start = lspByteOffset(source, range.get("start"))
  let finish = lspByteOffset(source, range.get("end"))

  test.assertTrue(start >= 0 && finish >= start)
  return host.stringSlice(source, 0, start) + edit.get("newText").value + host.stringSlice(source, finish, host.stringByteLength(source) - finish)
end

def requestHandleCompletion(server: LspServer, id: String): Void
  let uri = "untitled:completion-" + id
  let text = "def write(value: Int): Void\nend\ndef main(): Void\n  wri\nend\n"
  let position = lspPosition(text, new IrSourceMap(text).utf16Length() - 5)

  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(uri) + ",\"languageId\":\"neri\",\"version\":1,\"text\":" + lspQuote(text) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(uri) + "},\"position\":" + position + "}}")
end

def assertHandleCompletion(response: String, id: String, insertion: String, format: String): Void
  let item = responseFor(response, id).get("result").first

  test.assertTrue(item != null)
  if item != null
    test.assertEqual(item.get("label").value, "write")
    test.assertEqual(item.get("textEdit").get("newText").value, insertion)
    test.assertEqual(item.get("insertTextFormat").value, format)
  end
end

def main(): Void
  let root = host.argumentAt(0)

  test.assertTrue(root != null)
  if root == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "lsp-handle-contract")

  test.assertTrue(temporary != null)
  if temporary == null
    return
  end
  let outputPath = temporary + "/responses"
  let workspace = root + "/tests/lsp/manifest-workspace"
  let mainPath = workspace + "/main.hk"
  let mainText = requiredHandleText(mainPath)
  let mainUri = lspUri(mainPath)
  let server = new LspServer()
  var saved = -1
  var output = -1

  host.writeText(outputPath, "")
  unsafe
    output = openOutput(outputPath)
    saved = duplicateDescriptor(1 as Int32) as Int

    test.assertTrue(output >= 0 && saved >= 0 && replaceDescriptor(output as Int32, 1 as Int32) >= (0 as Int32))
  end
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":" + lspQuote(lspUri(workspace)) + ",\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}},\"textDocument\":{\"completion\":{\"completionItem\":{\"snippetSupport\":true}},\"codeAction\":{\"codeActionLiteralSupport\":{\"codeActionKind\":{\"valueSet\":[\"quickfix\"]}}}}}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + ",\"languageId\":\"neri\",\"version\":3,\"text\":" + lspQuote(mainText) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/rename\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"position\":{\"line\":3,\"character\":20},\"newName\":\"renamed\"}}")
  let actionUri = "untitled:code-action"
  let actionText = "use console # retained\n\ndef main(): Void\nend\n"

  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + ",\"languageId\":\"neri\",\"version\":9,\"text\":" + lspQuote(actionText) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[\"quickfix\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"workspace/symbol\",\"params\":{\"query\":\"helper\"}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/typeDefinition\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"position\":{\"line\":3,\"character\":20}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[\"source\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(actionUri) + "},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"context\":{\"diagnostics\":[],\"only\":[]}}}")
  let styleText = "use manifestdemo\n\ndef main(): Void\n  let value = helper()\n  return\nend\n"

  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + ",\"version\":4},\"contentChanges\":[{\"text\":" + lspQuote(styleText) + "}]}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"options\":{\"tabSize\":2,\"insertSpaces\":true}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"range\":{\"start\":{\"line\":3,\"character\":0},\"end\":{\"line\":4,\"character\":8}},\"context\":{\"diagnostics\":[],\"only\":[\"source.fixAll.neri\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"range\":{\"start\":{\"line\":4,\"character\":2},\"end\":{\"line\":4,\"character\":2}},\"context\":{\"diagnostics\":[],\"only\":[\"quickfix\"]}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":13,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"range\":{\"start\":{\"line\":4,\"character\":2},\"end\":{\"line\":4,\"character\":2}},\"context\":{\"diagnostics\":[],\"only\":[]}}}")
  let disabled = new LspServer()

  request(disabled, "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"initialize\",\"params\":{\"rootUri\":" + lspQuote(lspUri(workspace)) + ",\"initializationOptions\":{\"codeStyleDiagnostics\":false},\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}},\"textDocument\":{\"codeAction\":{\"codeActionLiteralSupport\":{\"codeActionKind\":{\"valueSet\":[\"quickfix\"]}}}}}}}")
  request(disabled, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + ",\"languageId\":\"neri\",\"version\":5,\"text\":" + lspQuote(styleText) + "}}}")
  request(disabled, "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(mainUri) + "},\"options\":{\"tabSize\":2,\"insertSpaces\":true}}}")
  requestHandleCompletion(server, "14")
  requestHandleCompletion(disabled, "15")
  let enterText = "# 🙂\nclass Box\n"

  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"untitled:enter\",\"languageId\":\"neri\",\"version\":1,\"text\":" + lspQuote(enterText) + "}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":16,\"method\":\"textDocument/onTypeFormatting\",\"params\":{\"textDocument\":{\"uri\":\"untitled:enter\"},\"position\":{\"line\":2,\"character\":0},\"ch\":\"\\n\",\"options\":{\"tabSize\":2,\"insertSpaces\":false}}}")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":17,\"method\":\"textDocument/onTypeFormatting\",\"params\":{\"textDocument\":{\"uri\":\"untitled:enter\"},\"position\":{\"line\":0,\"character\":3},\"ch\":\"\\n\",\"options\":{\"tabSize\":2,\"insertSpaces\":true}}}")
  let enterDocument = server.find("untitled:enter")

  test.assertTrue(enterDocument != null)
  if enterDocument != null
    test.assertEqual(enterDocument.text, enterText)
    test.assertEqual(enterDocument.version, 1)
  end
  let opened = server.find(actionUri)

  test.assertTrue(opened != null)
  if opened != null
    test.assertEqual(opened.text, actionText)
    test.assertEqual(opened.version, 9)
  end
  let typingUri = "untitled:typing"

  request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(typingUri) + ",\"languageId\":\"neri\",\"version\":1,\"text\":\"class Obsolete\\nend\"}}}")
  var version = 2

  while version <= 21
    request(server, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(typingUri) + ",\"version\":" + (version as String) + "},\"contentChanges\":[{\"text\":\"class Fresh\\n  def run(): Void\\n\\n  end\\nend\\n\"}]}}")
    version = version + 1
  end
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":18,\"method\":\"textDocument/onTypeFormatting\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(typingUri) + "},\"position\":{\"line\":2,\"character\":0},\"ch\":\"\\n\",\"options\":{\"tabSize\":2,\"insertSpaces\":true}}}")
  let beforeSemanticQuery = requiredHandleText(outputPath)

  test.assertEqual(publicationFor(beforeSemanticQuery, typingUri, "21").kind, "missing")
  request(server, "{\"jsonrpc\":\"2.0\",\"id\":19,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":" + lspQuote(typingUri) + "}}}")
  var pending = server.pendingAnalysis()

  while pending != null
    server.analyze(pending)
    pending = server.pendingAnalysis()
  end
  pending = disabled.pendingAnalysis()
  while pending != null
    disabled.analyze(pending)
    pending = disabled.pendingAnalysis()
  end
  unsafe
    test.assertTrue(replaceDescriptor(saved as Int32, 1 as Int32) >= (0 as Int32))
    closeDescriptor(saved as Int32)
    closeDescriptor(output as Int32)
  end
  let response = requiredHandleText(outputPath)

  assertHandleCompletion(response, "14", "write($0)", "2")
  assertHandleCompletion(response, "15", "write()", "1")
  let typingEdit = responseFor(response, "18").get("result").first
  let typingSymbol = responseFor(response, "19").get("result").first

  test.assertTrue(typingEdit != null && typingSymbol != null)
  if typingEdit != null && typingSymbol != null
    test.assertEqual(typingEdit.get("newText").value, "    ")
    test.assertEqual(typingSymbol.get("name").value, "Fresh")
  end

  test.assertEqual(publicationFor(response, typingUri, "21").kind, "array")
  version = 1
  while version < 21
    test.assertEqual(publicationFor(response, typingUri, version as String).kind, "missing")
    version = version + 1
  end
  let initialized = responseFor(response, "1")
  let enter = responseFor(response, "16").get("result").first

  test.assertEqual(initialized.get("result").get("capabilities").get("documentOnTypeFormattingProvider").get("firstTriggerCharacter").value, "\n")
  test.assertTrue(enter != null)
  test.assertEqual(responseFor(response, "17").get("error").get("code").value, "-32602")
  if enter != null
    test.assertEqual(applyHandleEdit(enterText, enter), "# 🙂\nclass Box\n\t\nend")
  end
  let renamed = responseFor(response, "2").get("result")
  let quickFix = responseFor(response, "3").get("result")
  let symbols = responseFor(response, "4").get("result")
  let typeDefinition = responseFor(response, "5").get("result")
  let organized = responseFor(response, "6").get("result")
  let empty = responseFor(response, "7").get("result")
  let formatting = responseFor(response, "8").get("result")
  let fixAll = responseFor(response, "9").get("result")
  let disabledFormatting = responseFor(response, "11").get("result")
  let styleQuickFix = responseFor(response, "12").get("result")
  let styleEmpty = responseFor(response, "13").get("result")
  let enabledDiagnostics = publicationFor(response, mainUri, "4")
  let disabledDiagnostics = publicationFor(response, mainUri, "5")

  test.assertTrue(initialized.get("result").get("capabilities").get("codeActionProvider").kind == "object")
  test.assertTrue(renamed.kind == "object" && renamed.get("documentChanges").kind == "array")
  let quickAction = quickFix.first

  test.assertTrue(quickFix.kind == "array" && quickAction != null)
  if quickAction != null
    let changes = quickAction.get("edit").get("documentChanges")
    let change = changes.first

    test.assertTrue(change != null)
    if change != null
      test.assertEqual(change.get("textDocument").get("version").value, "9")
    end
  end

  test.assertTrue(symbols.kind == "array" && symbols.first != null)
  test.assertTrue(typeDefinition.kind == "literal" && typeDefinition.value == "null")
  let organizeAction = organized.first

  test.assertTrue(organized.kind == "array" && organizeAction != null)
  if organizeAction != null
    test.assertEqual(organizeAction.get("kind").value, "source.organizeImports")
  end

  test.assertTrue(empty.kind == "array" && empty.first == null)
  let formattingEdit = formatting.first

  test.assertTrue(formatting.kind == "array" && formattingEdit != null)
  if formattingEdit != null
    let range = formattingEdit.get("range")

    test.assertEqual(range.get("start").get("line").value, "4")
    test.assertEqual(range.get("start").get("character").value, "0")
    test.assertEqual(range.get("end").get("line").value, "4")
    test.assertEqual(range.get("end").get("character").value, "0")
    test.assertEqual(formattingEdit.get("newText").value, "\n")
    test.assertEqual(applyHandleEdit(styleText, formattingEdit), "use manifestdemo\n\ndef main(): Void\n  let value = helper()\n\n  return\nend\n")
  end
  let fixAllAction = fixAll.first

  test.assertTrue(fixAll.kind == "array" && fixAllAction != null)
  if fixAllAction != null
    let changes = fixAllAction.get("edit").get("documentChanges")
    let change = changes.first

    test.assertEqual(fixAllAction.get("kind").value, "source.fixAll.neri")
    test.assertTrue(change != null)
    if change != null
      test.assertEqual(change.get("textDocument").get("version").value, "4")
    end
  end

  test.assertTrue(disabledFormatting.kind == "array" && disabledFormatting.first != null)
  let styleAction = styleQuickFix.first

  test.assertTrue(styleQuickFix.kind == "array" && styleAction != null)
  if styleAction != null
    let changes = styleAction.get("edit").get("documentChanges")
    let change = changes.first
    let diagnostics = styleAction.get("diagnostics")
    let diagnostic = diagnostics.first

    test.assertEqual(styleAction.get("kind").value, "quickfix")
    test.assertTrue(diagnostic != null)
    if diagnostic != null
      test.assertEqual(diagnostic.get("code").value, "NRSTYLE001")
    end

    test.assertTrue(change != null)
    if change != null
      test.assertEqual(change.get("textDocument").get("version").value, "4")
    end
  end

  test.assertTrue(styleEmpty.kind == "array" && styleEmpty.first == null)
  let enabledDiagnostic = enabledDiagnostics.first

  test.assertTrue(enabledDiagnostics.kind == "array" && enabledDiagnostic != null)
  if enabledDiagnostic != null
    test.assertEqual(enabledDiagnostic.get("code").value, "NRSTYLE001")
  end

  test.assertTrue(disabledDiagnostics.kind == "array" && disabledDiagnostics.first == null)
  host.removeFile(outputPath)
  bootstrapRemoveEmptyDirectory(temporary)
end
