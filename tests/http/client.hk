use http
use host
use test
use console

@cabi("neri_rt_v1_net_connect")
def unsafe connectLocal(fd: Int, port: Int): Int
end

def port(): Int
  let configured = host.environment("PORT")
  if configured != null
    let value = host.parseInt(configured)
    if value != null
      return value
    end
  end
  return 8080
end

def connect(timeoutMilliseconds: Int = 5000): Int
  unsafe
    let deadline = http.netMilliseconds() + timeoutMilliseconds
    while http.netMilliseconds() < deadline
      let fd = http.netOpen()
      if fd >= 0
        if connectLocal(fd, port()) == 0
          if http.netConfigure(fd) == 0
            return fd
          end
        end
        http.netClose(fd)
      end
    end
  end
  test.assertTrue(false)
  return -1
end

def exchange(request: String, fragmented: Bool = false): String
  let fd = connect()
  var result = ""
  unsafe
    let bytes = stackalloc Byte[4096]
    let deadline = http.netMilliseconds() + 5000
    var written = true
    if fragmented
      var offset = 0
      while offset < host.stringByteLength(request)
        var count = host.stringByteLength(request) - offset
        count = 3 if count > 3
        written = http.writeText(fd, host.stringSlice(request, offset, count)) && written
        offset = offset + count
        http.netPoll(fd, 0, 5) if offset < host.stringByteLength(request)
      end
    else
      written = http.writeText(fd, request)
    end
    if !written
      http.netClose(fd)
      test.assertTrue(false)
      return ""
    end
    var done = false
    while !done
      if http.waitSocket(fd, 0, deadline) <= 0
        http.netClose(fd)
        test.assertTrue(false)
        return ""
      end
      let count = http.netRead(fd, bytes, 4096)
      if count == 0
        done = true
      else if count == -1
        http.netClose(fd)
        test.assertTrue(false)
        return ""
      else if count > 0
        var index = 0
        while index < count
          let character = host.stringFromBytes([bytes[index]])
          result = result + character if character != null
          index = index + 1
        end
      end
    end
    http.netClose(fd)
  end
  return result
end

def expect(request: String, status: Int): Void
  let result = exchange(request)
  test.assertTrue(http.find(result, "HTTP/1.1 " + (status as String) + " ", 0) == 0)
  test.assertTrue(http.find(result, "\r\nConnection: close\r\n", 0) > 0)
end

def largeResponse(): Void
  let fd = connect()
  var header = ""
  var bodyBytes = 0
  var bodyValid = true
  var readingHeader = true
  unsafe
    let bytes = stackalloc Byte[4096]
    let deadline = http.netMilliseconds() + 10000
    test.assertTrue(http.writeText(fd, "GET /large HTTP/1.1\r\nHost: a\r\n\r\n"))
    var done = false
    while !done
      test.assertTrue(http.waitSocket(fd, 0, deadline) > 0)
      let count = http.netRead(fd, bytes, 4096)
      test.assertTrue(count != -1)
      done = true if count == 0
      var index = 0
      while index < count
        if readingHeader
          let character = host.stringFromBytes([bytes[index]])
          header = header + character if character != null
          test.assertTrue(host.stringByteLength(header) < 1024)
          readingHeader = http.find(header, "\r\n\r\n", 0) < 0
        else
          bodyValid = bodyValid && (bytes[index] as Int) == 120
          bodyBytes = bodyBytes + 1
        end
        index = index + 1
      end
    end
    http.netClose(fd)
  end
  test.assertEqual(bodyBytes, 1048576)
  test.assertTrue(bodyValid)
  test.assertTrue(http.find(header, "Content-Length: 1048576\r\n", 0) > 0)
end

def disconnectResponse(): Void
  let fd = connect()
  unsafe
    let byte = stackalloc Byte[1]
    test.assertTrue(http.writeText(fd, "GET /large HTTP/1.1\r\nHost: a\r\n\r\n"))
    test.assertTrue(http.waitSocket(fd, 0, http.netMilliseconds() + 5000) > 0)
    test.assertEqual(http.netRead(fd, byte, 1), 1)
    http.netClose(fd)
  end
end

def binaryResponse(): Void
  let fd = connect()
  var header = ""
  var received = 0
  var valid = true
  var readingHeader = true
  unsafe
    let bytes = stackalloc Byte[4096]
    let deadline = http.netMilliseconds() + 5000
    test.assertTrue(http.writeText(fd, "GET /binary HTTP/1.1\r\nHost: a\r\n\r\n"))
    var done = false
    while !done
      test.assertTrue(http.waitSocket(fd, 0, deadline) > 0)
      let count = http.netRead(fd, bytes, 4096)
      test.assertTrue(count != -1)
      done = count == 0
      var index = 0
      while index < count
        if readingHeader
          let character = host.stringFromBytes([bytes[index]])
          header = header + character if character != null
          test.assertTrue(host.stringByteLength(header) < 1024)
          readingHeader = http.find(header, "\r\n\r\n", 0) < 0
        else
          valid = valid && (bytes[index] as Int) == received - (received / 256) * 256
          received = received + 1
        end
        index = index + 1
      end
    end
    http.netClose(fd)
  end
  test.assertTrue(valid)
  test.assertEqual(received, 1027)
  test.assertTrue(http.find(header, "Content-Type: application/octet-stream\r\n", 0) > 0)
  test.assertTrue(http.find(header, "Content-Length: 1027\r\n", 0) > 0)
  test.assertEqual(exchange("HEAD /binary HTTP/1.1\r\nHost: a\r\n\r\n"), header)
end

def main(): Void
  let requests = [
    "GET / HTTP/1.1\r\nHost: a\r\n",
    "GET / HTTP/1.1\r\n\r\n",
    "GET /%xx HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nContent-Length: x\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n",
    "POST / HTTP/1.1\r\nHost: a\r\n\r\n"]
  let codes = ["malformed_request", "invalid_host", "invalid_target", "invalid_content_length", "unsupported_framing", "unsupported_method"]
  var caseIndex = 0
  while caseIndex < requests.Length
    let failure = http.parse(requests[caseIndex]).failure
    test.assertTrue(failure != null)
    if failure != null
      test.assertEqual(failure.code, codes[caseIndex])
    end
    caseIndex = caseIndex + 1
  end
  let socketFailure = http.readHead(-1).failure
  test.assertTrue(socketFailure != null)
  if socketFailure != null
    test.assertEqual(socketFailure.code, "socket_error")
    test.assertEqual(socketFailure.operation, "read.wait")
  end
  let timed = http.writeTextResult(-1, "x", 0)
  test.assertEqual(timed.bytesWritten, 0)
  let timeout = timed.failure
  test.assertTrue(timeout != null)
  if timeout != null
    test.assertEqual(timeout.code, "timeout")
  end
  # The first connection also waits for a cold compiler-run server to start.
  let closed = connect(30000)

  test.assertTrue(http.writeText(closed, "GET / HTTP/1.1\r\nHost: a\r\n\r\n"))
  test.assertEqual(http.readHead(closed).status, 200)
  let eof = http.readHead(closed).failure
  unsafe
    http.netClose(closed)
  end
  test.assertTrue(eof != null)
  if eof != null
    test.assertEqual(eof.code, "peer_closed")
  end
  let fields = new http.Headers()
  test.assertTrue(!fields.add("X-Invalid", "value\r\nInjected: yes"))
  test.assertTrue(!fields.add("é", "value"))
  test.assertEqual(fields.count(), 0)
  test.assertTrue(http.parse("GET /水 HTTP/1.1\r\nHost: a\r\n\r\n").request == null)
  let headRequest = "HEAD / HTTP/1.1\r\nHost: local\r\n\r\n"
  test.assertEqual(http.parse(headRequest).status, 405)
  test.assertTrue(http.parse(headRequest, true).request != null)
  let valid = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
  let response = exchange(valid)
  test.assertTrue(http.find(response, "Content-Type: text/plain; charset=utf-8\r\n", 0) > 0)
  test.assertTrue(http.find(response, "Content-Length: 13\r\n", 0) > 0)
  test.assertTrue(http.find(response, "\r\n\r\nHello, world!", 0) > 0)
  let fragmented = exchange(valid, true)
  test.assertEqual(fragmented, response)
  let headResponse = exchange("HEAD / HTTP/1.1\r\nHost: localhost\r\n\r\n")
  test.assertEqual(headResponse, host.stringSlice(response, 0, http.find(response, "\r\n\r\n", 0) + 4))
  let options = new http.Options()
  options.onListening = fn(address)
    test.assertTrue(false)
  end
  let handler: fn(http.Request): http.Response = fn(request)
    return http.text(200, "unused")
  end
  let occupied = http.serve("127.0.0.1:" + (port() as String), handler, options)
  test.assertTrue(http.find(occupied, "Address already in use", 0) >= 0)
  let fixture = host.environment("NERI_HTTP_FIXTURE") != null
  if !fixture
    console.println("HTTP example contracts passed")
    return
  end
  var descriptors = ""
  if fixture
    binaryResponse()
    let headers = exchange("GET /headers HTTP/1.1\r\nHost: a\r\nx-tag: first\r\nX-TAG: second\r\n\r\n")
    test.assertTrue(http.find(headers, "\r\n\r\nfirst/second", 0) > 0)
    test.assertTrue(http.find(headers, "Content-Type: text/html; charset=utf-8\r\n", 0) > 0)
    test.assertTrue(http.find(headers, "ETag: \"asset-v1\"\r\nSet-Cookie: a=1\r\nset-cookie: b=2\r\n", 0) > 0)
    expect("GET /framing HTTP/1.1\r\nHost: a\r\n\r\n", 500)
    expect("GET /duplicate HTTP/1.1\r\nHost: a\r\n\r\n", 500)
    for path in ["/missing", "/empty", "/reset", "/cached", "/invalid"]
      let get = exchange("GET " + path + " HTTP/1.1\r\nHost: a\r\n\r\n")
      let head = exchange("HEAD " + path + " HTTP/1.1\r\nHost: a\r\n\r\n")
      test.assertEqual(head, host.stringSlice(get, 0, http.find(get, "\r\n\r\n", 0) + 4))
    end
    let method = exchange("HEAD /a%2Fb?q=x HTTP/1.1\r\nHost: a\r\n\r\n")
    test.assertTrue(http.find(method, "Content-Length: 15\r\n", 0) > 0)
    let unsupported = exchange("POST / HTTP/1.1\r\nHost: a\r\n\r\n")
    test.assertTrue(http.find(unsupported, "Allow: GET, HEAD\r\n", 0) > 0)
    descriptors = exchange("GET /fds HTTP/1.1\r\nHost: a\r\n\r\n")
    let encoded = exchange("GET /a%2Fb?q=%E2%82%AC HTTP/1.1\r\nHost: a\r\n\r\n", true)
    test.assertTrue(http.find(encoded, "\r\n\r\nGET /a%2Fb?q=%E2%82%AC", 0) > 0)
    expect("GET /invalid HTTP/1.1\r\nHost: a\r\n\r\n", 500)
    let empty = exchange("GET /empty HTTP/1.1\r\nHost: a\r\n\r\n")
    test.assertTrue(http.find(empty, "Content-Length", 0) < 0)
    test.assertTrue(http.find(empty, "discarded", 0) < 0)
  end
  for malformed in [
    "GET / HTTP/1.x\r\nHost: a\r\n\r\n",
    "GET / HTTP/1.1\rX\r\nHost: a\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\n folded: x\r\n\r\n",
    "GET / HTTP/1.1\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n",
    "GET / HTTP/1.1\r\nHost : a\r\n\r\n",
    "GET /%xx HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nContent-Length: 1\r\n\r\nx",
    "GET / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n"]
    expect(malformed, 400)
    expect(valid, 200)
  end
  expect("POST / HTTP/1.1\r\nHost: a\r\n\r\n", 405)
  expect("GET / HTTP/1.0\r\nHost: a\r\n\r\n", 505)
  expect("GET / HTTP/1.1\r\nHost: a\r\nExpect: 100-continue\r\n\r\n", 417)
  expect("GET / HTTP/1.1\r\nHost:", 408)
  var oversized = "x"
  while host.stringByteLength(oversized) < 8192
    oversized = oversized + oversized
  end
  expect(oversized, 431)
  var index = 0
  while index < 100
    let fd = connect()
    http.writeText(fd, "GET / HTTP/1.1\r\n")
    unsafe
      http.netClose(fd)
    end
    expect(valid, 200)
    index = index + 1
  end
  if fixture
    largeResponse()
    index = 0
    while index < 20
      disconnectResponse()
      expect(valid, 200)
      index = index + 1
    end
    test.assertEqual(exchange("GET /fds HTTP/1.1\r\nHost: a\r\n\r\n"), descriptors)
  end
  console.println("HTTP protocol contracts passed")
end
