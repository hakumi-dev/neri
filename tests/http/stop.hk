use http
use test

@cabiImport("neri_rt_v1_net_connect")
unsafe def connectLocal(fd: Int, port: Int): Int
end

class State
  public client: Int = -1
  public handled: Bool = false
end

def main(): Void
  let address = "127.0.0.1:8080"
  let state = new State()
  let stop = new http::Stop()
  let options = new http::Options()

  options.stop = stop
  options.onListening = fn(address)
    unsafe
      state.client = http::netOpen()

      test::assertTrue(state.client >= 0)
      test::assertEqual(connectLocal(state.client, 8080), 0)
      test::assertEqual(http::netConfigure(state.client), 0)
    end

    test::assertTrue(http::writeText(state.client, "GET / HTTP/1.1\r\nHost: local\r\n\r\n"))
  end
  let handler: fn(http::Request): http::Response = fn(request)
    state.handled = true
    stop.request()
    return http::text(204, "")
  end
  let invalid = http::serveResult("水水水水:8080", handler)

  test::assertTrue(invalid != null)
  if invalid != null
    test::assertEqual(invalid.code, "invalid_address")
  end
  let result = http::serveResult(address, handler, options)

  test::assertTrue(result == null && state.handled)
  let response = http::readHead(state.client)

  test::assertTrue(response.failure == null)
  test::assertTrue(http::find(response.text, "HTTP/1.1 204 ", 0) == 0)
  unsafe
    http::netClose(state.client)
  end
  # Rebinding and stopping in onListening verifies release and idle shutdown.
  let idleStop = new http::Stop()
  let idleOptions = new http::Options()

  idleOptions.stop = idleStop
  idleOptions.onListening = fn(address)
    idleStop.request()
  end
  let idleHandler: fn(http::Request): http::Response = fn(request)
    test::assertTrue(false)
    return http::text(500, "unreachable")
  end
  let idle = http::serveResult(address, idleHandler, idleOptions)

  test::assertTrue(idle == null)
end
