use http
use host
use console

def main(): Void
  var payload = "x"

  while host::stringByteLength(payload) < 1048576
    payload = payload + payload
  end
  let large = payload
  var octets: Byte[] = []
  var index = 0

  while index < 1027
    octets = host::appendByte(octets, (index - (index / 256) * 256) as Byte)
    index = index + 1
  end
  let binaryPayload = octets
  let error = http::serve("127.0.0.1:8080") do |request|
    if request.path == "/binary"
      return http::binary(200, binaryPayload)
    end
    if request.path == "/headers"
      let values = request.headers.values("X-Tag")
      let response = http::text(200, values[0] + "/" + values[1])

      response.headers.add("Content-Type", "text/html; charset=utf-8")
      response.headers.add("ETag", "\"asset-v1\"")
      response.headers.add("Set-Cookie", "a=1")
      response.headers.add("set-cookie", "b=2")
      return response
    end
    if request.path == "/framing"
      let response = http::text(200, "hidden")

      response.headers.add("cOnTeNt-LeNgTh", "0")
      return response
    end
    if request.path == "/duplicate"
      let response = http::text(200, "hidden")

      response.headers.add("ETag", "\"a\"")
      response.headers.add("etag", "\"b\"")
      return response
    end
    if request.path == "/large"
      return http::text(200, large)
    end
    if request.path == "/invalid"
      return http::text(99, "invalid")
    end
    if request.path == "/empty"
      return http::text(204, "discarded")
    end
    if request.path == "/reset"
      return http::text(205, "discarded")
    end
    if request.path == "/cached"
      return http::text(304, "discarded")
    end
    if request.path == "/missing"
      return http::text(404, "Missing")
    end
    if request.path == "/fds"
      unsafe
        let descriptor = http::netOpen()

        http::netClose(descriptor)
        return http::text(200, descriptor as String)
      end
    end
    if request.path == "/a%2Fb"
      return http::text(200, request.method + " " + request.path + "?" + request.query)
    end
    return http::text(200, "Hello, world!")
  end

  console::println(error)
  host::exit(1)
end
