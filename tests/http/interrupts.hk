use http
use host
use test

@cabi("getpid")
def unsafe processId(): Int32
end

def main(): Void
  var pid = 0
  unsafe
    pid = processId() as Int
  end
  let process = pid as String
  for signalName in ["-INT", "-TERM"]
    let options = new http.Options()
    options.handleInterrupts = true
    options.onListening = fn(address)
      let code = host.run("/bin/kill", [signalName, process])
      test.assertTrue(code != null && code == 0)
    end
    let handler: fn(http.Request): http.Response = fn(request)
      test.assertTrue(false)
      return http.text(500, "unreachable")
    end
    test.assertTrue(http.serveResult("127.0.0.1:8080", handler, options) == null)
  end
  # A stale lease cannot release a later owner, and nested acquisition fails.
  unsafe
    let first = http.interruptOpen()
    test.assertTrue(first > 0)
    test.assertEqual(http.interruptOpen(), 0)
    http.interruptClose(first)
    let second = http.interruptOpen()
    test.assertTrue(second > first)
    http.interruptClose(first)
    test.assertEqual(http.interruptOpen(), 0)
    http.interruptClose(second)
  end
end
