use test

def incrementThroughPointer(value: Int): Int
  var result = value
  unsafe
    let pointer = &result
    *pointer = *pointer + 1
  end
  return result
end

def main(): Void
  test.assertEqual(incrementThroughPointer(41), 42)

  let values = [1, 2, 3]
  unsafe
    let stack = stackalloc Int[2]
    stack[0] = 10
    stack[1] = 20
    test.assertEqual(*(stack + 1), 20)

    var memory = native.allocZeroed<Byte>(2)
    memory[1] = 65 as Byte
    memory = native.realloc(memory, 4)
    test.assertEqual(memory[1] as Int, 65)
    native.free(memory)

    borrow values as pointer
      pointer[2] = 7
    end
  end

  test.assertEqual(values[2], 7)
end
