use test

@cabiImport("pipe")
unsafe def inputPipe(descriptors: Int32*): Int32
end

@cabiImport("dup")
unsafe def inputDuplicate(fd: Int32): Int32
end

@cabiImport("dup2")
unsafe def inputReplace(source: Int32, target: Int32): Int32
end

@cabiImport("close")
unsafe def inputClose(fd: Int32): Int32
end

@cabiImport("write")
unsafe def inputWrite(fd: Int32, bytes: Byte*, length: Int): Int
end

def main(): Void
  let descriptors = [0 as Int32, 0 as Int32]
  let bytes = [97 as Byte, 98 as Byte]
  let input = new LspInput()

  unsafe
    borrow descriptors as pointer
      test::assertEqual(inputPipe(pointer), 0 as Int32)
    end
    let reader = descriptors[0]
    let writer = descriptors[1]
    let saved = inputDuplicate(0 as Int32)

    test::assertTrue(saved >= (0 as Int32))
    test::assertEqual(inputReplace(reader, 0 as Int32), 0 as Int32)
    test::assertEqual(lspWaitReadable(-1, 0), -1)
    test::assertEqual(lspWaitReadable(0, -1), -1)
    test::assertTrue(!input.waitReadable(0))
    borrow bytes as pointer
      test::assertEqual(inputWrite(writer, pointer, bytes.Length), 2)
    end

    test::assertTrue(input.waitReadable(0))
    test::assertEqual(input.readByte(), 97)
    test::assertTrue(input.waitReadable(0))
    test::assertEqual(input.readByte(), 98)
    test::assertTrue(!input.waitReadable(1))
    inputClose(writer)

    test::assertTrue(input.waitReadable(0))
    test::assertEqual(input.readByte(), -1)
    inputReplace(saved, 0 as Int32)
    inputClose(saved)
    inputClose(reader)
  end
end
