    "extended-model-postgresql-consumer",
    "  let guid = Guid.parse(\"01234567-89AB-CDEF-0123-456789ABCDEF\")\n  let date = DateOnly.parse(\"2024-02-29\")\n  let time = TimeOnly.parse(\"23:59:59.1234567\")\n  let instant = DateTime.parse(\"2024-02-29T23:59:59.1234567Z\")\n\n  test::assertTrue(guid != null && date != null && time != null && instant != null)\n  test::assertTrue(DateOnly.parse(\"1900-02-29\") == null)\n  test::assertTrue(TimeOnly.parse(\"24:00:00\") == null)\n  test::assertTrue(Guid.parse(\"invalid\") == null)\n  if guid == null || date == null || time == null || instant == null\n    return\n  end\n  match decodeGuid(new RawRow([new RawColumn(\"value\", Cell.Text(\"01234567-89AB-CDEF-0123-456789ABCDEF\"))]), \"value\")\n    case DecodeResult.Failure(error)\n      test::assertTrue(true)\n    case DecodeResult.Value(value)\n      test::assertTrue(false)\n  end\n  match decodeTimeOnly(new RawRow([new RawColumn(\"value\", Cell.Text(\"12:00:00\"))]), \"value\")\n    case DecodeResult.Failure(error)\n      test::assertTrue(true)\n    case DecodeResult.Value(value)\n      test::assertTrue(false)\n  end\n  let row = new model::ExtendedRecord()\n\n  row.id = 1\n  row.guid = guid\n  row.date = date\n  row.time = time\n  row.instant = instant\n  row.strings = [\"quote\\\" and water 水\", \"\"]\n  row.ints = [-9223372036854775808, 9223372036854775807]\n  row.bools = [true, false]\n  row.status = model::Status.Inactive()\n  let payload = JsonDocument.parse(\"{\\\"answer\\\":42,\\\"values\\\":[true,false]}\")\n\n  test::assertTrue(payload != null)\n  if payload != null\n    row.payload = payload\n  end\n  model::setTenant(row, 42)\n  let offset = DateTimeOffset.parse(\"2024-03-01T00:59:59.1234567+01:00\")\n  let equivalent = DateTimeOffset.parse(\"2024-02-29T23:59:59.1234567Z\")\n\n  test::assertTrue(offset != null && equivalent != null)\n  if offset != null && equivalent != null\n    test::assertTrue(offset == equivalent)\n    row.offsetInstant = offset\n  end\n  row.duration = TimeSpan.fromTicks(-9223372036854775808)\n  let captured = capture_ExtendedRecord(row)\n\n  match decodeEntity_14_ExtendedRecord(captured)\n    case DecodeResult.Failure(error)\n      test::assertTrue(false)\n    case DecodeResult.Value(decoded)\n      test::assertEqual(decoded.guid.toText(), \"01234567-89ab-cdef-0123-456789abcdef\")\n      test::assertEqual(decoded.date.toText(), \"2024-02-29\")\n      test::assertEqual(decoded.time.toText(), \"23:59:59.1234567\")\n      test::assertEqual(decoded.strings[0], row.strings[0])\n      test::assertEqual(decoded.ints[1], row.ints[1])\n      test::assertFalse(decoded.bools[1])\n      test::assertTrue(decoded.address == null)\n      test::assertEqual(decoded.payload.toText(), row.payload.toText())\n      test::assertEqual(model::getTenant(decoded), 42)\n      test::assertEqual(decoded.offsetInstant.offsetMinutes(), 60)\n      test::assertEqual(decoded.offsetInstant.toText(), row.offsetInstant.toText())\n      test::assertEqual(decoded.duration.ticks(), -9223372036854775808)\n  end\n  let query = new Database().records.where(guid: guid).where(optionalGuid: null).matching(quote do |value: model::ExtendedRecord|: Bool\n    return value.guid == guid\n  end).matching(quote do |value: model::ExtendedRecord|: Bool\n    return value.date <= date\n  end)\n\n  match query.take(10).buildPlan(SqlDialect.QuestionMark())\n    case CompileResult.Failure(error)\n      test::assertTrue(false)\n    case CompileResult.Plan(plan)\n      test::assertEqual(plan.sql().parameters().count(), 3)\n  end\n  let conninfo = host::environment(\"NERI_POSTGRES_CONNINFO\")\n\n  if conninfo == null\n    return\n  end\n  match PostgreSQLProvider.open(conninfo)\n    case result::Result.Error(error)\n      test::assertTrue(false)\n    case result::Result.Ok(provider)\n      for statement in [\"CREATE TEMP TABLE extended_records(id BIGINT PRIMARY KEY,guid TEXT NOT NULL,date TEXT NOT NULL,time TEXT NOT NULL,instant TEXT NOT NULL,strings TEXT NOT NULL,ints TEXT NOT NULL,bools TEXT NOT NULL,status BIGINT NOT NULL,address_city TEXT,address_line TEXT,payload TEXT NOT NULL,tenant BIGINT NOT NULL,offset_instant TEXT NOT NULL,duration BIGINT NOT NULL,optional_guid TEXT,billing_city TEXT,billing_line TEXT,details_json TEXT)\", \"CREATE TEMP TABLE animals(id BIGINT PRIMARY KEY,label TEXT NOT NULL,barks BOOLEAN,curls BIGINT,kind TEXT NOT NULL)\", \"INSERT INTO animals VALUES(1,'poodle',TRUE,7,'poodle')\", \"CREATE TEMP TABLE authors(id BIGINT PRIMARY KEY)\", \"CREATE TEMP TABLE books(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,author_id BIGINT REFERENCES authors(id))\", \"CREATE TEMP VIEW summaries AS SELECT id AS author_id FROM authors UNION ALL SELECT id AS author_id FROM authors\", \"CREATE TEMP TABLE implicit_lefts(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY)\", \"CREATE TEMP TABLE implicit_rights(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY)\", \"CREATE TEMP TABLE implicit_links(left_0 BIGINT NOT NULL REFERENCES implicit_lefts(id),right_0 BIGINT NOT NULL REFERENCES implicit_rights(id),PRIMARY KEY(left_0,right_0))\", \"CREATE TEMP TABLE owned_owners(id BIGINT PRIMARY KEY)\", \"CREATE TEMP TABLE owned_children(owner_id BIGINT NOT NULL REFERENCES owned_owners(id) ON DELETE CASCADE,local_id BIGINT NOT NULL,label TEXT NOT NULL,PRIMARY KEY(owner_id,local_id))\", \"CREATE TEMP TABLE offset_owners(id TEXT PRIMARY KEY)\", \"CREATE TEMP TABLE offset_children(id BIGINT PRIMARY KEY,owner_id TEXT NOT NULL REFERENCES offset_owners(id))\", \"CREATE TEMP TABLE directed_nodes(id BIGINT PRIMARY KEY)\", \"CREATE TEMP TABLE directed_links(left_0 BIGINT NOT NULL REFERENCES directed_nodes(id),right_0 BIGINT NOT NULL REFERENCES directed_nodes(id),PRIMARY KEY(left_0,right_0))\", \"CREATE TEMP TABLE mapped_write_table(id BIGINT PRIMARY KEY,label TEXT NOT NULL)\", \"CREATE TEMP VIEW mapped_write_view AS SELECT id,label FROM mapped_write_table WHERE label <> 'hidden'\"]\n        match provider.executeSet(new SetWritePlan(statement, new WriteValues()))\n          case WriteResult.Failure(error)\n            console::println(writeFailureMessage(error))\n\n            test::assertTrue(false)\n          case WriteResult.Saved(count)\n          case WriteResult.SavedWithValues(count, values)\n        end\n      end\n      let database = new Database(provider)\n\n      test::assertTrue(database.records.add(row) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          console::println(writeFailureMessage(error))\n\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n      row.strings[0] = \"mutated collection\"\n      row.status = model::Status.Active()\n      let address = new model::Address()\n\n      address.city = \"Paris\"\n      row.address = address\n      model::setTenant(row, 99)\n\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n      let fresh = new Database(provider)\n\n      match fresh.records.where(guid: guid).where(optionalGuid: null).whereMappedCell(\"tenant\", Cell.Int(99)).matching(quote do |value: model::ExtendedRecord|: Bool\n        return value.guid == guid\n      end).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n\n          test::assertTrue(stored != null)\n          if stored != null\n            test::assertEqual(stored.value.strings[0], \"mutated collection\")\n            test::assertEqual(stored.value.date.toText(), date.toText())\n            test::assertEqual(model::getTenant(stored.value), 99)\n            let address = stored.value.address\n\n            test::assertTrue(address != null)\n            if address != null\n              test::assertEqual(address.city, \"Paris\")\n            end\n            match stored.value.status\n              case model::Status.Active()\n                test::assertTrue(true)\n              case model::Status.Inactive()\n                test::assertTrue(false)\n            end\n          end\n      end\n\n      let originalAddress = row.address\n\n      test::assertTrue(originalAddress != null)\n      if originalAddress != null\n        row.billing = originalAddress\n        match database.saveChanges()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        let billing = new model::Address()\n        let details = new model::Profile()\n        let nested = new model::Address()\n\n        billing.city = \"Rome\"\n        details.city = \"東京\"\n        details.count = 7\n        details.guid = guid\n        details.tags = [\"one\", \"é\"]\n        nested.city = \"Nested\"\n        details.nested = nested\n        row.billing = billing\n        row.details = details\n        match database.saveChanges()\n          case WriteResult.Failure(error)\n            console::println(writeFailureMessage(error))\n\n            test::assertTrue(false)\n          case WriteResult.Saved(count)\n            test::assertEqual(count, 1)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertEqual(count, 1)\n        end\n        let jsonRead = new Database(provider)\n\n        match jsonRead.records.where(id: 1).all()\n          case QueryResult.Failure(error)\n            test::assertTrue(false)\n          case QueryResult.Rows(rows)\n            let stored = rows.first()\n\n            test::assertTrue(stored != null)\n            if stored != null\n              let details = stored.value.details\n\n              test::assertTrue(details != null)\n              if details != null\n                test::assertEqual(details.city, \"東京\")\n                test::assertEqual(details.tags[1], \"é\")\n                test::assertTrue(details.guid == guid)\n                details.count = 8\n                match jsonRead.saveChanges()\n                  case WriteResult.Failure(error)\n                    test::assertTrue(false)\n                  case WriteResult.Saved(count)\n                    test::assertEqual(count, 1)\n                  case WriteResult.SavedWithValues(count, values)\n                    test::assertEqual(count, 1)\n                end\n              end\n            end\n        end\n      end\n\n      let optionalRead = new Database(provider)\n      \n      match optionalRead.records.where(id: 1).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n      \n          test::assertTrue(stored != null)\n          if stored != null\n            stored.value.address = null\n            match optionalRead.saveChanges()\n              case WriteResult.Failure(error)\n                console::println(writeFailureMessage(error))\n      \n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n      match new Database(provider).records.where(id: 1).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n\n          test::assertTrue(stored != null)\n          if stored != null\n            test::assertTrue(stored.value.address == null)\n          end\n      end\n\n      match fresh.ofType_Dog().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n      match fresh.ofType_Poodle().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let poodle = rows.first()\n\n          test::assertTrue(poodle != null)\n          if poodle != null\n            poodle.value.curls = 9\n            match fresh.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n\n      let left = new model::ImplicitLeft()\n      let right = new model::ImplicitRight()\n\n      test::assertTrue(database.link_hidden(left, right) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          console::println(writeFailureMessage(error))\n\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 3)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 3)\n      end\n      let skips = new Database(provider)\n\n      match skips.implicitLefts.include(skips.navigation.implicitLefts.rights).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n\n          test::assertTrue(stored != null)\n          if stored != null\n            test::assertEqual(stored.value.rights.Length, 1)\n            let right = stored.value.rights[0]\n\n            test::assertEqual(right.lefts.Length, 1)\n            stored.value.rights = []\n            match skips.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n\n      let author = new model::Author()\n\n      author.id = 100\n\n      test::assertTrue(database.authors.add(author) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n      let book = new model::Book()\n\n      author.books = [book]\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          console::println(writeFailureMessage(error))\n\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n\n      test::assertTrue(book.authorId == 100)\n      test::assertTrue(book.id > 0)\n      let fixup = new Database(provider)\n\n      match fixup.authors.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(authors)\n          match fixup.books.all()\n            case QueryResult.Failure(error)\n              test::assertTrue(false)\n            case QueryResult.Rows(books)\n              let parent = authors.first()\n              let child = books.first()\n\n              test::assertTrue(parent != null && child != null)\n              if parent != null && child != null\n                test::assertEqual(parent.value.books.Length, 1)\n                let authorReference = child.value.author\n\n                test::assertTrue(authorReference != null)\n                if authorReference != null\n                  test::assertTrue(reference::same(authorReference, parent.value))\n                end\n              end\n          end\n      end\n      match fixup.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 0)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 0)\n      end\n      let relations = new Database(provider)\n\n      match relations.authors.include(relations.navigation.authors.books).thenInclude(relations.navigation.books.author).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let loaded = rows.first()\n\n          test::assertTrue(loaded != null)\n          if loaded != null\n            test::assertEqual(loaded.value.books.Length, 1)\n            loaded.value.books[0].author = null\n            loaded.value.books = []\n            match relations.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n      match relations.includeReference_summariesFor_Author_by_authorId(relations.summaries).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 2)\n          let first = rows.first()\n\n          test::assertTrue(first != null)\n          if first != null\n            test::assertTrue(first.value.author != null)\n          end\n      end\n\n      let converted = convertedField(quote do |record: model::ExtendedRecord|: model::Status\n        return record.status\n      end, model::encodeStatus, \"model.encodeStatus\")\n\n      match fresh.records.matchingComputed(converted.equalTo(model::Status.Active())).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n      let detailsColumn = jsonField(quote do |record: model::ExtendedRecord|: model::Profile?\n        return record.details\n      end)\n\n      match fresh.records.where(id: 1).selectShape(detailsColumn.property(\"city\").textShape()).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let city = rows.first()\n\n          test::assertTrue(city != null && city.value == \"東京\")\n      end\n      let readProfile: fn(Cell): DecodeResult<model::Profile?> = fn(cell: Cell): DecodeResult<model::Profile?> do\n        return decode_json_ExtendedRecord_details_json(new RawRow([new RawColumn(\"value\", cell)]), \"value\")\n      end\n      let profileCodec = new ScalarCodec<model::Profile?>(readProfile, ResultColumnKind.Text(), true, \"model.Profile?\")\n      let projectedProfiles = fresh.records.where(id: 1).select(profileCodec, quote do |record: model::ExtendedRecord|: model::Profile?\n        return record.details\n      end)\n\n      match projectedProfiles.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let first = rows.first()\n          let profile = first == null ? null : first.value\n\n          test::assertTrue(profile != null)\n          if profile != null\n            test::assertEqual(profile.city, \"東京\")\n            test::assertTrue(profile.guid == guid)\n          end\n      end\n      let owner = new model::OwnedOwner()\n      let otherOwner = new model::OwnedOwner()\n      let ownedChild = new model::OwnedChild()\n\n      owner.id = 501\n      otherOwner.id = 502\n      ownedChild.localId = 1\n      ownedChild.label = \"owned\"\n      owner.children = [ownedChild]\n\n      test::assertTrue(database.ownedOwners.add(owner) == null)\n      test::assertTrue(database.ownedOwners.add(otherOwner) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          console::println(writeFailureMessage(error))\n\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 3)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 3)\n      end\n      otherOwner.children = [ownedChild]\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n      otherOwner.children = []\n      let ownedRead = new Database(provider)\n\n      match ownedRead.ownedOwners.where(id: 501).include(ownedRead.navigation.ownedOwners.children).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let parent = rows.first()\n\n          test::assertTrue(parent != null)\n          if parent != null\n            let replacement = new model::OwnedChild()\n\n            replacement.localId = 2\n            replacement.label = \"replacement\"\n            parent.value.children = [replacement]\n            match ownedRead.saveChanges()\n              case WriteResult.Failure(error)\n                console::println(writeFailureMessage(error))\n\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 2)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 2)\n            end\n\n            test::assertEqual(replacement.ownerId, 501)\n            test::assertTrue(ownedRead.ownedOwners.remove(parent.value) == null)\n            match ownedRead.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 2)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 2)\n            end\n          end\n      end\n      let offsetKey = DateTimeOffset.parse(\"2026-10-11T08:00:00+02:00\")\n      let equalOffsetKey = DateTimeOffset.parse(\"2026-10-11T01:00:00-05:00\")\n\n      test::assertTrue(offsetKey != null && equalOffsetKey != null)\n      if offsetKey != null && equalOffsetKey != null\n        let principal = new model::OffsetOwner()\n        let child = new model::OffsetChild()\n\n        principal.id = offsetKey\n        child.id = 601\n        principal.children = [child]\n\n        test::assertTrue(database.offsetOwners.add(principal) == null)\n        match database.saveChanges()\n          case WriteResult.Failure(error)\n            console::println(writeFailureMessage(error))\n\n            test::assertTrue(false)\n          case WriteResult.Saved(count)\n            test::assertEqual(count, 2)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertEqual(count, 2)\n        end\n        let duplicate = new model::OffsetOwner()\n\n        duplicate.id = equalOffsetKey\n\n        test::assertTrue(database.offsetOwners.add(duplicate) != null)\n        let offsetRead = new Database(provider)\n\n        match offsetRead.offsetOwners.where(id: equalOffsetKey).include(offsetRead.navigation.offsetOwners.children).all()\n          case QueryResult.Failure(error)\n            test::assertTrue(false)\n          case QueryResult.Rows(rows)\n            let stored = rows.first()\n\n            test::assertTrue(stored != null)\n            if stored != null\n              test::assertEqual(stored.value.id.offsetMinutes(), 0)\n              test::assertTrue(stored.value.id == equalOffsetKey)\n              test::assertEqual(stored.value.children.Length, 1)\n              test::assertEqual(stored.value.children[0].ownerId.offsetMinutes(), 0)\n              let ownerReference = stored.value.children[0].owner\n\n              test::assertTrue(ownerReference != null)\n              if ownerReference != null\n                test::assertTrue(reference::same(ownerReference, stored.value))\n              end\n            end\n        end\n      end\n\n      let forward = new model::DirectedNode()\n      let inverse = new model::DirectedNode()\n\n      forward.id = 701\n      inverse.id = 702\n\n      test::assertTrue(database.link_directed(forward, inverse) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          console::println(writeFailureMessage(error))\n\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 3)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 3)\n      end\n      let directed = new Database(provider)\n\n      match directed.nodes.where(id: 701).include(directed.navigation.nodes.following).thenInclude(directed.navigation.nodes.followers).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n\n          test::assertTrue(stored != null)\n          if stored != null\n            test::assertEqual(stored.value.following.Length, 1)\n            test::assertEqual(stored.value.following[0].id, 702)\n            test::assertEqual(stored.value.following[0].followers.Length, 1)\n            stored.value.following = []\n            match directed.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n      let view = new model::ViewRecord()\n\n      view.id = 801\n      view.label = \"visible\"\n\n      test::assertTrue(database.viewRecords.add(view) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n      let viewRead = new Database(provider)\n\n      match viewRead.viewRecords.where(id: 801).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          let stored = rows.first()\n\n          test::assertTrue(stored != null)\n          if stored != null\n            stored.value.label = \"hidden\"\n            match viewRead.saveChanges()\n              case WriteResult.Failure(error)\n                test::assertTrue(false)\n              case WriteResult.Saved(count)\n                test::assertEqual(count, 1)\n              case WriteResult.SavedWithValues(count, values)\n                test::assertEqual(count, 1)\n            end\n          end\n      end\n      match new Database(provider).viewRecords.where(id: 801).all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 0)\n      end\n\n      let pendingOwner = new model::ExtendedRecord()\n      let movedOwner = new model::ExtendedRecord()\n      let claimed = new model::Address()\n\n      pendingOwner.id = 901\n      movedOwner.id = 902\n      claimed.city = \"enrollment\"\n      pendingOwner.address = claimed\n\n      test::assertTrue(database.records.add(pendingOwner) == null)\n      pendingOwner.address = null\n      movedOwner.address = claimed\n\n      test::assertTrue(database.records.add(movedOwner) != null)\n      test::assertTrue(database.records.remove(pendingOwner) == null)\n      test::assertTrue(database.records.add(movedOwner) == null)\n      match database.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(false)\n        case WriteResult.Saved(count)\n          test::assertEqual(count, 1)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertEqual(count, 1)\n      end\n      database.clear()\n\n      test::assertTrue(provider.closeFailure() == null)\n  end\n",
    "use neri_data\nuse reference\nuse host\nuse result\nuse neri_data_postgresql\n",
    postgresql: true
  )
