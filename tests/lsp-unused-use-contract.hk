use host
use test

def containsText(text: String, part: String): Bool
  var offset = 0
  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0
    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def bindDocument(source: String): LspDocument
  let tokens = (new BootstrapLexer(source)).lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
  binder.requireEntryPoint = false
  let model = binder.bind()

  test.assertEqual(model.diagnostics.count(), 0)
  let document = new LspDocument()
  document.uri = "untitled:unused-use"
  document.text = source
  document.version = 1
  document.syntax = parser.arena
  document.syntaxRoot = root
  document.semantic = model
  return document
end

def bindSource(source: String): SemanticModel
  let semantic = bindDocument(source).semantic

  test.assertTrue(semantic != null)
  if semantic != null
    return semantic
  end
  return new SemanticModel()
end

def bindSources(first: String, second: String): SemanticModel
  let boundary = (new IrSourceMap(first)).utf16Length()
  let tokens = (new BootstrapLexer(first + second)).lex()
  let parser = new BootstrapParser(tokens)
  parser.addSourceBoundary(0)
  parser.addSourceBoundary(boundary)
  let root = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))
  binder.requireEntryPoint = false
  binder.clearSources()
  binder.addSource("library", 0)
  binder.addSource("client", boundary)
  let model = binder.bind()

  test.assertEqual(model.diagnostics.count(), 0)
  return model
end

def main(): Void
  let unusedDocument = bindDocument("use console\n\ndef main(): Void\nend\n")
  let unused = unusedDocument.semantic

  test.assertTrue(unused != null)
  if unused == null
    return
  end
  test.assertTrue(unused.hasUse("console"))
  test.assertTrue(!unused.useReferenced("console"))
  let tagged = lspUnusedUseDiagnostics(unusedDocument, unused, -1, true)

  test.assertEqual(tagged, "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"severity\":4,\"code\":\"NR_UNUSED_USE\",\"source\":\"neri\",\"message\":\"Unused import: console.\",\"tags\":[1]}")
  let untagged = lspUnusedUseDiagnostics(unusedDocument, unused, -1, false)

  test.assertTrue(!containsText(untagged, "\"tags\""))
  test.assertTrue(containsText(untagged, "\"severity\":4"))

  let usedDocument = bindDocument("use console\n\ndef main(): Void\n  console.println(\"used\")\nend\n")
  let used = usedDocument.semantic

  test.assertTrue(used != null)
  if used == null
    return
  end
  test.assertTrue(used.useReferenced("console"))
  test.assertEqual(lspUnusedUseDiagnostics(usedDocument, used, -1, true), "")

  let generated = bindSource("use tasks\n\ndef main(): Void\n  let values: Int[] = tasks.generate(1, 1) do |index|\n    return index\n  end\nend\n")

  test.assertTrue(generated.useReferenced("tasks"))

  let genericBody = bindSource("use console\n\ndef unused<T>(value: T): Void\n  console.println(\"used by generic\")\nend\n")

  test.assertTrue(genericBody.useReferenced("console"))

  let genericString = bindSource("use console\n\ndef unused<T>(value: T): String\n  return \"console\"\nend\n")

  test.assertTrue(!genericString.useReferenced("console"))

  let genericImports = bindSources("namespace imported\n\nclass Item\nend\n\ndef make(): Item\n  return new Item()\nend\n", "use imported\n\ndef unused<T>(value: T): Item\n  return make()\nend\n")

  test.assertTrue(genericImports.useReferenced("imported"))

  let genericType = bindSources("namespace imported\n\nclass Box<T>\n  public value: T\nend\n", "use imported\n\ndef unused<T>(value: T): Box<T>?\n  return null\nend\n")

  test.assertTrue(genericType.useReferenced("imported"))

  let qualified = bindSources("namespace imported\n\ndef answer(): Int\n  return 1\nend\n", "use imported\n\ndef caller(): Int\n  return imported.answer()\nend\n")

  test.assertTrue(qualified.useReferenced("imported"))

end
