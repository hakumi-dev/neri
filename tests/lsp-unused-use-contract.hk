use host
use test

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    var equal = true
    var index = 0

    while index < host::stringByteLength(part)
      if host::stringByteAt(text, offset + index) != host::stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def bindDocument(source: String): LspDocument
  let document = new LspDocument()
  var analysisSource = source

  if !containsText(source, "def main(")
    analysisSource = source + "\ndef main(): Void\nend\n"
  end

  document.uri = "untitled:unused-use"
  document.text = analysisSource
  document.version = 1
  let server = new LspServer()

  server.documents = document
  server.analyze(document)

  test::assertTrue(document.semantic != null)
  let semantic = document.semantic

  if semantic != null
    test::assertEqual(semantic.diagnostics.count(), 0)
  end
  return document
end

def bindSource(source: String): SemanticModel
  let semantic = bindDocument(source).semantic

  test::assertTrue(semantic != null)
  if semantic != null
    return semantic
  end
  return new SemanticModel()
end

def bindSources(first: String, second: String): SemanticModel
  let boundary = (new IrSourceMap(first)).utf16Length()
  let tokens = (new BootstrapLexer(first + second)).lex()
  let parser = new BootstrapParser(tokens)

  parser.addSourceBoundary(0)
  parser.addSourceBoundary(boundary)
  let root = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

  binder.requireEntryPoint = false
  binder.clearSources()
  binder.addSource("library", 0)
  binder.addSource("client", boundary)
  let model = binder.bind()

  test::assertEqual(model.diagnostics.count(), 0)
  return model
end

def incrementalSemanticContext(): Void
  let baseSource = "class Base\n  public value: Int = 1\nend\n\ndef base(): Int\n  return 1\nend\n\ndef __neri_session_entry(): Void\nend\n"
  let baseTokens = (new BootstrapLexer(baseSource)).lex()
  let baseParser = new BootstrapParser(baseTokens)
  let baseRoot = baseParser.parseProgram()

  test::assertEqual(baseParser.diagnostics.count(), 0)
  let baseBinder = new BootstrapBinder(baseParser.arena, baseRoot, baseTokens.startAt(baseTokens.count() - 1))

  baseBinder.requireEntryPoint = false
  let base = baseBinder.bind()

  test::assertEqual(base.diagnostics.count(), 0)
  let baseBoundCount = base.bound.count()
  let childSource = "class Child: Base\nend\n\ndef child(): Int\n  return base()\nend\n\ndef __neri_session_entry(): Void\nend\n"
  let childTokens = (new BootstrapLexer(childSource)).lex()
  let childParser = new BootstrapParser(childTokens, baseParser.arena)
  let childRoot = childParser.parseProgram()

  test::assertEqual(childParser.diagnostics.count(), 0)
  let childBinder = new BootstrapBinder(childParser.arena, childRoot, childTokens.startAt(childTokens.count() - 1), base)

  childBinder.requireEntryPoint = false
  childBinder.allowSessionEntryReplacement = true
  let child = childBinder.bindChild()

  test::assertEqual(child.diagnostics.count(), 0)
  test::assertTrue(child.findClass("Base") != null)
  test::assertTrue(child.findFunction("base") != null)
  let childClass = child.findClass("Child")

  test::assertTrue(childClass != null)
  if childClass != null
    test::assertTrue(child.ownsClass(childClass))
  end
  let parentClass = child.findClass("Base")

  test::assertTrue(parentClass != null)
  if parentClass != null
    test::assertTrue(!child.ownsClass(parentClass))
  end

  test::assertTrue(base.findClass("Child") == null)
  test::assertTrue(child.bound.count() > baseBoundCount)
  let sessionEntry = child.findFunction("__neri_session_entry")

  test::assertTrue(sessionEntry != null)
  if sessionEntry != null
    test::assertTrue(child.ownsFunction(sessionEntry))
  end
  let rejectedSource = "def base(): Int\n  return 2\nend\n"
  let rejectedTokens = (new BootstrapLexer(rejectedSource)).lex()
  let rejectedParser = new BootstrapParser(rejectedTokens, childParser.arena)
  let rejectedRoot = rejectedParser.parseProgram()

  test::assertEqual(rejectedParser.diagnostics.count(), 0)
  let rejectedBinder = new BootstrapBinder(rejectedParser.arena, rejectedRoot, rejectedTokens.startAt(rejectedTokens.count() - 1), child)

  rejectedBinder.requireEntryPoint = false
  let rejected = rejectedBinder.bindChild()

  test::assertTrue(rejected.diagnostics.count() > 0)
  test::assertEqual(base.diagnostics.count(), 0)
  test::assertEqual(child.diagnostics.count(), 0)
end

def main(): Void
  incrementalSemanticContext()
  let unusedDocument = bindDocument("use console\n\ndef main(): Void\nend\n")
  let unused = unusedDocument.semantic

  test::assertTrue(unused != null)
  if unused == null
    return
  end

  test::assertTrue(unused.hasUse("console"))
  test::assertTrue(!unused.useReferenced("console"))
  let tagged = lspUnusedUseDiagnostics(unusedDocument, unused, -1, true)

  test::assertEqual(tagged, "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":11}},\"severity\":4,\"code\":\"NR_UNUSED_USE\",\"source\":\"neri\",\"message\":\"Unused import: console.\",\"tags\":[1]}")
  let untagged = lspUnusedUseDiagnostics(unusedDocument, unused, -1, false)

  test::assertTrue(!containsText(untagged, "\"tags\""))
  test::assertTrue(containsText(untagged, "\"severity\":4"))

  let usedDocument = bindDocument("use console\n\ndef main(): Void\n  println(\"used\")\nend\n")
  let used = usedDocument.semantic

  test::assertTrue(used != null)
  if used == null
    return
  end

  test::assertTrue(used.useReferenced("console"))
  test::assertEqual(lspUnusedUseDiagnostics(usedDocument, used, -1, true), "")

  let generated = bindSource("use tasks\n\ndef main(): Void\n  let values: Int[] = generate(1, 1) do |index|\n    return index\n  end\nend\n")

  test::assertTrue(generated.useReferenced("tasks"))

  let genericBody = bindSource("use console\n\ndef unused<T>(value: T): Void\n  println(\"used by generic\")\nend\n")

  test::assertTrue(genericBody.useReferenced("console"))

  let genericString = bindSource("use console\n\ndef unused<T>(value: T): String\n  return \"console\"\nend\n")

  test::assertTrue(!genericString.useReferenced("console"))

  let genericImports = bindSources("namespace imported\n\nclass Item\nend\n\ndef make(): Item\n  return new Item()\nend\n", "use imported\n\ndef unused<T>(value: T): Item\n  return make()\nend\n")

  test::assertTrue(genericImports.useReferenced("imported"))

  let genericType = bindSources("namespace imported\n\nclass Box<T>\n  public value: T\nend\n", "use imported\n\ndef unused<T>(value: T): Box<T>?\n  return null\nend\n")

  test::assertTrue(genericType.useReferenced("imported"))

  let qualified = bindSources("namespace App::Nested\n\ndef answer(): Int\n  return 1\nend\n", "use App::Nested\n\ndef caller(): Int\n  return App::Nested::answer()\nend\n")

  test::assertTrue(!qualified.useReferenced("App.Nested"))
  let aliases = bindSources("namespace App::Nested\n\ndef answer(): Int\n  return 1\nend\n", "use IO = App::Nested\nuse Unused = App::Nested\n\ndef caller(): Int\n  return IO::answer()\nend\n")

  test::assertTrue(aliases.namespaceAliasReferenced("IO"))
  test::assertTrue(!aliases.namespaceAliasReferenced("Unused"))

end
