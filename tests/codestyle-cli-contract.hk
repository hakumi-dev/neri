use host
use process
use test

def styleWrite(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def styleDirectory(path: String): Void
  let status = host.run("mkdir", ["-p", path])

  test.assertTrue(status != null && status == 0)
end

def styleInvoke(compiler: String, arguments: String[]): process.PollResult
  let options = new process.SpawnOptions(compiler)

  options.arguments = arguments
  let started = process.spawn(options)

  test.assertTrue(started.failure() == null)
  let child = started.child()

  test.assertTrue(child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(30000)

  test.assertTrue(completed.failure == null && !completed.running)
  test.assertTrue(child.dispose())
  return completed
end

def styleExit(result: process.PollResult, expected: Int): Void
  let status = result.exit

  test.assertTrue(status != null)
  if status != null
    test.assertTrue(status.isExited())
    test.assertEqual(status.value(), expected)
  end
end

def styleOutput(result: process.PollResult): String
  let text = host.stringFromBytes(result.stdout)

  test.assertTrue(text != null)
  if text != null
    return text
  end
  return ""
end

def styleContains(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def styleText(path: String): String
  let text = host.readText(path)

  test.assertTrue(text != null)
  if text != null
    return text
  end
  return ""
end

def main(): Void
  let compiler = host.argumentAt(1)
  let work = host.argumentAt(2)

  test.assertTrue(compiler != null && work != null)
  if compiler == null || work == null
    return
  end
  let explicit = work + "/codestyle-cli-explicit"

  styleDirectory(explicit)
  let first = explicit + "/first.hk"
  let invalid = explicit + "/invalid.hk"
  let original = "def first(): Void\n  let value = 1\n  assert(value == 1)\nend\n"

  styleWrite(first, original)
  styleWrite(invalid, "def invalid(: Void\n")

  styleExit(styleInvoke(compiler, ["format", first, invalid]), 2)

  test.assertEqual(styleText(first), original)
  let check = styleInvoke(compiler, ["format", "--check", first])

  styleExit(check, 1)

  test.assertEqual(styleText(first), original)
  test.assertTrue(styleContains(styleOutput(check), first))
  styleExit(styleInvoke(compiler, ["lint", first]), 1)
  var formattedPath = first
  let operatingSystem = host.environment("OS")

  if operatingSystem == null || operatingSystem != "Windows_NT"
    let link = explicit + "/first-link.hk"
    let chmod = host.run("chmod", ["751", first])
    let linked = host.run("ln", ["-s", first, link])

    test.assertTrue(chmod != null && chmod == 0)
    test.assertTrue(linked != null && linked == 0)
    formattedPath = link
  end

  styleExit(styleInvoke(compiler, ["lint", "--fix", formattedPath]), 0)

  test.assertTrue(styleText(first) != original)
  if operatingSystem == null || operatingSystem != "Windows_NT"
    let executable = host.run("/bin/test", ["-x", first])

    test.assertTrue(executable != null && executable == 0)
  end

  styleExit(styleInvoke(compiler, ["format", "--check", first]), 0)

  let project = work + "/codestyle-cli-project"
  let dependency = project + "/dependency"

  styleDirectory(dependency)
  styleWrite(project + "/main.hk", original)
  styleWrite(project + "/worker.hk", original)
  styleWrite(dependency + "/library.hk", original)
  styleWrite(dependency + "/manifest.json", "{\"version\":2,\"units\":{\"library\":{\"kind\":\"library\",\"sources\":[\"library.hk\"],\"references\":[]}}}\n")
  styleWrite(project + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"],\"references\":[{\"project\":\"dependency/manifest.json\",\"unit\":\"library\"}]},\"worker\":{\"kind\":\"library\",\"sources\":[\"worker.hk\"],\"references\":[]}}}\n")

  styleExit(styleInvoke(compiler, ["format", "--project", project, "--unit", "app"]), 0)

  test.assertTrue(styleText(project + "/main.hk") != original)
  test.assertEqual(styleText(project + "/worker.hk"), original)
  test.assertEqual(styleText(dependency + "/library.hk"), original)
  styleExit(styleInvoke(compiler, ["format", "--project", project]), 0)

  test.assertTrue(styleText(project + "/worker.hk") != original)
  test.assertEqual(styleText(dependency + "/library.hk"), original)
end
