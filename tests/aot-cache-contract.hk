use host
use process
use test

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def countText(text: String, part: String): Int
  var count = 0
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      count = count + 1
      offset = offset + host.stringByteLength(part)
    else
      offset = offset + 1
    end
  end
  return count
end

def write(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def directory(path: String): Void
  let status = host.run("mkdir", ["-p", path])

  test.assertTrue(status != null && status == 0)
end

def invoke(executable: String, arguments: String[], cache: String = "", codegen: String = "", manifest: String = ""): process.PollResult
  let options = new process.SpawnOptions(executable)

  options.arguments = arguments
  if codegen != "" && manifest != ""
    options.environment = [new process.EnvironmentEntry("NERI_CACHE_DIR", cache),
      new process.EnvironmentEntry("NERI_CODEGEN", codegen),
      new process.EnvironmentEntry("NERI_RUNTIME_MANIFEST", manifest)]
  else if cache != ""
    options.environment = [new process.EnvironmentEntry("NERI_CACHE_DIR", cache)]
  end
  let started = process.spawn(options)

  test.assertTrue(started.failure() == null)
  let child = started.child()

  test.assertTrue(child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(60000)

  test.assertTrue(completed.failure == null && !completed.running)
  test.assertTrue(child.dispose())
  return completed
end

def text(bytes: Byte[]): String
  let decoded = host.stringFromBytes(bytes)

  test.assertTrue(decoded != null)
  if decoded != null
    return decoded
  end
  return ""
end

def exited(result: process.PollResult, expected: Int): Void
  let status = result.exit

  test.assertTrue(status != null)
  if status != null
    test.assertTrue(status.isExited())
    test.assertEqual(status.value(), expected)
  end
end

def build(compiler: String, manifest: String, target: readonly TargetPlatform, output: String, cache: String, noCache: Bool = false, codegen: String = "", runtimeManifest: String = ""): process.PollResult
  var arguments = ["build", "--project", manifest, "--unit", "app", "--target", target.name(),
    "--release", "--timings", "--output", output]

  if noCache
    arguments = host.appendString(arguments, "--no-cache")
  end
  return invoke(compiler, arguments, cache, codegen, runtimeManifest)
end

def pathDirectory(path: String): String
  var index = host.stringByteLength(path) - 1

  while index >= 0 && host.stringByteAt(path, index) != (47 as Byte) && host.stringByteAt(path, index) != (92 as Byte)
    index = index - 1
  end
  return index < 0 ? "." : host.stringSlice(path, 0, index)
end

def incompatibleAbiManifest(text: String): String?
  let name = "\"abiMinor\""
  var offset = 0

  while offset + host.stringByteLength(name) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(name)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(name, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      var valueStart = offset + host.stringByteLength(name)

      while valueStart < host.stringByteLength(text) && (host.stringByteAt(text, valueStart) == (32 as Byte) || host.stringByteAt(text, valueStart) == (58 as Byte))
        valueStart = valueStart + 1
      end
      var valueEnd = valueStart

      while valueEnd < host.stringByteLength(text) && (host.stringByteAt(text, valueEnd) as Int) >= 48 && (host.stringByteAt(text, valueEnd) as Int) <= 57
        valueEnd = valueEnd + 1
      end
      if valueEnd > valueStart
        return host.stringSlice(text, 0, valueStart) + "0" + host.stringSlice(text, valueEnd, host.stringByteLength(text) - valueEnd)
      end
      return null
    end
    offset = offset + 1
  end
  return null
end

def copyFile(source: String, destination: String): Void
  let status = host.run("cp", [source, destination])

  test.assertTrue(status != null && status == 0)
end

def assertCacheMisses(result: process.PollResult, expected: Int): Void
  let timings = text(result.stderr)

  exited(result, 0)

  test.assertEqual(countText(timings, "neri timing object-cache-miss "), expected)
  test.assertEqual(countText(timings, "neri timing object-cache-hit "), 0)
end

def run(path: String, target: readonly TargetPlatform): String
  let executable = target.isWindows() ? path + ".exe" : path
  let result = invoke(executable, [])

  exited(result, 0)
  return text(result.stdout)
end

def librarySource(step: Int): String
  return "namespace stable\n\nclass Counter\n  public value: Int\n\n  def init(value: Int): Void\n    this.value = value\n  end\n\n  def bump(): Int\n    this.value = this.value + " + (step as String) + "\n    return this.value\n  end\nend\n\ndef internalArrayValue(): Int\n  let values = [2, 3]\n  return values[0] + values[1]\nend\n"
end

def genericSource(changed: Bool): String
  let identityBody = changed ? "  let copy = value\n  return copy\n" : "  return value\n"

  return "namespace stable\n\nclass Box<T>\n  public value: T\n\n  def init(value: T): Void\n    this.value = value\n  end\n\n  def item(): T\n    return this.value\n  end\nend\n\ndef identity<T>(value: T): T\n" + identityBody + "end\n"
end

def consumerSource(label: String): String
  return "use console\nuse stable\n\ndef main(): Void\n  let counter = new Counter(5)\n  let alias = counter\n  let box = new Box<Int>(identity(6))\n  alias.bump()\n  console.println(\"" + label + "\" + ((counter.value + box.item()) as String))\nend\n"
end

def main(): Void
  let compiler = host.argumentAt(0)
  let work = host.argumentAt(1)
  let targetName = host.argumentAt(2)

  test.assertTrue(compiler != null && work != null && targetName != null)
  if compiler == null || work == null || targetName == null
    return
  end
  let target = TargetPlatform.parse(targetName)

  test.assertTrue(target != null)
  if target == null
    return
  end
  let root = work + "/aot-cache-contract"
  let library = root + "/library"
  let consumer = root + "/consumer"
  let cache = root + "/cache"
  let program = root + "/program"
  let baseline = root + "/baseline"

  directory(library)
  directory(consumer)
  directory(cache)
  var protectedCache: Int? = 0

  protectedCache = host.run("chmod", ["700", cache]) if target.isMacOS()

  test.assertTrue(protectedCache != null && protectedCache == 0)
  write(library + "/library.hk", librarySource(1))
  write(library + "/generics.hk", genericSource(false))
  write(library + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"library\",\"units\":{\"library\":{\"kind\":\"library\",\"sources\":[\"library.hk\",\"generics.hk\"]}}}\n")
  write(consumer + "/main.hk", consumerSource("value="))
  write(consumer + "/manifest.json", "{\"version\":2,\"defaultUnit\":\"app\",\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"main.hk\"],\"references\":[{\"project\":\"../library/manifest.json\",\"unit\":\"library\"}]}}}\n")

  let uncached = build(compiler, consumer + "/manifest.json", target, baseline, cache, true)

  exited(uncached, 0)

  test.assertEqual(run(baseline, target), "value=12\n")

  let cold = build(compiler, consumer + "/manifest.json", target, program, cache)
  let coldTimings = text(cold.stderr)
  let unitCount = countText(coldTimings, "neri timing object-cache-miss ")

  exited(cold, 0)
  if target.isMacOS()
    test.assertTrue(unitCount >= 2)
    test.assertEqual(countText(coldTimings, "neri timing object-cache-hit "), 0)
  end

  test.assertEqual(run(program, target), "value=12\n")

  let warm = build(compiler, consumer + "/manifest.json", target, program, cache)
  let warmTimings = text(warm.stderr)

  exited(warm, 0)
  if target.isMacOS()
    test.assertEqual(countText(warmTimings, "neri timing object-cache-hit "), unitCount)
    test.assertEqual(countText(warmTimings, "neri timing object-cache-miss "), 0)
  end

  test.assertEqual(run(program, target), "value=12\n")

  write(consumer + "/main.hk", consumerSource("changed="))
  let consumerChanged = build(compiler, consumer + "/manifest.json", target, program, cache)
  let consumerTimings = text(consumerChanged.stderr)

  exited(consumerChanged, 0)
  if target.isMacOS()
    test.assertEqual(countText(consumerTimings, "neri timing object-cache-hit "), unitCount - 1)
    test.assertEqual(countText(consumerTimings, "neri timing object-cache-miss "), 1)
  end

  test.assertEqual(run(program, target), "changed=12\n")

  write(library + "/library.hk", librarySource(2))
  let libraryChanged = build(compiler, consumer + "/manifest.json", target, program, cache)
  let libraryTimings = text(libraryChanged.stderr)

  exited(libraryChanged, 0)
  if target.isMacOS()
    test.assertEqual(countText(libraryTimings, "neri timing object-cache-hit "), unitCount - 1)
    test.assertEqual(countText(libraryTimings, "neri timing object-cache-miss "), 1)
  end

  test.assertEqual(run(program, target), "changed=13\n")

  write(library + "/generics.hk", genericSource(true))
  let genericChanged = build(compiler, consumer + "/manifest.json", target, program, cache)
  let genericTimings = text(genericChanged.stderr)

  exited(genericChanged, 0)
  if target.isMacOS()
    test.assertEqual(countText(genericTimings, "neri timing object-cache-hit "), unitCount - 1)
    test.assertEqual(countText(genericTimings, "neri timing object-cache-miss "), 1)
  end

  test.assertEqual(run(program, target), "changed=13\n")

  if target.isMacOS()
    let configuredCodegen = host.environment("NERI_CODEGEN")
    let configuredManifest = host.environment("NERI_RUNTIME_MANIFEST")

    test.assertTrue(configuredCodegen != null && configuredManifest != null)
    if configuredCodegen != null && configuredManifest != null
      let toolchain = root + "/toolchain"
      let copiedCodegen = toolchain + "/neri-codegen"
      let copiedManifest = toolchain + "/neri-runtime.json"
      let copiedRuntime = toolchain + "/libneri-runtime.a"
      let originalManifest = host.readText(configuredManifest)

      directory(toolchain)
      copyFile(configuredCodegen, copiedCodegen)
      copyFile(configuredManifest, copiedManifest)
      copyFile(pathDirectory(configuredManifest) + "/libneri-runtime.a", copiedRuntime)

      test.assertTrue(originalManifest != null)
      if originalManifest != null
        let copiedCold = build(compiler, consumer + "/manifest.json", target, program, cache,
          false, copiedCodegen, copiedManifest)

        assertCacheMisses(copiedCold, unitCount)
        let copiedWarm = build(compiler, consumer + "/manifest.json", target, program, cache,
          false, copiedCodegen, copiedManifest)
        let copiedWarmTimings = text(copiedWarm.stderr)

        exited(copiedWarm, 0)

        test.assertEqual(countText(copiedWarmTimings, "neri timing object-cache-hit "), unitCount)
        test.assertEqual(countText(copiedWarmTimings, "neri timing object-cache-miss "), 0)
        let consumerManifest = host.readText(consumer + "/manifest.json")

        test.assertTrue(consumerManifest != null)
        if consumerManifest != null
          write(consumer + "/manifest.json", consumerManifest + "\n")
          assertCacheMisses(build(compiler, consumer + "/manifest.json", target, program, cache,
              false, copiedCodegen, copiedManifest), unitCount)
        end
        let touched = host.run("touch", [copiedCodegen])

        test.assertTrue(touched != null && touched == 0)
        assertCacheMisses(build(compiler, consumer + "/manifest.json", target, program, cache,
            false, copiedCodegen, copiedManifest), unitCount)
        write(copiedManifest, originalManifest + "\n")
        assertCacheMisses(build(compiler, consumer + "/manifest.json", target, program, cache,
            false, copiedCodegen, copiedManifest), unitCount)

        test.assertEqual(run(program, target), "changed=13\n")
        let incompatibleManifest = incompatibleAbiManifest(originalManifest)

        test.assertTrue(incompatibleManifest != null)
        if incompatibleManifest != null
          write(copiedManifest, incompatibleManifest)
          let incompatible = build(compiler, consumer + "/manifest.json", target, program, cache,
            false, copiedCodegen, copiedManifest)

          exited(incompatible, 2)

          test.assertTrue(containsText(text(incompatible.stdout), "runtime manifest does not provide the required ABI minor version"))
        end
      end
    end
  end

  write(consumer + "/main.hk", "use stable\n\ndef main(): Void\n  let counter: Counter = \"invalid\"\nend\n")
  let invalid = build(compiler, consumer + "/manifest.json", target, program, cache)

  exited(invalid, 1)

  test.assertTrue(containsText(text(invalid.stdout), "String") && containsText(text(invalid.stdout), "Counter"))
end
