def packageDocumentsContracts(root: String): Void
  let publicDocuments = ["TEXT.md"]
  let missing = packageDocumentationLinkError("TEXT.md", "Read [the missing page](MISSING.md).", publicDocuments)

  test::assertEqual(missing, "package documentation link is not packaged: TEXT.md -> MISSING.md")
  test::assertEqual(packageDocumentationLinkError("TEXT.md", "Read [the packaged page](MISSING.md).", host::appendString(publicDocuments, "MISSING.md")), "")
  let selected = packagedDocumentsVerified(root)
  var textIncluded = false

  for document in selected
    textIncluded = true if document == "TEXT.md"
  end

  test::assertTrue(textIncluded)
end
