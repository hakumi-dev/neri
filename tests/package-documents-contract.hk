def packageDocumentsContracts(root: String): Void
  let selectedTest = new ToolingTestCase("arbitrary-unit\t1501\t7b70726f6a6563747d\t7b636f6d70696c65727d\t7b776f726b7d\t\te6b0b4090a\t787b70726f6a6563747d")
  let arguments = selectedTest.resolveArguments("project", "compiler", "work")

  test::assertEqual(selectedTest.name, "arbitrary-unit")
  test::assertEqual(selectedTest.timeoutMs, 1501)
  test::assertEqual(arguments.Length, 6)
  test::assertEqual(arguments[0], "project")
  test::assertEqual(arguments[1], "compiler")
  test::assertEqual(arguments[2], "work")
  test::assertEqual(arguments[3], "")
  test::assertEqual(arguments[4], "水\t\n")
  test::assertEqual(arguments[5], "x{project}")
  test::assertEqual((new ToolingTestCase("without-arguments\t1000")).arguments.Length, 0)
  test::assertEqual((new ToolingTestCase("empty-argument\t1000\t")).arguments.Length, 1)
  let publicDocuments = ["TEXT.md"]
  let missing = packageDocumentationLinkError("TEXT.md", "Read [the missing page](MISSING.md).", publicDocuments)

  test::assertEqual(missing, "package documentation link is not packaged: TEXT.md -> MISSING.md")
  test::assertEqual(packageDocumentationLinkError("TEXT.md", "Read [the packaged page](MISSING.md).", host::appendString(publicDocuments, "MISSING.md")), "")
  let selected = packagedDocumentsVerified(root)
  var textIncluded = false

  for document in selected
    textIncluded = true if document == "TEXT.md"
  end

  test::assertTrue(textIncluded)
end
