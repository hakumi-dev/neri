use host
use files
use test
use console

def assertSemanticTiming(result: process::PollResult, expected: String): Void
  let observed = errors(result)

  if !containsText(observed, expected)
    console::println("Expected " + expected + "; observed stderr: " + observed + "; stdout: " + output(result))
  end

  test::assertTrue(containsText(observed, expected))
end

def assertNoSemanticTiming(result: process::PollResult): Void
  let observed = errors(result)
  let clean = !containsText(observed, "dependency-semantic-hit") && !containsText(observed, "dependency-semantic-miss")

  if !clean
    console::println("Expected no semantic cache lookup; observed stderr: " + observed)
  end

  test::assertTrue(clean)
end

def batchBuildContracts(compiler: String, work: String, target: String): Void
  let project = work + "/batch"
  let cache = project + "/cache"

  directory(project + "/out")
  directory(cache)
  write(project + "/a_library.hk", "def echo<T>(value: T): T\n  return value\nend\n")
  write(project + "/z_first.hk", "use console\ndef main(): Void\n  console::println(echo<Int>(42) as String)\nend\n")
  write(project + "/z_second.hk", "use console\ndef main(): Void\n  console::println(echo<String>(\"batch\"))\nend\n")
  write(project + "/manifest.json", "{\"version\":2,\"units\":{\"common\":{\"kind\":\"library\",\"sources\":[\"a_library.hk\"]},\"first\":{\"kind\":\"executable\",\"sources\":[\"z_first.hk\"],\"references\":[\"common\"]},\"second\":{\"kind\":\"executable\",\"sources\":[\"z_second.hk\"],\"references\":[\"common\"]}}}\n")
  let built = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first", "--unit", "second"], cache)

  exited(built, 0)

  test::assertTrue(containsText(output(built), "analyzed=1 reused=1 fallback=0"))
  let first = invoke(project + "/out/first", [])
  let second = invoke(project + "/out/second", [])

  exited(first, 0)
  exited(second, 0)

  test::assertEqual(output(first), "42\n")
  test::assertEqual(output(second), "batch\n")

  write(project + "/a_library.hk", "def libraryValue(): Int\n  return pick()\nend\nnamespace alpha\ndef pick(): Int\n  return 1\nend\nnamespace beta\ndef pick(): Int\n  return 2\nend\n")
  write(project + "/z_first.hk", "use console\nuse alpha\ndef main(): Void\n  console::println(libraryValue() as String)\nend\n")
  write(project + "/z_second.hk", "use console\nuse beta\ndef main(): Void\n  console::println(libraryValue() as String)\nend\n")
  let scopes = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first", "--unit", "second"])

  exited(scopes, 0)
  let alpha = invoke(project + "/out/first", [])
  let beta = invoke(project + "/out/second", [])

  exited(alpha, 0)
  exited(beta, 0)

  test::assertEqual(output(alpha), "1\n")
  test::assertEqual(output(beta), "2\n")

  write(project + "/a_library.hk", "def libraryValue(): Int\n  return extension()\nend\n")
  write(project + "/z_first.hk", "use console\ndef extension(): Int\n  return 17\nend\ndef main(): Void\n  console::println(libraryValue() as String)\nend\n")
  let fallback = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first"])

  exited(fallback, 0)

  test::assertTrue(containsText(output(fallback), "fallback=1"))
  let extended = invoke(project + "/out/first", [])

  exited(extended, 0)

  test::assertEqual(output(extended), "17\n")
  let rejected = invoke(compiler, ["build-batch", "--project", project, "--output-dir", project + "/out", "--unit", "first", "--unit", "missing"])

  exited(rejected, 2)
end

def semanticDependencyContracts(compiler: String, work: String, target: String): Void
  let project = work + "/semantic-dependency"
  let cache = project + "/cache"
  let manifest = project + "/manifest.json"
  let library = project + "/dependency/a_library.hk"
  let consumer = project + "/z_main.hk"

  let cleared = host::run("rm", ["-rf", cache])

  test::assertTrue(cleared != null && cleared == 0)
  directory(cache + "/semantic")
  directory(project + "/dependency")
  let protectedCache = host::run("chmod", ["700", cache, cache + "/semantic"])

  test::assertTrue(protectedCache != null && protectedCache == 0)
  write(library, "namespace support\nclass Box<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return 2\nend\nnamespace support_alt\nclass OtherBox<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return 7\nend\n")
  write(consumer, "use support\ndef main(): Void\n  let box = new Box<Int>(amount())\n  let value = box.item()\nend\n")
  write(project + "/dependency/manifest.json", "{\"version\":2,\"units\":{\"library\":{\"kind\":\"library\",\"sources\":[\"a_library.hk\"]}}}\n")
  write(manifest, "{\"version\":2,\"units\":{\"app\":{\"kind\":\"executable\",\"sources\":[\"z_main.hk\"],\"references\":[{\"project\":\"dependency/manifest.json\",\"unit\":\"library\"}]}}}\n")
  let arguments = ["check", "--project", manifest, "--unit", "app", "--target", target, "--timings", "--output", project + "/analysis.nir"]
  let cold = invoke(compiler, arguments, cache)

  exited(cold, 0)

  assertSemanticTiming(cold, "dependency-semantic-miss")
  write(consumer, "use support\ndef main(): Void\n  let box = new Box<Int>(amount())\n  let value = box.item() + 1\nend\n")
  let warm = invoke(compiler, arguments, cache)

  exited(warm, 0)

  assertSemanticTiming(warm, "dependency-semantic-hit")
  let cacheDirectory = host::pathAbsolute(cache + "/semantic")

  test::assertTrue(cacheDirectory != null)
  if cacheDirectory == null
    return
  end
  let cacheRoot = files::Root.open(cacheDirectory)

  test::assertTrue(cacheRoot.failure == null && cacheRoot.root != null)
  let root = cacheRoot.root

  if root != null
    let listed = root.list("")

    test::assertTrue(listed.failure == null && listed.closeFailure == null)
    var corrupted = 0

    for entry in listed.entries
      if entry.kind.isFile() && containsText(entry.name, ".snapshot")
        write(cache + "/semantic/" + entry.name, "truncated snapshot\n")
        corrupted = corrupted + 1
      end
    end

    test::assertTrue(root.close() == null)

    test::assertTrue(corrupted > 0)
  end
  let repaired = invoke(compiler, arguments, cache)

  exited(repaired, 0)

  assertSemanticTiming(repaired, "dependency-semantic-miss")
  let repairedHit = invoke(compiler, arguments, cache)

  exited(repairedHit, 0)

  assertSemanticTiming(repairedHit, "dependency-semantic-hit")
  write(library, "namespace support\nclass Box<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return 5\nend\nnamespace support_alt\nclass OtherBox<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return 7\nend\n")
  let changedSource = invoke(compiler, arguments, cache)

  exited(changedSource, 0)

  assertSemanticTiming(changedSource, "dependency-semantic-miss")
  write(consumer, "use support_alt\ndef main(): Void\n  let box = new OtherBox<Int>(amount())\n  let value = box.item()\nend\n")
  let changedImport = invoke(compiler, arguments, cache)

  exited(changedImport, 0)

  assertSemanticTiming(changedImport, "dependency-semantic-miss")
  let bypass = invoke(compiler, ["check", "--project", manifest, "--unit", "app", "--target", target, "--timings", "--no-cache", "--output", project + "/analysis.nir"], cache)

  exited(bypass, 0)

  assertNoSemanticTiming(bypass)
  write(consumer, "use tools = support_alt\ndef main(): Void\n  let value = tools::amount()\nend\n")
  let alias = invoke(compiler, arguments, cache)

  exited(alias, 0)

  assertNoSemanticTiming(alias)
  write(library, "namespace support\nclass Box<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return \"invalid\"\nend\nnamespace support_alt\nclass OtherBox<T>\n  public value: T\n  def init(value: T): Void\n    this.value = value\n  end\n  def item(): T\n    return this.value\n  end\nend\ndef amount(): Int\n  return 7\nend\n")
  let invalid = invoke(compiler, arguments, cache)

  exited(invalid, 1)

  test::assertTrue(containsText(output(invalid) + errors(invalid), "NR143"))
end
