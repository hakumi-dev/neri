use host
use test

def batchBuildContracts(compiler: String, work: String, target: String): Void
  let project = work + "/batch"

  directory(project + "/out")
  write(project + "/a_library.hk", "def echo<T>(value: T): T\n  return value\nend\n")
  write(project + "/z_first.hk", "use console\ndef main(): Void\n  console.println(echo<Int>(42) as String)\nend\n")
  write(project + "/z_second.hk", "use console\ndef main(): Void\n  console.println(echo<String>(\"batch\"))\nend\n")
  write(project + "/manifest.json", "{\"version\":2,\"units\":{\"common\":{\"kind\":\"library\",\"sources\":[\"a_library.hk\"]},\"first\":{\"kind\":\"executable\",\"sources\":[\"z_first.hk\"],\"references\":[\"common\"]},\"second\":{\"kind\":\"executable\",\"sources\":[\"z_second.hk\"],\"references\":[\"common\"]}}}\n")
  let built = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first", "--unit", "second"])

  exited(built, 0)

  test.assertTrue(containsText(output(built), "analyzed=1 reused=1 fallback=0"))
  let first = invoke(project + "/out/first", [])
  let second = invoke(project + "/out/second", [])

  exited(first, 0)
  exited(second, 0)

  test.assertEqual(output(first), "42\n")
  test.assertEqual(output(second), "batch\n")

  write(project + "/a_library.hk", "def libraryValue(): Int\n  return pick()\nend\nnamespace alpha\ndef pick(): Int\n  return 1\nend\nnamespace beta\ndef pick(): Int\n  return 2\nend\n")
  write(project + "/z_first.hk", "use console\nuse alpha\ndef main(): Void\n  console.println(libraryValue() as String)\nend\n")
  write(project + "/z_second.hk", "use console\nuse beta\ndef main(): Void\n  console.println(libraryValue() as String)\nend\n")
  let scopes = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first", "--unit", "second"])

  exited(scopes, 0)
  let alpha = invoke(project + "/out/first", [])
  let beta = invoke(project + "/out/second", [])

  exited(alpha, 0)
  exited(beta, 0)

  test.assertEqual(output(alpha), "1\n")
  test.assertEqual(output(beta), "2\n")

  write(project + "/a_library.hk", "def libraryValue(): Int\n  return extension()\nend\n")
  write(project + "/z_first.hk", "use console\ndef extension(): Int\n  return 17\nend\ndef main(): Void\n  console.println(libraryValue() as String)\nend\n")
  let fallback = invoke(compiler, ["build-batch", "--project", project, "--target", target, "--output-dir", project + "/out", "--unit", "first"])

  exited(fallback, 0)

  test.assertTrue(containsText(output(fallback), "fallback=1"))
  let extended = invoke(project + "/out/first", [])

  exited(extended, 0)

  test.assertEqual(output(extended), "17\n")
  let rejected = invoke(compiler, ["build-batch", "--project", project, "--output-dir", project + "/out", "--unit", "first", "--unit", "missing"])

  exited(rejected, 2)
end
