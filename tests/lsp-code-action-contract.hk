use host
use test

def actionDocument(source: String, version: Int): LspDocument
  let document = new LspDocument()
  let analysisSource = source + "\ndef main(): Void\nend\n"

  document.uri = "file:///workspace/main.hk"
  document.text = analysisSource
  document.version = version
  let server = new LspServer()

  server.documents = document
  server.analyze(document)

  test.assertTrue(document.semantic != null)
  let semantic = document.semantic

  if semantic != null
    test.assertEqual(semantic.diagnostics.count(), 0)
  end
  return document
end

def hasText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def main(): Void
  let source = "use console # keep this explanation\nuse host\n\ndef run(): Void\n  let count = host.argumentCount()\nend\n"
  let document = actionDocument(source, 7)
  let quickFix = lspUnusedUseActions(document, 0, 11, true, false)

  test.assertTrue(hasText(quickFix, "\"kind\":\"quickfix\""))
  test.assertTrue(hasText(quickFix, "\"version\":7"))
  test.assertTrue(hasText(quickFix, "\"character\":11"))
  test.assertTrue(!hasText(quickFix, "keep this explanation"))
  let usedSelection = lspUnusedUseActions(document, 37, 45, true, false)

  test.assertEqual(usedSelection, "[]")
  let organized = lspUnusedUseActions(document, 0, 0, false, true)

  test.assertTrue(hasText(organized, "\"kind\":\"source.organizeImports\""))
  test.assertTrue(hasText(organized, "Remove unused imports"))
  test.assertTrue(!hasText(organized, "host"))
  let unsupported = lspUnusedUseActions(document, 0, 11, false, false)

  test.assertEqual(unsupported, "[]")

  let separated = actionDocument("\nuse console\n\ndef run(): Void\nend\n", 8)
  let endingAtUse = lspUnusedUseActions(separated, 0, 1, true, false)

  test.assertEqual(endingAtUse, "[]")
  let cursorOnUse = lspUnusedUseActions(separated, 1, 1, true, false)

  test.assertTrue(hasText(cursorOnUse, "\"kind\":\"quickfix\""))

  let guarded = actionDocument("use console\n\ndef run(): Void\n  println(\"still required\")\nend\n", 8)
  let guardedSemantic = guarded.semantic

  test.assertTrue(guardedSemantic != null)
  if guardedSemantic != null
    guardedSemantic.referencedUseNames = new StringBuffer()
    let invalidRemoval = lspUnusedUseActions(guarded, 0, 11, true, true)

    test.assertEqual(invalidRemoval, "[]")
  end
end
