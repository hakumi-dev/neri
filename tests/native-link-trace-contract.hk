use host
use test

def image(pid: String, path: String): String
  return "dyld[" + pid + "]: <01234567-89AB-CDEF-0123-456789ABCDEF> " + path + "\n"
end

def search(pid: String, path: String): String
  return "dyld[" + pid + "]: find path \"" + path + "\"\n"
end

def main(): Void
  let driver = neriCanonicalPath("/bin/sh")
  let linker = neriCanonicalPath("/usr/bin/env")

  if driver == null || linker == null
    return
  end
  let first = image("12", driver) + search("12", driver)
  let second = image("34", linker) + search("34", linker)
  let trace = new NativeLinkTrace()
  let diagnostics = trace.parse(first + second + "ld: warning: fixture\n", driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.paths.size, 2)
  test::assertEqual(trace.candidates.size, 2)
  test::assertEqual(diagnostics, "ld: warning: fixture\n")
  let signature = trace.signature

  for record in [
    "  LC_RPATH '@loader_path/../lib' from '/opt/homebrew/Cellar/llvm@22/22.1.8/bin/clang-22'",
    "  LC_RPATH \"@loader_path/../lib\" from \"/opt/homebrew/Cellar/llvm@22/22.1.8/bin/clang-22\""]
    let retained = trace.parse(first + second + "dyld[12]: " + record + "\n", driver, linker)

    test::assertTrue(trace.valid)
    test::assertEqual(retained, "")
    test::assertEqual(trace.signature, signature)
  end
  for malformed in [
    "  LC_RPATH '@loader_path/../lib' from \"/tool\"",
    "  LC_RPATH '@loader_path/../lib' from '/tool",
    "  LC_RPATH '@loader_path/../lib' from 'relative'",
    "  LC_RPATH '@loader_path/../lib' from '/tool' trailing",
    "  LC_RPATH '@loader_path/'bad' from '/tool'"]
    trace.parse(first + second + "dyld[12]: " + malformed + "\n", driver, linker)

    test::assertTrue(!trace.valid && trace.signature == "")
  end
  var older = "dyld[12]:   found: dylib-from-cache: (0x00AB) \"/cache/library\"\n"

  older = older + "dyld[12]:   found: already-loaded-by-path: \"/loaded/path\"\n"
  older = older + "dyld[12]:   found: already-loaded-by-rpath: /loaded/rpath\n"
  older = older + "dyld[12]:   found: already-loaded-by-dylib-index: \"/alias/library\" -> /resolved/library\n"

  trace.parse(first + second + older, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.candidates.size, 7)
  test::assertEqual(trace.candidates.get(0), "/alias/library")
  let olderSignature = trace.signature

  trace.parse(first + second + older + older, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.signature, olderSignature)
  for malformed in [
    "  found: dylib-from-cache: (0xGG) \"/cache/library\"",
    "  found: dylib-from-cache: (0x123456789) \"/cache/library\"",
    "  found: dylib-from-cache: (0x00AB) /cache/library",
    "  found: already-loaded-by-path: \"relative\"",
    "  found: already-loaded-by-path: \"/loaded/path\" trailing",
    "  found: already-loaded-by-rpath: \"/loaded/rpath\"",
    "  found: already-loaded-by-rpath: relative",
    "  found: already-loaded-by-dylib-index: /alias -> /resolved",
    "  found: already-loaded-by-dylib-index: \"/alias\" -> relative",
    "  found: already-loaded-by-dylib-index: \"/alias\" => /resolved"]
    trace.parse(first + second + "dyld[12]: " + malformed + "\n", driver, linker)

    test::assertTrue(!trace.valid && trace.signature == "")
  end
  let reordered = image("77", linker) + search("77", linker) + image("99", driver) + search("99", driver)

  trace.parse(reordered + image("99", driver), driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.signature, signature)
  trace.parse(first, driver, linker)

  test::assertTrue(!trace.valid && trace.signature == "")
  trace.parse(image("12", driver) + image("34", linker), driver, linker)

  test::assertTrue(!trace.valid)
  let error = "dyld[12]: Library not loaded: fixture\n"
  let retained = trace.parse(first + second + error, driver, linker)

  test::assertTrue(!trace.valid)
  test::assertEqual(retained, error)
  trace.parse(first + second + "dyld[12]:   possible path(original path): \"relative\"\n", driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + image("-1", driver), driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + "dyld[12]: <bad-uuid> /fixture\n", driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + "dyld[12]: find path \"/unterminated\"", driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first, driver, "")

  test::assertTrue(trace.valid)
  let matching = "dyld[12]:   found: prebuilt-loader-dylib matching path\n"
  let missing = "dyld[12]:   not found: weak-linked and pre-built-as-missing dylib\n"
  let ordered = first + second + image("12", "/zzz") + image("12", "/aaa") + search("12", "/zzz") + matching + search("12", "/aaa") + matching

  trace.parse(ordered + matching, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.paths.get(0), "/aaa")
  test::assertEqual(trace.candidates.get(0), "/aaa")
  test::assertEqual(trace.prebuilt.size, 2)
  test::assertEqual(trace.prebuilt.get(0), "/aaa")
  test::assertEqual(trace.prebuilt.get(1), "/zzz")
  let prebuiltSignature = trace.signature

  trace.parse(first + second + image("12", "/aaa") + image("12", "/zzz") + search("12", "/aaa") + matching + search("12", "/zzz") + matching, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.signature, prebuiltSignature)
  trace.parse(first + second + search("12", "@rpath/missing") + matching, driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + search("12", "@rpath/missing") + missing, driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + search("12", "@rpath/missing") + search("34", "/absolute") + matching, driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + search("12", "/absolute") + missing, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.prebuilt.size, 0)
  test::assertEqual(trace.prebuiltMissing.size, 1)
  test::assertEqual(trace.prebuiltMissing.get(0), "/absolute")
  let missingSignature = trace.signature

  trace.parse(first + second + search("12", "/absolute"), driver, linker)

  test::assertTrue(trace.valid)
  test::assertTrue(trace.signature != missingSignature)
  trace.parse(first + second + search("12", "/zzz") + missing + search("12", "/absolute") + missing + missing, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.prebuiltMissing.size, 2)
  test::assertEqual(trace.prebuiltMissing.get(0), "/absolute")
  test::assertEqual(trace.prebuiltMissing.get(1), "/zzz")
  let cryptex = "dyld[12]:   possible path(cryptex prefix): \"/cryptex/usr/lib/fixture\"\n"

  trace.parse(first + second + search("12", "/usr/lib/fixture") + cryptex, driver, linker)

  test::assertTrue(!trace.valid)
  let linkerCryptex = search("34", "/usr/lib/fixture") + "dyld[34]:   possible path(cryptex prefix): \"/cryptex/usr/lib/fixture\"\n"

  trace.parse(first + second + search("12", "/usr/lib/fixture") + cryptex + linkerCryptex, driver, linker)

  test::assertTrue(trace.valid)
  test::assertEqual(trace.cryptexPrefix, "/cryptex")
  trace.parse(first + second + linkerCryptex + search("12", "/usr/lib/other") + cryptex, driver, linker)

  test::assertTrue(!trace.valid)
  trace.parse(first + second + linkerCryptex + search("12", "/usr/lib/fixture") + cryptex + "dyld[12]:   possible path(cryptex prefix): \"/different/usr/lib/fixture\"\n", driver, linker)

  test::assertTrue(!trace.valid)
  let unsupported = "dyld[12]:   possible path(DYLD_FRAMEWORK/LIBRARY_PATH): \"/fixture\"\n"
  let preserved = trace.parse(first + second + unsupported, driver, linker)

  test::assertTrue(!trace.valid)
  test::assertEqual(preserved, unsupported)
end
