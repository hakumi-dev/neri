use host
use test
use files

def generatedWrite(path: String, text: String): Void
  test.assertTrue(host.writeText(path, text))
end

def generatedDirectory(path: String): Void
  let created = files.createDirectory(path, true)

  test.assertTrue(created.failure == null)
end

def generatedContains(text: String, part: String): Bool
  return bootstrapFindText(text, part) >= 0
end

def generationManifest(inputDigest: String, outputDigest: String, version: String = "1"): String
  return "{\"version\":1,\"generator\":\"contract-generator\",\"generatorVersion\":\"" + version + "\",\"inputs\":[{\"path\":\"../schema.neri-data\",\"sha256\":\"" + inputDigest + "\"}],\"outputs\":[{\"path\":\"generated/api.hk\",\"sha256\":\"" + outputDigest + "\"}],\"origins\":[{\"path\":\"generated/api.hk\",\"start\":4,\"length\":15,\"source\":\"../schema.neri-data\",\"sourceStart\":0,\"sourceLength\":8,\"identity\":\"callable:generatedAnswer\"}]}\n"
end

def generatedDocument(path: String, text: String): LspDocument
  let document = new LspDocument()

  document.uri = lspUri(path)
  document.sourcePath = path
  document.text = text
  document.version = 1
  document.publishDiagnostics = false
  return document
end

def main(): Void
  let root = host.argumentAt(0)

  test.assertTrue(root != null)
  if root == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "generated-source-contract")

  test.assertTrue(temporary != null)
  if temporary == null
    return
  end
  let projectRoot = temporary + "/project"
  let generatedRoot = projectRoot + "/generated"
  let schemaPath = temporary + "/schema.neri-data"
  let mainPath = projectRoot + "/main.hk"
  let otherPath = projectRoot + "/other.hk"
  let outputPath = generatedRoot + "/api.hk"
  let generationPath = generatedRoot + "/manifest.json"
  let generatedOnlyPath = generatedRoot + "/only.hk"
  let generatedOnlyManifest = generatedRoot + "/only-manifest.json"
  let projectPath = projectRoot + "/manifest.json"
  let schema = "answer:1"
  let output = "def generatedAnswer(): Int\n  return 1\nend\n"
  let diskMain = "def probe(): Void\nend\n"
  let mainSource = "def probe(): Void\n  generatedAns\nend\n"

  generatedDirectory(generatedRoot)
  generatedWrite(schemaPath, schema)
  generatedWrite(mainPath, diskMain)
  generatedWrite(otherPath, "def unrelated(): Int\n  return 0\nend\n")
  generatedWrite(outputPath, output)
  generatedWrite(generationPath, generationManifest(sha256FastText(schema), sha256FastText(output)))
  let generatedOnly = "def generatedOnly(): Int\n  return 2\nend\n"

  generatedWrite(generatedOnlyPath, generatedOnly)
  generatedWrite(generatedOnlyManifest, "{\"version\":1,\"generator\":\"contract-generator\",\"generatorVersion\":\"1\",\"inputs\":[{\"path\":\"../schema.neri-data\",\"sha256\":\"" + sha256FastText(schema) + "\"}],\"outputs\":[{\"path\":\"generated/only.hk\",\"sha256\":\"" + sha256FastText(generatedOnly) + "\"}],\"origins\":[]}\n")
  generatedWrite(projectPath, "{\"version\":2,\"defaultUnit\":\"app\",\"units\":{\"app\":{\"kind\":\"library\",\"sources\":[\"main.hk\"],\"generated\":[\"generated/manifest.json\"]},\"generatedOnly\":{\"kind\":\"library\",\"sources\":[],\"generated\":[\"generated/only-manifest.json\"]},\"unrelated\":{\"kind\":\"library\",\"sources\":[\"other.hk\"],\"generated\":[\"generated/missing.json\"]}}}\n")
  let project = neriLoadProject(projectPath)

  test.assertEqual(project.error, "")
  test.assertEqual(project.sources.size, 2)
  test.assertEqual(project.generatedInputs.size, 1)
  test.assertEqual(project.generationManifests.size, 1)
  test.assertTrue(project.generatedOrigins != null)
  let generatedOnlyProject = neriLoadProject(projectPath, "generatedOnly")
  let generatedOwner = neriProjectForSource(projectPath, generatedOnlyPath, "unrelated")

  test.assertEqual(generatedOnlyProject.error, "")
  test.assertEqual(generatedOnlyProject.sources.size, 1)
  test.assertEqual(generatedOwner.error, "")
  test.assertEqual(generatedOwner.sources.size, 1)
  test.assertTrue(neriProjectContains(generatedOwner, generatedOnlyPath))
  generatedWrite(outputPath, "def unverifiedAnswer(): Int\n  return 9\nend\n")
  let snapshot = sessionSnapshotFromProject(project)

  generatedWrite(outputPath, output)
  let environment = new SessionEnvironment("generated-source-contract", snapshot)
  let prepared = environment.prepare("let value = generatedAnswer()")

  test.assertEqual(snapshot.error, "")
  test.assertEqual(snapshot.count(), 2)
  test.assertTrue(generatedContains(snapshot.source(), "def generatedAnswer(): Int"))
  test.assertTrue(!generatedContains(snapshot.source(), "unverifiedAnswer"))
  test.assertEqual(prepared.status, "complete")
  generatedWrite(generationPath, generationManifest(sha256FastText(schema), sha256FastText(output), "2"))
  let revisedSnapshot = sessionSnapshotFromProject(neriLoadProject(projectPath))

  test.assertTrue(revisedSnapshot.configuration != snapshot.configuration)
  generatedWrite(generationPath, generationManifest(sha256FastText(schema), sha256FastText(output)))

  generatedWrite(schemaPath, "answer:2")
  let staleInput = neriLoadProject(projectPath)

  test.assertTrue(generatedContains(staleInput.error, "Artifact digest differs: ../schema.neri-data"))
  generatedWrite(schemaPath, schema)
  generatedWrite(outputPath, "def generatedAnswer(): Int\n  return 2\nend\n")
  let staleOutput = neriLoadProject(projectPath)

  test.assertTrue(generatedContains(staleOutput.error, "Artifact digest differs: generated/api.hk"))
  generatedWrite(outputPath, output)
  generatedWrite(generationPath, "{\"version\":2,\"generator\":\"contract-generator\",\"generatorVersion\":\"1\",\"inputs\":[],\"outputs\":[],\"origins\":[]}")
  let invalidSchema = neriLoadProject(projectPath)

  test.assertTrue(generatedContains(invalidSchema.error, "Expected version 1"))
  generatedWrite(generationPath, generationManifest(sha256FastText(schema), sha256FastText(output)))

  let server = new LspServer()
  let mainDocument = generatedDocument(mainPath, mainSource)
  let inputDocument = generatedDocument(schemaPath, schema)
  let outputDocument = generatedDocument(outputPath, "def unverifiedAnswer(): Int\n  return 9\nend\n")

  server.rootPath = projectRoot
  server.documents = mainDocument
  mainDocument.next = inputDocument
  inputDocument.next = outputDocument
  server.analyze(mainDocument)

  test.assertTrue(mainDocument.semantic == null)
  test.assertEqual(lspCompletion(mainDocument, (new IrSourceMap(mainDocument.text)).utf16Length() - 5), "[]")
  test.assertEqual(lspSourceOrigin(mainDocument, 20), "null")

  outputDocument.text = output
  inputDocument.text = "answer:2"
  server.analyze(mainDocument)

  test.assertTrue(mainDocument.semantic == null)
  inputDocument.text = schema
  server.analyze(mainDocument)
  let restored = lspCompletion(mainDocument, (new IrSourceMap(mainDocument.text)).utf16Length() - 5)

  test.assertTrue(generatedContains(restored, "\"label\":\"generatedAnswer\""))
  mainDocument.text = "def probe(): Void\n  let value = generatedAnswer()\nend\n"
  server.analyze(mainDocument)
  let generatedUse = bootstrapFindText(mainDocument.text, "generatedAnswer")
  let definition = lspDefinition(mainDocument, generatedUse)
  let origin = lspSourceOrigin(mainDocument, generatedUse)

  test.assertTrue(generatedContains(definition, lspUri(outputPath)))
  test.assertTrue(generatedContains(origin, lspUri(schemaPath)))
  test.assertTrue(generatedContains(origin, "\"character\":8"))

  let regeneratedSchema = "answer:2"
  let regeneratedOutput = "def regeneratedAnswer(): Int\n  return 2\nend\n"

  generatedWrite(schemaPath, regeneratedSchema)
  generatedWrite(outputPath, regeneratedOutput)
  generatedWrite(generationPath, generationManifest(sha256FastText(regeneratedSchema), sha256FastText(regeneratedOutput)))
  inputDocument.text = regeneratedSchema
  outputDocument.text = regeneratedOutput
  mainDocument.text = "def probe(): Void\n  regeneratedAns\nend\n"
  mainDocument.version = 2
  server.analyze(mainDocument)
  let regenerated = lspCompletion(mainDocument, (new IrSourceMap(mainDocument.text)).utf16Length() - 5)

  test.assertTrue(generatedContains(regenerated, "\"label\":\"regeneratedAnswer\""))

  let removed = files.removeTree(temporary)

  test.assertTrue(removed.failure == null)
end
