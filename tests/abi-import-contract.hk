use host
use process
use test

def abiImportContains(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def abiImportModule(name: String, linkName: String, resultType: String, parameterTypes: String[], effects: EffectSet, minor: Int, features: RuntimeFeatures): IrModule
  let module = new IrModule(name, "")
  let declaration = new IrImport(irSymbol(name, module.domains.symbolKind.getLibraryFunction(), "runtime.import." + name), irType(resultType), module.domains.importKind.getRuntime(), linkName, effects, irNoLocation())

  module.requiredFeatures.requireNativeStrings()
  declaration.runtimeMajor = 1
  declaration.runtimeMinor = minor
  declaration.runtimeFeatures = features
  for parameterType in parameterTypes
    declaration.parameterTypes.add(irType(parameterType))
  end
  module.addImport(declaration)
  return module
end

def abiImportTarget(): TargetPlatform?
  let path = host.environment("NERI_RUNTIME_MANIFEST")

  if path == null
    return null
  end
  let manifest = host.readText(path)

  if manifest == null
    return null
  end
  return TargetPlatform.parse(bootstrapManifestString(manifest, "target"))
end

def abiImportCodegen(module: IrModule, directory: String, name: String): process.PollResult
  return abiWireCodegen(irSerializeEnvelopeHex(module), directory, name)
end

def abiWireCodegen(envelope: String, directory: String, name: String): process.PollResult
  let codegen = host.environment("NERI_CODEGEN")

  test.assertTrue(codegen != null && codegen != "")
  if codegen == null || codegen == ""
    return new process.PollResult()
  end
  let input = directory + "/" + name + ".nir.hex"
  let output = directory + "/" + name + ".ll"
  let target = abiImportTarget()

  test.assertTrue(target != null)
  if target == null
    return new process.PollResult()
  end

  test.assertTrue(host.writeText(input, envelope))
  let options = new process.SpawnOptions(codegen)

  options.arguments = [
    "--input", input,
    "--input-format", "hex",
    "--target", target.name(),
    "--optimization", "debug",
    "--emit", "llvm-ir",
    "--output", output
  ]
  let started = process.spawn(options)
  let child = started.child()

  test.assertTrue(started.failure() == null && child != null)
  if child == null
    return new process.PollResult()
  end
  let completed = child.wait(30000)

  test.assertTrue(completed.failure == null && !completed.running && !completed.stdoutTruncated && !completed.stderrTruncated)
  test.assertTrue(child.dispose())
  return completed
end

def abiImportAccept(module: IrModule, directory: String, name: String): Void
  let completed = abiImportCodegen(module, directory, name)
  let status = completed.exit

  test.assertTrue(status != null && status.isExited() && status.value() == 0)
end

def abiImportReject(module: IrModule, directory: String, name: String, code: String, message: String): Void
  let completed = abiImportCodegen(module, directory, name)
  let status = completed.exit
  let errors = host.stringFromBytes(completed.stderr)

  test.assertTrue(status != null && status.isExited() && status.value() == 2)
  test.assertTrue(errors != null && abiImportContains(errors, code) && abiImportContains(errors, message))
end

def rejectsUnknownRuntimeSymbol(directory: String): Void
  let module = abiImportModule("unknown-runtime", "neri_rt_v1_math_abs", "Int", ["Int"], new EffectSet().withMayPanic(), 4, new RuntimeFeatures())
  let declaration = module.firstImport

  test.assertTrue(declaration != null)
  if declaration != null
    declaration.linkName = "neri_rt_v1_not_catalogued"
  end

  abiImportReject(module, directory, "unknown-runtime", "NIR003", "absent from the ABI catalog")
end

def rejectsMismatchedSignatures(directory: String): Void
  let scalar = abiImportModule("scalar-signature", "neri_rt_v1_math_abs", "Int", ["Int"], new EffectSet().withMayPanic(), 4, new RuntimeFeatures())
  let scalarImport = scalar.firstImport

  abiImportAccept(scalar, directory, "scalar-baseline")

  test.assertTrue(scalarImport != null)
  if scalarImport != null
    scalarImport.resultType = irType("Bool")
  end

  abiImportReject(scalar, directory, "scalar-signature", "NIR006", "signature differs from the ABI catalog")

  let optional = abiImportModule("optional-signature", "neri_rt_v1_host_parse_int", "Int?", ["String"], new EffectSet().withMayPanic(), 6, new RuntimeFeatures().withBootstrapHost())
  let optionalImport = optional.firstImport

  abiImportAccept(optional, directory, "optional-baseline")

  test.assertTrue(optionalImport != null)
  if optionalImport != null
    optionalImport.resultType = irType("Float?")
  end

  abiImportReject(optional, directory, "optional-signature", "NIR006", "signature differs from the ABI catalog")

  let array = abiImportModule("array-signature", "neri_rt_v1_host_append_byte", "Byte[]", ["Byte[]", "Byte"], new EffectSet().withMayPanic().withManagedAllocate().withSafepoint(), 6, new RuntimeFeatures().withBootstrapHost())
  let arrayImport = array.firstImport

  abiImportAccept(array, directory, "array-baseline")

  test.assertTrue(arrayImport != null)
  if arrayImport != null
    arrayImport.parameterTypes.set(0, irType("Int[]"))
  end

  abiImportReject(array, directory, "array-signature", "NIR006", "parameter differs from the ABI catalog")
end

def rejectsWeakenedContract(directory: String): Void
  let effects = abiImportModule("weaker-effects", "neri_rt_v1_string_concat", "String", ["String", "String"], new EffectSet().withMayPanic().withManagedAllocate().withSafepoint(), 2, new RuntimeFeatures())
  let effectsImport = effects.firstImport

  abiImportAccept(effects, directory, "effects-baseline")

  test.assertTrue(effectsImport != null)
  if effectsImport != null
    effectsImport.effects = effectsImport.effects.withoutSafepoint()
  end

  abiImportReject(effects, directory, "weaker-effects", "NIR009", "effects contradict the ABI catalog")

  let minor = abiImportModule("insufficient-minor", "neri_rt_v1_host_string_byte_length", "Int", ["String"], new EffectSet().withMayPanic(), 6, new RuntimeFeatures().withBootstrapHost())
  let minorImport = minor.firstImport

  abiImportAccept(minor, directory, "minor-baseline")

  test.assertTrue(minorImport != null)
  if minorImport != null
    minorImport.runtimeMinor = 5
  end

  abiImportReject(minor, directory, "insufficient-minor", "NIR003", "weakens the catalog ABI requirements")

  let features = abiImportModule("insufficient-features", "neri_rt_v1_host_string_byte_length", "Int", ["String"], new EffectSet().withMayPanic(), 6, new RuntimeFeatures())

  abiImportReject(features, directory, "insufficient-features", "NIR003", "weakens the catalog ABI requirements")
end

def acceptsConservativeEffectsWithExactNoReturn(directory: String): Void
  let stronger = abiImportModule("stronger-effects", "neri_rt_v1_math_abs", "Int", ["Int"], new EffectSet().withRead().withMayPanic(), 4, new RuntimeFeatures())

  abiImportAccept(stronger, directory, "stronger-effects")

  let exit = abiImportModule("exact-noreturn", "neri_rt_v1_host_exit", "Void", ["Int"], new EffectSet().withWrite().withMayPanic().withNoReturn(), 6, new RuntimeFeatures().withBootstrapHost())

  abiImportAccept(exit, directory, "exact-noreturn")

  let omittedNoReturn = abiImportModule("omitted-noreturn", "neri_rt_v1_host_exit", "Void", ["Int"], new EffectSet().withWrite().withMayPanic(), 6, new RuntimeFeatures().withBootstrapHost())

  abiImportAccept(omittedNoReturn, directory, "omitted-noreturn")

  let falseNoReturn = abiImportModule("false-noreturn", "neri_rt_v1_math_abs", "Int", ["Int"], new EffectSet().withMayPanic().withNoReturn(), 4, new RuntimeFeatures())

  abiImportReject(falseNoReturn, directory, "false-noreturn", "NIR009", "effects contradict the ABI catalog")
end

def conditionalNoReturnCaller(compiler: String, directory: String): Void
  let source = directory + "/conditional-noreturn.hk"
  let rendered = directory + "/conditional-noreturn.nir"
  let executable = directory + "/conditional-noreturn"
  let program = "use console\nuse host\n\ndef conditionalExit(stop: Bool): Void\n  if stop\n    host.exit(9)\n  end\n  console.println(\"continued\")\nend\n\ndef main(): Void\n  conditionalExit(false)\nend\n"

  test.assertTrue(host.writeText(source, program))
  let renderStatus = host.run(compiler, ["build", source, "--emit=neri-ir", "--output", rendered])

  test.assertTrue(renderStatus != null && renderStatus == 0)
  let ir = host.readText(rendered)

  test.assertTrue(ir != null)
  if ir != null
    test.assertTrue(abiImportContains(ir, "\"runtime.intrinsic.host.exit\"] : (int) -> void kind=runtime link=\"neri_rt_v1_host_exit\" effects=[write, may-panic, noreturn]"))
    test.assertTrue(abiImportContains(ir, "\"conditionalExit\"] kind=function (bool) -> void effects=[write, may-panic]"))
  end
  let buildStatus = host.run(compiler, ["build", source, "--output", executable])

  test.assertTrue(buildStatus != null && buildStatus == 0)
  let runStatus = host.run(executable, [])

  test.assertTrue(runStatus != null && runStatus == 0)
end

def cInteropSignature(resultType: String, parameterTypes: String[]): String
  let components = new StringBuffer()

  components.add(resultType)
  for parameter in parameterTypes
    components.add(parameter)
  end
  return semanticCFunctionType(components)
end

def cInteropModule(): IrModule
  let module = new IrModule("c-interop-contract", "callback")
  let location = module.location(0, 8)
  let function = new IrFunction(irSymbol(module.id, module.domains.symbolKind.getFunction(), "callback"), "void", module.domains.functionKind.getFunction(), false, location)
  let body = function.createBlock()

  module.requiredFeatures.requireCInterop()
  function.cExportSymbol = "contract_callback"
  body.terminator = new IrTerminator(module.domains.terminatorKind.getReturn(), location)
  module.addFunction(function)
  return module
end

def cInteropImport(module: IrModule, resultType: String, parameters: String[]): IrImport
  let imported = new IrImport(irSymbol(module.id, module.domains.symbolKind.getFunction(), "foreign"), resultType, module.domains.importKind.getCAbi(), "contract_foreign", irCAbiEffects(), irNoLocation())

  for parameter in parameters
    imported.parameterTypes.add(parameter)
  end
  module.addImport(imported)
  return imported
end

def verifiesForeignCallEffects(directory: String): Void
  let module = new IrModule("foreign-effects", "")
  let imported = cInteropImport(module, "int", ["int"])
  let complete = irCAbiEffects()

  abiImportAccept(module, directory, "foreign-effects-complete")
  var index = 0

  for incomplete in [complete.withoutRead(), complete.withoutWrite(), complete.withoutMayPanic(),
    complete.withoutManagedAllocate(), complete.withoutNativeAllocate(), complete.withoutSafepoint(), complete.withoutUnsafe()]
    imported.effects = incomplete

    abiImportReject(module, directory, "foreign-effects-" + (index as String), "NIR009", "conservative effect contract")

    index = index + 1
  end
end

def verifiesCInteropDeclarations(directory: String): Void
  let module = cInteropModule()
  let callback = cInteropSignature("void", [])
  let imported = cInteropImport(module, "optional|" + callback, [callback, "pointer|" + callback])

  abiImportAccept(module, directory, "c-interop-signatures")
  for reserved in ["neri_rt_v1_foreign_enter", "neri_rt_v1_foreign_leave", "neri_rt_v1_math_abs"]
    imported.linkName = reserved

    abiImportReject(module, directory, "c-interop-runtime-" + reserved, "NIR005", "compiler-controlled runtime symbol")
  end
  imported.linkName = "contract_foreign"
  module.requiredFeatures = new IrFeatureSet()

  abiImportReject(module, directory, "c-interop-missing-feature", "NIR003", "C function types require c-interop-v1")
  module.requiredFeatures.requireCInterop()
  imported.effects = new EffectSet().withRead().withWrite().withUnsafe()

  abiImportReject(module, directory, "c-interop-effects", "NIR009", "conservative effect contract")
  imported.effects = irCAbiEffects()
  imported.parameterTypes.set(0, cInteropSignature("void", ["void"]))

  abiImportReject(module, directory, "c-interop-invalid-parameter", "NIR006", "C-compatible result and parameters")
  imported.parameterTypes.set(0, callback)
  let exported = module.firstFunction

  test.assertTrue(exported != null)
  if exported == null
    return
  end
  exported.cExportSymbol = imported.linkName

  abiImportReject(module, directory, "c-interop-conflict", "NIR005", "conflicts with another export or import")
  exported.cExportSymbol = "neri_rt_v1_foreign_enter"

  abiImportReject(module, directory, "c-interop-reserved", "NIR006", "portable unreserved symbol")
end

def verifiesCInteropInstructions(directory: String): Void
  let module = cInteropModule()
  let exported = module.firstFunction

  test.assertTrue(exported != null)
  if exported == null
    return
  end
  let body = exported.firstBlock

  test.assertTrue(body != null)
  if body == null
    return
  end
  let location = module.location(0, 8)
  let callback = cInteropSignature("void", [])
  let address = new IrInstruction(module.domains.opcode.getCFunctionAddress(), 0, callback, [], [], exported.symbol, null, "", null, false, location)
  let begin = new IrInstruction(module.domains.opcode.getUnsafeBegin(), 1, "!unsafe", [], [], null, null, "", null, false, location)
  let call = new IrInstruction(module.domains.opcode.getCallCIndirect(), -1, "void", [1, 0], [], null, null, "", null, false, location)
  let finish = new IrInstruction(module.domains.opcode.getUnsafeEnd(), -1, "void", [1], [], null, null, "", null, false, location)

  exported.effects = irCAbiEffects()
  body.addInstruction(address)
  body.addInstruction(begin)
  body.addInstruction(call)
  body.addInstruction(finish)

  abiImportAccept(module, directory, "c-interop-indirect")
  exported.cExportSymbol = ""

  abiImportReject(module, directory, "c-interop-non-exported", "NIR005", "requires an exported function")
  exported.cExportSymbol = "contract_callback"
  call.operands = [1]

  abiImportReject(module, directory, "c-interop-missing-callee", "NIR006", "capability and callable")
  call.operands = [0, 0]

  abiImportReject(module, directory, "c-interop-missing-capability", "NIR006", "operand has the wrong semantic type")
  call.operands = [1, 0]
  address.resultType = cInteropSignature("byte", [])

  abiImportReject(module, directory, "c-interop-address-signature", "NIR006", "result has the wrong semantic type")
end

def rejectsFeatureWire(directory: String, name: String, features: String[], diagnostic: String): Void
  let module = new IrModule(name, "")
  let payload = new IrWireBuffer(module.domains)

  payload.writeUInt16(irSemanticMajor())
  payload.writeUInt16(irSemanticMinor())
  payload.writeUtf8(name)
  payload.writeUInt32(features.Length)
  for feature in features
    payload.writeUtf8(feature)
  end
  payload.writeUInt32(0)
  payload.writeUInt32(0)
  payload.writeUInt32(0)
  payload.writeUInt32(0)
  payload.writeUInt32(0)
  let envelope = irSerializeEnvelopePayloadHex(module, payload, sha256FastWire(payload.bytes))
  let completed = abiWireCodegen(envelope, directory, name)
  let status = completed.exit
  let errors = host.stringFromBytes(completed.stderr)

  test.assertTrue(status != null && status.isExited() && status.value() == 2)
  test.assertTrue(errors != null && abiImportContains(errors, diagnostic))
end

def main(): Void
  let compiler = host.argumentAt(1)
  let directory = host.argumentAt(2)

  test.assertTrue(compiler != null && directory != null)
  if compiler == null || directory == null
    return
  end
  rejectsUnknownRuntimeSymbol(directory)
  rejectsMismatchedSignatures(directory)
  rejectsWeakenedContract(directory)
  acceptsConservativeEffectsWithExactNoReturn(directory)
  conditionalNoReturnCaller(compiler, directory)
  verifiesForeignCallEffects(directory)
  verifiesCInteropDeclarations(directory)
  verifiesCInteropInstructions(directory)
  rejectsFeatureWire(directory, "feature-unknown", ["future-v1"], "Unknown required semantic feature")
  rejectsFeatureWire(directory, "feature-duplicate", ["native-strings-v1", "native-strings-v1"], "unique canonical order")
  rejectsFeatureWire(directory, "feature-order", ["string-data-v1", "native-strings-v1"], "unique canonical order")
  rejectsFeatureWire(directory, "feature-transport", ["c-interop-v1"], "requires IR transport 1.8")
end
