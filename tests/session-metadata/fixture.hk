use host

def metadataWordMaximum(): UInt64
  return (9223372036854775807 as UInt64) * (2 as UInt64) + (1 as UInt64)
end

unsafe def metadataText(text: String): Byte*
  let count = host::stringByteLength(text)
  let bytes = native::allocZeroed<Byte>(count + 1)
  var index = 0

  while index < count
    bytes[index] = host::stringByteAt(text, index) as Byte
    index = index + 1
  end
  return bytes
end

@cabiExport("metadata_fixture_entry")
unsafe def entry(previous: Byte*): Byte*
  return previous
end

unsafe def makeMetadata(flags: UInt32, size: UInt64): SessionMetadata*
  # The calling session owns the initialized heap and reclaims these native
  # allocations at shutdown. Every supported target stores UInt16 little-endian.
  let result = native::allocZeroed<SessionMetadata>(1)
  let layout = native::allocZeroed<SessionLayout>(1)

  layout.identity = metadataText("metadata-fixture")
  layout.canonical = metadataText("metadata-fixture-layout")
  layout.kind = 1 as UInt32
  layout.flags = flags
  layout.size = size
  layout.alignment = 8 as UInt64
  result.size = native::sizeOf<SessionMetadata>() as UInt32
  result.major[0] = 1 as Byte
  result.minor[0] = 1 as Byte
  result.entryName = metadataText("neri_session_entry_v1")
  result.entry = entry
  result.source = metadataText("neri:type:v1:void")
  result.target = layout.identity
  result.layouts = layout
  result.count = 1 as UInt64
  result.displayOffset = metadataWordMaximum()
  return result
end
