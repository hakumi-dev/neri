use test
use result
use resources

class Journal
  public text: String = ""
end

resource class Handle
  public journal: Journal
  public def init(journal: Journal): Void
    this.journal = journal
  end
  public def close(): result.Failure?
    this.journal.text = this.journal.text + "X"
    return new result.Failure("X", "close")
  end
end

def loop(journal: Journal): resources.Outcome<Int, String>
  var index = 0
  while index < 2
    index = index + 1
    using handle <- new Handle(journal)
      continue if index == 1
      break
    end
  end
  return 1
end

def main(): Void
  let journal = new Journal()
  let outcome = loop(journal)
  test.assertEqual(journal.text, "XX")
  test.assertEqual(outcome.closeFailures.count(), 2)
end
