use crypto
use files
use host
use http
use result
use test

class CallCount
  public value: Int = 0
end

def main(): Void
  let stringify: fn(Int): String = fn(value: Int): String
    return value as String
  end
  let mapped = result.map<Int, result.Failure, String>(result.Result<Int, result.Failure>.Ok(4), stringify)
  match mapped
    case result.Result.Ok(text)
      test.assertEqual(text, "4")
    case result.Result.Error(failure)
      test.assertTrue(false)
  end

  let increment: fn(Int): result.Result<Int, result.Failure> = fn(value: Int): result.Result<Int, result.Failure>
    return result.Result<Int, result.Failure>.Ok(value + 1)
  end
  let chained = result.flatMap<Int, result.Failure, Int>(result.Result<Int, result.Failure>.Ok(2), increment)
  match chained
    case result.Result.Ok(value)
      test.assertEqual(value, 3)
    case result.Result.Error(failure)
      test.assertTrue(false)
  end

  let code: fn(result.Failure): String = fn(failure: result.Failure): String
    return failure.code
  end
  let transformed = result.mapError<Int, result.Failure, String>(result.Result<Int, result.Failure>.Error(new result.Failure("failed", "test")), code)
  match transformed
    case result.Result.Ok(value)
      test.assertTrue(false)
    case result.Result.Error(error)
      test.assertEqual(error, "failed")
  end

  let nested = result.Result<result.Result<Int, result.Failure>, result.Failure>.Ok(result.Result<Int, result.Failure>.Ok(8))
  match nested
    case result.Result.Ok(inner)
      match inner
        case result.Result.Ok(value)
          test.assertEqual(value, 8)
        case result.Result.Error(failure)
          test.assertTrue(false)
      end
    case result.Result.Error(failure)
      test.assertTrue(false)
  end

  let calls = new CallCount()
  let count: fn(Int): Int = fn(value: Int): Int
    calls.value = calls.value + 1
    return value + 1
  end
  let untouched = result.map<Int, result.Failure, Int>(result.Result<Int, result.Failure>.Error(new result.Failure("first", "test")), count)
  test.assertEqual(calls.value, 0)
  match untouched
    case result.Result.Ok(value)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.code, "first")
  end

  let independent = result.Result<Int, result.Failure>.Error(new result.Failure("second", "test"))
  match independent
    case result.Result.Ok(value)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.code, "second")
  end

  let parsed = http.parseOutcome("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
  match parsed
    case result.Result.Ok(request)
      test.assertEqual(request.path, "/")
    case result.Result.Error(failure)
      test.assertTrue(false)
  end

  let rejected = http.parseOutcome("GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
  match rejected
    case result.Result.Ok(request)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.status, 505)
      test.assertTrue(!failure.head)
      test.assertEqual(failure.cause.code, "unsupported_version")
  end

  let unreadable = http.readHeadOutcome(-1, -1)
  match unreadable
    case result.Result.Ok(head)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.status, 0)
      test.assertEqual(failure.bytesRead, 0)
      test.assertEqual(failure.cause.transferred, 0)
  end

  let unwritten = http.writeBytesOutcome(-1, [1 as Byte], -1)
  match unwritten
    case result.Result.Ok(bytes)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.transferred, 0)
  end

  let invalid = crypto.decodeHexOutcome("0g")
  match invalid
    case result.Result.Ok(bytes)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.operation, "crypto.decode_hex")
  end

  let random = crypto.randomBytesOutcome(-1)
  match random
    case result.Result.Ok(bytes)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.operation, "crypto.random_bytes")
  end

  let missing = files.readBytesOutcome("", 1)
  match missing
    case result.Result.Ok(bytes)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.cause.operation, "files.read")
  end

  let partial = new files.ReadResult()
  partial.bytesRead = 7
  partial.failure = new files.Failure("read_failed", 5, "root.read", 2)
  let firstClose = new files.Failure("close_failed", 9, "root.close_component")
  firstClose.closeFailure = new files.Failure("close_failed", 10, "root.close_component")
  partial.closeFailure = firstClose
  match files.readOutcome(partial)
    case result.Result.Ok(bytes)
      test.assertTrue(false)
    case result.Result.Error(failure)
      test.assertEqual(failure.cause.transferred, 7)
      test.assertEqual(failure.cause.osCode, 5)
      test.assertEqual(failure.component, 2)
      let close = failure.closeFailure
      test.assertTrue(close != null)
      if close != null
        test.assertEqual(close.osCode, 9)
        let next = close.closeFailure
        test.assertTrue(next != null)
        if next != null
          test.assertEqual(next.osCode, 10)
        end
      end
  end
end
