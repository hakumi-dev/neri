use json
use result
use test
use text

def parsed(input: String, options: json::Options? = null): json::Value
  match json::parse(input, options)
    case result::Result.Ok(value)
      return value
    case result::Result.Error(error)
      test::assertTrue(false)

      return json::Value.nullValue()
  end
end

def failed(input: String, code: String, options: json::Options? = null): Void
  match json::parse(input, options)
    case result::Result.Ok(value)
      test::assertTrue(false)
    case result::Result.Error(error)
      test::assertEqual(error.code, code)
  end
end

def encoded(value: json::Value, options: json::Options? = null): String
  match json::stringify(value, options)
    case result::Result.Ok(output)
      return output
    case result::Result.Error(error)
      test::assertTrue(false)

      return ""
  end
end

def writeFailed(value: json::Value, code: String, options: json::Options): Void
  match json::stringify(value, options)
    case result::Result.Ok(output)
      test::assertTrue(false)
    case result::Result.Error(error)
      test::assertEqual(error.code, code)
  end
end

def invalidBytes(bytes: Byte[], offset: Int): Void
  match json::parseBytes(bytes)
    case result::Result.Ok(item)
      test::assertTrue(false)
    case result::Result.Error(error)
      test::assertEqual(error.code, "invalid_utf8")
      test::assertEqual(error.offset, offset)
  end
end

def main(): Void
  let document = "{\"a\":[null,true,false,-0,9007199254740993,1.2300e+9999],\"z\":\"é😀\"}"
  let value = parsed(document)

  test::assertEqual(encoded(value), document)
  test::assertEqual(encoded(parsed(" \r\n\t42 ")), "42")
  test::assertEqual(encoded(parsed("\"\\uD83D\\uDE00\\u0000\\n\\\\\\\"\\/\"")), "\"😀\\u0000\\u000a\\\\\\\"/\"")
  test::assertTrue(json::Value.number("01") == null)
  test::assertTrue(json::Value.number("NaN") == null)

  for input in ["", "01", "+1", "1.", "1e", "1e+", "--1", "NaN", "Infinity", "true false", "[1,]", "{\"a\":1,}", "{a:1}", "\"\\uD800\"", "\"\\uDC00\"", "\"\\uD800\\u0041\"", "\"\\x20\"", "\"\n\"", "\"unterminated", "[", "\"\\u00xz\""]
    failed(input, "invalid_json")
  end
  failed("{\"a\":1,\"\\u0061\":2}", "duplicate_key")
  invalidBytes([255 as Byte], 0)
  invalidBytes([34 as Byte, 65 as Byte, 255 as Byte, 34 as Byte], 2)
  invalidBytes([34 as Byte, 65 as Byte, 226 as Byte, 130 as Byte], 2)
  let inputLimit = new json::Options()

  inputLimit.maxInputBytes = 4

  test::assertEqual(encoded(parsed("null", inputLimit)), "null")

  failed("false", "input_limit", inputLimit)
  let depth = new json::Options()

  depth.maxDepth = 1

  test::assertEqual(encoded(parsed("[0]", depth)), "[0]")

  failed("[[0]]", "depth_limit", depth)
  writeFailed(parsed("[[0]]"), "depth_limit", depth)
  let nodes = new json::Options()

  nodes.maxNodes = 2

  test::assertEqual(encoded(parsed("[0]", nodes)), "[0]")

  failed("[0,1]", "node_limit", nodes)
  writeFailed(parsed("[0,1]"), "node_limit", nodes)
  let output = new json::Options()

  output.maxOutputBytes = 4

  test::assertEqual(encoded(json::Value.nullValue(), output), "null")

  writeFailed(json::Value.boolean(false), "output_limit", output)
  output.maxDepth = 257
  failed("null", "invalid_options", output)
  let object = json::Value.object()

  test::assertTrue(object.put("b", json::Value.boolean(true)))
  test::assertTrue(object.put("a", json::Value.nullValue()))
  test::assertTrue(!object.put("a", json::Value.boolean(false)))
  test::assertEqual(encoded(object), "{\"b\":true,\"a\":null}")
  test::assertTrue(object.get("missing") == null)

  let ordered = json::Value.object()
  var index = 0

  while index < 1000
    let key = text::Scalar.fromInt(1024 + index)

    if key != null
      let name = key.toString()

      if name != null
        test::assertTrue(ordered.put(name, json::Value.boolean(true)))
        test::assertTrue(ordered.get(name) != null)
      end
    end
    index = index + 1
  end

  test::assertEqual(parsed(encoded(ordered)).count(), 1000)

  let cycle = json::Value.array()

  cycle.add(cycle)
  writeFailed(cycle, "depth_limit", depth)
end
