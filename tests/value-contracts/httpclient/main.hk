use host
use http
use httpclient
use result
use test

def requireResponse(outcome: result::Result<httpclient::Response, result::Failure>): httpclient::Response?
  match outcome
    case result::Result.Ok(response)
      return response
    case result::Result.Error(failure)
      test::assertTrue(false)
      return null
  end
end

def main(): Void
  let responseHeaders = new httpclient::Headers()

  test::assertTrue(!responseHeaders.add("bad\"name", "value"))
  let requestHeaders = new http::Headers()

  test::assertTrue(requestHeaders.add("X-Test", "one"))
  test::assertTrue(!httpclient::originTarget("/path#fragment"))
  let encoded = httpclient::encodeRequest(8123, "GET", "/../a%2Fb?q=%E2%82%AC", requestHeaders, null)

  test::assertTrue(encoded != null)
  if encoded != null
    let text = host::stringFromBytes(encoded)

    test::assertTrue(text != null)
    if text != null
      test::assertTrue(http::find(text, "GET /../a%2Fb?q=%E2%82%AC HTTP/1.1\r\n", 0) == 0)
      test::assertTrue(http::find(text, "Host: 127.0.0.1:8123\r\nConnection: close\r\nX-Test: one\r\n", 0) > 0)
    end
  end

  let wire = "HTTP/1.1 200 OK\r\nContent-Length: 3\r\nSet-Cookie: a=1\r\nset-cookie: b=2\r\n\r\n"
  var bytes: Byte[] = []
  var index = 0

  while index < host::stringByteLength(wire)
    bytes = host::appendByte(bytes, host::stringByteAt(wire, index))
    index = index + 1
  end
  bytes = host::appendByte(bytes, 0 as Byte)
  bytes = host::appendByte(bytes, 255 as Byte)
  bytes = host::appendByte(bytes, 10 as Byte)
  let options = new httpclient::Options()
  let response = requireResponse(httpclient::parseResponse(bytes, host::stringByteLength(wire), false, options))

  test::assertTrue(response != null)
  if response != null
    test::assertEqual(response.status, 200)
    test::assertEqual(response.headerValues("SET-cookie").Length, 2)
    test::assertEqual(response.headerValues("set-cookie")[1], "b=2")
    test::assertEqual(response.body.Length, 3)
    test::assertEqual(response.body[0] as Int, 0)
    test::assertEqual(response.body[1] as Int, 255)
  end

  match httpclient::get(0, "/")
    case result::Result.Ok(response)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "invalid_port")
  end

  let noTime = new httpclient::Options()

  noTime.timeoutMilliseconds = 0
  match httpclient::get(1, "/", null, noTime)
    case result::Result.Ok(response)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "invalid_options")
  end

  let tight = new httpclient::Options()

  tight.headerLimit = 8
  match httpclient::parseResponse(bytes, host::stringByteLength(wire), false, tight)
    case result::Result.Ok(response)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "header_limit")
  end

  let malformed = "HTTP/1.1 +20 Bad\r\nContent-Length: +3\r\n\r\nabc"
  var malformedBytes: Byte[] = []

  index = 0
  while index < host::stringByteLength(malformed)
    malformedBytes = host::appendByte(malformedBytes, host::stringByteAt(malformed, index))
    index = index + 1
  end
  match httpclient::parseResponse(malformedBytes, http::find(malformed, "\r\n\r\n", 0) + 4, false, options)
    case result::Result.Ok(response)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "invalid_status")
  end

  let truncated = "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nabc"
  var truncatedBytes: Byte[] = []

  index = 0
  while index < host::stringByteLength(truncated)
    truncatedBytes = host::appendByte(truncatedBytes, host::stringByteAt(truncated, index))
    index = index + 1
  end
  match httpclient::parseResponse(truncatedBytes, http::find(truncated, "\r\n\r\n", 0) + 4, false, options)
    case result::Result.Ok(response)
      test::assertTrue(false)
    case result::Result.Error(failure)
      test::assertEqual(failure.code, "incomplete_body")
  end
end
