use test
use result
use resources

class Journal
  public text: String = ""
end

resource class Handle
  private journal: Journal
  private code: String
  def init(journal: Journal, code: String): Void
    this.journal = journal
    this.code = code
  end
  def close(): result::Failure?
    this.journal.text = this.journal.text + this.code
    return new result::Failure(this.code, "close")
  end
end

def denied(): result::Result<Handle, String>
  return result::Result<Handle, String>.Error("acquisition")
end

def acquireFailure(journal: Journal): resources::Outcome<Int, String>
  using first <- new Handle(journal, "A")
    using second <- new Handle(journal, "B")
      using third <- denied()
        return 7
      end
    end
  end
  return 0
end

def bodyFailure(journal: Journal): resources::Outcome<Int, String>
  using active <- new Handle(journal, "C")
    return "body"
  end
  return 0
end

def priorFailure(journal: Journal): resources::Outcome<Int, String>
  using active <- new Handle(journal, "D")
    let previous = new resources::CloseFailures()

    previous.add(new result::Failure("P", "prior.close"))
    return new resources::Outcome<Int, String>(resources::Completion<Int, String>.Failure("primary"), previous)
  end
  return 0
end

def expectFailure(outcome: resources::Outcome<Int, String>, expected: String, closes: String): Void
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertTrue(false)
    case resources::Completion.Failure(primary)
      test::assertTrue(primary != null)
      if primary != null
        test::assertEqual(primary, expected)
      end
  end
  let collected = new Journal()

  outcome.closeFailures.each() do |failure|
    collected.text = collected.text + failure.code
  end

  test::assertEqual(collected.text, closes)
end

def main(): Void
  let journal = new Journal()

  expectFailure(acquireFailure(journal), "acquisition", "BA")
  expectFailure(bodyFailure(journal), "body", "C")
  expectFailure(priorFailure(journal), "primary", "PD")

  test::assertEqual(journal.text, "BACD")
end
