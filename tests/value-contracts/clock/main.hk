use clock
use test

def assertTimestamp(timestamp: clock::Timestamp, expected: String): Void
  let formatted = timestamp.formatUtc()

  test::assertTrue(formatted != null)
  if formatted != null
    test::assertEqual(formatted, expected)
  end
end

def assertWall(source: clock::WallClock, expected: String): Void
  let timestamp = source.now()

  test::assertTrue(timestamp != null)
  if timestamp != null
    assertTimestamp(timestamp, expected)
  end
end

def main(): Void
  let second = clock::Duration.fromSeconds(1)
  let start = clock::Instant.fromMonotonicMilliseconds(10)

  test::assertTrue(second != null && start != null)
  if second != null && start != null
    let deadline = start.plus(second)

    test::assertTrue(deadline != null)
    if deadline != null
      let duration = deadline.since(start)

      test::assertTrue(duration != null)
      if duration != null
        test::assertEqual(duration.milliseconds(), 1000)
      end

      test::assertTrue(!start.reached(deadline) && deadline.reached(deadline))
      test::assertTrue(start.since(deadline) == null)
    end
  end
  let maximum = clock::Duration.fromMilliseconds(9223372036854775807)
  let one = clock::Duration.fromMilliseconds(1)

  test::assertTrue(maximum != null && one != null)
  if maximum != null && one != null
    test::assertTrue(maximum.plus(one) == null)
  end

  test::assertTrue(clock::Duration.fromSeconds(9223372036854776) == null)
  test::assertTrue(clock::Duration.fromMilliseconds(-1) == null)
  let before = clock::Instant.now()
  let after = clock::Instant.now()

  test::assertTrue(before != null && after != null)
  if before != null && after != null
    test::assertTrue(after.since(before) != null)
  end
  if start != null && one != null && maximum != null
    let fake = new clock::FakeClock(start)
    let source = fake.clock()
    let deadline = start.plus(one)
    let initial = source.now()

    test::assertTrue(initial != null && deadline != null)
    if initial != null && deadline != null
      test::assertTrue(!initial.reached(deadline))
      test::assertTrue(fake.advance(one))
      let reached = source.now()

      test::assertTrue(reached != null)
      if reached != null
        test::assertTrue(reached.reached(deadline))
      end

      test::assertTrue(!fake.advance(maximum))
      let unchanged = source.now()

      test::assertTrue(unchanged != null)
      if unchanged != null
        let difference = unchanged.since(deadline)

        test::assertTrue(difference != null)
        if difference != null
          test::assertEqual(difference.milliseconds(), 0)
        end
      end
    end
  end
  let unavailable: fn(): clock::Instant? = fn()
    return null
  end
  let missing = new clock::Clock(unavailable)

  test::assertTrue(missing.now() == null)
  let system = clock::Clock.monotonic()

  test::assertTrue(system.now() != null)

  let epoch = clock::Timestamp.fromUnixMilliseconds(0)

  test::assertEqual(epoch.unixMilliseconds(), 0)
  assertTimestamp(epoch, "1970-01-01T00:00:00.000Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(-1), "1969-12-31T23:59:59.999Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(951782400000), "2000-02-29T00:00:00.000Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(4107542399999), "2100-02-28T23:59:59.999Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(4107542400000), "2100-03-01T00:00:00.000Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(-62167219200000), "0000-01-01T00:00:00.000Z")
  assertTimestamp(clock::Timestamp.fromUnixMilliseconds(253402300799999), "9999-12-31T23:59:59.999Z")

  test::assertTrue(clock::Timestamp.fromUnixMilliseconds(-62167219200001).formatUtc() == null)
  test::assertTrue(clock::Timestamp.fromUnixMilliseconds(253402300800000).formatUtc() == null)

  let maximumTimestamp = clock::Timestamp.fromUnixMilliseconds(9223372036854775807)

  if one != null
    test::assertTrue(maximumTimestamp.plus(one) == null)
    let fakeWall = new clock::FakeWallClock(epoch)
    let wall = fakeWall.wallClock()

    assertWall(wall, "1970-01-01T00:00:00.000Z")

    test::assertTrue(fakeWall.advance(one))
    assertWall(wall, "1970-01-01T00:00:00.001Z")

    let overflowingFake = new clock::FakeWallClock(maximumTimestamp)
    let overflowingWall = overflowingFake.wallClock()

    test::assertTrue(!overflowingFake.advance(one))
    let unchangedWall = overflowingWall.now()

    test::assertTrue(unchangedWall != null)
    if unchangedWall != null
      test::assertEqual(unchangedWall.unixMilliseconds(), 9223372036854775807)
    end
  end

  let unavailableWall: fn(): clock::Timestamp? = fn()
    return null
  end

  test::assertTrue((new clock::WallClock(unavailableWall)).now() == null)
  let wallNow = clock::WallClock.system().now()

  test::assertTrue(wallNow != null)
  if wallNow != null
    test::assertTrue(wallNow.formatUtc() != null)
  end
end
