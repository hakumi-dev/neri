use test
use host

@cabiImport("llabs")
unsafe def cAbs(value: Int): Int
end

unsafe def unsafeDigits(first: Int, second: Int): Int
  return first * 10 + second
end

class Trace
  public events: String = ""

  def mark(label: String, value: Int): Int
    this.events = this.events + label
    return value
  end
end

def digits(first: Int, second: Int = first + 1, third: Int = second + 1): Int
  return first * 100 + second * 10 + third
end

def choose<T>(fallback: T, value: T): T
  return value
end

def headOr<T>(values: T[], fallback: T): T
  return values.Length > 0 ? values[0] : fallback
end

def traced(trace: Trace, first: Int = trace.mark("d", 2), second: Int = first + 1): Int
  return first * 10 + second
end

class NamedBase
  public number: Int

  def init(first: Int, second: Int = first + 1, third: Int = second + 1): Void
    this.number = first * 100 + second * 10 + third
  end

  def combine(first: Int = 1, second: Int = 2): Int
    return first * 10 + second
  end
end

class NamedDerived: NamedBase
  def init(value: Int): Void
    super(third: value, first: 1)
  end

  override def combine(left: Int = 3, second: Int = 4): Int
    return 100 + left * 10 + second
  end

  def parent(): Int
    return super.combine(second: 8, first: 7)
  end
end

def main(): Void
  let trace = new Trace()
  let value = digits(third: trace.mark("c", 9), first: trace.mark("a", 2))

  test.assertEqual(value, 239)
  test.assertEqual(trace.events, "ca")
  test.assertEqual(digits(1, third: 8), 128)
  test.assertEqual(digits(first: 2), 234)
  test.assertEqual(choose(value: "selected", fallback: "other"), "selected")
  test.assertEqual(headOr(values: [], fallback: 7), 7)
  test.assertEqual(right: "bc", left: host.stringSlice(length: 2, value: "abcd", start: 1))

  let defaultTrace = new Trace()
  let defaultResult = traced(second: defaultTrace.mark("s", 8), trace: defaultTrace)

  test.assertEqual(defaultResult, 28)
  test.assertEqual(defaultTrace.events, "sd")

  let item = new NamedBase(third: 7, first: 2)
  let derived = new NamedDerived(value: 9)
  let base: NamedBase = derived

  test.assertEqual(item.number, 237)
  test.assertEqual(derived.number, 129)
  test.assertEqual(base.combine(second: 8), 118)
  test.assertEqual(derived.combine(second: 8), 138)
  test.assertEqual(derived.parent(), 78)

  unsafe
    test.assertEqual(cAbs(value: -42), 42)
    test.assertEqual(unsafeDigits(second: 8, first: 7), 78)
  end
end
