use test

class Box
  public value: Int = 4
end

enum OptionalValue<T>
  case Value(value: T?)
end

enum Reply<T, E>
  case Value(value: T)
  case Error(error: E?)
end

def intValue(value: Int?): Int
  let wrapped = OptionalValue<Int>.Value(value)
  match wrapped
    case OptionalValue.Value(item)
      if item == null
        return 0
      end
      return item
  end
end

def classValue(value: Box?): Int
  let wrapped = OptionalValue<Box>.Value(value)
  match wrapped
    case OptionalValue.Value(item)
      if item == null
        return 0
      end
      return item.value
  end
end

def main(): Void
  test.assertEqual(intValue(null), 0)
  test.assertEqual(intValue(3), 3)
  test.assertEqual(classValue(null), 0)
  test.assertEqual(classValue(new Box()), 4)
  match OptionalValue<Int>.Value(7)
    case OptionalValue.Value(value)
      test.assertTrue(value != null)
      if value != null
        test.assertEqual(value, 7)
      end
  end
  match Reply<Int, String>.Error("failed")
    case Reply.Value(value)
      test.assertTrue(false)
    case Reply.Error(error)
      test.assertTrue(error != null)
      if error != null
        test.assertEqual(error, "failed")
      end
  end
end
