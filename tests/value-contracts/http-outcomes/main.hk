use http
use host
use result
use test

@cabi("neri_rt_v1_net_connect")
unsafe def connectLocal(fd: Int, port: Int): Int
end

class State
  public client: Int = -1
  public outcome: result.Result<http.Exchange, http.ExchangeFailure>?
end

def exercise(request: String, success: Bool): Void
  let state = new State()
  let stop = new http.Stop()
  let options = new http.Options()
  options.stop = stop
  options.onListening = fn(address)
    unsafe
      state.client = http.netOpen()
      test.assertEqual(connectLocal(state.client, 8080), 0)
      test.assertEqual(http.netConfigure(state.client), 0)
    end
    test.assertTrue(http.writeText(state.client, request))
  end
  options.onConnection = fn(outcome)
    state.outcome = outcome
    stop.request()
  end
  let handler: fn(http.Request): http.Response = fn(request)
    return http.binary(200, [0 as Byte, 255 as Byte])
  end
  match http.serveOutcome("127.0.0.1:8080", handler, options)
    case result.Result.Ok(stopped)
      test.assertTrue(stopped)
    case result.Result.Error(failure)
      test.assertTrue(false)
  end
  let response = http.readHead(state.client)
  test.assertTrue(response.failure == null)
  let outcome = state.outcome
  test.assertTrue(outcome != null)
  if outcome != null
    match outcome
      case result.Result.Ok(exchange)
        test.assertTrue(success)
        test.assertEqual(exchange.bytesRead, host.stringByteLength(request))
        test.assertEqual(exchange.bytesWritten, host.stringByteLength(response.text))
        test.assertEqual(exchange.status, 200)
        unsafe
          let byte = stackalloc Byte[1]
          test.assertEqual(http.netRead(state.client, byte, 1), 0)
        end
      case result.Result.Error(failure)
        test.assertTrue(!success)
        test.assertEqual(failure.cause.code, "unsupported_version")
        test.assertEqual(failure.cause.transferred, host.stringByteLength(request))
        test.assertEqual(failure.exchange.status, 505)
        test.assertTrue(failure.exchange.bytesWritten > host.stringByteLength(response.text))
        test.assertTrue(failure.responseFailure == null && failure.closeFailures.count() == 0)
    end
  end
  unsafe
    http.netClose(state.client)
  end
end

def main(): Void
  let failed = new http.Failure("listen_failed", "listen", "primary")
  failed.closeFailures.add(new result.Failure("first", "socket.close", "detail", 3, 9))
  failed.closeFailures.add(new result.Failure("second", "socket.close"))
  let converted = http.transportFailure(failed, 7)
  test.assertEqual(converted.code, "listen_failed")
  test.assertEqual(converted.transferred, 7)
  let first = converted.closeFailure
  test.assertTrue(first != null)
  if first != null
    test.assertEqual(first.code, "first")
    test.assertEqual(first.detail, "detail")
    test.assertEqual(first.osCode, 9)
    test.assertEqual(first.transferred, 3)
    let second = first.closeFailure
    test.assertTrue(second != null)
    if second != null
      test.assertEqual(second.code, "second")
      test.assertTrue(second.closeFailure == null)
    end
  end
  exercise("HEAD / HTTP/1.1\r\nHost: local\r\n\r\n", true)
  exercise("GET / HTTP/1.0\r\nHost: local\r\n\r\n", false)
end
