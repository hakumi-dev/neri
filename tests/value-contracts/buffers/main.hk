use buffers
use test

class TextState
  public value: String = ""
end

def assertText(actual: String?, expected: String): Void
  test.assertTrue(actual != null)
  if actual != null
    test.assertEqual(actual, expected)
  end
end

def main(): Void
  let created: ByteBuffer? = ByteBuffer.create(12, 2)
  test.assertTrue(created != null)
  if created == null
    return
  end
  let bytes = created
  test.assertTrue(bytes.appendBytes([65 as Byte, 66 as Byte]))
  test.assertEqual(bytes.capacity(), 2)
  test.assertTrue(bytes.appendSlice([88 as Byte, 67 as Byte, 68 as Byte], 1, 2))
  test.assertEqual(bytes.capacity(), 4)
  let saved = bytes.snapshot()
  test.assertTrue(bytes.appendText("é"))
  test.assertEqual(bytes.capacity(), 8)
  test.assertEqual(saved.Length, 4)
  test.assertEqual(saved[0] as Int, 65)
  assertText(bytes.text(), "ABCDé")

  let overlap = ByteBuffer.create(6)
  test.assertTrue(overlap != null)
  if overlap == null
    return
  end
  test.assertTrue(overlap.appendText("abcdef"))
  test.assertTrue(overlap.copyWithin(1, 0, 4))
  assertText(overlap.text(), "aabcdf")
  test.assertTrue(overlap.copyWithin(0, 1, 4))
  assertText(overlap.text(), "abcddf")
  let before = bytes.snapshot()
  test.assertTrue(!bytes.appendSlice([1 as Byte], 2, 1))
  test.assertTrue(!bytes.appendBytes([1 as Byte, 2 as Byte, 3 as Byte, 4 as Byte, 5 as Byte, 6 as Byte, 7 as Byte]))
  test.assertEqual(bytes.snapshot().Length, before.Length)

  let invalidUtf8: ByteBuffer? = ByteBuffer.create(2)
  test.assertTrue(invalidUtf8 != null)
  if invalidUtf8 == null
    return
  end
  test.assertTrue(invalidUtf8.append(255 as Byte))
  test.assertTrue(invalidUtf8.text() == null)
  test.assertTrue(ByteBuffer.create(134217729) == null)
  test.assertTrue(ByteBuffer.create(1, -1) == null)

  let text: TextBuffer? = TextBuffer.create(8, 0)
  test.assertTrue(text != null)
  if text == null
    return
  end
  test.assertTrue(text.append("水"))
  test.assertTrue(text.append("ok"))
  assertText(text.snapshot(), "水ok")
  test.assertTrue(!text.append("more"))
  assertText(text.snapshot(), "水ok")

  let values: Values<String>? = Values<String>.create(3)
  test.assertTrue(values != null)
  if values == null
    return
  end
  test.assertTrue(values.add("one"))
  test.assertTrue(values.add("one"))
  test.assertTrue(values.add("two"))
  test.assertTrue(!values.add("three"))
  test.assertEqual(values.count(), 3)
  let joined = new TextState()
  values.each() do |value|
    joined.value = joined.value + value
  end
  test.assertEqual(joined.value, "oneonetwo")

  let mutating = Values<String>.create(2)
  test.assertTrue(mutating != null)
  if mutating == null
    return
  end
  test.assertTrue(mutating.add("first"))
  mutating.each() do |value|
    mutating.add("later")
  end
  test.assertEqual(mutating.count(), 2)
end
