use console
use files
use host
use process
use result
use test

def findText(value: String, target: String): Int
  var index = 0
  let limit = host::stringByteLength(value) - host::stringByteLength(target)

  while index <= limit
    if host::stringSlice(value, index, host::stringByteLength(target)) == target
      return index
    end
    index = index + 1
  end
  return -1
end

def fixtureOutput(argument: String): String
  let executable = host::executablePath()

  test::assertTrue(executable != null)
  if executable == null
    return ""
  end
  let options = new process::SpawnOptions(executable)

  options.arguments = [argument]
  let completed = process::run(options)

  match completed
    case result::Result.Ok(value)
      let exit = value.exit
      let text = host::stringFromBytes(value.stdout)

      test::assertTrue(exit != null && exit.isExited() && exit.value() == 1)
      test::assertTrue(text != null)
      return text == null ? "" : text
    case result::Result.Error(problem)
      test::assertTrue(false)
      return ""
  end
end

def verifySuite(): Void
  let output = fixtureOutput("--verify")
  let failure = findText(output, "FAIL assertion fails")
  let success = findText(output, "PASS continues afterward")
  let early = findText(output, "FAIL early exit zero")
  let marker = "FIXTURE="
  let start = findText(output, marker)

  test::assertTrue(failure >= 0 && success > failure && early > success)
  test::assertTrue(findText(output, "child exited without completing its case") >= 0)
  test::assertTrue(findText(output, "Assertion failed: expected true.") >= 0)
  test::assertTrue(findText(output, "1 passed, 2 failed, 3 total") >= 0)
  test::assertTrue(findText(output, "stdout:") >= 0 && findText(output, "stderr:") >= 0)
  test::assertTrue(start >= 0)
  if start >= 0
    let pathStart = start + host::stringByteLength(marker)
    var pathEnd = pathStart

    while pathEnd < host::stringByteLength(output) && host::stringByteAt(output, pathEnd) != 10 as Byte
      pathEnd = pathEnd + 1
    end
    let path = host::stringSlice(output, pathStart, pathEnd - pathStart)
    let observed = files::status(path)
    let status = observed.status

    test::assertTrue(observed.failure == null && status != null)
    if status != null
      test::assertTrue(!status.exists)
    end
  end
  let empty = fixtureOutput("--empty")
  let duplicate = fixtureOutput("--duplicate")

  test::assertTrue(findText(empty, "no cases registered") >= 0)
  test::assertTrue(findText(duplicate, "duplicate case name") >= 0)
  console::println("Test suite contracts passed")
end

def main(): Void
  let mode = host::argumentAt(0)

  if mode == null
    verifySuite()
    return
  end
  let suite = new test::Suite("Reporting")

  if mode == "--empty"
    host::exit(suite.run())
    return
  end
  if mode == "--duplicate"
    suite.add("same case") do |context|
    end
    suite.add("same case") do |context|
    end
    host::exit(suite.run())
    return
  end
  suite.add("assertion fails") do |context|
    console::println("FIXTURE=" + context.directory)

    test::assertTrue(false)
  end
  suite.add("continues afterward") do |context|
    console::println("Callback continued")
  end
  suite.add("early exit zero") do |context|
    host::exit(0)
  end
  host::exit(suite.run())
end
