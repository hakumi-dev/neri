use console
use test
use alternatives_library

@cabi("neri_rt_v1_gc_collect")
def unsafe collectGarbage(): Void
end

enum Result<T>
  case Ok(value: T)
  case Error(message: String)
end

enum Signal
  case Continue()
  case Stop()
end

enum Pair<T>
  case Item(value: T)
end

enum Wrapped<T>
  case Value(value: Pair<T>)
end

class Box<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end
end

class Counter
  public calls: Int = 0

  def next(): Result<Int>
    this.calls = this.calls + 1
    return Result<Int>.Ok(this.calls)
  end
end

def choose(value: Int): Result<Box<String>>
  if value == 1
    return Result<Box<String>>.Ok(new Box<String>("kept"))
  end
  return Result<Box<String>>.Error("no")
end

def collect(value: Result<Box<String>>): fn(): String
  match value
    case Result.Ok(box)
      return fn(): String
        unsafe
          collectGarbage()
        end
        return box.value
      end
    case Result.Error(message)
      return fn(): String
        return message
      end
  end
end

def main(): Void
  let callback = collect(choose(1))
  unsafe
    collectGarbage()
  end
  test.assertEqual(callback(), "kept")
  let resultValue = choose(0)
  match resultValue
    case Result.Ok(box)
      test.assertEqual(box.value, "unexpected")
    case Result.Error(message)
      test.assertEqual(message, "no")
  end

  let counter = new Counter()
  match counter.next()
    case Result.Ok(number)
      test.assertEqual(number, 1)
    case Result.Error(message)
      test.assertEqual(message, "unexpected")
  end
  test.assertEqual(counter.calls, 1)

  var selected = ""
  match Result<String>.Ok("merged")
    case Result.Ok(value)
      selected = value
    case Result.Error(message)
      selected = message
  end
  test.assertEqual(selected, "merged")

  let nested = Wrapped<Box<String>>.Value(Pair<Box<String>>.Item(new Box<String>("nested")))
  match nested
    case Wrapped.Value(pair)
      match pair
        case Pair.Item(box)
          test.assertEqual(box.value, "nested")
      end
  end

  var loop = 0
  while loop < 3
    loop = loop + 1
    let signal = loop < 3 ? Signal.Continue() : Signal.Stop()
    match signal
      case Signal.Continue()
        continue
      case Signal.Stop()
        break
    end
  end
  test.assertEqual(loop, 3)
  let carried = 42
  for signal in [Signal.Continue(), Signal.Stop()]
    match signal
      case Signal.Continue()
        let alias = carried
        test.assertEqual(alias, 42)
      case Signal.Stop()
        let alias = carried
        test.assertEqual(alias, 42)
    end
  end
  test.assertEqual(alternatives_library.lexicalMatch(alternatives_library.Result<Int>.Ok(9)), 9)
end
