use crypto
use host
use tasks
use test

def bytesOf(text: String): Byte[]
  var bytes: Byte[] = []
  var index = 0
  while index < host.stringByteLength(text)
    bytes = host.appendByte(bytes, host.stringByteAt(text, index))
    index = index + 1
  end
  return bytes
end

def requireBytes(result: crypto.BytesResult): Byte[]
  test.assertTrue(result.failure() == null)
  let bytes = result.bytes()
  test.assertTrue(bytes != null)
  if bytes != null
    return bytes
  end
  return []
end

def assertDigest(input: Byte[], expected: String): Void
  let digest = requireBytes(crypto.sha256(input))
  let encoded = crypto.encodeHex(digest)
  test.assertTrue(encoded != null)
  if encoded != null
    test.assertEqual(encoded, expected)
  end
end

def assertEncoded(input: Byte[], expected: String): Void
  let encoded = crypto.encodeHex(input)
  test.assertTrue(encoded != null)
  if encoded != null
    test.assertEqual(encoded, expected)
  end
end

def assertFailure(result: crypto.BytesResult, expected: String): Void
  test.assertTrue(result.bytes() == null)
  let failure = result.failure()
  test.assertTrue(failure != null)
  if failure != null
    test.assertEqual(failure.code(), expected)
  end
end

def main(): Void
  assertDigest([], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  assertDigest(bytesOf("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  assertDigest(bytesOf("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  assertDigest([0 as Byte], "6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d")

  let decoded = requireBytes(crypto.decodeHex("00A1fF"))
  test.assertEqual(decoded.Length, 3)
  test.assertTrue(decoded[0] == (0 as Byte) && decoded[1] == (161 as Byte) && decoded[2] == (255 as Byte))
  assertEncoded(decoded, "00a1ff")
  assertFailure(crypto.decodeHex("0"), "invalid_hex")
  assertFailure(crypto.decodeHex("0g"), "invalid_hex")
  assertFailure(crypto.decodeHex("é"), "invalid_hex")
  assertFailure(crypto.decodeHex("0000", 1), "limit_exceeded")
  assertFailure(crypto.decodeHex("", -1), "invalid_limit")

  let deterministicRead: fn(Int): crypto.BytesResult = fn(count: Int)
    let values: Byte[] = tasks.generate(count, 1) do |index|
      return (index + 1) as Byte
    end
    return crypto.BytesResult.success(values)
  end
  let deterministic = new crypto.EntropySource(deterministicRead)
  let generated = requireBytes(deterministic.bytes(3))
  test.assertTrue(generated[0] == (1 as Byte) && generated[1] == (2 as Byte) && generated[2] == (3 as Byte))

  let unavailableRead: fn(Int): crypto.BytesResult = fn(count: Int)
    return crypto.BytesResult.failed("entropy_failed")
  end
  assertFailure((new crypto.EntropySource(unavailableRead)).bytes(16), "entropy_failed")
  let shortRead: fn(Int): crypto.BytesResult = fn(count: Int)
    return crypto.BytesResult.success([])
  end
  assertFailure((new crypto.EntropySource(shortRead)).bytes(1), "invalid_source")
  assertFailure(deterministic.bytes(257), "invalid_length")

  let system = requireBytes(crypto.randomBytes(16))
  test.assertEqual(system.Length, 16)
end
