use result
use resources
use test

class Journal
  public text: String = ""
end

resource class Trace
  public journal: Journal
  public code: String
  public fails: Bool

  public def init(journal: Journal, code: String, fails: Bool): Void
    this.journal = journal
    this.code = code
    this.fails = fails
  end

  public def close(): result.Failure?
    this.journal.text = this.journal.text + this.code
    if this.fails
      return new result.Failure(this.code, "close")
    end
    return null
  end

  public def static acquire(journal: Journal): result.Result<Trace, String>
    let handle = new Trace(journal, "S", false)
    return result.Result<Trace, String>.Ok(transfer handle)
  end
end

def run(journal: Journal): resources.Outcome<Int, String>
  using outer <- new Trace(journal, "A", true)
    using inner <- new Trace(journal, "B", true)
      return 7
    end
  end
  return 0
end

def acquire(journal: Journal): result.Result<Trace, String>
  let handle = new Trace(journal, "C", false)
  return result.Result<Trace, String>.Ok(transfer handle)
end

def useAcquired(journal: Journal): resources.Outcome<Int, String>
  using handle <- acquire(journal)
    return 9
  end
  return 0
end

def useStaticAcquired(journal: Journal): resources.Outcome<Int, String>
  using handle <- Trace.acquire(journal)
    return 10
  end
  return 0
end

def main(): Void
  let journal = new Journal()
  let outcome = run(journal)
  test.assertEqual(journal.text, "BA")
  test.assertEqual(outcome.closeFailures.count(), 2)
  match outcome.completion
    case resources.Completion.Value(value)
      test.assertEqual(value, 7)
    case resources.Completion.Failure(primary)
      test.assertTrue(false)
  end

  let acquiredJournal = new Journal()
  let acquired = useAcquired(acquiredJournal)
  test.assertEqual(acquiredJournal.text, "C")
  test.assertEqual(acquired.closeFailures.count(), 0)

  let staticJournal = new Journal()
  let staticAcquired = useStaticAcquired(staticJournal)
  test.assertEqual(staticJournal.text, "S")
  test.assertEqual(staticAcquired.closeFailures.count(), 0)
end
