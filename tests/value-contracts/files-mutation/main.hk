use files
use host
use resources
use result
use test

@cabiImport("symlink")
unsafe def nativeSymlink(target: Byte*, link: Byte*): Int32
end

@cabiImport("mkfifo")
unsafe def nativeMakeFifo(path: Byte*, mode: Int32): Int32
end

class State
  public path: String = ""
end

def assert(value: files.OperationResult): Void
  test.assertTrue(value.failure == null)
end

def symlink(target: String, link: String): Int
  let targetLength = host.stringByteLength(target)
  let linkLength = host.stringByteLength(link)

  unsafe
    let targetBytes = native.alloc<Byte>(targetLength + 1)
    let linkBytes = native.alloc<Byte>(linkLength + 1)
    var index = 0

    while index < targetLength
      targetBytes[index] = host.stringByteAt(target, index)
      index = index + 1
    end
    targetBytes[targetLength] = 0 as Byte
    index = 0
    while index < linkLength
      linkBytes[index] = host.stringByteAt(link, index)
      index = index + 1
    end
    linkBytes[linkLength] = 0 as Byte
    let result = nativeSymlink(targetBytes, linkBytes) as Int

    native.free(targetBytes)
    native.free(linkBytes)
    return result
  end
end

def makeFifo(path: String): Int
  let length = host.stringByteLength(path)

  unsafe
    let bytes = native.alloc<Byte>(length + 1)
    var index = 0

    while index < length
      bytes[index] = host.stringByteAt(path, index)
      index = index + 1
    end
    bytes[length] = 0 as Byte
    let result = nativeMakeFifo(bytes, 448 as Int32)
    let error = files.fileError()

    native.free(bytes)
    return result == (0 as Int32) ? 0 : -error
  end
end

def mutate(state: State): resources.Outcome<Int, result.Failure>
  using sentinel <- files.TemporaryDirectory.create("neri-sentinel-")
    using temporary <- files.TemporaryDirectory.create("neri-files-")
      state.path = temporary.path()
      let rootStatus = files.status(state.path)
      let rootValue = rootStatus.status

      test.assertTrue(rootStatus.failure == null && rootValue != null)
      if rootValue != null
        test.assertTrue(rootValue.exists && rootValue.kind.isDirectory() && !rootValue.symlink)
      end

      assert(files.createDirectory(state.path + "/nested/child", true))

      test.assertTrue(host.writeBytes(state.path + "/nested/child/source.bin", [1 as Byte, 2 as Byte, 3 as Byte]))
      assert(files.copyFile(state.path + "/nested/child/source.bin", state.path + "/nested/child/copied.bin"))
      let copied = files.status(state.path + "/nested/child/copied.bin").status
      let copiedBytes = files.readBytes(state.path + "/nested/child/copied.bin", 3).bytes

      test.assertTrue(copied != null)
      if copied != null
        test.assertTrue(copied.exists && copied.kind.isFile() && !copied.symlink)
      end

      test.assertTrue(copiedBytes != null)
      if copiedBytes != null
        test.assertEqual(copiedBytes.Length, 3)
        test.assertEqual(copiedBytes[0] as Int, 1)
        test.assertEqual(copiedBytes[2] as Int, 3)
      end
      let existingDirectory = files.createDirectory(state.path + "/nested/child/source.bin", true)

      test.assertTrue(existingDirectory.failure != null)
      assert(files.createDirectory(state.path + "/tree", true))
      test.assertEqual(symlink(sentinel.path(), state.path + "/tree/sentinel-link"), 0)
      let sentinelBefore = files.status(sentinel.path()).status

      test.assertTrue(sentinelBefore != null && sentinelBefore.exists)
      test.assertTrue(files.removeTree(state.path + "/tree/sentinel-link/").failure != null)
      assert(files.removeTree(state.path + "/tree"))
      let sentinelAfter = files.status(sentinel.path()).status

      test.assertTrue(sentinelAfter != null && sentinelAfter.exists && sentinelAfter.kind.isDirectory())
      let fifoPath = state.path + "/nested/child/stream"
      let fifoBefore = files.status(fifoPath).status

      test.assertTrue(fifoBefore != null && !fifoBefore.exists)
      let fifoResult = makeFifo(fifoPath)

      test.assertEqual(fifoResult, 0)
      let fifo = files.status(fifoPath).status

      test.assertTrue(fifo != null && fifo.exists && fifo.kind.isOther())
      let fifoCopy = files.copyFile(fifoPath, state.path + "/nested/child/fifo-copy.bin")

      test.assertTrue(fifoCopy.failure != null)
      assert(files.move(state.path + "/nested/child/copied.bin", state.path + "/nested/child/moved.bin"))
      let old = files.status(state.path + "/nested/child/copied.bin").status
      let moved = files.status(state.path + "/nested/child/moved.bin").status

      test.assertTrue(old != null && moved != null)
      if old != null && moved != null
        test.assertTrue(!old.exists && moved.exists)
      end

      assert(files.removeFile(state.path + "/nested/child/moved.bin"))
      assert(files.removeFile(state.path + "/nested/child/source.bin"))
      assert(files.removeFile(fifoPath))
      assert(files.removeDirectory(state.path + "/nested/child"))
      return 0
    end
  end
  return 1
end

def main(): Void
  let state = new State()
  let completed = mutate(state)

  test.assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources.Completion.Value(value)
      test.assertEqual(value, 0)
    case resources.Completion.Failure(problem)
      test.assertTrue(false)
  end
  let removed = files.status(state.path).status

  test.assertTrue(removed != null)
  if removed != null
    test.assertTrue(!removed.exists && removed.kind.isMissing())
  end
end
