use files
use host
use test

def dataContractWrite(path: String, value: String): Void
  test::assertTrue(host::writeText(path, value))
end

def dataContractFileEquals(path: String, expected: String): Bool
  let actual = host::readText(path)

  return actual != null && actual == expected
end

def dataContractPathAbsent(path: String): Bool
  let inspected = files::status(path)

  if inspected.failure != null
    return false
  end
  let status = inspected.status

  if status == null
    return true
  end
  return !status.exists
end

def dataContractEntities(): String
  return "namespace model\n\nclass EntityBase\n  public id: Int\n\n  def init(id: Int): Void\n    this.id = id\n  end\nend\n\nclass FloatRecord\n  public id: Int\n  public amount: Float\n  public optionalAmount: Float?\n\n  def init(id: Int, amount: Float, optionalAmount: Float?): Void\n    this.id = id\n    this.amount = amount\n    this.optionalAmount = optionalAmount\n  end\nend\n\nclass Customer: EntityBase\n  public query: Bool\n  public predicate_name: String\n  public name: String?\n  public init: String\n  public orders: Order[]\n  public optionalOrders: OptionalOrder[]\n\n  def init(id: Int, query: Bool, predicate_name: String, name: String?, init: String): Void\n    super(id)\n    this.query = query\n    this.predicate_name = predicate_name\n    this.name = name\n    this.init = init\n    this.orders = []\n    this.optionalOrders = []\n  end\nend\n\nclass Order\n  public id: Int\n  public customerId: Int\n  public total: Int\n  public customer: Customer?\n\n  def init(id: Int, customerId: Int, total: Int): Void\n    this.id = id\n    this.customerId = customerId\n    this.total = total\n    this.customer = null\n  end\nend\n"
end

def dataContractFloatMapping(keyByFloat: Bool = false): String
  let key = keyByFloat ? "amount" : "id"

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"float_data\",\"context\":\"FloatDatabase\",\"output\":\"generated-float\",\"entities\":[{\"type\":\"model.FloatRecord\",\"set\":\"records\",\"table\":\"float_records\",\"key\":\"" + key + "\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"amount\",\"column\":\"amount\"},{\"member\":\"optionalAmount\",\"column\":\"optional_amount\"}]}]}\n"
end

def dataContractOptionalEntities(): String
  return "\nclass OptionalOrder\n  public id: Int\n  public customerId: Int?\n  public customer: Customer?\n\n  def init(id: Int, customerId: Int?): Void\n    this.id = id\n    this.customerId = customerId\n    this.customer = null\n  end\nend\n\nclass Tag\n  public code: String\n  public entries: OptionalTagEntry[]\n\n  def init(code: String): Void\n    this.code = code\n    this.entries = []\n  end\nend\n\nclass OptionalTagEntry\n  public id: Int\n  public tagCode: String?\n  public tag: Tag?\n\n  def init(id: Int, tagCode: String?): Void\n    this.id = id\n    this.tagCode = tagCode\n    this.tag = null\n  end\nend\n"
end

def dataContractMapping(deleteBehaviorJson: String = "", extraEntity: String = ""): String
  let deleteBehavior = deleteBehaviorJson == "" ? "" : ",\"deleteBehavior\":" + deleteBehaviorJson
  let inserted = extraEntity == "" ? "" : "," + extraEntity

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Customer\",\"set\":\"customers\",\"table\":\"customers\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"query\",\"column\":\"query\"},{\"member\":\"predicate_name\",\"column\":\"predicate_name\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"init\",\"column\":\"init\"}]},{\"type\":\"model.Order\",\"set\":\"orders\",\"table\":\"orders\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"customerId\",\"column\":\"customer_id\"},{\"member\":\"total\",\"column\":\"total\"}]}" + inserted + "],\"relations\":[{\"principal\":\"model.Customer\",\"dependent\":\"model.Order\",\"key\":\"id\",\"foreignKey\":\"customerId\"" + deleteBehavior + "}]}\n"
end

def dataContractGeneratedMapping(): String
  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Customer\",\"set\":\"customers\",\"table\":\"customers\",\"key\":\"id\",\"keyGeneration\":\"onAdd\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"query\",\"column\":\"query\"},{\"member\":\"predicate_name\",\"column\":\"predicate_name\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"init\",\"column\":\"init\"}]}]}\n"
end

def dataContractNavigationMapping(collection: String, reference: String, includeReference: Bool = true): String
  let inverse = includeReference ? ",\"reference\":\"" + reference + "\"" : ""

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Customer\",\"set\":\"customers\",\"table\":\"customers\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"query\",\"column\":\"query\"},{\"member\":\"predicate_name\",\"column\":\"predicate_name\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"init\",\"column\":\"init\"}]},{\"type\":\"model.Order\",\"set\":\"orders\",\"table\":\"orders\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"customerId\",\"column\":\"customer_id\"},{\"member\":\"total\",\"column\":\"total\"}]}],\"relations\":[{\"principal\":\"model.Customer\",\"dependent\":\"model.Order\",\"key\":\"id\",\"foreignKey\":\"customerId\",\"collection\":\"" + collection + "\"" + inverse + "}]}\n"
end

def dataContractOptionalIntMapping(deleteBehaviorJson: String = ""): String
  let policy = deleteBehaviorJson == "" ? "" : ",\"deleteBehavior\":" + deleteBehaviorJson

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"OptionalDatabase\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Customer\",\"set\":\"customers\",\"table\":\"customers\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"query\",\"column\":\"query\"},{\"member\":\"predicate_name\",\"column\":\"predicate_name\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"init\",\"column\":\"init\"}]},{\"type\":\"model.OptionalOrder\",\"set\":\"optionalOrders\",\"table\":\"optional_orders\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"customerId\",\"column\":\"customer_id\"}]}],\"relations\":[{\"principal\":\"model.Customer\",\"dependent\":\"model.OptionalOrder\",\"key\":\"id\",\"foreignKey\":\"customerId\",\"collection\":\"optionalOrders\",\"reference\":\"customer\"" + policy + "}]}\n"
end

def dataContractOptionalStringMapping(wrongType: Bool = false, deleteBehaviorJson: String = ""): String
  let dependent = wrongType ? "model.OptionalOrder" : "model.OptionalTagEntry"
  let field = wrongType ? "customerId" : "tagCode"
  let table = wrongType ? "optional_orders" : "tag_entries"
  let policy = deleteBehaviorJson == "" ? "" : ",\"deleteBehavior\":" + deleteBehaviorJson

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"TagDatabase\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Tag\",\"set\":\"tags\",\"table\":\"tags\",\"key\":\"code\",\"columns\":[{\"member\":\"code\",\"column\":\"code\"}]},{\"type\":\"" + dependent + "\",\"set\":\"entries\",\"table\":\"" + table + "\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"" + field + "\",\"column\":\"foreign_key\"}]}],\"relations\":[{\"principal\":\"model.Tag\",\"dependent\":\"" + dependent + "\",\"key\":\"code\",\"foreignKey\":\"" + field + "\"" + (wrongType ? "" : ",\"collection\":\"entries\",\"reference\":\"tag\"") + policy + "}]}\n"
end

def dataContractManifest(): String
  return "{\"version\":2,\"defaultUnit\":\"contract\",\"units\":{\"runtime\":{\"kind\":\"library\",\"sources\":[\"runtime.hk\",\"translation.hk\",\"scalars.hk\",\"persistence.hk\",\"graph-registration.hk\",\"bulk.hk\",\"diagnostics.hk\",\"migrations.hk\",\"schema-model.hk\",\"schema-diff.hk\",\"joins.hk\",\"join-composition.hk\",\"joined-projections.hk\",\"projections.hk\",\"aggregates.hk\",\"group-composition.hk\",\"streaming.hk\",\"loading.hk\",\"reference-loading.hk\",\"navigation-paths.hk\",\"navigation-query.hk\"]},\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]},\"data\":{\"kind\":\"library\",\"sources\":[\"bridge.hk\"],\"generated\":[\"generated/manifest.json\"],\"references\":[\"entities\",\"runtime\"]},\"contract\":{\"kind\":\"executable\",\"sources\":[\"contract.hk\"],\"references\":[\"data\"]},\"link-contract\":{\"kind\":\"executable\",\"sources\":[\"link-contract.hk\"],\"references\":[\"data\"]},\"wrong-link\":{\"kind\":\"executable\",\"sources\":[\"wrong-link.hk\"],\"references\":[\"data\"]},\"wrong-label\":{\"kind\":\"executable\",\"sources\":[\"wrong-label.hk\"],\"references\":[\"data\"]},\"wrong-type\":{\"kind\":\"executable\",\"sources\":[\"wrong-type.hk\"],\"references\":[\"data\"]},\"cross-entity\":{\"kind\":\"executable\",\"sources\":[\"cross-entity.hk\"],\"references\":[\"data\"]},\"immutable-plan\":{\"kind\":\"executable\",\"sources\":[\"immutable-plan.hk\"],\"references\":[\"runtime\"]}}}\n"
end

def dataContractLinkProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let schema = schema_Database()\n\n  test::assertEqual(schema.count(), 2)\n  test::assertTrue(schema.validate() == null)\n  test::assertEqual(schema.signature(), schema_Database().signature())\n  let customers = schema.find(\"model.Customer\")\n\n  test::assertTrue(customers != null)\n  if customers != null\n    test::assertEqual(customers.name(), \"customers\")\n    test::assertEqual(customers.count(), 5)\n    let id = customers.find(\"model.EntityBase.id\")\n\n    test::assertTrue(id != null)\n    if id != null\n      test::assertEqual(id.column().name(), \"id\")\n      test::assertTrue(id.column().primaryKey())\n    end\n    let name = customers.find(\"model.Customer.name\")\n\n    test::assertTrue(name != null)\n    if name != null\n      test::assertTrue(name.column().nullable())\n    end\n  end\n  let db = new Database()\n  let customer = new Customer(7, false, \"p\", null, \"ready\")\n  let order = new Order(2, 0, 5)\n  match db.customers.addWithHandle(customer)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(principal)\n      match db.orders.addWithHandle(order)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(dependent)\n          test::assertTrue(db.link_ordersFor_Customer_by_customerId(principal, dependent) == null)\n      end\n  end\nend\n"
end

def dataContractCascadeProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new Database()\n  match db.customers.addWithHandle(new Customer(7, false, \"p\", null, \"ready\"))\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(principal)\n      match db.customers.addWithHandle(new Customer(8, false, \"q\", null, \"ready\"))\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(replacement)\n          match db.orders.addWithHandle(new Order(2, 0, 5))\n            case TrackHandleResult.Failure(error)\n              test::assertTrue(false)\n            case TrackHandleResult.Tracked(dependent)\n              test::assertTrue(db.link_ordersFor_Customer_by_customerId(principal, dependent) == null)\n              test::assertTrue(db.reassign_ordersFor_Customer_by_customerId(replacement, dependent) == null)\n              test::assertTrue(db.unlink_ordersFor_Customer_by_customerId(dependent) == null)\n              test::assertTrue(db.removeCascade_customers(principal) == null)\n          end\n      end\n  end\nend\n"
end

def dataContractOptionalIntLinkProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new OptionalDatabase()\n  let parent = new Customer(7, false, \"p\", null, \"ready\")\n  let child = new OptionalOrder(2, null)\n  match db.customers.addWithHandle(parent)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(principal)\n      match db.optionalOrders.addWithHandle(child)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(dependent)\n          test::assertTrue(db.link_optionalOrdersFor_Customer_by_customerId(principal, dependent) == null)\n      end\n  end\n  let value = child.customerId\n\n  test::assertTrue(value != null)\n  if value != null\n    test::assertEqual(value, 7)\n  end\nend\n"
end

def dataContractOptionalStringLinkProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new TagDatabase()\n  let parent = new Tag(\"O'Reilly; -- 水\")\n  let child = new OptionalTagEntry(2, null)\n  match db.tags.addWithHandle(parent)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(principal)\n      match db.entries.addWithHandle(child)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(dependent)\n          test::assertTrue(db.link_entriesFor_Tag_by_tagCode(principal, dependent) == null)\n      end\n  end\n  let value = child.tagCode\n\n  test::assertTrue(value != null)\n  if value != null\n    test::assertEqual(value, \"O'Reilly; -- 水\")\n  end\nend\n"
end

def dataContractOptionalIntReassignProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new OptionalDatabase()\n  let first = new Customer(7, false, \"p\", null, \"ready\")\n  let second = new Customer(8, false, \"q\", null, \"ready\")\n  let child = new OptionalOrder(2, null)\n  match db.customers.addWithHandle(first)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(oldPrincipal)\n      match db.customers.addWithHandle(second)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(newPrincipal)\n          match db.optionalOrders.addWithHandle(child)\n            case TrackHandleResult.Failure(error)\n              test::assertTrue(false)\n            case TrackHandleResult.Tracked(dependent)\n              test::assertTrue(db.link_optionalOrdersFor_Customer_by_customerId(oldPrincipal, dependent) == null)\n              test::assertTrue(db.reassign_optionalOrdersFor_Customer_by_customerId(newPrincipal, dependent) == null)\n              let changed = child.customerId\n\n              test::assertTrue(changed != null)\n              if changed != null\n                test::assertEqual(changed, 8)\n              end\n              test::assertTrue(db.unlink_optionalOrdersFor_Customer_by_customerId(dependent) == null)\n              test::assertTrue(child.customerId == null)\n          end\n      end\n  end\nend\n"
end

def dataContractOptionalStringReassignProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new TagDatabase()\n  let first = new Tag(\"A\")\n  let second = new Tag(\"O'Reilly; -- 水\")\n  let child = new OptionalTagEntry(2, null)\n  match db.tags.addWithHandle(first)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(oldPrincipal)\n      match db.tags.addWithHandle(second)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(newPrincipal)\n          match db.entries.addWithHandle(child)\n            case TrackHandleResult.Failure(error)\n              test::assertTrue(false)\n            case TrackHandleResult.Tracked(dependent)\n              test::assertTrue(db.link_entriesFor_Tag_by_tagCode(oldPrincipal, dependent) == null)\n              test::assertTrue(db.reassign_entriesFor_Tag_by_tagCode(newPrincipal, dependent) == null)\n              let changed = child.tagCode\n\n              test::assertTrue(changed != null)\n              if changed != null\n                test::assertEqual(changed, \"O'Reilly; -- 水\")\n              end\n              test::assertTrue(db.unlink_entriesFor_Tag_by_tagCode(dependent) == null)\n              test::assertTrue(child.tagCode == null)\n          end\n      end\n  end\nend\n"
end

