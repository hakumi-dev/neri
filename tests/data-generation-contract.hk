def dataContractRequiredReassignProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse test\n\ndef main(): Void\n  let db = new Database()\n  let first = new Customer(7, false, \"p\", null, \"ready\")\n  let second = new Customer(8, false, \"q\", null, \"ready\")\n  let child = new Order(2, 0, 5)\n  match db.customers.addWithHandle(first)\n    case TrackHandleResult.Failure(error)\n      test::assertTrue(false)\n    case TrackHandleResult.Tracked(oldPrincipal)\n      match db.customers.addWithHandle(second)\n        case TrackHandleResult.Failure(error)\n          test::assertTrue(false)\n        case TrackHandleResult.Tracked(newPrincipal)\n          match db.orders.addWithHandle(child)\n            case TrackHandleResult.Failure(error)\n              test::assertTrue(false)\n            case TrackHandleResult.Tracked(dependent)\n              test::assertTrue(db.link_ordersFor_Customer_by_customerId(oldPrincipal, dependent) == null)\n              test::assertTrue(db.reassign_ordersFor_Customer_by_customerId(newPrincipal, dependent) == null)\n          end\n      end\n  end\n  test::assertEqual(child.customerId, 8)\nend\n"
end

def dataContractProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse quotation\nuse test\n\nclass RowsProvider: Provider\n  public override readonly def dialect(): SqlDialect\n    return SqlDialect.QuestionMark()\n  end\n  public override readonly def supports(capability: ProviderCapability): Bool\n    return true\n  end\n  public override def execute(plan: readonly SqlPlan): ProviderResult\n    return ProviderResult.Rows([new RawRow([new RawColumn(\"id\", Cell.Int(7)), new RawColumn(\"query\", Cell.Bool(false)), new RawColumn(\"predicate_name\", Cell.Text(\"p\")), new RawColumn(\"name\", Cell.Null()), new RawColumn(\"init\", Cell.Text(\"ready\"))])])\n  end\n  public override def writeBatch(batch: readonly WriteBatch): WriteResult\n    return WriteResult.Failure(WriteFailure.Unsupported(\"read-only provider\"))\n  end\nend\n\ndef main(): Void\n  let db = new Database()\n  match db.customers.take(2).compile()\n    case CompileResult.Plan(plan)\n      test::assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"id\\\", \\\"customers\\\".\\\"query\\\", \\\"customers\\\".\\\"predicate_name\\\", \\\"customers\\\".\\\"name\\\", \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" LIMIT 2\")\n    case CompileResult.Failure(error)\n      test::assertTrue(false)\n  end\n  let filtered = db.customers.where(query: false, name: null).take(2)\n  match filtered.compile()\n    case CompileResult.Plan(plan)\n      test::assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"id\\\", \\\"customers\\\".\\\"query\\\", \\\"customers\\\".\\\"predicate_name\\\", \\\"customers\\\".\\\"name\\\", \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" WHERE (\\\"customers\\\".\\\"query\\\" = ? AND \\\"customers\\\".\\\"name\\\" IS NULL) LIMIT 2\")\n      let first = plan.sql().parameters().first()\n\n      test::assertTrue(first != null)\n      if first != null\n        match first.value()\n          case Parameter.Bool(value)\n            test::assertFalse(value)\n          case Parameter.Float(value)\n            test::assertTrue(false)\n          case Parameter.Int(value)\n            test::assertTrue(false)\n          case Parameter.Text(value)\n            test::assertTrue(false)\n        end\n      end\n    case CompileResult.Failure(error)\n      test::assertTrue(false)\n  end\n  match filtered.all(new RowsProvider())\n    case QueryResult.Rows(rows)\n      let first = rows.first()\n\n      test::assertTrue(first != null)\n      if first != null\n        test::assertEqual(first.value.init, \"ready\")\n        let snapshot = snapshot_Customer(first.value).pack()\n\n        test::assertEqual(snapshot.count(), 5)\n        let captured = snapshot.entryAt(4)\n\n        test::assertTrue(captured != null)\n        if captured != null\n          match captured.value()\n            case CaptureValue.Text(value)\n              test::assertEqual(value, \"ready\")\n            case CaptureValue.Bool(value)\n              test::assertTrue(false)\n            case CaptureValue.Float(value)\n              test::assertTrue(false)\n            case CaptureValue.Int(value)\n              test::assertTrue(false)\n            case CaptureValue.Null()\n              test::assertTrue(false)\n          end\n        end\n        match db.ordersFor_Customer_by_customerId(first.value).take(1).compile()\n          case CompileResult.Plan(plan)\n            test::assertEqual(plan.sql().sql(), \"SELECT \\\"orders\\\".\\\"id\\\", \\\"orders\\\".\\\"customer_id\\\", \\\"orders\\\".\\\"total\\\" FROM \\\"orders\\\" WHERE \\\"orders\\\".\\\"customer_id\\\" = ? LIMIT 1\")\n          case CompileResult.Failure(error)\n            test::assertTrue(false)\n        end\n      end\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n  end\n  let projected = select(filtered, textScalar()) do |customer|\n    return customer.init\n  end\n  match projected.compile()\n    case CompileResult.Plan(plan)\n      test::assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" WHERE (\\\"customers\\\".\\\"query\\\" = ? AND \\\"customers\\\".\\\"name\\\" IS NULL) LIMIT 2\")\n    case CompileResult.Failure(error)\n      test::assertTrue(false)\n  end\nend\n"
end

def dataContractRun(compiler: String, project: String, unit: String): Int
  let result = host::run(compiler, ["run", "--project", project, "--unit", unit])

  if result != null
    return result
  end
  return -1
end

def dataContractCheck(compiler: String, project: String, unit: String, output: String): Int
  let result = host::run(compiler, ["check", "--project", project, "--unit", unit, "--emit=obj", "--output", output])

  if result != null
    return result
  end
  return -1
end

def dataContractHasOrigin(emission: DataEmission, identity: String, emittedText: String): Bool
  var artifact = emission.firstArtifact

  while artifact != null
    let sourceMap = new IrSourceMap(artifact.text)
    var emitted = artifact.firstOrigin

    while emitted != null
      if emitted.origin.identity == identity
        let start = sourceMap.offsetAt(emitted.start)
        let finish = sourceMap.offsetAt(emitted.start + emitted.length)

        if host::stringSlice(artifact.text, start, finish - start) == emittedText
          return true
        end
      end
      emitted = emitted.nextOrigin
    end
    artifact = artifact.nextArtifact
  end
  return false
end

def dataContractArtifact(emission: DataEmission, name: String): DataArtifact?
  var artifact = emission.firstArtifact

  while artifact != null
    if artifact.name == name
      return artifact
    end
    artifact = artifact.nextArtifact
  end
  return null
end

def dataContractObsoleteRoot(mapping: DataMapping, artifact: DataArtifact): Void
  let revision = sha256FastText("legacy-generation")
  let directory = mapping.outputPath + "/" + revision
  let legacyName = "entity_0.hk"

  test::assertTrue(files::createDirectory(directory, true).failure == null)
  dataContractWrite(directory + "/" + legacyName, artifact.text)
  let output = dataRelativePath(mapping.projectRoot, directory + "/" + legacyName)
  let manifest = "{\"version\":1,\"generator\":\"neri-data\",\"generatorVersion\":\"1\",\"inputs\":[],\"outputs\":[{\"path\":" + lspQuote(output) + ",\"sha256\":\"" + sha256FastText(artifact.text) + "\"}],\"origins\":[]}\n"

  dataContractWrite(mapping.outputPath + "/manifest.json", manifest)
  dataContractWrite(directory + "/unowned.hk", "preserve me\n")
end

def dataContractContains(source: String, value: String): Bool
  let sourceLength = host::stringByteLength(source)
  let valueLength = host::stringByteLength(value)
  var offset = 0

  while offset + valueLength <= sourceLength
    if host::stringSlice(source, offset, valueLength) == value
      return true
    end
    offset = offset + 1
  end
  return false
end

def main(): Void
  let root = host::argumentAt(0)

  test::assertTrue(root != null)
  if root == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "data-generation-contract")

  test::assertTrue(temporary != null)
  if temporary == null
    return
  end
  let created = files::createDirectory(temporary + "/generated", true)

  test::assertTrue(created.failure == null)
  for name in ["runtime.hk", "translation.hk", "scalars.hk", "persistence.hk", "graph-registration.hk", "bulk.hk", "diagnostics.hk", "migrations.hk", "schema-model.hk", "schema-diff.hk", "joins.hk", "join-composition.hk", "joined-projections.hk", "projections.hk", "aggregates.hk", "group-composition.hk", "streaming.hk", "loading.hk", "reference-loading.hk", "navigation-paths.hk", "navigation-query.hk"]
    let source = host::readText(root + "/experiments/neri-data/" + name)

    test::assertTrue(source != null)
    if source == null
      return
    end
    dataContractWrite(temporary + "/" + name, source)
  end
  dataContractWrite(temporary + "/entities.hk", dataContractEntities() + dataContractOptionalEntities())
  dataContractWrite(temporary + "/bridge.hk", "namespace app_data\n")
  dataContractWrite(temporary + "/mapping.json", dataContractMapping())
  dataContractWrite(temporary + "/manifest.json", dataContractManifest())
  dataContractWrite(temporary + "/contract.hk", dataContractProgram())
  dataContractWrite(temporary + "/link-contract.hk", dataContractLinkProgram())
  dataContractWrite(temporary + "/wrong-link.hk", dataContractWrongLinkProgram())
  dataContractWrite(temporary + "/wrong-label.hk", "use app_data\ndef main(): Void\n  let value = (new Database()).customers.where(missing: true)\nend\n")
  dataContractWrite(temporary + "/wrong-type.hk", "use app_data\ndef main(): Void\n  let value = (new Database()).customers.where(query: 1)\nend\n")
  dataContractWrite(temporary + "/cross-entity.hk", "use app_data\nuse model\ndef main(): Void\n  let db = new Database()\n  let predicate: quote fn(Order): Bool = quote do |order: Order|: Bool\n    return order.id == 1\n  end\n  let value = db.customers.matching(predicate)\nend\n")
  dataContractWrite(temporary + "/immutable-plan.hk", "use neri_data\ndef mutate(plan: readonly SqlPlan): Void\n  plan.limit = 2\nend\n\ndef main(): Void\nend\n")
  let mapping = dataLoadMapping(temporary + "/mapping.json")

  test::assertEqual(mapping.error, "")
  let emission = dataEmit(mapping)

  test::assertEqual(emission.error, "")
  var artifactCount = 0
  var schemaArtifact = false
  var emittedArtifact = emission.firstArtifact

  while emittedArtifact != null
    artifactCount = artifactCount + 1
    schemaArtifact = true if emittedArtifact.name == "schema.hk"
    emittedArtifact = emittedArtifact.nextArtifact
  end

  test::assertEqual(artifactCount, 5)
  test::assertTrue(schemaArtifact)
  let customerArtifact = dataContractArtifact(emission, "Customer.entity.hk")
  let orderArtifact = dataContractArtifact(emission, "Order.entity.hk")

  test::assertTrue(customerArtifact != null)
  test::assertTrue(orderArtifact != null)
  test::assertTrue(dataContractArtifact(emission, "entity_0.hk") == null)
  if customerArtifact != null && orderArtifact != null
    let customer = mapping.firstEntity

    if customer != null
      let order = customer.nextEntity

      if order != null
        mapping.firstEntity = order
        order.nextEntity = customer
        customer.nextEntity = null
        let reordered = dataEmit(mapping)

        customer.nextEntity = order
        order.nextEntity = null
        mapping.firstEntity = customer

        test::assertEqual(reordered.error, "")
        let reorderedCustomer = dataContractArtifact(reordered, "Customer.entity.hk")
        let reorderedOrder = dataContractArtifact(reordered, "Order.entity.hk")

        test::assertTrue(reorderedCustomer != null)
        test::assertTrue(reorderedOrder != null)
        if reorderedCustomer != null && reorderedOrder != null
          test::assertEqual(reorderedCustomer.text, customerArtifact.text)
          test::assertEqual(reorderedOrder.text, orderArtifact.text)
        end
      end
    end
    let tagEntity = "{\"type\":\"model.Tag\",\"set\":\"tags\",\"table\":\"tags\",\"key\":\"code\",\"columns\":[{\"member\":\"code\",\"column\":\"code\"}]}"

    dataContractWrite(temporary + "/inserted-mapping.json", dataContractMapping(extraEntity: tagEntity))
    let insertedMapping = dataLoadMapping(temporary + "/inserted-mapping.json")

    test::assertEqual(insertedMapping.error, "")
    let insertedEmission = dataEmit(insertedMapping)

    test::assertEqual(insertedEmission.error, "")
    let insertedCustomer = dataContractArtifact(insertedEmission, "Customer.entity.hk")
    let insertedOrder = dataContractArtifact(insertedEmission, "Order.entity.hk")

    test::assertTrue(insertedCustomer != null)
    test::assertTrue(insertedOrder != null)
    test::assertTrue(dataContractArtifact(insertedEmission, "Tag.entity.hk") != null)
    if insertedCustomer != null && insertedOrder != null
      test::assertEqual(insertedCustomer.text, customerArtifact.text)
      test::assertEqual(insertedOrder.text, orderArtifact.text)
    end
  end

  test::assertTrue(dataContractHasOrigin(emission, "field:model.EntityBase.id", "\"model.EntityBase.id\""))
  test::assertTrue(dataContractHasOrigin(emission, "field:model.Customer.query", "\"model.Customer.query\""))
  test::assertTrue(dataContractHasOrigin(emission, "field:model.Customer.init", "init"))
  test::assertTrue(dataContractHasOrigin(emission, "field:model.Order.customerId", "ordersFor_Customer_by_customerId"))
  test::assertTrue(dataContractHasOrigin(emission, "field:model.Order.customerId", "link_ordersFor_Customer_by_customerId"))
  dataContractWrite(temporary + "/float-mapping.json", dataContractFloatMapping())
  let floatMapping = dataLoadMapping(temporary + "/float-mapping.json")

  test::assertEqual(floatMapping.error, "")
  let floatEmission = dataEmit(floatMapping)

  test::assertEqual(floatEmission.error, "")
  var floatArtifacts = ""
  var floatArtifact = floatEmission.firstArtifact

  while floatArtifact != null
    floatArtifacts = floatArtifacts + floatArtifact.text
    floatArtifact = floatArtifact.nextArtifact
  end

  test::assertTrue(dataContractContains(floatArtifacts, "decodeFloat"))
  test::assertTrue(dataContractContains(floatArtifacts, "decodeNullableFloat"))
  test::assertTrue(dataContractContains(floatArtifacts, "ResultColumnKind.Float()"))
  test::assertTrue(dataContractContains(floatArtifacts, "Cell.Float("))
  test::assertTrue(dataContractContains(floatArtifacts, "cellOptionalFloat("))
  dataContractWrite(temporary + "/float-key-mapping.json", dataContractFloatMapping(true))
  let floatKeyMapping = dataLoadMapping(temporary + "/float-key-mapping.json")

  test::assertTrue(floatKeyMapping.error != "")
  let orderEntity = mapping.firstEntity

  if orderEntity != null
    let originalSet = orderEntity.setName

    orderEntity.setName = "removeCascade_orders"
    let cascadeNameCollision = dataEmit(mapping)

    test::assertTrue(cascadeNameCollision.error != "")
    orderEntity.setName = originalSet
    let next = orderEntity.nextEntity

    if next != null
      let originalName = next.generatedName

      next.generatedName = "customer"
      let casefoldCollision = dataEmit(mapping)

      test::assertTrue(casefoldCollision.error != "")
      next.generatedName = originalName
    end
  end
  mapping.contextName = "mappingEntity_8_Customer"
  let collision = dataEmit(mapping)

  test::assertTrue(collision.error != "")
  mapping.contextName = "capture_Customer"
  let captureCollision = dataEmit(mapping)

  test::assertTrue(captureCollision.error != "")
  mapping.contextName = "apply_Customer"
  let applyCollision = dataEmit(mapping)

  test::assertTrue(applyCollision.error != "")
  mapping.contextName = "Database"
  let firstEntity = mapping.firstEntity

  if firstEntity != null
    let originalSet = firstEntity.setName

    firstEntity.setName = "init"
    let constructorCollision = dataEmit(mapping)

    test::assertTrue(constructorCollision.error != "")
    firstEntity.setName = "changes"
    let trackingCollision = dataEmit(mapping)

    test::assertTrue(trackingCollision.error != "")
    for reserved in ["clear", "beginTransaction", "commitTransaction", "rollbackTransaction"]
      firstEntity.setName = reserved
      let transactionCollision = dataEmit(mapping)

      test::assertTrue(transactionCollision.error != "")
    end
    firstEntity.setName = originalSet
  end

  test::assertTrue(dataPublish(mapping, emission))
  let firstOutput = mapping.outputPath + "/Customer.entity.hk"
  let firstManifest = host::readText(mapping.outputPath + "/manifest.json")
  var expectedCustomerText = ""

  if customerArtifact != null
    expectedCustomerText = customerArtifact.text
  end

  test::assertTrue(firstManifest != null)
  if firstManifest != null
    test::assertTrue(dataContractContains(firstManifest, "\"generatorVersion\": \"2\""))
    test::assertTrue(dataContractContains(firstManifest, "\"path\": \"generated/Customer.entity.hk\""))
  end

  let ordinaryOutput = mapping.outputPath
  let lock = bootstrapDirectory(ordinaryOutput) + "/.neri-data-lock-" + sha256FastText(ordinaryOutput)

  test::assertTrue(files::createDirectory(lock).failure == null)
  test::assertTrue(!dataPublish(mapping, emission))
  test::assertTrue(dataContractFileEquals(firstOutput, expectedCustomerText))
  if firstManifest != null
    test::assertTrue(dataContractFileEquals(mapping.outputPath + "/manifest.json", firstManifest))
  end
  mapping.error = ""

  test::assertTrue(files::removeDirectory(lock).failure == null)
  test::assertTrue(dataPublish(mapping, emission))
  test::assertTrue(dataContractPathAbsent(lock))
  mapping.outputPath = temporary + "/absent-generated"

  test::assertTrue(dataContractPathAbsent(mapping.outputPath))
  test::assertTrue(dataPublish(mapping, emission))
  test::assertTrue(dataContractFileEquals(mapping.outputPath + "/Customer.entity.hk", expectedCustomerText))
  test::assertTrue(dataContractPathAbsent(bootstrapDirectory(mapping.outputPath) + "/.neri-data-lock-" + sha256FastText(mapping.outputPath)))
  mapping.outputPath = ordinaryOutput

  test::assertTrue(dataPublish(mapping, emission))
  if firstManifest != null
    test::assertTrue(dataContractFileEquals(mapping.outputPath + "/manifest.json", firstManifest))
  end

  test::assertTrue(files::removeFile(firstOutput).failure == null)
  test::assertTrue(dataPublish(mapping, emission))
  test::assertTrue(dataContractFileEquals(firstOutput, expectedCustomerText))
  dataContractWrite(firstOutput, "tampered\n")

  test::assertTrue(dataPublish(mapping, emission))
  test::assertTrue(dataContractFileEquals(firstOutput, expectedCustomerText))
  let insertedMappingForPublication = dataLoadMapping(temporary + "/inserted-mapping.json")
  let insertedEmissionForPublication = dataEmit(insertedMappingForPublication)

  test::assertEqual(insertedMappingForPublication.error, "")
  test::assertEqual(insertedEmissionForPublication.error, "")
  test::assertTrue(dataPublish(insertedMappingForPublication, insertedEmissionForPublication))
  test::assertTrue(host::readText(mapping.outputPath + "/Tag.entity.hk") != null)
  test::assertTrue(dataContractFileEquals(firstOutput, expectedCustomerText))
  test::assertTrue(dataPublish(mapping, emission))
  test::assertTrue(host::readText(mapping.outputPath + "/Tag.entity.hk") == null)
  let obsoleteArtifact = emission.firstArtifact

  test::assertTrue(obsoleteArtifact != null)
  if obsoleteArtifact != null
    mapping.outputPath = temporary + "/obsolete-generated"
    dataContractObsoleteRoot(mapping, obsoleteArtifact)
    let obsoleteManifest = host::readText(mapping.outputPath + "/manifest.json")
    let obsoletePath = mapping.outputPath + "/" + sha256FastText("legacy-generation") + "/entity_0.hk"
    let unownedPath = mapping.outputPath + "/" + sha256FastText("legacy-generation") + "/unowned.hk"

    test::assertTrue(!dataPublish(mapping, emission))
    test::assertEqual(mapping.error, "Existing neri-data output uses an unsupported generator version.")
    test::assertTrue(obsoleteManifest != null)
    if obsoleteManifest != null
      test::assertTrue(dataContractFileEquals(mapping.outputPath + "/manifest.json", obsoleteManifest))
    end

    test::assertTrue(dataContractFileEquals(obsoletePath, obsoleteArtifact.text))
    test::assertTrue(dataContractFileEquals(unownedPath, "preserve me\n"))
    test::assertTrue(dataContractPathAbsent(mapping.outputPath + "/Customer.entity.hk"))
    test::assertTrue(dataContractPathAbsent(bootstrapDirectory(mapping.outputPath) + "/.neri-data-lock-" + sha256FastText(mapping.outputPath)))
    mapping.error = ""
    mapping.outputPath = ordinaryOutput
  end

  let publicationOnly = host::argumentAt(2)

  if publicationOnly != null && publicationOnly == "--publication-only"
    return
  end
  let compilerArgument = host::argumentAt(1)
  var compiler = root + "/scripts/neri.sh"

  if compilerArgument != null
    compiler = compilerArgument
  end
  let project = temporary + "/manifest.json"

  test::assertEqual(dataContractRun(compiler, project, "contract"), 0)
  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  dataContractWrite(temporary + "/link-contract.hk", dataContractRequiredReassignProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  test::assertEqual(dataContractCheck(compiler, project, "wrong-link", temporary + "/wrong-link.o"), 1)
  dataContractWrite(temporary + "/wrong-link.hk", dataContractRequiredUnlinkProgram())

  test::assertEqual(dataContractCheck(compiler, project, "wrong-link", temporary + "/required-unlink.o"), 1)
  test::assertEqual(dataContractCheck(compiler, project, "wrong-label", temporary + "/wrong-label.o"), 1)
  test::assertEqual(dataContractCheck(compiler, project, "wrong-type", temporary + "/wrong-type.o"), 1)
  test::assertEqual(dataContractCheck(compiler, project, "cross-entity", temporary + "/cross-entity.o"), 1)
  test::assertEqual(dataContractCheck(compiler, project, "immutable-plan", temporary + "/immutable-plan.o"), 1)
  dataContractWrite(temporary + "/cascade-mapping.json", dataContractMapping("\"clientCascade\""))
  let cascadeMapping = dataLoadMapping(temporary + "/cascade-mapping.json")

  test::assertEqual(cascadeMapping.error, "")
  let cascadeRelation = cascadeMapping.firstRelation

  test::assertTrue(cascadeRelation != null)
  if cascadeRelation != null
    test::assertEqual(cascadeRelation.deleteBehavior, "clientCascade")
  end
  let cascadeEmission = dataEmit(cascadeMapping)

  test::assertEqual(cascadeEmission.error, "")
  test::assertTrue(dataPublish(cascadeMapping, cascadeEmission))
  dataContractWrite(temporary + "/link-contract.hk", dataContractCascadeProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  for invalid in ["\"cascade\"", "42", "\"\""]
    dataContractWrite(temporary + "/cascade-mapping.json", dataContractMapping(invalid))
    let rejected = dataLoadMapping(temporary + "/cascade-mapping.json")

    test::assertTrue(rejected.error != "")
  end
  dataContractWrite(temporary + "/cascade-mapping.json", dataContractMapping("\"restrict\""))
  let restrictMapping = dataLoadMapping(temporary + "/cascade-mapping.json")

  test::assertEqual(restrictMapping.error, "")
  let restrictRelation = restrictMapping.firstRelation

  test::assertTrue(restrictRelation != null)
  if restrictRelation != null
    test::assertEqual(restrictRelation.deleteBehavior, "restrict")
  end
  dataContractWrite(temporary + "/cascade-mapping.json", dataContractMapping("\"clientSetNull\""))
  let requiredSetNull = dataLoadMapping(temporary + "/cascade-mapping.json")

  test::assertTrue(requiredSetNull.error != "")
  dataContractWrite(temporary + "/generated-mapping.json", dataContractGeneratedMapping())
  let generatedMapping = dataLoadMapping(temporary + "/generated-mapping.json")

  test::assertEqual(generatedMapping.error, "")
  let generatedEmission = dataEmit(generatedMapping)

  test::assertEqual(generatedEmission.error, "")
  test::assertTrue(dataContractHasOrigin(generatedEmission, "field:model.EntityBase.id", "def set_generated_key_Customer"))
  generatedMapping.contextName = "set_generated_key_Customer"
  let generatedCollision = dataEmit(generatedMapping)

  test::assertTrue(generatedCollision.error != "")
  dataContractWrite(temporary + "/navigation-mapping.json", dataContractNavigationMapping("orders", "customer"))
  let navigationMapping = dataLoadMapping(temporary + "/navigation-mapping.json")

  test::assertEqual(navigationMapping.error, "")
  let navigationEmission = dataEmit(navigationMapping)

  test::assertEqual(navigationEmission.error, "")
  test::assertTrue(dataContractHasOrigin(navigationEmission, "field:model.Customer.orders", "orders"))
  test::assertTrue(dataContractHasOrigin(navigationEmission, "field:model.Order.customer", "customer"))
  test::assertTrue(dataPublish(navigationMapping, navigationEmission))
  let navigationPrincipal = navigationMapping.firstEntity

  if navigationPrincipal != null
    let originalSet = navigationPrincipal.setName

    navigationPrincipal.setName = "includeReference_ordersFor_Customer_by_customerId"
    let helperCollision = dataEmit(navigationMapping)

    test::assertTrue(helperCollision.error != "")
    navigationPrincipal.setName = originalSet
  end
  dataContractWrite(temporary + "/navigation-mapping.json", dataContractNavigationMapping("", "customer"))
  let emptyNavigation = dataLoadMapping(temporary + "/navigation-mapping.json")

  test::assertTrue(emptyNavigation.error != "")
  dataContractWrite(temporary + "/navigation-mapping.json", dataContractNavigationMapping("orders", "customer", false))
  let missingInverse = dataLoadMapping(temporary + "/navigation-mapping.json")

  test::assertTrue(missingInverse.error != "")
  dataContractWrite(temporary + "/navigation-mapping.json", dataContractNavigationMapping("query", "customer"))
  let scalarNavigation = dataLoadMapping(temporary + "/navigation-mapping.json")

  test::assertTrue(scalarNavigation.error != "")
  dataContractWrite(temporary + "/navigation-mapping.json", dataContractNavigationMapping("orders", "total"))
  let wrongReference = dataLoadMapping(temporary + "/navigation-mapping.json")

  test::assertTrue(wrongReference.error != "")
  dataContractWrite(temporary + "/optional-int-mapping.json", dataContractOptionalIntMapping())
  let optionalInt = dataLoadMapping(temporary + "/optional-int-mapping.json")

  test::assertEqual(optionalInt.error, "")
  let optionalIntEmission = dataEmit(optionalInt)

  test::assertEqual(optionalIntEmission.error, "")
  test::assertTrue(dataContractHasOrigin(optionalIntEmission, "field:model.OptionalOrder.customerId", "customerId"))
  let optionalPrincipal = optionalInt.firstEntity

  if optionalPrincipal != null
    let originalSet = optionalPrincipal.setName

    for reserved in ["reassign_optionalOrdersFor_Customer_by_customerId", "unlink_optionalOrdersFor_Customer_by_customerId"]
      optionalPrincipal.setName = reserved
      let collision = dataEmit(optionalInt)

      test::assertTrue(collision.error != "")
    end
    optionalPrincipal.setName = originalSet
  end

  test::assertTrue(dataPublish(optionalInt, optionalIntEmission))
  test::assertEqual(dataContractCheck(compiler, project, "data", temporary + "/optional-int.o"), 0)
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalIntLinkProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalIntReassignProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  let optionalIntRelation = optionalInt.firstRelation

  test::assertTrue(optionalIntRelation != null)
  if optionalIntRelation != null
    test::assertTrue(dataRelationSupportsLink(optionalIntRelation))
  end
  dataContractWrite(temporary + "/optional-int-mapping.json", dataContractOptionalIntMapping("\"clientSetNull\""))
  let setNullInt = dataLoadMapping(temporary + "/optional-int-mapping.json")

  test::assertEqual(setNullInt.error, "")
  let setNullIntRelation = setNullInt.firstRelation

  test::assertTrue(setNullIntRelation != null)
  if setNullIntRelation != null
    test::assertEqual(setNullIntRelation.deleteBehavior, "clientSetNull")
  end
  let setNullIntEmission = dataEmit(setNullInt)

  test::assertEqual(setNullIntEmission.error, "")
  test::assertTrue(dataPublish(setNullInt, setNullIntEmission))
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalIntLinkProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  dataContractWrite(temporary + "/optional-string-mapping.json", dataContractOptionalStringMapping())
  let optionalString = dataLoadMapping(temporary + "/optional-string-mapping.json")

  test::assertEqual(optionalString.error, "")
  let optionalStringEmission = dataEmit(optionalString)

  test::assertEqual(optionalStringEmission.error, "")
  test::assertTrue(dataPublish(optionalString, optionalStringEmission))
  test::assertEqual(dataContractCheck(compiler, project, "data", temporary + "/optional-string.o"), 0)
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalStringLinkProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalStringReassignProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  let optionalStringRelation = optionalString.firstRelation

  test::assertTrue(optionalStringRelation != null)
  if optionalStringRelation != null
    test::assertTrue(dataRelationSupportsLink(optionalStringRelation))
  end
  dataContractWrite(temporary + "/optional-string-mapping.json", dataContractOptionalStringMapping(deleteBehaviorJson: "\"clientSetNull\""))
  let setNullString = dataLoadMapping(temporary + "/optional-string-mapping.json")

  test::assertEqual(setNullString.error, "")
  let setNullStringRelation = setNullString.firstRelation

  test::assertTrue(setNullStringRelation != null)
  if setNullStringRelation != null
    test::assertEqual(setNullStringRelation.deleteBehavior, "clientSetNull")
  end
  let setNullStringEmission = dataEmit(setNullString)

  test::assertEqual(setNullStringEmission.error, "")
  test::assertTrue(dataPublish(setNullString, setNullStringEmission))
  dataContractWrite(temporary + "/link-contract.hk", dataContractOptionalStringLinkProgram())

  test::assertEqual(dataContractRun(compiler, project, "link-contract"), 0)
  dataContractWrite(temporary + "/optional-string-mapping.json", dataContractOptionalStringMapping(true))
  let wrongNullable = dataLoadMapping(temporary + "/optional-string-mapping.json")

  test::assertTrue(wrongNullable.error != "")
  let removed = files::removeTree(temporary)

  test::assertTrue(removed.failure == null)
end
