use files
use host
use test

def dataContractWrite(path: String, value: String): Void
  test.assertTrue(host.writeText(path, value))
end

def dataContractEntities(): String
  return "namespace model\n\nclass EntityBase\n  public id: Int\n\n  def init(id: Int): Void\n    this.id = id\n  end\nend\n\nclass Customer: EntityBase\n  public query: Bool\n  public predicate_name: String\n  public name: String?\n  public init: String\n\n  def init(id: Int, query: Bool, predicate_name: String, name: String?, init: String): Void\n    super(id)\n    this.query = query\n    this.predicate_name = predicate_name\n    this.name = name\n    this.init = init\n  end\nend\n\nclass Order\n  public id: Int\n  public customerId: Int\n  public total: Int\n\n  def init(id: Int, customerId: Int, total: Int): Void\n    this.id = id\n    this.customerId = customerId\n    this.total = total\n  end\nend\n"
end

def dataContractMapping(): String
  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"app_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Customer\",\"set\":\"customers\",\"table\":\"customers\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"query\",\"column\":\"query\"},{\"member\":\"predicate_name\",\"column\":\"predicate_name\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"init\",\"column\":\"init\"}]},{\"type\":\"model.Order\",\"set\":\"orders\",\"table\":\"orders\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"customerId\",\"column\":\"customer_id\"},{\"member\":\"total\",\"column\":\"total\"}]}],\"relations\":[{\"principal\":\"model.Customer\",\"dependent\":\"model.Order\",\"key\":\"id\",\"foreignKey\":\"customerId\"}]}\n"
end

def dataContractManifest(): String
  return "{\"version\":2,\"defaultUnit\":\"contract\",\"units\":{\"runtime\":{\"kind\":\"library\",\"sources\":[\"runtime.hk\",\"translation.hk\",\"scalars.hk\"]},\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]},\"data\":{\"kind\":\"library\",\"sources\":[\"bridge.hk\"],\"generated\":[\"generated/manifest.json\"],\"references\":[\"entities\",\"runtime\"]},\"contract\":{\"kind\":\"executable\",\"sources\":[\"contract.hk\"],\"references\":[\"data\"]},\"wrong-label\":{\"kind\":\"executable\",\"sources\":[\"wrong-label.hk\"],\"references\":[\"data\"]},\"wrong-type\":{\"kind\":\"executable\",\"sources\":[\"wrong-type.hk\"],\"references\":[\"data\"]},\"cross-entity\":{\"kind\":\"executable\",\"sources\":[\"cross-entity.hk\"],\"references\":[\"data\"]},\"immutable-plan\":{\"kind\":\"executable\",\"sources\":[\"immutable-plan.hk\"],\"references\":[\"runtime\"]}}}\n"
end

def dataContractProgram(): String
  return "use app_data\nuse model\nuse neri_data\nuse quotation\nuse test\n\nclass RowsProvider: Provider\n  public override readonly def dialect(): SqlDialect\n    return SqlDialect.QuestionMark()\n  end\n  public override readonly def supports(capability: ProviderCapability): Bool\n    return true\n  end\n  public override def execute(plan: readonly SqlPlan): ProviderResult\n    return ProviderResult.Rows([new RawRow([new RawColumn(\"id\", Cell.Int(7)), new RawColumn(\"query\", Cell.Bool(false)), new RawColumn(\"predicate_name\", Cell.Text(\"p\")), new RawColumn(\"name\", Cell.Null()), new RawColumn(\"init\", Cell.Text(\"ready\"))])])\n  end\nend\n\ndef main(): Void\n  let db = new Database()\n  match db.customers.take(2).compile()\n    case CompileResult.Plan(plan)\n      test.assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"id\\\", \\\"customers\\\".\\\"query\\\", \\\"customers\\\".\\\"predicate_name\\\", \\\"customers\\\".\\\"name\\\", \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" LIMIT 2\")\n    case CompileResult.Failure(error)\n      test.assertTrue(false)\n  end\n  let filtered = db.customers.where(query: false, name: null).take(2)\n  match filtered.compile()\n    case CompileResult.Plan(plan)\n      test.assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"id\\\", \\\"customers\\\".\\\"query\\\", \\\"customers\\\".\\\"predicate_name\\\", \\\"customers\\\".\\\"name\\\", \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" WHERE (\\\"customers\\\".\\\"query\\\" = ? AND \\\"customers\\\".\\\"name\\\" IS NULL) LIMIT 2\")\n      let first = plan.sql().parameters().first()\n\n      test.assertTrue(first != null)\n      if first != null\n        match first.value()\n          case Parameter.Bool(value)\n            test.assertFalse(value)\n          case Parameter.Int(value)\n            test.assertTrue(false)\n          case Parameter.Text(value)\n            test.assertTrue(false)\n        end\n      end\n    case CompileResult.Failure(error)\n      test.assertTrue(false)\n  end\n  match filtered.all(new RowsProvider())\n    case QueryResult.Rows(rows)\n      let first = rows.first()\n\n      test.assertTrue(first != null)\n      if first != null\n        test.assertEqual(first.value.init, \"ready\")\n        let snapshot = snapshot_Customer(first.value).pack()\n\n        test.assertEqual(snapshot.count(), 5)\n        let captured = snapshot.entryAt(4)\n\n        test.assertTrue(captured != null)\n        if captured != null\n          match captured.value()\n            case CaptureValue.Text(value)\n              test.assertEqual(value, \"ready\")\n            case CaptureValue.Bool(value)\n              test.assertTrue(false)\n            case CaptureValue.Int(value)\n              test.assertTrue(false)\n            case CaptureValue.Null()\n              test.assertTrue(false)\n          end\n        end\n        match db.ordersFor_Customer_by_customerId(first.value).take(1).compile()\n          case CompileResult.Plan(plan)\n            test.assertEqual(plan.sql().sql(), \"SELECT \\\"orders\\\".\\\"id\\\", \\\"orders\\\".\\\"customer_id\\\", \\\"orders\\\".\\\"total\\\" FROM \\\"orders\\\" WHERE \\\"orders\\\".\\\"customer_id\\\" = ? LIMIT 1\")\n          case CompileResult.Failure(error)\n            test.assertTrue(false)\n        end\n      end\n    case QueryResult.Failure(error)\n      test.assertTrue(false)\n  end\n  let projected = select(filtered, textScalar()) do |customer|\n    return customer.init\n  end\n  match projected.compile()\n    case CompileResult.Plan(plan)\n      test.assertEqual(plan.sql().sql(), \"SELECT \\\"customers\\\".\\\"init\\\" FROM \\\"customers\\\" WHERE (\\\"customers\\\".\\\"query\\\" = ? AND \\\"customers\\\".\\\"name\\\" IS NULL) LIMIT 2\")\n    case CompileResult.Failure(error)\n      test.assertTrue(false)\n  end\nend\n"
end

def dataContractRun(compiler: String, project: String, unit: String): Int
  let result = host.run(compiler, ["run", "--project", project, "--unit", unit])

  if result != null
    return result
  end
  return -1
end

def dataContractCheck(compiler: String, project: String, unit: String, output: String): Int
  let result = host.run(compiler, ["check", "--project", project, "--unit", unit, "--emit=obj", "--output", output])

  if result != null
    return result
  end
  return -1
end

def dataContractHasOrigin(emission: DataEmission, identity: String, emittedText: String): Bool
  var artifact = emission.firstArtifact

  while artifact != null
    let sourceMap = new IrSourceMap(artifact.text)
    var emitted = artifact.firstOrigin

    while emitted != null
      if emitted.origin.identity == identity
        let start = sourceMap.offsetAt(emitted.start)
        let finish = sourceMap.offsetAt(emitted.start + emitted.length)

        if host.stringSlice(artifact.text, start, finish - start) == emittedText
          return true
        end
      end
      emitted = emitted.nextOrigin
    end
    artifact = artifact.nextArtifact
  end
  return false
end

def main(): Void
  let root = host.argumentAt(0)

  test.assertTrue(root != null)
  if root == null
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "data-generation-contract")

  test.assertTrue(temporary != null)
  if temporary == null
    return
  end
  let runtime = host.readText(root + "/experiments/neri-data/runtime.hk")
  let translation = host.readText(root + "/experiments/neri-data/translation.hk")
  let scalars = host.readText(root + "/experiments/neri-data/scalars.hk")

  test.assertTrue(runtime != null)
  test.assertTrue(translation != null)
  test.assertTrue(scalars != null)
  if runtime == null || translation == null || scalars == null
    return
  end
  let created = files.createDirectory(temporary + "/generated", true)

  test.assertTrue(created.failure == null)
  dataContractWrite(temporary + "/runtime.hk", runtime)
  dataContractWrite(temporary + "/translation.hk", translation)
  dataContractWrite(temporary + "/scalars.hk", scalars)
  dataContractWrite(temporary + "/entities.hk", dataContractEntities())
  dataContractWrite(temporary + "/bridge.hk", "namespace app_data\n")
  dataContractWrite(temporary + "/mapping.json", dataContractMapping())
  dataContractWrite(temporary + "/manifest.json", dataContractManifest())
  dataContractWrite(temporary + "/contract.hk", dataContractProgram())
  dataContractWrite(temporary + "/wrong-label.hk", "use app_data\ndef main(): Void\n  let value = (new Database()).customers.where(missing: true)\nend\n")
  dataContractWrite(temporary + "/wrong-type.hk", "use app_data\ndef main(): Void\n  let value = (new Database()).customers.where(query: 1)\nend\n")
  dataContractWrite(temporary + "/cross-entity.hk", "use app_data\nuse model\ndef main(): Void\n  let db = new Database()\n  let predicate: quote fn(Order): Bool = quote do |order: Order|: Bool\n    return order.id == 1\n  end\n  let value = db.customers.matching(predicate)\nend\n")
  dataContractWrite(temporary + "/immutable-plan.hk", "use neri_data\ndef mutate(plan: readonly SqlPlan): Void\n  plan.limit = 2\nend\n\ndef main(): Void\nend\n")
  let mapping = dataLoadMapping(temporary + "/mapping.json")

  test.assertEqual(mapping.error, "")
  let emission = dataEmit(mapping)

  test.assertEqual(emission.error, "")
  test.assertTrue(dataContractHasOrigin(emission, "field:model.EntityBase.id", "\"model.EntityBase.id\""))
  test.assertTrue(dataContractHasOrigin(emission, "field:model.Customer.query", "\"model.Customer.query\""))
  test.assertTrue(dataContractHasOrigin(emission, "field:model.Customer.init", "init"))
  test.assertTrue(dataContractHasOrigin(emission, "field:model.Order.customerId", "ordersFor_Customer_by_customerId"))
  mapping.contextName = "mappingEntity_8_Customer"
  let collision = dataEmit(mapping)

  test.assertTrue(collision.error != "")
  mapping.contextName = "Database"
  let initialInputs = dataPublishInputs(mapping)

  test.assertTrue(initialInputs != null)
  if initialInputs != null
    let initialRevision = dataPublishRevision(mapping, initialInputs, emission)
    let staging = mapping.outputPath + "/.publish-" + initialRevision

    test.assertTrue(files.createDirectory(staging).failure == null)
    let stagedArtifact = emission.firstArtifact

    test.assertTrue(stagedArtifact != null)
    if stagedArtifact != null
      dataContractWrite(staging + "/" + stagedArtifact.name, stagedArtifact.text)
    end
  end

  test.assertTrue(dataPublish(mapping, emission))
  let publishedInputs = dataPublishInputs(mapping)

  test.assertTrue(publishedInputs != null)
  if publishedInputs != null
    let revision = dataPublishRevision(mapping, publishedInputs, emission)
    let firstOutput = mapping.outputPath + "/" + revision + "/entity_0.hk"

    test.assertTrue(files.removeFile(firstOutput).failure == null)
    test.assertTrue(dataPublish(mapping, emission))
    dataContractWrite(firstOutput, "tampered\n")

    test.assertTrue(dataPublish(mapping, emission))
    let firstArtifact = emission.firstArtifact

    test.assertTrue(firstArtifact != null)
    if firstArtifact != null
      let repaired = host.readText(firstOutput)

      test.assertTrue(repaired != null)
      if repaired != null
        test.assertEqual(repaired, firstArtifact.text)
      end
    end
  end

  let compilerArgument = host.argumentAt(1)
  var compiler = root + "/scripts/neri.sh"

  if compilerArgument != null
    compiler = compilerArgument
  end
  let project = temporary + "/manifest.json"

  test.assertEqual(dataContractRun(compiler, project, "contract"), 0)
  test.assertEqual(dataContractCheck(compiler, project, "wrong-label", temporary + "/wrong-label.o"), 1)
  test.assertEqual(dataContractCheck(compiler, project, "wrong-type", temporary + "/wrong-type.o"), 1)
  test.assertEqual(dataContractCheck(compiler, project, "cross-entity", temporary + "/cross-entity.o"), 1)
  test.assertEqual(dataContractCheck(compiler, project, "immutable-plan", temporary + "/immutable-plan.o"), 1)
  let removed = files.removeTree(temporary)

  test.assertTrue(removed.failure == null)
end
