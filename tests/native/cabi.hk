use test

@cabi("labs")
def unsafe cAbs(value: Int): Int
end

@cabi("labs")
def unsafe cAbsAgain(value: Int): Int
end

@cabi("getenv")
def unsafe getEnvironment(name: Byte*): Byte*?
end

def main(): Void
  unsafe
    let result = cAbsAgain(cAbs(-42))
    test.assertEqual(result, 42)

    let name = stackalloc Byte[5]
    name[0] = 80 as Byte
    name[1] = 65 as Byte
    name[2] = 84 as Byte
    name[3] = 72 as Byte
    name[4] = 0 as Byte
    let path = getEnvironment(name)
    if path == null
      test.assertEqual(0, 1)
    end
  end
end
