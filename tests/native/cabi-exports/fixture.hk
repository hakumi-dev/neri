use test

class Root
  public value: Int32 = 41 as Int32
end

struct CallbackRecord
  tag: Byte
  callback: cabi fn(Int32): Int32
  optional: (cabi fn(Int32): Int32)?
end

@cabiImport("neri_rt_v1_gc_collect")
unsafe def collect(): Void
end

@cabiImport("oracle_twice")
unsafe def twice(value: Int32): Int32
end

@cabiImport("oracle_callback")
unsafe def callback(): cabi fn(Int32): Int32
end

@cabiImport("oracle_apply")
unsafe def apply(operation: cabi fn(Int32): Int32, value: Int32): Int32
end

@cabiImport("oracle_record_fill")
unsafe def fill(record: CallbackRecord*): Void
end

@cabiImport("oracle_record_check")
unsafe def check(record: CallbackRecord*): Bool
end

@cabiExport("app_increment")
unsafe def increment(value: Int32): Int32
  let root = new Root()

  root.value = value
  collect()
  return root.value + (1 as Int32)
end

@cabiExport("app_roundtrip")
unsafe def roundtrip(): Int32
  let root = new Root()
  let foreign: cabi fn(Int32): Int32 = twice
  let exported: cabi fn(Int32): Int32 = increment
  let returned = callback()
  let result = apply(exported, 20 as Int32)

  test.assertEqual(root.value as Int, 41)
  test.assertEqual(foreign(result) as Int, 42)
  test.assertEqual(returned(result) as Int, 42)

  let record = stackalloc CallbackRecord[1]

  fill(record)

  test.assertEqual(record.callback(21 as Int32) as Int, 42)
  test.assertTrue(record.optional == null)

  record.callback = increment
  record.optional = twice
  let present = record.optional

  test.assertTrue(check(record))

  if present != null
    test.assertEqual(present(21 as Int32) as Int, 42)
  else
    test.assertTrue(false)
  end

  let operations = stackalloc (cabi fn(Int32): Int32)[1]

  operations[0] = increment
  let nullable = stackalloc (cabi fn(Int32): Int32)?[1]

  nullable[0] = null

  test.assertEqual(operations[0](41 as Int32) as Int, 42)
  test.assertTrue(nullable[0] == null)

  nullable[0] = twice
  let selected = nullable[0]

  if selected != null
    test.assertEqual(selected(21 as Int32) as Int, 42)
  else
    test.assertTrue(false)
  end

  var local: cabi fn(Int32): Int32 = twice
  let address = &local

  *address = increment
  let loaded = *address

  test.assertEqual(loaded(41 as Int32) as Int, 42)

  return root.value + (1 as Int32)
end

@cabiExport("app_choose")
unsafe def choose(present: Bool): (cabi fn(Int32): Int32)?
  if present
    return increment
  end
  return null
end

@cabiExport("app_record")
unsafe def publicRecord(storage: Byte*): CallbackRecord*
  let record = storage as CallbackRecord*

  record.tag = 7 as Byte
  record.callback = increment
  record.optional = null
  return record
end

@cabiExport("app_optional")
unsafe def optional(operation: (cabi fn(Int32): Int32)?, value: Int32): Int32
  if operation != null
    return operation(value)
  end
  return -1 as Int32
end

@cabiExport("app_mixed")
unsafe def mixed(byte: Byte, flag: Bool, signed: Int32, unsigned: UInt32, wide: UInt64, small: Float32, real: Float, output: Int32*): Float
  test.assertEqual(-9223372036854775808, (-9223372036854775807) - 1)

  if byte != (255 as Byte) || !flag || signed != (-2147483648 as Int32) || unsigned != (4294967295 as UInt32) || wide != ((9223372036854775807 as UInt64) + (1 as UInt64))
    return -1.0
  end
  *output = signed
  return (small as Float) + real + (byte as Float) + (flag ? 1.0 : 0.0)
end

@cabiExport("app_divide")
unsafe def divide(value: Int32): Int32
  return (42 as Int32) / value
end
