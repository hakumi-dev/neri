class Root
  public text: String = "other"
  public offset: Int32 = 17 as Int32
end

# Unreachable native types do not impose C header completeness requirements.
struct A
  next: B[2]*
end

struct B
  next: A[2]*
end

@cabiExport("app_other")
unsafe def increment(value: Int32): Int32
  let root = new Root()

  return root.offset + value
end
