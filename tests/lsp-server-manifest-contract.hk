use host
use test

def sourceText(path: String): String
  let text = host::readText(path)

  test::assertTrue(text != null)
  if text != null
    return text
  end
  return ""
end

def document(path: String, text: String): LspDocument
  let item = new LspDocument()

  item.uri = lspUri(path)
  item.sourcePath = path
  item.text = text
  item.version = 1
  return item
end

def analyzed(document: LspDocument): Bool
  let semantic = document.semantic

  if semantic == null
    return false
  end
  return semantic.diagnostics.count() == 0
end

def containsText(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    var equal = true
    var index = 0

    while index < host::stringByteLength(part)
      if host::stringByteAt(text, offset + index) != host::stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def textOffset(text: String, part: String): Int
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    var equal = true
    var index = 0

    while index < host::stringByteLength(part)
      if host::stringByteAt(text, offset + index) != host::stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return offset
    end
    offset = offset + 1
  end
  return -1
end

def definitionAt(document: LspDocument, text: String, part: String, offset: Int = 0): String
  let start = textOffset(text, part)

  test::assertTrue(start >= 0)
  if start < 0
    return "null"
  end
  return lspDefinition(document, start + offset)
end

def snapshot(document: LspDocument, projectKey: String, projectRevision: Int): LspSemanticSnapshot
  let value = new LspSemanticSnapshot()

  value.projectKey = projectKey
  value.projectRevision = projectRevision
  value.semantic = document.semantic
  value.sourceUris = document.sourceUris
  value.sourceTexts = document.sourceTexts
  value.sourceStarts = document.sourceStarts
  var index = 0

  while index < document.sourceUris.size
    value.sourceVersions.add(index == 0 ? document.version : -1)
    index = index + 1
  end
  value.requireEntryPoint = document.requireEntryPoint
  value.forbiddenEntryPointSources = document.forbiddenEntryPointSources
  return value
end

def sourceSnapshot(projectKey: String, uri: String, start: Int): LspSemanticSnapshot
  let value = new LspSemanticSnapshot()

  value.projectKey = projectKey
  value.projectRevision = 1
  value.sourceUris.add(uri)
  value.sourceTexts.add("local")
  value.sourceStarts.add(start)
  value.sourceVersions.add(-1)
  return value
end

def abstractLspContracts(): Void
  let source = "abstract class Shape\n  abstract def area(scale: Int): Int\n\n  def measured(): Int\n    return this.area(2)\n  end\nend\n\nabstract class Template<T>\n  abstract def item(): T\nend\n\nclass Square: Shape\n  override def area(scale: Int): Int\n    return scale * scale\n  end\nend\n\ndef main(): Void\n  let shape: Shape = new Square()\n  let template: Template<Int>? = null\n  let amount = shape.area(3)\nend\n"
  let item = document("/abstract-lsp.hk", source)
  let server = new LspServer()

  server.documents = item
  server.analyze(item)

  test::assertTrue(analyzed(item))
  let classHover = lspHover(item, textOffset(source, "class Shape") + 6)
  let methodHover = lspHover(item, textOffset(source, "this.area(2)") + 6)
  let methodSignature = lspSignatureHelp(item, textOffset(source, "this.area(2)") + 10)
  let methodCompletion = lspCompletion(item, textOffset(source, "this.area(2)") + 6, true)
  let typeCompletion = lspCompletion(item, textOffset(source, "new Square()") + 4, true)
  let abstractDefinition = definitionAt(item, source, "shape.area(3)", 7)

  test::assertTrue(containsText(classHover, "abstract class Shape"))
  test::assertTrue(containsText(methodHover, "abstract def Shape.area(scale: Int): Int"))
  test::assertTrue(containsText(methodSignature, "abstract def Shape.area(scale: Int): Int"))
  test::assertTrue(containsText(methodCompletion, "\"detail\":\"abstract Shape.area(scale: Int): Int\""))
  test::assertTrue(containsText(methodCompletion, "\"newText\":\"area\""))
  test::assertTrue(containsText(typeCompletion, "\"detail\":\"abstract class Shape\""))
  test::assertTrue(containsText(typeCompletion, "\"newText\":\"Shape\""))
  test::assertTrue(containsText(typeCompletion, "\"detail\":\"abstract class Template<T>\""))
  test::assertTrue(containsText(abstractDefinition, "\"line\":1,\"character\":15"))

  let incompleteSource = "abstract class Base\n  abstract def run(): Void\nend\n\nclass Missing: Base\nend\n\ndef main(): Void\nend\n"
  let incomplete = document("/incomplete-abstract-lsp.hk", incompleteSource)
  let incompleteServer = new LspServer()

  incompleteServer.documents = incomplete
  incompleteServer.analyze(incomplete)
  let semantic = incomplete.semantic

  test::assertTrue(semantic != null)
  if semantic != null
    test::assertEqual(semantic.diagnostics.count(), 1)
    test::assertEqual(semantic.diagnostics.codes.get(0), "NR255")
  end
end

def cFunctionLspContracts(): Void
  let source = "@cabiExport(\"app_lsp_sum\")\nunsafe def sum(left: Int32, right: Int32): Int32\n  return left + right\nend\n\n@cabiImport(\"app_lsp_install\")\nunsafe def install(callback: (cabi fn(Int32, Int32): Int32)?): (cabi fn(Int32, Int32): Int32)?\nend\n\nunsafe def inspect(callback: cabi fn(Int32, Int32): Int32): Void\n  let value = callback(1 as Int32, 2 as Int32)\n  let optional: (cabi fn(Int32, Int32): Int32)? = callback\n  install(optional)\nend\n\ndef main(): Void\n  unsafe\n    inspect(sum)\n  end\nend\n"
  let item = document("/c-function-lsp.hk", source)
  let server = new LspServer()

  server.documents = item
  server.analyze(item)
  let signature = lspSignatureHelp(item, textOffset(source, "2 as Int32") + 1)
  let hover = lspHover(item, textOffset(source, "callback(1") + 2)
  let completion = lspCompletion(item, textOffset(source, "install(optional)") + 3)

  test::assertTrue(analyzed(item))
  test::assertTrue(containsText(signature, "\"label\":\"cabi fn(Int32, Int32): Int32\""))
  test::assertTrue(containsText(signature, "\"activeParameter\":1"))
  test::assertTrue(containsText(hover, "callback: cabi fn(Int32, Int32): Int32"))
  test::assertTrue(containsText(completion, "install(callback: (cabi fn(Int32, Int32): Int32)?): (cabi fn(Int32, Int32): Int32)?"))
end

def queryTableContracts(): Void
  let table = new StringTable<Int>()
  let first = table.add("Aa", 7)
  let collision = table.add("BB", 9)
  let empty = table.add("", 0)
  let unicode = table.add("水:😀|é", 11)
  var index = 0

  # Aa and BB have the same polynomial hash. Grow through several capacities
  # before checking their full keys and all inserted values.
  while index < 512
    table.add("key:" + (index as String), index)
    index = index + 1
  end
  let duplicate = table.add("Aa", 99)
  let a = table.find("Aa")
  let b = table.find("BB")
  let blank = table.find("")
  let wide = table.find("水:😀|é")

  test::assertTrue(first && collision && empty && unicode && !duplicate)
  test::assertTrue(a != null && a.value == 7 && b != null && b.value == 9)
  test::assertTrue(blank != null && blank.value == 0 && wide != null && wide.value == 11)
  test::assertTrue(table.find("missing") == null)

  index = 0
  while index < 512
    let entry = table.find("key:" + (index as String))

    test::assertTrue(entry != null && entry.value == index)
    index = index + 1
  end
end

def snapshotSourceContracts(): Void
  let snapshot = new LspSemanticSnapshot()

  snapshot.sourceUris.add("file:///first.hk")
  snapshot.sourceUris.add("file:///水.hk")
  snapshot.sourceUris.add("file:///last.hk")
  snapshot.sourceStarts.add(0)
  snapshot.sourceStarts.add(40)
  snapshot.sourceStarts.add(100)

  test::assertEqual(lspSnapshotSourceKey(snapshot, 100), "file:///last.hk")
  test::assertEqual(lspSnapshotSourceKey(snapshot, 39), "file:///first.hk")
  test::assertEqual(lspSnapshotSourceKey(snapshot, 40), "file:///水.hk")
  test::assertEqual(lspSnapshotSourceOffset(snapshot, 99), 59)
end

def namespaceSubmissionContract(): Void
  let source = "namespace sample\n\ndef value(): Int\n  return 1\nend\n"
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let submission = parser.parseSubmission()

  test::assertEqual(parser.diagnostics.count(), 0)
  test::assertEqual(semanticIntField(parser.arena.dataAt(submission.root), 5), 1)
  test::assertEqual(submission.declarationCount, 1)
  let namespaceNode = parser.arena.childAt(submission.root, 2)
  let nameNode = parser.arena.childAt(namespaceNode, 0)

  test::assertTrue(parser.arena.kindAt(namespaceNode).isNamespace())
  test::assertEqual(parser.arena.dataAt(namespaceNode), "sample")
  test::assertEqual(parser.arena.startAt(nameNode), bootstrapFindText(source, "sample"))
  test::assertEqual(parser.arena.lengthAt(nameNode), 6)
end

def splitNamespaceDefinitionContract(): Void
  let firstSource = "use split\nnamespace split\ndef first(): Int\n  return 1\nend\n"
  let secondSource = "namespace split\ndef second(): Int\n  return 2\nend\n"
  let secondStart = (new IrSourceMap(firstSource + "\n")).utf16Length()
  let source = firstSource + "\n" + secondSource
  let tokens = (new BootstrapLexer(source)).lex()
  let parser = new BootstrapParser(tokens)

  parser.addSourceBoundary(0)
  parser.addSourceBoundary(secondStart)
  let root = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, root, (new IrSourceMap(source)).utf16Length())

  binder.recordSourceSymbols = true
  binder.requireEntryPoint = false
  binder.clearSources()
  binder.addSource("file:///first-split.hk", 0)
  binder.addSource("file:///second-split.hk", secondStart)
  let document = new LspDocument()

  document.uri = "file:///first-split.hk"
  document.text = firstSource
  document.semantic = binder.bind()
  document.sourceUris.add(document.uri)
  document.sourceUris.add("file:///second-split.hk")
  document.sourceTexts.add(firstSource)
  document.sourceTexts.add(secondSource)
  document.sourceStarts.add(0)
  document.sourceStarts.add(secondStart)
  let definition = lspDefinition(document, bootstrapFindText(source, "use split") + 4)
  let parsed = (new LspJsonParser(definition)).parse()
  let first = parsed.first

  test::assertTrue(parsed.isArray() && first != null)
  if first != null
    let second = first.next

    test::assertTrue(second != null)
    if second != null
      test::assertTrue(second.next == null)
      test::assertTrue((first.get("uri").scalarText() == "file:///first-split.hk" && second.get("uri").scalarText() == "file:///second-split.hk") || (first.get("uri").scalarText() == "file:///second-split.hk" && second.get("uri").scalarText() == "file:///first-split.hk"))
    end
  end
end

def main(): Void
  cFunctionLspContracts()
  let root = host::argumentAt(0)

  test::assertTrue(root != null)
  if root == null
    return
  end

  abstractLspContracts()
  queryTableContracts()
  snapshotSourceContracts()
  namespaceSubmissionContract()
  splitNamespaceDefinitionContract()

  let emptyRoot = root + "/tests/lsp/empty-implicit"
  let emptyProject = neriLoadProject(emptyRoot)

  test::assertEqual(emptyProject.error(), "An implicit project must contain at least one .hk source.")
  test::assertTrue(neriProjectErrorReasonIsEmptyImplicitProject(emptyProject.errorReason()))
  let invalidProject = neriLoadProject(root + "/tests/lsp/project/invalid-name.json")

  test::assertTrue(invalidProject.errorReason() != null)
  test::assertFalse(neriProjectErrorReasonIsEmptyImplicitProject(invalidProject.errorReason()))
  let unsavedPath = emptyRoot + "/unsaved.hk"
  let unsaved = document(unsavedPath, "def main(): Void\nend\n")
  let unsavedServer = new LspServer()

  unsavedServer.rootPath = emptyRoot
  unsavedServer.documents = unsaved
  unsavedServer.analyze(unsaved)

  test::assertTrue(analyzed(unsaved))
  test::assertEqual(unsaved.lastPublishedDiagnostics, "[]")

  let canonicalRoot = root + "/tests/lsp/manifest-workspace"
  let canonicalMain = canonicalRoot + "/main.hk"
  let resolvedRoot = neriCanonicalPath(canonicalRoot + "/.")
  let resolvedFuture = neriCanonicalPath(canonicalRoot + "/missing/../future")

  test::assertTrue(resolvedRoot != null && resolvedRoot == canonicalRoot)
  test::assertTrue(resolvedFuture != null && resolvedFuture == canonicalRoot + "/future")
  let canonical = new LspServer()

  canonical.rootPath = canonicalRoot
  let canonicalDocument = document(canonicalMain, sourceText(canonicalMain))

  canonical.documents = canonicalDocument
  canonical.analyze(canonicalDocument)

  test::assertEqual(canonical.nearestProjectRoot(canonicalMain), canonicalRoot)
  test::assertTrue(analyzed(canonicalDocument))
  test::assertEqual(canonicalDocument.sourceUris.size, 3)
  let unowned = document(canonicalRoot + "/unowned.hk", "def unowned(): Int\n  return 1\nend\n")

  canonical.documents = unowned
  canonical.analyze(unowned)

  test::assertEqual(unowned.analysisStatus, "unavailable")
  test::assertTrue(unowned.semantic == null)
  test::assertTrue(containsText(unowned.lastPublishedDiagnostics, "\"severity\":3"))
  test::assertTrue(containsText(unowned.lastPublishedDiagnostics, "\"code\":\"NR_PROJECT_CONTEXT\""))
  let corePath = root + "/stdlib/core.hk"
  let coreDocument = document(corePath, sourceText(corePath))
  let coreServer = new LspServer()

  coreServer.documents = coreDocument
  coreServer.analyze(coreDocument)

  test::assertTrue(analyzed(coreDocument))
  test::assertEqual(coreDocument.sourceUris.size, 1)
  test::assertEqual(coreDocument.sourceUris.get(0), "@stdlib/core.hk")
  test::assertTrue(containsText(definitionAt(coreDocument, coreDocument.text, "class String", 6), "core.hk"))

  # workspace/symbol discovers a non-default closed unit without retaining its
  # semantic model. Reanalyzing an overlay invalidates that compact cache.
  let closedWorkspace = new LspServer()

  closedWorkspace.rootPath = canonicalRoot
  let closedSymbols = lspWorkspaceSymbols(closedWorkspace, "secondaryOnly")

  test::assertTrue(containsText(closedSymbols, "secondaryOnly"))
  let secondaryPath = canonicalRoot + "/secondary.hk"
  let secondary = document(secondaryPath, "def changedOnly(): Int\n  return 3\nend\n\ndef main(): Void\nend\n")

  closedWorkspace.documents = secondary
  closedWorkspace.analyze(secondary)
  let overlaySymbols = lspWorkspaceSymbols(closedWorkspace, "")

  test::assertTrue(containsText(overlaySymbols, "changedOnly"))
  test::assertTrue(!containsText(overlaySymbols, "secondaryOnly"))

  let implicitRoot = root + "/tests/lsp/implicit-workspace"
  let implicitMain = implicitRoot + "/main.hk"
  let implicitHelper = implicitRoot + "/helper.hk"
  let implicit = new LspServer()

  implicit.rootPath = implicitRoot
  let main = document(implicitMain, sourceText(implicitMain))

  implicit.documents = main
  implicit.analyze(main)

  test::assertEqual(implicit.nearestProjectRoot(implicitMain), implicitRoot)
  test::assertTrue(analyzed(main))
  test::assertEqual(main.sourceUris.size, 3)
  let symlinkFixture = bootstrapTemporaryDirectory(root + "/build", "lsp-symlink-boundary")

  test::assertTrue(symlinkFixture != null)
  if symlinkFixture != null
    let actualRoot = symlinkFixture + "/actual"
    let linkedRoot = symlinkFixture + "/linked"
    let actualMade = host::run("mkdir", ["-p", actualRoot])
    let actualMain = actualRoot + "/main.hk"

    test::assertTrue(actualMade != null && actualMade == 0)
    test::assertTrue(host::writeText(actualMain, "def local(): Int\n  return 1\nend\n"))
    let linked = host::run("ln", ["-s", actualRoot, linkedRoot])

    test::assertTrue(linked != null && linked == 0)
    let symlinkServer = new LspServer()

    symlinkServer.rootPath = linkedRoot

    test::assertEqual(symlinkServer.nearestProjectRoot(linkedRoot + "/main.hk"), actualRoot)
    let removed = host::run("rm", ["-rf", symlinkFixture])

    test::assertTrue(removed != null && removed == 0)
  end

  let overlay = document(implicitHelper, "namespace implicitdemo\n\ndef helper(): String\n  return \"changed\"\nend\n")

  overlay.next = main
  implicit.documents = overlay
  implicit.analyze(main)
  let overlaySemantic = main.semantic

  test::assertTrue(overlaySemantic != null)
  if overlaySemantic != null
    test::assertTrue(overlaySemantic.diagnostics.count() > 0)
  end

  let navigationSource = "class Counter\n  def init(): Void\n  end\n\n  def increment(): Int\n    return 1\n  end\nend\n\nclass Box<T>\n  public value: T\n\n  def item(): T\n    return this.value\n  end\nend\n\nclass Derived: Counter\nend\n\nstruct Packet\n  bytes: Int\nend\n\nenum Signal\n  case Ready(value: Int)\n  case Stop()\nend\n\nclass Crate<T>\n  public item: T\nend\n\ndef accept(packet: Packet): Void\nend\n\ndef main(): Void\n  let typed: Counter? = new Counter()\n  let boxed: Box<fn(): Int> = new Box<fn(): Int>()\n  let nested: Crate<Box<fn(): Int>> = new Crate<Box<fn(): Int>>()\n  if typed != null\n    typed.increment()\n  end\n  boxed.item()\n  let value = boxed.value\n  let signal = Signal.Ready(7)\n  match signal\n    case Signal.Ready(number)\n      let copy = number\n    case Signal.Stop()\n  end\n  let inherited: Derived = new Derived()\nend\n"
  let navigationDocument = new LspDocument()

  navigationDocument.uri = "untitled:navigation"
  navigationDocument.text = navigationSource
  navigationDocument.version = 1
  let navigation = new LspServer()

  navigation.documents = navigationDocument
  navigation.analyze(navigationDocument)

  test::assertTrue(analyzed(navigationDocument))
  let counterType = definitionAt(navigationDocument, navigationSource, ": Counter?", 2)
  let counterConstructor = definitionAt(navigationDocument, navigationSource, "new Counter()", 4)
  let counterConstructorEnd = definitionAt(navigationDocument, navigationSource, "new Counter()", 10)
  let boxType = definitionAt(navigationDocument, navigationSource, ": Box<fn(): Int>", 2)
  let boxConstructor = definitionAt(navigationDocument, navigationSource, "new Box<fn(): Int>()", 4)
  let nestedOuter = definitionAt(navigationDocument, navigationSource, ": Crate<Box<fn(): Int>>", 2)
  let nestedInner = definitionAt(navigationDocument, navigationSource, ": Crate<Box<fn(): Int>>", 8)
  let inheritedType = definitionAt(navigationDocument, navigationSource, "class Derived: Counter", 15)
  let nativeType = definitionAt(navigationDocument, navigationSource, "packet: Packet", 8)
  let incrementCall = definitionAt(navigationDocument, navigationSource, "typed.increment()", 6)
  let incrementCallEnd = definitionAt(navigationDocument, navigationSource, "typed.increment()", 14)
  let genericMethod = definitionAt(navigationDocument, navigationSource, "boxed.item()", 6)
  let genericField = definitionAt(navigationDocument, navigationSource, "boxed.value", 6)
  let genericType = lspTypeDefinition(navigationDocument, textOffset(navigationSource, "boxed.item()") + 1)
  let enumConstruct = definitionAt(navigationDocument, navigationSource, "Signal.Ready(7)", 7)
  let enumMatch = definitionAt(navigationDocument, navigationSource, "Signal.Ready(number)", 7)
  let enumStop = definitionAt(navigationDocument, navigationSource, "Signal.Stop()", 7)

  test::assertTrue(containsText(counterType, "\"line\":0,\"character\":6"))
  test::assertTrue(containsText(counterConstructor, "\"line\":0,\"character\":6"))
  test::assertTrue(containsText(counterConstructorEnd, "\"line\":0,\"character\":6"))
  test::assertTrue(containsText(boxType, "\"line\":9,\"character\":6"))
  test::assertTrue(containsText(boxConstructor, "\"line\":9,\"character\":6"))
  test::assertTrue(containsText(nestedOuter, "\"line\":29,\"character\":6"))
  test::assertTrue(containsText(nestedInner, "\"line\":9,\"character\":6"))
  test::assertTrue(containsText(inheritedType, "\"line\":0,\"character\":6"))
  test::assertTrue(containsText(nativeType, "\"line\":20,\"character\":7"))
  test::assertTrue(containsText(incrementCall, "\"line\":4,\"character\":6"))
  test::assertTrue(containsText(incrementCallEnd, "\"line\":4,\"character\":6"))
  test::assertTrue(containsText(genericMethod, "\"line\":12,\"character\":6"))
  test::assertTrue(containsText(genericField, "\"line\":10,\"character\":9"))
  test::assertTrue(containsText(genericType, "\"line\":9,\"character\":6"))
  test::assertTrue(containsText(enumConstruct, "\"line\":25,\"character\":7"))
  test::assertTrue(containsText(enumMatch, "\"line\":25,\"character\":7"))
  test::assertTrue(containsText(enumStop, "\"line\":26,\"character\":7"))
  let conversionSource = "class Convertible\n  @conversion\n  public def integer(): Int\n    return 7\n  end\nend\n\ndef main(): Void\n  let scalar = new Convertible()\n  let value = scalar as Int\nend\n"
  let conversionDocument = new LspDocument()

  conversionDocument.uri = "untitled:conversion"
  conversionDocument.text = conversionSource
  conversionDocument.version = 1
  let conversionServer = new LspServer()

  conversionServer.documents = conversionDocument
  conversionServer.analyze(conversionDocument)

  test::assertTrue(analyzed(conversionDocument))
  let conversionOperand = definitionAt(conversionDocument, conversionSource, "scalar as Int", 1)
  let conversionOperator = definitionAt(conversionDocument, conversionSource, "scalar as Int", 7)

  test::assertTrue(containsText(conversionOperand, "\"line\":8,\"character\":6"))
  test::assertEqual(conversionOperator, "null")
  let namespaceClassSource = "def main(): Void\n  let circle = shapes::CircleFactory()\nend\n\nnamespace shapes\nclass Circle\nend\n\ndef CircleFactory(): Circle\n  return new Circle()\nend\n"
  let namespaceClassDocument = new LspDocument()

  namespaceClassDocument.uri = "untitled:namespace-class"
  namespaceClassDocument.text = namespaceClassSource
  namespaceClassDocument.version = 1
  let namespaceClassServer = new LspServer()

  namespaceClassServer.documents = namespaceClassDocument
  namespaceClassServer.analyze(namespaceClassDocument)

  test::assertTrue(analyzed(namespaceClassDocument))
  let namespaceClasses = lspCompletion(namespaceClassDocument, textOffset(namespaceClassSource, "shapes::Circle") + 10)

  test::assertTrue(containsText(namespaceClasses, "\"label\":\"Circle\""))

  let stringSource = "def main(): Void\n  let value: String = \"hello\"\n  let size = value.byteLength()\nend\n"
  let stringDocument = new LspDocument()

  stringDocument.uri = "untitled:string-class"
  stringDocument.text = stringSource
  stringDocument.version = 1
  let stringServer = new LspServer()

  stringServer.documents = stringDocument
  stringServer.analyze(stringDocument)

  test::assertTrue(analyzed(stringDocument))
  test::assertTrue(containsText(definitionAt(stringDocument, stringSource, ": String", 2), "core.hk"))
  test::assertTrue(containsText(definitionAt(stringDocument, stringSource, "value.byteLength", 6), "core.hk"))
  test::assertTrue(containsText(lspCompletion(stringDocument, textOffset(stringSource, "value.byteLength") + 6), "\"label\":\"byteLength\""))
  let librarySource = "use console\nuse math\nuse test\nuse host\nuse tasks\ndef main(): Void\n  console::println(\"hello\")\n  let value = math::max(1, 2)\n\n  test::assertEqual(value, 2)\n\n  let count = host::argumentCount()\n  let generated: Int[] = tasks::generate(1) do |index|\n    return index\n  end\nend\n"
  let libraryDocument = new LspDocument()

  libraryDocument.uri = "untitled:library-declarations"
  libraryDocument.text = librarySource
  libraryDocument.version = 1
  let libraryServer = new LspServer()

  libraryServer.documents = libraryDocument
  libraryServer.analyze(libraryDocument)

  test::assertTrue(analyzed(libraryDocument))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "use console", 4), "console.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "console::println", 2), "console.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "console::println", 10), "console.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "math::max", 7), "math.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "test::assertEqual", 8), "test.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "host::argumentCount", 8), "host.hk"))
  test::assertTrue(containsText(definitionAt(libraryDocument, librarySource, "tasks::generate", 8), "tasks.hk"))
  test::assertTrue(containsText(lspCompletion(libraryDocument, textOffset(librarySource, "console::println") + 9), "\"label\":\"println\""))
  let librarySnapshot = snapshot(libraryDocument, "library-declarations", 1)
  let importRename = lspPrepareRename(librarySnapshot, textOffset(librarySource, "use console") + 4)
  let qualifierRename = lspPrepareRename(librarySnapshot, textOffset(librarySource, "console::println") + 2)
  let directRename = lspRename(librarySnapshot, textOffset(librarySource, "use console") + 4, "terminal")

  test::assertTrue(containsText(importRename.error, "Namespaces cannot be renamed safely"))
  test::assertTrue(containsText(qualifierRename.error, "Namespaces cannot be renamed safely"))
  test::assertTrue(containsText(directRename.error, "Namespaces cannot be renamed safely"))
  let equalitySource = "def same<T: Equality>(left: T, right: T): Bool\n  return left == right\nend\n\ndef main(): Void\n  let equal = same(1, 1)\nend\n"
  let equalityDocument = new LspDocument()

  equalityDocument.uri = "untitled:equality-bound"
  equalityDocument.text = equalitySource
  equalityDocument.version = 1
  let equalityServer = new LspServer()

  equalityServer.documents = equalityDocument
  equalityServer.analyze(equalityDocument)

  test::assertTrue(analyzed(equalityDocument))
  test::assertTrue(containsText(lspCompletion(equalityDocument, textOffset(equalitySource, "same(1, 1)") + 3), "T: Equality"))
  test::assertTrue(containsText(definitionAt(equalityDocument, equalitySource, "same(1, 1)", 2), "\"line\":0,\"character\":4"))
  let contractSource = "contract Named\n  readonly def label(): String\n  end\nend\n\nclass Value\n  readonly def label(): String\n    return \"value\"\n  end\nend\n\ndef inspect<T: Named>(value: T): String\n  return value.label()\nend\n\ndef read<T: Named>(value: T): String\n  return value.label()\nend\n\ndef main(): Void\n  let label = read(new Value())\n  let other = read(new OtherValue())\nend\n\nclass OtherValue\n  readonly def label(): String\n    return \"other\"\n  end\nend\n"
  let contractDocument = new LspDocument()

  contractDocument.uri = "untitled:source-contract"
  contractDocument.text = contractSource
  contractDocument.version = 1
  let contractServer = new LspServer()

  contractServer.documents = contractDocument
  contractServer.analyze(contractDocument)

  let contractCallCompletion = lspCompletion(contractDocument, textOffset(contractSource, "read(new Value())") + 3)

  test::assertTrue(analyzed(contractDocument))
  test::assertTrue(containsText(lspCompletion(contractDocument, textOffset(contractSource, "T: Named") + 5), "Named"))
  test::assertTrue(containsText(contractCallCompletion, "T: Named"))
  test::assertTrue(!containsText(contractCallCompletion, "read<OtherValue>"))
  test::assertTrue(containsText(lspCompletion(contractDocument, textOffset(contractSource, "value.label()") + 8), "label"))
  test::assertTrue(containsText(definitionAt(contractDocument, contractSource, "T: Named", 3), "\"line\":0,\"character\":9"))
  test::assertTrue(containsText(definitionAt(contractDocument, contractSource, "value.label()", 7), "\"line\":1,\"character\":15"))
  test::assertTrue(containsText(definitionAt(contractDocument, contractSource, "read(new Value())", 2), "\"line\":15,\"character\":4"))
  let contractSnapshot = snapshot(contractDocument, "source-contract", 1)
  let contractRename = lspPrepareRename(contractSnapshot, textOffset(contractSource, "value.label()") + 7)

  test::assertTrue(containsText(contractRename.error, "Contract requirements cannot be renamed"))
  let querySnapshot = snapshot(navigationDocument, "navigation", 1)
  let duplicateSnapshot = snapshot(navigationDocument, "navigation", 1)
  let rejectedSnapshot = snapshot(navigationDocument, "other-project", 1)
  let staleSnapshot = snapshot(navigationDocument, "navigation", 0)
  let queryIndex = new LspSemanticIndex()

  queryIndex.begin("navigation", 1)
  queryIndex.addSnapshot(querySnapshot)
  queryIndex.addSnapshot(querySnapshot)
  queryIndex.addSnapshot(duplicateSnapshot)
  queryIndex.addSnapshot(rejectedSnapshot)
  queryIndex.addSnapshot(staleSnapshot)
  let boxIdentity = lspQueryCanonicalIdentity(querySnapshot, lspSnapshotIdentityAt(querySnapshot, textOffset(navigationSource, ": Box<fn(): Int>") + 2))
  let boxDefinition = lspIndexDefinition(queryIndex, boxIdentity)
  let boxReferences = lspIndexReferences(queryIndex, boxIdentity, true)
  let boxSymbols = lspIndexWorkspaceSymbols(queryIndex, "bOx")

  test::assertTrue(containsText(boxIdentity, "type:Box|untitled:navigation|"))
  test::assertTrue(boxDefinition != null && boxDefinition.snapshotKey == lspSnapshotKey(querySnapshot))
  test::assertTrue(boxReferences != null)
  var boxCount = 0
  var symbol = boxSymbols

  while symbol != null
    if symbol.name == "Box"
      boxCount = boxCount + 1

      test::assertEqual(symbol.kind, 5)
    end
    symbol = symbol.next
  end

  test::assertEqual(boxCount, 1)

  # Source starts are snapshot-local. The same closed file must deduplicate
  # when an analyzer orders it at a different absolute offset, while locals
  # at the same offset in separate files remain distinct declarations.
  let orderedFirst = sourceSnapshot("unit", "file:///one.hk", 0)
  let orderedSecond = sourceSnapshot("unit", "file:///one.hk", 40)
  let otherLocal = sourceSnapshot("unit", "file:///two.hk", 0)
  let isolation = new LspSemanticIndex()

  isolation.begin("unit", 1)
  isolation.add("local:0|file:///one.hk|0", "first", 13, orderedFirst, 0, 5, true)
  isolation.add("local:0|file:///one.hk|0", "first", 13, orderedSecond, 40, 5, true)
  isolation.add("local:0|file:///two.hk|0", "second", 13, otherLocal, 0, 5, true)
  let firstLocal = lspIndexDefinition(isolation, "local:0|file:///one.hk|0")
  let secondLocal = lspIndexDefinition(isolation, "local:0|file:///two.hk|0")
  let firstReferences = lspIndexReferences(isolation, "local:0|file:///one.hk|0", true)

  test::assertTrue(firstLocal != null && firstLocal.sourceKey == "file:///one.hk" && firstLocal.sourceOffset == 0)
  test::assertTrue(secondLocal != null && secondLocal.sourceKey == "file:///two.hk" && secondLocal.sourceOffset == 0)
  test::assertTrue(firstReferences != null && firstReferences.next == null)

  isolation.begin("unit", 2)
  isolation.add("fresh", "fresh", 13, orderedFirst, 0, 5, true)

  test::assertTrue(!isolation.contains("local:0|file:///one.hk|0", orderedFirst, 0, 5, true))
  test::assertTrue(isolation.contains("fresh", orderedFirst, 0, 5, true))
end
