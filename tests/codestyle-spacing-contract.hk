use test

def codeStyleSpacingAnalyze(source: String): NeriCodeStyleResult
  let options = new NeriCodeStyleOptions()
  let rule: NeriCodeStyleRule? = new NeriCodeStyleTokenSpacingRule()

  return neriCodeStyleAnalyzeWithRules(neriCodeStyleContext(source), options, rule)
end

def codeStyleSpacingFormatted(source: String): String
  let result = codeStyleSpacingAnalyze(source)

  return neriCodeStyleApply(source, result.edits)
end

def codeStyleSpacingContract(): Void
  let source = "def choose<T>(first : T,second:T):T\n  let negative = - 1\n  let result=first+negative\n  let cast = 1as Int\n  return choose<T>( first ,second ).value\nend\n"
  let expected = "def choose<T>(first: T, second: T): T\n  let negative = -1\n  let result = first + negative\n  let cast = 1 as Int\n  return choose<T>(first, second).value\nend\n"
  let formatted = codeStyleSpacingFormatted(source)
  let repeat = codeStyleSpacingAnalyze(formatted)

  test::assertEqual(formatted, expected)
  test::assertTrue(repeat.findings == null)
  let namespaces = "use IO=App :: Nested\n\ndef run(): Void\n  IO :: Factory . create()\nend\n"

  test::assertEqual(codeStyleSpacingFormatted(namespaces), "use IO = App::Nested\n\ndef run(): Void\n  IO::Factory.create()\nend\n")
end

def codeStyleSpacingRolesContract(): Void
  let source = "def compare<T>(value: T*, fallback: T?): Bool\n  let chosen = true ? value: fallback\n  let nested = true ? false ? value: fallback: choose(label : value).member\n  return value!=null && - 1<0\nend\n"
  let expected = "def compare<T>(value: T*, fallback: T?): Bool\n  let chosen = true ? value : fallback\n  let nested = true ? false ? value : fallback : choose(label: value).member\n  return value != null && -1 < 0\nend\n"

  test::assertEqual(codeStyleSpacingFormatted(source), expected)
end

def codeStyleSpacingTextContract(): Void
  let source = "def main(): Void\n  let text = \"a , b : c . d\" # keep , : . spacing\n  consume( text )\nend\n"
  let expected = "def main(): Void\n  let text = \"a , b : c . d\" # keep , : . spacing\n  consume(text)\nend\n"

  test::assertEqual(codeStyleSpacingFormatted(source), expected)
end
