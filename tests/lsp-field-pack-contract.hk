use host
use test

def fieldPackDocument(source: String): LspDocument
  let marker = bootstrapFindText(source, "|")
  let document = new LspDocument()

  test.assertTrue(marker >= 0)
  document.uri = "untitled:field-pack"
  document.text = host.stringSlice(source, 0, marker) + host.stringSlice(source, marker + 1, host.stringByteLength(source) - marker - 1)
  let directory = host.environment("NERI_STDLIB")

  test.assertTrue(directory != null)
  if directory != null
    let fields = host.readText(directory + "/fields.hk")
    let quotation = host.readText(directory + "/quotation.hk")

    test.assertTrue(fields != null)
    test.assertTrue(quotation != null)
    if fields != null && quotation != null
      document.text = document.text + fields + "\n" + quotation
    end
  end
  let tokens = (new BootstrapLexer(document.text)).lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, root, tokens.startAt(tokens.count() - 1))

  binder.recordCompletionSites = true
  document.tokens = tokens
  document.syntax = parser.arena
  document.syntaxRoot = root
  let semantic = binder.bind()

  test.assertEqual(semantic.diagnostics.count(), 0)
  document.semantic = semantic
  document.sourceUris.add(document.uri)
  document.sourceTexts.add(document.text)
  document.sourceStarts.add(0)
  return document
end

def fieldPackCompletion(source: String): String
  let document = fieldPackDocument(source)

  return lspCompletion(document, bootstrapFindText(source, "|"))
end

def fieldPackDeclarations(): String
  return "class Entity\n  public enabled: Bool = false\nend\n\nclass Customer: Entity\n  public active: Bool = false\n  public name: String? = null\n  private secret: Int = 0\nend\n\nclass Query\n  public def where(labels filters: fields of Customer): Int\n    return 0\n  end\n\n  public def select(active: Int, labels filters: fields of Customer): Int\n    return active\n  end\nend\n"
end

def main(): Void
  let incomplete = fieldPackDeclarations() + "\ndef main(): Void\n  let result = new Query().where(|active: true)\nend\n"
  let incompleteResult = fieldPackCompletion(incomplete)

  test.assertTrue(bootstrapFindText(incompleteResult, "\"label\":\"active\"") >= 0)
  test.assertTrue(bootstrapFindText(incompleteResult, "\"label\":\"filters\"") < 0)
  test.assertTrue(bootstrapFindText(incompleteResult, "\"label\":\"enabled\"") >= 0)
  test.assertTrue(bootstrapFindText(incompleteResult, "\"label\":\"secret\"") < 0)

  let supplied = fieldPackDeclarations() + "\ndef main(): Void\n  let result = new Query().where(active: true, na|me: null)\nend\n"
  let suppliedResult = fieldPackCompletion(supplied)

  test.assertTrue(bootstrapFindText(suppliedResult, "\"label\":\"active\"") < 0)
  test.assertTrue(bootstrapFindText(suppliedResult, "\"label\":\"name\"") >= 0)

  let value = fieldPackDeclarations() + "\ndef main(): Void\n  let fallback: Bool = false\n  let result = new Query().where(active: fa|llback)\nend\n"
  let valueResult = fieldPackCompletion(value)

  test.assertTrue(bootstrapFindText(valueResult, "\"label\":\"false\"") >= 0)
  test.assertTrue(bootstrapFindText(valueResult, "\"label\":\"null\"") < 0)

  let collision = fieldPackDeclarations() + "\ndef main(): Void\n  let result = new Query().select(1, |name: null)\nend\n"
  let collisionResult = fieldPackCompletion(collision)

  test.assertTrue(bootstrapFindText(collisionResult, "\"label\":\"active\"") < 0)
  test.assertTrue(bootstrapFindText(collisionResult, "\"label\":\"name\"") >= 0)

  let signatureSource = fieldPackDeclarations() + "\ndef main(): Void\n  let result = new Query().where(active: tr|ue)\nend\n"
  let signatureDocument = fieldPackDocument(signatureSource)
  let signature = lspSignatureHelp(signatureDocument, bootstrapFindText(signatureSource, "|"))

  test.assertTrue(bootstrapFindText(signature, "labels filters: (fields of Customer)") >= 0)
  test.assertTrue(bootstrapFindText(signature, "\"activeParameter\":0") >= 0)
end
