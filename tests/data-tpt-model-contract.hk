use test

def schemaMappingCheckTPT(root: String): Void
  schemaMappingWrite(
    root + "/entities.hk",
    "namespace model\n\nabstract class TptRoot\n  public id: Int\n  public label: String = \"\"\n  public version: Int\nend\n\nclass TptMiddle: TptRoot\n  public rank: Int\nend\n\nclass TptLeaf: TptMiddle\n  public enabled: Bool\nend\n\nclass TptOther: TptRoot\n  public weight: Int\nend\n"
  )
  let mapping = schemaMappingLoad(
    root,
    "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"mapped_data\",\"context\":\"TptDatabase\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.TptRoot\",\"set\":\"roots\",\"table\":\"tpt_root\",\"key\":\"id\",\"keyGeneration\":\"onAdd\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"label\",\"column\":\"label\"},{\"member\":\"version\",\"column\":\"version\"}],\"hierarchy\":{\"strategy\":\"tpt\",\"discriminatorColumn\":\"kind\",\"value\":\"root\",\"derivedTypes\":[{\"type\":\"model.TptMiddle\",\"value\":\"middle\",\"table\":\"tpt_middle\",\"columns\":[{\"member\":\"rank\",\"column\":\"rank\"}]},{\"type\":\"model.TptLeaf\",\"value\":\"leaf\",\"table\":\"tpt_leaves\",\"columns\":[{\"member\":\"enabled\",\"column\":\"enabled\"}]},{\"type\":\"model.TptOther\",\"value\":\"other\",\"table\":\"tpt_others\",\"columns\":[{\"member\":\"weight\",\"column\":\"weight\"}]}]},\"concurrencyTokens\":[\"version\"]}]}"
  )

  if mapping.error != ""
    console::println(mapping.error)
  end

  test::assertEqual(mapping.error, "")
  let body = "  let schema = schema_TptDatabase()\n\n  test::assertTrue(schema.validate() == null)\n  test::assertTrue(schema.find(\"model.TptRoot\") != null)\n  test::assertTrue(schema.find(\"model.TptMiddle\") != null)\n  test::assertTrue(schema.find(\"model.TptLeaf\") != null)\n  let path = " + lspQuote(root + "/tpt-model.sqlite") + "\n\n  test::assertTrue(createSQLiteFixture(path, \"CREATE TABLE tpt_root(id INTEGER PRIMARY KEY,label TEXT NOT NULL,version INTEGER NOT NULL); CREATE TABLE tpt_middle(id INTEGER PRIMARY KEY REFERENCES tpt_root(id),rank INTEGER NOT NULL CHECK(rank >= 0)); CREATE TABLE tpt_leaves(id INTEGER PRIMARY KEY REFERENCES tpt_middle(id),enabled INTEGER NOT NULL); CREATE TABLE tpt_others(id INTEGER PRIMARY KEY REFERENCES tpt_root(id),weight INTEGER NOT NULL)\"))\n  match SQLiteProvider.openWritable(path)\n    case SQLiteOpenResult.Failure(error)\n      test::assertTrue(false)\n    case SQLiteOpenResult.Opened(provider)\n      let database = new TptDatabase(provider)\n      let leaf = new model::TptLeaf()\n      let other = new model::TptOther()\n\n      leaf.id = 0\n      leaf.label = \"leaf\"\n      leaf.rank = 7\n      leaf.enabled = true\n      other.id = 0\n      other.label = \"other\"\n      other.weight = 9\n\n      test::assertTrue(database.roots.add(leaf) == null)\n      test::assertTrue(database.roots.add(other) == null)\n      saved(database.saveChanges(), 5)\n      let attached = new TptDatabase(provider)\n      let attachedLeaf = new model::TptLeaf()\n\n      attachedLeaf.id = leaf.id\n      attachedLeaf.label = leaf.label\n      attachedLeaf.rank = leaf.rank\n      attachedLeaf.enabled = leaf.enabled\n      attachedLeaf.version = leaf.version\n\n      test::assertTrue(attached.roots.attach(attachedLeaf) == null)\n      attachedLeaf.rank = 8\n      saved(attached.saveChanges(), 2)\n      leaf.rank = 8\n\n      let fresh = new TptDatabase(provider)\n      let loaded = one(fresh.ofType_TptLeaf().all())\n      let root = one(fresh.roots.where(id: leaf.id).all())\n\n      test::assertTrue(loaded != null && root != null)\n      if loaded != null && root != null\n        test::assertTrue(reference::same<model::TptRoot>(loaded, root))\n        loaded.rank = 10\n        saved(fresh.beginTransaction(), 0)\n        saved(fresh.saveChanges(), 2)\n        saved(fresh.rollbackTransaction(), 0)\n        let before = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(before != null)\n        if before != null\n          test::assertEqual(before.rank, 8)\n        end\n        saved(fresh.saveChanges(), 2)\n        let stored = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(stored != null)\n        if stored != null\n          test::assertEqual(stored.rank, 10)\n        end\n        loaded.rank = -1\n        match fresh.saveChanges()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        let unchanged = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(unchanged != null)\n        if unchanged != null\n          test::assertEqual(unchanged.rank, 10)\n        end\n        loaded.rank = 11\n        saved(fresh.saveChanges(), 2)\n\n        test::assertTrue(createSQLiteFixture(path, \"UPDATE tpt_root SET version=1 WHERE id=\" + (loaded.id as String)))\n        loaded.rank = 12\n        match fresh.saveChanges()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        let concurrent = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(concurrent != null)\n        if concurrent != null\n          test::assertEqual(concurrent.rank, 11)\n          test::assertEqual(concurrent.version, 1)\n        end\n\n        test::assertTrue(createSQLiteFixture(path, \"UPDATE tpt_root SET version=0 WHERE id=\" + (loaded.id as String)))\n        loaded.rank = 11\n\n        test::assertTrue(fresh.roots.remove(loaded) == null)\n        saved(fresh.saveChanges(), 3)\n      end\n      let retryDatabase = new TptDatabase(provider)\n      let retry = new model::TptLeaf()\n\n      retry.label = \"retry\"\n      retry.rank = -1\n      retry.enabled = true\n\n      test::assertTrue(retryDatabase.roots.add(retry) == null)\n      let temporary = retry.id\n\n      test::assertTrue(temporary < 0)\n      match retryDatabase.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(checkFailure(error))\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      test::assertEqual(retry.id, temporary)\n      retry.rank = 2\n      saved(retryDatabase.saveChanges(), 3)\n\n      test::assertTrue(retry.id > 0)\n\n      match new TptDatabase(provider).ofType_TptMiddle().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n      match new TptDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 2)\n      end\n\n      let bulk = new TptDatabase(provider)\n      saved(bulk.roots.whereMappedCell(\"rank\", Cell.Int(2)).executeUpdate(label: \"bulk\"), 1)\n      let bulkLeaf = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n      test::assertTrue(bulkLeaf != null)\n      if bulkLeaf != null\n        test::assertEqual(bulkLeaf.label, \"bulk\")\n      end\n      match bulk.roots.executeUpdateMappedCell(\"rank\", Cell.Int(3))\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n      match bulk.roots.executeDelete()\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      test::assertTrue(provider.close())\n  end\n"

  schemaMappingRunConsumer(
    root,
    mapping,
    "tpt-model-consumer",
    body,
    "use neri_data\nuse reference\nuse neri_data_sqlite\nuse neri_data_sqlite_fixture\n\ndef one<T>(rows: QueryResult<T>): T?\n  match rows\n    case QueryResult.Rows(value)\n      let first = value.first()\n\n      return first == null ? null : first.value\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n      return null\n  end\nend\n\ndef saved(value: WriteResult, expected: Int): Void\n  match value\n    case WriteResult.Saved(count)\n      test::assertEqual(count, expected)\n    case WriteResult.SavedWithValues(count, unused)\n      test::assertEqual(count, expected)\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n\n      test::assertTrue(false)\n  end\nend\ndef checkFailure(value: WriteFailure): Bool\n  match value\n    case WriteFailure.Provider(provider)\n      match provider\n        case ProviderFailure.Driver(error)\n          return error.primaryCode() == 19 && error.extendedCode() == 275\n        case ProviderFailure.State(message)\n        case ProviderFailure.Cleanup(error)\n      end\n    case WriteFailure.Validation(message)\n    case WriteFailure.Concurrency(message)\n    case WriteFailure.Constraint(message)\n    case WriteFailure.Unsupported(message)\n    case WriteFailure.Transaction(message)\n    case WriteFailure.Cleanup(error)\n  end\n  return false\nend\n\n",
    sqlite: true
  )
  schemaMappingRunConsumer(
    root,
    mapping,
    "tpt-model-postgresql-consumer",
    "  let schema = schema_TptDatabase()\n\n  test::assertTrue(schema.validate() == null)\n  test::assertTrue(schema.find(\"model.TptRoot\") != null)\n  test::assertTrue(schema.find(\"model.TptMiddle\") != null)\n  test::assertTrue(schema.find(\"model.TptLeaf\") != null)\n  let conninfo = host::environment(\"NERI_POSTGRES_CONNINFO\")\n\n  if conninfo == null\n    return\n  end\n  match PostgreSQLProvider.open(conninfo)\n    case result::Result.Error(error)\n      test::assertTrue(false)\n    case result::Result.Ok(provider)\n      for statement in [\"CREATE TEMP TABLE tpt_root(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,label TEXT NOT NULL,version BIGINT NOT NULL)\", \"CREATE TEMP TABLE tpt_middle(id BIGINT PRIMARY KEY REFERENCES tpt_root(id),rank BIGINT NOT NULL CHECK(rank >= 0))\", \"CREATE TEMP TABLE tpt_leaves(id BIGINT PRIMARY KEY REFERENCES tpt_middle(id),enabled BOOLEAN NOT NULL)\", \"CREATE TEMP TABLE tpt_others(id BIGINT PRIMARY KEY REFERENCES tpt_root(id),weight BIGINT NOT NULL)\"]\n        test::assertTrue(pgFixture(provider, statement))\n      end\n      let database = new TptDatabase(provider)\n      let leaf = new model::TptLeaf()\n      let other = new model::TptOther()\n\n      leaf.id = 0\n      leaf.label = \"leaf\"\n      leaf.rank = 7\n      leaf.enabled = true\n      other.id = 0\n      other.label = \"other\"\n      other.weight = 9\n\n      test::assertTrue(database.roots.add(leaf) == null)\n      test::assertTrue(database.roots.add(other) == null)\n      saved(database.saveChanges(), 5)\n      let attached = new TptDatabase(provider)\n      let attachedLeaf = new model::TptLeaf()\n\n      attachedLeaf.id = leaf.id\n      attachedLeaf.label = leaf.label\n      attachedLeaf.rank = leaf.rank\n      attachedLeaf.enabled = leaf.enabled\n      attachedLeaf.version = leaf.version\n\n      test::assertTrue(attached.roots.attach(attachedLeaf) == null)\n      attachedLeaf.rank = 8\n      saved(attached.saveChanges(), 2)\n      leaf.rank = 8\n\n      let fresh = new TptDatabase(provider)\n      let loaded = one(fresh.ofType_TptLeaf().all())\n      let root = one(fresh.roots.where(id: leaf.id).all())\n\n      test::assertTrue(loaded != null && root != null)\n      if loaded != null && root != null\n        test::assertTrue(reference::same<model::TptRoot>(loaded, root))\n        loaded.rank = 10\n        saved(fresh.beginTransaction(), 0)\n        saved(fresh.saveChanges(), 2)\n        saved(fresh.rollbackTransaction(), 0)\n        let before = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(before != null)\n        if before != null\n          test::assertEqual(before.rank, 8)\n        end\n        saved(fresh.saveChanges(), 2)\n        let stored = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(stored != null)\n        if stored != null\n          test::assertEqual(stored.rank, 10)\n        end\n        loaded.rank = -1\n        match fresh.saveChanges()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        let unchanged = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(unchanged != null)\n        if unchanged != null\n          test::assertEqual(unchanged.rank, 10)\n        end\n        loaded.rank = 11\n        saved(fresh.saveChanges(), 2)\n\n        test::assertTrue(pgFixture(provider, \"UPDATE tpt_root SET version=1 WHERE id=\" + (loaded.id as String)))\n        loaded.rank = 12\n        match fresh.saveChanges()\n          case WriteResult.Failure(error)\n            test::assertTrue(true)\n          case WriteResult.Saved(count)\n            test::assertTrue(false)\n          case WriteResult.SavedWithValues(count, values)\n            test::assertTrue(false)\n        end\n        let concurrent = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n        test::assertTrue(concurrent != null)\n        if concurrent != null\n          test::assertEqual(concurrent.rank, 11)\n          test::assertEqual(concurrent.version, 1)\n        end\n\n        test::assertTrue(pgFixture(provider, \"UPDATE tpt_root SET version=0 WHERE id=\" + (loaded.id as String)))\n        loaded.rank = 11\n\n        test::assertTrue(fresh.roots.remove(loaded) == null)\n        saved(fresh.saveChanges(), 3)\n      end\n      let retryDatabase = new TptDatabase(provider)\n      let retry = new model::TptLeaf()\n\n      retry.label = \"retry\"\n      retry.rank = -1\n      retry.enabled = true\n\n      test::assertTrue(retryDatabase.roots.add(retry) == null)\n      let temporary = retry.id\n\n      test::assertTrue(temporary < 0)\n      match retryDatabase.saveChanges()\n        case WriteResult.Failure(error)\n          test::assertTrue(checkFailure(error))\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      test::assertEqual(retry.id, temporary)\n      retry.rank = 2\n      saved(retryDatabase.saveChanges(), 3)\n\n      test::assertTrue(retry.id > 0)\n\n      match new TptDatabase(provider).ofType_TptMiddle().all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 1)\n      end\n      match new TptDatabase(provider).roots.all()\n        case QueryResult.Failure(error)\n          test::assertTrue(false)\n        case QueryResult.Rows(rows)\n          test::assertEqual(rows.count(), 2)\n      end\n\n      let bulk = new TptDatabase(provider)\n      saved(bulk.roots.whereMappedCell(\"rank\", Cell.Int(2)).executeUpdate(label: \"bulk\"), 1)\n      let bulkLeaf = one(new TptDatabase(provider).ofType_TptLeaf().all())\n\n      test::assertTrue(bulkLeaf != null)\n      if bulkLeaf != null\n        test::assertEqual(bulkLeaf.label, \"bulk\")\n      end\n      match bulk.roots.executeUpdateMappedCell(\"rank\", Cell.Int(3))\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n      match bulk.roots.executeDelete()\n        case WriteResult.Failure(error)\n          test::assertTrue(true)\n        case WriteResult.Saved(count)\n          test::assertTrue(false)\n        case WriteResult.SavedWithValues(count, values)\n          test::assertTrue(false)\n      end\n\n      test::assertTrue(provider.closeFailure() == null)\n  end\n",
    "use neri_data\nuse reference\nuse host\nuse result\nuse neri_data_postgresql\n\ndef one<T>(rows: QueryResult<T>): T?\n  match rows\n    case QueryResult.Rows(value)\n      let first = value.first()\n\n      return first == null ? null : first.value\n    case QueryResult.Failure(error)\n      test::assertTrue(false)\n      return null\n  end\nend\n\ndef saved(value: WriteResult, expected: Int): Void\n  match value\n    case WriteResult.Saved(count)\n      test::assertEqual(count, expected)\n    case WriteResult.SavedWithValues(count, unused)\n      test::assertEqual(count, expected)\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n\n      test::assertTrue(false)\n  end\nend\n\ndef pgFixture(provider: PostgreSQLProvider, sql: String): Bool\n  match provider.executeSet(new SetWritePlan(sql, new WriteValues()))\n    case WriteResult.Failure(error)\n      console::println(writeFailureMessage(error))\n      return false\n    case WriteResult.Saved(count)\n      return true\n    case WriteResult.SavedWithValues(count, values)\n      return true\n  end\nend\n\ndef checkFailure(value: WriteFailure): Bool\n  match value\n    case WriteFailure.Provider(provider)\n      match provider\n        case ProviderFailure.Driver(error)\n          return error.sqlState() == \"23514\"\n        case ProviderFailure.State(message)\n        case ProviderFailure.Cleanup(error)\n      end\n    case WriteFailure.Validation(message)\n    case WriteFailure.Concurrency(message)\n    case WriteFailure.Constraint(message)\n    case WriteFailure.Unsupported(message)\n    case WriteFailure.Transaction(message)\n    case WriteFailure.Cleanup(error)\n  end\n  return false\nend\n\n",
    postgresql: true
  )
end
