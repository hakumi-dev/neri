use console
use files
use host
use neri_data
use test

def hierarchySeedTable(strategy: String, name: String): String
  return strategy == "tph" ? "" : ",\"table\":" + lspQuote(name)
end

def hierarchySeedMapping(strategy: String, duplicate: Bool = false): String
  let root = "{\"type\":\"model.SeedRoot\",\"set\":\"roots\",\"table\":\"seed_roots\",\"key\":[\"tenant\",\"id\"],\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"tenant\",\"column\":\"tenant\"},{\"member\":\"label\",\"column\":\"label\"}],\"seeds\":[{\"id\":1,\"tenant\":7,\"label\":\"root\"}]"
  let middle = "{\"type\":\"model.SeedMiddle\",\"value\":\"middle\",\"columns\":[{\"member\":\"rank\",\"column\":\"rank\"}]" + hierarchySeedTable(
    strategy,
    "seed_middle"
  ) + "}"
  let leaf = "{\"type\":\"model.SeedLeaf\",\"value\":\"leaf\",\"columns\":[{\"member\":\"enabled\",\"column\":\"enabled\"}],\"seeds\":[{\"id\":2,\"tenant\":7,\"label\":\"leaf\",\"rank\":9,\"enabled\":true}]" + hierarchySeedTable(
    strategy,
    "seed_leaves"
  ) + "}"
  let other = "{\"type\":\"model.SeedOther\",\"value\":\"other\",\"columns\":[{\"member\":\"weight\",\"column\":\"weight\"}],\"seeds\":[{\"id\":" + (duplicate ? "2" : "3") + ",\"tenant\":7,\"label\":\"other\",\"weight\":5}]" + hierarchySeedTable(
    strategy,
    "seed_others"
  ) + "}"

  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"mapped_data\",\"context\":\"SeedDatabase\",\"output\":\"generated\",\"entities\":[" + root + ",\"hierarchy\":{\"strategy\":" + lspQuote(strategy) + ",\"discriminatorColumn\":\"kind\",\"value\":\"root\",\"derivedTypes\":[" + middle + "," + leaf + "," + other + "]}}]}"
end

def hierarchySeedSignature(mapping: DataMapping): String
  let snapshot = dataMigrationModel(mapping)
  let model = snapshot.model

  if model == null
    console::println(snapshot.error)

    test::assertTrue(false)
    return ""
  end
  match diffSchema("initial", new SchemaModel([]), model)
    case SchemaDiffResult.Plan(plan)
      return plan.migration().signature()
    case SchemaDiffResult.Unchanged()
    case SchemaDiffResult.Failure(error)
  end

  test::assertTrue(false)
  return ""
end

def main(): Void
  let repository = host::argumentAt(0)

  test::assertTrue(repository != null)
  if repository == null
    return
  end
  let root = bootstrapTemporaryDirectory(repository + "/build", "data-hierarchy-seed-contract")
  let fixture = host::readText(repository + "/tests/fixtures/data-hierarchy-seed-consumer.hk")

  test::assertTrue(root != null && fixture != null)
  if root == null || fixture == null
    return
  end

  test::assertTrue(files::createDirectory(root + "/generated").failure == null)
  schemaMappingWrite(
    root + "/manifest.json",
    "{\"version\":2,\"defaultUnit\":\"entities\",\"units\":{\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]}}}"
  )
  schemaMappingWrite(
    root + "/entities.hk",
    "namespace model\n\nclass SeedRoot\n  public id: Int\n  public tenant: Int\n  public label: String = \"\"\nend\n\nabstract class SeedMiddle: SeedRoot\n  public rank: Int\nend\n\nclass SeedLeaf: SeedMiddle\n  public enabled: Bool\nend\n\nclass SeedOther: SeedRoot\n  public weight: Int\nend\n"
  )
  for strategy in ["tph", "tpt", "tpc"]
    let mapping = schemaMappingLoad(root, hierarchySeedMapping(strategy))
    let signature = hierarchySeedSignature(mapping)
    let database = root + "/" + strategy + ".sqlite"

    schemaMappingRunConsumer(
      root,
      mapping,
      strategy + "-seed-consumer",
      "  verifyHierarchySeeds(" + lspQuote(database) + ", " + lspQuote(signature) + ")\n",
      fixture,
      sqlite: true
    )
  end
  let duplicate = schemaMappingLoad(root, hierarchySeedMapping("tpc", duplicate: true))

  test::assertTrue(duplicate.error.contains("across the hierarchy"))
  files::removeTree(root)
end
