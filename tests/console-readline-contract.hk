use console
use test

def main(): Void
  let blank = console.readLine()
  test.assertTrue(blank != null)
  if blank != null
    test.assertEqual(blank, "")
  end
  let value = console.readLine()
  test.assertTrue(value != null)
  if value != null
    test.assertEqual(value, "value")
  end
  test.assertTrue(console.readLine() == null)
  # The original reader keeps its empty-string EOF contract.
  test.assertEqual(console.read(), "")
end
