use host
use test

def replaceFirst(source: String, expected: String, replacement: String): String
  let start = bootstrapFindText(source, expected)

  test.assertTrue(start >= 0)

  return host.stringSlice(source, 0, start) + replacement + host.stringSlice(source, start + host.stringByteLength(expected), host.stringByteLength(source) - start - host.stringByteLength(expected))
end

def bindFieldsSource(source: String): SemanticModel
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())
  let syntaxRoot = parser.parseProgram()

  test.assertEqual(parser.diagnostics.count(), 0)

  return (new BootstrapBinder(parser.arena, syntaxRoot, (new IrSourceMap(source)).utf16Length())).bind()
end

def hasDiagnostic(model: SemanticModel, code: String): Bool
  var index = 0

  while index < model.diagnostics.count()
    if model.diagnostics.codes.get(index) == code
      return true
    end
    index = index + 1
  end
  return false
end

def main(): Void
  let optionalRoot = host.argumentAt(0)

  test.assertTrue(optionalRoot != null)

  if optionalRoot == null
    return
  end
  let optionalQuotation = host.readText(optionalRoot + "/stdlib/quotation.hk")
  let optionalFields = host.readText(optionalRoot + "/stdlib/fields.hk")

  test.assertTrue(optionalQuotation != null && optionalFields != null)

  if optionalQuotation == null || optionalFields == null
    return
  end
  let entryPoint = "use fields\n\ndef main(): Void\n  fixture.collect(active: true)\nend\n\n"
  let fixture = "\nnamespace fixture\n\nclass Customer\n  public active: Bool = false\nend\n\ndef collect(labels filters: fields of Customer): Void\nend\n"
  let validSource = entryPoint + optionalQuotation + "\n" + optionalFields + fixture
  let valid = bindFieldsSource(validSource)

  test.assertEqual(valid.diagnostics.count(), 0)

  var invalidFields = replaceFirst(optionalFields, "private storedValue: quotation.CaptureValue", "private storedValue: Bool")

  invalidFields = replaceFirst(invalidFields, "def init(identity: String, typeName: String, value: quotation.CaptureValue): Void", "def init(identity: String, typeName: String, value: Bool): Void")
  invalidFields = replaceFirst(invalidFields, "public readonly def value(): readonly quotation.CaptureValue", "public readonly def value(): Bool")
  let invalid = bindFieldsSource(entryPoint + optionalQuotation + "\n" + invalidFields + fixture)

  test.assertTrue(hasDiagnostic(invalid, "NR277"))
  test.assertFalse(hasDiagnostic(invalid, "NR112"))
  test.assertFalse(hasDiagnostic(invalid, "NR143"))
end
