use host
use test

def bindFieldsSource(sources: StandardLibraryTestSources): SemanticModel
  let source = sources.source()
  let parser = new BootstrapParser((new BootstrapLexer(source)).lex())

  var index = 0

  while index < sources.count()
    parser.addSourceBoundary(sources.startAt(index))
    index = index + 1
  end
  let syntaxRoot = parser.parseProgram()

  test::assertEqual(parser.diagnostics.count(), 0)
  let binder = new BootstrapBinder(parser.arena, syntaxRoot, (new IrSourceMap(source)).utf16Length())

  binder.clearSources()
  index = 0
  while index < sources.count()
    binder.addSource(sources.idAt(index), sources.startAt(index))
    index = index + 1
  end

  return binder.bind()
end

def hasDiagnostic(model: SemanticModel, code: String): Bool
  var index = 0

  while index < model.diagnostics.count()
    if model.diagnostics.codes.get(index) == code
      return true
    end
    index = index + 1
  end
  return false
end

def main(): Void
  let optionalRoot = host::argumentAt(0)

  test::assertTrue(optionalRoot != null)

  if optionalRoot == null
    return
  end
  let directory = optionalRoot + "/stdlib"
  let entryPoint = "use fields\n\ndef main(): Void\n  fixture::collect(active: true)\nend\n\n"
  let fixture = "\nnamespace fixture\n\nclass Customer\n  public active: Bool = false\nend\n\ndef collect(labels filters: fields of Customer): Void\nend\n"
  let validSources = new StandardLibraryTestSources(directory)

  validSources.addSource("main", entryPoint)
  validSources.addModule("fields")
  validSources.addSource("fixture", fixture)

  test::assertEqual(validSources.error, "")
  let valid = bindFieldsSource(validSources)

  test::assertEqual(valid.diagnostics.count(), 0)
  let invalidSources = new StandardLibraryTestSources(directory)

  invalidSources.addSource("main", entryPoint)
  invalidSources.addModule("fields")
  invalidSources.addSource("fixture", fixture)

  test::assertEqual(invalidSources.error, "")
  test::assertTrue(invalidSources.replaceFirst("@stdlib/fields/entry.hk", "private storedValue: quotation::CaptureValue", "private storedValue: Bool"))
  test::assertTrue(invalidSources.replaceFirst("@stdlib/fields/entry.hk", "def init(identity: String, typeName: String, value: quotation::CaptureValue): Void", "def init(identity: String, typeName: String, value: Bool): Void"))
  test::assertTrue(invalidSources.replaceFirst("@stdlib/fields/entry.hk", "public readonly def value(): readonly quotation::CaptureValue", "public readonly def value(): Bool"))
  let invalid = bindFieldsSource(invalidSources)

  test::assertTrue(hasDiagnostic(invalid, "NR277"))
  test::assertFalse(hasDiagnostic(invalid, "NR112"))
  test::assertFalse(hasDiagnostic(invalid, "NR143"))
end
