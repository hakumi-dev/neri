use host
use test

def objectFixture(): Byte[]
  var bytes: Byte[] = []
  var index = 0

  while index < 40
    bytes = host::appendByte(bytes, 0 as Byte)
    index = index + 1
  end
  bytes[0] = 207 as Byte
  bytes[1] = 250 as Byte
  bytes[2] = 237 as Byte
  bytes[3] = 254 as Byte
  bytes[4] = 12 as Byte
  bytes[7] = 1 as Byte
  bytes[12] = 1 as Byte
  bytes[16] = 1 as Byte
  bytes[20] = 8 as Byte
  bytes[32] = 42 as Byte
  bytes[36] = 8 as Byte
  return bytes
end

def archiveText(bytes: Byte[], text: String): Byte[]
  var output = bytes
  var index = 0

  while index < host::stringByteLength(text)
    output = host::appendByte(output, host::stringByteAt(text, index))
    index = index + 1
  end
  return output
end

def archiveMember(bytes: Byte[], name: String, object: Byte[]): Byte[]
  var field = name

  while host::stringByteLength(field) < 16
    field = field + " "
  end
  var size = object.Length as String

  while host::stringByteLength(size) < 10
    size = size + " "
  end
  var output = archiveText(bytes, field + "0           0     0     644     " + size + "`\n")

  for byte in object
    output = host::appendByte(output, byte)
  end
  output = host::appendByte(output, 10 as Byte) if (object.Length / 2) * 2 != object.Length
  return output
end

def main(): Void
  let object = objectFixture()

  test::assertTrue(nativeLinkObjectBytes(object))
  object[12] = 6 as Byte

  test::assertTrue(nativeLinkObjectBytes(object))
  object[12] = 1 as Byte
  object[36] = 16 as Byte

  test::assertTrue(!nativeLinkObjectBytes(object))
  object[36] = 8 as Byte
  object[4] = 7 as Byte

  test::assertTrue(!nativeLinkObjectBytes(object))
  object[4] = 12 as Byte
  object[32] = 45 as Byte

  test::assertTrue(!nativeLinkObjectBytes(object))
  object[32] = 42 as Byte
  let bitcode: Byte[] = [66 as Byte, 67 as Byte, 192 as Byte, 222 as Byte]
  let magic = archiveText([], "!<arch>\n")
  let archive = archiveMember(magic, "unit.o/", object)

  test::assertTrue(!nativeLinkObjectBytes(bitcode))
  test::assertTrue(nativeLinkObjectBytes(archive))
  test::assertTrue(!nativeLinkObjectBytes(archiveMember(magic, "unit.o/", bitcode)))
  test::assertTrue(!nativeLinkObjectBytes(archiveText(archive, "partial")))
  test::assertTrue(!nativeLinkObjectBytes(archiveMember(magic, "#1/80", object)))
  let extended = archiveText([], "long-object-name.o")
  var payload = extended

  for byte in object
    payload = host::appendByte(payload, byte)
  end

  test::assertTrue(nativeLinkObjectBytes(archiveMember(magic, "#1/18", payload)))
  let symbolData: Byte[] = [0 as Byte, 0 as Byte, 0 as Byte, 0 as Byte, 0 as Byte, 0 as Byte, 0 as Byte, 0 as Byte]
  let indexed = archiveMember(archiveMember(magic, "__.SYMDEF", symbolData), "unit.o/", object)

  test::assertTrue(nativeLinkObjectBytes(indexed))
  test::assertTrue(!nativeLinkObjectBytes(archiveMember(magic, "__.SYMDEF", bitcode)))
  let manifestPath = host::environment("NERI_RUNTIME_MANIFEST")

  if manifestPath != null
    let manifest = host::readText(manifestPath)

    if manifest != null && bootstrapManifestString(manifest, "target") == "macos-arm64"
      let runtime = bootstrapManifestString(manifest, "artifact")
      let path = bootstrapStartsWith(runtime, "/") ? runtime : bootstrapDirectory(manifestPath) + "/" + runtime

      test::assertTrue(runtime != "" && nativeLinkObjectFile(path))
    end
  end
end
