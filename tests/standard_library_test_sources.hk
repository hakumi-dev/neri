use host

class StandardLibraryTestSources
  private directory: String
  private catalog: StandardLibraryCatalog
  private combined: String = ""
  private ids: StringBuffer = new StringBuffer()
  private texts: StringBuffer = new StringBuffer()
  private starts: IntBuffer = new IntBuffer()
  public error: String = ""

  def init(directory: String): Void
    this.directory = directory
    this.catalog = new StandardLibraryCatalog(directory)
    this.error = this.catalog.error
  end

  def addSource(id: String, text: String): Void
    if this.error != "" || this.hasSource(id)
      return
    end
    this.starts.add((new IrSourceMap(this.combined)).utf16Length())
    this.ids.add(id)
    this.texts.add(text)
    this.combined = this.combined + text + "\n"
  end

  def addModule(name: String): Void
    if this.error != ""
      return
    end
    let paths = this.catalog.sourcePaths(name)

    this.error = this.catalog.error
    if this.error == "" && paths.size == 0
      this.error = "Standard-library module is unavailable: " + name
      return
    end
    var path = paths.first.nextNode

    while this.error == "" && path != null
      let id = "@stdlib/" + path.value

      if !this.hasSource(id)
        let text = host::readText(this.directory + "/" + path.value)

        if text == null
          this.error = "Standard-library source is unavailable: " + path.value
          return
        end
        this.addSource(id, text)
        for imported in bootstrapLibraryImports(text)
          this.addModule(imported)
        end
      end
      path = path.nextNode
    end
  end

  def replaceFirst(id: String, expected: String, replacement: String): Bool
    var index = 0

    while index < this.ids.size
      if this.ids.get(index) == id
        let source = this.texts.get(index)
        let start = bootstrapFindText(source, expected)

        if start < 0
          return false
        end
        let updated = host::stringSlice(source, 0, start) + replacement + host::stringSlice(source, start + host::stringByteLength(expected), host::stringByteLength(source) - start - host::stringByteLength(expected))

        this.texts.set(index, updated)
        this.rebuild()
        return true
      end
      index = index + 1
    end
    return false
  end

  def count(): Int
    return this.ids.size
  end

  def idAt(index: Int): String
    return this.ids.get(index)
  end

  def textAt(index: Int): String
    return this.texts.get(index)
  end

  def startAt(index: Int): Int
    return this.starts.get(index)
  end

  def source(): String
    return this.combined
  end

  private def hasSource(id: String): Bool
    var index = 0

    while index < this.ids.size
      if this.ids.get(index) == id
        return true
      end
      index = index + 1
    end
    return false
  end

  private def rebuild(): Void
    this.combined = ""
    this.starts = new IntBuffer()
    var index = 0

    while index < this.texts.size
      this.starts.add((new IrSourceMap(this.combined)).utf16Length())
      this.combined = this.combined + this.texts.get(index) + "\n"
      index = index + 1
    end
  end
end
