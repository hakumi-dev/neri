use host
use process
use test
use console

def probe(executable: String, root: String, suffix: String): String
  let options = new process::SpawnOptions(executable)

  options.arguments = ["probe", suffix]
  options.environment = [new process::EnvironmentEntry("NERI_CACHE_DIR", root + "/cache"),
    new process::EnvironmentEntry("NERI_LINKER", root + "/" + suffix + "/clang++"),
    new process::EnvironmentEntry("SDKROOT", root + "/" + suffix + "/sdk"),
    new process::EnvironmentEntry("NERI_RUNTIME_MANIFEST", root + "/" + suffix + "/runtime.json"),
    new process::EnvironmentEntry("DEVELOPER_DIR", root + "/" + suffix + "/developer"),
    new process::EnvironmentEntry("MACOSX_DEPLOYMENT_TARGET", suffix == "first" ? "13.0" : "14.0")]
  let child = process::spawn(options).child()

  test::assertTrue(child != null)
  if child == null
    return ""
  end
  let result = child.wait(60000)
  let status = result.exit
  let output = host::stringFromBytes(result.stdout)

  test::assertTrue(!result.running && result.failure == null && status != null && status.isExited() && status.value() == 0)
  test::assertTrue(child.dispose())
  test::assertTrue(output != null && output != "")
  return output == null ? "" : output
end

def main(): Void
  if !runCacheSupportedHost()
    return
  end
  if host::argumentAt(0) == "probe"
    let cache = new RunCache()
    let target = TargetPlatform.parse("macos-arm64")

    test::assertTrue(target != null)
    if target == null
      return
    end
    cache.prepare(new IrModule("object-fixture", ""), target, true, null,
      "object-dependency-contract-v1", "", [], "fixed-ir-identity", true)

    test::assertTrue(cache.directory != "")
    if host::argumentAt(1) == "first"
      test::assertTrue(!cache.hit())
      let staging = bootstrapTemporaryDirectory(bootstrapDirectory(cache.directory), "dependency-contract")

      test::assertTrue(staging != null)
      if staging == null
        return
      end

      test::assertTrue(host::writeText(staging + "/program", "object payload"))
      test::assertTrue(host::writeText(staging + "/program.nir.hex", "actual transport payload"))
      test::assertTrue(cache.publish(staging))
    end

    test::assertTrue(cache.hit())
    test::assertTrue(host::readText(cache.executable) == "object payload")
    test::assertTrue(host::readText(cache.executable + ".nir.hex") == "actual transport payload")
    console::println("object bundle hit")
    return
  end
  let work = host::argumentAt(0)
  let executable = host::executablePath()

  test::assertTrue(work != null && executable != null)
  if work == null || executable == null
    return
  end
  let root = work + "/object-dependencies"
  let created = host::run("mkdir", ["-p", root + "/cache"])
  let protectedCache = host::run("chmod", ["700", root + "/cache"])

  test::assertTrue(created != null && created == 0 && protectedCache != null && protectedCache == 0)
  let first = probe(executable, root, "first")
  let second = probe(executable, root, "second")

  test::assertEqual(first, second)
  test::assertEqual(second, "object bundle hit\n")
end
