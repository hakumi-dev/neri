use host
use test

def main(): Void
  let work = host::argumentAt(0)

  test::assertTrue(work != null)
  if work == null
    return
  end
  let directory = work + "/native-link-digest"
  let created = host::run("mkdir", ["-p", directory])
  let path = directory + "/input"

  test::assertTrue(created != null && created == 0)
  test::assertEqual(nativeLinkFileDigest(directory), "")
  test::assertEqual(nativeLinkFileDigest(directory + "/missing"), "")
  test::assertTrue(host::writeText(path, ""))
  test::assertEqual(nativeLinkFileDigest(path), sha256FastText(runCacheFrame("neri-native-link-chunks-v1") + runCacheFrame("0") + runCacheFrame("1048576")))
  test::assertTrue(host::writeText(path, "abc"))
  test::assertEqual(nativeLinkFileDigest(path), sha256FastText(runCacheFrame("neri-native-link-chunks-v1") + runCacheFrame("3") + runCacheFrame("1048576") + runCacheFrame(sha256FastText("abc"))))

  let chunks = new StringBuffer()
  var index = 0

  while index < 16384
    chunks.add("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    index = index + 1
  end
  let firstChunk = chunks.join()
  let original = firstChunk + "tail"

  test::assertTrue(host::writeText(path, original))
  let before = nativeLinkFileDigest(path)
  let expected = sha256FastText(runCacheFrame("neri-native-link-chunks-v1") + runCacheFrame("1048580") + runCacheFrame("1048576") + runCacheFrame(sha256FastText(firstChunk)) + runCacheFrame(sha256FastText("tail")))

  test::assertEqual(before, expected)
  test::assertTrue(host::writeText(path, firstChunk + "fail"))
  test::assertTrue(nativeLinkFileDigest(path) != before)
  test::assertTrue(host::writeText(path, original))
  test::assertEqual(nativeLinkFileDigest(path), before)

  let other = directory + "/other"
  let alias = directory + "/alias"

  test::assertTrue(host::writeText(other, original))
  let linked = host::run("ln", ["-s", path, alias])

  test::assertTrue(linked != null && linked == 0)
  let inputs = new NativeLinkInputs()

  inputs.inputs.add(alias)
  inputs.valid = true
  let firstSnapshot = inputs.snapshot()

  test::assertTrue(firstSnapshot != "")
  test::assertEqual(nativeLinkFileDigest(alias), before)
  test::assertTrue(host::removeFile(alias))
  let retargeted = host::run("ln", ["-s", other, alias])

  test::assertTrue(retargeted != null && retargeted == 0)
  test::assertEqual(nativeLinkFileDigest(path), before)
  test::assertEqual(nativeLinkFileDigest(other), before)
  test::assertEqual(nativeLinkFileDigest(alias), before)
  let secondSnapshot = inputs.snapshot()

  test::assertTrue(secondSnapshot != "" && secondSnapshot != firstSnapshot)
  test::assertEqual(inputs.snapshot(), secondSnapshot)
  test::assertTrue(host::writeText(other, firstChunk + "fail"))
  let changedSnapshot = inputs.snapshot()

  test::assertTrue(changedSnapshot != "" && changedSnapshot != secondSnapshot)
  test::assertTrue(host::writeText(other, original))
  test::assertEqual(inputs.snapshot(), secondSnapshot)

  let missing = directory + "/candidate"

  inputs.missing.add(missing)
  let absentSnapshot = inputs.snapshot()

  test::assertTrue(absentSnapshot != "" && absentSnapshot != secondSnapshot)
  test::assertEqual(inputs.snapshot(), absentSnapshot)
  test::assertTrue(host::writeText(missing, "candidate"))
  test::assertEqual(inputs.snapshot(), "")
  test::assertTrue(host::removeFile(missing))
  test::assertEqual(inputs.snapshot(), absentSnapshot)

  # Link tools can exceed the reference-artifact reader's 128 MiB bound.
  let enlarged = host::run("dd", ["if=/dev/zero", "of=" + path, "bs=1", "count=0", "seek=134217729"])

  test::assertTrue(enlarged != null && enlarged == 0)
  test::assertEqual(referenceFileDigest(path), "")
  let largeDigest = nativeLinkFileDigest(path)

  test::assertEqual(host::stringByteLength(largeDigest), 64)
  let mutated = host::run("dd", ["if=" + other, "of=" + path, "bs=1", "count=1", "seek=134217728", "conv=notrunc"])

  test::assertTrue(mutated != null && mutated == 0)
  let changedDigest = nativeLinkFileDigest(path)

  test::assertEqual(host::stringByteLength(changedDigest), 64)
  test::assertTrue(changedDigest != largeDigest)
  test::assertTrue(host::removeFile(alias))
  test::assertTrue(host::removeFile(other))
  test::assertTrue(host::removeFile(path))
end
