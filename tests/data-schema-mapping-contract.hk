use test

def schemaMappingWrite(path: String, value: String): Void
  test::assertTrue(host::writeText(path, value))
end

def schemaMappingEntities(): String
  return "use quotation\n\nnamespace model\n\nclass BaseRecord\n  public id: Int\nend\n\nclass Record: BaseRecord\n  public active: Bool\n  public amount: Int\n  public maximum: Int\n  public ratio: Float\n  public label: String\n  public optionalLabel: String?\n  public optionalCount: Int?\nend\n\nclass OtherRecord\n  public id: Int\nend\n\nclass Address\n  public city: String\n  public line: String?\nend\n\nclass ComplexRecord\n  public id: Int\n  public home: Address\n  public work: Address\nend\n\nclass BoolRecord\n  public id: Int\n  public flag: Bool\n  public optionalFlag: Bool?\nend\n\nclass OptionalComplexRecord\n  public id: Int\n  public address: Address?\nend\n\nclass GraphTraversal_Database\nend\n\ndef activeRecords(): quote fn(Record): Bool\n  return quote do |record: Record|: Bool\n    return record.active\n  end\nend\n"
end

def schemaMappingText(
  columns: String,
  indexes: String = "",
  extraEntity: String = "",
  entityOptions: String = ""
): String
  return "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"mapped_data\",\"context\":\"Database\",\"output\":\"generated\",\"entities\":[{\"type\":\"model.Record\",\"set\":\"records\",\"table\":\"records\",\"key\":\"id\",\"columns\":[" + columns + "],\"indexes\":[" + indexes + "]" + entityOptions + "}" + extraEntity + "]}\n"
end

def schemaMappingColumns(
  idDefault: String = "",
  activeDefault: String = "",
  amountDefault: String = "",
  maximumDefault: String = "",
  ratioDefault: String = "",
  labelDefault: String = "",
  optionalLabelDefault: String = "",
  optionalCountDefault: String = ""
): String
  return "{\"member\":\"id\",\"column\":\"id\"" + idDefault + "},{\"member\":\"active\",\"column\":\"active\"" + activeDefault + "},{\"member\":\"amount\",\"column\":\"amount\"" + amountDefault + "},{\"member\":\"maximum\",\"column\":\"maximum\"" + maximumDefault + "},{\"member\":\"ratio\",\"column\":\"ratio\"" + ratioDefault + "},{\"member\":\"label\",\"column\":\"label\"" + labelDefault + "},{\"member\":\"optionalLabel\",\"column\":\"optional_label\"" + optionalLabelDefault + "},{\"member\":\"optionalCount\",\"column\":\"optional_count\"" + optionalCountDefault + "}"
end

def schemaMappingLoad(root: String, value: String): DataMapping
  schemaMappingWrite(root + "/mapping.json", value)

  return dataLoadMapping(root + "/mapping.json")
end

def schemaMappingReject(root: String, value: String): Void
  let mapping = schemaMappingLoad(root, value)

  if mapping.error == ""
    test::assertTrue(false)
  end
end

def schemaMappingCheckDefaultsAndIndexes(root: String): Void
  let columns = schemaMappingColumns(
    activeDefault: ",\"default\":true",
    amountDefault: ",\"default\":-9223372036854775808",
    maximumDefault: ",\"default\":9223372036854775807",
    ratioDefault: ",\"default\":1.25e-30",
    labelDefault: ",\"default\":\"O'Reilly; -- 水\"",
    optionalLabelDefault: ",\"default\":null"
  )
  let indexes = "{\"name\":\"idx_records_label\",\"members\":[\"label\",\"id\"],\"unique\":true}"
  let mapping = schemaMappingLoad(root, schemaMappingText(columns, indexes))

  test::assertEqual(mapping.error, "")
  let emission = dataEmit(mapping)

  if emission.error != ""
    console::println(emission.error)
  end

  test::assertEqual(emission.error, "")
  var schema = ""
  var artifact = emission.firstArtifact

  while artifact != null
    if artifact.name == "schema.hk"
      schema = artifact.text
    end
    artifact = artifact.nextArtifact
  end

  test::assertTrue(schema != "")

  test::assertTrue(dataPublish(mapping, emission))
  let publishedSchema = host::readText(mapping.outputPath + "/schema.hk")

  test::assertTrue(publishedSchema != null)
  if publishedSchema != null
    test::assertEqual(publishedSchema, schema)
  end

  test::assertEqual(schemaMappingCompileConsumer(root, schema), 0)
end

def schemaMappingCompileConsumer(root: String, schema: String): Int
  let consumerRoot = root + "/consumer"

  test::assertTrue(files::createDirectory(consumerRoot).failure == null)
  let large = dataFloatLiteral("1.25e30")
  let tiny = dataFloatLiteral("5e-324")

  test::assertTrue(large != null)
  test::assertTrue(tiny != null)
  if large == null || tiny == null
    return -1
  end
  schemaMappingWrite(
    consumerRoot + "/schema.hk",
    schema + "\ndef extraFloatDefaults(): Bool\n  return (" + large + " as String) == \"1.25e30\" && (" + tiny + " as String) == \"5e-324\"\nend\n"
  )
  schemaMappingWrite(
    consumerRoot + "/manifest.json",
    "{\"version\":2,\"defaultUnit\":\"schema-consumer\",\"units\":{\"schema-consumer\":{\"kind\":\"executable\",\"sources\":[\"schema.hk\",\"consumer.hk\"],\"references\":[{\"project\":\"../../../experiments/neri-data/manifest.json\",\"unit\":\"runtime\"}]}}}\n"
  )
  schemaMappingWrite(
    consumerRoot + "/consumer.hk",
    "use mapped_data\nuse neri_data\nuse test\n\ndef assertDefault(table: readonly SchemaTable, field: String, expected: String): Void\n  let member = table.find(\"model.Record.\" + field)\n\n  test::assertTrue(member != null)\n  if member != null\n    test::assertEqual(schemaDefaultCode(member.column().defaultValue()), expected)\n  end\nend\n\ndef main(): Void\n  let model = schema_Database()\n  let record = model.find(\"model.Record\")\n\n  test::assertTrue(extraFloatDefaults())\n  test::assertTrue(model.validate() == null)\n  test::assertTrue(record != null)\n  if record != null\n    test::assertEqual(record.count(), 8)\n    assertDefault(record, \"active\", \"B1\")\n    assertDefault(record, \"amount\", \"I20:-9223372036854775808\")\n    assertDefault(record, \"maximum\", \"I19:9223372036854775807\")\n    assertDefault(record, \"ratio\", \"F8:1.25e-30\")\n    assertDefault(record, \"label\", \"T16:O'Reilly; -- 水\")\n    assertDefault(record, \"optionalLabel\", \"Z\")\n    assertDefault(record, \"optionalCount\", \"N\")\n    let index = record.findIndex(\"idx_records_label\")\n\n    test::assertTrue(index != null)\n    if index != null\n      test::assertTrue(index.unique())\n      test::assertTrue(index.at(0) == \"model.Record.label\")\n      test::assertTrue(index.at(1) == \"model.BaseRecord.id\")\n    end\n  end\nend\n"
  )
  let repository = host::argumentAt(0)

  if repository == null
    return -1
  end
  let compilerArgument = host::argumentAt(1)
  var compiler = repository + "/scripts/neri.sh"

  if compilerArgument != null
    compiler = compilerArgument
  end
  let status = host::run(compiler, schemaMappingConsumerArguments(consumerRoot, "schema-consumer"))

  return status == null ? -1 : status
end

def schemaMappingConsumerArguments(root: String, unit: String): String[]
  var arguments = ["run", "--project", root, "--unit", unit]
  let mode = host::argumentAt(2)

  let inheritedMode = host::argumentAt(3)

  if (mode != null && mode == "--release") || (inheritedMode != null && inheritedMode == "--release")
    arguments = host::appendString(arguments, "--release")
  end
  return arguments
end

def schemaMappingCheckInvalidDefaults(root: String): Void
  let indexes = ""
  let defaults = schemaMappingColumns()

  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(amountDefault: ",\"default\":9223372036854775808"), indexes)
  )
  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(amountDefault: ",\"default\":-9223372036854775809"), indexes)
  )
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(amountDefault: ",\"default\":1.5"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(amountDefault: ",\"default\":1e3"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(ratioDefault: ",\"default\":1e999"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(ratioDefault: ",\"default\":1e-999"), indexes))
  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(labelDefault: ",\"default\":\"bad\\u0000value\""), indexes)
  )
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(activeDefault: ",\"default\":1"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(ratioDefault: ",\"default\":\"1.5\""), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(labelDefault: ",\"default\":true"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(amountDefault: ",\"default\":null"), indexes))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(idDefault: ",\"default\":1"), indexes))
  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(idDefault: ",\"valueGeneration\":\"onAdd\""), indexes)
  )
  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(amountDefault: ",\"valueGeneration\":\"sometimes\""), indexes)
  )
  schemaMappingReject(
    root,
    schemaMappingText(schemaMappingColumns(amountDefault: ",\"valueGeneration\":true"), indexes)
  )

  let optionalNoDefault = schemaMappingLoad(root, schemaMappingText(defaults, indexes))

  test::assertEqual(optionalNoDefault.error, "")
end

def schemaMappingCheckIndexes(root: String): Void
  let columns = schemaMappingColumns()
  let duplicateMember = "{\"name\":\"idx_duplicate\",\"members\":[\"label\",\"label\"]}"
  let unknownMember = "{\"name\":\"idx_unknown\",\"members\":[\"missing\"]}"
  let invalidName = "{\"name\":\"bad-name\",\"members\":[\"label\"]}"
  let reservedName = "{\"name\":\"__neri_reserved\",\"members\":[\"label\"]}"
  let tableCollision = "{\"name\":\"records\",\"members\":[\"label\"]}"
  let firstIndex = "{\"name\":\"idx_same\",\"members\":[\"label\"]}"
  let caseCollision = "{\"name\":\"IDX_SAME\",\"members\":[\"id\"]}"
  let second = ", {\"type\":\"model.OtherRecord\",\"set\":\"others\",\"table\":\"others\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"}],\"indexes\":[" + caseCollision + "]}"
  let reusedTable = ", {\"type\":\"model.OtherRecord\",\"set\":\"others\",\"table\":\"RECORDS\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"}]}"
  let duplicateColumn = "{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"label\",\"column\":\"ID\"}"

  schemaMappingReject(root, schemaMappingText(columns, duplicateMember))
  schemaMappingReject(root, schemaMappingText(columns, unknownMember))
  schemaMappingReject(root, schemaMappingText(columns, invalidName))
  schemaMappingReject(root, schemaMappingText(columns, reservedName))
  schemaMappingReject(root, schemaMappingText(columns, tableCollision))
  schemaMappingReject(root, schemaMappingText(columns, firstIndex + "," + caseCollision))
  schemaMappingReject(root, schemaMappingText(columns, firstIndex, second))
  schemaMappingReject(root, schemaMappingText(columns, "", reusedTable))
  schemaMappingReject(root, schemaMappingText(duplicateColumn))
end

def schemaMappingCheckConcurrency(root: String): Void
  let columns = schemaMappingColumns()

  for invalid in [
    "null",
    "true",
    "\"label\"",
    "[1]",
    "[\"missing\"]",
    "[\"id\"]",
    "[\"label\",\"label\"]",
    "[\"optional_label\"]"
  ]
    schemaMappingReject(root, schemaMappingText(columns, entityOptions: ",\"concurrencyTokens\":" + invalid))
  end
  for policy in ["", ",\"concurrencyTokens\":[]", ",\"concurrencyTokens\":[\"optionalLabel\",\"amount\"]"]
    let mapping = schemaMappingLoad(root, schemaMappingText(columns, entityOptions: policy))

    test::assertEqual(mapping.error, "")
    let entity = mapping.firstEntity

    test::assertTrue(entity != null)
    if entity != null
      let tokens = entity.concurrencyColumns

      if policy == ""
        test::assertTrue(tokens == null)
      else
        test::assertTrue(tokens != null)
        if tokens != null
          if policy == ",\"concurrencyTokens\":[]"
            test::assertEqual(tokens.size, 0)
          else
            test::assertEqual(tokens.size, 2)
            test::assertEqual(tokens.get(0), "optional_label")
            test::assertEqual(tokens.get(1), "amount")
          end
        end
      end
    end
    let emission = dataEmit(mapping)

    test::assertEqual(emission.error, "")
  end
end

def schemaMappingCheckGraphNames(root: String): Void
  let other = ",{\"type\":\"model.OtherRecord\",\"set\":\"addGraph_records\",\"table\":\"other_records\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"}]}"
  let memberCollision = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns(), extraEntity: other))

  test::assertEqual(memberCollision.error, "")
  let memberEmission = dataEmit(memberCollision)

  test::assertTrue(memberEmission.error != "")
  let typeCollision = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns()))

  test::assertEqual(typeCollision.error, "")
  typeCollision.namespaceName = "model"
  let typeEmission = dataEmit(typeCollision)

  test::assertTrue(typeEmission.error != "")
end

def schemaMappingRunConsumer(
  root: String,
  mapping: DataMapping,
  name: String,
  body: String,
  declarations: String = "",
  sqlite: Bool = false,
  postgresql: Bool = false
): Void
  let selected = host::argumentAt(2)

  if selected != null
    if selected.endsWith("-sqlite") && postgresql
      return
    end
    if selected.endsWith("-postgresql") && sqlite
      return
    end
  end
  let emission = dataEmit(mapping)

  if emission.error != ""
    console::println(emission.error)
  end

  test::assertEqual(emission.error, "")
  let consumerRoot = root + "/" + name

  test::assertTrue(files::createDirectory(consumerRoot).failure == null)
  var artifact = emission.firstArtifact
  let entities = host::readText(root + "/entities.hk")

  test::assertTrue(entities != null)
  if entities == null
    return
  end
  schemaMappingWrite(consumerRoot + "/entities.hk", entities)
  var sources = "\"entities.hk\",\"consumer.hk\""

  while artifact != null
    schemaMappingWrite(consumerRoot + "/" + artifact.name, artifact.text)
    sources = sources + "," + lspQuote(artifact.name)
    artifact = artifact.nextArtifact
  end
  schemaMappingWrite(
    consumerRoot + "/manifest.json",
    "{\"version\":2,\"defaultUnit\":\"consumer\",\"units\":{\"consumer\":{\"kind\":\"executable\",\"sources\":[" + sources + "],\"references\":[{\"project\":\"../../../experiments/neri-data/manifest.json\",\"unit\":\"runtime\"}" + (sqlite ? ",{\"project\":\"../../../experiments/neri-data/providers/sqlite/manifest.json\",\"unit\":\"sqlite\"},{\"project\":\"../../../experiments/neri-data/providers/sqlite/manifest.json\",\"unit\":\"fixture\"}" : "") + (postgresql ? ",{\"project\":\"../../../experiments/neri-data/providers/postgresql/manifest.json\",\"unit\":\"postgresql\"}" : "") + "]}}}\n"
  )
  schemaMappingWrite(
    consumerRoot + "/consumer.hk",
    "use mapped_data\nuse test\n\n" + declarations + "def main(): Void\n" + body + "end\n"
  )
  let repository = host::argumentAt(0)
  let compilerArgument = host::argumentAt(1)

  if repository != null
    let compiler = compilerArgument == null ? repository + "/scripts/neri.sh" : compilerArgument
    var arguments = schemaMappingConsumerArguments(consumerRoot, "consumer")
    let preserve = consumerRoot.endsWith("/extended-model-consumer") || consumerRoot.endsWith("/extended-model-postgresql-consumer")
    let executable = consumerRoot + "/contract-consumer"

    if preserve
      arguments[0] = "build"
      arguments = host::appendString(arguments, "--output")
      arguments = host::appendString(arguments, executable)
    end
    var status = host::run(compiler, arguments)

    if preserve && status != null && status == 0
      status = host::run(executable, [])
    end

    test::assertTrue(status != null)
    if status != null
      test::assertEqual(status, 0)
    end
  end
end

def schemaMappingCheckKeyless(root: String): Void
  let view = ",{\"type\":\"model.OtherRecord\",\"set\":\"summaries\",\"view\":\"record_summary\",\"keyless\":true,\"columns\":[{\"member\":\"id\",\"column\":\"count\"}]}"
  let mapping = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns(), extraEntity: view))

  test::assertEqual(mapping.error, "")
  schemaMappingRunConsumer(
    root,
    mapping,
    "keyless-consumer",
    "  let mapping = mappingEntity_11_OtherRecord()\n  let schema = schema_Database()\n  let database = new Database()\n  let record = new model::OtherRecord()\n\n  test::assertTrue(mapping.readOnly())\n  test::assertTrue(mapping.keyColumn() == null)\n  test::assertTrue(schema.find(\"model.OtherRecord\") == null)\n  test::assertTrue(schema.find(\"model.Record\") != null)\n  test::assertTrue(database.summaries.stateOf(record) == null)\n  test::assertTrue(database.summaries.add(record) != null)\n  match decodeEntity_11_OtherRecord(new neri_data::RawRow([new neri_data::RawColumn(\"count\", neri_data::Cell.Int(7))]))\n    case neri_data::DecodeResult.Value(value)\n      test::assertEqual(value.id, 7)\n    case neri_data::DecodeResult.Failure(error)\n      test::assertTrue(false)\n  end\n"
  )
  for option in [",\"keyless\":true", ",\"view\":\"record_summary\""]
    schemaMappingReject(root, schemaMappingText(schemaMappingColumns(), entityOptions: option))
  end
  let invalidGeneration = ",{\"type\":\"model.OtherRecord\",\"set\":\"summaries\",\"table\":\"record_summary\",\"keyless\":true,\"columns\":[{\"member\":\"id\",\"column\":\"count\",\"valueGeneration\":\"onAdd\"}]}"

  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(), extraEntity: invalidGeneration))
end

def schemaMappingCheckComplex(root: String): Void
  let complex = ",{\"type\":\"model.ComplexRecord\",\"set\":\"complexes\",\"table\":\"complexes\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"home.city\",\"column\":\"home_city\"},{\"member\":\"home.line\",\"column\":\"home_line\"},{\"member\":\"work.city\",\"column\":\"work_city\"},{\"member\":\"work.line\",\"column\":\"work_line\"}]}"
  let mapping = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns(), extraEntity: complex))

  test::assertEqual(mapping.error, "")
  schemaMappingRunConsumer(
    root,
    mapping,
    "complex-consumer",
    "  let row = new neri_data::RawRow([new neri_data::RawColumn(\"id\", neri_data::Cell.Int(7)), new neri_data::RawColumn(\"home_city\", neri_data::Cell.Text(\"Paris\")), new neri_data::RawColumn(\"home_line\", neri_data::Cell.Null()), new neri_data::RawColumn(\"work_city\", neri_data::Cell.Text(\"Madrid\")), new neri_data::RawColumn(\"work_line\", neri_data::Cell.Text(\"Office\"))])\n  let schema = schema_Database()\n\n  test::assertTrue(schema.validate() == null)\n  match decodeEntity_13_ComplexRecord(row)\n    case neri_data::DecodeResult.Value(value)\n      test::assertEqual(value.home.city, \"Paris\")\n      test::assertTrue(value.home.line == null)\n      test::assertEqual(value.work.city, \"Madrid\")\n      let target = new model::ComplexRecord()\n\n      target.home = new model::Address()\n      target.work = new model::Address()\n      apply_ComplexRecord(target, value)\n      target.home.city = \"Changed\"\n\n      test::assertEqual(value.home.city, \"Paris\")\n      match capture_ComplexRecord(target).value(\"home_city\")\n        case neri_data::CellLookup.Found(cell)\n          match cell\n            case neri_data::Cell.Text(text)\n              test::assertEqual(text, \"Changed\")\n            case neri_data::Cell.Int(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Bool(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Float(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Binary(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Null()\n              test::assertTrue(false)\n          end\n        case neri_data::CellLookup.Missing()\n          test::assertTrue(false)\n      end\n      let database = new Database()\n      let query = database.complexes.matching() do |item: model::ComplexRecord|: Bool\n        return item.home.city == \"Paris\" && item.work.city == \"Madrid\"\n      end\n\n      match query.take(10).buildPlan()\n        case neri_data::CompileResult.Plan(plan)\n          test::assertEqual(plan.sql().parameters().count(), 2)\n        case neri_data::CompileResult.Failure(error)\n          test::assertTrue(false)\n      end\n    case neri_data::DecodeResult.Failure(error)\n      test::assertTrue(false)\n  end\n"
  )
  let optional = ",{\"type\":\"model.OptionalComplexRecord\",\"set\":\"optional_complexes\",\"table\":\"optional_complexes\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"address.city\",\"column\":\"city\"}]}"

  let optionalMapping = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns(), extraEntity: optional))

  test::assertEqual(optionalMapping.error, "")
end

def schemaMappingCheckFilters(root: String): Void
  let mapping = schemaMappingLoad(
    root,
    schemaMappingText(
      schemaMappingColumns(),
      entityOptions: ",\"queryFilter\":\"model.activeRecords\",\"queryFilters\":[{\"name\":\"soft-delete\",\"factory\":\"model.activeRecords\"},{\"name\":\"tenant\",\"factory\":\"model.activeRecords\"}]"
    )
  )

  test::assertEqual(mapping.error, "")
  schemaMappingRunConsumer(
    root,
    mapping,
    "filter-consumer",
    "  let database = new Database()\n  let query = database.records.where(id: 7)\n\n  match query.take(10).buildPlan()\n    case neri_data::CompileResult.Plan(filtered)\n      match query.ignoreQueryFilters().take(10).buildPlan()\n        case neri_data::CompileResult.Plan(unfiltered)\n          test::assertTrue(filtered.sql().sql() != unfiltered.sql().sql())\n          match query.ignoreQueryFilters([\"soft-delete\"]).take(10).buildPlan()\n            case neri_data::CompileResult.Plan(selective)\n              test::assertTrue(selective.sql().sql() != filtered.sql().sql())\n              test::assertTrue(selective.sql().sql() != unfiltered.sql().sql())\n            case neri_data::CompileResult.Failure(error)\n              test::assertTrue(false)\n          end\n          test::assertEqual(filtered.sql().parameters().count(), 1)\n          test::assertEqual(unfiltered.sql().parameters().count(), 1)\n        case neri_data::CompileResult.Failure(error)\n          test::assertTrue(false)\n      end\n    case neri_data::CompileResult.Failure(error)\n      test::assertTrue(false)\n  end\n"
  )
  for factory in ["model.missingFilter", "model.activeRecords()", "model.Record"]
    schemaMappingReject(
      root,
      schemaMappingText(schemaMappingColumns(), entityOptions: ",\"queryFilter\":" + lspQuote(factory))
    )
  end
end

def schemaMappingCheckConversions(root: String): Void
  let converted = ",{\"type\":\"model.BoolRecord\",\"set\":\"flags\",\"table\":\"flags\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"flag\",\"column\":\"flag\",\"conversion\":\"boolToInt\",\"default\":true},{\"member\":\"optionalFlag\",\"column\":\"optional_flag\",\"conversion\":\"boolToInt\",\"default\":null}]}"
  let mapping = schemaMappingLoad(root, schemaMappingText(schemaMappingColumns(), extraEntity: converted))

  test::assertEqual(mapping.error, "")
  schemaMappingRunConsumer(
    root,
    mapping,
    "conversion-consumer",
    "  let row = new neri_data::RawRow([new neri_data::RawColumn(\"id\", neri_data::Cell.Int(7)), new neri_data::RawColumn(\"flag\", neri_data::Cell.Int(1)), new neri_data::RawColumn(\"optional_flag\", neri_data::Cell.Null())])\n\n  match decodeEntity_10_BoolRecord(row)\n    case neri_data::DecodeResult.Value(value)\n      test::assertTrue(value.flag)\n      test::assertTrue(value.optionalFlag == null)\n      match capture_BoolRecord(value).value(\"flag\")\n        case neri_data::CellLookup.Found(cell)\n          match cell\n            case neri_data::Cell.Int(integer)\n              test::assertEqual(integer, 1)\n            case neri_data::Cell.Bool(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Float(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Text(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Binary(unused)\n              test::assertTrue(false)\n            case neri_data::Cell.Null()\n              test::assertTrue(false)\n          end\n        case neri_data::CellLookup.Missing()\n          test::assertTrue(false)\n      end\n    case neri_data::DecodeResult.Failure(error)\n      test::assertTrue(false)\n  end\n  match neri_data::decodeBoolToInt(new neri_data::RawRow([new neri_data::RawColumn(\"flag\", neri_data::Cell.Int(2))]), \"flag\")\n    case neri_data::DecodeResult.Value(value)\n      test::assertTrue(false)\n    case neri_data::DecodeResult.Failure(error)\n      test::assertTrue(true)\n  end\n  for dialect in [neri_data::SqlDialect.QuestionMark(), neri_data::SqlDialect.PostgreSql()]\n    let provider = new ConversionProvider(dialect)\n    let database = new Database(provider)\n\n    match database.flags.executeUpdate(flag: false)\n      case neri_data::WriteResult.Saved(count)\n        test::assertEqual(provider.seenInt, 0)\n      case neri_data::WriteResult.Failure(error)\n        test::assertTrue(false)\n      case neri_data::WriteResult.SavedWithValues(count, rows)\n        test::assertTrue(false)\n    end\n    match database.flags.where(flag: true).take(10).buildPlan(dialect)\n      case neri_data::CompileResult.Plan(plan)\n        let first = plan.sql().parameters().first()\n\n        test::assertTrue(first != null)\n        if first != null\n          match first.value()\n            case neri_data::Parameter.Int(value)\n              test::assertEqual(value, 1)\n            case neri_data::Parameter.Bool(unused)\n              test::assertTrue(false)\n            case neri_data::Parameter.Float(unused)\n              test::assertTrue(false)\n            case neri_data::Parameter.Text(unused)\n              test::assertTrue(false)\n            case neri_data::Parameter.Binary(unused)\n              test::assertTrue(false)\n          end\n        end\n      case neri_data::CompileResult.Failure(error)\n        test::assertTrue(false)\n    end\n    let projected = database.flags.take(10).select(neri_data::boolScalar()) do |value: model::BoolRecord|: Bool\n      return value.flag\n    end\n\n    match projected.buildPlan(dialect)\n      case neri_data::CompileResult.Plan(plan)\n        test::assertTrue(plan.sql().sql() != \"\")\n      case neri_data::CompileResult.Failure(error)\n        test::assertTrue(false)\n    end\n  end\n",
    declarations: "class ConversionProvider: neri_data::Provider\n  public seenInt: Int = -1\n  private sqlDialect: neri_data::SqlDialect\n\n  def init(dialect: neri_data::SqlDialect): Void\n    this.sqlDialect = dialect\n  end\n\n  public override readonly def dialect(): neri_data::SqlDialect\n    match this.sqlDialect\n      case neri_data::SqlDialect.QuestionMark()\n        return neri_data::SqlDialect.QuestionMark()\n      case neri_data::SqlDialect.PostgreSql()\n        return neri_data::SqlDialect.PostgreSql()\n    end\n  end\n\n  public override readonly def supports(capability: neri_data::ProviderCapability): Bool\n    return true\n  end\n\n  public override def execute(plan: readonly neri_data::SqlPlan): neri_data::ProviderResult\n    return neri_data::ProviderResult.Rows([])\n  end\n\n  public override def executeSet(plan: readonly neri_data::SetWritePlan): neri_data::WriteResult\n    let first = plan.parameters().first()\n\n    if first != null\n      match first.value()\n        case neri_data::Cell.Int(value)\n          this.seenInt = value\n        case neri_data::Cell.Bool(unused)\n        case neri_data::Cell.Float(unused)\n        case neri_data::Cell.Text(unused)\n        case neri_data::Cell.Binary(unused)\n        case neri_data::Cell.Null()\n      end\n    end\n    return neri_data::WriteResult.Saved(1)\n  end\nend\n\n"
  )
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(amountDefault: ",\"conversion\":\"boolToInt\"")))
  schemaMappingReject(root, schemaMappingText(schemaMappingColumns(activeDefault: ",\"conversion\":\"custom\"")))
end

def verifyDataSchemaMappingContract(root: String): Void
  let temporary = bootstrapTemporaryDirectory(root + "/build", "data-schema-mapping-contract")

  test::assertTrue(temporary != null)
  if temporary == null
    return
  end
  let projectRoot = temporary

  test::assertTrue(files::createDirectory(projectRoot + "/generated").failure == null)
  schemaMappingWrite(
    projectRoot + "/manifest.json",
    "{\"version\":2,\"defaultUnit\":\"entities\",\"units\":{\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]}}}\n"
  )
  schemaMappingWrite(projectRoot + "/entities.hk", schemaMappingEntities() + modelParityEntities())
  let selected = host::argumentAt(2)

  if selected != null && selected.startsWith("extended-")
    schemaMappingCheckExtendedModels(projectRoot)
    return
  end
  if selected != null && selected.startsWith("tpc-")
    schemaMappingCheckTPC(projectRoot)
    return
  end
  if selected != null && selected.startsWith("tpt-")
    schemaMappingCheckTPT(projectRoot)
    return
  end
  schemaMappingCheckDefaultsAndIndexes(projectRoot)
  schemaMappingCheckInvalidDefaults(projectRoot)
  schemaMappingCheckIndexes(projectRoot)
  schemaMappingCheckConcurrency(projectRoot)
  schemaMappingCheckGraphNames(projectRoot)
  schemaMappingCheckKeyless(projectRoot)
  schemaMappingCheckComplex(projectRoot)
  schemaMappingCheckFilters(projectRoot)
  schemaMappingCheckConversions(projectRoot)
  schemaMappingCheckModelParity(projectRoot)
end

def schemaMappingContractMain(): Void
  let root = host::argumentAt(0)

  test::assertTrue(root != null)
  if root != null
    verifyDataSchemaMappingContract(root)
  end
end
