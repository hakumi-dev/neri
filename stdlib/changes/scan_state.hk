use buffers
use crypto
use files
use host
use result
use tasks
namespace changes

class ScanState
  public remainingEntries: Int
  public remainingBytes: Int
  public depthLimit: Int
  public encoded: buffers.ByteBuffer
  public failure: result.Failure?

  def init(entries: Int, bytes: Int, depth: Int, encoded: buffers.ByteBuffer): Void
    this.remainingEntries = entries
    this.remainingBytes = bytes
    this.depthLimit = depth
    this.encoded = encoded
  end

  def visit(root: files.Root, path: String, depth: Int): Void
    if this.failure != null
      return
    end
    if depth > this.depthLimit
      this.failure = new result.Failure("depth_exceeded", "changes.enumerate", path)
      return
    end
    let listed = root.list(path, this.remainingEntries)

    if listed.failure != null || listed.closeFailure != null
      this.failure = combinedFailure(listed.failure, listed.closeFailure, path, 0)
      return
    end
    let ordered = sortEntries(listed.entries)

    for entry in ordered
      if this.remainingEntries == 0
        this.failure = new result.Failure("entry_limit_exceeded", "changes.enumerate", path)
        return
      end
      this.remainingEntries = this.remainingEntries - 1
      let child = path == "" ? entry.name : path + "/" + entry.name

      if entry.kind.isDirectory()
        if !appendRecord(this.encoded, entry.kind, child, [])
          this.failure = new result.Failure("snapshot_limit_exceeded", "changes.hash", child)
          return
        end
        this.visit(root, child, depth + 1)
      else if entry.kind.isFile()
        let read = root.readBytes(child, this.remainingBytes)

        if read.failure != null || read.closeFailure != null
          this.failure = combinedFailure(read.failure, read.closeFailure, child, read.bytesRead)
          return
        end
        let bytes = read.bytes

        if bytes == null
          this.failure = new result.Failure("missing_bytes", "changes.read", child)
          return
        end
        if bytes.Length > this.remainingBytes
          this.failure = new result.Failure("byte_limit_exceeded", "changes.read", child)
          return
        end
        this.remainingBytes = this.remainingBytes - bytes.Length
        match crypto.sha256Outcome(bytes)
          case result.Result.Ok(digest)
            if !appendRecord(this.encoded, entry.kind, child, digest)
              this.failure = new result.Failure("snapshot_limit_exceeded", "changes.hash", child)
              return
            end
          case result.Result.Error(failure)
            this.failure = new result.Failure(failure.code, "changes.hash", child, bytes.Length, failure.osCode, failure)
            return
        end
      else
        this.failure = new result.Failure("unsupported_entry", "changes.enumerate", child)
        return
      end
      if this.failure != null
        return
      end
    end
  end
end
