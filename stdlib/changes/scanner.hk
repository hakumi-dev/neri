use buffers
use crypto
use files
use host
use result
use tasks
namespace changes

class Scanner
  public entryLimit: Int = 4096
  public byteLimit: Int = 134217728
  public depthLimit: Int = 64
  private baseline: Byte[]?

  def poll(root: files::Root, relative: String = ""): PollResult
    let output = new PollResult()

    if this.entryLimit < 0 || this.entryLimit > 4096 || this.byteLimit < 0 || this.byteLimit > 134217728 || this.depthLimit < 0 || this.depthLimit > 64
      output.failure = new result::Failure("invalid_limit", "changes.poll")
      return output
    end
    let buffer = buffers::ByteBuffer.create(134217728)

    if buffer == null
      output.failure = new result::Failure("allocation_failed", "changes.poll")
      return output
    end
    let state = new ScanState(this.entryLimit, this.byteLimit, this.depthLimit, buffer)

    state.visit(root, relative, 0)
    if state.failure != null
      output.failure = state.failure
      return output
    end
    let encoded = state.encoded.snapshot()

    match crypto::sha256Outcome(encoded)
      case result::Result.Ok(candidate)
        let previous = this.baseline

        output.changed = previous != null && !sameBytes(previous, candidate)
        output.digest = copyBytes(candidate)
        this.baseline = candidate
      case result::Result.Error(failure)
        output.failure = new result::Failure(failure.code, "changes.hash", "", encoded.Length, failure.osCode, failure)
    end
    return output
  end
end
