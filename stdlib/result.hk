namespace result

def map<T, E, U>(value: Result<T, E>, transform: fn(T): U): Result<U, E>
  match value
    case Result.Ok(item)
      return Result<U, E>.Ok(transform(item))
    case Result.Error(error)
      return Result<U, E>.Error(error)
  end
end

def flatMap<T, E, U>(value: Result<T, E>, transform: fn(T): Result<U, E>): Result<U, E>
  match value
    case Result.Ok(item)
      return transform(item)
    case Result.Error(error)
      return Result<U, E>.Error(error)
  end
end

def mapError<T, E, F>(value: Result<T, E>, transform: fn(E): F): Result<T, F>
  match value
    case Result.Ok(item)
      return Result<T, F>.Ok(item)
    case Result.Error(error)
      return Result<T, F>.Error(transform(error))
  end
end
