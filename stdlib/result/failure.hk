namespace result

public class Failure
  public code: String
  public operation: String
  public detail: String
  public transferred: Int
  public osCode: Int
  public cause: Failure?
  public closeFailure: Failure?

  def init(code: String, operation: String, detail: String = "", transferred: Int = 0, osCode: Int = 0, cause: Failure? = null, closeFailure: Failure? = null): Void
    this.code = code
    this.operation = operation
    this.detail = detail
    this.transferred = transferred
    this.osCode = osCode
    this.cause = cause
    this.closeFailure = closeFailure
  end
end
