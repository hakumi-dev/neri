namespace result

## Structured diagnostics from a native subsystem, captured before cleanup.
public class NativeError
  private storedDomain: String
  private storedCode: Int?
  private storedExtendedCode: Int?
  private storedSymbol: String?

  def init(domain: String, code: Int? = null, extendedCode: Int? = null, symbol: String? = null): Void
    this.storedDomain = domain
    this.storedCode = code
    this.storedExtendedCode = extendedCode
    this.storedSymbol = symbol
  end

  public readonly def domain(): String
    return this.storedDomain
  end

  public readonly def code(): Int?
    return this.storedCode
  end

  public readonly def extendedCode(): Int?
    return this.storedExtendedCode
  end

  public readonly def symbol(): String?
    return this.storedSymbol
  end
end
