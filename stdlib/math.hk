namespace math

@intrinsic("integer.abs")
def abs(value: Int): Int
end

def max(left: Int, right: Int): Int
  if left >= right
    return left
  end
  return right
end

def min(left: Int, right: Int): Int
  if left <= right
    return left
  end
  return right
end

@intrinsic("integer.pow")
def pow(base: Int, exponent: Int): Int
end
