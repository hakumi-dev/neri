use buffers
use host
use tasks
use result
namespace crypto

class EntropySource
  private read: fn(Int): BytesResult

  def init(read: fn(Int): BytesResult): Void
    this.read = read
  end

  static def system(): EntropySource
    let read: fn(Int): BytesResult = fn(count: Int)
      return crypto::systemRandomBytes(count)
    end

    return new EntropySource(read)
  end

  def bytes(count: Int): BytesResult
    if count < 0 || count > 256
      return BytesResult.failed("invalid_length")
    end
    let read = this.read
    let result = read(count)
    let bytes = result.bytes()
    let failure = result.failure()

    if failure != null
      return result
    end
    if bytes == null || bytes.Length != count
      return BytesResult.failed("invalid_source")
    end
    return result
  end
end
