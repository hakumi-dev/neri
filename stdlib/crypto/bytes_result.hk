use buffers
use host
use tasks
use result
namespace crypto

class BytesResult
  private value: Byte[]?
  private problem: Failure?

  private def init(value: Byte[]?, problem: Failure?): Void
    this.value = value
    this.problem = problem
  end

  static def success(value: Byte[]): BytesResult
    return new BytesResult(value, null)
  end

  static def failed(code: String): BytesResult
    return new BytesResult(null, Failure.fromCode(code))
  end

  def bytes(): Byte[]?
    return this.value
  end

  def failure(): Failure?
    return this.problem
  end
end
