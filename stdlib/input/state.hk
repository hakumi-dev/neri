use host
namespace input

class State
  private held: Int[] = []
  private pressedKeys: Int[] = []
  private releasedKeys: Int[] = []
  public mouseX: Float = 0.0
  public mouseY: Float = 0.0

  def contains(values: Int[], code: Int): Bool
    for value in values
      return true if value == code
    end
    return false
  end

  def down(key: Key): Bool
    return this.contains(this.held, key.code())
  end
  def pressed(key: Key): Bool
    return this.contains(this.pressedKeys, key.code())
  end
  def released(key: Key): Bool
    return this.contains(this.releasedKeys, key.code())
  end

  def beginFrame(): Void
    this.pressedKeys = []
    this.releasedKeys = []
  end

  def apply(event: Int): Void
    if event == 2
      for code in this.held
        this.releasedKeys = host.appendInt(this.releasedKeys, code)
      end
      this.held = []
    else if event >= 100 && event < 136
      let code = event - 100

      if !this.contains(this.held, code)
        this.held = host.appendInt(this.held, code)
        this.pressedKeys = host.appendInt(this.pressedKeys, code)
      end
    else if event >= 200 && event < 236
      let code = event - 200

      if this.contains(this.held, code)
        this.releasedKeys = host.appendInt(this.releasedKeys, code)
        var remaining: Int[] = []

        for value in this.held
          remaining = host.appendInt(remaining, value) if value != code
        end
        this.held = remaining
      end
    end
  end
end
