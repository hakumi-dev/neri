use host
namespace input

class Key
  private value: Int = -1
  def init(value: Int): Void
    this.value = value
  end
  def code(): Int
    return this.value
  end
  static def letter(value: String): Key
    if host.stringByteLength(value) == 1
      let byte = host.stringByteAt(value, 0) as Int

      if byte >= 65 && byte <= 90
        return new Key(byte - 65)
      else if byte >= 97 && byte <= 122
        return new Key(byte - 97)
      end
    end
    return new Key(-1)
  end
  static def up(): Key
    return new Key(26)
  end
  static def down(): Key
    return new Key(27)
  end
  static def left(): Key
    return new Key(28)
  end
  static def right(): Key
    return new Key(29)
  end
  static def space(): Key
    return new Key(30)
  end
  static def escape(): Key
    return new Key(31)
  end
  static def enter(): Key
    return new Key(32)
  end
  static def mouseLeft(): Key
    return new Key(33)
  end
  static def mouseMiddle(): Key
    return new Key(34)
  end
  static def mouseRight(): Key
    return new Key(35)
  end
end
