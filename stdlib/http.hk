use host
namespace http

class Failure
  public code: String
  public operation: String
  public detail: String

  def init(code: String, operation: String, detail: String = ""): Void
    this.code = code
    this.operation = operation
    this.detail = detail
  end
end

class Options
  public onListening: (fn(String): Void)?
  public log: (fn(String): Void)?
  public stop: Stop?
  public handleInterrupts: Bool = false
end

# Requested synchronously from callbacks on the serving thread.
class Stop
  private requested: Bool = false

  def request(): Void
    this.requested = true
  end

  def isRequested(): Bool
    return this.requested
  end
end

def stopRequested(options: Options?, interruptToken: Int = 0): Bool
  if interruptToken > 0
    unsafe
      if interruptPending(interruptToken) != 0
        return true
      end
    end
  end
  if options != null
    let stop = options.stop
    if stop != null
      return stop.isRequested()
    end
  end
  return false
end

def report(options: Options?, message: String): Void
  if options != null
    let log = options.log
    log(message) if log != null
  end
end

# Field lines retain their order and are never implicitly comma-combined.
class Headers
  private names: String[] = []
  private contents: String[] = []
  private bytes: Int = 0

  def add(name: String, value: String): Bool
    if !token(name) || !fieldValue(value)
      return false
    end
    let size = host.stringByteLength(name) + host.stringByteLength(value) + 4
    if this.names.Length >= 64 || size > 7168 - this.bytes
      return false
    end
    this.names = host.appendString(this.names, name)
    this.contents = host.appendString(this.contents, value)
    this.bytes = this.bytes + size
    return true
  end

  def values(name: String): String[]
    var result: String[] = []
    var index = 0
    while index < this.names.Length
      if lower(this.names[index]) == lower(name)
        result = host.appendString(result, this.contents[index])
      end
      index = index + 1
    end
    return result
  end

  def count(): Int
    return this.names.Length
  end

  def nameAt(index: Int): String
    return this.names[index]
  end

  def valueAt(index: Int): String
    return this.contents[index]
  end
end

class Request
  public method: String = "GET"
  public path: String = "/"
  public query: String = ""
  public headers: Headers = new Headers()
end

class Response
  public status: Int = 200
  public body: String = ""
  public bodyBytes: Byte[]?
  public headers: Headers = new Headers()

  def init(status: Int, body: String): Void
    this.status = status
    this.body = body
  end
end

def text(status: Int, body: String): Response
  return new Response(status, body)
end

def binary(status: Int, body: Byte[]): Response
  let response = new Response(status, "")
  response.bodyBytes = body
  return response
end

class Parsed
  public request: Request?
  public status: Int = 400
  public head: Bool = false
  public failure: Failure? = new Failure("malformed_request", "parse")
end

def find(text: String, part: String, start: Int): Int
  var index = start
  let limit = host.stringByteLength(text) - host.stringByteLength(part)
  while index <= limit
    var offset = 0
    while offset < host.stringByteLength(part) && host.stringByteAt(text, index + offset) == host.stringByteAt(part, offset)
      offset = offset + 1
    end
    if offset == host.stringByteLength(part)
      return index
    end
    index = index + 1
  end
  return -1
end

def lower(text: String): String
  var result = ""
  var index = 0
  while index < host.stringByteLength(text)
    var byte = host.stringByteAt(text, index) as Int
    if byte >= 65 && byte <= 90
      byte = byte + 32
    end
    let character = host.stringFromBytes([byte as Byte])
    result = result + character if character != null
    index = index + 1
  end
  return result
end

def trim(text: String): String
  var start = 0
  var endAt = host.stringByteLength(text)
  while start < endAt && (host.stringByteAt(text, start) == (32 as Byte) || host.stringByteAt(text, start) == (9 as Byte))
    start = start + 1
  end
  while endAt > start && (host.stringByteAt(text, endAt - 1) == (32 as Byte) || host.stringByteAt(text, endAt - 1) == (9 as Byte))
    endAt = endAt - 1
  end
  return host.stringSlice(text, start, endAt - start)
end

def token(text: String): Bool
  if text == ""
    return false
  end
  var index = 0
  while index < host.stringByteLength(text)
    let byte = host.stringByteAt(text, index) as Int
    if byte > 127
      return false
    end
    if !((byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122))
      if find("!#$%&'*+-.^_`|~", host.stringSlice(text, index, 1), 0) < 0
        return false
      end
    end
    index = index + 1
  end
  return true
end

def fieldValue(value: String): Bool
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    if (byte < 32 && byte != 9) || byte > 126
      return false
    end
    index = index + 1
  end
  return true
end

def targetValid(target: String): Bool
  if target == "" || host.stringByteAt(target, 0) != (47 as Byte)
    return false
  end
  var index = 0
  while index < host.stringByteLength(target)
    let character = host.stringSlice(target, index, 1)
    if character == "%"
      if index + 2 >= host.stringByteLength(target)
        return false
      end
      if find("0123456789abcdefABCDEF", host.stringSlice(target, index + 1, 1), 0) < 0 || find("0123456789abcdefABCDEF", host.stringSlice(target, index + 2, 1), 0) < 0
        return false
      end
      index = index + 2
    else if find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~!$&'()*+,;=:@/?", character, 0) < 0
      return false
    end
    index = index + 1
  end
  return true
end

def parse(head: String, allowHead: Bool = false): Parsed
  let result = new Parsed()
  let headLength = host.stringByteLength(head)
  if headLength > 8192 || headLength < 4 || !fieldValueLines(head)
    return result
  end
  if host.stringSlice(head, headLength - 4, 4) != "\r\n\r\n"
    return result
  end
  let fields = new Headers()
  result.failure = new Failure("invalid_request_line", "parse")
  let lineEnd = find(head, "\r\n", 0)
  if lineEnd < 0
    return result
  end
  let line = host.stringSlice(head, 0, lineEnd)
  let firstSpace = find(line, " ", 0)
  let secondSpace = find(line, " ", firstSpace + 1)
  if firstSpace <= 0 || secondSpace <= firstSpace + 1
    return result
  end
  let method = host.stringSlice(line, 0, firstSpace)
  result.head = method == "HEAD"
  let target = host.stringSlice(line, firstSpace + 1, secondSpace - firstSpace - 1)
  if !token(method)
    return result
  end
  if !targetValid(target)
    result.failure = new Failure("invalid_target", "parse")
    return result
  end
  let version = host.stringSlice(line, secondSpace + 1, host.stringByteLength(line) - secondSpace - 1)
  if host.stringByteLength(version) != 8
    return result
  end
  if host.stringSlice(version, 0, 5) != "HTTP/" || host.stringByteAt(version, 6) != (46 as Byte)
    return result
  end
  let major = host.stringByteAt(version, 5) as Int
  let minor = host.stringByteAt(version, 7) as Int
  if major < 48 || major > 57 || minor < 48 || minor > 57
    return result
  end
  if version != "HTTP/1.1"
    result.status = 505
    result.failure = new Failure("unsupported_version", "parse")
    return result
  end
  var start = lineEnd + 2
  var hosts = 0
  var lengths = 0
  var unsupportedBody = false
  var expect = false
  while start < host.stringByteLength(head) - 2
    result.failure = new Failure("invalid_header", "parse")
    let endAt = find(head, "\r\n", start)
    if endAt < start
      return result
    end
    let field = host.stringSlice(head, start, endAt - start)
    let colon = find(field, ":", 0)
    if colon <= 0
      return result
    end
    let name = host.stringSlice(field, 0, colon)
    if !token(name)
      return result
    end
    let value = trim(host.stringSlice(field, colon + 1, host.stringByteLength(field) - colon - 1))
    if !fields.add(name, value)
      return result
    end
    let normalized = lower(name)
    if normalized == "host"
      hosts = hosts + 1
      if value == "" || find(value, " ", 0) >= 0 || find(value, "\t", 0) >= 0 || find(value, ",", 0) >= 0
        result.failure = new Failure("invalid_host", "parse")
        return result
      end
    else if normalized == "content-length"
      result.failure = new Failure("invalid_content_length", "parse")
      lengths = lengths + 1
      if value == ""
        return result
      end
      var index = 0
      while index < host.stringByteLength(value)
        let digit = host.stringByteAt(value, index) as Int
        if digit < 48 || digit > 57
          return result
        end
        if digit != 48
          unsupportedBody = true
        end
        index = index + 1
      end
    else if normalized == "transfer-encoding"
      result.failure = new Failure("unsupported_framing", "parse")
      return result
    else if normalized == "expect"
      expect = true
    end
    start = endAt + 2
  end
  if hosts != 1
    result.failure = new Failure("invalid_host", "parse")
    return result
  end
  if lengths > 1 || unsupportedBody
    result.failure = new Failure("unsupported_framing", "parse")
    return result
  end
  if expect
    result.status = 417
    result.failure = new Failure("unsupported_expectation", "parse")
    return result
  end
  if method != "GET" && !(allowHead && method == "HEAD")
    result.status = 405
    result.failure = new Failure("unsupported_method", "parse")
    return result
  end
  let request = new Request()
  request.method = method
  request.headers = fields
  let queryAt = find(target, "?", 0)
  if queryAt < 0
    request.path = target
  else
    request.path = host.stringSlice(target, 0, queryAt)
    request.query = host.stringSlice(target, queryAt + 1, host.stringByteLength(target) - queryAt - 1)
  end
  result.request = request
  result.status = 200
  result.failure = null
  return result
end

def fieldValueLines(value: String): Bool
  var index = 0
  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    if byte > 126 || (byte < 32 && byte != 9 && byte != 10 && byte != 13)
      return false
    end
    index = index + 1
  end
  return true
end

def responseFieldsValid(fields: Headers): Bool
  var index = 0
  while index < fields.count()
    let name = lower(fields.nameAt(index))
    if name == "content-length" || name == "transfer-encoding" || name == "connection" || name == "trailer" || name == "upgrade" || name == "keep-alive" || name == "proxy-connection"
      return false
    end
    if name != "set-cookie" && fields.values(name).Length > 1
      return false
    end
    index = index + 1
  end
  return true
end

class EncodedResponse
  public headers: String = ""
  public text: String = ""
  public bytes: Byte[]?
end

def wire(response: Response, head: Bool): EncodedResponse
  let encoded = new EncodedResponse()
  var status = response.status
  var body = response.body
  var binaryBody = response.bodyBytes
  var length = host.stringByteLength(body)
  if binaryBody != null
    length = binaryBody.Length
  end
  var fields = response.headers
  if status < 200 || status > 599 || length > 1048576 || !responseFieldsValid(fields)
    status = 500
    body = "Invalid response"
    binaryBody = null
    length = host.stringByteLength(body)
    fields = new Headers()
  end
  var headers = "HTTP/1.1 " + (status as String) + " Response\r\nConnection: close\r\n"
  if fields.values("content-type").Length == 0
    headers = headers + "Content-Type: " + (binaryBody == null ? "text/plain; charset=utf-8" : "application/octet-stream") + "\r\n"
  end
  var index = 0
  while index < fields.count()
    headers = headers + fields.nameAt(index) + ": " + fields.valueAt(index) + "\r\n"
    index = index + 1
  end
  if status == 405 && fields.values("allow").Length == 0
    headers = headers + "Allow: GET, HEAD\r\n"
  end
  if status == 204 || status == 304
    encoded.headers = headers + "\r\n"
    return encoded
  end
  if status == 205
    body = ""
    binaryBody = null
    length = 0
  end
  encoded.headers = headers + "Content-Length: " + (length as String) + "\r\n\r\n"
  if !head
    encoded.text = body
    encoded.bytes = binaryBody
  end
  return encoded
end

def sendResponse(fd: Int, response: Response, head: Bool, options: Options?): Void
  let output = wire(response, head)
  var written = false
  unsafe
    let started = netMilliseconds()
    if started >= 0
      let deadline = started + 2000
      written = writePayload(fd, output.headers, null, deadline) && writePayload(fd, output.text, output.bytes, deadline)
    end
  end
  if written
    report(options, "Response " + host.stringSlice(output.headers, 9, 3))
  else
    report(options, "Response write failed or timed out")
  end
end

def connection(fd: Int, handler: fn(Request): Response, options: Options?): Void
  unsafe
    let head = readHead(fd)
    if head.status == 0
      report(options, "Connection closed before request headers completed")
      return
    end
    if head.status != 200
      sendResponse(fd, text(head.status, "Request rejected"), false, options)
      return
    end
    let parsed = parse(head.text, true)
    let request = parsed.request
    var response = text(parsed.status, "Request rejected")
    if request != null
      response = handler(request)
    end
    sendResponse(fd, response, parsed.head, options)
  end
end

# Formats listener failures or normal stop for callers of the text API.
def serve(address: String, handler: fn(Request): Response, options: Options? = null): String
  let failure = serveResult(address, handler, options)
  if failure != null
    return failure.operation + ": " + failure.detail
  end
  return "Listener stopped"
end

def serveResult(address: String, handler: fn(Request): Response, options: Options? = null): Failure?
  var token = 0
  if options != null && options.handleInterrupts
    unsafe
      token = interruptOpen()
    end
    if token == 0
      return new Failure("interrupt_unavailable", "listen.interrupt", "Process interrupt handling is already owned or unavailable")
    end
  end
  let result = serveLoop(address, handler, options, token)
  if token > 0
    unsafe
      interruptClose(token)
    end
  end
  return result
end

def serveLoop(address: String, handler: fn(Request): Response, options: Options?, interruptToken: Int): Failure?
  if host.stringByteLength(address) < 11 || find(address, "127.0.0.1:", 0) != 0
    return new Failure("invalid_address", "listen", "Address must be 127.0.0.1:<port>")
  end
  let portText = host.stringSlice(address, 10, host.stringByteLength(address) - 10)
  let port = host.parseInt(portText)
  if port == null || port < 1 || port > 65535
    return new Failure("invalid_port", "listen", "Port must be an integer from 1 to 65535")
  end
  if stopRequested(options, interruptToken)
    return null
  end
  unsafe
    let listener = netOpen()
    if listener < 0
      return new Failure("socket_error", "listen.open", socketError())
    end
    var failure: Failure? = null
    if netConfigure(listener) < 0
      failure = new Failure("socket_error", "listen.configure", socketError())
    else if netBind(listener, port) < 0
      failure = new Failure("socket_error", "listen.bind", socketError())
    else if netListen(listener) < 0
      failure = new Failure("socket_error", "listen.start", socketError())
    end
    if failure != null
      netClose(listener)
      return failure
    end
    if options != null
      let onListening = options.onListening
      onListening(address) if onListening != null
    end
    while !stopRequested(options, interruptToken)
      let ready = netPoll(listener, 0, interruptToken > 0 ? 50 : -1)
      if ready == -1
        let error = new Failure("socket_error", "listen.wait", socketError())
        netClose(listener)
        return error
      end
      if ready > 0 && !stopRequested(options, interruptToken)
        let fd = netAccept(listener)
        if fd == -1
          let error = new Failure("socket_error", "listen.accept", socketError())
          netClose(listener)
          return error
        end
        if fd >= 0
          if netConfigure(fd) == 0
            connection(fd, handler, options)
          else
            report(options, "Configure connection: " + socketError())
          end
          netClose(fd)
        end
      end
    end
    netClose(listener)
  end
  return null
end

@cabi("neri_rt_v1_interrupt_open")
def unsafe interruptOpen(): Int
end
@cabi("neri_rt_v1_interrupt_pending")
def unsafe interruptPending(token: Int): Int
end
@cabi("neri_rt_v1_interrupt_close")
def unsafe interruptClose(token: Int): Void
end

@cabi("neri_rt_v1_net_open")
def unsafe netOpen(): Int
end
@cabi("neri_rt_v1_net_configure")
def unsafe netConfigure(fd: Int): Int
end
@cabi("neri_rt_v1_net_bind")
def unsafe netBind(fd: Int, port: Int): Int
end
@cabi("neri_rt_v1_net_listen")
def unsafe netListen(fd: Int): Int
end
@cabi("neri_rt_v1_net_accept")
def unsafe netAccept(fd: Int): Int
end
@cabi("neri_rt_v1_net_poll")
def unsafe netPoll(fd: Int, writing: Int, milliseconds: Int): Int
end
@cabi("neri_rt_v1_net_read")
def unsafe netRead(fd: Int, bytes: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_net_write")
def unsafe netWrite(fd: Int, bytes: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_net_close")
def unsafe netClose(fd: Int): Void
end
@cabi("neri_rt_v1_net_milliseconds")
def unsafe netMilliseconds(): Int
end
@cabi("neri_rt_v1_net_error")
def unsafe netError(bytes: Byte*, capacity: Int): Int
end

def socketError(): String
  unsafe
    let bytes = stackalloc Byte[256]
    let length = netError(bytes, 256)
    var text = ""
    var index = 0
    while index < length
      let character = host.stringFromBytes([bytes[index]])
      text = text + character if character != null
      index = index + 1
    end
    return text
  end
end

# Each operation keeps one absolute deadline across interruptions and partial I/O.
def waitSocket(fd: Int, writing: Int, deadline: Int): Int
  let failure = waitReady(fd, writing, deadline)
  if failure == null
    return 1
  end
  return failure.code == "timeout" ? 0 : -1
end

def waitReady(fd: Int, writing: Int, deadline: Int): Failure?
  unsafe
    while true
      let now = netMilliseconds()
      if now < 0
        return new Failure("clock_error", "clock", socketError())
      end
      let remaining = deadline - now
      if remaining <= 0
        return new Failure("timeout", writing == 0 ? "read.wait" : "write.wait")
      end
      let result = netPoll(fd, writing, remaining)
      if result == -1
        return new Failure("socket_error", writing == 0 ? "read.wait" : "write.wait", socketError())
      end
      if result == 0
        return new Failure("timeout", writing == 0 ? "read.wait" : "write.wait")
      end
      if result > 0
        return null
      end
    end
    return new Failure("socket_error", "wait")
  end
end

class Head
  public text: String = ""
  public status: Int = 0
  public failure: Failure?
  public bytesRead: Int = 0
end

def readHead(fd: Int, timeoutMilliseconds: Int = 2000): Head
  unsafe
    let result = new Head()
    let bytes = stackalloc Byte[8192]
    if timeoutMilliseconds < 0 || timeoutMilliseconds > 2147483647
      result.failure = new Failure("invalid_timeout", "read")
      return result
    end
    let started = netMilliseconds()
    if started < 0
      result.failure = new Failure("clock_error", "clock", socketError())
      return result
    end
    let deadline = started + timeoutMilliseconds
    var length = 0
    var scanned = 0
    while length < 8192
      let failure = waitReady(fd, 0, deadline)
      if failure != null
        result.failure = failure
        if failure.code == "timeout"
          result.status = 408
        end
        return result
      end
      let count = netRead(fd, bytes + length, 8192 - length)
      if count == 0
        result.failure = new Failure("peer_closed", "read")
        return result
      end
      if count == -1
        result.failure = new Failure("socket_error", "read", socketError())
        return result
      end
      if count > 0
        length = length + count
        result.bytesRead = length
        while scanned < length
          let byte = bytes[scanned] as Int
          if byte > 126 || (byte < 32 && byte != 9 && byte != 10 && byte != 13)
            result.status = 400
            result.failure = new Failure("invalid_header_bytes", "read")
            return result
          end
          scanned = scanned + 1
          if scanned >= 4 && bytes[scanned - 4] == (13 as Byte) && bytes[scanned - 3] == (10 as Byte) && bytes[scanned - 2] == (13 as Byte) && bytes[scanned - 1] == (10 as Byte)
            var index = 0
            while index < scanned
              let character = host.stringFromBytes([bytes[index]])
              result.text = result.text + character if character != null
              index = index + 1
            end
            result.status = 200
            return result
          end
        end
      end
    end
    result.status = 431
    result.failure = new Failure("header_limit", "read")
    return result
  end
end

def writeText(fd: Int, text: String): Bool
  return writeTextResult(fd, text).failure == null
end

def writeBytes(fd: Int, bytes: Byte[]): Bool
  return writeBytesResult(fd, bytes).failure == null
end

class WriteResult
  public bytesWritten: Int = 0
  public failure: Failure?
end

def writeTextResult(fd: Int, text: String, timeoutMilliseconds: Int = 2000): WriteResult
  return writeResult(fd, text, null, timeoutMilliseconds)
end

def writeBytesResult(fd: Int, bytes: Byte[], timeoutMilliseconds: Int = 2000): WriteResult
  return writeResult(fd, "", bytes, timeoutMilliseconds)
end

def writeResult(fd: Int, text: String, bytes: Byte[]?, timeoutMilliseconds: Int): WriteResult
  let result = new WriteResult()
  if timeoutMilliseconds < 0 || timeoutMilliseconds > 2147483647
    result.failure = new Failure("invalid_timeout", "write")
    return result
  end
  unsafe
    let started = netMilliseconds()
    if started < 0
      result.failure = new Failure("clock_error", "clock", socketError())
      return result
    end
    return writePayloadResult(fd, text, bytes, started + timeoutMilliseconds)
  end
end

def writePayload(fd: Int, text: String, binaryBody: Byte[]?, deadline: Int): Bool
  return writePayloadResult(fd, text, binaryBody, deadline).failure == null
end

def writePayloadResult(fd: Int, text: String, binaryBody: Byte[]?, deadline: Int): WriteResult
  let result = new WriteResult()
  unsafe
    let bytes = stackalloc Byte[1024]
    var offset = 0
    var length = host.stringByteLength(text)
    if binaryBody != null
      length = binaryBody.Length
    end
    while offset < length
      var size = length - offset
      if size > 1024
        size = 1024
      end
      var index = 0
      while index < size
        if binaryBody != null
          bytes[index] = binaryBody[offset + index]
        else
          bytes[index] = host.stringByteAt(text, offset + index)
        end
        index = index + 1
      end
      var sent = 0
      while sent < size
        let failure = waitReady(fd, 1, deadline)
        if failure != null
          result.failure = failure
          return result
        end
        let count = netWrite(fd, bytes + sent, size - sent)
        if count == -1
          result.failure = new Failure("socket_error", "write", socketError())
          return result
        end
        if count == 0
          result.failure = new Failure("write_stalled", "write")
          return result
        end
        if count > 0
          sent = sent + count
          result.bytesWritten = result.bytesWritten + count
        end
      end
      offset = offset + size
    end
    return result
  end
end
