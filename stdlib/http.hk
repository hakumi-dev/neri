use host
namespace http

class Request
  public method: String = "GET"
  public path: String = "/"
  public query: String = ""
end

class Response
  public status: Int = 200
  public body: String = ""

  def init(status: Int, body: String): Void
    this.status = status
    this.body = body
  end
end

def text(status: Int, body: String): Response
  return new Response(status, body)
end

class Parsed
  public request: Request?
  public status: Int = 400
  public head: Bool = false
end

def find(text: String, part: String, start: Int): Int
  var index = start
  let limit = host.stringByteLength(text) - host.stringByteLength(part)
  while index <= limit
    if host.stringSlice(text, index, host.stringByteLength(part)) == part
      return index
    end
    index = index + 1
  end
  return -1
end

def lower(text: String): String
  var result = ""
  var index = 0
  while index < host.stringByteLength(text)
    var byte = host.stringByteAt(text, index) as Int
    if byte >= 65 && byte <= 90
      byte = byte + 32
    end
    let character = host.stringFromBytes([byte as Byte])
    result = result + character if character != null
    index = index + 1
  end
  return result
end

def trim(text: String): String
  var start = 0
  var endAt = host.stringByteLength(text)
  while start < endAt && (host.stringByteAt(text, start) == (32 as Byte) || host.stringByteAt(text, start) == (9 as Byte))
    start = start + 1
  end
  while endAt > start && (host.stringByteAt(text, endAt - 1) == (32 as Byte) || host.stringByteAt(text, endAt - 1) == (9 as Byte))
    endAt = endAt - 1
  end
  return host.stringSlice(text, start, endAt - start)
end

def token(text: String): Bool
  if text == ""
    return false
  end
  var index = 0
  while index < host.stringByteLength(text)
    let byte = host.stringByteAt(text, index) as Int
    if !((byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122))
      if find("!#$%&'*+-.^_`|~", host.stringSlice(text, index, 1), 0) < 0
        return false
      end
    end
    index = index + 1
  end
  return true
end

def targetValid(target: String): Bool
  if target == "" || host.stringByteAt(target, 0) != (47 as Byte)
    return false
  end
  var index = 0
  while index < host.stringByteLength(target)
    let character = host.stringSlice(target, index, 1)
    if character == "%"
      if index + 2 >= host.stringByteLength(target)
        return false
      end
      if find("0123456789abcdefABCDEF", host.stringSlice(target, index + 1, 1), 0) < 0 || find("0123456789abcdefABCDEF", host.stringSlice(target, index + 2, 1), 0) < 0
        return false
      end
      index = index + 2
    else if find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~!$&'()*+,;=:@/?", character, 0) < 0
      return false
    end
    index = index + 1
  end
  return true
end

def parse(head: String): Parsed
  let result = new Parsed()
  let lineEnd = find(head, "\r\n", 0)
  if lineEnd < 0
    return result
  end
  let line = host.stringSlice(head, 0, lineEnd)
  let firstSpace = find(line, " ", 0)
  let secondSpace = find(line, " ", firstSpace + 1)
  if firstSpace <= 0 || secondSpace <= firstSpace + 1
    return result
  end
  let method = host.stringSlice(line, 0, firstSpace)
  result.head = method == "HEAD"
  let target = host.stringSlice(line, firstSpace + 1, secondSpace - firstSpace - 1)
  if !token(method) || !targetValid(target)
    return result
  end
  if host.stringSlice(line, secondSpace + 1, host.stringByteLength(line) - secondSpace - 1) != "HTTP/1.1"
    result.status = 505
    return result
  end
  var start = lineEnd + 2
  var hosts = 0
  var lengths = 0
  var unsupportedBody = false
  var expect = false
  while start < host.stringByteLength(head) - 2
    let endAt = find(head, "\r\n", start)
    if endAt < start
      return result
    end
    let field = host.stringSlice(head, start, endAt - start)
    let colon = find(field, ":", 0)
    if colon <= 0
      return result
    end
    let name = host.stringSlice(field, 0, colon)
    if !token(name)
      return result
    end
    let value = trim(host.stringSlice(field, colon + 1, host.stringByteLength(field) - colon - 1))
    if find(value, "\r", 0) >= 0 || find(value, "\n", 0) >= 0
      return result
    end
    let normalized = lower(name)
    if normalized == "host"
      hosts = hosts + 1
      if value == "" || find(value, " ", 0) >= 0 || find(value, "\t", 0) >= 0 || find(value, ",", 0) >= 0
        return result
      end
    else if normalized == "content-length"
      lengths = lengths + 1
      if value == ""
        return result
      end
      var index = 0
      while index < host.stringByteLength(value)
        let digit = host.stringByteAt(value, index) as Int
        if digit < 48 || digit > 57
          return result
        end
        if digit != 48
          unsupportedBody = true
        end
        index = index + 1
      end
    else if normalized == "transfer-encoding"
      return result
    else if normalized == "expect"
      expect = true
    end
    start = endAt + 2
  end
  if hosts != 1 || lengths > 1 || unsupportedBody
    return result
  end
  if expect
    result.status = 417
    return result
  end
  if method != "GET"
    result.status = 405
    return result
  end
  let request = new Request()
  let queryAt = find(target, "?", 0)
  if queryAt < 0
    request.path = target
  else
    request.path = host.stringSlice(target, 0, queryAt)
    request.query = host.stringSlice(target, queryAt + 1, host.stringByteLength(target) - queryAt - 1)
  end
  result.request = request
  result.status = 200
  return result
end

def wire(response: Response, head: Bool): String
  var status = response.status
  var body = response.body
  if status < 200 || status > 599 || host.stringByteLength(body) > 1048576
    status = 500
    body = "Invalid response"
  end
  var headers = "HTTP/1.1 " + (status as String) + " Response\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n"
  if status == 405
    headers = headers + "Allow: GET\r\n"
  end
  if status == 204 || status == 304
    return headers + "\r\n"
  end
  if status == 205
    body = ""
  end
  headers = headers + "Content-Length: " + (host.stringByteLength(body) as String) + "\r\n\r\n"
  return headers + (head ? "" : body)
end

def connection(fd: Int, handler: fn(Request): Response): Void
  unsafe
    let head = readHead(fd)
    if head.status == 0
      return
    end
    if head.status != 200
      writeText(fd, wire(text(head.status, "Request rejected"), false))
      return
    end
    let parsed = parse(head.text)
    let request = parsed.request
    var response = text(parsed.status, "Request rejected")
    if request != null
      response = handler(request)
    end
    writeText(fd, wire(response, parsed.head))
  end
end

# Returns an owned error string on startup/listener failure; otherwise serves until
# process termination. Per-connection failures are isolated from the accept loop.
def serve(address: String, handler: fn(Request): Response): String
  if host.stringByteLength(address) < 11 || host.stringSlice(address, 0, 10) != "127.0.0.1:"
    return "Address must be 127.0.0.1:<port>"
  end
  let portText = host.stringSlice(address, 10, host.stringByteLength(address) - 10)
  let port = host.parseInt(portText)
  if port == null || port < 1 || port > 65535
    return "Port must be an integer from 1 to 65535"
  end
  unsafe
    let listener = netOpen()
    if listener < 0
      return "Open listener: " + socketError()
    end
    if netConfigure(listener) < 0 || netBind(listener, port) < 0 || netListen(listener) < 0
      let detail = socketError()
      let error = "Listen on " + address + ": " + detail
      netClose(listener)
      return error
    end
    while true
      let ready = netPoll(listener, 0, -1)
      if ready == -1
        let error = "Wait for connection: " + socketError()
        netClose(listener)
        return error
      end
      if ready > 0
        let fd = netAccept(listener)
        if fd == -1
          let error = "Accept connection: " + socketError()
          netClose(listener)
          return error
        end
        if fd >= 0
          if netConfigure(fd) == 0
            connection(fd, handler)
          end
          netClose(fd)
        end
      end
    end
  end
  return "Listener stopped"
end

@cabi("neri_rt_v1_net_open")
def unsafe netOpen(): Int
end
@cabi("neri_rt_v1_net_configure")
def unsafe netConfigure(fd: Int): Int
end
@cabi("neri_rt_v1_net_bind")
def unsafe netBind(fd: Int, port: Int): Int
end
@cabi("neri_rt_v1_net_listen")
def unsafe netListen(fd: Int): Int
end
@cabi("neri_rt_v1_net_accept")
def unsafe netAccept(fd: Int): Int
end
@cabi("neri_rt_v1_net_poll")
def unsafe netPoll(fd: Int, writing: Int, milliseconds: Int): Int
end
@cabi("neri_rt_v1_net_read")
def unsafe netRead(fd: Int, bytes: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_net_write")
def unsafe netWrite(fd: Int, bytes: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_net_close")
def unsafe netClose(fd: Int): Void
end
@cabi("neri_rt_v1_net_milliseconds")
def unsafe netMilliseconds(): Int
end
@cabi("neri_rt_v1_net_error")
def unsafe netError(bytes: Byte*, capacity: Int): Int
end

def socketError(): String
  unsafe
    let bytes = stackalloc Byte[256]
    let length = netError(bytes, 256)
    var text = ""
    var index = 0
    while index < length
      let character = host.stringFromBytes([bytes[index]])
      text = text + character if character != null
      index = index + 1
    end
    return text
  end
end

# Each operation keeps one absolute deadline across interruptions and partial I/O.
def waitSocket(fd: Int, writing: Int, deadline: Int): Int
  unsafe
    while true
      let now = netMilliseconds()
      if now < 0
        return -1
      end
      let remaining = deadline - now
      if remaining <= 0
        return 0
      end
      let result = netPoll(fd, writing, remaining)
      if result != -2
        return result
      end
    end
    return -1
  end
end

class Head
  public text: String = ""
  public status: Int = 0
end

def readHead(fd: Int): Head
  unsafe
    let result = new Head()
    let bytes = stackalloc Byte[8192]
    let started = netMilliseconds()
    if started < 0
      return result
    end
    let deadline = started + 2000
    var length = 0
    var scanned = 0
    while length < 8192
      let ready = waitSocket(fd, 0, deadline)
      if ready <= 0
        if ready == 0
          result.status = 408
        end
        return result
      end
      let count = netRead(fd, bytes + length, 8192 - length)
      if count == 0 || count == -1
        return result
      end
      if count > 0
        length = length + count
        while scanned < length
          let byte = bytes[scanned] as Int
          if byte > 126 || (byte < 32 && byte != 9 && byte != 10 && byte != 13)
            result.status = 400
            return result
          end
          scanned = scanned + 1
          if scanned >= 4 && bytes[scanned - 4] == (13 as Byte) && bytes[scanned - 3] == (10 as Byte) && bytes[scanned - 2] == (13 as Byte) && bytes[scanned - 1] == (10 as Byte)
            var index = 0
            while index < scanned
              let character = host.stringFromBytes([bytes[index]])
              result.text = result.text + character if character != null
              index = index + 1
            end
            result.status = 200
            return result
          end
        end
      end
    end
    result.status = 431
    return result
  end
end

def writeText(fd: Int, text: String): Bool
  unsafe
    let bytes = stackalloc Byte[1024]
    let started = netMilliseconds()
    if started < 0
      return false
    end
    let deadline = started + 2000
    var offset = 0
    let length = host.stringByteLength(text)
    while offset < length
      var size = length - offset
      if size > 1024
        size = 1024
      end
      var index = 0
      while index < size
        bytes[index] = host.stringByteAt(text, offset + index)
        index = index + 1
      end
      var sent = 0
      while sent < size
        if waitSocket(fd, 1, deadline) <= 0
          return false
        end
        let count = netWrite(fd, bytes + sent, size - sent)
        if count == 0 || count == -1
          return false
        end
        if count > 0
          sent = sent + count
        end
      end
      offset = offset + size
    end
    return true
  end
end
