use buffers
use host
use http
use result
use tasks
namespace httpclient

def now(): Int
  unsafe
    return http.netMilliseconds()
  end
end

@cabiImport("neri_rt_v1_net_connect_timeout")
unsafe def netConnect(fd: Int, port: Int, timeoutMilliseconds: Int): Int
end

def get(port: Int, path: String, headers: http.Headers? = null, options: Options? = null): result.Result<Response, result.Failure>
  return request(port, "GET", path, headers, null, options)
end

def head(port: Int, path: String, headers: http.Headers? = null, options: Options? = null): result.Result<Response, result.Failure>
  return request(port, "HEAD", path, headers, null, options)
end

def request(port: Int, method: String, path: String, headers: http.Headers? = null, body: Byte[]? = null, options: Options? = null): result.Result<Response, result.Failure>
  var settings = new Options()

  settings = options if options != null
  if port < 1 || port > 65535
    return failed("invalid_port", "request.validate")
  end
  if !token(method)
    return failed("invalid_method", "request.validate")
  end
  if !originTarget(path)
    return failed("invalid_target", "request.validate")
  end
  if settings.timeoutMilliseconds < 1 || settings.timeoutMilliseconds > 2147483647 || settings.headerLimit < 1 || settings.headerLimit > 1048576 || settings.bodyLimit < 0 || settings.bodyLimit > 134217728
    return failed("invalid_options", "request.validate")
  end
  var input = new http.Headers()

  input = headers if headers != null
  if input.values("host").Length > 0 || input.values("connection").Length > 0 || input.values("content-length").Length > 0 || input.values("transfer-encoding").Length > 0
    return failed("reserved_header", "request.validate")
  end
  let payload = encodeRequest(port, method, path, input, body)

  if payload == null
    return failed("request_limit", "request.encode")
  end
  unsafe
    let started = http.netMilliseconds()

    if started < 0
      return failed("clock_error", "request.clock", http.socketError())
    end
    let deadline = started + settings.timeoutMilliseconds
    let fd = http.netOpen()

    if fd < 0
      return failed("socket_error", "connect.open", http.socketError())
    end
    if http.netConfigure(fd) != 0
      let detail = http.socketError()

      return finish(fd, failed("socket_error", "connect.configure", detail))
    end
    let beforeConnect = http.netMilliseconds()

    if beforeConnect < 0 || beforeConnect >= deadline
      return finish(fd, failed("timeout", "connect"))
    end
    let connected = netConnect(fd, port, deadline - beforeConnect)

    if connected != 0
      let detail = http.socketError()

      if connected == -2
        return finish(fd, failed("timeout", "connect", detail))
      end
      return finish(fd, failed("socket_error", "connect", detail))
    end
    let beforeWrite = http.netMilliseconds()

    if beforeWrite < 0 || beforeWrite >= deadline
      return finish(fd, failed("timeout", "request.write"))
    end
    let written = http.writeBytesResult(fd, payload, deadline - beforeWrite)
    let writeFailure = written.failure

    if writeFailure != null
      return finish(fd, failed(writeFailure.code, "request." + writeFailure.operation, writeFailure.detail, written.bytesWritten))
    end
    let received = receive(fd, method == "HEAD", settings, deadline)

    return finish(fd, received)
  end
end

def encodeRequest(port: Int, method: String, path: String, headers: http.Headers, body: Byte[]?): Byte[]?
  let output = buffers.ByteBuffer.create(1048576, 1024)

  if output == null || !output.appendText(method + " " + path + " HTTP/1.1\r\nHost: 127.0.0.1:" + (port as String) + "\r\nConnection: close\r\n")
    return null
  end
  var index = 0

  while index < headers.count()
    if !output.appendText(headers.nameAt(index) + ": " + headers.valueAt(index) + "\r\n")
      return null
    end
    index = index + 1
  end
  if body != null && !output.appendText("Content-Length: " + (body.Length as String) + "\r\n")
    return null
  end
  if !output.appendText("\r\n") || (body != null && !output.appendBytes(body))
    return null
  end
  return output.snapshot()
end

def receive(fd: Int, headRequest: Bool, options: Options, deadline: Int): result.Result<Response, result.Failure>
  unsafe
    let maximum = options.headerLimit + options.bodyLimit
    var initial = 4096

    initial = maximum if initial > maximum
    let output = buffers.ByteBuffer.create(maximum, initial)

    if output == null
      return failed("invalid_options", "response.read")
    end
    let chunk = stackalloc Byte[4096]
    var headEnd = -1
    var expectedBody = -2
    var headScanned = 4

    while true
      let ready = http.waitSocket(fd, 0, deadline)

      if ready == 0
        return failed("timeout", "response.read", "", output.length())
      end
      if ready < 0
        return failed("socket_error", "response.read", http.socketError(), output.length())
      end
      let count = http.netRead(fd, chunk, 4096)

      if count == 0
        return parseResponse(output.snapshot(), headEnd, headRequest, options)
      end
      if count == -1
        return failed("socket_error", "response.read", http.socketError(), output.length())
      end
      if count == -2
        continue
      end
      var index = 0

      while index < count
        if !output.append(chunk[index])
          return failed(headEnd < 0 ? "header_limit" : "body_limit", "response.read", "", output.length())
        end
        index = index + 1
      end
      if headEnd < 0
        headEnd = delimiter(output, headScanned)
        headScanned = output.length() - 3 if headEnd < 0 && output.length() > 3
        if headEnd < 0 && output.length() >= options.headerLimit
          return failed("header_limit", "response.read", "", output.length())
        end
        if headEnd > options.headerLimit
          return failed("header_limit", "response.read", "", output.length())
        end
        if headEnd >= 0 && output.length() - headEnd > options.bodyLimit
          return failed("body_limit", "response.read", "", output.length())
        end
        if headEnd >= 0
          let headerBytes = output.snapshot()
          let validated = parseResponse(headerBytes, headEnd, headRequest, options, false)

          match validated
            case result.Result.Ok(response)
              return result.Result<Response, result.Failure>.Ok(response)
            case result.Result.Error(failure)
              if failure.code != "incomplete_body"
                return result.Result<Response, result.Failure>.Error(failure)
              end
          end
          expectedBody = framedBodyLength(headerBytes, headEnd, headRequest)
          if expectedBody > options.bodyLimit
            return failed("body_limit", "response.read", "", output.length())
          end
        end
      else
        if output.length() - headEnd > options.bodyLimit
          return failed("body_limit", "response.read", "", output.length())
        end
      end
      if headEnd >= 0 && expectedBody >= 0
        let actual = output.length() - headEnd

        if actual == expectedBody
          return parseResponse(output.snapshot(), headEnd, headRequest, options, false)
        end
        if actual > expectedBody
          return failed("extra_body", "response.parse", "", output.length())
        end
      end
    end
    return failed("socket_error", "response.read")
  end
end

def framedBodyLength(bytes: Byte[], headEnd: Int, headRequest: Bool): Int
  let headBytes: Byte[] = tasks.generate(headEnd, 1) do |index|
    return bytes[index]
  end
  let text = host.stringFromBytes(headBytes)

  if text == null
    return -2
  end
  let firstEnd = http.find(text, "\r\n", 0)

  if firstEnd < 12
    return -2
  end
  let status = decimal(host.stringSlice(text, 9, 3))

  if status == null
    return -2
  end
  if headRequest || status == 204 || status == 205 || status == 304 || status < 200
    return 0
  end
  var position = firstEnd + 2
  var length = -1

  while position < headEnd - 2
    let lineEnd = http.find(text, "\r\n", position)
    let colon = http.find(text, ":", position)

    if lineEnd < position || colon <= position || colon >= lineEnd
      return -2
    end
    if lower(host.stringSlice(text, position, colon - position)) == "content-length"
      if length >= 0
        return -2
      end
      let parsed = decimal(http.trim(host.stringSlice(text, colon + 1, lineEnd - colon - 1)))

      if parsed == null
        return -2
      end
      length = parsed
    end
    position = lineEnd + 2
  end
  return length
end

def delimiter(bytes: buffers.ByteBuffer, start: Int): Int
  var index = start

  while index <= bytes.length()
    let first = bytes.byteAt(index - 4)
    let second = bytes.byteAt(index - 3)
    let third = bytes.byteAt(index - 2)
    let fourth = bytes.byteAt(index - 1)

    if first != null && second != null && third != null && fourth != null && first == (13 as Byte) && second == (10 as Byte) && third == (13 as Byte) && fourth == (10 as Byte)
      return index
    end
    index = index + 1
  end
  return -1
end

def parseResponse(bytes: Byte[], headEnd: Int, headRequest: Bool, options: Options, endOfStream: Bool = true): result.Result<Response, result.Failure>
  if headEnd < 4 || headEnd > bytes.Length
    return failed("incomplete_header", "response.parse", "", bytes.Length)
  end
  if headEnd > options.headerLimit
    return failed("header_limit", "response.parse", "", bytes.Length)
  end
  let headBytes: Byte[] = tasks.generate(headEnd, 1) do |index|
    return bytes[index]
  end
  let text = host.stringFromBytes(headBytes)

  if text == null
    return failed("invalid_header_bytes", "response.parse", "", bytes.Length)
  end
  let firstEnd = http.find(text, "\r\n", 0)

  if firstEnd < 13 || http.find(host.stringSlice(text, 0, firstEnd), "HTTP/1.1 ", 0) != 0
    return failed("invalid_status_line", "response.parse", "", bytes.Length)
  end
  let status = decimal(host.stringSlice(text, 9, 3))

  if status == null || status < 100 || status > 599 || host.stringByteAt(text, 12) != (32 as Byte) || !fieldValue(host.stringSlice(text, 13, firstEnd - 13))
    return failed("invalid_status", "response.parse", "", bytes.Length)
  end
  if status < 200
    return failed("unsupported_interim_response", "response.parse", "", bytes.Length)
  end
  let headers = new Headers()
  var position = firstEnd + 2

  while position < headEnd - 2
    let lineEnd = http.find(text, "\r\n", position)

    if lineEnd < position
      return failed("invalid_header", "response.parse", "", bytes.Length)
    end
    let colon = http.find(text, ":", position)

    if colon <= position || colon >= lineEnd || !headers.add(host.stringSlice(text, position, colon - position), http.trim(host.stringSlice(text, colon + 1, lineEnd - colon - 1)))
      return failed("invalid_header", "response.parse", "", bytes.Length)
    end
    position = lineEnd + 2
  end
  if headers.values("transfer-encoding").Length > 0
    return failed("unsupported_framing", "response.parse", "", bytes.Length)
  end
  let lengths = headers.values("content-length")

  if lengths.Length > 1
    return failed("ambiguous_length", "response.parse", "", bytes.Length)
  end
  var expected = -1

  if lengths.Length == 1
    let parsed = decimal(lengths[0])

    if parsed == null || parsed < 0
      return failed("invalid_length", "response.parse", "", bytes.Length)
    end
    expected = parsed
  end
  if headRequest || status == 204 || status == 205 || status == 304 || (status >= 100 && status < 200)
    expected = 0
  end
  if expected < 0
    if !endOfStream
      return failed("incomplete_body", "response.parse", "", bytes.Length)
    end
    expected = bytes.Length - headEnd
  end
  if expected > options.bodyLimit
    return failed("body_limit", "response.parse", "", bytes.Length)
  end
  if bytes.Length - headEnd < expected
    return failed("incomplete_body", "response.parse", "", bytes.Length)
  end
  if bytes.Length - headEnd > expected
    return failed("extra_body", "response.parse", "", bytes.Length)
  end
  let body: Byte[] = tasks.generate(expected, 1) do |index|
    return bytes[headEnd + index]
  end

  return result.Result<Response, result.Failure>.Ok(new Response(status, headers, body))
end

def token(value: String): Bool
  return http.token(value)
end

def fieldValue(value: String): Bool
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    if byte == 0 || byte == 10 || byte == 13 || byte == 127 || (byte < 32 && byte != 9)
      return false
    end
    index = index + 1
  end
  return true
end

def decimal(value: String): Int?
  let length = host.stringByteLength(value)

  if length == 0 || length > 18
    return null
  end
  var result = 0
  var index = 0

  while index < length
    let byte = host.stringByteAt(value, index) as Int

    if byte < 48 || byte > 57 || result > 922337203685477580 || (result == 922337203685477580 && byte > 55)
      return null
    end
    result = result * 10 + byte - 48
    index = index + 1
  end
  return result
end

def lower(value: String): String
  var output = ""
  var index = 0

  while index < host.stringByteLength(value)
    var byte = host.stringByteAt(value, index) as Int

    byte = byte + 32 if byte >= 65 && byte <= 90
    let character = host.stringFromBytes([byte as Byte])

    output = output + character if character != null
    index = index + 1
  end
  return output
end

def originTarget(value: String): Bool
  let length = host.stringByteLength(value)

  if length == 0 || host.stringByteAt(value, 0) != (47 as Byte)
    return false
  end
  var index = 0

  while index < length
    let byte = host.stringByteAt(value, index) as Int

    if byte <= 32 || byte == 35 || byte == 127
      return false
    end
    index = index + 1
  end
  return true
end

def failed(code: String, operation: String, detail: String = "", transferred: Int = 0): result.Result<Response, result.Failure>
  return result.Result<Response, result.Failure>.Error(new result.Failure(code, operation, detail, transferred))
end

unsafe def finish(fd: Int, outcome: result.Result<Response, result.Failure>): result.Result<Response, result.Failure>
  if http.netCloseResult(fd) == 0
    return outcome
  end
  let closed = new result.Failure("close_failed", "socket.close", http.socketError())

  match outcome
    case result.Result.Ok(response)
      return result.Result<Response, result.Failure>.Error(closed)
    case result.Result.Error(failure)
      failure.closeFailure = closed
      return result.Result<Response, result.Failure>.Error(failure)
  end
end
