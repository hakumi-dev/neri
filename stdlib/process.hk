use buffers
use host
use result
use tasks
namespace process

@cabiImport("neri_rt_v1_process_spawn_input")
unsafe def nativeSpawn(config: Byte*, length: Int, token: Int*, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_process_poll")
unsafe def nativePoll(token: Int, waitMilliseconds: Int, state: Int*, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_process_read")
unsafe def nativeRead(token: Int, channel: Int, offset: Int, output: Byte*, capacity: Int, count: Int*): Int
end
@cabiImport("neri_rt_v1_process_cancel")
unsafe def nativeCancel(token: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_process_interrupt")
unsafe def nativeInterrupt(token: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_process_dispose")
unsafe def nativeDispose(token: Int, osCode: Int*): Int
end

def spawn(options: SpawnOptions): SpawnResult
  let config = encodeOptions(options)

  if config == null
    return SpawnResult.failed("invalid_options")
  end
  return Child.start(config)
end

def asResultFailure(failure: Failure, fallbackOperation: String): result::Failure
  var operation = failure.operation

  operation = fallbackOperation if operation == ""
  return new result::Failure(failure.code(), operation, "", 0, failure.osCode)
end

def spawnOutcome(options: SpawnOptions): result::Result<Child, result::Failure>
  let value = spawn(options)
  let failure = value.failure()

  if failure != null
    return result::Result<Child, result::Failure>.Error(asResultFailure(failure, "process.spawn"))
  end
  let child = value.child()

  if child == null
    return result::Result<Child, result::Failure>.Error(new result::Failure("missing_child", "process.spawn"))
  end
  return result::Result<Child, result::Failure>.Ok(child)
end

def pollOutcome(child: Child): result::Result<PollResult, result::Failure>
  return waitOutcome(child, 0)
end

def waitOutcome(child: Child, milliseconds: Int): result::Result<PollResult, result::Failure>
  let value = child.wait(milliseconds)
  let failure = value.failure

  if failure != null
    return result::Result<PollResult, result::Failure>.Error(asResultFailure(failure, "process.poll"))
  end
  return result::Result<PollResult, result::Failure>.Ok(value)
end

def run(options: SpawnOptions, timeoutMilliseconds: Int = 60000): result::Result<PollResult, result::Failure>
  if timeoutMilliseconds < 0 || timeoutMilliseconds > 60000
    return result::Result<PollResult, result::Failure>.Error(new result::Failure("invalid_timeout", "process.run"))
  end
  let started = spawn(options)
  let spawnFailure = started.failure()

  if spawnFailure != null
    return result::Result<PollResult, result::Failure>.Error(asResultFailure(spawnFailure, "process.spawn"))
  end
  let child = started.child()

  if child == null
    return result::Result<PollResult, result::Failure>.Error(new result::Failure("missing_child", "process.spawn"))
  end
  let completed = child.wait(timeoutMilliseconds)
  let waitFailure = completed.failure

  if waitFailure != null
    let primary = asResultFailure(waitFailure, "process.poll")

    match child.disposeOutcome()
      case result::Result.Error(closeFailure)
        primary.closeFailure = closeFailure
      case result::Result.Ok(value)
        return result::Result<PollResult, result::Failure>.Error(primary)
    end
    return result::Result<PollResult, result::Failure>.Error(primary)
  end
  if completed.running
    let cancelled = child.cancelOutcome()

    match cancelled
      case result::Result.Error(failure)
        match child.disposeOutcome()
          case result::Result.Error(closeFailure)
            failure.closeFailure = closeFailure
          case result::Result.Ok(value)
            return result::Result<PollResult, result::Failure>.Error(failure)
        end
        return result::Result<PollResult, result::Failure>.Error(failure)
      case result::Result.Ok(value)
        let timeout = new result::Failure("timeout", "process.run")

        match child.disposeOutcome()
          case result::Result.Error(closeFailure)
            timeout.closeFailure = closeFailure
          case result::Result.Ok(disposed)
            return result::Result<PollResult, result::Failure>.Error(timeout)
        end
        return result::Result<PollResult, result::Failure>.Error(timeout)
    end
  end
  let disposed = child.disposeOutcome()

  match disposed
    case result::Result.Error(failure)
      return result::Result<PollResult, result::Failure>.Error(failure)
    case result::Result.Ok(value)
      return result::Result<PollResult, result::Failure>.Ok(completed)
  end
end

def encodeOptions(options: SpawnOptions): Byte[]?
  let invalidExecutable = host::stringByteLength(options.executable) == 0 || containsNul(options.executable)
  let invalidCounts = options.arguments.Length > 1023 || options.environment.Length > 1024
  let invalidLimits = options.stdoutLimit < 0 || options.stdoutLimit > 134217728 || options.stderrLimit < 0 || options.stderrLimit > 134217728

  if invalidExecutable || containsNul(options.workingDirectory) || invalidCounts || invalidLimits || (options.terminal && options.input.Length != 0)
    return null
  end
  var index = 0

  while index < options.arguments.Length
    if containsNul(options.arguments[index])
      return null
    end
    index = index + 1
  end
  index = 0
  while index < options.environment.Length
    let entry = options.environment[index]

    if host::stringByteLength(entry.name) == 0 || containsNul(entry.name) || containsNul(entry.value) || containsEquals(entry.name)
      return null
    end
    var previous = 0

    while previous < index
      if asciiLower(options.environment[previous].name) == asciiLower(entry.name)
        return null
      end
      previous = previous + 1
    end
    index = index + 1
  end
  let output = buffers::ByteBuffer.create(1048576)

  if output == null
    return null
  end
  if !output.appendText("NPR2") || !output.append(options.inheritEnvironment ? 1 as Byte : 0 as Byte)
    return null
  end
  if !appendU32(output, options.stdoutLimit) || !appendU32(output, options.stderrLimit)
    return null
  end
  if !appendText(output, options.workingDirectory) || !appendU32(output, options.arguments.Length + 1) || !appendText(output, options.executable)
    return null
  end
  for argument in options.arguments
    if !appendText(output, argument)
      return null
    end
  end
  if !appendU32(output, options.environment.Length)
    return null
  end
  for entry in options.environment
    if !appendText(output, entry.name) || !appendText(output, entry.value)
      return null
    end
  end
  if !appendU32(output, options.input.Length) || !output.appendBytes(options.input)
    return null
  end
  if !output.append(options.terminal ? 1 as Byte : 0 as Byte)
    return null
  end
  return output.snapshot()
end

def appendText(output: buffers::ByteBuffer, value: String): Bool
  return appendU32(output, host::stringByteLength(value)) && output.appendText(value)
end

def appendU32(output: buffers::ByteBuffer, value: Int): Bool
  if value < 0 || value > 4294967295
    return false
  end
  if !output.append((value - (value / 256) * 256) as Byte)
    return false
  end
  if !output.append(((value / 256) - (value / 65536) * 256) as Byte)
    return false
  end
  if !output.append(((value / 65536) - (value / 16777216) * 256) as Byte)
    return false
  end
  return output.append((value / 16777216) as Byte)
end

def containsNul(value: String): Bool
  var index = 0

  while index < host::stringByteLength(value)
    if host::stringByteAt(value, index) == (0 as Byte)
      return true
    end
    index = index + 1
  end
  return false
end

def containsEquals(value: String): Bool
  var index = 0

  while index < host::stringByteLength(value)
    if host::stringByteAt(value, index) == (61 as Byte)
      return true
    end
    index = index + 1
  end
  return false
end

def asciiLower(value: String): String
  var bytes: Byte[] = []
  var index = 0

  while index < host::stringByteLength(value)
    var byte = host::stringByteAt(value, index)
    let numeric = byte as Int

    byte = (numeric + 32) as Byte if numeric >= 65 && numeric <= 90
    bytes = host::appendByte(bytes, byte)
    index = index + 1
  end
  let result = host::stringFromBytes(bytes)

  if result == null
    return ""
  end
  return result
end
