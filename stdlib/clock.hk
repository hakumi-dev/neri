namespace clock

class Duration
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  static def fromMilliseconds(value: Int): Duration?
    if value < 0
      return null
    end
    return new Duration(value)
  end

  static def fromSeconds(value: Int): Duration?
    if value < 0 || value > 9223372036854775
      return null
    end
    return new Duration(value * 1000)
  end

  def milliseconds(): Int
    return this.value
  end

  def plus(other: Duration): Duration?
    if this.value > 9223372036854775807 - other.value
      return null
    end
    return new Duration(this.value + other.value)
  end
end

class Instant
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  static def fromMonotonicMilliseconds(value: Int): Instant?
    if value < 0
      return null
    end
    return new Instant(value)
  end

  static def now(): Instant?
    let value = clock.milliseconds()
    if value == null
      return null
    end
    return new Instant(value)
  end

  def since(earlier: Instant): Duration?
    if this.value < earlier.value
      return null
    end
    return Duration.fromMilliseconds(this.value - earlier.value)
  end

  def plus(duration: Duration): Instant?
    let delta = duration.milliseconds()
    if this.value > 9223372036854775807 - delta
      return null
    end
    return new Instant(this.value + delta)
  end

  def reached(deadline: Instant): Bool
    return this.value >= deadline.value
  end
end

class Clock
  private read: fn(): Instant?

  def init(read: fn(): Instant?): Void
    this.read = read
  end

  static def monotonic(): Clock
    let read: fn(): Instant? = fn()
      return Instant.now()
    end
    return new Clock(read)
  end

  def now(): Instant?
    let read = this.read
    return read()
  end
end

class FakeClock
  private value: Instant

  def init(start: Instant): Void
    this.value = start
  end

  def clock(): Clock
    let state = this
    let read: fn(): Instant? = fn()
      return state.value
    end
    return new Clock(read)
  end

  def advance(duration: Duration): Bool
    let next = this.value.plus(duration)
    if next == null
      return false
    end
    this.value = next
    return true
  end
end

class Timestamp
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  ## Constructs a wall-clock timestamp from signed Unix epoch milliseconds.
  static def fromUnixMilliseconds(value: Int): Timestamp
    return new Timestamp(value)
  end

  static def now(): Timestamp?
    let value = clock.wallMilliseconds()
    if value == null
      return null
    end
    return new Timestamp(value)
  end

  def unixMilliseconds(): Int
    return this.value
  end

  def plus(duration: Duration): Timestamp?
    let delta = duration.milliseconds()
    if this.value > 9223372036854775807 - delta
      return null
    end
    return new Timestamp(this.value + delta)
  end

  ## Formats UTC with millisecond precision and no locale-dependent state.
  ## Years outside 0000..9999 cannot be represented by this fixed format.
  def formatUtc(): String?
    if this.value < -62167219200000 || this.value >= 253402300800000
      return null
    end

    var days = this.value / 86400000
    var daytime = this.value - days * 86400000
    if daytime < 0
      days = days - 1
      daytime = daytime + 86400000
    end

    let shifted = days + 719468
    var era = shifted / 146097
    if shifted < 0
      era = (shifted - 146096) / 146097
    end
    let dayOfEra = shifted - era * 146097
    let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    let monthPrime = (5 * dayOfYear + 2) / 153
    let day = dayOfYear - (153 * monthPrime + 2) / 5 + 1
    var month = monthPrime + 3
    if monthPrime >= 10
      month = monthPrime - 9
      year = year + 1
    end

    let hour = daytime / 3600000
    let minute = (daytime / 60000) - hour * 60
    let second = (daytime / 1000) - (daytime / 60000) * 60
    let millisecond = daytime - (daytime / 1000) * 1000
    let date = clock.fourDigits(year) + "-" + clock.twoDigits(month) + "-" + clock.twoDigits(day)
    let time = clock.twoDigits(hour) + ":" + clock.twoDigits(minute) + ":" + clock.twoDigits(second)
    return date + "T" + time + "." + clock.threeDigits(millisecond) + "Z"
  end
end

class WallClock
  private read: fn(): Timestamp?

  def init(read: fn(): Timestamp?): Void
    this.read = read
  end

  static def system(): WallClock
    let read: fn(): Timestamp? = fn()
      return Timestamp.now()
    end
    return new WallClock(read)
  end

  def now(): Timestamp?
    let read = this.read
    return read()
  end
end

class FakeWallClock
  private value: Timestamp

  def init(start: Timestamp): Void
    this.value = start
  end

  def wallClock(): WallClock
    let state = this
    let read: fn(): Timestamp? = fn()
      return state.value
    end
    return new WallClock(read)
  end

  def advance(duration: Duration): Bool
    let next = this.value.plus(duration)
    if next == null
      return false
    end
    this.value = next
    return true
  end
end

def twoDigits(value: Int): String
  if value < 10
    return "0" + (value as String)
  end
  return value as String
end

def threeDigits(value: Int): String
  if value < 10
    return "00" + (value as String)
  end
  if value < 100
    return "0" + (value as String)
  end
  return value as String
end

def fourDigits(value: Int): String
  if value < 10
    return "000" + (value as String)
  end
  if value < 100
    return "00" + (value as String)
  end
  if value < 1000
    return "0" + (value as String)
  end
  return value as String
end

@cabi("neri_rt_v1_clock_milliseconds")
unsafe def nativeMilliseconds(): Int
end

@cabi("neri_rt_v1_clock_wall_milliseconds")
unsafe def nativeWallMilliseconds(value: Int*): Int
end

## Returns an arbitrary monotonic epoch in milliseconds.
## Suitable for elapsed time and deadlines, not wall-clock time.
def milliseconds(): Int?
  unsafe
    let value = nativeMilliseconds()
    if value < 0
      return null
    end
    return value
  end
end


## Returns signed Unix epoch milliseconds from the system wall clock.
def wallMilliseconds(): Int?
  unsafe
    let value = stackalloc Int[1]
    if nativeWallMilliseconds(value) != 0
      return null
    end
    return value[0]
  end
end
