namespace clock

@cabi("neri_rt_v1_clock_milliseconds")
def unsafe nativeMilliseconds(): Int
end

## Returns an arbitrary monotonic epoch in milliseconds.
## Suitable for elapsed time and deadlines, not wall-clock time.
def milliseconds(): Int?
  unsafe
    let value = nativeMilliseconds()
    if value < 0
      return null
    end
    return value
  end
end
