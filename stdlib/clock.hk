namespace clock

def twoDigits(value: Int): String
  if value < 10
    return "0" + (value as String)
  end
  return value as String
end

def threeDigits(value: Int): String
  if value < 10
    return "00" + (value as String)
  end
  if value < 100
    return "0" + (value as String)
  end
  return value as String
end

def fourDigits(value: Int): String
  if value < 10
    return "000" + (value as String)
  end
  if value < 100
    return "00" + (value as String)
  end
  if value < 1000
    return "0" + (value as String)
  end
  return value as String
end

@cabi("neri_rt_v1_clock_milliseconds")
unsafe def nativeMilliseconds(): Int
end

@cabi("neri_rt_v1_clock_wall_milliseconds")
unsafe def nativeWallMilliseconds(value: Int*): Int
end

## Returns an arbitrary monotonic epoch in milliseconds.
## Suitable for elapsed time and deadlines, not wall-clock time.
def milliseconds(): Int?
  unsafe
    let value = nativeMilliseconds()

    if value < 0
      return null
    end
    return value
  end
end


## Returns signed Unix epoch milliseconds from the system wall clock.
def wallMilliseconds(): Int?
  unsafe
    let value = stackalloc Int[1]

    if nativeWallMilliseconds(value) != 0
      return null
    end
    return value[0]
  end
end
