use host
namespace draw

class Color
  public red: Int = 0
  public green: Int = 0
  public blue: Int = 0
  public alpha: Int = 255

  def init(red: Int, green: Int, blue: Int, alpha: Int = 255): Void
    this.red = red
    this.green = green
    this.blue = blue
    this.alpha = alpha
  end

  static def black(): Color
    return new Color(0, 0, 0)
  end
  static def white(): Color
    return new Color(255, 255, 255)
  end
end
