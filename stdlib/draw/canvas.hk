use host
namespace draw

class Canvas
  private token: Int = 0
  public failed: Bool = false

  def init(token: Int): Void
    this.token = token
  end

  def color(color: Color): Bool
    if this.failed
      return false
    end
    unsafe
      this.failed = !nativeColor(this.token, color.red, color.green, color.blue, color.alpha)
    end
    return !this.failed
  end

  def clear(color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeClear(this.token)
      end
    end
  end

  def fillRect(x: Float, y: Float, width: Float, height: Float, color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeRect(this.token, x, y, width, height)
      end
    end
  end

  def line(x1: Float, y1: Float, x2: Float, y2: Float, color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeLine(this.token, x1, y1, x2, y2)
      end
    end
  end

  def text(x: Float, y: Float, text: String, color: Color): Void
    if !this.color(color)
      return
    end
    let bytes = cString(text)

    if bytes == null
      this.failed = true
      return
    end
    unsafe
      borrow bytes as pointer
        this.failed = !nativeText(this.token, x, y, pointer)
      end
    end
  end
end
