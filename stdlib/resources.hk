use result
namespace resources

enum Completion<T, E>
  case Value(value: T)
  case Failure(primary: E?)
end

class CloseFailureNode
  public value: result.Failure
  public next: CloseFailureNode

  def init(value: result.Failure): Void
    this.value = value
    this.next = this
  end
end

class CloseFailures
  private head: CloseFailureNode
  private tail: CloseFailureNode
  private size: Int = 0

  def init(): Void
    let sentinel = new CloseFailureNode(new result.Failure("", "resources.closeFailures"))

    this.head = sentinel
    this.tail = sentinel
  end

  def count(): Int
    return this.size
  end

  def add(value: result.Failure): Void
    let node = new CloseFailureNode(value)
    let currentTail = this.tail

    currentTail.next = node
    this.tail = node
    this.size = this.size + 1
  end

  def append(other: CloseFailures): Void
    var current = other.head
    let initialCount = other.size
    var copied = 0

    while copied < initialCount
      current = current.next
      this.add(current.value)
      copied = copied + 1
    end
  end

  def each(visit: fn(result.Failure): Void): Void
    var current = this.head
    let initialCount = this.size
    var visited = 0

    while visited < initialCount
      current = current.next
      visit(current.value)
      visited = visited + 1
    end
  end
end

class Outcome<T, E>
  public completion: Completion<T, E>
  public closeFailures: CloseFailures

  def init(completion: Completion<T, E>, closeFailures: CloseFailures = new CloseFailures()): Void
    this.completion = completion
    this.closeFailures = closeFailures
  end
end

def success<T, E>(value: T): Outcome<T, E>
  return new Outcome<T, E>(Completion<T, E>.Value(value))
end

def failure<T, E>(primary: E): Outcome<T, E>
  return new Outcome<T, E>(Completion<T, E>.Failure(primary))
end
