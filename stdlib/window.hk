use host
use draw
use input
use clock
namespace window

@cabi("neri_rt_v1_window_open")
def unsafe nativeOpen(title: Byte*, width: Int, height: Int): Int
end
@cabi("neri_rt_v1_window_close")
def unsafe nativeClose(token: Int): Void
end
@cabi("neri_rt_v1_window_poll")
def unsafe nativePoll(token: Int): Int
end
@cabi("neri_rt_v1_window_size")
def unsafe nativeSize(token: Int, axis: Int): Int
end
@cabi("neri_rt_v1_window_mouse")
def unsafe nativeMouse(token: Int, axis: Int): Float
end
@cabi("neri_rt_v1_window_present")
def unsafe nativePresent(token: Int): Bool
end
@cabi("neri_rt_v1_window_delay")
def unsafe nativeDelay(milliseconds: Int): Void
end
@cabi("neri_rt_v1_window_error")
def unsafe nativeError(buffer: Byte*, capacity: Int): Int
end

def errorMessage(): String
  unsafe
    let buffer = stackalloc Byte[512]
    let count = nativeError(buffer, 512)
    var bytes: Byte[] = []
    var index = 0
    while index < count
      bytes = host.appendByte(bytes, buffer[index])
      index = index + 1
    end
    let text = host.stringFromBytes(bytes)
    if text != null && text != ""
      return text
    end
  end
  return "Window operation failed"
end

class Options
  public title: String = "Neri"
  public width: Int = 800
  public height: Int = 600
  public fps: Int = 60
end

class Frame: draw.Canvas
  public input: input.State = new input.State()
  public width: Int = 0
  public height: Int = 0
  public timeMs: Int = 0
  public deltaMs: Int = 0
  private closing: Bool = false

  def init(token: Int): Void
    super(token)
  end
  def close(): Void
    this.closing = true
  end
  def isClosing(): Bool
    return this.closing
  end
end

def run(options: Options, update: fn(Frame): Void): String?
  let title = draw.cString(options.title)
  if title == null || options.width < 1 || options.width > 16384 || options.height < 1 || options.height > 16384 || options.fps < 1 || options.fps > 240
    return "Invalid window options"
  end
  let interval = 1000 / options.fps
  var token = 0
  unsafe
    borrow title as pointer
      token = nativeOpen(pointer, options.width, options.height)
    end
  end
  if token == 0
    return errorMessage()
  end
  let frame = new Frame(token)
  var previous = clock.milliseconds()
  var failure: String? = null
  while !frame.isClosing() && failure == null
    let start = clock.milliseconds()
    if start == null || previous == null
      failure = "Monotonic clock unavailable"
    else
      frame.timeMs = start
      frame.deltaMs = start - previous
      previous = start
      frame.input.beginFrame()
      unsafe
        var event = nativePoll(token)
        while event != 0 && !frame.isClosing()
          if event == 1
            frame.close()
          else
            frame.input.apply(event)
          end
          event = nativePoll(token)
        end
        frame.width = nativeSize(token, 0)
        frame.height = nativeSize(token, 1)
        frame.input.mouseX = nativeMouse(token, 0)
        frame.input.mouseY = nativeMouse(token, 1)
      end
      if !frame.isClosing()
        update(frame)
        if frame.failed
          failure = errorMessage()
        else if !frame.isClosing()
          unsafe
            if !nativePresent(token)
              failure = errorMessage()
            end
          end
        end
      end
      let finish = clock.milliseconds()
      if finish != null && !frame.isClosing() && failure == null
        unsafe
          nativeDelay(interval - (finish - start))
        end
      end
    end
  end
  unsafe
    nativeClose(token)
  end
  return failure
end
