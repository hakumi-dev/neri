namespace host

@intrinsic("host.exit")
def exit(status: Int): Void
end

@intrinsic("string.byteLength")
def stringByteLength(value: String): Int
end

@intrinsic("host.argumentCount")
def argumentCount(): Int
end

@cabi("neri_rt_v1_host_executable_path")
unsafe def executablePathBytes(output: Byte*, capacity: Int): Int
end

# Canonical path of the running process image, independent of its arguments.
def executablePath(): String?
  var length = 0
  let probe: Byte[] = [0 as Byte]

  unsafe
    borrow probe as pointer
      length = executablePathBytes(pointer, 0)
    end
  end
  if length < 0 || length > 1048576
    return null
  end
  var bytes: Byte[] = []
  var index = 0

  while index <= length
    bytes = appendByte(bytes, 0 as Byte)
    index = index + 1
  end
  unsafe
    borrow bytes as pointer
      if executablePathBytes(pointer, length + 1) != length
        return null
      end
    end
  end
  let text = stringFromBytes(bytes)

  if text == null
    return null
  end
  return stringSlice(text, 0, length)
end

@intrinsic("string.byteAt")
def stringByteAt(value: String, index: Int): Byte
end

@intrinsic("string.slice")
def stringSlice(value: String, start: Int, length: Int): String
end

@intrinsic("host.errorMessage")
def errorMessage(): String
end

@intrinsic("string.fromBytes")
def stringFromBytes(value: Byte[]): String?
end

@intrinsic("host.readText")
def readText(path: String): String?
end

@intrinsic("host.pathJoin")
def pathJoin(left: String, right: String): String?
end

@intrinsic("host.pathAbsolute")
def pathAbsolute(path: String): String?
end

@intrinsic("host.pathFileName")
def pathFileName(path: String): String?
end

@intrinsic("host.argumentAt")
def argumentAt(index: Int): String?
end

@intrinsic("host.environment")
def environment(name: String): String?
end

@intrinsic("host.parseInt")
def parseInt(value: String): Int?
end

@intrinsic("host.run")
def run(program: String, arguments: String[]): Int?
end

@intrinsic("host.parseFloat")
def parseFloat(value: String): Float?
end

@intrinsic("host.appendByte")
def appendByte(values: Byte[], value: Byte): Byte[]
end

@intrinsic("host.appendInt")
def appendInt(values: Int[], value: Int): Int[]
end

@intrinsic("host.appendString")
def appendString(values: String[], value: String): String[]
end

@intrinsic("host.writeText")
def writeText(path: String, value: String): Bool
end

@intrinsic("host.writeBytes")
def writeBytes(path: String, value: Byte[]): Bool
end

@intrinsic("host.removeFile")
def removeFile(path: String): Bool
end
