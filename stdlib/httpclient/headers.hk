use buffers
use host
use http
use result
use tasks
namespace httpclient

class Headers
  private names: String[] = []
  private contents: String[] = []

  def add(name: String, value: String): Bool
    if this.names.Length >= 128 || !token(name) || !fieldValue(value)
      return false
    end
    this.names = host::appendString(this.names, name)
    this.contents = host::appendString(this.contents, value)
    return true
  end

  def values(name: String): String[]
    var found: String[] = []
    var index = 0

    while index < this.names.Length
      if lower(this.names[index]) == lower(name)
        found = host::appendString(found, this.contents[index])
      end
      index = index + 1
    end
    return found
  end
end
