use buffers
use host
use http
use result
use tasks
namespace httpclient

class Response
  public status: Int
  public headers: Headers
  public body: Byte[]

  def init(status: Int, headers: Headers, body: Byte[]): Void
    this.status = status
    this.headers = headers
    this.body = body
  end

  def header(name: String): String?
    let values = this.headers.values(name)

    if values.Length == 0
      return null
    end
    return values[0]
  end

  def headerValues(name: String): String[]
    return this.headers.values(name)
  end

  def text(): String?
    return host.stringFromBytes(this.body)
  end
end
