use buffers
use host
use http
use result
use tasks
namespace httpclient

# A deliberately small HTTP/1.1 client for loopback integration tests.
# It sends origin-form targets byte-for-byte and closes each connection.

class Options
  public timeoutMilliseconds: Int = 4000
  public headerLimit: Int = 16384
  public bodyLimit: Int = 8388608
end
