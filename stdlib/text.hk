use host
use tasks
namespace text

class Scalar
  private code: Int

  private def init(code: Int): Void
    this.code = code
  end

  def static fromInt(code: Int): Scalar?
    if code < 0 || code > 1114111 || (code >= 55296 && code <= 57343)
      return null
    end
    return new Scalar(code)
  end

  @conversion
  @readonly
  def value(): Int
    return this.code
  end

  @readonly
  def utf8(): Byte[]
    if this.code < 128
      return [this.code as Byte]
    end
    if this.code < 2048
      let high = this.code / 64

      return [(192 + high) as Byte, (128 + this.code - high * 64) as Byte]
    end
    if this.code < 65536
      let high = this.code / 4096
      let middle = (this.code - high * 4096) / 64

      return [(224 + high) as Byte, (128 + middle) as Byte, (128 + this.code - high * 4096 - middle * 64) as Byte]
    end
    let high = this.code / 262144
    let upper = (this.code - high * 262144) / 4096
    let middle = (this.code - high * 262144 - upper * 4096) / 64

    return [(240 + high) as Byte, (128 + upper) as Byte, (128 + middle) as Byte, (128 + this.code - high * 262144 - upper * 4096 - middle * 64) as Byte]
  end

  @readonly
  def toString(): String?
    return fromBytes(this.utf8())
  end

  @operator("==")
  @readonly
  def equals(other: Scalar): Bool
    return this.code == other.code
  end
end

def byteLength(value: String): Int
  return host.stringByteLength(value)
end

def byteAt(value: String, offset: Int): Byte?
  if offset < 0 || offset >= byteLength(value)
    return null
  end
  return host.stringByteAt(value, offset)
end

def isScalarBoundary(value: String, offset: Int): Bool
  let length = byteLength(value)

  if offset < 0 || offset > length
    return false
  end
  if offset == length
    return true
  end
  let byte = byteAt(value, offset)

  if byte == null
    return false
  end
  let first = byte as Int

  return first < 128 || first >= 192
end

def sliceBytes(value: String, start: Int, length: Int): String?
  let total = byteLength(value)

  if start < 0 || length < 0 || start > total || length > total - start || !isScalarBoundary(value, start) || !isScalarBoundary(value, start + length)
    return null
  end
  return host.stringSlice(value, start, length)
end

def fromBytes(value: Byte[]): String?
  return host.stringFromBytes(value)
end

def copyBytes(value: String, target: Byte[], offset: Int): Bool
  let length = byteLength(value)

  if offset < 0 || offset > target.Length || length > target.Length - offset
    return false
  end
  var index = 0

  while index < length
    target[offset + index] = host.stringByteAt(value, index)
    index = index + 1
  end
  return true
end

def bytes(value: String): Byte[]
  let length = byteLength(value)
  let result: Byte[] = tasks.generate(length, 1) do |index|
    return 0 as Byte
  end

  copyBytes(value, result, 0)
  return result
end

def scalarWidth(first: Int): Int
  if first < 128
    return 1
  end
  if first < 224
    return 2
  end
  if first < 240
    return 3
  end
  return 4
end

def scalarByte(value: String, offset: Int): Int
  let item = byteAt(value, offset)

  if item == null
    return -1
  end
  return item as Int
end

def scalarCount(value: String): Int
  let length = byteLength(value)
  var offset = 0
  var count = 0

  while offset < length
    offset = offset + scalarWidth(scalarByte(value, offset))
    count = count + 1
  end
  return count
end

def scalarAt(value: String, index: Int): Int?
  if index < 0
    return null
  end
  let length = byteLength(value)
  var offset = 0
  var current = 0

  while offset < length
    let first = scalarByte(value, offset)

    if current == index
      if first < 128
        return first
      end
      let second = scalarByte(value, offset + 1)

      if first < 224
        return (first - 192) * 64 + second - 128
      end
      let third = scalarByte(value, offset + 2)

      if first < 240
        return (first - 224) * 4096 + (second - 128) * 64 + third - 128
      end
      let fourth = scalarByte(value, offset + 3)

      return (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
    end
    offset = offset + scalarWidth(first)
    current = current + 1
  end
  return null
end

def concat(left: String, right: String): String
  return left + right
end

def equal(left: String, right: String): Bool
  return left == right
end
