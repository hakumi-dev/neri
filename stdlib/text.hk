use tasks
namespace text

class Scalar
  private code: Int

  private def init(code: Int): Void
    this.code = code
  end

  def static fromInt(code: Int): Scalar?
    if code < 0 || code > 1114111 || (code >= 55296 && code <= 57343)
      return null
    end
    return new Scalar(code)
  end

  @conversion
  @readonly
  def value(): Int
    return this.code
  end

  @readonly
  def utf8(): Byte[]
    if this.code < 128
      return [this.code as Byte]
    end
    if this.code < 2048
      let high = this.code / 64

      return [(192 + high) as Byte, (128 + this.code - high * 64) as Byte]
    end
    if this.code < 65536
      let high = this.code / 4096
      let middle = (this.code - high * 4096) / 64

      return [(224 + high) as Byte, (128 + middle) as Byte, (128 + this.code - high * 4096 - middle * 64) as Byte]
    end
    let high = this.code / 262144
    let upper = (this.code - high * 262144) / 4096
    let middle = (this.code - high * 262144 - upper * 4096) / 64

    return [(240 + high) as Byte, (128 + upper) as Byte, (128 + middle) as Byte, (128 + this.code - high * 262144 - upper * 4096 - middle * 64) as Byte]
  end

  @readonly
  def toString(): String?
    return String.fromBytes(this.utf8())
  end

  @operator("==")
  @readonly
  def equals(other: Scalar): Bool
    return this.code == other.code
  end
end

def byteLength(value: String): Int
  return value.byteLength()
end

def byteAt(value: String, offset: Int): Byte?
  return value.byteAt(offset)
end

def isScalarBoundary(value: String, offset: Int): Bool
  return value.isScalarBoundary(offset)
end

def sliceBytes(value: String, start: Int, length: Int): String?
  return value.sliceBytes(start, length)
end

def fromBytes(value: Byte[]): String?
  return String.fromBytes(value)
end

def copyBytes(value: String, target: Byte[], offset: Int): Bool
  let length = byteLength(value)

  if offset < 0 || offset > target.Length || length > target.Length - offset
    return false
  end
  var index = 0

  while index < length
    let item = value.byteAt(index)

    if item == null
      return false
    end
    target[offset + index] = item
    index = index + 1
  end
  return true
end

def bytes(value: String): Byte[]
  let length = byteLength(value)
  let result: Byte[] = tasks.generate(length, 1) do |index|
    return 0 as Byte
  end

  copyBytes(value, result, 0)
  return result
end

def scalarWidth(first: Int): Int
  if first < 128
    return 1
  end
  if first < 224
    return 2
  end
  if first < 240
    return 3
  end
  return 4
end

def scalarByte(value: String, offset: Int): Int
  let item = byteAt(value, offset)

  if item == null
    return -1
  end
  return item as Int
end

def scalarCount(value: String): Int
  return value.scalarCount()
end

def scalarAt(value: String, index: Int): Int?
  return value.scalarAt(index)
end

def concat(left: String, right: String): String
  return left.concat(right)
end

def equal(left: String, right: String): Bool
  return left.equals(right)
end
