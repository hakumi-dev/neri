use result
namespace resources

class CloseFailures
  private head: CloseFailureNode
  private tail: CloseFailureNode
  private size: Int = 0

  def init(): Void
    let sentinel = new CloseFailureNode(new result.Failure("", "resources.closeFailures"))

    this.head = sentinel
    this.tail = sentinel
  end

  def count(): Int
    return this.size
  end

  def add(value: result.Failure): Void
    let node = new CloseFailureNode(value)
    let currentTail = this.tail

    currentTail.next = node
    this.tail = node
    this.size = this.size + 1
  end

  def append(other: CloseFailures): Void
    var current = other.head
    let initialCount = other.size
    var copied = 0

    while copied < initialCount
      current = current.next
      this.add(current.value)
      copied = copied + 1
    end
  end

  def each(visit: fn(result.Failure): Void): Void
    var current = this.head
    let initialCount = this.size
    var visited = 0

    while visited < initialCount
      current = current.next
      visit(current.value)
      visited = visited + 1
    end
  end
end
