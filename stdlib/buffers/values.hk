use host
use tasks
use text
namespace buffers

class Values<T>
  private first: ValueNode<T>?
  private last: ValueNode<T>?
  private size: Int = 0
  private maximum: Int

  private def init(limit: Int): Void
    this.maximum = limit
  end

  static def create(limit: Int): Values<T>?
    if limit < 0 || limit > 134217728
      return null
    end
    return new Values<T>(limit)
  end

  def add(value: T): Bool
    if this.size >= this.maximum
      return false
    end
    let node = new ValueNode<T>(value)
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
    this.size = this.size + 1
    return true
  end

  def count(): Int
    return this.size
  end

  def each(visit: fn(T): Void): Void
    var current: ValueNode<T>? = this.first
    let initialCount = this.size
    var visited = 0

    while current != null && visited < initialCount
      visit(current.value)
      current = current.next
      visited = visited + 1
    end
  end
end
