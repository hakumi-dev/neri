use host
use tasks
use text
namespace buffers

class TextBuffer
  private bytes: ByteBuffer

  private def init(bytes: ByteBuffer): Void
    this.bytes = bytes
  end

  static def create(limit: Int, initialCapacity: Int = 16): TextBuffer?
    let bytes: ByteBuffer? = ByteBuffer.create(limit, initialCapacity)

    if bytes == null
      return null
    end
    return new TextBuffer(bytes)
  end

  def length(): Int
    return this.bytes.length()
  end

  def capacity(): Int
    return this.bytes.capacity()
  end

  def append(value: String): Bool
    return this.bytes.appendText(value)
  end

  def snapshot(): String?
    return this.bytes.text()
  end
end
