namespace test

@intrinsic("assertion.require")
def assert(value: Bool): Void
end

@intrinsic("assertion.true")
def assertTrue(value: Bool): Void
end

@intrinsic("assertion.false")
def assertFalse(value: Bool): Void
end

@exact
def assertEqual<T>(left: T, right: T): Void
  assert(left == right)
end
