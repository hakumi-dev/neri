namespace terminal

sealed class Key
  private tag: Int
  private text: String

  private def init(tag: Int, text: String = ""): Void
    this.tag = tag
    this.text = text
  end

  static def character(value: String): Key
    return new Key(0, value)
  end

  readonly def isCharacter(value: String): Bool
    return this.tag == 0 && this.text == value
  end

  readonly def characterText(): String?
    return this.text if this.tag == 0
    return null
  end

  readonly def same(other: readonly Key): Bool
    return this.tag == other.tag && this.text == other.text
  end

  static def up(): Key
    return new Key(1)
  end

  readonly def isUp(): Bool
    return this.tag == 1
  end

  static def down(): Key
    return new Key(2)
  end

  readonly def isDown(): Bool
    return this.tag == 2
  end

  static def right(): Key
    return new Key(3)
  end

  readonly def isRight(): Bool
    return this.tag == 3
  end

  static def left(): Key
    return new Key(4)
  end

  readonly def isLeft(): Bool
    return this.tag == 4
  end

  static def space(): Key
    return new Key(5)
  end

  readonly def isSpace(): Bool
    return this.tag == 5
  end

  static def enter(): Key
    return new Key(6)
  end

  readonly def isEnter(): Bool
    return this.tag == 6
  end

  static def backspace(): Key
    return new Key(7)
  end

  readonly def isBackspace(): Bool
    return this.tag == 7
  end

  static def escape(): Key
    return new Key(8)
  end

  readonly def isEscape(): Bool
    return this.tag == 8
  end

  static def unknown(): Key
    return new Key(9)
  end

  readonly def isUnknown(): Bool
    return this.tag == 9
  end

  static def closed(): Key
    return new Key(10)
  end

  readonly def isClosed(): Bool
    return this.tag == 10
  end
end
