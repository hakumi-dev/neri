@representation("utf8")
public class String
  @readonly
  def byteLength(): Int
    return core.stringByteLength(this)
  end

  @readonly
  def byteAt(offset: Int): Byte?
    if offset < 0 || offset >= this.byteLength()
      return null
    end
    return core.stringByteAt(this, offset)
  end

  @readonly
  def isScalarBoundary(offset: Int): Bool
    let length = this.byteLength()

    if offset < 0 || offset > length
      return false
    end
    if offset == length
      return true
    end
    let first = core.stringByteAt(this, offset) as Int

    return first < 128 || first >= 192
  end

  @readonly
  def sliceBytes(start: Int, length: Int): String?
    let total = this.byteLength()

    if start < 0 || length < 0 || start > total || length > total - start || !this.isScalarBoundary(start) || !this.isScalarBoundary(start + length)
      return null
    end
    return core.stringSlice(this, start, length)
  end

  def static fromBytes(value: Byte[]): String?
    return core.stringFromBytes(value)
  end

  @readonly
  def scalarCount(): Int
    let length = this.byteLength()
    var offset = 0
    var count = 0

    while offset < length
      offset = offset + core.scalarWidth(core.stringByteAt(this, offset) as Int)
      count = count + 1
    end
    return count
  end

  @readonly
  def scalarAt(index: Int): Int?
    if index < 0
      return null
    end
    let length = this.byteLength()
    var offset = 0
    var current = 0

    while offset < length
      let first = core.stringByteAt(this, offset) as Int

      if current == index
        if first < 128
          return first
        end
        let second = core.stringByteAt(this, offset + 1) as Int

        if first < 224
          return (first - 192) * 64 + second - 128
        end
        let third = core.stringByteAt(this, offset + 2) as Int

        if first < 240
          return (first - 224) * 4096 + (second - 128) * 64 + third - 128
        end
        let fourth = core.stringByteAt(this, offset + 3) as Int

        return (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
      end
      offset = offset + core.scalarWidth(first)
      current = current + 1
    end
    return null
  end

  @operator("+")
  @readonly
  def concat(other: String): String
    return core.stringConcat(this, other)
  end

  @operator("==")
  @readonly
  def equals(other: String): Bool
    return core.stringEqual(this, other)
  end

  @operator("!=")
  @readonly
  def notEquals(other: String): Bool
    return !core.stringEqual(this, other)
  end
end

namespace core

@intrinsic("string.concat")
def stringConcat(left: String, right: String): String
end

@intrinsic("string.equal")
def stringEqual(left: String, right: String): Bool
end

@intrinsic("string.byteLength")
def stringByteLength(value: String): Int
end

@intrinsic("string.byteAt")
def stringByteAt(value: String, offset: Int): Byte
end

@intrinsic("string.slice")
def stringSlice(value: String, start: Int, length: Int): String
end

@intrinsic("string.fromBytes")
def stringFromBytes(value: Byte[]): String?
end

def scalarWidth(first: Int): Int
  if first < 128
    return 1
  end
  if first < 224
    return 2
  end
  if first < 240
    return 3
  end
  return 4
end
