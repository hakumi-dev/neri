use result
namespace http

# Owns the process interrupt lease, optional fatal drain watcher, and Stop attachment.
resource class Lifetime
  private interruptToken: Int = 0
  private drainToken: Int = 0
  private stop: Stop?
  private attachment: Int = 0
  private requested: Bool = false
  private closed: Bool = false

  private def init(interruptToken: Int, drainToken: Int, stop: Stop?, attachment: Int): Void
    this.interruptToken = interruptToken
    this.drainToken = drainToken
    this.stop = stop
    this.attachment = attachment
  end

  public static def open(handleInterrupts: Bool = false, forceExitAfterStopMilliseconds: Int? = null, stop: Stop? = null): result::Result<Lifetime, result::Failure>
    if forceExitAfterStopMilliseconds != null && (forceExitAfterStopMilliseconds < 1 || forceExitAfterStopMilliseconds > 60000)
      return result::Result<Lifetime, result::Failure>.Error(new result::Failure("invalid_timeout", "listen.drain", "forceExitAfterStopMilliseconds must be 1..60000"))
    end
    var attachment = 0

    if stop != null
      attachment = stop.attachDrain(0)
      if attachment == 0
        return result::Result<Lifetime, result::Failure>.Error(new result::Failure("stop_unavailable", "listen.stop", "Stop is already attached to an active lifetime"))
      end
    end
    var interruptToken = 0

    if handleInterrupts
      unsafe
        interruptToken = interruptOpen()
      end
      if interruptToken == 0
        stop.detachDrain(attachment) if stop != null
        return result::Result<Lifetime, result::Failure>.Error(new result::Failure("interrupt_unavailable", "listen.interrupt", "Process interrupt handling is already owned or unavailable"))
      end
    end
    var drainToken = 0

    if forceExitAfterStopMilliseconds != null
      unsafe
        drainToken = drainOpen(forceExitAfterStopMilliseconds, interruptToken > 0 ? 1 : 0)
      end
      if drainToken == 0
        unsafe
          interruptClose(interruptToken) if interruptToken > 0
        end
        stop.detachDrain(attachment) if stop != null
        return result::Result<Lifetime, result::Failure>.Error(new result::Failure("drain_unavailable", "listen.drain", "Could not start the forced-exit deadline watcher"))
      end
      stop.setDrain(attachment, drainToken) if stop != null
    end
    let owned = new Lifetime(interruptToken, drainToken, stop, attachment)

    return result::Result<Lifetime, result::Failure>.Ok(transfer owned)
  end

  public def isStopping(): Bool
    if this.closed
      return false
    end
    if this.requested
      return true
    end
    let stop = this.stop

    if stop != null && stop.isRequested()
      return true
    end
    if this.interruptToken > 0
      unsafe
        return interruptPending(this.interruptToken) != 0
      end
    end
    return false
  end

  public def requestStop(): Void
    if this.closed
      return
    end
    this.requested = true
    let stop = this.stop

    if stop != null
      stop.request()
    else if this.drainToken > 0
      unsafe
        drainRequest(this.drainToken)
      end
    end
  end

  public def pollMilliseconds(): Int
    return this.interruptToken > 0 ? 50 : -1
  end

  public def close(): result::Failure?
    if this.closed
      return null
    end
    this.closed = true
    let stop = this.stop

    stop.detachDrain(this.attachment) if stop != null
    unsafe
      drainClose(this.drainToken) if this.drainToken > 0
      interruptClose(this.interruptToken) if this.interruptToken > 0
    end
    this.drainToken = 0
    this.interruptToken = 0
    this.attachment = 0
    this.stop = null
    return null
  end
end
