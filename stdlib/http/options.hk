use host
use result
use resources
namespace http

class Options
  public onListening: (fn(String): Void)?
  public log: (fn(String): Void)?
  public stop: Stop?
  public handleInterrupts: Bool = false
  # Opt-in fatal boundary: after stop is requested, allow the active request to
  # finish for this duration, then terminate the process with status 124.
  public forceExitAfterStopMilliseconds: Int?
  public onConnection: (fn(result::Result<Exchange, ExchangeFailure>): Void)?
end
