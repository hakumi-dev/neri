use host
use result
use resources
namespace http

class ExchangeFailure
  public cause: result.Failure
  public exchange: Exchange
  public responseFailure: result.Failure?
  public closeFailures: resources.CloseFailures = new resources.CloseFailures()

  def init(cause: result.Failure, exchange: Exchange): Void
    this.cause = cause
    this.exchange = exchange
  end
end
