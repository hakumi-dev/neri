use host
use result
use resources
namespace http

class Failure
  public code: String
  public operation: String
  public detail: String
  public closeFailures: resources::CloseFailures = new resources::CloseFailures()

  def init(code: String, operation: String, detail: String = ""): Void
    this.code = code
    this.operation = operation
    this.detail = detail
  end
end
