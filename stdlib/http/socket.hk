use host
use result
use resources
namespace http

# Socket owns one native descriptor. Its handle remains available only to
# unsafe implementation code; callers use the typed HTTP APIs.
resource class Socket
  private fd: Int
  private closed: Bool = false

  private def init(fd: Int): Void
    this.fd = fd
  end

  public static unsafe def own(fd: Int): result::Result<Socket, ExchangeFailure>
    if fd < 0
      return result::Result<Socket, ExchangeFailure>.Error(new ExchangeFailure(new result::Failure("socket_error", "socket.own", socketError()), new Exchange()))
    end
    let owned = new Socket(fd)

    return result::Result<Socket, ExchangeFailure>.Ok(transfer owned)
  end

  public static unsafe def ownListener(fd: Int): result::Result<Socket, result::Failure>
    if fd < 0
      return result::Result<Socket, result::Failure>.Error(new result::Failure("socket_error", "listen.open", socketError()))
    end
    let owned = new Socket(fd)

    return result::Result<Socket, result::Failure>.Ok(transfer owned)
  end

  public def close(): result::Failure?
    if this.closed
      return null
    end
    this.closed = true
    unsafe
      if netCloseResult(this.fd) < 0
        return new result::Failure("close_failed", "socket.close", socketError())
      end
    end
    return null
  end

  public unsafe def nativeHandle(): Int
    return this.fd
  end
end
