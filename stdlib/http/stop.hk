use host
use result
use resources
namespace http

# Requested synchronously from callbacks on the serving thread.
class Stop
  private requested: Bool = false
  private drainToken: Int = 0

  def request(): Void
    this.requested = true
    if this.drainToken > 0
      unsafe
        drainRequest(this.drainToken)
      end
    end
  end

  def isRequested(): Bool
    return this.requested
  end

  def attachDrain(token: Int): Void
    this.drainToken = token
    if this.requested && token > 0
      unsafe
        drainRequest(token)
      end
    end
  end

  def detachDrain(token: Int): Void
    this.drainToken = 0 if this.drainToken == token
  end
end
