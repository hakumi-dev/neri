use host
use result
use resources
namespace http

# Requested synchronously from callbacks on the serving thread.
class Stop
  private requested: Bool = false
  private drainToken: Int = 0
  private attachment: Int = 0
  private nextAttachment: Int = 0

  def request(): Void
    this.requested = true
    if this.drainToken > 0
      unsafe
        drainRequest(this.drainToken)
      end
    end
  end

  def isRequested(): Bool
    return this.requested
  end

  internal def attachDrain(token: Int): Int
    if this.attachment != 0
      return 0
    end
    if this.nextAttachment == 9223372036854775807
      return 0
    end
    this.nextAttachment = this.nextAttachment + 1
    this.attachment = this.nextAttachment
    this.drainToken = token
    if this.requested && token > 0
      unsafe
        drainRequest(token)
      end
    end
    return this.attachment
  end

  internal def detachDrain(attachment: Int): Void
    if attachment != 0 && this.attachment == attachment
      this.drainToken = 0
      this.attachment = 0
    end
  end

  internal def setDrain(attachment: Int, token: Int): Void
    if attachment != 0 && this.attachment == attachment
      this.drainToken = token
      if this.requested && token > 0
        unsafe
          drainRequest(token)
        end
      end
    end
  end
end
