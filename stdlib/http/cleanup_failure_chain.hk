use host
use result
use resources
namespace http

class CleanupFailureChain
  private tail: result.Failure

  def init(primary: result.Failure): Void
    this.tail = primary
  end

  def append(failure: result.Failure): Void
    var source: result.Failure? = failure

    while source != null
      let copied = new result.Failure(source.code, source.operation, source.detail, source.transferred, source.osCode, source.cause)

      this.tail.closeFailure = copied
      this.tail = copied
      source = source.closeFailure
    end
  end
end
