use arrays
use result
namespace http

# Reuses bounded managed storage across waits. Descriptors are borrowed for
# polling only; their owner must keep them open until wait returns.
class PollSet
  private descriptors: Int[]
  private interests: Int[]
  private events: Int[]
  private used: Int = 0

  private def init(capacity: Int): Void
    this.descriptors = arrays::generate<Int>(capacity) do |index|
      return 0
    end
    this.interests = arrays::generate<Int>(capacity) do |index|
      return 0
    end
    this.events = arrays::generate<Int>(capacity) do |index|
      return 0
    end
  end

  static def create(capacity: Int): PollSet?
    if capacity < 0 || capacity > 4096
      return null
    end
    return new PollSet(capacity)
  end

  def clear(): Void
    this.used = 0
  end

  def count(): Int
    return this.used
  end

  unsafe def add(descriptor: Int, read: Bool = true, write: Bool = false): Int?
    if descriptor < 0 || this.used == this.descriptors.Length
      return null
    end
    let index = this.used

    this.descriptors[index] = descriptor
    this.interests[index] = (read ? 1 : 0) + (write ? 2 : 0)
    this.events[index] = 0
    this.used = this.used + 1
    return index
  end

  unsafe def wait(milliseconds: Int): result::Result<Int, result::Failure>
    # No flags from an earlier wait survive a failure or a timeout.
    var index = 0

    while index < this.used
      this.events[index] = 0
      index = index + 1
    end
    if milliseconds < -1 || milliseconds > 60000
      return result::Result<Int, result::Failure>.Error(new result::Failure("invalid_timeout", "poll.wait"))
    end
    borrow this.descriptors as descriptors
      borrow this.interests as interests
        borrow this.events as events
          let ready = netPollMany(descriptors, interests, events, this.used, milliseconds)

          if ready < 0
            return result::Result<Int, result::Failure>.Error(new result::Failure("socket_error", "poll.wait", socketError()))
          end
          return result::Result<Int, result::Failure>.Ok(ready)
        end
      end
    end
  end

  def readable(index: Int): Bool
    return this.has(index, 1)
  end

  def writable(index: Int): Bool
    return this.has(index, 2)
  end

  def failed(index: Int): Bool
    return this.has(index, 4)
  end

  def hungUp(index: Int): Bool
    return this.has(index, 8)
  end

  def invalid(index: Int): Bool
    return this.has(index, 16)
  end

  private def has(index: Int, flag: Int): Bool
    if index < 0 || index >= this.used
      return false
    end
    let value = this.events[index] / flag

    return value - (value / 2) * 2 == 1
  end
end
