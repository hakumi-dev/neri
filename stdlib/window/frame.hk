use host
use draw
use input
use clock
namespace window

class Frame: draw.Canvas
  public input: input.State = new input.State()
  public width: Int = 0
  public height: Int = 0
  public timeMs: Int = 0
  public deltaMs: Int = 0
  private closing: Bool = false

  def init(token: Int): Void
    super(token)
  end
  def close(): Void
    this.closing = true
  end
  def isClosing(): Bool
    return this.closing
  end
end
