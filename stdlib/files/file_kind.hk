namespace files

sealed class FileKind
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def missing(): FileKind
    return new FileKind(0)
  end

  static def other(): FileKind
    return new FileKind(4)
  end

  static def fromNative(value: Int): FileKind?
    if value < 0 || value > 4
      return null
    end
    return new FileKind(value)
  end

  readonly def isMissing(): Bool
    return this.tag == 0
  end

  readonly def isFile(): Bool
    return this.tag == 1
  end

  readonly def isDirectory(): Bool
    return this.tag == 2
  end

  readonly def isSymlink(): Bool
    return this.tag == 3
  end

  readonly def isOther(): Bool
    return this.tag == 4
  end

  readonly def name(): String
    return "missing" if this.isMissing()
    return "file" if this.isFile()
    return "directory" if this.isDirectory()
    return "symlink" if this.isSymlink()
    return "other"
  end
end
