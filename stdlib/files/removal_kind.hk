namespace files

sealed class RemovalKind
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def file(): RemovalKind
    return new RemovalKind(1)
  end

  static def directory(): RemovalKind
    return new RemovalKind(2)
  end

  static def tree(): RemovalKind
    return new RemovalKind(3)
  end

  readonly def nativeCode(): Int
    return this.tag
  end

  readonly def operation(): String
    return "remove_file" if this.tag == 1
    return "remove_directory" if this.tag == 2
    return "remove_tree"
  end
end
