use host
namespace terminal

@cabi("neri_rt_v1_terminal_open")
def unsafe nativeOpen(): Int
end
@cabi("neri_rt_v1_terminal_close")
def unsafe nativeClose(token: Int): Void
end
@cabi("neri_rt_v1_terminal_read")
def unsafe nativeRead(token: Int, timeout: Int): Int
end
@cabi("neri_rt_v1_terminal_size")
def unsafe nativeSize(token: Int, rows: Int): Int
end

def escape(): String
  let value = host.stringFromBytes([27 as Byte])
  if value != null
    return value
  end
  return ""
end

class Session
  private token: Int = 0
  private pending: Int = -1

  def init(): Void
    if this.token == 0
      unsafe
        this.token = nativeOpen()
      end
    end
  end

  def isOpen(): Bool
    return this.token > 0
  end

  def close(): Void
    unsafe
      nativeClose(this.token)
    end
    this.token = 0
    this.pending = -1
  end

  def columns(): Int
    unsafe
      return nativeSize(this.token, 0)
    end
  end

  def rows(): Int
    unsafe
      return nativeSize(this.token, 1)
    end
  end

  def readKey(timeout: Int): String?
    if timeout < 0 || timeout > 60000
      this.close()
      return "closed"
    end
    unsafe
      var byte = this.pending
      this.pending = -1
      if byte < 0
        byte = nativeRead(this.token, timeout)
      end
      if byte == -1
        return null
      end
      if byte == -2
        this.close()
        return "closed"
      end
      if byte == 27
        let prefix = nativeRead(this.token, 20)
        if prefix == -2
          this.close()
          return "closed"
        end
        if prefix == 91 || prefix == 79
          let direction = nativeRead(this.token, 20)
          if direction == -2
            this.close()
            return "closed"
          end
          if direction == 65
            return "up"
          else if direction == 66
            return "down"
          else if direction == 67
            return "right"
          else if direction == 68
            return "left"
          end
        else
          this.pending = prefix
        end
        return "escape"
      end
      if byte == 32
        return "space"
      else if byte == 10 || byte == 13
        return "enter"
      else if byte == 127 || byte == 8
        return "backspace"
      end
      if byte >= 33 && byte <= 126
        return host.stringFromBytes([byte as Byte])
      end
      return "unknown"
    end
  end
end

def open(): Session?
  let session = new Session()
  if !session.isOpen()
    return null
  end
  return session
end
