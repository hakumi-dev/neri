use host
namespace terminal

@cabiImport("neri_rt_v1_terminal_open")
unsafe def nativeOpen(): Int
end
@cabiImport("neri_rt_v1_terminal_close")
unsafe def nativeClose(token: Int): Void
end
@cabiImport("neri_rt_v1_terminal_read")
unsafe def nativeRead(token: Int, timeout: Int): Int
end
@cabiImport("neri_rt_v1_terminal_size")
unsafe def nativeSize(token: Int, rows: Int): Int
end

def escape(): String
  let value = host::stringFromBytes([27 as Byte])

  if value != null
    return value
  end
  return ""
end

class Session
  private token: Int = 0
  private pending: Int = -1

  def init(): Void
    if this.token == 0
      unsafe
        this.token = nativeOpen()
      end
    end
  end

  def isOpen(): Bool
    return this.token > 0
  end

  def close(): Void
    unsafe
      nativeClose(this.token)
    end
    this.token = 0
    this.pending = -1
  end

  def columns(): Int
    unsafe
      return nativeSize(this.token, 0)
    end
  end

  def rows(): Int
    unsafe
      return nativeSize(this.token, 1)
    end
  end

  def readKey(timeout: Int): Key?
    if timeout < 0 || timeout > 60000
      this.close()
      return Key.closed()
    end
    unsafe
      var byte = this.pending

      this.pending = -1
      if byte < 0
        byte = nativeRead(this.token, timeout)
      end
      if byte == -1
        return null
      end
      if byte == -2
        this.close()
        return Key.closed()
      end
      if byte == 27
        let prefix = nativeRead(this.token, 20)

        if prefix == -2
          this.close()
          return Key.closed()
        end
        if prefix == 91 || prefix == 79
          let direction = nativeRead(this.token, 20)

          if direction == -2
            this.close()
            return Key.closed()
          end
          if direction == 65
            return Key.up()
          else if direction == 66
            return Key.down()
          else if direction == 67
            return Key.right()
          else if direction == 68
            return Key.left()
          end
        else
          this.pending = prefix
        end
        return Key.escape()
      end
      if byte == 32
        return Key.space()
      else if byte == 10 || byte == 13
        return Key.enter()
      else if byte == 127 || byte == 8
        return Key.backspace()
      end
      if byte >= 33 && byte <= 126
        let text = host::stringFromBytes([byte as Byte])

        if text != null
          return Key.character(text)
        end
        return Key.unknown()
      end
      return Key.unknown()
    end
  end
end

def open(): Session?
  let session = new Session()

  if !session.isOpen()
    return null
  end
  return session
end
