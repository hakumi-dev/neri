namespace quotation

public enum NodeKind
  case Parameter()
  case Capture()
  case Member()
  case IntLiteral()
  case BoolLiteral()
  case TextLiteral()
  case NullLiteral()
  case Equal()
  case NotEqual()
  case Less()
  case LessEqual()
  case Greater()
  case GreaterEqual()
  case And()
  case Or()
  case Not()
  case Negate()
end

public enum CaptureValue
  case Bool(value: Bool)
  case Int(value: Int)
  case Text(value: String)
  case Null()
end

def captureBool(value: Bool?): CaptureValue
  if value != null
    return CaptureValue.Bool(value)
  end
  return CaptureValue.Null()
end

def captureInt(value: Int?): CaptureValue
  if value != null
    return CaptureValue.Int(value)
  end
  return CaptureValue.Null()
end

def captureText(value: String?): CaptureValue
  if value != null
    return CaptureValue.Text(value)
  end
  return CaptureValue.Null()
end

public class Node
  private nodeKind: NodeKind
  private staticType: String
  private firstChild: Int
  private secondChild: Int
  private slotIndex: Int
  private symbolIdentity: String
  private storedInt: Int
  private storedBool: Bool
  private storedText: String

  def init(kind: NodeKind, typeName: String, first: Int = -1, second: Int = -1, index: Int = -1, identity: String = "", intValue: Int = 0, boolValue: Bool = false, textValue: String = ""): Void
    this.nodeKind = kind
    this.staticType = typeName
    this.firstChild = first
    this.secondChild = second
    this.slotIndex = index
    this.symbolIdentity = identity
    this.storedInt = intValue
    this.storedBool = boolValue
    this.storedText = textValue
  end

  public readonly def kind(): readonly NodeKind
    return this.nodeKind
  end

  public readonly def typeName(): String
    return this.staticType
  end

  public readonly def first(): Int
    return this.firstChild
  end

  public readonly def second(): Int
    return this.secondChild
  end

  public readonly def index(): Int
    return this.slotIndex
  end

  public readonly def identity(): String
    return this.symbolIdentity
  end

  public readonly def intValue(): Int
    return this.storedInt
  end

  public readonly def boolValue(): Bool
    return this.storedBool
  end

  public readonly def textValue(): String
    return this.storedText
  end
end

public class Tree
  private nodes: Node[]
  private captures: CaptureValue[]
  private rootNode: Int
  private parameters: String[]
  private result: String

  def init(nodes: Node[], captures: CaptureValue[], root: Int, parameterTypes: String[], resultType: String): Void
    this.nodes = nodes
    this.captures = captures
    this.rootNode = root
    this.parameters = parameterTypes
    this.result = resultType
  end

  public readonly def count(): Int
    return this.nodes.Length
  end

  public readonly def root(): Int
    return this.rootNode
  end

  public readonly def resultType(): String
    return this.result
  end

  public readonly def parameterCount(): Int
    return this.parameters.Length
  end

  public readonly def parameterTypeAt(index: Int): String?
    if index < 0 || index >= this.parameters.Length
      return null
    end
    return this.parameters[index]
  end

  public readonly def nodeAt(index: Int): readonly Node?
    if index < 0 || index >= this.nodes.Length
      return null
    end
    return this.nodes[index]
  end

  public readonly def captureCount(): Int
    return this.captures.Length
  end

  public readonly def captureAt(index: Int): readonly CaptureValue?
    if index < 0 || index >= this.captures.Length
      return null
    end
    return this.captures[index]
  end
end
