namespace quotation

def captureBool(value: Bool?): CaptureValue
  if value != null
    return CaptureValue.Bool(value)
  end
  return CaptureValue.Null()
end

def captureInt(value: Int?): CaptureValue
  if value != null
    return CaptureValue.Int(value)
  end
  return CaptureValue.Null()
end

def captureFloat(value: Float?): CaptureValue
  if value != null
    return CaptureValue.Float(value)
  end
  return CaptureValue.Null()
end

def captureText(value: String?): CaptureValue
  if value != null
    return CaptureValue.Text(value)
  end
  return CaptureValue.Null()
end
