use buffers
use host
use tasks
use result
namespace crypto

@cabiImport("neri_rt_v1_crypto_sha256")
unsafe def nativeSha256(input: Byte*, length: Int, digest: Byte*): Int
end

@cabiImport("neri_rt_v1_crypto_random")
unsafe def nativeRandom(output: Byte*, length: Int): Int
end

def sha256(input: Byte[]): BytesResult
  let output: Byte[] = tasks.generate(32, 1) do |index|
    return 0 as Byte
  end

  unsafe
    borrow input as pointer
      borrow output as digest
        if nativeSha256(pointer, input.Length, digest) != 0
          return BytesResult.failed("digest_failed")
        end
      end
    end
  end
  return BytesResult.success(output)
end

def randomBytes(count: Int): BytesResult
  return EntropySource.system().bytes(count)
end

def systemRandomBytes(count: Int): BytesResult
  if count < 0 || count > 256
    return BytesResult.failed("invalid_length")
  end
  let output: Byte[] = tasks.generate(count, 1) do |index|
    return 0 as Byte
  end

  unsafe
    borrow output as pointer
      if nativeRandom(pointer, count) != 0
        return BytesResult.failed("entropy_failed")
      end
    end
  end
  return BytesResult.success(output)
end

def encodeHex(input: Byte[]): String?
  if input.Length > 67108864
    return null
  end
  let outputLength = input.Length * 2
  let output = buffers.ByteBuffer.create(outputLength, outputLength)

  if output == null
    return null
  end
  var index = 0

  while index < input.Length
    let value = input[index] as Int

    if !output.append(hexDigit(value / 16)) || !output.append(hexDigit(value - (value / 16) * 16))
      return null
    end
    index = index + 1
  end
  return output.text()
end

def decodeHex(text: String, limit: Int = 4096): BytesResult
  if limit < 0 || limit > 134217728
    return BytesResult.failed("invalid_limit")
  end
  let length = host.stringByteLength(text)

  if length - (length / 2) * 2 != 0
    return BytesResult.failed("invalid_hex")
  end
  if length / 2 > limit
    return BytesResult.failed("limit_exceeded")
  end
  let output = buffers.ByteBuffer.create(length / 2, length / 2)

  if output == null
    return BytesResult.failed("invalid_limit")
  end
  var index = 0

  while index < length
    let high = hexValue(host.stringByteAt(text, index) as Int)
    let low = hexValue(host.stringByteAt(text, index + 1) as Int)

    if high < 0 || low < 0
      return BytesResult.failed("invalid_hex")
    end
    if !output.append((high * 16 + low) as Byte)
      return BytesResult.failed("limit_exceeded")
    end
    index = index + 2
  end
  return BytesResult.success(output.snapshot())
end

def hexDigit(value: Int): Byte
  if value < 10
    return (48 + value) as Byte
  end
  return (87 + value) as Byte
end

def hexValue(value: Int): Int
  if value >= 48 && value <= 57
    return value - 48
  end
  if value >= 65 && value <= 70
    return value - 55
  end
  if value >= 97 && value <= 102
    return value - 87
  end
  return -1
end

def sha256Outcome(input: Byte[]): result.Result<Byte[], result.Failure>
  let value = crypto.sha256(input)
  let bytes = value.bytes()
  let failure = value.failure()

  if failure != null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure(failure.code(), "crypto.sha256"))
  end
  if bytes == null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure("missing_digest", "crypto.sha256"))
  end
  return result.Result<Byte[], result.Failure>.Ok(bytes)
end

def decodeHexOutcome(text: String, limit: Int = 4096): result.Result<Byte[], result.Failure>
  let value = crypto.decodeHex(text, limit)
  let bytes = value.bytes()
  let failure = value.failure()

  if failure != null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure(failure.code(), "crypto.decode_hex"))
  end
  if bytes == null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure("missing_bytes", "crypto.decode_hex"))
  end
  return result.Result<Byte[], result.Failure>.Ok(bytes)
end

def randomBytesOutcome(count: Int): result.Result<Byte[], result.Failure>
  let value = crypto.randomBytes(count)
  let bytes = value.bytes()
  let failure = value.failure()

  if failure != null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure(failure.code(), "crypto.random_bytes"))
  end
  if bytes == null
    return result.Result<Byte[], result.Failure>.Error(new result.Failure("missing_bytes", "crypto.random_bytes"))
  end
  return result.Result<Byte[], result.Failure>.Ok(bytes)
end
