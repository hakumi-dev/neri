namespace quotation

public enum NodeKind
  case Parameter()
  case Capture()
  case Member()
  case IntLiteral()
  case BoolLiteral()
  case TextLiteral()
  case NullLiteral()
  case Equal()
  case NotEqual()
  case Less()
  case LessEqual()
  case Greater()
  case GreaterEqual()
  case And()
  case Or()
  case Not()
  case Negate()
end
