namespace quotation

public class Tree
  private nodes: Node[]
  private captures: CaptureValue[]
  private rootNode: Int
  private parameters: String[]
  private result: String

  def init(nodes: Node[], captures: CaptureValue[], root: Int, parameterTypes: String[], resultType: String): Void
    this.nodes = nodes
    this.captures = captures
    this.rootNode = root
    this.parameters = parameterTypes
    this.result = resultType
  end

  public readonly def count(): Int
    return this.nodes.Length
  end

  public readonly def root(): Int
    return this.rootNode
  end

  public readonly def resultType(): String
    return this.result
  end

  public readonly def parameterCount(): Int
    return this.parameters.Length
  end

  public readonly def parameterTypeAt(index: Int): String?
    if index < 0 || index >= this.parameters.Length
      return null
    end
    return this.parameters[index]
  end

  public readonly def nodeAt(index: Int): readonly Node?
    if index < 0 || index >= this.nodes.Length
      return null
    end
    return this.nodes[index]
  end

  public readonly def captureCount(): Int
    return this.captures.Length
  end

  public readonly def captureAt(index: Int): readonly CaptureValue?
    if index < 0 || index >= this.captures.Length
      return null
    end
    return this.captures[index]
  end
end
