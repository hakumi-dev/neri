use buffers
use host
use result
use tasks
namespace process

class Failure
  private value: String
  public osCode: Int
  public operation: String
  private def init(code: String, osCode: Int = 0, operation: String = ""): Void
    this.value = code
    this.osCode = osCode
    this.operation = operation
  end
  static def fromCode(code: String, osCode: Int = 0, operation: String = ""): Failure
    return new Failure(code, osCode, operation)
  end
  def code(): String
    return this.value
  end
end
