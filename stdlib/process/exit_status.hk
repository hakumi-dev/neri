use buffers
use host
use result
use tasks
namespace process

sealed class ExitStatus
  private tag: Int
  private code: Int

  private def init(tag: Int, code: Int): Void
    this.tag = tag
    this.code = code
  end

  static def fromNative(kind: Int, value: Int): ExitStatus?
    if kind < 1 || kind > 3
      return null
    end
    return new ExitStatus(kind, value)
  end

  readonly def isExited(): Bool
    return this.tag == 1
  end

  readonly def isSignaled(): Bool
    return this.tag == 2
  end

  readonly def isCancelled(): Bool
    return this.tag == 3
  end

  readonly def value(): Int
    return this.code
  end

  readonly def name(): String
    return "exit" if this.isExited()
    return "signal" if this.isSignaled()
    return "cancelled"
  end
end
