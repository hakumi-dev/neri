use buffers
use host
use result
use tasks
namespace process

class SpawnResult
  private value: Child?
  private problem: Failure?
  private def init(value: Child?, problem: Failure?): Void
    this.value = value
    this.problem = problem
  end
  static def success(value: Child): SpawnResult
    return new SpawnResult(value, null)
  end
  static def failed(code: String, osCode: Int = 0, operation: String = ""): SpawnResult
    return new SpawnResult(null, Failure.fromCode(code, osCode, operation))
  end
  def child(): Child?
    return this.value
  end
  def failure(): Failure?
    return this.problem
  end
end
