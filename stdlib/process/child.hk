use buffers
use host
use result
use tasks
namespace process

class Child
  private token: Int
  private disposed: Bool = false

  private def init(token: Int): Void
    this.token = token
  end

  static def start(config: Byte[]): SpawnResult
    unsafe
      let token = stackalloc Int[1]
      let osCode = stackalloc Int[1]

      borrow config as pointer
        if nativeSpawn(pointer, config.Length, token, osCode) != 0
          return SpawnResult.failed("spawn_failed", osCode[0], "process.spawn")
        end
      end
      return SpawnResult.success(new Child(token[0]))
    end
  end

  def poll(): PollResult
    return this.wait(0)
  end

  def wait(milliseconds: Int): PollResult
    let result = new PollResult()

    if this.disposed
      result.failure = Failure.fromCode("disposed", 0, "process.poll")
      return result
    end
    if milliseconds < 0 || milliseconds > 60000
      result.failure = Failure.fromCode("invalid_timeout", 0, "process.poll")
      return result
    end
    unsafe
      let state = stackalloc Int[7]
      let osCode = stackalloc Int[1]

      if nativePoll(this.token, milliseconds, state, osCode) != 0
        result.failure = Failure.fromCode("poll_failed", osCode[0], "process.poll")
        return result
      end
      result.running = state[0] == 0
      if !result.running
        var kind = "exit"

        kind = "signal" if state[1] == 2
        kind = "cancelled" if state[1] == 3
        result.exit = new ExitStatus(kind, state[2])
      end
      result.stdout = this.readChannel(1, state[3])
      result.stderr = this.readChannel(2, state[4])
      if result.stdout.Length != state[3] || result.stderr.Length != state[4]
        result.failure = Failure.fromCode("read_failed", 0, "process.read")
        return result
      end
      result.stdoutTruncated = state[5] != 0
      result.stderrTruncated = state[6] != 0
    end
    return result
  end

  def cancel(): Bool
    if this.disposed
      return true
    end
    unsafe
      let osCode = stackalloc Int[1]

      return nativeCancel(this.token, osCode) == 0
    end
  end

  def interrupt(): Bool
    if this.disposed
      return false
    end
    unsafe
      let osCode = stackalloc Int[1]

      return nativeInterrupt(this.token, osCode) == 0
    end
  end

  def dispose(): Bool
    if this.disposed
      return true
    end
    unsafe
      let osCode = stackalloc Int[1]

      if nativeDispose(this.token, osCode) != 0
        return false
      end
    end
    this.disposed = true
    return true
  end

  def cancelOutcome(): result.Result<Bool, result.Failure>
    if this.disposed
      return result.Result<Bool, result.Failure>.Ok(true)
    end
    unsafe
      let osCode = stackalloc Int[1]

      if nativeCancel(this.token, osCode) != 0
        return result.Result<Bool, result.Failure>.Error(new result.Failure("cancel_failed", "process.cancel", "", 0, osCode[0]))
      end
    end
    return result.Result<Bool, result.Failure>.Ok(true)
  end

  def interruptOutcome(): result.Result<Bool, result.Failure>
    if this.disposed
      return result.Result<Bool, result.Failure>.Error(new result.Failure("disposed", "process.interrupt"))
    end
    unsafe
      let osCode = stackalloc Int[1]

      if nativeInterrupt(this.token, osCode) != 0
        return result.Result<Bool, result.Failure>.Error(new result.Failure("interrupt_failed", "process.interrupt", "", 0, osCode[0]))
      end
    end
    return result.Result<Bool, result.Failure>.Ok(true)
  end

  def disposeOutcome(): result.Result<Bool, result.Failure>
    if this.disposed
      return result.Result<Bool, result.Failure>.Ok(true)
    end
    unsafe
      let osCode = stackalloc Int[1]

      if nativeDispose(this.token, osCode) != 0
        return result.Result<Bool, result.Failure>.Error(new result.Failure("dispose_failed", "process.dispose", "", 0, osCode[0]))
      end
    end
    this.disposed = true
    return result.Result<Bool, result.Failure>.Ok(true)
  end

  private def readChannel(channel: Int, length: Int): Byte[]
    if length == 0
      return []
    end
    let output: Byte[] = tasks.generate(length, 1) do |index|
      return 0 as Byte
    end

    unsafe
      let count = stackalloc Int[1]

      borrow output as pointer
        if nativeRead(this.token, channel, 0, pointer, length, count) != 0 || count[0] != length
          return []
        end
      end
    end
    return output
  end
end
