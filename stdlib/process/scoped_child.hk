use buffers
use host
use result
use tasks
namespace process

resource class ScopedChild
  private child: Child

  private def init(child: Child): Void
    this.child = child
  end

  static def spawn(options: SpawnOptions): result.Result<ScopedChild, result.Failure>
    let started = process.spawn(options)
    let failure = started.failure()

    if failure != null
      return result.Result<ScopedChild, result.Failure>.Error(asResultFailure(failure, "process.spawn"))
    end
    let child = started.child()

    if child == null
      return result.Result<ScopedChild, result.Failure>.Error(new result.Failure("missing_child", "process.spawn"))
    end
    let owned = new ScopedChild(child)

    return result.Result<ScopedChild, result.Failure>.Ok(transfer owned)
  end

  def close(): result.Failure?
    match this.child.disposeOutcome()
      case result.Result.Ok(disposed)
        return null
      case result.Result.Error(failure)
        return failure
    end
  end

  def poll(): PollResult
    return this.child.poll()
  end

  def wait(milliseconds: Int): PollResult
    return this.child.wait(milliseconds)
  end

  def cancel(): result.Result<Bool, result.Failure>
    return this.child.cancelOutcome()
  end

  def interrupt(): result.Result<Bool, result.Failure>
    return this.child.interruptOutcome()
  end
end
