use host
namespace draw

@cabi("neri_rt_v1_window_color")
def unsafe nativeColor(token: Int, red: Int, green: Int, blue: Int, alpha: Int): Bool
end
@cabi("neri_rt_v1_window_clear")
def unsafe nativeClear(token: Int): Bool
end
@cabi("neri_rt_v1_window_rect")
def unsafe nativeRect(token: Int, x: Float, y: Float, width: Float, height: Float): Bool
end
@cabi("neri_rt_v1_window_line")
def unsafe nativeLine(token: Int, x1: Float, y1: Float, x2: Float, y2: Float): Bool
end
@cabi("neri_rt_v1_window_text")
def unsafe nativeText(token: Int, x: Float, y: Float, text: Byte*): Bool
end

class Color
  public red: Int = 0
  public green: Int = 0
  public blue: Int = 0
  public alpha: Int = 255

  def init(red: Int, green: Int, blue: Int, alpha: Int = 255): Void
    this.red = red
    this.green = green
    this.blue = blue
    this.alpha = alpha
  end

  def static black(): Color
    return new Color(0, 0, 0)
  end
  def static white(): Color
    return new Color(255, 255, 255)
  end
end

# A null result rejects embedded NUL and oversized strings before borrowing.
def cString(text: String): Byte[]?
  let length = host.stringByteLength(text)
  if length > 4096
    return null
  end
  var bytes: Byte[] = []
  var index = 0
  while index < length
    let byte = host.stringByteAt(text, index)
    if byte == (0 as Byte)
      return null
    end
    bytes = host.appendByte(bytes, byte)
    index = index + 1
  end
  return host.appendByte(bytes, 0 as Byte)
end

class Canvas
  private token: Int = 0
  public failed: Bool = false

  def init(token: Int): Void
    this.token = token
  end

  def color(color: Color): Bool
    if this.failed
      return false
    end
    unsafe
      this.failed = !nativeColor(this.token, color.red, color.green, color.blue, color.alpha)
    end
    return !this.failed
  end

  def clear(color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeClear(this.token)
      end
    end
  end

  def fillRect(x: Float, y: Float, width: Float, height: Float, color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeRect(this.token, x, y, width, height)
      end
    end
  end

  def line(x1: Float, y1: Float, x2: Float, y2: Float, color: Color): Void
    if this.color(color)
      unsafe
        this.failed = !nativeLine(this.token, x1, y1, x2, y2)
      end
    end
  end

  def text(x: Float, y: Float, text: String, color: Color): Void
    if !this.color(color)
      return
    end
    let bytes = cString(text)
    if bytes == null
      this.failed = true
      return
    end
    unsafe
      borrow bytes as pointer
        this.failed = !nativeText(this.token, x, y, pointer)
      end
    end
  end
end
