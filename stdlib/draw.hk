use host
namespace draw

@cabiImport("neri_rt_v1_window_color")
unsafe def nativeColor(token: Int, red: Int, green: Int, blue: Int, alpha: Int): Bool
end
@cabiImport("neri_rt_v1_window_clear")
unsafe def nativeClear(token: Int): Bool
end
@cabiImport("neri_rt_v1_window_rect")
unsafe def nativeRect(token: Int, x: Float, y: Float, width: Float, height: Float): Bool
end
@cabiImport("neri_rt_v1_window_line")
unsafe def nativeLine(token: Int, x1: Float, y1: Float, x2: Float, y2: Float): Bool
end
@cabiImport("neri_rt_v1_window_text")
unsafe def nativeText(token: Int, x: Float, y: Float, text: Byte*): Bool
end

# A null result rejects embedded NUL and oversized strings before borrowing.
def cString(text: String): Byte[]?
  let length = host.stringByteLength(text)

  if length > 4096
    return null
  end
  var bytes: Byte[] = []
  var index = 0

  while index < length
    let byte = host.stringByteAt(text, index)

    if byte == (0 as Byte)
      return null
    end
    bytes = host.appendByte(bytes, byte)
    index = index + 1
  end
  return host.appendByte(bytes, 0 as Byte)
end
