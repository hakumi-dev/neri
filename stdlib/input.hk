use host
namespace input

class Key
  private value: Int = -1
  def init(value: Int): Void
    this.value = value
  end
  def code(): Int
    return this.value
  end
  def static letter(value: String): Key
    if host.stringByteLength(value) == 1
      let byte = host.stringByteAt(value, 0) as Int
      if byte >= 65 && byte <= 90
        return new Key(byte - 65)
      else if byte >= 97 && byte <= 122
        return new Key(byte - 97)
      end
    end
    return new Key(-1)
  end
  def static up(): Key
    return new Key(26)
  end
  def static down(): Key
    return new Key(27)
  end
  def static left(): Key
    return new Key(28)
  end
  def static right(): Key
    return new Key(29)
  end
  def static space(): Key
    return new Key(30)
  end
  def static escape(): Key
    return new Key(31)
  end
  def static enter(): Key
    return new Key(32)
  end
  def static mouseLeft(): Key
    return new Key(33)
  end
  def static mouseMiddle(): Key
    return new Key(34)
  end
  def static mouseRight(): Key
    return new Key(35)
  end
end

class State
  private held: Int[] = []
  private pressedKeys: Int[] = []
  private releasedKeys: Int[] = []
  public mouseX: Float = 0.0
  public mouseY: Float = 0.0

  def contains(values: Int[], code: Int): Bool
    for value in values
      return true if value == code
    end
    return false
  end

  def down(key: Key): Bool
    return this.contains(this.held, key.code())
  end
  def pressed(key: Key): Bool
    return this.contains(this.pressedKeys, key.code())
  end
  def released(key: Key): Bool
    return this.contains(this.releasedKeys, key.code())
  end

  def beginFrame(): Void
    this.pressedKeys = []
    this.releasedKeys = []
  end

  def apply(event: Int): Void
    if event == 2
      for code in this.held
        this.releasedKeys = host.appendInt(this.releasedKeys, code)
      end
      this.held = []
    else if event >= 100 && event < 136
      let code = event - 100
      if !this.contains(this.held, code)
        this.held = host.appendInt(this.held, code)
        this.pressedKeys = host.appendInt(this.pressedKeys, code)
      end
    else if event >= 200 && event < 236
      let code = event - 200
      if this.contains(this.held, code)
        this.releasedKeys = host.appendInt(this.releasedKeys, code)
        var remaining: Int[] = []
        for value in this.held
          remaining = host.appendInt(remaining, value) if value != code
        end
        this.held = remaining
      end
    end
  end
end
