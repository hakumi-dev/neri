use quotation
namespace fields

public class Entry
  private storedIdentity: String
  private storedTypeName: String
  private storedValue: quotation::CaptureValue

  def init(identity: String, typeName: String, value: quotation::CaptureValue): Void
    this.storedIdentity = identity
    this.storedTypeName = typeName
    this.storedValue = value
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def typeName(): String
    return this.storedTypeName
  end

  public readonly def value(): readonly quotation::CaptureValue
    return this.storedValue
  end
end
