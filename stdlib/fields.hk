use quotation

namespace fields

public class Entry
  private storedIdentity: String
  private storedTypeName: String
  private storedValue: quotation.CaptureValue

  def init(identity: String, typeName: String, value: quotation.CaptureValue): Void
    this.storedIdentity = identity
    this.storedTypeName = typeName
    this.storedValue = value
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def typeName(): String
    return this.storedTypeName
  end

  public readonly def value(): readonly quotation.CaptureValue
    return this.storedValue
  end
end

public class Pack
  private entries: Entry[]
  private storedEntityType: String

  def init(entries: Entry[], entityType: String): Void
    this.entries = entries
    this.storedEntityType = entityType
  end

  public readonly def count(): Int
    return this.entries.Length
  end

  public readonly def entryAt(index: Int): readonly Entry?
    if index < 0 || index >= this.entries.Length
      return null
    end
    return this.entries[index]
  end

  public readonly def entityType(): String
    return this.storedEntityType
  end
end
