namespace workers

public class Ticket
  private owner: Int
  private value: UInt64

  private def init(owner: Int, value: UInt64): Void
    this.owner = owner
    this.value = value
  end

  public def id(): UInt64
    return this.value
  end

  # Raw owner identities are native capabilities. Construction stays unsafe.
  public static unsafe def createOwned(owner: Int, value: UInt64): Ticket
    return new Ticket(owner, value)
  end

  internal def belongsTo(handle: Int): Bool
    return this.owner == handle
  end
end
