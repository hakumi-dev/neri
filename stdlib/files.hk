use host
use tasks
use result
namespace files

class Failure
  public code: String
  public osCode: Int
  public operation: String
  public component: Int
  public closeFailure: Failure?

  def init(code: String, osCode: Int = 0, operation: String = "", component: Int = -1): Void
    this.code = code
    this.osCode = osCode
    this.operation = operation
    this.component = component
  end
end

class RootOpenResult
  public root: Root?
  public failure: Failure?
end

class ReadResult
  public bytes: Byte[]?
  public failure: Failure?
  public closeFailure: Failure?
  public bytesRead: Int = 0
end

class DirectoryEntry
  public name: String
  public kind: String
  def init(name: String, kind: String): Void
    this.name = name
    this.kind = kind
  end
end

class ListResult
  public entries: DirectoryEntry[] = []
  public failure: Failure?
  public closeFailure: Failure?
end

class OperationResult
  public failure: Failure?
end

class Status
  public exists: Bool = false
  public kind: String = "missing"
  public executable: Bool = false
  public symlink: Bool = false
end

class StatusResult
  public status: Status?
  public failure: Failure?
end


@cabi("neri_rt_v1_file_open")
unsafe def openFile(path: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_file_size")
unsafe def fileSize(fd: Int): Int
end
@cabi("neri_rt_v1_file_read")
unsafe def readFile(fd: Int, bytes: Byte*, length: Int): Int
end
@cabi("neri_rt_v1_file_close")
unsafe def closeFile(fd: Int): Int
end
@cabi("neri_rt_v1_file_error")
unsafe def fileError(): Int
end
@cabi("neri_rt_v1_file_root_open")
unsafe def rootOpen(path: Byte*, length: Int, osCode: Int*, category: Int*): Int
end
@cabi("neri_rt_v1_file_root_open_at")
unsafe def rootOpenAt(parent: Int, name: Byte*, length: Int, kind: Int, osCode: Int*, category: Int*): Int
end
@cabi("neri_rt_v1_file_directory_open")
unsafe def directoryOpen(parent: Int, token: Int*, osCode: Int*, closeCode: Int*): Int
end
@cabi("neri_rt_v1_file_directory_next")
unsafe def directoryNext(token: Int, name: Byte*, capacity: Int, length: Int*, kind: Int*, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_directory_close")
unsafe def directoryClose(token: Int, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_temp_directory")
unsafe def nativeTemporaryDirectory(prefix: Byte*, prefixLength: Int, output: Byte*, capacity: Int, outputLength: Int*, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_mkdir")
unsafe def nativeCreateDirectory(path: Byte*, length: Int, parents: Int, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_rename")
unsafe def nativeMove(source: Byte*, sourceLength: Int, destination: Byte*, destinationLength: Int, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_remove")
unsafe def nativeRemove(path: Byte*, length: Int, kind: Int, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_status")
unsafe def nativeStatus(path: Byte*, length: Int, exists: Int*, kind: Int*, executable: Int*, symlink: Int*, osCode: Int*): Int
end
@cabi("neri_rt_v1_file_mutation_copy")
unsafe def nativeCopy(source: Byte*, sourceLength: Int, destination: Byte*, destinationLength: Int, osCode: Int*): Int
end

def rootedFailure(category: Int, osCode: Int, operation: String, component: Int): Failure
  var code = "open_failed"

  code = "component_missing" if category == 1
  code = "component_denied" if category == 2
  code = "symlink_disallowed" if category == 3
  code = "wrong_type" if category == 4
  code = "unavailable" if category == 6
  return new Failure(code, osCode, operation, component)
end

resource class ScopedRoot
  private root: Root

  private def init(root: Root): Void
    this.root = root
  end

  static def open(path: String): result.Result<ScopedRoot, result.Failure>
    let opened = Root.open(path)
    let failure = opened.failure

    if failure != null
      return result.Result<ScopedRoot, result.Failure>.Error(asReadFailure(failure, 0, "root.open"))
    end
    let root = opened.root

    if root == null
      return result.Result<ScopedRoot, result.Failure>.Error(new result.Failure("missing_root", "root.open"))
    end
    let owned = new ScopedRoot(root)

    return result.Result<ScopedRoot, result.Failure>.Ok(transfer owned)
  end

  def close(): result.Failure?
    let failure = this.root.close()

    if failure != null
      return asReadFailure(failure, 0, "root.close")
    end
    return null
  end

  def isClosed(): Bool
    return this.root.isClosed()
  end

  def readBytes(path: String, limit: Int): ReadResult
    return this.root.readBytes(path, limit)
  end

  def readBytesOutcome(path: String, limit: Int): result.Result<Byte[], ReadFailure>
    return this.root.readBytesOutcome(path, limit)
  end

  def list(path: String = "", limit: Int = 4096): ListResult
    return this.root.list(path, limit)
  end
end

class Root
  private fd: Int
  private closed: Bool = false

  private def init(fd: Int): Void
    this.fd = fd
  end

  static def open(path: String): RootOpenResult
    let result = new RootOpenResult()
    let length = host.stringByteLength(path)

    if length == 0 || length > 1048576 || host.stringByteAt(path, 0) != (47 as Byte) || (length > 1 && host.stringByteAt(path, length - 1) == (47 as Byte))
      result.failure = new Failure("invalid_root", 0, "root.open")
      return result
    end
    var index = 0

    while index < length
      if host.stringByteAt(path, index) == (0 as Byte)
        result.failure = new Failure("invalid_root", 0, "root.open")
        return result
      end
      index = index + 1
    end
    unsafe
      let osCode = stackalloc Int[1]
      let category = stackalloc Int[1]
      let bytes = native.alloc<Byte>(length)

      index = 0
      while index < length
        bytes[index] = host.stringByteAt(path, index)
        index = index + 1
      end
      let fd = rootOpen(bytes, length, osCode, category)

      native.free(bytes)
      if fd < 0
        let failure = rootedFailure(category[0], osCode[0], "root.open", -1)

        failure.code = "root_not_directory" if category[0] == 4
        failure.code = "root_open_failed" if category[0] == 1 || category[0] == 2 || category[0] == 5
        result.failure = failure
      else
        result.root = new Root(fd)
      end
    end
    return result
  end

  def isClosed(): Bool
    return this.closed
  end

  def close(): Failure?
    if this.closed
      return null
    end
    this.closed = true
    unsafe
      if closeFile(this.fd) < 0
        return new Failure("close_failed", fileError(), "root.close")
      end
    end
    return null
  end

  def readBytes(path: String, limit: Int): ReadResult
    let result = new ReadResult()

    if this.closed
      result.failure = new Failure("closed", 0, "root.read")
      return result
    end
    if limit < 0 || limit > 134217728
      result.failure = new Failure("invalid_limit", 0, "root.read")
      return result
    end
    let length = host.stringByteLength(path)

    if !validRelativePath(path)
      result.failure = new Failure("invalid_path", 0, "root.read")
      return result
    end
    var start = 0
    var component = 0
    var parent = this.fd
    var ownsParent = false

    while start < length
      var endAt = start

      while endAt < length && host.stringByteAt(path, endAt) != (47 as Byte)
        let byte = host.stringByteAt(path, endAt)

        if byte == (0 as Byte) || byte == (92 as Byte)
          result.failure = new Failure("invalid_path", 0, "root.read", component)
          closeIntermediate(parent, ownsParent, result)
          return result
        end
        endAt = endAt + 1
      end
      let name = host.stringSlice(path, start, endAt - start)

      if name == "" || name == "." || name == ".."
        result.failure = new Failure("invalid_path", 0, "root.read", component)
        closeIntermediate(parent, ownsParent, result)
        return result
      end
      let final = endAt == length

      unsafe
        let osCode = stackalloc Int[1]
        let category = stackalloc Int[1]
        let nameLength = host.stringByteLength(name)
        let bytes = native.alloc<Byte>(nameLength)
        var nameIndex = 0

        while nameIndex < nameLength
          bytes[nameIndex] = host.stringByteAt(name, nameIndex)
          nameIndex = nameIndex + 1
        end
        let opened = rootOpenAt(parent, bytes, host.stringByteLength(name), final ? 2 : 1, osCode, category)

        native.free(bytes)
        if opened < 0
          result.failure = rootedFailure(category[0], osCode[0], final ? "root.open_file" : "root.open_directory", component)
          closeIntermediate(parent, ownsParent, result)
          return result
        end
        if !closeIntermediate(parent, ownsParent, result)
          closeIntermediate(opened, true, result)
          return result
        end
        parent = opened
        ownsParent = true
      end
      start = endAt + 1
      component = component + 1
    end
    readOpened(parent, limit, result)
    let failure = result.failure

    if failure != null
      failure.component = component - 1
      failure.operation = "root." + failure.operation
    end
    closeIntermediate(parent, true, result)
    return result
  end

  def readBytesOutcome(path: String, limit: Int): result.Result<Byte[], ReadFailure>
    return readOutcome(this.readBytes(path, limit))
  end

  def list(path: String, limit: Int = 4096): ListResult
    let result = new ListResult()

    if this.closed
      result.failure = new Failure("closed", 0, "root.list")
      return result
    end
    if limit < 0 || limit > 4096 || (path != "" && !validRelativePath(path))
      result.failure = new Failure(path == "" || validRelativePath(path) ? "invalid_limit" : "invalid_path", 0, "root.list")
      return result
    end
    var parent = this.fd
    var ownsParent = false
    var component = 0
    var start = 0
    let pathLength = host.stringByteLength(path)

    while start < pathLength
      var endAt = start

      while endAt < pathLength && host.stringByteAt(path, endAt) != (47 as Byte)
        endAt = endAt + 1
      end
      let name = host.stringSlice(path, start, endAt - start)

      unsafe
        let osCode = stackalloc Int[1]
        let category = stackalloc Int[1]
        let nameLength = host.stringByteLength(name)
        let bytes = native.alloc<Byte>(nameLength)
        var index = 0

        while index < nameLength
          bytes[index] = host.stringByteAt(name, index)
          index = index + 1
        end
        let opened = rootOpenAt(parent, bytes, nameLength, 1, osCode, category)

        native.free(bytes)
        if opened < 0
          result.failure = rootedFailure(category[0], osCode[0], "root.list.open_directory", component)
          closeListParent(parent, ownsParent, result)
          return result
        end
        if !closeListParent(parent, ownsParent, result)
          closeListParent(opened, true, result)
          return result
        end
        parent = opened
        ownsParent = true
      end
      start = endAt + 1
      component = component + 1
    end
    unsafe
      let token = stackalloc Int[1]
      let osCode = stackalloc Int[1]
      let closeCode = stackalloc Int[1]
      let opened = directoryOpen(parent, token, osCode, closeCode)

      if opened != 0
        result.failure = new Failure(opened == -2 ? "unavailable" : "list_failed", osCode[0], "root.list.open", component)
        if closeCode[0] != 0
          result.closeFailure = new Failure("close_failed", closeCode[0], "root.list.close", component)
        end
        closeListParent(parent, ownsParent, result)
        return result
      end
      let entries: DirectoryEntry[] = tasks.generate(limit, 1) do |index|
        return new DirectoryEntry("", "other")
      end
      var count = 0
      let buffer: Byte[] = tasks.generate(4096, 1) do |index|
        return 0 as Byte
      end
      var done = false

        while !done
          let length = stackalloc Int[1]
          let kind = stackalloc Int[1]
          var status = 0

          borrow buffer as pointer
            status = directoryNext(token[0], pointer, buffer.Length, length, kind, osCode)
          end
          if status == 1
            done = true
          else if status != 0
            result.failure = new Failure("list_failed", osCode[0], "root.list.next", component)
            done = true
          else if count == limit
            result.failure = new Failure("limit_exceeded", 0, "root.list", component)
            done = true
          else
            let nameBytes: Byte[] = tasks.generate(length[0], 1) do |index|
              return buffer[index]
            end
            let text = host.stringFromBytes(nameBytes)

            if text == null
              result.failure = new Failure("invalid_name", 0, "root.list.next", component)
              done = true
            else
              var kindName = "other"

              kindName = "file" if kind[0] == 1
              kindName = "directory" if kind[0] == 2
              kindName = "symlink" if kind[0] == 3
              entries[count] = new DirectoryEntry(text, kindName)
              count = count + 1
            end
          end
        end
      if directoryClose(token[0], osCode) != 0
        result.closeFailure = new Failure("close_failed", osCode[0], "root.list.close", component)
      end
      closeListParent(parent, ownsParent, result)
      if result.failure == null && result.closeFailure == null
        result.entries = tasks.generate(count, 1) do |index|
          return new DirectoryEntry(entries[index].name, entries[index].kind)
        end
      end
    end
    return result
  end
end

def closeListParent(fd: Int, owned: Bool, result: ListResult): Bool
  if !owned
    return true
  end
  unsafe
    if closeFile(fd) < 0
      let failure = new Failure("close_failed", fileError(), "root.list.close_component")

      if result.closeFailure == null
        result.closeFailure = failure
      else
        var cursor = result.closeFailure

        while cursor != null
          let next = cursor.closeFailure

          if next == null
            cursor.closeFailure = failure
            cursor = null
          else
            cursor = next
          end
        end
      end
      return false
    end
  end
  return true
end

def validRelativePath(path: String): Bool
  let length = host.stringByteLength(path)

  if length == 0 || length > 1048576 || host.stringByteAt(path, 0) == (47 as Byte) || host.stringByteAt(path, length - 1) == (47 as Byte)
    return false
  end
  var start = 0
  var index = 0

  while index <= length
    if index == length || host.stringByteAt(path, index) == (47 as Byte)
      let component = host.stringSlice(path, start, index - start)

      if component == "" || component == "." || component == ".."
        return false
      end
      start = index + 1
    else
      let byte = host.stringByteAt(path, index)

      if byte == (0 as Byte) || byte == (92 as Byte) || byte == (58 as Byte)
        return false
      end
    end
    index = index + 1
  end
  return true
end

def closeIntermediate(fd: Int, owned: Bool, result: ReadResult): Bool
  if !owned
    return true
  end
  unsafe
    if closeFile(fd) < 0
      let failure = new Failure("close_failed", fileError(), "root.close_component")
      let previous = result.closeFailure

      if previous == null
        result.closeFailure = failure
      else
        var cursor: Failure = previous

        while true
          let next = cursor.closeFailure

          if next == null
            cursor.closeFailure = failure
            break
          end
          cursor = next
        end
      end
      result.bytes = null
      return false
    end
  end
  return true
end

def readBytes(path: String, limit: Int): ReadResult
  let result = new ReadResult()

  if limit < 0 || limit > 134217728
    result.failure = new Failure("invalid_limit", 0, "files.read")
    return result
  end
  let pathLength = host.stringByteLength(path)

  if pathLength == 0 || pathLength > 1048576
    result.failure = new Failure("invalid_path", 0, "files.read")
    return result
  end
  var index = 0

  while index < pathLength
    if host.stringByteAt(path, index) == (0 as Byte)
      result.failure = new Failure("invalid_path", 0, "files.read")
      return result
    end
    index = index + 1
  end
  unsafe
    let pathBytes = native.alloc<Byte>(pathLength)

    index = 0
    while index < pathLength
      pathBytes[index] = host.stringByteAt(path, index)
      index = index + 1
    end
    let fd = openFile(pathBytes, pathLength)
    let openError = fileError()

    native.free(pathBytes)
    if fd < 0
      result.failure = new Failure("open_failed", openError, "open")
      return result
    end
    readOpened(fd, limit, result)
    if closeFile(fd) < 0
      result.closeFailure = new Failure("close_failed", fileError(), "close")
      result.bytes = null
    end
  end
  return result
end

def readOpened(fd: Int, limit: Int, result: ReadResult): Void
  unsafe
  let size = fileSize(fd)

  if size == -2
    result.failure = new Failure("not_regular", 0, "metadata")
    return
  end
  if size < 0
    result.failure = new Failure("metadata_failed", fileError(), "metadata")
    return
  end
  if size > limit
    result.failure = new Failure("limit_exceeded", 0, "metadata")
    return
  end
  # Indexed generation allocates one managed array in linear time.
  let bytes: Byte[] = tasks.generate(size, 1) do |index|
    return 0 as Byte
  end
  var offset = 0

  borrow bytes as pointer
    while offset < size
      let count = readFile(fd, pointer + offset, size - offset)

      if count == -1
        result.failure = new Failure("read_failed", fileError(), "read")
        return
      end
      if count == 0
        result.failure = new Failure("changed_size", 0, "read")
        return
      end
      if count > 0
        offset = offset + count
        result.bytesRead = offset
      end
    end
  end
  let extra = stackalloc Byte[1]
  var count = readFile(fd, extra, 1)

  while count == -2
    count = readFile(fd, extra, 1)
  end
  if count < 0
    result.failure = new Failure("read_failed", fileError(), "read")
  else if count > 0
    result.bytesRead = result.bytesRead + count
    result.failure = new Failure("changed_size", 0, "read")
  else
    result.bytes = bytes
  end
  end
end

class ReadFailure
  public cause: result.Failure
  public component: Int
  public closeFailure: result.Failure?

  def init(cause: result.Failure, component: Int = -1, closeFailure: result.Failure? = null): Void
    this.cause = cause
    this.component = component
    this.closeFailure = closeFailure
  end
end

def asReadFailure(source: Failure, bytesRead: Int, fallbackOperation: String): result.Failure
  var operation = source.operation

  operation = fallbackOperation if operation == ""
  let failure = new result.Failure(source.code, operation, "", bytesRead, source.osCode)
  let closed = source.closeFailure

  if closed != null
    failure.closeFailure = asReadFailure(closed, bytesRead, "files.close")
  end
  return failure
end

def readOutcome(read: ReadResult): result.Result<Byte[], ReadFailure>
  let primary = read.failure
  let closed = read.closeFailure
  let bytes = read.bytes

  if primary != null
    var closeCause: result.Failure? = null

    if closed != null
      closeCause = asReadFailure(closed, read.bytesRead, "files.close")
    end
    let cause = asReadFailure(primary, read.bytesRead, "files.read")

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause, primary.component, closeCause))
  end
  if closed != null
    let cause = asReadFailure(closed, read.bytesRead, "files.close")

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause, closed.component))
  end
  if bytes == null
    let cause = new result.Failure("missing_bytes", "files.read", "", read.bytesRead)

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause))
  end
  return result.Result<Byte[], ReadFailure>.Ok(bytes)
end

def readBytesOutcome(path: String, limit: Int): result.Result<Byte[], ReadFailure>
  return readOutcome(files.readBytes(path, limit))
end

resource class TemporaryDirectory
  private value: String
  private closed: Bool = false

  private def init(path: String): Void
    this.value = path
  end

  static def create(prefix: String = "neri-"): result.Result<TemporaryDirectory, result.Failure>
    if !validTemporaryPrefix(prefix)
      return result.Result<TemporaryDirectory, result.Failure>.Error(new result.Failure("invalid_prefix", "temporary_directory"))
    end
    let prefixLength = host.stringByteLength(prefix)
    let output: Byte[] = tasks.generate(32768, 1) do |index|
      return 0 as Byte
    end

    unsafe
      let prefixBytes = native.alloc<Byte>(prefixLength)
      var index = 0

      while index < prefixLength
        prefixBytes[index] = host.stringByteAt(prefix, index)
        index = index + 1
      end
      let outputLength = stackalloc Int[1]
      let osCode = stackalloc Int[1]
      var status = 0

      borrow output as outputBytes
        status = nativeTemporaryDirectory(prefixBytes, prefixLength, outputBytes, output.Length, outputLength, osCode)
      end
      native.free(prefixBytes)
      if status != 0
        return result.Result<TemporaryDirectory, result.Failure>.Error(new result.Failure("temporary_directory_failed", "temporary_directory", "", 0, osCode[0]))
      end
      if outputLength[0] <= 0 || outputLength[0] > output.Length
        return result.Result<TemporaryDirectory, result.Failure>.Error(new result.Failure("temporary_directory_failed", "temporary_directory"))
      end
      let pathBytes: Byte[] = tasks.generate(outputLength[0], 1) do |index|
        return output[index]
      end
      let text = host.stringFromBytes(pathBytes)

      if text == null
        let cleanupCode = stackalloc Int[1]

        borrow output as outputBytes
          nativeRemove(outputBytes, outputLength[0], 3, cleanupCode)
        end
        return result.Result<TemporaryDirectory, result.Failure>.Error(new result.Failure("invalid_path", "temporary_directory"))
      end
      let directory = new TemporaryDirectory(text)

      return result.Result<TemporaryDirectory, result.Failure>.Ok(transfer directory)
    end
  end

  def path(): String
    return this.value
  end

  def close(): result.Failure?
    if this.closed
      return null
    end
    this.closed = true
    let removed = removeTree(this.value)
    let failure = removed.failure

    if failure != null
      return asResultFailure(failure)
    end
    return null
  end

  def isClosed(): Bool
    return this.closed
  end
end

def createDirectory(path: String, parents: Bool = false): OperationResult
  let result = new OperationResult()
  let length = validNativePath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, "create_directory")
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let osCode = stackalloc Int[1]
    let status = nativeCreateDirectory(bytes, length, parents ? 1 : 0, osCode)

    native.free(bytes)
    if status != 0
      result.failure = new Failure("create_directory_failed", osCode[0], "create_directory")
    end
  end
  return result
end

def move(source: String, destination: String): OperationResult
  let result = new OperationResult()
  let sourceLength = validNativePath(source)
  let destinationLength = validNativePath(destination)

  if sourceLength < 0 || destinationLength < 0
    result.failure = new Failure("invalid_path", 0, "move")
    return result
  end
  unsafe
    let sourceBytes = native.alloc<Byte>(sourceLength)
    let destinationBytes = native.alloc<Byte>(destinationLength)

    copyStringBytes(source, sourceBytes, sourceLength)
    copyStringBytes(destination, destinationBytes, destinationLength)
    let osCode = stackalloc Int[1]
    let status = nativeMove(sourceBytes, sourceLength, destinationBytes, destinationLength, osCode)

    native.free(sourceBytes)
    native.free(destinationBytes)
    if status != 0
      result.failure = new Failure("move_failed", osCode[0], "move")
    end
  end
  return result
end

def removeFile(path: String): OperationResult
  return removePath(path, 1, "remove_file")
end

def removeDirectory(path: String): OperationResult
  return removePath(path, 2, "remove_directory")
end

def removeTree(path: String): OperationResult
  return removePath(path, 3, "remove_tree")
end

def copyFile(source: String, destination: String): OperationResult
  let result = new OperationResult()
  let sourceLength = validNativePath(source)
  let destinationLength = validNativePath(destination)

  if sourceLength < 0 || destinationLength < 0
    result.failure = new Failure("invalid_path", 0, "copy_file")
    return result
  end
  unsafe
    let sourceBytes = native.alloc<Byte>(sourceLength)
    let destinationBytes = native.alloc<Byte>(destinationLength)

    copyStringBytes(source, sourceBytes, sourceLength)
    copyStringBytes(destination, destinationBytes, destinationLength)
    let osCode = stackalloc Int[1]
    let status = nativeCopy(sourceBytes, sourceLength, destinationBytes, destinationLength, osCode)

    native.free(sourceBytes)
    native.free(destinationBytes)
    if status != 0
      result.failure = new Failure("copy_file_failed", osCode[0], "copy_file")
    end
  end
  return result
end

def status(path: String): StatusResult
  let result = new StatusResult()
  let length = validNativePath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, "status")
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let exists = stackalloc Int[1]
    let kind = stackalloc Int[1]
    let executable = stackalloc Int[1]
    let symlink = stackalloc Int[1]
    let osCode = stackalloc Int[1]
    let nativeResult = nativeStatus(bytes, length, exists, kind, executable, symlink, osCode)

    native.free(bytes)
    if nativeResult != 0
      result.failure = new Failure("status_failed", osCode[0], "status")
      return result
    end
    let value = new Status()

    value.exists = exists[0] != 0
    value.executable = executable[0] != 0
    value.symlink = symlink[0] != 0
    value.kind = "file" if kind[0] == 1
    value.kind = "directory" if kind[0] == 2
    value.kind = "symlink" if kind[0] == 3
    value.kind = "other" if kind[0] == 4
    result.status = value
  end
  return result
end

def removePath(path: String, kind: Int, operation: String): OperationResult
  let result = new OperationResult()
  let length = validRemovalPath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, operation)
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let osCode = stackalloc Int[1]
    let nativeResult = nativeRemove(bytes, length, kind, osCode)

    native.free(bytes)
    if nativeResult != 0
      result.failure = new Failure(operation + "_failed", osCode[0], operation)
    end
  end
  return result
end

def validRemovalPath(path: String): Int
  let length = validNativePath(path)

  if length < 0 || host.stringByteAt(path, length - 1) == (47 as Byte) || host.stringByteAt(path, length - 1) == (92 as Byte)
    return -1
  end
  var start = length - 1

  while start > 0 && host.stringByteAt(path, start - 1) != (47 as Byte) && host.stringByteAt(path, start - 1) != (92 as Byte)
    start = start - 1
  end
  let component = host.stringSlice(path, start, length - start)

  return component == "." || component == ".." ? -1 : length
end

def validNativePath(path: String): Int
  let length = host.stringByteLength(path)

  if length == 0 || length > 1048576
    return -1
  end
  var index = 0

  while index < length
    if host.stringByteAt(path, index) == (0 as Byte)
      return -1
    end
    index = index + 1
  end
  return length
end

def validTemporaryPrefix(prefix: String): Bool
  let length = validNativePath(prefix)

  if length < 0
    return false
  end
  var index = 0

  while index < length
    let byte = host.stringByteAt(prefix, index)

    if byte == (47 as Byte) || byte == (92 as Byte)
      return false
    end
    index = index + 1
  end
  return true
end

unsafe def copyStringBytes(text: String, output: Byte*, length: Int): Void
  var index = 0

  while index < length
    output[index] = host.stringByteAt(text, index)
    index = index + 1
  end
end

def asResultFailure(failure: Failure): result.Failure
  return new result.Failure(failure.code, failure.operation, "", 0, failure.osCode)
end
