use host
use tasks
use result
namespace files

@cabiImport("neri_rt_v1_file_open")
unsafe def openFile(path: Byte*, length: Int): Int
end
@cabiImport("neri_rt_v1_file_size")
unsafe def fileSize(fd: Int): Int
end
@cabiImport("neri_rt_v1_file_read")
unsafe def readFile(fd: Int, bytes: Byte*, length: Int): Int
end
@cabiImport("neri_rt_v1_file_close")
unsafe def closeFile(fd: Int): Int
end
@cabiImport("neri_rt_v1_file_error")
unsafe def fileError(): Int
end
@cabiImport("neri_rt_v1_file_root_open")
unsafe def rootOpen(path: Byte*, length: Int, osCode: Int*, category: Int*): Int
end
@cabiImport("neri_rt_v1_file_root_open_at")
unsafe def rootOpenAt(parent: Int, name: Byte*, length: Int, kind: Int, osCode: Int*, category: Int*): Int
end
@cabiImport("neri_rt_v1_file_directory_open")
unsafe def directoryOpen(parent: Int, token: Int*, osCode: Int*, closeCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_directory_next")
unsafe def directoryNext(token: Int, name: Byte*, capacity: Int, length: Int*, kind: Int*, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_directory_close")
unsafe def directoryClose(token: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_temp_directory")
unsafe def nativeTemporaryDirectory(prefix: Byte*, prefixLength: Int, output: Byte*, capacity: Int, outputLength: Int*, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_mkdir")
unsafe def nativeCreateDirectory(path: Byte*, length: Int, parents: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_rename")
unsafe def nativeMove(source: Byte*, sourceLength: Int, destination: Byte*, destinationLength: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_remove")
unsafe def nativeRemove(path: Byte*, length: Int, kind: Int, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_status")
unsafe def nativeStatus(path: Byte*, length: Int, exists: Int*, kind: Int*, executable: Int*, symlink: Int*, osCode: Int*): Int
end
@cabiImport("neri_rt_v1_file_mutation_copy")
unsafe def nativeCopy(source: Byte*, sourceLength: Int, destination: Byte*, destinationLength: Int, osCode: Int*): Int
end

def rootedFailure(category: Int, osCode: Int, operation: String, component: Int): Failure
  var code = "open_failed"

  code = "component_missing" if category == 1
  code = "component_denied" if category == 2
  code = "symlink_disallowed" if category == 3
  code = "wrong_type" if category == 4
  code = "unavailable" if category == 6
  return new Failure(code, osCode, operation, component)
end

def closeListParent(fd: Int, owned: Bool, result: ListResult): Bool
  if !owned
    return true
  end
  unsafe
    if closeFile(fd) < 0
      let failure = new Failure("close_failed", fileError(), "root.list.close_component")

      if result.closeFailure == null
        result.closeFailure = failure
      else
        var cursor = result.closeFailure

        while cursor != null
          let next = cursor.closeFailure

          if next == null
            cursor.closeFailure = failure
            cursor = null
          else
            cursor = next
          end
        end
      end
      return false
    end
  end
  return true
end

def validRelativePath(path: String): Bool
  let length = host.stringByteLength(path)

  if length == 0 || length > 1048576 || host.stringByteAt(path, 0) == (47 as Byte) || host.stringByteAt(path, length - 1) == (47 as Byte)
    return false
  end
  var start = 0
  var index = 0

  while index <= length
    if index == length || host.stringByteAt(path, index) == (47 as Byte)
      let component = host.stringSlice(path, start, index - start)

      if component == "" || component == "." || component == ".."
        return false
      end
      start = index + 1
    else
      let byte = host.stringByteAt(path, index)

      if byte == (0 as Byte) || byte == (92 as Byte) || byte == (58 as Byte)
        return false
      end
    end
    index = index + 1
  end
  return true
end

def closeIntermediate(fd: Int, owned: Bool, result: ReadResult): Bool
  if !owned
    return true
  end
  unsafe
    if closeFile(fd) < 0
      let failure = new Failure("close_failed", fileError(), "root.close_component")
      let previous = result.closeFailure

      if previous == null
        result.closeFailure = failure
      else
        var cursor: Failure = previous

        while true
          let next = cursor.closeFailure

          if next == null
            cursor.closeFailure = failure
            break
          end
          cursor = next
        end
      end
      result.bytes = null
      return false
    end
  end
  return true
end

def readBytes(path: String, limit: Int): ReadResult
  let result = new ReadResult()

  if limit < 0 || limit > 134217728
    result.failure = new Failure("invalid_limit", 0, "files.read")
    return result
  end
  let pathLength = host.stringByteLength(path)

  if pathLength == 0 || pathLength > 1048576
    result.failure = new Failure("invalid_path", 0, "files.read")
    return result
  end
  var index = 0

  while index < pathLength
    if host.stringByteAt(path, index) == (0 as Byte)
      result.failure = new Failure("invalid_path", 0, "files.read")
      return result
    end
    index = index + 1
  end
  unsafe
    let pathBytes = native.alloc<Byte>(pathLength)

    index = 0
    while index < pathLength
      pathBytes[index] = host.stringByteAt(path, index)
      index = index + 1
    end
    let fd = openFile(pathBytes, pathLength)
    let openError = fileError()

    native.free(pathBytes)
    if fd < 0
      result.failure = new Failure("open_failed", openError, "open")
      return result
    end
    readOpened(fd, limit, result)
    if closeFile(fd) < 0
      result.closeFailure = new Failure("close_failed", fileError(), "close")
      result.bytes = null
    end
  end
  return result
end

def readOpened(fd: Int, limit: Int, result: ReadResult): Void
  unsafe
    let size = fileSize(fd)

    if size == -2
      result.failure = new Failure("not_regular", 0, "metadata")
      return
    end
    if size < 0
      result.failure = new Failure("metadata_failed", fileError(), "metadata")
      return
    end
    if size > limit
      result.failure = new Failure("limit_exceeded", 0, "metadata")
      return
    end
    # Indexed generation allocates one managed array in linear time.
    let bytes: Byte[] = tasks.generate(size, 1) do |index|
      return 0 as Byte
    end
    var offset = 0

    borrow bytes as pointer
      while offset < size
        let count = readFile(fd, pointer + offset, size - offset)

        if count == -1
          result.failure = new Failure("read_failed", fileError(), "read")
          return
        end
        if count == 0
          result.failure = new Failure("changed_size", 0, "read")
          return
        end
        if count > 0
          offset = offset + count
          result.bytesRead = offset
        end
      end
    end
    let extra = stackalloc Byte[1]
    var count = readFile(fd, extra, 1)

    while count == -2
      count = readFile(fd, extra, 1)
    end
    if count < 0
      result.failure = new Failure("read_failed", fileError(), "read")
    else if count > 0
      result.bytesRead = result.bytesRead + count
      result.failure = new Failure("changed_size", 0, "read")
    else
      result.bytes = bytes
    end
  end
end

def asReadFailure(source: Failure, bytesRead: Int, fallbackOperation: String): result.Failure
  var operation = source.operation

  operation = fallbackOperation if operation == ""
  let failure = new result.Failure(source.code, operation, "", bytesRead, source.osCode)
  let closed = source.closeFailure

  if closed != null
    failure.closeFailure = asReadFailure(closed, bytesRead, "files.close")
  end
  return failure
end

def readOutcome(read: ReadResult): result.Result<Byte[], ReadFailure>
  let primary = read.failure
  let closed = read.closeFailure
  let bytes = read.bytes

  if primary != null
    var closeCause: result.Failure? = null

    if closed != null
      closeCause = asReadFailure(closed, read.bytesRead, "files.close")
    end
    let cause = asReadFailure(primary, read.bytesRead, "files.read")

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause, primary.component, closeCause))
  end
  if closed != null
    let cause = asReadFailure(closed, read.bytesRead, "files.close")

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause, closed.component))
  end
  if bytes == null
    let cause = new result.Failure("missing_bytes", "files.read", "", read.bytesRead)

    return result.Result<Byte[], ReadFailure>.Error(new ReadFailure(cause))
  end
  return result.Result<Byte[], ReadFailure>.Ok(bytes)
end

def readBytesOutcome(path: String, limit: Int): result.Result<Byte[], ReadFailure>
  return readOutcome(files.readBytes(path, limit))
end

def createDirectory(path: String, parents: Bool = false): OperationResult
  let result = new OperationResult()
  let length = validNativePath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, "create_directory")
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let osCode = stackalloc Int[1]
    let status = nativeCreateDirectory(bytes, length, parents ? 1 : 0, osCode)

    native.free(bytes)
    if status != 0
      result.failure = new Failure("create_directory_failed", osCode[0], "create_directory")
    end
  end
  return result
end

def move(source: String, destination: String): OperationResult
  let result = new OperationResult()
  let sourceLength = validNativePath(source)
  let destinationLength = validNativePath(destination)

  if sourceLength < 0 || destinationLength < 0
    result.failure = new Failure("invalid_path", 0, "move")
    return result
  end
  unsafe
    let sourceBytes = native.alloc<Byte>(sourceLength)
    let destinationBytes = native.alloc<Byte>(destinationLength)

    copyStringBytes(source, sourceBytes, sourceLength)
    copyStringBytes(destination, destinationBytes, destinationLength)
    let osCode = stackalloc Int[1]
    let status = nativeMove(sourceBytes, sourceLength, destinationBytes, destinationLength, osCode)

    native.free(sourceBytes)
    native.free(destinationBytes)
    if status != 0
      result.failure = new Failure("move_failed", osCode[0], "move")
    end
  end
  return result
end

def removeFile(path: String): OperationResult
  return removePath(path, RemovalKind.file())
end

def removeDirectory(path: String): OperationResult
  return removePath(path, RemovalKind.directory())
end

def removeTree(path: String): OperationResult
  return removePath(path, RemovalKind.tree())
end

def copyFile(source: String, destination: String): OperationResult
  let result = new OperationResult()
  let sourceLength = validNativePath(source)
  let destinationLength = validNativePath(destination)

  if sourceLength < 0 || destinationLength < 0
    result.failure = new Failure("invalid_path", 0, "copy_file")
    return result
  end
  unsafe
    let sourceBytes = native.alloc<Byte>(sourceLength)
    let destinationBytes = native.alloc<Byte>(destinationLength)

    copyStringBytes(source, sourceBytes, sourceLength)
    copyStringBytes(destination, destinationBytes, destinationLength)
    let osCode = stackalloc Int[1]
    let status = nativeCopy(sourceBytes, sourceLength, destinationBytes, destinationLength, osCode)

    native.free(sourceBytes)
    native.free(destinationBytes)
    if status != 0
      result.failure = new Failure("copy_file_failed", osCode[0], "copy_file")
    end
  end
  return result
end

def status(path: String): StatusResult
  let result = new StatusResult()
  let length = validNativePath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, "status")
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let exists = stackalloc Int[1]
    let kind = stackalloc Int[1]
    let executable = stackalloc Int[1]
    let symlink = stackalloc Int[1]
    let osCode = stackalloc Int[1]
    let nativeResult = nativeStatus(bytes, length, exists, kind, executable, symlink, osCode)

    native.free(bytes)
    if nativeResult != 0
      result.failure = new Failure("status_failed", osCode[0], "status")
      return result
    end
    let fileKind = FileKind.fromNative(kind[0])

    if fileKind == null
      result.failure = new Failure("status_failed", 0, "status")
      return result
    end
    let value = new Status()

    value.exists = exists[0] != 0
    value.executable = executable[0] != 0
    value.symlink = symlink[0] != 0
    value.kind = fileKind
    result.status = value
  end
  return result
end

def removePath(path: String, kind: readonly RemovalKind): OperationResult
  let result = new OperationResult()
  let operation = kind.operation()
  let length = validRemovalPath(path)

  if length < 0
    result.failure = new Failure("invalid_path", 0, operation)
    return result
  end
  unsafe
    let bytes = native.alloc<Byte>(length)

    copyStringBytes(path, bytes, length)
    let osCode = stackalloc Int[1]
    let nativeResult = nativeRemove(bytes, length, kind.nativeCode(), osCode)

    native.free(bytes)
    if nativeResult != 0
      result.failure = new Failure(operation + "_failed", osCode[0], operation)
    end
  end
  return result
end

def validRemovalPath(path: String): Int
  let length = validNativePath(path)

  if length < 0 || host.stringByteAt(path, length - 1) == (47 as Byte) || host.stringByteAt(path, length - 1) == (92 as Byte)
    return -1
  end
  var start = length - 1

  while start > 0 && host.stringByteAt(path, start - 1) != (47 as Byte) && host.stringByteAt(path, start - 1) != (92 as Byte)
    start = start - 1
  end
  let component = host.stringSlice(path, start, length - start)

  return component == "." || component == ".." ? -1 : length
end

def validNativePath(path: String): Int
  let length = host.stringByteLength(path)

  if length == 0 || length > 1048576
    return -1
  end
  var index = 0

  while index < length
    if host.stringByteAt(path, index) == (0 as Byte)
      return -1
    end
    index = index + 1
  end
  return length
end

def validTemporaryPrefix(prefix: String): Bool
  let length = validNativePath(prefix)

  if length < 0
    return false
  end
  var index = 0

  while index < length
    let byte = host.stringByteAt(prefix, index)

    if byte == (47 as Byte) || byte == (92 as Byte)
      return false
    end
    index = index + 1
  end
  return true
end

unsafe def copyStringBytes(text: String, output: Byte*, length: Int): Void
  var index = 0

  while index < length
    output[index] = host.stringByteAt(text, index)
    index = index + 1
  end
end

def asResultFailure(failure: Failure): result.Failure
  return new result.Failure(failure.code, failure.operation, "", 0, failure.osCode)
end
