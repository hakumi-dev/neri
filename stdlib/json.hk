use buffers
use result
use text
namespace json

def parse(input: String, options: Options? = null): result::Result<Value, Failure>
  let limits = options == null ? new Options() : options

  if !validOptions(limits)
    return result::Result<Value, Failure>.Error(new Failure("invalid_options"))
  end
  if input.byteLength() > limits.maxInputBytes
    return result::Result<Value, Failure>.Error(new Failure("input_limit"))
  end
  return new Parser(input, limits.maxDepth, limits.maxNodes).parse()
end

def parseBytes(input: Byte[], options: Options? = null): result::Result<Value, Failure>
  let limits = options == null ? new Options() : options

  if !validOptions(limits)
    return result::Result<Value, Failure>.Error(new Failure("invalid_options"))
  end
  if input.Length > limits.maxInputBytes
    return result::Result<Value, Failure>.Error(new Failure("input_limit"))
  end
  let decoded = text::fromBytes(input)

  if decoded == null
    let invalid = text::invalidUtf8Offset(input)
    var offset = 0

    offset = invalid if invalid != null
    return result::Result<Value, Failure>.Error(new Failure("invalid_utf8", offset))
  end
  return new Parser(decoded, limits.maxDepth, limits.maxNodes).parse()
end

def stringify(value: Value, options: Options? = null): result::Result<String, Failure>
  let limits = options == null ? new Options() : options

  if !validOptions(limits)
    return result::Result<String, Failure>.Error(new Failure("invalid_options"))
  end
  let writer = new Writer(limits.maxOutputBytes, limits.maxDepth, limits.maxNodes)

  return writer.stringify(value)
end

def validOptions(options: Options): Bool
  return options.maxInputBytes >= 0 && options.maxInputBytes <= 134217728 && options.maxOutputBytes >= 0 && options.maxOutputBytes <= 134217728 && options.maxDepth >= 0 && options.maxDepth <= 256 && options.maxNodes > 0 && options.maxNodes <= 1000000
end

def validNumber(value: String): Bool
  let length = value.byteLength()
  var index = 0

  if length == 0
    return false
  end
  if value.byteAt(index) == (45 as Byte)
    index = index + 1
  end
  if index >= length
    return false
  end
  if value.byteAt(index) == (48 as Byte)
    index = index + 1
  else
    if !digit19(value.byteAt(index))
      return false
    end
    index = index + 1
    while index < length && digit(value.byteAt(index))
      index = index + 1
    end
  end
  if index < length && value.byteAt(index) == (46 as Byte)
    index = index + 1
    if index >= length || !digit(value.byteAt(index))
      return false
    end
    while index < length && digit(value.byteAt(index))
      index = index + 1
    end
  end
  if index < length && (value.byteAt(index) == (69 as Byte) || value.byteAt(index) == (101 as Byte))
    index = index + 1
    if index < length && (value.byteAt(index) == (43 as Byte) || value.byteAt(index) == (45 as Byte))
      index = index + 1
    end
    if index >= length || !digit(value.byteAt(index))
      return false
    end
    while index < length && digit(value.byteAt(index))
      index = index + 1
    end
  end
  return index == length
end

def digit(value: Byte?): Bool
  return value != null && (value as Int) >= 48 && (value as Int) <= 57
end

def digit19(value: Byte?): Bool
  return value != null && (value as Int) >= 49 && (value as Int) <= 57
end
