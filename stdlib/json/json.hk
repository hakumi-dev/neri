use result
namespace json

## Builds JSON values and retains the first construction failure.
## Parsing and serialization use the bounded JSON codec.
public class Json
  private stored: Value

  def init(value: Value): Void
    this.stored = value
  end

  static def object(): Json
    return new Json(Value.object())
  end

  static def array(values: Json[] = []): Json
    let output = new Json(Value.array())

    for value in values
      output.add(value)
    end
    return output
  end

  static def string(value: String): Json
    return new Json(Value.string(value))
  end

  static def integer(value: Int): Json
    return new Json(new Value("number", value as String))
  end

  static def boolean(value: Bool): Json
    return new Json(Value.boolean(value))
  end

  static def nullValue(): Json
    return new Json(Value.nullValue())
  end

  static def parse(input: String, options: Options? = null): result::Result<Value, Failure>
    return json::parse(input, options)
  end

  def put(key: String, value: Json): Json
    if this.stored.constructionFailure == null
      let problem = value.stored.constructionFailure

      if problem != null
        this.stored.constructionFailure = problem
      else if !this.stored.put(key, value.stored)
        this.stored.constructionFailure = new Failure("invalid_property")
      end
    end
    return this
  end

  def add(value: Json): Json
    if this.stored.constructionFailure == null
      let problem = value.stored.constructionFailure

      if problem != null
        this.stored.constructionFailure = problem
      else if !this.stored.add(value.stored)
        this.stored.constructionFailure = new Failure("invalid_item")
      end
    end
    return this
  end

  def stringify(options: Options? = null): result::Result<String, Failure>
    return json::stringify(this.stored, options)
  end
end
