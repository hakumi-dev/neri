use buffers
use result
use text
namespace json

internal class Writer
  private output: buffers::ByteBuffer?
  private depthLimit: Int
  private nodeLimit: Int
  private nodes: Int = 0
  private problem: Failure?

  def init(outputLimit: Int, depthLimit: Int, nodeLimit: Int): Void
    this.output = buffers::ByteBuffer.create(outputLimit)
    this.depthLimit = depthLimit
    this.nodeLimit = nodeLimit
  end

  def stringify(value: Value): result::Result<String, Failure>
    this.write(value, 0)
    let problem = this.problem

    if problem != null
      return result::Result<String, Failure>.Error(problem)
    end
    let output = this.output

    if output != null
      let rendered = output.text()

      if rendered != null
        return result::Result<String, Failure>.Ok(rendered)
      end
    end
    return result::Result<String, Failure>.Error(new Failure("output_limit"))
  end

  private def append(value: String): Void
    if this.problem != null
      return
    end
    let output = this.output

    if output == null || !output.appendText(value)
      this.problem = new Failure("output_limit")
    end
  end

  private def write(value: Value, depth: Int): Void
    if this.problem != null
      return
    end
    if depth > this.depthLimit
      this.problem = new Failure("depth_limit")
      return
    end
    if this.nodes >= this.nodeLimit
      this.problem = new Failure("node_limit")
      return
    end
    this.nodes = this.nodes + 1
    let kind = value.kind()
    let content = value.text()

    if kind == "null"
      this.append("null")
    else if kind == "string" && content != null
      this.string(content)
    else if (kind == "number" || kind == "boolean") && content != null
      this.append(content)
    else if kind == "array" || kind == "object"
      let object = kind == "object"

      this.append(object ? "{" : "[")
      let first = [true]

      value.eachWhile() do |key, child|
        if this.problem == null
          if !first[0]
            this.append(",")
          end
          first[0] = false
          if object && key != null
            this.string(key)
            this.append(":")
          end
          this.write(child, depth + 1)
        end
        return this.problem == null
      end
      this.append(object ? "}" : "]")
    end
  end

  private def string(value: String): Void
    this.append("\"")
    var index = 0
    var start = 0

    while index < value.byteLength() && this.problem == null
      let byte = value.byteAt(index)

      if byte != null && ((byte as Int) < 32 || byte == (34 as Byte) || byte == (92 as Byte))
        let chunk = value.sliceBytes(start, index - start)

        if chunk != null
          this.append(chunk)
        end
        if byte == (34 as Byte)
          this.append("\\\"")
        else if byte == (92 as Byte)
          this.append("\\\\")
        else
          let code = byte as Int
          let digits = "0123456789abcdef"
          let high = digits.sliceBytes(code / 16, 1)
          let low = digits.sliceBytes(code - (code / 16) * 16, 1)

          if high != null && low != null
            this.append("\\u00")
            this.append(high)
            this.append(low)
          end
        end
        start = index + 1
      end
      index = index + 1
    end
    let chunk = value.sliceBytes(start, index - start)

    if chunk != null
      this.append(chunk)
    end
    this.append("\"")
  end
end
