namespace json

public class Value
  private tag: String
  private content: String = ""
  private firstEntry: Entry?
  private lastEntry: Entry?
  private index: Entry?
  private size: Int = 0

  private def init(tag: String, content: String = ""): Void
    this.tag = tag
    this.content = content
  end

  static def nullValue(): Value
    return new Value("null")
  end

  static def boolean(value: Bool): Value
    return new Value("boolean", value ? "true" : "false")
  end

  static def string(value: String): Value
    return new Value("string", value)
  end

  static def number(lexeme: String): Value?
    if !validNumber(lexeme)
      return null
    end
    return new Value("number", lexeme)
  end

  static def array(): Value
    return new Value("array")
  end

  static def object(): Value
    return new Value("object")
  end

  def kind(): String
    return this.tag
  end

  def text(): String?
    if this.tag == "string" || this.tag == "number" || this.tag == "boolean"
      return this.content
    end
    return null
  end

  def count(): Int
    return this.size
  end

  def each(visit: fn(String?, Value): Void): Void
    var entry = this.firstEntry
    let count = this.size
    var visited = 0

    while entry != null && visited < count
      visit(entry.key, entry.value)
      entry = entry.next
      visited = visited + 1
    end
  end

  internal def eachWhile(visit: fn(String?, Value): Bool): Void
    var entry = this.firstEntry
    let count = this.size
    var visited = 0

    while entry != null && visited < count
      if !visit(entry.key, entry.value)
        return
      end
      entry = entry.next
      visited = visited + 1
    end
  end

  def get(key: String): Value?
    if this.tag != "object"
      return null
    end
    var entry = this.index

    while entry != null
      let entryKey = entry.key

      if entryKey == null
        return null
      end
      let order = this.compare(key, entryKey)

      if order == 0
        return entry.value
      end
      entry = order < 0 ? entry.left : entry.right
    end
    return null
  end

  def at(index: Int): Value?
    if this.tag != "array" || index < 0 || index >= this.size
      return null
    end
    var entry = this.firstEntry
    var current = 0

    while entry != null
      if current == index
        return entry.value
      end
      entry = entry.next
      current = current + 1
    end
    return null
  end

  def add(value: Value): Bool
    if this.tag != "array" || this.size >= 1000000
      return false
    end
    this.append(null, value)
    return true
  end

  def put(key: String, value: Value): Bool
    if this.tag != "object" || this.size >= 1000000 || this.get(key) != null
      return false
    end
    let entry = this.append(key, value)

    this.index = this.insert(this.index, entry, key)
    return true
  end

  private def append(key: String?, value: Value): Entry
    let entry = new Entry(key, value)
    let tail = this.lastEntry

    if tail == null
      this.firstEntry = entry
    else
      tail.next = entry
    end
    this.lastEntry = entry
    this.size = this.size + 1
    return entry
  end

  private def compare(left: String, right: String): Int
    var offset = 0

    while offset < left.byteLength() && offset < right.byteLength()
      let a = left.byteAt(offset)
      let b = right.byteAt(offset)

      if a != null && b != null && a != b
        return (a as Int) - (b as Int)
      end
      offset = offset + 1
    end
    return left.byteLength() - right.byteLength()
  end

  private def height(entry: Entry?): Int
    return entry == null ? 0 : entry.height
  end

  private def update(entry: Entry): Void
    let left = this.height(entry.left)
    let right = this.height(entry.right)

    entry.height = 1 + (left > right ? left : right)
  end

  private def rotateLeft(root: Entry): Entry
    let next = root.right

    if next == null
      return root
    end
    root.right = next.left
    next.left = root
    this.update(root)
    this.update(next)
    return next
  end

  private def rotateRight(root: Entry): Entry
    let next = root.left

    if next == null
      return root
    end
    root.left = next.right
    next.right = root
    this.update(root)
    this.update(next)
    return next
  end

  private def insert(root: Entry?, entry: Entry, key: String): Entry
    if root == null
      return entry
    end
    let rootKey = root.key

    if rootKey == null
      return root
    end
    if this.compare(key, rootKey) < 0
      root.left = this.insert(root.left, entry, key)
    else
      root.right = this.insert(root.right, entry, key)
    end
    this.update(root)
    let balance = this.height(root.left) - this.height(root.right)
    let left = root.left
    let right = root.right

    if balance > 1 && left != null
      if this.height(left.left) < this.height(left.right)
        root.left = this.rotateLeft(left)
      end
      return this.rotateRight(root)
    end
    if balance < -1 && right != null
      if this.height(right.right) < this.height(right.left)
        root.right = this.rotateRight(right)
      end
      return this.rotateLeft(root)
    end
    return root
  end
end
