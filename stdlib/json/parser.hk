use buffers
use result
use text
namespace json

internal class Parser
  private input: String
  private position: Int = 0
  private depthLimit: Int
  private nodeLimit: Int
  private nodes: Int = 0
  private problem: Failure?

  def init(input: String, depthLimit: Int, nodeLimit: Int): Void
    this.input = input
    this.depthLimit = depthLimit
    this.nodeLimit = nodeLimit
  end

  def parse(): result::Result<Value, Failure>
    let value = this.read(0)

    this.spaces()
    if this.position != this.input.byteLength()
      this.fail("invalid_json")
    end
    let problem = this.problem

    if problem != null
      return result::Result<Value, Failure>.Error(problem)
    end
    return result::Result<Value, Failure>.Ok(value)
  end

  private def fail(code: String): Void
    if this.problem == null
      this.problem = new Failure(code, this.position)
    end
  end

  private def byte(): Int
    let value = this.input.byteAt(this.position)

    return value == null ? -1 : value as Int
  end

  private def spaces(): Void
    while this.byte() == 32 || this.byte() == 9 || this.byte() == 10 || this.byte() == 13
      this.position = this.position + 1
    end
  end

  private def read(depth: Int): Value
    this.spaces()
    if depth > this.depthLimit
      this.fail("depth_limit")
      return Value.nullValue()
    end
    if this.nodes >= this.nodeLimit
      this.fail("node_limit")
      return Value.nullValue()
    end
    this.nodes = this.nodes + 1
    let byte = this.byte()

    if byte == 34
      return Value.string(this.string())
    end
    if byte == 123 || byte == 91
      return this.container(depth, byte == 123)
    end
    let start = this.position

    while this.byte() >= 0 && this.byte() != 32 && this.byte() != 9 && this.byte() != 10 && this.byte() != 13 && this.byte() != 44 && this.byte() != 93 && this.byte() != 125
      this.position = this.position + 1
    end
    let token = this.input.sliceBytes(start, this.position - start)

    if token != null
      if token == "null"
        return Value.nullValue()
      end
      if token == "true" || token == "false"
        return Value.boolean(token == "true")
      end
      let number = Value.number(token)

      if number != null
        return number
      end
    end
    this.fail("invalid_json")
    return Value.nullValue()
  end

  private def container(depth: Int, object: Bool): Value
    let value = object ? Value.object() : Value.array()
    let closing = object ? 125 : 93

    this.position = this.position + 1
    this.spaces()
    if this.byte() == closing
      this.position = this.position + 1
      return value
    end
    while this.problem == null
      var key = ""

      this.spaces()
      if object
        if this.byte() != 34
          this.fail("invalid_json")
          return value
        end
        key = this.string()
        this.spaces()
        if this.byte() != 58
          this.fail("invalid_json")
          return value
        end
        this.position = this.position + 1
        if value.get(key) != null
          this.fail("duplicate_key")
          return value
        end
      end
      let child = this.read(depth + 1)

      if this.problem != null
        return value
      end
      if object
        if !value.put(key, child)
          this.fail("node_limit")
        end
      else
        if !value.add(child)
          this.fail("node_limit")
        end
      end
      this.spaces()
      if this.byte() == closing
        this.position = this.position + 1
        return value
      end
      if this.byte() != 44
        this.fail("invalid_json")
        return value
      end
      this.position = this.position + 1
    end
    return value
  end

  private def string(): String
    let output = buffers::ByteBuffer.create(this.input.byteLength())

    if output == null
      this.fail("input_limit")
      return ""
    end
    this.position = this.position + 1
    while this.problem == null
      let byte = this.byte()

      if byte < 32
        this.fail("invalid_json")
        return ""
      end
      this.position = this.position + 1
      if byte == 34
        let value = output.text()

        if value != null
          return value
        end
        this.fail("invalid_utf8")
        return ""
      end
      if byte != 92
        if !output.append(byte as Byte)
          this.fail("input_limit")
        end
      else
        let escaped = this.byte()

        this.position = this.position + 1
        var code = -1

        if escaped == 34 || escaped == 92 || escaped == 47
          code = escaped
        else if escaped == 98
          code = 8
        else if escaped == 102
          code = 12
        else if escaped == 110
          code = 10
        else if escaped == 114
          code = 13
        else if escaped == 116
          code = 9
        else if escaped == 117
          code = this.hex4()
          if code >= 55296 && code <= 56319
            if this.byte() != 92
              this.fail("invalid_json")
              return ""
            end
            this.position = this.position + 1
            if this.byte() != 117
              this.fail("invalid_json")
              return ""
            end
            this.position = this.position + 1
            let low = this.hex4()

            if low < 56320 || low > 57343
              this.fail("invalid_json")
              return ""
            end
            code = 65536 + (code - 55296) * 1024 + low - 56320
          end
        end
        let scalar = text::Scalar.fromInt(code)

        if scalar == null
          this.fail("invalid_json")
          return ""
        end
        if !output.appendBytes(scalar.utf8())
          this.fail("input_limit")
        end
      end
    end
    return ""
  end

  private def hex4(): Int
    var value = 0
    var count = 0

    while count < 4
      let byte = this.byte()
      var digit = -1

      if byte >= 48 && byte <= 57
        digit = byte - 48
      else if byte >= 65 && byte <= 70
        digit = byte - 55
      else if byte >= 97 && byte <= 102
        digit = byte - 87
      end
      if digit < 0
        this.fail("invalid_json")
        return -1
      end
      value = value * 16 + digit
      this.position = this.position + 1
      count = count + 1
    end
    return value
  end
end
