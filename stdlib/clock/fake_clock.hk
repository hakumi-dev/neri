namespace clock

class FakeClock
  private value: Instant

  def init(start: Instant): Void
    this.value = start
  end

  def clock(): Clock
    let state = this
    let read: fn(): Instant? = fn()
      return state.value
    end

    return new Clock(read)
  end

  def advance(duration: Duration): Bool
    let next = this.value.plus(duration)

    if next == null
      return false
    end
    this.value = next
    return true
  end
end
