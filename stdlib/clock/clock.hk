namespace clock

class Clock
  private read: fn(): Instant?

  def init(read: fn(): Instant?): Void
    this.read = read
  end

  static def monotonic(): Clock
    let read: fn(): Instant? = fn()
      return Instant.now()
    end

    return new Clock(read)
  end

  def now(): Instant?
    let read = this.read

    return read()
  end
end
