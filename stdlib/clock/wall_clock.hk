namespace clock

class WallClock
  private read: fn(): Timestamp?

  def init(read: fn(): Timestamp?): Void
    this.read = read
  end

  static def system(): WallClock
    let read: fn(): Timestamp? = fn()
      return Timestamp.now()
    end

    return new WallClock(read)
  end

  def now(): Timestamp?
    let read = this.read

    return read()
  end
end
