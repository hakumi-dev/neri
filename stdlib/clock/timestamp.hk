namespace clock

class Timestamp
  private value: Int

  private def init(value: Int): Void
    this.value = value
  end

  ## Constructs a wall-clock timestamp from signed Unix epoch milliseconds.
  static def fromUnixMilliseconds(value: Int): Timestamp
    return new Timestamp(value)
  end

  static def now(): Timestamp?
    let value = clock.wallMilliseconds()

    if value == null
      return null
    end
    return new Timestamp(value)
  end

  def unixMilliseconds(): Int
    return this.value
  end

  def plus(duration: Duration): Timestamp?
    let delta = duration.milliseconds()

    if this.value > 9223372036854775807 - delta
      return null
    end
    return new Timestamp(this.value + delta)
  end

  ## Formats UTC with millisecond precision and no locale-dependent state.
  ## Years outside 0000..9999 cannot be represented by this fixed format.
  def formatUtc(): String?
    if this.value < -62167219200000 || this.value >= 253402300800000
      return null
    end

    var days = this.value / 86400000
    var daytime = this.value - days * 86400000

    if daytime < 0
      days = days - 1
      daytime = daytime + 86400000
    end

    let shifted = days + 719468
    var era = shifted / 146097

    if shifted < 0
      era = (shifted - 146096) / 146097
    end
    let dayOfEra = shifted - era * 146097
    let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    let monthPrime = (5 * dayOfYear + 2) / 153
    let day = dayOfYear - (153 * monthPrime + 2) / 5 + 1
    var month = monthPrime + 3

    if monthPrime >= 10
      month = monthPrime - 9
      year = year + 1
    end

    let hour = daytime / 3600000
    let minute = (daytime / 60000) - hour * 60
    let second = (daytime / 1000) - (daytime / 60000) * 60
    let millisecond = daytime - (daytime / 1000) * 1000
    let date = clock.fourDigits(year) + "-" + clock.twoDigits(month) + "-" + clock.twoDigits(day)
    let time = clock.twoDigits(hour) + ":" + clock.twoDigits(minute) + ":" + clock.twoDigits(second)

    return date + "T" + time + "." + clock.threeDigits(millisecond) + "Z"
  end
end
