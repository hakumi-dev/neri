use host
use tasks
use text
namespace buffers

class ByteBuffer
  private bytes: Byte[] = []
  private used: Int = 0
  private maximum: Int

  private def init(limit: Int, initialCapacity: Int): Void
    this.maximum = limit
    var capacity = initialCapacity

    capacity = limit if capacity > limit
    this.bytes = zeroBytes(capacity)
  end

  def static create(limit: Int, initialCapacity: Int = 16): ByteBuffer?
    if limit < 0 || limit > 134217728 || initialCapacity < 0
      return null
    end
    return new ByteBuffer(limit, initialCapacity)
  end

  def length(): Int
    return this.used
  end

  def capacity(): Int
    return this.bytes.Length
  end

  def limit(): Int
    return this.maximum
  end

  def append(value: Byte): Bool
    if !this.reserve(1)
      return false
    end
    this.bytes[this.used] = value
    this.used = this.used + 1
    return true
  end

  def appendBytes(values: Byte[]): Bool
    return this.appendSlice(values, 0, values.Length)
  end

  def appendSlice(values: Byte[], offset: Int, count: Int): Bool
    if offset < 0 || count < 0 || offset > values.Length || count > values.Length - offset
      return false
    end
    if !this.reserve(count)
      return false
    end
    var index = 0

    while index < count
      this.bytes[this.used + index] = values[offset + index]
      index = index + 1
    end
    this.used = this.used + count
    return true
  end

  def appendText(value: String): Bool
    let count = text.byteLength(value)

    if !this.reserve(count)
      return false
    end
    if !text.copyBytes(value, this.bytes, this.used)
      return false
    end
    this.used = this.used + count
    return true
  end

  def copyWithin(target: Int, start: Int, count: Int): Bool
    if target < 0 || start < 0 || count < 0 || target > this.used || start > this.used || count > this.used - start || count > this.used - target
      return false
    end
    if target > start && target < start + count
      var index = count

      while index > 0
        index = index - 1
        this.bytes[target + index] = this.bytes[start + index]
      end
    else
      var index = 0

      while index < count
        this.bytes[target + index] = this.bytes[start + index]
        index = index + 1
      end
    end
    return true
  end

  def byteAt(index: Int): Byte?
    if index < 0 || index >= this.used
      return null
    end
    return this.bytes[index]
  end

  def snapshot(): Byte[]
    let source = this.bytes

    return tasks.generate(this.used, 1) do |index|
      return source[index]
    end
  end

  def text(): String?
    return text.fromBytes(this.snapshot())
  end

  private def reserve(additional: Int): Bool
    if this.maximum < 0 || additional < 0 || additional > this.maximum - this.used
      return false
    end
    let required = this.used + additional

    if required <= this.bytes.Length
      return true
    end
    var capacity = this.bytes.Length

    capacity = 1 if capacity == 0
    while capacity < required
      if capacity > this.maximum / 2
        capacity = this.maximum
      else
        capacity = capacity * 2
      end
    end
    let previous = this.bytes

    this.bytes = tasks.generate(capacity, 1) do |index|
      return index < previous.Length ? previous[index] : 0 as Byte
    end
    return true
  end
end

def zeroBytes(count: Int): Byte[]
  return tasks.generate(count, 1) do |index|
    return 0 as Byte
  end
end

class TextBuffer
  private bytes: ByteBuffer

  private def init(bytes: ByteBuffer): Void
    this.bytes = bytes
  end

  def static create(limit: Int, initialCapacity: Int = 16): TextBuffer?
    let bytes: ByteBuffer? = ByteBuffer.create(limit, initialCapacity)

    if bytes == null
      return null
    end
    return new TextBuffer(bytes)
  end

  def length(): Int
    return this.bytes.length()
  end

  def capacity(): Int
    return this.bytes.capacity()
  end

  def append(value: String): Bool
    return this.bytes.appendText(value)
  end

  def snapshot(): String?
    return this.bytes.text()
  end
end

class ValueNode<T>
  public value: T
  public next: ValueNode<T>?

  def init(value: T): Void
    this.value = value
  end
end

class Values<T>
  private first: ValueNode<T>?
  private last: ValueNode<T>?
  private size: Int = 0
  private maximum: Int

  private def init(limit: Int): Void
    this.maximum = limit
  end

  def static create(limit: Int): Values<T>?
    if limit < 0 || limit > 134217728
      return null
    end
    return new Values<T>(limit)
  end

  def add(value: T): Bool
    if this.size >= this.maximum
      return false
    end
    let node = new ValueNode<T>(value)
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
    this.size = this.size + 1
    return true
  end

  def count(): Int
    return this.size
  end

  def each(visit: fn(T): Void): Void
    var current: ValueNode<T>? = this.first
    let initialCount = this.size
    var visited = 0

    while current != null && visited < initialCount
      visit(current.value)
      current = current.next
      visited = visited + 1
    end
  end
end
