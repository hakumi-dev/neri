use host

# The trusted seed predates typed array generation. This implementation is used
# only to build Stage1; subsequent stages compile the current hash table.
class StringTableEntry<T>
  public key: String
  public value: T
  public next: StringTableEntry<T>?

  def init(key: String, value: T): Void
    this.key = key
    this.value = value
  end
end

class StringTable<T>
  private first: StringTableEntry<T>?

  def find(key: String): StringTableEntry<T>?
    var entry = this.first

    while entry != null
      if entry.key == key
        return entry
      end
      entry = entry.next
    end
    return null
  end

  def add(key: String, value: T): Bool
    if this.find(key) != null
      return false
    end
    let entry = new StringTableEntry<T>(key, value)

    entry.next = this.first
    this.first = entry
    return true
  end
end
