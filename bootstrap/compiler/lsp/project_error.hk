# Seed-stage representation of the compiler's closed project-error classification.
class NeriProjectErrorReason
  private emptyImplicit: Bool

  private def init(emptyImplicit: Bool): Void
    this.emptyImplicit = emptyImplicit
  end

  def static InvalidProject(): NeriProjectErrorReason
    return new NeriProjectErrorReason(false)
  end

  def static EmptyImplicitProject(): NeriProjectErrorReason
    return new NeriProjectErrorReason(true)
  end

  def isEmptyImplicitProject(): Bool
    return this.emptyImplicit
  end
end

def neriProjectErrorReasonIsEmptyImplicitProject(reason: NeriProjectErrorReason?): Bool
  if reason == null
    return false
  end
  return reason.isEmptyImplicitProject()
end
