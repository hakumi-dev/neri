class AgentToolDescriptor
  private storedName: String
  private storedDescription: String
  private storedFields: AgentInputField[]
  private following: AgentToolDescriptor?

  def init(name: String, description: String, fields: AgentInputField[]): Void
    this.storedName = name
    this.storedDescription = description
    this.storedFields = fields
  end

  def name(): String
    return this.storedName
  end

  def description(): String
    return this.storedDescription
  end

  def inputSchema(): String
    return agentInputObjectSchema(this.storedFields)
  end

  def decode(arguments: LspJson): AgentToolRequest?
    if !agentInputObjectValid(arguments, this.storedFields)
      return null
    end
    return this.decodeValid(arguments)
  end

  def decodeValid(arguments: LspJson): AgentToolRequest?
    host.exit(70)
    return null
  end

  def next(): AgentToolDescriptor?
    return this.following
  end

  def link(next: AgentToolDescriptor): Void
    this.following = next
  end
end
