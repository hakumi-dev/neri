class AgentTestService
  private root: String

  def init(root: String): Void
    this.root = root
  end

  def run(operationId: String): String
    return agentTestResponse(operationId, this.root, "", "unavailable", "unavailable", "Project tests are unavailable in the bootstrap compiler.", false, false, 0, 0, "", false)
  end
end
