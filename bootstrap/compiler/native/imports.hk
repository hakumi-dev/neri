use host

@cabi("stat")
def unsafe runCacheStat(path: Byte*, data: Byte*): Int
end

@cabi("uname")
def unsafe runCacheUname(data: Byte*): Int
end

@cabi("lstat")
def unsafe runCacheLstat(path: Byte*, data: Byte*): Int
end

@cabi("getuid")
def unsafe runCacheUid(): Int
end

@cabi("mkdir")
def unsafe runCacheMkdir(path: Byte*, mode: Int): Int
end

@cabi("rename")
def unsafe runCacheRename(from: Byte*, to: Byte*): Int
end

@cabi("write")
def unsafe runCacheWrite(fd: Int, bytes: Byte*, length: Int): Int
end

@cabi("neri_rt_v1_clock_milliseconds")
def unsafe runCacheClock(): Int
end

@cabi("malloc")
def unsafe shaAllocateBytes(size: Int): Byte*?
end

@cabi("free")
def unsafe shaFreeBytes(bytes: Byte*): Void
end

@cabi("neri_rt_v1_crypto_sha256")
def unsafe shaNativeDigest(bytes: Byte*, length: Int, digest: Byte*): Int
end

# Consumes the native allocation after hashing, including native digest failure.
def unsafe shaConsumeBytes(bytes: Byte*, length: Int): String?
  var digest: Byte[] = []
  var index = 0

  while index < 32
    digest = host.appendByte(digest, 0 as Byte)
    index = index + 1
  end
  var status = -1

  borrow digest as output
    status = shaNativeDigest(bytes, length, output)
  end
  shaFreeBytes(bytes)
  if status != 0
    return null
  end
  var result = ""

  index = 0
  while index < 32
    let value = digest[index] as Int

    result = result + irHexDigit(value / 16) + irHexDigit(value - (value / 16) * 16)
    index = index + 1
  end
  return result
end

@cabi("neri_rt_v1_host_canonical_path")
def unsafe neriHostCanonicalPath(path: Byte*, output: Byte*, capacity: Int): Int
end

@cabi("read")
def unsafe lspRead(fd: Int, bytes: Byte*, length: Int): Int
end
