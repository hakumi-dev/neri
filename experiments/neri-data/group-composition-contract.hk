use neri_data
use test
use host

class GroupCompositionRecord
  public id: Int
  public category: String?
  public amount: Int?

  def init(id: Int, category: String? = null, amount: Int? = null): Void
    this.id = id
    this.category = category
    this.amount = amount
  end
end

class GroupCompositionResult
  public category: String?
  public rows: Int

  def init(category: String?, rows: Int): Void
    this.category = category
    this.rows = rows
  end
end

class GroupCompositionProvider: Provider
  public calls: Int = 0
  public enabled: Bool = true
  public seenSql: String = ""
  public seenParameters: Int = 0

  public override readonly def dialect(): SqlDialect
    return SqlDialect.PostgreSql()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.enabled
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    this.seenSql = plan.sql()
    this.seenParameters = plan.parameters().count()
    return ProviderResult.Rows([])
  end
end

def rejectGroupCompositionRecord(row: RawRow): DecodeResult<GroupCompositionRecord>
  return DecodeResult<GroupCompositionRecord>.Failure(QueryFailure.Provider("group composition must not decode source rows"))
end

def groupCompositionQuery(): Query<GroupCompositionRecord>
  let mapping = new EntityMapping("GroupCompositionRecord", "group_composition_records", [new MappingColumn("GroupCompositionRecord.id", "Int", "id"), new MappingColumn("GroupCompositionRecord.category", "String?", "category"), new MappingColumn("GroupCompositionRecord.amount", "Int?", "amount")])
  let decoder = new Decoder<GroupCompositionRecord>(rejectGroupCompositionRecord, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<GroupCompositionRecord>("group_composition_records", decoder, mapping: mapping)
end

def groupCompositionCategory(): RowShape<GroupCompositionRecord, String?>
  let category: quote fn(GroupCompositionRecord): String? = quote do |row: GroupCompositionRecord|: String?
    return row.category
  end

  return fieldShape(optionalTextScalar(), category)
end

def groupCompositionAmount(): quote fn(GroupCompositionRecord): Int?
  return quote do |row: GroupCompositionRecord|: Int?
    return row.amount
  end
end

def makeGroupCompositionResult(category: String?, rows: Int): GroupCompositionResult
  return new GroupCompositionResult(category, rows)
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def main(): Void
  let provider = new GroupCompositionProvider()
  let sourcePredicate: quote fn(GroupCompositionRecord): Bool = quote do |row: GroupCompositionRecord|: Bool
    return row.id == 7
  end
  let filterPredicate: quote fn(GroupCompositionRecord): Bool = quote do |row: GroupCompositionRecord|: Bool
    return row.id > 2
  end
  let filteredCount = countRows<GroupCompositionRecord>().where(filterPredicate)
  let orderFilter: quote fn(GroupCompositionRecord): Bool = quote do |row: GroupCompositionRecord|: Bool
    return row.id > 3
  end
  let orderedCount = countRows<GroupCompositionRecord>().where(orderFilter)
  let havingPredicate: quote fn(Int): Bool = quote do |value: Int|: Bool
    return value > 5
  end
  let metric = groupMetric(filteredCount)
  let having = metric.where(havingPredicate)
  let order = groupMetric(orderedCount).descending()
  let source = groupCompositionQuery().matching(sourcePredicate)
  let grouped = selectGroups(groupBy(source, groupCompositionCategory()), countRows<GroupCompositionRecord>()) do |category: String?, rows: Int|: GroupCompositionResult
    return new GroupCompositionResult(category, rows)
  end
  let composed = grouped.take(2).having(having).orderByAggregate(order).thenByKey().skip(1)

  match composed.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      test::assertEqual(plan.sql().limit(), 2)
      test::assertEqual(plan.sql().columns().count(), 2)
      test::assertTrue(containsText(plan.sql().sql(), "SELECT \"__neri_group_stage\".\"__neri_shape_0\", \"__neri_group_stage\".\"__neri_aggregate_1\" FROM"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_composition_records\".\"id\" > $1"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_composition_records\".\"id\" > $2"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_composition_records\".\"id\" = $3"))
      test::assertTrue(containsText(plan.sql().sql(), "LIMIT 2) AS \"__neri_group_stage\" WHERE"))
      test::assertTrue(containsText(plan.sql().sql(), "WHERE \"__neri_group_stage\".\"__neri_aggregate_2\" > $4"))
      test::assertTrue(containsText(plan.sql().sql(), "ORDER BY \"__neri_group_stage\".\"__neri_aggregate_3\" DESC, \"__neri_group_stage\".\"__neri_shape_0\" ASC"))
      test::assertTrue(containsText(plan.sql().sql(), "OFFSET 1"))
      let first = plan.sql().parameters().first()

      test::assertTrue(first != null)
      if first != null
        match first.value()
          case Parameter.Int(value)
            test::assertEqual(value, 2)
          case Parameter.Float(value)
            test::assertTrue(false)
          case Parameter.Bool(value)
            test::assertTrue(false)
          case Parameter.Text(value)
            test::assertTrue(false)
        end
        let second = first.next()

        test::assertTrue(second != null)
        if second != null
          match second.value()
            case Parameter.Int(value)
              test::assertEqual(value, 3)
            case Parameter.Float(value)
              test::assertTrue(false)
            case Parameter.Bool(value)
              test::assertTrue(false)
            case Parameter.Text(value)
              test::assertTrue(false)
          end
          let third = second.next()

          test::assertTrue(third != null)
          if third != null
            match third.value()
              case Parameter.Int(value)
                test::assertEqual(value, 7)
              case Parameter.Float(value)
                test::assertTrue(false)
              case Parameter.Bool(value)
                test::assertTrue(false)
              case Parameter.Text(value)
                test::assertTrue(false)
            end
            let fourth = third.next()

            test::assertTrue(fourth != null)
            if fourth != null
              match fourth.value()
                case Parameter.Int(value)
                  test::assertEqual(value, 5)
                case Parameter.Float(value)
                  test::assertTrue(false)
                case Parameter.Bool(value)
                  test::assertTrue(false)
                case Parameter.Text(value)
                  test::assertTrue(false)
              end
            end
          end
        end
      end
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  let before = provider.calls

  match composed.all(provider)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, before + 1)
  test::assertEqual(provider.seenParameters, 4)
  test::assertTrue(containsText(provider.seenSql, "\"group_composition_records\".\"id\" > $1"))
  test::assertTrue(containsText(provider.seenSql, "WHERE \"__neri_group_stage\".\"__neri_aggregate_2\" > $4"))

  let badOrder = grouped.orderByKey().skip(-1).take(1)
  let beforeBadOrder = provider.calls

  match badOrder.all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertEqual(message, "invalid grouped offset")
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeBadOrder)

  match grouped.take(2).take(0).take(1).all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertEqual(value, 0)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeBadOrder)

  let invalidConstructor = new GroupedAggregate<GroupCompositionRecord, String?, Int, GroupCompositionResult>(groupCompositionQuery().asRelation(), groupCompositionCategory(), countRows<GroupCompositionRecord>(), makeGroupCompositionResult, 2000)

  match invalidConstructor.take(2).all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertEqual(value, 2000)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeBadOrder)

  let combined = combineAggregates(countRows<GroupCompositionRecord>(), sumInt(optionalIntScalar(), groupCompositionAmount()), aggregateCompositionPair)
  let combinedPredicate: quote fn(AggregateCompositionPair): Bool = quote do |value: AggregateCompositionPair|: Bool
    return value.rows > 0
  end
  let combinedMetric = groupMetric(combined).where(combinedPredicate)
  let invalidMetric = grouped.having(combinedMetric).take(1)
  let beforeInvalidMetric = provider.calls

  match invalidMetric.all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "group metric requires one scalar aggregate")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeInvalidMetric)

  let nullablePredicate: quote fn(Int?): Bool = quote do |value: Int?|: Bool
    return value == null
  end
  let nullableSum = sumInt(optionalIntScalar(), groupCompositionAmount())
  let nullHaving = groupMetric(nullableSum).where(nullablePredicate)
  let nullableGroups = selectGroups(groupBy(groupCompositionQuery(), groupCompositionCategory()), countRows<GroupCompositionRecord>()) do |category: String?, rows: Int|: GroupCompositionResult
    return new GroupCompositionResult(category, rows)
  end

  match nullableGroups.having(nullHaving).take(2).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 0)
      test::assertTrue(containsText(plan.sql().sql(), "WHERE \"__neri_group_stage\".\"__neri_aggregate_2\" IS NULL"))
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  let badMapping = new EntityMapping("GroupCompositionRecord", "group_composition_records", [new MappingColumn("GroupCompositionRecord.id", "Int", "id"), new MappingColumn("GroupCompositionRecord.category", "String?", "category"), new MappingColumn("GroupCompositionRecord.amount", "String", "amount")])
  let badDecoder = new Decoder<GroupCompositionRecord>(rejectGroupCompositionRecord, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))
  let malformed = new Query<GroupCompositionRecord>("group_composition_records", badDecoder, mapping: badMapping)
  let malformedGroups = selectGroups(groupBy(malformed, groupCompositionCategory()), sumInt(optionalIntScalar(), groupCompositionAmount())) do |category: String?, total: Int?|: GroupCompositionResult
    var rows = 0

    if total != null
      rows = total
    end
    return new GroupCompositionResult(category, rows)
  end
  let nullableMetricPredicate: quote fn(Int?): Bool = quote do |value: Int?|: Bool
    return value == null
  end
  let malformedMetric = groupMetric(sumInt(optionalIntScalar(), groupCompositionAmount())).where(nullableMetricPredicate)
  let malformedHaving = malformedGroups.having(malformedMetric).take(1)
  let beforeMalformed = provider.calls

  match malformedHaving.all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          # Quotation validation may reject the malformed mapping before selection translation.
          test::assertTrue(name != "")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeMalformed)
end

class AggregateCompositionPair
  public rows: Int
  public total: Int?

  def init(rows: Int, total: Int?): Void
    this.rows = rows
    this.total = total
  end
end

def aggregateCompositionPair(rows: Int, total: Int?): AggregateCompositionPair
  return new AggregateCompositionPair(rows, total)
end
