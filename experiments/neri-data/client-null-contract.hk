use neri_data
use test
use host

class NullNode
  public id: Int
  public parentId: Int?
  public otherId: Int?

  def init(id: Int, parentId: Int? = null, otherId: Int? = null): Void
    this.id = id
    this.parentId = parentId
    this.otherId = otherId
  end
end

class RequiredNullNode
  public id: Int
  public parentId: Int

  def init(id: Int, parentId: Int): Void
    this.id = id
    this.parentId = parentId
  end
end

class NullWriteProvider: Provider
  private lease: Int = 0
  private state: TransactionState = TransactionState.RolledBack()
  public updates: Int = 0
  public deletes: Int = 0

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.TrackedWrites()
        return true
      case ProviderCapability.ExplicitTransactions()
        return true
      case ProviderCapability.Savepoints()
        return false
      case ProviderCapability.BoundedTypedReads()
        return false
      case ProviderCapability.StreamingReads()
        return false
      case ProviderCapability.SetWrites()
        return false
    end
  end

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Rows([])
  end

  public override def beginTransaction(): TransactionOpenResult
    this.lease = this.lease + 1
    this.state = TransactionState.Active()
    return TransactionOpenResult.Begun(this.lease)
  end

  public override def writeBatchInTransaction(batch: readonly WriteBatch, lease: Int): WriteResult
    if lease != this.lease
      return WriteResult.Failure(WriteFailure.Transaction("wrong lease"))
    end
    var current = batch.first()

    while current != null
      let sql = current.command().sql()

      if host::stringByteLength(sql) >= 6 && host::stringSlice(sql, 0, 6) == "UPDATE"
        this.updates = this.updates + 1
      end
      if host::stringByteLength(sql) >= 6 && host::stringSlice(sql, 0, 6) == "DELETE"
        this.deletes = this.deletes + 1
      end
      current = current.next()
    end
    return WriteResult.Saved(batch.count())
  end

  public override def commitTransaction(lease: Int): WriteResult
    this.state = TransactionState.Committed()
    return WriteResult.Saved(0)
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    this.state = TransactionState.RolledBack()
    return WriteResult.Saved(0)
  end

  public override def transactionState(lease: Int): TransactionState
    if lease != this.lease
      return TransactionState.Invalid()
    end
    return this.state
  end
end

def columns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("parent_id", ResultColumnKind.Int(), true), new ResultColumn("other_id", ResultColumnKind.Int(), true)])
end

def capture(node: NullNode): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(node.id)), new RawColumn("parent_id", cellOptionalInt(node.parentId)), new RawColumn("other_id", cellOptionalInt(node.otherId))])
end

def captureRequired(node: RequiredNullNode): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(node.id)), new RawColumn("parent_id", Cell.Int(node.parentId))])
end

def requiredColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("parent_id", ResultColumnKind.Int())])
end

def requiredKey(node: RequiredNullNode): Cell
  return Cell.Int(node.id)
end

def requiredParent(node: RequiredNullNode): Cell
  return Cell.Int(node.parentId)
end

def setRequiredParent(node: RequiredNullNode, value: Cell): Void
  match value
    case Cell.Int(number)
      node.parentId = number
    case Cell.Null()
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def key(node: NullNode): Cell
  return Cell.Int(node.id)
end

def parent(node: NullNode): Cell
  return cellOptionalInt(node.parentId)
end

def other(node: NullNode): Cell
  return cellOptionalInt(node.otherId)
end

def setParent(node: NullNode, value: Cell): Void
  match value
    case Cell.Int(number)
      node.parentId = number
    case Cell.Null()
      node.parentId = null
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def setOther(node: NullNode, value: Cell): Void
  match value
    case Cell.Int(number)
      node.otherId = number
    case Cell.Null()
      node.otherId = null
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def attach(tracker: EntityTracker<NullNode>, node: NullNode): TrackedHandle<NullNode>?
  match tracker.attachWithHandle(node)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def add(tracker: EntityTracker<NullNode>, node: NullNode): TrackedHandle<NullNode>?
  match tracker.addWithHandle(node)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def link(changes: ChangeContext, principal: TrackedHandle<NullNode>, dependent: TrackedHandle<NullNode>, slot: String, policy: RelationshipDeletePolicy): QueryFailure?
  if slot == "other_id"
    return changes.registerRelation(new ScalarRelationshipLink<NullNode, NullNode>(principal, dependent, key, other, setOther, ResultColumnKind.Int(), true, slot, policy).edge())
  end
  return changes.registerRelation(new ScalarRelationshipLink<NullNode, NullNode>(principal, dependent, key, parent, setParent, ResultColumnKind.Int(), true, slot, policy).edge())
end

def saved(result: WriteResult, count: Int): Void
  match result
    case WriteResult.Saved(actual)
      test::assertEqual(actual, count)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(actual, outputs)
      test::assertTrue(false)
  end
end

def deleted(tracker: EntityTracker<NullNode>, node: NullNode): Void
  let state = tracker.stateOf(node)

  test::assertTrue(state != null)
  if state != null
    match state
      case TrackingState.Deleted()
      case TrackingState.Unchanged()
        test::assertTrue(false)
      case TrackingState.Modified()
        test::assertTrue(false)
      case TrackingState.Added()
        test::assertTrue(false)
      case TrackingState.Detached()
        test::assertTrue(false)
    end
  end
end

def mixedAndRollback(): Void
  let provider = new NullWriteProvider()
  let tracker = new EntityTracker<NullNode>("nodes", "id", columns(), capture)
  let changes = new ChangeContext(provider)
  let root = new NullNode(1)
  let branch = new NullNode(2, 1)
  let survivor = new NullNode(3, 1, 2)
  let doomed = new NullNode(4, 1, 2)

  changes.register(tracker.changeSet())
  let rootHandle = attach(tracker, root)
  let branchHandle = attach(tracker, branch)
  let survivorHandle = attach(tracker, survivor)
  let doomedHandle = attach(tracker, doomed)

  if rootHandle != null && branchHandle != null && survivorHandle != null && doomedHandle != null
    test::assertTrue(link(changes, rootHandle, branchHandle, "parent_id", RelationshipDeletePolicy.ClientCascade()) == null)
    test::assertTrue(link(changes, rootHandle, survivorHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(link(changes, branchHandle, survivorHandle, "other_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(link(changes, rootHandle, doomedHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(link(changes, branchHandle, doomedHandle, "other_id", RelationshipDeletePolicy.ClientCascade()) == null)
    saved(changes.beginTransaction(), 0)

    test::assertTrue(removeCascade(changes, rootHandle) == null)
    test::assertTrue(survivor.parentId == null && survivor.otherId == null)
    let doomedParent = doomed.parentId

    test::assertTrue(doomedParent != null)
    if doomedParent != null
      test::assertEqual(doomedParent, 1)
    end
    deleted(tracker, root)
    deleted(tracker, branch)
    deleted(tracker, doomed)
    saved(changes.saveChanges(), 4)

    test::assertEqual(provider.updates, 1)
    test::assertEqual(provider.deletes, 3)
    saved(changes.rollbackTransaction(), 0)

    test::assertTrue(survivor.parentId == null && survivor.otherId == null)
    deleted(tracker, root)
    saved(changes.saveChanges(), 4)
  end
end

def preflightAndAdded(): Void
  let tracker = new EntityTracker<NullNode>("nodes", "id", columns(), capture)
  let changes = new ChangeContext()
  let root = new NullNode(10)
  let clear = new NullNode(11, 10)
  let blocked = new NullNode(12, 10)

  changes.register(tracker.changeSet())
  let rootHandle = attach(tracker, root)
  let clearHandle = attach(tracker, clear)
  let blockedHandle = attach(tracker, blocked)

  if rootHandle != null && clearHandle != null && blockedHandle != null
    test::assertTrue(link(changes, rootHandle, clearHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(link(changes, rootHandle, blockedHandle, "parent_id", RelationshipDeletePolicy.Restrict()) == null)
    test::assertTrue(removeCascade(changes, rootHandle) != null)
    let clearParent = clear.parentId

    test::assertTrue(clearParent != null)
    if clearParent != null
      test::assertEqual(clearParent, 10)
    end
    let state = tracker.stateOf(root)

    test::assertTrue(state != null)
    if state != null
      match state
        case TrackingState.Unchanged()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Deleted()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
    end
  end

  let addedTracker = new EntityTracker<NullNode>("nodes", "id", columns(), capture)
  let addedChanges = new ChangeContext()
  let newRoot = new NullNode(20)
  let newChild = new NullNode(21, 20)
  let newRestrict = new NullNode(22, 20)
  let newDetached = new NullNode(23, 20)

  addedChanges.register(addedTracker.changeSet())
  let newRootHandle = add(addedTracker, newRoot)
  let newChildHandle = add(addedTracker, newChild)
  let newRestrictHandle = add(addedTracker, newRestrict)
  let newDetachedHandle = add(addedTracker, newDetached)

  if newRootHandle != null && newChildHandle != null && newRestrictHandle != null && newDetachedHandle != null
    test::assertTrue(link(addedChanges, newRootHandle, newChildHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(link(addedChanges, newRootHandle, newRestrictHandle, "parent_id", RelationshipDeletePolicy.Restrict()) == null)
    test::assertTrue(link(addedChanges, newRootHandle, newDetachedHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    test::assertTrue(removeCascade(addedChanges, newRootHandle) != null)
    test::assertTrue(newChild.parentId != null)
    test::assertTrue(addedTracker.detach(newRestrict) == null)
    test::assertTrue(addedTracker.detach(newDetached) == null)
    test::assertTrue(removeCascade(addedChanges, newRootHandle) == null)
    test::assertTrue(newChild.parentId == null)
    test::assertTrue(newDetached.parentId != null)
    let state = addedTracker.stateOf(newChild)

    test::assertTrue(state != null)
    if state != null
      match state
        case TrackingState.Added()
        case TrackingState.Unchanged()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Deleted()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
    end
  end
end

def policyAndCycle(): Void
  let tracker = new EntityTracker<NullNode>("nodes", "id", columns(), capture)
  let changes = new ChangeContext()
  let root = new NullNode(30, null, 31)
  let branch = new NullNode(31, 30)
  let survivor = new NullNode(32, 30)
  let replacement = new NullNode(33)

  changes.register(tracker.changeSet())
  let rootHandle = attach(tracker, root)
  let branchHandle = attach(tracker, branch)
  let survivorHandle = attach(tracker, survivor)
  let replacementHandle = attach(tracker, replacement)

  if rootHandle != null && branchHandle != null && survivorHandle != null && replacementHandle != null
    let wrongShape = new ScalarRelationshipLink<NullNode, NullNode>(rootHandle, survivorHandle, key, parent, setParent, ResultColumnKind.Int(), false, "parent_id", RelationshipDeletePolicy.ClientSetNull())

    test::assertTrue(changes.registerRelation(wrongShape.edge()) != null)
    test::assertTrue(link(changes, rootHandle, survivorHandle, "parent_id", RelationshipDeletePolicy.ClientSetNull()) == null)
    let wrongPolicy = new ScalarRelationshipLink<NullNode, NullNode>(rootHandle, survivorHandle, key, parent, setParent, ResultColumnKind.Int(), true, "parent_id", RelationshipDeletePolicy.Restrict())

    test::assertTrue(changes.registerRelation(wrongPolicy.edge()) != null)
    let replacementPolicy = new ScalarRelationshipLink<NullNode, NullNode>(replacementHandle, survivorHandle, key, parent, setParent, ResultColumnKind.Int(), true, "parent_id", RelationshipDeletePolicy.Restrict())

    test::assertTrue(changes.reassignRelation(replacementPolicy.edge()) != null)
    let retainedParent = survivor.parentId

    test::assertTrue(retainedParent != null)
    if retainedParent != null
      test::assertEqual(retainedParent, 30)
    end

    test::assertTrue(link(changes, rootHandle, branchHandle, "parent_id", RelationshipDeletePolicy.ClientCascade()) == null)
    test::assertTrue(link(changes, branchHandle, rootHandle, "other_id", RelationshipDeletePolicy.ClientCascade()) == null)
    test::assertTrue(removeCascade(changes, rootHandle) != null)
    test::assertTrue(survivor.parentId != null)
    let rootState = tracker.stateOf(root)
    let branchState = tracker.stateOf(branch)

    test::assertTrue(rootState != null && branchState != null)
    if rootState != null && branchState != null
      match rootState
        case TrackingState.Unchanged()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Deleted()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
      match branchState
        case TrackingState.Unchanged()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Deleted()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
    end
  end

  let requiredTracker = new EntityTracker<RequiredNullNode>("required_nodes", "id", requiredColumns(), captureRequired)
  let requiredChanges = new ChangeContext()
  let requiredRoot = new RequiredNullNode(40, 0)
  let requiredChild = new RequiredNullNode(41, 40)

  requiredChanges.register(requiredTracker.changeSet())
  match requiredTracker.attachWithHandle(requiredRoot)
    case TrackHandleResult.Tracked(principal)
      match requiredTracker.attachWithHandle(requiredChild)
        case TrackHandleResult.Tracked(dependent)
          let invalid = new ScalarRelationshipLink<RequiredNullNode, RequiredNullNode>(principal, dependent, requiredKey, requiredParent, setRequiredParent, ResultColumnKind.Int(), false, "parent_id", RelationshipDeletePolicy.ClientSetNull())

          test::assertTrue(requiredChanges.registerRelation(invalid.edge()) != null)
          test::assertEqual(requiredChild.parentId, 40)
        case TrackHandleResult.Failure(error)
          test::assertTrue(false)
      end
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
end

def main(): Void
  mixedAndRollback()
  preflightAndAdded()
  policyAndCycle()
end
