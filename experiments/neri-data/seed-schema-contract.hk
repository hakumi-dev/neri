use neri_data
use test

def seedModel(rows: SchemaSeed[], name: String = "records"): SchemaModel
  return new SchemaModel([new SchemaTable("records", name, [
          new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true)),
          new SchemaField("name", new SchemaColumn("label", SchemaType.Text()))
        ], seeds: rows)])
end

def modelSeedDiff(): Void
  let before = seedModel([new SchemaSeed(["id"], [Cell.Int(1)], ["name"], [Cell.Text("before")])])
  let after = seedModel([
      new SchemaSeed(["id"], [Cell.Int(2)], ["name"], [Cell.Text("new")]),
      new SchemaSeed(["id"], [Cell.Int(1)], ["name"], [Cell.Text("after")])
    ], "renamed")
  let canonical = seedModel([
      new SchemaSeed(["id"], [Cell.Int(1)], ["name"], [Cell.Text("after")]),
      new SchemaSeed(["id"], [Cell.Int(2)], ["name"], [Cell.Text("new")])
    ], "renamed")

  test::assertTrue(before.validate() == null)
  test::assertTrue(after.validate() == null)
  test::assertEqual(after.signature(), canonical.signature())
  var planned = false
  var updated = false
  var deleted = false

  match diffSchema("seed_update", before, after)
    case SchemaDiffResult.Plan(plan)
      planned = true
      let migration = plan.migration()
      let update = migration.upAt(1)
      let insert = migration.upAt(2)
      let deletion = migration.downAt(0)

      test::assertEqual(migration.upCount(), 3)
      test::assertEqual(migration.downCount(), 3)
      test::assertTrue(update != null)
      test::assertTrue(insert != null)
      test::assertTrue(deletion != null)
      if update != null
        match update
          case SchemaOp.UpdateData(table, keys, keyValues, columns, values)
            updated = true

            test::assertEqual(table, "renamed")
            test::assertEqual(columns[0], "label")
          case SchemaOp.InsertData(table, columns, values)
          case SchemaOp.DeleteData(table, keys, keyValues)
          case SchemaOp.CreateTable(table, columns)
          case SchemaOp.DropTable(table)
          case SchemaOp.AddColumn(table, column)
          case SchemaOp.DropColumn(table, column)
          case SchemaOp.RenameTable(from, to)
          case SchemaOp.RenameColumn(table, from, to)
          case SchemaOp.CreateIndex(name, table, columns, unique, indexFacets)
          case SchemaOp.Sql(statement)
          case SchemaOp.DropIndex(name)
          case SchemaOp.RebuildTable(from, to)
            test::assertTrue(false)
        end
      end
      if deletion != null
        match deletion
          case SchemaOp.DeleteData(table, keys, keyValues)
            deleted = true

            test::assertEqual(table, "renamed")
          case SchemaOp.InsertData(table, columns, values)
          case SchemaOp.UpdateData(table, keys, keyValues, columns, values)
          case SchemaOp.CreateTable(table, columns)
          case SchemaOp.DropTable(table)
          case SchemaOp.AddColumn(table, column)
          case SchemaOp.DropColumn(table, column)
          case SchemaOp.RenameTable(from, to)
          case SchemaOp.RenameColumn(table, from, to)
          case SchemaOp.CreateIndex(name, table, columns, unique, indexFacets)
          case SchemaOp.Sql(statement)
          case SchemaOp.DropIndex(name)
          case SchemaOp.RebuildTable(from, to)
            test::assertTrue(false)
        end
      end
    case SchemaDiffResult.Unchanged()
    case SchemaDiffResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(planned && updated && deleted)
  var unchanged = false

  match diffSchema("seed_same", after, canonical)
    case SchemaDiffResult.Unchanged()
      unchanged = true
    case SchemaDiffResult.Plan(plan)
    case SchemaDiffResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(unchanged)
  let invalid = seedModel([new SchemaSeed(["id"], [Cell.Null()], ["name"], [Cell.Text("bad")])])
  let duplicate = seedModel([
      new SchemaSeed(["id"], [Cell.Int(1)], ["name"], [Cell.Text("one")]),
      new SchemaSeed(["id"], [Cell.Int(1)], ["name"], [Cell.Text("two")])
    ])

  test::assertTrue(invalid.validate() != null)
  test::assertTrue(duplicate.validate() != null)
end

def main(): Void
  modelSeedDiff()
end
