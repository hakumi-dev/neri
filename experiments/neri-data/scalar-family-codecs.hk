namespace neri_data

def cellDateTimeOffset(value: DateTimeOffset): Cell
  return Cell.Text(value.toStorage())
end

## Key storage uses UTC identity and materializes with a zero offset.
def cellDateTimeOffsetKey(value: DateTimeOffset): Cell
  return Cell.Text(host::stringSlice(value.toStorage(), 0, 28))
end

def cellOptionalDateTimeOffsetKey(value: DateTimeOffset?): Cell
  return value == null ? Cell.Null() : cellDateTimeOffsetKey(value)
end

def decodeDateTimeOffsetKey(row: RawRow, column: String): DecodeResult<DateTimeOffset>
  let parse: fn(String): DateTimeOffset? = fn(text: String): DateTimeOffset? do
    let utc = DateTime.parse(text)

    return utc == null || utc.toText() != text ? null : DateTimeOffset.fromLocal(utc, 0)
  end

  return decodeTextScalar<DateTimeOffset>(row, column, parse, "UTC DateTimeOffset key")
end

def decodeNullableDateTimeOffsetKey(row: RawRow, column: String): DecodeResult<DateTimeOffset?>
  let parse: fn(String): DateTimeOffset? = fn(text: String): DateTimeOffset? do
    let utc = DateTime.parse(text)

    return utc == null || utc.toText() != text ? null : DateTimeOffset.fromLocal(utc, 0)
  end

  return decodeNullableTextScalar<DateTimeOffset>(row, column, parse, "UTC DateTimeOffset key")
end

def cellOptionalDateTimeOffset(value: DateTimeOffset?): Cell
  return value == null ? Cell.Null() : cellDateTimeOffset(value)
end

def initialDateTimeOffset(): DateTimeOffset
  return DateTimeOffset.minimum()
end

def decodeDateTimeOffset(row: RawRow, column: String): DecodeResult<DateTimeOffset>
  let parse: fn(String): DateTimeOffset? = fn(text: String): DateTimeOffset? do
    return DateTimeOffset.fromStorage(text)
  end

  return decodeTextScalar<DateTimeOffset>(row, column, parse, "DateTimeOffset")
end

def decodeNullableDateTimeOffset(row: RawRow, column: String): DecodeResult<DateTimeOffset?>
  let parse: fn(String): DateTimeOffset? = fn(text: String): DateTimeOffset? do
    return DateTimeOffset.fromStorage(text)
  end

  return decodeNullableTextScalar<DateTimeOffset>(row, column, parse, "DateTimeOffset")
end

def cellTimeSpan(value: TimeSpan): Cell
  return Cell.Int(value.ticks())
end

def cellOptionalTimeSpan(value: TimeSpan?): Cell
  return value == null ? Cell.Null() : cellTimeSpan(value)
end

def initialTimeSpan(): TimeSpan
  return TimeSpan.zero()
end

def decodeTimeSpan(row: RawRow, column: String): DecodeResult<TimeSpan>
  match decodeInt(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<TimeSpan>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<TimeSpan>.Value(TimeSpan.fromTicks(value))
  end
end

def decodeNullableTimeSpan(row: RawRow, column: String): DecodeResult<TimeSpan?>
  match decodeNullableInt(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<TimeSpan?>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<TimeSpan?>.Value(value == null ? null : TimeSpan.fromTicks(value))
  end
end

