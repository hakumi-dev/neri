use host
use clock
use console
namespace neri_data_recovery

@library("sqlite3")
@cabiImport("sqlite3_open_v2")
unsafe def sqliteOpen(path: Byte*, database: Void**, flags: Int32, vfs: Byte*?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_close")
unsafe def sqliteClose(database: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_exec")
unsafe def sqliteExec(database: Void*, sql: Byte*, callback: (cabi fn(Void*, Int32, Void**, Void**): Int32)?, argument: Void*?, message: Byte**?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_backup_init")
unsafe def sqliteBackupInit(destination: Void*, destinationName: Byte*, source: Void*, sourceName: Byte*): Void*?
end

@library("sqlite3")
@cabiImport("sqlite3_backup_step")
unsafe def sqliteBackupStep(backup: Void*, pages: Int32): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_backup_finish")
unsafe def sqliteBackupFinish(backup: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_sleep")
unsafe def sqliteSleep(milliseconds: Int32): Int32
end

@cabiExport("app_recovery_delete_journal")
unsafe def recoveryDeleteJournal(context: Void*, count: Int32, values: Void**, names: Void**): Int32
  let accepted = context as Int*

  if count == (1 as Int32)
    let text: Byte*? = values[0] as Byte*

    if text != null && text[0] == (100 as Byte) && text[1] == (101 as Byte) && text[2] == (108 as Byte) && text[3] == (101 as Byte) && text[4] == (116 as Byte) && text[5] == (101 as Byte) && text[6] == (0 as Byte)
      accepted[0] = accepted[0] + 1
    end
  end
  return 0 as Int32
end

def recoveryCreateDatabase(path: String): Bool
  let pathLength = host::stringByteLength(path)

  if pathLength == 0 || pathLength > 2147483646
    return false
  end
  unsafe
    let pathBytes = native::alloc<Byte>(pathLength + 1)
    var index = 0

    while index < pathLength
      let byte = host::stringByteAt(path, index)

      if byte == (0 as Byte)
        native::free(pathBytes)
        return false
      end
      pathBytes[index] = byte
      index = index + 1
    end
    pathBytes[pathLength] = 0 as Byte
    let database = stackalloc Void*[1]
    let opened = sqliteOpen(pathBytes, database, 6 as Int32, null)

    native::free(pathBytes)
    if opened != (0 as Int32)
      let partial: Void*? = database[0]

      if partial != null
        sqliteClose(partial)
      end
      return false
    end
    let sql = "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, active INTEGER NOT NULL, nickname TEXT);"
    let sqlLength = host::stringByteLength(sql)
    let sqlBytes = native::alloc<Byte>(sqlLength + 1)

    index = 0

    while index < sqlLength
      sqlBytes[index] = host::stringByteAt(sql, index)
      index = index + 1
    end
    sqlBytes[sqlLength] = 0 as Byte
    let executed = sqliteExec(database[0], sqlBytes, null, null, null)

    native::free(sqlBytes)
    let closed = sqliteClose(database[0])

    return executed == (0 as Int32) && closed == (0 as Int32)
  end
end

def recoveryBackup(sourcePath: String, destinationPath: String): Bool
  let sourceLength = host::stringByteLength(sourcePath)
  let destinationLength = host::stringByteLength(destinationPath)

  if sourceLength == 0 || destinationLength == 0 || sourceLength > 2147483646 || destinationLength > 2147483646
    return false
  end
  unsafe
    let sourceBytes = native::alloc<Byte>(sourceLength + 1)
    let destinationBytes = native::alloc<Byte>(destinationLength + 1)
    var index = 0

    while index < sourceLength
      let byte = host::stringByteAt(sourcePath, index)

      if byte == (0 as Byte)
        native::free(sourceBytes)
        native::free(destinationBytes)
        return false
      end
      sourceBytes[index] = byte
      index = index + 1
    end
    sourceBytes[sourceLength] = 0 as Byte
    index = 0

    while index < destinationLength
      let byte = host::stringByteAt(destinationPath, index)

      if byte == (0 as Byte)
        native::free(sourceBytes)
        native::free(destinationBytes)
        return false
      end
      destinationBytes[index] = byte
      index = index + 1
    end
    destinationBytes[destinationLength] = 0 as Byte
    let source = stackalloc Void*[1]
    let destination = stackalloc Void*[1]
    let sourceOpened = sqliteOpen(sourceBytes, source, 1 as Int32, null)
    let destinationOpened = sqliteOpen(destinationBytes, destination, 6 as Int32, null)

    native::free(sourceBytes)
    native::free(destinationBytes)
    if sourceOpened != (0 as Int32) || destinationOpened != (0 as Int32)
      let partialSource: Void*? = source[0]
      let partialDestination: Void*? = destination[0]

      if partialSource != null
        sqliteClose(partialSource)
      end
      if partialDestination != null
        sqliteClose(partialDestination)
      end
      return false
    end
    let mainName = [109 as Byte, 97 as Byte, 105 as Byte, 110 as Byte, 0 as Byte]
    var backup: Void*? = null

    borrow mainName as pointer
      backup = sqliteBackupInit(destination[0], pointer, source[0], pointer)
    end
    var copied = false
    var stepStatus = -1 as Int32
    var finishStatus = -1 as Int32

    if backup != null
      let started = clock::milliseconds()
      var stepped = 0 as Int32
      var copying = started != null

      while copying && stepped != (101 as Int32)
        stepped = sqliteBackupStep(backup, 64 as Int32)

        if stepped != (0 as Int32) && stepped != (5 as Int32) && stepped != (6 as Int32) && stepped != (101 as Int32)
          copying = false
        else
          let now = clock::milliseconds()

          if now == null || started == null || now - started >= 5000
            copying = false
          else if stepped == (5 as Int32) || stepped == (6 as Int32)
            sqliteSleep(10 as Int32)
          end
        end
      end
      let finished = sqliteBackupFinish(backup)

      stepStatus = stepped
      finishStatus = finished
      copied = stepped == (101 as Int32) && finished == (0 as Int32)
    end
    if copied
      # Publish a standalone offline snapshot, including when the source uses WAL.
      let sql = "PRAGMA journal_mode=DELETE;"
      let length = host::stringByteLength(sql)
      let bytes = native::alloc<Byte>(length + 1)
      var index = 0

      while index < length
        bytes[index] = host::stringByteAt(sql, index)
        index = index + 1
      end
      bytes[length] = 0 as Byte
      let accepted = stackalloc Int[1]

      accepted[0] = 0
      let normalized = sqliteExec(destination[0], bytes, recoveryDeleteJournal, accepted as Void*, null)

      native::free(bytes)
      copied = normalized == (0 as Int32) && accepted[0] == 1
    end
    let destinationClosed = sqliteClose(destination[0])
    let sourceClosed = sqliteClose(source[0])

    if !copied || destinationClosed != (0 as Int32) || sourceClosed != (0 as Int32)
      console::println("backup failed: step=" + ((stepStatus as Int) as String) + " finish=" + ((finishStatus as Int) as String) + " source-close=" + ((sourceClosed as Int) as String) + " destination-close=" + ((destinationClosed as Int) as String))
    end
    return copied && destinationClosed == (0 as Int32) && sourceClosed == (0 as Int32)
  end
end

def recoveryPause(milliseconds: Int): Void
  unsafe
    sqliteSleep(milliseconds as Int32)
  end
end
