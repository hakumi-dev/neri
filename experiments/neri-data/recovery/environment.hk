use console
use neri_data
use neri_data_sqlite

def main(): Void
  unsafe
    let version = sqliteVersionNumber()
    let threadsafe = sqliteThreadSafe()

    console::println("SQLite runtime version=" + ((version as Int) as String) + " threadsafe=" + ((threadsafe as Int) as String))
    if !sqliteWalResetSafeVersion(version)
      console::println(providerFailureMessage(sqliteWalResetFailure()))
    end

    test::assertTrue(sqliteWalResetSafeVersion(version))
    test::assertTrue(threadsafe != (0 as Int32))
  end
end
