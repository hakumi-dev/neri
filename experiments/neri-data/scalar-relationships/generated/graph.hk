        return neri_data::GraphVisitResult<scalar_model::RequiredItem>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<scalar_model::RequiredItem>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_RequiredItem)

        if staged != null
