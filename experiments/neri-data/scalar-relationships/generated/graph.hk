use reference
namespace scalar_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_ScalarDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Group: neri_data::EntityTracker<scalar_model::Group>
  private visits_Group: neri_data::GraphVisitList<scalar_model::Group>
  private tracker_Code: neri_data::EntityTracker<scalar_model::Code>
  private visits_Code: neri_data::GraphVisitList<scalar_model::Code>
  private tracker_RequiredItem: neri_data::EntityTracker<scalar_model::RequiredItem>
  private visits_RequiredItem: neri_data::GraphVisitList<scalar_model::RequiredItem>
  private tracker_OptionalItem: neri_data::EntityTracker<scalar_model::OptionalItem>
  private visits_OptionalItem: neri_data::GraphVisitList<scalar_model::OptionalItem>
  private tracker_RequiredTag: neri_data::EntityTracker<scalar_model::RequiredTag>
  private visits_RequiredTag: neri_data::GraphVisitList<scalar_model::RequiredTag>
  private tracker_OptionalTag: neri_data::EntityTracker<scalar_model::OptionalTag>
  private visits_OptionalTag: neri_data::GraphVisitList<scalar_model::OptionalTag>

  def init(changes: neri_data::ChangeContext, tracker_Group: neri_data::EntityTracker<scalar_model::Group>, tracker_Code: neri_data::EntityTracker<scalar_model::Code>, tracker_RequiredItem: neri_data::EntityTracker<scalar_model::RequiredItem>, tracker_OptionalItem: neri_data::EntityTracker<scalar_model::OptionalItem>, tracker_RequiredTag: neri_data::EntityTracker<scalar_model::RequiredTag>, tracker_OptionalTag: neri_data::EntityTracker<scalar_model::OptionalTag>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Group = tracker_Group
    this.visits_Group = new neri_data::GraphVisitList<scalar_model::Group>(this.graph)
    this.tracker_Code = tracker_Code
    this.visits_Code = new neri_data::GraphVisitList<scalar_model::Code>(this.graph)
    this.tracker_RequiredItem = tracker_RequiredItem
    this.visits_RequiredItem = new neri_data::GraphVisitList<scalar_model::RequiredItem>(this.graph)
    this.tracker_OptionalItem = tracker_OptionalItem
    this.visits_OptionalItem = new neri_data::GraphVisitList<scalar_model::OptionalItem>(this.graph)
    this.tracker_RequiredTag = tracker_RequiredTag
    this.visits_RequiredTag = new neri_data::GraphVisitList<scalar_model::RequiredTag>(this.graph)
    this.tracker_OptionalTag = tracker_OptionalTag
    this.visits_OptionalTag = new neri_data::GraphVisitList<scalar_model::OptionalTag>(this.graph)
  end

  def add_groups(root: scalar_model::Group): neri_data::TrackHandleResult<scalar_model::Group>
    match this.discover_groups(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<scalar_model::Group>.Failure(error)
    end
  end

  private def discover_groups(entity: scalar_model::Group): neri_data::GraphVisitResult<scalar_model::Group>
    match this.visits_Group.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<scalar_model::Group>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<scalar_model::Group>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Group)

        if staged != null
          return neri_data::GraphVisitResult<scalar_model::Group>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_groups(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<scalar_model::Group>.Failure(queued)
        end
        return neri_data::GraphVisitResult<scalar_model::Group>.New(slot)
    end
  end

  private def scan_groups(entity: scalar_model::Group, owner: neri_data::GraphSlot<scalar_model::Group>): neri_data::QueryFailure?
    return null
  end

  def add_codes(root: scalar_model::Code): neri_data::TrackHandleResult<scalar_model::Code>
    match this.discover_codes(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<scalar_model::Code>.Failure(error)
    end
  end

  private def discover_codes(entity: scalar_model::Code): neri_data::GraphVisitResult<scalar_model::Code>
    match this.visits_Code.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<scalar_model::Code>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<scalar_model::Code>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Code)

        if staged != null
          return neri_data::GraphVisitResult<scalar_model::Code>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_codes(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<scalar_model::Code>.Failure(queued)
        end
        return neri_data::GraphVisitResult<scalar_model::Code>.New(slot)
    end
  end

  private def scan_codes(entity: scalar_model::Code, owner: neri_data::GraphSlot<scalar_model::Code>): neri_data::QueryFailure?
    return null
  end

