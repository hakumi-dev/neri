use console
use files
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use resources
use result
use scalar_data
use scalar_model
use test

def tracked<T>(result: TrackHandleResult<T>): TrackedHandle<T>?
  match result
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def saved(result: WriteResult, count: Int): Void
  match result
    case WriteResult.Saved(actual)
      test::assertEqual(actual, count)
    case WriteResult.SavedWithValues(actual, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def checkFailed(result: WriteResult): Void
  match result
    case WriteResult.Saved(actual)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(actual, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertEqual(writeFailureMessage(error), "SQLite step failed (code 275): CHECK constraint failed: name != 'rejected'")
  end
end

def optionalInt(actual: Int?, expected: Int): Void
  test::assertTrue(actual != null)
  if actual != null
    test::assertEqual(actual, expected)
  end
end

def optionalString(actual: String?, expected: String): Void
  test::assertTrue(actual != null)
  if actual != null
    test::assertEqual(actual, expected)
  end
end

def intCounts(provider: SQLiteProvider, groups: Int, required: Int, optional: Int): Void
  let read = new ScalarDatabase(provider)

  match read.groups.count()
    case QueryValue.Value(value)
      test::assertEqual(value, groups)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.requiredItems.count()
    case QueryValue.Value(value)
      test::assertEqual(value, required)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalItems.count()
    case QueryValue.Value(value)
      test::assertEqual(value, optional)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def stringCounts(provider: SQLiteProvider, codes: Int, required: Int, optional: Int): Void
  let read = new ScalarDatabase(provider)

  match read.codes.count()
    case QueryValue.Value(value)
      test::assertEqual(value, codes)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.requiredTags.count()
    case QueryValue.Value(value)
      test::assertEqual(value, required)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalTags.count()
    case QueryValue.Value(value)
      test::assertEqual(value, optional)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyGeneratedInt(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let group = new Group(0, "first")
  let required = new RequiredItem(0, 0, "required")
  let optional = new OptionalItem(0, null, "rejected")
  let g = tracked(db.groups.addWithHandle(group))
  let r = tracked(db.requiredItems.addWithHandle(required))
  let o = tracked(db.optionalItems.addWithHandle(optional))

  test::assertTrue(g != null && r != null && o != null)
  if g == null || r == null || o == null
    return
  end
  let temporary = group.id
  let temporaryRequired = required.id
  let temporaryOptional = optional.id

  test::assertTrue(temporary < 0 && temporaryRequired < 0 && temporaryOptional < 0)
  test::assertTrue(db.link_requiredItemsFor_Group_by_groupId(g, r) == null)
  test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(g, o) == null)
  test::assertEqual(required.groupId, temporary)
  optionalInt(optional.groupId, temporary)
  checkFailed(db.saveChanges())
  intCounts(provider, 0, 0, 0)

  test::assertEqual(group.id, temporary)
  test::assertEqual(required.id, temporaryRequired)
  test::assertEqual(optional.id, temporaryOptional)
  test::assertEqual(required.groupId, temporary)
  optionalInt(optional.groupId, temporary)

  test::assertEqual(optional.name, "rejected")
  optional.name = "accepted"
  saved(db.saveChanges(), 3)
  intCounts(provider, 1, 1, 1)

  test::assertTrue(group.id > 0 && required.id > 0 && optional.id > 0)
  test::assertEqual(required.groupId, group.id)
  optionalInt(optional.groupId, group.id)
  let read = new ScalarDatabase(provider)

  match read.optionalItems.where(id: optional.id).single()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      optionalInt(value.groupId, group.id)
  end
  let free = new OptionalItem(0, null, "unlinked")

  test::assertTrue(db.optionalItems.add(free) == null)
  saved(db.saveChanges(), 1)
  let readUnlinked = new ScalarDatabase(provider)

  match readUnlinked.optionalItems.where(id: free.id).single()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value.groupId == null)
  end
  let other = new Group(0, "other")
  let h = tracked(db.groups.addWithHandle(other))

  test::assertTrue(h != null)
  if h != null
    test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(h, o) != null)
    optionalInt(optional.groupId, group.id)
  end
  let foreign = new ScalarDatabase(provider)
  let foreignGroup = new Group(0, "foreign")
  let foreignHandle = tracked(foreign.groups.addWithHandle(foreignGroup))

  test::assertTrue(foreignHandle != null)
  if foreignHandle != null
    test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(foreignHandle, o) != null)
    optionalInt(optional.groupId, group.id)
  end

  test::assertTrue(db.groups.detach(other) == null)
  test::assertTrue(db.groups.remove(group) == null)
  test::assertTrue(db.optionalItems.remove(optional) == null)
  test::assertTrue(db.requiredItems.remove(required) == null)
  saved(db.saveChanges(), 3)
  intCounts(provider, 0, 0, 1)
end

def verifyStrings(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let key = "O'Reilly; DROP TABLE codes; -- 水"
  let code = new Code(key)
  let required = new RequiredTag(0, "wrong")
  let optional = new OptionalTag(0, null)
  let c = tracked(db.codes.addWithHandle(code))
  let r = tracked(db.requiredTags.addWithHandle(required))
  let o = tracked(db.optionalTags.addWithHandle(optional))

  test::assertTrue(c != null && r != null && o != null)
  if c == null || r == null || o == null
    return
  end

  test::assertTrue(db.link_requiredTagsFor_Code_by_codeValue(c, r) == null)
  test::assertTrue(db.link_optionalTagsFor_Code_by_codeValue(c, o) == null)
  test::assertEqual(required.codeValue, key)
  optionalString(optional.codeValue, key)
  saved(db.saveChanges(), 3)
  stringCounts(provider, 1, 1, 1)
  let read = new ScalarDatabase(provider)

  match read.requiredTags.where(id: required.id).single()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      optionalString(value.codeValue, key)
  end
  match read.optionalTags.where(id: optional.id).single()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      optionalString(value.codeValue, key)
  end
  let free = new OptionalTag(0, null)

  test::assertTrue(db.optionalTags.add(free) == null)
  saved(db.saveChanges(), 1)
  let readUnlinked = new ScalarDatabase(provider)

  match readUnlinked.optionalTags.where(id: free.id).single()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value.codeValue == null)
  end

  test::assertTrue(db.codes.remove(code) == null)
  test::assertTrue(db.requiredTags.remove(required) == null)
  test::assertTrue(db.optionalTags.remove(optional) == null)
  saved(db.saveChanges(), 3)
  stringCounts(provider, 0, 0, 1)
end

def verifyOuterRollback(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let group = new Group(0, "outer")
  let optional = new OptionalItem(0, null, "outer")
  let g = tracked(db.groups.addWithHandle(group))
  let o = tracked(db.optionalItems.addWithHandle(optional))

  test::assertTrue(g != null && o != null)
  if g == null || o == null
    return
  end
  let temporary = group.id

  test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(g, o) == null)
  saved(db.beginTransaction(), 0)
  saved(db.saveChanges(), 2)

  test::assertTrue(group.id > 0)
  optionalInt(optional.groupId, group.id)
  optional.name = "second save"
  saved(db.saveChanges(), 1)
  saved(db.rollbackTransaction(), 0)
  intCounts(provider, 0, 0, 1)

  test::assertEqual(group.id, temporary)
  optionalInt(optional.groupId, temporary)

  test::assertEqual(optional.name, "second save")
  saved(db.saveChanges(), 2)

  test::assertTrue(group.id > 0)
  optionalInt(optional.groupId, group.id)
end

def verifyUnlink(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let group = new Group(0, "unlink")
  let item = new OptionalItem(0, null, "unlink")
  let code = new Code("unlink; O'Reilly 水")
  let tag = new OptionalTag(0, null)
  let g = tracked(db.groups.addWithHandle(group))
  let i = tracked(db.optionalItems.addWithHandle(item))
  let c = tracked(db.codes.addWithHandle(code))
  let t = tracked(db.optionalTags.addWithHandle(tag))

  test::assertTrue(g != null && i != null && c != null && t != null)
  if g == null || i == null || c == null || t == null
    return
  end

  test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(g, i) == null)
  test::assertTrue(db.link_optionalTagsFor_Code_by_codeValue(c, t) == null)
  saved(db.saveChanges(), 4)

  optionalInt(item.groupId, group.id)
  optionalString(tag.codeValue, code.value)

  test::assertTrue(db.unlink_optionalItemsFor_Group_by_groupId(i) == null)
  test::assertTrue(db.unlink_optionalTagsFor_Code_by_codeValue(t) == null)
  test::assertTrue(item.groupId == null && tag.codeValue == null)
  saved(db.beginTransaction(), 0)
  saved(db.commitTransaction(), 0)

  test::assertTrue(db.groups.remove(group) == null)
  test::assertTrue(db.codes.remove(code) == null)
  saved(db.saveChanges(), 4)
  let read = new ScalarDatabase(provider)

  match read.groups.where(id: group.id).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.codes.where(value: code.value).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalItems.where(id: item.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.groupId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalTags.where(id: tag.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.codeValue == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyReassign(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let old = new Group(0, "old")
  let child = new RequiredItem(0, 0, "child")
  let oldHandle = tracked(db.groups.addWithHandle(old))
  let childHandle = tracked(db.requiredItems.addWithHandle(child))

  test::assertTrue(oldHandle != null && childHandle != null)
  if oldHandle == null || childHandle == null
    return
  end

  test::assertTrue(db.link_requiredItemsFor_Group_by_groupId(oldHandle, childHandle) == null)
  saved(db.saveChanges(), 2)
  let oldId = old.id
  let replacement = new Group(0, "replacement")
  let replacementHandle = tracked(db.groups.addWithHandle(replacement))
  let rejected = new OptionalItem(0, null, "rejected")

  test::assertTrue(replacementHandle != null)
  if replacementHandle == null
    return
  end
  let temporary = replacement.id

  test::assertTrue(db.reassign_requiredItemsFor_Group_by_groupId(replacementHandle, childHandle) == null)
  test::assertEqual(child.groupId, temporary)
  saved(db.beginTransaction(), 0)
  saved(db.commitTransaction(), 0)

  test::assertTrue(db.groups.remove(old) == null)
  test::assertTrue(db.optionalItems.add(rejected) == null)
  checkFailed(db.saveChanges())
  let read = new ScalarDatabase(provider)

  test::assertEqual(replacement.id, temporary)
  test::assertEqual(child.groupId, temporary)
  test::assertEqual(rejected.name, "rejected")
  match read.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.requiredItems.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.groupId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  rejected.name = "accepted"
  saved(db.saveChanges(), 4)
  let afterRetry = new ScalarDatabase(provider)

  test::assertTrue(replacement.id > 0)
  test::assertEqual(child.groupId, replacement.id)
  match afterRetry.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match afterRetry.requiredItems.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.groupId, replacement.id)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let foreign = new ScalarDatabase(provider)
  let foreignGroup = new Group(0, "foreign")
  let foreignHandle = tracked(foreign.groups.addWithHandle(foreignGroup))

  test::assertTrue(foreignHandle != null)
  if foreignHandle != null
    test::assertTrue(db.reassign_requiredItemsFor_Group_by_groupId(foreignHandle, childHandle) != null)
    test::assertEqual(child.groupId, replacement.id)
  end
  let stale = new Group(0, "stale")
  let staleHandle = tracked(db.groups.addWithHandle(stale))

  test::assertTrue(staleHandle != null)
  if staleHandle != null
    test::assertTrue(db.groups.detach(stale) == null)
    test::assertTrue(db.reassign_requiredItemsFor_Group_by_groupId(staleHandle, childHandle) != null)
    test::assertEqual(child.groupId, replacement.id)
  end
end

def verifyStringReassign(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let old = new Code("old; 水")
  let replacement = new Code("new; O'Reilly 水")
  let required = new RequiredTag(0, "unassigned")
  let optional = new OptionalTag(0, null)
  let a = tracked(db.codes.addWithHandle(old))
  let b = tracked(db.codes.addWithHandle(replacement))
  let r = tracked(db.requiredTags.addWithHandle(required))
  let o = tracked(db.optionalTags.addWithHandle(optional))

  test::assertTrue(a != null && b != null && r != null && o != null)
  if a == null || b == null || r == null || o == null
    return
  end

  test::assertTrue(db.link_requiredTagsFor_Code_by_codeValue(a, r) == null)
  test::assertTrue(db.link_optionalTagsFor_Code_by_codeValue(a, o) == null)
  saved(db.saveChanges(), 4)

  test::assertTrue(db.reassign_requiredTagsFor_Code_by_codeValue(b, r) == null)
  test::assertTrue(db.reassign_optionalTagsFor_Code_by_codeValue(b, o) == null)
  test::assertEqual(required.codeValue, replacement.value)
  optionalString(optional.codeValue, replacement.value)

  test::assertTrue(db.codes.remove(old) == null)
  saved(db.saveChanges(), 3)
  let read = new ScalarDatabase(provider)

  match read.requiredTags.where(id: required.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.codeValue, replacement.value)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalTags.where(id: optional.id).single()
    case QueryValue.Value(value)
      optionalString(value.codeValue, replacement.value)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyReassignOuterRollback(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let old = new Group(0, "old outer")
  let child = new RequiredItem(0, 0, "outer child")
  let optional = new OptionalItem(0, null, "outer optional")
  let a = tracked(db.groups.addWithHandle(old))
  let r = tracked(db.requiredItems.addWithHandle(child))
  let o = tracked(db.optionalItems.addWithHandle(optional))

  test::assertTrue(a != null && r != null && o != null)
  if a == null || r == null || o == null
    return
  end

  test::assertTrue(db.link_requiredItemsFor_Group_by_groupId(a, r) == null)
  test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(a, o) == null)
  saved(db.saveChanges(), 3)
  let oldId = old.id
  let replacement = new Group(0, "new outer")
  let b = tracked(db.groups.addWithHandle(replacement))

  test::assertTrue(b != null)
  if b == null
    return
  end
  let temporary = replacement.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.reassign_requiredItemsFor_Group_by_groupId(b, r) == null)
  test::assertTrue(db.unlink_optionalItemsFor_Group_by_groupId(o) == null)
  test::assertTrue(optional.groupId == null)
  test::assertTrue(db.groups.remove(old) == null)
  saved(db.saveChanges(), 4)

  test::assertTrue(replacement.id > 0)
  test::assertEqual(child.groupId, replacement.id)
  child.name = "second outer save"
  saved(db.saveChanges(), 1)
  saved(db.rollbackTransaction(), 0)
  let read = new ScalarDatabase(provider)

  test::assertEqual(replacement.id, temporary)
  test::assertEqual(child.groupId, temporary)
  test::assertEqual(child.name, "second outer save")
  test::assertTrue(optional.groupId == null)
  match read.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.requiredItems.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.groupId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalItems.where(id: optional.id).single()
    case QueryValue.Value(value)
      optionalInt(value.groupId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  saved(db.saveChanges(), 4)
  let afterRetry = new ScalarDatabase(provider)

  test::assertTrue(replacement.id > 0)
  test::assertEqual(child.groupId, replacement.id)
  test::assertTrue(optional.groupId == null)
  match afterRetry.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match afterRetry.optionalItems.where(id: optional.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.groupId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyReassignSavepointRecovery(provider: SQLiteProvider): Void
  let db = new ScalarDatabase(provider)
  let old = new Group(0, "old savepoint")
  let child = new RequiredItem(0, 0, "required savepoint")
  let optional = new OptionalItem(0, null, "optional savepoint")
  let a = tracked(db.groups.addWithHandle(old))
  let r = tracked(db.requiredItems.addWithHandle(child))
  let o = tracked(db.optionalItems.addWithHandle(optional))

  test::assertTrue(a != null && r != null && o != null)
  if a == null || r == null || o == null
    return
  end

  test::assertTrue(db.link_requiredItemsFor_Group_by_groupId(a, r) == null)
  test::assertTrue(db.link_optionalItemsFor_Group_by_groupId(a, o) == null)
  saved(db.saveChanges(), 3)
  let oldId = old.id
  let accepted = new Group(0, "earlier accepted")

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.groups.add(accepted) == null)
  saved(db.saveChanges(), 1)

  test::assertTrue(accepted.id > 0)
  let acceptedId = accepted.id
  let replacement = new Group(0, "new savepoint")
  let b = tracked(db.groups.addWithHandle(replacement))
  let rejected = new OptionalItem(0, null, "rejected")

  test::assertTrue(b != null)
  if b == null
    return
  end
  let temporary = replacement.id

  test::assertTrue(db.reassign_requiredItemsFor_Group_by_groupId(b, r) == null)
  test::assertTrue(db.unlink_optionalItemsFor_Group_by_groupId(o) == null)
  test::assertTrue(db.groups.remove(old) == null)
  test::assertTrue(db.optionalItems.add(rejected) == null)
  let rejectedAssignedTemporary = rejected.id

  checkFailed(db.saveChanges())
  let read = new ScalarDatabase(provider)

  test::assertEqual(accepted.id, acceptedId)
  test::assertEqual(replacement.id, temporary)
  test::assertEqual(rejected.id, rejectedAssignedTemporary)
  test::assertEqual(child.groupId, temporary)
  test::assertTrue(optional.groupId == null)
  match read.groups.where(id: acceptedId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.requiredItems.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.groupId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.optionalItems.where(id: optional.id).single()
    case QueryValue.Value(value)
      optionalInt(value.groupId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  rejected.name = "accepted retry"
  saved(db.saveChanges(), 5)
  saved(db.commitTransaction(), 0)
  let committed = new ScalarDatabase(provider)

  test::assertEqual(accepted.id, acceptedId)
  test::assertTrue(replacement.id > 0)
  test::assertEqual(child.groupId, replacement.id)
  test::assertTrue(optional.groupId == null)
  match committed.groups.where(id: oldId).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match committed.requiredItems.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.groupId, replacement.id)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match committed.optionalItems.where(id: optional.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.groupId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-scalar-relationships-")
    let path = temporary.path() + "/scalar.sqlite"
    let schema = "CREATE TABLE groups(id INTEGER PRIMARY KEY,name TEXT NOT NULL); CREATE TABLE required_items(id INTEGER PRIMARY KEY,group_id INTEGER NOT NULL REFERENCES groups(id),name TEXT NOT NULL); CREATE TABLE optional_items(id INTEGER PRIMARY KEY,group_id INTEGER REFERENCES groups(id),name TEXT NOT NULL CHECK(name != 'rejected')); CREATE TABLE codes(value TEXT PRIMARY KEY); CREATE TABLE required_tags(id INTEGER PRIMARY KEY,code_value TEXT NOT NULL REFERENCES codes(value)); CREATE TABLE optional_tags(id INTEGER PRIMARY KEY,code_value TEXT REFERENCES codes(value));"

    test::assertTrue(createSQLiteFixture(path, schema))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyGeneratedInt(provider)
        verifyStrings(provider)
        verifyOuterRollback(provider)

        test::assertTrue(provider.close())
    end
    let unlinkPath = temporary.path() + "/unlink.sqlite"
    let reassignPath = temporary.path() + "/reassign.sqlite"
    let stringPath = temporary.path() + "/string-reassign.sqlite"
    let outerPath = temporary.path() + "/outer-reassign.sqlite"
    let recoveryPath = temporary.path() + "/savepoint-recovery.sqlite"

    test::assertTrue(createSQLiteFixture(unlinkPath, schema))
    test::assertTrue(createSQLiteFixture(reassignPath, schema))
    test::assertTrue(createSQLiteFixture(stringPath, schema))
    test::assertTrue(createSQLiteFixture(outerPath, schema))
    test::assertTrue(createSQLiteFixture(recoveryPath, schema))
    match SQLiteProvider.openWritable(unlinkPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyUnlink(provider)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.openWritable(reassignPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyReassign(provider)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.openWritable(stringPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyStringReassign(provider)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.openWritable(outerPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyReassignOuterRollback(provider)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.openWritable(recoveryPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyReassignSavepointRecovery(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFiles()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("Scalar relationship contract passed")
end
