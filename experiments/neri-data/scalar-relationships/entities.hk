namespace scalar_model

class Group
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class RequiredItem
  public id: Int
  public groupId: Int
  public name: String

  def init(id: Int, groupId: Int, name: String): Void
    this.id = id
    this.groupId = groupId
    this.name = name
  end
end

class OptionalItem
  public id: Int
  public groupId: Int?
  public name: String

  def init(id: Int, groupId: Int?, name: String): Void
    this.id = id
    this.groupId = groupId
    this.name = name
  end
end

class Code
  public value: String

  def init(value: String): Void
    this.value = value
  end
end

class RequiredTag
  public id: Int
  public codeValue: String

  def init(id: Int, codeValue: String): Void
    this.id = id
    this.codeValue = codeValue
  end
end

class OptionalTag
  public id: Int
  public codeValue: String?

  def init(id: Int, codeValue: String?): Void
    this.id = id
    this.codeValue = codeValue
  end
end
