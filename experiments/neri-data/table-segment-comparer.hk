namespace neri_data

def tableSegmentOverlay(baseline: RawRow, local: RawRow): RawRow
  let columns: RawColumn[] = tasks::generate(baseline.count(), 1) do |index|
    let column = baseline.at(index)

    if column == null
      return new RawColumn("", Cell.Null())
    end
    let replacement = cellFromRow(local, column.name)
    let prior = cellFromRow(baseline, column.name)

    return new RawColumn(column.name, replacement == null ? (prior == null ? Cell.Null() : prior) : replacement)
  end

  return new RawRow(columns)
end

## Restricts a root comparer to local table values while holding other fields at their original snapshot.
def tableSegmentComparer<B>(
  roots: EntityTracker<B>,
  keys: String[],
  comparer: fn(RawRow, RawRow): Bool
): fn(
  RawRow,
  RawRow
): Bool
  let equal: fn(RawRow, RawRow): Bool = fn(left: RawRow, right: RawRow): Bool do
    let state = new ModelCallbackState()
    let target = compositeKeyCell(left, keys)
    let visit: fn(B): Bool = fn(entity: B): Bool do
      let original = roots.original(entity)

      if original != null && navigationTupleRowMatches(original, keys, target)
        state.snapshot = original
        return false
      end
      return true
    end

    roots.visitTracked(visit)
    let baseline = state.snapshot

    return baseline != null && comparer(tableSegmentOverlay(baseline, left), tableSegmentOverlay(baseline, right))
  end

  return equal
end
