namespace graph_data

## Describes the mapped tables and columns for schema comparison.
def schema_GraphDatabase(): neri_data::SchemaModel
  return new neri_data::SchemaModel([
      new neri_data::SchemaTable("graph_model.Book", "books", [
          new neri_data::SchemaField("graph_model.Book.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("graph_model.Book.authorId", new neri_data::SchemaColumn("author_id", neri_data::SchemaType.Int(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("graph_model.Book.title", new neri_data::SchemaColumn("title", neri_data::SchemaType.Text(), nullable: false, primaryKey: false))
        ]),
      new neri_data::SchemaTable("graph_model.Author", "authors", [
          new neri_data::SchemaField("graph_model.Author.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("graph_model.Author.name", new neri_data::SchemaColumn("name", neri_data::SchemaType.Text(), nullable: false, primaryKey: false))
        ])
    ])
end
