use reference
namespace graph_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_GraphDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Book: neri_data::EntityTracker<graph_model::Book>
  private visits_Book: neri_data::GraphVisitList<graph_model::Book>
  private tracker_Author: neri_data::EntityTracker<graph_model::Author>
  private visits_Author: neri_data::GraphVisitList<graph_model::Author>

  def init(changes: neri_data::ChangeContext, tracker_Book: neri_data::EntityTracker<graph_model::Book>, tracker_Author: neri_data::EntityTracker<graph_model::Author>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Book = tracker_Book
    this.visits_Book = new neri_data::GraphVisitList<graph_model::Book>(this.graph)
    this.tracker_Author = tracker_Author
    this.visits_Author = new neri_data::GraphVisitList<graph_model::Author>(this.graph)
  end

  def add_books(root: graph_model::Book): neri_data::TrackHandleResult<graph_model::Book>
    match this.discover_books(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<graph_model::Book>.Failure(error)
    end
  end

  private def discover_books(entity: graph_model::Book): neri_data::GraphVisitResult<graph_model::Book>
    match this.visits_Book.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<graph_model::Book>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<graph_model::Book>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Book)

        if staged != null
          return neri_data::GraphVisitResult<graph_model::Book>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_books(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<graph_model::Book>.Failure(queued)
        end
        return neri_data::GraphVisitResult<graph_model::Book>.New(slot)
    end
  end

  private def scan_books(entity: graph_model::Book, owner: neri_data::GraphSlot<graph_model::Book>): neri_data::QueryFailure?
    return null
  end

  def add_authors(root: graph_model::Author): neri_data::TrackHandleResult<graph_model::Author>
    match this.discover_authors(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<graph_model::Author>.Failure(error)
    end
  end

  private def discover_authors(entity: graph_model::Author): neri_data::GraphVisitResult<graph_model::Author>
    match this.visits_Author.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<graph_model::Author>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<graph_model::Author>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Author)

        if staged != null
          return neri_data::GraphVisitResult<graph_model::Author>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_authors(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<graph_model::Author>.Failure(queued)
        end
        return neri_data::GraphVisitResult<graph_model::Author>.New(slot)
    end
  end

  private def scan_authors(entity: graph_model::Author, owner: neri_data::GraphSlot<graph_model::Author>): neri_data::QueryFailure?
    return null
  end
end
