use test
use console
use files
use resources
use result
use graph_data
use graph_model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failed(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(writeFailureMessage(error) != "")
  end
end

def authorHandle(db: GraphDatabase, author: Author): TrackedHandle<Author>?
  match db.authors.addWithHandle(author)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def bookHandle(db: GraphDatabase, book: Book): TrackedHandle<Book>?
  match db.books.addWithHandle(book)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def counts(provider: SQLiteProvider, authors: Int, books: Int): Void
  let db = new GraphDatabase(provider)

  match db.authors.count()
    case QueryValue.Value(value)
      test::assertEqual(value, authors)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.books.count()
    case QueryValue.Value(value)
      test::assertEqual(value, books)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyGraph(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let author = new Author(0, "author")
  let book = new Book(0, 0, "rejected")
  let a = authorHandle(db, author)
  let b = bookHandle(db, book)

  if a == null
    return
  end
  if b == null
    return
  end

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) == null)
  test::assertEqual(book.authorId, author.id)
  let temporaryAuthor = author.id
  let temporaryBook = book.id

  failed(db.saveChanges())
  counts(provider, 0, 0)

  test::assertEqual(author.id, temporaryAuthor)
  test::assertEqual(book.id, temporaryBook)
  test::assertEqual(book.authorId, temporaryAuthor)
  book.title = "accepted"
  saved(db.saveChanges(), 2)
  counts(provider, 1, 1)

  test::assertTrue(author.id > 0 && book.id > 0)
  test::assertEqual(book.authorId, author.id)
  saved(db.saveChanges(), 0)
  saved(db.beginTransaction(), 0)

  test::assertTrue(db.authors.remove(author) == null)
  test::assertTrue(db.books.remove(book) == null)
  saved(db.saveChanges(), 2)
  counts(provider, 0, 0)
  saved(db.saveChanges(), 0)
  saved(db.rollbackTransaction(), 0)
  counts(provider, 1, 1)
  saved(db.saveChanges(), 2)
  counts(provider, 0, 0)
end

def verifyOuterRollback(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let author = new Author(0, "provisional author")
  let book = new Book(0, 0, "provisional book")
  let a = authorHandle(db, author)
  let b = bookHandle(db, book)

  if a == null
    return
  end
  if b == null
    return
  end
  let temporaryAuthor = author.id
  let temporaryBook = book.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) == null)
  saved(db.saveChanges(), 2)

  test::assertTrue(author.id > 0 && book.id > 0)
  test::assertEqual(book.authorId, author.id)
  book.title = "local edit survives rollback"
  saved(db.saveChanges(), 1)
  saved(db.rollbackTransaction(), 0)
  counts(provider, 0, 0)

  test::assertEqual(author.id, temporaryAuthor)
  test::assertEqual(book.id, temporaryBook)
  test::assertEqual(book.authorId, temporaryAuthor)
  test::assertEqual(book.title, "local edit survives rollback")
  saved(db.saveChanges(), 2)
  counts(provider, 1, 1)
end

def verifyOuterFailure(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let earlier = new Author(0, "earlier outer author")
  let earlierBook = new Book(0, 0, "earlier outer book")
  let firstAuthor = authorHandle(db, earlier)
  let firstBook = bookHandle(db, earlierBook)

  test::assertTrue(firstAuthor != null && firstBook != null)
  if firstAuthor == null || firstBook == null
    return
  end
  let temporaryEarlier = earlier.id
  let temporaryEarlierBook = earlierBook.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.link_booksFor_Author_by_authorId(firstAuthor, firstBook) == null)
  saved(db.saveChanges(), 2)

  test::assertTrue(earlier.id > 0 && earlierBook.id > 0)
  test::assertEqual(earlierBook.authorId, earlier.id)
  counts(provider, 2, 2)
  let author = new Author(0, "failed outer author")
  let book = new Book(0, 0, "rejected")
  let a = authorHandle(db, author)
  let b = bookHandle(db, book)

  test::assertTrue(a != null && b != null)
  if a == null || b == null
    return
  end
  let temporaryAuthor = author.id
  let temporaryBook = book.id

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) == null)
  failed(db.saveChanges())
  counts(provider, 2, 2)

  test::assertTrue(earlier.id > 0 && earlierBook.id > 0)
  test::assertEqual(author.id, temporaryAuthor)
  test::assertEqual(book.id, temporaryBook)
  test::assertEqual(book.authorId, temporaryAuthor)
  book.title = "retried outer graph"
  saved(db.saveChanges(), 2)
  counts(provider, 3, 3)
  saved(db.commitTransaction(), 0)
  counts(provider, 3, 3)
  db.clear()
  saved(db.saveChanges(), 0)

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) != null)
end

def verifyOuterRollbackAfterSavepoint(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let author = new Author(0, "rollback all")
  let book = new Book(0, 0, "accepted first")
  let a = authorHandle(db, author)
  let b = bookHandle(db, book)

  test::assertTrue(a != null && b != null)
  if a == null || b == null
    return
  end
  let temporaryAuthor = author.id
  let temporaryBook = book.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) == null)
  saved(db.saveChanges(), 2)

  test::assertTrue(author.id > 0 && book.id > 0)
  book.title = "rejected"
  failed(db.saveChanges())
  counts(provider, 4, 4)
  saved(db.rollbackTransaction(), 0)
  counts(provider, 3, 3)

  test::assertEqual(author.id, temporaryAuthor)
  test::assertEqual(book.id, temporaryBook)
  test::assertEqual(book.authorId, temporaryAuthor)
  test::assertEqual(book.title, "rejected")
end

def verifyNativeAbort(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let firstAuthor = new Author(0, "native first")
  let firstBook = new Book(0, 0, "duplicate")
  let firstA = authorHandle(db, firstAuthor)
  let firstB = bookHandle(db, firstBook)

  test::assertTrue(firstA != null && firstB != null)
  if firstA == null || firstB == null
    return
  end
  let temporaryFirstA = firstAuthor.id
  let temporaryFirstB = firstBook.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.link_booksFor_Author_by_authorId(firstA, firstB) == null)
  saved(db.saveChanges(), 2)
  counts(provider, 1, 1)
  let secondAuthor = new Author(0, "native second")
  let secondBook = new Book(0, 0, "duplicate")
  let secondA = authorHandle(db, secondAuthor)
  let secondB = bookHandle(db, secondBook)

  test::assertTrue(secondA != null && secondB != null)
  if secondA == null || secondB == null
    return
  end
  let temporarySecondA = secondAuthor.id
  let temporarySecondB = secondBook.id

  test::assertTrue(db.link_booksFor_Author_by_authorId(secondA, secondB) == null)
  failed(db.saveChanges())
  counts(provider, 0, 0)

  test::assertEqual(firstAuthor.id, temporaryFirstA)
  test::assertEqual(firstBook.id, temporaryFirstB)
  test::assertEqual(firstBook.authorId, temporaryFirstA)
  test::assertEqual(secondAuthor.id, temporarySecondA)
  test::assertEqual(secondBook.id, temporarySecondB)
  test::assertEqual(secondBook.authorId, temporarySecondA)
  failed(db.commitTransaction())
  secondBook.title = "unique retry"
  saved(db.saveChanges(), 4)
  counts(provider, 2, 2)
end

def verifyForeignHandle(provider: SQLiteProvider): Void
  let db = new GraphDatabase(provider)
  let foreign = new GraphDatabase(provider)
  let author = new Author(0, "foreign author")
  let book = new Book(0, 777, "foreign book")
  let a = authorHandle(foreign, author)
  let b = bookHandle(db, book)

  if a == null
    return
  end
  if b == null
    return
  end

  test::assertTrue(db.link_booksFor_Author_by_authorId(a, b) != null)
  test::assertEqual(book.authorId, 777)
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-relationships-")
    let path = temporary.path() + "/graphs.sqlite"
    let schema = "CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE books (id INTEGER PRIMARY KEY, author_id INTEGER NOT NULL REFERENCES authors(id), title TEXT NOT NULL CHECK(title != 'rejected'));"

    test::assertTrue(createSQLiteFixture(path, schema))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        console::println("Verifying graph dependency ordering and failed-save retry")
        verifyGraph(provider)
        console::println("Verifying graph outer transaction rollback")
        verifyOuterRollback(provider)
        console::println("Verifying recoverable graph save failure inside an outer transaction")
        verifyOuterFailure(provider)
        console::println("Verifying outer rollback after an accepted save and recoverable failure")
        verifyOuterRollbackAfterSavepoint(provider)
        console::println("Verifying graph handle ownership")
        verifyForeignHandle(provider)

        test::assertTrue(provider.close())
    end
    let nativePath = temporary.path() + "/native-abort.sqlite"
    let nativeSchema = "CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE books (id INTEGER PRIMARY KEY, author_id INTEGER NOT NULL REFERENCES authors(id), title TEXT NOT NULL UNIQUE ON CONFLICT ROLLBACK);"

    test::assertTrue(createSQLiteFixture(nativePath, nativeSchema))
    match SQLiteProvider.openWritable(nativePath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        console::println("Verifying native SQLite outer transaction abort")
        verifyNativeAbort(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFiles()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("Relationship integration contracts passed")
end
