namespace graph_model

class Author
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class Book
  public id: Int
  public authorId: Int
  public title: String

  def init(id: Int, authorId: Int, title: String): Void
    this.id = id
    this.authorId = authorId
    this.title = title
  end
end
