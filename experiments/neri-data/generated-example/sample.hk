use app_data
use neri_data
use console

def main(): Void
  let db = database()
  let query = db.customers.where(active: true, nickname: null).take(20)

  match query.compile()
    case CompileResult.Plan(plan)
      console.println(plan.sql().sql())
    case CompileResult.Failure(error)
      console.println("Query compilation failed")
  end
end
