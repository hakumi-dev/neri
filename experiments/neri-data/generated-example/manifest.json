{
  "version": 2,
  "defaultUnit": "sample",
  "units": {
    "entities": {
      "kind": "library",
      "sources": ["entities.hk"]
    },
    "data": {
      "kind": "library",
      "sources": ["database.hk"],
      "generated": ["generated/manifest.json"],
      "references": ["entities", {"project": "../manifest.json", "unit": "runtime"}]
    },
    "sample": {
      "kind": "executable",
      "sources": ["sample.hk"],
      "references": ["data"]
    }
  }
}
