namespace app_data

## Describes the mapped tables and columns for schema comparison.
def schema_Database(): neri_data::SchemaModel
  return new neri_data::SchemaModel([
      new neri_data::SchemaTable("model.Customer", "customers", [
          new neri_data::SchemaField("model.Customer.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("model.Customer.name", new neri_data::SchemaColumn("name", neri_data::SchemaType.Text(), nullable: false, primaryKey: false, defaultValue: neri_data::SchemaDefault.Text("O'Brien\n\"Neri\"\\café"))),
          new neri_data::SchemaField("model.Customer.active", new neri_data::SchemaColumn("active", neri_data::SchemaType.Bool(), nullable: false, primaryKey: false, defaultValue: neri_data::SchemaDefault.Bool(true))),
          new neri_data::SchemaField("model.Customer.nickname", new neri_data::SchemaColumn("nickname", neri_data::SchemaType.Text(), nullable: true, primaryKey: false, defaultValue: neri_data::SchemaDefault.Null()))
        ], [
          new neri_data::SchemaIndex("customers_name_active", ["model.Customer.name", "model.Customer.active"], true)
        ]),
      new neri_data::SchemaTable("model.Order", "orders", [
          new neri_data::SchemaField("model.Order.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("model.Order.customerId", new neri_data::SchemaColumn("customer_id", neri_data::SchemaType.Int(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("model.Order.total", new neri_data::SchemaColumn("total", neri_data::SchemaType.Int(), nullable: false, primaryKey: false, defaultValue: neri_data::SchemaDefault.Int(0)))
        ], [
          new neri_data::SchemaIndex("orders_customer_total", ["model.Order.customerId", "model.Order.total"], false)
        ])
    ])
end
