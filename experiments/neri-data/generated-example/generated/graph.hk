use reference
namespace app_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_Database
  private graph: neri_data::GraphRegistration
  private tracker_Customer: neri_data::EntityTracker<model::Customer>
  private visits_Customer: neri_data::GraphVisitList<model::Customer>
  private tracker_Order: neri_data::EntityTracker<model::Order>
  private visits_Order: neri_data::GraphVisitList<model::Order>

  def init(changes: neri_data::ChangeContext, tracker_Customer: neri_data::EntityTracker<model::Customer>, tracker_Order: neri_data::EntityTracker<model::Order>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Customer = tracker_Customer
    this.visits_Customer = new neri_data::GraphVisitList<model::Customer>(this.graph)
    this.tracker_Order = tracker_Order
    this.visits_Order = new neri_data::GraphVisitList<model::Order>(this.graph)
  end

  def add_customers(root: model::Customer): neri_data::TrackHandleResult<model::Customer>
    match this.discover_customers(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<model::Customer>.Failure(error)
    end
  end

  private def discover_customers(entity: model::Customer): neri_data::GraphVisitResult<model::Customer>
    match this.visits_Customer.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<model::Customer>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<model::Customer>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Customer)

        if staged != null
          return neri_data::GraphVisitResult<model::Customer>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_customers(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<model::Customer>.Failure(queued)
        end
        return neri_data::GraphVisitResult<model::Customer>.New(slot)
    end
  end

  private def scan_customers(entity: model::Customer, owner: neri_data::GraphSlot<model::Customer>): neri_data::QueryFailure?
    return null
  end

  def add_orders(root: model::Order): neri_data::TrackHandleResult<model::Order>
    match this.discover_orders(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<model::Order>.Failure(error)
    end
  end

  private def discover_orders(entity: model::Order): neri_data::GraphVisitResult<model::Order>
    match this.visits_Order.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<model::Order>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<model::Order>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Order)

        if staged != null
          return neri_data::GraphVisitResult<model::Order>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_orders(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<model::Order>.Failure(queued)
        end
        return neri_data::GraphVisitResult<model::Order>.New(slot)
    end
  end

  private def scan_orders(entity: model::Order, owner: neri_data::GraphSlot<model::Order>): neri_data::QueryFailure?
    return null
  end
end
