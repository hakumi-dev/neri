use host
namespace neri_data

## Selects one physical table while retaining the root tracker's shared identity.
class TrackedWriteLayout
  private storedTable: String
  private storedColumns: readonly ResultColumns

  def init(table: String, columns: readonly ResultColumns): Void
    this.storedTable = table
    this.storedColumns = columns
  end

  public readonly def table(): String
    return this.storedTable
  end

  public readonly def columns(): readonly ResultColumns
    return this.storedColumns
  end

  internal readonly def has(name: String): Bool
    var index = 0

    while index < this.storedColumns.count()
      if this.storedColumns.at(index).name() == name
        return true
      end
      index = index + 1
    end
    return false
  end

  internal readonly def compatible(other: readonly TrackedWriteLayout): Bool
    let columns = other.columns()

    if this.storedTable != other.table() || this.storedColumns.count() != columns.count()
      return false
    end
    var index = 0

    while index < columns.count()
      let first = this.storedColumns.at(index)
      let second = columns.at(index)

      if first.name() != second.name() || first.nullable() != second.nullable() || generatedKindCode(first.kind()) != generatedKindCode(second.kind())
        return false
      end
      index = index + 1
    end
    return true
  end

  internal readonly def failure(
    row: RawRow, mapped: readonly ResultColumns, keys: String[],
    concurrency: String[]?, generated: GeneratedValueColumn[], dialect: SqlDialect
  ): String?
    if !identifierValid(this.storedTable) || this.storedColumns.count() < 1 || this.storedColumns.count() > 1000
      return "physical write layout requires a valid table and 1..1000 columns"
    end
    match dialect
      case SqlDialect.QuestionMark()
      case SqlDialect.PostgreSql()
        if host::stringByteLength(this.storedTable) > 63
          return "PostgreSQL physical table identifier exceeds 63 bytes"
        end
    end
    var index = 0

    while index < this.storedColumns.count()
      let selected = this.storedColumns.at(index)
      let name = selected.name()

      if !identifierValid(name)
        return "physical write layout has an invalid column identifier"
      end
      var earlier = 0

      while earlier < index
        if this.storedColumns.at(earlier).name() == name
          return "physical write layout has duplicate columns"
        end
        earlier = earlier + 1
      end
      var matching = false
      var position = 0

      while position < mapped.count()
        let candidate = mapped.at(position)

        if candidate.name() == name && generatedKindCode(candidate.kind()) == generatedKindCode(selected.kind()) && (!selected.nullable() || candidate.nullable())
          matching = true
        end
        position = position + 1
      end
      if !matching
        return "physical write column must match root storage metadata: " + name
      end
      let value = cellFromRow(row, name)

      if value == null || !writeCellMatches(value, selected)
        return "physical write column is missing or has invalid storage: " + name
      end
      index = index + 1
    end
    for key in keys
      if !this.has(key)
        return "physical write layout omits a primary key: " + key
      end
    end
    if concurrency != null
      for token in concurrency
        if !this.has(token)
          return "physical write layout omits a concurrency token: " + token
        end
      end
    end
    for definition in generated
      if !this.has(definition.column().name())
        return "physical write layout omits a generated column: " + definition.column().name()
      end
    end
    return null
  end
end
