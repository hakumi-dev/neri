use test
use console
use files
use resources
use result
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def customerCount(provider: Provider): Int
  let db = new Database(provider)

  match db.customers.take(10).all()
    case QueryResult.Rows(rows)
      return rows.count()
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return -1
  end
end

def saveOne(db: Database, customer: model::Customer): Void
  test::assertTrue(db.customers.add(customer) == null)
  match db.saveChanges()
    case WriteResult.Saved(count)
      test::assertEqual(count, 1)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertEqual(count, 1)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
end

def verifyScopedOperations(root: String): Void
  let path = root + "/scoped.sqlite"
  let sql = "CREATE TABLE customers (id INTEGER, name TEXT, active INTEGER, nickname TEXT); INSERT INTO customers VALUES (1, 'Ada', 1, NULL);"

  test::assertTrue(createSQLiteFixture(path, sql))
  let connection = new SQLiteConnection(path)
  let db = new Database(connection)

  match db.customers.take(10).all()
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(files::removeFile(path).failure == null)
  match db.customers.take(10).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertTrue(message != "")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  test::assertTrue(connection.close())
  test::assertTrue(connection.close())
end

def verifyMissingPath(root: String): Void
  let connection = new SQLiteConnection(root + "/missing.sqlite")
  let db = new Database(connection)

  match db.customers.take(1).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertTrue(message != "")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  test::assertTrue(connection.close())
end

def verifyTransactions(path: String): Void
  let setup = "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL, active INTEGER NOT NULL, nickname TEXT);"

  test::assertTrue(createSQLiteFixture(path, setup))
  let rollbackConnection = new SQLiteConnection(path)
  let rollbackDb = new Database(rollbackConnection)

  match rollbackDb.beginTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
  saveOne(rollbackDb, new Customer(1, "rolled back", true))
  match rollbackDb.rollbackTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(customerCount(new SQLiteConnection(path)), 0)
  test::assertTrue(rollbackConnection.close())

  let commitConnection = new SQLiteConnection(path)
  let commitDb = new Database(commitConnection)

  match commitDb.beginTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
  saveOne(commitDb, new Customer(2, "committed", true))
  match commitDb.commitTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(customerCount(new SQLiteConnection(path)), 1)
  test::assertTrue(commitConnection.close())

  let closeConnection = new SQLiteConnection(path)
  let closeDb = new Database(closeConnection)

  match closeDb.beginTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
  saveOne(closeDb, new Customer(3, "close rolls back", true))

  test::assertTrue(closeConnection.close())
  test::assertTrue(closeConnection.close())
  test::assertEqual(customerCount(new SQLiteConnection(path)), 1)
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-sqlite-connection-")
    verifyScopedOperations(temporary.path())
    verifyMissingPath(temporary.path())
    verifyTransactions(temporary.path() + "/transactions.sqlite")
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("SQLite connection lifecycle contracts passed")
end
