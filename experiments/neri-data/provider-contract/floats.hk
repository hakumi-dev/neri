use files
use resources
use result
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class FloatRecord
  public id: Int
  public amount: Float
  public optionalAmount: Float?

  def init(id: Int, amount: Float, optionalAmount: Float?): Void
    this.id = id
    this.amount = amount
    this.optionalAmount = optionalAmount
  end
end

class FloatVisit
  public count: Int = 0
  public value: Float = 0.0
end

def decodeFloatRecord(row: RawRow): DecodeResult<FloatRecord>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<FloatRecord>.Failure(error)
    case DecodeResult.Value(id)
      match decodeFloat(row, "amount")
        case DecodeResult.Failure(error)
          return DecodeResult<FloatRecord>.Failure(error)
        case DecodeResult.Value(amount)
          match decodeNullableFloat(row, "optional_amount")
            case DecodeResult.Failure(error)
              return DecodeResult<FloatRecord>.Failure(error)
            case DecodeResult.Value(optionalAmount)
              return DecodeResult<FloatRecord>.Value(new FloatRecord(id, amount, optionalAmount))
          end
      end
  end
end

def floatColumns(): ResultColumns
  return new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("amount", ResultColumnKind.Float()),
      new ResultColumn("optional_amount", ResultColumnKind.Float(), true)
    ])
end

def floatRows(provider: SQLiteProvider): Query<FloatRecord>
  let mapping = new EntityMapping("FloatRecord", "measurements", [
      new MappingColumn("FloatRecord.id", "Int", "id"),
      new MappingColumn("FloatRecord.amount", "Float", "amount"),
      new MappingColumn("FloatRecord.optionalAmount", "Float?", "optional_amount")
    ], "id")

  return new Query<FloatRecord>("measurements", new Decoder<FloatRecord>(decodeFloatRecord, floatColumns()), mapping: mapping, provider: provider)
end

def malformedRows(provider: SQLiteProvider): Query<FloatRecord>
  let mapping = new EntityMapping("FloatRecord", "malformed_values", [
      new MappingColumn("FloatRecord.id", "Int", "id"),
      new MappingColumn("FloatRecord.amount", "Float", "amount")
    ], "id")
  let decoder = new Decoder<FloatRecord>(decodeFloatRecord, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<FloatRecord>("malformed_values", decoder, mapping: mapping, provider: provider)
end

def amountField(): quote fn(FloatRecord): Float
  return quote do |row: FloatRecord|: Float
    return row.amount
  end
end

def optionalField(): quote fn(FloatRecord): Float?
  return quote do |row: FloatRecord|: Float?
    return row.optionalAmount
  end
end

def readRecord(provider: SQLiteProvider, id: Int): FloatRecord?
  match floatRows(provider).where(id: id).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      if first != null
        return first.value
      end
  end
  return null
end

def assertSaved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
end

def assertRejected(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Validation(message)
          test::assertTrue(message != "")
        case WriteFailure.Concurrency(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Provider(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
  end
end

def captureFloatRecord(value: FloatRecord): RawRow
  var optional: Cell = Cell.Null()
  let amount = value.optionalAmount

  if amount != null
    optional = Cell.Float(amount)
  end
  return new RawRow([
      new RawColumn("id", Cell.Int(value.id)),
      new RawColumn("amount", Cell.Float(value.amount)),
      new RawColumn("optional_amount", optional)
    ])
end

def verifyFloatProvider(provider: SQLiteProvider): Void
  let rows = floatRows(provider)
  let first = readRecord(provider, 1)

  test::assertTrue(first != null)
  if first != null
    test::assertEqual(first.amount, 1.25)
    test::assertTrue(first.optionalAmount == null)
  end
  let second = readRecord(provider, 2)

  test::assertTrue(second != null)
  if second != null
    test::assertEqual(second.amount, 1.0)
    let optional = second.optionalAmount

    test::assertTrue(optional != null)
    if optional != null
      test::assertEqual(optional, 2.5)
    end
  end
  match select(rows.where(amount: 1.25).take(1), floatScalar(), amountField()).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let value = values.first()

      test::assertEqual(values.count(), 1)
      test::assertTrue(value != null)
      if value != null
        test::assertEqual(value.value, 1.25)
      end
  end
  let visited = new FloatVisit()
  let visit: fn(Float): Bool = fn(value: Float): Bool
    visited.count = visited.count + 1
    visited.value = value
    return true
  end

  match select(rows.where(amount: 1.25).take(1), floatScalar(), amountField()).stream(visit)
    case StreamResult.Completed(count)
      test::assertEqual(count, 1)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertEqual(visited.count, 1)
  test::assertEqual(visited.value, 1.25)
  match select(rows.where(id: 1).take(1), optionalFloatScalar(), optionalField()).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let value = values.first()

      test::assertTrue(value != null)
      if value != null
        test::assertTrue(value.value == null)
      end
  end
  assertSaved(rows.where(id: 1).executeUpdate(amount: 3.5, optionalAmount: 4.25), 1)
  let updated = readRecord(provider, 1)

  test::assertTrue(updated != null)
  if updated != null
    test::assertEqual(updated.amount, 3.5)
    let optional = updated.optionalAmount

    test::assertTrue(optional != null)
    if optional != null
      test::assertEqual(optional, 4.25)
    end
  end

  let tracker = new EntityTracker<FloatRecord>("measurements", "id", floatColumns(), captureFloatRecord)
  let context = new ChangeContext(provider)

  context.register(tracker.changeSet())
  if updated != null
    test::assertTrue(tracker.attach(updated) == null)
    updated.amount = 5.5
    updated.optionalAmount = null
    assertSaved(context.saveChanges(), 1)
  end
  let tracked = readRecord(provider, 1)

  test::assertTrue(tracked != null)
  if tracked != null
    test::assertEqual(tracked.amount, 5.5)
    test::assertTrue(tracked.optionalAmount == null)
  end

  assertSaved(context.beginTransaction(), 0)
  if updated != null
    updated.amount = 6.5
    assertSaved(context.saveChanges(), 1)
  end
  assertSaved(context.rollbackTransaction(), 0)
  let rolledBack = readRecord(provider, 1)

  test::assertTrue(rolledBack != null)
  if rolledBack != null
    test::assertEqual(rolledBack.amount, 5.5)
  end

  let infinity = 1.0 / 0.0
  let nan = 0.0 / 0.0

  assertRejected(rows.where(id: 1).executeUpdate(amount: infinity))
  assertRejected(rows.where(id: 1).executeUpdate(amount: nan))
  match rows.where(amount: infinity).take(1).all()
    case QueryResult.Rows(values)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(message)
          test::assertEqual(message, "Float field filter must be finite")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
  let unchanged = readRecord(provider, 1)

  test::assertTrue(unchanged != null)
  if unchanged != null
    test::assertEqual(unchanged.amount, 5.5)
  end

  let bad = malformedRows(provider)
  var id = 1

  while id <= 4
    match select(bad.where(id: id).take(1), floatScalar(), amountField()).all()
      case QueryResult.Rows(values)
        test::assertTrue(false)
      case QueryResult.Failure(error)
        match error
          case QueryFailure.Provider(message)
            test::assertEqual(message, id == 4 ? "SQLite float column must be finite" : "SQLite float column has wrong type")
          case QueryFailure.InvalidIdentifier(name)
            test::assertTrue(false)
          case QueryFailure.InvalidLimit(value, maximum)
            test::assertTrue(false)
          case QueryFailure.MissingLimit(maximum)
            test::assertTrue(false)
          case QueryFailure.SourceMismatch(expected, actual)
            test::assertTrue(false)
          case QueryFailure.UnsupportedCapability(message)
            test::assertTrue(false)
          case QueryFailure.MissingColumn(name)
            test::assertTrue(false)
          case QueryFailure.TypeMismatch(column, expected, actual)
            test::assertTrue(false)
          case QueryFailure.Cardinality(expected, actual)
            test::assertTrue(false)
        end
    end
    id = id + 1
  end
  let increment: quote fn(FloatRecord): Float = quote do |row: FloatRecord|: Float
    return row.amount + 0.5
  end
  let clearOptional: quote fn(FloatRecord): Float? = quote do |row: FloatRecord|: Float?
    return null
  end
  let computed = updateSet<FloatRecord>().set(amountField(), increment).set(optionalField(), clearOptional)

  assertSaved(rows.where(id: 2).executeUpdateSet(computed), 1)
  let computedRow = readRecord(provider, 2)

  test::assertTrue(computedRow != null)
  if computedRow != null
    test::assertEqual(computedRow.amount, 1.5)
    test::assertTrue(computedRow.optionalAmount == null)
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-data-floats-")
    let path = temporary.path() + "/floats.sqlite"
    let sql = "CREATE TABLE measurements(id INTEGER PRIMARY KEY, amount REAL NOT NULL, optional_amount REAL); INSERT INTO measurements VALUES(1, 1.25, NULL), (2, 1, 2.5); CREATE TABLE malformed_values(id INTEGER PRIMARY KEY, amount); INSERT INTO malformed_values VALUES(1, 1), (2, '1.25'), (3, x'0102'), (4, 1e999);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Opened(provider)
        verifyFloatProvider(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
