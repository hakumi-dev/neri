use files
use resources
use result
use test
use host
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use quotation

class CustomerCard
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class CustomerProfile
  public nickname: String?
  public backupNickname: String?

  def init(nickname: String?, backupNickname: String?): Void
    this.nickname = nickname
    this.backupNickname = backupNickname
  end
end

class OrderCard
  public id: Int
  public total: Int

  def init(id: Int, total: Int): Void
    this.id = id
    this.total = total
  end
end

class CustomerOrderCard
  public customer: CustomerCard
  public order: OrderCard

  def init(customer: CustomerCard, order: OrderCard): Void
    this.customer = customer
    this.order = order
  end
end

class CustomerOrderCalls
  public count: Int = 0
end

class OptionalCustomerOrderCard
  public customerId: Int
  public customerName: String
  public right: CustomerProfile?

  def init(customerId: Int, customerName: String, right: CustomerProfile?): Void
    this.customerId = customerId
    this.customerName = customerName
    this.right = right
  end
end

def customerId(): quote fn(Customer): Int
  return quote do |value: Customer|: Int
    return value.id
  end
end

def customerName(): quote fn(Customer): String
  return quote do |value: Customer|: String
    return value.name
  end
end

def customerNickname(): quote fn(Customer): String?
  return quote do |value: Customer|: String?
    return value.nickname
  end
end

def customerActive(): quote fn(Customer): Bool
  return quote do |value: Customer|: Bool
    return value.active
  end
end

def orderCustomerId(): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.customerId
  end
end

def orderId(): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.id
  end
end

def orderTotal(): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.total
  end
end

def customerIdPlus(offset: Int): quote fn(Customer): Int
  return quote do |value: Customer|: Int
    return value.id + offset
  end
end

def orderTotalPlus(offset: Int): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.total + offset
  end
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def assertTextParameter(node: readonly ParameterNode?, expected: String): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Text(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Int(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
  end
  return node.next()
end

def assertIntParameter(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def customerCardShape(): RowShape<Customer, CustomerCard>
  return combineShapes(fieldShape(intScalar(), customerId()), fieldShape(textScalar(), customerName())) do |id: Int, name: String|: CustomerCard
    return new CustomerCard(id, name)
  end
end

def customerProfileShape(): RowShape<Customer, CustomerProfile>
  return combineShapes(fieldShape(optionalTextScalar(), customerNickname()), fieldShape(optionalTextScalar(), customerNickname())) do |nickname: String?, backupNickname: String?|: CustomerProfile
    return new CustomerProfile(nickname, backupNickname)
  end
end

def orderCardShape(): RowShape<Order, OrderCard>
  return combineShapes(fieldShape(intScalar(), orderId()), fieldShape(intScalar(), orderTotal())) do |id: Int, total: Int|: OrderCard
    return new OrderCard(id, total)
  end
end

def verifyComposition(provider: SQLiteProvider): Void
  let db = database(provider)
  let calls = new CustomerOrderCalls()
  let joined = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).orderByLeft(customerId()).thenByRight(orderId())
  let overNine = quote do |order: Order|: Bool
    return order.total > 9
  end

  match joined.take(1).matchingRight(overNine).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
  end
  match joined.matchingRight(overNine).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        test::assertEqual(first.value.right.id, 11)
      end
  end

  let leftAtLeastThree = quote do |customer: Customer|: Bool
    return customer.id >= 3
  end
  let rightAtLeastTen = quote do |order: Order|: Bool
    return order.total >= 10
  end
  let filtered = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).matchingLeft(leftAtLeastThree).matchingRight(rightAtLeastTen).orderByLeft(customerId()).thenByRight(orderId()).skip(0).take(5)

  match filtered.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 3)
        test::assertEqual(first.value.right.id, 13)
      end
  end

  let computedSides = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).matchingLeft(quote do |customer: Customer|: Bool
      return customer.id + 1 < 4
    end).matchingRight(quote do |order: Order|: Bool
      return order.total + 1 > 10
    end).take(5)

  match computedSides.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        test::assertEqual(first.value.right.id, 11)
      end
  end

  let orderedSkip = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).orderByLeft(customerId()).thenByRight(orderId()).skip(1).take(3)

  match orderedSkip.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 3)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        test::assertEqual(first.value.right.id, 11)
      end
  end

  let computedOrder = joined.matchingRight(quote do |order: Order|: Bool
      return order.total > 8
    end).take(4).orderByLeft(customerIdPlus(2), true).thenByRight(orderTotalPlus(3)).thenByLeft(customerIdPlus(5)).thenByRight(orderTotalPlus(7)).matchingLeft(quote do |customer: Customer|: Bool
      return customer.id > 0
    end).skip(1).take(2)

  match computedOrder.compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertTrue(plan.sql().requiresCheckedScalars())
      let second = assertIntParameter(plan.sql().parameters().first(), 7)
      let third = assertIntParameter(second, 5)
      let fourth = assertIntParameter(third, 3)
      let fifth = assertIntParameter(fourth, 2)
      let sixth = assertIntParameter(fifth, 8)
      let remaining = assertIntParameter(sixth, 0)

      test::assertTrue(remaining == null)
  end

  match computedOrder.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        let second = first.next

        test::assertTrue(second != null)
        if second != null
          test::assertEqual(first.value.right.id, 12)
          test::assertEqual(second.value.right.id, 10)
        end
      end
  end

  let computedOrderProjection = projectJoin(computedOrder, customerCardShape(), orderCardShape()) do |customer: CustomerCard, order: OrderCard|: CustomerOrderCard
    return new CustomerOrderCard(customer, order)
  end

  match computedOrderProjection.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        let second = first.next

        test::assertTrue(second != null)
        if second != null
          test::assertEqual(first.value.order.id, 12)
          test::assertEqual(second.value.order.id, 10)
        end
      end
  end

  let sourceName = "Ada"
  let sourceTotal = 9
  let minimumCustomer = 1
  let minimumTotal = 8
  let sourceJoin = join(db.customers.where(name: sourceName), db.orders.where(total: sourceTotal), intScalar(), customerId(), orderCustomerId())
  let sourceLeftFiltered = sourceJoin.matchingLeft(quote do |customer: Customer|: Bool
      return customer.id > minimumCustomer
    end)
  let sourceRightFiltered = sourceLeftFiltered.matchingRight(quote do |order: Order|: Bool
      return order.total > minimumTotal
    end)
  let sourceFiltered = sourceRightFiltered.take(4)

  match sourceFiltered.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      test::assertTrue(containsText(plan.sql().sql(), "$1"))
      test::assertTrue(containsText(plan.sql().sql(), "$2"))
      test::assertTrue(containsText(plan.sql().sql(), "$3"))
      test::assertTrue(containsText(plan.sql().sql(), "$4"))
      let first = plan.sql().parameters().first()

      let second = assertTextParameter(first, sourceName)
      let third = assertIntParameter(second, sourceTotal)
      let fourth = assertIntParameter(third, minimumCustomer)
      let remaining = assertIntParameter(fourth, minimumTotal)

      test::assertTrue(remaining == null)
  end

  let leftShift = 1
  let rightShift = 2
  let computedSourceFilters = join(db.customers.where(name: sourceName), db.orders.where(total: sourceTotal), intScalar(), customerId(), orderCustomerId()).matchingLeft(quote do |customer: Customer|: Bool
      return customer.id + leftShift > minimumCustomer
    end).matchingRight(quote do |order: Order|: Bool
      return order.total + rightShift > minimumTotal
    end).take(4)

  match computedSourceFilters.compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 6)
      let second = assertTextParameter(plan.sql().parameters().first(), sourceName)
      let third = assertIntParameter(second, sourceTotal)
      let fourth = assertIntParameter(third, leftShift)
      let fifth = assertIntParameter(fourth, minimumCustomer)
      let sixth = assertIntParameter(fifth, rightShift)
      let remaining = assertIntParameter(sixth, minimumTotal)

      test::assertTrue(remaining == null)
  end

  match computedSourceFilters.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
  end

  let left = customerCardShape()
  let right = orderCardShape()
  let projected = projectJoin(filtered, left, right) do |customer: CustomerCard, order: OrderCard|: CustomerOrderCard
    calls.count = calls.count + 1
    return new CustomerOrderCard(customer, order)
  end

  match projected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.customer.id, 3)
        test::assertEqual(first.value.customer.name, "Cal")
        test::assertEqual(first.value.order.id, 13)
        test::assertEqual(first.value.order.total, 15)
      end
  end

  test::assertEqual(calls.count, 1)

  let activeRight = quote do |customer: Customer|: Bool
    return customer.id < 3
  end
  let filteredRight = db.customers.matching(activeRight)
  let outer = leftJoin(db.customers, filteredRight, intScalar(), customerId(), customerId()).orderByLeft(customerId()).take(10)

  match outer.withRight().count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match outer.withoutRight().count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let rightOnly = leftJoin(db.customers, db.customers, intScalar(), customerId(), customerId()).matchingRight(activeRight)

  match rightOnly.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match rightOnly.withoutRight().count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let customerIdentity = customerCardShape()
  let profile = customerProfileShape()
  let optionalProjected = projectLeftJoin(outer, customerIdentity, profile) do |customer: CustomerCard, right: CustomerProfile?|: OptionalCustomerOrderCard
    return new OptionalCustomerOrderCard(customer.id, customer.name, right)
  end

  match optionalProjected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var sawPresentNull = false
      var sawMissing = false

      while row != null
        if row.value.customerId == 2
          let right = row.value.right

          test::assertTrue(right != null)
          if right != null
            test::assertTrue(right.nickname == null)
            test::assertTrue(right.backupNickname == null)
            sawPresentNull = true
          end
        else if row.value.customerId == 3
          let right = row.value.right

          test::assertTrue(right == null)
          sawMissing = true
        end
        row = row.next
      end

      test::assertTrue(sawPresentNull && sawMissing)
  end

  let visitCount = new CustomerOrderCalls()
  let streamProjection = projectJoin(
    joined.orderByLeft(customerId()).thenByRight(orderId()).take(10),
    left,
    right
  ) do |customer: CustomerCard, order: OrderCard|: CustomerOrderCard
    return new CustomerOrderCard(customer, order)
  end
  let visitor: fn(CustomerOrderCard): Bool = fn(value: CustomerOrderCard): Bool
    visitCount.count = visitCount.count + 1
    return visitCount.count < 2
  end

  match streamProjection.stream(visitor)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 2)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertEqual(visitCount.count, 2)

  match join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).take(2).take(0).take(1).all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertEqual(value, 0)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
end

def verifyPairPredicates(provider: SQLiteProvider): Void
  let db = database(provider)
  let base = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).orderByLeft(customerId()).thenByRight(orderId())
  let sameCustomer = base.matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id == order.customerId
    end)

  match sameCustomer.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let minimumCustomer = 0
  let minimumTotal = 8
  let sourceName = "Ada"
  let sourceTotal = 9
  let captured = join(db.customers.where(name: sourceName), db.orders.where(total: sourceTotal), intScalar(), customerId(), orderCustomerId()).matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id > minimumCustomer && order.total > minimumTotal && customer.id < order.total
    end).take(10)

  match captured.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      test::assertTrue(containsText(plan.sql().sql(), "$1"))
      test::assertTrue(containsText(plan.sql().sql(), "$2"))
      test::assertTrue(containsText(plan.sql().sql(), "$3"))
      test::assertTrue(containsText(plan.sql().sql(), "$4"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_join_stage\".\"__neri_l0\" < \"__neri_join_stage\".\"__neri_r2\""))
      let second = assertTextParameter(plan.sql().parameters().first(), "Ada")
      let third = assertIntParameter(second, 9)
      let fourth = assertIntParameter(third, minimumCustomer)
      let remaining = assertIntParameter(fourth, minimumTotal)

      test::assertTrue(remaining == null)
  end

  let customerShift = 1
  let orderShift = 2
  let computedPair = join(db.customers.where(name: sourceName), db.orders.where(total: sourceTotal), intScalar(), customerId(), orderCustomerId()).matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id + customerShift > minimumCustomer && order.total + orderShift > minimumTotal
    end).take(10)

  match computedPair.compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 6)
      let second = assertTextParameter(plan.sql().parameters().first(), sourceName)
      let third = assertIntParameter(second, sourceTotal)
      let fourth = assertIntParameter(third, customerShift)
      let fifth = assertIntParameter(fourth, minimumCustomer)
      let sixth = assertIntParameter(fifth, orderShift)
      let remaining = assertIntParameter(sixth, minimumTotal)

      test::assertTrue(remaining == null)
  end

  match computedPair.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let onlyCustomerTwo = quote do |customer: Customer, order: Order|: Bool
    return customer.id == 2
  end

  match base.take(1).matchingPair(onlyCustomerTwo).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match base.matchingPair(onlyCustomerTwo).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 2)
        test::assertEqual(first.value.right.id, 12)
      end
  end

  let activeCustomers = db.customers.where(active: true)
  let selfJoin = join(activeCustomers, activeCustomers, boolScalar(), customerActive(), customerActive())
  let sameNullable = selfJoin.matchingPair(quote do |left: Customer, right: Customer|: Bool
      return left.nickname == right.nickname
    end)

  match sameNullable.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match selfJoin.matchingPair(quote do |left: Customer, right: Customer|: Bool
      return !(left.nickname == right.nickname)
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match sameNullable.take(10).compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_join_stage\".\"__neri_l3\" IS NOT NULL"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_join_stage\".\"__neri_r3\" IS NOT NULL"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_join_stage\".\"__neri_l3\" IS NULL AND \"__neri_join_stage\".\"__neri_r3\" IS NULL"))
  end

  let leftMapping = new EntityMapping("model.Customer", "joined_source", [new MappingColumn("model.Customer.id", "Int", "left_id")])
  let rightMapping = new EntityMapping("model.Order", "joined_source", [new MappingColumn("model.Order.total", "Int", "right_total")])
  let wrongSideTree = new quotation::Tree(
    [
      new quotation::Node(NodeKind.Parameter(), "model.Customer", index: 0),
      new quotation::Node(NodeKind.Parameter(), "model.Order", index: 1),
      new quotation::Node(NodeKind.Member(), "Int", first: 1, identity: "model.Customer.id"),
      new quotation::Node(NodeKind.IntLiteral(), "Int", intValue: 0),
      new quotation::Node(NodeKind.Greater(), "Bool", first: 2, second: 3)
    ],
    [],
    4,
    ["model.Customer", "model.Order"],
    "Bool"
  )

  match translateJoinQuotation(leftMapping, rightMapping, wrongSideTree)
    case TranslationResult.Failure(error)
      test::assertTrue(true)
    case TranslationResult.Expression(value)
      test::assertTrue(false)
  end

  let leftNameEqualsRightNickname = quote do |left: Customer, right: Customer|: Bool
    return left.name == right.nickname && right.nickname == left.name
  end
  let mixedSelfJoin = join(activeCustomers, db.customers.where(id: 1), boolScalar(), customerActive(), customerActive()).matchingPair(leftNameEqualsRightNickname)

  match mixedSelfJoin.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let missingRight = leftJoin(db.customers.where(id: 3), db.customers.where(id: 1), boolScalar(), customerActive(), customerActive()).matchingPair(quote do |left: Customer, right: Customer|: Bool
      return !(left.nickname == right.nickname)
    end)

  match missingRight.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let left = customerCardShape()
  let right = orderCardShape()
  let pairMatches = base.matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id < order.total
    end).take(10)
  let projection = projectJoin(pairMatches, left, right) do |customer: CustomerCard, order: OrderCard|: CustomerOrderCard
    return new CustomerOrderCard(customer, order)
  end

  match projection.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
  end

  let calls = new CustomerOrderCalls()
  let visit: fn(CustomerOrderCard): Bool = fn(value: CustomerOrderCard): Bool
    calls.count = calls.count + 1
    return calls.count < 2
  end

  match projection.stream(visit)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 2)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end
end

def verifyOptionalPairPredicates(provider: SQLiteProvider): Void
  let db = database(provider)
  let leftBeforeFour = quote do |customer: Customer|: Bool
    return customer.id < 4
  end
  let leftSource = db.customers.matching(leftBeforeFour)
  let rightSource = db.customers.where(active: true)
  let ordered = leftJoin(leftSource, rightSource, boolScalar(), customerActive(), customerActive()).orderByLeft(customerId()).thenByRight(customerId())
  let acceptMissingOrLaterNull = quote do |left: Customer, right: Customer?|: Bool
    return right == null || (left.id < right.id && right.nickname == null)
  end
  let accepted = ordered.matchingOptionalPair(acceptMissingOrLaterNull)

  let conditionalPair = ordered.matchingOptionalPair(quote do |left: Customer, right: Customer?|: Bool
      return right == null ? true : right.id > left.id
    end)

  match conditionalPair.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match conditionalPair.take(10).compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), "CASE"))
      test::assertTrue(containsText(plan.sql().sql(), "__neri_present"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_join_stage\".\"__neri_present\" = 0"))
      test::assertTrue(!containsText(plan.sql().sql(), " IS 0"))
  end

  match accepted.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match ordered.take(1).matchingOptionalPair(acceptMissingOrLaterNull).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match accepted.take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        let right = first.value.right

        test::assertTrue(right != null)
        if right != null
          test::assertEqual(right.id, 2)
        end
      end
  end

  let presentOnly = quote do |left: Customer, right: Customer?|: Bool
    return !(right == null) && left.id < right.id && right.nickname == null
  end

  match ordered.matchingOptionalPair(presentOnly).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match ordered.matchingOptionalPair(quote do |left: Customer, right: Customer?|: Bool
      return right == null
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match ordered.matchingOptionalPair(quote do |left: Customer, right: Customer?|: Bool
      return right != null && right.nickname == null
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  match ordered.matchingOptionalPair(quote do |left: Customer, right: Customer?|: Bool
      return right == null || (right.id > 0 && left.id / (left.id - 3) > 0)
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  match ordered.matchingRight(quote do |right: Customer|: Bool
      return right.id + 1 > 0
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match ordered.matchingPair(quote do |left: Customer, right: Customer|: Bool
      return left.id + right.id > 0
    end).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let sortedLeftJoin = leftJoin(leftSource, rightSource, boolScalar(), customerActive(), customerActive()).orderByRight(customerIdPlus(1), true).thenByLeft(customerIdPlus(0)).skip(4).take(1)
  let sortedLeftProjection = projectLeftJoin(sortedLeftJoin, customerCardShape(), customerProfileShape()) do |customer: CustomerCard, profile: CustomerProfile?|: OptionalCustomerOrderCard
    return new OptionalCustomerOrderCard(customer.id, customer.name, profile)
  end

  match sortedLeftProjection.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.customerId, 3)
        test::assertTrue(first.value.right == null)
      end
  end

  let leftMap = new EntityMapping("model.Customer", "__neri_join_stage", [new MappingColumn("model.Customer.id", "Int", "__neri_l0"), new MappingColumn("model.Customer.nickname", "String?", "__neri_l1")])
  let rightMap = new EntityMapping("model.Customer", "__neri_join_stage", [new MappingColumn("model.Customer.id", "Int", "__neri_r0"), new MappingColumn("model.Customer.nickname", "String?", "__neri_r1")])
  let unguardedTree = new quotation::Tree(
    [
      new quotation::Node(NodeKind.Parameter(), "model.Customer", index: 0),
      new quotation::Node(NodeKind.Parameter(), "model.Customer", index: 1),
      new quotation::Node(NodeKind.Member(), "String?", first: 1, identity: "model.Customer.nickname"),
      new quotation::Node(NodeKind.NullLiteral(), "Null"),
      new quotation::Node(NodeKind.Equal(), "Bool", first: 2, second: 3)
    ],
    [],
    4,
    ["model.Customer", "model.Customer?"],
    "Bool"
  )

  match translateOptionalJoinQuotation(leftMap, rightMap, unguardedTree)
    case TranslationResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "right member access requires a right presence guard")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case TranslationResult.Expression(value)
      test::assertTrue(false)
  end

  let unguardedArithmeticTree = new quotation::Tree(
    [
      new quotation::Node(NodeKind.Parameter(), "model.Customer", index: 0),
      new quotation::Node(NodeKind.Parameter(), "model.Customer", index: 1),
      new quotation::Node(NodeKind.Member(), "Int", first: 1, identity: "model.Customer.id"),
      new quotation::Node(NodeKind.IntLiteral(), "Int", intValue: 1),
      new quotation::Node(NodeKind.Add(), "Int", first: 2, second: 3),
      new quotation::Node(NodeKind.Member(), "Int", first: 0, identity: "model.Customer.id"),
      new quotation::Node(NodeKind.Greater(), "Bool", first: 5, second: 4)
    ],
    [],
    6,
    ["model.Customer", "model.Customer?"],
    "Bool"
  )

  match translateOptionalJoinQuotation(leftMap, rightMap, unguardedArithmeticTree)
    case TranslationResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "right member access requires a right presence guard")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case TranslationResult.Expression(value)
      test::assertTrue(false)
  end

  let projected = projectLeftJoin(accepted.take(10), customerCardShape(), customerProfileShape()) do |customer: CustomerCard, profile: CustomerProfile?|: OptionalCustomerOrderCard
    return new OptionalCustomerOrderCard(customer.id, customer.name, profile)
  end

  match projected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var row = rows.first()
      var sawPresentNull = false
      var sawMissing = false

      while row != null
        if row.value.customerId == 1
          let profile = row.value.right

          test::assertTrue(profile != null)
          if profile != null
            test::assertTrue(profile.nickname == null)
            test::assertTrue(profile.backupNickname == null)
            sawPresentNull = true
          end
        else if row.value.customerId == 3
          let profile = row.value.right

          test::assertTrue(profile == null)
          sawMissing = true
        end
        row = row.next
      end

      test::assertTrue(sawPresentNull && sawMissing)
  end

  let visits = new CustomerOrderCalls()
  let visit: fn(OptionalCustomerOrderCard): Bool = fn(value: OptionalCustomerOrderCard): Bool
    visits.count = visits.count + 1
    return visits.count < 1
  end

  match projected.stream(visit)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-join-composition-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, 'Ada', 1, 'Ada'), (2, 'Bea', 1, NULL), (3, 'Cal', 0, 'three'), (4, 'Deb', 'broken active', NULL); INSERT INTO orders VALUES(10, 1, 9), (11, 1, 20), (12, 2, 9), (13, 3, 15), (14, 99, 4);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyComposition(provider)
        verifyPairPredicates(provider)
        verifyOptionalPairPredicates(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
