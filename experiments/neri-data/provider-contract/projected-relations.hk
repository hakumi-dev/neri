use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use files
use host
use console
use resources
use result
use test

class ProjectedGroups
  public nickname: String?
  public count: Int

  def init(nickname: String?, count: Int): Void
    this.nickname = nickname
    this.count = count
  end
end

class ProjectedCallbacks
  public count: Int = 0
end

class CustomCodecCalls
  public count: Int = 0
end

class ArbitraryProjected
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class ProjectedProviderProbe: Provider
  private inner: Provider
  public calls: Int = 0

  def init(inner: Provider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.inner.supports(capability)
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    return this.inner.execute(plan)
  end
end

def projectedCustomerId(): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id
  end
end

def projectedCustomerName(): quote fn(Customer): String
  return quote do |customer: Customer|: String
    return customer.name
  end
end

def projectedCustomerNickname(): quote fn(Customer): String?
  return quote do |customer: Customer|: String?
    return customer.nickname
  end
end

def projectedOrderCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def projectedShape(suffix: String): RowShape<Customer, ProjectedPair<ProjectedPair<Int, String>, String?>>
  let name = expressionShape(textScalar(), quote do |customer: Customer|: String
      return customer.name + suffix
    end)
  let identity = pairShape(fieldShape(intScalar(), projectedCustomerId()), name)

  return pairShape(identity, fieldShape(optionalTextScalar(), projectedCustomerNickname()))
end

def assertProjectedTextParameter(node: readonly ParameterNode?, expected: String): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Text(value)
      test::assertEqual(value, expected)
    case Parameter.Int(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Bool(value)
      test::assertTrue(false)
  end
  return node.next()
end

def assertProjectedIntParameter(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def verifyProjectedRelations(provider: SQLiteProvider): Void
  let probe = new ProjectedProviderProbe(provider)
  let db = new Database(probe)
  let suffix = "!"
  let fullShape = projectedShape(suffix)
  let sourceName = "Ada"
  let sourceTotal = 9
  let leftShift = 1
  let rightShift = 0
  let minimumId = 0
  let source = project(db.customers.where(name: sourceName), fullShape).asRelation()
  let orders = db.orders.where(total: sourceTotal).asRelation()
  let joined = source.join(orders, intScalar(), quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: Int
      return value.first.first + leftShift
    end, quote do |order: Order|: Int
      return order.customerId + rightShift
    end).matchingPair(quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>, order: Order|: Bool
      return value.first.first > minimumId && order.total > minimumId
    end).take(10)

  match joined.compile()
    case CompileResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          console::println(name)
        case QueryFailure.Provider(message)
          console::println(message)
        case QueryFailure.TypeMismatch(column, expected, actual)
          console::println(column + " expected " + expected + " got " + actual)
        case QueryFailure.SourceMismatch(expected, actual)
          console::println("source expected " + expected + " got " + actual)
        case QueryFailure.InvalidIdentifier(name)
          console::println("invalid " + name)
        case QueryFailure.InvalidLimit(value, maximum)
          console::println("invalid limit")
        case QueryFailure.MissingLimit(maximum)
          console::println("missing limit")
        case QueryFailure.MissingColumn(name)
          console::println("missing " + name)
        case QueryFailure.Cardinality(expected, actual)
          console::println("cardinality " + expected)
      end

      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 7)
      let second = assertProjectedTextParameter(plan.sql().parameters().first(), suffix)
      let third = assertProjectedTextParameter(second, sourceName)
      let fourth = assertProjectedIntParameter(third, sourceTotal)
      let fifth = assertProjectedIntParameter(fourth, leftShift)
      let sixth = assertProjectedIntParameter(fifth, rightShift)
      let seventh = assertProjectedIntParameter(sixth, minimumId)
      let remaining = assertProjectedIntParameter(seventh, minimumId)

      test::assertTrue(remaining == null)
  end

  let plainShape = pairShape(fieldShape(intScalar(), projectedCustomerId()), fieldShape(textScalar(), projectedCustomerName()))
  let numbered = project(db.customers.where(name: sourceName), plainShape).asRelation().join(orders, intScalar(), quote do |value: ProjectedPair<Int, String>|: Int
      return value.first
    end, projectedOrderCustomerId()).matchingPair(quote do |value: ProjectedPair<Int, String>, order: Order|: Bool
      return value.first > minimumId && order.total > minimumId
    end).take(10)

  match numbered.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      test::assertTrue(containsText(plan.sql().sql(), "$1"))
      test::assertTrue(containsText(plan.sql().sql(), "$4"))
      let second = assertProjectedTextParameter(plan.sql().parameters().first(), sourceName)
      let third = assertProjectedIntParameter(second, sourceTotal)
      let fourth = assertProjectedIntParameter(third, minimumId)
      let remaining = assertProjectedIntParameter(fourth, minimumId)

      test::assertTrue(remaining == null)
  end

  match joined.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.first.first, 1)
        test::assertEqual(first.value.left.first.second, "Ada!")
        test::assertTrue(first.value.left.second == null)
        test::assertEqual(first.value.right.customerId, 2)
      end
  end

  # The first window is fixed before this projected-row filter runs.
  let stageFiltered = project(db.customers.orderBy(projectedCustomerId()).take(2), fullShape).asRelation().matching(quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: Bool
      return value.first.first >= 2
    end)
  let reprojected = projectRelation(stageFiltered, pairShape(fieldShape(intScalar(), quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: Int
          return value.first.first
        end), fieldShape(optionalTextScalar(), quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: String?
          return value.second
        end)))

  match reprojected.take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, 2)
        test::assertTrue(first.value.second == "ada")
      end
  end

  # Ordering metadata survives a projection that omits the order key.
  let descending = db.customers.asRelation().orderBy(quote do |customer: Customer|: Int
      return customer.id
    end, true)
  let withoutOrderKey = projectRelation(descending, pairShape(fieldShape(textScalar(), quote do |customer: Customer|: String
          return customer.name
        end), fieldShape(optionalTextScalar(), projectedCustomerNickname())))

  match withoutOrderKey.take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, "Cy")
        test::assertTrue(first.value.second == null)
      end
  end

  let stopAfterFirst: fn(ProjectedPair<String, String?>): Bool = fn(value: ProjectedPair<String, String?>): Bool
    test::assertEqual(value.first, "Cy")
    return false
  end

  match withoutOrderKey.streamWith(provider, stopAfterFirst)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  # Projection limits compose monotonically and remain attached to its relation.
  let capped = projectRelation(db.customers.asRelation(), fullShape).take(1).take(3).asRelation()

  match capped.aggregate(countRows<ProjectedPair<ProjectedPair<Int, String>, String?>>()).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(count)
      test::assertEqual(count, 1)
  end

  let invalidThenValid = projectRelation(db.customers.asRelation(), fullShape).take(0).take(3).asRelation()

  match invalidThenValid.aggregate(countRows<ProjectedPair<ProjectedPair<Int, String>, String?>>()).value()
    case QueryValue.Failure(error)
      match error
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertEqual(value, 0)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryValue.Value(count)
      test::assertTrue(false)
  end

  # Outer joins over projected relations preserve absence without decoding nullable leaves as required values.
  let projectedLeft = project(db.customers.where(id: 1), fullShape).asRelation()
  let projectedMissingRight = project(db.customers.where(id: 4), fullShape).asRelation()

  match projectedLeft.leftJoin(projectedMissingRight, intScalar(), quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: Int
      return value.first.first
    end, quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: Int
      return value.first.first
    end).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertTrue(first.value.right == null)
      end
  end

  let nullableGrouping = stageFiltered.groupBy(fieldShape(optionalTextScalar(), quote do |value: ProjectedPair<ProjectedPair<Int, String>, String?>|: String?
        return value.second
      end))
  let grouped = selectGroups(nullableGrouping, countRows<ProjectedPair<ProjectedPair<Int, String>, String?>>()) do |nickname: String?, count: Int|: ProjectedGroups
    return new ProjectedGroups(nickname, count)
  end

  match grouped.take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.count, 1)
        test::assertTrue(first.value.nickname == "ada")
      end
  end

  let calls = new ProjectedCallbacks()
  let codecCalls = new CustomCodecCalls()
  let customRead: fn(Cell): DecodeResult<Int> = fn(cell: Cell): DecodeResult<Int>
    codecCalls.count = codecCalls.count + 1
    match decodeScalarInt(cell)
      case DecodeResult.Failure(error)
        return DecodeResult<Int>.Failure(error)
      case DecodeResult.Value(value)
        return DecodeResult<Int>.Value(value + 100)
    end
  end
  let customInt = new ScalarCodec<Int>(customRead, ResultColumnKind.Int(), false, "Int")
  let customPair = pairShape(fieldShape(customInt, projectedCustomerId()), fieldShape(textScalar(), projectedCustomerName()))
  let customCodecRelation = project(db.customers.where(id: 1), customPair).asRelation().take(1)
  let beforeCustomCodec = probe.calls

  match customCodecRelation.all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(name != "")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  test::assertEqual(codecCalls.count, 0)
  test::assertEqual(probe.calls, beforeCustomCodec)

  let arbitraryShape = combineShapes(fieldShape(intScalar(), projectedCustomerId()), fieldShape(textScalar(), projectedCustomerName())) do |id: Int, name: String|: ArbitraryProjected
    calls.count = calls.count + 1
    return new ArbitraryProjected(id, name)
  end

  match projectRelation(db.customers.where(id: 1).asRelation(), arbitraryShape).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.id, 1)
        test::assertEqual(first.value.name, "Ada")
      end
  end

  test::assertEqual(calls.count, 1)
  let invalidSource = project(db.customers.where(id: 1), arbitraryShape).asRelation()
  let beforeInvalidRelation = probe.calls

  match invalidSource.join(db.orders.asRelation(), intScalar(), quote do |value: ArbitraryProjected|: Int
      return value.id
    end, projectedOrderCustomerId()).take(1).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(name != "")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  test::assertEqual(calls.count, 1)
  test::assertEqual(probe.calls, beforeInvalidRelation)
end

def verifyProjectedRelationsFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-projected-relations-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES (1, 'Ada', 1, NULL), (2, 'Bea', 1, 'ada'), (3, 'Cy', 0, NULL); INSERT INTO orders VALUES (10, 1, 90), (11, 2, 9);"

    test::assertTrue(createSQLiteFixture(path, sql))

    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyProjectedRelations(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyProjectedRelationsFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
