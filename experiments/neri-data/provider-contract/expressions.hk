use files
use resources
use result
use test
use host
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class ExpressionRow
  public id: Int = 0
  public value: Int = 0
  public amount: Float = 0.0
  public label: String = ""
  public optionalValue: Int? = null
end

class ExpressionPair
  public id: Int
  public calculated: Int

  def init(id: Int, calculated: Int): Void
    this.id = id
    this.calculated = calculated
  end
end

class ExpressionGroup
  public bucket: Int
  public count: Int

  def init(bucket: Int, count: Int): Void
    this.bucket = bucket
    this.count = count
  end
end

class ExpressionJoin
  public label: String
  public calculated: Int

  def init(label: String, calculated: Int): Void
    this.label = label
    this.calculated = calculated
  end
end

class NoCheckedExpressionProvider: Provider
  private inner: Provider
  public calls: Int = 0

  def init(inner: Provider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.BoundedTypedReads()
        return this.inner.supports(capability)
      case ProviderCapability.StreamingReads()
        return this.inner.supports(capability)
      case ProviderCapability.SetWrites()
        return this.inner.supports(capability)
      case ProviderCapability.TrackedWrites()
        return this.inner.supports(capability)
      case ProviderCapability.ExplicitTransactions()
        return this.inner.supports(capability)
      case ProviderCapability.Savepoints()
        return this.inner.supports(capability)
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    return this.inner.execute(plan)
  end
end

class ExpressionVisits
  public count: Int = 0
end

def rejectExpressionRow(row: RawRow): DecodeResult<ExpressionRow>
  return DecodeResult<ExpressionRow>.Failure(QueryFailure.Provider("expression projection must not decode entities"))
end

def expressionRows(provider: Provider): Query<ExpressionRow>
  let mapping = new EntityMapping("ExpressionRow", "expression_rows", [
      new MappingColumn("ExpressionRow.id", "Int", "id"),
      new MappingColumn("ExpressionRow.value", "Int", "value"),
      new MappingColumn("ExpressionRow.amount", "Float", "amount"),
      new MappingColumn("ExpressionRow.label", "String", "label"),
      new MappingColumn("ExpressionRow.optionalValue", "Int?", "optional_value")
    ], "id")
  let decoder = new Decoder<ExpressionRow>(rejectExpressionRow, new ResultColumns([
        new ResultColumn("id", ResultColumnKind.Int()),
        new ResultColumn("value", ResultColumnKind.Int()),
        new ResultColumn("amount", ResultColumnKind.Float()),
        new ResultColumn("label", ResultColumnKind.Text()),
        new ResultColumn("optional_value", ResultColumnKind.Int(), true)
      ]))

  return new Query<ExpressionRow>("expression_rows", decoder, mapping: mapping, provider: provider)
end

def expressionId(): quote fn(ExpressionRow): Int
  return quote do |row: ExpressionRow|: Int
    return row.id
  end
end

def expressionIdBelow(bound: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.id < bound
  end
end

def expressionValue(): quote fn(ExpressionRow): Int
  return quote do |row: ExpressionRow|: Int
    return row.value
  end
end

def valueAbove(threshold: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.value > threshold
  end
end

def valuePlusAbove(offset: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.value + offset > 15
  end
end

def valuePlus(offset: Int): quote fn(ExpressionRow): Int
  return quote do |row: ExpressionRow|: Int
    return row.value + offset
  end
end

def idPlus(offset: Int): quote fn(ExpressionRow): Int
  return quote do |row: ExpressionRow|: Int
    return row.id + offset
  end
end

def optionalEquals(expected: Int?): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return (row.id > 0 ? row.optionalValue : null) == expected
  end
end

def errorUnlessFirstRow(threshold: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.id == 1 || row.value / 0 > threshold
  end
end

def alwaysError(threshold: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.value / 0 > threshold
  end
end

def falseAndError(threshold: Int): quote fn(ExpressionRow): Bool
  return quote do |row: ExpressionRow|: Bool
    return row.id != 1 && row.value / 0 > threshold
  end
end

def assertProviderFailure<T>(result: QueryResult<T>): Void
  match result
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertTrue(message != "")
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
end

def assertCheckedCapabilityFailure<T>(result: QueryResult<T>): Void
  match result
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(values)
      test::assertTrue(false)
  end
end

def assertCheckedValueFailure<T>(result: QueryValue<T>): Void
  match result
    case QueryValue.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryValue.Value(value)
      test::assertTrue(false)
  end
end

def verifyExpressions(provider: SQLiteProvider): Void
  let rows = expressionRows(provider)
  let delta = 1
  let scale = 2
  let suffix = "!"
  let integer = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return ((row.value + delta) * scale - 4) / 2
    end)
  let pair = combineShapes(fieldShape(intScalar(), expressionId()), integer) do |id: Int, calculated: Int|: ExpressionPair
    return new ExpressionPair(id, calculated)
  end
  let noChecked = new NoCheckedExpressionProvider(provider)

  match project(expressionRows(noChecked).where(id: 1).take(1), integer).all()
    case QueryResult.Rows(values)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  test::assertEqual(noChecked.calls, 0)

  let noCheckedFiltered = expressionRows(noChecked).take(3).matching(valuePlusAbove(0))

  assertCheckedCapabilityFailure(project(noCheckedFiltered, fieldShape(intScalar(), expressionId())).all())

  let noCheckedJoin = join(noCheckedFiltered, expressionRows(noChecked).take(3), intScalar(), expressionId(), expressionId()).take(2)
  let noCheckedJoined = projectJoin(noCheckedJoin, fieldShape(intScalar(), expressionId()), fieldShape(intScalar(), expressionId())) do |leftId: Int, rightId: Int|: ExpressionJoin
    return new ExpressionJoin("", leftId + rightId)
  end

  assertCheckedCapabilityFailure(noCheckedJoined.all())

  assertCheckedValueFailure(aggregateRows(noCheckedFiltered, countRows<ExpressionRow>()).value())

  test::assertEqual(noChecked.calls, 0)

  match project(rows.where(id: 1).take(1), integer).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertTrue(false)
    case CompileResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(name != "")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  match project(rows.where(id: 1).orderBy(expressionId()).take(1).where(value: 10), pair).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertEqual(values.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.id, 1)
        test::assertEqual(first.value.calculated, 9)
      end
  end

  let matching = join(rows.where(id: 1), rows.where(id: 1), intScalar(), expressionId(), expressionId()).take(10)
  let leftLabel = expressionShape(textScalar(), quote do |row: ExpressionRow|: String
      return row.label + suffix
    end)
  let rightValue = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value + delta
    end)
  let joined = projectJoin(matching, leftLabel, rightValue) do |label: String, calculated: Int|: ExpressionJoin
    return new ExpressionJoin(label, calculated)
  end

  match joined.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.label, "A!")
        test::assertEqual(first.value.calculated, 11)
      end
  end

  let label = expressionShape(textScalar(), quote do |row: ExpressionRow|: String
      return row.label + suffix
    end)

  match project(rows.where(id: 7).take(1), label).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(host::stringByteLength(first.value), 4)
        test::assertEqual(host::stringByteAt(first.value, 1), 0 as Byte)
        test::assertEqual(host::stringByteAt(first.value, 3), 33 as Byte)
      end
  end

  let floatValue = expressionShape(floatScalar(), quote do |row: ExpressionRow|: Float
      return row.amount / 2.0 + 0.5
    end)

  match project(rows.where(id: 1).take(1), floatValue).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, 1.25)
      end
  end

  let afterWindow = project(rows.orderBy(expressionId()).take(3).matching(valuePlusAbove(0)).orderBy(valuePlus(1)).thenBy(idPlus(0)).take(5), fieldShape(intScalar(), expressionId()))

  match afterWindow.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 2)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        let second = first.next

        test::assertTrue(second != null)
        if second != null
          test::assertEqual(first.value, 2)
          test::assertEqual(second.value, 3)
        end
      end
  end

  let distinctOrder = project(rows.orderBy(expressionId()).take(3).distinct().orderBy(valuePlus(0), true).thenBy(idPlus(0)).skip(1).take(1), fieldShape(intScalar(), expressionId()))

  match distinctOrder.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 1)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, 3)
      end
  end

  match project(rows.where(id: 1).take(1).matching(optionalEquals(null)), fieldShape(intScalar(), expressionId())).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 1)
  end

  match project(rows.orderBy(expressionId()).take(3).matching(optionalEquals(20)), fieldShape(intScalar(), expressionId())).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 2)
  end

  # Each arithmetic subtree is checked before a later operation can hide overflow.
  let cancellation = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return (row.value + 1) - 1
    end)
  let divideByZero = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value / 0
    end)
  let divisor = -1
  let divideMinimum = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value / divisor
    end)
  let negateMinimum = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return -row.value
    end)
  let wrongStorage = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value + 1
    end)
  let floatOverflow = expressionShape(floatScalar(), quote do |row: ExpressionRow|: Float
      return row.amount * row.amount
    end)
  let wrongFloatStorage = expressionShape(floatScalar(), quote do |row: ExpressionRow|: Float
      return row.amount + 1.0
    end)

  assertProviderFailure(project(rows.where(id: 4).take(1), cancellation).all())
  assertProviderFailure(project(rows.where(id: 1).take(1), divideByZero).all())
  assertProviderFailure(project(rows.where(id: 6).take(1), divideMinimum).all())
  assertProviderFailure(project(rows.where(id: 6).take(1), negateMinimum).all())
  assertProviderFailure(project(rows.where(id: 5).take(1), wrongStorage).all())
  assertProviderFailure(project(rows.where(id: 4).take(1), floatOverflow).all())
  assertProviderFailure(project(rows.where(id: 8).take(1), wrongFloatStorage).all())
  assertProviderFailure(project(rows.where(id: 5).take(1), wrongFloatStorage).all())

  assertProviderFailure(project(rows.where(id: 1).take(1).matching(alwaysError(0)), fieldShape(intScalar(), expressionId())).all())

  match project(rows.where(id: 1).take(1).matching(errorUnlessFirstRow(0)), fieldShape(intScalar(), expressionId())).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 1)
  end

  match project(rows.where(id: 1).take(1).matching(falseAndError(0)), fieldShape(intScalar(), expressionId())).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 0)
  end

  let falseGuard: quote fn(ExpressionRow): Bool = quote do |row: ExpressionRow|: Bool
    return row.id != 1
  end

  match project(rows.where(id: 1).take(1).matching(falseGuard).matching(alwaysError(0)), fieldShape(intScalar(), expressionId())).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      test::assertEqual(values.count(), 0)
  end

  let visits = new ExpressionVisits()
  let visit: fn(Int): Bool = fn(value: Int): Bool
    visits.count = visits.count + 1

    test::assertEqual(value, 9)
    return false
  end

  match project(rows.where(id: 1).take(1), integer).stream(visit)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertEqual(visits.count, 1)

  match project(rows.where(id: 4).take(1), cancellation).stream(visit)
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 0)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(visits.count, 1)

  let lazy = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.id == 1 ? row.value + 1 : row.value / 0
    end)

  match project(rows.where(id: 1).take(1), lazy).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, 11)
      end
  end

  # A missing right row must not evaluate a required expression on its NULL columns.
  let missing = leftJoin(rows.where(id: 1), rows.where(id: 2), intScalar(), expressionId(), expressionId()).take(10)
  let right = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value + 1
    end)

  let missingProjection = projectLeftJoin(missing, fieldShape(intScalar(), expressionId()), right) do |id: Int, calculated: Int?|: ExpressionPair
    var actual = -1

    if calculated != null
      actual = calculated
    end
    return new ExpressionPair(id, actual)
  end

  match missingProjection.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.calculated, -1)
      end
  end

  let bucket = 10
  let key = expressionShape(intScalar(), quote do |row: ExpressionRow|: Int
      return row.value / bucket
    end)
  let count = groupMetric(countRows<ExpressionRow>())
  let hasTwo = quote do |value: Int|: Bool
    return value == 2
  end
  let belowFour = quote do |row: ExpressionRow|: Bool
    return row.id < 4
  end
  let groups = selectGroups(groupBy(rows.matching(belowFour), key), countRows<ExpressionRow>()) do |key: Int, count: Int|: ExpressionGroup
    return new ExpressionGroup(key, count)
  end

  match groups.having(count.where(hasTwo)).orderByKey(true).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(values)
      let first = values.first()

      test::assertEqual(values.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.bucket, 2)
        test::assertEqual(first.value.count, 2)
      end
  end

  let delete = rows.orderBy(expressionId()).take(3).matching(valuePlusAbove(0)).orderBy(valuePlus(0)).thenBy(expressionId()).take(2)

  match delete.executeDelete()
    case WriteResult.Saved(count)
      test::assertEqual(count, 2)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  match rows.where(id: 2).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyExpressionFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-scalar-expressions-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE expression_rows(id INTEGER, value, amount, label TEXT, optional_value); INSERT INTO expression_rows VALUES (1, 10, 1.5, 'A', NULL), (2, 20, 2.5, 'B', 20), (3, 20, 3.5, 'C', 20), (4, 9223372036854775807, 1e308, 'D', 40), (5, 'wrong', 'wrong', 'E', 50), (6, -9223372036854775808, 2.0, 'F', 60), (7, 30, 4.0, CAST(x'580059' AS TEXT), 70), (8, 40, 1e999, 'H', 80);"

    test::assertTrue(createSQLiteFixture(path, sql))

    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        test::assertTrue(provider.supports(ProviderCapability.CheckedScalarExpressions()))
        verifyExpressions(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyExpressionFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
