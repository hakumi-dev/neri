use files
use resources
use result
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class Measurement
  public id: Int
  public bucket: String?
  public segment: Int?
  public amount: Int?
  public label: String?

  def init(id: Int, bucket: String?, segment: Int?, amount: Int?, label: String?): Void
    this.id = id
    this.bucket = bucket
    this.segment = segment
    this.amount = amount
    this.label = label
  end
end

class GroupKey
  public bucket: String?
  public segment: Int?

  def init(bucket: String?, segment: Int?): Void
    this.bucket = bucket
    this.segment = segment
  end
end

class AggregateCounts
  public rows: Int
  public amounts: Int

  def init(rows: Int, amounts: Int): Void
    this.rows = rows
    this.amounts = amounts
  end
end

class GroupSummary
  public key: GroupKey
  public counts: AggregateCounts

  def init(key: GroupKey, counts: AggregateCounts): Void
    this.key = key
    this.counts = counts
  end
end

class NumericSummary
  public sum: Int?
  public minimum: Int?
  public maximum: Int?

  def init(sum: Int?, minimum: Int?, maximum: Int?): Void
    this.sum = sum
    this.minimum = minimum
    this.maximum = maximum
  end
end

class ModifierSummary
  public key: String?
  public rows: Int
  public unique: Int
  public total: Int?
  public zero: Int

  def init(key: String?, rows: Int, unique: Int, total: Int?, zero: Int): Void
    this.key = key
    this.rows = rows
    this.unique = unique
    this.total = total
    this.zero = zero
  end
end

def matchesInt(value: Int?, expected: Int): Bool
  if value == null
    return false
  end
  return value == expected
end

def matchesText(value: String?, expected: String): Bool
  if value == null
    return false
  end
  return value == expected
end

def decodeMeasurement(row: RawRow): DecodeResult<Measurement>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<Measurement>.Failure(error)
    case DecodeResult.Value(id)
      match decodeNullableString(row, "bucket")
        case DecodeResult.Failure(error)
          return DecodeResult<Measurement>.Failure(error)
        case DecodeResult.Value(bucket)
          match decodeNullableInt(row, "segment")
            case DecodeResult.Failure(error)
              return DecodeResult<Measurement>.Failure(error)
            case DecodeResult.Value(segment)
              match decodeNullableInt(row, "amount")
                case DecodeResult.Failure(error)
                  return DecodeResult<Measurement>.Failure(error)
                case DecodeResult.Value(amount)
                  match decodeNullableString(row, "label")
                    case DecodeResult.Failure(error)
                      return DecodeResult<Measurement>.Failure(error)
                    case DecodeResult.Value(label)
                      return DecodeResult<Measurement>.Value(new Measurement(id, bucket, segment, amount, label))
                  end
              end
          end
      end
  end
end

def measurements(provider: SQLiteProvider): Query<Measurement>
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("bucket", ResultColumnKind.Text(), true),
      new ResultColumn("segment", ResultColumnKind.Int(), true),
      new ResultColumn("amount", ResultColumnKind.Int(), true),
      new ResultColumn("label", ResultColumnKind.Text(), true)
    ])
  let mapping = new EntityMapping("Measurement", "measurements", [
      new MappingColumn("Measurement.id", "Int", "id"),
      new MappingColumn("Measurement.bucket", "String?", "bucket"),
      new MappingColumn("Measurement.segment", "Int?", "segment"),
      new MappingColumn("Measurement.amount", "Int?", "amount"),
      new MappingColumn("Measurement.label", "String?", "label")
    ], "id")

  return new Query<Measurement>("measurements", new Decoder<Measurement>(decodeMeasurement, columns), mapping: mapping, provider: provider)
end

def bucketField(): quote fn(Measurement): String?
  return quote do |item: Measurement|: String?
    return item.bucket
  end
end

def segmentField(): quote fn(Measurement): Int?
  return quote do |item: Measurement|: Int?
    return item.segment
  end
end

def amountField(): quote fn(Measurement): Int?
  return quote do |item: Measurement|: Int?
    return item.amount
  end
end

def labelField(): quote fn(Measurement): String?
  return quote do |item: Measurement|: String?
    return item.label
  end
end

def idField(): quote fn(Measurement): Int
  return quote do |item: Measurement|: Int
    return item.id
  end
end

def groupKey(): RowShape<Measurement, GroupKey>
  return combineShapes(
    fieldShape(optionalTextScalar(), bucketField()),
    fieldShape(optionalIntScalar(), segmentField())
  ) do |bucket: String?, segment: Int?|: GroupKey
    return new GroupKey(bucket, segment)
  end
end

def countsShape(): AggregateShape<Measurement, AggregateCounts>
  return combineAggregates(countRows<Measurement>(), countNonNull(optionalIntScalar(), amountField())) do |rows: Int, amounts: Int|: AggregateCounts
    return new AggregateCounts(rows, amounts)
  end
end

def numericShape(): AggregateShape<Measurement, NumericSummary>
  let extremes = combineAggregates(minInt(optionalIntScalar(), amountField()), maxInt(optionalIntScalar(), amountField())) do |minimum: Int?, maximum: Int?|: NumericSummary
    return new NumericSummary(null, minimum, maximum)
  end

  return combineAggregates(sumInt(optionalIntScalar(), amountField()), extremes) do |sum: Int?, rest: NumericSummary|: NumericSummary
    return new NumericSummary(sum, rest.minimum, rest.maximum)
  end
end

def verifyGrouped(provider: SQLiteProvider): Void
  let source = measurements(provider).orderBy(idField()).take(8)
  let grouped = selectGroups(groupBy(source, groupKey()), countsShape()) do |key: GroupKey, counts: AggregateCounts|: GroupSummary
    return new GroupSummary(key, counts)
  end

  match grouped.take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 5)
      var row = rows.first()
      var sawNull = false
      var sawA1 = false
      var sawA2 = false
      var sawB = false
      var sawC = false

      while row != null
        let key = row.value.key

        if key.bucket == null
          test::assertTrue(matchesInt(key.segment, 1))
          test::assertEqual(row.value.counts.rows, 2)
          test::assertEqual(row.value.counts.amounts, 0)
          sawNull = true
        else
          if matchesText(key.bucket, "A") && matchesInt(key.segment, 1)
            test::assertEqual(row.value.counts.rows, 2)
            test::assertEqual(row.value.counts.amounts, 1)
            sawA1 = true
          end
          if matchesText(key.bucket, "A") && matchesInt(key.segment, 2)
            test::assertEqual(row.value.counts.rows, 1)
            sawA2 = true
          end
          if matchesText(key.bucket, "B")
            test::assertEqual(row.value.counts.rows, 2)
            sawB = true
          end
          if matchesText(key.bucket, "C")
            test::assertTrue(key.segment == null)
            test::assertEqual(row.value.counts.amounts, 0)
            sawC = true
          end
        end
        row = row.next
      end

      test::assertTrue(sawNull && sawA1 && sawA2 && sawB && sawC)
  end
end

def distinctMetrics(): AggregateShape<Measurement, ModifierSummary>
  let sums = combineAggregates(
    sumInt(optionalIntScalar(), amountField()).distinct(),
    sumIntOrZero(optionalIntScalar(), amountField()).distinct()
  ) do |total: Int?, zero: Int|: ModifierSummary
    return new ModifierSummary(null, 0, 0, total, zero)
  end

  return combineAggregates(countNonNull(optionalIntScalar(), amountField()).distinct(), sums) do |unique: Int, values: ModifierSummary|: ModifierSummary
    return new ModifierSummary(null, 0, unique, values.total, values.zero)
  end
end

def verifyModifiers(provider: SQLiteProvider): Void
  let source = measurements(provider)
  let allAndDistinct = combineAggregates(countRows<Measurement>(), distinctMetrics()) do |rows: Int, values: ModifierSummary|: ModifierSummary
    return new ModifierSummary(null, rows, values.unique, values.total, values.zero)
  end

  match aggregateRows(source.where(bucket: "bulk"), allAndDistinct).value()
    case QueryValue.Value(value)
      test::assertEqual(value.rows, 1201)
      test::assertEqual(value.unique, 1)
      test::assertTrue(matchesInt(value.total, 1))
      test::assertEqual(value.zero, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "C"), distinctMetrics()).value()
    case QueryValue.Value(value)
      test::assertEqual(value.unique, 0)
      test::assertTrue(value.total == null)
      test::assertEqual(value.zero, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let none = quote do |item: Measurement|: Bool
    return item.id < 0
  end
  let filteredMetrics = combineAggregates(countRows<Measurement>(), distinctMetrics().where(none)) do |rows: Int, values: ModifierSummary|: ModifierSummary
    return new ModifierSummary(null, rows, values.unique, values.total, values.zero)
  end
  let grouped = selectGroups(groupBy(source.orderBy(idField()).take(8), fieldShape(optionalTextScalar(), bucketField())), filteredMetrics) do |key: String?, value: ModifierSummary|: ModifierSummary
    return new ModifierSummary(key, value.rows, value.unique, value.total, value.zero)
  end

  match grouped.take(10).all()
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var current = rows.first()
      var totalRows = 0
      var sawNull = false

      while current != null
        test::assertEqual(current.value.unique, 0)
        test::assertTrue(current.value.total == null)
        test::assertEqual(current.value.zero, 0)
        totalRows = totalRows + current.value.rows
        if current.value.key == null
          sawNull = true
        end
        current = current.next
      end

      test::assertEqual(totalRows, 8)
      test::assertTrue(sawNull)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  let positive = quote do |item: Measurement|: Bool
    return item.id > 0
  end
  let early = quote do |item: Measurement|: Bool
    return item.id < 3
  end
  let baseCount = countRows<Measurement>()
  let independent = combineAggregates(baseCount, baseCount.where(positive).where(early)) do |all: Int, selected: Int|: AggregateCounts
    return new AggregateCounts(all, selected)
  end

  match aggregateRows(source.where(bucket: "A"), independent).value()
    case QueryValue.Value(value)
      test::assertEqual(value.rows, 3)
      test::assertEqual(value.amounts, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let hostile = "O'Reilly; DROP TABLE measurements; -- 水"
  let hostileValue: String? = hostile
  let hostileFilter = quote do |item: Measurement|: Bool
    return item.label == hostileValue
  end

  match aggregateRows(source.where(bucket: "B"), baseCount.where(hostileFilter)).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let later = quote do |item: Measurement|: Bool
    return item.id >= 2
  end

  match aggregateRows(source.orderBy(idField()).take(2), sumIntOrZero(optionalIntScalar(), amountField()).where(later)).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.orderBy(idField()).take(3).skip(1), baseCount.where(early)).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "overflow"), sumInt(optionalIntScalar(), amountField()).where(none)).value()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyAggregates(provider: SQLiteProvider): Void
  let source = measurements(provider)
  let hostile = "O'Reilly; DROP TABLE measurements; -- 水"

  match aggregateRows(source.where(bucket: "A"), countsShape()).value()
    case QueryValue.Value(value)
      test::assertEqual(value.rows, 3)
      test::assertEqual(value.amounts, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "A"), numericShape()).value()
    case QueryValue.Value(value)
      test::assertTrue(matchesInt(value.sum, 30))
      test::assertTrue(matchesInt(value.minimum, 10))
      test::assertTrue(matchesInt(value.maximum, 20))
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "C"), numericShape()).value()
    case QueryValue.Value(value)
      test::assertTrue(value.sum == null && value.minimum == null && value.maximum == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(id: -1), numericShape()).value()
    case QueryValue.Value(value)
      test::assertTrue(value.sum == null && value.minimum == null && value.maximum == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(id: -1), sumIntOrZero(optionalIntScalar(), amountField())).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "C"), sumIntOrZero(optionalIntScalar(), amountField())).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(label: hostile), countRows<Measurement>()).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  # Aggregation reads a mapped source without constructing its malformed entity row.
  match aggregateRows(source.where(bucket: "Bad"), countRows<Measurement>()).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.orderBy(idField()).take(2).where(id: 3), countRows<Measurement>()).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let emptyGroups = selectGroups(groupBy(source.orderBy(idField()).take(2).where(id: 3), groupKey()), countRows<Measurement>()) do |key: GroupKey, count: Int|: Int
    return count
  end

  match emptyGroups.take(10).all()
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.orderBy(idField()).take(3).skip(1), sumInt(optionalIntScalar(), amountField())).value()
    case QueryValue.Value(value)
      test::assertTrue(matchesInt(value, 20))
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "A"), minString(optionalTextScalar(), labelField())).value()
    case QueryValue.Value(value)
      test::assertTrue(matchesText(value, "alpha"))
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "A"), maxString(optionalTextScalar(), labelField())).value()
    case QueryValue.Value(value)
      test::assertTrue(matchesText(value, "gamma"))
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "bulk").distinct(), countsShape()).value()
    case QueryValue.Value(value)
      test::assertEqual(value.rows, 1201)
      test::assertEqual(value.amounts, 1201)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "bulk"), sumInt(optionalIntScalar(), amountField())).value()
    case QueryValue.Value(value)
      test::assertTrue(matchesInt(value, 1201))
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(source.where(bucket: "overflow"), sumInt(optionalIntScalar(), amountField())).value()
    case QueryValue.Value(value)
      test::assertTrue(false)
    case QueryValue.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertEqual(message, "integer overflow")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  verifyGrouped(provider)
  verifyModifiers(provider)
end

def verifyAggregateFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-data-aggregates-")
    let path = temporary.path() + "/data.sqlite"
    var sql = "CREATE TABLE measurements(id INTEGER PRIMARY KEY, bucket TEXT, segment INTEGER, amount INTEGER, label TEXT);"

    sql = sql + "INSERT INTO measurements VALUES (1, 'A', 1, 10, 'alpha'), (2, 'A', 1, NULL, 'beta'), (3, 'A', 2, 20, 'gamma'), (4, NULL, 1, NULL, 'zeta'), (5, NULL, 1, NULL, 'eta'), (6, 'B', 2, -5, 'O''Reilly; DROP TABLE measurements; -- 水'), (7, 'B', 2, 5, NULL), (8, 'C', NULL, NULL, NULL), (9, 'Bad', 1, 7, x'80');"
    sql = sql + "WITH RECURSIVE seq(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM seq WHERE n<1200) INSERT INTO measurements SELECT 100+n, 'bulk', 9, 1, 'bulk' FROM seq;"
    sql = sql + "INSERT INTO measurements VALUES (2000, 'overflow', 1, 9223372036854775807, NULL), (2001, 'overflow', 1, 1, NULL);"

    test::assertTrue(createSQLiteFixture(path, sql))

    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyAggregates(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyAggregateFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
