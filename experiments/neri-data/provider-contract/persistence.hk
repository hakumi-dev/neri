use test
use console
use files
use resources
use result
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class CustomerSummary
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

def summary(id: Int, name: String): CustomerSummary
  return new CustomerSummary(id, name)
end

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failed(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(writeFailureMessage(error) != "")
  end
end

def failedAs(result: WriteResult, expected: String): Void
  var actual = "success"

  match result
    case WriteResult.Saved(count)
      actual = "success"
    case WriteResult.SavedWithValues(count, outputs)
      actual = "unexpected provider outputs"
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Validation(message)
          actual = "validation"
        case WriteFailure.Concurrency(message)
          actual = "concurrency"
        case WriteFailure.Constraint(message)
          actual = "constraint"
        case WriteFailure.Provider(message)
          actual = "provider"
        case WriteFailure.Unsupported(message)
          actual = "unsupported"
        case WriteFailure.Transaction(message)
          actual = "transaction"
      end
  end

  if actual != expected
    console::println("Expected " + expected + ", got " + actual)
  end

  test::assertEqual(actual, expected)
end

def customer(db: Database, id: Int): Customer?
  match db.customers.where(id: id).first()
    case QueryValue.Value(value)
      return value
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  return null
end

def customerIds(result: QueryResult<Customer>, expected: Int[]): Void
  match result
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), expected.Length)
      var row = rows.first()
      var index = 0

      while row != null
        test::assertEqual(row.value.id, expected[index])
        row = row.next
        index = index + 1
      end
  end
end

def counted(result: QueryValue<Int>, expected: Int): Void
  match result
    case QueryValue.Value(value)
      test::assertEqual(value, expected)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def cardinalityFailed(result: QueryValue<Customer>, actual: Int): Void
  match result
    case QueryValue.Value(value)
      test::assertTrue(false)
    case QueryValue.Failure(error)
      match error
        case QueryFailure.Cardinality(expected, count)
          test::assertEqual(count, actual)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, found)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, found)
          test::assertTrue(false)
      end
  end
end

def verifyQuery(provider: SQLiteProvider): Void
  let db = database(provider)

  match db.customers.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 3)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.customers.take(2).take(5).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.customers.where(id: 100).any()
    case QueryValue.Value(value)
      test::assertFalse(value)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(customer(db, 100) == null)
  let byId = quote do |value: Customer|: Int
    return value.id
  end
  let byName = quote do |value: Customer|: String
    return value.name
  end
  let byActive = quote do |value: Customer|: Bool
    return value.active
  end
  let cardinality = database(provider)

  cardinalityFailed(cardinality.customers.single(), 2)
  cardinalityFailed(cardinality.customers.where(id: 100).single(), 0)

  test::assertTrue(cardinality.customers.stateOf(new Customer(1, "untracked probe", true)) == null)
  match cardinality.customers.orderBy(byId).take(1).single()
    case QueryValue.Value(value)
      test::assertEqual(value.id, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match cardinality.customers.where(id: 100).singleOrDefault()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  customerIds(db.customers.orderBy(byId).take(2).where(active: false).all(), [])
  customerIds(db.customers.where(active: false).orderBy(byId).take(2).all(), [3])
  customerIds(db.customers.orderBy(byId).skip(1).orderBy(byId, true).take(1).all(), [3])
  customerIds(db.customers.orderByBool(byActive, true).thenBy(byId, true).skip(1).take(2).all(), [1, 3])
  customerIds(db.customers.orderBy(byId).take(2).orderBy(byId, true).all(), [2, 1])
  counted(db.customers.orderBy(byId).take(2).skip(1).count(), 1)
  match select(db.customers.orderBy(byId).take(2).where(active: true), textScalar(), byName).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
  end
  let projection = select2(db.customers.orderBy(byId).take(2), intScalar(), byId, textScalar(), byName, summary)

  match projection.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 2)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.id, 1)
        test::assertEqual(first.value.name, "Original")
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
end

def verifyChanges(provider: SQLiteProvider): Void
  let db = database(provider)
  let existing = customer(db, 1)

  test::assertTrue(existing != null)
  if existing == null
    return
  end
  existing.name = "Updated ' 水"
  let repeated = customer(db, 1)

  test::assertTrue(repeated != null && repeated.name == existing.name)
  test::assertTrue(db.customers.add(new Customer(1, "Duplicate", true)) != null)
  test::assertTrue(db.customers.add(new Customer(4, "Inserted", false, "nickname")) == null)
  test::assertTrue(db.orders.add(new Order(12, 4, 99)) == null)
  saved(db.saveChanges(), 3)
  saved(db.saveChanges(), 0)
  let fresh = database(provider)
  let updated = customer(fresh, 1)
  let inserted = customer(fresh, 4)

  test::assertTrue(updated != null && updated.name == "Updated ' 水")
  test::assertTrue(inserted != null)
  if inserted != null
    let nickname = inserted.nickname

    test::assertTrue(nickname != null)
    if nickname != null
      test::assertEqual(nickname, "nickname")
    end
  end
  let cancelled = new Customer(5, "Cancelled", true)

  test::assertTrue(db.customers.add(cancelled) == null)
  test::assertTrue(db.customers.remove(cancelled) == null)
  saved(db.saveChanges(), 0)

  test::assertTrue(customer(database(provider), 5) == null)
  existing.id = 100
  failed(db.saveChanges())
  existing.id = 1
  saved(db.saveChanges(), 0)
  match db.orders.where(id: 10).first()
    case QueryValue.Value(order)
      test::assertTrue(order != null)
      if order != null
        test::assertTrue(db.orders.remove(order) == null)
      end
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  saved(db.saveChanges(), 1)
  saved(db.saveChanges(), 0)
  match database(provider).orders.where(id: 10).any()
    case QueryValue.Value(value)
      test::assertFalse(value)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyExplicitRead(provider: SQLiteProvider): Void
  let db = database(provider)

  match db.customers.where(id: 2).first(provider)
    case QueryValue.Value(value)
      test::assertTrue(value != null)
      if value != null
        value.name = "Untracked edit"
      end
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  saved(db.saveChanges(), 0)
  let actual = customer(database(provider), 2)

  test::assertTrue(actual != null && actual.name == "Ada")
  test::assertTrue(db.customers.where(id: 2).add(new Customer(70, "Filtered add", true)) != null)
  let attached = new Customer(2, "Ada", true, "ada")

  test::assertTrue(db.customers.attach(attached) == null)
  attached.active = false
  attached.nickname = null
  saved(db.saveChanges(), 1)
  let changed = customer(database(provider), 2)

  test::assertTrue(changed != null && !changed.active && changed.nickname == null)
end

def verifyRollback(provider: SQLiteProvider): Void
  let db = database(provider)
  let added = new Customer(8, "Rollback then retry", true)
  let dependent = new Order(90, 999, 8)

  test::assertTrue(db.customers.add(added) == null)
  test::assertTrue(db.orders.add(dependent) == null)
  failedAs(db.saveChanges(), "constraint")

  test::assertTrue(customer(database(provider), 8) == null)
  dependent.customerId = 8
  saved(db.saveChanges(), 2)
  saved(db.saveChanges(), 0)

  test::assertTrue(customer(database(provider), 8) != null)
end

def verifyConflict(provider: SQLiteProvider, path: String): Void
  let first = database(provider)
  let original = customer(first, 1)

  test::assertTrue(original != null)
  if original == null
    return
  end
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(other)
      let second = database(other)
      let stale = customer(second, 1)

      test::assertTrue(stale != null)
      if stale != null
        original.name = "Winner"
        saved(first.saveChanges(), 1)
        stale.name = "Stale overwrite"
        failedAs(second.saveChanges(), "concurrency")
        failedAs(second.saveChanges(), "concurrency")
        let actual = customer(database(provider), 1)

        test::assertTrue(actual != null && actual.name == "Winner")
        if actual != null
          test::assertTrue(second.customers.rebase(stale, actual) == null)
          saved(second.saveChanges(), 1)
          saved(second.saveChanges(), 0)
          let retried = customer(database(provider), 1)

          test::assertTrue(retried != null && retried.name == "Stale overwrite")
          if retried != null
            stale.name = "Discard this edit"

            test::assertTrue(second.customers.remove(stale) == null)
            test::assertTrue(second.customers.refreshFrom(stale, retried) == null)
            test::assertEqual(stale.name, "Stale overwrite")
            saved(second.saveChanges(), 0)
          end

          test::assertTrue(second.customers.detach(stale) == null)
          stale.name = "Detached edit"
          saved(second.saveChanges(), 0)
        end
      end

      test::assertTrue(other.close())
  end
end

def verifyTransactions(provider: SQLiteProvider): Void
  let db = database(provider)
  let existing = new Customer(40, "Before transaction", true)

  test::assertTrue(db.customers.add(existing) == null)
  saved(db.saveChanges(), 1)
  saved(db.beginTransaction(), 0)
  failedAs(db.beginTransaction(), "validation")
  existing.name = "First provisional save"
  saved(db.saveChanges(), 1)
  saved(db.saveChanges(), 0)
  let added = new Customer(41, "Pending transaction insert", true)

  test::assertTrue(db.customers.add(added) == null)
  saved(db.saveChanges(), 1)
  existing.name = "Local changes survive rollback"
  saved(db.saveChanges(), 1)
  saved(db.rollbackTransaction(), 0)
  let persisted = customer(database(provider), 40)

  test::assertTrue(persisted != null && persisted.name == "Before transaction")
  test::assertTrue(customer(database(provider), 41) == null)
  saved(db.saveChanges(), 2)
  saved(db.saveChanges(), 0)

  test::assertTrue(customer(database(provider), 41) != null)
  saved(db.beginTransaction(), 0)
  existing.name = "Committed after savepoint recovery"
  saved(db.saveChanges(), 1)
  let unrelated = database(provider)

  test::assertTrue(unrelated.customers.add(new Customer(42, "Wrong transaction owner", true)) == null)
  failedAs(unrelated.saveChanges(), "transaction")
  let dependent = new Order(140, 9999, 12)

  test::assertTrue(db.orders.add(dependent) == null)
  failedAs(db.saveChanges(), "constraint")
  dependent.customerId = 40
  saved(db.saveChanges(), 1)
  saved(db.commitTransaction(), 0)
  let committed = customer(database(provider), 40)

  test::assertTrue(committed != null && committed.name == "Committed after savepoint recovery")
  test::assertTrue(customer(database(provider), 42) == null)
  saved(db.saveChanges(), 0)
  db.clear()
  existing.name = "Cleared instance is detached"
  saved(db.saveChanges(), 0)
end

def verifyAutomaticRollback(provider: SQLiteProvider): Void
  let db = database(provider)
  let existing = customer(db, 40)

  test::assertTrue(existing != null)
  if existing == null
    return
  end
  saved(db.beginTransaction(), 0)
  existing.name = "Retry after automatic rollback"
  saved(db.saveChanges(), 1)
  let rejected = new Customer(77, "Trigger rollback", true)

  test::assertTrue(db.customers.add(rejected) == null)
  failedAs(db.saveChanges(), "constraint")
  let persisted = customer(database(provider), 40)

  test::assertTrue(persisted != null && persisted.name == "Committed after savepoint recovery")
  test::assertTrue(db.customers.detach(rejected) == null)
  saved(db.saveChanges(), 1)
  saved(db.saveChanges(), 0)
end

def verifyDeleteRetry(provider: SQLiteProvider): Void
  let db = database(provider)
  let deleted = new Customer(43, "Delete after rollback", true)

  test::assertTrue(db.customers.add(deleted) == null)
  saved(db.saveChanges(), 1)
  saved(db.beginTransaction(), 0)

  test::assertTrue(db.customers.remove(deleted) == null)
  saved(db.saveChanges(), 1)
  saved(db.rollbackTransaction(), 0)

  test::assertTrue(customer(database(provider), 43) != null)
  saved(db.saveChanges(), 1)

  test::assertTrue(customer(database(provider), 43) == null)
end

def verifyCloseRollback(path: String): Void
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      let db = database(provider)
      let existing = customer(db, 40)

      test::assertTrue(existing != null)
      if existing != null
        saved(db.beginTransaction(), 0)
        existing.name = "Closing discards database writes"
        saved(db.saveChanges(), 1)

        test::assertTrue(provider.close())
        failedAs(db.saveChanges(), "transaction")
        let original = db.customers.original(existing)

        test::assertTrue(original != null)
        if original != null
          match decodeString(original, "name")
            case DecodeResult.Value(value)
              test::assertEqual(value, "Retry after automatic rollback")
            case DecodeResult.Failure(error)
              test::assertTrue(false)
          end
        end
      end

      test::assertTrue(provider.close())
  end
end

def verifyAdvancedQueries(directory: String): Void
  let path = directory + "/large.sqlite"
  let schema = "CREATE TABLE customers (id INTEGER, name TEXT, active INTEGER, nickname TEXT, unmapped INTEGER);"
  let large = "WITH RECURSIVE numbers(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM numbers WHERE id < 1505) INSERT INTO customers SELECT id, 'row', CASE WHEN id = 1505 THEN 1 ELSE 0 END, NULL, id FROM numbers;"

  test::assertTrue(createSQLiteFixture(path, schema + large))
  match SQLiteProvider.open(path)
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      let db = database(provider)
      let byId = quote do |value: Customer|: Int
        return value.id
      end

      customerIds(db.customers.orderBy(byId).skip(1).where(active: true).take(1).all(), [1505])
      counted(db.customers.orderBy(byId).skip(1000).count(), 505)
      counted(db.customers.count(), 1505)

      test::assertTrue(provider.close())
  end
  let distinctPath = directory + "/distinct.sqlite"
  let duplicates = "INSERT INTO customers VALUES (1, 'same', 1, NULL, 10), (1, 'same', 1, NULL, 20), (2, 'same', 1, NULL, 30);"

  test::assertTrue(createSQLiteFixture(distinctPath, schema + duplicates))
  match SQLiteProvider.open(distinctPath)
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      let db = database(provider)
      let byId = quote do |value: Customer|: Int
        return value.id
      end
      let byActive = quote do |value: Customer|: Bool
        return value.active
      end

      customerIds(db.customers.distinct().orderBy(byId).take(3).all(), [1, 2])
      counted(db.customers.distinct().count(), 2)
      match select(db.customers.distinct().take(3), boolScalar(), byActive).all()
        case QueryResult.Failure(error)
          test::assertTrue(false)
        case QueryResult.Rows(rows)
          test::assertEqual(rows.count(), 2)
      end

      test::assertTrue(provider.close())
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-data-persistence-")
    let path = temporary.path() + "/data.sqlite"
    var sql = "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, active INTEGER NOT NULL, nickname TEXT);"

    sql = sql + "CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER NOT NULL REFERENCES customers(id), total INTEGER NOT NULL);"
    sql = sql + "INSERT INTO customers VALUES (1, 'Original', 1, NULL), (2, 'Ada', 1, 'ada'), (3, 'Lin', 0, NULL);"
    sql = sql + "INSERT INTO orders VALUES (10, 1, 42);"
    sql = sql + "CREATE TRIGGER reject_customer BEFORE INSERT ON customers WHEN NEW.id = 77 BEGIN SELECT RAISE(ROLLBACK, 'forced rollback'); END;"

    verifyAdvancedQueries(temporary.path())

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        console::println(message)

        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        console::println("Verifying queries and tracking")
        verifyQuery(provider)
        verifyChanges(provider)
        verifyExplicitRead(provider)
        verifyRollback(provider)
        verifyConflict(provider, path)
        console::println("Verifying explicit transactions")
        verifyTransactions(provider)
        console::println("Verifying automatic rollback")
        verifyAutomaticRollback(provider)
        console::println("Verifying delete retry")
        verifyDeleteRetry(provider)
        console::println("Verifying close rollback")
        verifyCloseRollback(path)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        let db = database(provider)
        let persisted = customer(db, 1)

        test::assertTrue(persisted != null && persisted.name == "Stale overwrite")
        test::assertTrue(db.customers.add(new Customer(99, "Read-only", false)) == null)
        failedAs(db.saveChanges(), "unsupported")

        test::assertTrue(customer(database(provider), 99) == null)
        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("SQLite persistence and query integration contracts passed")
end
