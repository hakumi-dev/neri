use files
use host
use resources
use result
use test
use model
use app_data
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use quotation

class JoinDispatchProbe: Provider
  private inner: Provider
  private rejectChecked: Bool
  public calls: Int = 0

  def init(inner: Provider, rejectChecked: Bool = false): Void
    this.inner = inner
    this.rejectChecked = rejectChecked
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        if this.rejectChecked
          return false
        end
        return this.inner.supports(capability)
      case ProviderCapability.BoundedTypedReads()
        return this.inner.supports(capability)
      case ProviderCapability.StreamingReads()
        return this.inner.supports(capability)
      case ProviderCapability.SetWrites()
        return this.inner.supports(capability)
      case ProviderCapability.TrackedWrites()
        return this.inner.supports(capability)
      case ProviderCapability.ExplicitTransactions()
        return this.inner.supports(capability)
      case ProviderCapability.Savepoints()
        return this.inner.supports(capability)
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    return this.inner.execute(plan)
  end
end

class ChainedJoinVisits
  public count: Int = 0
end

def chainedCustomerId(): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id
  end
end

def chainedOrderCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def chainedCustomerIdPlus(offset: Int): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id + offset
  end
end

def chainedOrderCustomerIdMinus(offset: Int): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId - offset
  end
end

def chainedCustomerNameWith(suffix: String): quote fn(Customer): String
  return quote do |customer: Customer|: String
    return customer.name + suffix
  end
end

def chainedCustomerNicknameIfAbove(floor: Int): quote fn(Customer): String?
  return quote do |customer: Customer|: String?
    return customer.id > floor ? customer.nickname : null
  end
end

def hasChainedText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def chainedPairCustomerIdPlus(offset: Int): quote fn(Joined<Customer, Order>): Int
  return quote do |pair: Joined<Customer, Order>|: Int
    return pair.left.id + offset
  end
end

def chainedCustomerIdMinus(offset: Int): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id - offset
  end
end

def chainedOrderCustomerIdBy(divisor: Int): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId / divisor
  end
end

def chainedOrderTotalAtLeast(minimum: Int): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.total >= minimum
  end
end

def chainedOrderIdBelow(bound: Int): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.id < bound
  end
end

def chainedOrderId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.id
  end
end

def chainedPairCustomerId(): quote fn(Joined<Customer, Order>): Int
  return quote do |pair: Joined<Customer, Order>|: Int
    return pair.left.id
  end
end

def chainedDeepOrderId(): quote fn(Joined<Joined<Customer, Order>, Customer>): Int
  return quote do |pair: Joined<Joined<Customer, Order>, Customer>|: Int
    return pair.left.right.id
  end
end

def chainedLeftCustomerId(): quote fn(LeftJoined<Customer, Order>): Int
  return quote do |pair: LeftJoined<Customer, Order>|: Int
    return pair.left.id
  end
end

def sumChainedIds(left: Int, right: Int): Int
  return left + right
end

def assertChainedBoolParameter(node: readonly ParameterNode?, expected: Bool): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Bool(value)
      test::assertEqual(value, expected)
    case Parameter.Int(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def assertChainedIntParameter(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def verifyDeepInner(provider: SQLiteProvider): Void
  let db = database(provider)
  let ceiling = 3
  let firstSource = db.customers.where(active: true).orderBy(chainedCustomerId()).take(1).asRelation()
  let minimumTotal = 9
  let secondSource = db.orders.matching(quote do |order: Order|: Bool
      return order.total >= minimumTotal
    end).asRelation()
  let firstPair = firstSource.join(secondSource, intScalar(), chainedCustomerId(), chainedOrderCustomerId())
  let thirdSource = db.customers.where(active: true).asRelation()
  let secondPair = firstPair.asRelation().join(thirdSource, intScalar(), chainedPairCustomerId(), chainedCustomerId()).matchingLeft(quote do |pair: Joined<Customer, Order>|: Bool
      return pair.left.id < ceiling
    end)
  let fourthSource = db.orders.matching(quote do |order: Order|: Bool
      return order.total >= minimumTotal
    end).asRelation()
  let deep = secondPair.asRelation().join(fourthSource, intScalar(), chainedDeepOrderId(), chainedOrderId()).orderByLeft(chainedDeepOrderId()).take(10)

  match deep.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 5)
      let second = assertChainedBoolParameter(plan.sql().parameters().first(), true)
      let third = assertChainedIntParameter(second, 9)
      let fourth = assertChainedBoolParameter(third, true)
      let fifth = assertChainedIntParameter(fourth, ceiling)
      let remaining = assertChainedIntParameter(fifth, 9)

      test::assertTrue(remaining == null)
  end

  match deep.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match deep.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var row = rows.first()
      var orderTen = 0
      var orderEleven = 0

      while row != null
        let chain = row.value

        test::assertEqual(chain.left.left.left.id, 1)
        test::assertEqual(chain.left.right.id, 1)
        test::assertEqual(chain.left.left.right.id, chain.right.id)
        if chain.left.left.right.id == 10
          orderTen = orderTen + 1
        else if chain.left.left.right.id == 11
          orderEleven = orderEleven + 1
        end
        row = row.next
      end

      test::assertEqual(orderTen, 1)
      test::assertEqual(orderEleven, 1)
  end

  let leftValue = fieldShape(intScalar(), chainedPairCustomerId())
  let rightValue = fieldShape(intScalar(), chainedCustomerId())
  let projected = projectJoin(secondPair.take(10), leftValue, rightValue, sumChainedIds)

  match projected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, 2)
      end
  end
end

def verifyNestedLeft(provider: SQLiteProvider): Void
  let db = database(provider)
  let leftCustomers = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id < 4
    end).asRelation()
  let earlyOrders = db.orders.matching(quote do |order: Order|: Bool
      return order.id < 13
    end).asRelation()
  let customerOrders = leftCustomers.leftJoin(earlyOrders, intScalar(), chainedCustomerId(), chainedOrderCustomerId())
  let availableProfiles = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id < 3
    end).asRelation()
  let nested = customerOrders.asRelation().leftJoin(availableProfiles, intScalar(), chainedLeftCustomerId(), chainedCustomerId()).take(10)

  match nested.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match nested.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var sawPresentNull = false
      var sawMissingBoth = false

      while row != null
        let value = row.value
        let customerId = value.left.left.id

        if customerId == 2
          let order = value.left.right
          let profile = value.right

          test::assertTrue(order != null && profile != null)
          if order != null && profile != null
            test::assertEqual(order.id, 12)
            test::assertTrue(profile.nickname == null)
            sawPresentNull = true
          end
        else if customerId == 3
          let order = value.left.right
          let profile = value.right

          test::assertTrue(order == null && profile == null)
          sawMissingBoth = true
        end
        row = row.next
      end

      test::assertTrue(sawPresentNull && sawMissingBoth)
  end

  let visited = new ChainedJoinVisits()
  let visit: fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool = fn(value: LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool
    visited.count = visited.count + 1
    return visited.count < 1
  end

  match nested.stream(visit)
    case StreamResult.Stopped(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end
end

def verifyNestedRight(provider: SQLiteProvider): Void
  let db = database(provider)
  let leftCustomers = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id < 4
    end).asRelation()
  let earlyOrders = db.orders.matching(quote do |order: Order|: Bool
      return order.id < 13
    end).asRelation()
  let customerOrders = leftCustomers.leftJoin(earlyOrders, intScalar(), chainedCustomerId(), chainedOrderCustomerId())
  let allCustomers = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id < 5
    end).asRelation()
  let nestedRight = allCustomers.leftJoin(customerOrders.asRelation(), intScalar(), chainedCustomerId(), chainedLeftCustomerId()).take(10)

  match nestedRight.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 5)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match nestedRight.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 5)
      var row = rows.first()
      var sawNestedMissingOrder = false
      var sawOuterMissing = false

      while row != null
        let value = row.value

        if value.left.id == 3
          let nested = value.right

          test::assertTrue(nested != null)
          if nested != null
            test::assertEqual(nested.left.id, 3)
            test::assertTrue(nested.right == null)
            sawNestedMissingOrder = true
          end
        else if value.left.id == 4
          let nested = value.right

          test::assertTrue(nested == null)
          sawOuterMissing = true
        end
        row = row.next
      end

      test::assertTrue(sawNestedMissingOrder && sawOuterMissing)
  end
end

def verifyComputedJoinKeys(provider: SQLiteProvider): Void
  let db = database(provider)
  let minimumTotal = 9
  let leftShift = 2
  let rightShift = -2
  let filteredCustomers = db.customers.where(active: true).asRelation()
  let filteredOrders = db.orders.matching(chainedOrderTotalAtLeast(minimumTotal)).asRelation()
  let computedInner = filteredCustomers.join(filteredOrders, intScalar(), chainedCustomerIdPlus(leftShift), chainedOrderCustomerIdMinus(rightShift)).take(10)

  match computedInner.compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      let second = assertChainedBoolParameter(plan.sql().parameters().first(), true)
      let third = assertChainedIntParameter(second, minimumTotal)
      let fourth = assertChainedIntParameter(third, leftShift)
      let remaining = assertChainedIntParameter(fourth, rightShift)

      test::assertTrue(remaining == null)
  end

  match computedInner.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 3)
      var row = rows.first()

      while row != null
        test::assertEqual(row.value.left.id, row.value.right.customerId)
        row = row.next
      end
  end

  let earlyOrders = db.orders.matching(chainedOrderIdBelow(12)).asRelation()
  let computedLeft = db.customers.where(active: true).asRelation().leftJoin(earlyOrders, intScalar(), chainedCustomerIdPlus(1), chainedOrderCustomerIdMinus(-1)).take(10)

  match computedLeft.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 3)
      var row = rows.first()
      var sawUnmatchedCustomer = false

      while row != null
        if row.value.left.id == 2
          test::assertTrue(row.value.right == null)
          sawUnmatchedCustomer = row.value.right == null
        else
          test::assertTrue(row.value.right != null)
        end
        row = row.next
      end

      test::assertTrue(sawUnmatchedCustomer)
  end

  let activeCustomers = db.customers.where(active: true).asRelation()
  let stringSelfJoin = activeCustomers.join(db.customers.where(active: true).asRelation(), textScalar(), chainedCustomerNameWith("!"), chainedCustomerNameWith("!")).take(10)

  match stringSelfJoin.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var row = rows.first()

      while row != null
        test::assertEqual(row.value.left.id, row.value.right.id)
        row = row.next
      end
  end

  let optionalKeySource = db.customers.where(active: true).asRelation()
  let leftFloor = -1
  let rightFloor = -2
  let optionalInner = optionalKeySource.join(db.customers.where(active: true).asRelation(), optionalTextScalar(), chainedCustomerNicknameIfAbove(leftFloor), chainedCustomerNicknameIfAbove(rightFloor)).take(10)

  match optionalInner.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      let second = assertChainedBoolParameter(plan.sql().parameters().first(), true)
      let third = assertChainedBoolParameter(second, true)
      let fourth = assertChainedIntParameter(third, leftFloor)
      let remaining = assertChainedIntParameter(fourth, rightFloor)

      test::assertTrue(remaining == null)
      test::assertTrue(hasChainedText(plan.sql().sql(), "\"__neri_left\".\"id\" > $3"))
      test::assertTrue(hasChainedText(plan.sql().sql(), "\"__neri_right\".\"__neri_r0\" > $4"))
  end

  match optionalInner.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        test::assertEqual(first.value.right.id, 1)
      end
  end

  let optionalLeft = optionalKeySource.leftJoin(db.customers.where(active: true).asRelation(), optionalTextScalar(), chainedCustomerNicknameIfAbove(leftFloor), chainedCustomerNicknameIfAbove(rightFloor)).take(10)

  match optionalLeft.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 4)
      let second = assertChainedBoolParameter(plan.sql().parameters().first(), true)
      let third = assertChainedBoolParameter(second, true)
      let fourth = assertChainedIntParameter(third, leftFloor)
      let remaining = assertChainedIntParameter(fourth, rightFloor)

      test::assertTrue(remaining == null)
      test::assertTrue(hasChainedText(plan.sql().sql(), "\"__neri_left\".\"id\" > $3"))
      test::assertTrue(hasChainedText(plan.sql().sql(), "\"__neri_right\".\"__neri_r0\" > $4"))
  end

  match optionalLeft.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var row = rows.first()
      var nullKeyRemainedUnmatched = false

      while row != null
        if row.value.left.id == 2
          test::assertTrue(row.value.right == null)
          nullKeyRemainedUnmatched = row.value.right == null
        end
        row = row.next
      end

      test::assertTrue(nullKeyRemainedUnmatched)
  end

  let directPair = db.customers.where(active: true).asRelation().join(db.orders.asRelation(), intScalar(), chainedCustomerId(), chainedOrderCustomerId())
  let nestedPair = directPair.asRelation().join(db.customers.asRelation(), intScalar(), chainedPairCustomerIdPlus(2), chainedCustomerIdMinus(-2)).take(10)

  match nestedPair.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 3)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.left.id, first.value.right.id)
      end
  end

  let brokenKey = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id == 1
    end).asRelation().join(db.orders.matching(quote do |order: Order|: Bool
        return order.id == 10
      end).asRelation(), intScalar(), chainedCustomerId(), chainedOrderCustomerIdBy(0)).take(1)

  match brokenKey.all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertTrue(message != "")
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  let noCheckedProbe = new JoinDispatchProbe(provider, true)
  let noCheckedDb = database(noCheckedProbe)
  let noCheckedJoin = join(noCheckedDb.customers, noCheckedDb.orders, intScalar(), chainedCustomerIdPlus(1), chainedOrderCustomerIdMinus(-1)).take(10)

  match noCheckedJoin.all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(noCheckedProbe.calls, 0)
end

def verifyProviderMismatch(provider: SQLiteProvider): Void
  let leftProbe = new JoinDispatchProbe(provider)
  let foreignProbe = new JoinDispatchProbe(provider)
  let leftDb = database(leftProbe)
  let foreignDb = database(foreignProbe)
  let first = leftDb.customers.asRelation().join(leftDb.orders.asRelation(), intScalar(), chainedCustomerId(), chainedOrderCustomerId())
  let mismatched = first.asRelation().join(foreignDb.customers.asRelation(), intScalar(), chainedPairCustomerId(), chainedCustomerId()).take(10)

  match mismatched.all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "join requires one shared provider or explicit override")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(leftProbe.calls, 0)
  test::assertEqual(foreignProbe.calls, 0)
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-chained-joins-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, 'Ada', 1, 'Ada'), (2, 'Bea', 1, NULL), (3, 'Cal', 0, 'three'), (4, 'Deb', 0, NULL); INSERT INTO orders VALUES(10, 1, 9), (11, 1, 20), (12, 2, 9), (13, 3, 15), (14, 99, 4);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyDeepInner(provider)
        verifyNestedLeft(provider)
        verifyNestedRight(provider)
        verifyComputedJoinKeys(provider)
        verifyProviderMismatch(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
