use test
use console
use files
use resources
use result
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def verifyContext(provider: SQLiteProvider): Void
  let db = database(provider)
  let name = "O'Reilly; DROP TABLE orders;-- 水"
  let filtered = db.customers.where(active: true, nickname: null, name: name).take(20)

  match filtered.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.id, 1)
        test::assertEqual(first.value.name, name)
        test::assertTrue(first.value.active && first.value.nickname == null)

        match db.ordersFor_Customer_by_customerId(first.value).take(10).all()
          case QueryResult.Rows(orders)
            let order = orders.first()

            test::assertEqual(orders.count(), 1)
            test::assertTrue(order != null && order.value.total == 42)
          case QueryResult.Failure(error)
            test::assertTrue(false)
        end
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  let ordered = db.customers.where(active: true).orderBy(quote do |customer: Customer|: Int
      return customer.id
    end, true).take(1)

  match ordered.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null && first.value.id == 2)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  let projected = select(filtered, textScalar(), quote do |customer: Customer|: String
      return customer.name
    end)

  match projected.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null && first.value == name)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(provider.close())
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-data-context-")
    let path = temporary.path() + "/data.sqlite"
    var sql = "CREATE TABLE customers (id INTEGER, name TEXT, active INTEGER, nickname TEXT);"

    sql = sql + "CREATE TABLE orders (id INTEGER, customer_id INTEGER, total INTEGER);"
    sql = sql + "INSERT INTO customers VALUES (1, 'O''Reilly; DROP TABLE orders;-- 水', 1, NULL), (2, 'Ada', 1, 'ada'), (3, 'Lin', 0, NULL);"
    sql = sql + "INSERT INTO orders VALUES (10, 1, 42), (11, 2, 99);"

    test::assertTrue(createSQLiteFixture(path, sql))
    # Two independent connections read the same persisted data through generated sets.
    var attempt = 0

    while attempt < 2
      match SQLiteProvider.open(path)
        case SQLiteOpenResult.Opened(provider)
          verifyContext(provider)
        case SQLiteOpenResult.Failure(message)
          console::println(message)

          test::assertTrue(false)
      end
      attempt = attempt + 1
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("SQLite generated context contracts passed")
end
