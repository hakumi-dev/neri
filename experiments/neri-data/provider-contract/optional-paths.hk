use files
use resources
use result
use test
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use quotation

class OptionalPathLeft
  public customerId: Int
  public orderTotal: Int?

  def init(customerId: Int, orderTotal: Int?): Void
    this.customerId = customerId
    this.orderTotal = orderTotal
  end
end

class OptionalPathCustomer
  public customerId: Int
  public nickname: String?

  def init(customerId: Int, nickname: String?): Void
    this.customerId = customerId
    this.nickname = nickname
  end
end

class OptionalPathProjection
  public customerId: Int
  public orderTotal: Int?
  public relatedCustomerId: Int?
  public relatedNickname: String?

  def init(customerId: Int, orderTotal: Int?, relatedCustomerId: Int?, relatedNickname: String?): Void
    this.customerId = customerId
    this.orderTotal = orderTotal
    this.relatedCustomerId = relatedCustomerId
    this.relatedNickname = relatedNickname
  end
end

class OptionalPresenceKey
  public orderPresent: Bool
  public relatedCustomerPresent: Bool

  def init(orderPresent: Bool, relatedCustomerPresent: Bool): Void
    this.orderPresent = orderPresent
    this.relatedCustomerPresent = relatedCustomerPresent
  end
end

class OptionalPresenceRow
  public key: OptionalPresenceKey
  public count: Int

  def init(key: OptionalPresenceKey, count: Int): Void
    this.key = key
    this.count = count
  end
end

class OptionalTotalGroup
  public total: Int?
  public count: Int

  def init(total: Int?, count: Int): Void
    this.total = total
    this.count = count
  end
end

def rejectForgedUnguardedMember(): Void
  let mapping = new EntityMapping("model.Customer", "customers", [new MappingColumn("model.Customer.nickname", "String?", "nickname")])
  let tree = new quotation::Tree(
    [
      new quotation::Node(quotation::NodeKind.Parameter(), "model.Customer", index: 0),
      new quotation::Node(quotation::NodeKind.Member(), "String", first: 0, identity: "model.Customer.nickname"),
      new quotation::Node(quotation::NodeKind.TextLiteral(), "String", textValue: "x"),
      new quotation::Node(quotation::NodeKind.Equal(), "Bool", first: 1, second: 2)
    ],
    [],
    3,
    ["model.Customer"],
    "Bool"
  )
  let state = new CompileState()

  match compileScalarQuotation(mapping, tree, "Bool", state, SqlDialect.QuestionMark())
    case ScalarSqlResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "optional member access requires a presence guard")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case ScalarSqlResult.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(state.count, 0)
end

def pathCustomerId(): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id
  end
end

def pathOrderCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def pathCustomerSubset(): quote fn(Customer): Bool
  return quote do |customer: Customer|: Bool
    return customer.id >= 3 && customer.id < 5
  end
end

def pathNestedCustomerId(): quote fn(LeftJoined<Customer, Order>): Int
  return quote do |pair: LeftJoined<Customer, Order>|: Int
    return pair.left.id
  end
end

def pathNestedOrderTotal(): quote fn(LeftJoined<Customer, Order>): Int?
  return quote do |pair: LeftJoined<Customer, Order>|: Int?
    return pair.right != null ? pair.right.total : null
  end
end

def pathOuterNestedOrderTotal(): quote fn(LeftJoined<Customer, LeftJoined<Customer, Order>>): Int?
  return quote do |pair: LeftJoined<Customer, LeftJoined<Customer, Order>>|: Int?
    return pair.right != null ? (pair.right.right != null ? pair.right.right.total : null) : null
  end
end

def pathNestedOrderTotalAbove(bound: Int): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Bool
    return pair.left.right != null && pair.left.right.total > bound
  end
end

def pathNestedLazyDivision(): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Bool
    return pair.left.right == null || (pair.left.right.total != 9 && pair.left.right.total / (pair.left.right.total - 9) > 0)
  end
end

def pathNestedOrderPresent(): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Bool
    return pair.left.right != null
  end
end

def pathRelatedCustomerPresent(): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): Bool
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Bool
    return pair.right != null
  end
end

def pathRelatedNickname(): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): String?
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: String?
    return pair.right != null ? pair.right.nickname : null
  end
end

def pathRelatedNicknamePlus(): quote fn(LeftJoined<LeftJoined<Customer, Order>, Customer>): String?
  return quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: String?
    return pair.right != null && pair.right.nickname != null ? pair.right.nickname + "!" : null
  end
end

def makeOptionalPathLeft(customerId: Int, orderTotal: Int?): OptionalPathLeft
  return new OptionalPathLeft(customerId, orderTotal)
end

def makeOptionalPathCustomer(customerId: Int, nickname: String?): OptionalPathCustomer
  return new OptionalPathCustomer(customerId, nickname)
end

def makeOptionalPathProjection(left: OptionalPathLeft, right: OptionalPathCustomer?): OptionalPathProjection
  if right == null
    return new OptionalPathProjection(left.customerId, left.orderTotal, null, null)
  end
  return new OptionalPathProjection(left.customerId, left.orderTotal, right.customerId, right.nickname)
end

def makePresenceKey(orderPresent: Bool, relatedCustomerPresent: Bool): OptionalPresenceKey
  return new OptionalPresenceKey(orderPresent, relatedCustomerPresent)
end

def makePresenceRow(key: OptionalPresenceKey, count: Int): OptionalPresenceRow
  return new OptionalPresenceRow(key, count)
end

def makeOptionalTotalGroup(total: Int?, count: Int): OptionalTotalGroup
  return new OptionalTotalGroup(total, count)
end

def verifyOptionalPaths(provider: SQLiteProvider): Void
  rejectForgedUnguardedMember()

  let db = database(provider)
  let firstLeft = leftJoin(db.customers, db.orders, intScalar(), pathCustomerId(), pathOrderCustomerId())
  let selectedCustomers = db.customers.matching(pathCustomerSubset()).asRelation()
  let nested = firstLeft.asRelation().leftJoin(selectedCustomers, intScalar(), pathNestedCustomerId(), pathCustomerId())
  let nestedRelation = nested.asRelation()

  match nestedRelation.aggregate(sumInt(optionalIntScalar(), quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Int?
        return pair.left.right != null ? pair.left.right.total : null
      end)).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 53)
  end

  let orderKeys = selectGroups(
    nestedRelation.groupBy(expressionShape(optionalIntScalar(), quote do |pair: LeftJoined<LeftJoined<Customer, Order>, Customer>|: Int?
          return pair.left.right != null ? pair.left.right.total : null
        end)),
    countRows<LeftJoined<LeftJoined<Customer, Order>, Customer>>(),
    makeOptionalTotalGroup
  ).take(10)

  match orderKeys.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var sawNull = false
      var sawNine = false
      var sawFifteen = false
      var sawTwenty = false

      while row != null
        if row.value.total == null
          test::assertEqual(row.value.count, 2)
          sawNull = true
        else if row.value.total == 9
          test::assertEqual(row.value.count, 2)
          sawNine = true
        else if row.value.total == 15
          test::assertEqual(row.value.count, 1)
          sawFifteen = true
        else if row.value.total == 20
          test::assertEqual(row.value.count, 1)
          sawTwenty = true
        else
          test::assertTrue(false)
        end
        row = row.next
      end

      test::assertTrue(sawNull && sawNine && sawFifteen && sawTwenty)
  end

  match nestedRelation.aggregate(countRows<LeftJoined<LeftJoined<Customer, Order>, Customer>>().where(pathNestedOrderTotalAbove(10))).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
  end

  match nestedRelation.aggregate(countRows<LeftJoined<LeftJoined<Customer, Order>, Customer>>().where(pathNestedLazyDivision())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
  end

  let presenceKeys = combineShapes(
    expressionShape(boolScalar(), pathNestedOrderPresent()),
    expressionShape(boolScalar(), pathRelatedCustomerPresent()),
    makePresenceKey
  )
  let presenceGroups = selectGroups(
    nestedRelation.groupBy(presenceKeys),
    countRows<LeftJoined<LeftJoined<Customer, Order>, Customer>>(),
    makePresenceRow
  ).take(10)

  match presenceGroups.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var sawPresentPresent = false
      var sawPresentMissing = false
      var sawMissingPresent = false
      var sawMissingMissing = false

      while row != null
        let key = row.value.key

        if key.orderPresent && key.relatedCustomerPresent
          test::assertEqual(row.value.count, 1)
          sawPresentPresent = true
        else if key.orderPresent && !key.relatedCustomerPresent
          test::assertEqual(row.value.count, 3)
          sawPresentMissing = true
        else if !key.orderPresent && key.relatedCustomerPresent
          test::assertEqual(row.value.count, 1)
          sawMissingPresent = true
        else
          test::assertEqual(row.value.count, 1)
          sawMissingMissing = true
        end
        row = row.next
      end

      test::assertTrue(sawPresentPresent && sawPresentMissing && sawMissingPresent && sawMissingMissing)
  end

  match nestedRelation.aggregate(countNonNull(optionalTextScalar(), pathRelatedNickname())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
  end

  match nestedRelation.aggregate(maxString(optionalTextScalar(), pathRelatedNicknamePlus())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == "Cal!")
  end

  let leftShape = combineShapes(
    fieldShape(intScalar(), pathNestedCustomerId()),
    expressionShape(optionalIntScalar(), pathNestedOrderTotal()),
    makeOptionalPathLeft
  )
  let rightShape = combineShapes(
    fieldShape(intScalar(), pathCustomerId()),
    fieldShape(optionalTextScalar(), quote do |customer: Customer|: String?
        return customer.nickname
      end),
    makeOptionalPathCustomer
  )
  let projected = projectLeftJoin(nested.take(10), leftShape, rightShape, makeOptionalPathProjection)

  match projected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 6)
      var row = rows.first()
      var sawMatchedNullNickname = false
      var sawMissingRight = false
      var sawPresentPair = false

      while row != null
        if row.value.customerId == 4
          test::assertTrue(row.value.orderTotal == null)
          test::assertTrue(row.value.relatedCustomerId == 4)
          test::assertTrue(row.value.relatedNickname == null)
          sawMatchedNullNickname = true
        else if row.value.customerId == 5
          test::assertTrue(row.value.orderTotal == null)
          test::assertTrue(row.value.relatedCustomerId == null)
          test::assertTrue(row.value.relatedNickname == null)
          sawMissingRight = true
        else if row.value.customerId == 3
          test::assertTrue(row.value.orderTotal == 15)
          test::assertTrue(row.value.relatedCustomerId == 3)
          test::assertTrue(row.value.relatedNickname == "Cal")
          sawPresentPair = true
        end
        row = row.next
      end

      test::assertTrue(sawMatchedNullNickname && sawMissingRight && sawPresentPair)
  end

  let nestedOnRight = db.customers.matching(pathCustomerSubset()).asRelation().leftJoin(db.orders.asRelation(), intScalar(), pathCustomerId(), pathOrderCustomerId())
  let rightNested = db.customers.asRelation().leftJoin(nestedOnRight.asRelation(), intScalar(), pathCustomerId(), pathNestedCustomerId())

  match rightNested.asRelation().aggregate(sumInt(optionalIntScalar(), pathOuterNestedOrderTotal())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 15)
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-optional-paths-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, 'Ada', 1, 'Ada'), (2, 'Bea', 1, NULL), (3, 'Cal', 0, 'Cal'), (4, 'Deb', 0, NULL), (5, 'Eve', 0, NULL); INSERT INTO orders VALUES(10, 1, 9), (11, 1, 20), (12, 2, 9), (13, 3, 15);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyOptionalPaths(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
