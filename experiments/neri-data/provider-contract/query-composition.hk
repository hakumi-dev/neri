use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use files
use resources
use result
use test
use host
use console

class QueryCompositionGroupCalls
  public count: Int = 0
end

class QueryCompositionGroupOutput
  public key: Int
  public count: Int

  def init(key: Int, count: Int): Void
    this.key = key
    this.count = count
  end
end

class QueryCompositionCodecCalls
  public count: Int = 0
end

class QueryCompositionLargeOrder
  public id: Int
  public customerId: Int
  public total: Int

  def init(id: Int, customerId: Int, total: Int): Void
    this.id = id
    this.customerId = customerId
    this.total = total
  end
end

def queryCompositionId(): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id
  end
end

def queryCompositionActive(): quote fn(Customer): Bool
  return quote do |customer: Customer|: Bool
    return customer.active
  end
end

def queryCompositionOrderTotal(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.total
  end
end

def queryCompositionLargeOrderDecoder(row: RawRow): DecodeResult<QueryCompositionLargeOrder>
  return DecodeResult<QueryCompositionLargeOrder>.Failure(QueryFailure.Provider("grouped aggregate must not decode source orders"))
end

def queryCompositionLargeOrders(provider: SQLiteProvider): Query<QueryCompositionLargeOrder>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("customer_id", ResultColumnKind.Int()), new ResultColumn("total", ResultColumnKind.Int())])
  let mapping = new EntityMapping("QueryCompositionLargeOrder", "large_orders", [new MappingColumn("QueryCompositionLargeOrder.id", "Int", "id"), new MappingColumn("QueryCompositionLargeOrder.customerId", "Int", "customer_id"), new MappingColumn("QueryCompositionLargeOrder.total", "Int", "total")], "id")

  return new Query<QueryCompositionLargeOrder>("large_orders", new Decoder<QueryCompositionLargeOrder>(queryCompositionLargeOrderDecoder, columns), mapping: mapping, provider: provider)
end

def queryCompositionOrderCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def assertQueryCompositionUnsupported<T>(result: QueryResult<T>): Void
  match result
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(name != "")
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
end

def queryCompositionParameterInt(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def queryCompositionContains(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def verifyQueryComposition(provider: SQLiteProvider): Void
  let db = new Database(provider)

  console::println("query order and bindings")
  let floor = 0
  let bucket = 2
  let sourceTie = 0
  let projectedTie = 0
  let ceiling = 3
  let source = db.customers.matching(quote do |customer: Customer|: Bool
      return customer.id > floor
    end).orderBy(quote do |customer: Customer|: Int
      return customer.id / bucket
    end, true).thenBy(quote do |customer: Customer|: Int
      return customer.id + sourceTie
    end, true).take(4)
  let identity = pairShape(fieldShape(intScalar(), queryCompositionId()), fieldShape(optionalTextScalar(), quote do |customer: Customer|: String?
        return customer.nickname
      end))
  let projected = project(source, identity).asRelation().thenBy(quote do |value: ProjectedPair<Int, String?>|: Int
      return value.first + projectedTie
    end).take(3).matching(quote do |value: ProjectedPair<Int, String?>|: Bool
      return value.first < ceiling
    end)

  match projected.compile(SqlDialect.QuestionMark())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 7)
      test::assertTrue(queryCompositionContains(plan.sql().sql(), "?"))
      let second = queryCompositionParameterInt(plan.sql().parameters().first(), projectedTie)
      let third = queryCompositionParameterInt(second, bucket)
      let fourth = queryCompositionParameterInt(third, sourceTie)
      let fifth = queryCompositionParameterInt(fourth, floor)
      let sixth = queryCompositionParameterInt(fifth, bucket)
      let seventh = queryCompositionParameterInt(sixth, sourceTie)
      let remaining = queryCompositionParameterInt(seventh, ceiling)

      test::assertTrue(remaining == null)
  end

  match projected.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, 2)
        test::assertTrue(first.value.second == "b")
      end
  end

  console::println("distinct source semantics")
  # DISTINCT applies to mapped source rows before these identical selected values collapse them.
  let activePair = pairShape(fieldShape(boolScalar(), queryCompositionActive()), fieldShape(boolScalar(), queryCompositionActive()))
  let distinct = project(db.customers.distinct().take(10), activePair).asRelation().take(10)

  match distinct.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var current = rows.first()
      var duplicateActive = 0

      while current != null
        test::assertEqual(current.value.first, current.value.second)
        if current.value.first
          duplicateActive = duplicateActive + 1
        end
        current = current.next
      end

      test::assertEqual(duplicateActive, 3)
  end

  console::println("grouped pair composition")
  let orderGroups = db.orders.asRelation().groupBy(fieldShape(intScalar(), queryCompositionOrderCustomerId()))
  let groupMetrics = aggregatePair(countRows<Order>(), sumIntOrZero(intScalar(), queryCompositionOrderTotal()))
  let grouped = selectGroupPairs(orderGroups, groupMetrics)
  let groupedSource = grouped.asRelation()

  # An aggregate consumer sees all groups unless the caller explicitly adds a limit.
  match groupedSource.aggregate(countRows<ProjectedPair<Int, ProjectedPair<Int, Int>>>()).compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertTrue(!queryCompositionContains(plan.sql().sql(), "LIMIT 1000"))
  end

  let minimumGroupCount = 2
  let minimumGroupTotal = 10
  let matchingGroups = groupedSource.matching(quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Bool
      return value.first == 1 && value.second.first >= minimumGroupCount && value.second.second >= minimumGroupTotal
    end).orderBy(quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Int
      return value.second.second
    end, true).take(10)
  let reprojectedGroups = projectRelation(matchingGroups, pairShape(fieldShape(intScalar(), quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Int
          return value.first
        end), fieldShape(intScalar(), quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Int
          return value.second.first
        end))).take(10)

  match reprojectedGroups.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, 1)
        test::assertEqual(first.value.second, 2)
      end
  end

  match matchingGroups.join(db.customers.asRelation(), intScalar(), quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Int
      return value.first
    end, queryCompositionId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.second.second, 12)
        test::assertEqual(first.value.right.id, 1)
      end
  end

  console::println("group windows and hidden aggregate ordering")
  let groupTwoOnly = quote do |value: ProjectedPair<Int, ProjectedPair<Int, Int>>|: Bool
    return value.first == 2
  end

  match grouped.take(1).asRelation().matching(groupTwoOnly).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
  end

  match grouped.asRelation().matching(groupTwoOnly).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, 2)
      end
  end

  let totalThree: quote fn(Order): Bool = quote do |order: Order|: Bool
    return order.total == 3
  end
  let hiddenGroupOrder = groupMetric(countRows<Order>().where(totalThree)).descending()
  let orderedGroups = selectGroupPairs(orderGroups, groupMetrics).orderByAggregate(hiddenGroupOrder).asRelation().take(1)

  match orderedGroups.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.first, 2)
        test::assertEqual(first.value.second.first, 1)
        test::assertEqual(first.value.second.second, 3)
      end
  end

  console::println("large grouped aggregate count")
  let largeSource = queryCompositionLargeOrders(provider).asRelation()
  let largeGroups = selectGroupPairs(largeSource.groupBy(fieldShape(intScalar(), quote do |order: QueryCompositionLargeOrder|: Int
          return order.customerId
        end)), aggregatePair(countRows<QueryCompositionLargeOrder>(), sumIntOrZero(intScalar(), quote do |order: QueryCompositionLargeOrder|: Int
          return order.total
        end)))

  match largeGroups.asRelation().aggregate(countRows<ProjectedPair<Int, ProjectedPair<Int, Int>>>()).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(count)
      test::assertEqual(count, 1001)
  end

  console::println("group relation certification")
  let callbackCalls = new QueryCompositionGroupCalls()
  let terminalGrouped = selectGroups(orderGroups, groupMetrics) do |key: Int, values: ProjectedPair<Int, Int>|: QueryCompositionGroupOutput
    callbackCalls.count = callbackCalls.count + 1
    return new QueryCompositionGroupOutput(key, values.first)
  end

  assertQueryCompositionUnsupported(terminalGrouped.asRelation().take(10).all())

  test::assertEqual(callbackCalls.count, 0)

  let codecCalls = new QueryCompositionCodecCalls()
  let customRead: fn(Cell): DecodeResult<Int> = fn(cell: Cell): DecodeResult<Int>
    codecCalls.count = codecCalls.count + 1
    match decodeScalarInt(cell)
      case DecodeResult.Failure(error)
        return DecodeResult<Int>.Failure(error)
      case DecodeResult.Value(value)
        return DecodeResult<Int>.Value(value + 100)
    end
  end
  let customInt = new ScalarCodec<Int>(customRead, ResultColumnKind.Int(), false, "Int")
  let customGroups = selectGroupPairs(db.orders.asRelation().groupBy(fieldShape(customInt, queryCompositionOrderCustomerId())), groupMetrics)

  assertQueryCompositionUnsupported(customGroups.asRelation().take(10).all())

  test::assertEqual(codecCalls.count, 0)
end

def verifyQueryCompositionFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-query-composition-")
    let path = temporary.path() + "/data.sqlite"
    var sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); CREATE TABLE large_orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES (1, 'Ada', 1, NULL), (2, 'Bea', 1, 'b'), (3, 'Cy', 0, NULL), (4, 'Dee', 1, 'd'); INSERT INTO orders VALUES (10, 1, 5), (11, 1, 7), (12, 2, 3), (13, 3, 4);"
    var largeRows = ""
    var current = 1

    while current <= 1001
      largeRows = largeRows + (current == 1 ? "" : ", ") + "(" + (current as String) + ", " + (current as String) + ", 1)"
      current = current + 1
    end
    sql = sql + "INSERT INTO large_orders VALUES " + largeRows + ";"

    test::assertTrue(createSQLiteFixture(path, sql))

    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyQueryComposition(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyQueryCompositionFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
