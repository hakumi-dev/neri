use test
use console
use files
use resources
use result
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class Loose
  public code: String?
  public note: String?

  def init(code: String?, note: String?): Void
    this.code = code
    this.note = note
  end
end

def decodeLoose(row: RawRow): DecodeResult<Loose>
  match decodeNullableString(row, "code")
    case DecodeResult.Failure(error)
      return DecodeResult<Loose>.Failure(error)
    case DecodeResult.Value(code)
      match decodeNullableString(row, "note")
        case DecodeResult.Failure(error)
          return DecodeResult<Loose>.Failure(error)
        case DecodeResult.Value(note)
          return DecodeResult<Loose>.Value(new Loose(code, note))
      end
  end
end

def loose(provider: SQLiteProvider): Query<Loose>
  let columns = new ResultColumns([new ResultColumn("code", ResultColumnKind.Text(), true), new ResultColumn("note", ResultColumnKind.Text(), true)])
  let mapping = new EntityMapping("Loose", "loose", [new MappingColumn("Loose.code", "String?", "code"), new MappingColumn("Loose.note", "String?", "note")])

  return new Query<Loose>("loose", new Decoder<Loose>(decodeLoose, columns), mapping: mapping, provider: provider)
end

def looseCode(): quote fn(Loose): String?
  return quote do |value: Loose|: String?
    return value.code
  end
end

def badOrders(provider: SQLiteProvider): Query<Order>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("customer_id", ResultColumnKind.Int()), new ResultColumn("total", ResultColumnKind.Int())])
  let mapping = new EntityMapping("model.Order", "bad_orders", [new MappingColumn("model.Order.id", "Int", "id"), new MappingColumn("model.Order.customerId", "Int", "customer_id"), new MappingColumn("model.Order.total", "Int", "total")], "id")

  return new Query<Order>("bad_orders", new Decoder<Order>(decodeEntity_5_Order, columns), mapping: mapping, provider: provider)
end

def customerId(): quote fn(Customer): Int
  return quote do |value: Customer|: Int
    return value.id
  end
end

def orderCustomerId(): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.customerId
  end
end

def orderId(): quote fn(Order): Int
  return quote do |value: Order|: Int
    return value.id
  end
end

def customerNickname(): quote fn(Customer): String?
  return quote do |value: Customer|: String?
    return value.nickname
  end
end

def verifySmall(provider: SQLiteProvider): Void
  let db = database(provider)
  let payload = "O'Reilly; DROP TABLE orders; -- 水"
  let matched = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).take(10)

  match join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.MissingLimit(maximum)
          test::assertEqual(maximum, queryRowLimit())
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end

  match matched.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var oneCount = 0

      while row != null
        test::assertEqual(row.value.left.id, row.value.right.customerId)
        if row.value.left.id == 1
          oneCount = oneCount + 1

          test::assertEqual(row.value.left.name, payload)
        end
        row = row.next
      end

      test::assertEqual(oneCount, 2)
  end
  match leftJoin(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 5)
      var row = rows.first()
      var unmatched = 0

      while row != null
        let right = row.value.right

        if right == null
          test::assertEqual(row.value.left.id, 4)
          unmatched = unmatched + 1
        else
          test::assertEqual(row.value.left.id, right.customerId)
        end
        row = row.next
      end

      test::assertEqual(unmatched, 1)
  end
  match join(db.customers.where(id: 4), db.orders, intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
  end
  match join(db.customers.where(name: payload), db.orders.where(total: 42), intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.name, payload)
        test::assertEqual(first.value.right.total, 42)
      end
  end
  match join(db.customers, db.customers, intScalar(), customerId(), customerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()

      while row != null
        test::assertEqual(row.value.left.id, row.value.right.id)
        test::assertEqual(row.value.left.name, row.value.right.name)
        row = row.next
      end
  end
  match join(db.customers, db.customers, optionalTextScalar(), customerNickname(), customerNickname()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()

      while row != null
        test::assertTrue(row.value.left.nickname != null)
        test::assertTrue(row.value.right.nickname != null)
        row = row.next
      end
  end
  match leftJoin(db.customers, loose(provider), optionalTextScalar(), customerNickname(), looseCode()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var matchedLoose = 0

      while row != null
        let right = row.value.right

        if row.value.left.nickname == null
          test::assertTrue(right == null)
        else
          test::assertTrue(right != null)
          if right != null
            test::assertTrue(right.code != null)
            test::assertTrue(right.note == null)
            matchedLoose = matchedLoose + 1
          end
        end
        row = row.next
      end

      test::assertEqual(matchedLoose, 2)
  end
  match leftJoin(db.customers.where(id: 2), badOrders(provider), intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertEqual(column, "id")
          test::assertEqual(expected, "Int")
          test::assertEqual(actual, "NULL")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
  let left = db.customers.orderBy(customerId()).skip(1).take(2)
  let right = db.orders.orderBy(orderId()).skip(2).take(2)

  match join(left, right, intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      var row = rows.first()

      while row != null
        test::assertTrue(row.value.left.id == 2 || row.value.left.id == 3)
        test::assertTrue(row.value.right.id == 12 || row.value.right.id == 13)
        row = row.next
      end
  end
end

def verifyLarge(provider: SQLiteProvider): Void
  let db = database(provider)

  match join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1505)
        test::assertEqual(first.value.right.id, 1505)
      end
  end
end

def counted(result: QueryValue<Int>, expected: Int): Void
  match result
    case QueryValue.Value(value)
      test::assertEqual(value, expected)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyCountLarge(provider: SQLiteProvider): Void
  let db = database(provider)
  let matched = join(db.customers, db.orders, intScalar(), customerId(), orderCustomerId())

  counted(matched.count(), 1505)
  counted(matched.take(7).count(), 7)
  counted(leftJoin(db.customers, db.orders, intScalar(), customerId(), orderCustomerId()).count(), 1505)
end

def verifyProviderMismatch(first: SQLiteProvider, second: SQLiteProvider): Void
  let firstDb = database(first)
  let secondDb = database(second)

  match join(firstDb.customers, secondDb.orders, intScalar(), customerId(), orderCustomerId()).take(10).all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "join requires one shared provider or explicit override")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-joins-")
    let smallPath = temporary.path() + "/small.sqlite"
    let largePath = temporary.path() + "/large.sqlite"
    let countPath = temporary.path() + "/counts.sqlite"
    let payload = "O''Reilly; DROP TABLE orders; -- 水"
    let small = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); CREATE TABLE loose(code TEXT, note TEXT); CREATE TABLE bad_orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, '" + payload + "', 1, NULL), (2, 'Ada', 1, 'same'), (3, 'Lin', 0, 'same'), (4, 'No order', 1, NULL); INSERT INTO orders VALUES(10,1,42), (11,1,43), (12,2,99), (13,3,7), (14,999,8); INSERT INTO loose VALUES('same', NULL); INSERT INTO bad_orders VALUES(NULL, 2, 777);"
    let large = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 1505) INSERT INTO customers SELECT id, 'seed', 0, NULL FROM n; WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 1504) INSERT INTO orders SELECT id, -1, 0 FROM n; INSERT INTO orders VALUES(1505, 1505, 42);"
    let counts = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 1505) INSERT INTO customers SELECT id, 'seed', 0, NULL FROM n; WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 1505) INSERT INTO orders SELECT id, id, 1 FROM n; UPDATE orders SET total = 'bad storage' WHERE id = 1505;"

    test::assertTrue(createSQLiteFixture(smallPath, small))
    test::assertTrue(createSQLiteFixture(largePath, large))
    test::assertTrue(createSQLiteFixture(countPath, counts))
    match SQLiteProvider.open(smallPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifySmall(provider)
        match SQLiteProvider.open(smallPath)
          case SQLiteOpenResult.Failure(message)
            test::assertTrue(false)
          case SQLiteOpenResult.Opened(other)
            verifyProviderMismatch(provider, other)

            test::assertTrue(other.close())
        end

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.open(largePath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyLarge(provider)

        test::assertTrue(provider.close())
    end
    match SQLiteProvider.open(countPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyCountLarge(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFiles()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("SQLite join contracts passed")
end
