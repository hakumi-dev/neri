use files
use resources
use result
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class MetricRecord
  public id: Int = 0
  public groupId: Int = 0
  public a: Int? = null
  public b: Int? = null
  public leftText: String? = null
  public rightText: String? = null
end

class MetricResult
  public key: Int
  public count: Int

  def init(key: Int, count: Int): Void
    this.key = key
    this.count = count
  end
end

def rejectMetricRecord(row: RawRow): DecodeResult<MetricRecord>
  return DecodeResult<MetricRecord>.Failure(QueryFailure.Provider("group predicates must not decode source entities"))
end

def records(provider: SQLiteProvider): Query<MetricRecord>
  let mapping = new EntityMapping("MetricRecord", "metric_records", [
      new MappingColumn("MetricRecord.id", "Int", "id"),
      new MappingColumn("MetricRecord.groupId", "Int", "group_id"),
      new MappingColumn("MetricRecord.a", "Int?", "a"),
      new MappingColumn("MetricRecord.b", "Int?", "b"),
      new MappingColumn("MetricRecord.leftText", "String?", "left_text"),
      new MappingColumn("MetricRecord.rightText", "String?", "right_text")
    ], "id")
  let decoder = new Decoder<MetricRecord>(rejectMetricRecord, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<MetricRecord>("metric_records", decoder, mapping: mapping, provider: provider)
end

def keyField(): quote fn(MetricRecord): Int
  return quote do |row: MetricRecord|: Int
    return row.groupId
  end
end

def aField(): quote fn(MetricRecord): Int?
  return quote do |row: MetricRecord|: Int?
    return row.a
  end
end

def bField(): quote fn(MetricRecord): Int?
  return quote do |row: MetricRecord|: Int?
    return row.b
  end
end

def leftTextField(): quote fn(MetricRecord): String?
  return quote do |row: MetricRecord|: String?
    return row.leftText
  end
end

def rightTextField(): quote fn(MetricRecord): String?
  return quote do |row: MetricRecord|: String?
    return row.rightText
  end
end

def groups(source: Query<MetricRecord>, output: AggregateShape<MetricRecord, Int>): GroupedAggregate<MetricRecord, Int, Int, MetricResult>
  return selectGroups(groupBy(source, fieldShape(intScalar(), keyField())), output) do |key: Int, count: Int|: MetricResult
    return new MetricResult(key, count)
  end
end

def checkGroups(query: GroupedAggregate<MetricRecord, Int, Int, MetricResult>, expected: String): Void
  match query.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      var current = rows.first()
      var actual = ""

      while current != null
        actual = actual + (current.value.key as String) + ":" + (current.value.count as String) + ","
        current = current.next
      end

      test::assertEqual(actual, expected)
  end
end

def verifyPredicates(provider: SQLiteProvider): Void
  let grouped = groups(records(provider), countRows<MetricRecord>())
  let counts = groupMetric(countRows<MetricRecord>())
  let a = groupMetric(sumInt(optionalIntScalar(), aField()))
  let b = groupMetric(sumInt(optionalIntScalar(), bField()))
  let equal = a.equalTo(b)
  let different = a.notEqualTo(b)

  checkGroups(grouped.having(equal).take(20), "1:2,3:2,")
  checkGroups(grouped.having(different).take(20), "2:2,4:1,5:1,6:1,")
  checkGroups(grouped.having(equal.not()).take(20), "2:2,4:1,5:1,6:1,")
  checkGroups(grouped.having(different.not()).take(20), "1:2,3:2,")
  checkGroups(grouped.having(equal.or(different)).take(20), "1:2,2:2,3:2,4:1,5:1,6:1,")
  checkGroups(grouped.having(equal.and(different)).take(20), "")
  checkGroups(grouped.having(equal.or(equal.not())).take(20), "1:2,2:2,3:2,4:1,5:1,6:1,")

  let multiple = quote do |count: Int|: Bool
    return count > 1
  end
  let missing = quote do |value: Int?|: Bool
    return value == null
  end
  let manyOrMissing = counts.where(multiple).or(a.where(missing))

  checkGroups(grouped.having(counts.where(multiple).and(equal)).take(20), "1:2,3:2,")
  checkGroups(grouped.having(manyOrMissing).take(20), "1:2,2:2,3:2,4:1,")
  checkGroups(grouped.having(manyOrMissing.not()).take(20), "5:1,6:1,")
  checkGroups(grouped.having(counts.where(multiple).not().and(a.where(missing).not())).take(20), "5:1,6:1,")
  checkGroups(grouped.take(2).having(different), "2:2,")
  checkGroups(grouped.having(different).take(2), "2:2,4:1,")
  checkGroups(grouped.orderByKey(true).take(2).having(equal), "")
  checkGroups(grouped.having(equal).orderByKey(true).take(2), "3:2,1:2,")
  checkGroups(grouped.having(equal).skip(1).take(2), "3:2,")
  checkGroups(grouped.skip(1).take(2).having(equal), "3:2,")

  let zeroA = groupMetric(sumIntOrZero(optionalIntScalar(), aField()))
  let zeroB = groupMetric(sumIntOrZero(optionalIntScalar(), bField()))

  checkGroups(grouped.having(zeroA.lessThan(zeroB)).take(20), "2:2,4:1,")
  checkGroups(grouped.having(zeroA.lessOrEqual(zeroB)).take(20), "1:2,2:2,3:2,4:1,")
  checkGroups(grouped.having(zeroA.greaterThan(zeroB)).take(20), "5:1,6:1,")
  checkGroups(grouped.having(zeroA.greaterOrEqual(zeroB)).take(20), "1:2,3:2,5:1,6:1,")
  checkGroups(grouped.having(zeroA.equalTo(zeroB)).take(20), "1:2,3:2,")

  let textsA = groupMetric(minString(optionalTextScalar(), leftTextField()))
  let textsB = groupMetric(minString(optionalTextScalar(), rightTextField()))

  checkGroups(grouped.having(textsA.equalTo(textsB)).take(20), "1:2,3:2,6:1,")
  checkGroups(grouped.having(textsA.notEqualTo(textsB)).take(20), "2:2,4:1,5:1,")
  checkGroups(grouped.having(textsA.equalTo(textsB).not()).take(20), "2:2,4:1,5:1,")
  checkGroups(grouped.having(textsA.equalTo(textsB).and(different)).take(20), "6:1,")

  let sourceAfterFirst = quote do |row: MetricRecord|: Bool
    return row.id >= 2
  end
  let outputBeforeLast = quote do |row: MetricRecord|: Bool
    return row.id <= 8
  end
  let leftFilter = quote do |row: MetricRecord|: Bool
    return row.id > 2
  end
  let rightFilter = quote do |row: MetricRecord|: Bool
    return row.id < 9
  end
  let orderFilter = quote do |row: MetricRecord|: Bool
    return row.id >= 7
  end
  let filteredA = groupMetric(sumIntOrZero(optionalIntScalar(), aField()).where(leftFilter))
  let filteredB = groupMetric(sumIntOrZero(optionalIntScalar(), bField()).where(rightFilter))
  let ordered = groupMetric(countRows<MetricRecord>().where(orderFilter))
  let selected = countRows<MetricRecord>().where(outputBeforeLast)
  let mixed = groups(records(provider).matching(sourceAfterFirst), selected)
  let predicate = filteredA.lessThan(filteredB).or(counts.where(multiple))
  let result = mixed.having(predicate).orderByAggregate(ordered.descending()).thenByKey()

  checkGroups(result.take(20), "4:1,1:1,2:2,3:2,")
  checkGroups(result.take(2).having(equal), "1:1,")

  let distinctA = groupMetric(countNonNull(optionalIntScalar(), aField()).distinct())
  let distinctB = groupMetric(countNonNull(optionalIntScalar(), bField()).distinct())

  checkGroups(grouped.having(distinctA.equalTo(distinctB)).take(20), "1:2,2:2,3:2,6:1,")
  checkGroups(groups(records(provider).where(id: -1), countRows<MetricRecord>()).having(equal.or(different)).take(20), "")
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-group-predicates-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE metric_records(id INTEGER PRIMARY KEY, group_id INTEGER NOT NULL, a INTEGER, b INTEGER, left_text TEXT, right_text TEXT); INSERT INTO metric_records VALUES (1,1,10,10,'x','x'),(2,1,20,20,'x','x'),(3,2,5,20,'a','b'),(4,2,15,10,'a','b'),(5,3,NULL,NULL,NULL,NULL),(6,3,NULL,NULL,NULL,NULL),(7,4,NULL,7,NULL,'z'),(8,5,9,NULL,'z',NULL),(9,6,50,25,'O''Reilly; -- 水','O''Reilly; -- 水');"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyPredicates(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let result = verifyFile()

  test::assertEqual(result.closeFailures.count(), 0)
  match result.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
