use files
use resources
use result
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class ComparisonRow
  public id: Int = 0
  public a: Int = 0
  public b: Int = 0
  public x: Int? = null
  public y: Int? = null
  public s: String? = null
  public t: String? = null
  public p: Bool? = null
  public q: Bool? = null
  public f: Bool = false
  public g: Bool = false
  public n: String = ""
  public m: String = ""
end

def rejectEntity(row: RawRow): DecodeResult<ComparisonRow>
  return DecodeResult<ComparisonRow>.Failure(QueryFailure.Provider("comparison projections must not decode entities"))
end

def comparisonRows(provider: SQLiteProvider): Query<ComparisonRow>
  let mapping = new EntityMapping("ComparisonRow", "comparisons", [
      new MappingColumn("ComparisonRow.id", "Int", "id"),
      new MappingColumn("ComparisonRow.a", "Int", "a"),
      new MappingColumn("ComparisonRow.b", "Int", "b"),
      new MappingColumn("ComparisonRow.x", "Int?", "x"),
      new MappingColumn("ComparisonRow.y", "Int?", "y"),
      new MappingColumn("ComparisonRow.s", "String?", "s"),
      new MappingColumn("ComparisonRow.t", "String?", "t"),
      new MappingColumn("ComparisonRow.p", "Bool?", "p"),
      new MappingColumn("ComparisonRow.q", "Bool?", "q"),
      new MappingColumn("ComparisonRow.f", "Bool", "f"),
      new MappingColumn("ComparisonRow.g", "Bool", "g"),
      new MappingColumn("ComparisonRow.n", "String", "n"),
      new MappingColumn("ComparisonRow.m", "String", "m")
    ], "id")
  let decoder = new Decoder<ComparisonRow>(rejectEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<ComparisonRow>("comparisons", decoder, mapping: mapping, provider: provider)
end

def rowId(): quote fn(ComparisonRow): Int
  return quote do |row: ComparisonRow|: Int
    return row.id
  end
end

def checkIds(query: Query<ComparisonRow>, expected: String): Void
  match select(query.orderBy(rowId()).take(50), intScalar(), rowId()).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      var current = rows.first()
      var actual = ""

      while current != null
        actual = actual + (current.value as String) + ","
        current = current.next
      end

      test::assertEqual(actual, expected)
  end
end

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
end

def verifyComparisons(provider: SQLiteProvider): Void
  let rows = comparisonRows(provider)
  let equal = quote do |row: ComparisonRow|: Bool
    return row.a == row.b
  end
  let unequal = quote do |row: ComparisonRow|: Bool
    return row.a != row.b
  end
  let less = quote do |row: ComparisonRow|: Bool
    return row.a < row.b
  end
  let lessEqual = quote do |row: ComparisonRow|: Bool
    return row.a <= row.b
  end
  let greater = quote do |row: ComparisonRow|: Bool
    return row.a > row.b
  end
  let greaterEqual = quote do |row: ComparisonRow|: Bool
    return row.a >= row.b
  end

  checkIds(rows.matching(equal), "1,4,")
  checkIds(rows.matching(unequal), "2,3,5,6,")
  checkIds(rows.matching(less), "2,5,")
  checkIds(rows.matching(lessEqual), "1,2,4,5,")
  checkIds(rows.matching(greater), "3,6,")
  checkIds(rows.matching(greaterEqual), "1,3,4,6,")

  let optionalEqual = quote do |row: ComparisonRow|: Bool
    return row.x == row.y
  end
  let optionalUnequal = quote do |row: ComparisonRow|: Bool
    return row.x != row.y
  end
  let optionalNotEqual = quote do |row: ComparisonRow|: Bool
    return !(row.x == row.y)
  end
  let optionalTotal = quote do |row: ComparisonRow|: Bool
    return row.x == row.y || row.x != row.y
  end
  let optionalSelf = quote do |row: ComparisonRow|: Bool
    return row.x == row.x
  end

  checkIds(rows.matching(optionalEqual), "1,2,6,")
  checkIds(rows.matching(optionalUnequal), "3,4,5,")
  checkIds(rows.matching(optionalNotEqual), "3,4,5,")
  checkIds(rows.matching(optionalTotal), "1,2,3,4,5,6,")
  checkIds(rows.matching(optionalSelf), "1,2,3,4,5,6,")
  checkIds(rows.orderBy(rowId()).take(4).matching(optionalUnequal), "3,4,")
  checkIds(rows.orderBy(rowId()).skip(3).matching(optionalUnequal), "4,5,")
  checkIds(rows.where(a: 1).matching(less), "2,")

  let textEqual = quote do |row: ComparisonRow|: Bool
    return row.s == row.t
  end
  let textUnequal = quote do |row: ComparisonRow|: Bool
    return row.s != row.t
  end
  let boolEqual = quote do |row: ComparisonRow|: Bool
    return row.p == row.q
  end
  let boolUnequal = quote do |row: ComparisonRow|: Bool
    return row.p != row.q
  end
  let requiredText = quote do |row: ComparisonRow|: Bool
    return row.n == row.m
  end
  let requiredBool = quote do |row: ComparisonRow|: Bool
    return row.f == row.g
  end
  let requiredTextUnequal = quote do |row: ComparisonRow|: Bool
    return row.n != row.m
  end
  let requiredBoolUnequal = quote do |row: ComparisonRow|: Bool
    return row.f != row.g
  end

  checkIds(rows.matching(textEqual), "1,2,6,")
  checkIds(rows.matching(textUnequal), "3,4,5,")
  checkIds(rows.matching(boolEqual), "1,2,6,")
  checkIds(rows.matching(boolUnequal), "3,4,5,")
  checkIds(rows.matching(requiredText), "1,4,5,6,")
  checkIds(rows.matching(requiredBool), "1,4,6,")
  checkIds(rows.matching(requiredTextUnequal), "2,3,")
  checkIds(rows.matching(requiredBoolUnequal), "2,3,5,")
  checkIds(rows.where(n: "O'Reilly; -- 水").matching(requiredText), "6,")

  let filtered = quote do |row: ComparisonRow|: Bool
    return row.x == row.y && row.id > 2
  end

  match aggregateRows(rows.where(a: 4), countRows<ComparisonRow>().where(filtered)).value()
    case QueryValue.Value(count)
      test::assertEqual(count, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  saved(rows.matching(optionalUnequal).executeUpdate(n: "changed"), 3)
  checkIds(rows.where(n: "changed"), "3,4,5,")
  saved(rows.matching(optionalUnequal).executeDelete(), 3)
  checkIds(rows, "1,2,6,")
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-comparisons-")
    let path = temporary.path() + "/data.sqlite"
    var sql = "CREATE TABLE comparisons(id INTEGER PRIMARY KEY, a INTEGER NOT NULL, b INTEGER NOT NULL, x INTEGER, y INTEGER, s TEXT, t TEXT, p INTEGER, q INTEGER, f INTEGER NOT NULL, g INTEGER NOT NULL, n TEXT NOT NULL, m TEXT NOT NULL);"

    sql = sql + "INSERT INTO comparisons VALUES (1,1,1,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'same','same'), (2,1,2,1,1,'a','a',1,1,1,0,'a','b'), (3,2,1,1,2,'a','b',1,0,0,1,'b','a'), (4,2,2,NULL,1,NULL,'a',NULL,1,0,0,'',''), (5,3,4,1,NULL,'a',NULL,1,NULL,1,0,'水','水'), (6,4,3,2,2,'O''Reilly; -- 水','O''Reilly; -- 水',0,0,0,0,'O''Reilly; -- 水','O''Reilly; -- 水');"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyComparisons(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let result = verifyFile()

  test::assertEqual(result.closeFailures.count(), 0)
  match result.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
