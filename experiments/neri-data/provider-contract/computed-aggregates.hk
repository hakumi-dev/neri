use files
use resources
use result
use test
use host
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use quotation

class ComputedAggregateSumCount
  public total: Int?
  public count: Int

  def init(total: Int?, count: Int): Void
    this.total = total
    this.count = count
  end
end

class ComputedAggregateMinMax
  public minimum: Int?
  public maximum: Int?

  def init(minimum: Int?, maximum: Int?): Void
    this.minimum = minimum
    this.maximum = maximum
  end
end

class ComputedAggregateCore
  public total: Int?
  public count: Int
  public minimum: Int?
  public maximum: Int?

  def init(total: Int?, count: Int, minimum: Int?, maximum: Int?): Void
    this.total = total
    this.count = count
    this.minimum = minimum
    this.maximum = maximum
  end
end

class ComputedAggregateSummary
  public total: Int?
  public count: Int
  public minimum: Int?
  public maximum: Int?
  public average: Float?

  def init(total: Int?, count: Int, minimum: Int?, maximum: Int?, average: Float?): Void
    this.total = total
    this.count = count
    this.minimum = minimum
    this.maximum = maximum
    this.average = average
  end
end

class ComputedAggregateGroup
  public customerId: Int
  public count: Int

  def init(customerId: Int, count: Int): Void
    this.customerId = customerId
    this.count = count
  end
end

class ComputedAggregateProbe: Provider
  private inner: Provider
  public calls: Int = 0

  def init(inner: Provider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.BoundedTypedReads()
        return this.inner.supports(capability)
      case ProviderCapability.StreamingReads()
        return this.inner.supports(capability)
      case ProviderCapability.SetWrites()
        return this.inner.supports(capability)
      case ProviderCapability.TrackedWrites()
        return this.inner.supports(capability)
      case ProviderCapability.ExplicitTransactions()
        return this.inner.supports(capability)
      case ProviderCapability.Savepoints()
        return this.inner.supports(capability)
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    return this.inner.execute(plan)
  end
end

def aggregateTotalPlusOne(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.total + 1
  end
end

def aggregateConditionalTotal(): quote fn(Order): Int?
  return quote do |order: Order|: Int?
    return order.id > 11 ? order.total + 1 : null
  end
end

def aggregateCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def aggregateCustomerNamePlusSuffix(): quote fn(Customer): String
  return quote do |customer: Customer|: String
    return customer.name + "!"
  end
end

def aggregateNotNine(): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.total != 9
  end
end

def aggregateDivisionPositive(): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.total / (order.total - 9) > 0
  end
end

def aggregateThreshold(bound: Int): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.id > bound
  end
end

def aggregateBeforeTwelve(): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.id < 12
  end
end

def aggregateSourceFloor(bound: Int): quote fn(Order): Bool
  return quote do |order: Order|: Bool
    return order.total > bound
  end
end

def makeSumCount(total: Int?, count: Int): ComputedAggregateSumCount
  return new ComputedAggregateSumCount(total, count)
end

def makeMinMax(minimum: Int?, maximum: Int?): ComputedAggregateMinMax
  return new ComputedAggregateMinMax(minimum, maximum)
end

def makeCore(pair: ComputedAggregateSumCount, extremes: ComputedAggregateMinMax): ComputedAggregateCore
  return new ComputedAggregateCore(pair.total, pair.count, extremes.minimum, extremes.maximum)
end

def makeSummary(core: ComputedAggregateCore, average: Float?): ComputedAggregateSummary
  return new ComputedAggregateSummary(core.total, core.count, core.minimum, core.maximum, average)
end

def makeGroup(customerId: Int, count: Int): ComputedAggregateGroup
  return new ComputedAggregateGroup(customerId, count)
end

def assertIntParameter(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def verifyComputedAggregates(provider: SQLiteProvider): Void
  let db = database(provider)
  let relation = db.orders.asRelation()
  let increment = aggregateTotalPlusOne()
  let pair = combineAggregates(
    sumInt(intScalar(), increment),
    countNonNull(intScalar(), increment),
    makeSumCount
  )
  let extremes = combineAggregates(
    minInt(intScalar(), increment),
    maxInt(intScalar(), increment),
    makeMinMax
  )
  let core = combineAggregates(pair, extremes, makeCore)
  let summary = combineAggregates(core, average(intScalar(), increment), makeSummary)

  match relation.aggregate(summary).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value.total == 57)
      test::assertEqual(value.count, 4)
      test::assertTrue(value.minimum == 10)
      test::assertTrue(value.maximum == 21)
      test::assertTrue(value.average == 14.25)
  end

  match db.customers.asRelation().aggregate(maxString(textScalar(), aggregateCustomerNamePlusSuffix())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == "Deb!")
  end

  match relation.aggregate(sumInt(intScalar(), increment).distinct()).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 47)
  end

  match relation.aggregate(sumInt(optionalIntScalar(), aggregateConditionalTotal())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 26)
  end

  match db.orders.matching(quote do |order: Order|: Bool
      return order.id > 100
    end).asRelation().aggregate(sumInt(optionalIntScalar(), aggregateConditionalTotal())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == null)
  end

  match db.orders.matching(aggregateBeforeTwelve()).asRelation().aggregate(sumInt(optionalIntScalar(), aggregateConditionalTotal())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == null)
  end

  let filtered = sumInt(intScalar(), increment).where(aggregateThreshold(11))

  match relation.aggregate(filtered).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 26)
  end

  let safeCount = countRows<Order>().where(aggregateNotNine()).where(aggregateDivisionPositive()).where(aggregateThreshold(10))

  match relation.aggregate(safeCount).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertEqual(value, 2)
  end

  let badDivision = quote do |order: Order|: Int
    return order.total / (order.total - 9)
  end

  match db.orders.matching(quote do |order: Order|: Bool
      return order.id == 10
    end).asRelation().aggregate(sumInt(intScalar(), badDivision)).value()
    case QueryValue.Failure(error)
      match error
        case QueryFailure.Provider(message)
          test::assertEqual(message, "checked Int division is undefined")
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  match relation.aggregate(sumInt(intScalar(), badDivision).where(aggregateNotNine())).value()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(value)
      test::assertTrue(value == 3)
  end

  let argumentBound = 10
  let filterBound = 11
  let sourceBound = 8
  let argument = quote do |order: Order|: Int
    return order.id > argumentBound ? order.total : 0
  end
  let filteredArgument = sumInt(intScalar(), argument).where(aggregateThreshold(filterBound))

  match db.orders.matching(aggregateSourceFloor(sourceBound)).asRelation().aggregate(filteredArgument).compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      let sql = plan.sql().sql()

      test::assertTrue(containsText(sql, "CASE"))
      test::assertTrue(containsText(sql, "FILTER (WHERE"))
      test::assertTrue(containsText(sql, "$1"))
      test::assertTrue(containsText(sql, "$2"))
      test::assertTrue(containsText(sql, "$3"))
      test::assertTrue(containsText(sql, "$4"))
      test::assertEqual(plan.sql().parameters().count(), 4)
      let second = assertIntParameter(plan.sql().parameters().first(), argumentBound)
      let third = assertIntParameter(second, 0)
      let fourth = assertIntParameter(third, filterBound)
      let remaining = assertIntParameter(fourth, sourceBound)

      test::assertTrue(remaining == null)
  end

  let hiddenMetric = groupMetric(sumIntOrZero(intScalar(), increment))
  let positive = quote do |value: Int|: Bool
    return value > 0
  end
  let noCheckedHaving = new ComputedAggregateProbe(provider)
  let guardedHaving = selectGroups(
    database(noCheckedHaving).orders.asRelation().groupBy(fieldShape(intScalar(), aggregateCustomerId())),
    countRows<Order>(),
    makeGroup
  ).having(hiddenMetric.where(positive)).take(10)

  match guardedHaving.all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(noCheckedHaving.calls, 0)

  let noCheckedOrder = new ComputedAggregateProbe(provider)
  let hiddenOrder = groupMetric(sumIntOrZero(intScalar(), increment))
  let orderedGroups = selectGroups(
    database(noCheckedOrder).orders.asRelation().groupBy(fieldShape(intScalar(), aggregateCustomerId())),
    countRows<Order>(),
    makeGroup
  ).orderByAggregate(hiddenOrder.descending()).take(10)

  match orderedGroups.all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(noCheckedOrder.calls, 0)
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-computed-aggregates-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, 'Ada', 1, 'Ada'), (2, 'Bea', 1, NULL), (3, 'Cal', 0, 'Cal'), (4, 'Deb', 0, NULL); INSERT INTO orders VALUES(10, 1, 9), (11, 1, 20), (12, 2, 9), (13, 3, 15);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyComputedAggregates(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
