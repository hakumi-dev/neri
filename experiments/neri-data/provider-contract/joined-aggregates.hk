use files
use resources
use result
use test
use host
use app_data
use model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use quotation

class JoinedAggregateStats
  public total: Int?
  public rows: Int

  def init(total: Int?, rows: Int): Void
    this.total = total
    this.rows = rows
  end
end

class JoinedAggregateGroup
  public customerId: Int
  public total: Int?
  public rows: Int

  def init(customerId: Int, total: Int?, rows: Int): Void
    this.customerId = customerId
    this.total = total
    this.rows = rows
  end
end

class JoinedLeftAggregateGroup
  public customerId: Int
  public rows: Int

  def init(customerId: Int, rows: Int): Void
    this.customerId = customerId
    this.rows = rows
  end
end

class JoinedAggregateProbe: Provider
  private inner: Provider
  public calls: Int = 0

  def init(inner: Provider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.BoundedTypedReads()
        return this.inner.supports(capability)
      case ProviderCapability.StreamingReads()
        return this.inner.supports(capability)
      case ProviderCapability.SetWrites()
        return this.inner.supports(capability)
      case ProviderCapability.TrackedWrites()
        return this.inner.supports(capability)
      case ProviderCapability.ExplicitTransactions()
        return this.inner.supports(capability)
      case ProviderCapability.Savepoints()
        return this.inner.supports(capability)
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    return this.inner.execute(plan)
  end
end

def joinedAggregateCustomerId(): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id
  end
end

def joinedAggregateOrderCustomerId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.customerId
  end
end

def joinedAggregateOrderId(): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.id
  end
end

def joinedAggregateOrderTotalPlus(offset: Int): quote fn(Order): Int
  return quote do |order: Order|: Int
    return order.total + offset
  end
end

def joinedAggregateCustomerIdPlus(offset: Int): quote fn(Customer): Int
  return quote do |customer: Customer|: Int
    return customer.id + offset
  end
end

def joinedAggregateLeftCustomerId(): quote fn(Joined<Customer, Order>): Int
  return quote do |pair: Joined<Customer, Order>|: Int
    return pair.left.id
  end
end

def joinedAggregateRightTotal(): quote fn(Joined<Customer, Order>): Int
  return quote do |pair: Joined<Customer, Order>|: Int
    return pair.right.total
  end
end

def joinedAggregateNestedTotal(): quote fn(Joined<Joined<Customer, Order>, Customer>): Int
  return quote do |pair: Joined<Joined<Customer, Order>, Customer>|: Int
    return pair.left.right.total
  end
end

def joinedAggregateLeftJoinCustomerId(): quote fn(LeftJoined<Customer, Order>): Int
  return quote do |pair: LeftJoined<Customer, Order>|: Int
    return pair.left.id
  end
end

def makeJoinedAggregateStats(total: Int?, rows: Int): JoinedAggregateStats
  return new JoinedAggregateStats(total, rows)
end

def makeJoinedAggregateGroup(customerId: Int, stats: JoinedAggregateStats): JoinedAggregateGroup
  return new JoinedAggregateGroup(customerId, stats.total, stats.rows)
end

def makeJoinedLeftAggregateGroup(customerId: Int, rows: Int): JoinedLeftAggregateGroup
  return new JoinedLeftAggregateGroup(customerId, rows)
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def assertTextParameter(node: readonly ParameterNode?, expected: String): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Text(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Int(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
  end
  return node.next()
end

def assertIntParameter(node: readonly ParameterNode?, expected: Int): readonly ParameterNode?
  test::assertTrue(node != null)

  if node == null
    return null
  end
  match node.value()
    case Parameter.Int(value)
      test::assertEqual(value, expected)
    case Parameter.Bool(value)
      test::assertTrue(false)
    case Parameter.Float(value)
      test::assertTrue(false)
    case Parameter.Text(value)
      test::assertTrue(false)
  end
  return node.next()
end

def verifyJoinedAggregates(provider: SQLiteProvider): Void
  let db = database(provider)
  let allRows = join(db.customers, db.orders, intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).asRelation()
  let total = allRows.aggregate(sumInt(intScalar(), joinedAggregateRightTotal())).value()

  match total
    case QueryValue.Value(value)
      test::assertTrue(value == 53)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  match allRows.aggregate(countRows<Joined<Customer, Order>>()).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 4)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let sum = sumInt(intScalar(), joinedAggregateRightTotal())
  let metrics = combineAggregates(sum, countRows<Joined<Customer, Order>>(), makeJoinedAggregateStats)
  let groups = selectGroups(allRows.groupBy(fieldShape(intScalar(), joinedAggregateLeftCustomerId())), metrics, makeJoinedAggregateGroup)
  let totalMetric = groupMetric(sumIntOrZero(intScalar(), joinedAggregateRightTotal()))
  let hasTotalOverTen = quote do |value: Int|: Bool
    return value > 10
  end
  let grouped = groups.having(totalMetric.where(hasTotalOverTen)).orderByAggregate(totalMetric.descending()).take(2)

  match grouped.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        let second = first.next

        test::assertTrue(second != null)
        if second != null
          test::assertEqual(first.value.customerId, 1)
          test::assertTrue(first.value.total == 29)
          test::assertEqual(first.value.rows, 2)
          test::assertEqual(second.value.customerId, 3)
          test::assertTrue(second.value.total == 15)
          test::assertEqual(second.value.rows, 1)
        end
      end
  end

  let chained = allRows.join(db.customers.asRelation(), intScalar(), joinedAggregateLeftCustomerId(), joinedAggregateCustomerId()).asRelation()

  match chained.aggregate(sumInt(intScalar(), joinedAggregateNestedTotal())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == 53)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let emptyJoin = join(db.customers, db.orders, intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id < 0
    end).asRelation()

  match emptyJoin.aggregate(sumInt(intScalar(), joinedAggregateRightTotal())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match selectGroups(emptyJoin.groupBy(fieldShape(intScalar(), joinedAggregateLeftCustomerId())), countRows<Joined<Customer, Order>>(), makeJoinedLeftAggregateGroup).take(10).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
  end

  let sourceName = "Ada"
  let sourceTotal = 9
  let aggregateMinimum = 8
  let boundRelation = join(db.customers.where(name: sourceName), db.orders.where(total: sourceTotal), intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).asRelation()
  let filteredMetric = sumInt(intScalar(), joinedAggregateRightTotal()).where(quote do |pair: Joined<Customer, Order>|: Bool
      return pair.right.total > aggregateMinimum
    end)

  match boundRelation.aggregate(filteredMetric).compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 3)
      test::assertTrue(containsText(plan.sql().sql(), "FILTER (WHERE"))
      test::assertTrue(containsText(plan.sql().sql(), "$1"))
      test::assertTrue(containsText(plan.sql().sql(), "$2"))
      test::assertTrue(containsText(plan.sql().sql(), "$3"))
      let second = assertIntParameter(plan.sql().parameters().first(), aggregateMinimum)
      let third = assertTextParameter(second, sourceName)
      let remaining = assertIntParameter(third, sourceTotal)

      test::assertTrue(remaining == null)
  end

  let customerMinimum = 2
  let aggregateFloor = 8
  let limited = join(db.customers, db.orders, intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).orderByLeft(joinedAggregateCustomerId(), true).thenByRight(joinedAggregateOrderId()).take(2).matchingPair(quote do |customer: Customer, order: Order|: Bool
      return customer.id < customerMinimum
    end).orderByRight(joinedAggregateOrderTotalPlus(1)).skip(1).take(1).asRelation()

  match limited.aggregate(sumInt(intScalar(), joinedAggregateRightTotal()).where(quote do |pair: Joined<Customer, Order>|: Bool
        return pair.right.total > aggregateFloor
      end)).value()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  let leftRows = leftJoin(db.customers, db.orders, intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).asRelation()
  let leftGroups = selectGroups(leftRows.groupBy(fieldShape(intScalar(), joinedAggregateLeftJoinCustomerId())), countRows<LeftJoined<Customer, Order>>(), makeJoinedLeftAggregateGroup).take(10)

  match leftGroups.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 4)
      var row = rows.first()
      var sawUnmatched = false

      while row != null
        if row.value.customerId == 1
          test::assertEqual(row.value.rows, 2)
        else if row.value.customerId == 2 || row.value.customerId == 3 || row.value.customerId == 4
          test::assertEqual(row.value.rows, 1)
          if row.value.customerId == 4
            sawUnmatched = true
          end
        else
          test::assertTrue(false)
        end
        row = row.next
      end

      test::assertTrue(sawUnmatched)
  end

  let noChecked = new JoinedAggregateProbe(provider)
  let noCheckedDb = database(noChecked)
  let checkedRelation = join(noCheckedDb.customers, noCheckedDb.orders, intScalar(), joinedAggregateCustomerId(), joinedAggregateOrderCustomerId()).orderByLeft(joinedAggregateCustomerIdPlus(1)).asRelation()

  match checkedRelation.aggregate(countRows<Joined<Customer, Order>>()).value()
    case QueryValue.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "checked-scalar-expressions")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(noChecked.calls, 0)
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-joined-aggregates-")
    let path = temporary.path() + "/data.sqlite"
    let sql = "CREATE TABLE customers(id INTEGER, name TEXT, active INTEGER, nickname TEXT); CREATE TABLE orders(id INTEGER, customer_id INTEGER, total INTEGER); INSERT INTO customers VALUES(1, 'Ada', 1, 'Ada'), (2, 'Bea', 1, NULL), (3, 'Cal', 0, 'Cal'), (4, 'Deb', 0, NULL); INSERT INTO orders VALUES(10, 1, 9), (11, 1, 20), (12, 2, 9), (13, 3, 15);"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyJoinedAggregates(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
