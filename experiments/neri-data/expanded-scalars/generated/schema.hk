namespace expanded_data

## Describes the mapped tables and columns for schema comparison.
def schema_ExpandedDatabase(): neri_data::SchemaModel
  return new neri_data::SchemaModel([
      new neri_data::SchemaTable("expanded_model.Account", "accounts", [
          new neri_data::SchemaField(
            "expanded_model.Account.tenant",
            new neri_data::SchemaColumn(
              "tenant",
              neri_data::SchemaType.Int(),
              nullable: false,
              primaryKey: true,
              keyPosition: 1
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Account.code",
            new neri_data::SchemaColumn(
              "code",
              neri_data::SchemaType.Text(),
              nullable: false,
              primaryKey: true,
              keyPosition: 2
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Account.externalId",
            new neri_data::SchemaColumn("external_id", neri_data::SchemaType.Int(), nullable: false, primaryKey: false)
          )
        ], [
          new neri_data::SchemaIndex(
            "account_external",
            ["expanded_model.Account.tenant", "expanded_model.Account.externalId"],
            true
          )
        ]),
      new neri_data::SchemaTable("expanded_model.Item", "items", [
          new neri_data::SchemaField(
            "expanded_model.Item.tenant",
            new neri_data::SchemaColumn(
              "tenant",
              neri_data::SchemaType.Int(),
              nullable: false,
              primaryKey: true,
              keyPosition: 1,
              reference: new neri_data::SchemaReference(
                "accounts",
                ["tenant", "external_id"],
                ["tenant", "approver_external_id"]
              )
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Item.sequence",
            new neri_data::SchemaColumn(
              "sequence",
              neri_data::SchemaType.Int(),
              nullable: false,
              primaryKey: true,
              keyPosition: 2
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Item.accountExternalId",
            new neri_data::SchemaColumn(
              "account_external_id",
              neri_data::SchemaType.Int(),
              nullable: false,
              primaryKey: false,
              reference: new neri_data::SchemaReference(
                "accounts",
                ["tenant", "external_id"],
                ["tenant", "account_external_id"]
              )
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Item.approverExternalId",
            new neri_data::SchemaColumn(
              "approver_external_id",
              neri_data::SchemaType.Int(),
              nullable: false,
              primaryKey: false
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Item.amount",
            new neri_data::SchemaColumn(
              "amount",
              neri_data::SchemaType.Text(),
              nullable: false,
              primaryKey: false,
              defaultValue: neri_data::SchemaDefault.Text("0")
            )
          ),
          new neri_data::SchemaField(
            "expanded_model.Item.payload",
            new neri_data::SchemaColumn("payload", neri_data::SchemaType.Binary(), nullable: true, primaryKey: false)
          )
        ])
    ])
end
