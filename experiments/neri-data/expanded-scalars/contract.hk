use buffers
use expanded_data
use expanded_model
use files
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use resources
use result
use test


class OptionalTupleRecord
  public id: Int = 1
  public first: Int?
  public second: String?
end

def captureOptionalTuple(row: OptionalTupleRecord): RawRow
  return new RawRow([
      new RawColumn("id", Cell.Int(row.id)),
      new RawColumn("first", cellOptionalInt(row.first)),
      new RawColumn("second", cellOptionalString(row.second))
    ])
end

def optionalTupleValidation(): Void
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("first", ResultColumnKind.Int(), true),
      new ResultColumn("second", ResultColumnKind.Text(), true)
    ])
  let tuples: String[][] = [["first", "second"]]
  let tracker = new EntityTracker<OptionalTupleRecord>(
    "optional_tuples",
    "id",
    columns,
    captureOptionalTuple,
    foreignKeyColumns: tuples
  )
  let partial = new OptionalTupleRecord()

  partial.first = 1
  tuples[0][1] = "id"

  test::assertTrue(tracker.attach(partial) != null)
  partial.first = null

  test::assertTrue(tracker.attach(partial) == null)
end

def saved(result: WriteResult, count: Int): Void
  match result
    case WriteResult.Saved(actual)
      test::assertEqual(actual, count)
    case WriteResult.SavedWithValues(actual, outputs)
      test::assertEqual(actual, count)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end
end

def exactValues(): Void
  let first = Decimal.parse("9007199254740993.01")
  let second = Decimal.parse("0.09")

  test::assertTrue(first != null && second != null)
  test::assertTrue(Decimal.parse("1e3") == null)
  test::assertTrue(Decimal.parse("1.") == null)
  if first != null && second != null
    let sum = first.add(second)

    test::assertTrue(sum != null)
    if sum != null
      test::assertEqual(sum.text(), "9007199254740993.1")
      test::assertEqual(first.compare(sum), -1)
      let difference = sum.subtract(first)

      test::assertTrue(difference != null)
      if difference != null
        test::assertEqual(difference.text(), "0.09")
        test::assertEqual(difference.negate().text(), "-0.09")
      end
    end
  end
  let raw = new ByteBuffer(8, 0)

  raw.append(0 as Byte)
  raw.append(255 as Byte)
  let stable = cellByteBuffer(raw)

  raw.append(1 as Byte)
  match decodeScalarByteBuffer(stable)
    case DecodeResult.Failure(error)
      test::assertTrue(false)
    case DecodeResult.Value(value)
      test::assertEqual(value.length(), 2)
      test::assertTrue(value.byteAt(1) == (255 as Byte))
  end
end

def accountHandle(db: ExpandedDatabase, value: Account): TrackedHandle<Account>?
  match db.accounts.addWithHandle(value)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def verifyOverlappingLinks(provider: SQLiteProvider): Void
  let db = new ExpandedDatabase(provider)
  let owner = new Account()
  let approver = new Account()
  let child = new Item()

  owner.tenant = 3
  owner.code = "owner"
  owner.externalId = 200
  approver.tenant = 3
  approver.code = "approver"
  approver.externalId = 201
  child.tenant = 3
  child.sequence = 1
  child.accountExternalId = 200
  child.approverExternalId = 201
  let first = accountHandle(db, owner)
  let second = accountHandle(db, approver)

  match db.items.addWithHandle(child)
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(first != null && second != null)
      if first != null && second != null
        test::assertTrue(db.link_itemsFor_Account_by_tenant_accountExternalId(first, handle) == null)
        test::assertTrue(db.link_itemsFor_Account_by_tenant_approverExternalId(second, handle) == null)
        saved(db.saveChanges(), 3)
      end
  end
  let cleanup = new ExpandedDatabase(provider)

  saved(cleanup.items.where(tenant: 3).executeDelete(), 1)
  saved(cleanup.accounts.where(tenant: 3).executeDelete(), 2)
end

def verifyLazy(provider: SQLiteProvider): Void
  let db = new ExpandedDatabase(provider)

  match db.accounts.where(tenant: 1, code: "A").first()
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(account)
      test::assertTrue(account != null)
      if account != null
        match db.collectionState_itemsFor_Account_by_tenant_accountExternalId(account)
          case NavigationLoadState.Unknown()
          case NavigationLoadState.Loading()
            test::assertTrue(false)
          case NavigationLoadState.Partial()
            test::assertTrue(false)
          case NavigationLoadState.Loaded()
            test::assertTrue(false)
        end
        match db.lazy_itemsFor_Account_by_tenant_accountExternalId(account)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            let child = rows.first()

            test::assertEqual(rows.count(), 1)
            test::assertTrue(child != null)
            if child != null
              test::assertTrue(reference::same(child.value.account, account))
              match db.lazyReference_itemsFor_Account_by_tenant_accountExternalId(child.value)
                case QueryResult.Failure(error)
                  test::assertTrue(false)
                case QueryResult.Rows(parents)
                  let first = parents.first()

                  test::assertEqual(parents.count(), 1)
                  test::assertTrue(first != null)
                  if first != null
                    test::assertTrue(reference::same(first.value, account))
                  end
              end
            end
        end
        match db.collectionState_itemsFor_Account_by_tenant_accountExternalId(account)
          case NavigationLoadState.Loaded()
          case NavigationLoadState.Unknown()
            test::assertTrue(false)
          case NavigationLoadState.Loading()
            test::assertTrue(false)
          case NavigationLoadState.Partial()
            test::assertTrue(false)
        end
        match db.lazy_itemsFor_Account_by_tenant_accountExternalId(account)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 1)
        end
      end
  end
end

def verify(provider: SQLiteProvider): Void
  test::assertTrue(schema_ExpandedDatabase().validate() == null)
  verifyOverlappingLinks(provider)
  verifyLazy(provider)
  let db = new ExpandedDatabase(provider)

  match db.include_itemsFor_Account_by_tenant_approverExternalId(db.accounts.take(10)).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      var account = rows.first()

      while account != null
        test::assertEqual(account.value.approvedItems.Length, 1)
        if account.value.approvedItems.Length == 1
          let child = account.value.approvedItems[0]

          test::assertTrue(reference::same(child.approver, account.value))
          test::assertEqual(child.approverExternalId, account.value.externalId)
        end
        account = account.next
      end
  end
  match db.include_itemsFor_Account_by_tenant_accountExternalId(db.accounts.take(10)).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 3)
      var account = rows.first()
      var edited: Item? = null

      while account != null
        let value = account.value

        test::assertEqual(value.items.Length, 1)
        if value.tenant == 1 && value.code == "B"
          let original = value.externalId

          value.externalId = 999
          match db.saveChanges()
            case WriteResult.Failure(error)
              match error
                case WriteFailure.Validation(message)
                  test::assertEqual(message, "tracked alternate key changed")
                case WriteFailure.Provider(failure)
                  test::assertTrue(false)
                case WriteFailure.Unsupported(message)
                  test::assertTrue(false)
                case WriteFailure.Concurrency(message)
                  test::assertTrue(false)
                case WriteFailure.Constraint(message)
                  test::assertTrue(false)
                case WriteFailure.Transaction(message)
                  test::assertTrue(false)
                case WriteFailure.Cleanup(error)
                  test::assertTrue(false)
              end
            case WriteResult.Saved(count)
              test::assertTrue(false)
            case WriteResult.SavedWithValues(count, outputs)
              test::assertTrue(false)
          end
          value.externalId = original
        end
        if value.items.Length == 1
          let child = value.items[0]

          test::assertTrue(child.account != null && reference::same(child.account, value))
          test::assertEqual(child.accountExternalId, value.externalId)
          if value.tenant == 1 && value.code == "A"
            test::assertEqual(child.amount.text(), "9007199254740993.01")
            let bytes = child.payload

            test::assertTrue(bytes != null)
            if bytes != null
              test::assertEqual(bytes.length(), 2)
              test::assertTrue(bytes.byteAt(0) == (0 as Byte))
              test::assertTrue(bytes.byteAt(1) == (255 as Byte))
              bytes.append(7 as Byte)
            end
            edited = child
          end
        end
        account = account.next
      end
      saved(db.saveChanges(), 1)
      if edited != null
        let selected = db.items.where(tenant: edited.tenant, sequence: edited.sequence).take(1)

        match selected.all()
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(again)
            let item = again.first()

            test::assertTrue(item != null)
            if item != null
              test::assertTrue(reference::same(item.value, edited))
            end
        end
        let payload = new ByteBuffer(8, 0)

        payload.append(0 as Byte)
        payload.append(255 as Byte)
        payload.append(7 as Byte)
        match db.items.whereBinary("payload", payload).take(10).all()
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(matches)
            test::assertEqual(matches.count(), 1)
        end

        test::assertTrue(db.items.remove(edited) == null)
        saved(db.saveChanges(), 1)
      end
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-expanded-scalars-")
    let path = temporary.path() + "/expanded.sqlite"
    let schema = "PRAGMA foreign_keys=ON; CREATE TABLE accounts(tenant INTEGER NOT NULL,code TEXT NOT NULL,external_id INTEGER NOT NULL,PRIMARY KEY(tenant,code),UNIQUE(tenant,external_id)); CREATE TABLE items(tenant INTEGER NOT NULL,sequence INTEGER NOT NULL,account_external_id INTEGER NOT NULL,approver_external_id INTEGER NOT NULL,amount TEXT NOT NULL,payload BLOB,PRIMARY KEY(tenant,sequence),FOREIGN KEY(tenant,account_external_id) REFERENCES accounts(tenant,external_id),FOREIGN KEY(tenant,approver_external_id) REFERENCES accounts(tenant,external_id)); INSERT INTO accounts VALUES(1,'A',100),(1,'B',101),(2,'A',100); INSERT INTO items VALUES(1,1,100,101,'9007199254740993.01',X'00FF'),(1,2,101,100,'0',NULL),(2,1,100,100,'1',X'');"

    test::assertTrue(createSQLiteFixture(path, schema))
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(error)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verify(provider)

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  exactValues()
  optionalTupleValidation()
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end
