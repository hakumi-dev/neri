use buffers
use neri_data
namespace expanded_model

class Account
  public tenant: Int = 0
  public code: String = ""
  public externalId: Int = 0
  public items: Item[] = []
end

class Item
  public tenant: Int = 0
  public sequence: Int = 0
  public accountExternalId: Int = 0
  public amount: Decimal = Decimal.zero()
  public payload: ByteBuffer? = null
  public account: Account?
end
