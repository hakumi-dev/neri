use host
use quotation
namespace neri_data

## A UTC calendar instant using exact 100-nanosecond textual storage.
class DateTime
  private value: String = "0001-01-01T00:00:00.0000000Z"

  static def minimum(): DateTime
    return new DateTime()
  end

  static def parse(value: String): DateTime?
    let length = host::stringByteLength(value)

    if length < 20 || length > 28 || host::stringByteAt(
      value,
      10
    ) as Int != 84 || host::stringByteAt(
      value,
      length - 1
    ) as Int != 90
      return null
    end
    let date = DateOnly.parse(host::stringSlice(value, 0, 10))
    let time = TimeOnly.parse(host::stringSlice(value, 11, length - 12))

    if date == null || time == null
      return null
    end
    let result = new DateTime()

    result.value = date.toText() + "T" + time.toText() + "Z"
    return result
  end

  public readonly def toText(): String
    return this.value
  end

  public static def captureQuotation(value: readonly DateTime?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toText())
  end

  @operator("==")
  public readonly def equals(other: readonly DateTime): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly DateTime): Bool
    return this.value != other.value
  end

  @operator("<")
  public readonly def before(other: readonly DateTime): Bool
    return compareScalarText(this.value, other.value) < 0
  end

  @operator("<=")
  public readonly def beforeOrEqual(other: readonly DateTime): Bool
    return compareScalarText(this.value, other.value) <= 0
  end

  @operator(">")
  public readonly def after(other: readonly DateTime): Bool
    return compareScalarText(this.value, other.value) > 0
  end

  @operator(">=")
  public readonly def afterOrEqual(other: readonly DateTime): Bool
    return compareScalarText(this.value, other.value) >= 0
  end
end
