use json
use result
use quotation
namespace neri_data

## An immutable validated JSON document with deterministic bounded text storage.
class JsonDocument
  private value: String = "{}"

  static def empty(): JsonDocument
    return new JsonDocument()
  end

  static def parse(text: String): JsonDocument?
    match json::parse(text)
      case result::Result.Error(error)
        return null
      case result::Result.Ok(value)
        match json::stringify(value)
          case result::Result.Error(error)
            return null
          case result::Result.Ok(canonical)
            let document = new JsonDocument()

            document.value = canonical
            return document
        end
    end
  end

  public readonly def toText(): String
    return this.value
  end

  public static def captureQuotation(value: readonly JsonDocument?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toText())
  end

  @operator("==")
  public readonly def equals(other: readonly JsonDocument): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly JsonDocument): Bool
    return this.value != other.value
  end
end
