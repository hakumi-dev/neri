use neri_data
use test

class AggregateRecord
  public id: Int
  public category: String?
  public amount: Int?

  def init(id: Int, category: String? = null, amount: Int? = null): Void
    this.id = id
    this.category = category
    this.amount = amount
  end
end

class AggregatePair
  public rows: Int
  public total: Int?

  def init(rows: Int, total: Int?): Void
    this.rows = rows
    this.total = total
  end
end

class AggregateGroup
  public category: String?
  public rows: Int

  def init(category: String?, rows: Int): Void
    this.category = category
    this.rows = rows
  end
end

class AggregateCalls
  public materialized: Int = 0
end

class AggregateProvider: Provider
  public rows: RawRow[] = []
  public calls: Int = 0
  public enabled: Bool = true
  public fail: Bool = false
  public seenSql: String = ""
  public seenParameters: Int = 0

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.enabled
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    this.seenSql = plan.sql()
    this.seenParameters = plan.parameters().count()

    if this.fail
      return ProviderResult.Failure("aggregate provider failed")
    end
    return ProviderResult.Rows(this.rows)
  end
end

def aggregateQuery(): Query<AggregateRecord>
  let mapping = new EntityMapping("AggregateRecord", "aggregate_records", [new MappingColumn("AggregateRecord.id", "Int", "id"), new MappingColumn("AggregateRecord.category", "String?", "category"), new MappingColumn("AggregateRecord.amount", "Int?", "amount")])
  let decoder = new Decoder<AggregateRecord>(rejectAggregateEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<AggregateRecord>("aggregate_records", decoder, mapping: mapping)
end

def rejectAggregateEntity(row: RawRow): DecodeResult<AggregateRecord>
  return DecodeResult<AggregateRecord>.Failure(QueryFailure.Provider("aggregate must not decode input entities"))
end

def aggregatePair(rows: Int, total: Int?): AggregatePair
  return new AggregatePair(rows, total)
end

def makeAggregateGroup(calls: AggregateCalls): fn(String?, Int): AggregateGroup
  return fn(category: String?, rows: Int): AggregateGroup
    calls.materialized = calls.materialized + 1
    return new AggregateGroup(category, rows)
  end
end

def categoryKey(): RowShape<AggregateRecord, String?>
  let category: quote fn(AggregateRecord): String? = quote do |record: AggregateRecord|: String?
    return record.category
  end

  return fieldShape(optionalTextScalar(), category)
end

def verifyAggregateModifiers(provider: AggregateProvider): Void
  let amount: quote fn(AggregateRecord): Int? = quote do |record: AggregateRecord|: Int?
    return record.amount
  end
  let lower: quote fn(AggregateRecord): Bool = quote do |record: AggregateRecord|: Bool
    return record.id > 2
  end
  let upper: quote fn(AggregateRecord): Bool = quote do |record: AggregateRecord|: Bool
    return record.id < 9
  end
  let original = sumIntOrZero(optionalIntScalar(), amount)
  let modified = original.distinct().where(lower).where(upper)
  let input = aggregateQuery().where(id: 7)
  let counted = aggregateRows(input, modified)

  match counted.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().sql(), "SELECT COALESCE(SUM(DISTINCT \"aggregate_records\".\"amount\") FILTER (WHERE (\"aggregate_records\".\"id\" > $1 AND \"aggregate_records\".\"id\" < $2)), 0) AS \"__neri_aggregate_0\" FROM (SELECT \"aggregate_records\".\"id\", \"aggregate_records\".\"category\", \"aggregate_records\".\"amount\" FROM \"aggregate_records\" WHERE \"aggregate_records\".\"id\" = $3) AS \"aggregate_records\"")
      test::assertEqual(plan.sql().parameters().count(), 3)
      let first = plan.sql().parameters().first()

      test::assertTrue(first != null)
      if first != null
        match first.value()
          case Parameter.Int(value)
            test::assertEqual(value, 2)
          case Parameter.Float(value)
            test::assertTrue(false)
          case Parameter.Bool(value)
            test::assertTrue(false)
          case Parameter.Text(value)
            test::assertTrue(false)
        end
        let second = first.next()

        test::assertTrue(second != null)
        if second != null
          match second.value()
            case Parameter.Int(value)
              test::assertEqual(value, 9)
            case Parameter.Float(value)
              test::assertTrue(false)
            case Parameter.Bool(value)
              test::assertTrue(false)
            case Parameter.Text(value)
              test::assertTrue(false)
          end
          let third = second.next()

          test::assertTrue(third != null)
          if third != null
            match third.value()
              case Parameter.Int(value)
                test::assertEqual(value, 7)
              case Parameter.Float(value)
                test::assertTrue(false)
              case Parameter.Bool(value)
                test::assertTrue(false)
              case Parameter.Text(value)
                test::assertTrue(false)
            end
          end
        end
      end
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  match counted.compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().sql(), "SELECT COALESCE(SUM(DISTINCT \"aggregate_records\".\"amount\") FILTER (WHERE (\"aggregate_records\".\"id\" > ? AND \"aggregate_records\".\"id\" < ?)), 0) AS \"__neri_aggregate_0\" FROM (SELECT \"aggregate_records\".\"id\", \"aggregate_records\".\"category\", \"aggregate_records\".\"amount\" FROM \"aggregate_records\" WHERE \"aggregate_records\".\"id\" = ?) AS \"aggregate_records\"")
      test::assertEqual(plan.sql().parameters().count(), 3)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(input, original).compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 1)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let before = provider.calls

  match aggregateRows(input, countRows<AggregateRecord>().distinct().where(lower)).value(provider)
    case QueryValue.Failure(error)
      test::assertTrue(true)
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, before)
  let combined = combineAggregates(countRows<AggregateRecord>(), sumInt(optionalIntScalar(), amount), aggregatePair)

  match aggregateRows(input, combined.distinct()).value(provider)
    case QueryValue.Failure(error)
      test::assertTrue(true)
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, before)
  let distributed = combineAggregates(countRows<AggregateRecord>().where(lower), sumInt(optionalIntScalar(), amount).where(upper), aggregatePair).where(lower)

  match aggregateRows(input, distributed).compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 5)
      test::assertEqual(plan.sql().columns().count(), 2)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let constant: quote fn(AggregateRecord): Bool = quote do |record: AggregateRecord|: Bool
    return true
  end

  match aggregateRows(input, sumInt(optionalIntScalar(), amount).where(constant)).compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 2)
      let first = plan.sql().parameters().first()

      test::assertTrue(first != null)
      if first != null
        match first.value()
          case Parameter.Bool(value)
            test::assertTrue(value)
          case Parameter.Int(value)
            test::assertTrue(false)
          case Parameter.Float(value)
            test::assertTrue(false)
          case Parameter.Text(value)
            test::assertTrue(false)
        end
      end
  end

  test::assertEqual(provider.calls, before)
end

def main(): Void
  let amount: quote fn(AggregateRecord): Int? = quote do |record: AggregateRecord|: Int?
    return record.amount
  end
  let provider = new AggregateProvider()
  let paired = aggregateRows(aggregateQuery(), combineAggregates(countRows<AggregateRecord>(), sumInt(optionalIntScalar(), amount), aggregatePair))

  provider.rows = [new RawRow([new RawColumn("__neri_aggregate_0", Cell.Int(0)), new RawColumn("__neri_aggregate_1", Cell.Null())])]
  match paired.value(provider)
    case QueryValue.Value(value)
      test::assertEqual(value.rows, 0)
      test::assertTrue(value.total == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, 1)
  match paired.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().limit(), 1)
      test::assertEqual(plan.sql().columns().count(), 2)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let counted = aggregateRows(aggregateQuery(), countNonNull(optionalIntScalar(), amount))

  provider.rows = [new RawRow([new RawColumn("__neri_aggregate_0", Cell.Int(0))])]
  match counted.value(provider)
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let zero = aggregateRows(aggregateQuery(), sumIntOrZero(optionalIntScalar(), amount))

  provider.rows = [new RawRow([new RawColumn("__neri_aggregate_0", Cell.Int(0))])]
  match zero.value(provider)
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let category: quote fn(AggregateRecord): String? = quote do |record: AggregateRecord|: String?
    return record.category
  end
  let minimum = aggregateRows(aggregateQuery(), minString(optionalTextScalar(), category))

  provider.rows = [new RawRow([new RawColumn("__neri_aggregate_0", Cell.Null())])]
  match minimum.value(provider)
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  provider.rows = []
  match paired.value(provider)
    case QueryValue.Failure(error)
      match error
        case QueryFailure.Cardinality(expected, actual)
          test::assertEqual(actual, 0)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  provider.rows = [new RawRow([new RawColumn("__neri_aggregate_0", Cell.Int(1)), new RawColumn("__neri_aggregate_1", Cell.Null())]), new RawRow([new RawColumn("__neri_aggregate_0", Cell.Int(2)), new RawColumn("__neri_aggregate_1", Cell.Null())])]
  match paired.value(provider)
    case QueryValue.Failure(error)
      test::assertTrue(true)
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  let calls = new AggregateCalls()
  let grouped = selectGroups(groupBy(aggregateQuery(), categoryKey()), countRows<AggregateRecord>(), makeAggregateGroup(calls)).take(2)

  provider.rows = [new RawRow([new RawColumn("__neri_shape_0", Cell.Null()), new RawColumn("__neri_aggregate_1", Cell.Int(2))]), new RawRow([new RawColumn("__neri_shape_0", Cell.Text("A")), new RawColumn("__neri_aggregate_1", Cell.Int(3))])]
  match grouped.all(provider)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 2)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertTrue(first.value.category == null)
        test::assertEqual(first.value.rows, 2)
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(calls.materialized, 2)
  provider.rows = [new RawRow([new RawColumn("__neri_shape_0", Cell.Text("A")), new RawColumn("__neri_aggregate_1", Cell.Int(1))]), new RawRow([new RawColumn("__neri_shape_0", Cell.Text("B")), new RawColumn("__neri_aggregate_1", Cell.Int(1))]), new RawRow([new RawColumn("__neri_shape_0", Cell.Text("C")), new RawColumn("__neri_aggregate_1", Cell.Int(1))])]
  match grouped.all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(calls.materialized, 2)
  provider.rows = [new RawRow([new RawColumn("__neri_shape_0", Cell.Null()), new RawColumn("__neri_aggregate_1", Cell.Text("bad"))])]
  match grouped.all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(calls.materialized, 2)
  provider.fail = true
  match grouped.all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
  provider.fail = false
  provider.enabled = false
  let before = provider.calls

  match grouped.all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, before)
  provider.enabled = true
  match grouped.take(0).take(1).compile()
    case CompileResult.Failure(error)
      test::assertTrue(true)
    case CompileResult.Plan(plan)
      test::assertTrue(false)
  end
  match grouped.take(1001).compile()
    case CompileResult.Failure(error)
      test::assertTrue(true)
    case CompileResult.Plan(plan)
      test::assertTrue(false)
  end
  match grouped.take(1).compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().limit(), 1)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let staged = selectGroups(groupBy(aggregateQuery().where(id: 7).take(2).skip(1), categoryKey()), countRows<AggregateRecord>(), makeAggregateGroup(calls)).take(1)

  match staged.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().sql(), "SELECT \"aggregate_records\".\"category\" AS \"__neri_shape_0\", COUNT(*) AS \"__neri_aggregate_1\" FROM (SELECT \"aggregate_records\".\"id\", \"aggregate_records\".\"category\", \"aggregate_records\".\"amount\" FROM (SELECT \"aggregate_records\".\"id\", \"aggregate_records\".\"category\", \"aggregate_records\".\"amount\" FROM \"aggregate_records\" WHERE \"aggregate_records\".\"id\" = $1 LIMIT 2) AS \"aggregate_records\" OFFSET 1) AS \"aggregate_records\" GROUP BY 1 ORDER BY 1 LIMIT 1")
      test::assertEqual(plan.sql().parameters().count(), 1)
      test::assertEqual(plan.sql().limit(), 1)
      let first = plan.sql().parameters().first()

      test::assertTrue(first != null)
      if first != null
        match first.value()
          case Parameter.Int(value)
            test::assertEqual(value, 7)
          case Parameter.Float(value)
            test::assertTrue(false)
          case Parameter.Bool(value)
            test::assertTrue(false)
          case Parameter.Text(value)
            test::assertTrue(false)
        end
      end
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let badMapping = new EntityMapping("AggregateRecord", "aggregate_records", [new MappingColumn("AggregateRecord.id", "Int", "id"), new MappingColumn("AggregateRecord.category", "String?", "category"), new MappingColumn("AggregateRecord.amount", "String", "amount")])
  let badDecoder = new Decoder<AggregateRecord>(rejectAggregateEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))
  let badQuery = new Query<AggregateRecord>("aggregate_records", badDecoder, mapping: badMapping)
  let beforeBad = provider.calls

  match aggregateRows(badQuery, sumInt(optionalIntScalar(), amount)).value(provider)
    case QueryValue.Failure(error)
      test::assertTrue(true)
    case QueryValue.Value(value)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeBad)
  verifyAggregateModifiers(provider)
  match selectGroups(groupBy(aggregateQuery(), categoryKey()), countRows<AggregateRecord>(), makeAggregateGroup(calls)).compile()
    case CompileResult.Failure(error)
      test::assertTrue(true)
    case CompileResult.Plan(plan)
      test::assertTrue(false)
  end
end
