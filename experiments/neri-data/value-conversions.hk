use buffers
namespace neri_data

## Creates an owned binary cell from a bounded byte sequence.
def cellBinaryBytes(bytes: Byte[]): Cell
  let value = new ByteBuffer(134217728, bytes.Length)

  value.appendBytes(bytes)
  return Cell.Binary(value)
end

## Stores Bool values as the canonical integers zero and one.
def cellBoolToInt(value: Bool): Cell
  return Cell.Int(value ? 1 : 0)
end

def cellOptionalBoolToInt(value: Bool?): Cell
  return value == null ? Cell.Null() : cellBoolToInt(value)
end

def decodeBoolToInt(row: RawRow, column: String): DecodeResult<Bool>
  match decodeInt(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Bool>.Failure(error)
    case DecodeResult.Value(value)
      if value != 0 && value != 1
        return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch(
            column,
            "Bool stored as 0 or 1",
            "Int outside converter range"
          ))
      end
      return DecodeResult<Bool>.Value(value == 1)
  end
end

def decodeNullableBoolToInt(row: RawRow, column: String): DecodeResult<Bool?>
  match decodeNullableInt(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Bool?>.Failure(error)
    case DecodeResult.Value(value)
      if value == null
        return DecodeResult<Bool?>.Value(null)
      end
      if value != 0 && value != 1
        return DecodeResult<Bool?>.Failure(QueryFailure.TypeMismatch(
            column,
            "Bool stored as 0 or 1",
            "Int outside converter range"
          ))
      end
      return DecodeResult<Bool?>.Value(value == 1)
  end
end
