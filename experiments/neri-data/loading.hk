use reference
use host
use arrays
namespace neri_data

def navigationCellEqual(left: Cell, right: Cell): Bool
  match left
    case Cell.Int(value)
      match right
        case Cell.Int(other)
          return value == other
        case Cell.Null()
          return false
        case Cell.Bool(other)
          return false
        case Cell.Float(other)
          return false
        case Cell.Text(other)
          return false
      end
    case Cell.Text(value)
      match right
        case Cell.Text(other)
          return value == other
        case Cell.Null()
          return false
        case Cell.Bool(other)
          return false
        case Cell.Float(other)
          return false
        case Cell.Int(other)
          return false
      end
    case Cell.Null()
      return false
    case Cell.Bool(value)
      return false
    case Cell.Float(value)
      return false
  end
end

def navigationCellSameOrNull(left: Cell, right: Cell): Bool
  match left
    case Cell.Null()
      match right
        case Cell.Null()
          return true
        case Cell.Int(value)
          return false
        case Cell.Text(value)
          return false
        case Cell.Bool(value)
          return false
        case Cell.Float(value)
          return false
      end
    case Cell.Int(value)
      return navigationCellEqual(left, right)
    case Cell.Text(value)
      return navigationCellEqual(left, right)
    case Cell.Bool(value)
      return false
    case Cell.Float(value)
      return false
  end
end

def navigationKeyValid(value: Cell): Bool
  match value
    case Cell.Int(number)
      return true
    case Cell.Text(text)
      return true
    case Cell.Null()
      return false
    case Cell.Bool(boolean)
      return false
    case Cell.Float(number)
      return false
  end
end

def navigationColumnType(mapping: EntityMapping, column: String): String
  var index = 0

  while index < mapping.count()
    let field = mapping.columnAt(index)

    if field != null && field.column() == column
      return field.typeName()
    end
    index = index + 1
  end
  return ""
end

def navigationUnderlyingType(value: String): String
  if value == "Int?"
    return "Int"
  end
  if value == "String?"
    return "String"
  end
  return value
end

def navigationPhysicalEqual(left: String, right: String): Bool
  let length = host::stringByteLength(left)

  if length != host::stringByteLength(right)
    return false
  end
  var index = 0

  while index < length
    var first = host::stringByteAt(left, index) as Int
    var second = host::stringByteAt(right, index) as Int

    if first >= 65 && first <= 90
      first = first + 32
    end
    if second >= 65 && second <= 90
      second = second + 32
    end
    if first != second
      return false
    end
    index = index + 1
  end
  return true
end

def navigationColumnCollision(mapping: EntityMapping, name: String): Bool
  var index = 0

  while index < mapping.count()
    let column = mapping.columnAt(index)

    if column != null && navigationPhysicalEqual(column.column(), name)
      return true
    end
    index = index + 1
  end
  return false
end

def navigationRowMatches(row: RawRow, column: String, expected: Cell): Bool
  match row.value(column)
    case CellLookup.Found(actual)
      return navigationCellEqual(actual, expected)
    case CellLookup.Missing()
      return false
  end
end

def navigationRowMatchesOptional(row: RawRow, column: String, expected: Cell): Bool
  match row.value(column)
    case CellLookup.Found(actual)
      return navigationCellSameOrNull(actual, expected)
    case CellLookup.Missing()
      return false
  end
end

class CollectionNavigation<P, D>
  private principalKeyGetter: fn(P): Cell
  private dependentKeyGetter: fn(D): Cell
  private foreignKeyGetter: fn(D): Cell
  private foreignKeyName: String
  private collectionGetter: fn(P): D[]
  private collectionSetter: fn(P, D[]): Void
  private referenceGetter: fn(D): P?
  private referenceSetter: fn(D, P?): Void

  public def init(principalKey: fn(P): Cell, dependentKey: fn(D): Cell, foreignKey: fn(D): Cell, foreignKeyColumn: String, getCollection: fn(P): D[], setCollection: fn(P, D[]): Void, getReference: fn(D): P?, setReference: fn(D, P?): Void): Void
    this.principalKeyGetter = principalKey
    this.dependentKeyGetter = dependentKey
    this.foreignKeyGetter = foreignKey
    this.foreignKeyName = foreignKeyColumn
    this.collectionGetter = getCollection
    this.collectionSetter = setCollection
    this.referenceGetter = getReference
    this.referenceSetter = setReference
  end

  internal def principalKey(entity: P): Cell
    return this.principalKeyGetter(entity)
  end

  internal def dependentKey(entity: D): Cell
    return this.dependentKeyGetter(entity)
  end

  internal def foreignKey(entity: D): Cell
    return this.foreignKeyGetter(entity)
  end

  internal readonly def column(): String
    return this.foreignKeyName
  end

  internal def collection(entity: P): D[]
    return this.collectionGetter(entity)
  end

  internal def setCollection(entity: P, children: D[]): Void
    this.collectionSetter(entity, children)
  end

  internal def reference(entity: D): P?
    return this.referenceGetter(entity)
  end

  internal def setReference(entity: D, principal: P?): Void
    this.referenceSetter(entity, principal)
  end
end

class NavigationBucket<P, D>
  public principal: P
  public key: Cell
  public children: TypedRows<D>
  public next: NavigationBucket<P, D>?

  internal def init(principal: P, key: Cell): Void
    this.principal = principal
    this.key = key
    this.children = new TypedRows<D>()
    this.next = null
  end

end

class NavigationStage<D>
  public rows: TypedRows<D>
  public maximum: Int
  public overflow: Bool = false

  internal def init(maximum: Int): Void
    this.rows = new TypedRows<D>()
    this.maximum = maximum
  end

  internal def accept(value: D): Bool
    if this.rows.count() >= this.maximum
      this.overflow = true
      return false
    end
    this.rows.add(value)
    return true
  end
end

class NavigationArrayCursor<D>
  private current: TypedRowNode<D>?
  private seed: D

  internal def init(first: TypedRowNode<D>): Void
    this.current = first
    this.seed = first.value
  end

  internal def next(): D
    let current = this.current

    if current == null
      return this.seed
    end
    this.current = current.next
    return current.value
  end
end

class NavigationInverseAudit<P, D>
  private relation: CollectionNavigation<P, D>
  private principal: P
  private collection: D[]

  internal def init(relation: CollectionNavigation<P, D>, principal: P): Void
    this.relation = relation
    this.principal = principal
    this.collection = relation.collection(principal)
  end

  internal def accepts(child: D): Bool
    let inverse = this.relation.reference(child)

    if inverse == null || !reference::same(inverse, this.principal)
      return true
    end
    for member in this.collection
      if reference::same(member, child)
        return true
      end
    end
    return false
  end
end

enum NavigationOrderResult
  case Sql(value: String)
  case Failure(error: QueryFailure)
end

def navigationOrderTerm(mapping: EntityMapping, column: String, tree: readonly quotation::Tree?, descending: Bool, state: CompileState, dialect: SqlDialect): NavigationOrderResult
  if tree != null
    match compileScalarQuotation(mapping, tree, tree.resultType(), state, dialect)
      case ScalarSqlResult.Failure(error)
        return NavigationOrderResult.Failure(error)
      case ScalarSqlResult.Value(value)
        state.requiresCheckedScalars = state.requiresCheckedScalars || value.checkedScalars
        return NavigationOrderResult.Sql(value.sql + (descending ? " DESC" : " ASC"))
    end
  end
  if !identifierValid(column) || navigationColumnType(mapping, column) == ""
    return NavigationOrderResult.Failure(QueryFailure.MissingColumn(column))
  end
  return NavigationOrderResult.Sql(quoted(mapping.table(), column) + (descending ? " DESC" : " ASC"))
end

def navigationWindowOrder<T>(query: Query<T>, mapping: EntityMapping, dependentKey: String, state: CompileState, dialect: SqlDialect): NavigationOrderResult
  var order = ""
  let tree = query.primaryOrderingTree()
  let column = query.orderingColumn()

  if tree != null || column != null
    match navigationOrderTerm(mapping, column != null ? column : "", tree, query.orderingDescending(), state, dialect)
      case NavigationOrderResult.Failure(error)
        return NavigationOrderResult.Failure(error)
      case NavigationOrderResult.Sql(value)
        order = value
    end
  end
  var nextOrder = query.secondaryOrder()

  while nextOrder != null
    match navigationOrderTerm(mapping, nextOrder.column, nextOrder.tree, nextOrder.descending, state, dialect)
      case NavigationOrderResult.Failure(error)
        return NavigationOrderResult.Failure(error)
      case NavigationOrderResult.Sql(value)
        order = order + (order == "" ? "" : ", ") + value
    end
    nextOrder = nextOrder.next
  end
  if !identifierValid(dependentKey)
    return NavigationOrderResult.Failure(QueryFailure.InvalidIdentifier(dependentKey))
  end
  return NavigationOrderResult.Sql(order + (order == "" ? "" : ", ") + quoted(mapping.table(), dependentKey) + " ASC")
end

class IncludedQuery<P, D>
  private principals: Query<P>
  private dependents: Query<D>
  private selectedChildren: Query<D>?
  private relation: CollectionNavigation<P, D>
  private childMaximum: Int = 10000

  internal def init(principals: Query<P>, dependents: Query<D>, relation: CollectionNavigation<P, D>, selectedChildren: Query<D>? = null): Void
    this.principals = principals
    this.dependents = dependents
    this.relation = relation
    this.selectedChildren = selectedChildren
  end

  public def maxChildren(maximum: Int): IncludedQuery<P, D>
    let copy = new IncludedQuery<P, D>(this.principals, this.dependents, this.relation, this.selectedChildren)

    copy.childMaximum = maximum
    return copy
  end

  ## Applies one mapped dependent filter/order stage; skip and take are per principal.
  public def children(query: Query<D>): IncludedQuery<P, D>
    let copy = new IncludedQuery<P, D>(this.principals, this.dependents, this.relation, query)

    copy.childMaximum = this.childMaximum
    return copy
  end

  public def all(): QueryResult<P>
    let invalid = this.validateQueries()

    if invalid != null
      return QueryResult<P>.Failure(invalid)
    end
    match this.principals.all()
      case QueryResult.Failure(error)
        return QueryResult<P>.Failure(error)
      case QueryResult.Rows(rows)
        return this.load(rows)
    end
  end

  internal def validateQueries(): QueryFailure?
    if this.childMaximum < 1 || this.childMaximum > 10000
      return QueryFailure.Provider("navigation child limit must be between 1 and 10000")
    end
    let leftFailure = this.principals.queryFailure()

    if leftFailure != null
      return leftFailure
    end
    let rightFailure = this.dependents.queryFailure()

    if rightFailure != null
      return rightFailure
    end
    if !this.dependents.isUnfilteredRoot()
      return QueryFailure.UnsupportedCapability("navigation loading requires an unfiltered dependent query root")
    end
    let selected = this.selectedChildren

    if selected != null
      let selectedFailure = selected.queryFailure()

      if selectedFailure != null
        return selectedFailure
      end
      let offset = selected.rowOffset()
      let limit = selected.rowLimit()

      if offset < 0 || offset > 2147483647
        return QueryFailure.Provider("invalid query offset")
      end
      if limit != null
        if limit < 1 || limit > queryRowLimit()
          return QueryFailure.InvalidLimit(limit, queryRowLimit())
        end
        if offset > 9223372036854775807 - limit
          return QueryFailure.Provider("query offset exceeds supported range")
        end
      end
      if selected.prior() != null || selected.isDistinct()
        return QueryFailure.UnsupportedCapability("navigation children require one filter/order/page stage")
      end
      let selectedTracker = selected.rowTracker()
      let rootTracker = this.dependents.rowTracker()
      let selectedMapping = selected.entityMapping()
      let rootMapping = this.dependents.entityMapping()
      let selectedProvider = selected.provider()
      let rootProvider = this.dependents.provider()
      let selectedOwner = selected.changeOwner()
      let rootOwner = this.dependents.changeOwner()

      if selectedTracker == null || rootTracker == null || selectedMapping == null || rootMapping == null || selectedProvider == null || rootProvider == null || selectedOwner == null || rootOwner == null
        return QueryFailure.Provider("navigation children require mapped tracked query roots")
      end
      if selected.sourceName() != this.dependents.sourceName() || !reference::same(selectedTracker, rootTracker) || !reference::same(selectedMapping, rootMapping) || !reference::same(selectedProvider, rootProvider) || !reference::same(selectedOwner, rootOwner) || !reference::same(selected.rowDecoder(), this.dependents.rowDecoder())
        return QueryFailure.Provider("navigation children must use the same mapped dependent query root")
      end
    end
    let leftProvider = this.principals.provider()
    let rightProvider = this.dependents.provider()
    let leftOwner = this.principals.changeOwner()
    let rightOwner = this.dependents.changeOwner()

    if leftProvider == null || rightProvider == null || !reference::same(leftProvider, rightProvider)
      return QueryFailure.Provider("navigation queries require the same provider")
    end
    if leftOwner == null || rightOwner == null || !reference::same(leftOwner, rightOwner)
      return QueryFailure.Provider("navigation queries require the same change context")
    end
    if !leftOwner.matchesProvider(leftProvider)
      return QueryFailure.Provider("navigation context and query provider differ")
    end
    if this.dependents.rowTracker() == null || this.principals.rowTracker() == null
      return QueryFailure.UnsupportedCapability("navigation loading requires tracked query roots")
    end
    let principalMapping = this.principals.entityMapping()
    let dependentMapping = this.dependents.entityMapping()

    if principalMapping == null || dependentMapping == null
      return QueryFailure.UnsupportedCapability("navigation loading requires mapped entities")
    end
    let principalKey = principalMapping.keyColumn()
    let dependentKey = dependentMapping.keyColumn()

    if principalKey == null || dependentKey == null
      return QueryFailure.UnsupportedCapability("navigation loading requires mapped primary keys")
    end
    let principalType = navigationColumnType(principalMapping, principalKey)
    let dependentType = navigationColumnType(dependentMapping, dependentKey)
    let foreignType = navigationColumnType(dependentMapping, this.relation.column())

    if (principalType != "Int" && principalType != "String") || (dependentType != "Int" && dependentType != "String") || (foreignType != "Int" && foreignType != "String" && foreignType != "Int?" && foreignType != "String?") || principalType != navigationUnderlyingType(foreignType)
      return QueryFailure.UnsupportedCapability("navigation keys and foreign key require matching Int or String mappings")
    end
    if selected != null
      if !leftProvider.supports(ProviderCapability.StreamingReads())
        return QueryFailure.UnsupportedCapability("streaming-reads")
      end
      if (selected.rowOffset() > 0 || selected.rowLimit() != null) && !leftProvider.supports(ProviderCapability.WindowFunctions())
        return QueryFailure.UnsupportedCapability("window-functions")
      end
      let sample = new TypedRows<Cell>()

      if principalType == "Int"
        sample.add(Cell.Int(0))
      else
        sample.add(Cell.Text(""))
      end
      match this.compileSelectedChildren(selected, sample, 1, leftProvider.dialect())
        case CompileResult.Failure(error)
          return error
        case CompileResult.Plan(plan)
          if plan.sql().requiresCheckedScalars() && !leftProvider.supports(ProviderCapability.CheckedScalarExpressions())
            return QueryFailure.UnsupportedCapability("checked-scalar-expressions")
          end
      end
    end
    return null
  end

  private def compileBaseChildren(query: Query<D>, keys: TypedRows<Cell>, dialect: SqlDialect): CompileResult<D>
    let mapping = this.dependents.entityMapping()

    if mapping == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require entity mapping"))
    end
    let dependentKey = mapping.keyColumn()

    if dependentKey == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require a mapped primary key"))
    end
    let predicate = query.filterExpression()
    var source = new Query<D>(query.sourceName(), query.rowDecoder(), mapping: mapping, provider: query.provider(), tracker: query.rowTracker(), changes: query.changeOwner())

    if predicate != null
      source = new Query<D>(query.sourceName(), query.rowDecoder(), new Predicate<D>(predicate), mapping: mapping, provider: query.provider(), tracker: query.rowTracker(), changes: query.changeOwner())
    end
    let matched = source.matchingCells(this.relation.column(), keys)

    return compilePipeline<D, D>(matched, matched.rowDecoder(), null, null, dialect, ordered: false, unbounded: true)
  end

  private def compileSelectedChildren(query: Query<D>, keys: TypedRows<Cell>, maximum: Int, dialect: SqlDialect): CompileResult<D>
    if query.rowOffset() == 0 && query.rowLimit() == null
      return this.compileUnpagedChildren(query, keys, maximum, dialect)
    end
    return this.compileWindowedChildren(query, keys, maximum, dialect)
  end

  private def compileUnpagedChildren(query: Query<D>, keys: TypedRows<Cell>, maximum: Int, dialect: SqlDialect): CompileResult<D>
    let mapping = this.dependents.entityMapping()

    if mapping == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require entity mapping"))
    end
    let dependentKey = mapping.keyColumn()

    if dependentKey == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require a mapped primary key"))
    end
    match this.compileBaseChildren(query, keys, dialect)
      case CompileResult.Failure(error)
        return CompileResult<D>.Failure(error)
      case CompileResult.Plan(basePlan)
        let state = new CompileState()

        joinParameterCopy(basePlan.sql().parameters(), state)
        match navigationWindowOrder<D>(query, mapping, dependentKey, state, dialect)
          case NavigationOrderResult.Failure(error)
            return CompileResult<D>.Failure(error)
          case NavigationOrderResult.Sql(orderSql)
            let columns = basePlan.sql().columns()
            var projection = ""
            var index = 0

            while index < columns.count()
              projection = projection + (index == 0 ? "" : ", ") + quoted(mapping.table(), columns.at(index).name())
              index = index + 1
            end
            let sql = "SELECT " + projection + " FROM (" + basePlan.sql().sql() + ") AS \"" + mapping.table() + "\" ORDER BY " + quoted(mapping.table(), this.relation.column()) + ", " + orderSql + " LIMIT " + (maximum as String)
            let params = new ParameterValues(state.head, state.count)
            let checked = basePlan.sql().requiresCheckedScalars() || state.requiresCheckedScalars

            return CompileResult<D>.Plan(new TypedPlan<D>(new SqlPlan(sql, params, maximum, columns, checked), query.rowDecoder()))
        end
    end
  end

  private def compileWindowedChildren(query: Query<D>, keys: TypedRows<Cell>, maximum: Int, dialect: SqlDialect): CompileResult<D>
    let mapping = this.dependents.entityMapping()

    if mapping == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require entity mapping"))
    end
    let dependentKey = mapping.keyColumn()

    if dependentKey == null
      return CompileResult<D>.Failure(QueryFailure.UnsupportedCapability("navigation children require a mapped primary key"))
    end
    match this.compileBaseChildren(query, keys, dialect)
      case CompileResult.Failure(error)
        return CompileResult<D>.Failure(error)
      case CompileResult.Plan(basePlan)
        let orderState = new CompileState()

        match navigationWindowOrder<D>(query, mapping, dependentKey, orderState, dialect)
          case NavigationOrderResult.Failure(error)
            return CompileResult<D>.Failure(error)
          case NavigationOrderResult.Sql(orderSql)
            let shiftedBase = joinShiftSql(basePlan.sql().sql(), orderState.count, dialect)

            if shiftedBase == null
              return CompileResult<D>.Failure(QueryFailure.Provider("navigation parameter position overflow"))
            end
            joinParameterCopy(basePlan.sql().parameters(), orderState)
            let columns = basePlan.sql().columns()
            var rankName = "__neri_navigation_rank"
            var rankSuffix = 0

            while navigationColumnCollision(mapping, rankName)
              rankSuffix = rankSuffix + 1
              rankName = "__neri_navigation_rank_" + (rankSuffix as String)
            end
            var innerColumns = ""
            var outerColumns = ""
            var index = 0

            while index < columns.count()
              let name = columns.at(index).name()

              innerColumns = innerColumns + (index == 0 ? "" : ", ") + quoted(mapping.table(), name)
              outerColumns = outerColumns + (index == 0 ? "" : ", ") + quoted("__neri_navigation", name)
              index = index + 1
            end
            let rank = quoted("__neri_navigation", rankName)
            var sql = "SELECT " + outerColumns + " FROM (SELECT " + innerColumns + ", ROW_NUMBER() OVER (PARTITION BY " + quoted(mapping.table(), this.relation.column()) + " ORDER BY " + orderSql + ") AS \"" + rankName + "\" FROM (" + shiftedBase + ") AS \"" + mapping.table() + "\") AS \"__neri_navigation\" WHERE " + rank + " > " + (query.rowOffset() as String)
            let take = query.rowLimit()

            if take != null
              sql = sql + " AND " + rank + " <= " + ((query.rowOffset() + take) as String)
            end
            sql = sql + " ORDER BY " + quoted("__neri_navigation", this.relation.column()) + ", " + rank + " LIMIT " + (maximum as String)
            let params = new ParameterValues(orderState.head, orderState.count)
            let checked = basePlan.sql().requiresCheckedScalars() || orderState.requiresCheckedScalars
            let plan = new SqlPlan(sql, params, maximum, columns, checked)

            return CompileResult<D>.Plan(new TypedPlan<D>(plan, query.rowDecoder()))
        end
    end
  end

  public def load(rows: TypedRows<P>): QueryResult<P>
    let invalid = this.validateQueries()

    if invalid != null
      return QueryResult<P>.Failure(invalid)
    end
    if this.childMaximum < 1 || this.childMaximum > 10000
      return QueryResult<P>.Failure(QueryFailure.Provider("navigation child limit must be between 1 and 10000"))
    end
    let childTracker = this.dependents.rowTracker()
    let parentTracker = this.principals.rowTracker()
    let principalMapping = this.principals.entityMapping()
    let dependentMapping = this.dependents.entityMapping()

    if childTracker == null || parentTracker == null || principalMapping == null || dependentMapping == null
      return QueryResult<P>.Failure(QueryFailure.UnsupportedCapability("navigation loading requires tracked query roots"))
    end
    let principalKeyColumn = principalMapping.keyColumn()
    let dependentKeyColumn = dependentMapping.keyColumn()

    if principalKeyColumn == null || dependentKeyColumn == null
      return QueryResult<P>.Failure(QueryFailure.UnsupportedCapability("navigation loading requires mapped primary keys"))
    end
    var first: NavigationBucket<P, D>? = null
    var last: NavigationBucket<P, D>? = null
    var parent = rows.first()

    while parent != null
      let key = this.relation.principalKey(parent.value)

      if !navigationKeyValid(key)
        return QueryResult<P>.Failure(QueryFailure.Provider("navigation principal key must be Int or String"))
      end
      if !parentTracker.ownsPersistedForNavigation(parent.value)
        return QueryResult<P>.Failure(QueryFailure.Provider("navigation principal is not the live persisted tracked instance"))
      end
      let originalParent = parentTracker.original(parent.value)

      if originalParent == null || !navigationRowMatches(originalParent, principalKeyColumn, key)
        return QueryResult<P>.Failure(QueryFailure.Provider("navigation principal key callback differs from mapped key"))
      end
      var other = first
      var duplicate = false

      while other != null
        if navigationCellEqual(other.key, key)
          if !reference::same(other.principal, parent.value)
            return QueryResult<P>.Failure(QueryFailure.Provider("navigation principal key is duplicated"))
          end
          duplicate = true
        end
        other = other.next
      end
      if !duplicate
        let bucket = new NavigationBucket<P, D>(parent.value, key)

        if last == null
          first = bucket
        else
          last.next = bucket
        end
        last = bucket
      end
      parent = parent.next
    end
    let staged = new NavigationStage<D>(this.childMaximum)
    var batch: NavigationBucket<P, D>? = first

    while batch != null
      let keys = new TypedRows<Cell>()
      var taken = 0
      var cursor: NavigationBucket<P, D>? = batch

      while cursor != null && taken < 50
        keys.add(cursor.key)
        cursor = cursor.next
        taken = taken + 1
      end
      batch = cursor
      let selected = this.selectedChildren

      if selected == null
        let childQuery = this.dependents.matchingCells(this.relation.column(), keys)
        let visit: fn(D): Bool = fn(value: D): Bool
          return staged.accept(value)
        end

        match childQuery.stream(visit)
          case StreamResult.Completed(count)
            continue
          case StreamResult.Stopped(count)
            return QueryResult<P>.Failure(QueryFailure.Provider("navigation child limit exceeded"))
          case StreamResult.Cancelled(count)
            return QueryResult<P>.Failure(QueryFailure.Provider("navigation child load cancelled"))
          case StreamResult.Failure(error, count)
            return QueryResult<P>.Failure(error)
        end
      else
        let provider = selected.provider()

        if provider == null
          return QueryResult<P>.Failure(QueryFailure.Provider("navigation children require a provider"))
        end
        match this.compileSelectedChildren(selected, keys, this.childMaximum - staged.rows.count() + 1, provider.dialect())
          case CompileResult.Failure(error)
            return QueryResult<P>.Failure(error)
          case CompileResult.Plan(plan)
            let compile: fn(SqlDialect): CompileResult<D> = fn(actual: SqlDialect): CompileResult<D>
              return CompileResult<D>.Plan(plan)
            end
            let visit: fn(D): Bool = fn(value: D): Bool
              return staged.accept(value)
            end

            match streamCompiled<D>(provider, compile, visit, null, null)
              case StreamResult.Completed(count)
              case StreamResult.Stopped(count)
                return QueryResult<P>.Failure(QueryFailure.Provider("navigation child limit exceeded"))
              case StreamResult.Cancelled(count)
                return QueryResult<P>.Failure(QueryFailure.Provider("navigation child load cancelled"))
              case StreamResult.Failure(error, count)
                return QueryResult<P>.Failure(error)
            end
        end
      end
    end
    var stagedChild = staged.rows.first()
    var seen = new TypedRows<Cell>()

    while stagedChild != null
      let childKey = this.relation.dependentKey(stagedChild.value)
      let foreignKey = this.relation.foreignKey(stagedChild.value)

      if !navigationKeyValid(childKey) || !navigationKeyValid(foreignKey)
        return QueryResult<P>.Failure(QueryFailure.Provider("navigation child key and foreign key must be Int or String"))
      end
      var priorKey = seen.first()

      while priorKey != null
        if navigationCellEqual(priorKey.value, childKey)
          return QueryResult<P>.Failure(QueryFailure.Provider("navigation child key is duplicated"))
        end
        priorKey = priorKey.next
      end
      seen.add(childKey)
      var owner = first
      var matched = false

      while owner != null
        if navigationCellEqual(owner.key, foreignKey)
          matched = true
          break
        end
        owner = owner.next
      end
      if !matched
        return QueryResult<P>.Failure(QueryFailure.Provider("navigation child has an unexpected foreign key"))
      end
      stagedChild = stagedChild.next
    end
    match childTracker.resolveRows(staged.rows)
      case QueryResult.Failure(error)
        return QueryResult<P>.Failure(error)
      case QueryResult.Rows(resolved)
        var child = resolved.first()
        var raw = staged.rows.first()

        while child != null && raw != null
          if !childTracker.ownsPersistedForNavigation(child.value) || !navigationCellEqual(this.relation.dependentKey(child.value), this.relation.dependentKey(raw.value)) || !navigationCellEqual(this.relation.foreignKey(child.value), this.relation.foreignKey(raw.value))
            return QueryResult<P>.Failure(QueryFailure.Provider("tracked navigation key or foreign key differs from database row"))
          end
          let currentChild = childTracker.current(child.value)
          let originalChild = childTracker.original(child.value)

          if currentChild == null || originalChild == null || !navigationRowMatches(currentChild, dependentKeyColumn, this.relation.dependentKey(child.value)) || !navigationRowMatches(currentChild, this.relation.column(), this.relation.foreignKey(child.value)) || !navigationRowMatchesOptional(originalChild, this.relation.column(), this.relation.foreignKey(child.value))
            return QueryResult<P>.Failure(QueryFailure.Provider("navigation callbacks differ from mapped child fields"))
          end
          var owner = first

          while owner != null
            if navigationCellEqual(owner.key, this.relation.foreignKey(child.value))
              let inverse = this.relation.reference(child.value)

              if inverse != null && !reference::same(inverse, owner.principal)
                return QueryResult<P>.Failure(QueryFailure.Provider("tracked navigation reference conflicts with foreign key"))
              end
              owner.children.add(child.value)
              break
            end
            owner = owner.next
          end
          child = child.next
          raw = raw.next
        end
    end
    var bucket = first

    while bucket != null
      let audit = new NavigationInverseAudit<P, D>(this.relation, bucket.principal)
      let acceptTracked: fn(D): Bool = fn(child: D): Bool
        return audit.accepts(child)
      end

      if !childTracker.visitTracked(acceptTracked)
        return QueryResult<P>.Failure(QueryFailure.Provider("tracked navigation inverse is absent from principal collection"))
      end
      for oldChild in this.relation.collection(bucket.principal)
        let oldReference = this.relation.reference(oldChild)
        let originalChild = childTracker.original(oldChild)

        if oldReference == null || !reference::same(oldReference, bucket.principal)
          return QueryResult<P>.Failure(QueryFailure.Provider("tracked navigation collection and inverse reference disagree"))
        end
        if !childTracker.ownsPersistedForNavigation(oldChild) || !navigationCellEqual(this.relation.foreignKey(oldChild), bucket.key) || originalChild == null || !navigationRowMatchesOptional(originalChild, this.relation.column(), bucket.key)
          return QueryResult<P>.Failure(QueryFailure.Provider("tracked navigation collection conflicts with pending local relationship changes"))
        end
      end
      bucket = bucket.next
    end
    bucket = first

    while bucket != null
      for oldChild in this.relation.collection(bucket.principal)
        let oldReference = this.relation.reference(oldChild)

        if oldReference != null && reference::same(oldReference, bucket.principal)
          this.relation.setReference(oldChild, null)
        end
      end
      let children = bucket.children
      var exact: D[] = []
      let firstChild = children.first()

      if firstChild != null
        let cursor = new NavigationArrayCursor<D>(firstChild)

        exact = arrays::generate<D>(children.count()) do |index|
          return cursor.next()
        end
      end
      this.relation.setCollection(bucket.principal, exact)
      for child in exact
        this.relation.setReference(child, bucket.principal)
      end
      bucket = bucket.next
    end
    return QueryResult<P>.Rows(rows)
  end
end

def include<P, D>(principals: Query<P>, dependents: Query<D>, relation: CollectionNavigation<P, D>): IncludedQuery<P, D>
  return new IncludedQuery<P, D>(principals, dependents, relation)
end
