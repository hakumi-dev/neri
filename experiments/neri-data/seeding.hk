use host
use text
namespace neri_data

def schemaSeedOperation(op: readonly SchemaOp): Bool
  match op
    case SchemaOp.InsertData(table, columns, values)
      return true
    case SchemaOp.UpdateData(table, keys, keyValues, columns, values)
      return true
    case SchemaOp.DeleteData(table, keys, keyValues)
      return true
    case SchemaOp.CreateTable(table, columns)
    case SchemaOp.DropTable(table)
    case SchemaOp.AddColumn(table, column)
    case SchemaOp.DropColumn(table, column)
    case SchemaOp.RenameTable(from, to)
    case SchemaOp.RenameColumn(table, from, to)
    case SchemaOp.CreateIndex(name, table, columns, unique)
    case SchemaOp.DropIndex(name)
    case SchemaOp.RebuildTable(before, after)
      return false
  end
  return false
end

def schemaSeedHex(value: readonly Byte[]): String
  let digits = "0123456789abcdef"
  var output = ""

  for item in value
    let number = item as Int

    output = output + host::stringSlice(
      digits,
      number / 16,
      1
    ) + host::stringSlice(
      digits,
      number - (number / 16) * 16,
      1
    )
  end
  return output
end

def schemaSeedCellCode(value: readonly Cell): String
  match value
    case Cell.Null()
      return "N"
    case Cell.Bool(item)
      return item ? "B1" : "B0"
    case Cell.Int(item)
      return "I" + schemaPiece(item as String)
    case Cell.Float(item)
      return "F" + schemaPiece(item as String)
    case Cell.Text(item)
      return "T" + schemaPiece(item)
    case Cell.Binary(item)
      return "Y" + schemaPiece(schemaSeedHex(item.snapshot()))
  end
end

def schemaSeedTupleCode(columns: readonly String[], values: readonly Cell[]): String
  var output = schemaPiece(columns.Length as String)
  var index = 0

  while index < columns.Length && index < values.Length
    output = output + schemaPiece(columns[index]) + schemaPiece(schemaSeedCellCode(values[index]))
    index = index + 1
  end
  return output
end

def schemaSeedValuesCopy(values: readonly Cell[]): Cell[]
  return arrays::generate<Cell>(values.Length) do |index|
    let value = values[index]

    match value
      case Cell.Null()
        return Cell.Null()
      case Cell.Bool(item)
        return Cell.Bool(item)
      case Cell.Int(item)
        return Cell.Int(item)
      case Cell.Float(item)
        return Cell.Float(item)
      case Cell.Text(item)
        return Cell.Text(item)
      case Cell.Binary(item)
        return Cell.Binary(copyBinary(item))
    end
  end
end

def schemaSeedColumnsCopy(columns: readonly String[]): String[]
  return arrays::generate<String>(columns.Length) do |index|
    return columns[index]
  end
end

def schemaSeedTupleValid(columns: readonly String[], values: readonly Cell[], keys: Bool): String?
  if columns.Length == 0 || columns.Length != values.Length || columns.Length > 1000
    return "seed columns and values must be matching nonempty tuples of at most 1000 entries"
  end
  var index = 0

  while index < columns.Length
    if !identifierValid(columns[index])
      return "invalid seed column identifier"
    end
    var prior = 0

    while prior < index
      if schemaSameIdentifier(columns[prior], columns[index])
        return "duplicate seed column"
      end
      prior = prior + 1
    end
    match values[index]
      case Cell.Null()
        if keys
          return "seed keys cannot be null"
        end
      case Cell.Float(item)
        if !dataFloatFinite(item)
          return "seed floating values must be finite"
        end
      case Cell.Bool(item)
      case Cell.Int(item)
      case Cell.Text(item)
      case Cell.Binary(item)
    end
    index = index + 1
  end
  return null
end

def schemaSeedValidation(op: readonly SchemaOp): String?
  var table = ""
  var keys: String[] = []
  var keyValues: Cell[] = []
  var columns: String[] = []
  var values: Cell[] = []
  var insert = false
  var remove = false

  match op
    case SchemaOp.InsertData(target, fields, cells)
      table = target
      columns = schemaSeedColumnsCopy(fields)
      values = schemaSeedValuesCopy(cells)
      insert = true
    case SchemaOp.UpdateData(target, keyFields, keyCells, fields, cells)
      table = target
      keys = schemaSeedColumnsCopy(keyFields)
      keyValues = schemaSeedValuesCopy(keyCells)
      columns = schemaSeedColumnsCopy(fields)
      values = schemaSeedValuesCopy(cells)
    case SchemaOp.DeleteData(target, keyFields, keyCells)
      table = target
      keys = schemaSeedColumnsCopy(keyFields)
      keyValues = schemaSeedValuesCopy(keyCells)
      remove = true
    case SchemaOp.CreateTable(target, fields)
    case SchemaOp.DropTable(target)
    case SchemaOp.AddColumn(target, column)
    case SchemaOp.DropColumn(target, column)
    case SchemaOp.RenameTable(from, to)
    case SchemaOp.RenameColumn(target, from, to)
    case SchemaOp.CreateIndex(name, target, fields, unique)
    case SchemaOp.DropIndex(name)
    case SchemaOp.RebuildTable(before, after)
      return "operation is not a seed write"
  end
  if !schemaTableValid(table)
    return "invalid or reserved seed table"
  end
  if !insert
    let invalid = schemaSeedTupleValid(keys, keyValues, true)

    if invalid != null
      return invalid
    end
  end
  if !remove
    return schemaSeedTupleValid(columns, values, false)
  end
  return null
end

def schemaSeedLiteral(value: readonly Cell, dialect: SqlDialect): String
  match value
    case Cell.Null()
      return "NULL"
    case Cell.Bool(item)
      return item ? "TRUE" : "FALSE"
    case Cell.Int(item)
      return item as String
    case Cell.Float(item)
      var type = "REAL"

      match dialect
        case SqlDialect.PostgreSql()
          type = "double precision"
        case SqlDialect.QuestionMark()
      end
      return "CAST(" + schemaTextLiteral(item as String) + " AS " + type + ")"
    case Cell.Text(item)
      match dialect
        case SqlDialect.QuestionMark()
          return "CAST(X'" + schemaSeedHex(text::bytes(item)) + "' AS TEXT)"
        case SqlDialect.PostgreSql()
          return "convert_from(decode('" + schemaSeedHex(text::bytes(item)) + "','hex'),'UTF8')"
      end
    case Cell.Binary(item)
      let hex = schemaSeedHex(item.snapshot())

      match dialect
        case SqlDialect.QuestionMark()
          return "X'" + hex + "'"
        case SqlDialect.PostgreSql()
          return "decode('" + hex + "','hex')"
      end
  end
end

def schemaSeedBind(value: readonly Cell, dialect: SqlDialect, parameters: WriteValues, literals: Bool): String
  if literals
    return schemaSeedLiteral(value, dialect)
  end
  match value
    case Cell.Null()
      parameters.add(Cell.Null())
    case Cell.Bool(item)
      parameters.add(Cell.Bool(item))
    case Cell.Int(item)
      parameters.add(Cell.Int(item))
    case Cell.Float(item)
      parameters.add(Cell.Float(item))
    case Cell.Text(item)
      parameters.add(Cell.Text(item))
    case Cell.Binary(item)
      parameters.add(Cell.Binary(copyBinary(item)))
  end
  match dialect
    case SqlDialect.QuestionMark()
      return "?"
    case SqlDialect.PostgreSql()
      return "$" + (parameters.count() as String)
  end
end

def schemaSeedPostgresValuesValid(values: readonly Cell[]): Bool
  for value in values
    match value
      case Cell.Text(item)
        var index = 0

        while index < host::stringByteLength(item)
          if host::stringByteAt(item, index) == (0 as Byte)
            return false
          end
          index = index + 1
        end
      case Cell.Null()
      case Cell.Bool(item)
      case Cell.Int(item)
      case Cell.Float(item)
      case Cell.Binary(item)
    end
  end
  return true
end

def compileSeed(op: readonly SchemaOp, dialect: SqlDialect, literals: Bool = false): SetPlanResult
  let invalid = schemaSeedValidation(op)

  if invalid != null
    return SetPlanResult.Failure(WriteFailure.Validation(invalid))
  end
  match dialect
    case SqlDialect.PostgreSql()
      if !schemaPostgresOpNamesValid(op)
        return SetPlanResult.Failure(WriteFailure.Validation("PostgreSQL seed identifiers must fit 63 UTF-8 bytes"))
      end
    case SqlDialect.QuestionMark()
  end
  var table = ""
  var keys: String[] = []
  var keyValues: Cell[] = []
  var columns: String[] = []
  var values: Cell[] = []
  var kind = 0

  match op
    case SchemaOp.InsertData(target, fields, cells)
      table = target
      columns = schemaSeedColumnsCopy(fields)
      values = schemaSeedValuesCopy(cells)
    case SchemaOp.UpdateData(target, keyFields, keyCells, fields, cells)
      table = target
      keys = schemaSeedColumnsCopy(keyFields)
      keyValues = schemaSeedValuesCopy(keyCells)
      columns = schemaSeedColumnsCopy(fields)
      values = schemaSeedValuesCopy(cells)
      kind = 1
    case SchemaOp.DeleteData(target, keyFields, keyCells)
      table = target
      keys = schemaSeedColumnsCopy(keyFields)
      keyValues = schemaSeedValuesCopy(keyCells)
      kind = 2
    case SchemaOp.CreateTable(target, fields)
    case SchemaOp.DropTable(target)
    case SchemaOp.AddColumn(target, column)
    case SchemaOp.DropColumn(target, column)
    case SchemaOp.RenameTable(from, to)
    case SchemaOp.RenameColumn(target, from, to)
    case SchemaOp.CreateIndex(name, target, fields, unique)
    case SchemaOp.DropIndex(name)
    case SchemaOp.RebuildTable(before, after)
      return SetPlanResult.Failure(WriteFailure.Validation("operation is not a seed write"))
  end
  match dialect
    case SqlDialect.PostgreSql()
      if !schemaSeedPostgresValuesValid(values) || !schemaSeedPostgresValuesValid(keyValues)
        return SetPlanResult.Failure(WriteFailure.Validation("PostgreSQL seed text cannot contain NUL"))
      end
    case SqlDialect.QuestionMark()
  end
  let parameters = new WriteValues()
  var names = ""
  var bound = ""
  var index = 0

  while index < columns.Length
    names = names + (index == 0 ? "" : ", ") + schemaQuote(columns[index])
    let value = schemaSeedBind(values[index], dialect, parameters, literals)

    bound = bound + (index == 0 ? "" : ", ") + (kind == 1 ? schemaQuote(columns[index]) + " = " : "") + value
    index = index + 1
  end
  var sql = "INSERT INTO " + schemaQuote(table) + " (" + names + ") VALUES (" + bound + ")"

  if kind != 0
    sql = (kind == 1 ? "UPDATE " + schemaQuote(table) + " SET " + bound : "DELETE FROM " + schemaQuote(table)) + " WHERE "
    index = 0
    while index < keys.Length
      sql = sql + (index == 0 ? "" : " AND ") + schemaQuote(keys[index]) + " = " + schemaSeedBind(
        keyValues[index],
        dialect,
        parameters,
        literals
      )
      index = index + 1
    end
  end
  return SetPlanResult.Plan(new SetWritePlan(sql, parameters))
end
