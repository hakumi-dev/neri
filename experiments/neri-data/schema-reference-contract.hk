use test
use neri_data

def relationalModel(required: Bool = false): SchemaModel
  let parent = new SchemaTable("principal", "principals", [
    new SchemaField("a", new SchemaColumn("tenant", SchemaType.Int(), primaryKey: true)),
    new SchemaField("b", new SchemaColumn("code", SchemaType.Text(), primaryKey: true))
  ])
  let child = new SchemaTable("dependent", "dependents", [
    new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true)),
    new SchemaField("tenant", new SchemaColumn("tenant", SchemaType.Int(), nullable: !required, reference: new SchemaReference("principals", ["tenant", "code"], ["tenant", "code"], "SET NULL"))),
    new SchemaField("code", new SchemaColumn("code", SchemaType.Text(), nullable: !required))
  ])

  return new SchemaModel([parent, child])
end

def main(): Void
  let valid = relationalModel()
  let invalid = relationalModel(true)

  test::assertTrue(valid.validate() == null)
  test::assertTrue(invalid.validate() != null)

  match diffSchema("initial", new SchemaModel([]), valid)
    case SchemaDiffResult.Failure(error)
      test::assertTrue(false)
    case SchemaDiffResult.Unchanged()
      test::assertTrue(false)
    case SchemaDiffResult.Plan(plan)
      let migration = plan.migration()

      test::assertTrue((new MigrationSet([migration])).validate() == null)

      match compilePostgresMigration(migration, true)
        case SchemaCompileResult.Failure(message)
          test::assertTrue(false)
        case SchemaCompileResult.Statement(sql)
          test::assertTrue(sql != "")
      end
      match compilePostgresMigration(migration, false)
        case SchemaCompileResult.Failure(message)
          test::assertTrue(false)
        case SchemaCompileResult.Statement(sql)
          test::assertEqual(sql, "DROP TABLE \"dependents\", \"principals\";\n")
      end
  end
end
