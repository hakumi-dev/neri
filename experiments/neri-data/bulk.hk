use host
use quotation
namespace neri_data

## SQL and bound values produced only by the typed bulk compiler.
class SetWritePlan
  private statement: String
  private bound: WriteValues
  private checkedScalars: Bool

  def init(sql: String, parameters: WriteValues, requiresCheckedScalars: Bool = false): Void
    this.statement = sql
    this.bound = parameters
    this.checkedScalars = requiresCheckedScalars
  end

  public readonly def sql(): String
    return this.statement
  end

  public readonly def parameters(): readonly WriteValues
    return this.bound
  end

  public readonly def requiresCheckedScalars(): Bool
    return this.checkedScalars
  end
end

class UpdateAssignment
  private targetTree: readonly quotation::Tree
  private valueTree: readonly quotation::Tree
  private resultType: String
  private previousEntry: UpdateAssignment?
  private builder: (fn(EntityMapping, CompileState, SqlDialect): ScalarSqlResult)?
  private exactStorage: Bool

  def init(
    target: readonly quotation::Tree,
    value: readonly quotation::Tree,
    typeName: String,
    previous: UpdateAssignment?,
    builder: (fn(EntityMapping, CompileState, SqlDialect): ScalarSqlResult)? = null,
    exactStorage: Bool = false
  ): Void
    this.targetTree = target
    this.valueTree = value
    this.resultType = typeName
    this.previousEntry = previous
    this.builder = builder
    this.exactStorage = exactStorage
  end

  internal readonly def target(): readonly quotation::Tree
    return this.targetTree
  end

  internal readonly def value(): readonly quotation::Tree
    return this.valueTree
  end

  internal readonly def typeName(): String
    return this.resultType
  end

  internal def previous(): UpdateAssignment?
    return this.previousEntry
  end

  internal readonly def usesExactStorage(): Bool
    return this.exactStorage
  end

  internal def compileValue(mapping: EntityMapping, state: CompileState, dialect: SqlDialect): ScalarSqlResult
    let builder = this.builder

    if builder != null
      return builder(mapping, state, dialect)
    end
    return compileScalarQuotation(mapping, this.valueTree, this.resultType, state, dialect)
  end
end

## Persistent, typed assignments for one set-based update.
class UpdateSet<T>
  private latest: UpdateAssignment?
  private size: Int

  def init(last: UpdateAssignment? = null, count: Int = 0): Void
    this.latest = last
    this.size = count
  end

  public readonly def count(): Int
    return this.size
  end

  internal def entryAt(index: Int): UpdateAssignment?
    if index < 0 || index >= this.size
      return null
    end
    var current = this.latest
    var steps = this.size - index - 1

    while steps > 0 && current != null
      current = current.previous()
      steps = steps - 1
    end
    return current
  end

  public def set<V>(target: quote fn(T): V, value: quote fn(T): V): UpdateSet<T>
    let entry = new UpdateAssignment(target.tree(), value.tree(), target.tree().resultType(), this.latest)

    return new UpdateSet<T>(entry, this.size + 1)
  end

  public def setString(target: quote fn(T): String, value: StringExpression<T>): UpdateSet<T>
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      return value.buildSql(mapping, state, dialect)
    end

    return this.withBuilder(target.tree(), build)
  end

  public def setOptionalString(target: quote fn(T): String?, value: OptionalStringExpression<T>): UpdateSet<T>
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      return value.expression().buildSql(mapping, state, dialect)
    end

    return this.withBuilder(target.tree(), build)
  end

  public def setNumeric<V>(target: quote fn(T): V, value: NumericExpression<T, V>): UpdateSet<T>
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      return value.builder(mapping, state, dialect)
    end

    return this.withBuilder(target.tree(), build)
  end

  public def setOptionalNumeric<V>(target: quote fn(T): V?, value: OptionalNumericExpression<T, V>): UpdateSet<T>
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      return value.buildSql(mapping, state, dialect)
    end

    return this.withBuilder(target.tree(), build)
  end

  public def setConverted<V>(target: quote fn(T): V, value: V, encode: fn(V): Cell, conversionId: String): UpdateSet<T>
    let captured = shadowCellCopy(encode(value))
    let tree = target.tree()
    let build: fn(
      EntityMapping,
      CompileState,
      SqlDialect
    ): ScalarSqlResult = fn(
      mapping: EntityMapping,
      state: CompileState,
      dialect: SqlDialect
    ): ScalarSqlResult do
      match translateSelection(mapping, tree)
        case SelectionResult.Failure(error)
          return ScalarSqlResult.Failure(error)
        case SelectionResult.Column(column)
          if column.conversionId() != conversionId
            return scalarSqlFailure("converted assignment must use the mapped encoder identity")
          end
          return bulkCapturedStorage(column, captured, state, dialect)
      end
    end

    return this.withBuilder(tree, build, true)
  end

  private def withBuilder(
    target: readonly quotation::Tree,
    builder: fn(EntityMapping, CompileState, SqlDialect): ScalarSqlResult,
    exactStorage: Bool = false
  ): UpdateSet<T>
    let entry = new UpdateAssignment(target, target, target.resultType(), this.latest, builder, exactStorage)

    return new UpdateSet<T>(entry, this.size + 1)
  end
end

def updateSet<T>(): UpdateSet<T>
  return new UpdateSet<T>()
end

def bulkCapturedStorage(
  column: readonly MappingColumn,
  cell: Cell,
  state: CompileState,
  dialect: SqlDialect
): ScalarSqlResult
  let declared = semanticTranslationInner(column.storageTypeName())
  let decimal = declared == "neri_data.Decimal" || declared == "Decimal"
  let expected = decimal ? "String" : (declared == "buffers.ByteBuffer" ? "ByteBuffer" : declared)
  var parameter: Parameter? = null
  var actual = ""

  match cell
    case Cell.Null()
      if !translationOptional(column.storageTypeName())
        return scalarSqlFailure("converted NULL assignment requires nullable mapped storage")
      end
      return scalarSqlValue("NULL")
    case Cell.Bool(value)
      actual = "Bool"
      parameter = Parameter.Bool(value)
    case Cell.Int(value)
      actual = "Int"
      parameter = Parameter.Int(value)
    case Cell.Float(value)
      if !dataFloatFinite(value)
        return scalarSqlFailure("converted assignment Float must be finite")
      end
      actual = "Float"
      parameter = Parameter.Float(value)
    case Cell.Text(value)
      if decimal && decimalCanonical(value) != value
        return scalarSqlFailure("converted Decimal assignment requires canonical TEXT")
      end
      actual = "String"
      parameter = Parameter.Text(value)
    case Cell.Binary(value)
      actual = "ByteBuffer"
      parameter = Parameter.Binary(copyBinary(value))
  end
  if actual != expected || parameter == null
    return scalarSqlFailure("converted assignment encoder result must match storage type")
  end
  state.bind(parameter)
  return scalarSqlValue(dialectPlaceholder(dialect, state.count))
end

def bulkPhysicalFailure<T>(query: Query<T>, columns: String[]): String?
  let tracker = query.writeTracker()

  return tracker == null ? null : tracker.setWriteFailure(columns)
end

def bulkScalarDependencies(mapping: EntityMapping, target: String, sql: String): String[]
  let columns = new TypedRows<String>()

  columns.add(target)
  var index = 0

  while index < mapping.count()
    let column = mapping.columnAt(index)

    if column != null && column.column() != target && sql.contains(quoted(mapping.table(), column.column()))
      columns.add(column.column())
    end
    index = index + 1
  end
  return navigationArray(columns)
end

def compileSetMappedCell<T>(query: Query<T>, name: String, captured: Cell, dialect: SqlDialect): SetPlanResult
  let mapping = query.entityMapping()

  if mapping == null || mapping.readOnly()
    return SetPlanResult.Failure(WriteFailure.Unsupported("mapped storage update requires a writable entity mapping"))
  end
  let key = mapping.keyColumn()
  let column = mappedLogicalColumn(mapping, name)

  if key == null || column == null || mapping.isPrimaryKey(column.column())
    return SetPlanResult.Failure(WriteFailure.Validation("mapped storage update requires a declared non-key property"))
  end
  let physicalFailure = bulkPhysicalFailure(query, [column.column()])

  if physicalFailure != null
    return SetPlanResult.Failure(WriteFailure.Unsupported(physicalFailure))
  end
  match bulkKeySelection(query, mapping, key, dialect)
    case CompileResult.Failure(error)
      return SetPlanResult.Failure(bulkScalarFailure(error))
    case CompileResult.Plan(selection)
      let state = new CompileState()

      state.count = selection.parameterValues().count()
      match bulkCapturedStorage(column, shadowCellCopy(captured), state, dialect)
        case ScalarSqlResult.Failure(error)
          return SetPlanResult.Failure(bulkScalarFailure(error))
        case ScalarSqlResult.Value(value)
          let parameters = new WriteValues()

          bulkParameters(selection.parameterValues(), parameters)
          bulkParameters(new ParameterValues(state.head, state.count - selection.parameterValues().count()), parameters)
          let alias = bulkTargetAlias(mapping.table())
          let sql = "WITH \"" + alias + "\" AS MATERIALIZED (" + selection.sql().sql() + ") UPDATE \"" + mapping.table() + "\" SET \"" + column.column() + "\" = " + value.sql + " WHERE " + bulkKeyOperand(mapping) + " IN (SELECT " + bulkKeyNames(mapping) + " FROM \"" + alias + "\")"

          return SetPlanResult.Plan(new SetWritePlan(sql, parameters, selection.sql().requiresCheckedScalars()))
      end
  end
end

enum SetPlanResult
  case Plan(value: SetWritePlan)
  case Failure(error: WriteFailure)
end

def normalizeSetWrite(result: WriteResult): WriteResult
  match result
    case WriteResult.Saved(count)
      if count < 0
        return WriteResult.Failure(WriteFailure.Provider(ProviderFailure.State("set write returned a negative row count")))
      end
      return WriteResult.Saved(count)
    case WriteResult.Failure(error)
      return WriteResult.Failure(error)
    case WriteResult.SavedWithValues(count, outputs)
      return WriteResult.Failure(WriteFailure.Provider(ProviderFailure.State("set write returned row values")))
  end
end

def bulkParameters(source: readonly ParameterValues, target: WriteValues): Void
  var current = source.first()

  while current != null
    match current.value()
      case Parameter.Bool(value)
        target.add(Cell.Bool(value))
      case Parameter.Int(value)
        target.add(Cell.Int(value))
      case Parameter.Float(value)
        target.add(Cell.Float(value))
      case Parameter.Text(value)
        target.add(Cell.Text(value))
      case Parameter.Binary(value)
        target.add(Cell.Binary(copyBinary(value)))
    end
    current = current.next()
  end
end

def bulkKeySelection<T>(query: Query<T>, mapping: EntityMapping, key: String, dialect: SqlDialect): CompileResult<T>
  match compilePipeline<T, T>(
    query,
    query.rowDecoder(),
    mappedSelection(mapping),
    query.rowLimit(),
    dialect,
    inner: true
  )
    case CompileResult.Failure(error)
      return CompileResult<T>.Failure(error)
    case CompileResult.Plan(full)
      let source = query.sourceName()
      let sql = "SELECT " + navigationQuotedColumns(
        source,
        mapping.primaryKeys()
      ) + " FROM (" + full.sql().sql() + ") AS \"" + source + "\""
      let plan = new SqlPlan(
        sql,
        full.parameterValues(),
        full.sql().limit(),
        full.sql().columns(),
        full.sql().requiresCheckedScalars()
      )

      return CompileResult<T>.Plan(new TypedPlan<T>(plan, query.rowDecoder()))
  end
end

def bulkTargetAlias(table: String): String
  let first = "__neri_target_keys"

  if host::stringByteLength(table) != host::stringByteLength(first)
    return first
  end
  var same = true
  var index = 0

  while index < host::stringByteLength(first)
    var byte = host::stringByteAt(table, index) as Int

    if byte >= 65 && byte <= 90
      byte = byte + 32
    end
    if byte != host::stringByteAt(first, index) as Int
      same = false
    end
    index = index + 1
  end
  return same ? "__neri_target_keys_alt" : first
end

def compileSetDelete<T>(query: Query<T>, dialect: SqlDialect): SetPlanResult
  let mapping = query.entityMapping()

  if mapping == null
    return SetPlanResult.Failure(WriteFailure.Validation("bulk delete requires entity mapping"))
  end
  if mapping.readOnly()
    return SetPlanResult.Failure(WriteFailure.Unsupported("read-only entities cannot be modified"))
  end
  let tracker = query.writeTracker()

  if tracker != null && tracker.hasTableSegments()
    return SetPlanResult.Failure(WriteFailure.Unsupported("bulk delete requires one physical table; segmented inheritance uses tracked deletion"))
  end
  let names: String[] = tasks::generate(mapping.count(), 1) do |index|
    let column = mapping.columnAt(index)

    return column == null ? "" : column.column()
  end
  let physicalFailure = bulkPhysicalFailure(query, names)

  if physicalFailure != null
    return SetPlanResult.Failure(WriteFailure.Unsupported(physicalFailure))
  end
  let key = mapping.keyColumn()

  if key == null
    return SetPlanResult.Failure(WriteFailure.Validation("bulk delete requires mapped primary key"))
  end
  let invalid = mapping.failure(dialect)

  if invalid != null
    return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk entity mapping"))
  end
  match bulkKeySelection<T>(query, mapping, key, dialect)
    case CompileResult.Failure(error)
      return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk query"))
    case CompileResult.Plan(selection)
      let parameters = new WriteValues()

      bulkParameters(selection.sql().parameters(), parameters)
      let alias = bulkTargetAlias(mapping.table())
      let sql = "WITH \"" + alias + "\" AS MATERIALIZED (" + selection.sql().sql() + ") DELETE FROM \"" + mapping.table() + "\" WHERE " + bulkKeyOperand(mapping) + " IN (SELECT " + bulkKeyNames(mapping) + " FROM \"" + alias + "\")"

      return SetPlanResult.Plan(new SetWritePlan(sql, parameters, selection.sql().requiresCheckedScalars()))
  end
end

def compileSetUpdate<T>(query: Query<T>, changes: readonly fields::Pack, dialect: SqlDialect): SetPlanResult
  let mapping = query.entityMapping()

  if mapping == null
    return SetPlanResult.Failure(WriteFailure.Validation("bulk update requires entity mapping"))
  end
  if mapping.readOnly()
    return SetPlanResult.Failure(WriteFailure.Unsupported("read-only entities cannot be modified"))
  end
  let key = mapping.keyColumn()

  if key == null
    return SetPlanResult.Failure(WriteFailure.Validation("bulk update requires mapped primary key"))
  end
  let invalid = mapping.failure(dialect)

  if invalid != null
    return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk entity mapping"))
  end
  if changes.entityType() != mapping.entityType() || changes.count() == 0
    return SetPlanResult.Failure(WriteFailure.Validation("bulk update requires mapped fields"))
  end
  match bulkKeySelection<T>(query, mapping, key, dialect)
    case CompileResult.Failure(error)
      return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk query"))
    case CompileResult.Plan(selection)
      let values = new WriteValues()

      bulkParameters(selection.sql().parameters(), values)
      var assignments = ""
      var index = 0

      while index < changes.count()
        let entry = changes.entryAt(index)

        if entry == null
          return SetPlanResult.Failure(WriteFailure.Validation("bulk update contains a missing field"))
        end
        let column = mapping.find(entry.identity())

        if column == null || column.typeName() != entry.typeName()
          return SetPlanResult.Failure(WriteFailure.Validation("bulk update field does not match mapping"))
        end
        if column.conversionId() != null
          return SetPlanResult.Failure(WriteFailure.Validation("converted update targets require setConverted with the mapped encoder"))
        end
        let physicalFailure = bulkPhysicalFailure(query, [column.column()])

        if physicalFailure != null
          return SetPlanResult.Failure(WriteFailure.Unsupported(physicalFailure))
        end
        if mapping.isPrimaryKey(column.column())
          return SetPlanResult.Failure(WriteFailure.Validation("bulk update cannot change the primary key"))
        end
        var prior = 0

        while prior < index
          let earlier = changes.entryAt(prior)

          if earlier != null && earlier.identity() == entry.identity()
            return SetPlanResult.Failure(WriteFailure.Validation("bulk update field is repeated"))
          end
          prior = prior + 1
        end
        let value = entry.value()
        let actual = translationValueType(value)

        if actual == "Null"
          if !translationOptional(column.typeName())
            return SetPlanResult.Failure(WriteFailure.Validation("bulk null requires an optional field"))
          end
          values.add(Cell.Null())
        else
          if actual != semanticTranslationInner(column.typeName())
            return SetPlanResult.Failure(WriteFailure.Validation("bulk value type does not match mapping"))
          end
          match value
            case quotation::CaptureValue.Bool(item)
              values.add(column.boolToInt() ? Cell.Int(item ? 1 : 0) : Cell.Bool(item))
            case quotation::CaptureValue.Int(item)
              values.add(Cell.Int(item))
            case quotation::CaptureValue.Float(item)
              if !dataFloatFinite(item)
                return SetPlanResult.Failure(WriteFailure.Validation("bulk Float value must be finite"))
              end
              values.add(Cell.Float(item))
            case quotation::CaptureValue.Text(item)
              values.add(Cell.Text(item))
            case quotation::CaptureValue.Null()
              return SetPlanResult.Failure(WriteFailure.Validation("bulk value is not representable"))
          end
        end
        assignments = assignments + (index == 0 ? "" : ", ") + "\"" + column.column() + "\" = " + dialectPlaceholder(
          dialect,
          values.count()
        )
        index = index + 1
      end
      let alias = bulkTargetAlias(mapping.table())
      let sql = "WITH \"" + alias + "\" AS MATERIALIZED (" + selection.sql().sql() + ") UPDATE \"" + mapping.table() + "\" SET " + assignments + " WHERE " + bulkKeyOperand(mapping) + " IN (SELECT " + bulkKeyNames(mapping) + " FROM \"" + alias + "\")"

      return SetPlanResult.Plan(new SetWritePlan(sql, values, selection.sql().requiresCheckedScalars()))
  end
end

def bulkScalarFailure(error: QueryFailure): WriteFailure
  match error
    case QueryFailure.UnsupportedCapability(message)
      return WriteFailure.Validation(message)
    case QueryFailure.InvalidIdentifier(name)
      return WriteFailure.Validation("computed bulk update has an invalid identifier")
    case QueryFailure.InvalidLimit(value, maximum)
      return WriteFailure.Validation("computed bulk update has an invalid limit")
    case QueryFailure.MissingLimit(maximum)
      return WriteFailure.Validation("computed bulk update requires a query limit")
    case QueryFailure.SourceMismatch(expected, actual)
      return WriteFailure.Validation("computed bulk update source does not match mapping")
    case QueryFailure.Provider(message)
      return WriteFailure.Provider(message)
    case QueryFailure.MissingColumn(name)
      return WriteFailure.Validation("computed bulk update has an unmapped column")
    case QueryFailure.TypeMismatch(column, expected, actual)
      return WriteFailure.Validation("computed bulk update type does not match mapping")
    case QueryFailure.Cardinality(expected, actual)
      return WriteFailure.Validation("computed bulk update has invalid cardinality")
    case QueryFailure.Cleanup(failure)
      return WriteFailure.Cleanup(new WriteCleanupFailure(
          bulkScalarFailure(failure.primary()),
          WriteFailure.Provider(failure.cleanup())
        ))
  end
end

def bulkResultValidator(typeName: String): String
  let base = semanticTranslationInner(typeName)

  if base == "Int"
    return "__neri_value_int"
  end
  if base == "Float"
    return "__neri_value_float"
  end
  if base == "Bool"
    return "__neri_value_bool"
  end
  return "__neri_value_text"
end

def bulkPostgresResultValidator(sql: String, typeName: String): String
  let base = semanticTranslationInner(typeName)
  let sqlType = base == "Int" ? "BIGINT" : (base == "Bool" ? "BOOLEAN" : (base == "Float" ? "DOUBLE PRECISION" : "TEXT"))
  let value = "\"__neri_set_value\".\"value\""
  let errorText = "(coalesce(CAST(" + value + " AS TEXT), 'NULL') || ' invalid " + base + " assignment')"
  let invalid = base == "String" ? "CAST(CAST(" + errorText + " AS BIGINT) AS TEXT)" : "CAST(" + errorText + " AS " + sqlType + ")"
  let nullValue = translationOptional(typeName) ? "CAST(NULL AS " + sqlType + ")" : invalid
  var checked = value

  if base == "Float"
    checked = "CASE WHEN " + value + " > '-Infinity'::DOUBLE PRECISION AND " + value + " < 'Infinity'::DOUBLE PRECISION THEN " + value + " ELSE " + invalid + " END"
  end
  return "(SELECT CASE WHEN " + value + " IS NULL THEN " + nullValue + " ELSE " + checked + " END FROM (SELECT CAST(" + sql + " AS " + sqlType + ") AS \"value\") AS \"__neri_set_value\")"
end

def compileSetUpdateExpressions<T>(query: Query<T>, setters: UpdateSet<T>, dialect: SqlDialect): SetPlanResult
  let mapping = query.entityMapping()

  if mapping == null
    return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update requires entity mapping"))
  end
  if mapping.readOnly()
    return SetPlanResult.Failure(WriteFailure.Unsupported("read-only entities cannot be modified"))
  end
  let key = mapping.keyColumn()

  if key == null
    return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update requires mapped primary key"))
  end
  if mapping.failure(dialect) != null
    return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk entity mapping"))
  end
  if setters.count() == 0 || setters.count() > mapping.count()
    return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update requires distinct mapped fields"))
  end
  match bulkKeySelection<T>(query, mapping, key, dialect)
    case CompileResult.Failure(error)
      return SetPlanResult.Failure(WriteFailure.Validation("invalid bulk query"))
    case CompileResult.Plan(selection)
      let prefix = selection.sql().parameters()
      let state = new CompileState()

      state.count = prefix.count()
      var assignments = ""
      var index = 0

      while index < setters.count()
        let entry = setters.entryAt(index)

        if entry == null
          return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update contains a missing assignment"))
        end
        let targetTree = entry.target()
        let targetRoot = targetTree.nodeAt(targetTree.root())

        if targetRoot == null || translationNodeCode(targetRoot.kind()) != 2
          return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update target must be a direct mapped member"))
        end
        let receiver = targetTree.nodeAt(targetRoot.first())

        if receiver == null || translationNodeCode(receiver.kind()) != 0
          return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update target must be a direct mapped member"))
        end

        match translateSelection(mapping, targetTree)
          case SelectionResult.Failure(error)
            return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update target must be a mapped scalar member"))
          case SelectionResult.Column(column)
            if column.typeName() != entry.typeName() || entry.value().resultType() != entry.typeName()
              return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update target and value types must match mapping"))
            end
            if column.conversionId() != null && !entry.usesExactStorage()
              return SetPlanResult.Failure(WriteFailure.Validation("converted update targets require setConverted with the mapped encoder"))
            end
            if mapping.isPrimaryKey(column.column())
              return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update cannot change the primary key"))
            end
            var prior = 0

            while prior < index
              let previous = setters.entryAt(prior)

              if previous == null
                return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update contains a missing assignment"))
              end
              match translateSelection(mapping, previous.target())
                case SelectionResult.Failure(error)
                  return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update target must be a mapped scalar member"))
                case SelectionResult.Column(earlier)
                  if earlier.column() == column.column()
                    return SetPlanResult.Failure(WriteFailure.Validation("computed bulk update field is repeated"))
                  end
              end
              prior = prior + 1
            end
            match entry.compileValue(mapping, state, dialect)
              case ScalarSqlResult.Failure(error)
                return SetPlanResult.Failure(bulkScalarFailure(error))
              case ScalarSqlResult.Value(value)
                let physicalFailure = bulkPhysicalFailure(
                  query,
                  bulkScalarDependencies(mapping, column.column(), value.sql)
                )

                if physicalFailure != null
                  return SetPlanResult.Failure(WriteFailure.Unsupported(physicalFailure))
                end
                let allowNull = translationOptional(column.typeName()) ? "1" : "0"
                var guarded = ""

                if entry.usesExactStorage()
                  guarded = value.sql
                else
                  match dialect
                    case SqlDialect.QuestionMark()
                      guarded = bulkResultValidator(column.typeName()) + "(" + value.sql + ", " + allowNull + ")"
                    case SqlDialect.PostgreSql()
                      guarded = bulkPostgresResultValidator(value.sql, column.typeName())
                  end
                end

                if column.boolToInt()
                  guarded = "(SELECT CASE WHEN \"__neri_bool_value\".\"value\" IS NULL THEN NULL WHEN \"__neri_bool_value\".\"value\" THEN 1 ELSE 0 END FROM (SELECT " + guarded + " AS \"value\") AS \"__neri_bool_value\")"
                end

                assignments = assignments + (index == 0 ? "" : ", ") + "\"" + column.column() + "\" = " + guarded
            end
        end
        index = index + 1
      end
      let values = new WriteValues()

      bulkParameters(prefix, values)
      bulkParameters(new ParameterValues(state.head, state.count - prefix.count()), values)
      let alias = bulkTargetAlias(mapping.table())
      let sql = "WITH \"" + alias + "\" AS MATERIALIZED (" + selection.sql().sql() + ") UPDATE \"" + mapping.table() + "\" SET " + assignments + " WHERE " + bulkKeyOperand(mapping) + " IN (SELECT " + bulkKeyNames(mapping) + " FROM \"" + alias + "\")"

      return SetPlanResult.Plan(new SetWritePlan(sql, values, true))
  end
end

def bulkKeyNames(mapping: EntityMapping): String
  var result = ""

  for key in mapping.primaryKeys()
    result = result + (result == "" ? "" : ", ") + "\"" + key + "\""
  end
  return result
end

def bulkKeyOperand(mapping: EntityMapping): String
  let names = bulkKeyNames(mapping)

  return mapping.primaryKeys().Length > 1 ? "(" + names + ")" : names
end
