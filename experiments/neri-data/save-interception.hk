namespace neri_data

## Interceptors can validate before snapshot capture and observe final outcomes.
## Completion observation cannot replace an acknowledged database outcome.
abstract class SaveInterceptor
  public def beforeSave(context: ChangeContext): WriteFailure?
    return null
  end

  public def afterSave(context: ChangeContext, result: WriteResult): Void
  end
end

class SaveInterceptorEntry
  public interceptor: SaveInterceptor
  public next: SaveInterceptorEntry?

  def init(interceptor: SaveInterceptor): Void
    this.interceptor = interceptor
  end
end
