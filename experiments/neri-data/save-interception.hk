namespace neri_data

## Interceptors can validate before snapshot capture and observe final outcomes.
## Completion observation cannot replace an acknowledged database outcome.
abstract class SaveInterceptor
  public def beforeSave(context: ChangeContext): WriteFailure?
    return null
  end

  public def afterSave(context: ChangeContext, result: WriteResult): Void
  end
end

class SaveInterceptorEntry
  public interceptor: SaveInterceptor
  public next: SaveInterceptorEntry?

  def init(interceptor: SaveInterceptor): Void
    this.interceptor = interceptor
  end
end

class ChangeDetectorEntry
  public detect: fn(GraphJournal): QueryFailure?
  public next: ChangeDetectorEntry?

  def init(detect: fn(GraphJournal): QueryFailure?): Void
    this.detect = detect
  end
end

def detectorWriteFailure(error: QueryFailure): WriteFailure
  match error
    case QueryFailure.Provider(failure)
      return WriteFailure.Provider(failure)
    case QueryFailure.Cleanup(failure)
      return WriteFailure.Cleanup(new WriteCleanupFailure(
          detectorWriteFailure(failure.primary()),
          WriteFailure.Provider(failure.cleanup())
        ))
    case QueryFailure.UnsupportedCapability(name)
      return WriteFailure.Unsupported(name)
    case QueryFailure.InvalidIdentifier(name)
      return WriteFailure.Validation("invalid relationship identifier: " + name)
    case QueryFailure.InvalidLimit(value, maximum)
    case QueryFailure.MissingLimit(maximum)
      return WriteFailure.Validation("relationship change detection exceeds its bound")
    case QueryFailure.SourceMismatch(expected, actual)
      return WriteFailure.Validation("relationship source mismatch: " + actual)
    case QueryFailure.MissingColumn(name)
      return WriteFailure.Validation("relationship snapshot column is missing: " + name)
    case QueryFailure.TypeMismatch(column, expected, actual)
      return WriteFailure.Validation("relationship snapshot column type mismatch: " + column)
    case QueryFailure.Cardinality(expected, actual)
      return WriteFailure.Validation("relationship cardinality mismatch: " + expected)
  end
  return WriteFailure.Validation("relationship change detection failed")
end
