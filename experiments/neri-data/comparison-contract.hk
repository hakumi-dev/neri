use neri_data
use test
use host

class ComparisonRecord
  public id: Int
  public peerId: Int
  public active: Bool
  public enabled: Bool
  public name: String
  public alias: String
  public optionalId: Int?
  public optionalPeerId: Int?
  public optionalActive: Bool?
  public optionalEnabled: Bool?
  public optionalName: String?
  public optionalAlias: String?
  public foreignId: Int

  def init(): Void
    this.id = 0
    this.peerId = 0
    this.active = false
    this.enabled = false
    this.name = ""
    this.alias = ""
    this.optionalId = null
    this.optionalPeerId = null
    this.optionalActive = null
    this.optionalEnabled = null
    this.optionalName = null
    this.optionalAlias = null
    this.foreignId = 0
  end
end

class ComparisonProvider: Provider
  public calls: Int = 0
  public seenSql: String = ""
  public seenParameters: Int = 0

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    this.seenSql = plan.sql()
    this.seenParameters = plan.parameters().count()
    return ProviderResult.Rows([])
  end
end

def rejectComparisonRecord(row: RawRow): DecodeResult<ComparisonRecord>
  return DecodeResult<ComparisonRecord>.Failure(QueryFailure.Provider("comparison contract does not decode rows"))
end

def comparisonColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("peer_id", ResultColumnKind.Int()), new ResultColumn("active", ResultColumnKind.Bool()), new ResultColumn("enabled", ResultColumnKind.Bool()), new ResultColumn("name", ResultColumnKind.Text()), new ResultColumn("alias", ResultColumnKind.Text()), new ResultColumn("optional_id", ResultColumnKind.Int(), true), new ResultColumn("optional_peer_id", ResultColumnKind.Int(), true), new ResultColumn("optional_active", ResultColumnKind.Bool(), true), new ResultColumn("optional_enabled", ResultColumnKind.Bool(), true), new ResultColumn("optional_name", ResultColumnKind.Text(), true), new ResultColumn("optional_alias", ResultColumnKind.Text(), true)])
end

def comparisonMapping(): EntityMapping
  return new EntityMapping("ComparisonRecord", "comparison_records", [new MappingColumn("ComparisonRecord.id", "Int", "id"), new MappingColumn("ComparisonRecord.peerId", "Int", "peer_id"), new MappingColumn("ComparisonRecord.active", "Bool", "active"), new MappingColumn("ComparisonRecord.enabled", "Bool", "enabled"), new MappingColumn("ComparisonRecord.name", "String", "name"), new MappingColumn("ComparisonRecord.alias", "String", "alias"), new MappingColumn("ComparisonRecord.optionalId", "Int?", "optional_id"), new MappingColumn("ComparisonRecord.optionalPeerId", "Int?", "optional_peer_id"), new MappingColumn("ComparisonRecord.optionalActive", "Bool?", "optional_active"), new MappingColumn("ComparisonRecord.optionalEnabled", "Bool?", "optional_enabled"), new MappingColumn("ComparisonRecord.optionalName", "String?", "optional_name"), new MappingColumn("ComparisonRecord.optionalAlias", "String?", "optional_alias")])
end

def comparisonQuery(provider: Provider? = null): Query<ComparisonRecord>
  return new Query<ComparisonRecord>("comparison_records", new Decoder<ComparisonRecord>(rejectComparisonRecord, comparisonColumns()), mapping: comparisonMapping(), provider: provider)
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def assertPredicate(predicate: quote fn(ComparisonRecord): Bool, expectedSql: String, expectedParameters: Int = 0): Void
  match comparisonQuery().matching(predicate).take(7).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), expectedSql))
      test::assertEqual(plan.sql().parameters().count(), expectedParameters)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
end

def assertTwoIntParameters(parameters: readonly ParameterValues, firstExpected: Int, secondExpected: Int): Void
  let first = parameters.first()

  test::assertTrue(first != null)
  if first != null
    match first.value()
      case Parameter.Int(value)
        test::assertEqual(value, firstExpected)
      case Parameter.Float(value)
        test::assertTrue(false)
      case Parameter.Bool(value)
        test::assertTrue(false)
      case Parameter.Text(value)
        test::assertTrue(false)
    end
    let second = first.next()

    test::assertTrue(second != null)
    if second != null
      match second.value()
        case Parameter.Int(value)
          test::assertEqual(value, secondExpected)
        case Parameter.Float(value)
          test::assertTrue(false)
        case Parameter.Bool(value)
          test::assertTrue(false)
        case Parameter.Text(value)
          test::assertTrue(false)
      end
    end
  end
end

def requiredIntEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id == record.peerId
  end
end

def requiredIntNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id != record.peerId
  end
end

def requiredBoolEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.active == record.enabled
  end
end

def requiredBoolNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.active != record.enabled
  end
end

def requiredStringEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.name == record.alias
  end
end

def requiredStringNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.name != record.alias
  end
end

def nullableIntEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalId == record.optionalPeerId
  end
end

def nullableIntNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalId != record.optionalPeerId
  end
end

def nullableBoolEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalActive == record.optionalEnabled
  end
end

def nullableBoolNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalActive != record.optionalEnabled
  end
end

def nullableStringEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalName == record.optionalAlias
  end
end

def nullableStringNotEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.optionalName != record.optionalAlias
  end
end

def lessThan(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id < record.peerId
  end
end

def lessThanOrEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id <= record.peerId
  end
end

def greaterThan(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id > record.peerId
  end
end

def greaterThanOrEqual(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id >= record.peerId
  end
end

def mixedParameterComparison(): quote fn(ComparisonRecord): Bool
  let cutoff = 12

  return quote do |record: ComparisonRecord|: Bool
    return record.id > cutoff && record.id < record.peerId
  end
end

def invalidMappedType(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id == record.peerId
  end
end

def unmappedField(): quote fn(ComparisonRecord): Bool
  return quote do |record: ComparisonRecord|: Bool
    return record.id == record.foreignId
  end
end

def main(): Void
  assertPredicate(requiredIntEqual(), "\"comparison_records\".\"id\" = \"comparison_records\".\"peer_id\"")
  assertPredicate(requiredIntNotEqual(), "NOT \"comparison_records\".\"id\" = \"comparison_records\".\"peer_id\"")
  assertPredicate(requiredBoolEqual(), "\"comparison_records\".\"active\" = \"comparison_records\".\"enabled\"")
  assertPredicate(requiredBoolNotEqual(), "NOT \"comparison_records\".\"active\" = \"comparison_records\".\"enabled\"")
  assertPredicate(requiredStringEqual(), "\"comparison_records\".\"name\" = \"comparison_records\".\"alias\"")
  assertPredicate(requiredStringNotEqual(), "NOT \"comparison_records\".\"name\" = \"comparison_records\".\"alias\"")
  assertPredicate(nullableIntEqual(), "IS NULL")
  assertPredicate(nullableIntNotEqual(), "NOT (")
  assertPredicate(nullableBoolEqual(), "IS NULL")
  assertPredicate(nullableBoolNotEqual(), "NOT (")
  assertPredicate(nullableStringEqual(), "IS NULL")
  assertPredicate(nullableStringNotEqual(), "NOT (")
  assertPredicate(lessThan(), "\"comparison_records\".\"id\" < \"comparison_records\".\"peer_id\"")
  assertPredicate(lessThanOrEqual(), "\"comparison_records\".\"id\" <= \"comparison_records\".\"peer_id\"")
  assertPredicate(greaterThan(), "\"comparison_records\".\"id\" > \"comparison_records\".\"peer_id\"")
  assertPredicate(greaterThanOrEqual(), "\"comparison_records\".\"id\" >= \"comparison_records\".\"peer_id\"")

  let provider = new ComparisonProvider()
  let mixed = comparisonQuery().where(id: 8).matching(mixedParameterComparison()).take(7)

  match mixed.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 2)
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" = $1"))
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" > $2"))
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" < \"comparison_records\".\"peer_id\""))
      assertTwoIntParameters(plan.sql().parameters(), 8, 12)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  match mixed.all(provider)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, 1)
  test::assertEqual(provider.seenParameters, 2)
  test::assertTrue(containsText(provider.seenSql, "\"comparison_records\".\"id\" = ?"))
  test::assertTrue(containsText(provider.seenSql, "\"comparison_records\".\"id\" > ?"))
  test::assertTrue(containsText(provider.seenSql, "\"comparison_records\".\"id\" < \"comparison_records\".\"peer_id\""))

  let aggregateFilter = countRows<ComparisonRecord>().where(nullableIntEqual())

  match aggregateRows(comparisonQuery(), aggregateFilter).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 0)
      test::assertTrue(containsText(plan.sql().sql(), "FILTER (WHERE"))
      test::assertTrue(containsText(plan.sql().sql(), "IS NULL"))
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  match aggregateRows(comparisonQuery().where(id: 8), countRows<ComparisonRecord>().where(mixedParameterComparison())).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 2)
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" > $1"))
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" = $2"))
      test::assertTrue(containsText(plan.sql().sql(), "\"comparison_records\".\"id\" < \"comparison_records\".\"peer_id\""))
      assertTwoIntParameters(plan.sql().parameters(), 12, 8)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  let malformedMapping = new EntityMapping("ComparisonRecord", "comparison_records", [new MappingColumn("ComparisonRecord.id", "Int", "id"), new MappingColumn("ComparisonRecord.peerId", "String", "peer_id")])
  let malformed = new Query<ComparisonRecord>("comparison_records", new Decoder<ComparisonRecord>(rejectComparisonRecord, comparisonColumns()), mapping: malformedMapping)
  let beforeMalformed = provider.calls

  match malformed.matching(invalidMappedType()).take(7).all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeMalformed)

  let beforeUnmapped = provider.calls

  match comparisonQuery().matching(unmappedField()).take(7).all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeUnmapped)
end
