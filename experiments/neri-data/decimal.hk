use host
namespace neri_data

## An exact base-ten value. Parsing never passes through a floating-point value.
## Values have a canonical representation, up to 4096 decimal digits.
class Decimal
  private canonical: String = "0"

  static def zero(): Decimal
    return new Decimal()
  end

  ## Parses an optional sign, integer digits, and an optional decimal fraction.
  ## Whitespace, exponents, incomplete fractions, and more than 4096 digits fail.
  static def parse(value: String): Decimal?
    let canonical = decimalCanonical(value)

    if canonical == null
      return null
    end
    let parsed = new Decimal()

    parsed.canonical = canonical
    return parsed
  end

  public readonly def text(): String
    return this.canonical
  end

  public readonly def equals(other: readonly Decimal): Bool
    return this.canonical == other.canonical
  end

  ## Compares exact values, returning -1, 0, or 1.
  public readonly def compare(other: readonly Decimal): Int
    let firstNegative = decimalNegative(this.canonical)
    let secondNegative = decimalNegative(other.canonical)

    if firstNegative != secondNegative
      return firstNegative ? -1 : 1
    end
    let scale = decimalScale(this.canonical) > decimalScale(other.canonical) ? decimalScale(this.canonical) : decimalScale(other.canonical)
    let first = decimalDigits(this.canonical, scale)
    let second = decimalDigits(other.canonical, scale)
    let order = decimalDigitsCompare(first, second)

    return firstNegative ? -order : order
  end

  ## Adds without rounding. A result outside the digit bound returns null.
  public readonly def add(other: readonly Decimal): Decimal?
    let firstNegative = decimalNegative(this.canonical)
    let secondNegative = decimalNegative(other.canonical)
    let scale = decimalScale(this.canonical) > decimalScale(other.canonical) ? decimalScale(this.canonical) : decimalScale(other.canonical)
    let first = decimalDigits(this.canonical, scale)
    let second = decimalDigits(other.canonical, scale)
    var digits = ""
    var negative = firstNegative

    if firstNegative == secondNegative
      digits = decimalDigitsAdd(first, second)
    else
      let order = decimalDigitsCompare(first, second)

      if order >= 0
        digits = decimalDigitsSubtract(first, second)
      else
        digits = decimalDigitsSubtract(second, first)
        negative = secondNegative
      end
    end
    while host::stringByteLength(digits) <= scale
      digits = "0" + digits
    end
    if scale > 0
      let point = host::stringByteLength(digits) - scale

      digits = host::stringSlice(digits, 0, point) + "." + host::stringSlice(digits, point, scale)
    end
    return Decimal.parse((negative ? "-" : "") + digits)
  end

  public readonly def negate(): Decimal
    if this.canonical == "0"
      return Decimal.zero()
    end
    let result = new Decimal()

    result.canonical = decimalNegative(this.canonical) ? host::stringSlice(
      this.canonical,
      1,
      host::stringByteLength(this.canonical) - 1
    ) : "-" + this.canonical
    return result
  end

  public readonly def subtract(other: readonly Decimal): Decimal?
    return this.add(other.negate())
  end

  ## Multiplies exactly. A result outside the digit bound returns null.
  public readonly def multiply(other: readonly Decimal): Decimal?
    let first = decimalDigits(this.canonical, decimalScale(this.canonical))
    let second = decimalDigits(other.canonical, decimalScale(other.canonical))
    var digits = "0"
    var zeros = ""
    var index = host::stringByteLength(second) - 1

    while index >= 0
      var piece = ""
      var carry = 0
      var position = host::stringByteLength(first) - 1
      let factor = (host::stringByteAt(second, index) as Int) - 48

      while position >= 0 || carry > 0
        let digit = position < 0 ? 0 : (host::stringByteAt(first, position) as Int) - 48
        let product = digit * factor + carry

        piece = ((product - (product / 10) * 10) as String) + piece
        carry = product / 10
        position = position - 1
      end
      digits = decimalDigitsTrim(decimalDigitsAdd(digits, piece + zeros))
      zeros = zeros + "0"
      index = index - 1
    end
    return decimalFromDigits(
      digits,
      decimalScale(this.canonical) + decimalScale(other.canonical),
      decimalNegative(this.canonical) != decimalNegative(other.canonical)
    )
  end

  ## Divides to an explicit number of fractional digits, truncating toward zero.
  ## Zero divisors, invalid scales and results outside the digit bound return null.
  public readonly def divideTruncated(other: readonly Decimal, scale: Int): Decimal?
    if scale < 0 || scale > 4096 || other.text() == "0"
      return null
    end
    var numerator = decimalDigits(this.canonical, decimalScale(this.canonical))
    var denominator = decimalDigits(other.canonical, decimalScale(other.canonical))
    let shift = scale + decimalScale(other.canonical) - decimalScale(this.canonical)
    var missing = shift < 0 ? -shift : shift

    while missing > 0
      if shift < 0
        denominator = denominator + "0"
      else
        numerator = numerator + "0"
      end
      missing = missing - 1
    end
    var quotient = ""
    var remainder = "0"
    var index = 0

    while index < host::stringByteLength(numerator)
      remainder = decimalDigitsTrim(remainder + host::stringSlice(numerator, index, 1))
      var digit = 0

      while decimalDigitsCompare(remainder, denominator) >= 0
        remainder = decimalDigitsTrim(decimalDigitsSubtract(remainder, denominator))
        digit = digit + 1
      end
      quotient = quotient + (digit as String)
      index = index + 1
    end
    return decimalFromDigits(
      decimalDigitsTrim(quotient),
      scale,
      decimalNegative(this.canonical) != decimalNegative(other.canonical)
    )
  end
end

def decimalDigitsTrim(value: String): String
  var start = 0

  while start + 1 < host::stringByteLength(value) && host::stringByteAt(value, start) as Int == 48
    start = start + 1
  end
  return host::stringSlice(value, start, host::stringByteLength(value) - start)
end

def decimalFromDigits(value: String, scale: Int, negative: Bool): Decimal?
  var digits = value
  var fraction = scale

  if digits == "0"
    return Decimal.zero()
  end
  while fraction > 0 && host::stringByteAt(digits, host::stringByteLength(digits) - 1) as Int == 48
    digits = host::stringSlice(digits, 0, host::stringByteLength(digits) - 1)
    fraction = fraction - 1
  end
  if host::stringByteLength(digits) > 4096 || fraction > 4095
    return null
  end
  while host::stringByteLength(digits) <= fraction
    digits = "0" + digits
  end
  if fraction > 0
    let point = host::stringByteLength(digits) - fraction

    digits = host::stringSlice(digits, 0, point) + "." + host::stringSlice(digits, point, fraction)
  end
  return Decimal.parse((negative ? "-" : "") + digits)
end

def decimalNegative(value: String): Bool
  return host::stringByteAt(value, 0) as Int == 45
end

def decimalScale(value: String): Int
  var index = 0

  while index < host::stringByteLength(value)
    if host::stringByteAt(value, index) as Int == 46
      return host::stringByteLength(value) - index - 1
    end
    index = index + 1
  end
  return 0
end

def decimalCanonical(value: String): String?
  let length = host::stringByteLength(value)

  if length == 0 || length > 4098
    return null
  end
  var start = 0
  var negative = false
  let sign = host::stringByteAt(value, 0) as Int

  if sign == 45 || sign == 43
    negative = sign == 45
    start = 1
  end
  var point = length
  var index = start
  var digits = 0

  while index < length
    let byte = host::stringByteAt(value, index) as Int

    if byte == 46 && point == length && index > start && index + 1 < length
      point = index
    else if byte >= 48 && byte <= 57
      digits = digits + 1
    else
      return null
    end
    index = index + 1
  end
  if digits == 0 || digits > 4096
    return null
  end
  while start + 1 < point && host::stringByteAt(value, start) as Int == 48
    start = start + 1
  end
  var finish = length

  if point < length
    while finish > point + 1 && host::stringByteAt(value, finish - 1) as Int == 48
      finish = finish - 1
    end
    finish = point if finish == point + 1
  end
  let result = host::stringSlice(value, start, finish - start)

  return result == "0" ? "0" : (negative ? "-" : "") + result
end

def decimalDigits(value: String, scale: Int): String
  var result = ""
  var index = decimalNegative(value) ? 1 : 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    result = result + host::stringSlice(value, index, 1) if byte != 46
    index = index + 1
  end
  var missing = scale - decimalScale(value)

  while missing > 0
    result = result + "0"
    missing = missing - 1
  end
  var start = 0

  while start + 1 < host::stringByteLength(result) && host::stringByteAt(result, start) as Int == 48
    start = start + 1
  end
  return host::stringSlice(result, start, host::stringByteLength(result) - start)
end

def decimalDigitsCompare(first: String, second: String): Int
  let firstLength = host::stringByteLength(first)
  let secondLength = host::stringByteLength(second)

  if firstLength != secondLength
    return firstLength < secondLength ? -1 : 1
  end
  var index = 0

  while index < firstLength
    let left = host::stringByteAt(first, index) as Int
    let right = host::stringByteAt(second, index) as Int

    if left != right
      return left < right ? -1 : 1
    end
    index = index + 1
  end
  return 0
end

def decimalDigitsAdd(first: String, second: String): String
  var left = host::stringByteLength(first) - 1
  var right = host::stringByteLength(second) - 1
  var carry = 0
  var result = ""

  while left >= 0 || right >= 0 || carry > 0
    let a = left < 0 ? 0 : (host::stringByteAt(first, left) as Int) - 48
    let b = right < 0 ? 0 : (host::stringByteAt(second, right) as Int) - 48
    let sum = a + b + carry

    result = ((sum - (sum / 10) * 10) as String) + result
    carry = sum / 10
    left = left - 1
    right = right - 1
  end
  return result
end

def decimalDigitsSubtract(first: String, second: String): String
  var left = host::stringByteLength(first) - 1
  var right = host::stringByteLength(second) - 1
  var carryDebt = 0
  var result = ""

  while left >= 0
    let a = (host::stringByteAt(first, left) as Int) - 48
    let b = right < 0 ? 0 : (host::stringByteAt(second, right) as Int) - 48
    var difference = a - b - carryDebt

    carryDebt = difference < 0 ? 1 : 0
    difference = difference + 10 if difference < 0
    result = (difference as String) + result
    left = left - 1
    right = right - 1
  end
  return result
end
