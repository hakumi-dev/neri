namespace neri_data

def skipNavigationLive(state: TrackingState?): Bool
  if state == null
    return false
  end
  match state
    case TrackingState.Added()
      return true
    case TrackingState.Unchanged()
      return true
    case TrackingState.Modified()
      return true
    case TrackingState.Deleted()
      return false
    case TrackingState.Detached()
      return false
  end
end

class SkipNavigationChange<L, R>
  public left: L
  public right: R
  public baseline: Bool = false
  public next: SkipNavigationChange<L, R>?

  def init(left: L, right: R, next: SkipNavigationChange<L, R>?): Void
    this.left = left
    this.right = right
    this.next = next
  end
end

class SkipNavigationChanges<L, R>
  public first: SkipNavigationChange<L, R>?
  public count: Int = 0
  public failure: QueryFailure?

  internal def clear(): Void
    this.first = null
    this.count = 0
    this.failure = null
  end

  internal def contains(left: L, right: R): Bool
    var current = this.first

    while current != null
      if reference::same(current.left, left) && reference::same(current.right, right)
        return true
      end
      current = current.next
    end
    return false
  end

  internal def retain(active: SkipNavigationChanges<L, R>): Void
    var current = this.first
    var previous: SkipNavigationChange<L, R>? = null

    while current != null
      let next = current.next

      if active.contains(current.left, current.right)
        previous = current
      else
        if previous == null
          this.first = next
        else
          previous.next = next
        end
        this.count = this.count - 1
      end
      current = next
    end
  end

  internal def pair(left: L, right: R): SkipNavigationChange<L, R>?
    var current = this.first

    while current != null
      if reference::same(current.left, left) && reference::same(current.right, right)
        return current
      end
      current = current.next
    end
    if this.count >= 10000
      return null
    end
    let added = new SkipNavigationChange<L, R>(left, right, this.first)

    this.first = added
    this.count = this.count + 1
    return added
  end
end
