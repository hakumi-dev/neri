use host
use tasks
namespace neri_data

def schemaTextBefore(left: String, right: String): Bool
  let leftLength = host::stringByteLength(left)
  let rightLength = host::stringByteLength(right)
  var index = 0

  while index < leftLength && index < rightLength
    let first = host::stringByteAt(left, index) as Int
    let second = host::stringByteAt(right, index) as Int

    if first != second
      return first < second
    end
    index = index + 1
  end
  return leftLength < rightLength
end

## A stable logical field identity and its physical column definition.
class SchemaField
  private storedIdentity: String
  private storedColumn: SchemaColumn

  public def init(identity: String, column: SchemaColumn): Void
    this.storedIdentity = identity
    this.storedColumn = new SchemaColumn(column.name(), schemaCloneType(column.type()), column.nullable(), column.primaryKey(), schemaCloneDefault(column.defaultValue()))
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def column(): readonly SchemaColumn
    return this.storedColumn
  end

  internal readonly def copy(): SchemaField
    let column = this.storedColumn

    return new SchemaField(this.storedIdentity, new SchemaColumn(column.name(), schemaCloneType(column.type()), column.nullable(), column.primaryKey(), schemaCloneDefault(column.defaultValue())))
  end
end

## Index fields are logical identities, in index key order.
class SchemaIndex
  private storedName: String
  private storedFields: String[]
  private storedUnique: Bool

  public def init(name: String, fields: String[], unique: Bool = false): Void
    this.storedName = name
    this.storedFields = tasks::generate(fields.Length, 1) do |index|
      return fields[index]
    end
    this.storedUnique = unique
  end

  public readonly def name(): String
    return this.storedName
  end

  public readonly def count(): Int
    return this.storedFields.Length
  end

  public readonly def at(index: Int): String?
    if index < 0 || index >= this.storedFields.Length
      return null
    end
    return this.storedFields[index]
  end

  public readonly def unique(): Bool
    return this.storedUnique
  end

  internal readonly def copy(): SchemaIndex
    let fields: String[] = tasks::generate(this.storedFields.Length, 1) do |index|
      return this.storedFields[index]
    end

    return new SchemaIndex(this.storedName, fields, this.storedUnique)
  end

  internal readonly def signature(): String
    var value = schemaPiece(this.storedName) + (this.storedUnique ? "1" : "0") + schemaPiece(this.storedFields.Length as String)

    for field in this.storedFields
      value = value + schemaPiece(field)
    end
    return value
  end
end

class SchemaTable
  private storedIdentity: String
  private storedName: String
  private storedFields: SchemaField[]
  private storedIndexes: SchemaIndex[]

  public def init(identity: String, name: String, fields: SchemaField[], indexes: SchemaIndex[] = []): Void
    this.storedIdentity = identity
    this.storedName = name
    this.storedFields = tasks::generate(fields.Length, 1) do |index|
      return fields[index].copy()
    end
    this.storedIndexes = tasks::generate(indexes.Length, 1) do |index|
      return indexes[index].copy()
    end
    var index = 1

    while index < this.storedFields.Length
      var position = index

      while position > 0 && schemaTextBefore(this.storedFields[position].identity(), this.storedFields[position - 1].identity())
        let previous = this.storedFields[position - 1]

        this.storedFields[position - 1] = this.storedFields[position]
        this.storedFields[position] = previous
        position = position - 1
      end
      index = index + 1
    end
    index = 1
    while index < this.storedIndexes.Length
      var position = index

      while position > 0 && schemaTextBefore(this.storedIndexes[position].name(), this.storedIndexes[position - 1].name())
        let previous = this.storedIndexes[position - 1]

        this.storedIndexes[position - 1] = this.storedIndexes[position]
        this.storedIndexes[position] = previous
        position = position - 1
      end
      index = index + 1
    end
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def name(): String
    return this.storedName
  end

  public readonly def count(): Int
    return this.storedFields.Length
  end

  public readonly def at(index: Int): readonly SchemaField?
    if index < 0 || index >= this.storedFields.Length
      return null
    end
    return this.storedFields[index]
  end

  public readonly def find(identity: String): readonly SchemaField?
    for field in this.storedFields
      if field.identity() == identity
        return field
      end
    end
    return null
  end

  public readonly def indexCount(): Int
    return this.storedIndexes.Length
  end

  public readonly def indexAt(index: Int): readonly SchemaIndex?
    if index < 0 || index >= this.storedIndexes.Length
      return null
    end
    return this.storedIndexes[index]
  end

  public readonly def findIndex(name: String): readonly SchemaIndex?
    for index in this.storedIndexes
      if index.name() == name
        return index
      end
    end
    return null
  end

  internal readonly def columns(): SchemaColumn[]
    return tasks::generate(this.storedFields.Length, 1) do |index|
      let column = this.storedFields[index].column()

      return new SchemaColumn(column.name(), schemaCloneType(column.type()), column.nullable(), column.primaryKey(), schemaCloneDefault(column.defaultValue()))
    end
  end

  internal readonly def copy(): SchemaTable
    let fields: SchemaField[] = tasks::generate(this.storedFields.Length, 1) do |index|
      return this.storedFields[index].copy()
    end
    let indexes: SchemaIndex[] = tasks::generate(this.storedIndexes.Length, 1) do |index|
      return this.storedIndexes[index].copy()
    end

    return new SchemaTable(this.storedIdentity, this.storedName, fields, indexes)
  end

  internal readonly def signature(): String
    var value = schemaPiece(this.storedIdentity) + schemaPiece(this.storedName) + schemaPiece(this.storedFields.Length as String)

    for field in this.storedFields
      value = value + schemaPiece(field.identity()) + schemaPiece(schemaColumnCode(field.column()))
    end
    value = value + schemaPiece(this.storedIndexes.Length as String)
    for index in this.storedIndexes
      value = value + schemaPiece(index.signature())
    end
    return value
  end
end

## A copied, canonical desired model; it is independent of database inspection.
class SchemaModel
  private storedTables: SchemaTable[]

  public def init(tables: SchemaTable[]): Void
    this.storedTables = tasks::generate(tables.Length, 1) do |index|
      return tables[index].copy()
    end
    var index = 1

    while index < this.storedTables.Length
      var position = index

      while position > 0 && schemaTextBefore(this.storedTables[position].identity(), this.storedTables[position - 1].identity())
        let previous = this.storedTables[position - 1]

        this.storedTables[position - 1] = this.storedTables[position]
        this.storedTables[position] = previous
        position = position - 1
      end
      index = index + 1
    end
  end

  public readonly def count(): Int
    return this.storedTables.Length
  end

  public readonly def at(index: Int): readonly SchemaTable?
    if index < 0 || index >= this.storedTables.Length
      return null
    end
    return this.storedTables[index]
  end

  public readonly def find(identity: String): readonly SchemaTable?
    for table in this.storedTables
      if table.identity() == identity
        return table
      end
    end
    return null
  end

  public readonly def signature(): String
    var value = "model-v1" + schemaPiece(this.storedTables.Length as String)

    for table in this.storedTables
      value = value + schemaPiece(table.signature())
    end
    return value
  end

  public readonly def validate(): String?
    if this.storedTables.Length > 1000
      return "schema model exceeds 1000 tables"
    end
    var fieldCount = 0
    var indexCount = 0
    var position = 0

    for table in this.storedTables
      if table.identity() == "" || table.count() == 0
        return "schema table requires a logical identity and fields"
      end
      fieldCount = fieldCount + table.count()
      indexCount = indexCount + table.indexCount()
      if fieldCount > 1000 || indexCount > 1000
        return "schema model exceeds 1000 fields or indexes"
      end
      var earlier = 0

      while earlier < position
        let other = this.storedTables[earlier]

        if other.identity() == table.identity() || schemaSameIdentifier(other.name(), table.name())
          return "duplicate schema table identity or name"
        end
        earlier = earlier + 1
      end
      match compileSchema(schemaTableCreate(table), SqlDialect.QuestionMark())
        case SchemaCompileResult.Failure(message)
          return message
        case SchemaCompileResult.Statement(sql)
      end
      var fieldIndex = 0
      var previousIdentity = ""

      while fieldIndex < table.count()
        let field = table.at(fieldIndex)

        if field == null
          return "schema field is missing"
        end
        if field.identity() == "" || (fieldIndex > 0 && field.identity() == previousIdentity)
          return "duplicate or empty schema field identity"
        end
        previousIdentity = field.identity()
        fieldIndex = fieldIndex + 1
      end
      var ordinal = 0

      while ordinal < table.indexCount()
        let index = table.indexAt(ordinal)

        if index == null || index.count() == 0 || index.count() > 1000
          return "schema index requires from 1 through 1000 fields"
        end
        for other in this.storedTables
          if schemaSameIdentifier(index.name(), other.name())
            return "schema index name collides with table name"
          end
          var otherOrdinal = 0

          while otherOrdinal < other.indexCount()
            let otherIndex = other.indexAt(otherOrdinal)

            if otherIndex != null && (other.identity() != table.identity() || otherOrdinal != ordinal) && schemaSameIdentifier(index.name(), otherIndex.name())
              return "duplicate schema index name"
            end
            otherOrdinal = otherOrdinal + 1
          end
        end
        var keyIndex = 0

        while keyIndex < index.count()
          let identity = index.at(keyIndex)

          if identity == null || table.find(identity) == null
            return "schema index references an unknown logical field"
          end
          keyIndex = keyIndex + 1
        end
        match compileSchema(schemaIndexCreate(table, index), SqlDialect.QuestionMark())
          case SchemaCompileResult.Failure(message)
            return message
          case SchemaCompileResult.Statement(sql)
        end
        ordinal = ordinal + 1
      end
      position = position + 1
    end
    return null
  end
end

def schemaTableCreate(table: readonly SchemaTable): SchemaOp
  return SchemaOp.CreateTable(table.name(), table.columns())
end

def schemaIndexCreate(table: readonly SchemaTable, index: readonly SchemaIndex): SchemaOp
  let fields: String[] = tasks::generate(index.count(), 1) do |position|
    let identity = index.at(position)

    if identity == null
      return ""
    end
    let field = table.find(identity)

    return field == null ? "" : field.column().name()
  end

  return SchemaOp.CreateIndex(index.name(), table.name(), fields, index.unique())
end
