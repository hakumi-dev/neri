use host
namespace neri_data

def schemaTextBefore(left: String, right: String): Bool
  let leftLength = host::stringByteLength(left)
  let rightLength = host::stringByteLength(right)
  var index = 0

  while index < leftLength && index < rightLength
    let first = host::stringByteAt(left, index) as Int
    let second = host::stringByteAt(right, index) as Int

    if first != second
      return first < second
    end
    index = index + 1
  end
  return leftLength < rightLength
end

## A stable logical field identity and its physical column definition.
class SchemaField
  private storedIdentity: String
  private storedColumn: SchemaColumn

  def init(identity: String, column: SchemaColumn): Void
    this.storedIdentity = identity
    this.storedColumn = new SchemaColumn(
      column.name(),
      schemaCloneType(column.type()),
      column.nullable(),
      column.primaryKey(),
      schemaCloneDefault(column.defaultValue()),
      schemaCloneReference(column.reference()),
      column.keyPosition(), column.defaultSql(), column.computedSql(), column.computedStored(), column.checkSql(), column.collation()
    )
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def column(): readonly SchemaColumn
    return this.storedColumn
  end

  internal readonly def copy(): SchemaField
    let column = this.storedColumn

    return new SchemaField(
      this.storedIdentity,
      new SchemaColumn(
        column.name(),
        schemaCloneType(column.type()),
        column.nullable(),
        column.primaryKey(),
        schemaCloneDefault(column.defaultValue()),
        schemaCloneReference(column.reference()),
        column.keyPosition(), column.defaultSql(), column.computedSql(), column.computedStored(), column.checkSql(), column.collation()
      )
    )
  end
end

## Index fields are logical identities, in index key order.
class SchemaIndex
  private storedName: String
  private storedFields: String[]
  private storedUnique: Bool
  private storedDescending: Bool[]
  private storedPredicate: String?
  private storedExpressions: String[]
  private storedInclude: String[]

  def init(
    name: String,
    fields: String[],
    unique: Bool = false,
    descending: Bool[] = [],
    predicate: String? = null,
    expressions: String[] = [],
    include: String[] = []
  ): Void
    this.storedName = name
    this.storedFields = arrays::generate(fields.Length) do |index|
      return fields[index]
    end
    this.storedUnique = unique
    this.storedDescending = arrays::generate(descending.Length) do |index|
      return descending[index]
    end
    this.storedPredicate = predicate
    this.storedExpressions = arrays::generate(expressions.Length) do |index|
      return expressions[index]
    end
    this.storedInclude = arrays::generate(include.Length) do |index|
      return include[index]
    end
  end

  public readonly def name(): String
    return this.storedName
  end

  public readonly def count(): Int
    return this.storedFields.Length
  end

  public readonly def at(index: Int): String?
    if index < 0 || index >= this.storedFields.Length
      return null
    end
    return this.storedFields[index]
  end

  public readonly def unique(): Bool
    return this.storedUnique
  end

  public readonly def descending(): Bool[]
    return arrays::generate(this.storedDescending.Length) do |index|
      return this.storedDescending[index]
    end
  end

  public readonly def predicate(): String?
    return this.storedPredicate
  end

  public readonly def expressions(): String[]
    return arrays::generate(this.storedExpressions.Length) do |index|
      return this.storedExpressions[index]
    end
  end

  public readonly def include(): String[]
    return arrays::generate(this.storedInclude.Length) do |index|
      return this.storedInclude[index]
    end
  end

  public readonly def hasFacets(): Bool
    return this.storedDescending.Length != 0 || this.storedPredicate != null || this.storedExpressions.Length != 0 || this.storedInclude.Length != 0
  end

  internal readonly def copy(): SchemaIndex
    let fields: String[] = arrays::generate(this.storedFields.Length) do |index|
      return this.storedFields[index]
    end

    return new SchemaIndex(
      this.storedName,
      fields,
      this.storedUnique,
      this.descending(),
      this.storedPredicate,
      this.expressions(),
      this.include()
    )
  end

  internal readonly def signature(): String
    var value = schemaPiece(this.storedName) + (this.storedUnique ? "1" : "0") + schemaPiece(this.storedFields.Length as String)

    for field in this.storedFields
      value = value + schemaPiece(field)
    end
    if this.hasFacets()
      value = value + "facets-v1" + schemaPiece(this.storedDescending.Length as String)
      for descending in this.storedDescending
        value = value + (descending ? "1" : "0")
      end
      let predicate = this.storedPredicate

      value = value + schemaPiece(predicate == null ? "" : predicate) + schemaPiece(this.storedExpressions.Length as String)
      for expression in this.storedExpressions
        value = value + schemaPiece(expression)
      end
      value = value + schemaPiece(this.storedInclude.Length as String)
      for field in this.storedInclude
        value = value + schemaPiece(field)
      end
    end
    return value
  end
end

class SchemaTable
  private storedIdentity: String
  private storedName: String
  private storedFields: SchemaField[]
  private storedIndexes: SchemaIndex[]
  private storedSeeds: SchemaSeed[]

  def init(
    identity: String,
    name: String,
    fields: SchemaField[],
    indexes: SchemaIndex[] = [],
    seeds: SchemaSeed[] = []
  ): Void
    this.storedIdentity = identity
    this.storedName = name
    this.storedFields = arrays::generate(fields.Length) do |index|
      return fields[index].copy()
    end
    this.storedIndexes = arrays::generate(indexes.Length) do |index|
      return indexes[index].copy()
    end
    this.storedSeeds = arrays::generate(seeds.Length) do |index|
      return seeds[index].copy()
    end
    var seedIndex = 1

    while seedIndex < this.storedSeeds.Length
      var position = seedIndex

      while position > 0 && schemaTextBefore(
        this.storedSeeds[position].keySignature(),
        this.storedSeeds[position - 1].keySignature()
      )
        let previous = this.storedSeeds[position - 1]

        this.storedSeeds[position - 1] = this.storedSeeds[position]
        this.storedSeeds[position] = previous
        position = position - 1
      end
      seedIndex = seedIndex + 1
    end
    var index = 1

    while index < this.storedFields.Length
      var position = index

      while position > 0 && schemaTextBefore(
        this.storedFields[position].identity(),
        this.storedFields[position - 1].identity()
      )
        let previous = this.storedFields[position - 1]

        this.storedFields[position - 1] = this.storedFields[position]
        this.storedFields[position] = previous
        position = position - 1
      end
      index = index + 1
    end
    index = 1
    while index < this.storedIndexes.Length
      var position = index

      while position > 0 && schemaTextBefore(
        this.storedIndexes[position].name(),
        this.storedIndexes[position - 1].name()
      )
        let previous = this.storedIndexes[position - 1]

        this.storedIndexes[position - 1] = this.storedIndexes[position]
        this.storedIndexes[position] = previous
        position = position - 1
      end
      index = index + 1
    end
  end

  public readonly def identity(): String
    return this.storedIdentity
  end

  public readonly def name(): String
    return this.storedName
  end

  public readonly def count(): Int
    return this.storedFields.Length
  end

  public readonly def at(index: Int): readonly SchemaField?
    if index < 0 || index >= this.storedFields.Length
      return null
    end
    return this.storedFields[index]
  end

  public readonly def find(identity: String): readonly SchemaField?
    for field in this.storedFields
      if field.identity() == identity
        return field
      end
    end
    return null
  end

  public readonly def indexCount(): Int
    return this.storedIndexes.Length
  end

  public readonly def indexAt(index: Int): readonly SchemaIndex?
    if index < 0 || index >= this.storedIndexes.Length
      return null
    end
    return this.storedIndexes[index]
  end

  public readonly def findIndex(name: String): readonly SchemaIndex?
    for index in this.storedIndexes
      if index.name() == name
        return index
      end
    end
    return null
  end

  public readonly def seedCount(): Int
    return this.storedSeeds.Length
  end

  public readonly def seedAt(index: Int): readonly SchemaSeed?
    return index < 0 || index >= this.storedSeeds.Length ? null : this.storedSeeds[index]
  end

  internal readonly def findSeed(key: String): readonly SchemaSeed?
    for seed in this.storedSeeds
      if seed.keySignature() == key
        return seed
      end
    end
    return null
  end

  internal readonly def columns(): SchemaColumn[]
    return arrays::generate(this.storedFields.Length) do |index|
      let column = this.storedFields[index].column()

      return new SchemaColumn(
        column.name(),
        schemaCloneType(column.type()),
        column.nullable(),
        column.primaryKey(),
        schemaCloneDefault(column.defaultValue()),
        schemaCloneReference(column.reference()),
        column.keyPosition(), column.defaultSql(), column.computedSql(), column.computedStored(), column.checkSql(), column.collation()
      )
    end
  end

  internal readonly def copy(): SchemaTable
    let fields: SchemaField[] = arrays::generate(this.storedFields.Length) do |index|
      return this.storedFields[index].copy()
    end
    let indexes: SchemaIndex[] = arrays::generate(this.storedIndexes.Length) do |index|
      return this.storedIndexes[index].copy()
    end

    let seeds = arrays::generate<SchemaSeed>(this.storedSeeds.Length) do |index|
      return this.storedSeeds[index].copy()
    end

    return new SchemaTable(this.storedIdentity, this.storedName, fields, indexes, seeds)
  end

  internal readonly def signature(): String
    var value = schemaPiece(this.storedIdentity) + schemaPiece(this.storedName) + schemaPiece(this.storedFields.Length as String)

    for field in this.storedFields
      value = value + schemaPiece(field.identity()) + schemaPiece(schemaColumnCode(field.column()))
    end
    value = value + schemaPiece(this.storedIndexes.Length as String)
    for index in this.storedIndexes
      value = value + schemaPiece(index.signature())
    end
    if this.storedSeeds.Length > 0
      value = value + "seed-v1" + schemaPiece(this.storedSeeds.Length as String)
      for seed in this.storedSeeds
        value = value + schemaPiece(seed.signature())
      end
    end
    return value
  end
end

## A copied, canonical desired model; it is independent of database inspection.
class SchemaModel
  private storedTables: SchemaTable[]

  def init(tables: SchemaTable[]): Void
    this.storedTables = arrays::generate(tables.Length) do |index|
      return tables[index].copy()
    end
    var index = 1

    while index < this.storedTables.Length
      var position = index

      while position > 0 && schemaTextBefore(
        this.storedTables[position].identity(),
        this.storedTables[position - 1].identity()
      )
        let previous = this.storedTables[position - 1]

        this.storedTables[position - 1] = this.storedTables[position]
        this.storedTables[position] = previous
        position = position - 1
      end
      index = index + 1
    end
  end

  public readonly def count(): Int
    return this.storedTables.Length
  end

  public readonly def at(index: Int): readonly SchemaTable?
    if index < 0 || index >= this.storedTables.Length
      return null
    end
    return this.storedTables[index]
  end

  public readonly def find(identity: String): readonly SchemaTable?
    for table in this.storedTables
      if table.identity() == identity
        return table
      end
    end
    return null
  end

  public readonly def signature(): String
    var value = "model-v1" + schemaPiece(this.storedTables.Length as String)

    for table in this.storedTables
      value = value + schemaPiece(table.signature())
    end
    return value
  end

  public readonly def validate(checkReferences: Bool = true): String?
    if this.storedTables.Length > 1000
      return "schema model exceeds 1000 tables"
    end
    var fieldCount = 0
    var indexCount = 0
    var seedCount = 0
    var position = 0

    for table in this.storedTables
      if table.identity() == "" || table.count() == 0
        return "schema table requires a logical identity and fields"
      end
      seedCount = seedCount + table.seedCount()
      if seedCount > 1000
        return "schema model exceeds 1000 seed rows"
      end
      var seedIndex = 0
      var previousSeed = ""

      while seedIndex < table.seedCount()
        let seed = table.seedAt(seedIndex)

        if seed == null
          return "schema seed is missing"
        end
        let seedFailure = seed.validate(table)

        if seedFailure != null
          return seedFailure
        end
        if seedIndex > 0 && seed.keySignature() == previousSeed
          return "duplicate schema seed primary key"
        end
        previousSeed = seed.keySignature()
        seedIndex = seedIndex + 1
      end
      fieldCount = fieldCount + table.count()
      indexCount = indexCount + table.indexCount()
      if fieldCount > 1000 || indexCount > 1000
        return "schema model exceeds 1000 fields or indexes"
      end
      var earlier = 0

      while earlier < position
        let other = this.storedTables[earlier]

        if other.identity() == table.identity() || schemaSameIdentifier(other.name(), table.name())
          return "duplicate schema table identity or name"
        end
        earlier = earlier + 1
      end
      match compileSchema(schemaTableCreate(table), SqlDialect.QuestionMark())
        case SchemaCompileResult.Failure(message)
          return message
        case SchemaCompileResult.Statement(sql)
      end
      var fieldIndex = 0
      var previousIdentity = ""

      while fieldIndex < table.count()
        let field = table.at(fieldIndex)

        if field == null
          return "schema field is missing"
        end
        if field.identity() == "" || (fieldIndex > 0 && field.identity() == previousIdentity)
          return "duplicate or empty schema field identity"
        end
        previousIdentity = field.identity()
        fieldIndex = fieldIndex + 1
      end
      var ordinal = 0

      while ordinal < table.indexCount()
        let index = table.indexAt(ordinal)

        if index == null || index.count() + index.expressions().Length == 0 || index.count() + index.expressions().Length > 1000
          return "schema index requires from 1 through 1000 fields"
        end
        for other in this.storedTables
          if schemaSameIdentifier(index.name(), other.name())
            return "schema index name collides with table name"
          end
          var otherOrdinal = 0

          while otherOrdinal < other.indexCount()
            let otherIndex = other.indexAt(otherOrdinal)

            if otherIndex != null && (other.identity() != table.identity() || otherOrdinal != ordinal) && schemaSameIdentifier(
              index.name(),
              otherIndex.name()
            )
              return "duplicate schema index name"
            end
            otherOrdinal = otherOrdinal + 1
          end
        end
        var keyIndex = 0

        while keyIndex < index.count()
          let identity = index.at(keyIndex)

          if identity == null || table.find(identity) == null
            return "schema index references an unknown logical field"
          end
          keyIndex = keyIndex + 1
        end
        for identity in index.include()
          if table.find(identity) == null
            return "schema index includes an unknown logical field"
          end
        end
        match compileSchema(
          schemaIndexCreate(table, index),
          index.include().Length == 0 ? SqlDialect.QuestionMark() : SqlDialect.PostgreSql()
        )
          case SchemaCompileResult.Failure(message)
            return message
          case SchemaCompileResult.Statement(sql)
        end
        ordinal = ordinal + 1
      end
      if checkReferences
        let referenceError = schemaModelReferences(this, table)

        if referenceError != null
          return referenceError
        end
      end
      position = position + 1
    end
    return null
  end
end

def schemaTableCreate(table: readonly SchemaTable): SchemaOp
  return SchemaOp.CreateTable(table.name(), table.columns())
end

def schemaIndexCreate(table: readonly SchemaTable, index: readonly SchemaIndex): SchemaOp
  let fields: String[] = arrays::generate(index.count()) do |position|
    let identity = index.at(position)

    if identity == null
      return ""
    end
    let field = table.find(identity)

    return field == null ? "" : field.column().name()
  end

  let included = index.include()
  let include: String[] = arrays::generate(included.Length) do |position|
    let field = table.find(included[position])

    return field == null ? "" : field.column().name()
  end
  let facets = index.hasFacets() ? new SchemaIndex(
    index.name(),
    fields,
    index.unique(),
    index.descending(),
    index.predicate(),
    index.expressions(),
    include
  ) : null

  return SchemaOp.CreateIndex(index.name(), table.name(), fields, index.unique(), facets)
end
