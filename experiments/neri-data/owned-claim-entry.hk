namespace neri_data

class OwnedClaimEntry<O>
  public value: O
  public token: OwnedValueToken
  public live: fn(): Bool
  public next: OwnedClaimEntry<O>?

  def init(value: O, token: OwnedValueToken, live: fn(): Bool, next: OwnedClaimEntry<O>?): Void
    this.value = value
    this.token = token
    this.live = live
    this.next = next
  end
end
