use neri_data
use test
use quotation
use tasks

class ShapeRecord
  public id: Int
  public name: String
  public nickname: String?

  def init(id: Int, name: String, nickname: String? = null): Void
    this.id = id
    this.name = name
    this.nickname = nickname
  end
end

class ShapePair
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class ShapeSummary
  public pair: ShapePair
  public nickname: String?
  public duplicateId: Int

  def init(pair: ShapePair, nickname: String?, duplicateId: Int): Void
    this.pair = pair
    this.nickname = nickname
    this.duplicateId = duplicateId
  end
end

class ShapeCalls
  public pair: Int = 0
  public summary: Int = 0
  public decoded: Int = 0
end

class ShapeProvider: Provider
  public rows: RawRow[] = []
  public calls: Int = 0
  public seenSql: String = ""

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    this.seenSql = plan.sql()
    return ProviderResult.Rows(this.rows)
  end
end

def rejectShapeEntity(row: RawRow): DecodeResult<ShapeRecord>
  return DecodeResult<ShapeRecord>.Failure(QueryFailure.Provider("entity decoder should not run"))
end

def addShapeIds(first: Int, second: Int): Int
  return first + second
end

def shapeQuery(): Query<ShapeRecord>
  let mapping = new EntityMapping("ShapeRecord", "shape_records", [new MappingColumn("ShapeRecord.id", "Int", "id"), new MappingColumn("ShapeRecord.name", "String", "name"), new MappingColumn("ShapeRecord.nickname", "String?", "nickname")])
  let decoder = new Decoder<ShapeRecord>(rejectShapeEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<ShapeRecord>("shape_records", decoder, mapping: mapping)
end

def rejectMalformedScalar(tree: quotation::Tree): Void
  let mapping = new EntityMapping("ShapeRecord", "shape_records", [new MappingColumn("ShapeRecord.id", "Int", "id")])

  match compileScalarQuotation(mapping, tree, tree.resultType(), new CompileState(), SqlDialect.QuestionMark())
    case ScalarSqlResult.Failure(error)
      test::assertTrue(true)
    case ScalarSqlResult.Value(value)
      test::assertTrue(false)
  end
end

def verifyScalarTreeBoundaries(): Void
  let repeated: quotation::Node[] = tasks::generate(12, 1) do |index|
    if index == 0
      return new quotation::Node(quotation::NodeKind.BoolLiteral(), "Bool", boolValue: true)
    end
    return new quotation::Node(quotation::NodeKind.And(), "Bool", index - 1, index - 1)
  end

  rejectMalformedScalar(new quotation::Tree(repeated, [], 11, ["ShapeRecord"], "Bool"))
  rejectMalformedScalar(new quotation::Tree([
        new quotation::Node(quotation::NodeKind.Not(), "Bool", 0)
      ], [], 0, ["ShapeRecord"], "Bool"))
  rejectMalformedScalar(new quotation::Tree([
        new quotation::Node(quotation::NodeKind.BoolLiteral(), "Bool", boolValue: true),
        new quotation::Node(quotation::NodeKind.IntLiteral(), "Int", intValue: 1),
        new quotation::Node(quotation::NodeKind.Conditional(), "Int", 0, 1)
      ], [], 2, ["ShapeRecord"], "Int"))
  rejectMalformedScalar(new quotation::Tree([
        new quotation::Node(quotation::NodeKind.TextLiteral(), "String", textValue: "1"),
        new quotation::Node(quotation::NodeKind.IntLiteral(), "Int", intValue: 1),
        new quotation::Node(quotation::NodeKind.Add(), "Int", 0, 1)
      ], [], 2, ["ShapeRecord"], "Int"))
end

def main(): Void
  verifyScalarTreeBoundaries()
  let byId: quote fn(ShapeRecord): Int = quote do |item: ShapeRecord|: Int
    return item.id
  end
  let byName: quote fn(ShapeRecord): String = quote do |item: ShapeRecord|: String
    return item.name
  end
  let byNickname: quote fn(ShapeRecord): String? = quote do |item: ShapeRecord|: String?
    return item.nickname
  end
  let calls = new ShapeCalls()
  let read: fn(Cell): DecodeResult<Int> = fn(cell: Cell): DecodeResult<Int>
    calls.decoded = calls.decoded + 1
    return decodeScalarInt(cell)
  end
  let countingInt = new ScalarCodec<Int>(read, ResultColumnKind.Int(), false, "Int")
  let pair: fn(Int, String): ShapePair = fn(id: Int, name: String): ShapePair
    calls.pair = calls.pair + 1
    return new ShapePair(id, name)
  end
  let summary: fn(ShapePair, String?): ShapeSummary = fn(value: ShapePair, nickname: String?): ShapeSummary
    calls.summary = calls.summary + 1
    return new ShapeSummary(value, nickname, value.id)
  end
  let shape = combineShapes(combineShapes(fieldShape(countingInt, byId), fieldShape(textScalar(), byName), pair), fieldShape(optionalTextScalar(), byNickname), summary)
  let projection = project(shapeQuery().take(2), shape)
  let provider = new ShapeProvider()

  provider.rows = [new RawRow([new RawColumn("__neri_shape_0", Cell.Int(7)), new RawColumn("__neri_shape_1", Cell.Text("Ada")), new RawColumn("__neri_shape_2", Cell.Null())])]
  match projection.compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().columns().count(), 3)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  match projection.all(provider)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.pair.id, 7)
        test::assertEqual(first.value.pair.name, "Ada")
        test::assertTrue(first.value.nickname == null)
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(calls.pair, 1)
  test::assertEqual(calls.summary, 1)
  test::assertEqual(calls.decoded, 1)
  test::assertTrue(provider.seenSql != "")

  provider.rows = [new RawRow([new RawColumn("__neri_shape_0", Cell.Int(7)), new RawColumn("__neri_shape_1", Cell.Text("Ada")), new RawColumn("__neri_shape_2", Cell.Int(3))])]
  match projection.all(provider)
    case QueryResult.Failure(error)
      test::assertTrue(true)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(calls.pair, 1)
  test::assertEqual(calls.summary, 1)
  test::assertEqual(calls.decoded, 2)

  let repeated = project(shapeQuery().take(1), combineShapes(fieldShape(intScalar(), byId), fieldShape(intScalar(), byId), addShapeIds))

  match repeated.compile()
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().columns().count(), 2)
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
  let wrongMapping = new EntityMapping("ShapeRecord", "shape_records", [new MappingColumn("ShapeRecord.id", "Int", "id"), new MappingColumn("ShapeRecord.name", "Int", "name")])
  let wrongQuery = new Query<ShapeRecord>("shape_records", new Decoder<ShapeRecord>(rejectShapeEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])), mapping: wrongMapping)

  match project(wrongQuery.take(1), fieldShape(textScalar(), byName)).compile()
    case CompileResult.Failure(error)
      test::assertTrue(true)
    case CompileResult.Plan(plan)
      test::assertTrue(false)
  end
  let sourceMismatch = new Query<ShapeRecord>("other_records", new Decoder<ShapeRecord>(rejectShapeEntity, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])), mapping: wrongMapping)

  match project(sourceMismatch.take(1), fieldShape(intScalar(), byId)).compile()
    case CompileResult.Failure(error)
      test::assertTrue(true)
    case CompileResult.Plan(plan)
      test::assertTrue(false)
  end
end
