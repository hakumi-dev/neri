use host
use quotation
namespace neri_data

## An exact UTC instant retaining its whole-minute offset in the range -14:00..14:00.
class DateTimeOffset
  private utc: Int = 0
  private offset: Int = 0
  private value: String = "0001-01-01T00:00:00.0000000Z|0"

  static def minimum(): DateTimeOffset
    return new DateTimeOffset()
  end

  static def fromLocal(local: readonly DateTime, offsetMinutes: Int): DateTimeOffset?
    if offsetMinutes < -840 || offsetMinutes > 840
      return null
    end
    let ticks = calendarDateTimeTicks(local.toText()) - offsetMinutes * 600000000
    let utc = calendarTicksText(ticks)

    if utc == null
      return null
    end
    let value = new DateTimeOffset()

    value.utc = ticks
    value.offset = offsetMinutes
    value.value = utc + "|" + (offsetMinutes as String)
    return value
  end

  static def parse(text: String): DateTimeOffset?
    let length = host::stringByteLength(text)

    if length >= 20 && host::stringByteAt(text, length - 1) as Int == 90
      let local = DateTime.parse(text)

      return local == null ? null : DateTimeOffset.fromLocal(local, 0)
    end
    if length < 25 || length > 33
      return null
    end
    let sign = host::stringByteAt(text, length - 6) as Int
    let hour = calendarDigits(text, length - 5, 2)
    let minute = calendarDigits(text, length - 2, 2)

    if (sign != 43 && sign != 45) || host::stringByteAt(
      text,
      length - 3
    ) as Int != 58 || hour < 0 || hour > 14 || minute < 0 || minute > 59 || (hour == 14 && minute != 0)
      return null
    end
    let local = DateTime.parse(host::stringSlice(text, 0, length - 6) + "Z")

    return local == null ? null : DateTimeOffset.fromLocal(local, (sign == 45 ? -1 : 1) * (hour * 60 + minute))
  end

  static def fromStorage(text: String): DateTimeOffset?
    let length = host::stringByteLength(text)

    if length < 30 || length > 33 || host::stringByteAt(text, 28) as Int != 124
      return null
    end
    let utc = DateTime.parse(host::stringSlice(text, 0, 28))
    let offset = host::parseInt(host::stringSlice(text, 29, length - 29))

    if utc == null || offset == null || offset < -840 || offset > 840
      return null
    end
    let ticks = calendarDateTimeTicks(utc.toText())
    let local = calendarTicksText(ticks + offset * 600000000)

    if local == null || text != utc.toText() + "|" + (offset as String)
      return null
    end
    let value = new DateTimeOffset()

    value.utc = ticks
    value.offset = offset
    value.value = text
    return value
  end

  public readonly def toStorage(): String
    return this.value
  end

  public readonly def utcTicks(): Int
    return this.utc
  end

  public readonly def offsetMinutes(): Int
    return this.offset
  end

  public readonly def toText(): String
    let local = calendarTicksText(this.utc + this.offset * 600000000)
    let absolute = this.offset < 0 ? -this.offset : this.offset

    return local == null ? "" : host::stringSlice(
      local,
      0,
      27
    ) + (this.offset < 0 ? "-" : "+") + calendarPad(
      absolute / 60,
      2
    ) + ":" + calendarPad(
      absolute - absolute / 60 * 60,
      2
    )
  end

  public static def captureQuotation(value: readonly DateTimeOffset?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toStorage())
  end

  @operator("==")
  public readonly def equals(other: readonly DateTimeOffset): Bool
    return this.utc == other.utc
  end

  @operator("!=")
  public readonly def notEquals(other: readonly DateTimeOffset): Bool
    return this.utc != other.utc
  end

  @operator("<")
  public readonly def before(other: readonly DateTimeOffset): Bool
    return this.utc < other.utc
  end

  @operator("<=")
  public readonly def beforeOrEqual(other: readonly DateTimeOffset): Bool
    return this.utc <= other.utc
  end

  @operator(">")
  public readonly def after(other: readonly DateTimeOffset): Bool
    return this.utc > other.utc
  end

  @operator(">=")
  public readonly def afterOrEqual(other: readonly DateTimeOffset): Bool
    return this.utc >= other.utc
  end
end
