use neri_data
use quotation
use test

class JoinRecord
  public id: Int
  public groupId: Int

  def init(id: Int, groupId: Int): Void
    this.id = id
    this.groupId = groupId
  end
end

class NullableJoinRecord
  public tag: Int?

  def init(tag: Int?): Void
    this.tag = tag
  end
end

def decodeNullableJoinRecord(row: RawRow): DecodeResult<NullableJoinRecord>
  match decodeNullableInt(row, "tag")
    case DecodeResult.Failure(error)
      return DecodeResult<NullableJoinRecord>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<NullableJoinRecord>.Value(new NullableJoinRecord(value))
  end
end

def decodeJoinRecord(row: RawRow): DecodeResult<JoinRecord>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<JoinRecord>.Failure(error)
    case DecodeResult.Value(id)
      match decodeInt(row, "group_id")
        case DecodeResult.Failure(error)
          return DecodeResult<JoinRecord>.Failure(error)
        case DecodeResult.Value(groupId)
          return DecodeResult<JoinRecord>.Value(new JoinRecord(id, groupId))
      end
  end
end

class JoinProvider: Provider
  public calls: Int = 0

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    if plan.columns().count() == 3
      return ProviderResult.Rows([new RawRow([new RawColumn("__neri_l0", Cell.Int(4)), new RawColumn("__neri_r0", Cell.Null()), new RawColumn("__neri_present", Cell.Int(0))])])
    end
    if plan.columns().count() == 1
      return ProviderResult.Rows([new RawRow([new RawColumn("__neri_join_count", Cell.Int(17))])])
    end
    if plan.columns().count() == 5
      return ProviderResult.Rows([new RawRow([new RawColumn("__neri_l0", Cell.Int(1)), new RawColumn("__neri_l1", Cell.Int(7)), new RawColumn("__neri_r0", Cell.Null()), new RawColumn("__neri_r1", Cell.Null()), new RawColumn("__neri_present", Cell.Int(0))])])
    end
    return ProviderResult.Rows([new RawRow([new RawColumn("__neri_l0", Cell.Int(1)), new RawColumn("__neri_l1", Cell.Int(7)), new RawColumn("__neri_r0", Cell.Int(2)), new RawColumn("__neri_r1", Cell.Int(1))])])
  end
end

def joinRecords(provider: JoinProvider): Query<JoinRecord>
  let mapping = new EntityMapping("JoinRecord", "records", [new MappingColumn("JoinRecord.id", "Int", "id"), new MappingColumn("JoinRecord.groupId", "Int", "group_id")], "id")
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("group_id", ResultColumnKind.Int())])

  return new Query<JoinRecord>("records", new Decoder<JoinRecord>(decodeJoinRecord, columns), mapping: mapping, provider: provider)
end

def joinId(): quote fn(JoinRecord): Int
  return quote do |record: JoinRecord|: Int
    return record.id
  end
end

def joinGroup(): quote fn(JoinRecord): Int
  return quote do |record: JoinRecord|: Int
    return record.groupId
  end
end

def nullableJoinTag(): quote fn(NullableJoinRecord): Int?
  return quote do |record: NullableJoinRecord|: Int?
    return record.tag
  end
end

def nullableJoinRecords(provider: JoinProvider): Query<NullableJoinRecord>
  let mapping = new EntityMapping("NullableJoinRecord", "nullable_records", [new MappingColumn("NullableJoinRecord.tag", "Int?", "tag")])
  let columns = new ResultColumns([new ResultColumn("tag", ResultColumnKind.Int(), true)])

  return new Query<NullableJoinRecord>("nullable_records", new Decoder<NullableJoinRecord>(decodeNullableJoinRecord, columns), mapping: mapping, provider: provider)
end

def main(): Void
  let provider = new JoinProvider()
  let joined = join(joinRecords(provider).where(groupId: 7), joinRecords(provider).where(id: 8), intScalar(), joinId(), joinGroup()).take(5)

  match joined.compile(SqlDialect.PostgreSql())
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 2)
      test::assertEqual(plan.sql().sql(), "SELECT \"__neri_left\".\"id\" AS \"__neri_l0\", \"__neri_left\".\"group_id\" AS \"__neri_l1\", \"__neri_right\".\"__neri_r0\" AS \"__neri_r0\", \"__neri_right\".\"__neri_r1\" AS \"__neri_r1\" FROM (SELECT \"records\".\"id\", \"records\".\"group_id\" FROM \"records\" WHERE \"records\".\"group_id\" = $1) AS \"__neri_left\" INNER JOIN (SELECT \"__neri_right_source\".\"id\" AS \"__neri_r0\", \"__neri_right_source\".\"group_id\" AS \"__neri_r1\", 1 AS \"__neri_matched\" FROM (SELECT \"records\".\"id\", \"records\".\"group_id\" FROM \"records\" WHERE \"records\".\"id\" = $2) AS \"__neri_right_source\") AS \"__neri_right\" ON \"__neri_left\".\"id\" = \"__neri_right\".\"__neri_r1\" LIMIT 5")
  end
  match joined.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.left.id, 1)
        test::assertEqual(first.value.right.groupId, 1)
      end
  end
  match join(joinRecords(provider), joinRecords(provider), intScalar(), joinId(), joinGroup()).take(1).take(10).compile()
    case CompileResult.Failure(error)
      test::assertTrue(false)
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().limit(), 1)
  end
  match leftJoin(joinRecords(provider), joinRecords(provider), intScalar(), joinId(), joinGroup()).take(0).take(10).compile()
    case CompileResult.Plan(plan)
      test::assertTrue(false)
    case CompileResult.Failure(error)
      match error
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertEqual(value, 0)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.UnsupportedCapability(name)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
  match leftJoin(joinRecords(provider), joinRecords(provider), intScalar(), joinId(), joinGroup()).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertTrue(first.value.right == null)
      end
  end
  match leftJoin(nullableJoinRecords(provider), nullableJoinRecords(provider), optionalIntScalar(), nullableJoinTag(), nullableJoinTag()).take(1).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        let tag = first.value.left.tag

        test::assertTrue(tag != null)
        if tag != null
          test::assertEqual(tag, 4)
        end

        test::assertTrue(first.value.right == null)
      end
  end
  match join(joinRecords(provider), joinRecords(provider), intScalar(), joinId(), joinGroup()).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 17)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, 4)
  let other = new JoinProvider()

  match join(joinRecords(provider), joinRecords(other), intScalar(), joinId(), joinGroup()).take(1).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "join requires one shared provider or explicit override")
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(column, expected, actual)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
      end
  end
end
