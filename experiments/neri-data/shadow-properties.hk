use host
use reference
namespace neri_data

class ShadowProperty
  public name: String
  public value: Cell
  public next: ShadowProperty?

  def init(name: String, value: Cell): Void
    this.name = name
    this.value = value
  end
end

class ShadowEntity<T>
  public entity: T
  public first: ShadowProperty?
  public count: Int = 0
  public next: ShadowEntity<T>?

  def init(entity: T): Void
    this.entity = entity
  end
end

def shadowCellCopy(value: Cell): Cell
  match value
    case Cell.Binary(bytes)
      return Cell.Binary(copyBinary(bytes))
    case Cell.Null()
      return Cell.Null()
    case Cell.Bool(boolean)
      return Cell.Bool(boolean)
    case Cell.Int(integer)
      return Cell.Int(integer)
    case Cell.Float(number)
      return Cell.Float(number)
    case Cell.Text(text)
      return Cell.Text(text)
  end
end

## Stores mapped values separately from entity members, keyed by object identity.
## Application accessor mappings bind these values into ordinary row snapshots.
class ShadowProperties<T>
  private first: ShadowEntity<T>?
  private count: Int = 0
  private maximumEntities: Int
  private maximumProperties: Int

  def init(maximumEntities: Int = 10000, maximumProperties: Int = 64): Void
    this.maximumEntities = maximumEntities
    this.maximumProperties = maximumProperties
  end

  private def find(entity: T): ShadowEntity<T>?
    var current = this.first

    while current != null
      if reference::same(current.entity, entity)
        return current
      end
      current = current.next
    end
    return null
  end

  public def get(entity: T, name: String): CellLookup
    let entry = this.find(entity)

    if entry == null
      return CellLookup.Missing()
    end
    var property = entry.first

    while property != null
      if property.name == name
        return CellLookup.Found(shadowCellCopy(property.value))
      end
      property = property.next
    end
    return CellLookup.Missing()
  end

  public def getOrDefault(entity: T, name: String, initial: Cell): Cell
    match this.get(entity, name)
      case CellLookup.Found(value)
        return value
      case CellLookup.Missing()
        return shadowCellCopy(initial)
    end
  end

  public def set(entity: T, name: String, value: Cell): QueryFailure?
    if this.maximumEntities < 1 || this.maximumEntities > 100000 || this.maximumProperties < 1 || this.maximumProperties > 4096
      return QueryFailure.UnsupportedCapability("shadow store bounds are invalid")
    end
    if host::stringByteLength(name) == 0 || host::stringByteLength(name) > 256
      return QueryFailure.UnsupportedCapability("shadow property name must contain 1..256 UTF-8 bytes")
    end
    match value
      case Cell.Float(number)
        if !dataFloatFinite(number)
          return QueryFailure.TypeMismatch(name, "finite Float", "non-finite Float")
        end
      case Cell.Binary(bytes)
      case Cell.Null()
      case Cell.Bool(boolean)
      case Cell.Int(integer)
      case Cell.Text(text)
    end
    var entry = this.find(entity)

    if entry == null && this.count >= this.maximumEntities
      return QueryFailure.UnsupportedCapability("shadow store entity bound exceeded")
    end
    if entry != null
      var property = entry.first

      while property != null
        if property.name == name
          property.value = shadowCellCopy(value)
          return null
        end
        property = property.next
      end
      if entry.count >= this.maximumProperties
        return QueryFailure.UnsupportedCapability("shadow store property bound exceeded")
      end
    else
      let created = new ShadowEntity<T>(entity)

      created.next = this.first
      this.first = created
      this.count = this.count + 1
      entry = created
    end
    if entry == null
      return QueryFailure.UnsupportedCapability("shadow store enrollment is missing")
    end
    let property = new ShadowProperty(name, shadowCellCopy(value))

    property.next = entry.first
    entry.first = property
    entry.count = entry.count + 1
    return null
  end

  public def forget(entity: T): Void
    var current = this.first
    var previous: ShadowEntity<T>? = null

    while current != null
      if reference::same(current.entity, entity)
        if previous == null
          this.first = current.next
        else
          previous.next = current.next
        end
        this.count = this.count - 1
        return
      end
      previous = current
      current = current.next
    end
  end

  public def clear(): Void
    this.first = null
    this.count = 0
  end
end
