use host
namespace neri_data

def compareScalarText(left: String, right: String): Int
  var index = 0

  while index < host::stringByteLength(left) && index < host::stringByteLength(right)
    let difference = (host::stringByteAt(left, index) as Int) - (host::stringByteAt(right, index) as Int)

    if difference != 0
      return difference
    end
    index = index + 1
  end
  return host::stringByteLength(left) - host::stringByteLength(right)
end

def calendarDigits(value: String, start: Int, length: Int): Int
  var result = 0
  var index = start

  while index < start + length
    let byte = host::stringByteAt(value, index) as Int

    if byte < 48 || byte > 57
      return -1
    end
    result = result * 10 + byte - 48
    index = index + 1
  end
  return result
end

def decodeTextScalar<T>(row: RawRow, column: String, parse: fn(String): T?, expected: String): DecodeResult<T>
  match decodeString(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<T>.Failure(error)
    case DecodeResult.Value(text)
      let value = parse(text)

      if value == null
        return DecodeResult<T>.Failure(QueryFailure.TypeMismatch(column, expected, "invalid text value"))
      end
      return DecodeResult<T>.Value(value)
  end
end

def decodeNullableTextScalar<T>(row: RawRow, column: String, parse: fn(String): T?, expected: String): DecodeResult<T?>
  match decodeNullableString(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<T?>.Failure(error)
    case DecodeResult.Value(text)
      if text == null
        return DecodeResult<T?>.Value(null)
      end
      let value = parse(text)

      if value == null
        return DecodeResult<T?>.Failure(QueryFailure.TypeMismatch(column, expected, "invalid text value"))
      end
      return DecodeResult<T?>.Value(value)
  end
end
