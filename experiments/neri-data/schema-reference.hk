namespace neri_data

## Physical column tuples retain key order. Store each reference once on any dependent column in its tuple.
class SchemaReference
  private storedTable: String
  private storedColumns: String[]
  private storedFields: String[]
  private storedDelete: String
  private storedDeferred: Bool

  def init(
    table: String,
    columns: String[],
    fields: String[],
    onDelete: String = "NO ACTION",
    deferred: Bool = false
  ): Void
    this.storedTable = table
    this.storedColumns = tasks::generate(columns.Length, 1) do |index|
      return columns[index]
    end
    this.storedFields = tasks::generate(fields.Length, 1) do |index|
      return fields[index]
    end
    this.storedDelete = onDelete
    this.storedDeferred = deferred
  end

  public readonly def table(): String
    return this.storedTable
  end

  public readonly def count(): Int
    return this.storedColumns.Length
  end

  public readonly def columnAt(index: Int): String?
    return index < 0 || index >= this.storedColumns.Length ? null : this.storedColumns[index]
  end

  public readonly def fieldAt(index: Int): String?
    return index < 0 || index >= this.storedFields.Length ? null : this.storedFields[index]
  end

  public readonly def onDelete(): String
    return this.storedDelete
  end

  public readonly def deferred(): Bool
    return this.storedDeferred
  end

  public readonly def validate(): String?
    if !schemaTableValid(this.storedTable) || this.storedColumns.Length == 0 || this.storedColumns.Length != this.storedFields.Length || this.storedColumns.Length > 1000
      return "foreign key requires a valid table and matching nonempty column tuples"
    end
    if this.storedDelete != "NO ACTION" && this.storedDelete != "RESTRICT" && this.storedDelete != "CASCADE" && this.storedDelete != "SET NULL"
      return "unsupported database foreign-key delete action"
    end
    var index = 0

    while index < this.storedColumns.Length
      if !identifierValid(this.storedColumns[index]) || !identifierValid(this.storedFields[index])
        return "invalid foreign-key column identifier"
      end
      var prior = 0

      while prior < index
        if schemaSameIdentifier(
          this.storedColumns[prior],
          this.storedColumns[index]
        ) || schemaSameIdentifier(
          this.storedFields[prior],
          this.storedFields[index]
        )
          return "duplicate foreign-key column"
        end
        prior = prior + 1
      end
      index = index + 1
    end
    return null
  end
end

def schemaCloneReference(reference: readonly SchemaReference?): SchemaReference?
  if reference == null
    return null
  end
  let columns: String[] = tasks::generate(reference.count(), 1) do |index|
    return schemaReferenceName(reference.columnAt(index))
  end
  let fields: String[] = tasks::generate(reference.count(), 1) do |index|
    return schemaReferenceName(reference.fieldAt(index))
  end

  return new SchemaReference(reference.table(), columns, fields, reference.onDelete(), reference.deferred())
end

def schemaReferenceCode(reference: readonly SchemaReference?): String
  if reference == null
    return ""
  end
  var output = "R" + schemaPiece(reference.table()) + schemaPiece(reference.onDelete()) + schemaPiece(reference.count() as String)
  var index = 0

  while index < reference.count()
    output = output + schemaPiece(schemaReferenceName(reference.columnAt(index))) + schemaPiece(schemaReferenceName(reference.fieldAt(index)))
    index = index + 1
  end
  return output + (reference.deferred() ? "D1" : "")
end

def schemaPhysicalField(table: readonly SchemaTable, name: String): readonly SchemaField?
  var index = 0

  while index < table.count()
    let field = table.at(index)

    if field != null && schemaSameIdentifier(field.column().name(), name)
      return field
    end
    index = index + 1
  end
  return null
end

def schemaReferenceUnique(table: readonly SchemaTable, reference: readonly SchemaReference): Bool
  var keys = 0
  var position = 0

  while position < table.count()
    let field = table.at(position)

    if field != null && field.column().primaryKey()
      keys = keys + 1
    end
    position = position + 1
  end
  var primaryMatches = keys == reference.count()

  position = 0
  while position < reference.count()
    let name = reference.columnAt(position)
    let field = name == null ? null : schemaPhysicalField(table, name)

    if field == null || !field.column().primaryKey()
      primaryMatches = false
    end
    position = position + 1
  end
  if primaryMatches
    return true
  end
  position = 0
  while position < table.indexCount()
    let index = table.indexAt(position)

    if index != null && index.unique() && index.predicate() == null && index.expressions().Length == 0 && index.count() == reference.count()
      var matches = true
      var key = 0

      while key < index.count()
        let identity = index.at(key)
        let field = identity == null ? null : table.find(identity)

        if field == null || field.column().name() != reference.columnAt(key)
          matches = false
        end
        key = key + 1
      end
      if matches
        return true
      end
    end
    position = position + 1
  end
  return false
end

def schemaModelReferences(model: readonly SchemaModel, table: readonly SchemaTable): String?
  var index = 0

  while index < table.count()
    let field = table.at(index)
    let reference = field == null ? null : field.column().reference()

    if reference != null
      var principal: readonly SchemaTable? = null
      var targetIndex = 0

      while targetIndex < model.count()
        let candidate = model.at(targetIndex)

        if candidate != null && schemaSameIdentifier(candidate.name(), reference.table())
          principal = candidate
        end
        targetIndex = targetIndex + 1
      end
      if principal == null || !schemaReferenceUnique(principal, reference)
        return "foreign key must reference a declared primary or unique key"
      end
      var key = 0

      while key < reference.count()
        let sourceName = reference.fieldAt(key)
        let targetName = reference.columnAt(key)
        let source = sourceName == null ? null : schemaPhysicalField(table, sourceName)
        let target = targetName == null ? null : schemaPhysicalField(principal, targetName)

        if source == null || target == null || schemaTypeCode(source.column().type()) != schemaTypeCode(target.column().type())
          return "foreign-key columns require matching mapped scalar types"
        end
        if reference.onDelete() == "SET NULL" && !source.column().nullable()
          return "SET NULL foreign key requires nullable dependent columns"
        end
        key = key + 1
      end
    end
    index = index + 1
  end
  return null
end

def schemaReferenceName(value: String?): String
  return value == null ? "" : value
end
