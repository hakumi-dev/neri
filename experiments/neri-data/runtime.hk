def decodeFloat(row: RawRow, column: String): DecodeResult<Float>
  match row.value(column)
    case CellLookup.Missing()
      return DecodeResult<Float>.Failure(QueryFailure.MissingColumn(column))
    case CellLookup.Found(cell)
      match cell
        case Cell.Float(value)
          if !dataFloatFinite(value)
            return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch(column, "finite Float", "Float"))
          end
          return DecodeResult<Float>.Value(value)
        case Cell.Null()
          return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch(column, "Float", "NULL"))
        case Cell.Bool(value)
          return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch(column, "Float", "Bool"))
        case Cell.Int(value)
          return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch(column, "Float", "Int"))
        case Cell.Text(value)
          return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch(column, "Float", "String"))
      end
  end
end

def decodeNullableFloat(row: RawRow, column: String): DecodeResult<Float?>
  match row.value(column)
    case CellLookup.Missing()
      return DecodeResult<Float?>.Failure(QueryFailure.MissingColumn(column))
    case CellLookup.Found(cell)
      match cell
        case Cell.Null()
          return DecodeResult<Float?>.Value(null)
        case Cell.Float(value)
          if !dataFloatFinite(value)
            return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch(column, "finite Float?", "Float"))
          end
          return DecodeResult<Float?>.Value(value)
        case Cell.Bool(value)
          return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch(column, "Float?", "Bool"))
        case Cell.Int(value)
          return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch(column, "Float?", "Int"))
        case Cell.Text(value)
          return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch(column, "Float?", "String"))
      end
  end
end
