namespace neri_data

## Snapshot seed rows use stable logical fields, including an assigned primary key.
class SchemaSeed
  private storedKeys: String[]
  private storedKeyValues: Cell[]
  private storedFields: String[]
  private storedValues: Cell[]

  def init(keyFields: String[], keyValues: Cell[], fields: String[], values: Cell[]): Void
    this.storedKeys = schemaSeedColumnsCopy(keyFields)
    this.storedKeyValues = schemaSeedValuesCopy(keyValues)
    this.storedFields = schemaSeedColumnsCopy(fields)
    this.storedValues = schemaSeedValuesCopy(values)
    this.sort(this.storedKeys, this.storedKeyValues)
    this.sort(this.storedFields, this.storedValues)
  end

  private def sort(fields: String[], values: Cell[]): Void
    if fields.Length != values.Length
      return
    end
    var index = 1

    while index < fields.Length
      var position = index

      while position > 0 && schemaTextBefore(fields[position], fields[position - 1])
        let field = fields[position - 1]
        let value = values[position - 1]

        fields[position - 1] = fields[position]
        values[position - 1] = values[position]
        fields[position] = field
        values[position] = value
        position = position - 1
      end
      index = index + 1
    end
  end

  public readonly def keyCount(): Int
    return this.storedKeys.Length
  end

  public readonly def keyAt(index: Int): String?
    return index < 0 || index >= this.storedKeys.Length ? null : this.storedKeys[index]
  end

  public readonly def keyValueAt(index: Int): readonly Cell?
    return index < 0 || index >= this.storedKeyValues.Length ? null : this.storedKeyValues[index]
  end

  public readonly def count(): Int
    return this.storedFields.Length
  end

  public readonly def at(index: Int): String?
    return index < 0 || index >= this.storedFields.Length ? null : this.storedFields[index]
  end

  public readonly def valueAt(index: Int): readonly Cell?
    return index < 0 || index >= this.storedValues.Length ? null : this.storedValues[index]
  end

  internal readonly def copy(): SchemaSeed
    return new SchemaSeed(
      schemaSeedColumnsCopy(this.storedKeys),
      schemaSeedValuesCopy(this.storedKeyValues),
      schemaSeedColumnsCopy(this.storedFields),
      schemaSeedValuesCopy(this.storedValues)
    )
  end

  internal readonly def keySignature(): String
    return schemaSeedTupleCode(this.storedKeys, this.storedKeyValues)
  end

  internal readonly def signature(): String
    return this.keySignature() + schemaSeedTupleCode(this.storedFields, this.storedValues)
  end

  internal readonly def validate(table: readonly SchemaTable): String?
    if this.storedKeys.Length == 0 || this.storedKeys.Length != this.storedKeyValues.Length || this.storedFields.Length != this.storedValues.Length || this.storedKeys.Length + this.storedFields.Length > 1000
      return "model seed requires matching bounded field/value tuples and an assigned primary key"
    end
    var keyCount = 0
    var index = 0

    while index < table.count()
      let field = table.at(index)

      if field != null && field.column().primaryKey()
        keyCount = keyCount + 1
      end
      index = index + 1
    end
    if keyCount != this.storedKeys.Length
      return "model seed must supply the complete primary key"
    end
    index = 0
    while index < this.storedKeys.Length + this.storedFields.Length
      let key = index < this.storedKeys.Length
      let position = key ? index : index - this.storedKeys.Length
      let identity = key ? this.storedKeys[position] : this.storedFields[position]
      let value = key ? this.storedKeyValues[position] : this.storedValues[position]
      let field = table.find(identity)

      if field == null || field.column().primaryKey() != key
        return "model seed field is unknown or has an incorrect key role"
      end
      if position > 0
        let previous = key ? this.storedKeys[position - 1] : this.storedFields[position - 1]

        if identity == previous
          return "model seed contains duplicate fields"
        end
      end
      if !schemaSeedValueMatches(value, field.column())
        return "model seed value does not match its column type or nullability"
      end
      index = index + 1
    end
    index = 0
    while index < table.count()
      let field = table.at(index)

      if field != null && !field.column().primaryKey() && !field.column().nullable() && field.column().defaultValue() == null
        var found = false

        for identity in this.storedFields
          found = found || identity == field.identity()
        end
        if !found
          return "model seed omits a required field without a default"
        end
      end
      index = index + 1
    end
    return null
  end

  internal readonly def operation(table: readonly SchemaTable, insert: Bool): SchemaOp
    let keys = arrays::generate<String>(this.storedKeys.Length) do |index|
      let field = table.find(this.storedKeys[index])

      return field == null ? "" : field.column().name()
    end
    let keyValues = schemaSeedValuesCopy(this.storedKeyValues)
    let columns = arrays::generate<String>(this.storedFields.Length) do |index|
      let field = table.find(this.storedFields[index])

      return field == null ? "" : field.column().name()
    end
    let values = schemaSeedValuesCopy(this.storedValues)

    if !insert
      return SchemaOp.DeleteData(table.name(), keys, keyValues)
    end
    let allColumns = arrays::generate<String>(keys.Length + columns.Length) do |index|
      return index < keys.Length ? keys[index] : columns[index - keys.Length]
    end
    let allValues = arrays::generate<Cell>(keyValues.Length + values.Length) do |index|
      let value = index < keyValues.Length ? keyValues[index] : values[index - keyValues.Length]

      match value
        case Cell.Null()
          return Cell.Null()
        case Cell.Int(item)
          return Cell.Int(item)
        case Cell.Bool(item)
          return Cell.Bool(item)
        case Cell.Float(item)
          return Cell.Float(item)
        case Cell.Text(item)
          return Cell.Text(item)
        case Cell.Binary(item)
          return Cell.Binary(copyBinary(item))
      end
    end

    return SchemaOp.InsertData(table.name(), allColumns, allValues)
  end

  internal readonly def update(table: readonly SchemaTable): SchemaOp
    let keys = arrays::generate<String>(this.storedKeys.Length) do |index|
      let field = table.find(this.storedKeys[index])

      return field == null ? "" : field.column().name()
    end
    let columns = arrays::generate<String>(this.storedFields.Length) do |index|
      let field = table.find(this.storedFields[index])

      return field == null ? "" : field.column().name()
    end

    return SchemaOp.UpdateData(
      table.name(),
      keys,
      schemaSeedValuesCopy(this.storedKeyValues),
      columns,
      schemaSeedValuesCopy(this.storedValues)
    )
  end
end

def schemaSeedValueMatches(value: readonly Cell, column: readonly SchemaColumn): Bool
  match value
    case Cell.Null()
      return column.nullable() && !column.primaryKey()
    case Cell.Int(item)
      return schemaTypeCode(column.type()) == "I"
    case Cell.Bool(item)
      return schemaTypeCode(column.type()) == "B"
    case Cell.Float(item)
      return schemaTypeCode(column.type()) == "F" && dataFloatFinite(item)
    case Cell.Text(item)
      return schemaTypeCode(column.type()) == "T"
    case Cell.Binary(item)
      return schemaTypeCode(column.type()) == "Y"
  end
end

class SchemaSeedOrder
  internal tables: TypedRows<SchemaTable> = new TypedRows<SchemaTable>()
  internal failure: String?

  def init(model: SchemaModel): Void
    var remaining = 0
    var index = 0

    while index < model.count()
      let table = model.at(index)

      if table != null && table.seedCount() > 0
        remaining = remaining + 1
      end
      index = index + 1
    end
    while remaining > 0
      var progress = false

      index = 0
      while index < model.count()
        let table = model.at(index)

        if table != null && table.seedCount() > 0 && !this.contains(table.identity()) && this.ready(model, table)
          this.tables.add(table.copy())
          remaining = remaining - 1
          progress = true
        end
        index = index + 1
      end
      if !progress
        this.failure = "model seed foreign-key cycles require an explicitly ordered migration catalog"
        return
      end
    end
  end

  private def contains(identity: String): Bool
    var current = this.tables.first()

    while current != null
      if current.value.identity() == identity
        return true
      end
      current = current.next
    end
    return false
  end

  private def ready(model: SchemaModel, table: readonly SchemaTable): Bool
    var fieldIndex = 0

    while fieldIndex < table.count()
      let field = table.at(fieldIndex)
      let reference = field == null ? null : field.column().reference()

      if reference != null
        var targetIndex = 0

        while targetIndex < model.count()
          let target = model.at(targetIndex)

          if target != null && target.seedCount() > 0 && schemaSameIdentifier(
            target.name(),
            reference.table()
          ) && !this.contains(target.identity())
            return false
          end
          targetIndex = targetIndex + 1
        end
      end
      fieldIndex = fieldIndex + 1
    end
    return true
  end
end

def schemaDiffRemoveSeeds(from: SchemaModel, to: SchemaModel, ops: SchemaDiffOps): String?
  let order = new SchemaSeedOrder(from)
  let tables = navigationArray(order.tables)

  if order.failure != null
    return order.failure
  end
  var index = tables.Length - 1

  while index >= 0
    let table = tables[index]
    let target = to.find(table.identity())
    var seedIndex = 0

    while seedIndex < table.seedCount()
      let seed = table.seedAt(seedIndex)

      if seed != null && (target == null || target.findSeed(seed.keySignature()) == null)
        ops.add(seed.operation(table, false), true)
      end
      seedIndex = seedIndex + 1
    end
    index = index - 1
  end
  return null
end

def schemaDiffApplySeeds(from: SchemaModel, to: SchemaModel, ops: SchemaDiffOps): String?
  let order = new SchemaSeedOrder(to)

  if order.failure != null
    return order.failure
  end
  var current = order.tables.first()

  while current != null
    let table = current.value
    let previous = from.find(table.identity())
    var index = 0

    while index < table.seedCount()
      let seed = table.seedAt(index)

      if seed != null
        let oldSeed = previous == null ? null : previous.findSeed(seed.keySignature())

        if oldSeed == null
          ops.add(seed.operation(table, true))
        else if oldSeed.signature() != seed.signature()
          if previous != null && schemaSeedParentRemoval(from, to, previous)
            return "seed relationship rewrites alongside principal removal require an explicitly ordered migration catalog"
          end
          var oldIndex = 0

          while oldIndex < oldSeed.count()
            let identity = oldSeed.at(oldIndex)
            var supplied = false
            var nextIndex = 0

            while nextIndex < seed.count()
              supplied = supplied || seed.at(nextIndex) == identity
              nextIndex = nextIndex + 1
            end
            if !supplied && identity != null && table.find(identity) != null
              return "removing a managed seed field requires an explicit replacement value"
            end
            oldIndex = oldIndex + 1
          end
          if seed.count() > 0
            ops.add(seed.update(table))
          end
        end
      end
      index = index + 1
    end
    current = current.next
  end
  return null
end

def schemaSeedParentRemoval(from: SchemaModel, to: SchemaModel, table: readonly SchemaTable): Bool
  var fieldIndex = 0

  while fieldIndex < table.count()
    let field = table.at(fieldIndex)
    let reference = field == null ? null : field.column().reference()

    if reference != null
      var index = 0

      while index < from.count()
        let parent = from.at(index)

        if parent != null && schemaSameIdentifier(parent.name(), reference.table())
          let target = to.find(parent.identity())
          var seedIndex = 0

          while seedIndex < parent.seedCount()
            let seed = parent.seedAt(seedIndex)

            if seed != null && (target == null || target.findSeed(seed.keySignature()) == null)
              return true
            end
            seedIndex = seedIndex + 1
          end
        end
        index = index + 1
      end
    end
    fieldIndex = fieldIndex + 1
  end
  return false
end
