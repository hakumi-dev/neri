use neri_data
use test
use console

def valid(op: SchemaOp, expected: String): Void
  match compileSchema(op, SqlDialect.QuestionMark())
    case SchemaCompileResult.Statement(sql)
      test::assertEqual(sql, expected)
    case SchemaCompileResult.Failure(message)
      test::assertTrue(false)
  end
end

def invalid(op: SchemaOp): Void
  match compileSchema(op, SqlDialect.QuestionMark())
    case SchemaCompileResult.Statement(sql)
      test::assertTrue(false)
    case SchemaCompileResult.Failure(message)
      test::assertTrue(message != "")
  end
end

def verifyRebuildMetadata(): Void
  console::println("migration metadata: rebuild validation")
  let id = new SchemaField("record-id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true))
  let value = new SchemaField("record-value", new SchemaColumn("value", SchemaType.Text(), nullable: true))
  let source = new SchemaTable("records", "records", [id, value])
  let target = new SchemaTable("records", "records", [id, new SchemaField("record-value", new SchemaColumn("value", SchemaType.Text(), defaultValue: SchemaDefault.Text("next")))])
  let rebuild = new Migration("rebuild", [SchemaOp.RebuildTable(source, target)], [SchemaOp.RebuildTable(target, source)])

  let validation = (new MigrationSet([rebuild])).validate()

  if validation != null
    console::println(validation)
  end

  test::assertTrue(validation == null)
  invalid(SchemaOp.RebuildTable(source, target))

  let differentDefault = new SchemaTable("records", "records", [id, new SchemaField("record-value", new SchemaColumn("value", SchemaType.Text(), defaultValue: SchemaDefault.Text("other")))])
  let changed = new Migration("rebuild", [SchemaOp.RebuildTable(source, differentDefault)], [SchemaOp.RebuildTable(differentDefault, source)])
  let differentIdentity = new SchemaTable("other-records", "records", [id, value])
  let changedKey = new SchemaTable("records", "records", [new SchemaField("record-id", new SchemaColumn("id", SchemaType.Text(), primaryKey: true)), value])
  let requiredAddition = new SchemaTable("records", "records", [id, value, new SchemaField("required", new SchemaColumn("required", SchemaType.Text()))])

  test::assertTrue(rebuild.signature() != changed.signature())
  console::println("migration metadata: invalid rebuild declarations")
  for rejected in [differentIdentity, changedKey, requiredAddition]
    let invalidMigration = new Migration("invalid_rebuild", [SchemaOp.RebuildTable(source, rejected)], [SchemaOp.RebuildTable(rejected, source)])

    test::assertTrue((new MigrationSet([invalidMigration])).validate() != null)
  end
  let duplicate = new Migration("duplicate_rebuild", [SchemaOp.RebuildTable(source, target), SchemaOp.RebuildTable(source, target)], [SchemaOp.RebuildTable(target, source)])

  test::assertTrue((new MigrationSet([duplicate])).validate() != null)
  console::println("migration metadata: primary-key physical rename")
  let renamedKey = new SchemaTable("records", "records", [new SchemaField("record-id", new SchemaColumn("record_key", SchemaType.Int(), primaryKey: true)), value])

  match diffSchema("rename_key", new SchemaModel([source]), new SchemaModel([renamedKey]))
    case SchemaDiffResult.Plan(plan)
      test::assertFalse(plan.upDataLoss())
      test::assertFalse(plan.downDataLoss())
    case SchemaDiffResult.Unchanged()
      test::assertTrue(false)
    case SchemaDiffResult.Failure(error)
      test::assertTrue(false)
  end
end

def main(): Void
  verifyRebuildMetadata()
  console::println("migration metadata: legacy operations")
  let id = new SchemaColumn("id", SchemaType.Int(), primaryKey: true)
  let name = new SchemaColumn("name", SchemaType.Text(), defaultValue: SchemaDefault.Text("O'Brien"))
  let columns = [id, name]
  let create = SchemaOp.CreateTable("people", columns)

  valid(create, "CREATE TABLE \"people\" (\"id\" INTEGER PRIMARY KEY, \"name\" TEXT NOT NULL DEFAULT 'O''Brien')")
  valid(SchemaOp.AddColumn("people", new SchemaColumn("active", SchemaType.Bool(), defaultValue: SchemaDefault.Bool(false))), "ALTER TABLE \"people\" ADD COLUMN \"active\" INTEGER NOT NULL DEFAULT 0")
  valid(SchemaOp.DropColumn("people", "active"), "ALTER TABLE \"people\" DROP COLUMN \"active\"")
  valid(SchemaOp.RenameTable("people", "persons"), "ALTER TABLE \"people\" RENAME TO \"persons\"")
  valid(SchemaOp.RenameColumn("people", "name", "display_name"), "ALTER TABLE \"people\" RENAME COLUMN \"name\" TO \"display_name\"")
  valid(SchemaOp.CreateIndex("people_name", "people", ["name"], true), "CREATE UNIQUE INDEX \"people_name\" ON \"people\" (\"name\")")
  valid(SchemaOp.DropIndex("people_name"), "DROP INDEX \"people_name\"")
  valid(SchemaOp.DropTable("people"), "DROP TABLE \"people\"")
  valid(SchemaOp.AddColumn("people", new SchemaColumn("ratio", SchemaType.Float(), defaultValue: SchemaDefault.Float(1.25))), "ALTER TABLE \"people\" ADD COLUMN \"ratio\" REAL NOT NULL DEFAULT 1.25")
  valid(SchemaOp.AddColumn("people", new SchemaColumn("optional_ratio", SchemaType.Float(), nullable: true)), "ALTER TABLE \"people\" ADD COLUMN \"optional_ratio\" REAL")
  valid(SchemaOp.AddColumn("people", new SchemaColumn("nickname", SchemaType.Text(), nullable: true, defaultValue: SchemaDefault.Null())), "ALTER TABLE \"people\" ADD COLUMN \"nickname\" TEXT DEFAULT NULL")
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("name", SchemaType.Text(), defaultValue: SchemaDefault.Null())))
  invalid(SchemaOp.CreateTable("people", [new SchemaColumn("id", SchemaType.Int(), primaryKey: true, defaultValue: SchemaDefault.Null())]))
  let absentDefault = new Migration("optional", [SchemaOp.AddColumn("people", new SchemaColumn("nickname", SchemaType.Text(), nullable: true))], [SchemaOp.DropColumn("people", "nickname")])
  let nullDefault = new Migration("optional", [SchemaOp.AddColumn("people", new SchemaColumn("nickname", SchemaType.Text(), nullable: true, defaultValue: SchemaDefault.Null()))], [SchemaOp.DropColumn("people", "nickname")])

  test::assertTrue(absentDefault.signature() != nullDefault.signature())
  test::assertTrue((new MigrationSet([nullDefault])).validate() == null)
  invalid(SchemaOp.CreateTable("bad_float_key", [new SchemaColumn("id", SchemaType.Float(), primaryKey: true)]))
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("ratio", SchemaType.Float(), defaultValue: SchemaDefault.Int(1))))
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("ratio", SchemaType.Int(), defaultValue: SchemaDefault.Float(1.0))))
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("ratio", SchemaType.Float(), defaultValue: SchemaDefault.Float(1.0 / 0.0))))
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("ratio", SchemaType.Float(), defaultValue: SchemaDefault.Float(0.0 / 0.0))))
  invalid(SchemaOp.CreateTable("__NERI_migrations", columns))
  invalid(SchemaOp.CreateTable("people", [id, new SchemaColumn("ID", SchemaType.Int())]))
  invalid(SchemaOp.AddColumn("people", new SchemaColumn("missing", SchemaType.Text())))
  invalid(SchemaOp.CreateIndex("idx", "people", ["name", "NAME"], false))
  invalid(SchemaOp.RenameColumn("people", "Name", "name"))
  let operations = [create]
  let migration = new Migration("first", operations, [SchemaOp.DropTable("people")])
  let original = migration.signature()

  columns[1] = new SchemaColumn("wrong", SchemaType.Text())
  operations[0] = SchemaOp.DropTable("people")

  test::assertEqual(migration.signature(), original)
  let second = new Migration("second", [SchemaOp.AddColumn("people", new SchemaColumn("active", SchemaType.Bool(), defaultValue: SchemaDefault.Bool(true)))], [SchemaOp.DropColumn("people", "active")])
  let items = [migration, second]
  let catalog = new MigrationSet(items)

  items[0] = second

  test::assertTrue(catalog.validate() == null)
  test::assertTrue(catalog.historyPrefix([]) == null)
  test::assertTrue(catalog.historyPrefix([new MigrationStamp("first", migration.signature())]) == null)
  test::assertTrue(catalog.historyPrefix([new MigrationStamp("first", "modified")]) != null)
  test::assertTrue(catalog.historyPrefix([new MigrationStamp("second", second.signature())]) != null)
  test::assertTrue(catalog.historyPrefix([new MigrationStamp("first", migration.signature()), new MigrationStamp("second", second.signature()), new MigrationStamp("extra", "x")]) != null)
  test::assertTrue((new MigrationSet([migration, new Migration("FIRST", [], [])])).validate() != null)
  test::assertTrue((new MigrationSet([new Migration("dup", [create, create], [])])).validate() != null)
  test::assertTrue((new MigrationSet([new Migration("dup", [create, SchemaOp.CreateTable("PEOPLE", [id])], [SchemaOp.DropTable("people")])])).validate() != null)
  test::assertTrue((new MigrationSet([new Migration("bad", [SchemaOp.AddColumn("people", new SchemaColumn("required", SchemaType.Text()))], [])])).validate() != null)
end
