namespace graph_registration_data

## Describes the mapped tables and columns for schema comparison.
def schema_GraphRegistrationDatabase(): neri_data::SchemaModel
  return new neri_data::SchemaModel([
      new neri_data::SchemaTable("graph_registration_model.Account", "accounts", [
          new neri_data::SchemaField("graph_registration_model.Account.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("graph_registration_model.Account.name", new neri_data::SchemaColumn("name", neri_data::SchemaType.Text(), nullable: false, primaryKey: false))
        ]),
      new neri_data::SchemaTable("graph_registration_model.Entry", "entries", [
          new neri_data::SchemaField("graph_registration_model.Entry.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("graph_registration_model.Entry.accountId", new neri_data::SchemaColumn("account_id", neri_data::SchemaType.Int(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("graph_registration_model.Entry.parentId", new neri_data::SchemaColumn("parent_id", neri_data::SchemaType.Int(), nullable: true, primaryKey: false)),
          new neri_data::SchemaField("graph_registration_model.Entry.title", new neri_data::SchemaColumn("title", neri_data::SchemaType.Text(), nullable: false, primaryKey: false))
        ]),
      new neri_data::SchemaTable("graph_registration_model.Note", "notes", [
          new neri_data::SchemaField("graph_registration_model.Note.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("graph_registration_model.Note.entryId", new neri_data::SchemaColumn("entry_id", neri_data::SchemaType.Int(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("graph_registration_model.Note.body", new neri_data::SchemaColumn("body", neri_data::SchemaType.Text(), nullable: false, primaryKey: false))
        ], [
          new neri_data::SchemaIndex("notes_body_unique", ["graph_registration_model.Note.body"], true)
        ])
    ])
end
