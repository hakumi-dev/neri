namespace graph_registration_data

class Navigation_GraphRegistrationDatabase
  public accounts: NavigationSet_GraphRegistrationDatabase_Account
  public entries: NavigationSet_GraphRegistrationDatabase_Entry
  public notes: NavigationSet_GraphRegistrationDatabase_Note

  def init(context: GraphRegistrationDatabase): Void
    this.accounts = new NavigationSet_GraphRegistrationDatabase_Account(context)
    this.entries = new NavigationSet_GraphRegistrationDatabase_Entry(context)
    this.notes = new NavigationSet_GraphRegistrationDatabase_Note(context)
  end
end
