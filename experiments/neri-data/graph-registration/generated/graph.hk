use reference
namespace graph_registration_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_GraphRegistrationDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Account: neri_data::EntityTracker<graph_registration_model::Account>
  private visits_Account: neri_data::GraphVisitList<graph_registration_model::Account>
  private tracker_Entry: neri_data::EntityTracker<graph_registration_model::Entry>
  private visits_Entry: neri_data::GraphVisitList<graph_registration_model::Entry>
  private tracker_Note: neri_data::EntityTracker<graph_registration_model::Note>
  private visits_Note: neri_data::GraphVisitList<graph_registration_model::Note>

  def init(changes: neri_data::ChangeContext, tracker_Account: neri_data::EntityTracker<graph_registration_model::Account>, tracker_Entry: neri_data::EntityTracker<graph_registration_model::Entry>, tracker_Note: neri_data::EntityTracker<graph_registration_model::Note>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Account = tracker_Account
    this.visits_Account = new neri_data::GraphVisitList<graph_registration_model::Account>(this.graph)
    this.tracker_Entry = tracker_Entry
    this.visits_Entry = new neri_data::GraphVisitList<graph_registration_model::Entry>(this.graph)
    this.tracker_Note = tracker_Note
    this.visits_Note = new neri_data::GraphVisitList<graph_registration_model::Note>(this.graph)
  end

  def add_accounts(root: graph_registration_model::Account): neri_data::TrackHandleResult<graph_registration_model::Account>
    match this.discover_accounts(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<graph_registration_model::Account>.Failure(error)
    end
  end

  private def discover_accounts(entity: graph_registration_model::Account): neri_data::GraphVisitResult<graph_registration_model::Account>
    match this.visits_Account.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<graph_registration_model::Account>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<graph_registration_model::Account>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Account)

        if staged != null
          return neri_data::GraphVisitResult<graph_registration_model::Account>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_accounts(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<graph_registration_model::Account>.Failure(queued)
        end
        return neri_data::GraphVisitResult<graph_registration_model::Account>.New(slot)
    end
  end

  private def scan_accounts(entity: graph_registration_model::Account, owner: neri_data::GraphSlot<graph_registration_model::Account>): neri_data::QueryFailure?
    for child in entity.entries
      let inverse = child.account

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: entriesFor_Account_by_accountId")
      end
      var related: neri_data::GraphSlot<graph_registration_model::Entry>? = null

      match this.discover_entries(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_entriesFor_Account_by_accountId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_entries(root: graph_registration_model::Entry): neri_data::TrackHandleResult<graph_registration_model::Entry>
    match this.discover_entries(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<graph_registration_model::Entry>.Failure(error)
    end
  end

  private def discover_entries(entity: graph_registration_model::Entry): neri_data::GraphVisitResult<graph_registration_model::Entry>
    match this.visits_Entry.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<graph_registration_model::Entry>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<graph_registration_model::Entry>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Entry)

        if staged != null
          return neri_data::GraphVisitResult<graph_registration_model::Entry>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_entries(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<graph_registration_model::Entry>.Failure(queued)
        end
        return neri_data::GraphVisitResult<graph_registration_model::Entry>.New(slot)
    end
  end

  private def scan_entries(entity: graph_registration_model::Entry, owner: neri_data::GraphSlot<graph_registration_model::Entry>): neri_data::QueryFailure?
    let principal_entriesFor_Account_by_accountId = entity.account

    if principal_entriesFor_Account_by_accountId != null
      var related: neri_data::GraphSlot<graph_registration_model::Account>? = null

      match this.discover_accounts(principal_entriesFor_Account_by_accountId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_entriesFor_Account_by_accountId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    for child in entity.notes
      let inverse = child.entry

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: notesFor_Entry_by_entryId")
      end
      var related: neri_data::GraphSlot<graph_registration_model::Note>? = null

      match this.discover_notes(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_notesFor_Entry_by_entryId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    for child in entity.children
      let inverse = child.parent

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: entriesFor_Entry_by_parentId")
      end
      var related: neri_data::GraphSlot<graph_registration_model::Entry>? = null

      match this.discover_entries(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_entriesFor_Entry_by_parentId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    let principal_entriesFor_Entry_by_parentId = entity.parent

    if principal_entriesFor_Entry_by_parentId != null
      var related: neri_data::GraphSlot<graph_registration_model::Entry>? = null

      match this.discover_entries(principal_entriesFor_Entry_by_parentId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_entriesFor_Entry_by_parentId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_notes(root: graph_registration_model::Note): neri_data::TrackHandleResult<graph_registration_model::Note>
    match this.discover_notes(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<graph_registration_model::Note>.Failure(error)
    end
  end

  private def discover_notes(entity: graph_registration_model::Note): neri_data::GraphVisitResult<graph_registration_model::Note>
    match this.visits_Note.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<graph_registration_model::Note>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<graph_registration_model::Note>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Note)

        if staged != null
          return neri_data::GraphVisitResult<graph_registration_model::Note>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_notes(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<graph_registration_model::Note>.Failure(queued)
        end
        return neri_data::GraphVisitResult<graph_registration_model::Note>.New(slot)
    end
  end

  private def scan_notes(entity: graph_registration_model::Note, owner: neri_data::GraphSlot<graph_registration_model::Note>): neri_data::QueryFailure?
    let principal_notesFor_Entry_by_entryId = entity.entry

    if principal_notesFor_Entry_by_entryId != null
      var related: neri_data::GraphSlot<graph_registration_model::Entry>? = null

      match this.discover_entries(principal_notesFor_Entry_by_entryId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_notesFor_Entry_by_entryId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  private def link_entriesFor_Account_by_accountId(principal: neri_data::GraphSlot<graph_registration_model::Account>, dependent: neri_data::GraphSlot<graph_registration_model::Entry>, entity: graph_registration_model::Entry): neri_data::QueryFailure?
    let previous = entity.accountId
    let restore: fn(): Void = fn(): Void
      entity.accountId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_entriesFor_Account_by_accountId, restore)
  end

  private def link_notesFor_Entry_by_entryId(principal: neri_data::GraphSlot<graph_registration_model::Entry>, dependent: neri_data::GraphSlot<graph_registration_model::Note>, entity: graph_registration_model::Note): neri_data::QueryFailure?
    let previous = entity.entryId
    let restore: fn(): Void = fn(): Void
      entity.entryId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_notesFor_Entry_by_entryId, restore)
  end

  private def link_entriesFor_Entry_by_parentId(principal: neri_data::GraphSlot<graph_registration_model::Entry>, dependent: neri_data::GraphSlot<graph_registration_model::Entry>, entity: graph_registration_model::Entry): neri_data::QueryFailure?
    let previous = entity.parentId
    let restore: fn(): Void = fn(): Void
      entity.parentId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_entriesFor_Entry_by_parentId, restore)
  end
end
