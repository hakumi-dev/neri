use neri_data
use test

class StagingNode
  public id: Int = 0
  public parentId: Int = 17
  public setterCalls: Int = 0
end

def stagingCapture(entity: StagingNode): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(entity.id)), new RawColumn("parent_id", Cell.Int(entity.parentId))])
end

def stagingApply(entity: StagingNode, source: StagingNode): Void
  entity.id = source.id
  entity.parentId = source.parentId
end

def stagingId(entity: StagingNode): Int
  return entity.id
end

def stagingParent(entity: StagingNode): Int
  return entity.parentId
end

def stagingSetId(entity: StagingNode, value: Int): Void
  entity.id = value
end

def stagingSetParent(entity: StagingNode, value: Int): Void
  entity.parentId = value
end

def stagingRejectParent(entity: StagingNode, value: Int): Void
  entity.setterCalls = entity.setterCalls + 1
  entity.parentId = value - 1
end

def stagingTracker(): EntityTracker<StagingNode>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("parent_id", ResultColumnKind.Int())])

  return new EntityTracker<StagingNode>("staging_nodes", "id", columns, stagingCapture, stagingApply, true, stagingSetId)
end

def stagingSlot(graph: GraphRegistration, entity: StagingNode): GraphSlot<StagingNode>?
  let visits = new GraphVisitList<StagingNode>(graph)

  match visits.visit(entity)
    case GraphVisitResult.New(slot)
      return slot
    case GraphVisitResult.Existing(slot)
      return slot
    case GraphVisitResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def verifyStagingContracts(): Void
  let context = new ChangeContext()
  let tracker = stagingTracker()

  context.register(tracker.changeSet())
  let principal = new StagingNode()
  let dependent = new StagingNode()
  let graph = new GraphRegistration(context)
  let p = stagingSlot(graph, principal)
  let d = stagingSlot(graph, dependent)

  test::assertTrue(p != null && d != null)
  if p == null || d == null
    return
  end

  test::assertTrue(graph.stageNode(p, tracker) == null)
  test::assertTrue(graph.stageNode(d, tracker) == null)
  let badEdge: fn(TrackedHandle<StagingNode>, TrackedHandle<StagingNode>): RelationshipEdge = fn(a: TrackedHandle<StagingNode>, b: TrackedHandle<StagingNode>): RelationshipEdge
    return (new RelationshipLink<StagingNode, StagingNode>(a, b, stagingId, stagingParent, stagingRejectParent, "parent_id")).edge()
  end
  let undo: fn(): Void = fn(): Void
    dependent.parentId = 17
  end

  test::assertTrue(graph.stageLink(p, d, badEdge, undo) == null)
  match graph.enroll(p)
    case TrackHandleResult.Failure(error)
      test::assertEqual(dependent.setterCalls, 1)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
  end

  test::assertEqual(principal.id, 0)
  test::assertEqual(dependent.id, 0)
  test::assertEqual(dependent.parentId, 17)
  let retry = new GraphRegistration(context)
  let retryP = stagingSlot(retry, principal)
  let retryD = stagingSlot(retry, dependent)

  test::assertTrue(retryP != null && retryD != null)
  if retryP == null || retryD == null
    return
  end
  let edge: fn(TrackedHandle<StagingNode>, TrackedHandle<StagingNode>): RelationshipEdge = fn(a: TrackedHandle<StagingNode>, b: TrackedHandle<StagingNode>): RelationshipEdge
    return (new RelationshipLink<StagingNode, StagingNode>(a, b, stagingId, stagingParent, stagingSetParent, "parent_id")).edge()
  end

  test::assertTrue(retry.stageNode(retryP, tracker) == null)
  test::assertTrue(retry.stageNode(retryD, tracker) == null)
  test::assertTrue(retry.stageLink(retryP, retryD, edge, undo) == null)
  match retry.enroll(retryP)
    case TrackHandleResult.Tracked(handle)
      test::assertEqual(principal.id, -1)
      test::assertEqual(dependent.id, -2)
      test::assertEqual(dependent.parentId, -1)
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  match retry.enroll(retryP)
    case TrackHandleResult.Failure(error)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
  end
  let foreign = new GraphRegistration(context)

  test::assertTrue(foreign.stageNode(retryP, tracker) != null)
  let stranger = stagingTracker()
  let fresh = stagingSlot(foreign, new StagingNode())

  test::assertTrue(fresh != null)
  if fresh != null
    test::assertTrue(foreign.stageNode(fresh, stranger) != null)
  end
end
