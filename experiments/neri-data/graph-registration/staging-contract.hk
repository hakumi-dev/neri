use neri_data
use test

class StagingNode
  public id: Int = 0
  public parentId: Int = 17
  public setterCalls: Int = 0
end

def stagingCapture(entity: StagingNode): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(entity.id)), new RawColumn("parent_id", Cell.Int(entity.parentId))])
end

def stagingApply(entity: StagingNode, source: StagingNode): Void
  entity.id = source.id
  entity.parentId = source.parentId
end

def stagingId(entity: StagingNode): Int
  return entity.id
end

def stagingParent(entity: StagingNode): Int
  return entity.parentId
end

def stagingSetId(entity: StagingNode, value: Int): Void
  entity.id = value
end

def stagingSetParent(entity: StagingNode, value: Int): Void
  entity.parentId = value
end

def stagingRejectParent(entity: StagingNode, value: Int): Void
  entity.setterCalls = entity.setterCalls + 1
  entity.parentId = value - 1
end

def stagingTracker(): EntityTracker<StagingNode>
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("parent_id", ResultColumnKind.Int())
    ])

  return new EntityTracker<StagingNode>(
    "staging_nodes",
    "id",
    columns,
    stagingCapture,
    stagingApply,
    true,
    stagingSetId
  )
end

def stagingSlot(graph: GraphRegistration, entity: StagingNode): GraphSlot<StagingNode>?
  let visits = new GraphVisitList<StagingNode>(graph)

  match visits.visit(entity)
    case GraphVisitResult.New(slot)
      return slot
    case GraphVisitResult.Existing(slot)
      return slot
    case GraphVisitResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def verifyStagingContracts(): Void
  let context = new ChangeContext()
  let tracker = stagingTracker()

  context.register(tracker.changeSet())
  let principal = new StagingNode()
  let dependent = new StagingNode()
  let graph = new GraphRegistration(context)
  let p = stagingSlot(graph, principal)
  let d = stagingSlot(graph, dependent)

  test::assertTrue(p != null && d != null)
  if p == null || d == null
    return
  end

  test::assertTrue(graph.stageNode(p, tracker) == null)
  test::assertTrue(graph.stageNode(d, tracker) == null)
  let badEdge: fn(
    TrackedHandle<StagingNode>,
    TrackedHandle<StagingNode>
  ): RelationshipEdge = fn(
    a: TrackedHandle<StagingNode>,
    b: TrackedHandle<StagingNode>
  ): RelationshipEdge do
    return (new RelationshipLink<StagingNode, StagingNode>(
        a,
        b,
        stagingId,
        stagingParent,
        stagingRejectParent,
        "parent_id"
      )).edge()
  end
  let undo: fn(): Void = fn(): Void do
    dependent.parentId = 17
  end

  test::assertTrue(graph.stageLink(p, d, badEdge, undo) == null)
  match graph.enroll(p)
    case TrackHandleResult.Failure(error)
      ## A rejected assignment attempts restoration before the graph journal restores the snapshot.
      test::assertEqual(dependent.setterCalls, 2)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
  end

  test::assertEqual(principal.id, 0)
  test::assertEqual(dependent.id, 0)
  test::assertEqual(dependent.parentId, 17)
  let retry = new GraphRegistration(context)
  let retryP = stagingSlot(retry, principal)
  let retryD = stagingSlot(retry, dependent)

  test::assertTrue(retryP != null && retryD != null)
  if retryP == null || retryD == null
    return
  end
  let edge: fn(
    TrackedHandle<StagingNode>,
    TrackedHandle<StagingNode>
  ): RelationshipEdge = fn(
    a: TrackedHandle<StagingNode>,
    b: TrackedHandle<StagingNode>
  ): RelationshipEdge do
    return (new RelationshipLink<StagingNode, StagingNode>(
        a,
        b,
        stagingId,
        stagingParent,
        stagingSetParent,
        "parent_id"
      )).edge()
  end

  test::assertTrue(retry.stageNode(retryP, tracker) == null)
  test::assertTrue(retry.stageNode(retryD, tracker) == null)
  test::assertTrue(retry.stageLink(retryP, retryD, edge, undo) == null)
  match retry.enroll(retryP)
    case TrackHandleResult.Tracked(handle)
      test::assertEqual(principal.id, -1)
      test::assertEqual(dependent.id, -2)
      test::assertEqual(dependent.parentId, -1)
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  match retry.enroll(retryP)
    case TrackHandleResult.Failure(error)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
  end
  let foreign = new GraphRegistration(context)

  test::assertTrue(foreign.stageNode(retryP, tracker) != null)
  let stranger = stagingTracker()
  let fresh = stagingSlot(foreign, new StagingNode())

  test::assertTrue(fresh != null)
  if fresh != null
    test::assertTrue(foreign.stageNode(fresh, stranger) != null)
  end
end

class StagingJoin
  public leftId: Int = 0
  public rightId: Int = 0
end

def stagingJoinCapture(entity: StagingJoin): RawRow
  return new RawRow([
      new RawColumn("left_id", Cell.Int(entity.leftId)),
      new RawColumn("right_id", Cell.Int(entity.rightId))
    ])
end

def stagingLeft(entity: StagingJoin): Int
  return entity.leftId
end

def stagingSetLeft(entity: StagingJoin, value: Int): Void
  entity.leftId = value
end

def stagingRight(entity: StagingJoin): Int
  return entity.rightId
end

def stagingSetRight(entity: StagingJoin, value: Int): Void
  entity.rightId = value
end

def stagingJoinSlot(graph: GraphRegistration, entity: StagingJoin): GraphSlot<StagingJoin>?
  match new GraphVisitList<StagingJoin>(graph).visit(entity)
    case GraphVisitResult.New(slot)
      return slot
    case GraphVisitResult.Existing(slot)
      return slot
    case GraphVisitResult.Failure(error)
      return null
  end
  return null
end

def verifyProvisionalCompositeJoins(duplicate: Bool): Void
  let context = new ChangeContext()
  let principals = stagingTracker()
  let joins = new EntityTracker<StagingJoin>(
    "staging_joins",
    "left_id",
    new ResultColumns([
        new ResultColumn("left_id", ResultColumnKind.Int()),
        new ResultColumn("right_id", ResultColumnKind.Int())
      ]),
    stagingJoinCapture,
    keyColumns: ["left_id", "right_id"],
    foreignKeyColumns: [["left_id"], ["right_id"]]
  )

  context.register(principals.changeSet())
  context.register(joins.changeSet())
  let left = new StagingNode()
  let right = new StagingNode()
  let other = new StagingNode()
  let first = new StagingJoin()
  let second = new StagingJoin()
  let graph = new GraphRegistration(context)
  let l = stagingSlot(graph, left)
  let r = stagingSlot(graph, right)
  let o = stagingSlot(graph, other)
  let a = stagingJoinSlot(graph, first)
  let b = stagingJoinSlot(graph, second)

  test::assertTrue(l != null && r != null && o != null && a != null && b != null)
  if l == null || r == null || o == null || a == null || b == null
    return
  end
  let leftEdge: fn(
    TrackedHandle<StagingNode>,
    TrackedHandle<StagingJoin>
  ): RelationshipEdge = fn(
    p: TrackedHandle<StagingNode>,
    d: TrackedHandle<StagingJoin>
  ): RelationshipEdge do
    return new RelationshipLink<StagingNode, StagingJoin>(
      p,
      d,
      stagingId,
      stagingLeft,
      stagingSetLeft,
      "left_id"
    ).edge()
  end
  let rightEdge: fn(
    TrackedHandle<StagingNode>,
    TrackedHandle<StagingJoin>
  ): RelationshipEdge = fn(
    p: TrackedHandle<StagingNode>,
    d: TrackedHandle<StagingJoin>
  ): RelationshipEdge do
    return new RelationshipLink<StagingNode, StagingJoin>(
      p,
      d,
      stagingId,
      stagingRight,
      stagingSetRight,
      "right_id"
    ).edge()
  end
  let restoreFirst: fn(): Void = fn(): Void do
    first.leftId = 0
    first.rightId = 0
  end
  let restoreSecond: fn(): Void = fn(): Void do
    second.leftId = 0
    second.rightId = 0
  end

  test::assertTrue(graph.stageNode(l, principals) == null)
  test::assertTrue(graph.stageNode(r, principals) == null)
  test::assertTrue(graph.stageNode(o, principals) == null)
  test::assertTrue(graph.stageNode(a, joins) == null)
  test::assertTrue(graph.stageNode(b, joins) == null)
  test::assertTrue(graph.stageLink(l, a, leftEdge, restoreFirst) == null)
  test::assertTrue(graph.stageLink(l, b, leftEdge, restoreSecond) == null)
  test::assertTrue(graph.stageLink(r, a, rightEdge, restoreFirst) == null)
  test::assertTrue(graph.stageLink(duplicate ? r : o, b, rightEdge, restoreSecond) == null)
  match graph.enroll(l)
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(!duplicate)
      test::assertEqual(first.leftId, left.id)
      test::assertEqual(second.leftId, left.id)
      test::assertEqual(first.rightId, right.id)
      test::assertEqual(second.rightId, other.id)
    case TrackHandleResult.Failure(error)
      test::assertTrue(duplicate)
      test::assertEqual(left.id, 0)
      test::assertEqual(right.id, 0)
      test::assertEqual(other.id, 0)
      test::assertEqual(first.leftId, 0)
      test::assertEqual(first.rightId, 0)
      test::assertEqual(second.leftId, 0)
      test::assertEqual(second.rightId, 0)
  end
end

class SharedGraphProvider: Provider
  public failLeaf: Bool = false
  public writes: Int = 0
  public generated: Int = 100
  public commits: Int = 0
  public rollbacks: Int = 0
  private state: TransactionState = TransactionState.RolledBack()

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Rows([])
  end

  public override def beginTransaction(): TransactionOpenResult
    this.state = TransactionState.Active()
    return TransactionOpenResult.Begun(1)
  end

  public override def transactionState(lease: Int): TransactionState
    return lease == 1 ? schemaCloneTransactionState(this.state) : TransactionState.Invalid()
  end

  public override def commitTransaction(lease: Int): WriteResult
    this.state = TransactionState.Committed()
    this.commits = this.commits + 1
    return WriteResult.Saved(0)
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    this.state = TransactionState.RolledBack()
    this.rollbacks = this.rollbacks + 1
    return WriteResult.Saved(0)
  end

  public override def createSavepoint(lease: Int): SavepointOpenResult
    return SavepointOpenResult.Created(1)
  end

  public override def releaseSavepoint(lease: Int, id: Int): WriteResult
    return WriteResult.Saved(0)
  end

  public override def rollbackToSavepoint(lease: Int, id: Int): WriteResult
    return WriteResult.Saved(0)
  end

  public override def writeBatchInTransaction(batch: readonly WriteBatch, lease: Int): WriteResult
    this.writes = this.writes + 1
    let first = batch.first()

    if first == null
      return WriteResult.Failure(WriteFailure.Validation("shared graph command is missing"))
    end
    if first.command().returningColumns() != null
      this.generated = this.generated + 1
      let returned = new WriteReturnedRows()

      returned.add(new RawRow([new RawColumn("id", Cell.Int(this.generated))]))
      return WriteResult.SavedWithValues(1, returned)
    end
    if this.failLeaf
      return WriteResult.Failure(WriteFailure.Constraint("leaf rejected"))
    end
    let parameter = first.command().parameters().first()

    test::assertTrue(parameter != null)
    if parameter != null
      test::assertEqual(concurrencyCellInt(parameter.value()), this.generated)
    end
    return WriteResult.Saved(1)
  end
end

def schemaCloneTransactionState(state: readonly TransactionState): TransactionState
  match state
    case TransactionState.Active()
      return TransactionState.Active()
    case TransactionState.Committed()
      return TransactionState.Committed()
    case TransactionState.RolledBack()
      return TransactionState.RolledBack()
    case TransactionState.Failed()
      return TransactionState.Failed()
    case TransactionState.Invalid()
      return TransactionState.Invalid()
  end
end

def concurrencyCellInt(value: readonly Cell): Int
  match value
    case Cell.Int(number)
      return number
    case Cell.Null()
    case Cell.Text(text)
    case Cell.Bool(boolean)
    case Cell.Float(number)
    case Cell.Binary(bytes)
      return -999
  end
  return -999
end

def sharedRootCapture(entity: StagingNode): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(entity.id))])
end

def verifySharedObjectIdentifyingKey(rollback: Bool, external: Bool): Void
  let provider = new SharedGraphProvider()
  let context = new ChangeContext(provider)
  let root = new EntityTracker<StagingNode>(
    "shared_roots",
    "id",
    new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]),
    sharedRootCapture,
    generatedKey: true,
    setGeneratedKey: stagingSetId
  )
  let leaf = new EntityTracker<StagingNode>(
    "shared_leaves",
    "id",
    new ResultColumns([
        new ResultColumn("id", ResultColumnKind.Int()),
        new ResultColumn("parent_id", ResultColumnKind.Int())
      ]),
    stagingCapture,
    foreignKeyColumns: [["id"]]
  )
  let entity = new StagingNode()

  context.register(root.changeSet())
  context.register(leaf.changeSet())
  if external
    match provider.beginTransaction()
      case TransactionOpenResult.Begun(lease)
        saved(context.enlistTransaction(lease), 0)
      case TransactionOpenResult.Failure(error)
        test::assertTrue(false)
    end
  end
  var principal: TrackedHandle<StagingNode>? = null
  var dependent: TrackedHandle<StagingNode>? = null

  match root.addWithHandle(entity)
    case TrackHandleResult.Tracked(handle)
      principal = handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  match leaf.addWithHandle(entity)
    case TrackHandleResult.Tracked(handle)
      dependent = handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  if principal == null || dependent == null
    return
  end
  let temporaryKey = entity.id
  let edge = new RelationshipLink<StagingNode, StagingNode>(
    principal,
    dependent,
    stagingId,
    stagingId,
    stagingSetId,
    "id",
    RelationshipDeletePolicy.ClientCascade()
  ).edge()

  test::assertTrue(context.registerRelation(edge) == null)
  if rollback && !external
    provider.failLeaf = true
    failed(context.saveChanges())

    test::assertTrue(entity.id <= 0)
    provider.failLeaf = false
    saved(context.saveChanges(), 2)

    test::assertEqual(provider.rollbacks, 1)
  else
    saved(context.saveChanges(), 2)
  end

  test::assertEqual(entity.id, provider.generated)
  if external
    failed(context.commitTransaction())
    if rollback
      saved(provider.rollbackTransaction(1), 0)
      saved(context.synchronizeTransaction(), 0)

      test::assertTrue(temporaryKey < 0)
      test::assertEqual(entity.id, temporaryKey)
      saved(context.saveChanges(), 2)

      test::assertEqual(entity.id, provider.generated)
    else
      saved(provider.commitTransaction(1), 0)
      saved(context.synchronizeTransaction(), 0)
    end
  end
end
