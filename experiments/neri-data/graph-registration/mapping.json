{
  "version": 1,
  "project": "manifest.json",
  "unit": "entities",
  "namespace": "graph_registration_data",
  "context": "GraphRegistrationDatabase",
  "output": "generated",
  "entities": [
    {"type": "graph_registration_model.Account", "set": "accounts", "table": "accounts", "key": "id", "keyGeneration": "onAdd", "columns": [
      {"member": "id", "column": "id"}, {"member": "name", "column": "name"}
    ]},
    {"type": "graph_registration_model.Entry", "set": "entries", "table": "entries", "key": "id", "keyGeneration": "onAdd", "columns": [
      {"member": "id", "column": "id"}, {"member": "accountId", "column": "account_id"}, {"member": "parentId", "column": "parent_id"}, {"member": "title", "column": "title"}
    ]},
    {"type": "graph_registration_model.Note", "set": "notes", "table": "notes", "key": "id", "columns": [
      {"member": "id", "column": "id"}, {"member": "entryId", "column": "entry_id"}, {"member": "body", "column": "body"}
    ], "indexes": [{"name": "notes_body_unique", "members": ["body"], "unique": true}]}
  ],
  "relations": [
    {"principal": "graph_registration_model.Account", "dependent": "graph_registration_model.Entry", "key": "id", "foreignKey": "accountId", "collection": "entries", "reference": "account"},
    {"principal": "graph_registration_model.Entry", "dependent": "graph_registration_model.Note", "key": "id", "foreignKey": "entryId", "collection": "notes", "reference": "entry"},
    {"principal": "graph_registration_model.Entry", "dependent": "graph_registration_model.Entry", "key": "id", "foreignKey": "parentId", "collection": "children", "reference": "parent"}
  ]
}
