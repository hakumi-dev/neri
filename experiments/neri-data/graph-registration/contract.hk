use console
use files
use reference
use resources
use result
use test
use graph_registration_data
use graph_registration_model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, values)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failed(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, values)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(writeFailureMessage(error) != "")
  end
end

def accountHandle(db: GraphRegistrationDatabase, account: Account): TrackedHandle<Account>?
  match db.accounts.addWithHandle(account)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def entryHandle(db: GraphRegistrationDatabase, entry: graph_registration_model::Entry): TrackedHandle<graph_registration_model::Entry>?
  match db.entries.addWithHandle(entry)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def graphAdded(result: TrackHandleResult<Account>): Bool
  match result
    case TrackHandleResult.Tracked(handle)
      return true
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return false
  end
end

def graphEntryAdded(result: TrackHandleResult<graph_registration_model::Entry>): Bool
  match result
    case TrackHandleResult.Tracked(handle)
      return true
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return false
  end
end

def graphRejected(result: TrackHandleResult<Account>): Void
  match result
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
    case TrackHandleResult.Failure(error)
      test::assertTrue(true)
  end
end

def graphEntryRejected(result: TrackHandleResult<graph_registration_model::Entry>): Void
  match result
    case TrackHandleResult.Tracked(handle)
      test::assertTrue(false)
    case TrackHandleResult.Failure(error)
      test::assertTrue(true)
  end
end

def counts(provider: SQLiteProvider, accounts: Int, entries: Int, notes: Int): Void
  let db = new GraphRegistrationDatabase(provider)

  match db.accounts.count()
    case QueryValue.Value(value)
      test::assertEqual(value, accounts)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.entries.count()
    case QueryValue.Value(value)
      test::assertEqual(value, entries)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.notes.count()
    case QueryValue.Value(value)
      test::assertEqual(value, notes)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def assertSql(path: String, predicate: String): Void
  let sql = "CREATE TABLE __graph_assert(value INTEGER NOT NULL CHECK(value = 1)); INSERT INTO __graph_assert VALUES(" + predicate + "); DROP TABLE __graph_assert;"

  test::assertTrue(createSQLiteFixture(path, sql))
end

def openGraph(path: String): SQLiteProvider?
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Opened(provider)
      return provider
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
      return null
  end
end

def schema(): String
  return "CREATE TABLE accounts(id INTEGER PRIMARY KEY,name TEXT NOT NULL); CREATE TABLE entries(id INTEGER PRIMARY KEY,account_id INTEGER NOT NULL REFERENCES accounts(id),parent_id INTEGER REFERENCES entries(id),title TEXT NOT NULL); CREATE TABLE notes(id INTEGER PRIMARY KEY,entry_id INTEGER NOT NULL REFERENCES entries(id),body TEXT NOT NULL UNIQUE);"
end

def verifyThreeLevelAndSharedNavigation(path: String): Void
  console::println("graph registration: three levels, inverse cycles, shared pretracked principal")

  test::assertTrue(createSQLiteFixture(path, schema()))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let account = new Account(0, "root")
  let first = new graph_registration_model::Entry(0, 0, null, "first")
  let second = new graph_registration_model::Entry(0, 0, null, "second")
  let note = new Note(701, 0, "first note")

  account.entries = [first, second]
  first.account = account
  second.account = account
  first.notes = [note]
  note.entry = first

  test::assertTrue(graphAdded(db.addGraph_accounts(account)))
  test::assertTrue(account.id < 0 && first.id < 0 && second.id < 0)
  test::assertEqual(first.accountId, account.id)
  test::assertEqual(note.entryId, first.id)
  saved(db.saveChanges(), 4)

  test::assertTrue(account.id > 0 && first.id > 0 && second.id > 0)
  test::assertEqual(first.accountId, account.id)
  test::assertEqual(second.accountId, account.id)
  test::assertEqual(note.entryId, first.id)
  let firstAccount = first.account
  let secondAccount = second.account
  let noteEntry = note.entry

  test::assertTrue(firstAccount != null && reference::same(firstAccount, account))
  test::assertTrue(secondAccount != null && reference::same(secondAccount, account))
  test::assertTrue(noteEntry != null && reference::same(noteEntry, first))
  counts(provider, 1, 2, 1)

  let third = new graph_registration_model::Entry(0, 0, null, "third")

  third.account = account
  account.entries = [first, second, third]

  test::assertTrue(graphAdded(db.addGraph_accounts(account)))
  saved(db.saveChanges(), 1)

  test::assertTrue(third.id > 0)
  test::assertEqual(third.accountId, account.id)
  counts(provider, 1, 3, 1)

  test::assertTrue(provider.close())
end

def verifyAttachedReference(path: String): Void
  console::println("graph registration: explicitly attached persisted reference")

  test::assertTrue(createSQLiteFixture(path, schema() + "INSERT INTO accounts(id,name) VALUES(77,'stored');"))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let stored = new Account(77, "stored")
  let entry = new graph_registration_model::Entry(0, 0, null, "attached dependent")

  entry.account = stored

  test::assertTrue(db.accounts.attach(stored) == null)
  test::assertTrue(graphEntryAdded(db.addGraph_entries(entry)))
  test::assertEqual(entry.accountId, 77)
  saved(db.saveChanges(), 1)

  let linked = entry.account

  test::assertTrue(linked != null && reference::same(linked, stored))
  counts(provider, 1, 1, 0)

  test::assertTrue(provider.close())
end

def verifyAtomicEnrollmentFailure(path: String): Void
  console::println("graph registration: duplicate identity rollback and retry")
  let setup = schema() + "INSERT INTO accounts(id,name) VALUES(9,'stored'); INSERT INTO entries(id,account_id,parent_id,title) VALUES(9,9,NULL,'stored'); INSERT INTO notes(id,entry_id,body) VALUES(555,9,'occupied locally');"

  test::assertTrue(createSQLiteFixture(path, setup))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let unrelated = new Account(0, "unrelated")
  let occupied = new Note(555, 9, "occupied locally")
  let root = new Account(0, "candidate")
  let child = new graph_registration_model::Entry(0, 91, null, "candidate child")
  let collision = new Note(555, 0, "different instance")

  test::assertTrue(db.accounts.add(unrelated) == null)
  test::assertTrue(db.notes.attach(occupied) == null)
  let unrelatedTemporary = unrelated.id
  let rootId = root.id
  let childId = child.id
  let childForeignKey = child.accountId

  root.entries = [child]
  child.account = root
  child.notes = [collision]
  collision.entry = child

  graphRejected(db.addGraph_accounts(root))

  test::assertEqual(root.id, rootId)
  test::assertEqual(child.id, childId)
  test::assertEqual(child.accountId, childForeignKey)
  test::assertEqual(collision.id, 555)
  test::assertEqual(collision.entryId, 0)
  test::assertEqual(unrelated.id, unrelatedTemporary)
  test::assertTrue(db.accounts.stateOf(root) == null)
  test::assertTrue(db.entries.stateOf(child) == null)
  test::assertTrue(db.accounts.stateOf(unrelated) != null)
  test::assertTrue(db.notes.stateOf(occupied) != null)

  collision.id = 556

  test::assertTrue(graphAdded(db.addGraph_accounts(root)))
  test::assertEqual(root.id, unrelatedTemporary - 1)
  saved(db.saveChanges(), 4)

  test::assertTrue(root.id > 0 && child.id > 0 && unrelated.id > 0)
  test::assertEqual(unrelated.name, "unrelated")
  test::assertEqual(child.accountId, root.id)
  test::assertEqual(collision.entryId, child.id)
  counts(provider, 3, 2, 2)

  test::assertTrue(provider.close())
end

def verifyContradictoryAndCyclicGraphs(path: String): Void
  console::println("graph registration: conflicting inverses and insert cycles rejected")

  test::assertTrue(createSQLiteFixture(path, schema()))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let root = new Account(0, "root")
  let other = new Account(0, "other")
  let child = new graph_registration_model::Entry(0, 33, null, "contradiction")

  root.entries = [child]
  child.account = other
  graphRejected(db.addGraph_accounts(root))

  test::assertEqual(root.id, 0)
  test::assertEqual(other.id, 0)
  test::assertEqual(child.id, 0)
  test::assertEqual(child.accountId, 33)
  test::assertTrue(db.accounts.stateOf(root) == null)
  test::assertTrue(db.entries.stateOf(child) == null)

  let first = new graph_registration_model::Entry(0, 44, null, "first cycle")
  let second = new graph_registration_model::Entry(0, 55, null, "second cycle")

  first.parent = second
  second.parent = first
  first.children = [second]
  second.children = [first]
  graphEntryRejected(db.addGraph_entries(first))

  test::assertEqual(first.id, 0)
  test::assertEqual(second.id, 0)
  test::assertTrue(first.parentId == null && second.parentId == null)
  test::assertTrue(db.entries.stateOf(first) == null && db.entries.stateOf(second) == null)
  counts(provider, 0, 0, 0)

  test::assertTrue(provider.close())
end

def verifyDatabaseFailureRetry(path: String): Void
  console::println("graph registration: database failure preserves enrolled graph for retry")
  let setup = schema() + "INSERT INTO accounts(id,name) VALUES(70,'persisted'); INSERT INTO entries(id,account_id,parent_id,title) VALUES(71,70,NULL,'persisted'); INSERT INTO notes(id,entry_id,body) VALUES(72,71,'occupied');"

  test::assertTrue(createSQLiteFixture(path, setup))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let account = new Account(0, "retry")
  let entry = new graph_registration_model::Entry(0, 0, null, "retry child")
  let note = new Note(73, 0, "occupied")

  account.entries = [entry]
  entry.account = account
  entry.notes = [note]
  note.entry = entry

  test::assertTrue(graphAdded(db.addGraph_accounts(account)))
  failed(db.saveChanges())

  test::assertTrue(account.id < 0 && entry.id < 0)
  test::assertEqual(entry.accountId, account.id)
  test::assertEqual(note.entryId, entry.id)
  test::assertTrue(db.accounts.stateOf(account) != null)
  test::assertTrue(db.entries.stateOf(entry) != null)

  note.body = "available"
  saved(db.saveChanges(), 3)

  test::assertTrue(account.id > 0 && entry.id > 0)
  test::assertEqual(entry.accountId, account.id)
  test::assertEqual(note.entryId, entry.id)
  counts(provider, 2, 2, 2)

  test::assertTrue(provider.close())
end

def verifyLateLinkConflict(path: String): Void
  console::println("graph registration: late relationship conflict rolls back staged keys and keeps outer transaction")

  test::assertTrue(createSQLiteFixture(path, schema()))
  let opened = openGraph(path)

  if opened == null
    return
  end
  let provider = opened
  let db = new GraphRegistrationDatabase(provider)
  let principal = new Account(0, "principal")
  let dependent = new graph_registration_model::Entry(0, 0, null, "pretracked dependent")
  let principalHandle = accountHandle(db, principal)
  let dependentHandle = entryHandle(db, dependent)

  if principalHandle == null || dependentHandle == null
    return
  end

  test::assertTrue(db.link_entriesFor_Account_by_accountId(principalHandle, dependentHandle) == null)
  let oldForeignKey = dependent.accountId
  let competing = new Account(0, "competing")

  competing.entries = [dependent]
  saved(db.beginTransaction(), 0)

  graphRejected(db.addGraph_accounts(competing))

  test::assertEqual(competing.id, 0)
  test::assertEqual(dependent.accountId, oldForeignKey)
  test::assertTrue(db.accounts.stateOf(competing) == null)
  test::assertTrue(db.accounts.stateOf(principal) != null)
  test::assertTrue(db.entries.stateOf(dependent) != null)
  saved(db.saveChanges(), 2)

  test::assertTrue(principal.id > 0 && dependent.id > 0)

  let replacement = new Account(0, "replacement")
  let newDependent = new graph_registration_model::Entry(0, 0, null, "replacement dependent")

  replacement.entries = [newDependent]
  newDependent.account = replacement

  test::assertTrue(graphAdded(db.addGraph_accounts(replacement)))
  saved(db.saveChanges(), 2)
  saved(db.rollbackTransaction(), 0)
  counts(provider, 0, 0, 0)

  test::assertTrue(principal.id < 0 && dependent.id < 0)
  test::assertEqual(dependent.accountId, principal.id)
  test::assertTrue(replacement.id < 0 && newDependent.id < 0)
  test::assertEqual(newDependent.accountId, replacement.id)
  test::assertTrue(db.accounts.stateOf(principal) != null && db.entries.stateOf(dependent) != null)
  test::assertTrue(db.accounts.stateOf(replacement) != null && db.entries.stateOf(newDependent) != null)
  saved(db.saveChanges(), 4)
  counts(provider, 2, 2, 0)

  test::assertTrue(provider.close())
end

def verifyGraphRegistrationContract(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-graph-registration-")
    verifyThreeLevelAndSharedNavigation(temporary.path() + "/three.sqlite")
    verifyAttachedReference(temporary.path() + "/attached.sqlite")
    verifyAtomicEnrollmentFailure(temporary.path() + "/enrollment.sqlite")
    verifyContradictoryAndCyclicGraphs(temporary.path() + "/invalid.sqlite")
    verifyDatabaseFailureRetry(temporary.path() + "/retry.sqlite")
    verifyLateLinkConflict(temporary.path() + "/late-link.sqlite")
    return 0
  end
  return 1
end

def main(): Void
  verifyStagingContracts()
  let outcome = verifyGraphRegistrationContract()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
