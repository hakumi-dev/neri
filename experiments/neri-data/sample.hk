use test
use neri_data

def main(): Void
  let omitted = customers().compile()

  test.assertEqual(omitted.preview(), "SELECT * FROM customers")
  test.assertTrue(omitted.filter == null)

  let explicitFalse = customers().where(customerActive().eq(false)).compile()

  test.assertEqual(explicitFalse.preview(), "SELECT * FROM customers WHERE customers.active = ?")
  test.assertTrue(explicitFalse.filter != null)

  let falseParameters = explicitFalse.parameters

  if falseParameters != null
    match falseParameters.value()
      case Parameter.Bool(value)
        test.assertFalse(value)
      case Parameter.Int(value)
        test.assertTrue(false)
      case Parameter.Text(value)
        test.assertTrue(false)
    end
  else
    test.assertTrue(false)
  end

  let explicitNull = customers().where(customerNickname().isNull()).compile()

  test.assertEqual(explicitNull.preview(), "SELECT * FROM customers WHERE customers.nickname IS NULL")
  test.assertTrue(explicitNull.filter != null)
  test.assertTrue(explicitNull.parameters == null)

  let textPlan = customers().where(customerName().eq("O'Reilly")).compile()

  test.assertEqual(textPlan.preview(), "SELECT * FROM customers WHERE customers.name = ?")
  let textParameters = textPlan.parameters

  if textParameters != null
    match textParameters.value()
      case Parameter.Bool(value)
        test.assertTrue(false)
      case Parameter.Int(value)
        test.assertTrue(false)
      case Parameter.Text(value)
        test.assertEqual(value, "O'Reilly")
    end
  else
    test.assertTrue(false)
  end

  let original = customers().where(customerActive().eq(true))
  let chained = original.where(customerId().gt(10)).compile()
  let originalPlan = original.compile()

  test.assertEqual(chained.preview(), "SELECT * FROM customers WHERE customers.active = ? AND customers.id > ?")
  test.assertEqual(originalPlan.preview(), "SELECT * FROM customers WHERE customers.active = ?")
  let chainedParameters = chained.parameters

  if chainedParameters != null
    test.assertEqual(chainedParameters.count(), 2)

    match chainedParameters.value()
      case Parameter.Bool(value)
        test.assertTrue(value)
      case Parameter.Int(value)
        test.assertTrue(false)
      case Parameter.Text(value)
        test.assertTrue(false)
    end

    let secondParameter = chainedParameters.next()

    if secondParameter != null
      match secondParameter.value()
        case Parameter.Bool(value)
          test.assertTrue(false)
        case Parameter.Int(value)
          test.assertEqual(value, 10)
        case Parameter.Text(value)
          test.assertTrue(false)
      end
    else
      test.assertTrue(false)
    end
  else
    test.assertTrue(false)
  end

  let originalParameters = originalPlan.parameters

  if originalParameters != null
    test.assertEqual(originalParameters.count(), 1)

    match originalParameters.value()
      case Parameter.Bool(value)
        test.assertTrue(value)
      case Parameter.Int(value)
        test.assertTrue(false)
      case Parameter.Text(value)
        test.assertTrue(false)
    end
  else
    test.assertTrue(false)
  end

  let ordered = customers().where(customerId().gte(10)).orderBy(customerId(), true).compile()

  test.assertEqual(ordered.preview(), "SELECT * FROM customers WHERE customers.id >= ? ORDER BY customers.id DESC")

  let projected: Projection<Customer, String> = select<Customer, String>(customers().where(customerActive().eq(true)), customerNameProjection())

  test.assertEqual(projected.compile().preview(), "SELECT customers.name FROM customers WHERE customers.active = ?")
  test.assertEqual(customerOrders().preview(), "orders.customer_id -> customers.id")
  test.assertEqual(orders().where(orderCustomerId().eq(7)).compile().preview(), "SELECT * FROM orders WHERE orders.customer_id = ?")
end
