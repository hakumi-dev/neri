use neri_data
use test
use host

class CascadeItem
  public id: Int
  public parentId: Int?
  public otherId: Int?

  def init(id: Int, parentId: Int? = null, otherId: Int? = null): Void
    this.id = id
    this.parentId = parentId
    this.otherId = otherId
  end
end

class RequiredItem
  public id: Int
  public parentId: Int

  def init(id: Int, parentId: Int): Void
    this.id = id
    this.parentId = parentId
  end
end

class StringItem
  public code: String
  public parentCode: String

  def init(code: String, parentCode: String): Void
    this.code = code
    this.parentCode = parentCode
  end
end

class IdentifyingChild
  public id: Int

  def init(id: Int): Void
    this.id = id
  end
end

class CascadeProvider: Provider
  private lease: Int = 0
  private state: TransactionState = TransactionState.RolledBack()
  private nextKey: Int = 20
  public firstDeleted: Int = -1
  public secondDeleted: Int = -1
  public thirdDeleted: Int = -1
  public deleteCount: Int = 0

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.Savepoints()
        return false
      case ProviderCapability.BoundedTypedReads()
        return true
      case ProviderCapability.StreamingReads()
        return true
      case ProviderCapability.SetWrites()
        return true
      case ProviderCapability.TrackedWrites()
        return true
      case ProviderCapability.ExplicitTransactions()
        return true
    end
  end

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Rows([])
  end

  public override def beginTransaction(): TransactionOpenResult
    this.lease = this.lease + 1
    this.state = TransactionState.Active()
    return TransactionOpenResult.Begun(this.lease)
  end

  public override def writeBatchInTransaction(batch: readonly WriteBatch, lease: Int): WriteResult
    if lease != this.lease
      return WriteResult.Failure(WriteFailure.Transaction("wrong lease"))
    end
    let outputs = new WriteReturnedRows()
    var generated = false
    var node = batch.first()

    while node != null
      let command = node.command()
      let sql = command.sql()

      if host::stringByteLength(sql) >= 6 && host::stringSlice(sql, 0, 6) == "DELETE"
        let first = command.parameters().first()

        if first != null
          match first.value()
            case Cell.Int(id)
              this.deleteCount = this.deleteCount + 1
              if this.deleteCount == 1
                this.firstDeleted = id
              end
              if this.deleteCount == 2
                this.secondDeleted = id
              end
              if this.deleteCount == 3
                this.thirdDeleted = id
              end
            case Cell.Null()
            case Cell.Float(value)
            case Cell.Bool(value)
            case Cell.Text(value)
          end
        end
      end
      let returning = command.returningColumns()

      if returning == null
        outputs.add(null)
      else
        generated = true
        outputs.add(new RawRow([new RawColumn(returning.at(0).name(), Cell.Int(this.nextKey))]))
        this.nextKey = this.nextKey + 1
      end
      node = node.next()
    end
    if generated
      return WriteResult.SavedWithValues(batch.count(), outputs)
    end
    return WriteResult.Saved(batch.count())
  end

  public override def commitTransaction(lease: Int): WriteResult
    this.state = TransactionState.Committed()
    return WriteResult.Saved(0)
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    this.state = TransactionState.RolledBack()
    return WriteResult.Saved(0)
  end

  public override def transactionState(lease: Int): TransactionState
    if lease != this.lease
      return TransactionState.Invalid()
    end
    return this.state
  end
end

def captureItem(item: CascadeItem): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(item.id)), new RawColumn("parent_id", cellOptionalInt(item.parentId)), new RawColumn("other_id", cellOptionalInt(item.otherId))])
end

def captureRequired(item: RequiredItem): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(item.id)), new RawColumn("parent_id", Cell.Int(item.parentId))])
end

def captureString(item: StringItem): RawRow
  return new RawRow([new RawColumn("code", Cell.Text(item.code)), new RawColumn("parent_code", Cell.Text(item.parentCode))])
end

def captureIdentifying(item: IdentifyingChild): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(item.id))])
end

def stringColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("code", ResultColumnKind.Text()), new ResultColumn("parent_code", ResultColumnKind.Text())])
end

def identifyingColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
end

def requiredColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("parent_id", ResultColumnKind.Int())])
end

def requiredKey(item: RequiredItem): Int
  return item.id
end

def requiredParent(item: RequiredItem): Int
  return item.parentId
end

def setRequiredParent(item: RequiredItem, value: Int): Void
  item.parentId = value
end

def setRequiredKey(item: RequiredItem, value: Int): Void
  item.id = value
end

def stringKey(item: StringItem): Cell
  return Cell.Text(item.code)
end

def stringParent(item: StringItem): Cell
  return Cell.Text(item.parentCode)
end

def setStringParent(item: StringItem, value: Cell): Void
  match value
    case Cell.Text(text)
      item.parentCode = text
    case Cell.Null()
    case Cell.Int(number)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def principalCell(item: RequiredItem): Cell
  return Cell.Int(item.id)
end

def identifyingKey(item: IdentifyingChild): Cell
  return Cell.Int(item.id)
end

def setIdentifyingKey(item: IdentifyingChild, value: Cell): Void
  match value
    case Cell.Int(number)
      item.id = number
    case Cell.Null()
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def attachRequired(tracker: EntityTracker<RequiredItem>, item: RequiredItem): TrackedHandle<RequiredItem>?
  match tracker.attachWithHandle(item)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def addRequired(tracker: EntityTracker<RequiredItem>, item: RequiredItem): TrackedHandle<RequiredItem>?
  match tracker.addWithHandle(item)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def linkRequired(changes: ChangeContext, principal: TrackedHandle<RequiredItem>, dependent: TrackedHandle<RequiredItem>, policy: RelationshipDeletePolicy): Void
  let link = new RelationshipLink<RequiredItem, RequiredItem>(principal, dependent, requiredKey, requiredParent, setRequiredParent, "parent_id", policy)

  test::assertTrue(changes.registerRelation(link.edge()) == null)
end

def itemColumns(): ResultColumns
  return new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("parent_id", ResultColumnKind.Int(), true), new ResultColumn("other_id", ResultColumnKind.Int(), true)])
end

def key(item: CascadeItem): Cell
  return Cell.Int(item.id)
end

def parent(item: CascadeItem): Cell
  return cellOptionalInt(item.parentId)
end

def other(item: CascadeItem): Cell
  return cellOptionalInt(item.otherId)
end

def setParent(item: CascadeItem, value: Cell): Void
  match value
    case Cell.Int(id)
      item.parentId = id
    case Cell.Null()
      item.parentId = null
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def setOther(item: CascadeItem, value: Cell): Void
  match value
    case Cell.Int(id)
      item.otherId = id
    case Cell.Null()
      item.otherId = null
    case Cell.Text(text)
    case Cell.Float(boolean)
      test::assertTrue(false)
    case Cell.Bool(boolean)
  end
end

def setKey(item: CascadeItem, value: Int): Void
  item.id = value
end

def attachItem(tracker: EntityTracker<CascadeItem>, item: CascadeItem): TrackedHandle<CascadeItem>?
  match tracker.attachWithHandle(item)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def addItem(tracker: EntityTracker<CascadeItem>, item: CascadeItem): TrackedHandle<CascadeItem>?
  match tracker.addWithHandle(item)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def linkParent(changes: ChangeContext, principal: TrackedHandle<CascadeItem>, dependent: TrackedHandle<CascadeItem>, policy: RelationshipDeletePolicy): Void
  let link = new ScalarRelationshipLink<CascadeItem, CascadeItem>(principal, dependent, key, parent, setParent, ResultColumnKind.Int(), true, "parent_id", policy)

  test::assertTrue(changes.registerRelation(link.edge()) == null)
end

def linkOther(changes: ChangeContext, principal: TrackedHandle<CascadeItem>, dependent: TrackedHandle<CascadeItem>, policy: RelationshipDeletePolicy): Void
  let link = new ScalarRelationshipLink<CascadeItem, CascadeItem>(principal, dependent, key, other, setOther, ResultColumnKind.Int(), true, "other_id", policy)

  test::assertTrue(changes.registerRelation(link.edge()) == null)
end

def expectDeleted(tracker: EntityTracker<CascadeItem>, item: CascadeItem): Void
  let state = tracker.stateOf(item)

  test::assertTrue(state != null)
  if state == null
    return
  end
  match state
    case TrackingState.Deleted()
    case TrackingState.Added()
      test::assertTrue(false)
    case TrackingState.Unchanged()
      test::assertTrue(false)
    case TrackingState.Modified()
      test::assertTrue(false)
    case TrackingState.Detached()
      test::assertTrue(false)
  end
end

def expectDetached(tracker: EntityTracker<CascadeItem>, item: CascadeItem): Void
  let state = tracker.stateOf(item)

  test::assertTrue(state != null)
  if state == null
    return
  end
  match state
    case TrackingState.Detached()
    case TrackingState.Added()
      test::assertTrue(false)
    case TrackingState.Unchanged()
      test::assertTrue(false)
    case TrackingState.Modified()
      test::assertTrue(false)
    case TrackingState.Deleted()
      test::assertTrue(false)
  end
end

