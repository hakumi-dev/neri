def expectSaved(result: WriteResult, count: Int): Void
  match result
    case WriteResult.Saved(actual)
      test::assertEqual(actual, count)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(actual, outputs)
      test::assertTrue(false)
  end
end

def verifyRequiredOrphans(): Void
  let provider = new CascadeProvider()
  let tracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let changes = new ChangeContext(provider)
  let principal = new RequiredItem(101, 0)
  let dependent = new RequiredItem(102, 101)
  let grandchild = new RequiredItem(103, 102)

  changes.register(tracker.changeSet())
  let principalHandle = attachRequired(tracker, principal)
  let dependentHandle = attachRequired(tracker, dependent)
  let grandchildHandle = attachRequired(tracker, grandchild)

  if principalHandle != null && dependentHandle != null && grandchildHandle != null
    linkRequired(changes, principalHandle, dependentHandle, RelationshipDeletePolicy.ClientCascade())
    linkRequired(changes, dependentHandle, grandchildHandle, RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(unlinkRelation(changes, dependentHandle, "parent_id") == null)
    expectRequiredUnchanged(tracker, principal)
    expectRequiredDeleted(tracker, dependent)
    expectRequiredDeleted(tracker, grandchild)

    test::assertEqual(dependent.parentId, 101)
    test::assertEqual(grandchild.parentId, 102)
    test::assertTrue(tracker.remove(principal) == null)
    expectSaved(changes.saveChanges(), 3)

    test::assertEqual(provider.firstDeleted, 103)
    test::assertEqual(provider.secondDeleted, 102)
    test::assertEqual(provider.thirdDeleted, 101)
  end

  let retryProvider = new CascadeProvider()
  let retryTracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let retryChanges = new ChangeContext(retryProvider)
  let retryPrincipal = new RequiredItem(105, 0)
  let retryChild = new RequiredItem(106, 105)
  let retryGrandchild = new RequiredItem(107, 106)

  retryChanges.register(retryTracker.changeSet())
  let retryPrincipalHandle = attachRequired(retryTracker, retryPrincipal)
  let retryChildHandle = attachRequired(retryTracker, retryChild)
  let retryGrandchildHandle = attachRequired(retryTracker, retryGrandchild)

  if retryPrincipalHandle != null && retryChildHandle != null && retryGrandchildHandle != null
    linkRequired(retryChanges, retryPrincipalHandle, retryChildHandle, RelationshipDeletePolicy.ClientCascade())
    linkRequired(retryChanges, retryChildHandle, retryGrandchildHandle, RelationshipDeletePolicy.ClientCascade())
    expectSaved(retryChanges.beginTransaction(), 0)

    test::assertTrue(unlinkRelation(retryChanges, retryChildHandle, "parent_id") == null)
    test::assertTrue(unlinkRelation(retryChanges, retryChildHandle, "parent_id") != null)
    expectSaved(retryChanges.saveChanges(), 2)
    expectSaved(retryChanges.rollbackTransaction(), 0)
    expectRequiredUnchanged(retryTracker, retryPrincipal)
    expectRequiredDeleted(retryTracker, retryChild)
    expectRequiredDeleted(retryTracker, retryGrandchild)
    retryProvider.deleteCount = 0

    test::assertTrue(retryTracker.remove(retryPrincipal) == null)
    expectSaved(retryChanges.saveChanges(), 3)

    test::assertEqual(retryProvider.firstDeleted, 107)
    test::assertEqual(retryProvider.secondDeleted, 106)
    test::assertEqual(retryProvider.thirdDeleted, 105)
  end

  let movedProvider = new CascadeProvider()
  let movedTracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let movedChanges = new ChangeContext(movedProvider)
  let movedOld = new RequiredItem(151, 0)
  let movedNew = new RequiredItem(152, 0)
  let movedChild = new RequiredItem(153, 151)

  movedChanges.register(movedTracker.changeSet())
  let movedOldHandle = attachRequired(movedTracker, movedOld)
  let movedNewHandle = attachRequired(movedTracker, movedNew)
  let movedChildHandle = attachRequired(movedTracker, movedChild)

  if movedOldHandle != null && movedNewHandle != null && movedChildHandle != null
    linkRequired(movedChanges, movedOldHandle, movedChildHandle, RelationshipDeletePolicy.ClientCascade())
    let replacement = new RelationshipLink<RequiredItem, RequiredItem>(movedNewHandle, movedChildHandle, requiredKey, requiredParent, setRequiredParent, "parent_id", RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(movedChanges.reassignRelation(replacement.edge()) == null)
    test::assertEqual(movedChild.parentId, 152)
    test::assertTrue(unlinkRelation(movedChanges, movedChildHandle, "parent_id") == null)
    test::assertEqual(movedChild.parentId, 152)
    expectRequiredUnchanged(movedTracker, movedNew)

    test::assertTrue(movedTracker.remove(movedOld) == null)
    expectSaved(movedChanges.saveChanges(), 2)

    test::assertEqual(movedProvider.firstDeleted, 153)
    test::assertEqual(movedProvider.secondDeleted, 151)
  end

  let restrictedTracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let restrictedChanges = new ChangeContext()
  let restrictedPrincipal = new RequiredItem(111, 0)
  let restrictedChild = new RequiredItem(112, 111)
  let restrictedGrandchild = new RequiredItem(113, 112)

  restrictedChanges.register(restrictedTracker.changeSet())
  let restrictedPrincipalHandle = attachRequired(restrictedTracker, restrictedPrincipal)
  let restrictedChildHandle = attachRequired(restrictedTracker, restrictedChild)
  let restrictedGrandchildHandle = attachRequired(restrictedTracker, restrictedGrandchild)

  if restrictedPrincipalHandle != null && restrictedChildHandle != null && restrictedGrandchildHandle != null
    linkRequired(restrictedChanges, restrictedPrincipalHandle, restrictedChildHandle, RelationshipDeletePolicy.ClientCascade())
    linkRequired(restrictedChanges, restrictedChildHandle, restrictedGrandchildHandle, RelationshipDeletePolicy.Restrict())

    test::assertTrue(unlinkRelation(restrictedChanges, restrictedChildHandle, "parent_id") != null)
    expectRequiredUnchanged(restrictedTracker, restrictedPrincipal)
    expectRequiredUnchanged(restrictedTracker, restrictedChild)
    expectRequiredUnchanged(restrictedTracker, restrictedGrandchild)

    test::assertTrue(removeCascade(restrictedChanges, restrictedPrincipalHandle) != null)
  end

  let cycleTracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let cycleChanges = new ChangeContext()
  let cyclePrincipal = new RequiredItem(121, 122)
  let cycleChild = new RequiredItem(122, 121)

  cycleChanges.register(cycleTracker.changeSet())
  let cyclePrincipalHandle = attachRequired(cycleTracker, cyclePrincipal)
  let cycleChildHandle = attachRequired(cycleTracker, cycleChild)

  if cyclePrincipalHandle != null && cycleChildHandle != null
    linkRequired(cycleChanges, cyclePrincipalHandle, cycleChildHandle, RelationshipDeletePolicy.ClientCascade())
    linkRequired(cycleChanges, cycleChildHandle, cyclePrincipalHandle, RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(unlinkRelation(cycleChanges, cycleChildHandle, "parent_id") != null)
    expectRequiredUnchanged(cycleTracker, cyclePrincipal)
    expectRequiredUnchanged(cycleTracker, cycleChild)
  end

  let stringTracker = new EntityTracker<StringItem>("string_items", "code", stringColumns(), captureString)
  let stringChanges = new ChangeContext()
  let stringPrincipal = new StringItem("principal", "root")
  let stringChild = new StringItem("dependent", "principal")
  var stringPrincipalHandle: TrackedHandle<StringItem>? = null
  var stringChildHandle: TrackedHandle<StringItem>? = null

  stringChanges.register(stringTracker.changeSet())
  match stringTracker.attachWithHandle(stringPrincipal)
    case TrackHandleResult.Tracked(handle)
      stringPrincipalHandle = handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  match stringTracker.attachWithHandle(stringChild)
    case TrackHandleResult.Tracked(handle)
      stringChildHandle = handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  if stringPrincipalHandle != null && stringChildHandle != null
    let stringLink = new ScalarRelationshipLink<StringItem, StringItem>(stringPrincipalHandle, stringChildHandle, stringKey, stringParent, setStringParent, ResultColumnKind.Text(), false, "parent_code", RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(stringChanges.registerRelation(stringLink.edge()) == null)
    test::assertTrue(unlinkRelation(stringChanges, stringChildHandle, "parent_code") == null)
    test::assertEqual(stringChild.parentCode, "principal")
    let childState = stringTracker.stateOf(stringChild)
    let principalState = stringTracker.stateOf(stringPrincipal)

    test::assertTrue(childState != null && principalState != null)
    if childState != null && principalState != null
      match childState
        case TrackingState.Deleted()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Unchanged()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
      match principalState
        case TrackingState.Unchanged()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Deleted()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
    end
  end

  let identifyingPrincipalTracker = new EntityTracker<RequiredItem>("principals", "id", requiredColumns(), captureRequired)
  let identifyingChildTracker = new EntityTracker<IdentifyingChild>("identifying_children", "id", identifyingColumns(), captureIdentifying)
  let identifyingChanges = new ChangeContext()
  let identifyingPrincipal = new RequiredItem(131, 0)
  let identifyingChild = new IdentifyingChild(131)
  var identifyingChildHandle: TrackedHandle<IdentifyingChild>? = null

  identifyingChanges.register(identifyingPrincipalTracker.changeSet())
  identifyingChanges.register(identifyingChildTracker.changeSet())
  let identifyingPrincipalHandle = attachRequired(identifyingPrincipalTracker, identifyingPrincipal)

  match identifyingChildTracker.attachWithHandle(identifyingChild)
    case TrackHandleResult.Tracked(handle)
      identifyingChildHandle = handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
  end
  if identifyingPrincipalHandle != null && identifyingChildHandle != null
    let identifyingLink = new ScalarRelationshipLink<RequiredItem, IdentifyingChild>(identifyingPrincipalHandle, identifyingChildHandle, principalCell, identifyingKey, setIdentifyingKey, ResultColumnKind.Int(), false, "id", RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(identifyingChanges.registerRelation(identifyingLink.edge()) == null)
    test::assertTrue(unlinkRelation(identifyingChanges, identifyingChildHandle, "id") == null)
    test::assertEqual(identifyingChild.id, 131)
    expectRequiredUnchanged(identifyingPrincipalTracker, identifyingPrincipal)
    let identifyingState = identifyingChildTracker.stateOf(identifyingChild)

    test::assertTrue(identifyingState != null)
    if identifyingState != null
      match identifyingState
        case TrackingState.Deleted()
        case TrackingState.Added()
          test::assertTrue(false)
        case TrackingState.Unchanged()
          test::assertTrue(false)
        case TrackingState.Modified()
          test::assertTrue(false)
        case TrackingState.Detached()
          test::assertTrue(false)
      end
    end
  end
end

def verifyAddedOrphans(): Void
  var mode = 0

  while mode < 6
    let provider = new CascadeProvider()
    let generated = mode >= 2
    let tracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired, generatedKey: generated, setGeneratedKey: setRequiredKey)
    let changes = new ChangeContext(provider)
    let parentId = generated ? 0 : 170 + mode * 10
    let childId = generated ? 0 : 171 + mode * 10
    let parent = new RequiredItem(parentId, 0)
    let child = new RequiredItem(childId, parentId)

    changes.register(tracker.changeSet())
    if mode == 1 || mode == 3
      expectSaved(changes.beginTransaction(), 0)
    end
    let parentHandle = addRequired(tracker, parent)
    let childHandle = addRequired(tracker, child)

    if parentHandle != null && childHandle != null
      linkRequired(changes, parentHandle, childHandle, RelationshipDeletePolicy.ClientCascade())
      if mode != 1 && mode != 3
        expectSaved(changes.beginTransaction(), 0)
      end
      let originalParent = parent.id
      let originalChild = child.id

      if generated
        expectSaved(changes.saveChanges(), 2)
      end

      if mode == 5
        child.parentId = 998
      end

      test::assertTrue(unlinkRelation(changes, childHandle, "parent_id") == null)
      test::assertTrue(unlinkRelation(changes, childHandle, "parent_id") != null)
      if mode == 4
        child.parentId = 999
      end
      expectSaved(changes.rollbackTransaction(), 0)
      expectRequiredDetached(tracker, child)

      test::assertEqual(parent.id, originalParent)
      test::assertEqual(child.id, originalChild)
      if mode == 4
        test::assertEqual(child.parentId, 999)
      else
        if mode == 5
          test::assertEqual(child.parentId, 998)
        else
          test::assertEqual(child.parentId, originalParent)
        end
      end
    end
    mode = mode + 1
  end
end

def verifyCancelledReuseIdentity(): Void
  let tracker = new EntityTracker<RequiredItem>("required_items", "id", requiredColumns(), captureRequired)
  let changes = new ChangeContext(new CascadeProvider())
  let old = new RequiredItem(220, 0)
  let replacement = new RequiredItem(220, 0)

  changes.register(tracker.changeSet())
  let oldHandle = attachRequired(tracker, old)

  if oldHandle != null
    test::assertTrue(tracker.detach(old) == null)
    expectSaved(changes.beginTransaction(), 0)
    let replacementHandle = addRequired(tracker, replacement)

    if replacementHandle != null
      test::assertTrue(tracker.remove(replacement) == null)
      expectSaved(changes.rollbackTransaction(), 0)

      test::assertTrue(!oldHandle.valid())
      test::assertTrue(replacementHandle.valid())
      test::assertTrue(reference::same(replacementHandle.entity(), replacement))
      expectRequiredDetached(tracker, replacement)
    end
  end
end

def main(): Void
  verifyRequiredOrphans()
  verifyAddedOrphans()
  verifyCancelledReuseIdentity()
  let provider = new CascadeProvider()
  let tracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let changes = new ChangeContext(provider)
  let a = new CascadeItem(1)
  let b = new CascadeItem(2, 1, 3)
  let c = new CascadeItem(3, 1)

  changes.register(tracker.changeSet())
  let ah = attachItem(tracker, a)
  let bh = attachItem(tracker, b)
  let ch = attachItem(tracker, c)

  if ah != null && bh != null && ch != null
    linkParent(changes, ah, bh, RelationshipDeletePolicy.Restrict())
    linkParent(changes, ah, ch, RelationshipDeletePolicy.ClientCascade())
    linkOther(changes, ch, bh, RelationshipDeletePolicy.ClientCascade())
    let changedPolicy = new ScalarRelationshipLink<CascadeItem, CascadeItem>(ah, bh, key, parent, setParent, ResultColumnKind.Int(), true, "parent_id", RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(changes.registerRelation(changedPolicy.edge()) != null)
    test::assertTrue(removeCascade(changes, ah) == null)
    expectDeleted(tracker, a)
    expectDeleted(tracker, b)
    expectDeleted(tracker, c)
    expectSaved(changes.saveChanges(), 3)

    test::assertEqual(provider.firstDeleted, 2)
    test::assertEqual(provider.secondDeleted, 3)
    test::assertEqual(provider.thirdDeleted, 1)
  end

  let restrictTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let restrictChanges = new ChangeContext()
  let restrictParent = new CascadeItem(10)
  let restrictChild = new CascadeItem(11, 10)

  restrictChanges.register(restrictTracker.changeSet())
  let restrictParentHandle = attachItem(restrictTracker, restrictParent)
  let restrictChildHandle = attachItem(restrictTracker, restrictChild)

  if restrictParentHandle != null && restrictChildHandle != null
    linkParent(restrictChanges, restrictParentHandle, restrictChildHandle, RelationshipDeletePolicy.Restrict())

    test::assertTrue(removeCascade(restrictChanges, restrictParentHandle) != null)
    expectUnchanged(restrictTracker, restrictParent)
    expectUnchanged(restrictTracker, restrictChild)
    let replacementParent = new CascadeItem(12)
    let replacementHandle = attachItem(restrictTracker, replacementParent)

    if replacementHandle != null
      let changedPolicy = new ScalarRelationshipLink<CascadeItem, CascadeItem>(replacementHandle, restrictChildHandle, key, parent, setParent, ResultColumnKind.Int(), true, "parent_id", RelationshipDeletePolicy.ClientCascade())

      test::assertTrue(restrictChanges.reassignRelation(changedPolicy.edge()) != null)
      let parentId = restrictChild.parentId

      test::assertTrue(parentId != null && parentId == 10)
    end

    test::assertTrue(restrictTracker.remove(restrictParent) == null)
    test::assertTrue(restrictTracker.remove(restrictChild) == null)
  end

  let cycleTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let cycleChanges = new ChangeContext()
  let x = new CascadeItem(21, 22)
  let y = new CascadeItem(22, 21)

  cycleChanges.register(cycleTracker.changeSet())
  let xh = attachItem(cycleTracker, x)
  let yh = attachItem(cycleTracker, y)

  if xh != null && yh != null
    linkParent(cycleChanges, xh, yh, RelationshipDeletePolicy.ClientCascade())
    linkParent(cycleChanges, yh, xh, RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(removeCascade(cycleChanges, xh) != null)
    test::assertTrue(cycleTracker.remove(x) == null)
    test::assertTrue(cycleTracker.remove(y) == null)
  end

  let retiredTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let retiredChanges = new ChangeContext()
  let oldA = new CascadeItem(41, null, 42)
  let oldB = new CascadeItem(42, 41)

  retiredChanges.register(retiredTracker.changeSet())
  let oldAH = attachItem(retiredTracker, oldA)
  let oldBH = attachItem(retiredTracker, oldB)

  if oldAH != null && oldBH != null
    linkParent(retiredChanges, oldAH, oldBH, RelationshipDeletePolicy.ClientCascade())
    linkOther(retiredChanges, oldBH, oldAH, RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(unlinkRelation(retiredChanges, oldAH, "other_id") == null)
    test::assertTrue(removeCascade(retiredChanges, oldAH) != null)
    test::assertTrue(oldA.otherId == null)
    test::assertTrue(retiredTracker.remove(oldA) == null)
    expectUnchanged(retiredTracker, oldB)
  end

  let guardTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let guardChanges = new ChangeContext()
  let guardRoot = new CascadeItem(51)
  let guardChild = new CascadeItem(52, 51)

  guardChanges.register(guardTracker.changeSet())
  let guardRootHandle = attachItem(guardTracker, guardRoot)
  let guardChildHandle = attachItem(guardTracker, guardChild)

  if guardRootHandle != null && guardChildHandle != null
    linkParent(guardChanges, guardRootHandle, guardChildHandle, RelationshipDeletePolicy.ClientCascade())
    guardChild.id = 53

    test::assertTrue(removeCascade(guardChanges, guardRootHandle) != null)
    expectUnchanged(guardTracker, guardRoot)
    guardChild.id = 52
    guardRoot.id = 54

    test::assertTrue(removeCascade(guardChanges, guardRootHandle) != null)
    expectUnchanged(guardTracker, guardChild)
    guardRoot.id = 51
    let foreignContext = new ChangeContext()

    test::assertTrue(removeCascade(foreignContext, guardRootHandle) != null)
    test::assertTrue(guardTracker.detach(guardRoot) == null)
    let replacementRoot = new CascadeItem(51)
    let fresh = attachItem(guardTracker, replacementRoot)

    test::assertTrue(fresh != null)
    test::assertTrue(removeCascade(guardChanges, guardRootHandle) != null)
    expectUnchanged(guardTracker, replacementRoot)
  end

  let pendingProvider = new CascadeProvider()
  let pendingTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let pendingChanges = new ChangeContext(pendingProvider)
  let pendingRoot = new CascadeItem(31)
  let pendingLeaf = new CascadeItem(32, 31)

  pendingChanges.register(pendingTracker.changeSet())
  let pendingRootHandle = addItem(pendingTracker, pendingRoot)
  let pendingLeafHandle = addItem(pendingTracker, pendingLeaf)

  if pendingRootHandle != null && pendingLeafHandle != null
    linkParent(pendingChanges, pendingRootHandle, pendingLeafHandle, RelationshipDeletePolicy.ClientCascade())
    expectSaved(pendingChanges.beginTransaction(), 0)

    test::assertTrue(removeCascade(pendingChanges, pendingRootHandle) == null)
    expectDetached(pendingTracker, pendingRoot)
    expectDetached(pendingTracker, pendingLeaf)
    expectSaved(pendingChanges.rollbackTransaction(), 0)
    expectDetached(pendingTracker, pendingRoot)
    expectDetached(pendingTracker, pendingLeaf)
  end

  let duringProvider = new CascadeProvider()
  let duringTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem)
  let duringChanges = new ChangeContext(duringProvider)
  let duringRoot = new CascadeItem(35)
  let duringLeaf = new CascadeItem(36, 35)

  duringChanges.register(duringTracker.changeSet())
  expectSaved(duringChanges.beginTransaction(), 0)
  let duringRootHandle = addItem(duringTracker, duringRoot)
  let duringLeafHandle = addItem(duringTracker, duringLeaf)

  if duringRootHandle != null && duringLeafHandle != null
    linkParent(duringChanges, duringRootHandle, duringLeafHandle, RelationshipDeletePolicy.ClientCascade())

    test::assertTrue(removeCascade(duringChanges, duringRootHandle) == null)
    expectSaved(duringChanges.rollbackTransaction(), 0)
    expectDetached(duringTracker, duringRoot)
    expectDetached(duringTracker, duringLeaf)
  end

  let generatedProvider = new CascadeProvider()
  let generatedTracker = new EntityTracker<CascadeItem>("items", "id", itemColumns(), captureItem, generatedKey: true, setGeneratedKey: setKey)
  let generatedChanges = new ChangeContext(generatedProvider)
  let generatedRoot = new CascadeItem(0)
  let generatedLeaf = new CascadeItem(0)

  generatedChanges.register(generatedTracker.changeSet())
  let generatedRootHandle = addItem(generatedTracker, generatedRoot)
  let generatedLeafHandle = addItem(generatedTracker, generatedLeaf)

  if generatedRootHandle != null && generatedLeafHandle != null
    let originalRoot = generatedRoot.id
    let originalLeaf = generatedLeaf.id

    linkParent(generatedChanges, generatedRootHandle, generatedLeafHandle, RelationshipDeletePolicy.ClientCascade())
    expectSaved(generatedChanges.beginTransaction(), 0)
    expectSaved(generatedChanges.saveChanges(), 2)

    test::assertTrue(removeCascade(generatedChanges, generatedRootHandle) == null)
    expectSaved(generatedChanges.rollbackTransaction(), 0)

    test::assertEqual(generatedRoot.id, originalRoot)
    test::assertEqual(generatedLeaf.id, originalLeaf)
    expectDetached(generatedTracker, generatedRoot)
    expectDetached(generatedTracker, generatedLeaf)
  end
end
