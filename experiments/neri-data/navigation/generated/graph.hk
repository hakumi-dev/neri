use reference
namespace navigation_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_NavigationDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Author: neri_data::EntityTracker<navigation_model::Author>
  private visits_Author: neri_data::GraphVisitList<navigation_model::Author>
  private tracker_Book: neri_data::EntityTracker<navigation_model::Book>
  private visits_Book: neri_data::GraphVisitList<navigation_model::Book>
  private tracker_Tag: neri_data::EntityTracker<navigation_model::Tag>
  private visits_Tag: neri_data::GraphVisitList<navigation_model::Tag>
  private tracker_TagEntry: neri_data::EntityTracker<navigation_model::TagEntry>
  private visits_TagEntry: neri_data::GraphVisitList<navigation_model::TagEntry>

  def init(changes: neri_data::ChangeContext, tracker_Author: neri_data::EntityTracker<navigation_model::Author>, tracker_Book: neri_data::EntityTracker<navigation_model::Book>, tracker_Tag: neri_data::EntityTracker<navigation_model::Tag>, tracker_TagEntry: neri_data::EntityTracker<navigation_model::TagEntry>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Author = tracker_Author
    this.visits_Author = new neri_data::GraphVisitList<navigation_model::Author>(this.graph)
    this.tracker_Book = tracker_Book
    this.visits_Book = new neri_data::GraphVisitList<navigation_model::Book>(this.graph)
    this.tracker_Tag = tracker_Tag
    this.visits_Tag = new neri_data::GraphVisitList<navigation_model::Tag>(this.graph)
    this.tracker_TagEntry = tracker_TagEntry
    this.visits_TagEntry = new neri_data::GraphVisitList<navigation_model::TagEntry>(this.graph)
  end

  def add_authors(root: navigation_model::Author): neri_data::TrackHandleResult<navigation_model::Author>
    match this.discover_authors(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<navigation_model::Author>.Failure(error)
    end
  end

  private def discover_authors(entity: navigation_model::Author): neri_data::GraphVisitResult<navigation_model::Author>
    match this.visits_Author.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<navigation_model::Author>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<navigation_model::Author>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Author)

        if staged != null
          return neri_data::GraphVisitResult<navigation_model::Author>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_authors(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<navigation_model::Author>.Failure(queued)
        end
        return neri_data::GraphVisitResult<navigation_model::Author>.New(slot)
    end
  end

  private def scan_authors(entity: navigation_model::Author, owner: neri_data::GraphSlot<navigation_model::Author>): neri_data::QueryFailure?
    for child in entity.books
      let inverse = child.author

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: booksFor_Author_by_authorId")
      end
      var related: neri_data::GraphSlot<navigation_model::Book>? = null

      match this.discover_books(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Author_by_authorId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_books(root: navigation_model::Book): neri_data::TrackHandleResult<navigation_model::Book>
    match this.discover_books(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<navigation_model::Book>.Failure(error)
    end
  end

  private def discover_books(entity: navigation_model::Book): neri_data::GraphVisitResult<navigation_model::Book>
    match this.visits_Book.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<navigation_model::Book>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<navigation_model::Book>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Book)

        if staged != null
          return neri_data::GraphVisitResult<navigation_model::Book>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_books(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<navigation_model::Book>.Failure(queued)
        end
        return neri_data::GraphVisitResult<navigation_model::Book>.New(slot)
    end
  end

  private def scan_books(entity: navigation_model::Book, owner: neri_data::GraphSlot<navigation_model::Book>): neri_data::QueryFailure?
    let principal_booksFor_Author_by_authorId = entity.author

    if principal_booksFor_Author_by_authorId != null
      var related: neri_data::GraphSlot<navigation_model::Author>? = null

      match this.discover_authors(principal_booksFor_Author_by_authorId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Author_by_authorId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_tags(root: navigation_model::Tag): neri_data::TrackHandleResult<navigation_model::Tag>
    match this.discover_tags(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<navigation_model::Tag>.Failure(error)
    end
  end

  private def discover_tags(entity: navigation_model::Tag): neri_data::GraphVisitResult<navigation_model::Tag>
    match this.visits_Tag.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<navigation_model::Tag>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<navigation_model::Tag>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Tag)

        if staged != null
          return neri_data::GraphVisitResult<navigation_model::Tag>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_tags(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<navigation_model::Tag>.Failure(queued)
        end
        return neri_data::GraphVisitResult<navigation_model::Tag>.New(slot)
    end
  end

  private def scan_tags(entity: navigation_model::Tag, owner: neri_data::GraphSlot<navigation_model::Tag>): neri_data::QueryFailure?
    for child in entity.entries
      let inverse = child.tag

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: tagEntriesFor_Tag_by_tagCode")
      end
      var related: neri_data::GraphSlot<navigation_model::TagEntry>? = null

      match this.discover_tagEntries(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_tagEntriesFor_Tag_by_tagCode(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_tagEntries(root: navigation_model::TagEntry): neri_data::TrackHandleResult<navigation_model::TagEntry>
    match this.discover_tagEntries(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<navigation_model::TagEntry>.Failure(error)
    end
  end

  private def discover_tagEntries(entity: navigation_model::TagEntry): neri_data::GraphVisitResult<navigation_model::TagEntry>
    match this.visits_TagEntry.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<navigation_model::TagEntry>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<navigation_model::TagEntry>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_TagEntry)

        if staged != null
          return neri_data::GraphVisitResult<navigation_model::TagEntry>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_tagEntries(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<navigation_model::TagEntry>.Failure(queued)
        end
        return neri_data::GraphVisitResult<navigation_model::TagEntry>.New(slot)
    end
  end

  private def scan_tagEntries(entity: navigation_model::TagEntry, owner: neri_data::GraphSlot<navigation_model::TagEntry>): neri_data::QueryFailure?
    let principal_tagEntriesFor_Tag_by_tagCode = entity.tag

    if principal_tagEntriesFor_Tag_by_tagCode != null
      var related: neri_data::GraphSlot<navigation_model::Tag>? = null

      match this.discover_tags(principal_tagEntriesFor_Tag_by_tagCode)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_tagEntriesFor_Tag_by_tagCode(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  private def link_booksFor_Author_by_authorId(principal: neri_data::GraphSlot<navigation_model::Author>, dependent: neri_data::GraphSlot<navigation_model::Book>, entity: navigation_model::Book): neri_data::QueryFailure?
    let previous = entity.authorId
    let restore: fn(): Void = fn(): Void
      entity.authorId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_booksFor_Author_by_authorId, restore)
  end

  private def link_tagEntriesFor_Tag_by_tagCode(principal: neri_data::GraphSlot<navigation_model::Tag>, dependent: neri_data::GraphSlot<navigation_model::TagEntry>, entity: navigation_model::TagEntry): neri_data::QueryFailure?
    let previous = entity.tagCode
    let restore: fn(): Void = fn(): Void
      entity.tagCode = previous
    end

    return this.graph.stageLink(principal, dependent, edge_tagEntriesFor_Tag_by_tagCode, restore)
  end
end
