namespace navigation_data

class Navigation_NavigationDatabase
  public authors: NavigationSet_NavigationDatabase_Author
  public books: NavigationSet_NavigationDatabase_Book
  public tags: NavigationSet_NavigationDatabase_Tag
  public tagEntries: NavigationSet_NavigationDatabase_TagEntry

  def init(context: NavigationDatabase): Void
    this.authors = new NavigationSet_NavigationDatabase_Author(context)
    this.books = new NavigationSet_NavigationDatabase_Book(context)
    this.tags = new NavigationSet_NavigationDatabase_Tag(context)
    this.tagEntries = new NavigationSet_NavigationDatabase_TagEntry(context)
  end
end
