namespace navigation_model

class Author
  public id: Int
  public name: String
  public books: Book[]

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
    this.books = []
  end
end

class Book
  public id: Int
  public authorId: Int
  public title: String
  public author: Author?

  def init(id: Int, authorId: Int, title: String): Void
    this.id = id
    this.authorId = authorId
    this.title = title
    this.author = null
  end
end

class Tag
  public code: String
  public entries: TagEntry[]

  def init(code: String): Void
    this.code = code
    this.entries = []
  end
end

class TagEntry
  public id: Int
  public tagCode: String
  public tag: Tag?

  def init(id: Int, tagCode: String): Void
    this.id = id
    this.tagCode = tagCode
    this.tag = null
  end
end
