use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
namespace neri_data_storage_failures

@library("sqlite3")
@cabiImport("sqlite3_get_autocommit")
unsafe def sqliteGetAutoCommit(database: Void*): Int32
end

unsafe def storageFullWrite(path: String, name: String): ProviderFailure?
  let pathBytes = sqliteMigrationText(path)
  let database = stackalloc Void*[1]
  let opened = neri_data_sqlite_fixture::sqliteOpen(pathBytes, database, 2 as Int32, null)

  native::free(pathBytes)
  if opened != (0 as Int32)
    let partial: Void*? = database[0]

    if partial != null
      neri_data_sqlite_fixture::sqliteClose(partial)
    end
    return ProviderFailure.State("could not open fixture for SQLITE_FULL probe")
  end

  let limited = sqliteExecuteLiteral(database[0], "PRAGMA max_page_count=6;")

  if limited != (0 as Int32)
    return sqliteCloseFailure(database[0], ProviderFailure.State("could not cap fixture page count"))
  end
  let begun = sqliteExecuteLiteral(database[0], "BEGIN IMMEDIATE;")

  if begun != (0 as Int32)
    return sqliteCloseFailure(database[0], sqliteFailure(database[0], "storage.full.begin", begun))
  end
  let sql = "INSERT INTO customers (id,name,active,nickname) VALUES (2,'" + name + "',1,NULL);"
  let status = sqliteExecuteLiteral(database[0], sql)
  var failure = ProviderFailure.State("SQLITE_FULL write unexpectedly succeeded")

  if status != (0 as Int32)
    failure = sqliteFailure(database[0], "storage.full.write", status)
    if sqliteGetAutoCommit(database[0]) == (0 as Int32)
      failure = ProviderFailure.State("SQLITE_FULL did not roll back the transaction")
    end
  end
  return sqliteCloseFailure(database[0], failure)
end

unsafe def storageReadOnlyInsert(path: String): ProviderFailure?
  let pathBytes = sqliteMigrationText(path)
  let database = stackalloc Void*[1]
  let opened = neri_data_sqlite_fixture::sqliteOpen(pathBytes, database, 1 as Int32, null)

  native::free(pathBytes)
  if opened != (0 as Int32)
    let partial: Void*? = database[0]

    if partial != null
      neri_data_sqlite_fixture::sqliteClose(partial)
    end
    return ProviderFailure.State("could not open fixture read-only")
  end
  let status = sqliteExecuteLiteral(database[0], "INSERT INTO customers (id,name,active,nickname) VALUES (99,'no',1,NULL);")
  var failure = ProviderFailure.State("read-only write unexpectedly succeeded")

  if status != (0 as Int32)
    failure = sqliteFailure(database[0], "storage.readonly.write", status)
  end
  return sqliteCloseFailure(database[0], failure)
end
