use reference
namespace generated_properties_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_GeneratedPropertiesDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Record: neri_data::EntityTracker<generated_properties_model::Record>
  private visits_Record: neri_data::GraphVisitList<generated_properties_model::Record>
  private tracker_Child: neri_data::EntityTracker<generated_properties_model::Child>
  private visits_Child: neri_data::GraphVisitList<generated_properties_model::Child>

  def init(changes: neri_data::ChangeContext, tracker_Record: neri_data::EntityTracker<generated_properties_model::Record>, tracker_Child: neri_data::EntityTracker<generated_properties_model::Child>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Record = tracker_Record
    this.visits_Record = new neri_data::GraphVisitList<generated_properties_model::Record>(this.graph)
    this.tracker_Child = tracker_Child
    this.visits_Child = new neri_data::GraphVisitList<generated_properties_model::Child>(this.graph)
  end

  def add_records(root: generated_properties_model::Record): neri_data::TrackHandleResult<generated_properties_model::Record>
    match this.discover_records(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<generated_properties_model::Record>.Failure(error)
    end
  end

  private def discover_records(entity: generated_properties_model::Record): neri_data::GraphVisitResult<generated_properties_model::Record>
    match this.visits_Record.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<generated_properties_model::Record>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<generated_properties_model::Record>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Record)

        if staged != null
          return neri_data::GraphVisitResult<generated_properties_model::Record>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_records(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<generated_properties_model::Record>.Failure(queued)
        end
        return neri_data::GraphVisitResult<generated_properties_model::Record>.New(slot)
    end
  end

  private def scan_records(entity: generated_properties_model::Record, owner: neri_data::GraphSlot<generated_properties_model::Record>): neri_data::QueryFailure?
    return null
  end

  def add_children(root: generated_properties_model::Child): neri_data::TrackHandleResult<generated_properties_model::Child>
    match this.discover_children(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<generated_properties_model::Child>.Failure(error)
    end
  end

  private def discover_children(entity: generated_properties_model::Child): neri_data::GraphVisitResult<generated_properties_model::Child>
    match this.visits_Child.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<generated_properties_model::Child>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<generated_properties_model::Child>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Child)

        if staged != null
          return neri_data::GraphVisitResult<generated_properties_model::Child>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_children(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<generated_properties_model::Child>.Failure(queued)
        end
        return neri_data::GraphVisitResult<generated_properties_model::Child>.New(slot)
    end
  end

  private def scan_children(entity: generated_properties_model::Child, owner: neri_data::GraphSlot<generated_properties_model::Child>): neri_data::QueryFailure?
    return null
  end
end
