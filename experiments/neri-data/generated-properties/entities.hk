namespace generated_properties_model

class Record
  public id: Int
  public name: String
  public input: Int
  public serverText: String
  public active: Bool
  public ratio: Float
  public optionalLabel: String?
  public computed: Int

  def init(id: Int, name: String, input: Int, serverText: String, active: Bool, ratio: Float, optionalLabel: String?, computed: Int): Void
    this.id = id
    this.name = name
    this.input = input
    this.serverText = serverText
    this.active = active
    this.ratio = ratio
    this.optionalLabel = optionalLabel
    this.computed = computed
  end
end

class Child
  public id: Int
  public recordId: Int
  public name: String

  def init(id: Int, recordId: Int, name: String): Void
    this.id = id
    this.recordId = recordId
    this.name = name
  end
end
