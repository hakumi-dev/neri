use test
use console
use files
use resources
use result
use generated_properties_data
use generated_properties_model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failed(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(writeFailureMessage(error) != "")
  end
end

def failedConcurrency(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Concurrency(message)
          test::assertTrue(message != "")
        case WriteFailure.Validation(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Provider(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
  end
end

def count(provider: SQLiteProvider, expected: Int): Void
  let db = new GeneratedPropertiesDatabase(provider)

  match db.records.count()
    case QueryValue.Value(value)
      test::assertEqual(value, expected)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def graphCounts(provider: SQLiteProvider, records: Int, children: Int): Void
  let db = new GeneratedPropertiesDatabase(provider)

  match db.records.count()
    case QueryValue.Value(value)
      test::assertEqual(value, records)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match db.children.count()
    case QueryValue.Value(value)
      test::assertEqual(value, children)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def recordHandle(db: GeneratedPropertiesDatabase, record: Record): TrackedHandle<Record>?
  match db.records.addWithHandle(record)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def childHandle(db: GeneratedPropertiesDatabase, child: Child): TrackedHandle<Child>?
  match db.children.addWithHandle(child)
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def generatedValues(record: Record, idPositive: Bool, computed: Int): Void
  if idPositive
    test::assertTrue(record.id > 0)
  end

  test::assertEqual(record.serverText, "database default")
  test::assertTrue(record.active)
  test::assertEqual(record.ratio, 1.25)
  test::assertTrue(record.optionalLabel == null)
  test::assertEqual(record.computed, computed)
end

def verifyInsertUpdateAndRejectEdit(provider: SQLiteProvider): Void
  let db = new GeneratedPropertiesDatabase(provider)
  let first = new Record(0, "first", 3, "placeholder", false, 0.0, "placeholder", -1)

  test::assertTrue(db.records.add(first) == null)
  test::assertTrue(first.id < 0)
  saved(db.saveChanges(), 1)
  generatedValues(first, true, 6)

  first.name = "updated"
  first.input = 4
  first.serverText = "chosen text"
  first.active = false
  first.ratio = 2.5
  first.optionalLabel = "chosen optional"
  saved(db.saveChanges(), 1)

  test::assertEqual(first.name, "updated")
  test::assertEqual(first.serverText, "chosen text")
  test::assertFalse(first.active)
  test::assertEqual(first.ratio, 2.5)
  test::assertTrue(first.optionalLabel == "chosen optional")
  test::assertEqual(first.computed, 8)

  first.computed = 99
  failed(db.saveChanges())

  test::assertEqual(first.computed, 99)
  first.computed = 8
  saved(db.saveChanges(), 0)
end

def verifyFailedInsertRetry(provider: SQLiteProvider): Void
  let db = new GeneratedPropertiesDatabase(provider)
  let retry = new Record(0, "updated", 9, "temporary text", false, 0.0, "temporary optional", -1)

  test::assertTrue(db.records.add(retry) == null)
  let temporaryKey = retry.id

  test::assertTrue(temporaryKey < 0)
  failed(db.saveChanges())

  test::assertEqual(retry.id, temporaryKey)
  test::assertEqual(retry.serverText, "temporary text")
  test::assertFalse(retry.active)
  test::assertEqual(retry.ratio, 0.0)
  test::assertTrue(retry.optionalLabel == "temporary optional")
  test::assertEqual(retry.computed, -1)
  count(provider, 1)

  retry.name = "retry"
  saved(db.saveChanges(), 1)

  test::assertTrue(retry.id > 0)
  generatedValues(retry, true, 18)
  count(provider, 2)
end

def verifyTransactionGeneratedValues(provider: SQLiteProvider): Void
  let db = new GeneratedPropertiesDatabase(provider)
  let first = db.records.where(id: 1).single()

  match first
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(record)
      test::assertEqual(record.computed, 8)
      saved(db.beginTransaction(), 0)
      record.name = "transaction first save"
      record.input = 7
      record.serverText = "transaction editable default"
      saved(db.saveChanges(), 1)

      test::assertEqual(record.computed, 14)
      record.name = "transaction latest local edit"
      record.input = 8
      saved(db.saveChanges(), 1)

      test::assertEqual(record.computed, 16)
      record.serverText = "latest unsaved default edit"
      saved(db.rollbackTransaction(), 0)

      test::assertEqual(record.name, "transaction latest local edit")
      test::assertEqual(record.input, 8)
      test::assertEqual(record.serverText, "latest unsaved default edit")
      test::assertEqual(record.computed, 8)
      saved(db.saveChanges(), 1)

      test::assertEqual(record.computed, 16)
      count(provider, 2)
  end
end

def verifyGeneratedGraphSavepoint(path: String, provider: SQLiteProvider): Void
  test::assertTrue(createSQLiteFixture(path, "INSERT INTO children(id,record_id,name) VALUES(1,1,'taken')"))
  let db = new GeneratedPropertiesDatabase(provider)

  graphCounts(provider, 2, 1)
  saved(db.beginTransaction(), 0)
  let earlier = new Record(0, "earlier graph", 6, "earlier placeholder", false, 0.0, "earlier optional", -1)
  let earlierChild = new Child(0, 0, "accepted graph child")
  let earlierHandle = recordHandle(db, earlier)
  let earlierChildHandle = childHandle(db, earlierChild)

  test::assertTrue(earlierHandle != null && earlierChildHandle != null)
  if earlierHandle == null || earlierChildHandle == null
    return
  end
  let earlierTemporaryKey = earlier.id
  let earlierTemporaryChildKey = earlierChild.id

  test::assertTrue(db.link_childrenFor_Record_by_recordId(earlierHandle, earlierChildHandle) == null)
  saved(db.saveChanges(), 2)
  generatedValues(earlier, true, 12)

  test::assertEqual(earlierChild.recordId, earlier.id)
  graphCounts(provider, 3, 2)

  let rejected = new Record(0, "rejected graph", 7, "rejected placeholder", false, 0.0, "rejected optional", -1)
  let rejectedChild = new Child(0, 0, "taken")
  let rejectedHandle = recordHandle(db, rejected)
  let rejectedChildHandle = childHandle(db, rejectedChild)

  test::assertTrue(rejectedHandle != null && rejectedChildHandle != null)
  if rejectedHandle == null || rejectedChildHandle == null
    return
  end
  let rejectedTemporaryKey = rejected.id
  let rejectedTemporaryChildKey = rejectedChild.id

  test::assertTrue(db.link_childrenFor_Record_by_recordId(rejectedHandle, rejectedChildHandle) == null)
  failed(db.saveChanges())
  graphCounts(provider, 3, 2)

  test::assertTrue(earlier.id > 0)
  generatedValues(earlier, true, 12)

  test::assertEqual(earlierChild.recordId, earlier.id)
  test::assertEqual(rejected.id, rejectedTemporaryKey)
  test::assertEqual(rejectedChild.id, rejectedTemporaryChildKey)
  test::assertEqual(rejectedChild.recordId, rejectedTemporaryKey)
  test::assertEqual(rejected.serverText, "rejected placeholder")
  test::assertFalse(rejected.active)
  test::assertEqual(rejected.ratio, 0.0)
  test::assertTrue(rejected.optionalLabel == "rejected optional")
  test::assertEqual(rejected.computed, -1)

  rejectedChild.name = "retried graph child"
  saved(db.saveChanges(), 2)
  generatedValues(rejected, true, 14)

  test::assertEqual(rejectedChild.recordId, rejected.id)
  graphCounts(provider, 4, 3)

  earlier.serverText = "after-insert local edit"
  saved(db.rollbackTransaction(), 0)
  graphCounts(provider, 2, 1)

  test::assertEqual(earlier.id, earlierTemporaryKey)
  test::assertEqual(earlierChild.id, earlierTemporaryChildKey)
  test::assertEqual(earlierChild.recordId, earlierTemporaryKey)
  test::assertEqual(earlier.serverText, "after-insert local edit")
  test::assertFalse(earlier.active)
  test::assertEqual(earlier.ratio, 0.0)
  test::assertTrue(earlier.optionalLabel == "earlier optional")
  test::assertEqual(earlier.computed, -1)
  test::assertEqual(rejected.id, rejectedTemporaryKey)
  test::assertEqual(rejectedChild.id, rejectedTemporaryChildKey)
  test::assertEqual(rejectedChild.recordId, rejectedTemporaryKey)
  test::assertEqual(rejected.serverText, "rejected placeholder")
  test::assertFalse(rejected.active)
  test::assertEqual(rejected.ratio, 0.0)
  test::assertTrue(rejected.optionalLabel == "rejected optional")
  test::assertEqual(rejected.computed, -1)
end

def verifyComputedConcurrency(firstProvider: SQLiteProvider, secondProvider: SQLiteProvider): Void
  let first = new GeneratedPropertiesDatabase(firstProvider)
  let second = new GeneratedPropertiesDatabase(secondProvider)
  let staleResult = first.records.where(id: 1).single()
  let remoteResult = second.records.where(id: 1).single()

  match staleResult
    case QueryValue.Failure(error)
      test::assertTrue(false)
    case QueryValue.Value(stale)
      match remoteResult
        case QueryValue.Failure(error)
          test::assertTrue(false)
        case QueryValue.Value(remote)
          test::assertEqual(stale.computed, remote.computed)
          stale.name = "client wins after rebase"
          stale.input = 10
          remote.input = 9
          saved(second.saveChanges(), 1)

          test::assertEqual(remote.computed, 18)

          failedConcurrency(first.saveChanges())

          test::assertEqual(stale.name, "client wins after rebase")
          test::assertEqual(stale.input, 10)
          test::assertEqual(stale.computed, 16)
          stale.serverText = "client default edit"

          let freshDatabase = new GeneratedPropertiesDatabase(secondProvider)
          let freshResult = freshDatabase.records.where(id: 1).single()

          match freshResult
            case QueryValue.Failure(error)
              test::assertTrue(false)
            case QueryValue.Value(fresh)
              test::assertEqual(fresh.computed, 18)
              saved(first.beginTransaction(), 0)

              test::assertTrue(first.records.rebase(stale, fresh) == null)
              test::assertEqual(stale.name, "client wins after rebase")
              test::assertEqual(stale.input, 10)
              test::assertEqual(stale.computed, 18)
              test::assertEqual(stale.serverText, "client default edit")
              saved(first.rollbackTransaction(), 0)

              test::assertEqual(stale.name, "client wins after rebase")
              test::assertEqual(stale.input, 10)
              test::assertEqual(stale.computed, 16)
              test::assertEqual(stale.serverText, "client default edit")

              test::assertTrue(first.records.rebase(stale, fresh) == null)
              test::assertEqual(stale.computed, 18)
              test::assertEqual(stale.serverText, "client default edit")
              saved(first.saveChanges(), 1)

              test::assertEqual(stale.computed, 20)
          end
      end
  end
end

def verifyDatabase(path: String): Void
  let schema = "CREATE TABLE records (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, input INTEGER NOT NULL, server_text TEXT NOT NULL DEFAULT 'database default', active INTEGER NOT NULL DEFAULT 1, ratio REAL NOT NULL DEFAULT 1.25, optional_label TEXT DEFAULT NULL, computed INTEGER NOT NULL GENERATED ALWAYS AS (input * 2) STORED); CREATE TABLE children (id INTEGER PRIMARY KEY, record_id INTEGER NOT NULL REFERENCES records(id), name TEXT NOT NULL UNIQUE);"

  test::assertTrue(createSQLiteFixture(path, schema))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      console::println("Generated properties: insert defaults, update refresh, and local edit rejection")
      verifyInsertUpdateAndRejectEdit(provider)
      console::println("Generated properties: failed insert placeholder recovery and retry")
      verifyFailedInsertRetry(provider)
      console::println("Generated properties: transaction rollback and retry")
      verifyTransactionGeneratedValues(provider)
      console::println("Generated properties: graph savepoint with returned values")
      verifyGeneratedGraphSavepoint(path, provider)

      match SQLiteProvider.openWritable(path)
        case SQLiteOpenResult.Failure(message)
          console::println(message)

          test::assertTrue(false)
        case SQLiteOpenResult.Opened(secondProvider)
          console::println("Generated properties: computed concurrency token and rebase")
          verifyComputedConcurrency(provider, secondProvider)

          test::assertTrue(secondProvider.close())
      end

      test::assertTrue(provider.close())
  end
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-generated-properties-")
    verifyDatabase(temporary.path() + "/properties.sqlite")
    return 0
  end
  return 1
end

def main(): Void
  let outcome = verifyFiles()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
