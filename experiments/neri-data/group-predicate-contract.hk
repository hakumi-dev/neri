use neri_data
use test
use host

class GroupPredicateRecord
  public id: Int
  public category: String?
  public amount: Int?
end

class GroupPredicateResult
  public category: String?
  public rows: Int

  def init(category: String?, rows: Int): Void
    this.category = category
    this.rows = rows
  end
end

class GroupPredicatePair
  public rows: Int
  public total: Int?

  def init(rows: Int, total: Int?): Void
    this.rows = rows
    this.total = total
  end
end

class GroupPredicateProvider: Provider
  public calls: Int = 0
  public seenSql: String = ""
  public seenParameterCount: Int = 0

  public override readonly def dialect(): SqlDialect
    return SqlDialect.PostgreSql()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return true
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.calls = this.calls + 1
    this.seenSql = plan.sql()
    this.seenParameterCount = plan.parameters().count()
    return ProviderResult.Rows([])
  end
end

def rejectGroupPredicateRecord(row: RawRow): DecodeResult<GroupPredicateRecord>
  return DecodeResult<GroupPredicateRecord>.Failure(QueryFailure.Provider("group predicate contract does not decode source rows"))
end

def groupPredicateQuery(): Query<GroupPredicateRecord>
  let mapping = new EntityMapping("GroupPredicateRecord", "group_predicate_records", [new MappingColumn("GroupPredicateRecord.id", "Int", "id"), new MappingColumn("GroupPredicateRecord.category", "String?", "category"), new MappingColumn("GroupPredicateRecord.amount", "Int?", "amount")])
  let decoder = new Decoder<GroupPredicateRecord>(rejectGroupPredicateRecord, new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())]))

  return new Query<GroupPredicateRecord>("group_predicate_records", decoder, mapping: mapping)
end

def groupPredicateCategory(): RowShape<GroupPredicateRecord, String?>
  let category: quote fn(GroupPredicateRecord): String? = quote do |row: GroupPredicateRecord|: String?
    return row.category
  end

  return fieldShape(optionalTextScalar(), category)
end

def groupPredicateAmount(): quote fn(GroupPredicateRecord): Int?
  return quote do |row: GroupPredicateRecord|: Int?
    return row.amount
  end
end

def groupPredicateResult(category: String?, rows: Int): GroupPredicateResult
  return new GroupPredicateResult(category, rows)
end

def groupPredicatePair(rows: Int, total: Int?): GroupPredicatePair
  return new GroupPredicatePair(rows, total)
end

def groupedPredicateQuery(): GroupedAggregate<GroupPredicateRecord, String?, Int, GroupPredicateResult>
  return selectGroups(groupBy(groupPredicateQuery(), groupPredicateCategory()), countRows<GroupPredicateRecord>(), groupPredicateResult)
end

def containsText(value: String, needle: String): Bool
  let valueLength = host::stringByteLength(value)
  let needleLength = host::stringByteLength(needle)

  if needleLength > valueLength
    return false
  end
  var start = 0

  while start <= valueLength - needleLength
    var matched = true
    var offset = 0

    while offset < needleLength
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

def assertGroupPredicateSql(predicate: GroupHaving<GroupPredicateRecord>, expected: String): Void
  match groupedPredicateQuery().having(predicate).take(2).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), expected))
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end
end

def main(): Void
  let provider = new GroupPredicateProvider()
  let filterOne: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id > 11
  end
  let filterTwo: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id > 12
  end
  let filterThree: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id > 13
  end
  let filterFour: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id > 14
  end
  let filterFive: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id > 15
  end
  let firstMetric = groupMetric(countRows<GroupPredicateRecord>().where(filterOne))
  let secondMetric = groupMetric(countRows<GroupPredicateRecord>().where(filterTwo))
  let thirdMetric = groupMetric(countRows<GroupPredicateRecord>().where(filterThree))
  let fourthMetric = groupMetric(countRows<GroupPredicateRecord>().where(filterFour))
  let fifthMetric = groupMetric(countRows<GroupPredicateRecord>().where(filterFive))
  let capturePredicate: quote fn(Int): Bool = quote do |value: Int|: Bool
    return value > 50
  end
  let comparison = firstMetric.equalTo(secondMetric).and(thirdMetric.notEqualTo(fourthMetric).not()).or(fifthMetric.where(capturePredicate))
  let sourcePredicate: quote fn(GroupPredicateRecord): Bool = quote do |row: GroupPredicateRecord|: Bool
    return row.id == 7
  end
  let source = groupPredicateQuery().matching(sourcePredicate)
  let grouped = selectGroups(groupBy(source, groupPredicateCategory()), countRows<GroupPredicateRecord>(), groupPredicateResult)
  let composed = grouped.take(2).having(comparison)

  match composed.compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertEqual(plan.sql().parameters().count(), 7)
      test::assertEqual(plan.sql().columns().count(), 2)
      test::assertTrue(containsText(plan.sql().sql(), "SELECT \"__neri_group_stage\".\"__neri_shape_0\", \"__neri_group_stage\".\"__neri_aggregate_1\" FROM"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" > $1"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" > $2"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" > $3"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" > $4"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" > $5"))
      test::assertTrue(containsText(plan.sql().sql(), "\"group_predicate_records\".\"id\" = $6"))
      test::assertTrue(containsText(plan.sql().sql(), "LIMIT 2) AS \"__neri_group_stage\" WHERE"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_group_stage\".\"__neri_aggregate_6\" > $7"))
      let first = plan.sql().parameters().first()

      test::assertTrue(first != null)
      if first != null
        match first.value()
          case Parameter.Int(value)
            test::assertEqual(value, 11)
          case Parameter.Float(value)
            test::assertTrue(false)
          case Parameter.Bool(value)
            test::assertTrue(false)
          case Parameter.Text(value)
            test::assertTrue(false)
        end
        let second = first.next()

        test::assertTrue(second != null)
        if second != null
          match second.value()
            case Parameter.Int(value)
              test::assertEqual(value, 12)
            case Parameter.Float(value)
              test::assertTrue(false)
            case Parameter.Bool(value)
              test::assertTrue(false)
            case Parameter.Text(value)
              test::assertTrue(false)
          end
          let third = second.next()

          test::assertTrue(third != null)
          if third != null
            match third.value()
              case Parameter.Int(value)
                test::assertEqual(value, 13)
              case Parameter.Float(value)
                test::assertTrue(false)
              case Parameter.Bool(value)
                test::assertTrue(false)
              case Parameter.Text(value)
                test::assertTrue(false)
            end
            let fourth = third.next()

            test::assertTrue(fourth != null)
            if fourth != null
              match fourth.value()
                case Parameter.Int(value)
                  test::assertEqual(value, 14)
                case Parameter.Float(value)
                  test::assertTrue(false)
                case Parameter.Bool(value)
                  test::assertTrue(false)
                case Parameter.Text(value)
                  test::assertTrue(false)
              end
              let fifth = fourth.next()

              test::assertTrue(fifth != null)
              if fifth != null
                match fifth.value()
                  case Parameter.Int(value)
                    test::assertEqual(value, 15)
                  case Parameter.Float(value)
                    test::assertTrue(false)
                  case Parameter.Bool(value)
                    test::assertTrue(false)
                  case Parameter.Text(value)
                    test::assertTrue(false)
                end
                let sixth = fifth.next()

                test::assertTrue(sixth != null)
                if sixth != null
                  match sixth.value()
                    case Parameter.Int(value)
                      test::assertEqual(value, 7)
                    case Parameter.Float(value)
                      test::assertTrue(false)
                    case Parameter.Bool(value)
                      test::assertTrue(false)
                    case Parameter.Text(value)
                      test::assertTrue(false)
                  end
                  let seventh = sixth.next()

                  test::assertTrue(seventh != null)
                  if seventh != null
                    match seventh.value()
                      case Parameter.Int(value)
                        test::assertEqual(value, 50)
                      case Parameter.Float(value)
                        test::assertTrue(false)
                      case Parameter.Bool(value)
                        test::assertTrue(false)
                      case Parameter.Text(value)
                        test::assertTrue(false)
                    end
                  end
                end
              end
            end
          end
        end
      end
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  let beforeValid = provider.calls

  match composed.all(provider)
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 0)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeValid + 1)
  test::assertEqual(provider.seenParameterCount, 7)
  test::assertTrue(containsText(provider.seenSql, "LIMIT 2) AS \"__neri_group_stage\" WHERE"))

  let leftRequired = groupMetric(countRows<GroupPredicateRecord>())
  let rightRequired = groupMetric(countNonNull(optionalIntScalar(), groupPredicateAmount()))

  assertGroupPredicateSql(leftRequired.lessThan(rightRequired), " < \"__neri_group_stage\".\"__neri_aggregate_3\"")
  assertGroupPredicateSql(leftRequired.lessOrEqual(rightRequired), " <= \"__neri_group_stage\".\"__neri_aggregate_3\"")
  assertGroupPredicateSql(leftRequired.greaterThan(rightRequired), " > \"__neri_group_stage\".\"__neri_aggregate_3\"")
  assertGroupPredicateSql(leftRequired.greaterOrEqual(rightRequired), " >= \"__neri_group_stage\".\"__neri_aggregate_3\"")

  let nullableLeft = groupMetric(sumInt(optionalIntScalar(), groupPredicateAmount()))
  let nullableRight = groupMetric(maxInt(optionalIntScalar(), groupPredicateAmount()))

  match groupedPredicateQuery().having(nullableLeft.equalTo(nullableRight)).take(2).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_group_stage\".\"__neri_aggregate_2\" IS NOT NULL"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_group_stage\".\"__neri_aggregate_3\" IS NOT NULL"))
      test::assertTrue(containsText(plan.sql().sql(), "\"__neri_group_stage\".\"__neri_aggregate_2\" IS NULL AND \"__neri_group_stage\".\"__neri_aggregate_3\" IS NULL"))
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  match groupedPredicateQuery().having(nullableLeft.notEqualTo(nullableRight)).take(2).compile(SqlDialect.PostgreSql())
    case CompileResult.Plan(plan)
      test::assertTrue(containsText(plan.sql().sql(), "NOT ("))
      test::assertTrue(containsText(plan.sql().sql(), "IS NOT NULL"))
      test::assertTrue(containsText(plan.sql().sql(), "IS NULL"))
    case CompileResult.Failure(error)
      test::assertTrue(false)
  end

  let optionalOrder = nullableLeft.lessThan(nullableRight)
  let mixedOptionalOrder = leftRequired.equalTo(leftRequired).or(optionalOrder)
  let beforeOptionalOrder = provider.calls

  match groupedPredicateQuery().having(mixedOptionalOrder).take(2).all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "ordered group metric comparison requires Int or Float output")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeOptionalOrder)

  let combinedMetric = groupMetric(combineAggregates(countRows<GroupPredicateRecord>(), sumInt(optionalIntScalar(), groupPredicateAmount()), groupPredicatePair))
  let invalidCombined = groupedPredicateQuery().having(combinedMetric.equalTo(combinedMetric)).take(2)
  let beforeCombined = provider.calls

  match invalidCombined.all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "group metric requires one scalar aggregate")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeCombined)

  var deepCondition = firstMetric.equalTo(secondMetric)
  var depth = 0

  while depth < 65
    deepCondition = deepCondition.not()
    depth = depth + 1
  end
  let beforeDeepCondition = provider.calls

  match groupedPredicateQuery().having(deepCondition).take(2).all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "grouped condition exceeds complexity limit")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeDeepCondition)

  var wideCondition = firstMetric.equalTo(secondMetric)
  var width = 0

  while width < 8
    wideCondition = wideCondition.or(wideCondition)
    width = width + 1
  end
  let beforeWideCondition = provider.calls

  match groupedPredicateQuery().having(wideCondition).take(2).all(provider)
    case QueryResult.Failure(error)
      match error
        case QueryFailure.UnsupportedCapability(name)
          test::assertEqual(name, "grouped condition exceeds complexity limit")
        case QueryFailure.MissingLimit(maximum)
          test::assertTrue(false)
        case QueryFailure.InvalidLimit(value, maximum)
          test::assertTrue(false)
        case QueryFailure.Provider(message)
          test::assertTrue(false)
        case QueryFailure.Cardinality(expected, actual)
          test::assertTrue(false)
        case QueryFailure.InvalidIdentifier(name)
          test::assertTrue(false)
        case QueryFailure.SourceMismatch(expected, actual)
          test::assertTrue(false)
        case QueryFailure.TypeMismatch(name, expected, actual)
          test::assertTrue(false)
        case QueryFailure.MissingColumn(name)
          test::assertTrue(false)
      end
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(provider.calls, beforeWideCondition)
end
