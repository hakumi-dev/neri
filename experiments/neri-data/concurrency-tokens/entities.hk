namespace concurrency_tokens_model

class Record
  public id: Int
  public name: String
  public note: String?
  public version: Int

  def init(id: Int, name: String, note: String?, version: Int): Void
    this.id = id
    this.name = name
    this.note = note
    this.version = version
  end
end

class OptionalRecord
  public id: Int
  public name: String
  public token: String?

  def init(id: Int, name: String, token: String?): Void
    this.id = id
    this.name = name
    this.token = token
  end
end

class KeyOnlyRecord
  public id: Int
  public name: String
  public version: Int

  def init(id: Int, name: String, version: Int): Void
    this.id = id
    this.name = name
    this.version = version
  end
end
