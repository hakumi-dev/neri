use reference
namespace concurrency_tokens_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_ConcurrencyDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Record: neri_data::EntityTracker<concurrency_tokens_model::Record>
  private visits_Record: neri_data::GraphVisitList<concurrency_tokens_model::Record>
  private tracker_OptionalRecord: neri_data::EntityTracker<concurrency_tokens_model::OptionalRecord>
  private visits_OptionalRecord: neri_data::GraphVisitList<concurrency_tokens_model::OptionalRecord>
  private tracker_KeyOnlyRecord: neri_data::EntityTracker<concurrency_tokens_model::KeyOnlyRecord>
  private visits_KeyOnlyRecord: neri_data::GraphVisitList<concurrency_tokens_model::KeyOnlyRecord>

  def init(changes: neri_data::ChangeContext, tracker_Record: neri_data::EntityTracker<concurrency_tokens_model::Record>, tracker_OptionalRecord: neri_data::EntityTracker<concurrency_tokens_model::OptionalRecord>, tracker_KeyOnlyRecord: neri_data::EntityTracker<concurrency_tokens_model::KeyOnlyRecord>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Record = tracker_Record
    this.visits_Record = new neri_data::GraphVisitList<concurrency_tokens_model::Record>(this.graph)
    this.tracker_OptionalRecord = tracker_OptionalRecord
    this.visits_OptionalRecord = new neri_data::GraphVisitList<concurrency_tokens_model::OptionalRecord>(this.graph)
    this.tracker_KeyOnlyRecord = tracker_KeyOnlyRecord
    this.visits_KeyOnlyRecord = new neri_data::GraphVisitList<concurrency_tokens_model::KeyOnlyRecord>(this.graph)
  end

  def add_records(root: concurrency_tokens_model::Record): neri_data::TrackHandleResult<concurrency_tokens_model::Record>
    match this.discover_records(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<concurrency_tokens_model::Record>.Failure(error)
    end
  end

  private def discover_records(entity: concurrency_tokens_model::Record): neri_data::GraphVisitResult<concurrency_tokens_model::Record>
    match this.visits_Record.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<concurrency_tokens_model::Record>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<concurrency_tokens_model::Record>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Record)

        if staged != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::Record>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_records(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::Record>.Failure(queued)
        end
        return neri_data::GraphVisitResult<concurrency_tokens_model::Record>.New(slot)
    end
  end

  private def scan_records(entity: concurrency_tokens_model::Record, owner: neri_data::GraphSlot<concurrency_tokens_model::Record>): neri_data::QueryFailure?
    return null
  end

  def add_optionalRecords(root: concurrency_tokens_model::OptionalRecord): neri_data::TrackHandleResult<concurrency_tokens_model::OptionalRecord>
    match this.discover_optionalRecords(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<concurrency_tokens_model::OptionalRecord>.Failure(error)
    end
  end

  private def discover_optionalRecords(entity: concurrency_tokens_model::OptionalRecord): neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>
    match this.visits_OptionalRecord.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_OptionalRecord)

        if staged != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_optionalRecords(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>.Failure(queued)
        end
        return neri_data::GraphVisitResult<concurrency_tokens_model::OptionalRecord>.New(slot)
    end
  end

  private def scan_optionalRecords(entity: concurrency_tokens_model::OptionalRecord, owner: neri_data::GraphSlot<concurrency_tokens_model::OptionalRecord>): neri_data::QueryFailure?
    return null
  end

  def add_keyOnlyRecords(root: concurrency_tokens_model::KeyOnlyRecord): neri_data::TrackHandleResult<concurrency_tokens_model::KeyOnlyRecord>
    match this.discover_keyOnlyRecords(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<concurrency_tokens_model::KeyOnlyRecord>.Failure(error)
    end
  end

  private def discover_keyOnlyRecords(entity: concurrency_tokens_model::KeyOnlyRecord): neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>
    match this.visits_KeyOnlyRecord.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_KeyOnlyRecord)

        if staged != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_keyOnlyRecords(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>.Failure(queued)
        end
        return neri_data::GraphVisitResult<concurrency_tokens_model::KeyOnlyRecord>.New(slot)
    end
  end

  private def scan_keyOnlyRecords(entity: concurrency_tokens_model::KeyOnlyRecord, owner: neri_data::GraphSlot<concurrency_tokens_model::KeyOnlyRecord>): neri_data::QueryFailure?
    return null
  end
end
