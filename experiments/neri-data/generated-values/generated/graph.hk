use reference
namespace generated_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_GeneratedDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Record: neri_data::EntityTracker<generated_model::Record>
  private visits_Record: neri_data::GraphVisitList<generated_model::Record>

  def init(changes: neri_data::ChangeContext, tracker_Record: neri_data::EntityTracker<generated_model::Record>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Record = tracker_Record
    this.visits_Record = new neri_data::GraphVisitList<generated_model::Record>(this.graph)
  end

  def add_records(root: generated_model::Record): neri_data::TrackHandleResult<generated_model::Record>
    match this.discover_records(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<generated_model::Record>.Failure(error)
    end
  end

  private def discover_records(entity: generated_model::Record): neri_data::GraphVisitResult<generated_model::Record>
    match this.visits_Record.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<generated_model::Record>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<generated_model::Record>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Record)

        if staged != null
          return neri_data::GraphVisitResult<generated_model::Record>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_records(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<generated_model::Record>.Failure(queued)
        end
        return neri_data::GraphVisitResult<generated_model::Record>.New(slot)
    end
  end

  private def scan_records(entity: generated_model::Record, owner: neri_data::GraphSlot<generated_model::Record>): neri_data::QueryFailure?
    return null
  end
end
