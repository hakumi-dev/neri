namespace neri_data

class ReferenceSelection<P, D>
  public dependent: D
  public key: Cell
  public foreignKey: Cell
  public target: P?
  public next: ReferenceSelection<P, D>?

  def init(dependent: D, key: Cell, foreignKey: Cell): Void
    this.dependent = dependent
    this.key = key
    this.foreignKey = foreignKey
  end
end

class ReferencePublication<P, D>
  public principal: P
  public children: D[]
  public next: ReferencePublication<P, D>?

  def init(principal: P, children: D[]): Void
    this.principal = principal
    this.children = children
  end
end

class ReferenceCollectionAudit<P, D>
  private relation: CollectionNavigation<P, D>
  private selected: ReferenceSelection<P, D>?

  def init(relation: CollectionNavigation<P, D>, selected: ReferenceSelection<P, D>?): Void
    this.relation = relation
    this.selected = selected
  end

  internal def accepts(principal: P): Bool
    var selected = this.selected

    while selected != null
      for member in this.relation.collection(principal)
        if reference::same(member, selected.dependent)
          let target = selected.target
          let inverse = this.relation.reference(selected.dependent)

          if target == null || inverse == null || !reference::same(
            target,
            principal
          ) || !reference::same(
            inverse,
            principal
          )
            return false
          end
        end
      end
      selected = selected.next
    end
    return true
  end
end

def referenceForeignKeyAllowed(value: Cell): Bool
  match value
    case Cell.Null()
      return true
    case Cell.Int(number)
      return true
    case Cell.Text(text)
      return true
    case Cell.Bool(boolean)
      return false
    case Cell.Float(number)
      return false
    case Cell.Binary(boolean)
      return false
  end
end

class ReferencedQuery<P, D>: AsyncNavigationPlan<D, P>
  private publicationObserver: (fn(TypedRows<D>, TypedRows<P>): Void)?
  private dependents: Query<D>
  private principals: Query<P>
  private relation: CollectionNavigation<P, D>

  def init(dependents: Query<D>, principals: Query<P>, relation: CollectionNavigation<P, D>): Void
    this.dependents = dependents
    this.principals = principals
    this.relation = relation
  end

  public def beforePublication(observer: fn(TypedRows<D>, TypedRows<P>): Void): ReferencedQuery<P, D>
    let clone = new ReferencedQuery<P, D>(this.dependents, this.principals, this.relation)

    clone.publicationObserver = observer
    return clone
  end

  internal def validateQueries(): QueryFailure?
    let dependentFailure = this.dependents.queryFailure()

    if dependentFailure != null
      return dependentFailure
    end
    let principalFailure = this.principals.queryFailure()

    if principalFailure != null
      return principalFailure
    end
    if !this.principals.isUnfilteredRoot()
      return QueryFailure.UnsupportedCapability("reference loading requires an unfiltered principal query root")
    end
    let dependentProvider = this.dependents.provider()
    let principalProvider = this.principals.provider()
    let dependentOwner = this.dependents.changeOwner()
    let principalOwner = this.principals.changeOwner()

    if dependentProvider == null || principalProvider == null || !reference::same(dependentProvider, principalProvider)
      return QueryFailure.Provider(ProviderFailure.State("reference queries require the same provider"))
    end
    if dependentOwner == null || principalOwner == null || !reference::same(
      dependentOwner,
      principalOwner
    ) || !dependentOwner.matchesProvider(dependentProvider)
      return QueryFailure.Provider(ProviderFailure.State("reference queries require the same change context and provider"))
    end
    if this.dependents.rowTracker() == null || this.principals.rowTracker() == null
      return QueryFailure.UnsupportedCapability("reference loading requires tracked query roots")
    end
    let dependentMapping = this.dependents.entityMapping()
    let principalMapping = this.principals.entityMapping()

    if dependentMapping == null || principalMapping == null
      return QueryFailure.UnsupportedCapability("reference loading requires mapped entities")
    end
    let dependentKey = dependentMapping.keyColumn()
    let principalKey = principalMapping.keyColumn()

    if dependentKey == null || principalKey == null
      return QueryFailure.UnsupportedCapability("reference loading requires mapped primary keys")
    end
    let dependentType = navigationColumnType(dependentMapping, dependentKey)
    let principalColumns = this.relation.principalColumns(principalMapping.primaryKeys())
    let principalType = principalColumns.Length == 0 ? "" : navigationColumnType(principalMapping, principalColumns[0])
    let foreignType = navigationColumnType(dependentMapping, this.relation.column())

    if (dependentType != "Int" && dependentType != "String") || (principalType != "Int" && principalType != "String") || (foreignType != "Int" && foreignType != "String" && foreignType != "Int?" && foreignType != "String?") || principalType != navigationUnderlyingType(foreignType)
      return QueryFailure.UnsupportedCapability("reference keys and foreign key require matching Int or String mappings")
    end
    if !navigationTupleColumnsValid(principalMapping, dependentMapping, principalColumns, this.relation.columns())
      return QueryFailure.UnsupportedCapability("reference key tuple mappings do not match")
    end
    return null
  end

  public def allAsync(options: StreamOptions? = null): result::Result<AsyncNavigation<D, P>, QueryFailure>
    let invalid = this.validateQueries()

    if invalid != null
      return result::Result<AsyncNavigation<D, P>, QueryFailure>.Error(invalid)
    end
    match prepareAsyncNavigation<D, P>(this, options)
      case AsyncNavigationStart.Failure(error)
        return result::Result<AsyncNavigation<D, P>, QueryFailure>.Error(error)
      case AsyncNavigationStart.Started(driver)
        let owned = new AsyncNavigation<D, P>(driver)

        return result::Result<AsyncNavigation<D, P>, QueryFailure>.Ok(transfer owned)
    end
  end

  public def loadAsync(
    rows: TypedRows<D>,
    options: StreamOptions? = null
  ): result::Result<AsyncNavigation<D, P>, QueryFailure>
    let invalid = this.validateQueries()

    if invalid != null
      return result::Result<AsyncNavigation<D, P>, QueryFailure>.Error(invalid)
    end
    let owned = new AsyncNavigation<D, P>(new AsyncNavigationDriver<D, P>(this, options, rows: rows))

    return result::Result<AsyncNavigation<D, P>, QueryFailure>.Ok(transfer owned)
  end

  public override def prepareRoot(options: StreamOptions?): AsyncQueryPreparation<D>
    let invalid = this.validateQueries()

    return invalid == null ? prepareQueryAsync<D>(this.dependents, options) : AsyncQueryPreparation<D>.Failure(invalid)
  end

  internal override def checkpointRoots(journal: NavigationJournal): Void
    let parents = this.principals.rowTracker()
    let children = this.dependents.rowTracker()

    if parents != null && children != null
      checkpointNavigation(this.relation, parents, children, new TypedRows<P>(), new TypedRows<D>(), journal)
    end
  end

  public override def navigationKeys(rows: TypedRows<D>): TypedRows<Cell>
    let keys = new TypedRows<Cell>()
    var row = rows.first()

    while row != null
      let key = this.relation.foreignKey(row.value)
      var existing = keys.first()
      var found = false

      while existing != null
        found = found || navigationCellEqual(existing.value, key)
        existing = existing.next
      end
      if !found && navigationKeyValid(key)
        keys.add(key)
      end
      row = row.next
    end
    return keys
  end

  public override def navigationMaximum(): Int
    return 10000
  end

  public override def prepareNavigation(
    keys: TypedRows<Cell>,
    maximum: Int,
    options: StreamOptions?
  ): AsyncQueryPreparation<P>
    let mapping = this.principals.entityMapping()
    let provider = this.principals.provider()

    if mapping == null || provider == null
      return AsyncQueryPreparation<P>.Failure(QueryFailure.UnsupportedCapability("asynchronous reference loading requires mapped provider roots"))
    end
    let query = this.principals.matchingTupleCells(this.relation.principalColumns(mapping.primaryKeys()), keys)

    match compilePipeline<P, P>(query, query.rowDecoder(), null, null, provider.dialect(), unbounded: true)
      case CompileResult.Failure(error)
        return AsyncQueryPreparation<P>.Failure(error)
      case CompileResult.Plan(plan)
        return prepareAsyncQuery<P>(provider, plan, options, maximumRows: maximum)
    end
  end

  public override def publishNavigation(rows: TypedRows<D>, related: TypedRows<P>): QueryResult<D>
    return this.load(rows, related)
  end

  public def all(): QueryResult<D>
    let invalid = this.validateQueries()

    if invalid != null
      return QueryResult<D>.Failure(invalid)
    end
    let journal = new NavigationJournal()

    this.checkpointRoots(journal)
    match this.dependents.all()
      case QueryResult.Failure(error)
        journal.rollback()
        return QueryResult<D>.Failure(error)
      case QueryResult.Rows(rows)
        let result = this.load(rows)

        match result
          case QueryResult.Failure(error)
            journal.rollback()
          case QueryResult.Rows(loaded)
            journal.discard()
        end
        return result
    end
  end

  public def load(rows: TypedRows<D>, prefetched: TypedRows<P>? = null): QueryResult<D>
    let journal = new NavigationJournal()
    let result = this.loadCore(rows, prefetched, journal)

    match result
      case QueryResult.Failure(error)
        journal.rollback()
      case QueryResult.Rows(loaded)
        journal.discard()
    end
    return result
  end

  private def loadCore(rows: TypedRows<D>, prefetched: TypedRows<P>?, journal: NavigationJournal): QueryResult<D>
    let invalid = this.validateQueries()

    if invalid != null
      return QueryResult<D>.Failure(invalid)
    end
    if rows.count() > 10000
      return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference root exceeds 10000 rows")))
    end
    let dependentTracker = this.dependents.rowTracker()
    let principalTracker = this.principals.rowTracker()
    let dependentMapping = this.dependents.entityMapping()
    let principalMapping = this.principals.entityMapping()

    if dependentTracker == null || principalTracker == null || dependentMapping == null || principalMapping == null
      return QueryResult<D>.Failure(QueryFailure.UnsupportedCapability("reference loading requires tracked mapped entities"))
    end
    let dependentKeyColumn = dependentMapping.keyColumn()
    let principalKeyColumn = principalMapping.keyColumn()

    if dependentKeyColumn == null || principalKeyColumn == null
      return QueryResult<D>.Failure(QueryFailure.UnsupportedCapability("reference loading requires mapped primary keys"))
    end
    var first: ReferenceSelection<P, D>? = null
    var last: ReferenceSelection<P, D>? = null
    let requested = new TypedRows<Cell>()
    var row = rows.first()

    while row != null
      let dependent = row.value
      let key = this.relation.dependentKey(dependent)
      let foreignKey = this.relation.foreignKey(dependent)

      if !navigationKeyValid(key) || !dependentTracker.ownsPersistedForNavigation(dependent)
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference dependent must be a live persisted tracked instance")))
      end
      if !referenceForeignKeyAllowed(foreignKey)
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference foreign key must be Int, String, or null")))
      end
      let current = dependentTracker.current(dependent)
      let baseline = dependentTracker.original(dependent)

      if current == null || baseline == null || !navigationTupleRowMatches(
        current,
        dependentMapping.primaryKeys(),
        key
      ) || !navigationTupleRowMatches(
        current,
        this.relation.columns(),
        foreignKey
      ) || !navigationTupleRowMatches(
        baseline,
        this.relation.columns(),
        foreignKey
      )
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference dependent key or foreign key differs from mapped baseline")))
      end
      var prior = first
      var duplicate = false

      while prior != null
        if navigationCellEqual(prior.key, key)
          if !reference::same(prior.dependent, dependent)
            return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference dependent key is duplicated")))
          end
          duplicate = true
        end
        prior = prior.next
      end
      if !duplicate
        let selected = new ReferenceSelection<P, D>(dependent, key, foreignKey)

        if last == null
          first = selected
        else
          last.next = selected
        end
        last = selected
        if navigationKeyValid(foreignKey)
          var requestedNode = requested.first()
          var found = false

          while requestedNode != null
            if navigationCellEqual(requestedNode.value, foreignKey)
              found = true
              break
            end
            requestedNode = requestedNode.next
          end
          if !found
            requested.add(foreignKey)
          end
        end
      end
      row = row.next
    end
    let staged = new NavigationStage<P>(requested.count())
    var batch = requested.first()

    if prefetched != null
      var current = prefetched.first()

      while current != null
        if !staged.accept(current.value)
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal query returned too many rows")))
        end
        current = current.next
      end
    end
    while batch != null && prefetched == null
      let keys = new TypedRows<Cell>()
      var taken = 0
      var cursor: TypedRowNode<Cell>? = batch

      while cursor != null && taken < 50
        keys.add(cursor.value)
        cursor = cursor.next
        taken = taken + 1
      end
      batch = cursor
      let principalQuery = this.principals.matchingTupleCells(
        this.relation.principalColumns(principalMapping.primaryKeys()),
        keys
      )
      let visit: fn(P): Bool = fn(value: P): Bool do
        return staged.accept(value)
      end

      match principalQuery.stream(visit)
        case StreamResult.Completed(count)
          continue
        case StreamResult.Stopped(count)
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal query returned too many rows")))
        case StreamResult.Cancelled(count)
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal load cancelled")))
        case StreamResult.Failure(error, count)
          return QueryResult<D>.Failure(error)
      end
    end
    var stagedPrincipal = staged.rows.first()
    var seen = new TypedRows<Cell>()

    while stagedPrincipal != null
      let key = this.relation.principalKey(stagedPrincipal.value)

      if !navigationKeyValid(key)
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal key must be Int or String")))
      end
      var request = requested.first()
      var matched = false

      while request != null
        if navigationCellEqual(request.value, key)
          matched = true
          break
        end
        request = request.next
      end
      if !matched
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal query returned an unrequested key")))
      end
      var earlier = seen.first()

      while earlier != null
        if navigationCellEqual(earlier.value, key)
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference principal query returned a duplicate key")))
        end
        earlier = earlier.next
      end
      seen.add(key)
      stagedPrincipal = stagedPrincipal.next
    end
    var firstTarget: NavigationBucket<P, D>? = null
    var lastTarget: NavigationBucket<P, D>? = null

    let publicationObserver = this.publicationObserver

    if publicationObserver != null
      publicationObserver(rows, staged.rows)
    end
    checkpointNavigation(this.relation, principalTracker, dependentTracker, staged.rows, rows, journal)
    match principalTracker.resolveRows(staged.rows)
      case QueryResult.Failure(error)
        return QueryResult<D>.Failure(error)
      case QueryResult.Rows(resolved)
        var principal = resolved.first()
        var raw = staged.rows.first()

        while principal != null && raw != null
          let key = this.relation.principalKey(principal.value)
          let original = principalTracker.original(principal.value)

          if !principalTracker.ownsPersistedForNavigation(principal.value) || !navigationCellEqual(
            key,
            this.relation.principalKey(raw.value)
          ) || original == null || !navigationTupleRowMatches(
            original,
            this.relation.principalColumns(principalMapping.primaryKeys()),
            key
          )
            return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("tracked reference principal key differs from database row")))
          end
          let target = new NavigationBucket<P, D>(principal.value, key)

          if lastTarget == null
            firstTarget = target
          else
            lastTarget.next = target
          end
          lastTarget = target
          principal = principal.next
          raw = raw.next
        end
    end
    var selected = first

    while selected != null
      let foreignKey = selected.foreignKey
      var target = firstTarget

      while target != null
        if navigationCellEqual(target.key, foreignKey)
          selected.target = target.principal
          break
        end
        target = target.next
      end
      if navigationKeyValid(foreignKey) && target == null
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("reference foreign key has no principal")))
      end
      let existingReference = this.relation.reference(selected.dependent)

      if existingReference != null
        if target == null || !reference::same(existingReference, target.principal)
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("tracked reference conflicts with foreign key")))
        end
      end
      if target != null
        let collection = this.relation.collection(target.principal)
        var present = false

        for member in collection
          if reference::same(member, selected.dependent)
            present = true
            break
          end
        end
        if existingReference != null && !present
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("tracked reference is absent from principal collection")))
        end
        if existingReference == null && present
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("principal collection contains dependent with missing inverse")))
        end
        if !present
          target.children.add(selected.dependent)
        end
      end
      selected = selected.next
    end
    let collectionAudit = new ReferenceCollectionAudit<P, D>(this.relation, first)
    let acceptPrincipal: fn(P): Bool = fn(value: P): Bool do
      return collectionAudit.accepts(value)
    end

    if !principalTracker.visitTracked(acceptPrincipal)
      return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("selected dependent appears in an incompatible principal collection")))
    end
    var target = firstTarget
    var firstPublication: ReferencePublication<P, D>? = null
    var lastPublication: ReferencePublication<P, D>? = null

    while target != null
      let audit = new NavigationInverseAudit<P, D>(this.relation, target.principal)
      let acceptTracked: fn(D): Bool = fn(value: D): Bool do
        return audit.accepts(value)
      end

      if !dependentTracker.visitTracked(acceptTracked)
        return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("tracked reference inverse is absent from principal collection")))
      end
      let existing = this.relation.collection(target.principal)

      for member in existing
        let inverse = this.relation.reference(member)
        let currentMember = dependentTracker.current(member)
        let originalMember = dependentTracker.original(member)

        if inverse == null || !reference::same(
          inverse,
          target.principal
        ) || !dependentTracker.ownsPersistedForNavigation(member) || !navigationCellEqual(
          this.relation.foreignKey(member),
          target.key
        ) || currentMember == null || originalMember == null || !navigationTupleRowMatches(
          currentMember,
          dependentMapping.primaryKeys(),
          this.relation.dependentKey(member)
        ) || !navigationTupleRowMatches(
          currentMember,
          this.relation.columns(),
          target.key
        ) || !navigationTupleRowMatches(
          originalMember,
          this.relation.columns(),
          target.key
        )
          return QueryResult<D>.Failure(QueryFailure.Provider(ProviderFailure.State("principal collection contains contradictory member")))
        end
      end
      var exact = existing
      let addition = target.children.first()

      if addition != null
        let cursor = new NavigationArrayCursor<D>(addition)

        exact = arrays::generate<D>(existing.Length + target.children.count()) do |index|
          if index < existing.Length
            return existing[index]
          end
          return cursor.next()
        end
      end
      let publication = new ReferencePublication<P, D>(target.principal, exact)

      if lastPublication == null
        firstPublication = publication
      else
        lastPublication.next = publication
      end
      lastPublication = publication
      target = target.next
    end
    var publication = firstPublication

    while publication != null
      this.relation.setCollection(publication.principal, publication.children)
      publication = publication.next
    end
    selected = first

    while selected != null
      this.relation.setReference(selected.dependent, selected.target)
      this.relation.markReference(selected.dependent, NavigationLoadState.Loaded())
      selected = selected.next
    end
    return QueryResult<D>.Rows(rows)
  end
end

def includeReference<P, D>(
  dependents: Query<D>,
  principals: Query<P>,
  relation: CollectionNavigation<P, D>
): ReferencedQuery<P, D>
  return new ReferencedQuery<P, D>(dependents, principals, relation)
end
