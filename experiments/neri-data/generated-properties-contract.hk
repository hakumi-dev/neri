use neri_data
use test

class GeneratedPropertyItem
  public id: Int
  public token: String
  public score: Float?
  public applied: Int = 0

  def init(id: Int): Void
    this.id = id
    this.token = "pending"
  end
end

class GeneratedPropertyProvider: Provider
  private lease: Int = 0
  private state: TransactionState = TransactionState.RolledBack()
  public malformed: Int = 0
  public commits: Int = 0
  public rollbacks: Int = 0
  public sawMutationBeforeCommit: Bool = false
  public firstItem: GeneratedPropertyItem?
  public secondItem: GeneratedPropertyItem?
  public returnedAlias: RawColumn?

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.Savepoints()
        return false
      case ProviderCapability.BoundedTypedReads()
        return true
      case ProviderCapability.StreamingReads()
        return true
      case ProviderCapability.SetWrites()
        return true
      case ProviderCapability.TrackedWrites()
        return true
      case ProviderCapability.ExplicitTransactions()
        return true
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Rows([])
  end

  public override def writeBatch(batch: readonly WriteBatch): WriteResult
    return WriteResult.Failure(WriteFailure.Transaction("generated values require a lease"))
  end

  public override def beginTransaction(): TransactionOpenResult
    this.lease = this.lease + 1
    this.state = TransactionState.Active()
    return TransactionOpenResult.Begun(this.lease)
  end

  public override def writeBatchInTransaction(batch: readonly WriteBatch, lease: Int): WriteResult
    if lease != this.lease || batch.count() != 2
      return WriteResult.Failure(WriteFailure.Provider("unexpected generated batch"))
    end
    let outputs = new WriteReturnedRows()
    var command = batch.first()
    var position = 0

    while command != null
      let next = command.next()
      let columns = command.command().returningColumns()

      if position == 1 && this.malformed == 7 && columns == null
        outputs.add(new RawRow([new RawColumn("unexpected", Cell.Int(1))]))
        position = position + 1
        command = next
        continue
      end
      if columns == null || columns.count() != 2 || columns.at(0).name() != "token" || columns.at(1).name() != "score"
        return WriteResult.Failure(WriteFailure.Provider("unexpected generated columns"))
      end
      let token = position == 0 ? "first generated" : "second generated"
      let value = position == 0 ? 1.5 : 2.5

      if position == 1 && this.malformed == 1
        outputs.add(new RawRow([new RawColumn("token", Cell.Text(token)), new RawColumn("score", Cell.Float(value)), new RawColumn("extra", Cell.Int(1))]))
      else if position == 1 && this.malformed == 2
        outputs.add(new RawRow([new RawColumn("token", Cell.Text(token))]))
      else if position == 1 && this.malformed == 3
        outputs.add(new RawRow([new RawColumn("token", Cell.Int(9)), new RawColumn("score", Cell.Float(value))]))
      else if position == 1 && this.malformed == 4
        outputs.add(new RawRow([new RawColumn("token", Cell.Null()), new RawColumn("score", Cell.Float(value))]))
      else
        let tokenColumn = new RawColumn("token", Cell.Text(token))

        if position == 0
          this.returnedAlias = tokenColumn
        end
        outputs.add(new RawRow([tokenColumn, new RawColumn("score", Cell.Float(value))]))
      end
      position = position + 1
      command = next
    end
    return WriteResult.SavedWithValues(batch.count(), outputs)
  end

  public override def commitTransaction(lease: Int): WriteResult
    if lease != this.lease
      return WriteResult.Failure(WriteFailure.Transaction("invalid lease"))
    end
    let first = this.firstItem
    let second = this.secondItem

    if first != null && (first.token != "pending" || first.applied != 0)
      this.sawMutationBeforeCommit = true
    end
    if second != null && (second.token != "pending" || second.applied != 0)
      this.sawMutationBeforeCommit = true
    end
    this.commits = this.commits + 1
    if this.malformed == 5
      return WriteResult.Failure(WriteFailure.Provider("commit failed"))
    end
    if this.malformed == 6
      let alias = this.returnedAlias

      if alias != null
        alias.value = Cell.Text("tampered after validation")
      end
    end
    this.state = TransactionState.Committed()
    return WriteResult.Saved(0)
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    if lease != this.lease
      return WriteResult.Failure(WriteFailure.Transaction("invalid lease"))
    end
    this.rollbacks = this.rollbacks + 1
    this.state = TransactionState.RolledBack()
    return WriteResult.Saved(0)
  end

  public override def transactionState(lease: Int): TransactionState
    if lease != this.lease
      return TransactionState.Invalid()
    end
    return this.state
  end
end

def captureGeneratedProperty(item: GeneratedPropertyItem): RawRow
  let score = item.score
  var scoreCell = Cell.Null()

  if score != null
    scoreCell = Cell.Float(score)
  end

  return new RawRow([new RawColumn("id", Cell.Int(item.id)), new RawColumn("token", Cell.Text(item.token)), new RawColumn("score", scoreCell)])
end

def applyGeneratedProperty(item: GeneratedPropertyItem, row: readonly RawRow): Void
  match row.value("token")
    case CellLookup.Found(value)
      match value
        case Cell.Text(text)
          item.token = text
        case Cell.Null()
        case Cell.Bool(value)
        case Cell.Int(value)
        case Cell.Float(value)
      end
    case CellLookup.Missing()
  end
  match row.value("score")
    case CellLookup.Found(value)
      match value
        case Cell.Float(number)
          item.score = number
        case Cell.Null()
          item.score = null
        case Cell.Bool(value)
        case Cell.Int(value)
        case Cell.Text(value)
      end
    case CellLookup.Missing()
  end
  item.applied = item.applied + 1
end

def generatedPropertyCase(malformed: Int): Void
  let successful = malformed == 0 || malformed == 6
  let provider = new GeneratedPropertyProvider()
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("token", ResultColumnKind.Text()), new ResultColumn("score", ResultColumnKind.Float(), true)])
  let generated = [new GeneratedValueColumn(new ResultColumn("token", ResultColumnKind.Text()), GeneratedValueTiming.OnAdd()), new GeneratedValueColumn(new ResultColumn("score", ResultColumnKind.Float(), true), GeneratedValueTiming.OnAdd())]
  let tracker = new EntityTracker<GeneratedPropertyItem>("items", "id", columns, captureGeneratedProperty, generatedColumns: generated, applyGenerated: applyGeneratedProperty)
  let context = new ChangeContext(provider)
  let first = new GeneratedPropertyItem(1)
  let second = new GeneratedPropertyItem(2)

  provider.malformed = malformed
  provider.firstItem = first
  provider.secondItem = second
  context.register(tracker.changeSet())

  test::assertTrue(tracker.add(first) == null)
  if malformed == 7
    test::assertTrue(tracker.attach(second) == null)
    test::assertTrue(tracker.remove(second) == null)
  else
    test::assertTrue(tracker.add(second) == null)
  end
  match context.saveChanges()
    case WriteResult.Failure(error)
      if successful
        test::assertTrue(false)
      else
        match error
          case WriteFailure.Provider(message)
            test::assertTrue(message != "")
          case WriteFailure.Validation(message)
            test::assertTrue(false)
          case WriteFailure.Concurrency(message)
            test::assertTrue(false)
          case WriteFailure.Constraint(message)
            test::assertTrue(false)
          case WriteFailure.Unsupported(message)
            test::assertTrue(false)
          case WriteFailure.Transaction(message)
            test::assertTrue(false)
        end
      end
    case WriteResult.Saved(count)
      test::assertTrue(successful)
      test::assertEqual(count, 2)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertFalse(provider.sawMutationBeforeCommit)
  if successful
    test::assertEqual(provider.commits, 1)
    test::assertEqual(provider.rollbacks, 0)
    test::assertEqual(first.token, "first generated")
    test::assertEqual(second.token, "second generated")
    test::assertTrue(first.score == 1.5)
    test::assertTrue(second.score == 2.5)
    test::assertEqual(first.applied, 1)
    test::assertEqual(second.applied, 1)
  else
    test::assertEqual(provider.commits, malformed == 5 ? 1 : 0)
    test::assertEqual(provider.rollbacks, 1)
    test::assertEqual(first.token, "pending")
    test::assertEqual(second.token, "pending")
    test::assertTrue(first.score == null)
    test::assertTrue(second.score == null)
    test::assertEqual(first.applied, 0)
    test::assertEqual(second.applied, 0)
  end
end

def main(): Void
  generatedPropertyCase(0)
  generatedPropertyCase(1)
  generatedPropertyCase(2)
  generatedPropertyCase(3)
  generatedPropertyCase(4)
  generatedPropertyCase(5)
  generatedPropertyCase(6)
  generatedPropertyCase(7)
end
