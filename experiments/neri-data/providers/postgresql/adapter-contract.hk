use buffers
use test
use resources
use neri_data
use neri_data_postgresql

class PostgreSQLTrackedValue
  public id: Int = 0
  public label: String = "generated"
  public version: Int = 1
end

def pgCaptureTracked(value: PostgreSQLTrackedValue): RawRow
  return new RawRow([
      new RawColumn("id", Cell.Int(value.id)),
      new RawColumn("label", Cell.Text(value.label)),
      new RawColumn("version", Cell.Int(value.version))
    ])
end

def pgDecodeTracked(row: RawRow): DecodeResult<PostgreSQLTrackedValue>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
    case DecodeResult.Value(id)
      match decodeString(row, "label")
        case DecodeResult.Failure(error)
          return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
        case DecodeResult.Value(label)
          match decodeInt(row, "version")
            case DecodeResult.Failure(error)
              return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
            case DecodeResult.Value(version)
              let entity = new PostgreSQLTrackedValue()

              entity.id = id
              entity.label = label
              entity.version = version
              return DecodeResult<PostgreSQLTrackedValue>.Value(entity)
          end
      end
  end
end

def verifyPostgreSQLTrackedWrites(provider: PostgreSQLProvider): Void
  saved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE neri_contract_entities(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,label TEXT NOT NULL,version BIGINT NOT NULL)",
        new WriteValues()
      )))
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("label", ResultColumnKind.Text()),
      new ResultColumn("version", ResultColumnKind.Int())
    ])
  let setKey: fn(PostgreSQLTrackedValue, Int): Void = fn(entity: PostgreSQLTrackedValue, id: Int): Void do
    entity.id = id
  end
  let tracker = new EntityTracker<PostgreSQLTrackedValue>(
    "neri_contract_entities",
    "id",
    columns,
    pgCaptureTracked,
    generatedKey: true,
    setGeneratedKey: setKey,
    concurrencyColumns: ["version"]
  )
  let context = new ChangeContext(provider)
  let entity = new PostgreSQLTrackedValue()

  context.register(tracker.changeSet())

  test::assertTrue(tracker.add(entity) == null)

  saved(context.saveChanges())

  test::assertTrue(entity.id > 0)

  let mapping = new EntityMapping(
    "PostgreSQLTrackedValue",
    "neri_contract_entities",
    [
      new MappingColumn("PostgreSQLTrackedValue.id", "Int", "id"),
      new MappingColumn("PostgreSQLTrackedValue.label", "String", "label"),
      new MappingColumn("PostgreSQLTrackedValue.version", "Int", "version")
    ],
    keyColumn: "id"
  )
  let query = new Query<PostgreSQLTrackedValue>(
    "neri_contract_entities",
    new Decoder<PostgreSQLTrackedValue>(pgDecodeTracked, columns),
    mapping: mapping,
    provider: provider,
    tracker: tracker,
    changes: context
  )

  match query.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertTrue(first.value == entity)
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  pgTypedAsyncSucceeded(verifyPostgreSQLQueryAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLProjectionAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLPairAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLShapeAsync(query))
  entity.label = "local update"
  entity.version = 2
  saved(context.saveChanges())
  saved(provider.executeSet(new SetWritePlan("UPDATE neri_contract_entities SET version=99", new WriteValues())))
  entity.label = "stale update"
  entity.version = 3
  match context.saveChanges()
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Concurrency(message)
          test::assertTrue(message != "")
        case WriteFailure.Provider(error)
          test::assertTrue(false)
        case WriteFailure.Cleanup(error)
          test::assertTrue(false)
        case WriteFailure.Validation(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, rows)
      test::assertTrue(false)
  end
end

def verifyPostgreSQLScalarRows(provider: PostgreSQLProvider): Void
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("payload", ResultColumnKind.Binary(), true),
      new ResultColumn("score", ResultColumnKind.Float()),
      new ResultColumn("amount", ResultColumnKind.Text())
    ])

  match provider.execute(new SqlPlan(
      "SELECT id,payload,score,amount FROM neri_contract_scalars ORDER BY id",
      new ParameterValues(),
      3,
      columns
    ))
    case ProviderResult.Failure(error)
      console::println(providerFailureMessage(error))

      test::assertTrue(false)
    case ProviderResult.Rows(rows)
      test::assertEqual(rows.Length, 3)

      match decodeByteBuffer(rows[0], "payload")
        case DecodeResult.Value(value)
          let bytes = value.snapshot()

          test::assertEqual(bytes.Length, 4)
          test::assertEqual(bytes[0], 0 as Byte)
          test::assertEqual(bytes[1], 255 as Byte)
          test::assertEqual(bytes[2], 92 as Byte)
          test::assertEqual(bytes[3], 39 as Byte)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeByteBuffer(rows[1], "payload")
        case DecodeResult.Value(value)
          test::assertEqual(value.snapshot().Length, 0)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeNullableByteBuffer(rows[2], "payload")
        case DecodeResult.Value(value)
          test::assertTrue(value == null)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeFloat(rows[0], "score")
        case DecodeResult.Value(value)
          test::assertEqual(value, 1.25)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeDecimal(rows[0], "amount")
        case DecodeResult.Value(value)
          test::assertEqual(value.text(), "9007199254740993.000000000000000001")
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
  end
end

def verifyPostgreSQLScalars(provider: PostgreSQLProvider): Void
  saved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE neri_contract_scalars(id BIGINT PRIMARY KEY,payload BYTEA,score DOUBLE PRECISION NOT NULL,amount TEXT NOT NULL)",
        new WriteValues()
      )))
  let payload = new ByteBuffer(4, 4)
  let values = new WriteValues()

  payload.append(0 as Byte)
  payload.append(255 as Byte)
  payload.append(92 as Byte)
  payload.append(39 as Byte)
  values.add(Cell.Binary(payload))
  values.add(Cell.Float(1.25))
  values.add(Cell.Text("9007199254740993.000000000000000001"))
  saved(provider.executeSet(new SetWritePlan(
        "INSERT INTO neri_contract_scalars VALUES(1,$1,$2,$3),(2,''::bytea,$2,$3),(3,NULL,$2,$3)",
        values
      )))
  verifyPostgreSQLScalarRows(provider)
  saved(provider.executeSet(new SetWritePlan("SET bytea_output='escape'", new WriteValues())))
  verifyPostgreSQLScalarRows(provider)
  saved(provider.executeSet(new SetWritePlan("SET bytea_output='hex'", new WriteValues())))
end

def pgMigrationApplied(result: MigrationResult, expected: Int): Void
  match result
    case MigrationResult.Applied(count)
      test::assertEqual(count, expected)
    case MigrationResult.Failure(error)
      test::assertTrue(false)
  end
end

def verifyPostgreSQLMigrations(provider: PostgreSQLProvider): Void
  let migration = new Migration(
    "pg_contract_001",
    [SchemaOp.CreateTable(
        "neri_contract_migrated",
        [new SchemaColumn("id", SchemaType.Int(), primaryKey: true), new SchemaColumn("value", SchemaType.Text())]
      )],
    [SchemaOp.DropTable("neri_contract_migrated")]
  )
  let catalog = new MigrationSet([migration])

  pgMigrationApplied(provider.migrate(catalog), 1)
  pgMigrationApplied(provider.migrate(catalog), 0)
  match provider.migrationHistory(catalog)
    case MigrationHistoryResult.Loaded(stamps)
      test::assertEqual(stamps.Length, 1)
      test::assertEqual(stamps[0].id(), "pg_contract_001")
    case MigrationHistoryResult.Failure(error)
      test::assertTrue(false)
  end
  let drifted = new MigrationSet([new Migration(
        "pg_contract_001",
        [SchemaOp.CreateTable("neri_contract_migrated", [new SchemaColumn("id", SchemaType.Int(), primaryKey: true)])],
        [SchemaOp.DropTable("neri_contract_migrated")]
      )])

  match provider.migrationHistory(drifted)
    case MigrationHistoryResult.Failure(error)
      match error
        case MigrationFailure.Drift(message)
          test::assertTrue(message != "")
        case MigrationFailure.Validation(message)
          test::assertTrue(false)
        case MigrationFailure.Unsupported(message)
          test::assertTrue(false)
        case MigrationFailure.Provider(error)
          test::assertTrue(false)
        case MigrationFailure.Cleanup(error)
          test::assertTrue(false)
      end
    case MigrationHistoryResult.Loaded(stamps)
      test::assertTrue(false)
  end
  pgMigrationApplied(provider.migrate(catalog, ""), 1)
  match provider.migrationHistory(catalog)
    case MigrationHistoryResult.Loaded(stamps)
      test::assertEqual(stamps.Length, 0)
    case MigrationHistoryResult.Failure(error)
      test::assertTrue(false)
  end
end

def pgTrackedId(): quote fn(PostgreSQLTrackedValue): Int
  return quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.id
  end
end

def pgTrackedLabel(): quote fn(PostgreSQLTrackedValue): String
  return quote do |entity: PostgreSQLTrackedValue|: String
    return entity.label
  end
end

def verifyPostgreSQLQueryAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  using operation <- query.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLProjectionAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let projection = select(query, intScalar(), pgTrackedId())

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)
              test::assertTrue(rows.inspectItems(1)[0] > 0)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLPairAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let materialize: fn(Int, String): String = fn(id: Int, label: String): String do
    return (id as String) + label
  end
  let projection = select2(query, intScalar(), pgTrackedId(), textScalar(), pgTrackedLabel(), materialize)

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLShapeAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let projection = query.select(intScalar(), pgTrackedId())

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def pgTypedAsyncSucceeded(outcome: resources::Outcome<Int, QueryFailure>): Void
  test::assertEqual(outcome.closeFailures.count(), 0)

  match outcome.completion
    case resources::Completion.Value(code)
      test::assertEqual(code, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end
