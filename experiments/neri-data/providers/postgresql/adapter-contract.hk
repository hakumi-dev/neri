use neri_data_schema_contract
use buffers
use test
use resources
use neri_data
use neri_data_postgresql
use neri_data_async_contract

class PostgreSQLTrackedValue
  public id: Int = 0
  public label: String = "generated"
  public version: Int = 1
end

class PostgreSQLDecimalValue
  public amount: Decimal = Decimal.zero()
end

def pgDecodeDecimalValue(row: RawRow): DecodeResult<PostgreSQLDecimalValue>
  match decodeDecimal(row, "amount")
    case DecodeResult.Failure(error)
      return DecodeResult<PostgreSQLDecimalValue>.Failure(error)
    case DecodeResult.Value(amount)
      let value = new PostgreSQLDecimalValue()

      value.amount = amount
      return DecodeResult<PostgreSQLDecimalValue>.Value(value)
  end
end

def pgDecimalQuery(provider: PostgreSQLProvider, sql: String): Query<PostgreSQLDecimalValue>
  let columns = new ResultColumns([new ResultColumn("amount", ResultColumnKind.Text())])
  let mapping = new EntityMapping("PostgreSQLDecimalValue", "decimal_values", [
      new MappingColumn("PostgreSQLDecimalValue.amount", "neri_data.Decimal", "amount")
    ], readOnly: true)

  return sqlQuery<PostgreSQLDecimalValue>(
    sql,
    new ParameterValues(),
    new Decoder<PostgreSQLDecimalValue>(pgDecodeDecimalValue, columns),
    provider,
    mapping
  )
end

def verifyPostgreSQLDecimalQueries(provider: PostgreSQLProvider): Void
  let increment = Decimal.parse("0.09")
  let boundary = Decimal.parse("9007199254740993.01")

  test::assertTrue(increment != null && boundary != null)
  if increment == null || boundary == null
    return
  end
  let query = pgDecimalQuery(provider, "SELECT v AS amount FROM (VALUES ('0'),('1'),('9007199254740993.01')) AS d(v)")
  let amount = decimalField(quote do |value: PostgreSQLDecimalValue|: Decimal
      return value.amount
    end)

  match query.orderByDecimal(amount.subtract(decimalValue<PostgreSQLDecimalValue>(boundary))).take(3).all()
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(failure)
          console::println(providerFailureMessage(failure))
        case QueryFailure.UnsupportedCapability(name)
          console::println(name)
        case QueryFailure.MissingColumn(name)
          console::println(name)
        case QueryFailure.SourceMismatch(expected, actual)
          console::println(expected + " != " + actual)
        case QueryFailure.TypeMismatch(column, expected, actual)
          console::println(column + ": " + expected + " != " + actual)
        case QueryFailure.InvalidIdentifier(name)
          console::println(name)
        case QueryFailure.InvalidLimit(value, maximum)
          console::println("invalid Decimal limit")
        case QueryFailure.MissingLimit(maximum)
          console::println("missing Decimal limit")
        case QueryFailure.Cleanup(cleanup)
          console::println("Decimal query cleanup failed")
        case QueryFailure.Cardinality(expected, actual)
          console::println("Decimal query cardinality failed")
      end

      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 3)
      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.amount.text(), "0")
        let second = first.next

        test::assertTrue(second != null)
        if second != null
          test::assertEqual(second.value.amount.text(), "1")
        end
      end
  end
  match query.matchingDecimal(amount.equalTo(decimalValue<PostgreSQLDecimalValue>(boundary))).take(1).selectDecimal(amount.add(decimalValue<PostgreSQLDecimalValue>(increment))).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.text(), "9007199254740993.1")
      end
  end
  for sql in ["SELECT '1.00' AS amount", "SELECT NULL::text AS amount"]
    match pgDecimalQuery(provider, sql).take(1).selectDecimal(amount).all()
      case QueryResult.Failure(error)
      case QueryResult.Rows(rows)
        test::assertTrue(false)
    end
  end
end

def verifyPostgreSQLCommitCancellation(provider: PostgreSQLProvider): Void
  match awaitAsyncControl(provider.beginControlAsync(AsyncTransactionAction.Begin()))
    case AsyncControlResult.Begun(lease)
      match provider.beginControlAsync(AsyncTransactionAction.Commit(lease))
        case AsyncControlStart.Failure(error)
          test::assertTrue(false)
        case AsyncControlStart.Started(driver)
          driver.cancel()
          asyncControlSaved(awaitAsyncControl(AsyncControlStart.Started(driver)))
      end
      match provider.transactionState(lease)
        case TransactionState.Committed()
        case TransactionState.Active()
          test::assertTrue(false)
        case TransactionState.Failed()
          test::assertTrue(false)
        case TransactionState.Invalid()
          test::assertTrue(false)
        case TransactionState.RolledBack()
          test::assertTrue(false)
      end
    case AsyncControlResult.Failure(error)
      test::assertTrue(false)
    case AsyncControlResult.Saved()
      test::assertTrue(false)
    case AsyncControlResult.Created(id)
      test::assertTrue(false)
  end
end

def pgCaptureTracked(value: PostgreSQLTrackedValue): RawRow
  return new RawRow([
      new RawColumn("id", Cell.Int(value.id)),
      new RawColumn("label", Cell.Text(value.label)),
      new RawColumn("version", Cell.Int(value.version))
    ])
end

def pgDecodeTracked(row: RawRow): DecodeResult<PostgreSQLTrackedValue>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
    case DecodeResult.Value(id)
      match decodeString(row, "label")
        case DecodeResult.Failure(error)
          return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
        case DecodeResult.Value(label)
          match decodeInt(row, "version")
            case DecodeResult.Failure(error)
              return DecodeResult<PostgreSQLTrackedValue>.Failure(error)
            case DecodeResult.Value(version)
              let entity = new PostgreSQLTrackedValue()

              entity.id = id
              entity.label = label
              entity.version = version
              return DecodeResult<PostgreSQLTrackedValue>.Value(entity)
          end
      end
  end
end

def pgComputedUpdateAsync(
  query: Query<PostgreSQLTrackedValue>,
  setters: UpdateSet<PostgreSQLTrackedValue>
): resources::Outcome<Int, WriteFailure>
  using operation <- query.executeUpdateSetAsync(setters)
    while true
      match operation.poll()
        case AsyncWritePoll.Pending(socket, interest)
          continue
        case AsyncWritePoll.Completed(result)
          match result
            case WriteResult.Failure(error)
              return error
            case WriteResult.Saved(count)
              test::assertEqual(count, 1)
            case WriteResult.SavedWithValues(count, rows)
              test::assertTrue(false)
          end
          return 0
      end
    end
  end
  return 1
end

def verifyPostgreSQLComputedUpdates(provider: PostgreSQLProvider): Void
  saved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE neri_computed_entities(id BIGINT PRIMARY KEY,label TEXT,version BIGINT)",
        new WriteValues()
      )))
  saved(provider.executeSet(new SetWritePlan(
        "INSERT INTO neri_computed_entities VALUES(1,'bulk',1)",
        new WriteValues()
      )))
  let mapping = new EntityMapping("PostgreSQLTrackedValue", "neri_computed_entities", [
      new MappingColumn("PostgreSQLTrackedValue.id", "Int", "id"),
      new MappingColumn("PostgreSQLTrackedValue.label", "String", "label"),
      new MappingColumn("PostgreSQLTrackedValue.version", "Int", "version")
    ], "id")
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("label", ResultColumnKind.Text()),
      new ResultColumn("version", ResultColumnKind.Int())
    ])
  let query = new Query<PostgreSQLTrackedValue>(
    mapping.table(), new Decoder<PostgreSQLTrackedValue>(pgDecodeTracked, columns), mapping: mapping, provider: provider
  )
  let version = quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.version
  end
  let increment = quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.version + 1
  end
  let suffix = quote do |entity: PostgreSQLTrackedValue|: String
    return entity.label + "!"
  end
  let setters = updateSet<PostgreSQLTrackedValue>().set(version, increment).set(pgTrackedLabel(), suffix)

  saved(query.executeUpdateSet(setters))
  asyncContextSaved(pgComputedUpdateAsync(query, setters))
  match query.all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value.version, 3)
        test::assertEqual(first.value.label, "bulk!!")
      end
  end
  for invalid in ["9223372036854775807", "NULL"]
    saved(provider.executeSet(new SetWritePlan(
          "UPDATE neri_computed_entities SET version=" + invalid,
          new WriteValues()
        )))
    match query.executeUpdateSet(setters)
      case WriteResult.Failure(error)
      case WriteResult.Saved(count)
        test::assertTrue(false)
      case WriteResult.SavedWithValues(count, rows)
        test::assertTrue(false)
    end
    let failedAsync = pgComputedUpdateAsync(query, setters)

    test::assertEqual(failedAsync.closeFailures.count(), 0)
    match failedAsync.completion
      case resources::Completion.Value(value)
        test::assertTrue(false)
      case resources::Completion.Failure(error)
    end
    match query.select(textScalar(), pgTrackedLabel()).all()
      case QueryResult.Failure(error)
        test::assertTrue(false)
      case QueryResult.Rows(rows)
        let first = rows.first()

        test::assertTrue(first != null)
        if first != null
          test::assertEqual(first.value, "bulk!!")
        end
    end
  end
end

def verifyPostgreSQLTrackedWrites(provider: PostgreSQLProvider): Void
  saved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE neri_contract_entities(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,label TEXT NOT NULL,version BIGINT NOT NULL)",
        new WriteValues()
      )))
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("label", ResultColumnKind.Text()),
      new ResultColumn("version", ResultColumnKind.Int())
    ])
  let setKey: fn(PostgreSQLTrackedValue, Int): Void = fn(entity: PostgreSQLTrackedValue, id: Int): Void do
    entity.id = id
  end
  let tracker = new EntityTracker<PostgreSQLTrackedValue>(
    "neri_contract_entities",
    "id",
    columns,
    pgCaptureTracked,
    generatedKey: true,
    setGeneratedKey: setKey,
    concurrencyColumns: ["version"]
  )
  let context = new ChangeContext(provider)
  let entity = new PostgreSQLTrackedValue()

  context.register(tracker.changeSet())

  test::assertTrue(tracker.add(entity) == null)

  asyncContextSaved(awaitAsyncContextSave(context, 1))

  test::assertTrue(entity.id > 0)

  let mapping = new EntityMapping(
    "PostgreSQLTrackedValue",
    "neri_contract_entities",
    [
      new MappingColumn("PostgreSQLTrackedValue.id", "Int", "id"),
      new MappingColumn("PostgreSQLTrackedValue.label", "String", "label"),
      new MappingColumn("PostgreSQLTrackedValue.version", "Int", "version")
    ],
    keyColumn: "id"
  )
  let query = new Query<PostgreSQLTrackedValue>(
    "neri_contract_entities",
    new Decoder<PostgreSQLTrackedValue>(pgDecodeTracked, columns),
    mapping: mapping,
    provider: provider,
    tracker: tracker,
    changes: context
  )

  match query.all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertEqual(rows.count(), 1)
      test::assertTrue(first != null)
      if first != null
        test::assertTrue(reference::same(first.value, entity))
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  pgTypedAsyncSucceeded(verifyPostgreSQLQueryAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLProjectionAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLPairAsync(query))
  pgTypedAsyncSucceeded(verifyPostgreSQLShapeAsync(query))
  verifyPostgreSQLAggregates(provider, query, entity.id)
  verifyPostgreSQLCheckedExpressions(provider, query, entity.id)
  entity.label = "local update"
  entity.version = 2
  saved(context.saveChanges())
  saved(provider.executeSet(new SetWritePlan("UPDATE neri_contract_entities SET version=99", new WriteValues())))
  entity.label = "stale update"
  entity.version = 3
  match context.saveChanges()
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Concurrency(message)
          test::assertTrue(message != "")
        case WriteFailure.Provider(error)
          test::assertTrue(false)
        case WriteFailure.Cleanup(error)
          test::assertTrue(false)
        case WriteFailure.Validation(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, rows)
      test::assertTrue(false)
  end
end

def verifyPostgreSQLScalarRows(provider: PostgreSQLProvider): Void
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("payload", ResultColumnKind.Binary(), true),
      new ResultColumn("score", ResultColumnKind.Float()),
      new ResultColumn("amount", ResultColumnKind.Text())
    ])

  match provider.execute(new SqlPlan(
      "SELECT id,payload,score,amount FROM neri_contract_scalars ORDER BY id",
      new ParameterValues(),
      3,
      columns
    ))
    case ProviderResult.Failure(error)
      console::println(providerFailureMessage(error))

      test::assertTrue(false)
    case ProviderResult.Rows(rows)
      test::assertEqual(rows.Length, 3)

      match decodeByteBuffer(rows[0], "payload")
        case DecodeResult.Value(value)
          let bytes = value.snapshot()

          test::assertEqual(bytes.Length, 4)
          test::assertEqual(bytes[0], 0 as Byte)
          test::assertEqual(bytes[1], 255 as Byte)
          test::assertEqual(bytes[2], 92 as Byte)
          test::assertEqual(bytes[3], 39 as Byte)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeByteBuffer(rows[1], "payload")
        case DecodeResult.Value(value)
          test::assertEqual(value.snapshot().Length, 0)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeNullableByteBuffer(rows[2], "payload")
        case DecodeResult.Value(value)
          test::assertTrue(value == null)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeFloat(rows[0], "score")
        case DecodeResult.Value(value)
          test::assertEqual(value, 1.25)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
      match decodeDecimal(rows[0], "amount")
        case DecodeResult.Value(value)
          test::assertEqual(value.text(), "9007199254740993.000000000000000001")
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
  end
end

def verifyPostgreSQLScalars(provider: PostgreSQLProvider): Void
  saved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE neri_contract_scalars(id BIGINT PRIMARY KEY,payload BYTEA,score DOUBLE PRECISION NOT NULL,amount TEXT NOT NULL)",
        new WriteValues()
      )))
  let payload = new ByteBuffer(4, 4)
  let values = new WriteValues()

  payload.append(0 as Byte)
  payload.append(255 as Byte)
  payload.append(92 as Byte)
  payload.append(39 as Byte)
  values.add(Cell.Binary(payload))
  values.add(Cell.Float(1.25))
  values.add(Cell.Text("9007199254740993.000000000000000001"))
  saved(provider.executeSet(new SetWritePlan(
        "INSERT INTO neri_contract_scalars VALUES(1,$1,$2,$3),(2,''::bytea,$2,$3),(3,NULL,$2,$3)",
        values
      )))
  verifyPostgreSQLScalarRows(provider)
  saved(provider.executeSet(new SetWritePlan("SET bytea_output='escape'", new WriteValues())))
  verifyPostgreSQLScalarRows(provider)
  saved(provider.executeSet(new SetWritePlan("SET bytea_output='hex'", new WriteValues())))
end

def pgMigrationApplied(result: MigrationResult, expected: Int): Void
  match result
    case MigrationResult.Applied(count)
      test::assertEqual(count, expected)
    case MigrationResult.Failure(error)
      match error
        case MigrationFailure.Validation(message)
          console::println(message)
        case MigrationFailure.Unsupported(message)
          console::println(message)
        case MigrationFailure.Drift(message)
          console::println(message)
        case MigrationFailure.Provider(failure)
          console::println(providerFailureMessage(failure))
        case MigrationFailure.Cleanup(failure)
          console::println("migration cleanup failed")
      end

      test::assertTrue(false)
  end
end

def verifyPostgreSQLMigrations(provider: PostgreSQLProvider): Void
  let migration = new Migration(
    "pg_contract_001",
    [SchemaOp.CreateTable(
        "neri_contract_migrated",
        [new SchemaColumn("id", SchemaType.Int(), primaryKey: true), new SchemaColumn("value", SchemaType.Text())]
      )],
    [SchemaOp.DropTable("neri_contract_migrated")]
  )
  let catalog = new MigrationSet([migration])

  pgMigrationApplied(provider.migrate(catalog), 1)
  pgMigrationApplied(provider.migrate(catalog), 0)
  match provider.migrationHistory(catalog)
    case MigrationHistoryResult.Loaded(stamps)
      test::assertEqual(stamps.Length, 1)
      test::assertEqual(stamps[0].id(), "pg_contract_001")
    case MigrationHistoryResult.Failure(error)
      test::assertTrue(false)
  end
  let drifted = new MigrationSet([new Migration(
        "pg_contract_001",
        [SchemaOp.CreateTable("neri_contract_migrated", [new SchemaColumn("id", SchemaType.Int(), primaryKey: true)])],
        [SchemaOp.DropTable("neri_contract_migrated")]
      )])

  match provider.migrationHistory(drifted)
    case MigrationHistoryResult.Failure(error)
      match error
        case MigrationFailure.Drift(message)
          test::assertTrue(message != "")
        case MigrationFailure.Validation(message)
          test::assertTrue(false)
        case MigrationFailure.Unsupported(message)
          test::assertTrue(false)
        case MigrationFailure.Provider(error)
          test::assertTrue(false)
        case MigrationFailure.Cleanup(error)
          test::assertTrue(false)
      end
    case MigrationHistoryResult.Loaded(stamps)
      test::assertTrue(false)
  end
  pgMigrationApplied(provider.migrate(catalog, ""), 1)
  match provider.migrationHistory(catalog)
    case MigrationHistoryResult.Loaded(stamps)
      test::assertEqual(stamps.Length, 0)
    case MigrationHistoryResult.Failure(error)
      test::assertTrue(false)
  end
end

def pgTrackedId(): quote fn(PostgreSQLTrackedValue): Int
  return quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.id
  end
end

def pgAggregateOverflow(error: QueryFailure): Bool
  match error
    case QueryFailure.Provider(failure)
      match failure
        case ProviderFailure.Driver(details)
          return details.sqlState() == "22003"
        case ProviderFailure.State(message)
        case ProviderFailure.Cleanup(cleanup)
      end
    case QueryFailure.InvalidIdentifier(name)
    case QueryFailure.InvalidLimit(value, maximum)
    case QueryFailure.MissingLimit(maximum)
    case QueryFailure.SourceMismatch(expected, actual)
    case QueryFailure.UnsupportedCapability(name)
    case QueryFailure.MissingColumn(name)
    case QueryFailure.TypeMismatch(column, expected, actual)
    case QueryFailure.Cardinality(expected, actual)
    case QueryFailure.Cleanup(cleanup)
  end
  return false
end

def verifyPostgreSQLAggregates(provider: PostgreSQLProvider, query: Query<PostgreSQLTrackedValue>, expected: Int): Void
  match aggregateRows(query, sumInt(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == expected)
    case QueryValue.Failure(error)
      console::println(diagnosticQueryFailureKind(error))

      test::assertTrue(false)
  end
  match aggregateRows(query, sumIntOrZero(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertEqual(value, expected)
    case QueryValue.Failure(error)
      console::println(diagnosticQueryFailureKind(error))

      test::assertTrue(false)
  end
  match aggregateRows(query, average(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == (expected as Float))
    case QueryValue.Failure(error)
      console::println(diagnosticQueryFailureKind(error))

      test::assertTrue(false)
  end
  let positive: quote fn(PostgreSQLTrackedValue): Bool = quote do |entity: PostgreSQLTrackedValue|: Bool
    return entity.id > 0
  end

  match aggregateRows(query, sumIntOrZero(intScalar(), pgTrackedId()).distinct().where(positive)).value()
    case QueryValue.Value(value)
      test::assertEqual(value, expected)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let empty = query.where(id: -1)

  match aggregateRows(empty, sumInt(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(empty, sumIntOrZero(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match aggregateRows(empty, average(intScalar(), pgTrackedId())).value()
    case QueryValue.Value(value)
      test::assertTrue(value == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let extra = new WriteValues()

  extra.add(Cell.Int(expected + 1))
  saved(provider.executeSet(new SetWritePlan(
        "INSERT INTO neri_contract_entities(id,label,version) VALUES($1,'aggregate limit',9223372036854775807)",
        extra
      )))
  let version: quote fn(PostgreSQLTrackedValue): Int = quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.version
  end

  match aggregateRows(query, sumInt(intScalar(), version)).value()
    case QueryValue.Value(value)
      test::assertTrue(false)
    case QueryValue.Failure(error)
      test::assertTrue(pgAggregateOverflow(error))
  end
  saved(provider.executeSet(new SetWritePlan("DELETE FROM neri_contract_entities WHERE id=$1", extra)))
end

def pgTrackedLabel(): quote fn(PostgreSQLTrackedValue): String
  return quote do |entity: PostgreSQLTrackedValue|: String
    return entity.label
  end
end

def verifyPostgreSQLQueryAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  using operation <- query.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLProjectionAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let projection = select(query, intScalar(), pgTrackedId())

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)
              test::assertTrue(rows.inspectItems(1)[0] > 0)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLPairAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let materialize: fn(Int, String): String = fn(id: Int, label: String): String do
    return (id as String) + label
  end
  let projection = select2(query, intScalar(), pgTrackedId(), textScalar(), pgTrackedLabel(), materialize)

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def verifyPostgreSQLShapeAsync(query: Query<PostgreSQLTrackedValue>): resources::Outcome<Int, QueryFailure>
  let projection = query.select(intScalar(), pgTrackedId())

  using operation <- projection.allAsync()
    while true
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Rows(rows)
              test::assertEqual(rows.count(), 1)

              return 0
            case QueryResult.Failure(error)
              return error
          end
      end
    end
    return 1
  end
  return 1
end

def pgTypedAsyncSucceeded(outcome: resources::Outcome<Int, QueryFailure>): Void
  test::assertEqual(outcome.closeFailures.count(), 0)

  match outcome.completion
    case resources::Completion.Value(code)
      test::assertEqual(code, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end

def pgCheckedFailure(result: ProviderResult, state: String): Void
  match result
    case ProviderResult.Rows(rows)
      test::assertTrue(false)
    case ProviderResult.Failure(error)
      match error
        case ProviderFailure.Driver(details)
          test::assertTrue(details.sqlState() == state)
        case ProviderFailure.State(message)
          test::assertTrue(false)
        case ProviderFailure.Cleanup(cleanup)
          test::assertTrue(false)
      end
  end
end

def verifyPostgreSQLCheckedExpressions(
  provider: PostgreSQLProvider,
  query: Query<PostgreSQLTrackedValue>,
  id: Int
): Void
  let increment = quote do |entity: PostgreSQLTrackedValue|: Int
    return entity.id + 2
  end
  let suffix = quote do |entity: PostgreSQLTrackedValue|: String
    return entity.label + "!"
  end

  match query.select(intScalar(), increment).all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, id + 2)
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  match query.select(textScalar(), suffix).all()
    case QueryResult.Rows(rows)
      let first = rows.first()

      test::assertTrue(first != null)
      if first != null
        test::assertEqual(first.value, "generated!")
      end
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
  let intColumns = new ResultColumns([new ResultColumn("value", ResultColumnKind.Int())])
  let floatColumns = new ResultColumns([new ResultColumn("value", ResultColumnKind.Float())])
  let values = new CompileState()

  values.bind(Parameter.Int(9223372036854775807))
  pgCheckedFailure(provider.execute(new SqlPlan(
        "SELECT " + postgresCheckedScalar(18, "Int", "$1", "1") + " AS value",
        new ParameterValues(values.head, values.count), 1, intColumns, true
      )), "22003")
  let zero = new CompileState()

  zero.bind(Parameter.Int(0))
  pgCheckedFailure(provider.execute(new SqlPlan(
        "SELECT " + postgresCheckedScalar(21, "Int", "1", "$1") + " AS value",
        new ParameterValues(zero.head, zero.count), 1, intColumns, true
      )), "22012")
  let floating = new CompileState()

  floating.bind(Parameter.Float(1.25))
  match provider.execute(new SqlPlan(
      "SELECT " + postgresCheckedScalar(18, "Float", "$1", "2.5") + " AS value",
      new ParameterValues(floating.head, floating.count), 1, floatColumns, true
    ))
    case ProviderResult.Failure(error)
      test::assertTrue(false)
    case ProviderResult.Rows(rows)
      test::assertEqual(rows.Length, 1)
      match decodeFloat(rows[0], "value")
        case DecodeResult.Value(value)
          test::assertEqual(value, 3.75)
        case DecodeResult.Failure(error)
          test::assertTrue(false)
      end
  end
  let nonfinite = new CompileState()

  nonfinite.bind(Parameter.Text("NaN"))
  pgCheckedFailure(provider.execute(new SqlPlan(
        "SELECT " + postgresCheckedScalar(18, "Float", "$1", "1.0") + " AS value",
        new ParameterValues(nonfinite.head, nonfinite.count), 1, floatColumns, true
      )), "22P02")
  let shortCircuit = quote do |entity: PostgreSQLTrackedValue|: Bool
    return entity.id > 0 || entity.version / (entity.id - entity.id) > 0
  end

  match query.matching(shortCircuit).all()
    case QueryResult.Rows(rows)
      test::assertEqual(rows.count(), 1)
    case QueryResult.Failure(error)
      test::assertTrue(false)
  end
end

## Schema inspection reports physical order, tuple-key position and generation policy.
def verifyPostgreSQLSchemaInspection(provider: PostgreSQLProvider): Void
  match provider.command(
    "CREATE SCHEMA neri_contract_inspection; CREATE TABLE neri_contract_inspection.items(tenant BIGINT NOT NULL, id BIGINT GENERATED BY DEFAULT AS IDENTITY, label TEXT DEFAULT 'new', normalized TEXT GENERATED ALWAYS AS (lower(label)) STORED, PRIMARY KEY(tenant,id)); CREATE VIEW neri_contract_inspection.item_view AS SELECT label FROM neri_contract_inspection.items",
    new WriteValues(),
    script: true
  )
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
  match provider.inspectSchema("neri_contract_inspection")
    case PostgreSQLSchemaResult.Failure(error)
      console::println(providerFailureMessage(error))

      test::assertTrue(false)
    case PostgreSQLSchemaResult.Snapshot(snapshot)
      test::assertEqual(snapshot.count(), 5)
      let view = snapshot.at(0)
      let tenant = snapshot.at(1)
      let id = snapshot.at(2)
      let label = snapshot.at(3)
      let generated = snapshot.at(4)

      test::assertTrue(view != null && tenant != null && id != null && label != null && generated != null)
      if view != null
        test::assertTrue(view.view())
        test::assertEqual(view.table(), "item_view")
      end
      if tenant != null
        test::assertEqual(tenant.keyPosition(), 1)
        test::assertTrue(tenant.required())
        test::assertEqual(tenant.declaredType(), "bigint")
      end
      if id != null
        test::assertEqual(id.keyPosition(), 2)
        test::assertEqual(id.identity(), "d")
      end
      if label != null
        test::assertTrue(label.defaultSql() != null)
        test::assertTrue(!label.required())
      end
      if generated != null
        test::assertEqual(generated.generated(), "s")
      end
  end
  match provider.inspectSchema("invalid;schema")
    case PostgreSQLSchemaResult.Failure(error)
    case PostgreSQLSchemaResult.Snapshot(snapshot)
      test::assertTrue(false)
  end
  match provider.command(
    "CREATE TABLE public.neri_contract_scaffold(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,label TEXT COLLATE \"C\" DEFAULT 'new' CHECK(length(label)<100),normalized TEXT GENERATED ALWAYS AS (lower(label)) STORED); CREATE VIEW public.neri_contract_scaffold_view AS SELECT label FROM public.neri_contract_scaffold; CREATE INDEX neri_contract_scaffold_expression ON public.neri_contract_scaffold(lower(label) DESC) INCLUDE (id) WHERE label IS NOT NULL",
    new WriteValues(), script: true
  )
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
  match provider.scaffoldSchema()
    case SchemaScaffoldResult.Failure(error)
      test::assertTrue(false)
    case SchemaScaffoldResult.Source(source, mapping)
      test::assertTrue(source.contains("public field_id: Int = 0"))
      test::assertTrue(source.contains("public field_label: String? = null"))
      test::assertTrue(mapping.contains("\"keyGeneration\":\"onAdd\""))
      test::assertTrue(mapping.contains("\"valueGeneration\":\"onAddOrUpdate\""))
      test::assertTrue(mapping.contains("\"view\":\"neri_contract_scaffold_view\",\"keyless\":true"))
      test::assertTrue(mapping.contains("\"computedSql\":"))
      test::assertTrue(mapping.contains("\"defaultSql\":"))
      test::assertTrue(mapping.contains("\"checkSql\":"))
      test::assertTrue(mapping.contains("\"collation\":\"C\""))
      test::assertTrue(mapping.contains("\"expressions\":[\"lower(label)\"]"))
      test::assertTrue(mapping.contains("\"include\":[\"field_id\"]"))
      test::assertTrue(mapping.contains("\"predicate\":"))
  end
  match provider.command("CREATE TABLE public.neri_contract_scaffold_lossy(v NUMERIC(10,2))", new WriteValues())
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
  match provider.scaffoldSchema()
    case SchemaScaffoldResult.Failure(error)
    case SchemaScaffoldResult.Source(source, mapping)
      test::assertTrue(false)
  end
  match provider.command(
    "DROP VIEW public.neri_contract_scaffold_view; DROP TABLE public.neri_contract_scaffold,public.neri_contract_scaffold_lossy",
    new WriteValues(),
    script: true
  )
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
  match provider.command("DROP SCHEMA neri_contract_inspection CASCADE", new WriteValues(), script: true)
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
end

def pgNativeId(value: PostgreSQLTrackedValue): Int
  return value.id
end

def pgNativeForeignKey(value: PostgreSQLTrackedValue): Int
  return value.version
end

def pgNativeSetForeignKey(value: PostgreSQLTrackedValue, id: Int): Void
  value.version = id
end

def verifyPostgreSQLNativeEnrollment(owner: PostgreSQLProvider): Void
  match owner.command(
    "CREATE TEMP TABLE neri_native_roots(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,label TEXT NOT NULL,version BIGINT NOT NULL); CREATE TEMP TABLE neri_native_children(id BIGINT PRIMARY KEY,label TEXT NOT NULL,version BIGINT NOT NULL REFERENCES neri_native_roots(id))",
    new WriteValues(),
    script: true
  )
    case PostgreSQLCommandResult.Failure(error)
      test::assertTrue(false)
    case PostgreSQLCommandResult.Completed(count, row)
  end
  var ownerLease = 0

  match owner.beginTransaction()
    case TransactionOpenResult.Begun(lease)
      ownerLease = lease
    case TransactionOpenResult.Failure(error)
      test::assertTrue(false)
  end
  unsafe
    let nativeHandle = owner.nativeHandle()

    test::assertTrue(nativeHandle != null)
    if nativeHandle == null
      return
    end
    match PostgreSQLProvider.borrowNativeTransaction(nativeHandle)
      case result::Result.Ok(provider)
        let columns = new ResultColumns([
            new ResultColumn("id", ResultColumnKind.Int()),
            new ResultColumn("label", ResultColumnKind.Text()),
            new ResultColumn("version", ResultColumnKind.Int())
          ])
        let setKey: fn(PostgreSQLTrackedValue, Int): Void = fn(value: PostgreSQLTrackedValue, key: Int): Void do
          value.id = key
        end
        let roots = new EntityTracker<PostgreSQLTrackedValue>(
          "neri_native_roots",
          "id",
          columns,
          pgCaptureTracked,
          generatedKey: true,
          setGeneratedKey: setKey
        )
        let children = new EntityTracker<PostgreSQLTrackedValue>(
          "neri_native_children",
          "id",
          columns,
          pgCaptureTracked,
          foreignKeyColumns: [["version"]]
        )
        let root = new PostgreSQLTrackedValue()
        let child = new PostgreSQLTrackedValue()
        let context = new ChangeContext(provider)

        child.id = 7
        child.version = 0
        context.register(roots.changeSet())
        context.register(children.changeSet())
        saved(context.enlistTransaction(1))
        var principal: TrackedHandle<PostgreSQLTrackedValue>? = null
        var dependent: TrackedHandle<PostgreSQLTrackedValue>? = null

        match roots.addWithHandle(root)
          case TrackHandleResult.Tracked(handle)
            principal = handle
          case TrackHandleResult.Failure(error)
            test::assertTrue(false)
        end
        match children.addWithHandle(child)
          case TrackHandleResult.Tracked(handle)
            dependent = handle
          case TrackHandleResult.Failure(error)
            test::assertTrue(false)
        end
        if principal != null && dependent != null
          let temporaryKey = root.id
          let edge = new RelationshipLink<PostgreSQLTrackedValue, PostgreSQLTrackedValue>(
            principal,
            dependent,
            pgNativeId,
            pgNativeForeignKey,
            pgNativeSetForeignKey,
            "version"
          ).edge()

          test::assertTrue(context.registerRelation(edge) == null)
          let temporaryForeignKey = child.version

          saved(context.saveChanges())

          test::assertTrue(root.id > 0 && child.version == root.id)
          pgNativeRejected(context.commitTransaction())
          pgNativeRejected(provider.commitTransaction(1))
          pgNativeRejected(provider.acknowledgeNativeTransaction(true))
          saved(owner.rollbackTransaction(ownerLease))
          pgNativeRejected(context.synchronizeTransaction())
          saved(provider.acknowledgeNativeTransaction(false))
          saved(context.synchronizeTransaction())

          test::assertTrue(temporaryKey < 0)
          test::assertEqual(root.id, temporaryKey)
          test::assertEqual(child.version, temporaryForeignKey)
          test::assertEqual(temporaryForeignKey, temporaryKey)
          match owner.beginTransaction()
            case TransactionOpenResult.Begun(lease)
              ownerLease = lease
            case TransactionOpenResult.Failure(error)
              test::assertTrue(false)
          end
          match provider.enlistNativeTransaction()
            case TransactionOpenResult.Begun(lease)
              saved(context.enlistTransaction(lease))
            case TransactionOpenResult.Failure(error)
              test::assertTrue(false)
          end
          asyncContextSaved(awaitAsyncContextSave(context, 2))

          test::assertTrue(root.id > 0 && child.version == root.id)
          saved(owner.commitTransaction(ownerLease))
          saved(provider.acknowledgeNativeTransaction(true))
          saved(context.synchronizeTransaction())
        end

        test::assertTrue(provider.closeFailure() == null)
        match owner.command(
          "DROP TABLE neri_native_children; DROP TABLE neri_native_roots",
          new WriteValues(),
          script: true
        )
          case PostgreSQLCommandResult.Failure(error)
            test::assertTrue(false)
          case PostgreSQLCommandResult.Completed(count, row)
        end
      case result::Result.Error(error)
        test::assertTrue(false)
    end
  end
end

def pgNativeRejected(result: WriteResult): Void
  match result
    case WriteResult.Failure(error)
      test::assertTrue(true)
    case WriteResult.Saved(count)
    case WriteResult.SavedWithValues(count, rows)
      test::assertTrue(false)
  end
end


def verifyPostgreSQLSchemaFeatures(provider: PostgreSQLProvider): Void
  let migrate: fn(
    MigrationSet,
    String?
  ): MigrationResult = fn(
    catalog: MigrationSet,
    target: String?
  ): MigrationResult do
    return provider.migrate(catalog, target)
  end

  verifySchemaFeatures(provider, migrate, true)
  let migrateAsync: fn(
    MigrationSet,
    String?
  ): MigrationResult = fn(
    catalog: MigrationSet,
    target: String?
  ): MigrationResult do
    return awaitAsyncMigration(provider.beginMigrationAsync(catalog, target))
  end

  verifyTrustedMigrationSql(provider, migrateAsync, true)
end
