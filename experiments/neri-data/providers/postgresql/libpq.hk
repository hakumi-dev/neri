use host
use neri_data
namespace neri_data_postgresql

struct PostgreSQLPointer
  value: Byte*?
end

struct PostgreSQLConnOption
  keyword: Byte*?
  envvar: Byte*?
  compiled: Byte*?
  value: Byte*?
  label: Byte*?
  dispchar: Byte*?
  dispsize: Int32
end

@library("pq")
@cabiImport("PQconninfoParse")
unsafe def pgConninfoParse(conninfo: Byte*, error: Byte**?): PostgreSQLConnOption*?
end

@library("pq")
@cabiImport("PQconninfoFree")
unsafe def pgConninfoFree(options: PostgreSQLConnOption*): Void
end

@library("pq")
@cabiImport("PQconnectStartParams")
unsafe def pgConnectStartParams(keywords: Byte**, values: Byte**, expand: Int32): Void*?
end

@library("pq")
@cabiImport("PQparameterStatus")
unsafe def pgParameterStatus(connection: Void*, parameter: Byte*): Byte*?
end

@library("pq")
@cabiImport("PQconnectStart")
unsafe def pgConnectStart(conninfo: Byte*): Void*?
end

@library("pq")
@cabiImport("PQconnectPoll")
unsafe def pgConnectPoll(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQfinish")
unsafe def pgFinish(connection: Void*): Void
end

@library("pq")
@cabiImport("PQstatus")
unsafe def pgStatus(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQsocket")
unsafe def pgSocket(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQsetnonblocking")
unsafe def pgSetNonblocking(connection: Void*, enabled: Int32): Int32
end

@library("pq")
@cabiImport("PQflush")
unsafe def pgFlush(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQconsumeInput")
unsafe def pgConsumeInput(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQisBusy")
unsafe def pgIsBusy(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQgetResult")
unsafe def pgGetResult(connection: Void*): Void*?
end

@library("pq")
@cabiImport("PQclear")
unsafe def pgClear(result: Void*): Void
end

@library("pq")
@cabiImport("PQresultStatus")
unsafe def pgResultStatus(result: Void*): Int32
end

@library("pq")
@cabiImport("PQerrorMessage")
unsafe def pgErrorMessage(connection: Void*): Byte*
end

@library("pq")
@cabiImport("PQresultErrorMessage")
unsafe def pgResultErrorMessage(result: Void*): Byte*
end

@library("pq")
@cabiImport("PQresultErrorField")
unsafe def pgResultErrorField(result: Void*, field: Int32): Byte*?
end

@library("pq")
@cabiImport("PQntuples")
unsafe def pgNtuples(result: Void*): Int32
end

@library("pq")
@cabiImport("PQnfields")
unsafe def pgNfields(result: Void*): Int32
end

@library("pq")
@cabiImport("PQfname")
unsafe def pgFname(result: Void*, column: Int32): Byte*?
end

@library("pq")
@cabiImport("PQftype")
unsafe def pgFtype(result: Void*, column: Int32): UInt32
end

@library("pq")
@cabiImport("PQgetisnull")
unsafe def pgGetisnull(result: Void*, row: Int32, column: Int32): Int32
end

@library("pq")
@cabiImport("PQgetvalue")
unsafe def pgGetvalue(result: Void*, row: Int32, column: Int32): Byte*
end

@library("pq")
@cabiImport("PQgetlength")
unsafe def pgGetlength(result: Void*, row: Int32, column: Int32): Int32
end

@library("pq")
@cabiImport("PQcmdTuples")
unsafe def pgCmdTuples(result: Void*): Byte*
end

@library("pq")
@cabiImport("PQtransactionStatus")
unsafe def pgTransactionStatus(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQsetSingleRowMode")
unsafe def pgSetSingleRowMode(connection: Void*): Int32
end

@library("pq")
@cabiImport("PQsendQueryParams")
unsafe def pgSendQueryParams(
  connection: Void*,
  sql: Byte*,
  count: Int32,
  types: UInt32*?,
  values: Byte**?,
  lengths: Int32*?,
  formats: Int32*?,
  resultFormat: Int32
): Int32
end

@library("pq")
@cabiImport("PQsendQuery")
unsafe def pgSendQuery(connection: Void*, sql: Byte*): Int32
end
