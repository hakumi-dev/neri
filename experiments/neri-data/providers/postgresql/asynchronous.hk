use host
use neri_data
namespace neri_data_postgresql

enum PostgreSQLCommandPoll
  case Pending(socket: Int, interest: AsyncInterest)
  case Completed(count: Int, row: RawRow?)
  case Failure(error: ProviderFailure)
end

enum PostgreSQLControlSql
  case Statement(sql: String)
  case Failure(error: WriteFailure)
end

## A single nonblocking command on the caller's already-reserved connection.
class PostgreSQLCommandCursor
  private owner: PostgreSQLProvider
  private columns: readonly ResultColumns?
  private terminal: Bool = false
  private count: Int = 0
  private row: RawRow?
  private error: ProviderFailure?
  private history: TypedRows<RawRow>?

  def init(owner: PostgreSQLProvider, columns: readonly ResultColumns?): Void
    this.owner = owner
    this.columns = columns
  end

  public static def start(
    owner: PostgreSQLProvider,
    sql: String,
    parameters: readonly WriteValues,
    columns: readonly ResultColumns? = null,
    script: Bool = false,
    history: Bool = false
  ): PostgreSQLCommandCursor
    let cursor = new PostgreSQLCommandCursor(owner, columns)

    if history
      cursor.history = new TypedRows<RawRow>()
    end
    unsafe
      let connection = owner.nativeHandle()

      if connection == null
        cursor.error = ProviderFailure.State("PostgreSQL asynchronous connection is closed")
      else if script
        if pgHasNul(sql) || parameters.count() != 0
          cursor.error = ProviderFailure.State("PostgreSQL async migration script contains NUL or parameters")
        else
          let statement = pgCString(sql)

          if pgSendQuery(connection, statement) != (1 as Int32)
            cursor.error = pgFailure(connection, "async.script.send")
          end
          native::free(statement)
        end
      else
        cursor.error = pgSend(connection, sql, parameters)
      end
      cursor.terminal = cursor.error != null
    end
    return cursor
  end

  public def poll(): PostgreSQLCommandPoll
    let error = this.error

    if this.terminal
      return error == null ? PostgreSQLCommandPoll.Completed(
        this.count,
        this.row
      ) : PostgreSQLCommandPoll.Failure(error)
    end
    unsafe
      let connection = this.owner.nativeHandle()

      if connection == null
        this.terminal = true
        this.error = ProviderFailure.State("PostgreSQL asynchronous connection is closed")
        return PostgreSQLCommandPoll.Failure(ProviderFailure.State("PostgreSQL asynchronous connection is closed"))
      end
      let flushed = pgFlush(connection) as Int

      if flushed < 0 || pgConsumeInput(connection) != (1 as Int32)
        let ioError = pgFailure(connection, "async.command.io")

        this.owner.abortOperation()
        this.error = error == null ? ioError : ProviderFailure.Cleanup(new ProviderCleanupFailure(error, ioError))
        this.terminal = true
        return PostgreSQLCommandPoll.Failure(error == null ? ioError : ProviderFailure.Cleanup(new ProviderCleanupFailure(
              error,
              ioError
            )))
      end
      if flushed == 1 || pgIsBusy(connection) != (0 as Int32)
        return PostgreSQLCommandPoll.Pending(
          pgSocket(connection) as Int,
          flushed == 1 ? AsyncInterest.Write() : AsyncInterest.Read()
        )
      end
      let result = pgGetResult(connection)

      if result == null
        this.terminal = true
        return error == null ? PostgreSQLCommandPoll.Completed(
          this.count,
          this.row
        ) : PostgreSQLCommandPoll.Failure(error)
      end
      let status = pgResultStatus(result) as Int

      if status == 1 || status == 2
        let text = pgText(pgCmdTuples(result))
        let count = text == null ? null : host::parseInt(text)

        if count != null
          this.count = this.count + count
        end
        let columns = this.columns

        let history = this.history

        if columns != null && history != null
          let count = pgNtuples(result) as Int

          if status != 2 || count > 1001 || history.count() != 0
            this.error = ProviderFailure.State("PostgreSQL migration history response is invalid")
          else
            var index = 0

            while index < count
              match pgDecodeRow(result, index, columns)
                case PostgreSQLRowResult.Row(row)
                  history.add(row)
                case PostgreSQLRowResult.Failure(failure)
                  this.error = failure
              end
              index = index + 1
            end
          end
        else if columns != null
          if status != 2 || pgNtuples(result) != (1 as Int32) || this.row != null
            this.error = ProviderFailure.State("PostgreSQL RETURNING requires exactly one row per write")
          else
            match pgDecodeRow(result, 0, columns)
              case PostgreSQLRowResult.Row(row)
                this.row = row
              case PostgreSQLRowResult.Failure(failure)
                this.error = failure
            end
          end
        else if pgNtuples(result) != (0 as Int32)
          this.error = ProviderFailure.State("PostgreSQL asynchronous command returned unexpected rows")
        end
      else
        this.error = pgFailure(connection, "async.command.result", result)
      end
      pgClear(result)
      if status == 3 || status == 4 || status == 5
        this.owner.abortOperation()
        this.terminal = true
      end
      return PostgreSQLCommandPoll.Pending(-1, AsyncInterest.Read())
    end
  end

  public def historyRows(): TypedRows<RawRow>?
    return this.history
  end
end

class PostgreSQLAsyncControl: AsyncControlDriver
  private owner: PostgreSQLProvider
  private action: AsyncTransactionAction
  private cursor: PostgreSQLCommandCursor
  private deadline: Int?
  private token: CancellationToken?
  private terminal: AsyncControlResult?
  private cancelled: Bool = false

  def init(
    owner: PostgreSQLProvider,
    action: AsyncTransactionAction,
    sql: String,
    deadline: Int?,
    token: CancellationToken?
  ): Void
    this.owner = owner
    this.action = action
    this.deadline = deadline
    this.token = token
    this.cursor = PostgreSQLCommandCursor.start(owner, sql, new WriteValues())
  end

  public override def cancel(): Void
    this.cancelled = true
  end

  public override def close(): WriteFailure?
    if this.terminal == null
      this.owner.abortOperation()
      match this.action
        case AsyncTransactionAction.Commit(lease)
          let unknown = WriteFailure.Transaction("PostgreSQL commit outcome is unknown because the operation was closed before its response")

          this.terminal = AsyncControlResult.Failure(unknown)
          return unknown
        case AsyncTransactionAction.Begin()
        case AsyncTransactionAction.Rollback(lease)
        case AsyncTransactionAction.Savepoint(lease)
        case AsyncTransactionAction.RollbackTo(lease, id)
        case AsyncTransactionAction.Release(lease, id)
      end
      this.terminal = AsyncControlResult.Failure(WriteFailure.Provider(pgInterrupted("async.transaction")))
    end
    return null
  end

  public override def poll(): AsyncControlPoll
    let terminal = this.terminal

    if terminal != null
      return AsyncControlPoll.Completed(terminal)
    end
    let token = this.token
    var commit = false

    match this.action
      case AsyncTransactionAction.Commit(lease)
        commit = true
      case AsyncTransactionAction.Begin()
      case AsyncTransactionAction.Rollback(lease)
      case AsyncTransactionAction.Savepoint(lease)
      case AsyncTransactionAction.RollbackTo(lease, id)
      case AsyncTransactionAction.Release(lease, id)
    end

    if !commit && (this.cancelled || (token != null && token.cancelled()) || streamTimedOut(this.deadline))
      this.close()
      return AsyncControlPoll.Completed(AsyncControlResult.Failure(WriteFailure.Provider(pgInterrupted("async.transaction"))))
    end
    match this.cursor.poll()
      case PostgreSQLCommandPoll.Pending(socket, interest)
        return AsyncControlPoll.Pending(socket, interest)
      case PostgreSQLCommandPoll.Failure(error)
        this.owner.finishOperation()
        this.owner.reconcileAsyncFailure()
        let failure = commit ? WriteFailure.Transaction("PostgreSQL commit failed or its outcome is unknown: " + providerFailureMessage(error)) : WriteFailure.Provider(error)

        this.terminal = AsyncControlResult.Failure(failure)
        return AsyncControlPoll.Completed(AsyncControlResult.Failure(failure))
      case PostgreSQLCommandPoll.Completed(count, row)
        let result = this.owner.acceptAsyncControl(this.action)

        this.owner.finishOperation()
        this.terminal = result
        return AsyncControlPoll.Completed(result)
    end
  end
end

## BEGIN/SAVEPOINT, commands, returned-value validation, then COMMIT/RELEASE.
class PostgreSQLAsyncWrite: AsyncWriteDriver
  private owner: PostgreSQLProvider
  private batch: WriteBatch
  private current: readonly WriteCommandNode?
  private lease: Int?
  private savepoint: Int = 0
  private deadline: Int?
  private token: CancellationToken?
  private validate: (fn(readonly WriteReturnedRows): WriteFailure?)?
  private cursor: PostgreSQLCommandCursor?
  private action: AsyncTransactionAction?
  private phase: Int = 0
  private outputs: WriteReturnedRows = new WriteReturnedRows()
  private count: Int = 0
  private returning: Bool = false
  private failure: WriteFailure?
  private terminal: WriteResult?
  private cancelled: Bool = false
  private setWrite: Bool

  def init(
    owner: PostgreSQLProvider,
    batch: WriteBatch,
    lease: Int?,
    deadline: Int?,
    token: CancellationToken?,
    validate: (fn(readonly WriteReturnedRows): WriteFailure?)?,
    setWrite: Bool = false
  ): Void
    this.owner = owner
    this.batch = batch
    this.current = batch.first()
    this.lease = lease
    this.deadline = deadline
    this.token = token
    this.validate = validate
    this.setWrite = setWrite
  end

  public override def cancel(): Void
    this.cancelled = true
  end

  public override def close(): WriteFailure?
    if this.terminal == null
      this.owner.abortOperation()
      let primary = this.failure

      if this.phase == 4 && this.savepoint == 0
        let unknown = WriteFailure.Transaction("PostgreSQL write commit outcome is unknown because the operation was closed before its response")

        this.terminal = WriteResult.Failure(unknown)
        return unknown
      end
      this.terminal = WriteResult.Failure(primary == null ? WriteFailure.Provider(pgInterrupted("async.write")) : primary)
    end
    return null
  end

  private def complete(result: WriteResult): AsyncWritePoll
    this.owner.finishOperation()
    this.terminal = result
    return AsyncWritePoll.Completed(result)
  end

  private def startControl(action: AsyncTransactionAction, nextPhase: Int): AsyncWritePoll
    match this.owner.asyncControlSql(action)
      case PostgreSQLControlSql.Failure(error)
        let primary = this.failure

        return this.complete(WriteResult.Failure(primary == null ? error : WriteFailure.Cleanup(new WriteCleanupFailure(
                primary,
                error
              ))))
      case PostgreSQLControlSql.Statement(sql)
        this.action = action
        this.cursor = PostgreSQLCommandCursor.start(this.owner, sql, new WriteValues())
        this.phase = nextPhase
        return AsyncWritePoll.Pending(-1, AsyncInterest.Write())
    end
  end

  private def recover(error: WriteFailure): AsyncWritePoll
    this.failure = error
    this.cursor = null
    let lease = this.lease

    if lease == null
      return this.complete(WriteResult.Failure(error))
    end
    match this.owner.transactionState(lease)
      case TransactionState.RolledBack()
        return this.complete(WriteResult.Failure(error))
      case TransactionState.Active()
      case TransactionState.Failed()
      case TransactionState.Invalid()
      case TransactionState.Committed()
    end
    return this.startControl(
      this.savepoint == 0 ? AsyncTransactionAction.Rollback(lease) : AsyncTransactionAction.RollbackTo(
        lease,
        this.savepoint
      ),
      5
    )
  end

  public override def poll(): AsyncWritePoll
    let terminal = this.terminal

    if terminal != null
      return AsyncWritePoll.Completed(terminal)
    end
    let token = this.token

    if this.phase < 4 && (this.cancelled || (token != null && token.cancelled()) || streamTimedOut(this.deadline))
      # Closing the socket safely aborts any in-flight command and transaction.
      this.close()
      let cancelled = this.terminal

      return AsyncWritePoll.Completed(cancelled == null ? WriteResult.Failure(WriteFailure.Provider(pgInterrupted("async.write"))) : cancelled)
    end
    if this.phase == 0
      let lease = this.lease

      return this.startControl(
        lease == null ? AsyncTransactionAction.Begin() : AsyncTransactionAction.Savepoint(lease),
        1
      )
    end
    let cursor = this.cursor

    if cursor != null
      match cursor.poll()
        case PostgreSQLCommandPoll.Pending(socket, interest)
          return AsyncWritePoll.Pending(socket, interest)
        case PostgreSQLCommandPoll.Failure(error)
          this.cursor = null
          this.owner.reconcileAsyncFailure()
          if this.phase >= 4
            let primary = this.failure

            if this.phase == 4 && this.savepoint == 0 && !this.owner.supports(ProviderCapability.BoundedTypedReads())
              return this.complete(WriteResult.Failure(WriteFailure.Transaction("PostgreSQL write commit outcome is unknown after connection loss: " + providerFailureMessage(error))))
            end
            if this.phase == 4 && primary == null
              return this.recover(WriteFailure.Provider(error))
            end
            return this.complete(WriteResult.Failure(primary == null ? WriteFailure.Provider(error) : WriteFailure.Cleanup(new WriteCleanupFailure(
                    primary,
                    WriteFailure.Provider(error)
                  ))))
          end
          if this.phase == 1
            return this.complete(WriteResult.Failure(WriteFailure.Provider(error)))
          end
          return this.recover(WriteFailure.Provider(error))
        case PostgreSQLCommandPoll.Completed(changed, row)
          this.cursor = null
          let action = this.action

          if action != null
            let accepted = this.owner.acceptAsyncControl(action)

            this.action = null
            match accepted
              case AsyncControlResult.Begun(lease)
                this.lease = lease
              case AsyncControlResult.Created(id)
                this.savepoint = id
              case AsyncControlResult.Saved()
              case AsyncControlResult.Failure(error)
                return this.recover(error)
            end
            if this.phase == 1
              this.phase = 2
            else if this.phase == 4
              return this.complete(this.returning ? WriteResult.SavedWithValues(
                  this.count,
                  this.outputs
                ) : WriteResult.Saved(this.count))
            else if this.phase == 5
              let lease = this.lease

              if this.savepoint != 0 && lease != null
                return this.startControl(AsyncTransactionAction.Release(lease, this.savepoint), 6)
              end
              let failure = this.failure

              return this.complete(WriteResult.Failure(failure == null ? WriteFailure.Transaction("PostgreSQL asynchronous write rolled back") : failure))
            else if this.phase == 6
              let failure = this.failure

              return this.complete(WriteResult.Failure(failure == null ? WriteFailure.Transaction("PostgreSQL asynchronous write rolled back") : failure))
            end
          else
            let current = this.current

            if current == null
              return this.recover(WriteFailure.Validation("PostgreSQL asynchronous write command is missing"))
            end
            if changed < 0 || (!this.setWrite && changed != current.command().expectedRows())
              return this.recover(WriteFailure.Concurrency("PostgreSQL asynchronous write affected " + (changed as String) + " rows; expected " + (current.command().expectedRows() as String)))
            end
            this.count = this.count + changed
            this.outputs.add(row)
            this.returning = this.returning || row != null
            this.current = current.next()
          end
      end
    end
    if this.phase == 2
      let current = this.current

      if current != null
        let command = current.command()

        this.cursor = PostgreSQLCommandCursor.start(
          this.owner,
          command.sql(),
          command.parameters(),
          command.returningColumns()
        )
        return AsyncWritePoll.Pending(-1, AsyncInterest.Write())
      end
      let validate = this.validate

      if validate != null
        let rejected = validate(this.outputs)

        this.validate = null
        if rejected != null
          return this.recover(rejected)
        end
      end
      let lease = this.lease

      if lease == null
        return this.recover(WriteFailure.Transaction("PostgreSQL asynchronous write transaction is missing"))
      end
      return this.startControl(
        this.savepoint == 0 ? AsyncTransactionAction.Commit(lease) : AsyncTransactionAction.Release(
          lease,
          this.savepoint
        ),
        4
      )
    end
    return AsyncWritePoll.Pending(-1, AsyncInterest.Read())
  end
end

## The advisory lock, history validation, DDL, stamps and commit share one lease.
class PostgreSQLAsyncMigration: AsyncMigrationDriver
  private owner: PostgreSQLProvider
  private catalog: readonly MigrationSet
  private target: Int
  private deadline: Int?
  private token: CancellationToken?
  private cursor: PostgreSQLCommandCursor?
  private action: AsyncTransactionAction?
  private lease: Int = 0
  private phase: Int = 0
  private applied: Int = 0
  private changed: Int = 0
  private operationIndex: Int = 0
  private terminal: MigrationResult?
  private failure: MigrationFailure?
  private cancelled: Bool = false

  def init(
    owner: PostgreSQLProvider,
    catalog: readonly MigrationSet,
    target: Int,
    deadline: Int?,
    token: CancellationToken?
  ): Void
    this.owner = owner
    this.catalog = catalog
    this.target = target
    this.deadline = deadline
    this.token = token
  end

  public override def cancel(): Void
    this.cancelled = true
  end

  private def complete(result: MigrationResult): AsyncMigrationPoll
    this.owner.finishOperation()
    this.terminal = result
    return AsyncMigrationPoll.Completed(result)
  end

  private def command(sql: String, phase: Int, values: WriteValues? = null, script: Bool = false): AsyncMigrationPoll
    this.cursor = PostgreSQLCommandCursor.start(
      this.owner,
      sql,
      values == null ? new WriteValues() : values,
      script: script
    )
    this.phase = phase
    return AsyncMigrationPoll.Pending(-1, AsyncInterest.Write())
  end

  private def control(action: AsyncTransactionAction, phase: Int): AsyncMigrationPoll
    match this.owner.asyncControlSql(action)
      case PostgreSQLControlSql.Statement(sql)
        this.action = action
        return this.command(sql, phase)
      case PostgreSQLControlSql.Failure(error)
        let primary = this.failure
        let nativeError = pgWriteProviderFailure(error)

        return this.complete(MigrationResult.Failure(primary == null ? MigrationFailure.Provider(nativeError) : MigrationFailure.Cleanup(new MigrationCleanupFailure(
                primary,
                nativeError
              ))))
    end
  end

  private def recover(error: MigrationFailure): AsyncMigrationPoll
    this.failure = error
    this.cursor = null
    this.action = null
    this.owner.reconcileAsyncFailure()
    if this.lease == 0
      return this.complete(MigrationResult.Failure(error))
    end
    match this.owner.transactionState(this.lease)
      case TransactionState.RolledBack()
        return this.complete(MigrationResult.Failure(error))
      case TransactionState.Invalid()
        return this.complete(MigrationResult.Failure(error))
      case TransactionState.Active()
      case TransactionState.Failed()
      case TransactionState.Committed()
    end
    return this.control(AsyncTransactionAction.Rollback(this.lease), 7)
  end

  private def history(cursor: PostgreSQLCommandCursor): MigrationFailure?
    let rows = cursor.historyRows()

    if rows == null || rows.count() > 1000
      return MigrationFailure.Drift("PostgreSQL migration history exceeds catalog bounds")
    end
    let stamps = arrays::generate<MigrationStamp>(rows.count()) do |index|
      return new MigrationStamp("", "")
    end
    var current = rows.first()
    var index = 0

    while current != null
      var ordinal = -1
      var id = ""
      var signature = ""

      match current.value.value("ordinal")
        case CellLookup.Found(value)
          match value
            case Cell.Int(number)
              ordinal = number
            case Cell.Null()
            case Cell.Bool(item)
            case Cell.Float(item)
            case Cell.Text(item)
            case Cell.Binary(item)
          end
        case CellLookup.Missing()
      end
      match current.value.value("id")
        case CellLookup.Found(value)
          match value
            case Cell.Text(item)
              id = item
            case Cell.Null()
            case Cell.Bool(item)
            case Cell.Int(item)
            case Cell.Float(item)
            case Cell.Binary(item)
          end
        case CellLookup.Missing()
      end
      match current.value.value("signature")
        case CellLookup.Found(value)
          match value
            case Cell.Text(item)
              signature = item
            case Cell.Null()
            case Cell.Bool(item)
            case Cell.Int(item)
            case Cell.Float(item)
            case Cell.Binary(item)
          end
        case CellLookup.Missing()
      end
      if ordinal != index + 1
        return MigrationFailure.Drift("PostgreSQL migration history ordinal is not contiguous")
      end
      stamps[index] = new MigrationStamp(id, signature)
      index = index + 1
      current = current.next
    end
    let drift = this.catalog.historyPrefix(stamps)

    this.applied = stamps.Length
    return drift == null ? null : MigrationFailure.Drift(drift)
  end

  public override def poll(): AsyncMigrationPoll
    let terminal = this.terminal

    if terminal != null
      return AsyncMigrationPoll.Completed(terminal)
    end
    let token = this.token

    if this.phase != 6 && this.phase != 7 && (this.cancelled || (token != null && token.cancelled()) || streamTimedOut(this.deadline))
      this.close()
      let stopped = this.terminal

      return AsyncMigrationPoll.Completed(stopped == null ? MigrationResult.Failure(MigrationFailure.Provider(pgInterrupted("async.migration"))) : stopped)
    end
    if this.phase == 0
      return this.control(AsyncTransactionAction.Begin(), 1)
    end
    let cursor = this.cursor

    if cursor != null
      match cursor.poll()
        case PostgreSQLCommandPoll.Pending(socket, interest)
          return AsyncMigrationPoll.Pending(socket, interest)
        case PostgreSQLCommandPoll.Failure(error)
          this.cursor = null
          if this.phase == 6 && !this.owner.supports(ProviderCapability.BoundedTypedReads())
            return this.complete(MigrationResult.Failure(MigrationFailure.Provider(ProviderFailure.State("PostgreSQL migration commit outcome is unknown after connection loss: " + providerFailureMessage(error)))))
          end
          if this.phase == 7
            let primary = this.failure

            return this.complete(MigrationResult.Failure(primary == null ? MigrationFailure.Provider(error) : MigrationFailure.Cleanup(new MigrationCleanupFailure(
                    primary,
                    error
                  ))))
          end
          return this.recover(MigrationFailure.Provider(error))
        case PostgreSQLCommandPoll.Completed(count, row)
          this.cursor = null
          let action = this.action

          if action != null
            this.action = null
            match this.owner.acceptAsyncControl(action)
              case AsyncControlResult.Begun(lease)
                this.lease = lease
              case AsyncControlResult.Saved()
              case AsyncControlResult.Created(id)
                return this.recover(MigrationFailure.Provider(ProviderFailure.State("PostgreSQL migration control returned a savepoint")))
              case AsyncControlResult.Failure(error)
                return this.recover(MigrationFailure.Provider(pgWriteProviderFailure(error)))
            end
          end
          if this.phase == 1
            return this.command(
              "DO $$BEGIN PERFORM pg_advisory_xact_lock(1852142185); END$$; CREATE TABLE IF NOT EXISTS __neri_migrations (ordinal BIGINT PRIMARY KEY, id TEXT NOT NULL, signature TEXT NOT NULL)",
              2,
              script: true
            )
          else if this.phase == 2
            let columns = new ResultColumns([
                new ResultColumn("ordinal", ResultColumnKind.Int()),
                new ResultColumn("id", ResultColumnKind.Text()),
                new ResultColumn("signature", ResultColumnKind.Text())
              ])

            this.cursor = PostgreSQLCommandCursor.start(
              this.owner,
              "SELECT ordinal, id, signature FROM __neri_migrations ORDER BY ordinal LIMIT 1001",
              new WriteValues(),
              columns,
              history: true
            )
            this.phase = 3
            return AsyncMigrationPoll.Pending(-1, AsyncInterest.Write())
          else if this.phase == 3
            let drift = this.history(cursor)

            if drift != null
              return this.recover(drift)
            end
          else if this.phase == 4
            return this.nextOperation()
          else if this.phase == 8
            if count != 1
              return this.recover(MigrationFailure.Drift("PostgreSQL seed write must affect exactly one row"))
            end
            return this.nextOperation()
          else if this.phase == 5
            if count != 1
              return this.recover(MigrationFailure.Drift("PostgreSQL migration stamp write count mismatch"))
            end
            this.applied = this.applied < this.target ? this.applied + 1 : this.applied - 1
            this.changed = this.changed + 1
          else if this.phase == 6
            return this.complete(MigrationResult.Applied(this.changed))
          else if this.phase == 7
            let primary = this.failure

            return this.complete(MigrationResult.Failure(primary == null ? MigrationFailure.Provider(ProviderFailure.State("PostgreSQL migration rolled back")) : primary))
          end
      end
    end
    if this.applied == this.target
      return this.control(AsyncTransactionAction.Commit(this.lease), 6)
    end
    this.operationIndex = 0
    return this.nextOperation()
  end

  private def nextOperation(): AsyncMigrationPoll
    let forward = this.applied < this.target
    let index = forward ? this.applied : this.applied - 1
    let migration = this.catalog.at(index)

    if migration == null
      return this.recover(MigrationFailure.Validation("migration catalog has a missing entry"))
    end
    let count = forward ? migration.upCount() : migration.downCount()

    if this.operationIndex == count
      let values = new WriteValues()

      values.add(Cell.Int(index + 1))
      if forward
        values.add(Cell.Text(migration.id()))
        values.add(Cell.Text(migration.signature()))
      end
      return this.command(
        forward ? "INSERT INTO __neri_migrations(ordinal,id,signature) VALUES($1,$2,$3)" : "DELETE FROM __neri_migrations WHERE ordinal=$1",
        5,
        values
      )
    end
    let operation = forward ? migration.upAt(this.operationIndex) : migration.downAt(this.operationIndex)

    if operation == null
      return this.recover(MigrationFailure.Validation("migration has a missing operation"))
    end
    if schemaSeedOperation(operation)
      this.operationIndex = this.operationIndex + 1
      match compileSeed(operation, SqlDialect.PostgreSql())
        case SetPlanResult.Failure(error)
          return this.recover(MigrationFailure.Validation(writeFailureMessage(error)))
        case SetPlanResult.Plan(plan)
          return this.command(plan.sql(), 8, copyWriteValues(plan.parameters()))
      end
    end
    let finish = schemaMigrationSegmentEnd(migration, forward, this.operationIndex)
    let start = this.operationIndex

    this.operationIndex = finish
    match compilePostgresSchemaSegment(migration, forward, start, finish)
      case SchemaCompileResult.Failure(message)
        return this.recover(MigrationFailure.Unsupported(message))
      case SchemaCompileResult.Statement(sql)
        return this.command(sql, 4, script: true)
    end
  end

  public override def close(): MigrationFailure?
    if this.terminal == null
      this.owner.abortOperation()
      let primary = this.failure

      if this.phase == 6
        let unknown = MigrationFailure.Provider(ProviderFailure.State("PostgreSQL migration commit outcome is unknown because the operation was closed before its response"))

        this.terminal = MigrationResult.Failure(unknown)
        return unknown
      end
      this.terminal = MigrationResult.Failure(primary == null ? MigrationFailure.Provider(pgInterrupted("async.migration")) : primary)
    end
    return null
  end
end
