use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use files
use resources
use result
use test

class MaterializedRecord
  public id: Int

  def init(id: Int): Void
    this.id = id
  end
end

def decodeMaterializedRecord(row: RawRow): DecodeResult<MaterializedRecord>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<MaterializedRecord>.Failure(error)
    case DecodeResult.Value(id)
      return DecodeResult<MaterializedRecord>.Value(new MaterializedRecord(id))
  end
end

def recordId(): quote fn(MaterializedRecord): Int
  return quote do |record: MaterializedRecord|: Int
    return record.id
  end
end

def verifyMaterialization(): resources::Outcome<Int, result::Failure>
  using directory <- files::TemporaryDirectory.create("neri-materialization-")
    let path = directory.path() + "/records.sqlite"

    test::assertTrue(createSQLiteFixture(path, "CREATE TABLE records (id INTEGER NOT NULL); WITH RECURSIVE seed(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM seed WHERE id < 1005) INSERT INTO records SELECT id FROM seed;"))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
        let mapping = new EntityMapping("MaterializedRecord", "records", [new MappingColumn("MaterializedRecord.id", "Int", "id")])
        let query = new Query<MaterializedRecord>("records", new Decoder<MaterializedRecord>(decodeMaterializedRecord, columns), mapping: mapping, provider: provider)

        match query.orderBy(recordId()).all()
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            let preview = rows.inspectItems(9)

            test::assertEqual(rows.count(), 1005)
            test::assertEqual(preview.Length, 9)
            test::assertEqual(preview[0].id, 1)
            test::assertEqual(preview[8].id, 9)
            test::assertEqual(rows.inspectItems(0).Length, 0)
        end
        match query.take(2).all()
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 2)
        end
        match select(query, intScalar(), recordId()).all()
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 1005)
        end

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let outcome = verifyMaterialization()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end
