use host
use files
use resources
use result
use console
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class Person
  public id: Int
  public name: String
  public active: Bool
  public nickname: String?

  def init(id: Int, name: String, active: Bool, nickname: String? = null): Void
    this.id = id
    this.name = name
    this.active = active
    this.nickname = nickname
  end
end

def decodePerson(row: RawRow): DecodeResult<Person>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<Person>.Failure(error)
    case DecodeResult.Value(id)
      match decodeString(row, "name")
        case DecodeResult.Failure(error)
          return DecodeResult<Person>.Failure(error)
        case DecodeResult.Value(name)
          match decodeBool(row, "active")
            case DecodeResult.Failure(error)
              return DecodeResult<Person>.Failure(error)
            case DecodeResult.Value(active)
              match decodeNullableString(row, "nickname")
                case DecodeResult.Failure(error)
                  return DecodeResult<Person>.Failure(error)
                case DecodeResult.Value(nickname)
                  return DecodeResult<Person>.Value(new Person(id, name, active, nickname))
              end
          end
      end
  end
end

def people(): Query<Person>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("name", ResultColumnKind.Text()), new ResultColumn("active", ResultColumnKind.Bool()), new ResultColumn("nickname", ResultColumnKind.Text(), true)])
  let mapping = new EntityMapping("Person", "people", [new MappingColumn("Person.id", "Int", "id"), new MappingColumn("Person.name", "String", "name"), new MappingColumn("Person.active", "Bool", "active"), new MappingColumn("Person.nickname", "String?", "nickname")])

  return new Query<Person>("people", new Decoder<Person>(decodePerson, columns), mapping: mapping)
end

def providerError(error: QueryFailure): Bool
  match error
    case QueryFailure.Provider(message)
      return host::stringByteLength(message) > 0
    case QueryFailure.InvalidIdentifier(name)
      return false
    case QueryFailure.InvalidLimit(value, maximum)
      return false
    case QueryFailure.MissingLimit(maximum)
      return false
    case QueryFailure.SourceMismatch(expected, actual)
      return false
    case QueryFailure.UnsupportedCapability(name)
      return false
    case QueryFailure.MissingColumn(name)
      return false
    case QueryFailure.TypeMismatch(column, expected, actual)
      return false
    case QueryFailure.Cardinality(expected, actual)
      return false
  end
end

def missingRequiredValue(error: QueryFailure): Bool
  match error
    case QueryFailure.TypeMismatch(column, expected, actual)
      return column == "id" && expected == "Int" && actual == "NULL"
    case QueryFailure.Provider(message)
      return false
    case QueryFailure.InvalidIdentifier(name)
      return false
    case QueryFailure.InvalidLimit(value, maximum)
      return false
    case QueryFailure.MissingLimit(maximum)
      return false
    case QueryFailure.SourceMismatch(expected, actual)
      return false
    case QueryFailure.UnsupportedCapability(name)
      return false
    case QueryFailure.MissingColumn(name)
      return false
    case QueryFailure.Cardinality(expected, actual)
      return false
  end
end

def verifyCapabilities(provider: SQLiteProvider, writable: Bool): Void
  test::assertTrue(provider.supports(ProviderCapability.BoundedTypedReads()))
  test::assertEqual(provider.supports(ProviderCapability.SetWrites()), writable)
  test::assertEqual(provider.supports(ProviderCapability.TrackedWrites()), writable)
  test::assertEqual(provider.supports(ProviderCapability.ExplicitTransactions()), writable)
  test::assertEqual(provider.supports(ProviderCapability.Savepoints()), writable)
end

def verifySavepointLifecycle(provider: SQLiteProvider): Void
  match provider.beginTransaction()
    case TransactionOpenResult.Failure(error)
      test::assertTrue(false)
    case TransactionOpenResult.Begun(lease)
      match provider.createSavepoint(lease)
        case SavepointOpenResult.Failure(error)
          test::assertTrue(false)
        case SavepointOpenResult.Created(first)
          match provider.createSavepoint(lease)
            case SavepointOpenResult.Failure(error)
              test::assertTrue(false)
            case SavepointOpenResult.Created(second)
              test::assertTrue(second > first)
              match provider.releaseSavepoint(lease + 1, second)
                case WriteResult.Failure(error)
                  test::assertTrue(true)
                case WriteResult.Saved(count)
                  test::assertTrue(false)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
              match provider.rollbackToSavepoint(lease, first)
                case WriteResult.Failure(error)
                  test::assertTrue(true)
                case WriteResult.Saved(count)
                  test::assertTrue(false)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
              match provider.commitTransaction(lease)
                case WriteResult.Failure(error)
                  test::assertTrue(true)
                case WriteResult.Saved(count)
                  test::assertTrue(false)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
              match provider.rollbackToSavepoint(lease, second)
                case WriteResult.Failure(error)
                  test::assertTrue(false)
                case WriteResult.Saved(count)
                  test::assertEqual(count, 0)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
              match provider.releaseSavepoint(lease, second)
                case WriteResult.Failure(error)
                  test::assertTrue(false)
                case WriteResult.Saved(count)
                  test::assertEqual(count, 0)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
              match provider.releaseSavepoint(lease, second)
                case WriteResult.Failure(error)
                  test::assertTrue(true)
                case WriteResult.Saved(count)
                  test::assertTrue(false)
                case WriteResult.SavedWithValues(count, outputs)
                  test::assertTrue(false)
              end
          end
          match provider.releaseSavepoint(lease, first)
            case WriteResult.Failure(error)
              test::assertTrue(false)
            case WriteResult.Saved(count)
              test::assertEqual(count, 0)
            case WriteResult.SavedWithValues(count, outputs)
              test::assertTrue(false)
          end
      end
      match provider.commitTransaction(lease)
        case WriteResult.Failure(error)
          test::assertTrue(false)
        case WriteResult.Saved(count)
          test::assertEqual(count, 0)
        case WriteResult.SavedWithValues(count, outputs)
          test::assertTrue(false)
      end
      match provider.createSavepoint(lease)
        case SavepointOpenResult.Failure(error)
          test::assertTrue(true)
        case SavepointOpenResult.Created(id)
          test::assertTrue(false)
      end
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-data-sqlite-")
    let path = temporary.path() + "/contract.sqlite"
    let created = createSQLiteFixture(path, "CREATE TABLE people(id INTEGER, name TEXT, active INTEGER, nickname TEXT); INSERT INTO people VALUES(1, 'O''Reilly; DROP TABLE people', 1, NULL); INSERT INTO people VALUES(2, 'Other', 0, 'Álex'); INSERT INTO people VALUES(3, 'Bad', 2, NULL); INSERT INTO people VALUES(4, x'00', 1, NULL); INSERT INTO people VALUES(5, '', 0, '水🌿'); INSERT INTO people VALUES(NULL, 'NullId', 1, NULL); INSERT INTO people VALUES(7, CAST(x'80' AS TEXT), 1, NULL); INSERT INTO people VALUES(9.5, 'BadReal', 1, NULL);")

    test::assertTrue(created)

    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyCapabilities(provider, false)
        let query = people().where(name: "O'Reilly; DROP TABLE people").take(2)

        match query.all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 1)
            let first = rows.first()

            test::assertTrue(first != null)
            if first != null
              test::assertEqual(first.value.id, 1)
              test::assertEqual(first.value.name, "O'Reilly; DROP TABLE people")
              test::assertTrue(first.value.active)
              test::assertTrue(first.value.nickname == null)
            end
        end

        match people().where(name: "Other").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            let first = rows.first()

            test::assertTrue(first != null)
            if first != null
              let nickname = first.value.nickname

              test::assertTrue(nickname != null)
              if nickname != null
                test::assertEqual(nickname, "Álex")
              end
            end
        end
        match people().where(id: 3).take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(id: 4).take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(name: "NullId").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(missingRequiredValue(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(id: 7).take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(name: "BadReal").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(name: "O\0Reilly").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
        match people().where(name: "").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            let first = rows.first()

            test::assertTrue(first != null)
            if first != null
              test::assertEqual(first.value.name, "")
              let nickname = first.value.nickname

              test::assertTrue(nickname != null)
              if nickname != null
                test::assertEqual(nickname, "水🌿")
              end
            end
        end
        let missingColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
        let missing = new Query<Person>("missing", new Decoder<Person>(decodePerson, missingColumns)).take(1)

        match missing.all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end

        test::assertTrue(provider.close())
        test::assertTrue(provider.close())
        verifyCapabilities(provider, false)
        match people().take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(providerError(error))
          case QueryResult.Rows(rows)
            test::assertTrue(false)
        end
    end

    match SQLiteProvider.open(path + ".missing")
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(host::stringByteLength(message) > 0)
      case SQLiteOpenResult.Opened(provider)
        provider.close()

        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(path + ".missing")
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(host::stringByteLength(message) > 0)
      case SQLiteOpenResult.Opened(provider)
        provider.close()

        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyCapabilities(provider, true)
        verifySavepointLifecycle(provider)
        match people().where(name: "Other").take(1).all(provider)
          case QueryResult.Failure(error)
            test::assertTrue(false)
          case QueryResult.Rows(rows)
            test::assertEqual(rows.count(), 1)
        end
        match provider.beginTransaction()
          case TransactionOpenResult.Failure(error)
            test::assertTrue(false)
          case TransactionOpenResult.Begun(lease)
            match provider.transactionState(lease)
              case TransactionState.Active()
                test::assertTrue(true)
              case TransactionState.RolledBack()
                test::assertTrue(false)
              case TransactionState.Committed()
                test::assertTrue(false)
              case TransactionState.Invalid()
                test::assertTrue(false)
              case TransactionState.Failed()
                test::assertTrue(false)
            end
            match provider.beginTransaction()
              case TransactionOpenResult.Failure(error)
                test::assertTrue(true)
              case TransactionOpenResult.Begun(other)
                test::assertTrue(false)
            end
            match provider.createSavepoint(lease)
              case SavepointOpenResult.Failure(error)
                test::assertTrue(false)
              case SavepointOpenResult.Created(id)
                test::assertTrue(id > 0)
            end

            test::assertTrue(provider.close())
            verifyCapabilities(provider, false)
            match provider.transactionState(lease)
              case TransactionState.RolledBack()
                test::assertTrue(true)
              case TransactionState.Active()
                test::assertTrue(false)
              case TransactionState.Committed()
                test::assertTrue(false)
              case TransactionState.Invalid()
                test::assertTrue(false)
              case TransactionState.Failed()
                test::assertTrue(false)
            end
        end

        test::assertTrue(provider.close())
        verifyCapabilities(provider, false)
    end

    let restricted = host::run("/bin/chmod", ["444", path])

    if restricted != null && restricted == 0
      match SQLiteProvider.openWritable(path)
        case SQLiteOpenResult.Failure(message)
          test::assertTrue(host::stringByteLength(message) > 0)
        case SQLiteOpenResult.Opened(provider)
          provider.close()

          test::assertTrue(false)
      end

      let restored = host::run("/bin/chmod", ["644", path])

      test::assertTrue(restored != null && restored == 0)
    end
    match SQLiteProvider.open(path + "\0injected")
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(host::stringByteLength(message) > 0)
      case SQLiteOpenResult.Opened(provider)
        provider.close()

        test::assertTrue(false)
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFile()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
  console::println("SQLite provider contracts passed")
end
