use console
use neri_data_sqlite
use resources
use result
use neri_data

class ConfigurationRow
  public id: Int

  def init(id: Int): Void
    this.id = id
  end
end

def decodeConfigurationRow(row: RawRow): DecodeResult<ConfigurationRow>
  match decodeInt(row, "id")
    case DecodeResult.Value(value)
      return DecodeResult<ConfigurationRow>.Value(new ConfigurationRow(value))
    case DecodeResult.Failure(error)
      return DecodeResult<ConfigurationRow>.Failure(error)
  end
end

def contentionDeadline(path: String): Void
  unsafe
    let name = sqliteMigrationText(path)
    let handles = stackalloc Void*[1]
    let opened = sqliteOpen(name, handles, 6 as Int32, null)

    native::free(name)

    test::assertEqual(opened, 0 as Int32)
    let database = handles[0]

    test::assertEqual(
      sqliteExecuteLiteral(
        database,
        "CREATE TABLE deadline_records(id INTEGER); INSERT INTO deadline_records VALUES(1)"
      ),
      0 as Int32
    )
    match SQLiteProvider.openWritable(path, new SQLiteOptions(busyTimeoutMilliseconds: 1000))
      case SQLiteOpenResult.Failure(error)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
        let query = new Query<ConfigurationRow>(
          "deadline_records",
          new Decoder<ConfigurationRow>(decodeConfigurationRow, columns),
          provider: provider
        )
        let visit: fn(ConfigurationRow): Bool = fn(value: ConfigurationRow): Bool do
          return true
        end

        test::assertEqual(sqliteExecuteLiteral(database, "BEGIN EXCLUSIVE"), 0 as Int32)
        let started = clock::nativeMilliseconds()

        match query.stream(visit, new StreamOptions(timeoutMilliseconds: 40))
          case StreamResult.Cancelled(count)
            test::assertEqual(count, 0)
          case StreamResult.Completed(count)
            test::assertTrue(false)
          case StreamResult.Stopped(count)
            test::assertTrue(false)
          case StreamResult.Failure(error, count)
            console::println("Deadline stream failed: " + diagnosticQueryFailureKind(error))
            match error
              case QueryFailure.Provider(failure)
                console::println(providerFailureMessage(failure))
                match failure
                  case ProviderFailure.Driver(driver)
                    console::println(driver.operation())
                  case ProviderFailure.State(message)
                  case ProviderFailure.Cleanup(cleanup)
                end
              case QueryFailure.Cleanup(failure)
                console::println(providerFailureMessage(failure.cleanup()))
              case QueryFailure.InvalidIdentifier(name)
                console::println(name)
              case QueryFailure.InvalidLimit(value, maximum)
              case QueryFailure.MissingLimit(maximum)
              case QueryFailure.SourceMismatch(expected, actual)
                console::println(expected + " != " + actual)
              case QueryFailure.UnsupportedCapability(name)
                console::println(name)
              case QueryFailure.MissingColumn(name)
                console::println(name)
              case QueryFailure.TypeMismatch(column, expected, actual)
                console::println(column + ": " + expected + " != " + actual)
              case QueryFailure.Cardinality(expected, actual)
            end

            test::assertTrue(false)
        end
        let elapsed = clock::nativeMilliseconds() - started

        test::assertTrue(elapsed >= 0 && elapsed < 750)
        # A subsequent undelimited read must observe the restored busy budget.
        let retried = clock::nativeMilliseconds()
        var contention = false

        match query.stream(visit)
          case StreamResult.Failure(error, count)
            match error
              case QueryFailure.Provider(failure)
                match failure
                  case ProviderFailure.Driver(driver)
                    match driver.kind()
                      case DriverErrorKind.Contention()
                        contention = true
                      case DriverErrorKind.Constraint()
                      case DriverErrorKind.Interrupted()
                      case DriverErrorKind.ReadOnly()
                      case DriverErrorKind.StorageFull()
                      case DriverErrorKind.Io()
                      case DriverErrorKind.Corrupt()
                      case DriverErrorKind.Other()
                    end

                    test::assertTrue(driver.primaryCode() == 5)
                  case ProviderFailure.State(message)
                    test::assertTrue(false)
                  case ProviderFailure.Cleanup(cleanup)
                    test::assertTrue(false)
                end
              case QueryFailure.Cleanup(cleanup)
                test::assertTrue(false)
              case QueryFailure.InvalidIdentifier(name)
              case QueryFailure.InvalidLimit(value, maximum)
              case QueryFailure.MissingLimit(maximum)
              case QueryFailure.SourceMismatch(expected, actual)
              case QueryFailure.UnsupportedCapability(name)
              case QueryFailure.MissingColumn(name)
              case QueryFailure.TypeMismatch(column, expected, actual)
              case QueryFailure.Cardinality(expected, actual)
            end
          case StreamResult.Cancelled(count)
            test::assertTrue(false)
          case StreamResult.Completed(count)
            test::assertTrue(false)
          case StreamResult.Stopped(count)
            test::assertTrue(false)
        end

        test::assertTrue(contention)
        test::assertTrue(clock::nativeMilliseconds() - retried >= 750)
        test::assertEqual(sqliteExecuteLiteral(database, "ROLLBACK"), 0 as Int32)
        match query.stream(visit)
          case StreamResult.Completed(count)
            test::assertEqual(count, 1)
          case StreamResult.Cancelled(count)
            test::assertTrue(false)
          case StreamResult.Stopped(count)
            test::assertTrue(false)
          case StreamResult.Failure(error, count)
            test::assertTrue(false)
        end

        test::assertTrue(provider.close())
    end

    test::assertEqual(sqliteClose(database), 0 as Int32)
  end
end

def rejectedConfiguration(value: SQLiteOpenResult): Void
  match value
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(neri_data::providerFailureMessage(message) != "")
    case SQLiteOpenResult.Opened(provider)
      provider.close()

      test::assertTrue(false)
  end
end

def configured(value: SQLiteOpenResult, journal: String, synchronous: Int, busy: Int): Void
  match value
    case SQLiteOpenResult.Failure(message)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      let actual = provider.configuration()

      test::assertTrue(actual != null)
      if actual != null
        test::assertEqual(actual.journal(), journal)
        test::assertEqual(actual.synchronous(), synchronous)
        test::assertEqual(actual.busyTimeoutMilliseconds(), busy)
      end

      test::assertTrue(provider.close())
  end
end

def walResetVersionContract(): Void
  test::assertTrue(!sqliteWalResetSafeVersion(3037002 as Int32))
  test::assertTrue(!sqliteWalResetSafeVersion(3044005 as Int32))
  test::assertTrue(sqliteWalResetSafeVersion(3044006 as Int32))
  test::assertTrue(!sqliteWalResetSafeVersion(3045000 as Int32))
  test::assertTrue(!sqliteWalResetSafeVersion(3050006 as Int32))
  test::assertTrue(sqliteWalResetSafeVersion(3050007 as Int32))
  test::assertTrue(!sqliteWalResetSafeVersion(3051002 as Int32))
  test::assertTrue(sqliteWalResetSafeVersion(3051003 as Int32))
end

def walResetGuardOldVersion(path: String): Void
  unsafe
    if sqliteWalResetSafeVersion(sqliteVersionNumber())
      return
    end
    let name = sqliteMigrationText(path)
    let handles = stackalloc Void*[1]
    let opened = sqliteOpen(name, handles, 6 as Int32, null)

    native::free(name)

    test::assertEqual(opened, 0 as Int32)
    let database = handles[0]

    test::assertEqual(sqliteExecuteLiteral(database, "CREATE TABLE wal_guard_records(id INTEGER)"), 0 as Int32)
    match sqliteConfigurationScalar(database, "PRAGMA main.journal_mode=wal")
      case result::Result.Error(error)
        test::assertTrue(false)
      case result::Result.Ok(actual)
        test::assertEqual(actual, "wal")
    end

    test::assertEqual(sqliteClose(database), 0 as Int32)

    # Preserve and an explicit DELETE must reject the already-WAL database
    # before changing its journal mode on an affected writable runtime.
    rejectedConfiguration(SQLiteProvider.openWritable(path))
    rejectedConfiguration(SQLiteProvider.openWritable(path, new SQLiteOptions(journal: SQLiteJournalMode.Delete())))

    let verifyName = sqliteMigrationText(path)
    let verifyHandles = stackalloc Void*[1]
    let verifyOpened = sqliteOpen(verifyName, verifyHandles, 2 as Int32, null)

    native::free(verifyName)

    test::assertEqual(verifyOpened, 0 as Int32)
    match sqliteConfigurationScalar(verifyHandles[0], "PRAGMA main.journal_mode")
      case result::Result.Error(error)
        test::assertTrue(false)
      case result::Result.Ok(actual)
        test::assertEqual(actual, "wal")
    end

    test::assertEqual(sqliteClose(verifyHandles[0]), 0 as Int32)

    # A requested WAL must fail before it can mutate a new database.
    let requestedPath = path + "-requested"

    rejectedConfiguration(SQLiteProvider.createWritable(
        requestedPath,
        new SQLiteOptions(journal: SQLiteJournalMode.Wal())
      ))
    let requestedName = sqliteMigrationText(requestedPath)
    let requestedHandles = stackalloc Void*[1]
    let requestedOpened = sqliteOpen(requestedName, requestedHandles, 2 as Int32, null)

    native::free(requestedName)

    test::assertEqual(requestedOpened, 0 as Int32)
    match sqliteConfigurationScalar(requestedHandles[0], "PRAGMA main.journal_mode")
      case result::Result.Error(error)
        test::assertTrue(false)
      case result::Result.Ok(actual)
        test::assertEqual(actual, "delete")
    end

    test::assertEqual(sqliteClose(requestedHandles[0]), 0 as Int32)
  end
end

def configurationContract(): resources::Outcome<Bool, result::Failure>
  using temporary <- files::TemporaryDirectory.create("sqlite-configuration-")
    let path = temporary.path() + "/configured.sqlite"

    walResetVersionContract()
    walResetGuardOldVersion(path + "-wal-guard")
    rejectedConfiguration(SQLiteProvider.createWritable(path, new SQLiteOptions(busyTimeoutMilliseconds: -1)))
    rejectedConfiguration(SQLiteProvider.createWritable(path, new SQLiteOptions(busyTimeoutMilliseconds: 60001)))
    var walSupported = false

    unsafe
      walSupported = sqliteWalResetSafeVersion(sqliteVersionNumber())
    end
    if walSupported
      configured(
        SQLiteProvider.createWritable(
          path,
          new SQLiteOptions(
            journal: SQLiteJournalMode.Wal(),
            synchronous: SQLiteSynchronous.Extra(),
            busyTimeoutMilliseconds: 25
          )
        ),
        "wal",
        3,
        25
      )
      # Default reopening preserves WAL but resets connection-local settings.
      configured(SQLiteProvider.openWritable(path), "wal", 2, 0)
      configured(SQLiteProvider.open(path, new SQLiteOptions(journal: SQLiteJournalMode.Wal())), "wal", 2, 0)
      rejectedConfiguration(SQLiteProvider.open(path, new SQLiteOptions(journal: SQLiteJournalMode.Delete())))
    else
      configured(
        SQLiteProvider.createWritable(
          path,
          new SQLiteOptions(
            journal: SQLiteJournalMode.Delete(),
            synchronous: SQLiteSynchronous.Extra(),
            busyTimeoutMilliseconds: 25
          )
        ),
        "delete",
        3,
        25
      )
    end
    configured(
      SQLiteProvider.openWritable(
        path,
        new SQLiteOptions(journal: SQLiteJournalMode.Delete(), synchronous: SQLiteSynchronous.Normal())
      ),
      "delete",
      1,
      0
    )
    configured(SQLiteProvider.createWritable(":memory:"), "memory", 2, 0)
    rejectedConfiguration(SQLiteProvider.createWritable(
        ":memory:",
        new SQLiteOptions(journal: SQLiteJournalMode.Wal())
      ))
    contentionDeadline(temporary.path() + "/deadline.sqlite")
    return true
  end
  return false
end

def main(): Void
  nativeEnrollmentContract()
  let outcome = configurationContract()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertTrue(value)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
end

class NativeEnrolledValue
  public id: Int = 0
  public parentId: Int = 0
end

def nativeEnrolledCapture(value: NativeEnrolledValue): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(value.id)), new RawColumn("parent_id", Cell.Int(value.parentId))])
end

def nativeEnrolledSetId(value: NativeEnrolledValue, id: Int): Void
  value.id = id
end

def nativeEnrolledId(value: NativeEnrolledValue): Int
  return value.id
end

def nativeEnrolledParent(value: NativeEnrolledValue): Int
  return value.parentId
end

def nativeEnrolledSetParent(value: NativeEnrolledValue, id: Int): Void
  value.parentId = id
end

def nativeEnrollmentContract(): Void
  unsafe
    let name = sqliteMigrationText(":memory:")
    let handles = stackalloc Void*[1]

    test::assertEqual(sqliteOpen(name, handles, 6 as Int32, null), 0 as Int32)
    native::free(name)
    let database = handles[0]

    test::assertEqual(
      sqliteExecuteLiteral(
        database,
        "PRAGMA foreign_keys=ON; CREATE TABLE native_roots(id INTEGER PRIMARY KEY,parent_id INTEGER NOT NULL); CREATE TABLE native_children(id INTEGER PRIMARY KEY,parent_id INTEGER NOT NULL REFERENCES native_roots(id)); BEGIN"
      ),
      0 as Int32
    )
    match SQLiteProvider.borrowNativeTransaction(database)
      case SQLiteOpenResult.Failure(error)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        let columns = new ResultColumns([
            new ResultColumn("id", ResultColumnKind.Int()),
            new ResultColumn("parent_id", ResultColumnKind.Int())
          ])
        let roots = new EntityTracker<NativeEnrolledValue>(
          "native_roots",
          "id",
          columns,
          nativeEnrolledCapture,
          generatedKey: true,
          setGeneratedKey: nativeEnrolledSetId
        )
        let children = new EntityTracker<NativeEnrolledValue>(
          "native_children",
          "id",
          columns,
          nativeEnrolledCapture,
          foreignKeyColumns: [["parent_id"]]
        )
        let context = new ChangeContext(provider)
        let root = new NativeEnrolledValue()
        let child = new NativeEnrolledValue()

        child.id = 7
        context.register(roots.changeSet())
        context.register(children.changeSet())
        nativeEnrolledSaved(context.enlistTransaction(1), 0)
        var principal: TrackedHandle<NativeEnrolledValue>? = null
        var dependent: TrackedHandle<NativeEnrolledValue>? = null

        match roots.addWithHandle(root)
          case TrackHandleResult.Tracked(handle)
            principal = handle
          case TrackHandleResult.Failure(error)
            test::assertTrue(false)
        end
        match children.addWithHandle(child)
          case TrackHandleResult.Tracked(handle)
            dependent = handle
          case TrackHandleResult.Failure(error)
            test::assertTrue(false)
        end
        if principal != null && dependent != null
          let temporaryRootKey = root.id
          let edge = new RelationshipLink<NativeEnrolledValue, NativeEnrolledValue>(
            principal,
            dependent,
            nativeEnrolledId,
            nativeEnrolledParent,
            nativeEnrolledSetParent,
            "parent_id"
          ).edge()

          test::assertTrue(context.registerRelation(edge) == null)
          let temporaryParentKey = child.parentId

          nativeEnrolledSaved(context.saveChanges(), 2)

          test::assertTrue(root.id > 0 && child.parentId == root.id)
          nativeEnrolledRejected(provider.acknowledgeNativeTransaction(true))
          nativeEnrolledRejected(context.commitTransaction())
          nativeEnrolledRejected(provider.commitTransaction(1))

          test::assertEqual(sqliteExecuteLiteral(database, "ROLLBACK"), 0 as Int32)
          nativeEnrolledRejected(context.synchronizeTransaction())
          nativeEnrolledSaved(provider.acknowledgeNativeTransaction(false), 0)
          nativeEnrolledSaved(context.synchronizeTransaction(), 0)

          test::assertTrue(temporaryRootKey < 0)
          test::assertEqual(root.id, temporaryRootKey)
          test::assertEqual(child.parentId, temporaryParentKey)
          test::assertEqual(temporaryParentKey, temporaryRootKey)
          test::assertEqual(sqliteExecuteLiteral(database, "BEGIN"), 0 as Int32)
          match provider.enlistNativeTransaction()
            case TransactionOpenResult.Begun(lease)
              nativeEnrolledSaved(context.enlistTransaction(lease), 0)
            case TransactionOpenResult.Failure(error)
              test::assertTrue(false)
          end
          nativeEnrolledSaved(context.saveChanges(), 2)

          test::assertTrue(root.id > 0 && child.parentId == root.id)
          test::assertEqual(sqliteExecuteLiteral(database, "COMMIT"), 0 as Int32)
          nativeEnrolledSaved(provider.acknowledgeNativeTransaction(true), 0)
          nativeEnrolledSaved(context.synchronizeTransaction(), 0)
        end

        test::assertTrue(provider.close())
        test::assertEqual(sqliteExecuteLiteral(database, "INSERT INTO native_roots VALUES(999,0)"), 0 as Int32)
    end

    test::assertEqual(sqliteClose(database), 0 as Int32)
  end
end

def nativeEnrolledSaved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, rows)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def nativeEnrolledRejected(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
    case WriteResult.SavedWithValues(count, rows)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(true)
  end
end
