use console
use files
use resources
use result
use test
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

def expectApplied(result: MigrationResult, expected: Int): Void
  match result
    case MigrationResult.Applied(count)
      test::assertEqual(count, expected)
    case MigrationResult.Failure(error)
      match error
        case MigrationFailure.Validation(message)
          console::println(message)
        case MigrationFailure.Drift(message)
          console::println(message)
        case MigrationFailure.Unsupported(message)
          console::println(message)
        case MigrationFailure.Provider(message)
          console::println(message)
      end

      test::assertTrue(false)
  end
end

def expectRejected(result: MigrationResult): Void
  match result
    case MigrationResult.Applied(count)
      test::assertTrue(false)
    case MigrationResult.Failure(error)
      match error
        case MigrationFailure.Validation(message)
          console::println(message)

          test::assertTrue(message != "")
        case MigrationFailure.Drift(message)
          console::println(message)

          test::assertTrue(message != "")
        case MigrationFailure.Unsupported(message)
          console::println(message)

          test::assertTrue(message != "")
        case MigrationFailure.Provider(message)
          console::println(message)

          test::assertTrue(message != "")
      end
  end
end

def expectValidationFailure(result: MigrationResult): Void
  match result
    case MigrationResult.Applied(count)
      test::assertTrue(false)
    case MigrationResult.Failure(error)
      match error
        case MigrationFailure.Validation(message)
          console::println(message)

          test::assertTrue(message != "")
        case MigrationFailure.Drift(message)
          console::println(message)

          test::assertTrue(false)
        case MigrationFailure.Unsupported(message)
          console::println(message)

          test::assertTrue(false)
        case MigrationFailure.Provider(message)
          console::println(message)

          test::assertTrue(false)
      end
  end
end

def assertSql(path: String, predicate: String): Void
  let sql = "CREATE TABLE __schema_rebuild_assert(value INTEGER CHECK(value = 1)); INSERT INTO __schema_rebuild_assert VALUES(" + predicate + "); DROP TABLE __schema_rebuild_assert;"

  test::assertTrue(createSQLiteFixture(path, sql))
end

def hasColumn(provider: SQLiteProvider, table: String, column: String): Bool
  match provider.inspectSchema()
    case SQLiteSchemaResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
      return false
    case SQLiteSchemaResult.Snapshot(snapshot)
      var index = 0

      while index < snapshot.count()
        let entry = snapshot.at(index)

        if entry != null && entry.table() == table && entry.name() == column
          return true
        end
        index = index + 1
      end
      return false
  end
end

def beforeModel(): SchemaModel
  let id = new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true))
  let score = new SchemaField("score", new SchemaColumn("score", SchemaType.Int()))
  let quantity = new SchemaField("quantity", new SchemaColumn("code", SchemaType.Text(), nullable: true))
  let note = new SchemaField("note", new SchemaColumn("note", SchemaType.Text(), nullable: true))
  let label = new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("old")))
  let index = new SchemaIndex("items_quantity_idx", ["quantity"])

  return new SchemaModel([new SchemaTable("items", "items", [id, score, quantity, note, label], [index])])
end

def afterModel(unique: Bool = false): SchemaModel
  let id = new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true))
  let score = new SchemaField("score", new SchemaColumn("score", SchemaType.Text()))
  let quantity = new SchemaField("quantity", new SchemaColumn("quantity", SchemaType.Int()))
  let note = new SchemaField("note", new SchemaColumn("note", SchemaType.Text()))
  let label = new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("new")))
  let index = new SchemaIndex("items_quantity_idx", ["quantity"], unique)

  return new SchemaModel([new SchemaTable("items", "items", [id, score, quantity, note, label], [index])])
end

def renamedAndExpandedModel(): SchemaModel
  let id = new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true))
  let score = new SchemaField("score", new SchemaColumn("score", SchemaType.Int()))
  let quantity = new SchemaField("quantity", new SchemaColumn("code", SchemaType.Text(), nullable: true))
  let note = new SchemaField("note", new SchemaColumn("note", SchemaType.Text(), nullable: true))
  let label = new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("old")))
  let category = new SchemaField("category", new SchemaColumn("category", SchemaType.Text(), nullable: true))
  let index = new SchemaIndex("items_quantity_idx", ["quantity"])

  return new SchemaModel([new SchemaTable("items", "products", [id, score, quantity, note, label, category], [index])])
end

def rebuiltRenamedModel(): SchemaModel
  let id = new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true))
  let score = new SchemaField("score", new SchemaColumn("score", SchemaType.Text()))
  let quantity = new SchemaField("quantity", new SchemaColumn("quantity", SchemaType.Int()))
  let note = new SchemaField("note", new SchemaColumn("note", SchemaType.Text()))
  let label = new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("new")))
  let category = new SchemaField("category", new SchemaColumn("category", SchemaType.Text(), nullable: true))
  let index = new SchemaIndex("items_quantity_idx", ["quantity"])

  return new SchemaModel([new SchemaTable("items", "products", [id, score, quantity, note, label, category], [index])])
end

def mustPlan(id: String, before: SchemaModel, after: SchemaModel): Migration
  match diffSchema(id, before, after)
    case SchemaDiffResult.Unchanged()
      test::assertTrue(false)
    case SchemaDiffResult.Failure(error)
      match error
        case MigrationFailure.Validation(message)
          console::println(message)
        case MigrationFailure.Drift(message)
          console::println(message)
        case MigrationFailure.Unsupported(message)
          console::println(message)
        case MigrationFailure.Provider(message)
          console::println(message)
      end

      test::assertTrue(false)
    case SchemaDiffResult.Plan(plan)
      return plan.migration()
  end
  return new Migration("unreachable", [], [])
end

def seedBefore(path: String, initial: Migration): Void
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  let schema = "INSERT INTO items(id,score,code,note) VALUES(1,7,'42','kept'); INSERT INTO items(id,score,code,note,label) VALUES(2,12,'9','also','custom');"

  test::assertTrue(createSQLiteFixture(path, schema))
end

def verifySuccessfulRebuild(path: String, initial: Migration, rebuild: Migration): Void
  console::println("SQLite rebuild: conversions, rename, required values, defaults, indexes, downgrade")
  seedBefore(path, initial)

  let migrations = new MigrationSet([initial, rebuild])

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(migrations), 1)

      test::assertTrue(hasColumn(provider, "items", "quantity"))
      test::assertFalse(hasColumn(provider, "items", "code"))
      test::assertTrue(provider.close())
  end

  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(typeof(score) = 'text' AND score IN ('7','12')) = 2 AND SUM(typeof(quantity) = 'integer' AND quantity IN (42,9)) = 2 AND SUM(note IS NOT NULL) = 2 AND SUM(label IN ('old','custom')) = 2 FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(sql LIKE '%quantity%') FROM sqlite_schema WHERE type = 'index' AND name = 'items_quantity_idx')")

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items(id,score,quantity,note) VALUES(3,'21',5,'future');"))
  assertSql(path, "(SELECT label = 'new' AND score = '21' AND quantity = 5 FROM items WHERE id = 3)")

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(migrations, "initial"), 1)

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 3 AND SUM(typeof(score) = 'integer' AND score IN (7,12,21)) = 3 AND SUM(typeof(code) = 'text' AND code IN ('42','9','5')) = 3 AND SUM(note IS NOT NULL) = 3 FROM items)")
  assertSql(path, "(SELECT label IN ('old','custom','new') FROM items WHERE id = 3)")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(sql LIKE '%code%') FROM sqlite_schema WHERE type = 'index' AND name = 'items_quantity_idx')")
end

def verifyCopyFailure(path: String, initial: Migration, rebuild: Migration): Void
  console::println("SQLite rebuild: invalid conversion rolls back schema, data, and migration history")
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items(id,score,code,note) VALUES(1,7,NULL,'null value'); INSERT INTO items(id,score,code,note) VALUES(2,8,'oops','bad integer');"))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectRejected(provider.migrate(new MigrationSet([initial, rebuild])))

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end

  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(code IS NULL) = 1 AND SUM(code = 'oops') = 1 FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM __neri_migrations WHERE id = 'initial')")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM __neri_migrations WHERE id = 'rebuild')")

  test::assertTrue(createSQLiteFixture(path, "UPDATE items SET code = '31' WHERE id = 1;"))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectValidationFailure(provider.migrate(new MigrationSet([initial, rebuild])))

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(code = '31') = 1 AND SUM(code = 'oops') = 1 FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM __neri_migrations WHERE id = 'initial')")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM __neri_migrations WHERE id = 'rebuild')")

  test::assertTrue(createSQLiteFixture(path, "UPDATE items SET code = '32' WHERE id = 2;"))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial, rebuild])), 1)

      test::assertTrue(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(quantity IN (31,32)) = 2 AND SUM(note IS NOT NULL) = 2 FROM items)")
end

def verifyExternalDependency(path: String, initial: Migration, rebuild: Migration): Void
  console::println("SQLite rebuild: unmanaged index blocks rebuild before mutation")
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items(id,score,code,note) VALUES(1,3,'4','kept'); CREATE INDEX external_items_note ON items(note);"))

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectRejected(provider.migrate(new MigrationSet([initial, rebuild])))

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 1 FROM sqlite_schema WHERE type = 'index' AND name = 'external_items_note')")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM __neri_migrations WHERE id = 'initial')")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(code) = '4' FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM __neri_migrations WHERE id = 'rebuild')")
end

def verifyUniqueIndexRollback(path: String, initial: Migration, uniqueRebuild: Migration): Void
  console::println("SQLite rebuild: unique index failure rolls back rebuilt table and history")
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items(id,score,code,note) VALUES(1,1,'7','one'); INSERT INTO items(id,score,code,note) VALUES(2,2,'7','two');"))

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectRejected(provider.migrate(new MigrationSet([initial, uniqueRebuild])))

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(code = '7') = 2 FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(sql LIKE '%code%') FROM sqlite_schema WHERE type = 'index' AND name = 'items_quantity_idx')")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM __neri_migrations WHERE id = 'initial')")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM __neri_migrations WHERE id = 'unique_failure')")
end

def verifyInboundForeignKey(path: String, initial: Migration, rebuild: Migration): Void
  console::println("SQLite rebuild: inbound cascading foreign key rejects before mutation")
  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items(id,score,code,note) VALUES(1,3,'4','kept'); CREATE TABLE child_refs(id INTEGER PRIMARY KEY,parent_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE); INSERT INTO child_refs VALUES(1,1);"))

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectRejected(provider.migrate(new MigrationSet([initial, rebuild])))

      test::assertTrue(hasColumn(provider, "items", "code"))
      test::assertFalse(hasColumn(provider, "items", "quantity"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(code) = '4' FROM items)")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(parent_id) = 1 FROM child_refs)")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM __neri_migrations WHERE id = 'initial')")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM __neri_migrations WHERE id = 'rebuild')")
end

def verifyRenameAddThenRebuild(path: String, before: SchemaModel, initial: Migration): Void
  console::println("SQLite rebuild: renamed and expanded model remains the rebuild source")
  let intermediate = renamedAndExpandedModel()
  let after = rebuiltRenamedModel()
  let renameAdd = mustPlan("rename_add", before, intermediate)
  let rebuild = mustPlan("products_rebuild", intermediate, after)

  seedBefore(path, initial)

  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial, renameAdd])), 1)

      test::assertTrue(hasColumn(provider, "products", "category"))
      test::assertFalse(hasColumn(provider, "items", "id"))
      expectApplied(provider.migrate(new MigrationSet([initial, renameAdd, rebuild])), 1)

      test::assertTrue(hasColumn(provider, "products", "quantity"))
      test::assertFalse(hasColumn(provider, "products", "code"))
      test::assertTrue(hasColumn(provider, "products", "category"))
      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 2 AND SUM(typeof(score) = 'text' AND score IN ('7','12')) = 2 AND SUM(quantity IN (42,9)) = 2 AND SUM(category IS NULL) = 2 AND SUM(label IN ('old','custom')) = 2 FROM products)")
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(sql LIKE '%quantity%') FROM sqlite_schema WHERE type = 'index' AND name = 'items_quantity_idx')")
end

def verifyTextPrimaryKeyRebuild(path: String): Void
  console::println("SQLite rebuild: Text primary key survives rebuild")
  let beforeTable = new SchemaTable("labels", "labels", [new SchemaField("id", new SchemaColumn("id", SchemaType.Text(), primaryKey: true)), new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("old")))])
  let afterTable = new SchemaTable("labels", "labels", [new SchemaField("id", new SchemaColumn("id", SchemaType.Text(), primaryKey: true)), new SchemaField("label", new SchemaColumn("label", SchemaType.Text(), defaultValue: SchemaDefault.Text("new")))])
  let before = new SchemaModel([beforeTable])
  let after = new SchemaModel([afterTable])
  let initial = mustPlan("labels_initial", new SchemaModel([]), before)
  let rebuild = mustPlan("labels_rebuild", before, after)

  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial])), 1)

      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO labels(id,label) VALUES('alpha','prior');"))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectApplied(provider.migrate(new MigrationSet([initial, rebuild])), 1)

      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(label) = 'prior' FROM labels WHERE id = 'alpha')")
  assertSql(path, "(SELECT COUNT(*) = 1 FROM pragma_index_list('labels') WHERE origin = 'pk')")

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO labels(id) VALUES('beta');"))
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(label) = 'new' FROM labels WHERE id = 'beta')")
end

def verifyCommentedConstraintPreflight(path: String): Void
  console::println("SQLite rebuild: comment cannot hide an unmanaged CHECK constraint")
  let before = new SchemaTable("checked", "checked", [new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true)), new SchemaField("score", new SchemaColumn("score", SchemaType.Int()))])
  let after = new SchemaTable("checked", "checked", [new SchemaField("id", new SchemaColumn("id", SchemaType.Int(), primaryKey: true)), new SchemaField("score", new SchemaColumn("score", SchemaType.Text()))])
  let rebuild = new Migration("comment_check", [SchemaOp.RebuildTable(before, after)], [SchemaOp.RebuildTable(after, before)])

  match SQLiteProvider.createWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      test::assertTrue(provider.close())
  end

  test::assertTrue(createSQLiteFixture(path, "CREATE TABLE checked(id INTEGER PRIMARY KEY, score INTEGER NOT NULL /* a quoted literal: ' CHECK(value) */ CHECK(score > 0)); INSERT INTO checked VALUES(1,7);"))
  match SQLiteProvider.openWritable(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      expectRejected(provider.migrate(new MigrationSet([rebuild])))

      test::assertTrue(provider.close())
  end
  assertSql(path, "(SELECT COUNT(*) = 1 AND MIN(score) = 7 FROM checked)")
  assertSql(path, "(SELECT COUNT(*) = 0 FROM sqlite_schema WHERE name = '__neri_migrations')")
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-schema-rebuild-")
    let before = beforeModel()
    let after = afterModel()
    let initial = mustPlan("initial", new SchemaModel([]), before)
    let rebuild = mustPlan("rebuild", before, after)
    let uniqueRebuild = mustPlan("unique_failure", before, afterModel(true))

    verifySuccessfulRebuild(temporary.path() + "/success.sqlite", initial, rebuild)
    verifyCopyFailure(temporary.path() + "/copy-failure.sqlite", initial, rebuild)
    verifyExternalDependency(temporary.path() + "/external.sqlite", initial, rebuild)
    verifyUniqueIndexRollback(temporary.path() + "/unique.sqlite", initial, uniqueRebuild)
    verifyInboundForeignKey(temporary.path() + "/inbound-fk.sqlite", initial, rebuild)
    verifyRenameAddThenRebuild(temporary.path() + "/renamed-chain.sqlite", before, initial)
    verifyTextPrimaryKeyRebuild(temporary.path() + "/text-key.sqlite")
    verifyCommentedConstraintPreflight(temporary.path() + "/comment-check.sqlite")
    return 0
  end
  return 1
end

def main(): Void
  let outcome = verifyFiles()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
