use result
namespace neri_data_sqlite

## Owns one SQLite provider for sequential use within a worker.
resource class SQLiteSession
  private ownedProvider: SQLiteProvider

  private def init(provider: SQLiteProvider): Void
    this.ownedProvider = provider
  end

  public static def open(path: String): result::Result<SQLiteSession, result::Failure>
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, result::Failure>.Error(new result::Failure("open_failed", "sqlite.session.open", message))
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, result::Failure>.Ok(transfer owned)
    end
  end

  public static def openWritable(path: String): result::Result<SQLiteSession, result::Failure>
    match SQLiteProvider.openWritable(path)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, result::Failure>.Error(new result::Failure("open_failed", "sqlite.session.openWritable", message))
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, result::Failure>.Ok(transfer owned)
    end
  end

  public static def createWritable(path: String): result::Result<SQLiteSession, result::Failure>
    match SQLiteProvider.createWritable(path)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, result::Failure>.Error(new result::Failure("open_failed", "sqlite.session.createWritable", message))
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, result::Failure>.Ok(transfer owned)
    end
  end

  ## Borrows the provider; the session retains responsibility for closing it.
  public def provider(): SQLiteProvider
    return this.ownedProvider
  end

  public def close(): result::Failure?
    if this.ownedProvider.close()
      return null
    end
    return new result::Failure("close_failed", "sqlite.session.close", "SQLite provider could not be closed")
  end
end
