use result
namespace neri_data_sqlite

## Owns one SQLite provider for sequential use within a worker.
resource class SQLiteSession
  private ownedProvider: SQLiteProvider

  private def init(provider: SQLiteProvider): Void
    this.ownedProvider = provider
  end

  public static def open(path: String, options: SQLiteOptions? = null): result::Result<SQLiteSession, neri_data::ProviderFailure>
    match SQLiteProvider.open(path, options)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Error(message)
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Ok(transfer owned)
    end
  end

  public static def openWritable(path: String, options: SQLiteOptions? = null): result::Result<SQLiteSession, neri_data::ProviderFailure>
    match SQLiteProvider.openWritable(path, options)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Error(message)
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Ok(transfer owned)
    end
  end

  public static def createWritable(path: String, options: SQLiteOptions? = null): result::Result<SQLiteSession, neri_data::ProviderFailure>
    match SQLiteProvider.createWritable(path, options)
      case SQLiteOpenResult.Failure(message)
        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Error(message)
      case SQLiteOpenResult.Opened(provider)
        let owned = new SQLiteSession(provider)

        return result::Result<SQLiteSession, neri_data::ProviderFailure>.Ok(transfer owned)
    end
  end

  ## Borrows the provider; the session retains responsibility for closing it.
  public def provider(): SQLiteProvider
    return this.ownedProvider
  end

  public def close(): result::Failure?
    let failure = this.ownedProvider.closeFailure()

    return failure != null ? sqliteResourceFailure(failure) : null
  end
end
