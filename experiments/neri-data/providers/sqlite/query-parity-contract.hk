use test
use resources
use result
use neri_data
use neri_data_sqlite
use neri_data_query_contract

def asyncContract(): resources::Outcome<Int, QueryFailure>
  match SQLiteAsyncProvider.open(":memory:")
    case result::Result.Error(error)
      return QueryFailure.Provider(error)
    case result::Result.Ok(provider)
      let completed = verifyAsyncQueryParity(provider)
      let closed = provider.closeFailure()

      test::assertTrue(closed == null)
      test::assertEqual(completed.closeFailures.count(), 0)
      match completed.completion
        case resources::Completion.Value(value)
          return value
        case resources::Completion.Failure(error)
          if error == null
            return QueryFailure.UnsupportedCapability("asynchronous query contract failed without a diagnostic")
          end
          return error
      end
  end
end

def main(): Void
  match SQLiteProvider.createWritable(":memory:")
    case SQLiteOpenResult.Failure(error)
      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      verifyQueryParity(provider)

      test::assertTrue(provider.close())
  end
  let completed = asyncContract()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
  console::println("SQLite query parity contracts passed")
end
