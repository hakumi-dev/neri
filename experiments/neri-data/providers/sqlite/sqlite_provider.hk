end

@library("sqlite3")
@cabiImport("sqlite3_column_int64")
unsafe def sqliteColumnInt(statement: Void*, index: Int32): Int
end

@library("sqlite3")
@cabiImport("sqlite3_column_double")
unsafe def sqliteColumnDouble(statement: Void*, index: Int32): Float
end

@library("sqlite3")
@cabiImport("sqlite3_column_text")
unsafe def sqliteColumnText(statement: Void*, index: Int32): Byte*?
end

@library("sqlite3")
@cabiImport("sqlite3_column_bytes")
unsafe def sqliteColumnBytes(statement: Void*, index: Int32): Int32
end

enum SQLiteOpenResult
  case Opened(provider: SQLiteProvider)
  case Failure(message: String)
end

class SQLiteSavepointNode
  public id: Int
  public previous: SQLiteSavepointNode?

  def init(id: Int, previous: SQLiteSavepointNode?): Void
    this.id = id
    this.previous = previous
  end
end

class SQLiteProvider: neri_data::Provider
  private database: Void*?
  private closed: Bool = false
  private writable: Bool = false
  private poisoned: Bool = false
  private streaming: Bool = false
  private windowFunctions: Bool = false
  private nextLease: Int = 1
  private activeLease: Int = 0
  private lastLease: Int = 0
  private lastTransactionState: TransactionState = TransactionState.Invalid()
  private nextSavepoint: Int = 1
  private savepoints: SQLiteSavepointNode?

  private def init(): Void
  end

  static def open(path: String): SQLiteOpenResult
    return SQLiteProvider.openMode(path, false, false)
  end

  static def openWritable(path: String): SQLiteOpenResult
    return SQLiteProvider.openMode(path, true, false)
  end

  static def createWritable(path: String): SQLiteOpenResult
    return SQLiteProvider.openMode(path, true, true)
  end

  private static def openMode(path: String, writable: Bool, create: Bool): SQLiteOpenResult
    let length = host::stringByteLength(path)

    if length == 0 || length > 2147483646
      return SQLiteOpenResult.Failure("invalid SQLite path")
    end
    var index = 0

    while index < length
      if host::stringByteAt(path, index) == (0 as Byte)
        return SQLiteOpenResult.Failure("SQLite path contains NUL")
      end
      index = index + 1
    end
    unsafe
      let bytes = native::alloc<Byte>(length + 1)

      index = 0

      while index < length
        bytes[index] = host::stringByteAt(path, index)
        index = index + 1
      end
      bytes[length] = 0 as Byte
      let result = stackalloc Void*[1]
      let status = sqliteOpen(bytes, result, writable ? (create ? (6 as Int32) : (2 as Int32)) : (1 as Int32), null)

      native::free(bytes)
      if status != (0 as Int32)
        var message = "SQLite open failed: " + ((status as Int) as String)
        let database: Void*? = result[0]

        if database != null
          message = sqliteMessage(database)
          sqliteClose(database)
        end
        return SQLiteOpenResult.Failure(message)
      end
      if !sqliteRegisterCheckedScalars(result[0])
        let message = sqliteMessage(result[0])

        sqliteClose(result[0])
        return SQLiteOpenResult.Failure("SQLite checked scalar registration failed: " + message)
      end
      let provider = new SQLiteProvider()

      provider.database = result[0]
      provider.windowFunctions = sqliteVersionNumber() >= (3025000 as Int32) && sqliteExecuteLiteral(result[0], "SELECT ROW_NUMBER() OVER (PARTITION BY 1 ORDER BY 1)") == (0 as Int32)
      if writable
        let name = stackalloc Byte[5]

        name[0] = 109 as Byte
        name[1] = 97 as Byte
        name[2] = 105 as Byte
        name[3] = 110 as Byte
        name[4] = 0 as Byte
        if sqliteDatabaseReadOnly(result[0], name) != (0 as Int32)
          sqliteClose(result[0])
          return SQLiteOpenResult.Failure("SQLite database is read-only")
        end
        # SQLite foreign-key enforcement is connection-local and may default off.
        # https://sqlite.org/foreignkeys.html
        if sqliteExecuteLiteral(result[0], "PRAGMA foreign_keys=ON") != (0 as Int32)
          let message = sqliteMessage(result[0])

          sqliteClose(result[0])
          return SQLiteOpenResult.Failure(message)
        end
        if !sqliteForeignKeysEnabled(result[0])
          sqliteClose(result[0])
          return SQLiteOpenResult.Failure("SQLite foreign-key enforcement unavailable")
        end
      end
      provider.writable = writable
      return SQLiteOpenResult.Opened(provider)
    end
  end

  public def close(): Bool
    if this.streaming
      return false
    end
    unsafe
      let database = this.database

      if database == null
        return true
      end
      if this.activeLease != 0
        if sqliteAutoCommit(database) == (0 as Int32)
          let rolledBack = sqliteExecuteLiteral(database, "ROLLBACK")

          if rolledBack != (0 as Int32) || sqliteAutoCommit(database) == (0 as Int32)
            this.poisoned = true
            this.lastTransactionState = TransactionState.Failed()
            return false
          end
        end
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
      end
      if sqliteClose(database) != (0 as Int32)
        return false
      end
      this.database = null
    end
    this.closed = true
    return true
  end

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.BoundedTypedReads()
        return true
      case ProviderCapability.StreamingReads()
        return !this.closed && !this.poisoned
      case ProviderCapability.SetWrites()
        return this.writable && !this.closed && !this.poisoned
      case ProviderCapability.TrackedWrites()
        return this.writable && !this.closed && !this.poisoned
      case ProviderCapability.ExplicitTransactions()
        return this.writable && !this.closed && !this.poisoned
      case ProviderCapability.Savepoints()
        return this.writable && !this.closed && !this.poisoned
      case ProviderCapability.CheckedScalarExpressions()
        return !this.closed && !this.poisoned
      case ProviderCapability.WindowFunctions()
        return this.windowFunctions && !this.closed && !this.poisoned
    end
  end

  public def inspectSchema(): SQLiteSchemaResult
    if this.streaming
      return SQLiteSchemaResult.Failure("SQLite provider is busy streaming")
    end
    if this.closed || this.poisoned
      return SQLiteSchemaResult.Failure("SQLite provider is closed or transaction state is uncertain")
    end
    unsafe
      let database = this.database

      if database == null
        return SQLiteSchemaResult.Failure("SQLite database handle unavailable")
      end
      return sqliteInspectSchema(database)
    end
  end

  public def migrate(catalog: readonly MigrationSet, target: String? = null): MigrationResult
    if this.streaming
      return MigrationResult.Failure(MigrationFailure.Unsupported("SQLite provider is busy streaming"))
    end
    if this.activeLease != 0
      return MigrationResult.Failure(MigrationFailure.Unsupported("SQLite provider has an active transaction lease"))
    end
    if this.closed || !this.writable
      return MigrationResult.Failure(MigrationFailure.Unsupported("SQLite provider is closed or read-only"))
    end
    if this.poisoned
      return MigrationResult.Failure(MigrationFailure.Provider("SQLite transaction state is uncertain"))
    end
    let invalid = catalog.validate()

    if invalid != null
      return MigrationResult.Failure(MigrationFailure.Validation(invalid))
    end
    if catalog.count() > 1000
      return MigrationResult.Failure(MigrationFailure.Validation("SQLite migration catalog exceeds 1000 entries"))
    end
    var targetCount = catalog.count()

    if target != null
      targetCount = 0
      if target != ""
        var found = false
        var index = 0

        while index < catalog.count()
          let migration = catalog.at(index)

          if migration != null && migration.id() == target
            targetCount = index + 1
            found = true
          end
          index = index + 1
        end
        if !found
          return MigrationResult.Failure(MigrationFailure.Validation("migration target is not in catalog"))
        end
      end
    end
    unsafe
      if sqliteVersionNumber() < (3035000 as Int32)
        return MigrationResult.Failure(MigrationFailure.Unsupported("SQLite migrations require SQLite 3.35.0 or newer"))
      end
      let database = this.database

      if database == null
        return MigrationResult.Failure(MigrationFailure.Provider("SQLite database handle unavailable"))
      end
      if !sqliteForeignKeysEnabled(database)
        return MigrationResult.Failure(MigrationFailure.Provider("SQLite foreign-key enforcement is unavailable"))
      end
      if sqliteAutoCommit(database) == (0 as Int32)
        this.poisoned = true
        return MigrationResult.Failure(MigrationFailure.Provider("SQLite connection already has an unowned transaction"))
      end
      let begun = sqliteExecuteLiteral(database, "BEGIN IMMEDIATE")

      if begun != (0 as Int32)
        if sqliteAutoCommit(database) == (0 as Int32)
          this.poisoned = true
        end
        return MigrationResult.Failure(MigrationFailure.Provider("SQLite migration begin failed: " + sqliteMessage(database)))
      end
      let historyCreated = sqliteExecuteLiteral(database, "CREATE TABLE IF NOT EXISTS __neri_migrations (ordinal INTEGER PRIMARY KEY, id TEXT NOT NULL, signature TEXT NOT NULL)")

      if historyCreated != (0 as Int32)
        return this.failMigration(MigrationFailure.Provider("SQLite migration history setup failed: " + sqliteMessage(database)))
      end
      match sqliteMigrationHistory(database, catalog.count())
        case SQLiteMigrationHistory.Failure(message)
          return this.failMigration(MigrationFailure.Drift(message))
        case SQLiteMigrationHistory.Loaded(stamps)
          let mismatch = catalog.historyPrefix(stamps)

          if mismatch != null
            return this.failMigration(MigrationFailure.Drift(mismatch))
          end
          var count = 0

          if stamps.Length < targetCount
            var index = stamps.Length

            while index < targetCount
              let migration = catalog.at(index)

              if migration == null
                return this.failMigration(MigrationFailure.Validation("migration catalog has a missing entry"))
              end
              let failed = sqliteMigrationOperations(database, migration, true)

              if failed != null
                return this.failMigration(failed)
              end
              let recorded = sqliteMigrationRecord(database, index + 1, new MigrationStamp(migration.id(), migration.signature()))

              if recorded != null
                return this.failMigration(MigrationFailure.Provider(recorded))
              end
              count = count + 1
              index = index + 1
            end
          else
            var index = stamps.Length - 1

            while index >= targetCount
              let migration = catalog.at(index)

              if migration == null
                return this.failMigration(MigrationFailure.Validation("migration catalog has a missing entry"))
              end
              let failed = sqliteMigrationOperations(database, migration, false)

              if failed != null
                return this.failMigration(failed)
              end
              let forgotten = sqliteMigrationForget(database, index + 1)

              if forgotten != null
                return this.failMigration(MigrationFailure.Provider(forgotten))
              end
              count = count + 1
              index = index - 1
            end
          end
          let committed = sqliteExecuteLiteral(database, "COMMIT")

          if committed != (0 as Int32)
            return this.failMigration(MigrationFailure.Provider("SQLite migration commit failed: " + sqliteMessage(database)))
          end
          if sqliteAutoCommit(database) == (0 as Int32)
            return this.failMigration(MigrationFailure.Provider("SQLite migration commit did not end the transaction"))
          end
          return MigrationResult.Applied(count)
      end
    end
  end

  private def failMigration(error: MigrationFailure): MigrationResult
    unsafe
      let database = this.database

      if database == null
        this.poisoned = true
        return MigrationResult.Failure(MigrationFailure.Provider(sqliteMigrationFailureMessage(error) + "; rollback cannot access database"))
      end
      if sqliteAutoCommit(database) == (0 as Int32)
        let rolledBack = sqliteExecuteLiteral(database, "ROLLBACK")

        if rolledBack != (0 as Int32) || sqliteAutoCommit(database) == (0 as Int32)
          this.poisoned = true
          return MigrationResult.Failure(MigrationFailure.Provider(sqliteMigrationFailureMessage(error) + "; rollback failed: " + sqliteMessage(database)))
        end
      end
      return MigrationResult.Failure(error)
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    if this.streaming
      return ProviderResult.Failure("SQLite provider is busy streaming")
    end
    if this.closed || this.poisoned
      return ProviderResult.Failure("SQLite provider is closed or transaction state is uncertain")
    end
    if plan.limit() < 1 || plan.limit() > queryRowLimit()
      return ProviderResult.Failure("invalid SQLite row limit")
    end
    let sql = plan.sql()
    let length = host::stringByteLength(sql)

    if length == 0 || length > 2147483646
      return ProviderResult.Failure("invalid SQLite SQL length")
    end
    var index = 0

    while index < length
      if host::stringByteAt(sql, index) == (0 as Byte)
        return ProviderResult.Failure("SQLite SQL contains NUL")
      end
      index = index + 1
    end
    unsafe
      let database = this.database

      if database == null
        return ProviderResult.Failure("SQLite provider is closed")
      end
      let bytes = native::alloc<Byte>(length + 1)

      index = 0

      while index < length
        bytes[index] = host::stringByteAt(sql, index)
        index = index + 1
      end
      bytes[length] = 0 as Byte
      let statement = stackalloc Void*[1]
      let tail = stackalloc Byte*[1]
      let status = sqlitePrepare(database, bytes, length as Int32, statement, tail)

      if status != (0 as Int32)
        let message = sqliteMessage(database)
        let prepared: Void*? = statement[0]

        if prepared != null
          sqliteFinalize(prepared)
        end
        native::free(bytes)
        return ProviderResult.Failure(message)
      end
      let prepared: Void*? = statement[0]

      if prepared == null
        native::free(bytes)
        return ProviderResult.Failure("SQLite plan has no statement")
      end
      # sqlite3_prepare_v2 leaves the first unused byte in tail.
      # https://sqlite.org/c3ref/prepare.html
      let trailing = tail[0]

      if trailing[0] != (0 as Byte)
        sqliteFinalize(prepared)
        native::free(bytes)
        return ProviderResult.Failure("SQLite plan contains trailing SQL")
      end
      native::free(bytes)
      if sqliteReadOnly(prepared) == (0 as Int32)
        sqliteFinalize(prepared)
        return ProviderResult.Failure("SQLite plan is not read-only")
      end
      if sqliteParameterCount(prepared) != (plan.parameters().count() as Int32)
        sqliteFinalize(prepared)
        return ProviderResult.Failure("SQLite parameter count mismatch")
      end
      let bound = bindParameters(database, prepared, plan.parameters())

      match bound
        case SQLiteBindResult.Failure(message, buffers)
          sqliteFinalize(prepared)
          freeBuffers(buffers)
          return ProviderResult.Failure(message)
        case SQLiteBindResult.Bound(buffers)
          let rows = readRows(database, prepared, plan)
          let finalizeCode = sqliteFinalize(prepared)

          # SQLITE_STATIC keeps each text pointer borrowed until finalization.
          # https://sqlite.org/c3ref/bind_blob.html
          freeBuffers(buffers)
          match rows
            case ProviderResult.Failure(message)
              return ProviderResult.Failure(message)
            case ProviderResult.Rows(values)
              if finalizeCode != (0 as Int32)
                return ProviderResult.Failure("SQLite finalize failed: " + ((finalizeCode as Int) as String))
              end
              return ProviderResult.Rows(values)
          end
      end
    end
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    if this.streaming
      return StreamResult.Failure(QueryFailure.Provider("SQLite provider is busy streaming"), 0)
    end
    if this.closed || this.poisoned
      return StreamResult.Failure(QueryFailure.Provider("SQLite provider is closed or transaction state is uncertain"), 0)
    end
    this.streaming = true
    unsafe
      let database = this.database

      if database == null
        this.streaming = false
        return StreamResult.Failure(QueryFailure.Provider("SQLite database handle unavailable"), 0)
      end
      let deadline = stackalloc SQLiteStreamDeadline[1]

      deadline.deadline = 9223372036854775807
      deadline.expired = 0 as Int32
      let target = plan.deadlineMilliseconds()

      if target != null
        deadline.deadline = target
        # SQLite may invoke this callback during prepare as well as step.
        # https://sqlite.org/c3ref/progress_handler.html
        sqliteProgressHandler(database, 1000 as Int32, sqliteStreamProgress, deadline as Void*)
      end
      let result = sqliteStreamPrepared(database, plan, visit, deadline)

      if target != null
        sqliteProgressHandler(database, 0 as Int32, null, null)
      end
      if this.activeLease != 0 && sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
      end
      this.streaming = false
      return result
    end
  end

  public override def writeBatch(batch: readonly WriteBatch): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if this.activeLease != 0
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider has an active transaction lease"))
    end
    return this.writeStandaloneBatch(batch)
  end

  public override def executeSet(plan: readonly SetWritePlan): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if this.activeLease != 0
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider has an active transaction lease"))
    end
    if this.poisoned
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction state is uncertain"))
    end
    if this.closed
      return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is closed"))
    end
    if !this.writable
      return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is read-only"))
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is closed"))
      end
      let begun = sqliteExecuteLiteral(database, "BEGIN IMMEDIATE")

      if begun != (0 as Int32)
        return this.failBatch(sqliteWriteFailure(database, begun, "begin"))
      end
      match executeSetStatement(database, plan)
        case SQLiteSetStep.Failure(error)
          return this.failBatch(error)
        case SQLiteSetStep.Success(changed)
          let committed = sqliteExecuteLiteral(database, "COMMIT")

          if committed != (0 as Int32)
            return this.failBatch(sqliteWriteFailure(database, committed, "commit"))
          end
          return WriteResult.Saved(changed)
      end
    end
  end

  private def writeStandaloneBatch(batch: readonly WriteBatch): WriteResult
    if this.poisoned
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction state is uncertain"))
    end
    if this.closed
      return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is closed"))
    end
    if !this.writable
      return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is read-only"))
    end
    if batch.count() < 0 || batch.count() > 1000
      return WriteResult.Failure(WriteFailure.Validation("SQLite write batch exceeds operation limit"))
    end
    var scan = batch.first()

    while scan != null
      if scan.command().returningColumns() != null
        return WriteResult.Failure(WriteFailure.Validation("generated SQLite output requires a transaction lease"))
      end
      scan = scan.next()
    end
    if batch.count() == 0
      return WriteResult.Saved(0)
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Unsupported("SQLite provider is closed"))
      end
      let begun = sqliteExecuteLiteral(database, "BEGIN IMMEDIATE")

      if begun != (0 as Int32)
        return this.failBatch(sqliteWriteFailure(database, begun, "begin"))
      end
      var current = batch.first()
      var count = 0

      while current != null
        match executeWriteCommand(database, current.command())
          case SQLiteWriteStep.Success(row)
            count = count + 1
          case SQLiteWriteStep.Failure(error)
            return this.failBatch(error)
        end
        current = current.next()
      end
      if count != batch.count()
        return this.failBatch(WriteFailure.Validation("SQLite write batch count mismatch"))
      end
      let committed = sqliteExecuteLiteral(database, "COMMIT")

      if committed != (0 as Int32)
        return this.failBatch(sqliteWriteFailure(database, committed, "commit"))
      end
      return WriteResult.Saved(count)
    end
  end

  public override def beginTransaction(): TransactionOpenResult
    if this.streaming
      return TransactionOpenResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if this.poisoned
      return TransactionOpenResult.Failure(WriteFailure.Transaction("SQLite transaction state is uncertain"))
    end
    if this.closed || !this.writable
      return TransactionOpenResult.Failure(WriteFailure.Unsupported("SQLite provider is closed or read-only"))
    end
    if this.activeLease != 0
      return TransactionOpenResult.Failure(WriteFailure.Validation("SQLite transaction already active"))
    end
    if this.nextLease <= 0 || this.nextLease == 9223372036854775807
      return TransactionOpenResult.Failure(WriteFailure.Transaction("SQLite transaction lease IDs exhausted"))
    end
    unsafe
      let database = this.database

      if database == null
        return TransactionOpenResult.Failure(WriteFailure.Unsupported("SQLite provider is closed"))
      end
      if sqliteAutoCommit(database) == (0 as Int32)
        this.poisoned = true
        return TransactionOpenResult.Failure(WriteFailure.Transaction("SQLite connection already has an unowned transaction"))
      end
      let begun = sqliteExecuteLiteral(database, "BEGIN IMMEDIATE")

      if begun != (0 as Int32)
        return TransactionOpenResult.Failure(sqliteWriteFailure(database, begun, "begin"))
      end
      let lease = this.nextLease

      this.nextLease = lease + 1
      this.activeLease = lease
      this.savepoints = null
      this.lastLease = lease
      this.lastTransactionState = TransactionState.Active()
      return TransactionOpenResult.Begun(lease)
    end
  end

  public override def transactionState(lease: Int): TransactionState
    if lease <= 0
      return TransactionState.Invalid()
    end
    if lease == this.activeLease
      if this.poisoned
        return TransactionState.Failed()
      end
      return TransactionState.Active()
    end
    if lease == this.lastLease
      return this.lastTransactionState
    end
    return TransactionState.Invalid()
  end

  private def savepointName(id: Int): String
    return "neri_user_savepoint_" + (id as String)
  end

  public override def createSavepoint(lease: Int): SavepointOpenResult
    if this.streaming
      return SavepointOpenResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return SavepointOpenResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    if this.poisoned || this.closed
      return SavepointOpenResult.Failure(WriteFailure.Transaction("SQLite transaction is unavailable"))
    end
    if this.nextSavepoint <= 0 || this.nextSavepoint == 9223372036854775807
      return SavepointOpenResult.Failure(WriteFailure.Transaction("SQLite savepoint IDs exhausted"))
    end
    unsafe
      let database = this.database

      if database == null
        return SavepointOpenResult.Failure(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return SavepointOpenResult.Failure(WriteFailure.Transaction("SQLite transaction was rolled back"))
      end
      let id = this.nextSavepoint
      let status = sqliteExecuteLiteral(database, "SAVEPOINT " + this.savepointName(id))

      if status != (0 as Int32)
        let failure = sqliteWriteFailure(database, status, "savepoint")

        if sqliteAutoCommit(database) != (0 as Int32)
          this.activeLease = 0
          this.savepoints = null
          this.lastTransactionState = TransactionState.RolledBack()
        end
        return SavepointOpenResult.Failure(failure)
      end
      this.nextSavepoint = id + 1
      this.savepoints = new SQLiteSavepointNode(id, this.savepoints)
      return SavepointOpenResult.Created(id)
    end
  end

  public override def rollbackToSavepoint(lease: Int, id: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    let top = this.savepoints

    if top == null || id <= 0 || top.id != id
      return WriteResult.Failure(WriteFailure.Validation("invalid or non-top SQLite savepoint"))
    end
    if this.poisoned || this.closed
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction is unavailable"))
    end
    unsafe
      let database = this.database

      if database == null
        return this.failOuterTransaction(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction was rolled back"))
      end
      let status = sqliteExecuteLiteral(database, "ROLLBACK TO SAVEPOINT " + this.savepointName(id))

      if status != (0 as Int32)
        return this.failOuterTransaction(sqliteWriteFailure(database, status, "rollback to savepoint"))
      end
      return WriteResult.Saved(0)
    end
  end

  public override def releaseSavepoint(lease: Int, id: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    let top = this.savepoints

    if top == null || id <= 0 || top.id != id
      return WriteResult.Failure(WriteFailure.Validation("invalid or non-top SQLite savepoint"))
    end
    if this.poisoned || this.closed
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction is unavailable"))
    end
    unsafe
      let database = this.database

      if database == null
        return this.failOuterTransaction(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction was rolled back"))
      end
      let status = sqliteExecuteLiteral(database, "RELEASE SAVEPOINT " + this.savepointName(id))

      if status != (0 as Int32)
        return this.failOuterTransaction(sqliteWriteFailure(database, status, "release savepoint"))
      end
      this.savepoints = top.previous
      return WriteResult.Saved(0)
    end
  end

  public override def writeBatchInTransaction(batch: readonly WriteBatch, lease: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    if this.poisoned || this.closed
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction is unavailable"))
    end
    if batch.count() < 0 || batch.count() > 1000
      return WriteResult.Failure(WriteFailure.Validation("SQLite write batch exceeds operation limit"))
    end
    if batch.count() == 0
      return WriteResult.Saved(0)
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      let begun = sqliteExecuteLiteral(database, "SAVEPOINT neri_write_batch")

      if begun != (0 as Int32)
        return this.failLeasedBatch(sqliteWriteFailure(database, begun, "savepoint"))
      end
      var current = batch.first()
      var count = 0
      let outputs = new WriteReturnedRows()
      var hasOutputs = false

      while current != null
        match executeWriteCommand(database, current.command())
          case SQLiteWriteStep.Success(row)
            count = count + 1
            outputs.add(row)
            if row != null
              hasOutputs = true
            end
          case SQLiteWriteStep.Failure(error)
            return this.failLeasedBatch(error)
        end
        current = current.next()
      end
      if count != batch.count()
        return this.failLeasedBatch(WriteFailure.Validation("SQLite write batch count mismatch"))
      end
      let released = sqliteExecuteLiteral(database, "RELEASE SAVEPOINT neri_write_batch")

      if released != (0 as Int32)
        return this.failLeasedBatch(sqliteWriteFailure(database, released, "release savepoint"))
      end
      if hasOutputs
        return WriteResult.SavedWithValues(count, outputs)
      end
      return WriteResult.Saved(count)
    end
  end

  public override def executeSetInTransaction(plan: readonly SetWritePlan, lease: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    if this.poisoned || this.closed
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction is unavailable"))
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      let begun = sqliteExecuteLiteral(database, "SAVEPOINT neri_write_batch")

      if begun != (0 as Int32)
        return this.failLeasedBatch(sqliteWriteFailure(database, begun, "savepoint"))
      end
      match executeSetStatement(database, plan)
        case SQLiteSetStep.Failure(error)
          return this.failLeasedBatch(error)
        case SQLiteSetStep.Success(changed)
          let released = sqliteExecuteLiteral(database, "RELEASE SAVEPOINT neri_write_batch")

          if released != (0 as Int32)
            return this.failLeasedBatch(sqliteWriteFailure(database, released, "release savepoint"))
          end
          return WriteResult.Saved(changed)
      end
    end
  end

  public override def commitTransaction(lease: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    if this.poisoned
      return WriteResult.Failure(WriteFailure.Transaction("SQLite transaction state is uncertain"))
    end
    if this.savepoints != null
      return WriteResult.Failure(WriteFailure.Validation("SQLite savepoints must be released before commit"))
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      let committed = sqliteExecuteLiteral(database, "COMMIT")

      if committed != (0 as Int32)
        return this.failOuterTransaction(sqliteWriteFailure(database, committed, "commit"))
      end
      this.activeLease = 0
      this.savepoints = null
      this.lastTransactionState = TransactionState.Committed()
      return WriteResult.Saved(0)
    end
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    if this.streaming
      return WriteResult.Failure(WriteFailure.Transaction("SQLite provider is busy streaming"))
    end
    if lease <= 0 || lease != this.activeLease
      return WriteResult.Failure(WriteFailure.Validation("invalid SQLite transaction lease"))
    end
    unsafe
      let database = this.database

      if database == null
        return WriteResult.Failure(WriteFailure.Transaction("SQLite database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return WriteResult.Saved(0)
      end
      let rolledBack = sqliteExecuteLiteral(database, "ROLLBACK")

      if rolledBack != (0 as Int32) || sqliteAutoCommit(database) == (0 as Int32)
        this.poisoned = true
        this.lastTransactionState = TransactionState.Failed()
        return WriteResult.Failure(WriteFailure.Transaction("SQLite rollback failed"))
      end
      this.activeLease = 0
      this.savepoints = null
      this.lastTransactionState = TransactionState.RolledBack()
      return WriteResult.Saved(0)
    end
  end

  private def failLeasedBatch(error: WriteFailure): WriteResult
    unsafe
      let database = this.database

      if database == null
        this.poisoned = true
        this.lastTransactionState = TransactionState.Failed()
        return WriteResult.Failure(WriteFailure.Transaction(writeFailureMessage(error) + "; database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return WriteResult.Failure(error)
      end
      let rolledBack = sqliteExecuteLiteral(database, "ROLLBACK TO SAVEPOINT neri_write_batch")
      let released = rolledBack == (0 as Int32) ? sqliteExecuteLiteral(database, "RELEASE SAVEPOINT neri_write_batch") : rolledBack

      if rolledBack != (0 as Int32) || released != (0 as Int32)
        return this.failOuterTransaction(WriteFailure.Transaction(writeFailureMessage(error) + "; batch savepoint rollback failed"))
      end
      return WriteResult.Failure(error)
    end
  end

  private def failOuterTransaction(error: WriteFailure): WriteResult
    unsafe
      let database = this.database

      if database == null
        this.poisoned = true
        this.lastTransactionState = TransactionState.Failed()
        return WriteResult.Failure(WriteFailure.Transaction(writeFailureMessage(error) + "; database handle unavailable"))
      end
      if sqliteAutoCommit(database) != (0 as Int32)
        this.activeLease = 0
        this.savepoints = null
        this.lastTransactionState = TransactionState.RolledBack()
        return WriteResult.Failure(error)
      end
      let rolledBack = sqliteExecuteLiteral(database, "ROLLBACK")

      if rolledBack != (0 as Int32) || sqliteAutoCommit(database) == (0 as Int32)
        this.poisoned = true
        this.lastTransactionState = TransactionState.Failed()
        return WriteResult.Failure(WriteFailure.Transaction(writeFailureMessage(error) + "; outer rollback failed"))
      end
      this.activeLease = 0
      this.savepoints = null
      this.lastTransactionState = TransactionState.RolledBack()
      return WriteResult.Failure(error)
    end
  end

  private def failBatch(error: WriteFailure): WriteResult
    # Some SQLite errors auto-rollback; COMMIT failure can leave a transaction open.
    # https://sqlite.org/lang_transaction.html
    unsafe
      let database = this.database

      if database == null
        this.poisoned = true
        return WriteResult.Failure(WriteFailure.Transaction(writeFailureMessage(error) + "; database handle unavailable"))
      end
      if sqliteAutoCommit(database) == (0 as Int32)
        let rollbackCode = sqliteExecuteLiteral(database, "ROLLBACK")

        if rollbackCode != (0 as Int32) || sqliteAutoCommit(database) == (0 as Int32)
          this.poisoned = true
          return WriteResult.Failure(WriteFailure.Transaction(writeFailureMessage(error) + "; rollback failed"))
        end
      end
    end
    return WriteResult.Failure(error)
  end
end

enum SQLiteWriteStep
  case Success(row: RawRow?)
  case Failure(error: WriteFailure)
end

enum SQLiteSetStep
  case Success(changed: Int)
  case Failure(error: WriteFailure)
end

enum SQLiteWriteBindResult
  case Bound(buffers: SQLiteTextBufferNode?)
  case Failure(error: WriteFailure, buffers: SQLiteTextBufferNode?)
end

unsafe def sqliteWriteFailure(database: Void*, status: Int32, stage: String): WriteFailure
  let code = sqliteExtendedError(database) as Int
  let raw = status as Int
  let primary = raw - (raw / 256) * 256
  let message = "SQLite " + stage + " failed (code " + (code as String) + "): " + sqliteMessage(database)

  if primary == 19
    return WriteFailure.Constraint(message)
  end
  if primary == 5 || primary == 6
    return WriteFailure.Transaction(message)
  end
  if primary == 8
    return WriteFailure.Unsupported(message)
  end
  return WriteFailure.Provider(message)
end

unsafe def sqliteExecuteLiteral(database: Void*, sql: String): Int32
  let length = host::stringByteLength(sql)
  let bytes = native::alloc<Byte>(length + 1)
  var index = 0

  while index < length
    bytes[index] = host::stringByteAt(sql, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  let status = sqliteExec(database, bytes, null, null, null)

  native::free(bytes)
  return status
end

unsafe def sqliteForeignKeysEnabled(database: Void*): Bool
  let sql = "PRAGMA foreign_keys"
  let length = host::stringByteLength(sql)
  let bytes = native::alloc<Byte>(length + 1)
  var index = 0

  while index < length
    bytes[index] = host::stringByteAt(sql, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  let statement = stackalloc Void*[1]
  let status = sqlitePrepare(database, bytes, length as Int32, statement, null)

  native::free(bytes)
  let prepared: Void*? = statement[0]

  if status != (0 as Int32) || prepared == null
    if prepared != null
      sqliteFinalize(prepared)
    end
    return false
  end
  let enabled = sqliteStep(prepared) == (100 as Int32) && sqliteColumnInt(prepared, 0 as Int32) == 1
  let finalized = sqliteFinalize(prepared)

  return enabled && finalized == (0 as Int32)
end

unsafe def executeSetStatement(database: Void*, plan: readonly SetWritePlan): SQLiteSetStep
  let sql = plan.sql()
  let length = host::stringByteLength(sql)

  if length == 0 || length > 2147483646
    return SQLiteSetStep.Failure(WriteFailure.Validation("invalid SQLite set SQL length"))
  end
  var index = 0

  while index < length
    if host::stringByteAt(sql, index) == (0 as Byte)
      return SQLiteSetStep.Failure(WriteFailure.Validation("SQLite set SQL contains NUL"))
    end
    index = index + 1
  end
  let bytes = native::alloc<Byte>(length + 1)

  index = 0

  while index < length
    bytes[index] = host::stringByteAt(sql, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  let statement = stackalloc Void*[1]
  let tail = stackalloc Byte*[1]
  let status = sqlitePrepare(database, bytes, length as Int32, statement, tail)

  if status != (0 as Int32)
    let error = sqliteWriteFailure(database, status, "prepare")
    let partial: Void*? = statement[0]

    if partial != null
      sqliteFinalize(partial)
    end
    native::free(bytes)
    return SQLiteSetStep.Failure(error)
  end
  let prepared: Void*? = statement[0]

  if prepared == null
    native::free(bytes)
    return SQLiteSetStep.Failure(WriteFailure.Validation("SQLite set plan has no statement"))
  end
  let trailing = tail[0]

  if trailing[0] != (0 as Byte)
    sqliteFinalize(prepared)
    native::free(bytes)
    return SQLiteSetStep.Failure(WriteFailure.Validation("SQLite set plan contains trailing SQL"))
  end
  native::free(bytes)
  if sqliteReadOnly(prepared) != (0 as Int32) || sqliteColumnCount(prepared) != (0 as Int32)
    sqliteFinalize(prepared)
    return SQLiteSetStep.Failure(WriteFailure.Validation("SQLite set plan must be a write without result columns"))
  end
  if sqliteParameterCount(prepared) != (plan.parameters().count() as Int32)
    sqliteFinalize(prepared)
    return SQLiteSetStep.Failure(WriteFailure.Validation("SQLite set parameter count mismatch"))
  end
  let bound = bindWriteValues(database, prepared, plan.parameters())

  match bound
    case SQLiteWriteBindResult.Failure(error, buffers)
      sqliteFinalize(prepared)
      freeBuffers(buffers)
      return SQLiteSetStep.Failure(error)
    case SQLiteWriteBindResult.Bound(buffers)
      let stepped = sqliteStep(prepared)
      var failure: WriteFailure? = null

      if stepped != (101 as Int32)
        failure = stepped == (100 as Int32) ? WriteFailure.Validation("SQLite set plan returned rows") : sqliteWriteFailure(database, stepped, "step")
      end
      let changed = failure == null ? sqliteChanges(database) : 0
      let finalized = sqliteFinalize(prepared)

      freeBuffers(buffers)
      if failure != null
        return SQLiteSetStep.Failure(failure)
      end
      if finalized != (0 as Int32)
        return SQLiteSetStep.Failure(WriteFailure.Provider("SQLite set finalize failed: " + ((finalized as Int) as String)))
      end
      if changed < 0
        return SQLiteSetStep.Failure(WriteFailure.Provider("SQLite set affected row count is negative"))
      end
      return SQLiteSetStep.Success(changed)
  end
end

def sqliteReturningNameSame(left: String, right: String): Bool
  if host::stringByteLength(left) != host::stringByteLength(right)
    return false
  end
  var index = 0

  while index < host::stringByteLength(left)
    var first = host::stringByteAt(left, index) as Int
    var second = host::stringByteAt(right, index) as Int

    first = first + 32 if first >= 65 && first <= 90
    second = second + 32 if second >= 65 && second <= 90
    if first != second
      return false
    end
    index = index + 1
  end
  return true
end

def sqliteReturningMetadata(columns: readonly ResultColumns): String?
  if columns.count() < 1 || columns.count() > 1000
    return "SQLite returning output requires 1 through 1000 columns"
  end
  var index = 0

  while index < columns.count()
    let name = columns.at(index).name()
    let length = host::stringByteLength(name)

    if length < 1 || length > 2147483646
      return "SQLite returning column name has invalid length"
    end
    var offset = 0

    while offset < length
      if host::stringByteAt(name, offset) == (0 as Byte)
        return "SQLite returning column name contains NUL"
      end
      offset = offset + 1
    end
    var previous = 0

    while previous < index
      if sqliteReturningNameSame(columns.at(previous).name(), name)
        return "SQLite returning column names must be distinct"
      end
      previous = previous + 1
    end
    index = index + 1
  end
  return null
end

unsafe def executeWriteCommand(database: Void*, command: readonly WriteCommand): SQLiteWriteStep
  let sql = command.sql()
  let length = host::stringByteLength(sql)
  let returning = command.returningColumns()

  if returning != null
    let invalid = sqliteReturningMetadata(returning)

    if invalid != null
      return SQLiteWriteStep.Failure(WriteFailure.Validation(invalid))
    end
  end

  if length == 0 || length > 2147483646
    return SQLiteWriteStep.Failure(WriteFailure.Validation("invalid SQLite write SQL length"))
  end
  var index = 0

  while index < length
    if host::stringByteAt(sql, index) == (0 as Byte)
      return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write SQL contains NUL"))
    end
    index = index + 1
  end
  if command.expectedRows() != 1
    return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write command must affect one row"))
  end
  let bytes = native::alloc<Byte>(length + 1)

  index = 0

  while index < length
    bytes[index] = host::stringByteAt(sql, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  let statement = stackalloc Void*[1]
  let tail = stackalloc Byte*[1]
  let status = sqlitePrepare(database, bytes, length as Int32, statement, tail)

  if status != (0 as Int32)
    let error = sqliteWriteFailure(database, status, "prepare")
    let partial: Void*? = statement[0]

    if partial != null
      sqliteFinalize(partial)
    end
    native::free(bytes)
    return SQLiteWriteStep.Failure(error)
  end
  let prepared: Void*? = statement[0]

  if prepared == null
    native::free(bytes)
    return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write plan has no statement"))
  end
  let trailing = tail[0]

  if trailing[0] != (0 as Byte)
    sqliteFinalize(prepared)
    native::free(bytes)
    return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write plan contains trailing SQL"))
  end
  native::free(bytes)
  var expectedColumns = 0

  if returning != null
    expectedColumns = returning.count()
  end
  if sqliteReadOnly(prepared) != (0 as Int32) || sqliteColumnCount(prepared) != (expectedColumns as Int32)
    sqliteFinalize(prepared)
    return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write command result columns do not match metadata"))
  end
  if sqliteParameterCount(prepared) != (command.parameters().count() as Int32)
    sqliteFinalize(prepared)
    return SQLiteWriteStep.Failure(WriteFailure.Validation("SQLite write parameter count mismatch"))
  end
  let bound = bindWriteValues(database, prepared, command.parameters())

  match bound
    case SQLiteWriteBindResult.Failure(error, buffers)
      sqliteFinalize(prepared)
      freeBuffers(buffers)
      return SQLiteWriteStep.Failure(error)
    case SQLiteWriteBindResult.Bound(buffers)
      let stepped = sqliteStep(prepared)
      var failure: WriteFailure? = null
      var row: RawRow? = null

      if returning != null
        # RETURNING rows are available through sqlite3_step only after SQLite
        # performs the mutation; the caller's transaction owns validation.
        # https://sqlite.org/lang_returning.html
        if stepped != (100 as Int32)
          failure = stepped == (101 as Int32) ? WriteFailure.Concurrency("SQLite returning write returned no row") : sqliteWriteFailure(database, stepped, "step")
        else
          var column = 0

          while column < returning.count()
            if !returning.at(column).nullable() && sqliteColumnType(prepared, column as Int32) == (5 as Int32)
              failure = WriteFailure.Provider("SQLite returning required column is NULL")
              break
            end
            column = column + 1
          end
          if failure == null
            match decodeSQLiteColumns(prepared, returning)
              case SQLiteColumnsResult.Failure(message)
                failure = WriteFailure.Provider(message)
              case SQLiteColumnsResult.Values(values)
                row = new RawRow(values)
            end
          end
          if failure == null
            let completed = sqliteStep(prepared)

            if completed != (101 as Int32)
              failure = completed == (100 as Int32) ? WriteFailure.Validation("SQLite returning write returned multiple rows") : sqliteWriteFailure(database, completed, "step")
            end
          end
        end
      else
        if stepped != (101 as Int32)
          failure = sqliteWriteFailure(database, stepped, "step")
        end
      end
      if failure == null
        let changed = sqliteChanges(database)

        if changed != command.expectedRows()
          failure = WriteFailure.Concurrency("SQLite write affected " + (changed as String) + " rows; expected " + (command.expectedRows() as String))
        end
      end
      let finalized = sqliteFinalize(prepared)

      freeBuffers(buffers)
      if failure != null
        return SQLiteWriteStep.Failure(failure)
      end
      if finalized != (0 as Int32)
        return SQLiteWriteStep.Failure(WriteFailure.Provider("SQLite write finalize failed: " + ((finalized as Int) as String)))
      end
      return SQLiteWriteStep.Success(row)
  end
end

unsafe def bindWriteValues(database: Void*, statement: Void*, values: readonly WriteValues): SQLiteWriteBindResult
  var buffers: SQLiteTextBufferNode? = null
  var current = values.first()
  var index = 1

  while current != null
    var status = 0 as Int32

    match current.value()
      case Cell.Null()
        status = sqliteBindNull(statement, index as Int32)
      case Cell.Bool(value)
        status = sqliteBindInt(statement, index as Int32, value ? 1 : 0)
      case Cell.Int(value)
        status = sqliteBindInt(statement, index as Int32, value)
      case Cell.Float(value)
        if !dataFloatFinite(value)
          return SQLiteWriteBindResult.Failure(WriteFailure.Validation("SQLite write float parameter must be finite"), buffers)
        end
        status = sqliteBindDouble(statement, index as Int32, value)
      case Cell.Text(value)
        let length = host::stringByteLength(value)

        if length > 2147483646
          return SQLiteWriteBindResult.Failure(WriteFailure.Validation("SQLite write text parameter is too long"), buffers)
        end
        var offset = 0

        while offset < length
          if host::stringByteAt(value, offset) == (0 as Byte)
            return SQLiteWriteBindResult.Failure(WriteFailure.Validation("SQLite write text parameter contains NUL"), buffers)
          end
          offset = offset + 1
        end
        let bytes = native::alloc<Byte>(length + 1)

        offset = 0
        while offset < length
          bytes[offset] = host::stringByteAt(value, offset)
          offset = offset + 1
        end
        bytes[length] = 0 as Byte
        let node = new SQLiteTextBufferNode()

        node.pointer = bytes
        node.next = buffers
        buffers = node
        status = sqliteBindText(statement, index as Int32, bytes, length as Int32, null)
    end
    if status != (0 as Int32)
      return SQLiteWriteBindResult.Failure(sqliteWriteFailure(database, status, "bind"), buffers)
    end
    current = current.next()
    index = index + 1
  end
  return SQLiteWriteBindResult.Bound(buffers)
end

enum SQLiteBindResult
  case Bound(buffers: SQLiteTextBufferNode?)
  case Failure(message: String, buffers: SQLiteTextBufferNode?)
end

class SQLiteTextBufferNode
  public pointer: Byte*?
  public next: SQLiteTextBufferNode?

  def init(): Void
  end
end

class SQLiteCollectedRows
  private values: RawColumn[][]

  def init(capacity: Int): Void
    this.values = tasks::generate(capacity, 1) do |index|
      let empty: RawColumn[] = []

      return empty
    end
  end

  def set(index: Int, value: RawColumn[]): Void
    this.values[index] = value
  end

  readonly def at(index: Int): RawRow
    let source = this.values[index]
    let columns: RawColumn[] = tasks::generate(source.Length, 1) do |position|
      let column = source[position]

      match column.value
        case Cell.Null()
          return new RawColumn(column.name, Cell.Null())
        case Cell.Bool(value)
          return new RawColumn(column.name, Cell.Bool(value))
        case Cell.Int(value)
          return new RawColumn(column.name, Cell.Int(value))
        case Cell.Float(value)
          return new RawColumn(column.name, Cell.Float(value))
        case Cell.Text(value)
          return new RawColumn(column.name, Cell.Text(value))
      end
    end

    return new RawRow(columns)
  end
end

unsafe def bindParameters(database: Void*, statement: Void*, parameters: readonly ParameterValues): SQLiteBindResult
  var buffers: SQLiteTextBufferNode? = null
  var current = parameters.first()
  var index = 1

  while current != null
    var status = 0 as Int32

    match current.value()
      case Parameter.Bool(value)
        status = sqliteBindInt(statement, index as Int32, value ? 1 : 0)
      case Parameter.Int(value)
        status = sqliteBindInt(statement, index as Int32, value)
      case Parameter.Float(value)
        if !dataFloatFinite(value)
          return SQLiteBindResult.Failure("SQLite float parameter must be finite", buffers)
        end
        status = sqliteBindDouble(statement, index as Int32, value)
      case Parameter.Text(value)
        let length = host::stringByteLength(value)

        if length > 2147483646
          return SQLiteBindResult.Failure("SQLite text parameter is too long", buffers)
        end
        var offset = 0

        while offset < length
          if host::stringByteAt(value, offset) == (0 as Byte)
            # SQLite leaves the meaning of expressions with embedded NUL undefined.
            # https://sqlite.org/c3ref/bind_blob.html
            return SQLiteBindResult.Failure("SQLite text parameter contains NUL", buffers)
          end
          offset = offset + 1
        end
        let bytes = native::alloc<Byte>(length + 1)

        offset = 0

        while offset < length
          bytes[offset] = host::stringByteAt(value, offset)
          offset = offset + 1
        end
        bytes[length] = 0 as Byte
        let node = new SQLiteTextBufferNode()

        node.pointer = bytes
        node.next = buffers
        buffers = node
        status = sqliteBindText(statement, index as Int32, bytes, length as Int32, null)
    end
    if status != (0 as Int32)
      let message = sqliteMessage(database)

      return SQLiteBindResult.Failure(message, buffers)
    end
    current = current.next()
    index = index + 1
  end
  return SQLiteBindResult.Bound(buffers)
end

unsafe def freeBuffers(buffers: SQLiteTextBufferNode?): Void
  var current = buffers

  while current != null
    let pointer = current.pointer

    if pointer != null
      current.pointer = null
      native::free(pointer)
    end
    current = current.next
  end
end

unsafe def sqliteMessage(database: Void*): String
  let pointer = sqliteError(database)
  var length = 0

  while length < 4096 && pointer[length] != (0 as Byte)
    length = length + 1
  end
  let bytes = copyBytes(pointer, length)
  let message = host::stringFromBytes(bytes)

  if message == null
    return "SQLite error"
  end
  return message
end

unsafe def copyBytes(pointer: Byte*, length: Int): Byte[]
  let bytes: Byte[] = tasks::generate(length, 1) do |index|
    return 0 as Byte
  end
  var index = 0

  while index < length
    bytes[index] = pointer[index]
    index = index + 1
  end
  return bytes
end

enum SQLiteColumnsResult
  case Values(columns: RawColumn[])
  case Failure(message: String)
end

unsafe def decodeSQLiteColumns(statement: Void*, columns: readonly ResultColumns): SQLiteColumnsResult
  let columnCount = columns.count()
  var values: RawColumn[] = tasks::generate(columnCount, 1) do |index|
    return new RawColumn("", Cell.Null())
  end
  var index = 0

  while index < columnCount
    let expected = columns.at(index)
    let namePointer = sqliteColumnName(statement, index as Int32)

    if namePointer == null
      return SQLiteColumnsResult.Failure("SQLite result column name unavailable")
    end
    let name = sqliteText(namePointer, -1)

    if name == null || name != expected.name()
      return SQLiteColumnsResult.Failure("SQLite result column mismatch")
    end
    let kind = sqliteColumnType(statement, index as Int32)
    var cell = Cell.Null()

    if kind == (5 as Int32)
      cell = Cell.Null()
    else
      match expected.kind()
        case ResultColumnKind.Bool()
          if kind != (1 as Int32)
            return SQLiteColumnsResult.Failure("SQLite boolean column has wrong type")
          end
          let value = sqliteColumnInt(statement, index as Int32)

          if value != 0 && value != 1
            return SQLiteColumnsResult.Failure("SQLite boolean column is not 0 or 1")
          end
          cell = Cell.Bool(value == 1)
        case ResultColumnKind.Int()
          if kind != (1 as Int32)
            return SQLiteColumnsResult.Failure("SQLite integer column has wrong type")
          end
          cell = Cell.Int(sqliteColumnInt(statement, index as Int32))
        case ResultColumnKind.Float()
          if kind != (2 as Int32)
            return SQLiteColumnsResult.Failure("SQLite float column has wrong type")
          end
          let value = sqliteColumnDouble(statement, index as Int32)

          if !dataFloatFinite(value)
            return SQLiteColumnsResult.Failure("SQLite float column must be finite")
          end
          cell = Cell.Float(value)
        case ResultColumnKind.Text()
          if kind != (3 as Int32)
            return SQLiteColumnsResult.Failure("SQLite text column has wrong type")
          end
          let pointer = sqliteColumnText(statement, index as Int32)

          if pointer == null
            return SQLiteColumnsResult.Failure("SQLite text column unavailable")
          end
          let length = sqliteColumnBytes(statement, index as Int32) as Int
          # SQLite's column pointer may expire on step/finalize; copy it now.
          # https://sqlite.org/c3ref/column_blob.html
          let text = sqliteText(pointer, length)

          if text == null
            return SQLiteColumnsResult.Failure("SQLite text column is invalid UTF-8")
          end
          cell = Cell.Text(text)
      end
    end
    values[index] = new RawColumn(name, cell)
    index = index + 1
  end
  return SQLiteColumnsResult.Values(values)
end

unsafe def readRows(database: Void*, statement: Void*, plan: readonly SqlPlan): ProviderResult
  let columns = plan.columns()

  if sqliteColumnCount(statement) as Int != columns.count()
    return ProviderResult.Failure("SQLite result column count mismatch")
  end
  let rows = new SQLiteCollectedRows(plan.limit())
  var rowCount = 0
  var step = sqliteStep(statement)

  while step == (100 as Int32)
    if rowCount >= plan.limit()
      return ProviderResult.Failure("SQLite result exceeds row limit")
    end
    match decodeSQLiteColumns(statement, columns)
      case SQLiteColumnsResult.Failure(message)
        return ProviderResult.Failure(message)
      case SQLiteColumnsResult.Values(values)
        rows.set(rowCount, values)
    end
    rowCount = rowCount + 1
    step = sqliteStep(statement)
  end
  if step != (101 as Int32)
    return ProviderResult.Failure(sqliteMessage(database))
  end
  let complete: RawRow[] = tasks::generate(rowCount, 1) do |index|
    return rows.at(index)
  end

  return ProviderResult.Rows(complete)
end

unsafe def sqliteText(pointer: Byte*, length: Int): String?
  var count = length

  if count < 0
    count = 0

    while count < 4096 && pointer[count] != (0 as Byte)
      count = count + 1
    end
    if count == 4096
      return null
    end
  end
  return host::stringFromBytes(copyBytes(pointer, count))
end
