use host
use tasks
use neri_data
namespace neri_data_sqlite

@library("sqlite3")
@cabiImport("sqlite3_open_v2")
unsafe def sqliteOpen(path: Byte*, database: Void**, flags: Int32, vfs: Byte*?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_close")
unsafe def sqliteClose(database: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_db_readonly")
unsafe def sqliteDatabaseReadOnly(database: Void*, name: Byte*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_exec")
unsafe def sqliteExec(database: Void*, sql: Byte*, callback: (cabi fn(Void*, Int32, Void**, Void**): Int32)?, argument: Void*?, message: Byte**?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_get_autocommit")
unsafe def sqliteAutoCommit(database: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_changes64")
unsafe def sqliteChanges(database: Void*): Int
end

@library("sqlite3")
@cabiImport("sqlite3_libversion_number")
unsafe def sqliteVersionNumber(): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_errmsg")
unsafe def sqliteError(database: Void*): Byte*
end

@library("sqlite3")
@cabiImport("sqlite3_extended_errcode")
unsafe def sqliteExtendedError(database: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_prepare_v2")
unsafe def sqlitePrepare(database: Void*, sql: Byte*, length: Int32, statement: Void**, tail: Byte**?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_finalize")
unsafe def sqliteFinalize(statement: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_stmt_readonly")
unsafe def sqliteReadOnly(statement: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_bind_parameter_count")
unsafe def sqliteParameterCount(statement: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_bind_int64")
unsafe def sqliteBindInt(statement: Void*, index: Int32, value: Int): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_bind_double")
unsafe def sqliteBindDouble(statement: Void*, index: Int32, value: Float): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_bind_null")
unsafe def sqliteBindNull(statement: Void*, index: Int32): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_bind_text")
unsafe def sqliteBindText(statement: Void*, index: Int32, value: Byte*, length: Int32, destructor: (cabi fn(Void*): Void)?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_step")
unsafe def sqliteStep(statement: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_column_count")
unsafe def sqliteColumnCount(statement: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_column_name")
unsafe def sqliteColumnName(statement: Void*, index: Int32): Byte*?
end

@library("sqlite3")
@cabiImport("sqlite3_column_type")
