use resources
use result
use test
use console
use neri_data_sqlite
use neri_data_sqlite_fixture

def inspectColumns(provider: SQLiteProvider): Void
  match provider.inspectSchema()
    case SQLiteSchemaResult.Failure(message)
      console::println(neri_data::providerFailureMessage(message))

      test::assertTrue(false)
    case SQLiteSchemaResult.Snapshot(snapshot)
      test::assertEqual(snapshot.count(), 8)
      test::assertEqual(snapshot.indexCount(), 1)
      test::assertTrue(snapshot.at(-1) == null)
      test::assertTrue(snapshot.at(8) == null)

      let id = snapshot.at(0)
      let name = snapshot.at(1)
      let nickname = snapshot.at(2)
      let computed = snapshot.at(3)

      test::assertTrue(id != null && name != null && nickname != null && computed != null)

      if id != null && name != null && nickname != null && computed != null
        test::assertEqual(id.table(), "people")
        test::assertEqual(id.name(), "id")
        test::assertEqual(id.declaredType(), "INTEGER")
        test::assertEqual(id.keyPosition(), 1)
        test::assertTrue(id.rowidKey())
        test::assertTrue(id.keyRequired())
        test::assertTrue(id.createSql() != "")
        test::assertEqual(name.name(), "name")
        test::assertTrue(name.required())
        let defaultSql = name.defaultSql()

        test::assertTrue(defaultSql != null)

        if defaultSql != null
          test::assertEqual(defaultSql, "'O''Reilly'")
        end

        test::assertTrue(!nickname.required())
        test::assertTrue(nickname.defaultSql() == null)
        test::assertEqual(computed.hidden(), 2)
      end
      let view = snapshot.at(4)

      test::assertTrue(view != null && view.view())
  end
  match provider.scaffoldSchema()
    case neri_data::SchemaScaffoldResult.Failure(error)
      test::assertTrue(false)
    case neri_data::SchemaScaffoldResult.Source(source, mapping)
      test::assertTrue(source.contains("class Entity_people"))
      test::assertTrue(source.contains("public field_id: Int = 0"))
      test::assertTrue(source.contains("public field_nickname: String? = null"))
      test::assertTrue(mapping.contains("\"keyGeneration\":\"onAdd\""))
      test::assertTrue(mapping.contains("\"valueGeneration\":\"onAddOrUpdate\""))
      test::assertTrue(mapping.contains("\"computedSql\":\"name || nickname\""))
      test::assertTrue(mapping.contains("\"computedStored\":false"))
      test::assertTrue(mapping.contains("\"collation\":\"NOCASE\""))
      test::assertTrue(mapping.contains("\"checkSql\":\"length(nickname)<100\""))
      test::assertTrue(mapping.contains("\"expressions\":[\"lower(name)\"]"))
      test::assertTrue(mapping.contains("\"descending\":[true]"))
      test::assertTrue(mapping.contains("\"predicate\":\"nickname IS NOT NULL\""))
      test::assertTrue(mapping.contains("\"view\":\"visible_people\",\"keyless\":true"))
  end
end

def verifyInspection(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-schema-inspection-")
    let path = temporary.path() + "/schema.sqlite"
    let created = createSQLiteFixture(
      path,
      "CREATE TABLE people(id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'O''Reilly', nickname TEXT COLLATE NOCASE CHECK(length(nickname)<100), display TEXT GENERATED ALWAYS AS (name || nickname) VIRTUAL); CREATE TABLE __neri_migrations(id TEXT); CREATE VIEW visible_people AS SELECT * FROM people; CREATE INDEX people_expression ON people(lower(name) DESC) WHERE nickname IS NOT NULL;"
    )

    test::assertTrue(created)

    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        console::println(neri_data::providerFailureMessage(message))

        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        inspectColumns(provider)

        test::assertTrue(provider.close())

        match provider.inspectSchema()
          case SQLiteSchemaResult.Snapshot(snapshot)
            test::assertTrue(false)
          case SQLiteSchemaResult.Failure(message)
            test::assertTrue(neri_data::providerFailureMessage(message) != "")
        end
    end
    let relationPath = temporary.path() + "/relations.sqlite"

    test::assertTrue(createSQLiteFixture(
        relationPath,
        "CREATE TABLE parents(id INTEGER PRIMARY KEY,code TEXT NOT NULL UNIQUE); CREATE TABLE children(id INTEGER PRIMARY KEY,parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE DEFERRABLE INITIALLY DEFERRED)"
      ))
    match SQLiteProvider.open(relationPath)
      case SQLiteOpenResult.Failure(error)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        match provider.inspectSchema()
          case SQLiteSchemaResult.Failure(error)
            test::assertTrue(false)
          case SQLiteSchemaResult.Snapshot(snapshot)
            test::assertEqual(snapshot.referenceCount(), 1)
            test::assertEqual(snapshot.indexCount(), 1)
        end
        match provider.scaffoldSchema()
          case neri_data::SchemaScaffoldResult.Failure(error)
            test::assertTrue(false)
          case neri_data::SchemaScaffoldResult.Source(source, mapping)
            test::assertTrue(mapping.contains("\"foreignKey\":[\"field_parent_5f_id\"]"))
            test::assertTrue(mapping.contains("\"databaseOnDelete\":\"CASCADE\""))
            test::assertTrue(mapping.contains("\"deferred\":true"))
            test::assertTrue(mapping.contains("\"unique\":true"))
        end

        test::assertTrue(provider.close())
    end
    let emptyPath = temporary.path() + "/empty.sqlite"

    match SQLiteProvider.createWritable(emptyPath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        match provider.inspectSchema()
          case SQLiteSchemaResult.Failure(message)
            test::assertTrue(false)
          case SQLiteSchemaResult.Snapshot(snapshot)
            test::assertEqual(snapshot.count(), 0)
        end

        test::assertTrue(provider.close())
    end
    var schema = "CREATE TABLE wide("
    var index = 0

    while index < 1001
      schema = schema + (index == 0 ? "" : ", ") + "column_" + (index as String) + " INTEGER"
      index = index + 1
    end
    schema = schema + ")"
    let widePath = temporary.path() + "/wide.sqlite"
    let wideCreated = createSQLiteFixture(widePath, schema)

    test::assertTrue(wideCreated)

    match SQLiteProvider.open(widePath)
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        match provider.inspectSchema()
          case SQLiteSchemaResult.Snapshot(snapshot)
            test::assertTrue(false)
          case SQLiteSchemaResult.Failure(message)
            test::assertEqual(
              neri_data::providerFailureMessage(message),
              "SQLite schema exceeds the 1000-column inspection limit"
            )
        end

        test::assertTrue(provider.close())
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyInspection()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
