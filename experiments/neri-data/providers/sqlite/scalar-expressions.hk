use host
use neri_data
namespace neri_data_sqlite

@library("sqlite3")
@cabiImport("sqlite3_create_function_v2")
unsafe def sqliteCreateScalar(database: Void*, name: Byte*, arity: Int32, flags: Int32, state: Void*?, callback: (cabi fn(Void*, Int32, Void**): Void)?, step: (cabi fn(Void*, Int32, Void**): Void)?, finish: (cabi fn(Void*): Void)?, destroy: (cabi fn(Void*): Void)?): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_value_type")
unsafe def sqliteScalarType(value: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_value_int64")
unsafe def sqliteScalarInt(value: Void*): Int
end

@library("sqlite3")
@cabiImport("sqlite3_value_double")
unsafe def sqliteScalarFloat(value: Void*): Float
end

@library("sqlite3")
@cabiImport("sqlite3_value_text")
unsafe def sqliteScalarText(value: Void*): Byte*?
end

@library("sqlite3")
@cabiImport("sqlite3_value_bytes")
unsafe def sqliteScalarBytes(value: Void*): Int32
end

@library("sqlite3")
@cabiImport("sqlite3_result_int64")
unsafe def sqliteScalarResultInt(context: Void*, value: Int): Void
end

@library("sqlite3")
@cabiImport("sqlite3_result_double")
unsafe def sqliteScalarResultFloat(context: Void*, value: Float): Void
end

@library("sqlite3")
@cabiImport("sqlite3_result_text")
unsafe def sqliteScalarResultText(context: Void*, value: Byte*, length: Int32, destroy: (cabi fn(Void*): Void)?): Void
end

@library("sqlite3")
@cabiImport("sqlite3_result_error")
unsafe def sqliteScalarResultError(context: Void*, message: Byte*, length: Int32): Void
end

@library("sqlite3")
@cabiImport("sqlite3_result_value")
unsafe def sqliteScalarResultValue(context: Void*, value: Void*): Void
end

unsafe def sqliteScalarFailure(context: Void*, message: String): Void
  let length = host::stringByteLength(message)
  let bytes = native::alloc<Byte>(length + 1)
  var index = 0

  while index < length
    bytes[index] = host::stringByteAt(message, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  sqliteScalarResultError(context, bytes, length as Int32)
  native::free(bytes)
end

unsafe def sqliteIntBinary(context: Void*, count: Int32, values: Void**, operation: Int): Void
  if count != (2 as Int32) || sqliteScalarType(values[0]) != (1 as Int32) || sqliteScalarType(values[1]) != (1 as Int32)
    sqliteScalarFailure(context, "checked Int expression requires INTEGER operands")
    return
  end
  let left = sqliteScalarInt(values[0])
  let right = sqliteScalarInt(values[1])
  let maximum = 9223372036854775807
  let minimum = -9223372036854775808

  if operation == 1
    if (right > 0 && left > maximum - right) || (right < 0 && left < minimum - right)
      sqliteScalarFailure(context, "checked Int addition overflow")
      return
    end
    sqliteScalarResultInt(context, left + right)
    return
  end
  if operation == 2
    if (right < 0 && left > maximum + right) || (right > 0 && left < minimum + right)
      sqliteScalarFailure(context, "checked Int subtraction overflow")
      return
    end
    sqliteScalarResultInt(context, left - right)
    return
  end
  if operation == 3
    if left == 0 || right == 0
      sqliteScalarResultInt(context, 0)
      return
    end
    if (left == minimum && right == -1) || (right == minimum && left == -1)
      sqliteScalarFailure(context, "checked Int multiplication overflow")
      return
    end
    let positiveOverflow = left > 0 && right > 0 && left > maximum / right
    let mixedPositiveOverflow = left > 0 && right < 0 && right < minimum / left
    let mixedNegativeOverflow = left < 0 && right > 0 && left < minimum / right
    let negativeOverflow = left < 0 && right < 0 && left < maximum / right

    if positiveOverflow || mixedPositiveOverflow || mixedNegativeOverflow || negativeOverflow
      sqliteScalarFailure(context, "checked Int multiplication overflow")
      return
    end
    sqliteScalarResultInt(context, left * right)
    return
  end
  if right == 0 || (left == minimum && right == -1)
    sqliteScalarFailure(context, "checked Int division is undefined")
    return
  end
  sqliteScalarResultInt(context, left / right)
end

unsafe def sqliteIntUnary(context: Void*, count: Int32, values: Void**): Void
  if count != (1 as Int32) || sqliteScalarType(values[0]) != (1 as Int32)
    sqliteScalarFailure(context, "checked Int expression requires INTEGER operand")
    return
  end
  let value = sqliteScalarInt(values[0])

  if value == -9223372036854775808
    sqliteScalarFailure(context, "checked Int negation overflow")
    return
  end
  sqliteScalarResultInt(context, -value)
end

unsafe def sqliteFloatBinary(context: Void*, count: Int32, values: Void**, operation: Int): Void
  if count != (2 as Int32) || sqliteScalarType(values[0]) != (2 as Int32) || sqliteScalarType(values[1]) != (2 as Int32)
    sqliteScalarFailure(context, "checked Float expression requires REAL operands")
    return
  end
  let left = sqliteScalarFloat(values[0])
  let right = sqliteScalarFloat(values[1])

  if !neri_data::dataFloatFinite(left) || !neri_data::dataFloatFinite(right) || (operation == 4 && right == 0.0)
    sqliteScalarFailure(context, "checked Float expression has a non-finite operand or zero divisor")
    return
  end
  var value = 0.0

  if operation == 1
    value = left + right
  else if operation == 2
    value = left - right
  else if operation == 3
    value = left * right
  else
    value = left / right
  end
  if !neri_data::dataFloatFinite(value)
    sqliteScalarFailure(context, "checked Float expression produced a non-finite result")
    return
  end
  sqliteScalarResultFloat(context, value)
end

unsafe def sqliteFloatUnary(context: Void*, count: Int32, values: Void**): Void
  if count != (1 as Int32) || sqliteScalarType(values[0]) != (2 as Int32)
    sqliteScalarFailure(context, "checked Float expression requires REAL operand")
    return
  end
  let operand = sqliteScalarFloat(values[0])

  if !neri_data::dataFloatFinite(operand)
    sqliteScalarFailure(context, "checked Float expression requires finite input")
    return
  end
  sqliteScalarResultFloat(context, -operand)
end

unsafe def sqliteValidateValue(context: Void*, count: Int32, values: Void**, kind: Int): Void
  if count != (2 as Int32) || sqliteScalarType(values[1]) != (1 as Int32)
    sqliteScalarFailure(context, "checked value requires an INTEGER nullable flag")
    return
  end
  let nullable = sqliteScalarInt(values[1])

  if nullable != 0 && nullable != 1
    sqliteScalarFailure(context, "checked value nullable flag must be zero or one")
    return
  end
  let storage = sqliteScalarType(values[0])

  if storage == (5 as Int32)
    if nullable == 0
      sqliteScalarFailure(context, "required computed value is NULL")
      return
    end
    sqliteScalarResultValue(context, values[0])
    return
  end
  if kind == 1
    if storage != (1 as Int32)
      sqliteScalarFailure(context, "computed Int value must be INTEGER")
      return
    end
  else if kind == 2
    if storage != (2 as Int32)
      sqliteScalarFailure(context, "computed Float value must be REAL")
      return
    end
    if !neri_data::dataFloatFinite(sqliteScalarFloat(values[0]))
      sqliteScalarFailure(context, "computed Float value must be finite")
      return
    end
  else if kind == 3
    if storage != (1 as Int32)
      sqliteScalarFailure(context, "computed Bool value must be INTEGER")
      return
    end
    let boolean = sqliteScalarInt(values[0])

    if boolean != 0 && boolean != 1
      sqliteScalarFailure(context, "computed Bool value must be zero or one")
      return
    end
  else if storage != (3 as Int32)
    sqliteScalarFailure(context, "computed String value must be TEXT")
    return
  end
  sqliteScalarResultValue(context, values[0])
end

@cabiExport("app_sqlite_scalar_text_free")
unsafe def sqliteScalarTextFree(value: Void*): Void
  native::free(value as Byte*)
end

@cabiExport("app_sqlite_text_concat")
unsafe def sqliteTextConcat(context: Void*, count: Int32, values: Void**): Void
  if count != (2 as Int32) || sqliteScalarType(values[0]) != (3 as Int32) || sqliteScalarType(values[1]) != (3 as Int32)
    sqliteScalarFailure(context, "checked String concatenation requires TEXT operands")
    return
  end
  let left = sqliteScalarText(values[0])
  let right = sqliteScalarText(values[1])

  if left == null || right == null
    sqliteScalarFailure(context, "checked String concatenation could not read TEXT operands")
    return
  end
  let leftLength = sqliteScalarBytes(values[0]) as Int
  let rightLength = sqliteScalarBytes(values[1]) as Int

  if leftLength < 0 || rightLength < 0 || leftLength > 2147483646 - rightLength
    sqliteScalarFailure(context, "checked String concatenation exceeds SQLite text limit")
    return
  end
  let total = leftLength + rightLength
  let result = native::alloc<Byte>(total + 1)
  var index = 0

  while index < leftLength
    result[index] = left[index]
    index = index + 1
  end
  index = 0
  while index < rightLength
    result[leftLength + index] = right[index]
    index = index + 1
  end
  result[total] = 0 as Byte
  sqliteScalarResultText(context, result, total as Int32, sqliteScalarTextFree)
end

@cabiExport("app_sqlite_int_add")
unsafe def sqliteIntAdd(context: Void*, count: Int32, values: Void**): Void
  sqliteIntBinary(context, count, values, 1)
end

@cabiExport("app_sqlite_int_subtract")
unsafe def sqliteIntSubtract(context: Void*, count: Int32, values: Void**): Void
  sqliteIntBinary(context, count, values, 2)
end

@cabiExport("app_sqlite_int_multiply")
unsafe def sqliteIntMultiply(context: Void*, count: Int32, values: Void**): Void
  sqliteIntBinary(context, count, values, 3)
end

@cabiExport("app_sqlite_int_divide")
unsafe def sqliteIntDivide(context: Void*, count: Int32, values: Void**): Void
  sqliteIntBinary(context, count, values, 4)
end

@cabiExport("app_sqlite_int_negate")
unsafe def sqliteIntNegate(context: Void*, count: Int32, values: Void**): Void
  sqliteIntUnary(context, count, values)
end

@cabiExport("app_sqlite_float_add")
unsafe def sqliteFloatAdd(context: Void*, count: Int32, values: Void**): Void
  sqliteFloatBinary(context, count, values, 1)
end

@cabiExport("app_sqlite_float_subtract")
unsafe def sqliteFloatSubtract(context: Void*, count: Int32, values: Void**): Void
  sqliteFloatBinary(context, count, values, 2)
end

@cabiExport("app_sqlite_float_multiply")
unsafe def sqliteFloatMultiply(context: Void*, count: Int32, values: Void**): Void
  sqliteFloatBinary(context, count, values, 3)
end

@cabiExport("app_sqlite_float_divide")
unsafe def sqliteFloatDivide(context: Void*, count: Int32, values: Void**): Void
  sqliteFloatBinary(context, count, values, 4)
end

@cabiExport("app_sqlite_float_negate")
unsafe def sqliteFloatNegate(context: Void*, count: Int32, values: Void**): Void
  sqliteFloatUnary(context, count, values)
end

@cabiExport("app_sqlite_value_int")
unsafe def sqliteValueInt(context: Void*, count: Int32, values: Void**): Void
  sqliteValidateValue(context, count, values, 1)
end

@cabiExport("app_sqlite_value_float")
unsafe def sqliteValueFloat(context: Void*, count: Int32, values: Void**): Void
  sqliteValidateValue(context, count, values, 2)
end

@cabiExport("app_sqlite_value_bool")
unsafe def sqliteValueBool(context: Void*, count: Int32, values: Void**): Void
  sqliteValidateValue(context, count, values, 3)
end

@cabiExport("app_sqlite_value_text")
unsafe def sqliteValueText(context: Void*, count: Int32, values: Void**): Void
  sqliteValidateValue(context, count, values, 4)
end

unsafe def sqliteRegisterScalar(database: Void*, name: String, arity: Int32, callback: cabi fn(Void*, Int32, Void**): Void): Bool
  let length = host::stringByteLength(name)
  let bytes = native::alloc<Byte>(length + 1)
  var index = 0

  while index < length
    bytes[index] = host::stringByteAt(name, index)
    index = index + 1
  end
  bytes[length] = 0 as Byte
  # SQLITE_UTF8 | SQLITE_DETERMINISTIC | SQLITE_DIRECTONLY.
  let status = sqliteCreateScalar(database, bytes, arity, 526337 as Int32, null, callback, null, null, null)

  native::free(bytes)
  return status == (0 as Int32)
end

unsafe def sqliteRegisterCheckedScalars(database: Void*): Bool
  if !sqliteRegisterScalar(database, "__neri_int_add", 2 as Int32, sqliteIntAdd)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_int_subtract", 2 as Int32, sqliteIntSubtract)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_int_multiply", 2 as Int32, sqliteIntMultiply)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_int_divide", 2 as Int32, sqliteIntDivide)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_int_negate", 1 as Int32, sqliteIntNegate)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_float_add", 2 as Int32, sqliteFloatAdd)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_float_subtract", 2 as Int32, sqliteFloatSubtract)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_float_multiply", 2 as Int32, sqliteFloatMultiply)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_float_divide", 2 as Int32, sqliteFloatDivide)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_float_negate", 1 as Int32, sqliteFloatNegate)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_text_concat", 2 as Int32, sqliteTextConcat)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_value_int", 2 as Int32, sqliteValueInt)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_value_float", 2 as Int32, sqliteValueFloat)
    return false
  end
  if !sqliteRegisterScalar(database, "__neri_value_bool", 2 as Int32, sqliteValueBool)
    return false
  end
  return sqliteRegisterScalar(database, "__neri_value_text", 2 as Int32, sqliteValueText)
end
