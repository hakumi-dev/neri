use clock
use result
namespace neri_data

def navigationArray<T>(rows: TypedRows<T>): T[]
  let first = rows.first()

  if first == null
    return []
  end
  return arrays::generate<T>(rows.count()) do |index|
    var current = first
    var position = 0

    while position < index && current.next != null
      current = current.next
      position = position + 1
    end
    return current.value
  end
end

## A skip navigation backed by an explicitly mapped join entity.
class ManyToManyNavigation<L, J, R>
  private leftJoin: CollectionNavigation<L, J>
  private rightJoin: CollectionNavigation<R, J>
  private leftGetter: fn(L): R[]
  private leftSetter: fn(L, R[]): Void
  private rightGetter: fn(R): L[]
  private rightSetter: fn(R, L[]): Void
  private joinFactory: fn(L, R): J
  private graphEnrollment: (fn(J): QueryFailure?)?

  def init(
    leftJoin: CollectionNavigation<L, J>,
    rightJoin: CollectionNavigation<R, J>,
    getLeft: fn(L): R[],
    setLeft: fn(L, R[]): Void,
    getRight: fn(R): L[],
    setRight: fn(R, L[]): Void,
    createJoin: fn(L, R): J,
    enrollGraph: (fn(J): QueryFailure?)? = null
  ): Void
    this.leftJoin = leftJoin
    this.rightJoin = rightJoin
    this.leftGetter = getLeft
    this.leftSetter = setLeft
    this.rightGetter = getRight
    this.rightSetter = setRight
    this.joinFactory = createJoin
    this.graphEnrollment = enrollGraph
  end

  ## Registers reversible collection-difference inference before tracked saves.
  public def step(lefts: Query<L>, joins: Query<J>, rights: Query<R>, maximum: Int = 10000): NavigationStep<L, R>
    let first = collectionStep(lefts, joins, this.leftJoin, maximum)
    let second = referenceStep(joins, rights, this.rightJoin)
    let check: fn(Bool): QueryFailure? = fn(asynchronous: Bool): QueryFailure? do
      let invalid = first.validate(asynchronous)

      return invalid == null ? second.validate(asynchronous) : invalid
    end
    let checkpoint: fn(NavigationJournal): Void = fn(journal: NavigationJournal): Void do
      this.checkpoint(lefts, joins, rights, new TypedRows<L>(), new TypedRows<J>(), journal)
    end
    let run: fn(
      TypedRows<L>,
      NavigationJournal
    ): QueryResult<R> = fn(
      rows: TypedRows<L>,
      journal: NavigationJournal
    ): QueryResult<R> do
      match first.run(rows, journal)
        case QueryResult.Failure(error)
          return QueryResult<R>.Failure(error)
        case QueryResult.Rows(related)
          match second.run(related, journal)
            case QueryResult.Failure(error)
              return QueryResult<R>.Failure(error)
            case QueryResult.Rows(targets)
              this.publish(rows, targets, journal)
              return QueryResult<R>.Rows(targets)
          end
      end
    end
    let runAsync: fn(
      TypedRows<L>,
      NavigationJournal,
      StreamOptions?
    ): AsyncLoadDriver<R> = fn(
      rows: TypedRows<L>,
      journal: NavigationJournal,
      options: StreamOptions?
    ): AsyncLoadDriver<R> do
      let next: fn(TypedRows<J>): AsyncLoadDriver<R> = fn(related: TypedRows<J>): AsyncLoadDriver<R> do
        return second.runAsync(related, journal, options)
      end
      let publish: fn(QueryResult<R>): QueryResult<R> = fn(result: QueryResult<R>): QueryResult<R> do
        match result
          case QueryResult.Failure(error)
            return QueryResult<R>.Failure(error)
          case QueryResult.Rows(targets)
            this.publish(rows, targets, journal)
            return QueryResult<R>.Rows(targets)
        end
      end

      return new AsyncMapLoad<R, R>(new AsyncThenLoad<J, R>(first.runAsync(rows, journal, options), next), publish)
    end

    let single: fn(
      SingleNavigationScope,
      SingleNavigationRows<L>
    ): SingleNavigationRows<R> = fn(
      scope: SingleNavigationScope,
      input: SingleNavigationRows<L>
    ): SingleNavigationRows<R> do
      let joinRows = first.contributeSingle(scope, input)
      let rightRows = second.contributeSingle(scope, joinRows)
      let publish: fn(NavigationJournal): Void = fn(journal: NavigationJournal): Void do
        this.checkpoint(lefts, joins, rights, input.rows, joinRows.rows, journal)
        this.publish(input.rows, rightRows.rows, journal)
      end

      scope.afterPublication(publish)
      return rightRows
    end

    return new NavigationStep<L, R>(
      run,
      check,
      lefts.provider(),
      lefts.changeOwner(),
      lefts.rowTracker(),
      rights.rowTracker(),
      checkpoint,
      runAsync,
      singleContributor: single
    )
  end

  public def inverseStep(lefts: Query<L>, joins: Query<J>, rights: Query<R>, maximum: Int = 10000): NavigationStep<R, L>
    let create: fn(R, L): J = fn(right: R, left: L): J do
      return this.joinFactory(left, right)
    end
    let inverse = new ManyToManyNavigation<R, J, L>(
      this.rightJoin,
      this.leftJoin,
      this.rightGetter,
      this.rightSetter,
      this.leftGetter,
      this.leftSetter,
      create,
      this.graphEnrollment
    )

    return inverse.step(rights, joins, lefts, maximum)
  end

  ## Registers reversible collection-difference inference before tracked saves.
  public def trackCollectionChanges(lefts: Query<L>, joins: Query<J>, rights: Query<R>): WriteFailure?
    let owner = joins.changeOwner()
    let leftOwner = lefts.changeOwner()
    let rightOwner = rights.changeOwner()

    if owner == null || leftOwner == null || rightOwner == null || !reference::same(
      owner,
      leftOwner
    ) || !reference::same(
      owner,
      rightOwner
    )
      return WriteFailure.Validation("skip navigation change detection requires the same context")
    end
    let leftTracker = lefts.rowTracker()
    let joinTracker = joins.rowTracker()
    let rightTracker = rights.rowTracker()

    if leftTracker == null || joinTracker == null || rightTracker == null
      return WriteFailure.Validation("skip navigation materialization fixup requires tracked query roots")
    end
    let observed = new SkipNavigationChanges<L, R>()
    let fixup: fn(): QueryFailure? = fn(): QueryFailure? do
      return this.fixupMaterialized(leftTracker, joinTracker, rightTracker, observed)
    end
    let detect: fn(GraphJournal): QueryFailure? = fn(journal: GraphJournal): QueryFailure? do
      return this.detectCollectionChanges(lefts, joins, rights, journal)
    end
    let registered = owner.registerChangeDetector(detect)

    if registered != null
      return registered
    end
    leftTracker.observeMaterialization(fixup)
    joinTracker.observeMaterialization(fixup)
    rightTracker.observeMaterialization(fixup)
    let release: fn(): Void = fn(): Void do
      observed.clear()
    end

    leftTracker.observeClear(release)
    joinTracker.observeClear(release)
    rightTracker.observeClear(release)
    return null
  end

  internal def fixupMaterialized(
    leftTracker: EntityTracker<L>,
    joinTracker: EntityTracker<J>,
    rightTracker: EntityTracker<R>,
    observed: SkipNavigationChanges<L, R>
  ): QueryFailure?
    let leftRows = new TypedRows<L>()
    let rightRows = new TypedRows<R>()
    let joinRows = new TypedRows<J>()
    let collectLeft: fn(L): Bool = fn(value: L): Bool do
      if !skipNavigationLive(leftTracker.stateOf(value))
        return true
      end
      leftRows.add(value)
      return leftRows.count() <= 10000
    end
    let collectRight: fn(R): Bool = fn(value: R): Bool do
      if !skipNavigationLive(rightTracker.stateOf(value))
        return true
      end
      rightRows.add(value)
      return rightRows.count() <= 10000
    end
    let collectJoin: fn(J): Bool = fn(value: J): Bool do
      if !skipNavigationLive(joinTracker.stateOf(value))
        return true
      end
      joinRows.add(value)
      return joinRows.count() <= 10000
    end

    if !leftTracker.visitTracked(collectLeft) || !rightTracker.visitTracked(collectRight) || !joinTracker.visitTracked(collectJoin)
      return QueryFailure.UnsupportedCapability("skip navigation materialization fixup exceeds 10000 entities")
    end
    let discovered = new SkipNavigationChanges<L, R>()
    var join = joinRows.first()

    while join != null
      let leftKey = this.leftJoin.foreignKey(join.value)
      let rightKey = this.rightJoin.foreignKey(join.value)
      var left = leftRows.first()

      while left != null
        if navigationCellEqual(this.leftJoin.principalKey(left.value), leftKey)
          var right = rightRows.first()

          while right != null
            if navigationCellEqual(
              this.rightJoin.principalKey(right.value),
              rightKey
            ) && discovered.pair(
              left.value,
              right.value
            ) == null
              return QueryFailure.UnsupportedCapability("skip navigation materialization fixup exceeds 10000 pairs")
            end
            right = right.next
          end
        end
        left = left.next
      end
      join = join.next
    end
    observed.retain(discovered)
    var pair = discovered.first

    while pair != null
      let previous = observed.pair(pair.left, pair.right)

      if previous == null
        return QueryFailure.UnsupportedCapability("skip navigation observed pair limit exceeded")
      end
      pair = pair.next
    end
    pair = discovered.first

    while pair != null
      let previous = observed.pair(pair.left, pair.right)

      if previous != null && !previous.baseline
        previous.baseline = true
        let selectedRights = new TypedRows<R>()
        let selectedLefts = new TypedRows<L>()

        for right in this.leftGetter(pair.left)
          navigationDistinct(selectedRights, right)
        end
        for left in this.rightGetter(pair.right)
          navigationDistinct(selectedLefts, left)
        end
        navigationDistinct(selectedRights, pair.right)
        navigationDistinct(selectedLefts, pair.left)
        this.leftSetter(pair.left, navigationArray(selectedRights))
        this.rightSetter(pair.right, navigationArray(selectedLefts))
      end
      pair = pair.next
    end
    return null
  end

  ## Reconciles edits on either skip collection against the mapped join baseline.
  internal def detectCollectionChanges(
    lefts: Query<L>,
    joins: Query<J>,
    rights: Query<R>,
    journal: GraphJournal
  ): QueryFailure?
    let leftTracker = lefts.rowTracker()
    let joinTracker = joins.rowTracker()
    let rightTracker = rights.rowTracker()

    if leftTracker == null || joinTracker == null || rightTracker == null
      return QueryFailure.UnsupportedCapability("skip navigation change detection requires tracked query roots")
    end
    let pairs = new SkipNavigationChanges<L, R>()
    let leftRows = new TypedRows<L>()
    let rightRows = new TypedRows<R>()
    let collectLeft: fn(L): Bool = fn(left: L): Bool do
      leftRows.add(left)
      let before = this.leftGetter(left)
      let joinsBefore = this.leftJoin.collection(left)
      let stateBefore = this.leftJoin.collectionState(left)
      let undo: fn(): Void = fn(): Void do
        this.leftSetter(left, before)
        this.leftJoin.setCollection(left, joinsBefore)
        this.leftJoin.markCollection(left, stateBefore)
      end

      journal.record(undo)
      for right in before
        if pairs.pair(left, right) == null
          pairs.failure = QueryFailure.UnsupportedCapability("skip navigation changes exceed 10000 pairs")
          return false
        end
      end
      for join in joinsBefore
        let right = this.rightJoin.reference(join)

        if right != null
          let pair = pairs.pair(left, right)

          if pair == null
            pairs.failure = QueryFailure.UnsupportedCapability("skip navigation changes exceed 10000 pairs")
            return false
          end
          pair.baseline = true
        end
      end
      return leftRows.count() <= 10000
    end
    let collectRight: fn(R): Bool = fn(right: R): Bool do
      rightRows.add(right)
      let before = this.rightGetter(right)
      let joinsBefore = this.rightJoin.collection(right)
      let stateBefore = this.rightJoin.collectionState(right)
      let undo: fn(): Void = fn(): Void do
        this.rightSetter(right, before)
        this.rightJoin.setCollection(right, joinsBefore)
        this.rightJoin.markCollection(right, stateBefore)
      end

      journal.record(undo)
      for left in before
        if pairs.pair(left, right) == null
          pairs.failure = QueryFailure.UnsupportedCapability("skip navigation changes exceed 10000 pairs")
          return false
        end
      end
      return rightRows.count() <= 10000
    end

    if !leftTracker.visitTracked(collectLeft) || !rightTracker.visitTracked(collectRight)
      return pairs.failure == null ? QueryFailure.UnsupportedCapability("skip navigation change detection exceeds 10000 entities") : pairs.failure
    end
    var change = pairs.first

    while change != null
      let pair = change
      let leftState = lefts.stateOf(pair.left)
      let rightState = rights.stateOf(pair.right)

      if leftState == null || rightState == null
        return QueryFailure.Provider(ProviderFailure.State("skip collection contains an endpoint outside its tracked context"))
      end
      var leftValid = false
      var rightValid = false
      var addedLeft = false

      match leftState
        case TrackingState.Added()
          addedLeft = true
          leftValid = true
        case TrackingState.Unchanged()
          leftValid = true
        case TrackingState.Modified()
          leftValid = true
        case TrackingState.Deleted()
        case TrackingState.Detached()
      end
      match rightState
        case TrackingState.Added()
          rightValid = true
        case TrackingState.Unchanged()
          rightValid = true
        case TrackingState.Modified()
          rightValid = true
        case TrackingState.Deleted()
        case TrackingState.Detached()
      end
      if !leftValid || !rightValid
        return QueryFailure.Provider(ProviderFailure.State("skip collection contains a deleted or detached endpoint"))
      end
      var leftDesired = false
      var rightDesired = false

      for right in this.leftGetter(pair.left)
        leftDesired = leftDesired || reference::same(right, pair.right)
      end
      for left in this.rightGetter(pair.right)
        rightDesired = rightDesired || reference::same(left, pair.left)
      end
      let desired = leftDesired != pair.baseline ? leftDesired : (rightDesired != pair.baseline ? rightDesired : pair.baseline)

      if desired != pair.baseline
        var complete = addedLeft

        match this.leftJoin.collectionState(pair.left)
          case NavigationLoadState.Loaded()
            complete = true
          case NavigationLoadState.Unknown()
          case NavigationLoadState.Loading()
          case NavigationLoadState.Partial()
        end
        if !complete
          return QueryFailure.UnsupportedCapability("skip collection edits require a complete loaded left join collection or an Added endpoint")
        end
      end
      change = change.next
    end
    change = pairs.first

    while change != null
      let pair = change
      var leftDesired = false
      var rightDesired = false

      for right in this.leftGetter(pair.left)
        leftDesired = leftDesired || reference::same(right, pair.right)
      end
      for left in this.rightGetter(pair.right)
        rightDesired = rightDesired || reference::same(left, pair.left)
      end
      let desired = leftDesired != pair.baseline ? leftDesired : (rightDesired != pair.baseline ? rightDesired : pair.baseline)

      if desired != pair.baseline
        if desired
          let invalid = this.link(joins, pair.left, pair.right)

          if invalid != null
            return invalid
          end
        else
          this.leftJoin.markCollection(pair.left, NavigationLoadState.Loaded())
          let invalid = this.unlink(joins, pair.left, pair.right)

          if invalid != null
            return invalid
          end
        end
      end
      change = change.next
    end
    return null
  end

  public def load(
    lefts: Query<L>,
    joins: Query<J>,
    rights: Query<R>,
    rows: TypedRows<L>,
    maximum: Int = 10000
  ): QueryResult<L>
    let firstStep = collectionStep(lefts, joins, this.leftJoin, maximum)
    let secondStep = referenceStep(joins, rights, this.rightJoin)
    let firstFailure = firstStep.validate()
    let secondFailure = secondStep.validate()

    if firstFailure != null
      return QueryResult<L>.Failure(firstFailure)
    end
    if secondFailure != null
      return QueryResult<L>.Failure(secondFailure)
    end
    let journal = new NavigationJournal()

    this.checkpoint(lefts, joins, rights, new TypedRows<L>(), new TypedRows<J>(), journal)
    let beforeLeft: fn(TypedRows<L>, TypedRows<J>): Void = fn(roots: TypedRows<L>, related: TypedRows<J>): Void do
      this.checkpoint(lefts, joins, rights, roots, related, journal)
    end
    let beforeRight: fn(TypedRows<J>, TypedRows<R>): Void = fn(roots: TypedRows<J>, related: TypedRows<R>): Void do
      var current = related.first()

      while current != null
        this.checkpointRight(current.value, journal)
        current = current.next
      end
    end
    let firstPlan = include(
      lefts,
      joins,
      navigationJournalled(this.leftJoin, journal)
    ).maxChildren(maximum).beforePublication(beforeLeft)

    match firstPlan.load(rows)
      case QueryResult.Failure(error)
        journal.rollback()
        return QueryResult<L>.Failure(error)
      case QueryResult.Rows(loaded)
        let joinRows = new TypedRows<J>()
        var current = loaded.first()

        while current != null
          for join in this.leftJoin.collection(current.value)
            navigationDistinct(joinRows, join)
          end
          current = current.next
        end
        let secondPlan = includeReference(
          joins,
          rights,
          navigationJournalled(this.rightJoin, journal)
        ).beforePublication(beforeRight)

        match secondPlan.load(joinRows)
          case QueryResult.Failure(error)
            journal.rollback()
            return QueryResult<L>.Failure(error)
          case QueryResult.Rows(loadedJoins)
            let rightRows = new TypedRows<R>()
            var join = loadedJoins.first()

            while join != null
              let right = this.rightJoin.reference(join.value)

              if right != null
                navigationDistinct(rightRows, right)
              end
              join = join.next
            end
            this.publish(rows, rightRows, journal)
        end
    end
    journal.discard()
    return QueryResult<L>.Rows(rows)
  end

  public def allAsync(
    lefts: Query<L>, joins: Query<J>, rights: Query<R>,
    maximum: Int = 10000, options: StreamOptions? = null
  ): result::Result<AsyncLoad<L>, QueryFailure>
    let first = include(lefts, joins, this.leftJoin).maxChildren(maximum)
    let second = includeReference(joins, rights, this.rightJoin)
    let firstFailure = first.validateQueries(true)
    let secondFailure = second.validateQueries()

    if firstFailure != null
      return result::Result<AsyncLoad<L>, QueryFailure>.Error(firstFailure)
    end
    if secondFailure != null
      return result::Result<AsyncLoad<L>, QueryFailure>.Error(secondFailure)
    end
    let journal = new NavigationJournal()

    this.checkpoint(lefts, joins, rights, new TypedRows<L>(), new TypedRows<J>(), journal)
    let beforeLeft: fn(TypedRows<L>, TypedRows<J>): Void = fn(roots: TypedRows<L>, related: TypedRows<J>): Void do
      this.checkpoint(lefts, joins, rights, roots, related, journal)
    end
    let beforeRight: fn(TypedRows<J>, TypedRows<R>): Void = fn(roots: TypedRows<J>, related: TypedRows<R>): Void do
      var current = related.first()

      while current != null
        this.checkpointRight(current.value, journal)
        current = current.next
      end
    end
    let leftPlan = include(
      lefts,
      joins,
      navigationJournalled(this.leftJoin, journal)
    ).maxChildren(maximum).beforePublication(beforeLeft)
    let rightPlan = includeReference(
      joins,
      rights,
      navigationJournalled(this.rightJoin, journal)
    ).beforePublication(beforeRight)

    match prepareAsyncNavigation<L, J>(leftPlan, options)
      case AsyncNavigationStart.Failure(error)
        journal.rollback()
        return result::Result<AsyncLoad<L>, QueryFailure>.Error(error)
      case AsyncNavigationStart.Started(firstDriver)
        let driver = new AsyncManyToManyDriver<L, J, R>(
          this,
          this.leftJoin,
          this.rightJoin,
          rightPlan,
          firstDriver,
          journal,
          options
        )
        let owned = new AsyncLoad<L>(driver)

        return result::Result<AsyncLoad<L>, QueryFailure>.Ok(transfer owned)
    end
  end

  public def all(
    lefts: Query<L>,
    joins: Query<J>,
    rights: Query<R>,
    maximum: Int = 10000
  ): QueryResult<L>
    let firstFailure = collectionStep(lefts, joins, this.leftJoin, maximum).validate()
    let secondFailure = referenceStep(joins, rights, this.rightJoin).validate()

    if firstFailure != null
      return QueryResult<L>.Failure(firstFailure)
    end
    if secondFailure != null
      return QueryResult<L>.Failure(secondFailure)
    end
    let journal = new NavigationJournal()

    this.checkpoint(lefts, joins, rights, new TypedRows<L>(), new TypedRows<J>(), journal)
    match lefts.all()
      case QueryResult.Failure(error)
        journal.rollback()
        return QueryResult<L>.Failure(error)
      case QueryResult.Rows(rows)
        let result = this.load(lefts, joins, rights, rows, maximum)

        match result
          case QueryResult.Failure(error)
            journal.rollback()
          case QueryResult.Rows(loaded)
            journal.discard()
        end
        return result
    end
  end

  private def checkpointLeft(entity: L, journal: NavigationJournal): Void
    let joins = this.leftJoin.collection(entity)
    let skip = this.leftGetter(entity)
    let state = this.leftJoin.collectionState(entity)
    let undo: fn(): Void = fn(): Void do
      this.leftJoin.setCollection(entity, joins)
      this.leftSetter(entity, skip)
      this.leftJoin.markCollection(entity, state)
    end

    journal.record(undo)
  end

  private def checkpointJoin(entity: J, journal: NavigationJournal): Void
    let left = this.leftJoin.reference(entity)
    let right = this.rightJoin.reference(entity)
    let leftState = this.leftJoin.referenceState(entity)
    let rightState = this.rightJoin.referenceState(entity)
    let undo: fn(): Void = fn(): Void do
      this.leftJoin.setReference(entity, left)
      this.rightJoin.setReference(entity, right)
      this.leftJoin.markReference(entity, leftState)
      this.rightJoin.markReference(entity, rightState)
    end

    journal.record(undo)
  end

  private def checkpointRight(entity: R, journal: NavigationJournal): Void
    let joins = this.rightJoin.collection(entity)
    let skip = this.rightGetter(entity)
    let state = this.rightJoin.collectionState(entity)
    let undo: fn(): Void = fn(): Void do
      this.rightJoin.setCollection(entity, joins)
      this.rightSetter(entity, skip)
      this.rightJoin.markCollection(entity, state)
    end

    journal.record(undo)
  end

  private def checkpoint(
    lefts: Query<L>, joins: Query<J>, rights: Query<R>,
    rows: TypedRows<L>, incoming: TypedRows<J>, journal: NavigationJournal
  ): Void
    let leftTracker = lefts.rowTracker()
    let joinTracker = joins.rowTracker()
    let rightTracker = rights.rowTracker()
    let visitLeft: fn(L): Bool = fn(value: L): Bool do
      this.checkpointLeft(value, journal)
      return true
    end
    let visitJoin: fn(J): Bool = fn(value: J): Bool do
      this.checkpointJoin(value, journal)
      return true
    end
    let visitRight: fn(R): Bool = fn(value: R): Bool do
      this.checkpointRight(value, journal)
      return true
    end

    if leftTracker != null
      leftTracker.visitTracked(visitLeft)
    end
    if joinTracker != null
      joinTracker.visitTracked(visitJoin)
    end
    if rightTracker != null
      rightTracker.visitTracked(visitRight)
    end
    var root = rows.first()

    while root != null
      this.checkpointLeft(root.value, journal)
      root = root.next
    end
    var join = incoming.first()

    while join != null
      this.checkpointJoin(join.value, journal)
      join = join.next
    end
  end

  internal def publish(rows: TypedRows<L>, rights: TypedRows<R>, journal: NavigationJournal): Void
    let affectedRights = new TypedRows<R>()
    var supplied = rights.first()

    while supplied != null
      navigationDistinct(affectedRights, supplied.value)
      supplied = supplied.next
    end
    var leftNode = rows.first()

    while leftNode != null
      let left = leftNode.value
      let selected = new TypedRows<R>()

      for previous in this.leftGetter(left)
        navigationDistinct(affectedRights, previous)
      end

      for join in this.leftJoin.collection(left)
        let right = this.rightJoin.reference(join)

        if right != null
          navigationDistinct(selected, right)
        end
      end
      let previous = this.leftGetter(left)
      let undo: fn(): Void = fn(): Void do
        this.leftSetter(left, previous)
      end

      journal.record(undo)
      this.leftSetter(left, navigationArray(selected))
      leftNode = leftNode.next
    end
    var rightNode = affectedRights.first()

    while rightNode != null
      let right = rightNode.value
      let selected = new TypedRows<L>()

      for existing in this.rightGetter(right)
        var replaced = false
        var current = rows.first()

        while current != null
          if reference::same(current.value, existing)
            replaced = true
          end
          current = current.next
        end
        if !replaced
          navigationDistinct(selected, existing)
        end
      end
      var current = rows.first()

      while current != null
        for candidate in this.leftGetter(current.value)
          if reference::same(candidate, right)
            navigationDistinct(selected, current.value)
          end
        end
        current = current.next
      end
      let previous = this.rightGetter(right)
      let undo: fn(): Void = fn(): Void do
        this.rightSetter(right, previous)
      end

      journal.record(undo)
      this.rightSetter(right, navigationArray(selected))
      rightNode = rightNode.next
    end
  end

  ## Enrollment uses the join mapping's registered write links for generated keys.
  public def link(joins: Query<J>, left: L, right: R): QueryFailure?
    let invalid = joins.queryFailure()

    if invalid != null
      return invalid
    end
    if !joins.isUnfilteredRoot() || joins.rowTracker() == null
      return QueryFailure.UnsupportedCapability("many-to-many links require a tracked join query root")
    end
    let owner = joins.changeOwner()

    if owner == null
      return QueryFailure.UnsupportedCapability("many-to-many links require a tracked join query")
    end
    let blocked = owner.operationFailure()

    if blocked != null
      return blocked
    end
    let join = this.joinFactory(left, right)

    this.leftJoin.setReference(join, left)
    this.rightJoin.setReference(join, right)
    let enrollment = this.graphEnrollment
    let error = enrollment == null ? joins.add(join) : enrollment(join)

    if error != null
      return error
    end
    let joinLefts = new TypedRows<J>()
    let joinRights = new TypedRows<J>()
    let leftRights = new TypedRows<R>()
    let rightLefts = new TypedRows<L>()

    for item in this.leftJoin.collection(left)
      navigationDistinct(joinLefts, item)
    end
    for item in this.rightJoin.collection(right)
      navigationDistinct(joinRights, item)
    end
    for item in this.leftGetter(left)
      navigationDistinct(leftRights, item)
    end
    for item in this.rightGetter(right)
      navigationDistinct(rightLefts, item)
    end
    navigationDistinct(joinLefts, join)
    navigationDistinct(joinRights, join)
    navigationDistinct(leftRights, right)
    navigationDistinct(rightLefts, left)
    this.leftJoin.setCollection(left, navigationArray(joinLefts))
    this.rightJoin.setCollection(right, navigationArray(joinRights))
    this.leftSetter(left, navigationArray(leftRights))
    this.rightSetter(right, navigationArray(rightLefts))
    return null
  end

  ## Unlink requires a complete join collection so unseen rows cannot survive silently.
  public def unlink(joins: Query<J>, left: L, right: R): QueryFailure?
    let invalid = joins.queryFailure()

    if invalid != null
      return invalid
    end
    let tracker = joins.rowTracker()

    if !joins.isUnfilteredRoot() || tracker == null
      return QueryFailure.UnsupportedCapability("many-to-many unlink requires a tracked join query root")
    end
    var complete = false

    match this.leftJoin.collectionState(left)
      case NavigationLoadState.Loaded()
        complete = true
      case NavigationLoadState.Unknown()
      case NavigationLoadState.Loading()
      case NavigationLoadState.Partial()
    end
    if !complete
      return QueryFailure.UnsupportedCapability("many-to-many unlink requires the complete loaded join collection")
    end
    let selected = new TypedRows<J>()
    let retainedLeft = new TypedRows<J>()
    let retainedRight = new TypedRows<J>()

    for join in this.leftJoin.collection(left)
      let target = this.rightJoin.reference(join)

      if target != null && reference::same(target, right)
        let find: fn(J): Bool = fn(entity: J): Bool do
          return !reference::same(entity, join)
        end

        if tracker.visitTracked(find)
          return QueryFailure.Provider(ProviderFailure.State("many-to-many join is not the tracked instance"))
        end
        let state = joins.stateOf(join)

        if state == null
          return QueryFailure.Provider(ProviderFailure.State("many-to-many join is not tracked"))
        end
        match state
          case TrackingState.Detached()
            return QueryFailure.Provider(ProviderFailure.State("many-to-many join is detached"))
          case TrackingState.Added()
          case TrackingState.Unchanged()
          case TrackingState.Modified()
          case TrackingState.Deleted()
            return QueryFailure.Provider(ProviderFailure.State("many-to-many join is already deleted"))
        end
        selected.add(join)
      else
        retainedLeft.add(join)
      end
    end
    for join in this.rightJoin.collection(right)
      var removed = false
      var current = selected.first()

      while current != null
        removed = removed || reference::same(current.value, join)
        current = current.next
      end
      if !removed
        retainedRight.add(join)
      end
    end
    var current = selected.first()

    while current != null
      let error = joins.remove(current.value)

      if error != null
        return error
      end
      current = current.next
    end
    let leftRights = new TypedRows<R>()
    let rightLefts = new TypedRows<L>()

    for existing in this.leftGetter(left)
      if !reference::same(existing, right)
        leftRights.add(existing)
      end
    end
    for existing in this.rightGetter(right)
      if !reference::same(existing, left)
        rightLefts.add(existing)
      end
    end
    this.leftJoin.setCollection(left, navigationArray(retainedLeft))
    this.rightJoin.setCollection(right, navigationArray(retainedRight))
    this.leftSetter(left, navigationArray(leftRights))
    this.rightSetter(right, navigationArray(rightLefts))
    return null
  end

end


class AsyncManyToManyDriver<L, J, R>: AsyncLoadDriver<L>
  private relation: ManyToManyNavigation<L, J, R>
  private leftJoin: CollectionNavigation<L, J>
  private rightJoin: CollectionNavigation<R, J>
  private secondPlan: ReferencedQuery<R, J>
  private first: AsyncNavigationDriver<L, J>
  private second: AsyncNavigationDriver<J, R>?
  private journal: NavigationJournal
  private roots: TypedRows<L>?
  private options: StreamOptions?
  private deadline: Int?
  private terminal: QueryResult<L>?
  private closed: Bool = false

  def init(
    relation: ManyToManyNavigation<L, J, R>,
    leftJoin: CollectionNavigation<L, J>, rightJoin: CollectionNavigation<R, J>,
    secondPlan: ReferencedQuery<R, J>, first: AsyncNavigationDriver<L, J>,
    journal: NavigationJournal, options: StreamOptions?
  ): Void
    this.relation = relation
    this.leftJoin = leftJoin
    this.rightJoin = rightJoin
    this.secondPlan = secondPlan
    this.first = first
    this.journal = journal
    this.options = options
    let timeout = options == null ? null : options.timeoutMilliseconds()

    if timeout != null
      let now = clock::milliseconds()

      if timeout < 1 || timeout > 86400000 || now == null || now > 9223372036854775807 - timeout
        this.cancel()
        this.terminal = QueryResult<L>.Failure(QueryFailure.Provider(ProviderFailure.State("many-to-many async deadline is invalid or unavailable")))
      else
        this.deadline = now + timeout
      end
    end
  end

  private def fail(error: QueryFailure): AsyncQueryPoll<L>
    let cleanup = this.close()
    let failure = cleanup == null ? error : QueryFailure.Cleanup(new QueryCleanupFailure(error, cleanup))

    let result = QueryResult<L>.Failure(failure)

    this.terminal = result
    return AsyncQueryPoll<L>.Completed(result)
  end

  public override def poll(): AsyncQueryPoll<L>
    let terminal = this.terminal

    if terminal != null
      return AsyncQueryPoll<L>.Completed(terminal)
    end
    if this.closed
      return this.fail(QueryFailure.Provider(ProviderFailure.State("many-to-many async load is closed")))
    end
    let options = this.options
    let token = options == null ? null : options.token()
    let deadline = this.deadline
    var remaining: Int? = null

    if token != null && token.cancelled()
      return this.fail(QueryFailure.Provider(ProviderFailure.State("many-to-many async load cancelled")))
    end
    if deadline != null
      let now = clock::milliseconds()

      if now == null || now >= deadline
        return this.fail(QueryFailure.Provider(ProviderFailure.State("many-to-many async deadline elapsed")))
      end
      remaining = deadline - now
    end
    let second = this.second

    if second == null
      match this.first.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          return AsyncQueryPoll<L>.Pending(socket, interest)
        case AsyncQueryPoll.Completed(result)
          match result
            case QueryResult.Failure(error)
              return this.fail(error)
            case QueryResult.Rows(rows)
              this.roots = rows
              let joins = new TypedRows<J>()
              var current = rows.first()

              while current != null
                for join in this.leftJoin.collection(current.value)
                  navigationDistinct(joins, join)
                end
                current = current.next
              end
              let nextOptions = options == null ? null : new StreamOptions(token, remaining)

              this.second = new AsyncNavigationDriver<J, R>(this.secondPlan, nextOptions, rows: joins)
              return AsyncQueryPoll<L>.Pending(-1, AsyncInterest.Read())
          end
      end
    end
    match second.poll()
      case AsyncQueryPoll.Pending(socket, interest)
        return AsyncQueryPoll<L>.Pending(socket, interest)
      case AsyncQueryPoll.Completed(result)
        match result
          case QueryResult.Failure(error)
            return this.fail(error)
          case QueryResult.Rows(joins)
            let roots = this.roots

            if roots == null
              return this.fail(QueryFailure.Provider(ProviderFailure.State("many-to-many async roots are unavailable")))
            end
            let rights = new TypedRows<R>()
            var current = joins.first()

            while current != null
              let right = this.rightJoin.reference(current.value)

              if right != null
                navigationDistinct(rights, right)
              end
              current = current.next
            end
            this.relation.publish(roots, rights, this.journal)
            this.journal.discard()
            this.terminal = QueryResult<L>.Rows(roots)
            return AsyncQueryPoll<L>.Completed(QueryResult<L>.Rows(roots))
        end
    end
  end

  public override def cancel(): Void
    if this.terminal != null
      return
    end
    let error = QueryFailure.Provider(ProviderFailure.State("many-to-many async load cancelled"))
    let cleanup = this.close()
    let failure = cleanup == null ? error : QueryFailure.Cleanup(new QueryCleanupFailure(error, cleanup))

    this.terminal = QueryResult<L>.Failure(failure)
  end

  public override def close(): ProviderFailure?
    if this.closed
      return null
    end
    this.closed = true
    let firstError = this.first.close()
    let second = this.second
    let secondError = second == null ? null : second.close()

    if this.terminal == null
      this.journal.rollback()
    end
    if firstError != null && secondError != null
      return ProviderFailure.Cleanup(new ProviderCleanupFailure(firstError, secondError))
    end
    return firstError == null ? secondError : firstError
  end
end
