use host
use tasks
namespace neri_data

enum SchemaType
  case Bool()
  case Int()
  case Float()
  case Text()
end

enum SchemaDefault
  case Null()
  case Bool(value: Bool)
  case Int(value: Int)
  case Float(value: Float)
  case Text(value: String)
end

class SchemaColumn
  private storedName: String
  private storedType: SchemaType
  private storedNullable: Bool
  private storedPrimaryKey: Bool
  private storedDefault: SchemaDefault?

  public def init(name: String, type: SchemaType, nullable: Bool = false, primaryKey: Bool = false, defaultValue: SchemaDefault? = null): Void
    this.storedName = name
    this.storedType = type
    this.storedNullable = nullable
    this.storedPrimaryKey = primaryKey
    this.storedDefault = defaultValue
  end

  public readonly def name(): String
    return this.storedName
  end

  public readonly def type(): readonly SchemaType
    return this.storedType
  end

  public readonly def nullable(): Bool
    return this.storedNullable
  end

  public readonly def primaryKey(): Bool
    return this.storedPrimaryKey
  end

  public readonly def defaultValue(): readonly SchemaDefault?
    return this.storedDefault
  end
end

enum SchemaOp
  case CreateTable(table: String, columns: SchemaColumn[])
  case DropTable(table: String)
  case AddColumn(table: String, column: SchemaColumn)
  case DropColumn(table: String, column: String)
  case RenameTable(from: String, to: String)
  case RenameColumn(table: String, from: String, to: String)
  case CreateIndex(name: String, table: String, columns: String[], unique: Bool)
  case DropIndex(name: String)
  case RebuildTable(before: SchemaTable, after: SchemaTable)
end

enum SchemaCompileResult
  case Statement(sql: String)
  case Failure(message: String)
end

enum MigrationFailure
  case Validation(message: String)
  case Drift(message: String)
  case Unsupported(message: String)
  case Provider(message: String)
end

enum MigrationResult
  case Applied(count: Int)
  case Failure(error: MigrationFailure)
end

class MigrationStamp
  private storedId: String
  private storedSignature: String

  public def init(id: String, signature: String): Void
    this.storedId = id
    this.storedSignature = signature
  end

  public readonly def id(): String
    return this.storedId
  end

  public readonly def signature(): String
    return this.storedSignature
  end
end

def schemaSameIdentifier(left: String, right: String): Bool
  if host::stringByteLength(left) != host::stringByteLength(right)
    return false
  end
  var index = 0

  while index < host::stringByteLength(left)
    var first = host::stringByteAt(left, index) as Int
    var second = host::stringByteAt(right, index) as Int

    if first >= 65 && first <= 90
      first = first + 32
    end
    if second >= 65 && second <= 90
      second = second + 32
    end
    if first != second
      return false
    end
    index = index + 1
  end
  return true
end

def schemaReserved(name: String): Bool
  let prefix = "__neri_"

  if host::stringByteLength(name) < host::stringByteLength(prefix)
    return false
  end
  return schemaSameIdentifier(host::stringSlice(name, 0, host::stringByteLength(prefix)), prefix)
end

def schemaPiece(value: String): String
  return (host::stringByteLength(value) as String) + ":" + value
end

def schemaTypeCode(type: readonly SchemaType): String
  match type
    case SchemaType.Bool()
      return "B"
    case SchemaType.Int()
      return "I"
    case SchemaType.Float()
      return "F"
    case SchemaType.Text()
      return "T"
  end
end

def schemaDefaultCode(value: readonly SchemaDefault?): String
  if value == null
    return "N"
  end
  match value
    case SchemaDefault.Null()
      return "Z"
    case SchemaDefault.Bool(item)
      return item ? "B1" : "B0"
    case SchemaDefault.Int(item)
      return "I" + schemaPiece(item as String)
    case SchemaDefault.Float(item)
      return "F" + schemaPiece(item as String)
    case SchemaDefault.Text(item)
      return "T" + schemaPiece(item)
  end
end

def schemaColumnCode(column: readonly SchemaColumn): String
  return schemaPiece(column.name()) + schemaTypeCode(column.type()) + (column.nullable() ? "1" : "0") + (column.primaryKey() ? "1" : "0") + schemaDefaultCode(column.defaultValue())
end

def schemaCloneType(type: readonly SchemaType): SchemaType
  match type
    case SchemaType.Bool()
      return SchemaType.Bool()
    case SchemaType.Int()
      return SchemaType.Int()
    case SchemaType.Float()
      return SchemaType.Float()
    case SchemaType.Text()
      return SchemaType.Text()
  end
end

def schemaCloneDefault(value: readonly SchemaDefault?): SchemaDefault?
  if value == null
    return null
  end
  match value
    case SchemaDefault.Null()
      return SchemaDefault.Null()
    case SchemaDefault.Bool(item)
      return SchemaDefault.Bool(item)
    case SchemaDefault.Int(item)
      return SchemaDefault.Int(item)
    case SchemaDefault.Float(item)
      return SchemaDefault.Float(item)
    case SchemaDefault.Text(item)
      return SchemaDefault.Text(item)
  end
end

def schemaOpCode(op: readonly SchemaOp): String
  match op
    case SchemaOp.CreateTable(table, columns)
      var code = "CT" + schemaPiece(table) + schemaPiece(columns.Length as String)

      for column in columns
        code = code + schemaPiece(schemaColumnCode(column))
      end
      return code
    case SchemaOp.DropTable(table)
      return "DT" + schemaPiece(table)
    case SchemaOp.AddColumn(table, column)
      return "AC" + schemaPiece(table) + schemaPiece(schemaColumnCode(column))
    case SchemaOp.DropColumn(table, column)
      return "DC" + schemaPiece(table) + schemaPiece(column)
    case SchemaOp.RenameTable(from, to)
      return "RT" + schemaPiece(from) + schemaPiece(to)
    case SchemaOp.RenameColumn(table, from, to)
      return "RC" + schemaPiece(table) + schemaPiece(from) + schemaPiece(to)
    case SchemaOp.CreateIndex(name, table, columns, unique)
      var code = "CI" + schemaPiece(name) + schemaPiece(table) + (unique ? "1" : "0") + schemaPiece(columns.Length as String)

      for column in columns
        code = code + schemaPiece(column)
      end
      return code
    case SchemaOp.DropIndex(name)
      return "DI" + schemaPiece(name)
    case SchemaOp.RebuildTable(before, after)
      return "RB" + schemaPiece(before.signature()) + schemaPiece(after.signature())
  end
end

def schemaCloneOp(op: readonly SchemaOp): SchemaOp
  match op
    case SchemaOp.CreateTable(table, columns)
      let copied: SchemaColumn[] = tasks::generate(columns.Length, 1) do |index|
        let column = columns[index]

        return new SchemaColumn(column.name(), schemaCloneType(column.type()), column.nullable(), column.primaryKey(), schemaCloneDefault(column.defaultValue()))
      end

      return SchemaOp.CreateTable(table, copied)
    case SchemaOp.DropTable(table)
      return SchemaOp.DropTable(table)
    case SchemaOp.AddColumn(table, column)
      return SchemaOp.AddColumn(table, column)
    case SchemaOp.DropColumn(table, column)
      return SchemaOp.DropColumn(table, column)
    case SchemaOp.RenameTable(from, to)
      return SchemaOp.RenameTable(from, to)
    case SchemaOp.RenameColumn(table, from, to)
      return SchemaOp.RenameColumn(table, from, to)
    case SchemaOp.CreateIndex(name, table, columns, unique)
      let copied: String[] = tasks::generate(columns.Length, 1) do |index|
        return columns[index]
      end

      return SchemaOp.CreateIndex(name, table, copied, unique)
    case SchemaOp.DropIndex(name)
      return SchemaOp.DropIndex(name)
    case SchemaOp.RebuildTable(before, after)
      return SchemaOp.RebuildTable(before.copy(), after.copy())
  end
end

def schemaDuplicateOperation(left: readonly SchemaOp, right: readonly SchemaOp): Bool
  match left
    case SchemaOp.CreateTable(table, columns)
      match right
        case SchemaOp.CreateTable(other, otherColumns)
          return schemaSameIdentifier(table, other)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(name, other, otherColumns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.DropTable(table)
      match right
        case SchemaOp.DropTable(other)
          return schemaSameIdentifier(table, other)
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.AddColumn(table, column)
      match right
        case SchemaOp.AddColumn(other, otherColumn)
          return schemaSameIdentifier(table, other) && schemaSameIdentifier(column.name(), otherColumn.name())
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.DropColumn(other, otherColumn)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.DropColumn(table, column)
      match right
        case SchemaOp.DropColumn(other, otherColumn)
          return schemaSameIdentifier(table, other) && schemaSameIdentifier(column, otherColumn)
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, otherColumn)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.RenameTable(from, to)
      match right
        case SchemaOp.RenameTable(other, otherTo)
          return schemaSameIdentifier(from, other)
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameColumn(other, otherFrom, otherTo)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.RenameColumn(table, from, to)
      match right
        case SchemaOp.RenameColumn(other, otherFrom, otherTo)
          return schemaSameIdentifier(table, other) && schemaSameIdentifier(from, otherFrom)
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(otherFrom, otherTo)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.CreateIndex(name, table, columns, unique)
      match right
        case SchemaOp.CreateIndex(otherName, otherTable, otherColumns, otherUnique)
          return schemaSameIdentifier(name, otherName)
        case SchemaOp.CreateTable(other, otherColumns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.DropIndex(otherName)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.DropIndex(name)
      match right
        case SchemaOp.DropIndex(other)
          return schemaSameIdentifier(name, other)
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(otherName, other, columns, unique)
        case SchemaOp.RebuildTable(before, after)
          return false
      end
    case SchemaOp.RebuildTable(before, after)
      match right
        case SchemaOp.RebuildTable(otherBefore, otherAfter)
          return schemaSameIdentifier(before.name(), otherBefore.name())
        case SchemaOp.CreateTable(other, columns)
        case SchemaOp.DropTable(other)
        case SchemaOp.AddColumn(other, column)
        case SchemaOp.DropColumn(other, column)
        case SchemaOp.RenameTable(from, to)
        case SchemaOp.RenameColumn(other, from, to)
        case SchemaOp.CreateIndex(name, other, columns, unique)
        case SchemaOp.DropIndex(name)
          return false
      end
  end
  return false
end

def schemaRebuildValidation(before: readonly SchemaTable, after: readonly SchemaTable): String?
  if before.count() + before.indexCount() + 1 > 1000 || after.count() + after.indexCount() + 1 > 1000
    return "table rebuild exceeds 1000 objects"
  end
  let oldModel = new SchemaModel([before.copy()])
  let oldError = oldModel.validate()

  if oldError != null
    return oldError
  end
  let newModel = new SchemaModel([after.copy()])
  let newError = newModel.validate()

  if newError != null
    return newError
  end
  if before.identity() != after.identity()
    return "table rebuild requires unchanged logical identity"
  end
  var targetIndex = 0

  while targetIndex < after.count()
    let target = after.at(targetIndex)

    if target != null
      var existingIndex = 0

      while existingIndex < before.count()
        let existing = before.at(existingIndex)

        if existing != null && existing.identity() != target.identity() && schemaSameIdentifier(existing.column().name(), target.column().name())
          return "column physical name is reused by another identity"
        end
        existingIndex = existingIndex + 1
      end
      let previous = before.find(target.identity())

      if previous != null && previous.column().name() != target.column().name() && schemaSameIdentifier(previous.column().name(), target.column().name())
        return "column case-only rename is unsupported"
      end
      if previous == null && (target.column().primaryKey() || (!target.column().nullable() && target.column().defaultValue() == null))
        return "added column requires nullable or defaulted non-primary-key definition"
      end
    end
    targetIndex = targetIndex + 1
  end
  var keyIdentity = ""
  var index = 0

  while index < before.count()
    let field = before.at(index)

    if field != null && field.column().primaryKey()
      keyIdentity = field.identity()
    end
    index = index + 1
  end
  let oldKey = before.find(keyIdentity)
  let newKey = after.find(keyIdentity)

  if oldKey == null || newKey == null || !newKey.column().primaryKey() || schemaTypeCode(oldKey.column().type()) != schemaTypeCode(newKey.column().type()) || oldKey.column().nullable() != newKey.column().nullable() || schemaDefaultCode(oldKey.column().defaultValue()) != schemaDefaultCode(newKey.column().defaultValue())
    return "primary key change is unsupported"
  end
  return null
end

def schemaOperationValidation(op: readonly SchemaOp): String?
  match op
    case SchemaOp.RebuildTable(before, after)
      return schemaRebuildValidation(before, after)
    case SchemaOp.CreateTable(table, columns)
    case SchemaOp.DropTable(table)
    case SchemaOp.AddColumn(table, column)
    case SchemaOp.DropColumn(table, column)
    case SchemaOp.RenameTable(from, to)
    case SchemaOp.RenameColumn(table, from, to)
    case SchemaOp.CreateIndex(name, table, columns, unique)
    case SchemaOp.DropIndex(name)
  end
  match compileSchema(op, SqlDialect.QuestionMark())
    case SchemaCompileResult.Failure(message)
      return message
    case SchemaCompileResult.Statement(sql)
      return null
  end
end

class Migration
  private storedId: String
  private forward: SchemaOp[]
  private reverse: SchemaOp[]
  private storedSignature: String

  public def init(id: String, up: SchemaOp[], down: SchemaOp[]): Void
    this.storedId = id
    this.forward = tasks::generate(up.Length, 1) do |index|
      return schemaCloneOp(up[index])
    end
    this.reverse = tasks::generate(down.Length, 1) do |index|
      return schemaCloneOp(down[index])
    end
    var content = "v1" + schemaPiece(id) + schemaPiece(this.forward.Length as String)

    for op in this.forward
      content = content + schemaPiece(schemaOpCode(op))
    end
    content = content + schemaPiece(this.reverse.Length as String)

    for op in this.reverse
      content = content + schemaPiece(schemaOpCode(op))
    end
    this.storedSignature = content
  end

  public readonly def id(): String
    return this.storedId
  end

  public readonly def signature(): String
    return this.storedSignature
  end

  public readonly def upCount(): Int
    return this.forward.Length
  end

  public readonly def upAt(index: Int): readonly SchemaOp?
    if index < 0 || index >= this.forward.Length
      return null
    end
    return this.forward[index]
  end

  public readonly def downCount(): Int
    return this.reverse.Length
  end

  public readonly def downAt(index: Int): readonly SchemaOp?
    if index < 0 || index >= this.reverse.Length
      return null
    end
    return this.reverse[index]
  end

  internal readonly def copy(): Migration
    let up: SchemaOp[] = tasks::generate(this.forward.Length, 1) do |index|
      return schemaCloneOp(this.forward[index])
    end
    let down: SchemaOp[] = tasks::generate(this.reverse.Length, 1) do |index|
      return schemaCloneOp(this.reverse[index])
    end

    return new Migration(this.storedId, up, down)
  end
end

class MigrationSet
  private ordered: Migration[]

  public def init(migrations: Migration[]): Void
    this.ordered = tasks::generate(migrations.Length, 1) do |index|
      return migrations[index].copy()
    end
  end

  public readonly def count(): Int
    return this.ordered.Length
  end

  public readonly def at(index: Int): readonly Migration?
    if index < 0 || index >= this.ordered.Length
      return null
    end
    return this.ordered[index]
  end

  public readonly def validate(): String?
    var index = 0

    while index < this.ordered.Length
      let current = this.ordered[index]

      if !identifierValid(current.id()) || schemaReserved(current.id())
        return "invalid or reserved migration id"
      end
      if current.upCount() == 0 || current.downCount() == 0
        return "migration requires forward and reverse operations"
      end
      var earlier = 0

      while earlier < index
        if schemaSameIdentifier(this.ordered[earlier].id(), current.id())
          return "duplicate migration id"
        end
        earlier = earlier + 1
      end
      var opIndex = 0

      while opIndex < current.upCount()
        let op = current.upAt(opIndex)

        if op == null
          return "missing migration operation"
        end
        let invalidOp = schemaOperationValidation(op)

        if invalidOp != null
          return invalidOp
        end
        var prior = 0

        while prior < opIndex
          let previous = current.upAt(prior)

          if previous != null && schemaDuplicateOperation(previous, op)
            return "duplicate migration operation"
          end
          prior = prior + 1
        end
        opIndex = opIndex + 1
      end
      opIndex = 0

      while opIndex < current.downCount()
        let op = current.downAt(opIndex)

        if op == null
          return "missing reverse migration operation"
        end
        let invalidOp = schemaOperationValidation(op)

        if invalidOp != null
          return invalidOp
        end
        var prior = 0

        while prior < opIndex
          let previous = current.downAt(prior)

          if previous != null && schemaDuplicateOperation(previous, op)
            return "duplicate reverse migration operation"
          end
          prior = prior + 1
        end
        opIndex = opIndex + 1
      end
      index = index + 1
    end
    return null
  end

  public readonly def historyPrefix(applied: MigrationStamp[]): String?
    let invalid = this.validate()

    if invalid != null
      return invalid
    end
    if applied.Length > this.ordered.Length
      return "migration history exceeds catalog"
    end
    var index = 0

    while index < applied.Length
      if applied[index].id() != this.ordered[index].id() || applied[index].signature() != this.ordered[index].signature()
        return "migration history differs from catalog prefix"
      end
      index = index + 1
    end
    return null
  end
end

def schemaQuote(name: String): String
  return "\"" + name + "\""
end

def schemaTextLiteral(value: String): String
  var output = "'"
  var start = 0
  var index = 0

  while index < host::stringByteLength(value)
    if host::stringByteAt(value, index) as Int == 39
      output = output + host::stringSlice(value, start, index - start) + "''"
      start = index + 1
    end
    index = index + 1
  end
  return output + host::stringSlice(value, start, host::stringByteLength(value) - start) + "'"
end

def schemaColumnSql(column: readonly SchemaColumn, adding: Bool = false): SchemaCompileResult
  if !identifierValid(column.name())
    return SchemaCompileResult.Failure("invalid column identifier")
  end
  if column.primaryKey() && (column.nullable() || column.defaultValue() != null || adding)
    return SchemaCompileResult.Failure("primary key must be required Int or Text without default and created with table")
  end
  var kind = ""

  match column.type()
    case SchemaType.Bool()
      if column.primaryKey()
        return SchemaCompileResult.Failure("primary key must be Int or Text")
      end
      kind = "INTEGER"
    case SchemaType.Int()
      kind = "INTEGER"
    case SchemaType.Float()
      if column.primaryKey()
        return SchemaCompileResult.Failure("primary key must be Int or Text")
      end
      kind = "REAL"
    case SchemaType.Text()
      kind = "TEXT"
  end
  var sql = schemaQuote(column.name()) + " " + kind

  if column.primaryKey()
    sql = sql + (kind == "TEXT" ? " NOT NULL PRIMARY KEY" : " PRIMARY KEY")
  else if !column.nullable()
    sql = sql + " NOT NULL"
  end
  let defaultValue = column.defaultValue()

  if adding && !column.nullable() && defaultValue == null
    return SchemaCompileResult.Failure("required added column requires a typed default")
  end
  if defaultValue != null
    match defaultValue
      case SchemaDefault.Null()
        if !column.nullable()
          return SchemaCompileResult.Failure("null default requires a nullable column")
        end
        sql = sql + " DEFAULT NULL"
      case SchemaDefault.Bool(value)
        match column.type()
          case SchemaType.Bool()
            sql = sql + (value ? " DEFAULT 1" : " DEFAULT 0")
          case SchemaType.Int()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Float()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Text()
            return SchemaCompileResult.Failure("column default type mismatch")
        end
      case SchemaDefault.Int(value)
        match column.type()
          case SchemaType.Int()
            sql = sql + " DEFAULT " + (value as String)
          case SchemaType.Bool()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Float()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Text()
            return SchemaCompileResult.Failure("column default type mismatch")
        end
      case SchemaDefault.Float(value)
        if !dataFloatFinite(value)
          return SchemaCompileResult.Failure("Float default must be finite")
        end
        match column.type()
          case SchemaType.Float()
            sql = sql + " DEFAULT " + (value as String)
          case SchemaType.Bool()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Int()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Text()
            return SchemaCompileResult.Failure("column default type mismatch")
        end
      case SchemaDefault.Text(value)
        match column.type()
          case SchemaType.Text()
            var index = 0

            while index < host::stringByteLength(value)
              if host::stringByteAt(value, index) as Int == 0
                return SchemaCompileResult.Failure("text default contains NUL")
              end
              index = index + 1
            end
            sql = sql + " DEFAULT " + schemaTextLiteral(value)
          case SchemaType.Bool()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Int()
            return SchemaCompileResult.Failure("column default type mismatch")
          case SchemaType.Float()
            return SchemaCompileResult.Failure("column default type mismatch")
        end
    end
  end
  return SchemaCompileResult.Statement(sql)
end

def schemaTableValid(table: String): Bool
  return identifierValid(table) && !schemaReserved(table)
end

def compileSchema(op: readonly SchemaOp, dialect: SqlDialect): SchemaCompileResult
  match dialect
    case SqlDialect.PostgreSql()
      return SchemaCompileResult.Failure("schema compiler supports SQLite dialect only")
    case SqlDialect.QuestionMark()
  end
  match op
    case SchemaOp.CreateTable(table, columns)
      if !schemaTableValid(table) || columns.Length == 0
        return SchemaCompileResult.Failure("create table requires valid name and columns")
      end
      var columnsSql = ""
      var primaryKeys = 0
      var index = 0

      while index < columns.Length
        let column = columns[index]

        if column.primaryKey()
          primaryKeys = primaryKeys + 1
        end
        var prior = 0

        while prior < index
          if schemaSameIdentifier(columns[prior].name(), column.name())
            return SchemaCompileResult.Failure("duplicate table column")
          end
          prior = prior + 1
        end
        match schemaColumnSql(column)
          case SchemaCompileResult.Failure(message)
            return SchemaCompileResult.Failure(message)
          case SchemaCompileResult.Statement(sql)
            columnsSql = columnsSql + (index == 0 ? "" : ", ") + sql
        end
        index = index + 1
      end
      if primaryKeys != 1
        return SchemaCompileResult.Failure("table requires exactly one Int or Text primary key")
      end
      return SchemaCompileResult.Statement("CREATE TABLE " + schemaQuote(table) + " (" + columnsSql + ")")
    case SchemaOp.DropTable(table)
      if !schemaTableValid(table)
        return SchemaCompileResult.Failure("invalid or reserved table name")
      end
      return SchemaCompileResult.Statement("DROP TABLE " + schemaQuote(table))
    case SchemaOp.AddColumn(table, column)
      if !schemaTableValid(table)
        return SchemaCompileResult.Failure("invalid or reserved table name")
      end
      match schemaColumnSql(column, true)
        case SchemaCompileResult.Failure(message)
          return SchemaCompileResult.Failure(message)
        case SchemaCompileResult.Statement(sql)
          return SchemaCompileResult.Statement("ALTER TABLE " + schemaQuote(table) + " ADD COLUMN " + sql)
      end
    case SchemaOp.DropColumn(table, column)
      if !schemaTableValid(table) || !identifierValid(column)
        return SchemaCompileResult.Failure("invalid table or column name")
      end
      return SchemaCompileResult.Statement("ALTER TABLE " + schemaQuote(table) + " DROP COLUMN " + schemaQuote(column))
    case SchemaOp.RenameTable(from, to)
      if !schemaTableValid(from) || !schemaTableValid(to) || schemaSameIdentifier(from, to)
        return SchemaCompileResult.Failure("invalid table rename")
      end
      return SchemaCompileResult.Statement("ALTER TABLE " + schemaQuote(from) + " RENAME TO " + schemaQuote(to))
    case SchemaOp.RenameColumn(table, from, to)
      if !schemaTableValid(table) || !identifierValid(from) || !identifierValid(to) || schemaSameIdentifier(from, to)
        return SchemaCompileResult.Failure("invalid column rename")
      end
      return SchemaCompileResult.Statement("ALTER TABLE " + schemaQuote(table) + " RENAME COLUMN " + schemaQuote(from) + " TO " + schemaQuote(to))
    case SchemaOp.CreateIndex(name, table, columns, unique)
      if !identifierValid(name) || schemaReserved(name) || !schemaTableValid(table) || columns.Length == 0
        return SchemaCompileResult.Failure("invalid index definition")
      end
      var names = ""
      var index = 0

      while index < columns.Length
        if !identifierValid(columns[index])
          return SchemaCompileResult.Failure("invalid index column")
        end
        var prior = 0

        while prior < index
          if schemaSameIdentifier(columns[prior], columns[index])
            return SchemaCompileResult.Failure("duplicate index column")
          end
          prior = prior + 1
        end
        names = names + (index == 0 ? "" : ", ") + schemaQuote(columns[index])
        index = index + 1
      end
      return SchemaCompileResult.Statement("CREATE " + (unique ? "UNIQUE " : "") + "INDEX " + schemaQuote(name) + " ON " + schemaQuote(table) + " (" + names + ")")
    case SchemaOp.DropIndex(name)
      if !identifierValid(name) || schemaReserved(name)
        return SchemaCompileResult.Failure("invalid or reserved index name")
      end
      return SchemaCompileResult.Statement("DROP INDEX " + schemaQuote(name))
    case SchemaOp.RebuildTable(before, after)
      return SchemaCompileResult.Failure("table rebuild requires SQLite provider execution")
  end
end
