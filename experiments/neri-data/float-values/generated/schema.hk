namespace float_data

## Describes the mapped tables and columns for schema comparison.
def schema_FloatDatabase(): neri_data::SchemaModel
  return new neri_data::SchemaModel([
      new neri_data::SchemaTable("float_model.Record", "float_records", [
          new neri_data::SchemaField("float_model.Record.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("float_model.Record.amount", new neri_data::SchemaColumn("amount", neri_data::SchemaType.Float(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("float_model.Record.optionalAmount", new neri_data::SchemaColumn("optional_amount", neri_data::SchemaType.Float(), nullable: true, primaryKey: false))
        ])
    ])
end
