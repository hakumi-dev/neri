use json
use result
use host
use arrays
namespace neri_data

def cellOptionalStrings(values: String[]?): Cell
  return values == null ? Cell.Null() : cellStrings(values)
end

def decodeNullableStrings(row: RawRow, column: String): DecodeResult<String[]?>
  let cell = cellFromRow(row, column)

  if cell != null
    match cell
      case Cell.Null()
        return DecodeResult<String[]?>.Value(null)
      case Cell.Int(unused)
      case Cell.Bool(unused)
      case Cell.Float(unused)
      case Cell.Text(unused)
      case Cell.Binary(unused)
    end
  end
  match decodeStrings(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<String[]?>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<String[]?>.Value(value)
  end
end

def cellOptionalInts(values: Int[]?): Cell
  return values == null ? Cell.Null() : cellInts(values)
end

def decodeNullableInts(row: RawRow, column: String): DecodeResult<Int[]?>
  let cell = cellFromRow(row, column)

  if cell != null
    match cell
      case Cell.Null()
        return DecodeResult<Int[]?>.Value(null)
      case Cell.Int(unused)
      case Cell.Bool(unused)
      case Cell.Float(unused)
      case Cell.Text(unused)
      case Cell.Binary(unused)
    end
  end
  match decodeInts(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Int[]?>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<Int[]?>.Value(value)
  end
end

def cellOptionalBools(values: Bool[]?): Cell
  return values == null ? Cell.Null() : cellBools(values)
end

def decodeNullableBools(row: RawRow, column: String): DecodeResult<Bool[]?>
  let cell = cellFromRow(row, column)

  if cell != null
    match cell
      case Cell.Null()
        return DecodeResult<Bool[]?>.Value(null)
      case Cell.Int(unused)
      case Cell.Bool(unused)
      case Cell.Float(unused)
      case Cell.Text(unused)
      case Cell.Binary(unused)
    end
  end
  match decodeBools(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Bool[]?>.Failure(error)
    case DecodeResult.Value(value)
      return DecodeResult<Bool[]?>.Value(value)
  end
end


def initialStrings(): String[]
  return []
end

def cellStrings(values: String[]): Cell
  let array = json::Json.array()

  for value in values
    array.add(json::Json.string(value))
  end
  match array.stringify()
    case result::Result.Ok(text)
      return Cell.Text(text)
    case result::Result.Error(error)
      return Cell.Bool(false)
  end
end

def decodeStrings(row: RawRow, column: String): DecodeResult<String[]>
  var text = ""

  match decodeString(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<String[]>.Failure(error)
    case DecodeResult.Value(value)
      text = value
  end
  match json::parse(text)
    case result::Result.Error(error)
      return DecodeResult<String[]>.Failure(QueryFailure.TypeMismatch(column, "JSON String array", "invalid JSON"))
    case result::Result.Ok(array)
      if array.kind() != "array"
        return DecodeResult<String[]>.Failure(QueryFailure.TypeMismatch(column, "JSON String array", array.kind()))
      end
      let values = arrays::generate<String>(array.count()) do |position|
        return ""
      end
      var index = 0

      while index < array.count()
        let item = array.at(index)
        let content = item == null ? null : item.text()

        if item == null || item.kind() != "string" || content == null
          return DecodeResult<String[]>.Failure(QueryFailure.TypeMismatch(
              column,
              "String array element",
              "incompatible JSON element"
            ))
        end
        values[index] = content
        index = index + 1
      end
      return DecodeResult<String[]>.Value(values)
  end
end

def initialInts(): Int[]
  return []
end

def cellInts(values: Int[]): Cell
  let array = json::Json.array()

  for value in values
    array.add(json::Json.integer(value))
  end
  match array.stringify()
    case result::Result.Ok(text)
      return Cell.Text(text)
    case result::Result.Error(error)
      return Cell.Bool(false)
  end
end

def decodeInts(row: RawRow, column: String): DecodeResult<Int[]>
  var text = ""

  match decodeString(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Int[]>.Failure(error)
    case DecodeResult.Value(value)
      text = value
  end
  match json::parse(text)
    case result::Result.Error(error)
      return DecodeResult<Int[]>.Failure(QueryFailure.TypeMismatch(column, "JSON Int array", "invalid JSON"))
    case result::Result.Ok(array)
      if array.kind() != "array"
        return DecodeResult<Int[]>.Failure(QueryFailure.TypeMismatch(column, "JSON Int array", array.kind()))
      end
      let values = arrays::generate<Int>(array.count()) do |position|
        return 0
      end
      var index = 0

      while index < array.count()
        let item = array.at(index)
        let content = item == null ? null : item.text()

        if item == null || item.kind() != "number" || content == null
          return DecodeResult<Int[]>.Failure(QueryFailure.TypeMismatch(
              column,
              "Int array element",
              "incompatible JSON element"
            ))
        end
        let value = host::parseInt(content)

        if value == null
          return DecodeResult<Int[]>.Failure(QueryFailure.TypeMismatch(
              column,
              "Int array element",
              "non-integral or overflowing number"
            ))
        end
        values[index] = value
        index = index + 1
      end
      return DecodeResult<Int[]>.Value(values)
  end
end

def initialBools(): Bool[]
  return []
end

def cellBools(values: Bool[]): Cell
  let array = json::Json.array()

  for value in values
    array.add(json::Json.boolean(value))
  end
  match array.stringify()
    case result::Result.Ok(text)
      return Cell.Text(text)
    case result::Result.Error(error)
      return Cell.Bool(false)
  end
end

def decodeBools(row: RawRow, column: String): DecodeResult<Bool[]>
  var text = ""

  match decodeString(row, column)
    case DecodeResult.Failure(error)
      return DecodeResult<Bool[]>.Failure(error)
    case DecodeResult.Value(value)
      text = value
  end
  match json::parse(text)
    case result::Result.Error(error)
      return DecodeResult<Bool[]>.Failure(QueryFailure.TypeMismatch(column, "JSON Bool array", "invalid JSON"))
    case result::Result.Ok(array)
      if array.kind() != "array"
        return DecodeResult<Bool[]>.Failure(QueryFailure.TypeMismatch(column, "JSON Bool array", array.kind()))
      end
      let values = arrays::generate<Bool>(array.count()) do |position|
        return false
      end
      var index = 0

      while index < array.count()
        let item = array.at(index)
        let content = item == null ? null : item.text()

        if item == null || item.kind() != "boolean" || content == null
          return DecodeResult<Bool[]>.Failure(QueryFailure.TypeMismatch(
              column,
              "Bool array element",
              "incompatible JSON element"
            ))
        end
        values[index] = content == "true"
        index = index + 1
      end
      return DecodeResult<Bool[]>.Value(values)
  end
end
