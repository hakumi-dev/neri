namespace chained_navigation_model

class Author
  public id: Int
  public name: String
  public books: Book[]

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
    this.books = []
  end
end

class Book
  public id: Int
  public authorId: Int
  public publisherId: Int?
  public title: String
  public author: Author?
  public publisher: Publisher?
  public pages: Page[]

  def init(id: Int, authorId: Int, publisherId: Int?, title: String): Void
    this.id = id
    this.authorId = authorId
    this.publisherId = publisherId
    this.title = title
    this.author = null
    this.publisher = null
    this.pages = []
  end
end

class Page
  public id: Int
  public bookId: Int
  public body: String
  public book: Book?

  def init(id: Int, bookId: Int, body: String): Void
    this.id = id
    this.bookId = bookId
    this.body = body
    this.book = null
  end
end

class Publisher
  public id: Int
  public name: String
  public books: Book[]

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
    this.books = []
  end
end
