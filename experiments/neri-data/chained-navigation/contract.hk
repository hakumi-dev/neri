use console
use files
use resources
use result
use test
use reference
use chained_navigation_data
use chained_navigation_model
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture

class CountingProvider: Provider
  private inner: SQLiteProvider
  public reads: Int = 0
  public streams: Int = 0

  def init(inner: SQLiteProvider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.inner.supports(capability)
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.reads = this.reads + 1
    return this.inner.execute(plan)
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.streams = this.streams + 1
    return this.inner.stream(plan, visit)
  end
end

def loaded(result: QueryResult<Author>): TypedRows<Author>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      console::println("unexpected chained-navigation query failure")

      test::assertTrue(false)
      return null
  end
end

def failed(result: QueryResult<Author>): Void
  match result
    case QueryResult.Failure(error)
      return
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
end

def authorAt(rows: TypedRows<Author>, id: Int): Author?
  var current = rows.first()

  while current != null
    if current.value.id == id
      return current.value
    end
    current = current.next
  end
  return null
end

def bookAt(author: Author, id: Int): Book?
  for book in author.books
    if book.id == id
      return book
    end
  end
  return null
end

def sameBookArrayStorage(alias: Book[], current: Book[], first: Book, second: Book): Bool
  alias[0] = second
  let sharesStorage = reference::same(current[0], second)

  alias[0] = first
  return sharesStorage
end

def samePageArrayStorage(alias: Page[], current: Page[], first: Page, second: Page): Bool
  alias[0] = second
  let sharesStorage = reference::same(current[0], second)

  alias[0] = first
  return sharesStorage
end

def verifyGraph(provider: SQLiteProvider, path: String): Void
  console::println("Chained navigation: nested collections, reference sibling, optional null and identity")
  let counted = new CountingProvider(provider)
  let db = new ChainedNavigationDatabase(counted)
  let booksStep = db.collectionStep_booksFor_Author_by_authorId()
  let pagesStep = db.collectionStep_pagesFor_Book_by_bookId()
  let publisherStep = db.referenceStep_booksFor_Publisher_by_publisherId()
  let publisherBooksStep = db.collectionStep_booksFor_Publisher_by_publisherId()
  let plan = includePath(db.authors.take(3), booksStep).thenInclude(publisherStep).thenInclude(publisherBooksStep).include(booksStep).thenInclude(pagesStep)
  let rows = loaded(plan.all())

  test::assertTrue(rows != null)
  if rows == null
    return
  end

  test::assertEqual(rows.count(), 3)
  let ada = authorAt(rows, 1)
  let empty = authorAt(rows, 2)
  let nullPublisher = authorAt(rows, 3)

  test::assertTrue(ada != null && empty != null && nullPublisher != null)
  if ada == null || empty == null || nullPublisher == null
    return
  end

  test::assertEqual(ada.books.Length, 2)
  test::assertEqual(empty.books.Length, 0)
  test::assertEqual(nullPublisher.books.Length, 1)
  let firstBook = bookAt(ada, 10)
  let secondBook = bookAt(ada, 11)
  let lastBook = bookAt(nullPublisher, 12)

  test::assertTrue(firstBook != null && secondBook != null && lastBook != null)
  if firstBook == null || secondBook == null || lastBook == null
    return
  end

  test::assertEqual(firstBook.pages.Length, 2)
  test::assertEqual(secondBook.pages.Length, 1)
  test::assertEqual(lastBook.pages.Length, 0)
  let firstPage = firstBook.pages[0]
  let secondPage = secondBook.pages[0]

  let firstPageBook = firstPage.book
  let secondPageBook = secondPage.book
  let firstBookAuthor = firstBook.author

  test::assertTrue(firstPageBook != null && secondPageBook != null && firstBookAuthor != null)
  if firstPageBook == null || secondPageBook == null || firstBookAuthor == null
    return
  end

  test::assertTrue(reference::same(firstPageBook, firstBook))
  test::assertTrue(reference::same(secondPageBook, secondBook))
  test::assertTrue(reference::same(firstBookAuthor, ada))
  let sharedPublisher = firstBook.publisher
  let otherPublisher = secondBook.publisher

  test::assertTrue(sharedPublisher != null && otherPublisher != null)
  if sharedPublisher == null || otherPublisher == null
    return
  end

  test::assertTrue(reference::same(sharedPublisher, otherPublisher))
  test::assertEqual(sharedPublisher.books.Length, 2)
  test::assertTrue(reference::same(sharedPublisher.books[0], firstBook) || reference::same(sharedPublisher.books[1], firstBook))
  test::assertTrue(reference::same(sharedPublisher.books[0], secondBook) || reference::same(sharedPublisher.books[1], secondBook))
  test::assertTrue(lastBook.publisher == null)
  test::assertTrue(lastBook.publisherId == null)

  ada.name = "pending local author edit"
  let repeated = loaded(plan.all())

  test::assertTrue(repeated != null)
  test::assertEqual(ada.name, "pending local author edit")
  if repeated != null
    let repeatedAda = authorAt(repeated, 1)

    test::assertTrue(repeatedAda != null)
    if repeatedAda != null
      test::assertTrue(reference::same(repeatedAda, ada))
      let repeatedFirstBook = bookAt(repeatedAda, 10)

      test::assertTrue(repeatedFirstBook != null)
      if repeatedFirstBook != null
        test::assertTrue(reference::same(repeatedFirstBook, firstBook))
        test::assertTrue(reference::same(repeatedFirstBook.pages[0], firstPage))
      end
    end
  end

  test::assertEqual(ada.books.Length, 2)
  test::assertEqual(firstBook.pages.Length, 2)
  test::assertEqual(sharedPublisher.books.Length, 2)

  let originalBooks = ada.books
  let originalPages = firstBook.pages
  let originalBooksFirst = originalBooks[0]
  let originalBooksSecond = originalBooks[1]
  let originalPagesFirst = originalPages[0]
  let originalPagesSecond = originalPages[1]
  let originalPublisherBooks = sharedPublisher.books
  let originalPublisherFirst = originalPublisherBooks[0]
  let originalPublisherSecond = originalPublisherBooks[1]

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO pages(id,book_id,body) VALUES(999,10,NULL);"))
  let freshDb = new ChainedNavigationDatabase(counted)
  let freshRoots = loaded(freshDb.authors.take(3).all())

  test::assertTrue(freshRoots != null)
  if freshRoots != null
    let freshAda = authorAt(freshRoots, 1)

    test::assertTrue(freshAda != null)
    if freshAda != null
      test::assertEqual(freshAda.books.Length, 0)
      let freshBooks = freshDb.collectionStep_booksFor_Author_by_authorId()
      let freshPages = freshDb.collectionStep_pagesFor_Book_by_bookId()
      let freshPublisher = freshDb.referenceStep_booksFor_Publisher_by_publisherId()
      let freshPublisherBooks = freshDb.collectionStep_booksFor_Publisher_by_publisherId()
      let freshPlan = includePath(freshDb.authors.take(3), freshBooks).thenInclude(freshPublisher).thenInclude(freshPublisherBooks).include(freshBooks).thenInclude(freshPages)
      let streamsBeforeFailure = counted.streams

      failed(freshPlan.load(freshRoots))

      test::assertEqual(counted.streams, streamsBeforeFailure + 5)
      test::assertEqual(freshAda.books.Length, 0)
      match freshDb.books.where(id: 10).first()
        case QueryValue.Failure(error)
          test::assertTrue(false)
        case QueryValue.Value(maybeLoadedBook)
          test::assertTrue(maybeLoadedBook != null)
          if maybeLoadedBook != null
            test::assertTrue(maybeLoadedBook.author == null)
            test::assertTrue(maybeLoadedBook.publisher == null)
            test::assertEqual(maybeLoadedBook.pages.Length, 0)
          end
      end
      match freshDb.publishers.where(id: 7).first()
        case QueryValue.Failure(error)
          test::assertTrue(false)
        case QueryValue.Value(maybeLoadedPublisher)
          test::assertTrue(maybeLoadedPublisher != null)
          if maybeLoadedPublisher != null
            test::assertEqual(maybeLoadedPublisher.books.Length, 0)
          end
      end
    end
  end

  failed(plan.all())

  test::assertEqual(ada.name, "pending local author edit")
  test::assertTrue(sameBookArrayStorage(originalBooks, ada.books, originalBooksFirst, originalBooksSecond))
  test::assertTrue(samePageArrayStorage(originalPages, firstBook.pages, originalPagesFirst, originalPagesSecond))
  test::assertTrue(sameBookArrayStorage(originalPublisherBooks, sharedPublisher.books, originalPublisherFirst, originalPublisherSecond))
  test::assertTrue(reference::same(ada.books[0], firstBook) || reference::same(ada.books[1], firstBook))
  test::assertTrue(reference::same(firstBook.pages[0], firstPage))
  let restoredAuthor = firstBook.author
  let restoredPublisher = firstBook.publisher

  test::assertTrue(restoredAuthor != null && restoredPublisher != null)
  if restoredAuthor != null && restoredPublisher != null
    test::assertTrue(reference::same(restoredAuthor, ada))
    test::assertTrue(reference::same(restoredPublisher, sharedPublisher))
  end

  test::assertEqual(sharedPublisher.books.Length, 2)
  test::assertTrue(createSQLiteFixture(path, "DELETE FROM pages WHERE id = 999;"))
  let recovered = loaded(plan.all())

  test::assertTrue(recovered != null)
  if recovered != null
    let recoveredAda = authorAt(recovered, 1)

    test::assertTrue(recoveredAda != null)
    if recoveredAda != null
      test::assertTrue(reference::same(recoveredAda, ada))
    end
  end

  test::assertTrue(reference::same(firstBook.pages[0], firstPage))

  let emptyRows = loaded(includePath(db.authors.where(id: 999).take(1), booksStep).thenInclude(pagesStep).all())

  test::assertTrue(emptyRows != null)
  if emptyRows != null
    test::assertEqual(emptyRows.count(), 0)
  end

end

def verifyWrongContext(provider: SQLiteProvider): Void
  console::println("Chained navigation: late foreign-context step rejects before root execution")
  let counted = new CountingProvider(provider)
  let root = new ChainedNavigationDatabase(counted)
  let local = new ChainedNavigationDatabase(counted)
  let existingRows = loaded(root.authors.take(1).all())

  test::assertTrue(existingRows != null)
  if existingRows == null
    return
  end
  let readsBefore = counted.reads
  let streamsBefore = counted.streams
  let firstStep = root.collectionStep_booksFor_Author_by_authorId()
  let foreignStep = local.collectionStep_pagesFor_Book_by_bookId()
  let plan = includePath(root.authors.take(1), firstStep).thenInclude(foreignStep)

  test::assertEqual(counted.reads, readsBefore)
  test::assertEqual(counted.streams, streamsBefore)
  failed(plan.load(existingRows))
  failed(plan.all())

  test::assertEqual(counted.reads, readsBefore)
  test::assertEqual(counted.streams, streamsBefore)
end

def verifyBatch(path: String): Void
  console::println("Chained navigation: per-level batching and optional reference query counts")
  let sql = "CREATE TABLE authors(id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE publishers(id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE books(id INTEGER PRIMARY KEY, author_id INTEGER NOT NULL REFERENCES authors(id), publisher_id INTEGER REFERENCES publishers(id), title TEXT NOT NULL); CREATE TABLE pages(id INTEGER PRIMARY KEY, book_id INTEGER NOT NULL REFERENCES books(id), body TEXT); INSERT INTO publishers VALUES(1,'shared'); WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 51) INSERT INTO authors SELECT id,'author' FROM n; INSERT INTO books SELECT id,id,1,'book' FROM authors; INSERT INTO pages SELECT id,id,'page' FROM authors;"

  test::assertTrue(createSQLiteFixture(path, sql))
  match SQLiteProvider.open(path)
    case SQLiteOpenResult.Failure(message)
      console::println(message)

      test::assertTrue(false)
    case SQLiteOpenResult.Opened(provider)
      let counted = new CountingProvider(provider)
      let db = new ChainedNavigationDatabase(counted)
      let booksStep = db.collectionStep_booksFor_Author_by_authorId()
      let pagesStep = db.collectionStep_pagesFor_Book_by_bookId()
      let publisherStep = db.referenceStep_booksFor_Publisher_by_publisherId()
      let publisherBooksStep = db.collectionStep_booksFor_Publisher_by_publisherId()
      let rows = loaded(includePath(db.authors.take(51), booksStep).thenInclude(publisherStep).thenInclude(publisherBooksStep).include(booksStep).thenInclude(pagesStep).all())

      test::assertTrue(rows != null)
      if rows != null
        test::assertEqual(rows.count(), 51)
        var parent = rows.first()
        var pageTotal = 0
        var bookTotal = 0

        while parent != null
          test::assertEqual(parent.value.books.Length, 1)
          bookTotal = bookTotal + parent.value.books.Length
          pageTotal = pageTotal + parent.value.books[0].pages.Length

          test::assertTrue(parent.value.books[0].publisher != null)
          parent = parent.next
        end

        test::assertEqual(bookTotal, 51)
        test::assertEqual(pageTotal, 51)
      end

      test::assertEqual(counted.reads, 1)
      test::assertEqual(counted.streams, 8)
      test::assertTrue(provider.close())
  end
end

def verifyFile(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-chained-navigation-")
    let path = temporary.path() + "/navigation.sqlite"
    let sql = "CREATE TABLE authors(id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE publishers(id INTEGER PRIMARY KEY, name TEXT NOT NULL); CREATE TABLE books(id INTEGER PRIMARY KEY, author_id INTEGER NOT NULL REFERENCES authors(id), publisher_id INTEGER REFERENCES publishers(id), title TEXT NOT NULL); CREATE TABLE pages(id INTEGER PRIMARY KEY, book_id INTEGER NOT NULL REFERENCES books(id), body TEXT); INSERT INTO authors VALUES(1,'Ada'),(2,'empty'),(3,'null publisher'); INSERT INTO publishers VALUES(7,'Shared'); INSERT INTO books VALUES(10,1,7,'first'),(11,1,7,'second'),(12,3,NULL,'unpublished'); INSERT INTO pages VALUES(100,10,'first page'),(101,10,'second page'),(110,11,'third page');"

    test::assertTrue(createSQLiteFixture(path, sql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Failure(message)
        console::println(message)

        test::assertTrue(false)
      case SQLiteOpenResult.Opened(provider)
        verifyGraph(provider, path)
        verifyWrongContext(provider)
        verifyTrackerBoundary(provider)

        test::assertTrue(provider.close())
    end
    verifyBatch(temporary.path() + "/batch.sqlite")
    return 0
  end
  return 1
end

def main(): Void
  let outcome = verifyFile()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(problem)
      test::assertTrue(false)
  end
end
