use test
use chained_navigation_data
use chained_navigation_model
use neri_data
use neri_data_sqlite

## A step must use the root's tracker even when provider and context match.
def verifyTrackerBoundary(provider: SQLiteProvider): Void
  let counted = new CountingProvider(provider)
  let changes = new ChangeContext(counted)
  let authorColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int(), false), new ResultColumn("name", ResultColumnKind.Text(), false)])
  let bookColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int(), false), new ResultColumn("author_id", ResultColumnKind.Int(), false), new ResultColumn("publisher_id", ResultColumnKind.Int(), true), new ResultColumn("title", ResultColumnKind.Text(), false)])
  let rootTracker = new EntityTracker<Author>("authors", "id", authorColumns, capture_Author, apply_Author)
  let otherTracker = new EntityTracker<Author>("authors", "id", authorColumns, capture_Author, apply_Author)
  let bookTracker = new EntityTracker<Book>("books", "id", bookColumns, capture_Book, apply_Book)
  let root = new Query<Author>("authors", new Decoder<Author>(decodeEntity_6_Author, authorColumns), mapping: mappingEntity_6_Author(), provider: counted, tracker: rootTracker, changes: changes).take(1)
  let alternate = new Query<Author>("authors", new Decoder<Author>(decodeEntity_6_Author, authorColumns), mapping: mappingEntity_6_Author(), provider: counted, tracker: otherTracker, changes: changes)
  let books = new Query<Book>("books", new Decoder<Book>(decodeEntity_4_Book, bookColumns), mapping: mappingEntity_4_Book(), provider: counted, tracker: bookTracker, changes: changes)
  let navigation = new CollectionNavigation<Author, Book>(nav_principal_key_booksFor_Author_by_authorId, nav_dependent_key_booksFor_Author_by_authorId, nav_foreign_key_booksFor_Author_by_authorId, "author_id", nav_get_collection_booksFor_Author_by_authorId, nav_set_collection_booksFor_Author_by_authorId, nav_get_reference_booksFor_Author_by_authorId, nav_set_reference_booksFor_Author_by_authorId)
  let step = collectionStep(alternate, books, navigation)

  match includePath(root, step).all()
    case QueryResult.Failure(error)
      var trackerFailure = false

      match error
        case QueryFailure.UnsupportedCapability(message)
          trackerFailure = message != ""
        case QueryFailure.InvalidIdentifier(name)
        case QueryFailure.InvalidLimit(value, maximum)
        case QueryFailure.MissingLimit(maximum)
        case QueryFailure.SourceMismatch(expected, actual)
        case QueryFailure.Provider(message)
        case QueryFailure.MissingColumn(name)
        case QueryFailure.TypeMismatch(column, expected, actual)
        case QueryFailure.Cardinality(expected, actual)
      end

      test::assertTrue(trackerFailure)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end

  test::assertEqual(counted.reads, 0)
  test::assertEqual(counted.streams, 0)
end
