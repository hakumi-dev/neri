namespace chained_navigation_data

class Navigation_ChainedNavigationDatabase
  public authors: NavigationSet_ChainedNavigationDatabase_Author
  public books: NavigationSet_ChainedNavigationDatabase_Book
  public pages: NavigationSet_ChainedNavigationDatabase_Page
  public publishers: NavigationSet_ChainedNavigationDatabase_Publisher

  def init(context: ChainedNavigationDatabase): Void
    this.authors = new NavigationSet_ChainedNavigationDatabase_Author(context)
    this.books = new NavigationSet_ChainedNavigationDatabase_Book(context)
    this.pages = new NavigationSet_ChainedNavigationDatabase_Page(context)
    this.publishers = new NavigationSet_ChainedNavigationDatabase_Publisher(context)
  end
end
