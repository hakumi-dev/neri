use reference
namespace chained_navigation_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_ChainedNavigationDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Author: neri_data::EntityTracker<chained_navigation_model::Author>
  private visits_Author: neri_data::GraphVisitList<chained_navigation_model::Author>
  private tracker_Book: neri_data::EntityTracker<chained_navigation_model::Book>
  private visits_Book: neri_data::GraphVisitList<chained_navigation_model::Book>
  private tracker_Page: neri_data::EntityTracker<chained_navigation_model::Page>
  private visits_Page: neri_data::GraphVisitList<chained_navigation_model::Page>
  private tracker_Publisher: neri_data::EntityTracker<chained_navigation_model::Publisher>
  private visits_Publisher: neri_data::GraphVisitList<chained_navigation_model::Publisher>

  def init(changes: neri_data::ChangeContext, tracker_Author: neri_data::EntityTracker<chained_navigation_model::Author>, tracker_Book: neri_data::EntityTracker<chained_navigation_model::Book>, tracker_Page: neri_data::EntityTracker<chained_navigation_model::Page>, tracker_Publisher: neri_data::EntityTracker<chained_navigation_model::Publisher>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Author = tracker_Author
    this.visits_Author = new neri_data::GraphVisitList<chained_navigation_model::Author>(this.graph)
    this.tracker_Book = tracker_Book
    this.visits_Book = new neri_data::GraphVisitList<chained_navigation_model::Book>(this.graph)
    this.tracker_Page = tracker_Page
    this.visits_Page = new neri_data::GraphVisitList<chained_navigation_model::Page>(this.graph)
    this.tracker_Publisher = tracker_Publisher
    this.visits_Publisher = new neri_data::GraphVisitList<chained_navigation_model::Publisher>(this.graph)
  end

  def add_authors(root: chained_navigation_model::Author): neri_data::TrackHandleResult<chained_navigation_model::Author>
    match this.discover_authors(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<chained_navigation_model::Author>.Failure(error)
    end
  end

  private def discover_authors(entity: chained_navigation_model::Author): neri_data::GraphVisitResult<chained_navigation_model::Author>
    match this.visits_Author.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<chained_navigation_model::Author>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<chained_navigation_model::Author>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Author)

        if staged != null
          return neri_data::GraphVisitResult<chained_navigation_model::Author>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_authors(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<chained_navigation_model::Author>.Failure(queued)
        end
        return neri_data::GraphVisitResult<chained_navigation_model::Author>.New(slot)
    end
  end

  private def scan_authors(entity: chained_navigation_model::Author, owner: neri_data::GraphSlot<chained_navigation_model::Author>): neri_data::QueryFailure?
    for child in entity.books
      let inverse = child.author

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: booksFor_Author_by_authorId")
      end
      var related: neri_data::GraphSlot<chained_navigation_model::Book>? = null

      match this.discover_books(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Author_by_authorId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_books(root: chained_navigation_model::Book): neri_data::TrackHandleResult<chained_navigation_model::Book>
    match this.discover_books(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<chained_navigation_model::Book>.Failure(error)
    end
  end

  private def discover_books(entity: chained_navigation_model::Book): neri_data::GraphVisitResult<chained_navigation_model::Book>
    match this.visits_Book.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<chained_navigation_model::Book>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<chained_navigation_model::Book>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Book)

        if staged != null
          return neri_data::GraphVisitResult<chained_navigation_model::Book>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_books(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<chained_navigation_model::Book>.Failure(queued)
        end
        return neri_data::GraphVisitResult<chained_navigation_model::Book>.New(slot)
    end
  end

  private def scan_books(entity: chained_navigation_model::Book, owner: neri_data::GraphSlot<chained_navigation_model::Book>): neri_data::QueryFailure?
    let principal_booksFor_Author_by_authorId = entity.author

    if principal_booksFor_Author_by_authorId != null
      var related: neri_data::GraphSlot<chained_navigation_model::Author>? = null

      match this.discover_authors(principal_booksFor_Author_by_authorId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Author_by_authorId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    for child in entity.pages
      let inverse = child.book

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: pagesFor_Book_by_bookId")
      end
      var related: neri_data::GraphSlot<chained_navigation_model::Page>? = null

      match this.discover_pages(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_pagesFor_Book_by_bookId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    let principal_booksFor_Publisher_by_publisherId = entity.publisher

    if principal_booksFor_Publisher_by_publisherId != null
      var related: neri_data::GraphSlot<chained_navigation_model::Publisher>? = null

      match this.discover_publishers(principal_booksFor_Publisher_by_publisherId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Publisher_by_publisherId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_pages(root: chained_navigation_model::Page): neri_data::TrackHandleResult<chained_navigation_model::Page>
    match this.discover_pages(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<chained_navigation_model::Page>.Failure(error)
    end
  end

  private def discover_pages(entity: chained_navigation_model::Page): neri_data::GraphVisitResult<chained_navigation_model::Page>
    match this.visits_Page.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<chained_navigation_model::Page>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<chained_navigation_model::Page>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Page)

        if staged != null
          return neri_data::GraphVisitResult<chained_navigation_model::Page>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_pages(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<chained_navigation_model::Page>.Failure(queued)
        end
        return neri_data::GraphVisitResult<chained_navigation_model::Page>.New(slot)
    end
  end

  private def scan_pages(entity: chained_navigation_model::Page, owner: neri_data::GraphSlot<chained_navigation_model::Page>): neri_data::QueryFailure?
    let principal_pagesFor_Book_by_bookId = entity.book

    if principal_pagesFor_Book_by_bookId != null
      var related: neri_data::GraphSlot<chained_navigation_model::Book>? = null

      match this.discover_books(principal_pagesFor_Book_by_bookId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_pagesFor_Book_by_bookId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_publishers(root: chained_navigation_model::Publisher): neri_data::TrackHandleResult<chained_navigation_model::Publisher>
    match this.discover_publishers(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<chained_navigation_model::Publisher>.Failure(error)
    end
  end

  private def discover_publishers(entity: chained_navigation_model::Publisher): neri_data::GraphVisitResult<chained_navigation_model::Publisher>
    match this.visits_Publisher.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<chained_navigation_model::Publisher>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<chained_navigation_model::Publisher>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Publisher)

        if staged != null
          return neri_data::GraphVisitResult<chained_navigation_model::Publisher>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_publishers(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<chained_navigation_model::Publisher>.Failure(queued)
        end
        return neri_data::GraphVisitResult<chained_navigation_model::Publisher>.New(slot)
    end
  end

  private def scan_publishers(entity: chained_navigation_model::Publisher, owner: neri_data::GraphSlot<chained_navigation_model::Publisher>): neri_data::QueryFailure?
    for child in entity.books
      let inverse = child.publisher

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: booksFor_Publisher_by_publisherId")
      end
      var related: neri_data::GraphSlot<chained_navigation_model::Book>? = null

      match this.discover_books(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_booksFor_Publisher_by_publisherId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  private def link_booksFor_Author_by_authorId(principal: neri_data::GraphSlot<chained_navigation_model::Author>, dependent: neri_data::GraphSlot<chained_navigation_model::Book>, entity: chained_navigation_model::Book): neri_data::QueryFailure?
    let previous = entity.authorId
    let restore: fn(): Void = fn(): Void
      entity.authorId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_booksFor_Author_by_authorId, restore)
  end

  private def link_pagesFor_Book_by_bookId(principal: neri_data::GraphSlot<chained_navigation_model::Book>, dependent: neri_data::GraphSlot<chained_navigation_model::Page>, entity: chained_navigation_model::Page): neri_data::QueryFailure?
    let previous = entity.bookId
    let restore: fn(): Void = fn(): Void
      entity.bookId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_pagesFor_Book_by_bookId, restore)
  end

  private def link_booksFor_Publisher_by_publisherId(principal: neri_data::GraphSlot<chained_navigation_model::Publisher>, dependent: neri_data::GraphSlot<chained_navigation_model::Book>, entity: chained_navigation_model::Book): neri_data::QueryFailure?
    let previous = entity.publisherId
    let restore: fn(): Void = fn(): Void
      entity.publisherId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_booksFor_Publisher_by_publisherId, restore)
  end
end
