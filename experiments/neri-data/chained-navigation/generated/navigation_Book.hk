namespace chained_navigation_data

class NavigationSet_ChainedNavigationDatabase_Book
  public author: neri_data::NavigationStep<chained_navigation_model::Book, chained_navigation_model::Author>
  public pages: neri_data::NavigationStep<chained_navigation_model::Book, chained_navigation_model::Page>
  public publisher: neri_data::NavigationStep<chained_navigation_model::Book, chained_navigation_model::Publisher>

  def init(context: ChainedNavigationDatabase): Void
    this.author = context.referenceStep_booksFor_Author_by_authorId()
    this.pages = context.collectionStep_pagesFor_Book_by_bookId()
    this.publisher = context.referenceStep_booksFor_Publisher_by_publisherId()
  end
end
