namespace neri_data

enum DriverErrorKind
  case Contention()
  case Constraint()
  case Interrupted()
  case ReadOnly()
  case StorageFull()
  case Io()
  case Corrupt()
  case Other()
end

class DriverError
  private storedProvider: String
  private storedOperation: String
  private storedKind: DriverErrorKind
  private storedPrimaryCode: Int?
  private storedExtendedCode: Int?
  private storedSqlState: String?
  private storedMessage: String

  public def init(provider: String, operation: String, kind: DriverErrorKind, primaryCode: Int?, extendedCode: Int?, sqlState: String?, message: String): Void
    this.storedProvider = provider
    this.storedOperation = operation
    this.storedKind = kind
    this.storedPrimaryCode = primaryCode
    this.storedExtendedCode = extendedCode
    this.storedSqlState = sqlState
    this.storedMessage = message
  end

  public readonly def provider(): String
    return this.storedProvider
  end

  public readonly def operation(): String
    return this.storedOperation
  end

  public def kind(): DriverErrorKind
    return this.storedKind
  end

  public readonly def primaryCode(): Int?
    return this.storedPrimaryCode
  end

  public readonly def extendedCode(): Int?
    return this.storedExtendedCode
  end

  public readonly def sqlState(): String?
    return this.storedSqlState
  end

  public readonly def message(): String
    return this.storedMessage
  end
end

enum ProviderFailure
  case State(message: String)
  case Driver(error: DriverError)
  case Cleanup(error: ProviderCleanupFailure)
end

class ProviderCleanupFailure
  private storedPrimary: ProviderFailure
  private storedCleanup: ProviderFailure

  public def init(primary: ProviderFailure, cleanup: ProviderFailure): Void
    this.storedPrimary = primary
    this.storedCleanup = cleanup
  end

  public def primary(): ProviderFailure
    return this.storedPrimary
  end

  public def cleanup(): ProviderFailure
    return this.storedCleanup
  end
end

## Retains a query failure when closing its streaming provider also fails.
class QueryCleanupFailure
  private storedPrimary: QueryFailure
  private storedCleanup: ProviderFailure

  public def init(primary: QueryFailure, cleanup: ProviderFailure): Void
    this.storedPrimary = primary
    this.storedCleanup = cleanup
  end

  public def primary(): QueryFailure
    return this.storedPrimary
  end

  public def cleanup(): ProviderFailure
    return this.storedCleanup
  end
end

## Retains a migration failure when rollback/close cleanup also fails.
class MigrationCleanupFailure
  private storedPrimary: MigrationFailure
  private storedCleanup: ProviderFailure

  public def init(primary: MigrationFailure, cleanup: ProviderFailure): Void
    this.storedPrimary = primary
    this.storedCleanup = cleanup
  end

  public def primary(): MigrationFailure
    return this.storedPrimary
  end

  public def cleanup(): ProviderFailure
    return this.storedCleanup
  end
end

class WriteCleanupFailure
  private storedPrimary: WriteFailure
  private storedCleanup: WriteFailure

  public def init(primary: WriteFailure, cleanup: WriteFailure): Void
    this.storedPrimary = primary
    this.storedCleanup = cleanup
  end

  public def primary(): WriteFailure
    return this.storedPrimary
  end

  public def cleanup(): WriteFailure
    return this.storedCleanup
  end
end

def providerFailureMessage(error: ProviderFailure): String
  match error
    case ProviderFailure.State(message)
      return message
    case ProviderFailure.Driver(driver)
      return driver.message()
    case ProviderFailure.Cleanup(failure)
      return providerFailureMessage(failure.primary()) + "; cleanup failed: " + providerFailureMessage(failure.cleanup())
  end
end
