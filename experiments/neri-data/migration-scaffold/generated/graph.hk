use reference
namespace migration_scaffold_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_MigrationScaffoldDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Item: neri_data::EntityTracker<migration_scaffold_model::Item>
  private visits_Item: neri_data::GraphVisitList<migration_scaffold_model::Item>

  def init(changes: neri_data::ChangeContext, tracker_Item: neri_data::EntityTracker<migration_scaffold_model::Item>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Item = tracker_Item
    this.visits_Item = new neri_data::GraphVisitList<migration_scaffold_model::Item>(this.graph)
  end

  def add_items(root: migration_scaffold_model::Item): neri_data::TrackHandleResult<migration_scaffold_model::Item>
    match this.discover_items(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<migration_scaffold_model::Item>.Failure(error)
    end
  end

  private def discover_items(entity: migration_scaffold_model::Item): neri_data::GraphVisitResult<migration_scaffold_model::Item>
    match this.visits_Item.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<migration_scaffold_model::Item>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<migration_scaffold_model::Item>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Item)

        if staged != null
          return neri_data::GraphVisitResult<migration_scaffold_model::Item>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_items(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<migration_scaffold_model::Item>.Failure(queued)
        end
        return neri_data::GraphVisitResult<migration_scaffold_model::Item>.New(slot)
    end
  end

  private def scan_items(entity: migration_scaffold_model::Item, owner: neri_data::GraphSlot<migration_scaffold_model::Item>): neri_data::QueryFailure?
    return null
  end
end
