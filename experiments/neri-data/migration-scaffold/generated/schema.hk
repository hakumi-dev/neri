      new neri_data::SchemaTable("migration_scaffold_model.Item", "items", [
          new neri_data::SchemaField("migration_scaffold_model.Item.id", new neri_data::SchemaColumn("id", neri_data::SchemaType.Int(), nullable: false, primaryKey: true)),
          new neri_data::SchemaField("migration_scaffold_model.Item.label", new neri_data::SchemaColumn("label", neri_data::SchemaType.Text(), nullable: false, primaryKey: false)),
          new neri_data::SchemaField("migration_scaffold_model.Item.amount", new neri_data::SchemaColumn("amount", neri_data::SchemaType.Float(), nullable: false, primaryKey: false, defaultValue: neri_data::SchemaDefault.Float(1.25)))
        ], [
          new neri_data::SchemaIndex("items_label_amount", ["migration_scaffold_model.Item.label", "migration_scaffold_model.Item.amount"], false)
        ])
    ])
