use reference
namespace reference_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_ReferenceDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Group: neri_data::EntityTracker<reference_model::Group>
  private visits_Group: neri_data::GraphVisitList<reference_model::Group>
  private tracker_Item: neri_data::EntityTracker<reference_model::Item>
  private visits_Item: neri_data::GraphVisitList<reference_model::Item>
  private tracker_Label: neri_data::EntityTracker<reference_model::Label>
  private visits_Label: neri_data::GraphVisitList<reference_model::Label>
  private tracker_Tagged: neri_data::EntityTracker<reference_model::Tagged>
  private visits_Tagged: neri_data::GraphVisitList<reference_model::Tagged>
  private tracker_TreeNode: neri_data::EntityTracker<reference_model::TreeNode>
  private visits_TreeNode: neri_data::GraphVisitList<reference_model::TreeNode>

  def init(changes: neri_data::ChangeContext, tracker_Group: neri_data::EntityTracker<reference_model::Group>, tracker_Item: neri_data::EntityTracker<reference_model::Item>, tracker_Label: neri_data::EntityTracker<reference_model::Label>, tracker_Tagged: neri_data::EntityTracker<reference_model::Tagged>, tracker_TreeNode: neri_data::EntityTracker<reference_model::TreeNode>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Group = tracker_Group
    this.visits_Group = new neri_data::GraphVisitList<reference_model::Group>(this.graph)
    this.tracker_Item = tracker_Item
    this.visits_Item = new neri_data::GraphVisitList<reference_model::Item>(this.graph)
    this.tracker_Label = tracker_Label
    this.visits_Label = new neri_data::GraphVisitList<reference_model::Label>(this.graph)
    this.tracker_Tagged = tracker_Tagged
    this.visits_Tagged = new neri_data::GraphVisitList<reference_model::Tagged>(this.graph)
    this.tracker_TreeNode = tracker_TreeNode
    this.visits_TreeNode = new neri_data::GraphVisitList<reference_model::TreeNode>(this.graph)
  end

  def add_groups(root: reference_model::Group): neri_data::TrackHandleResult<reference_model::Group>
    match this.discover_groups(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<reference_model::Group>.Failure(error)
    end
  end

  private def discover_groups(entity: reference_model::Group): neri_data::GraphVisitResult<reference_model::Group>
    match this.visits_Group.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<reference_model::Group>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<reference_model::Group>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Group)

        if staged != null
          return neri_data::GraphVisitResult<reference_model::Group>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_groups(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<reference_model::Group>.Failure(queued)
        end
        return neri_data::GraphVisitResult<reference_model::Group>.New(slot)
    end
  end

  private def scan_groups(entity: reference_model::Group, owner: neri_data::GraphSlot<reference_model::Group>): neri_data::QueryFailure?
    for child in entity.items
      let inverse = child.group

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: itemsFor_Group_by_groupId")
      end
      var related: neri_data::GraphSlot<reference_model::Item>? = null

      match this.discover_items(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Group_by_groupId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_items(root: reference_model::Item): neri_data::TrackHandleResult<reference_model::Item>
    match this.discover_items(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<reference_model::Item>.Failure(error)
    end
  end

  private def discover_items(entity: reference_model::Item): neri_data::GraphVisitResult<reference_model::Item>
    match this.visits_Item.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<reference_model::Item>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<reference_model::Item>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Item)

        if staged != null
          return neri_data::GraphVisitResult<reference_model::Item>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_items(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<reference_model::Item>.Failure(queued)
        end
        return neri_data::GraphVisitResult<reference_model::Item>.New(slot)
    end
  end

  private def scan_items(entity: reference_model::Item, owner: neri_data::GraphSlot<reference_model::Item>): neri_data::QueryFailure?
    let principal_itemsFor_Group_by_groupId = entity.group

    if principal_itemsFor_Group_by_groupId != null
      var related: neri_data::GraphSlot<reference_model::Group>? = null

      match this.discover_groups(principal_itemsFor_Group_by_groupId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_itemsFor_Group_by_groupId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_labels(root: reference_model::Label): neri_data::TrackHandleResult<reference_model::Label>
    match this.discover_labels(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<reference_model::Label>.Failure(error)
    end
  end

  private def discover_labels(entity: reference_model::Label): neri_data::GraphVisitResult<reference_model::Label>
    match this.visits_Label.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<reference_model::Label>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<reference_model::Label>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Label)

        if staged != null
          return neri_data::GraphVisitResult<reference_model::Label>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_labels(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<reference_model::Label>.Failure(queued)
        end
        return neri_data::GraphVisitResult<reference_model::Label>.New(slot)
    end
  end

  private def scan_labels(entity: reference_model::Label, owner: neri_data::GraphSlot<reference_model::Label>): neri_data::QueryFailure?
    for child in entity.tagged
      let inverse = child.label

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: taggedFor_Label_by_labelCode")
      end
      var related: neri_data::GraphSlot<reference_model::Tagged>? = null

      match this.discover_tagged(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_taggedFor_Label_by_labelCode(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_tagged(root: reference_model::Tagged): neri_data::TrackHandleResult<reference_model::Tagged>
    match this.discover_tagged(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<reference_model::Tagged>.Failure(error)
    end
  end

  private def discover_tagged(entity: reference_model::Tagged): neri_data::GraphVisitResult<reference_model::Tagged>
    match this.visits_Tagged.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<reference_model::Tagged>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<reference_model::Tagged>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Tagged)

        if staged != null
          return neri_data::GraphVisitResult<reference_model::Tagged>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_tagged(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<reference_model::Tagged>.Failure(queued)
        end
        return neri_data::GraphVisitResult<reference_model::Tagged>.New(slot)
    end
  end

  private def scan_tagged(entity: reference_model::Tagged, owner: neri_data::GraphSlot<reference_model::Tagged>): neri_data::QueryFailure?
    let principal_taggedFor_Label_by_labelCode = entity.label

    if principal_taggedFor_Label_by_labelCode != null
      var related: neri_data::GraphSlot<reference_model::Label>? = null

      match this.discover_labels(principal_taggedFor_Label_by_labelCode)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_taggedFor_Label_by_labelCode(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  def add_nodes(root: reference_model::TreeNode): neri_data::TrackHandleResult<reference_model::TreeNode>
    match this.discover_nodes(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<reference_model::TreeNode>.Failure(error)
    end
  end

  private def discover_nodes(entity: reference_model::TreeNode): neri_data::GraphVisitResult<reference_model::TreeNode>
    match this.visits_TreeNode.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<reference_model::TreeNode>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<reference_model::TreeNode>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_TreeNode)

        if staged != null
          return neri_data::GraphVisitResult<reference_model::TreeNode>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_nodes(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<reference_model::TreeNode>.Failure(queued)
        end
        return neri_data::GraphVisitResult<reference_model::TreeNode>.New(slot)
    end
  end

  private def scan_nodes(entity: reference_model::TreeNode, owner: neri_data::GraphSlot<reference_model::TreeNode>): neri_data::QueryFailure?
    for child in entity.children
      let inverse = child.parent

      if inverse != null && !reference::same(inverse, entity)
        return neri_data::QueryFailure.Provider("graph navigation inverse disagrees with collection: nodesFor_TreeNode_by_parentId")
      end
      var related: neri_data::GraphSlot<reference_model::TreeNode>? = null

      match this.discover_nodes(child)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_nodesFor_TreeNode_by_parentId(owner, related, child)

        if failure != null
          return failure
        end
      end
    end
    let principal_nodesFor_TreeNode_by_parentId = entity.parent

    if principal_nodesFor_TreeNode_by_parentId != null
      var related: neri_data::GraphSlot<reference_model::TreeNode>? = null

      match this.discover_nodes(principal_nodesFor_TreeNode_by_parentId)
        case neri_data::GraphVisitResult.New(slot)
          related = slot
        case neri_data::GraphVisitResult.Existing(slot)
          related = slot
        case neri_data::GraphVisitResult.Failure(error)
          return error
      end
      if related != null
        let failure = this.link_nodesFor_TreeNode_by_parentId(related, owner, entity)

        if failure != null
          return failure
        end
      end
    end
    return null
  end

  private def link_itemsFor_Group_by_groupId(principal: neri_data::GraphSlot<reference_model::Group>, dependent: neri_data::GraphSlot<reference_model::Item>, entity: reference_model::Item): neri_data::QueryFailure?
    let previous = entity.groupId
    let restore: fn(): Void = fn(): Void
      entity.groupId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_itemsFor_Group_by_groupId, restore)
  end

  private def link_taggedFor_Label_by_labelCode(principal: neri_data::GraphSlot<reference_model::Label>, dependent: neri_data::GraphSlot<reference_model::Tagged>, entity: reference_model::Tagged): neri_data::QueryFailure?
    let previous = entity.labelCode
    let restore: fn(): Void = fn(): Void
      entity.labelCode = previous
    end

    return this.graph.stageLink(principal, dependent, edge_taggedFor_Label_by_labelCode, restore)
  end

  private def link_nodesFor_TreeNode_by_parentId(principal: neri_data::GraphSlot<reference_model::TreeNode>, dependent: neri_data::GraphSlot<reference_model::TreeNode>, entity: reference_model::TreeNode): neri_data::QueryFailure?
    let previous = entity.parentId
    let restore: fn(): Void = fn(): Void
      entity.parentId = previous
    end

    return this.graph.stageLink(principal, dependent, edge_nodesFor_TreeNode_by_parentId, restore)
  end
end
