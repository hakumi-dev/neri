namespace reference_data

class Navigation_ReferenceDatabase
  public groups: NavigationSet_ReferenceDatabase_Group
  public items: NavigationSet_ReferenceDatabase_Item
  public labels: NavigationSet_ReferenceDatabase_Label
  public tagged: NavigationSet_ReferenceDatabase_Tagged
  public nodes: NavigationSet_ReferenceDatabase_TreeNode

  def init(context: ReferenceDatabase): Void
    this.groups = new NavigationSet_ReferenceDatabase_Group(context)
    this.items = new NavigationSet_ReferenceDatabase_Item(context)
    this.labels = new NavigationSet_ReferenceDatabase_Label(context)
    this.tagged = new NavigationSet_ReferenceDatabase_Tagged(context)
    this.nodes = new NavigationSet_ReferenceDatabase_TreeNode(context)
  end
end
