namespace reference_model

class Group
  public id: Int
  public name: String
  public items: Item[] = []

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class Item
  public id: Int
  public groupId: Int?
  public title: String
  public group: Group? = null

  def init(id: Int, groupId: Int?, title: String): Void
    this.id = id
    this.groupId = groupId
    this.title = title
  end
end

class Label
  public code: String
  public tagged: Tagged[] = []

  def init(code: String): Void
    this.code = code
  end
end

class Tagged
  public id: Int
  public labelCode: String?
  public label: Label? = null

  def init(id: Int, labelCode: String?): Void
    this.id = id
    this.labelCode = labelCode
  end
end

class TreeNode
  public id: Int
  public parentId: Int?
  public parent: TreeNode? = null
  public children: TreeNode[] = []

  def init(id: Int, parentId: Int?): Void
    this.id = id
    this.parentId = parentId
  end
end
