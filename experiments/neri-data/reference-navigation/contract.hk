use console
use files
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use reference
use reference_data
use reference_model
use resources
use result
use test

class ReferenceCountingProvider: Provider
  private inner: SQLiteProvider
  public reads: Int = 0
  public streams: Int = 0

  def init(inner: SQLiteProvider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.inner.supports(capability)
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.reads = this.reads + 1
    return this.inner.execute(plan)
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.streams = this.streams + 1
    return this.inner.stream(plan, visit)
  end
end

def itemRows(result: QueryResult<Item>): TypedRows<Item>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def taggedRows(result: QueryResult<Tagged>): TypedRows<Tagged>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def nodeRows(result: QueryResult<TreeNode>): TypedRows<TreeNode>?
  match result
    case QueryResult.Rows(rows)
      return rows
    case QueryResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def itemFailure(result: QueryResult<Item>): Void
  match result
    case QueryResult.Failure(error)
      return
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
end

def sameItemGroup(item: Item, group: Group): Bool
  let inverse = item.group

  return inverse != null && reference::same(inverse, group)
end

def verifyMain(provider: SQLiteProvider, path: String): Void
  let counted = new ReferenceCountingProvider(provider)
  let db = new ReferenceDatabase(counted)
  let firstRows = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 10).take(1)).all())

  test::assertTrue(firstRows != null)
  if firstRows == null
    return
  end
  let firstNode = firstRows.first()

  test::assertEqual(firstRows.count(), 1)
  test::assertTrue(firstNode != null)
  if firstNode == null
    return
  end
  let first = firstNode.value
  let group = first.group

  test::assertTrue(group != null)
  if group == null
    return
  end

  test::assertEqual(group.items.Length, 1)
  test::assertTrue(reference::same(group.items[0], first))
  let secondRows = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 11).take(1)).all())

  test::assertTrue(secondRows != null)
  if secondRows == null
    return
  end
  let secondNode = secondRows.first()

  test::assertEqual(secondRows.count(), 1)
  test::assertTrue(secondNode != null)
  if secondNode == null
    return
  end
  let second = secondNode.value
  let shared = second.group

  test::assertTrue(shared != null)
  if shared != null
    test::assertTrue(reference::same(shared, group))
  end

  test::assertEqual(group.items.Length, 2)
  test::assertTrue(reference::same(group.items[0], first))
  test::assertTrue(reference::same(group.items[1], second))
  let repeated = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 10).take(1)).all())

  test::assertTrue(repeated != null)
  test::assertEqual(group.items.Length, 2)
  if repeated != null
    let repeatNode = repeated.first()

    test::assertEqual(repeated.count(), 1)
    test::assertTrue(repeatNode != null)
    if repeatNode != null
      test::assertTrue(reference::same(repeatNode.value, first))
    end
  end
  let beforeNullStreams = counted.streams
  let nullRows = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 12).take(1)).all())
  let emptyRows = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 999).take(1)).all())

  test::assertTrue(nullRows != null && emptyRows != null)
  test::assertEqual(counted.streams, beforeNullStreams)
  if nullRows != null
    let nullNode = nullRows.first()

    test::assertEqual(nullRows.count(), 1)
    test::assertTrue(nullNode != null)
    if nullNode != null
      test::assertTrue(nullNode.value.group == null)
    end
  end
  if emptyRows != null
    test::assertEqual(emptyRows.count(), 0)
  end
  let unicode = "O'Reilly; DROP TABLE labels; -- 水"
  let tagged = taggedRows(db.includeReference_taggedFor_Label_by_labelCode(db.tagged.take(20)).all())

  test::assertTrue(tagged != null)
  if tagged != null
    test::assertEqual(tagged.count(), 3)
    var linked: Label? = null
    var node = tagged.first()

    while node != null
      if node.value.id == 20 || node.value.id == 21
        let current = node.value.label

        test::assertTrue(current != null)
        if current != null
          test::assertEqual(current.code, unicode)
          if linked != null
            test::assertTrue(reference::same(linked, current))
          end
          linked = current
        end
      else if node.value.id == 22
        test::assertTrue(node.value.label == null)
      end
      node = node.next
    end
    if linked != null
      test::assertEqual(linked.tagged.Length, 2)
    end
  end
  let firstNodeRows = nodeRows(db.includeReference_nodesFor_TreeNode_by_parentId(db.nodes.where(id: 2).take(1)).all())
  let secondNodeRows = nodeRows(db.includeReference_nodesFor_TreeNode_by_parentId(db.nodes.where(id: 3).take(1)).all())

  test::assertTrue(firstNodeRows != null && secondNodeRows != null)
  if firstNodeRows != null && secondNodeRows != null
    test::assertEqual(firstNodeRows.count(), 1)
    test::assertEqual(secondNodeRows.count(), 1)
    let a = firstNodeRows.first()
    let b = secondNodeRows.first()

    test::assertTrue(a != null && b != null)
    if a != null && b != null
      let principalA = a.value.parent
      let principalB = b.value.parent

      test::assertTrue(principalA != null && principalB != null)
      if principalA != null && principalB != null
        test::assertTrue(reference::same(principalA, principalB))
        test::assertEqual(principalA.children.Length, 2)
      end
    end
  end
  let selfRows = nodeRows(db.includeReference_nodesFor_TreeNode_by_parentId(db.nodes.where(id: 4).take(1)).all())

  test::assertTrue(selfRows != null)
  if selfRows != null
    test::assertEqual(selfRows.count(), 1)
    let selfNode = selfRows.first()

    test::assertTrue(selfNode != null)
    if selfNode != null
      let parent = selfNode.value.parent

      test::assertTrue(parent != null)
      if parent != null
        test::assertTrue(reference::same(parent, selfNode.value))
      end

      test::assertEqual(selfNode.value.children.Length, 1)
      test::assertTrue(reference::same(selfNode.value.children[0], selfNode.value))
    end
  end
  match db.include_itemsFor_Group_by_groupId(db.groups.where(id: 1).take(1)).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(groups)
      let loadedGroup = groups.first()

      test::assertEqual(groups.count(), 1)
      test::assertTrue(loadedGroup != null)
      if loadedGroup != null
        test::assertTrue(reference::same(loadedGroup.value, group))
        test::assertEqual(loadedGroup.value.items.Length, 2)
        test::assertTrue(reference::same(loadedGroup.value.items[0], first))
        test::assertTrue(reference::same(loadedGroup.value.items[1], second))
      end
  end
  match db.include_taggedFor_Label_by_labelCode(db.labels.where(code: unicode).take(1)).all()
    case QueryResult.Failure(error)
      test::assertTrue(false)
    case QueryResult.Rows(labels)
      let loadedLabel = labels.first()

      test::assertEqual(labels.count(), 1)
      test::assertTrue(loadedLabel != null)
      if loadedLabel != null
        test::assertEqual(loadedLabel.value.code, unicode)
        test::assertEqual(loadedLabel.value.tagged.Length, 2)
        test::assertEqual(loadedLabel.value.tagged[0].id, 20)
        test::assertEqual(loadedLabel.value.tagged[1].id, 21)
      end
  end

  test::assertTrue(createSQLiteFixture(path, "INSERT INTO items VALUES(13,999,'missing');"))
  let beforeMissing = counted.streams

  itemFailure(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 13).take(1)).all())

  test::assertEqual(counted.streams, beforeMissing + 1)
  test::assertEqual(group.items.Length, 2)
  test::assertTrue(sameItemGroup(first, group))
  test::assertTrue(createSQLiteFixture(path, "DELETE FROM items WHERE id=13;"))
  test::assertTrue(createSQLiteFixture(path, "UPDATE groups SET name=NULL WHERE id=2; INSERT INTO items VALUES(14,2,'malformed');"))
  let beforeMalformed = counted.streams

  itemFailure(db.includeReference_itemsFor_Group_by_groupId(db.items.take(20)).all())

  test::assertEqual(counted.streams, beforeMalformed + 1)
  test::assertEqual(group.items.Length, 2)
  test::assertTrue(sameItemGroup(first, group))
  first.groupId = 2
  itemFailure(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 10).take(1)).load(firstRows))

  test::assertEqual(group.items.Length, 2)
  test::assertTrue(sameItemGroup(first, group))
  first.groupId = 1
  group.id = 100
  itemFailure(db.includeReference_itemsFor_Group_by_groupId(db.items.where(id: 10).take(1)).load(firstRows))

  test::assertEqual(group.items.Length, 2)
  group.id = 1
end

def verifyBatch(provider: SQLiteProvider, path: String): Void
  let counted = new ReferenceCountingProvider(provider)
  let db = new ReferenceDatabase(counted)
  let byId = quote do |item: Item|: Int
    return item.id
  end
  let rows = itemRows(db.includeReference_itemsFor_Group_by_groupId(db.items.orderBy(byId).take(100)).all())

  test::assertTrue(rows != null)
  if rows != null
    test::assertEqual(rows.count(), 51)
  end

  test::assertEqual(counted.reads, 1)
  test::assertEqual(counted.streams, 2)
  if rows != null
    let first = rows.first()

    test::assertTrue(first != null)
    if first != null
      let previous = first.value.group

      test::assertTrue(previous != null)
      test::assertTrue(createSQLiteFixture(path, "DELETE FROM groups WHERE id=51;"))
      let beforeFailure = counted.streams

      itemFailure(db.includeReference_itemsFor_Group_by_groupId(db.items.orderBy(byId).take(100)).load(rows))

      test::assertEqual(counted.streams, beforeFailure + 2)
      let after = first.value.group

      test::assertTrue(after != null)
      if previous != null && after != null
        test::assertTrue(reference::same(previous, after))
      end
    end
  end
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-reference-navigation-")
    let path = temporary.path() + "/references.sqlite"
    let batchPath = temporary.path() + "/batch.sqlite"
    let sql = "CREATE TABLE groups(id INTEGER PRIMARY KEY,name TEXT); CREATE TABLE items(id INTEGER PRIMARY KEY,group_id INTEGER,title TEXT NOT NULL); CREATE TABLE labels(code TEXT PRIMARY KEY); CREATE TABLE tagged(id INTEGER PRIMARY KEY,label_code TEXT); CREATE TABLE nodes(id INTEGER PRIMARY KEY,parent_id INTEGER); INSERT INTO groups VALUES(1,'one'),(2,'two'); INSERT INTO items VALUES(10,1,'first'),(11,1,'second'),(12,NULL,'none'); INSERT INTO labels VALUES('O''Reilly; DROP TABLE labels; -- 水'); INSERT INTO tagged VALUES(20,'O''Reilly; DROP TABLE labels; -- 水'),(21,'O''Reilly; DROP TABLE labels; -- 水'),(22,NULL); INSERT INTO nodes VALUES(1,NULL),(2,1),(3,1),(4,4);"
    let batchSql = "CREATE TABLE groups(id INTEGER PRIMARY KEY,name TEXT NOT NULL); CREATE TABLE items(id INTEGER PRIMARY KEY,group_id INTEGER,title TEXT NOT NULL); CREATE TABLE labels(code TEXT PRIMARY KEY); CREATE TABLE tagged(id INTEGER PRIMARY KEY,label_code TEXT); WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 51) INSERT INTO groups SELECT id,'group' FROM n; WITH RECURSIVE n(id) AS (VALUES(1) UNION ALL SELECT id + 1 FROM n WHERE id < 51) INSERT INTO items SELECT id,id,'item' FROM n;"

    test::assertTrue(createSQLiteFixture(path, sql))
    test::assertTrue(createSQLiteFixture(batchPath, batchSql))
    match SQLiteProvider.open(path)
      case SQLiteOpenResult.Opened(provider)
        verifyMain(provider, path)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.open(batchPath)
      case SQLiteOpenResult.Opened(provider)
        verifyBatch(provider, batchPath)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    return 0
  end
  return 1
end

def main(): Void
  let outcome = verifyFiles()

  test::assertEqual(outcome.closeFailures.count(), 0)
  match outcome.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
  console::println("Reference navigation contract passed")
end
