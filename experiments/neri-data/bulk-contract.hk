use neri_data
use quotation
use test

class BulkRecord
  public id: Int
  public active: Bool
  public nickname: String?

  def init(id: Int, active: Bool, nickname: String?): Void
    this.id = id
    this.active = active
    this.nickname = nickname
  end
end

def decodeBulkRecord(row: RawRow): DecodeResult<BulkRecord>
  return DecodeResult<BulkRecord>.Failure(QueryFailure.Provider("bulk must not decode rows"))
end

class BulkProvider: Provider
  public seenSql: String = ""
  public first: Cell? = null
  public second: Cell? = null
  public third: Cell? = null
  public fourth: Cell? = null
  public count: Int = 0
  public leased: Bool = false
  private checkedExpressions: Bool
  private postgreSql: Bool

  def init(postgreSql: Bool = false, checkedExpressions: Bool = true): Void
    this.postgreSql = postgreSql
    this.checkedExpressions = checkedExpressions
  end

  public override readonly def dialect(): SqlDialect
    return this.postgreSql ? SqlDialect.PostgreSql() : SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return this.checkedExpressions
      case ProviderCapability.BoundedTypedReads()
        return true
      case ProviderCapability.StreamingReads()
        return true
      case ProviderCapability.SetWrites()
        return true
      case ProviderCapability.TrackedWrites()
        return true
      case ProviderCapability.ExplicitTransactions()
        return true
      case ProviderCapability.Savepoints()
        return true
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    test::assertTrue(false)
    return ProviderResult.Rows([])
  end

  public override def executeSet(plan: readonly SetWritePlan): WriteResult
    this.inspect(plan)
    return WriteResult.Saved(2048)
  end

  public override def executeSetInTransaction(plan: readonly SetWritePlan, lease: Int): WriteResult
    test::assertEqual(lease, 9)
    this.leased = true
    this.inspect(plan)
    return WriteResult.Saved(0)
  end

  public override def beginTransaction(): TransactionOpenResult
    return TransactionOpenResult.Begun(9)
  end

  public override def commitTransaction(lease: Int): WriteResult
    return WriteResult.Saved(0)
  end

  public override def rollbackTransaction(lease: Int): WriteResult
    return WriteResult.Saved(0)
  end

  public override def transactionState(lease: Int): TransactionState
    return TransactionState.Active()
  end

  private def inspect(plan: readonly SetWritePlan): Void
    this.seenSql = plan.sql()
    this.count = plan.parameters().count()
    let first = plan.parameters().first()

    if first != null
      match first.value()
        case Cell.Null()
          this.first = Cell.Null()
        case Cell.Float(value)
          this.first = Cell.Float(value)
        case Cell.Bool(value)
          this.first = Cell.Bool(value)
        case Cell.Int(value)
          this.first = Cell.Int(value)
        case Cell.Text(value)
          this.first = Cell.Text(value)
      end
      let second = first.next()

      if second != null
        match second.value()
          case Cell.Null()
            this.second = Cell.Null()
          case Cell.Float(value)
            this.second = Cell.Float(value)
          case Cell.Bool(value)
            this.second = Cell.Bool(value)
          case Cell.Int(value)
            this.second = Cell.Int(value)
          case Cell.Text(value)
            this.second = Cell.Text(value)
        end
        let third = second.next()

        if third != null
          match third.value()
            case Cell.Null()
              this.third = Cell.Null()
            case Cell.Float(value)
              this.third = Cell.Float(value)
            case Cell.Bool(value)
              this.third = Cell.Bool(value)
            case Cell.Int(value)
              this.third = Cell.Int(value)
            case Cell.Text(value)
              this.third = Cell.Text(value)
          end
          let fourth = third.next()

          if fourth != null
            match fourth.value()
              case Cell.Null()
                this.fourth = Cell.Null()
              case Cell.Float(value)
                this.fourth = Cell.Float(value)
              case Cell.Bool(value)
                this.fourth = Cell.Bool(value)
              case Cell.Int(value)
                this.fourth = Cell.Int(value)
              case Cell.Text(value)
                this.fourth = Cell.Text(value)
            end
          end
        end
      end
    end
  end
end

def bulkMapping(): EntityMapping
  return new EntityMapping("BulkRecord", "records", [new MappingColumn("BulkRecord.id", "Int", "id"), new MappingColumn("BulkRecord.active", "Bool", "active"), new MappingColumn("BulkRecord.nickname", "String?", "nickname")], "id")
end

def bulkQuery(provider: BulkProvider, changes: ChangeContext? = null): Query<BulkRecord>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])

  return new Query<BulkRecord>("records", new Decoder<BulkRecord>(decodeBulkRecord, columns), mapping: bulkMapping(), provider: provider, changes: changes)
end

def bulkQueryWithMapping(provider: BulkProvider, mapping: EntityMapping): Query<BulkRecord>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])

  return new Query<BulkRecord>("records", new Decoder<BulkRecord>(decodeBulkRecord, columns), mapping: mapping, provider: provider)
end

def bulkId(): quote fn(BulkRecord): Int
  return quote do |record: BulkRecord|: Int
    return record.id
  end
end

def bulkActive(): quote fn(BulkRecord): Bool
  return quote do |record: BulkRecord|: Bool
    return record.active
  end
end

def bulkNickname(): quote fn(BulkRecord): String?
  return quote do |record: BulkRecord|: String?
    return record.nickname
  end
end

def calculatedActive(delta: Int, threshold: Int): quote fn(BulkRecord): Bool
  return quote do |record: BulkRecord|: Bool
    return record.id > delta && record.id < threshold
  end
end

def capturedNickname(value: String): quote fn(BulkRecord): String?
  return quote do |record: BulkRecord|: String?
    return value
  end
end

def setFailureCategory(result: WriteResult): String
  match result
    case WriteResult.Saved(count)
      return "saved"
    case WriteResult.SavedWithValues(count, outputs)
      return "saved"
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Validation(message)
          return "validation"
        case WriteFailure.Unsupported(message)
          return "unsupported"
        case WriteFailure.Concurrency(message)
          return "concurrency"
        case WriteFailure.Constraint(message)
          return "constraint"
        case WriteFailure.Provider(message)
          return "provider"
        case WriteFailure.Transaction(message)
          return "transaction"
      end
  end
end

def main(): Void
  let provider = new BulkProvider()
  let ordered: quote fn(BulkRecord): Int = quote do |record: BulkRecord|: Int
    return record.id
  end
  let selected = bulkQuery(provider).where(active: true).orderBy(ordered).skip(2).take(3).distinct()

  match selected.executeDelete()
    case WriteResult.Saved(count)
      test::assertEqual(count, 2048)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertTrue(provider.seenSql != "")
  test::assertEqual(provider.count, 1)
  let pg = new BulkProvider(true)

  match bulkQuery(pg).where(active: true).executeUpdate(nickname: null)
    case WriteResult.Saved(count)
      test::assertEqual(count, 2048)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertEqual(pg.seenSql, "WITH \"__neri_target_keys\" AS MATERIALIZED (SELECT \"records\".\"id\" FROM (SELECT \"records\".\"id\", \"records\".\"active\", \"records\".\"nickname\" FROM \"records\" WHERE \"records\".\"active\" = $1) AS \"records\") UPDATE \"records\" SET \"nickname\" = $2 WHERE \"id\" IN (SELECT \"id\" FROM \"__neri_target_keys\")")
  test::assertEqual(pg.count, 2)
  let aliased = new BulkProvider()
  let aliasColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
  let aliasMapping = new EntityMapping("BulkRecord", "__NERI_TARGET_KEYS", [new MappingColumn("BulkRecord.id", "Int", "id")], "id")
  let aliasQuery = new Query<BulkRecord>("__NERI_TARGET_KEYS", new Decoder<BulkRecord>(decodeBulkRecord, aliasColumns), mapping: aliasMapping, provider: aliased)

  match aliasQuery.executeDelete()
    case WriteResult.Saved(count)
      test::assertEqual(count, 2048)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertEqual(aliased.seenSql, "WITH \"__neri_target_keys_alt\" AS MATERIALIZED (SELECT \"__NERI_TARGET_KEYS\".\"id\" FROM (SELECT \"__NERI_TARGET_KEYS\".\"id\" FROM \"__NERI_TARGET_KEYS\") AS \"__NERI_TARGET_KEYS\") DELETE FROM \"__NERI_TARGET_KEYS\" WHERE \"id\" IN (SELECT \"id\" FROM \"__neri_target_keys_alt\")")
  let distinctProvider = new BulkProvider(true)
  let byActive: quote fn(BulkRecord): Bool = quote do |record: BulkRecord|: Bool
    return record.active
  end

  match bulkQuery(distinctProvider).distinct().orderByBool(byActive).take(2).executeDelete()
    case WriteResult.Saved(count)
      test::assertEqual(count, 2048)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertEqual(distinctProvider.seenSql, "WITH \"__neri_target_keys\" AS MATERIALIZED (SELECT \"records\".\"id\" FROM (SELECT \"records\".\"id\", \"records\".\"active\", \"records\".\"nickname\" FROM (SELECT DISTINCT \"records\".\"id\", \"records\".\"active\", \"records\".\"nickname\" FROM \"records\") AS \"records\" ORDER BY \"records\".\"active\" ASC LIMIT 2) AS \"records\") DELETE FROM \"records\" WHERE \"id\" IN (SELECT \"id\" FROM \"__neri_target_keys\")")
  let first = pg.first

  test::assertTrue(first != null)
  if first != null
    match first
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Bool(value)
        test::assertTrue(value)
      case Cell.Null()
        test::assertTrue(false)
      case Cell.Int(value)
        test::assertTrue(false)
      case Cell.Text(value)
        test::assertTrue(false)
    end
  end
  let second = pg.second

  test::assertTrue(second != null)
  if second != null
    match second
      case Cell.Null()
        test::assertTrue(true)
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Bool(value)
        test::assertTrue(false)
      case Cell.Int(value)
        test::assertTrue(false)
      case Cell.Text(value)
        test::assertTrue(false)
    end
  end
  match bulkQuery(provider).executeUpdate(id: 8)
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Validation(message)
          test::assertTrue(true)
        case WriteFailure.Concurrency(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Provider(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end
  let owner = new ChangeContext(provider)

  match owner.beginTransaction()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end
  let foreign = new BulkProvider()

  match bulkQuery(foreign, owner).executeDelete()
    case WriteResult.Failure(error)
      match error
        case WriteFailure.Validation(message)
          test::assertTrue(true)
        case WriteFailure.Concurrency(message)
          test::assertTrue(false)
        case WriteFailure.Constraint(message)
          test::assertTrue(false)
        case WriteFailure.Provider(message)
          test::assertTrue(false)
        case WriteFailure.Unsupported(message)
          test::assertTrue(false)
        case WriteFailure.Transaction(message)
          test::assertTrue(false)
      end
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertEqual(foreign.seenSql, "")
  match bulkQuery(provider, owner).executeDelete()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.Failure(error)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
  end

  test::assertTrue(provider.leased)

  let computedProvider = new BulkProvider()
  let emptySet = updateSet<BulkRecord>()
  let oneAssignment = emptySet.set(bulkActive(), calculatedActive(3, 5))

  test::assertEqual(emptySet.count(), 0)
  test::assertEqual(oneAssignment.count(), 1)
  let emptyProvider = new BulkProvider()

  test::assertEqual(setFailureCategory(bulkQuery(emptyProvider).executeUpdateSet(emptySet)), "validation")
  test::assertEqual(emptyProvider.seenSql, "")
  let capturedActive = false
  let delta = 3
  let threshold = 5
  let replacement = "computed nickname"
  let activeSet = updateSet<BulkRecord>().set(bulkActive(), calculatedActive(delta, threshold))
  let computedSet = activeSet.set(bulkNickname(), capturedNickname(replacement))
  let selectedPredicate: quote fn(BulkRecord): Bool = quote do |record: BulkRecord|: Bool
    return record.active == capturedActive
  end

  match bulkQuery(computedProvider).matching(selectedPredicate).orderBy(ordered).skip(1).take(2).executeUpdateSet(computedSet)
    case WriteResult.Saved(count)
      test::assertEqual(count, 2048)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(computedProvider.seenSql != "")
  test::assertEqual(computedProvider.count, 4)
  let firstComputed = computedProvider.first
  let secondComputed = computedProvider.second
  let thirdComputed = computedProvider.third
  let fourthComputed = computedProvider.fourth

  test::assertTrue(firstComputed != null && secondComputed != null && thirdComputed != null && fourthComputed != null)
  if firstComputed != null && secondComputed != null && thirdComputed != null && fourthComputed != null
    match firstComputed
      case Cell.Bool(value)
        test::assertTrue(!value)
      case Cell.Int(value)
        test::assertTrue(false)
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Text(value)
        test::assertTrue(false)
      case Cell.Null()
        test::assertTrue(false)
    end
    match secondComputed
      case Cell.Int(value)
        test::assertEqual(value, 3)
      case Cell.Bool(value)
        test::assertTrue(false)
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Text(value)
        test::assertTrue(false)
      case Cell.Null()
        test::assertTrue(false)
    end
    match thirdComputed
      case Cell.Int(value)
        test::assertEqual(value, 5)
      case Cell.Bool(value)
        test::assertTrue(false)
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Text(value)
        test::assertTrue(false)
      case Cell.Null()
        test::assertTrue(false)
    end
    match fourthComputed
      case Cell.Text(value)
        test::assertEqual(value, replacement)
      case Cell.Bool(value)
        test::assertTrue(false)
      case Cell.Float(value)
        test::assertTrue(false)
      case Cell.Int(value)
        test::assertTrue(false)
      case Cell.Null()
        test::assertTrue(false)
    end
  end

  let unsupportedProvider = new BulkProvider(checkedExpressions: false)

  test::assertEqual(setFailureCategory(bulkQuery(unsupportedProvider).executeUpdateSet(computedSet)), "unsupported")
  test::assertEqual(unsupportedProvider.seenSql, "")
  let postgresProvider = new BulkProvider(true)

  test::assertEqual(setFailureCategory(bulkQuery(postgresProvider).executeUpdateSet(computedSet)), "unsupported")
  test::assertEqual(postgresProvider.seenSql, "")
  let keyProvider = new BulkProvider()
  let keySet = updateSet<BulkRecord>().set(bulkId(), bulkId())

  test::assertEqual(setFailureCategory(bulkQuery(keyProvider).executeUpdateSet(keySet)), "validation")
  test::assertEqual(keyProvider.seenSql, "")
  let duplicateProvider = new BulkProvider()
  let firstDuplicate = updateSet<BulkRecord>().set(bulkActive(), calculatedActive(delta, threshold))
  let duplicateSet = firstDuplicate.set(bulkActive(), calculatedActive(threshold, delta))

  test::assertEqual(setFailureCategory(bulkQuery(duplicateProvider).executeUpdateSet(duplicateSet)), "validation")
  test::assertEqual(duplicateProvider.seenSql, "")
  let unmappedProvider = new BulkProvider()
  let partialMapping = new EntityMapping("BulkRecord", "records", [new MappingColumn("BulkRecord.id", "Int", "id"), new MappingColumn("BulkRecord.active", "Bool", "active")], "id")
  let unmappedSet = updateSet<BulkRecord>().set(bulkNickname(), capturedNickname(replacement))

  test::assertEqual(setFailureCategory(bulkQueryWithMapping(unmappedProvider, partialMapping).executeUpdateSet(unmappedSet)), "validation")
  test::assertEqual(unmappedProvider.seenSql, "")
  let mismatchProvider = new BulkProvider()
  let mismatchedMapping = new EntityMapping("BulkRecord", "records", [new MappingColumn("BulkRecord.id", "Int", "id"), new MappingColumn("BulkRecord.active", "Int", "active")], "id")
  let mismatchSet = updateSet<BulkRecord>().set(bulkActive(), calculatedActive(delta, threshold))

  test::assertEqual(setFailureCategory(bulkQueryWithMapping(mismatchProvider, mismatchedMapping).executeUpdateSet(mismatchSet)), "validation")
  test::assertEqual(mismatchProvider.seenSql, "")
end
