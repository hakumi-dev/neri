use reference
namespace null_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_NullDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Parent: neri_data::EntityTracker<null_model::Parent>
  private visits_Parent: neri_data::GraphVisitList<null_model::Parent>
  private tracker_Branch: neri_data::EntityTracker<null_model::Branch>
  private visits_Branch: neri_data::GraphVisitList<null_model::Branch>
  private tracker_Child: neri_data::EntityTracker<null_model::Child>
  private visits_Child: neri_data::GraphVisitList<null_model::Child>
  private tracker_Code: neri_data::EntityTracker<null_model::Code>
  private visits_Code: neri_data::GraphVisitList<null_model::Code>
  private tracker_TextChild: neri_data::EntityTracker<null_model::TextChild>
  private visits_TextChild: neri_data::GraphVisitList<null_model::TextChild>

  def init(changes: neri_data::ChangeContext, tracker_Parent: neri_data::EntityTracker<null_model::Parent>, tracker_Branch: neri_data::EntityTracker<null_model::Branch>, tracker_Child: neri_data::EntityTracker<null_model::Child>, tracker_Code: neri_data::EntityTracker<null_model::Code>, tracker_TextChild: neri_data::EntityTracker<null_model::TextChild>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Parent = tracker_Parent
    this.visits_Parent = new neri_data::GraphVisitList<null_model::Parent>(this.graph)
    this.tracker_Branch = tracker_Branch
    this.visits_Branch = new neri_data::GraphVisitList<null_model::Branch>(this.graph)
    this.tracker_Child = tracker_Child
    this.visits_Child = new neri_data::GraphVisitList<null_model::Child>(this.graph)
    this.tracker_Code = tracker_Code
    this.visits_Code = new neri_data::GraphVisitList<null_model::Code>(this.graph)
    this.tracker_TextChild = tracker_TextChild
    this.visits_TextChild = new neri_data::GraphVisitList<null_model::TextChild>(this.graph)
  end

  def add_parents(root: null_model::Parent): neri_data::TrackHandleResult<null_model::Parent>
    match this.discover_parents(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<null_model::Parent>.Failure(error)
    end
  end

  private def discover_parents(entity: null_model::Parent): neri_data::GraphVisitResult<null_model::Parent>
    match this.visits_Parent.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<null_model::Parent>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<null_model::Parent>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Parent)

        if staged != null
          return neri_data::GraphVisitResult<null_model::Parent>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_parents(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<null_model::Parent>.Failure(queued)
        end
        return neri_data::GraphVisitResult<null_model::Parent>.New(slot)
    end
  end

  private def scan_parents(entity: null_model::Parent, owner: neri_data::GraphSlot<null_model::Parent>): neri_data::QueryFailure?
    return null
  end

  def add_branches(root: null_model::Branch): neri_data::TrackHandleResult<null_model::Branch>
    match this.discover_branches(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<null_model::Branch>.Failure(error)
    end
  end

  private def discover_branches(entity: null_model::Branch): neri_data::GraphVisitResult<null_model::Branch>
    match this.visits_Branch.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<null_model::Branch>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<null_model::Branch>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Branch)

        if staged != null
          return neri_data::GraphVisitResult<null_model::Branch>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_branches(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<null_model::Branch>.Failure(queued)
        end
        return neri_data::GraphVisitResult<null_model::Branch>.New(slot)
    end
  end

  private def scan_branches(entity: null_model::Branch, owner: neri_data::GraphSlot<null_model::Branch>): neri_data::QueryFailure?
    return null
  end

  def add_children(root: null_model::Child): neri_data::TrackHandleResult<null_model::Child>
    match this.discover_children(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<null_model::Child>.Failure(error)
    end
  end

  private def discover_children(entity: null_model::Child): neri_data::GraphVisitResult<null_model::Child>
    match this.visits_Child.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<null_model::Child>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<null_model::Child>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Child)

        if staged != null
          return neri_data::GraphVisitResult<null_model::Child>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_children(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<null_model::Child>.Failure(queued)
        end
        return neri_data::GraphVisitResult<null_model::Child>.New(slot)
    end
  end

  private def scan_children(entity: null_model::Child, owner: neri_data::GraphSlot<null_model::Child>): neri_data::QueryFailure?
    return null
  end

  def add_codes(root: null_model::Code): neri_data::TrackHandleResult<null_model::Code>
    match this.discover_codes(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<null_model::Code>.Failure(error)
    end
  end

  private def discover_codes(entity: null_model::Code): neri_data::GraphVisitResult<null_model::Code>
    match this.visits_Code.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<null_model::Code>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<null_model::Code>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Code)

        if staged != null
          return neri_data::GraphVisitResult<null_model::Code>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_codes(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<null_model::Code>.Failure(queued)
        end
        return neri_data::GraphVisitResult<null_model::Code>.New(slot)
    end
  end

  private def scan_codes(entity: null_model::Code, owner: neri_data::GraphSlot<null_model::Code>): neri_data::QueryFailure?
    return null
  end

  def add_textChildren(root: null_model::TextChild): neri_data::TrackHandleResult<null_model::TextChild>
    match this.discover_textChildren(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<null_model::TextChild>.Failure(error)
    end
  end

  private def discover_textChildren(entity: null_model::TextChild): neri_data::GraphVisitResult<null_model::TextChild>
    match this.visits_TextChild.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<null_model::TextChild>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<null_model::TextChild>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_TextChild)

        if staged != null
          return neri_data::GraphVisitResult<null_model::TextChild>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_textChildren(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<null_model::TextChild>.Failure(queued)
        end
        return neri_data::GraphVisitResult<null_model::TextChild>.New(slot)
    end
  end

  private def scan_textChildren(entity: null_model::TextChild, owner: neri_data::GraphSlot<null_model::TextChild>): neri_data::QueryFailure?
    return null
  end
end
