use console
use files
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use null_data
use null_model
use resources
use result
use test

def tracked<T>(result: TrackHandleResult<T>): TrackedHandle<T>?
  match result
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)
      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failedCheck(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertEqual(writeFailureMessage(error), "SQLite step failed (code 275): CHECK constraint failed: parent_id IS NOT NULL OR label != 'blocked'")
  end
end

def failedForeignKey(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertEqual(writeFailureMessage(error), "SQLite step failed (code 1811): FOREIGN KEY constraint failed")
  end
end

def detachedRemoval(result: QueryFailure?): Void
  test::assertTrue(result != null)
  if result != null
    match result
      case QueryFailure.Provider(message)
        test::assertEqual(message, "entity is detached")
      case QueryFailure.InvalidIdentifier(name)
        test::assertTrue(false)
      case QueryFailure.InvalidLimit(value, maximum)
        test::assertTrue(false)
      case QueryFailure.MissingLimit(maximum)
        test::assertTrue(false)
      case QueryFailure.SourceMismatch(expected, actual)
        test::assertTrue(false)
      case QueryFailure.UnsupportedCapability(name)
        test::assertTrue(false)
      case QueryFailure.MissingColumn(name)
        test::assertTrue(false)
      case QueryFailure.TypeMismatch(column, expected, actual)
        test::assertTrue(false)
      case QueryFailure.Cardinality(expected, actual)
        test::assertTrue(false)
    end
  end
end

def optionalInt(actual: Int?, expected: Int): Void
  test::assertTrue(actual != null)
  if actual != null
    test::assertEqual(actual, expected)
  end
end

def counts(provider: SQLiteProvider, parents: Int, branches: Int, children: Int): Void
  let read = new NullDatabase(provider)

  match read.parents.count()
    case QueryValue.Value(value)
      test::assertEqual(value, parents)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.branches.count()
    case QueryValue.Value(value)
      test::assertEqual(value, branches)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.children.count()
    case QueryValue.Value(value)
      test::assertEqual(value, children)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyMixed(provider: SQLiteProvider): Void
  let db = new NullDatabase(provider)
  let parent = new Parent(0, "mixed")
  let branch = new Branch(0, 0)
  let doomed = new Child(0, null, null, "doomed")
  let survivor = new Child(0, null, null, "survivor")
  let p = tracked(db.parents.addWithHandle(parent))
  let b = tracked(db.branches.addWithHandle(branch))
  let d = tracked(db.children.addWithHandle(doomed))
  let s = tracked(db.children.addWithHandle(survivor))

  test::assertTrue(p != null && b != null && d != null && s != null)
  if p == null || b == null || d == null || s == null
    return
  end

  test::assertTrue(db.link_branchesFor_Parent_by_parentId(p, b) == null)
  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, d) == null)
  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, s) == null)
  test::assertTrue(db.link_childrenFor_Branch_by_branchId(b, d) == null)
  saved(db.saveChanges(), 4)
  counts(provider, 1, 1, 2)

  test::assertTrue(db.removeCascade_parents(p) == null)
  test::assertTrue(survivor.parentId == null)
  saved(db.saveChanges(), 4)
  counts(provider, 0, 0, 1)
  let read = new NullDatabase(provider)

  match read.children.where(id: survivor.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.children.where(id: doomed.id).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyAddedParent(provider: SQLiteProvider): Void
  let db = new NullDatabase(provider)
  let parent = new Parent(0, "added")
  let child = new Child(0, null, null, "surviving insert")
  let p = tracked(db.parents.addWithHandle(parent))
  let c = tracked(db.children.addWithHandle(child))

  test::assertTrue(p != null && c != null)
  if p == null || c == null
    return
  end

  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, c) == null)
  test::assertTrue(db.removeCascade_parents(p) == null)
  test::assertTrue(child.parentId == null)
  saved(db.saveChanges(), 1)
  counts(provider, 0, 0, 1)
  let read = new NullDatabase(provider)

  match read.children.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let staged = new NullDatabase(provider)
  let stagedParent = new Parent(0, "outer added")
  let stagedChild = new Child(0, null, null, "outer survivor")

  saved(staged.beginTransaction(), 0)
  let outerParent = tracked(staged.parents.addWithHandle(stagedParent))
  let outerChild = tracked(staged.children.addWithHandle(stagedChild))

  test::assertTrue(outerParent != null && outerChild != null)
  if outerParent == null || outerChild == null
    return
  end
  let temporaryParent = stagedParent.id
  let temporaryChild = stagedChild.id

  test::assertTrue(staged.link_childrenFor_Parent_by_parentId(outerParent, outerChild) == null)
  saved(staged.saveChanges(), 2)

  test::assertTrue(stagedParent.id > 0 && stagedChild.id > 0)
  test::assertTrue(staged.removeCascade_parents(outerParent) == null)
  test::assertTrue(stagedChild.parentId == null)
  saved(staged.saveChanges(), 2)
  saved(staged.rollbackTransaction(), 0)
  counts(provider, 0, 0, 1)

  test::assertEqual(stagedParent.id, temporaryParent)
  test::assertEqual(stagedChild.id, temporaryChild)
  test::assertTrue(stagedChild.parentId == null)
  detachedRemoval(staged.parents.remove(stagedParent))
  saved(staged.saveChanges(), 1)
  counts(provider, 0, 0, 2)
  let retried = new NullDatabase(provider)

  match retried.children.where(id: stagedChild.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyRollback(provider: SQLiteProvider): Void
  let db = new NullDatabase(provider)
  let parent = new Parent(0, "rollback")
  let child = new Child(0, null, null, "rollback")
  let p = tracked(db.parents.addWithHandle(parent))
  let c = tracked(db.children.addWithHandle(child))

  test::assertTrue(p != null && c != null)
  if p == null || c == null
    return
  end

  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, c) == null)
  saved(db.saveChanges(), 2)
  let oldId = parent.id

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.removeCascade_parents(p) == null)
  saved(db.saveChanges(), 2)
  counts(provider, 0, 0, 1)
  saved(db.rollbackTransaction(), 0)
  counts(provider, 1, 0, 1)
  let restored = new NullDatabase(provider)

  test::assertTrue(child.parentId == null)
  match restored.children.where(id: child.id).single()
    case QueryValue.Value(value)
      optionalInt(value.parentId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  saved(db.saveChanges(), 2)
  counts(provider, 0, 0, 1)
  let retried = new NullDatabase(provider)

  match retried.children.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifySavepointRetry(provider: SQLiteProvider): Void
  let db = new NullDatabase(provider)
  let parent = new Parent(0, "savepoint")
  let first = new Child(0, null, null, "first")
  let blocked = new Child(0, null, null, "blocked")
  let p = tracked(db.parents.addWithHandle(parent))
  let a = tracked(db.children.addWithHandle(first))
  let b = tracked(db.children.addWithHandle(blocked))

  test::assertTrue(p != null && a != null && b != null)
  if p == null || a == null || b == null
    return
  end

  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, a) == null)
  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, b) == null)
  saved(db.saveChanges(), 3)
  let oldId = parent.id
  let earlier = new Code("earlier accepted")

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.codes.add(earlier) == null)
  saved(db.saveChanges(), 1)

  test::assertTrue(db.removeCascade_parents(p) == null)
  failedCheck(db.saveChanges())
  counts(provider, 1, 0, 2)
  let read = new NullDatabase(provider)

  test::assertTrue(first.parentId == null && blocked.parentId == null)
  match read.codes.where(value: earlier.value).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.children.where(id: first.id).single()
    case QueryValue.Value(value)
      optionalInt(value.parentId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.children.where(id: blocked.id).single()
    case QueryValue.Value(value)
      optionalInt(value.parentId, oldId)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  blocked.label = "allowed"
  saved(db.saveChanges(), 3)
  saved(db.commitTransaction(), 0)
  counts(provider, 0, 0, 2)
  let committed = new NullDatabase(provider)

  match committed.children.where(id: first.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match committed.children.where(id: blocked.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.parentId == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyHidden(provider: SQLiteProvider, path: String): Void
  let db = new NullDatabase(provider)
  let parent = new Parent(0, "hidden")
  let known = new Child(0, null, null, "known")
  let p = tracked(db.parents.addWithHandle(parent))
  let k = tracked(db.children.addWithHandle(known))

  test::assertTrue(p != null && k != null)
  if p == null || k == null
    return
  end

  test::assertTrue(db.link_childrenFor_Parent_by_parentId(p, k) == null)
  saved(db.saveChanges(), 2)
  let sql = "INSERT INTO children(id,parent_id,branch_id,label) VALUES(100," + (parent.id as String) + ",NULL,'hidden');"

  test::assertTrue(createSQLiteFixture(path, sql))
  counts(provider, 1, 0, 2)

  test::assertTrue(db.removeCascade_parents(p) == null)
  failedForeignKey(db.saveChanges())
  counts(provider, 1, 0, 2)
  let read = new NullDatabase(provider)

  test::assertTrue(known.parentId == null)
  match read.children.where(id: known.id).single()
    case QueryValue.Value(value)
      optionalInt(value.parentId, parent.id)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyString(provider: SQLiteProvider): Void
  let db = new NullDatabase(provider)
  let key = "O'Reilly; DROP TABLE codes; -- 水"
  let code = new Code(key)
  let child = new TextChild(1, null)
  let c = tracked(db.codes.addWithHandle(code))
  let t = tracked(db.textChildren.addWithHandle(child))

  test::assertTrue(c != null && t != null)
  if c == null || t == null
    return
  end

  test::assertTrue(db.link_textChildrenFor_Code_by_codeValue(c, t) == null)
  saved(db.saveChanges(), 2)
  let linked = new NullDatabase(provider)

  match linked.textChildren.where(id: child.id).single()
    case QueryValue.Value(value)
      let linkedCode = value.codeValue

      test::assertTrue(linkedCode != null)
      if linkedCode != null
        test::assertEqual(linkedCode, key)
      end
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end

  test::assertTrue(db.removeCascade_codes(c) == null)
  test::assertTrue(child.codeValue == null)
  saved(db.saveChanges(), 2)
  let read = new NullDatabase(provider)

  match read.codes.count()
    case QueryValue.Value(value)
      test::assertEqual(value, 0)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.textChildren.where(id: child.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.codeValue == null)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyFiles(): resources::Outcome<Int, result::Failure>
  using temporary <- files::TemporaryDirectory.create("neri-client-null-")
    let schema = "CREATE TABLE parents(id INTEGER PRIMARY KEY,name TEXT NOT NULL); CREATE TABLE branches(id INTEGER PRIMARY KEY,parent_id INTEGER NOT NULL REFERENCES parents(id) ON DELETE RESTRICT); CREATE TABLE children(id INTEGER PRIMARY KEY,parent_id INTEGER REFERENCES parents(id) ON DELETE RESTRICT,branch_id INTEGER REFERENCES branches(id) ON DELETE RESTRICT,label TEXT NOT NULL,CHECK(parent_id IS NOT NULL OR label != 'blocked')); CREATE TABLE codes(value TEXT PRIMARY KEY); CREATE TABLE text_children(id INTEGER PRIMARY KEY,code_value TEXT REFERENCES codes(value) ON DELETE RESTRICT);"
    let mixedPath = temporary.path() + "/mixed.sqlite"
    let addedPath = temporary.path() + "/added.sqlite"
    let rollbackPath = temporary.path() + "/rollback.sqlite"
    let savepointPath = temporary.path() + "/savepoint.sqlite"
    let hiddenPath = temporary.path() + "/hidden.sqlite"
    let stringPath = temporary.path() + "/string.sqlite"

    test::assertTrue(createSQLiteFixture(mixedPath, schema))
    test::assertTrue(createSQLiteFixture(addedPath, schema))
    test::assertTrue(createSQLiteFixture(rollbackPath, schema))
    test::assertTrue(createSQLiteFixture(savepointPath, schema))
    test::assertTrue(createSQLiteFixture(hiddenPath, schema))
    test::assertTrue(createSQLiteFixture(stringPath, schema))
    match SQLiteProvider.openWritable(mixedPath)
      case SQLiteOpenResult.Opened(provider)
        verifyMixed(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(addedPath)
      case SQLiteOpenResult.Opened(provider)
        verifyAddedParent(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(rollbackPath)
      case SQLiteOpenResult.Opened(provider)
        verifyRollback(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(savepointPath)
      case SQLiteOpenResult.Opened(provider)
        verifySavepointRetry(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(hiddenPath)
      case SQLiteOpenResult.Opened(provider)
        verifyHidden(provider, hiddenPath)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    match SQLiteProvider.openWritable(stringPath)
      case SQLiteOpenResult.Opened(provider)
        verifyString(provider)

        test::assertTrue(provider.close())
      case SQLiteOpenResult.Failure(message)
        test::assertTrue(false)
    end
    return 0
  end
  return 1
end

def main(): Void
  let completed = verifyFiles()

  test::assertEqual(completed.closeFailures.count(), 0)
  match completed.completion
    case resources::Completion.Value(value)
      test::assertEqual(value, 0)
    case resources::Completion.Failure(error)
      test::assertTrue(false)
  end
  console::println("Client set-null integration contract passed")
end
