namespace null_model

class Parent
  public id: Int
  public name: String

  def init(id: Int, name: String): Void
    this.id = id
    this.name = name
  end
end

class Branch
  public id: Int
  public parentId: Int

  def init(id: Int, parentId: Int): Void
    this.id = id
    this.parentId = parentId
  end
end

class Child
  public id: Int
  public parentId: Int?
  public branchId: Int?
  public label: String

  def init(id: Int, parentId: Int?, branchId: Int?, label: String): Void
    this.id = id
    this.parentId = parentId
    this.branchId = branchId
    this.label = label
  end
end

class Code
  public value: String

  def init(value: String): Void
    this.value = value
  end
end

class TextChild
  public id: Int
  public codeValue: String?

  def init(id: Int, codeValue: String?): Void
    this.id = id
    this.codeValue = codeValue
  end
end
