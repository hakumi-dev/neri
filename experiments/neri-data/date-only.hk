use host
use quotation
namespace neri_data

## A proleptic Gregorian calendar date in the range 0001..9999.
class DateOnly
  private value: String = "0001-01-01"

  static def minimum(): DateOnly
    return new DateOnly()
  end

  static def parse(value: String): DateOnly?
    if host::stringByteLength(value) != 10 || host::stringByteAt(
      value,
      4
    ) as Int != 45 || host::stringByteAt(
      value,
      7
    ) as Int != 45
      return null
    end
    let year = calendarDigits(value, 0, 4)
    let month = calendarDigits(value, 5, 2)
    let day = calendarDigits(value, 8, 2)

    if year < 1 || month < 1 || month > 12 || day < 1
      return null
    end
    var maximum = 31

    if month == 4 || month == 6 || month == 9 || month == 11
      maximum = 30
    else if month == 2
      maximum = year - year / 4 * 4 == 0 && (year - year / 100 * 100 != 0 || year - year / 400 * 400 == 0) ? 29 : 28
    end
    if day > maximum
      return null
    end
    let result = new DateOnly()

    result.value = value
    return result
  end

  public readonly def toText(): String
    return this.value
  end

  public static def captureQuotation(value: readonly DateOnly?): quotation::CaptureValue
    return value == null ? quotation::CaptureValue.Null() : quotation::CaptureValue.Text(value.toText())
  end

  @operator("==")
  public readonly def equals(other: readonly DateOnly): Bool
    return this.value == other.value
  end

  @operator("!=")
  public readonly def notEquals(other: readonly DateOnly): Bool
    return this.value != other.value
  end

  @operator("<")
  public readonly def before(other: readonly DateOnly): Bool
    return compareScalarText(this.value, other.value) < 0
  end

  @operator("<=")
  public readonly def beforeOrEqual(other: readonly DateOnly): Bool
    return compareScalarText(this.value, other.value) <= 0
  end

  @operator(">")
  public readonly def after(other: readonly DateOnly): Bool
    return compareScalarText(this.value, other.value) > 0
  end

  @operator(">=")
  public readonly def afterOrEqual(other: readonly DateOnly): Bool
    return compareScalarText(this.value, other.value) >= 0
  end
end
