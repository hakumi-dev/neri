use buffers
use neri_data
use test

class ShadowContractEntity
  public id: Int = 1
end

def shadowInt(store: ShadowProperties<ShadowContractEntity>, entity: ShadowContractEntity, name: String): Int
  let row = new RawRow([new RawColumn(name, store.getOrDefault(entity, name, Cell.Int(-1)))])

  match decodeInt(row, name)
    case DecodeResult.Value(value)
      return value
    case DecodeResult.Failure(error)
      test::assertTrue(false)
      return -1
  end
end

def verifyShadowBinaryOwnership(): Void
  let store = new ShadowProperties<ShadowContractEntity>()
  let entity = new ShadowContractEntity()
  let bytes = new ByteBuffer(8, 2)

  bytes.append(1 as Byte)

  test::assertTrue(store.set(entity, "bytes", Cell.Binary(bytes)) == null)

  bytes.append(2 as Byte)
  let first = new RawRow([new RawColumn("bytes", store.getOrDefault(entity, "bytes", Cell.Null()))])

  match decodeByteBuffer(first, "bytes")
    case DecodeResult.Failure(error)
      test::assertTrue(false)
    case DecodeResult.Value(copy)
      test::assertEqual(copy.length(), 1)

      copy.append(3 as Byte)
  end
  let second = new RawRow([new RawColumn("bytes", store.getOrDefault(entity, "bytes", Cell.Null()))])

  match decodeByteBuffer(second, "bytes")
    case DecodeResult.Failure(error)
      test::assertTrue(false)
    case DecodeResult.Value(copy)
      test::assertEqual(copy.length(), 1)
      test::assertTrue(copy.byteAt(0) == (1 as Byte))
  end
end

def main(): Void
  let store = new ShadowProperties<ShadowContractEntity>(2, 1)
  let first = new ShadowContractEntity()
  let second = new ShadowContractEntity()
  let third = new ShadowContractEntity()

  test::assertTrue(store.set(first, "tenant", Cell.Int(7)) == null)
  test::assertTrue(store.set(second, "tenant", Cell.Int(9)) == null)
  test::assertEqual(shadowInt(store, first, "tenant"), 7)
  test::assertEqual(shadowInt(store, second, "tenant"), 9)
  test::assertTrue(store.set(third, "tenant", Cell.Int(11)) != null)
  test::assertTrue(store.set(first, "extra", Cell.Int(13)) != null)
  test::assertTrue(store.set(first, "tenant", Cell.Int(17)) == null)
  test::assertEqual(shadowInt(store, first, "tenant"), 17)
  test::assertEqual(shadowInt(store, third, "tenant"), -1)

  store.forget(second)

  test::assertTrue(store.set(third, "tenant", Cell.Int(11)) == null)
  test::assertEqual(shadowInt(store, second, "tenant"), -1)

  store.clear()

  test::assertEqual(shadowInt(store, first, "tenant"), -1)
  test::assertTrue(store.set(second, "tenant", Cell.Int(19)) == null)
  test::assertTrue(store.set(first, "", Cell.Int(1)) != null)

  verifyShadowBinaryOwnership()
end
