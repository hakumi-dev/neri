use host
namespace neri_data

## A typed scalar decoder and its result-column contract.
class ScalarCodec<R>
  private readCell: fn(Cell): DecodeResult<R>
  private resultKind: ResultColumnKind
  private isNullable: Bool
  private canonicalName: String

  public def init(read: fn(Cell): DecodeResult<R>, kind: ResultColumnKind, nullable: Bool, typeName: String): Void
    this.readCell = read
    this.resultKind = kind
    this.isNullable = nullable
    this.canonicalName = typeName
  end

  ## Decodes one provider cell without performing a type conversion.
  public def decode(cell: Cell): DecodeResult<R>
    return this.readCell(cell)
  end

  ## Returns the canonical Neri scalar type name, including '?' when nullable.
  public readonly def typeName(): String
    return this.canonicalName
  end

  ## Returns the provider result-column kind for this scalar.
  public def kind(): ResultColumnKind
    return this.resultKind
  end

  ## Reports whether NULL is a valid decoded value.
  public readonly def nullable(): Bool
    return this.isNullable
  end

  ## Builds a one-column decoder and preserves the requested column name in errors.
  public def decoder(column: String): Decoder<R>
    let codec = this
    let read: fn(RawRow): DecodeResult<R> = fn(rawRow: RawRow): DecodeResult<R>
      match rawRow.value(column)
        case CellLookup.Missing()
          return DecodeResult<R>.Failure(QueryFailure.MissingColumn(column))
        case CellLookup.Found(cell)
          match codec.decode(cell)
            case DecodeResult.Value(value)
              return DecodeResult<R>.Value(value)
            case DecodeResult.Failure(error)
              return DecodeResult<R>.Failure(scalarColumnError(error, column))
          end
      end
    end

    return new Decoder<R>(read, new ResultColumns([new ResultColumn(column, this.kind(), this.nullable())]))
  end
end

def scalarColumnError(error: QueryFailure, column: String): QueryFailure
  match error
    case QueryFailure.TypeMismatch(unused, expected, actual)
      return QueryFailure.TypeMismatch(column, expected, actual)
    case QueryFailure.InvalidIdentifier(name)
      return QueryFailure.InvalidIdentifier(name)
    case QueryFailure.InvalidLimit(value, maximum)
      return QueryFailure.InvalidLimit(value, maximum)
    case QueryFailure.MissingLimit(maximum)
      return QueryFailure.MissingLimit(maximum)
    case QueryFailure.SourceMismatch(expected, actual)
      return QueryFailure.SourceMismatch(expected, actual)
    case QueryFailure.UnsupportedCapability(name)
      return QueryFailure.UnsupportedCapability(name)
    case QueryFailure.Provider(message)
      return QueryFailure.Provider(message)
    case QueryFailure.MissingColumn(name)
      return QueryFailure.MissingColumn(name)
  end
end

def decodeScalarBool(cell: Cell): DecodeResult<Bool>
  match cell
    case Cell.Bool(value)
      return DecodeResult<Bool>.Value(value)
    case Cell.Null()
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "NULL"))
    case Cell.Int(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "Int"))
    case Cell.Text(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "String"))
  end
end

def decodeScalarInt(cell: Cell): DecodeResult<Int>
  match cell
    case Cell.Int(value)
      return DecodeResult<Int>.Value(value)
    case Cell.Null()
      return DecodeResult<Int>.Failure(QueryFailure.TypeMismatch("", "Int", "NULL"))
    case Cell.Bool(value)
      return DecodeResult<Int>.Failure(QueryFailure.TypeMismatch("", "Int", "Bool"))
    case Cell.Text(value)
      return DecodeResult<Int>.Failure(QueryFailure.TypeMismatch("", "Int", "String"))
  end
end

def decodeScalarText(cell: Cell): DecodeResult<String>
  match cell
    case Cell.Text(value)
      return DecodeResult<String>.Value(value)
    case Cell.Null()
      return DecodeResult<String>.Failure(QueryFailure.TypeMismatch("", "String", "NULL"))
    case Cell.Bool(value)
      return DecodeResult<String>.Failure(QueryFailure.TypeMismatch("", "String", "Bool"))
    case Cell.Int(value)
      return DecodeResult<String>.Failure(QueryFailure.TypeMismatch("", "String", "Int"))
  end
end

def decodeScalarOptionalBool(cell: Cell): DecodeResult<Bool?>
  match cell
    case Cell.Null()
      return DecodeResult<Bool?>.Value(null)
    case Cell.Bool(value)
      return DecodeResult<Bool?>.Value(value)
    case Cell.Int(value)
      return DecodeResult<Bool?>.Failure(QueryFailure.TypeMismatch("", "Bool?", "Int"))
    case Cell.Text(value)
      return DecodeResult<Bool?>.Failure(QueryFailure.TypeMismatch("", "Bool?", "String"))
  end
end

def decodeScalarOptionalInt(cell: Cell): DecodeResult<Int?>
  match cell
    case Cell.Null()
      return DecodeResult<Int?>.Value(null)
    case Cell.Int(value)
      return DecodeResult<Int?>.Value(value)
    case Cell.Bool(value)
      return DecodeResult<Int?>.Failure(QueryFailure.TypeMismatch("", "Int?", "Bool"))
    case Cell.Text(value)
      return DecodeResult<Int?>.Failure(QueryFailure.TypeMismatch("", "Int?", "String"))
  end
end

def decodeScalarOptionalText(cell: Cell): DecodeResult<String?>
  match cell
    case Cell.Null()
      return DecodeResult<String?>.Value(null)
    case Cell.Text(value)
      return DecodeResult<String?>.Value(value)
    case Cell.Bool(value)
      return DecodeResult<String?>.Failure(QueryFailure.TypeMismatch("", "String?", "Bool"))
    case Cell.Int(value)
      return DecodeResult<String?>.Failure(QueryFailure.TypeMismatch("", "String?", "Int"))
  end
end

## Creates a strict non-nullable boolean scalar codec.
def boolScalar(): ScalarCodec<Bool>
  return new ScalarCodec<Bool>(decodeScalarBool, ResultColumnKind.Bool(), false, "Bool")
end

## Creates a strict non-nullable integer scalar codec.
def intScalar(): ScalarCodec<Int>
  return new ScalarCodec<Int>(decodeScalarInt, ResultColumnKind.Int(), false, "Int")
end

## Creates a strict non-nullable text scalar codec.
def textScalar(): ScalarCodec<String>
  return new ScalarCodec<String>(decodeScalarText, ResultColumnKind.Text(), false, "String")
end

## Creates a nullable boolean scalar codec.
def optionalBoolScalar(): ScalarCodec<Bool?>
  return new ScalarCodec<Bool?>(decodeScalarOptionalBool, ResultColumnKind.Bool(), true, "Bool?")
end

## Creates a nullable integer scalar codec.
def optionalIntScalar(): ScalarCodec<Int?>
  return new ScalarCodec<Int?>(decodeScalarOptionalInt, ResultColumnKind.Int(), true, "Int?")
end

## Creates a nullable text scalar codec.
def optionalTextScalar(): ScalarCodec<String?>
  return new ScalarCodec<String?>(decodeScalarOptionalText, ResultColumnKind.Text(), true, "String?")
end
