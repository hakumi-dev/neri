def decodeScalarFloat(cell: Cell): DecodeResult<Float>
  match cell
    case Cell.Float(value)
      if !dataFloatFinite(value)
        return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "finite Float", "Float"))
      end
      return DecodeResult<Float>.Value(value)
    case Cell.Null()
      return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "Float", "NULL"))
    case Cell.Bool(value)
      return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "Float", "Bool"))
    case Cell.Int(value)
      return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "Float", "Int"))
    case Cell.Text(value)
      return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "Float", "String"))
    case Cell.Binary(value)
      return DecodeResult<Float>.Failure(QueryFailure.TypeMismatch("", "Float", "ByteBuffer"))
  end
end

def decodeScalarOptionalFloat(cell: Cell): DecodeResult<Float?>
  match cell
    case Cell.Null()
      return DecodeResult<Float?>.Value(null)
    case Cell.Float(value)
      if !dataFloatFinite(value)
        return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch("", "finite Float?", "Float"))
      end
      return DecodeResult<Float?>.Value(value)
    case Cell.Bool(value)
      return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch("", "Float?", "Bool"))
    case Cell.Int(value)
      return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch("", "Float?", "Int"))
    case Cell.Text(value)
      return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch("", "Float?", "String"))
    case Cell.Binary(value)
      return DecodeResult<Float?>.Failure(QueryFailure.TypeMismatch("", "Float?", "ByteBuffer"))
  end
end

## Creates a strict non-nullable boolean scalar codec.
def boolScalar(): ScalarCodec<Bool>
  return new ScalarCodec<Bool>(decodeScalarBool, ResultColumnKind.Bool(), false, "Bool").certifySqlValue()
end

## Creates a strict non-nullable integer scalar codec.
def intScalar(): ScalarCodec<Int>
  return new ScalarCodec<Int>(decodeScalarInt, ResultColumnKind.Int(), false, "Int").certifySqlValue()
end

## Creates a strict finite floating-point scalar codec.
def floatScalar(): ScalarCodec<Float>
  return new ScalarCodec<Float>(decodeScalarFloat, ResultColumnKind.Float(), false, "Float").certifySqlValue()
end

## Creates a strict non-nullable text scalar codec.
def textScalar(): ScalarCodec<String>
  return new ScalarCodec<String>(decodeScalarText, ResultColumnKind.Text(), false, "String").certifySqlValue()
end

## Creates a nullable boolean scalar codec.
def optionalBoolScalar(): ScalarCodec<Bool?>
  return new ScalarCodec<Bool?>(decodeScalarOptionalBool, ResultColumnKind.Bool(), true, "Bool?").certifySqlValue()
end

## Creates a nullable integer scalar codec.
def optionalIntScalar(): ScalarCodec<Int?>
  return new ScalarCodec<Int?>(decodeScalarOptionalInt, ResultColumnKind.Int(), true, "Int?").certifySqlValue()
end

## Creates a strict nullable finite floating-point scalar codec.
def optionalFloatScalar(): ScalarCodec<Float?>
  return new ScalarCodec<Float?>(decodeScalarOptionalFloat, ResultColumnKind.Float(), true, "Float?").certifySqlValue()
end

## Creates a nullable text scalar codec.
def optionalTextScalar(): ScalarCodec<String?>
  return new ScalarCodec<String?>(decodeScalarOptionalText, ResultColumnKind.Text(), true, "String?").certifySqlValue()
end

## Copies a binary value for a stable row snapshot.
def copyBinary(value: readonly ByteBuffer): ByteBuffer
  let result = new ByteBuffer(134217728, value.length())

  result.appendBytes(value.snapshot())
  return result
end

def sameBinary(left: readonly ByteBuffer, right: readonly ByteBuffer): Bool
  if left.length() != right.length()
    return false
  end
  var index = 0

  while index < left.length()
    if left.byteAt(index) != right.byteAt(index)
      return false
    end
    index = index + 1
  end
  return true
end

def decodeScalarByteBuffer(cell: Cell): DecodeResult<ByteBuffer>
  match cell
    case Cell.Null()
      return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer", "NULL"))
    case Cell.Bool(value)
      return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer", "Bool"))
    case Cell.Int(value)
      return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer", "Int"))
    case Cell.Float(value)
      return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer", "Float"))
    case Cell.Text(value)
      return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer", "String"))
    case Cell.Binary(value)
      if value.length() > 134217728
        return DecodeResult<ByteBuffer>.Failure(QueryFailure.TypeMismatch(
            "",
            "bounded ByteBuffer",
            "oversized ByteBuffer"
          ))
      end
      return DecodeResult<ByteBuffer>.Value(copyBinary(value))
  end
end

def binaryScalar(): ScalarCodec<ByteBuffer>
  return new ScalarCodec<ByteBuffer>(decodeScalarByteBuffer, ResultColumnKind.Binary(), false, "buffers.ByteBuffer")
end

def decodeByteBuffer(row: RawRow, column: String): DecodeResult<ByteBuffer>
  return decodeScalarColumn(row, column, binaryScalar())
end

def decodeScalarDecimal(cell: Cell): DecodeResult<Decimal>
  match cell
    case Cell.Null()
      return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch("", "Decimal", "NULL"))
    case Cell.Bool(value)
      return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch("", "Decimal", "Bool"))
    case Cell.Int(value)
      return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch("", "Decimal", "Int"))
    case Cell.Float(value)
      return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch("", "Decimal", "Float"))
    case Cell.Text(value)
      let decimal = Decimal.parse(value)

      if decimal == null || decimal.text() != value
        return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch(
            "",
            "exact Decimal",
            "noncanonical decimal text"
          ))
      end
      return DecodeResult<Decimal>.Value(decimal)
    case Cell.Binary(value)
      return DecodeResult<Decimal>.Failure(QueryFailure.TypeMismatch("", "Decimal", "ByteBuffer"))
  end
end

def decimalScalar(): ScalarCodec<Decimal>
  return new ScalarCodec<Decimal>(decodeScalarDecimal, ResultColumnKind.Text(), false, "neri_data.Decimal")
end

def decodeDecimal(row: RawRow, column: String): DecodeResult<Decimal>
  return decodeScalarColumn(row, column, decimalScalar())
end

def decodeScalarOptionalByteBuffer(cell: Cell): DecodeResult<ByteBuffer?>
  match cell
    case Cell.Null()
      return DecodeResult<ByteBuffer?>.Value(null)
    case Cell.Bool(value)
      return DecodeResult<ByteBuffer?>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer?", "Bool"))
    case Cell.Int(value)
      return DecodeResult<ByteBuffer?>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer?", "Int"))
    case Cell.Float(value)
      return DecodeResult<ByteBuffer?>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer?", "Float"))
    case Cell.Text(value)
      return DecodeResult<ByteBuffer?>.Failure(QueryFailure.TypeMismatch("", "ByteBuffer?", "String"))
    case Cell.Binary(value)
      if value.length() > 134217728
        return DecodeResult<ByteBuffer?>.Failure(QueryFailure.TypeMismatch(
            "",
            "bounded ByteBuffer?",
            "oversized ByteBuffer"
          ))
      end
      return DecodeResult<ByteBuffer?>.Value(copyBinary(value))
  end
end

def optionalBinaryScalar(): ScalarCodec<ByteBuffer?>
  return new ScalarCodec<ByteBuffer?>(
    decodeScalarOptionalByteBuffer,
    ResultColumnKind.Binary(),
    true,
    "buffers.ByteBuffer?"
  )
end

def decodeNullableByteBuffer(row: RawRow, column: String): DecodeResult<ByteBuffer?>
  return decodeScalarColumn(row, column, optionalBinaryScalar())
end

def decodeScalarOptionalDecimal(cell: Cell): DecodeResult<Decimal?>
  match cell
    case Cell.Null()
      return DecodeResult<Decimal?>.Value(null)
    case Cell.Bool(value)
      return DecodeResult<Decimal?>.Failure(QueryFailure.TypeMismatch("", "Decimal?", "Bool"))
    case Cell.Int(value)
      return DecodeResult<Decimal?>.Failure(QueryFailure.TypeMismatch("", "Decimal?", "Int"))
    case Cell.Float(value)
      return DecodeResult<Decimal?>.Failure(QueryFailure.TypeMismatch("", "Decimal?", "Float"))
    case Cell.Text(value)
      let decimal = Decimal.parse(value)

      if decimal == null || decimal.text() != value
        return DecodeResult<Decimal?>.Failure(QueryFailure.TypeMismatch("", "exact Decimal", "invalid decimal text"))
      end
      return DecodeResult<Decimal?>.Value(decimal)
    case Cell.Binary(value)
      return DecodeResult<Decimal?>.Failure(QueryFailure.TypeMismatch("", "Decimal?", "ByteBuffer"))
  end
end

def optionalDecimalScalar(): ScalarCodec<Decimal?>
  return new ScalarCodec<Decimal?>(decodeScalarOptionalDecimal, ResultColumnKind.Text(), true, "neri_data.Decimal?")
end

def decodeNullableDecimal(row: RawRow, column: String): DecodeResult<Decimal?>
  return decodeScalarColumn(row, column, optionalDecimalScalar())
end
