use host
use buffers
namespace neri_data

## A typed scalar decoder and its result-column contract.
class ScalarCodec<R>
  private readCell: fn(Cell): DecodeResult<R>
  private resultKind: ResultColumnKind
  private isNullable: Bool
  private canonicalName: String
  private sqlValuePreserved: Bool = false

  def init(read: fn(Cell): DecodeResult<R>, kind: ResultColumnKind, nullable: Bool, typeName: String): Void
    this.readCell = read
    this.resultKind = kind
    this.isNullable = nullable
    this.canonicalName = typeName
  end

  ## Decodes one provider cell using the configured reader.
  public def decode(cell: Cell): DecodeResult<R>
    return this.readCell(cell)
  end

  ## Returns the canonical Neri scalar type name, including '?' when nullable.
  public readonly def typeName(): String
    return this.canonicalName
  end

  ## Returns the provider result-column kind for this scalar.
  public def kind(): ResultColumnKind
    return this.resultKind
  end

  ## Reports whether NULL is a valid decoded value.
  public readonly def nullable(): Bool
    return this.isNullable
  end

  internal readonly def preservesSqlValue(): Bool
    return this.sqlValuePreserved
  end

  internal def certifySqlValue(): ScalarCodec<R>
    this.sqlValuePreserved = true
    return this
  end

  ## Builds a one-column decoder and preserves the requested column name in errors.
  public def decoder(column: String): Decoder<R>
    let codec = this
    let read: fn(RawRow): DecodeResult<R> = fn(rawRow: RawRow): DecodeResult<R> do
      match rawRow.value(column)
        case CellLookup.Missing()
          return DecodeResult<R>.Failure(QueryFailure.MissingColumn(column))
        case CellLookup.Found(cell)
          match codec.decode(cell)
            case DecodeResult.Value(value)
              return DecodeResult<R>.Value(value)
            case DecodeResult.Failure(error)
              return DecodeResult<R>.Failure(scalarColumnError(error, column))
          end
      end
    end

    return new Decoder<R>(read, new ResultColumns([new ResultColumn(column, this.kind(), this.nullable())]))
  end
end

## Decodes a named provider cell through a scalar codec without coercion.
def decodeScalarColumn<R>(row: RawRow, column: String, codec: ScalarCodec<R>): DecodeResult<R>
  match row.value(column)
    case CellLookup.Missing()
      return DecodeResult<R>.Failure(QueryFailure.MissingColumn(column))
    case CellLookup.Found(cell)
      match codec.decode(cell)
        case DecodeResult.Value(value)
          return DecodeResult<R>.Value(value)
        case DecodeResult.Failure(error)
          return DecodeResult<R>.Failure(scalarColumnError(error, column))
      end
  end
end

## Builds a strict two-scalar row decoder for a materialized projection value.
def select2Decoder<A, B, R>(
  first: ScalarCodec<A>,
  firstColumn: String,
  second: ScalarCodec<B>,
  secondColumn: String,
  materialize: fn(A, B): R
): Decoder<R>
  let read: fn(RawRow): DecodeResult<R> = fn(row: RawRow): DecodeResult<R> do
    match decodeScalarColumn(row, firstColumn, first)
      case DecodeResult.Failure(error)
        return DecodeResult<R>.Failure(error)
      case DecodeResult.Value(firstValue)
        match decodeScalarColumn(row, secondColumn, second)
          case DecodeResult.Failure(error)
            return DecodeResult<R>.Failure(error)
          case DecodeResult.Value(secondValue)
            return DecodeResult<R>.Value(materialize(firstValue, secondValue))
        end
    end
  end

  return new Decoder<R>(
    read,
    new ResultColumns([
        new ResultColumn(firstColumn, first.kind(), first.nullable()),
        new ResultColumn(secondColumn, second.kind(), second.nullable())
      ])
  )
end

def scalarColumnError(error: QueryFailure, column: String): QueryFailure
  match error
    case QueryFailure.TypeMismatch(unused, expected, actual)
      return QueryFailure.TypeMismatch(column, expected, actual)
    case QueryFailure.InvalidIdentifier(name)
      return QueryFailure.InvalidIdentifier(name)
    case QueryFailure.InvalidLimit(value, maximum)
      return QueryFailure.InvalidLimit(value, maximum)
    case QueryFailure.MissingLimit(maximum)
      return QueryFailure.MissingLimit(maximum)
    case QueryFailure.SourceMismatch(expected, actual)
      return QueryFailure.SourceMismatch(expected, actual)
    case QueryFailure.UnsupportedCapability(name)
      return QueryFailure.UnsupportedCapability(name)
    case QueryFailure.Provider(message)
      return QueryFailure.Provider(message)
    case QueryFailure.MissingColumn(name)
      return QueryFailure.MissingColumn(name)
    case QueryFailure.Cardinality(expected, actual)
      return QueryFailure.Cardinality(expected, actual)
    case QueryFailure.Cleanup(failure)
      return QueryFailure.Cleanup(new QueryCleanupFailure(
          scalarColumnError(failure.primary(), column),
          failure.cleanup()
        ))
  end
end

def decodeScalarBool(cell: Cell): DecodeResult<Bool>
  match cell
    case Cell.Bool(value)
      return DecodeResult<Bool>.Value(value)
    case Cell.Null()
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "NULL"))
    case Cell.Int(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "Int"))
    case Cell.Float(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "Float"))
    case Cell.Text(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "String"))
    case Cell.Binary(value)
      return DecodeResult<Bool>.Failure(QueryFailure.TypeMismatch("", "Bool", "ByteBuffer"))
  end
end

