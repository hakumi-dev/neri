use cascade_data
use cascade_model
use console
use files
use neri_data
use neri_data_sqlite
use neri_data_sqlite_fixture
use resources
use result
use test

def tracked<T>(result: TrackHandleResult<T>): TrackedHandle<T>?
  match result
    case TrackHandleResult.Tracked(handle)
      return handle
    case TrackHandleResult.Failure(error)
      test::assertTrue(false)
      return null
  end
end

def saved(result: WriteResult, expected: Int): Void
  match result
    case WriteResult.Saved(count)

      test::assertEqual(count, expected)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      console::println(writeFailureMessage(error))

      test::assertTrue(false)
  end
end

def failed(result: WriteResult): Void
  match result
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertEqual(writeFailureMessage(error), "SQLite step failed (code 1811): FOREIGN KEY constraint failed")
  end
end

def detachedRemoval(result: QueryFailure?): Void
  test::assertTrue(result != null)
  if result != null
    match result
      case QueryFailure.Provider(message)
        test::assertEqual(message, "entity is detached")
      case QueryFailure.InvalidIdentifier(name)
        test::assertTrue(false)
      case QueryFailure.InvalidLimit(value, maximum)
        test::assertTrue(false)
      case QueryFailure.MissingLimit(maximum)
        test::assertTrue(false)
      case QueryFailure.SourceMismatch(expected, actual)
        test::assertTrue(false)
      case QueryFailure.UnsupportedCapability(name)
        test::assertTrue(false)
      case QueryFailure.MissingColumn(name)
        test::assertTrue(false)
      case QueryFailure.TypeMismatch(column, expected, actual)
        test::assertTrue(false)
      case QueryFailure.Cardinality(expected, actual)
        test::assertTrue(false)
    end
  end
end

def counts(provider: SQLiteProvider, roots: Int, branches: Int, leaves: Int): Void
  let read = new CascadeDatabase(provider)

  match read.roots.count()
    case QueryValue.Value(value)
      test::assertEqual(value, roots)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.branches.count()
    case QueryValue.Value(value)
      test::assertEqual(value, branches)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.leaves.count()
    case QueryValue.Value(value)
      test::assertEqual(value, leaves)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

def verifyDiamond(provider: SQLiteProvider): Void
  let db = new CascadeDatabase(provider)
  let root = new cascade_model::Root(0, "diamond")
  let left = new Branch(0, 0, "left")
  let right = new Branch(0, 0, "right")
  let shared = new Leaf(0, null, 0, "shared")
  let r = tracked(db.roots.addWithHandle(root))
  let l = tracked(db.branches.addWithHandle(left))
  let b = tracked(db.branches.addWithHandle(right))
  let s = tracked(db.leaves.addWithHandle(shared))

  test::assertTrue(r != null && l != null && b != null && s != null)
  if r == null || l == null || b == null || s == null
    return
  end

  test::assertTrue(db.link_branchesFor_Root_by_rootId(r, l) == null)
  test::assertTrue(db.link_branchesFor_Root_by_rootId(r, b) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_leftId(l, s) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_rightId(b, s) == null)
  saved(db.saveChanges(), 4)
  counts(provider, 1, 2, 1)

  test::assertTrue(db.removeCascade_roots(r) == null)
  saved(db.saveChanges(), 4)
  counts(provider, 0, 0, 0)
end

def verifyUnregisteredRetry(provider: SQLiteProvider, path: String): Void
  let db = new CascadeDatabase(provider)
  let root = new cascade_model::Root(0, "registered")
  let branch = new Branch(0, 0, "registered")
  let known = new Leaf(0, null, 0, "known")
  let r = tracked(db.roots.addWithHandle(root))
  let b = tracked(db.branches.addWithHandle(branch))
  let k = tracked(db.leaves.addWithHandle(known))

  test::assertTrue(r != null && b != null && k != null)
  if r == null || b == null || k == null
    return
  end

  test::assertTrue(db.link_branchesFor_Root_by_rootId(r, b) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_rightId(b, k) == null)
  saved(db.saveChanges(), 3)
  counts(provider, 1, 1, 1)
  let hiddenSql = "INSERT INTO leaves(id,left_id,right_id,name) VALUES(100," + (branch.id as String) + "," + (branch.id as String) + ",'hidden');"

  test::assertTrue(createSQLiteFixture(path, hiddenSql))
  counts(provider, 1, 1, 2)
  let earlier = new cascade_model::Root(0, "earlier save")

  saved(db.beginTransaction(), 0)

  test::assertTrue(db.roots.add(earlier) == null)
  saved(db.saveChanges(), 1)

  test::assertTrue(earlier.id > 0)
  let earlierId = earlier.id

  test::assertTrue(db.removeCascade_roots(r) == null)
  failed(db.saveChanges())
  counts(provider, 2, 1, 2)
  let afterFailure = new CascadeDatabase(provider)

  test::assertEqual(earlier.id, earlierId)
  match afterFailure.leaves.where(id: known.id).count()
    case QueryValue.Value(value)
      test::assertEqual(value, 1)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  let hidden = new Leaf(100, branch.id, branch.id, "hidden")
  let h = tracked(db.leaves.attachWithHandle(hidden))

  test::assertTrue(h != null)
  if h == null
    return
  end

  test::assertTrue(db.leaves.remove(hidden) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_leftId(b, h) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_rightId(b, h) == null)
  saved(db.saveChanges(), 4)
  counts(provider, 1, 0, 0)
  saved(db.commitTransaction(), 0)
  counts(provider, 1, 0, 0)
end

def verifyReassignedAndUnlinked(provider: SQLiteProvider): Void
  let db = new CascadeDatabase(provider)
  let oldRoot = new cascade_model::Root(0, "old root")
  let newRoot = new cascade_model::Root(0, "new root")
  let moved = new Branch(0, 0, "moved")
  let oldBranch = new Branch(0, 0, "old branch")
  let survivor = new Leaf(0, null, 0, "survivor")
  let a = tracked(db.roots.addWithHandle(oldRoot))
  let n = tracked(db.roots.addWithHandle(newRoot))
  let m = tracked(db.branches.addWithHandle(moved))
  let b = tracked(db.branches.addWithHandle(oldBranch))
  let s = tracked(db.leaves.addWithHandle(survivor))

  test::assertTrue(a != null && n != null && m != null && b != null && s != null)
  if a == null || n == null || m == null || b == null || s == null
    return
  end

  test::assertTrue(db.link_branchesFor_Root_by_rootId(a, m) == null)
  test::assertTrue(db.link_branchesFor_Root_by_rootId(a, b) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_leftId(b, s) == null)
  test::assertTrue(db.link_leavesFor_Branch_by_rightId(m, s) == null)
  saved(db.saveChanges(), 5)

  test::assertTrue(db.reassign_branchesFor_Root_by_rootId(n, m) == null)
  test::assertTrue(db.unlink_leavesFor_Branch_by_leftId(s) == null)
  test::assertTrue(survivor.leftId == null)
  test::assertTrue(db.removeCascade_roots(a) == null)
  saved(db.saveChanges(), 4)
  counts(provider, 1, 1, 1)
  let read = new CascadeDatabase(provider)

  match read.branches.where(id: moved.id).single()
    case QueryValue.Value(value)
      test::assertEqual(value.rootId, newRoot.id)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
  match read.leaves.where(id: survivor.id).single()
    case QueryValue.Value(value)
      test::assertTrue(value.leftId == null)
      test::assertEqual(value.rightId, moved.id)
    case QueryValue.Failure(error)
      test::assertTrue(false)
  end
end

