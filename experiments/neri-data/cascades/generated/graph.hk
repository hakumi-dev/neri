use reference
namespace cascade_data

## Collects one reachable mapped graph before atomic enrollment.
class GraphTraversal_CascadeDatabase
  private graph: neri_data::GraphRegistration
  private tracker_Root: neri_data::EntityTracker<cascade_model::Root>
  private visits_Root: neri_data::GraphVisitList<cascade_model::Root>
  private tracker_Branch: neri_data::EntityTracker<cascade_model::Branch>
  private visits_Branch: neri_data::GraphVisitList<cascade_model::Branch>
  private tracker_Leaf: neri_data::EntityTracker<cascade_model::Leaf>
  private visits_Leaf: neri_data::GraphVisitList<cascade_model::Leaf>
  private tracker_Node: neri_data::EntityTracker<cascade_model::Node>
  private visits_Node: neri_data::GraphVisitList<cascade_model::Node>
  private tracker_CodeRoot: neri_data::EntityTracker<cascade_model::CodeRoot>
  private visits_CodeRoot: neri_data::GraphVisitList<cascade_model::CodeRoot>
  private tracker_TextChild: neri_data::EntityTracker<cascade_model::TextChild>
  private visits_TextChild: neri_data::GraphVisitList<cascade_model::TextChild>
  private tracker_RequiredTextChild: neri_data::EntityTracker<cascade_model::RequiredTextChild>
  private visits_RequiredTextChild: neri_data::GraphVisitList<cascade_model::RequiredTextChild>

  def init(changes: neri_data::ChangeContext, tracker_Root: neri_data::EntityTracker<cascade_model::Root>, tracker_Branch: neri_data::EntityTracker<cascade_model::Branch>, tracker_Leaf: neri_data::EntityTracker<cascade_model::Leaf>, tracker_Node: neri_data::EntityTracker<cascade_model::Node>, tracker_CodeRoot: neri_data::EntityTracker<cascade_model::CodeRoot>, tracker_TextChild: neri_data::EntityTracker<cascade_model::TextChild>, tracker_RequiredTextChild: neri_data::EntityTracker<cascade_model::RequiredTextChild>): Void
    this.graph = new neri_data::GraphRegistration(changes)
    this.tracker_Root = tracker_Root
    this.visits_Root = new neri_data::GraphVisitList<cascade_model::Root>(this.graph)
    this.tracker_Branch = tracker_Branch
    this.visits_Branch = new neri_data::GraphVisitList<cascade_model::Branch>(this.graph)
    this.tracker_Leaf = tracker_Leaf
    this.visits_Leaf = new neri_data::GraphVisitList<cascade_model::Leaf>(this.graph)
    this.tracker_Node = tracker_Node
    this.visits_Node = new neri_data::GraphVisitList<cascade_model::Node>(this.graph)
    this.tracker_CodeRoot = tracker_CodeRoot
    this.visits_CodeRoot = new neri_data::GraphVisitList<cascade_model::CodeRoot>(this.graph)
    this.tracker_TextChild = tracker_TextChild
    this.visits_TextChild = new neri_data::GraphVisitList<cascade_model::TextChild>(this.graph)
    this.tracker_RequiredTextChild = tracker_RequiredTextChild
    this.visits_RequiredTextChild = new neri_data::GraphVisitList<cascade_model::RequiredTextChild>(this.graph)
  end

  def add_roots(root: cascade_model::Root): neri_data::TrackHandleResult<cascade_model::Root>
    match this.discover_roots(root)
      case neri_data::GraphVisitResult.New(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Existing(slot)
        return this.graph.enroll(slot)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::TrackHandleResult<cascade_model::Root>.Failure(error)
    end
  end

  private def discover_roots(entity: cascade_model::Root): neri_data::GraphVisitResult<cascade_model::Root>
    match this.visits_Root.visit(entity)
      case neri_data::GraphVisitResult.Failure(error)
        return neri_data::GraphVisitResult<cascade_model::Root>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<cascade_model::Root>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Root)

        if staged != null
          return neri_data::GraphVisitResult<cascade_model::Root>.Failure(staged)
        end
        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?
          return this.scan_roots(entity, slot)
        end
        let queued = this.graph.enqueue(scan)

        if queued != null
          return neri_data::GraphVisitResult<cascade_model::Root>.Failure(queued)
        end
        return neri_data::GraphVisitResult<cascade_model::Root>.New(slot)
    end
  end

  private def scan_roots(entity: cascade_model::Root, owner: neri_data::GraphSlot<cascade_model::Root>): neri_data::QueryFailure?
    return null
  end

  def add_branches(root: cascade_model::Branch): neri_data::TrackHandleResult<cascade_model::Branch>
    match this.discover_branches(root)
