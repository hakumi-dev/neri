        return neri_data::GraphVisitResult<cascade_model::Branch>.Failure(error)
      case neri_data::GraphVisitResult.Existing(slot)
        return neri_data::GraphVisitResult<cascade_model::Branch>.Existing(slot)
      case neri_data::GraphVisitResult.New(slot)
        let staged = this.graph.stageNode(slot, this.tracker_Branch)

        if staged != null
          return neri_data::GraphVisitResult<cascade_model::Branch>.Failure(staged)
