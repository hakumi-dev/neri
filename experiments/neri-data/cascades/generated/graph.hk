          return neri_data::GraphVisitResult<cascade_model::Branch>.Failure(queued)
        end
        return neri_data::GraphVisitResult<cascade_model::Branch>.New(slot)
    end
  end

  private def scan_branches(entity: cascade_model::Branch, owner: neri_data::GraphSlot<cascade_model::Branch>): neri_data::QueryFailure?
    return null
  end

