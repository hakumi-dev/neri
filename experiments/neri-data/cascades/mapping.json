{
  "version": 1,
  "project": "manifest.json",
  "unit": "entities",
  "namespace": "cascade_data",
  "context": "CascadeDatabase",
  "output": "generated",
  "entities": [
    {"type": "cascade_model.Root", "set": "roots", "table": "roots", "key": "id", "keyGeneration": "onAdd", "columns": [{"member": "id", "column": "id"}, {"member": "name", "column": "name"}]},
    {"type": "cascade_model.Branch", "set": "branches", "table": "branches", "key": "id", "keyGeneration": "onAdd", "columns": [{"member": "id", "column": "id"}, {"member": "rootId", "column": "root_id"}, {"member": "name", "column": "name"}]},
    {"type": "cascade_model.Leaf", "set": "leaves", "table": "leaves", "key": "id", "keyGeneration": "onAdd", "columns": [{"member": "id", "column": "id"}, {"member": "leftId", "column": "left_id"}, {"member": "rightId", "column": "right_id"}, {"member": "name", "column": "name"}]},
    {"type": "cascade_model.Node", "set": "nodes", "table": "nodes", "key": "id", "columns": [{"member": "id", "column": "id"}, {"member": "parentId", "column": "parent_id"}]},
    {"type": "cascade_model.CodeRoot", "set": "codes", "table": "codes", "key": "code", "columns": [{"member": "code", "column": "code"}]},
    {"type": "cascade_model.TextChild", "set": "textChildren", "table": "text_children", "key": "id", "columns": [{"member": "id", "column": "id"}, {"member": "codeValue", "column": "code_value"}]},
    {"type": "cascade_model.RequiredTextChild", "set": "requiredTextChildren", "table": "required_text_children", "key": "id", "columns": [{"member": "id", "column": "id"}, {"member": "codeValue", "column": "code_value"}]}
  ],
  "relations": [
    {"principal": "cascade_model.Root", "dependent": "cascade_model.Branch", "key": "id", "foreignKey": "rootId", "deleteBehavior": "clientCascade"},
    {"principal": "cascade_model.Branch", "dependent": "cascade_model.Leaf", "key": "id", "foreignKey": "leftId", "deleteBehavior": "clientCascade"},
    {"principal": "cascade_model.Branch", "dependent": "cascade_model.Leaf", "key": "id", "foreignKey": "rightId", "deleteBehavior": "clientCascade"},
    {"principal": "cascade_model.Node", "dependent": "cascade_model.Node", "key": "id", "foreignKey": "parentId", "deleteBehavior": "clientCascade"},
    {"principal": "cascade_model.CodeRoot", "dependent": "cascade_model.TextChild", "key": "code", "foreignKey": "codeValue", "deleteBehavior": "clientCascade"},
    {"principal": "cascade_model.CodeRoot", "dependent": "cascade_model.RequiredTextChild", "key": "code", "foreignKey": "codeValue", "deleteBehavior": "clientCascade"}
  ]
}
