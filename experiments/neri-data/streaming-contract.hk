use host
use neri_data
use test

class StreamRecord
  public id: Int
  public name: String?

  def init(id: Int, name: String? = null): Void
    this.id = id
    this.name = name
  end
end

def decodeStreamRecord(row: RawRow): DecodeResult<StreamRecord>
  match decodeInt(row, "id")
    case DecodeResult.Value(id)
      match decodeNullableString(row, "name")
        case DecodeResult.Value(name)
          return DecodeResult<StreamRecord>.Value(new StreamRecord(id, name))
        case DecodeResult.Failure(error)
          return DecodeResult<StreamRecord>.Failure(error)
      end
    case DecodeResult.Failure(error)
      return DecodeResult<StreamRecord>.Failure(error)
  end
end

def containsText(value: String, needle: String): Bool
  if host::stringByteLength(needle) > host::stringByteLength(value)
    return false
  end
  var start = 0

  while start <= host::stringByteLength(value) - host::stringByteLength(needle)
    var matched = true
    var offset = 0

    while offset < host::stringByteLength(needle)
      if host::stringByteAt(value, start + offset) != host::stringByteAt(needle, offset)
        matched = false
        break
      end
      offset = offset + 1
    end
    if matched
      return true
    end
    start = start + 1
  end
  return false
end

class StreamProbe: Provider
  public seenSql: String = ""
  public seenMaximum: Int? = null
  public seenParameters: Int = 0
  public visits: Int = 0
  public rowCount: Int = 1505
  public ignoreStop: Bool = false
  public badRow: Bool = false
  public badLastShapeField: Bool = false

  public override readonly def dialect(): SqlDialect
    return SqlDialect.QuestionMark()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    match capability
      case ProviderCapability.WindowFunctions()
        return false
      case ProviderCapability.CheckedScalarExpressions()
        return false
      case ProviderCapability.StreamingReads()
        return true
      case ProviderCapability.BoundedTypedReads()
        return false
      case ProviderCapability.SetWrites()
        return false
      case ProviderCapability.TrackedWrites()
        return false
      case ProviderCapability.ExplicitTransactions()
        return false
      case ProviderCapability.Savepoints()
        return false
    end
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Failure("buffered execution forbidden")
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.seenSql = plan.sql()
    this.seenMaximum = plan.maximumRows()
    this.seenParameters = plan.parameters().count()
    var index = 0

    while index < this.rowCount
      let present = index == 0 ? 0 : 1
      let lastShapeField = this.badLastShapeField && index == 1 ? Cell.Text("invalid") : Cell.Int(index)
      let row = this.badRow ? new RawRow([]) : new RawRow([new RawColumn("id", Cell.Int(index)), new RawColumn("name", Cell.Null()), new RawColumn("__neri_select_0", Cell.Int(index)), new RawColumn("__neri_select_1", Cell.Null()), new RawColumn("__neri_shape_0", Cell.Int(index)), new RawColumn("__neri_shape_1", Cell.Null()), new RawColumn("__neri_shape_2", lastShapeField), new RawColumn("__neri_l0", Cell.Int(index)), new RawColumn("__neri_l1", Cell.Null()), new RawColumn("__neri_r0", Cell.Int(index)), new RawColumn("__neri_r1", Cell.Null()), new RawColumn("__neri_present", Cell.Int(present))])
      let keepGoing = visit(row)

      this.visits = this.visits + 1
      if !keepGoing && !this.ignoreStop
        return StreamResult.Stopped(this.visits)
      end
      index = index + 1
    end
    return StreamResult.Completed(this.visits)
  end
end

class StreamCounter
  public count: Int = 0
  public stopAt: Int? = null
  public token: CancellationToken? = null

  def init(stopAt: Int? = null, token: CancellationToken? = null): Void
    this.stopAt = stopAt
    this.token = token
  end

  public def visit(row: StreamRecord): Bool
    this.count = this.count + 1
    let token = this.token

    if token != null && this.count == 1
      token.cancel()
    end
    let stop = this.stopAt

    return stop == null || this.count < stop
  end
end

class DeliveryCount
  public count: Int = 0

  public def add(): Void
    this.count = this.count + 1
  end
end

def records(provider: Provider): Query<StreamRecord>
  let columns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int()), new ResultColumn("name", ResultColumnKind.Text(), true)])
  let mapping = new EntityMapping("StreamRecord", "records", [new MappingColumn("StreamRecord.id", "Int", "id"), new MappingColumn("StreamRecord.name", "String?", "name")])

  return new Query<StreamRecord>("records", new Decoder<StreamRecord>(decodeStreamRecord, columns), mapping: mapping, provider: provider)
end

def streamRecordId(): quote fn(StreamRecord): Int
  return quote do |value: StreamRecord|: Int
    return value.id
  end
end

class StreamDto
  public id: Int
  public name: String?

  def init(id: Int, name: String?): Void
    this.id = id
    this.name = name
  end
end

class StreamShapeCalls
  public inner: Int = 0
  public materialize: Int = 0
end

class StreamNestedDto
  public first: StreamDto
  public finalId: Int

  def init(first: StreamDto, finalId: Int): Void
    this.first = first
    this.finalId = finalId
  end
end

def streamRecordName(): quote fn(StreamRecord): String?
  return quote do |value: StreamRecord|: String?
    return value.name
  end
end

def makeStreamDto(calls: StreamShapeCalls, id: Int, name: String?): StreamDto
  calls.inner = calls.inner + 1
  return new StreamDto(id, name)
end

def makeNestedStreamDto(calls: StreamShapeCalls, first: StreamDto, finalId: Int): StreamNestedDto
  calls.materialize = calls.materialize + 1
  return new StreamNestedDto(first, finalId)
end

def streamJoinLeftId(): quote fn(StreamRecord): Int
  return quote do |value: StreamRecord|: Int
    return value.id
  end
end

def assertStreamCompleted(result: StreamResult, expected: Int): Void
  match result
    case StreamResult.Completed(count)
      test::assertEqual(count, expected)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end
end

def main(): Void
  let provider = new StreamProbe()
  let counter = new StreamCounter()
  let consume: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return counter.visit(row)
  end
  let result = records(provider).skip(1).stream(consume)


  match result
    case StreamResult.Completed(count)
      test::assertEqual(count, 1505)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertEqual(counter.count, 1505)
  test::assertTrue(provider.seenMaximum == null)
  test::assertFalse(containsText(provider.seenSql, "LIMIT 1000"))

  let distinctProvider = new StreamProbe()
  let distinctCounter = new StreamCounter()
  let distinctConsume: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return distinctCounter.visit(row)
  end
  let distinctResult = records(distinctProvider).distinct().skip(1).stream(distinctConsume)

  match distinctResult
    case StreamResult.Completed(count)
      test::assertEqual(count, 1505)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertFalse(containsText(distinctProvider.seenSql, "LIMIT 1000"))

  let hostile = new StreamProbe()

  hostile.ignoreStop = true
  hostile.rowCount = 6
  let stoppedCounter = new StreamCounter(2)
  let stopVisit: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return stoppedCounter.visit(row)
  end
  let stoppedResult = records(hostile).stream(stopVisit)

  match stoppedResult
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 2)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(stoppedCounter.count, 2)

  let overLimit = new StreamProbe()

  overLimit.ignoreStop = true
  overLimit.rowCount = 4
  let boundedCounter = new StreamCounter()
  let boundedVisit: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return boundedCounter.visit(row)
  end
  let boundedResult = records(overLimit).take(2).stream(boundedVisit)

  match boundedResult
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 2)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(boundedCounter.count, 2)
  let seenMaximum = overLimit.seenMaximum

  test::assertTrue(seenMaximum != null)
  if seenMaximum != null
    test::assertEqual(seenMaximum, 2)
  end

  let missing = new StreamProbe()

  missing.badRow = true
  missing.ignoreStop = true
  missing.rowCount = 3
  let missingCounter = new StreamCounter()
  let missingVisit: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return missingCounter.visit(row)
  end
  let missingResult = records(missing).stream(missingVisit)

  match missingResult
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 0)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(missingCounter.count, 0)

  let token = new CancellationToken()
  let cancelledCounter = new StreamCounter(token: token)
  let cancelVisit: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return cancelledCounter.visit(row)
  end
  let cancelledResult = records(new StreamProbe()).stream(cancelVisit, new StreamOptions(token: token))

  match cancelledResult
    case StreamResult.Cancelled(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  let preCancelled = new CancellationToken()

  preCancelled.cancel()
  let untouched = new StreamProbe()
  let preResult = records(untouched).stream(consume, new StreamOptions(token: preCancelled))

  match preResult
    case StreamResult.Cancelled(count)
      test::assertEqual(count, 0)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  test::assertEqual(untouched.visits, 0)

  for invalid in [0, -1, 86400001]
    let rejected = new StreamProbe()
    let timeoutResult = records(rejected).stream(consume, new StreamOptions(timeoutMilliseconds: invalid))

    match timeoutResult
      case StreamResult.Failure(error, count)
        test::assertEqual(count, 0)
      case StreamResult.Completed(count)
        test::assertTrue(false)
      case StreamResult.Stopped(count)
        test::assertTrue(false)
      case StreamResult.Cancelled(count)
        test::assertTrue(false)
    end

    test::assertEqual(rejected.visits, 0)
  end

  let concurrentStopToken = new CancellationToken()
  let concurrentStopCounter = new StreamCounter(stopAt: 1, token: concurrentStopToken)
  let concurrentVisit: fn(StreamRecord): Bool = fn(row: StreamRecord): Bool
    return concurrentStopCounter.visit(row)
  end
  let concurrentResult = records(new StreamProbe()).stream(concurrentVisit, new StreamOptions(token: concurrentStopToken))

  match concurrentResult
    case StreamResult.Stopped(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  let projectedProvider = new StreamProbe()
  let projectedCount = new DeliveryCount()
  let projectedVisit: fn(Int): Bool = fn(value: Int): Bool
    projectedCount.add()
    return true
  end
  let projected = select(records(projectedProvider), intScalar(), streamRecordId()).stream(projectedVisit)


  assertStreamCompleted(projected, 1505)

  test::assertEqual(projectedCount.count, 1505)
  test::assertTrue(projectedProvider.seenMaximum == null)
  test::assertEqual(projectedProvider.seenParameters, 0)
  test::assertFalse(containsText(projectedProvider.seenSql, "LIMIT 1000"))

  let boundedProjectionProvider = new StreamProbe()

  boundedProjectionProvider.rowCount = 2
  let boundedProjectionCount = new DeliveryCount()
  let boundedProjectionVisit: fn(Int): Bool = fn(value: Int): Bool
    boundedProjectionCount.add()
    return true
  end
  let boundedProjection = select(records(boundedProjectionProvider).where(id: 9).take(2), intScalar(), streamRecordId()).streamWith(boundedProjectionProvider, boundedProjectionVisit)


  assertStreamCompleted(boundedProjection, 2)

  let projectionMaximum = boundedProjectionProvider.seenMaximum

  test::assertTrue(projectionMaximum != null)
  if projectionMaximum != null
    test::assertEqual(projectionMaximum, 2)
  end

  test::assertEqual(boundedProjectionProvider.seenParameters, 1)
  test::assertEqual(boundedProjectionCount.count, 2)

  let shapeProvider = new StreamProbe()
  let shapeCalls = new StreamShapeCalls()
  let shapeMaterialize: fn(Int, String?): StreamDto = fn(id: Int, name: String?): StreamDto
    return makeStreamDto(shapeCalls, id, name)
  end
  let shape = combineShapes(fieldShape(intScalar(), streamRecordId()), fieldShape(optionalTextScalar(), streamRecordName()), shapeMaterialize)
  let shapeCount = new DeliveryCount()
  let shapeVisit: fn(StreamDto): Bool = fn(value: StreamDto): Bool
    shapeCount.add()

    test::assertTrue(value.name == null)
    return true
  end
  let shapeBoundProvider = new StreamProbe()
  let shapedResult = project(records(shapeBoundProvider), shape).streamWith(shapeProvider, shapeVisit)

  assertStreamCompleted(shapedResult, 1505)

  test::assertEqual(shapeCount.count, 1505)
  test::assertEqual(shapeCalls.inner, 1505)
  test::assertTrue(shapeProvider.seenMaximum == null)
  test::assertEqual(shapeBoundProvider.visits, 0)

  let invalidProjectionProvider = new StreamProbe()

  match project(records(invalidProjectionProvider).take(0), shape).stream(shapeVisit)
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 0)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(invalidProjectionProvider.visits, 0)

  let brokenShapeProvider = new StreamProbe()

  brokenShapeProvider.badLastShapeField = true
  brokenShapeProvider.rowCount = 2
  let brokenShapeCalls = new StreamShapeCalls()
  let brokenShapeMaterialize: fn(Int, String?): StreamDto = fn(id: Int, name: String?): StreamDto
    return makeStreamDto(brokenShapeCalls, id, name)
  end
  let nestedShape = combineShapes(fieldShape(intScalar(), streamRecordId()), fieldShape(optionalTextScalar(), streamRecordName()), brokenShapeMaterialize)
  let nestedMaterialize: fn(StreamDto, Int): StreamNestedDto = fn(first: StreamDto, finalId: Int): StreamNestedDto
    return makeNestedStreamDto(brokenShapeCalls, first, finalId)
  end
  let brokenShape = combineShapes(nestedShape, fieldShape(intScalar(), streamRecordId()), nestedMaterialize)
  let brokenVisit: fn(StreamNestedDto): Bool = fn(value: StreamNestedDto): Bool
    return true
  end
  let brokenResult = project(records(brokenShapeProvider), brokenShape).stream(brokenVisit)


  match brokenResult
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(brokenShapeCalls.inner, 1)
  test::assertEqual(brokenShapeCalls.materialize, 1)

  let queryBoundProvider = new StreamProbe()
  let queryOverrideProvider = new StreamProbe()

  queryOverrideProvider.rowCount = 1
  let queryOverrideCounter = new StreamCounter()
  let queryOverrideVisit: fn(StreamRecord): Bool = fn(value: StreamRecord): Bool
    return queryOverrideCounter.visit(value)
  end
  let queryOverrideResult = records(queryBoundProvider).streamWith(queryOverrideProvider, queryOverrideVisit)

  assertStreamCompleted(queryOverrideResult, 1)

  test::assertEqual(queryBoundProvider.visits, 0)
  test::assertEqual(queryOverrideProvider.visits, 1)

  let joinedProvider = new StreamProbe()
  let joinedCount = new DeliveryCount()
  let joinedVisit: fn(Joined<StreamRecord, StreamRecord>): Bool = fn(value: Joined<StreamRecord, StreamRecord>): Bool
    joinedCount.add()

    test::assertEqual(value.left.id, value.right.id)
    return true
  end
  let joinedResult = join(records(joinedProvider), records(joinedProvider), intScalar(), streamJoinLeftId(), streamJoinLeftId()).streamWith(joinedProvider, joinedVisit)

  assertStreamCompleted(joinedResult, 1505)

  test::assertEqual(joinedCount.count, 1505)
  test::assertTrue(joinedProvider.seenMaximum == null)
  test::assertFalse(containsText(joinedProvider.seenSql, "LIMIT 1000"))

  let joinToken = new CancellationToken()
  let cancelledJoinProvider = new StreamProbe()
  let cancelJoinVisit: fn(Joined<StreamRecord, StreamRecord>): Bool = fn(value: Joined<StreamRecord, StreamRecord>): Bool
    joinToken.cancel()
    return true
  end
  let cancelledJoin = join(records(cancelledJoinProvider), records(cancelledJoinProvider), intScalar(), streamJoinLeftId(), streamJoinLeftId()).streamWith(cancelledJoinProvider, cancelJoinVisit, new StreamOptions(token: joinToken))

  match cancelledJoin
    case StreamResult.Cancelled(count)
      test::assertEqual(count, 1)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Failure(error, count)
      test::assertTrue(false)
  end

  let boundedJoinProvider = new StreamProbe()

  boundedJoinProvider.rowCount = 1
  let boundedJoinCount = new DeliveryCount()
  let boundedJoinVisit: fn(Joined<StreamRecord, StreamRecord>): Bool = fn(value: Joined<StreamRecord, StreamRecord>): Bool
    boundedJoinCount.add()
    return true
  end
  let boundedJoinResult = join(records(boundedJoinProvider), records(boundedJoinProvider), intScalar(), streamJoinLeftId(), streamJoinLeftId()).take(2).take(1).stream(boundedJoinVisit)

  assertStreamCompleted(boundedJoinResult, 1)

  test::assertEqual(boundedJoinCount.count, 1)
  let joinMaximum = boundedJoinProvider.seenMaximum

  test::assertTrue(joinMaximum != null)
  if joinMaximum != null
    test::assertEqual(joinMaximum, 1)
  end

  let invalidJoinProvider = new StreamProbe()
  let invalidJoinVisit: fn(Joined<StreamRecord, StreamRecord>): Bool = fn(value: Joined<StreamRecord, StreamRecord>): Bool
    return true
  end
  let invalidJoinResult = join(records(invalidJoinProvider), records(invalidJoinProvider), intScalar(), streamJoinLeftId(), streamJoinLeftId()).take(2).take(1001).stream(invalidJoinVisit)

  match invalidJoinResult
    case StreamResult.Failure(error, count)
      test::assertEqual(count, 0)
    case StreamResult.Completed(count)
      test::assertTrue(false)
    case StreamResult.Stopped(count)
      test::assertTrue(false)
    case StreamResult.Cancelled(count)
      test::assertTrue(false)
  end

  test::assertEqual(invalidJoinProvider.visits, 0)

  let outerProvider = new StreamProbe()

  outerProvider.rowCount = 2
  let missingCount = new DeliveryCount()
  let presentNullCount = new DeliveryCount()
  let outerVisit: fn(LeftJoined<StreamRecord, StreamRecord>): Bool = fn(value: LeftJoined<StreamRecord, StreamRecord>): Bool
    let right = value.right

    if right == null
      missingCount.add()
    else
      presentNullCount.add()

      test::assertTrue(right.name == null)
    end
    return true
  end
  let outerResult = leftJoin(records(outerProvider), records(outerProvider), intScalar(), streamJoinLeftId(), streamJoinLeftId()).streamWith(outerProvider, outerVisit)

  assertStreamCompleted(outerResult, 2)

  test::assertEqual(missingCount.count, 1)
  test::assertEqual(presentNullCount.count, 1)
end
