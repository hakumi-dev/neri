use test
use resources
use neri_data
use buffers
namespace neri_data_query_contract

class QueryGapRoot
  public id: Int
  public children: QueryGapChild[] = []
  public bridges: QueryGapBridge[] = []
  public skipChildren: QueryGapChild[] = []

  def init(id: Int): Void
    this.id = id
  end
end

class QueryGapCounter
  public calls: Int = 0
end

class QueryGapCountingProvider: Provider
  private inner: Provider
  public commands: Int = 0

  def init(inner: Provider): Void
    this.inner = inner
  end

  public override readonly def dialect(): SqlDialect
    return this.inner.dialect()
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return this.inner.supports(capability)
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    this.commands = this.commands + 1
    return this.inner.execute(plan)
  end

  public override def stream(plan: readonly StreamPlan, visit: fn(RawRow): Bool): StreamResult
    this.commands = this.commands + 1
    return this.inner.stream(plan, visit)
  end

  public override def beginReadAsync(
    plan: readonly SqlPlan,
    options: StreamOptions? = null,
    maximumRows: Int? = null
  ): AsyncReadStart
    this.commands = this.commands + 1
    return this.inner.beginReadAsync(plan, options, maximumRows)
  end
end

class QueryGapOtherDialect: Provider
  private kind: SqlDialect

  def init(original: SqlDialect): Void
    match original
      case SqlDialect.PostgreSql()
        this.kind = SqlDialect.QuestionMark()
      case SqlDialect.QuestionMark()
        this.kind = SqlDialect.PostgreSql()
    end
  end

  public override readonly def dialect(): SqlDialect
    match this.kind
      case SqlDialect.PostgreSql()
        return SqlDialect.PostgreSql()
      case SqlDialect.QuestionMark()
        return SqlDialect.QuestionMark()
    end
  end

  public override readonly def supports(capability: ProviderCapability): Bool
    return false
  end

  public override def execute(plan: readonly SqlPlan): ProviderResult
    return ProviderResult.Failure(ProviderFailure.State("dialect compatibility must fail before execution"))
  end
end

class QueryGapChild
  public id: Int
  public rootId: Int
  public value: Int
  public root: QueryGapRoot?
  public bridges: QueryGapBridge[] = []
  public skipRoots: QueryGapRoot[] = []

  def init(id: Int, rootId: Int, value: Int): Void
    this.id = id
    this.rootId = rootId
    this.value = value
  end
end

def captureQueryGapRoot(value: QueryGapRoot): RawRow
  return new RawRow([new RawColumn("id", Cell.Int(value.id))])
end

def captureQueryGapChild(value: QueryGapChild): RawRow
  return new RawRow([
      new RawColumn("id", Cell.Int(value.id)),
      new RawColumn("root_id", Cell.Int(value.rootId)),
      new RawColumn("value", Cell.Int(value.value))
    ])
end

def decodeQueryGapRoot(row: RawRow): DecodeResult<QueryGapRoot>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<QueryGapRoot>.Failure(error)
    case DecodeResult.Value(id)
      return DecodeResult<QueryGapRoot>.Value(new QueryGapRoot(id))
  end
end

def decodeQueryGapChild(row: RawRow): DecodeResult<QueryGapChild>
  match decodeInt(row, "id")
    case DecodeResult.Failure(error)
      return DecodeResult<QueryGapChild>.Failure(error)
    case DecodeResult.Value(id)
      match decodeInt(row, "root_id")
        case DecodeResult.Failure(error)
          return DecodeResult<QueryGapChild>.Failure(error)
        case DecodeResult.Value(rootId)
          match decodeInt(row, "value")
            case DecodeResult.Failure(error)
              return DecodeResult<QueryGapChild>.Failure(error)
            case DecodeResult.Value(value)
              return DecodeResult<QueryGapChild>.Value(new QueryGapChild(id, rootId, value))
          end
      end
  end
end

class QueryGapGraph
  public roots: Query<QueryGapRoot>
  public children: Query<QueryGapChild>
  public relation: CollectionNavigation<QueryGapRoot, QueryGapChild>
  public changes: ChangeContext
  public childTracker: EntityTracker<QueryGapChild>

  def init(provider: Provider): Void
    let rootColumns = new ResultColumns([new ResultColumn("id", ResultColumnKind.Int())])
    let childColumns = new ResultColumns([
        new ResultColumn("id", ResultColumnKind.Int()),
        new ResultColumn("root_id", ResultColumnKind.Int()),
        new ResultColumn("value", ResultColumnKind.Int())
      ])
    let roots = new EntityTracker<QueryGapRoot>("gap_roots", "id", rootColumns, captureQueryGapRoot)
    let children = new EntityTracker<QueryGapChild>("gap_children", "id", childColumns, captureQueryGapChild)
    let changes = new ChangeContext(provider)

    this.changes = changes
    this.childTracker = children

    changes.register(roots.changeSet())
    changes.register(children.changeSet())
    this.roots = new Query<QueryGapRoot>(
      "gap_roots",
      new Decoder<QueryGapRoot>(decodeQueryGapRoot, rootColumns),
      mapping: new EntityMapping(
        "neri_data_query_contract.QueryGapRoot",
        "gap_roots",
        [new MappingColumn("neri_data_query_contract.QueryGapRoot.id", "Int", "id")],
        "id"
      ),
      provider: provider,
      tracker: roots,
      changes: changes
    ).fromSql(
      "SELECT 1 AS id UNION ALL SELECT 2 AS id UNION ALL SELECT 3 AS id",
      new ParameterValues()
    )
    this.children = new Query<QueryGapChild>(
      "gap_children",
      new Decoder<QueryGapChild>(decodeQueryGapChild, childColumns),
      mapping: new EntityMapping(
        "neri_data_query_contract.QueryGapChild",
        "gap_children",
        [
          new MappingColumn("neri_data_query_contract.QueryGapChild.id", "Int", "id"),
          new MappingColumn("neri_data_query_contract.QueryGapChild.rootId", "Int", "root_id"),
          new MappingColumn("neri_data_query_contract.QueryGapChild.value", "Int", "value")
        ],
        "id"
      ),
      provider: provider,
      tracker: children,
      changes: changes
    ).fromSql(
      "SELECT 10 AS id, 1 AS root_id, 5 AS value UNION ALL SELECT 11 AS id, 1 AS root_id, 7 AS value UNION ALL SELECT 12 AS id, 2 AS root_id, 9 AS value",
      new ParameterValues()
    )
    let principalKey: fn(QueryGapRoot): Cell = fn(root: QueryGapRoot): Cell do
      return Cell.Int(root.id)
    end
    let childKey: fn(QueryGapChild): Cell = fn(child: QueryGapChild): Cell do
      return Cell.Int(child.id)
    end
    let foreignKey: fn(QueryGapChild): Cell = fn(child: QueryGapChild): Cell do
      return Cell.Int(child.rootId)
    end
    let getChildren: fn(QueryGapRoot): QueryGapChild[] = fn(root: QueryGapRoot): QueryGapChild[] do
      return root.children
    end
    let setChildren: fn(
      QueryGapRoot,
      QueryGapChild[]
    ): Void = fn(
      root: QueryGapRoot,
      children: QueryGapChild[]
    ): Void do
      root.children = children
    end
    let getRoot: fn(QueryGapChild): QueryGapRoot? = fn(child: QueryGapChild): QueryGapRoot? do
      return child.root
    end
    let setRoot: fn(QueryGapChild, QueryGapRoot?): Void = fn(child: QueryGapChild, root: QueryGapRoot?): Void do
      child.root = root
    end

    this.relation = new CollectionNavigation<QueryGapRoot, QueryGapChild>(
      principalKey,
      childKey,
      foreignKey,
      "root_id",
      getChildren,
      setChildren,
      getRoot,
      setRoot
    )

    test::assertTrue(registerNavigation(this.roots, this.children, this.relation) == null)
  end
end

def gapRows<T>(result: QueryResult<T>): TypedRows<T>
  match result
    case QueryResult.Failure(error)
      match error
        case QueryFailure.Provider(failure)
          console::println(providerFailureMessage(failure))
        case QueryFailure.UnsupportedCapability(name)
          console::println(name)
        case QueryFailure.TypeMismatch(column, expected, actual)
          console::println(column + ": " + expected + " != " + actual)
        case QueryFailure.InvalidIdentifier(name)
          console::println(name)
        case QueryFailure.InvalidLimit(value, maximum)
        case QueryFailure.MissingLimit(maximum)
        case QueryFailure.SourceMismatch(expected, actual)
        case QueryFailure.MissingColumn(name)
          console::println(name)
        case QueryFailure.Cardinality(expected, actual)
        case QueryFailure.Cleanup(failure)
      end

      test::assertTrue(false)
      return new TypedRows<T>()
    case QueryResult.Rows(rows)
      return rows
  end
end

def verifyQueryGapLoading(provider: Provider): Void
  let tracked = new QueryGapGraph(provider)
  let changed = new QueryGapCounter()
  let link: fn(
    QueryGapRoot,
    QueryGapChild
  ): QueryFailure? = fn(
    root: QueryGapRoot,
    child: QueryGapChild
  ): QueryFailure? do
    changed.calls = changed.calls + 1
    return QueryFailure.UnsupportedCapability("query loading must not infer a relationship write")
  end
  let unlink: fn(QueryGapChild): QueryFailure? = fn(child: QueryGapChild): QueryFailure? do
    changed.calls = changed.calls + 1
    return QueryFailure.UnsupportedCapability("query loading must not infer a relationship removal")
  end
  let snapshot: fn(QueryGapChild): fn(): Void = fn(child: QueryGapChild): fn(): Void do
    let undo: fn(): Void = fn(): Void do
    end

    return undo
  end

  test::assertTrue(registerCollectionChanges(
      tracked.roots,
      tracked.children,
      tracked.relation,
      link,
      unlink,
      snapshot
    ) == null)

  let trackedComplete = gapRows(include(tracked.roots.take(3), tracked.children, tracked.relation).all())
  let trackedFiltered = gapRows(include(
      tracked.roots.take(3),
      tracked.children,
      tracked.relation
    ).children(tracked.children.orderBy(quote do |child: QueryGapChild|: Int
          return child.value
        end, true).take(1)).all())
  let completeRoot = trackedComplete.first()
  let filteredRoot = trackedFiltered.first()

  test::assertTrue(completeRoot != null && completeRoot.value.children.Length == 2)
  test::assertTrue(filteredRoot != null && filteredRoot.value.children.Length == 2)
  if filteredRoot != null
    for child in filteredRoot.value.children
      test::assertTrue(child.root != null && child.rootId == filteredRoot.value.id)
    end
  end
  match tracked.changes.saveChanges()
    case WriteResult.Saved(count)
      test::assertEqual(count, 0)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(false)
  end

  test::assertEqual(changed.calls, 0)

  if filteredRoot != null
    let root = filteredRoot.value
    let added = new QueryGapChild(20, root.id, 99)

    added.root = root
    root.children = [root.children[0], root.children[1], added]

    test::assertTrue(tracked.childTracker.add(added) == null)

    let reloaded = gapRows(include(
        tracked.roots.take(3),
        tracked.children,
        tracked.relation
      ).children(tracked.children.take(1)).all()).first()

    test::assertTrue(reloaded != null && reloaded.value.children.Length == 3)
    test::assertTrue(added.root != null && added.rootId == root.id)
  end

  let splitGraph = new QueryGapGraph(provider)
  let selected = splitGraph.children.orderBy(quote do |child: QueryGapChild|: Int
      return child.value
    end, true).take(1)
  let roots = splitGraph.roots.orderBy(quote do |root: QueryGapRoot|: Int
      return root.id
    end).take(3)
  let split = gapRows(include(roots, splitGraph.children, splitGraph.relation).children(selected).asNoTracking().all())
  let single = gapRows(include(
      roots,
      splitGraph.children,
      splitGraph.relation
    ).children(selected).asNoTracking().asSingleQuery().all())

  test::assertEqual(split.count(), 3)
  test::assertEqual(single.count(), 3)
  var left = split.first()
  var right = single.first()

  while left != null && right != null
    test::assertEqual(left.value.id, right.value.id)
    test::assertEqual(left.value.children.Length, right.value.children.Length)
    test::assertTrue(splitGraph.roots.stateOf(left.value) == null)
    test::assertTrue(splitGraph.roots.stateOf(right.value) == null)
    if left.value.children.Length > 0
      test::assertEqual(left.value.children[0].value, right.value.children[0].value)
      test::assertTrue(splitGraph.children.stateOf(right.value.children[0]) == null)
      let inverse = right.value.children[0].root

      test::assertTrue(inverse != null && reference::same(inverse, right.value))
    end
    left = left.next
    right = right.next
  end
  let graph = new QueryGapGraph(provider)
  let authors = graph.roots.detachedGraph()
  let children = graph.children.detachedGraph()
  let plan = authors.take(3).includeStep(collectionStep(
      authors,
      children,
      graph.relation
    )).thenIncludeStep(referenceStep(
      children,
      authors,
      graph.relation
    ))
  let loaded = gapRows(plan.all())
  let first = loaded.first()

  test::assertTrue(first != null && first.value.children.Length == 2)
  if first != null
    let inverse = first.value.children[0].root

    test::assertTrue(inverse != null && reference::same(inverse, first.value))
    test::assertTrue(graph.roots.stateOf(first.value) == null)
  end
  let keyed = new QueryGapGraph(provider)
  let keylessMapping = new EntityMapping(
    "neri_data_query_contract.QueryGapChild",
    "gap_view",
    [
      new MappingColumn("neri_data_query_contract.QueryGapChild.id", "Int", "id"),
      new MappingColumn("neri_data_query_contract.QueryGapChild.rootId", "Int", "root_id"),
      new MappingColumn("neri_data_query_contract.QueryGapChild.value", "Int", "value")
    ],
    readOnly: true
  )
  let views = sqlQuery(
    "SELECT 10 AS id, 1 AS root_id, 5 AS value UNION ALL SELECT 10 AS id, 1 AS root_id, 6 AS value",
    new ParameterValues(),
    keyed.children.rowDecoder(),
    provider,
    keylessMapping
  ).take(2)
  let foreignKey: fn(QueryGapChild): Cell = fn(child: QueryGapChild): Cell do
    return Cell.Int(child.rootId)
  end
  let principalKey: fn(QueryGapRoot): Cell = fn(root: QueryGapRoot): Cell do
    return Cell.Int(root.id)
  end
  let setReference: fn(QueryGapChild, QueryGapRoot?): Void = fn(child: QueryGapChild, root: QueryGapRoot?): Void do
    child.root = root
  end
  let viewRows = gapRows(includeKeylessReference(views, keyed.roots, foreignKey, principalKey, setReference).all())
  let viewFirst = viewRows.first()

  test::assertEqual(viewRows.count(), 2)
  if viewFirst != null && viewFirst.next != null
    let firstTarget = viewFirst.value.root
    let secondTarget = viewFirst.next.value.root

    test::assertTrue(!reference::same(viewFirst.value, viewFirst.next.value))
    test::assertTrue(firstTarget != null && secondTarget != null && reference::same(firstTarget, secondTarget))
    if firstTarget != null
      test::assertTrue(keyed.roots.stateOf(firstTarget) == null)
    end
  end
  let counting = new QueryGapCountingProvider(provider)
  let pathGraph = new QueryGapGraph(counting)
  let path = pathGraph.roots.orderBy(quote do |row: QueryGapRoot|: Int
      return row.id
    end).take(3).includeStep(collectionStep(
      pathGraph.roots,
      pathGraph.children,
      pathGraph.relation
    )).thenIncludeStep(referenceStep(
      pathGraph.children,
      pathGraph.roots,
      pathGraph.relation
    )).includeStep(collectionStep(
      pathGraph.roots,
      pathGraph.children,
      pathGraph.relation
    ))
  let complete = gapRows(path.asSingleQuery().all())
  let completeFirst = complete.first()

  test::assertEqual(counting.commands, 1)
  test::assertEqual(complete.count(), 3)
  test::assertTrue(completeFirst != null && completeFirst.value.children.Length == 2)
  if completeFirst != null && completeFirst.value.children.Length > 0
    let inverse = completeFirst.value.children[0].root

    test::assertTrue(inverse != null && reference::same(inverse, completeFirst.value))
  end
  counting.commands = 0
  gapRows(path.asSingleQuery().asSplitQuery().all())

  test::assertTrue(counting.commands >= 4)
  let filteredGraph = new QueryGapGraph(counting)
  let minimumRoot = 1
  let minimumChild = 5
  let selectedChildren = filteredGraph.children.matching(quote do |row: QueryGapChild|: Bool
      return row.value > minimumChild
    end).orderBy(quote do |row: QueryGapChild|: Int
      return row.value
    end, true).take(1)
  let filtered = filteredGraph.roots.matching(quote do |row: QueryGapRoot|: Bool
      return row.id >= minimumRoot
    end).orderBy(quote do |row: QueryGapRoot|: Int
      return row.id
    end).take(3).includeStep(collectionStep(
      filteredGraph.roots,
      filteredGraph.children,
      filteredGraph.relation,
      children: selectedChildren
    )).asSingleQuery().thenIncludeStep(referenceStep(
      filteredGraph.children,
      filteredGraph.roots,
      filteredGraph.relation
    ))
  let filteredRows = gapRows(filtered.all())
  let filteredFirst = filteredRows.first()

  test::assertTrue(filteredFirst != null && filteredFirst.value.children.Length == 1 && filteredFirst.value.children[0].value == 7)
  let getReference: fn(QueryGapChild): QueryGapRoot? = fn(child: QueryGapChild): QueryGapRoot? do
    return child.root
  end
  let keylessStep = keylessReferenceStep(
    views,
    keyed.roots,
    foreignKey,
    principalKey,
    getReference,
    setReference,
    ["root_id"]
  )
  let keylessSingle = gapRows(views.includeStep(keylessStep).asSingleQuery().all())

  test::assertEqual(keylessSingle.count(), 2)
end

def verifyQueryGapCorrelations(provider: Provider): Void
  let graph = new QueryGapGraph(provider)
  let outer = quote do |root: QueryGapRoot|: Int
    return root.id
  end
  let inner = quote do |child: QueryGapChild|: Int
    return child.rootId
  end
  let related = graph.children.matching(quote do |child: QueryGapChild|: Bool
      return child.value > 5
    end).orderBy(quote do |child: QueryGapChild|: Int
      return child.value
    end, true).asRelation()
  let source = graph.roots.orderBy(outer).take(3)
  let counts = gapRows(source.selectShape(correlatedCount(related, intScalar(), outer, inner)).all())
  let any = gapRows(source.selectShape(correlatedAny(related, intScalar(), outer, inner)).all())
  let values = gapRows(source.selectShape(correlatedFirst(related, intScalar(), quote do |child: QueryGapChild|: Int
          return child.value
        end, intScalar(), outer, inner)).all())
  let firstCount = counts.first()
  let firstAny = any.first()
  let firstValue = values.first()

  test::assertEqual(counts.count(), 3)
  test::assertTrue(firstCount != null && firstCount.value == 1)
  test::assertTrue(firstAny != null && firstAny.value)
  test::assertTrue(firstValue != null && firstValue.value == 7)
  if firstValue != null && firstValue.next != null
    let last = firstValue.next.next

    test::assertTrue(last != null && last.value == null)
  end
  let factory: fn(QueryGapGraph): Query<QueryGapRoot> = fn(db: QueryGapGraph): Query<QueryGapRoot> do
    let initial = 1

    return db.roots.matching(quote do |root: QueryGapRoot|: Bool
        return root.id >= initial
      end).take(3)
  end
  let parameters: fn(Int): ParameterValues = fn(value: Int): ParameterValues do
    return new ParameterValues(new ParameterNode(Parameter.Int(value)), 1)
  end
  let cache = new CompiledQueryCache<QueryGapGraph, QueryGapRoot>(factory, 2)
  let invoke = cache.delegate(parameters)
  let first = gapRows(invoke(graph, 2))
  let next = gapRows(invoke(graph, 3))
  let other = gapRows(invoke(new QueryGapGraph(provider), 1))

  test::assertEqual(first.count(), 2)
  test::assertEqual(next.count(), 1)
  test::assertEqual(other.count(), 3)
  let counter = new QueryGapCounter()
  let counting: fn(QueryGapGraph): Query<QueryGapRoot> = fn(db: QueryGapGraph): Query<QueryGapRoot> do
    counter.calls = counter.calls + 1
    return factory(db)
  end
  let bounded = new CompiledQueryCache<QueryGapGraph, QueryGapRoot>(counting, 1)
  let cached = bounded.delegate(parameters)
  let replacement = new QueryGapGraph(provider)

  gapRows(cached(graph, 2))
  gapRows(cached(graph, 3))
  gapRows(cached(replacement, 2))
  gapRows(cached(graph, 1))

  test::assertEqual(counter.calls, 3)
  match bounded.getOrCompile(new QueryGapGraph(new QueryGapOtherDialect(provider.dialect())))
    case CompiledQueryResult.Prepared(query)
      test::assertTrue(false)
    case CompiledQueryResult.Failure(error)
      test::assertTrue(true)
  end
end

class QueryGapTime
  public id: Int
  public at: DateTimeOffset

  def init(id: Int, at: DateTimeOffset): Void
    this.id = id
    this.at = at
  end
end

def verifyQueryGapTime(provider: Provider): Void
  let read: fn(RawRow): DecodeResult<QueryGapTime> = fn(row: RawRow): DecodeResult<QueryGapTime> do
    match decodeInt(row, "id")
      case DecodeResult.Failure(error)
        return DecodeResult<QueryGapTime>.Failure(error)
      case DecodeResult.Value(id)
        match decodeDateTimeOffset(row, "at")
          case DecodeResult.Failure(error)
            return DecodeResult<QueryGapTime>.Failure(error)
          case DecodeResult.Value(at)
            return DecodeResult<QueryGapTime>.Value(new QueryGapTime(id, at))
        end
    end
  end
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("at", ResultColumnKind.Text())
    ])
  let mapping = new EntityMapping(
    "neri_data_query_contract.QueryGapTime",
    "gap_times",
    [
      new MappingColumn("neri_data_query_contract.QueryGapTime.id", "Int", "id"),
      new MappingColumn(
        "neri_data_query_contract.QueryGapTime.at",
        "neri_data.DateTimeOffset",
        "at",
        storageType: "String",
        conversionId: "neri_data.cellDateTimeOffset"
      )
    ],
    readOnly: true
  )
  let roots = sqlQuery<QueryGapTime>(
    "SELECT 1 AS id, '2026-10-11T10:00:00.0000000Z|60' AS at UNION ALL SELECT 2 AS id, '2026-10-11T10:00:00.0000000Z|-60' AS at UNION ALL SELECT 3 AS id, '2026-10-11T10:00:00.0000001Z|0' AS at",
    new ParameterValues(),
    new Decoder<QueryGapTime>(read, columns),
    provider,
    mapping
  )
  let instant = DateTimeOffset.parse("2026-10-11T10:00:00Z")

  test::assertTrue(instant != null)
  if instant == null
    return
  end
  let equal = gapRows(roots.matching(quote do |row: QueryGapTime|: Bool
        return row.at == instant
      end).take(3).all())
  let fields = gapRows(roots.where(at: instant).take(3).all())
  let utcHour = utcCalendarField(quote do |row: QueryGapTime|: DateTimeOffset
      return row.at
    end).hour()
  let utcParts = gapRows(roots.matchingComputed(utcHour.equalTo(10)).take(3).selectShape(utcHour.requiredShape()).all())
  let utcYear = gapRows(roots.take(3).selectShape(utcCalendarField(quote do |row: QueryGapTime|: DateTimeOffset
          return row.at
        end).year().shape()).all())
  let localHour = calendarField(quote do |row: QueryGapTime|: DateTimeOffset
      return row.at
    end).hour()
  let localParts = gapRows(roots.matchingComputed(localHour.equalTo(11)).take(3).selectShape(localHour.requiredShape()).all())
  let rollover = sqlQuery<QueryGapTime>(
    "SELECT 1 AS id, '2026-12-31T23:30:00.1234567Z|60' AS at",
    new ParameterValues(),
    new Decoder<QueryGapTime>(read, columns),
    provider,
    mapping
  ).take(1)
  let calendar = calendarField(quote do |row: QueryGapTime|: DateTimeOffset
      return row.at
    end)
  let year = gapRows(rollover.selectShape(calendar.year().requiredShape()).all()).first()
  let microsecond = gapRows(rollover.selectShape(calendar.microsecond().requiredShape()).all()).first()
  let nanosecond = gapRows(rollover.selectShape(calendar.nanosecond().requiredShape()).all()).first()
  let later = gapRows(roots.matching(quote do |row: QueryGapTime|: Bool
        return row.at > instant
      end).take(3).all())
  let decode: fn(Cell): DecodeResult<DateTimeOffset> = fn(cell: Cell): DecodeResult<DateTimeOffset> do
    return decodeDateTimeOffset(new RawRow([new RawColumn("at", cell)]), "at")
  end
  let codec = new ScalarCodec<DateTimeOffset>(decode, ResultColumnKind.Text(), false, "neri_data.DateTimeOffset")
  let ordered = gapRows(roots.orderByValue(codec, quote do |row: QueryGapTime|: DateTimeOffset
        return row.at
      end, true).take(3).select(intScalar(), quote do |row: QueryGapTime|: Int
        return row.id
      end).all())
  let orderedFirst = ordered.first()
  let equalFirst = equal.first()

  test::assertEqual(equal.count(), 2)
  test::assertEqual(fields.count(), 2)
  test::assertEqual(utcParts.count(), 3)
  test::assertEqual(utcYear.count(), 3)
  test::assertEqual(localParts.count(), 1)
  test::assertTrue(year != null && year.value == 2027)
  test::assertTrue(microsecond != null && microsecond.value == 456)
  test::assertTrue(nanosecond != null && nanosecond.value == 700)
  test::assertEqual(later.count(), 1)
  test::assertTrue(orderedFirst != null && orderedFirst.value == 3)
  test::assertTrue(equalFirst != null && equalFirst.value.at.offsetMinutes() == 60)
end

class QueryGapDecimal
  public amount: Decimal = Decimal.zero()
  public optional: Decimal?
end

def gapDecimalQuery(provider: Provider, sql: String): Query<QueryGapDecimal>
  let decode: fn(RawRow): DecodeResult<QueryGapDecimal> = fn(row: RawRow): DecodeResult<QueryGapDecimal> do
    return DecodeResult<QueryGapDecimal>.Failure(QueryFailure.UnsupportedCapability("decimal scalar projection must decode its selected shape"))
  end
  let columns = new ResultColumns([
      new ResultColumn("amount", ResultColumnKind.Text()),
      new ResultColumn("optional", ResultColumnKind.Text(), true)
    ])
  let mapping = new EntityMapping(
    "neri_data_query_contract.QueryGapDecimal",
    "gap_decimals",
    [
      new MappingColumn("neri_data_query_contract.QueryGapDecimal.amount", "neri_data.Decimal", "amount"),
      new MappingColumn("neri_data_query_contract.QueryGapDecimal.optional", "neri_data.Decimal?", "optional")
    ],
    readOnly: true
  )

  return sqlQuery<QueryGapDecimal>(
    sql,
    new ParameterValues(),
    new Decoder<QueryGapDecimal>(decode, columns),
    provider,
    mapping
  ).take(1)
end

def gapDecimalText(result: QueryResult<Decimal>, expected: String): Void
  let rows = gapRows(result)
  let first = rows.first()

  test::assertTrue(first != null)
  if first != null
    test::assertEqual(first.value.text(), expected)
  end
end

def verifyQueryGapDecimals(provider: Provider): Void
  let amount = decimalField(quote do |row: QueryGapDecimal|: Decimal
      return row.amount
    end)
  let optional = optionalDecimalField(quote do |row: QueryGapDecimal|: Decimal?
      return row.optional
    end)
  let hundredth = Decimal.parse("0.01")
  let three = Decimal.parse("3")
  let tenth = Decimal.parse("0.1")

  test::assertTrue(hundredth != null && three != null && tenth != null)
  if hundredth == null || three == null || tenth == null
    return
  end
  let query = gapDecimalQuery(provider, "SELECT '9007199254740993.01' AS amount, '10.01' AS optional")

  gapDecimalText(
    query.selectDecimal(amount.multiply(decimalValue<QueryGapDecimal>(hundredth))).all(),
    "90071992547409.9301"
  )
  gapDecimalText(
    query.selectDecimal(optional.divideTruncated(
        decimalValue<QueryGapDecimal>(three).asOptional(),
        20
      ).coalesce(amount)).all(),
    "3.33666666666666666666"
  )
  let local = Decimal.parse("10.01")

  test::assertTrue(local != null)
  if local != null
    let divided = local.divideTruncated(three, 20)
    let multiplied = local.multiply(tenth)

    test::assertTrue(divided != null && divided.text() == "3.33666666666666666666")
    test::assertTrue(multiplied != null && multiplied.text() == "1.001")
    test::assertTrue(local.divideTruncated(Decimal.zero(), 2) == null)
  end
  let nullQuery = gapDecimalQuery(provider, "SELECT '1' AS amount, NULL AS optional")
  let nullRows = gapRows(nullQuery.selectOptionalDecimal(optional.multiply(decimalValue<QueryGapDecimal>(three).asOptional())).all())
  let first = nullRows.first()

  test::assertTrue(first != null && first.value == null)
  gapDecimalText(nullQuery.selectDecimal(optional.coalesce(decimalValue<QueryGapDecimal>(tenth))).all(), "0.1")
  let equalNull = gapRows(nullQuery.matchingDecimal(optional.equalTo(optionalDecimalValue<QueryGapDecimal>(null))).selectDecimal(amount).all())

  test::assertEqual(equalNull.count(), 1)
  for sql in ["SELECT NULL AS amount, NULL AS optional", "SELECT '1.00' AS amount, NULL AS optional"]
    match gapDecimalQuery(provider, sql).selectDecimal(amount).all()
      case QueryResult.Failure(error)
      case QueryResult.Rows(rows)
        test::assertTrue(false)
    end
  end
  match gapDecimalQuery(provider, "SELECT '1' AS amount, '1.00' AS optional").selectOptionalDecimal(optional).all()
    case QueryResult.Failure(error)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
  match query.selectDecimal(amount.divideTruncated(decimalValue<QueryGapDecimal>(Decimal.zero()), 2)).all()
    case QueryResult.Failure(error)
    case QueryResult.Rows(rows)
      test::assertTrue(false)
  end
end

class QueryGapJson
  public values: Int[] = []
  public document: String = "{}"
end

def verifyQueryGapJson(provider: Provider): Void
  let columns = new ResultColumns([
      new ResultColumn("values", ResultColumnKind.Text()),
      new ResultColumn("document", ResultColumnKind.Text())
    ])
  let mapping = new EntityMapping(
    "neri_data_query_contract.QueryGapJson",
    "gap_json",
    [
      new MappingColumn(
        "neri_data_query_contract.QueryGapJson.values",
        "Int[]",
        "values",
        storageType: "String",
        conversionId: "neri_data.cellInts"
      ),
      new MappingColumn("neri_data_query_contract.QueryGapJson.document", "String", "document")
    ],
    readOnly: true
  )
  let decode: fn(RawRow): DecodeResult<QueryGapJson> = fn(row: RawRow): DecodeResult<QueryGapJson> do
    return DecodeResult<QueryGapJson>.Failure(QueryFailure.UnsupportedCapability("JSON scalar projection must decode its selected shape"))
  end
  let query = sqlQuery<QueryGapJson>(
    "SELECT '[1,2,9007199254740993]' AS \"values\", '{\"profile\":{\"label\":\"Ada\",\"active\":true},\"ids\":[7,8]}' AS document",
    new ParameterValues(),
    new Decoder<QueryGapJson>(decode, columns),
    provider,
    mapping
  ).take(1)
  let collection = intCollection(quote do |row: QueryGapJson|: Int[]
      return row.values
    end)
  let document = jsonField(quote do |row: QueryGapJson|: String
      return row.document
    end)
  let lengths = gapRows(query.matchingComputed(collection.contains(9007199254740993)).selectShape(collection.lengthShape()).all())
  let labels = gapRows(query.selectShape(document.property("profile").property("label").textShape()).all())
  let ids = gapRows(query.selectShape(document.property("ids").index(1).intShape()).all())
  let missing = gapRows(query.selectShape(document.property("missing").intShape()).all())
  let firstLength = lengths.first()
  let firstLabel = labels.first()
  let firstId = ids.first()
  let firstMissing = missing.first()

  test::assertTrue(firstLength != null && firstLength.value == 3)
  test::assertTrue(firstLabel != null && firstLabel.value == "Ada")
  test::assertTrue(firstId != null && firstId.value == 8)
  test::assertTrue(firstMissing != null && firstMissing.value == null)
end

enum QueryGapStatus
  case Ready()
  case Pending()
end

class QueryGapConverted
  public id: Int = 0
  public status: QueryGapStatus = QueryGapStatus.Pending()
  public bytes: ByteBuffer = new ByteBuffer(8, 1)
  public optional: ByteBuffer?
end

def queryGapStatusCell(value: QueryGapStatus): Cell
  match value
    case QueryGapStatus.Ready()
      return Cell.Int(1)
    case QueryGapStatus.Pending()
      return Cell.Int(2)
  end
end

def verifyQueryGapConverted(provider: Provider): Void
  var binary = "X'01'"

  match provider.dialect()
    case SqlDialect.QuestionMark()
    case SqlDialect.PostgreSql()
      binary = "decode('01', 'hex')"
  end
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("status", ResultColumnKind.Int()),
      new ResultColumn("bytes", ResultColumnKind.Binary()),
      new ResultColumn("optional", ResultColumnKind.Binary(), true)
    ])
  let mapping = new EntityMapping("neri_data_query_contract.QueryGapConverted", "gap_converted", [
      new MappingColumn("neri_data_query_contract.QueryGapConverted.id", "Int", "id"),
      new MappingColumn(
        "neri_data_query_contract.QueryGapConverted.status",
        "neri_data_query_contract.QueryGapStatus",
        "status",
        storageType: "Int",
        conversionId: "neri_data_query_contract.queryGapStatusCell"
      ),
      new MappingColumn("neri_data_query_contract.QueryGapConverted.bytes", "buffers.ByteBuffer", "bytes"),
      new MappingColumn("neri_data_query_contract.QueryGapConverted.optional", "buffers.ByteBuffer?", "optional")
    ], readOnly: true)
  let read: fn(RawRow): DecodeResult<QueryGapConverted> = fn(row: RawRow): DecodeResult<QueryGapConverted> do
    return DecodeResult<QueryGapConverted>.Failure(QueryFailure.UnsupportedCapability("converted regression uses scalar projection"))
  end
  let query = sqlQuery<QueryGapConverted>(
    "SELECT 1 AS id, 1 AS status, " + binary + " AS bytes, NULL AS optional UNION ALL SELECT 2, 2, " + binary + ", " + binary,
    new ParameterValues(),
    new Decoder<QueryGapConverted>(read, columns),
    provider,
    mapping
  ).take(2)
  let bytes = new ByteBuffer(8, 1)

  bytes.append(1 as Byte)
  let equal = binaryField(quote do |row: QueryGapConverted|: ByteBuffer
      return row.bytes
    end).equalTo(bytes)

  bytes.append(2 as Byte)
  let selected = gapRows(query.matchingComputed(equal).select(intScalar(), quote do |row: QueryGapConverted|: Int
        return row.id
      end).all())
  let different = gapRows(query.matchingComputed(binaryField(quote do |row: QueryGapConverted|: ByteBuffer
          return row.bytes
        end).notEqualTo(bytes)).select(intScalar(), quote do |row: QueryGapConverted|: Int
        return row.id
      end).all())
  let nulls = gapRows(query.matchingComputed(optionalBinaryField(quote do |row: QueryGapConverted|: ByteBuffer?
          return row.optional
        end).equalTo(null)).select(intScalar(), quote do |row: QueryGapConverted|: Int
        return row.id
      end).all())
  let status = convertedField(quote do |row: QueryGapConverted|: QueryGapStatus
      return row.status
    end, queryGapStatusCell, "neri_data_query_contract.queryGapStatusCell")
  let ready = gapRows(query.matchingComputed(status.equalTo(QueryGapStatus.Ready())).select(intScalar(), quote do |row: QueryGapConverted|: Int
        return row.id
      end).all())
  let shadow = gapRows(query.whereMappedCell(
      "status",
      Cell.Int(2)
    ).select(intScalar(), quote do |row: QueryGapConverted|: Int
        return row.id
      end).all())
  let decodeStatus: fn(Cell): DecodeResult<QueryGapStatus> = fn(cell: Cell): DecodeResult<QueryGapStatus> do
    match cell
      case Cell.Int(value)
        if value == 1
          return DecodeResult<QueryGapStatus>.Value(QueryGapStatus.Ready())
        end
        if value == 2
          return DecodeResult<QueryGapStatus>.Value(QueryGapStatus.Pending())
        end
      case Cell.Text(value)
      case Cell.Bool(value)
      case Cell.Float(value)
      case Cell.Binary(value)
      case Cell.Null()
    end
    return DecodeResult<QueryGapStatus>.Failure(QueryFailure.UnsupportedCapability("unknown converted status"))
  end
  let statusCodec = new ScalarCodec<QueryGapStatus>(
    decodeStatus,
    ResultColumnKind.Int(),
    false,
    "neri_data_query_contract.QueryGapStatus"
  )
  let projected = gapRows(query.matchingComputed(status.equalTo(QueryGapStatus.Ready())).select(statusCodec, quote do |row: QueryGapConverted|: QueryGapStatus
        return row.status
      end).all())
  let projectedStatus = projected.first()

  test::assertEqual(selected.count(), 2)
  test::assertEqual(different.count(), 2)
  test::assertEqual(nulls.count(), 1)
  test::assertEqual(ready.count(), 1)
  test::assertEqual(shadow.count(), 1)
  test::assertTrue(projectedStatus != null)
  if projectedStatus != null
    match projectedStatus.value
      case QueryGapStatus.Ready()
        test::assertTrue(true)
      case QueryGapStatus.Pending()
        test::assertTrue(false)
    end
  end
end

class QueryGapString
  public id: Int = 0
  public text: String = ""
  public optional: String?
  public encoded: String = ""
end

def queryGapEncodedString(value: String): Cell
  return Cell.Text("encoded:" + value)
end

def verifyQueryGapStrings(provider: Provider): Void
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("text", ResultColumnKind.Text()),
      new ResultColumn("optional", ResultColumnKind.Text(), true),
      new ResultColumn("encoded", ResultColumnKind.Text())
    ])
  let mapping = new EntityMapping("neri_data_query_contract.QueryGapString", "gap_strings", [
      new MappingColumn("neri_data_query_contract.QueryGapString.id", "Int", "id"),
      new MappingColumn("neri_data_query_contract.QueryGapString.text", "String", "text"),
      new MappingColumn("neri_data_query_contract.QueryGapString.optional", "String?", "optional"),
      new MappingColumn(
        "neri_data_query_contract.QueryGapString.encoded",
        "String",
        "encoded",
        storageType: "String",
        conversionId: "neri_data_query_contract.queryGapEncodedString"
      )
    ], readOnly: true)
  let read: fn(RawRow): DecodeResult<QueryGapString> = fn(row: RawRow): DecodeResult<QueryGapString> do
    return DecodeResult<QueryGapString>.Failure(QueryFailure.UnsupportedCapability("string regression uses scalar projection"))
  end
  let query = sqlQuery<QueryGapString>(
    "SELECT 1 AS id, '  Ab%_éZ  ' AS text, NULL AS optional, 'encoded:abc' AS encoded",
    new ParameterValues(),
    new Decoder<QueryGapString>(read, columns),
    provider,
    mapping
  ).take(1)
  let text = stringField(quote do |row: QueryGapString|: String
      return row.text
    end).trim()
  let contains = gapRows(query.matchingComputed(text.contains("%_")).selectShape(stringShape(text.substring(
          4,
          1
        ))).all())
  let prefix = gapRows(query.matchingComputed(text.startsWith("Ab")).selectShape(stringLengthShape(text)).all())
  let suffix = gapRows(query.matchingComputed(text.endsWith("éZ")).selectShape(stringShape(stringValue<QueryGapString>("aB").upper())).all())
  let optional = optionalStringField(quote do |row: QueryGapString|: String?
      return row.optional
    end)
  let nulls = gapRows(query.selectShape(optionalStringLengthShape(optional)).all())
  let coalesced = gapRows(query.selectShape(stringShape(optional.coalesce("fallback"))).all())
  let encoded = convertedField(quote do |row: QueryGapString|: String
      return row.encoded
    end, queryGapEncodedString, "neri_data_query_contract.queryGapEncodedString")
  let explicit = gapRows(query.matchingComputed(encoded.equalTo("abc")).select(intScalar(), quote do |row: QueryGapString|: Int
        return row.id
      end).all())
  let first = contains.first()
  let length = prefix.first()
  let upper = suffix.first()
  let empty = nulls.first()
  let fallback = coalesced.first()

  test::assertTrue(first != null && first.value == "é")
  test::assertTrue(length != null && length.value == 6)
  test::assertTrue(upper != null && upper.value == "AB")
  test::assertTrue(empty != null && empty.value == null)
  test::assertTrue(fallback != null && fallback.value == "fallback")
  test::assertEqual(explicit.count(), 1)

  match query.where(encoded: "abc").select(intScalar(), quote do |row: QueryGapString|: Int
      return row.id
    end).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      test::assertTrue(true)
  end
  match query.matching(quote do |row: QueryGapString|: Bool
      return row.encoded == "abc"
    end).select(intScalar(), quote do |row: QueryGapString|: Int
      return row.id
    end).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      test::assertTrue(true)
  end
end

class QueryGapNumeric
  public id: Int = 0
  public number: Float = 0.0
  public optional: Float?
end

def gapNumericQuery(provider: Provider, value: String): Query<QueryGapNumeric>
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("number", ResultColumnKind.Float()),
      new ResultColumn("optional", ResultColumnKind.Float(), true)
    ])
  let mapping = new EntityMapping("neri_data_query_contract.QueryGapNumeric", "gap_numbers", [
      new MappingColumn("neri_data_query_contract.QueryGapNumeric.id", "Int", "id"),
      new MappingColumn("neri_data_query_contract.QueryGapNumeric.number", "Float", "number"),
      new MappingColumn("neri_data_query_contract.QueryGapNumeric.optional", "Float?", "optional")
    ], readOnly: true)
  let read: fn(RawRow): DecodeResult<QueryGapNumeric> = fn(row: RawRow): DecodeResult<QueryGapNumeric> do
    return DecodeResult<QueryGapNumeric>.Failure(QueryFailure.UnsupportedCapability("numeric regression uses scalar projection"))
  end

  return sqlQuery<QueryGapNumeric>(
    "SELECT 8 AS id, CAST(" + value + " AS DOUBLE PRECISION) AS number, CAST(NULL AS DOUBLE PRECISION) AS optional",
    new ParameterValues(),
    new Decoder<QueryGapNumeric>(read, columns),
    provider,
    mapping
  ).take(1)
end

def verifyQueryGapNumeric(provider: Provider): Void
  let query = gapNumericQuery(provider, "-3.9")
  let number = floatField(quote do |row: QueryGapNumeric|: Float
      return row.number
    end)
  let optional = optionalFloatField(quote do |row: QueryGapNumeric|: Float?
      return row.optional
    end)
  let truncated = gapRows(query.selectShape(number.toIntTruncated().shape()).all()).first()
  let converted = gapRows(query.selectShape(intField(quote do |row: QueryGapNumeric|: Int
          return row.id
        end).toFloat().shape()).all()).first()
  let coalesced = gapRows(query.selectShape(optional.coalesce(4.9).toIntTruncated().shape()).all()).first()
  let nullable = gapRows(query.selectShape(optional.toIntTruncated().shape()).all()).first()
  let conditional = gapRows(query.select(intScalar(), quote do |row: QueryGapNumeric|: Int
        return row.id > 0 ? 7 : -1
      end).all()).first()

  test::assertTrue(truncated != null && truncated.value == -3)
  test::assertTrue(converted != null && converted.value == 8.0)
  test::assertTrue(coalesced != null && coalesced.value == 4)
  test::assertTrue(nullable != null && nullable.value == null)
  test::assertTrue(conditional != null && conditional.value == 7)

  match gapNumericQuery(provider, "9223372036854775808.0").selectShape(number.toIntTruncated().shape()).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      test::assertTrue(true)
  end
  match gapNumericQuery(provider, "NULL").selectShape(number.toIntTruncated().shape()).all()
    case QueryResult.Rows(rows)
      test::assertTrue(false)
    case QueryResult.Failure(error)
      test::assertTrue(true)
  end
end

class QueryGapBridge
  public id: Int = 1
  public leftId: Int = 1
  public rightId: Int = 10
  public left: QueryGapRoot?
  public right: QueryGapChild?
end

def verifyQueryGapSkipFixup(provider: Provider): Void
  let graph = new QueryGapGraph(provider)
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("left_id", ResultColumnKind.Int()),
      new ResultColumn("right_id", ResultColumnKind.Int())
    ])
  let capture: fn(QueryGapBridge): RawRow = fn(value: QueryGapBridge): RawRow do
    return new RawRow([
        new RawColumn("id", Cell.Int(value.id)),
        new RawColumn("left_id", Cell.Int(value.leftId)),
        new RawColumn("right_id", Cell.Int(value.rightId))
      ])
  end
  let read: fn(RawRow): DecodeResult<QueryGapBridge> = fn(row: RawRow): DecodeResult<QueryGapBridge> do
    return DecodeResult<QueryGapBridge>.Value(new QueryGapBridge())
  end
  let tracker = new EntityTracker<QueryGapBridge>("gap_bridges", "id", columns, capture)

  graph.changes.register(tracker.changeSet())
  let bridges = new Query<QueryGapBridge>("gap_bridges", new Decoder<QueryGapBridge>(
      read,
      columns
    ), mapping: new EntityMapping("neri_data_query_contract.QueryGapBridge", "gap_bridges", [
        new MappingColumn("neri_data_query_contract.QueryGapBridge.id", "Int", "id"),
        new MappingColumn("neri_data_query_contract.QueryGapBridge.leftId", "Int", "left_id"),
        new MappingColumn("neri_data_query_contract.QueryGapBridge.rightId", "Int", "right_id")
      ], "id"), provider: provider, tracker: tracker, changes: graph.changes).fromSql(
    "SELECT 1 AS id, 1 AS left_id, 10 AS right_id",
    new ParameterValues()
  )
  let leftKey: fn(QueryGapRoot): Cell = fn(value: QueryGapRoot): Cell do
    return Cell.Int(value.id)
  end
  let rightKey: fn(QueryGapChild): Cell = fn(value: QueryGapChild): Cell do
    return Cell.Int(value.id)
  end
  let joinKey: fn(QueryGapBridge): Cell = fn(value: QueryGapBridge): Cell do
    return Cell.Int(value.id)
  end
  let leftForeign: fn(QueryGapBridge): Cell = fn(value: QueryGapBridge): Cell do
    return Cell.Int(value.leftId)
  end
  let rightForeign: fn(QueryGapBridge): Cell = fn(value: QueryGapBridge): Cell do
    return Cell.Int(value.rightId)
  end
  let leftGet: fn(QueryGapRoot): QueryGapBridge[] = fn(value: QueryGapRoot): QueryGapBridge[] do
    return value.bridges
  end
  let leftSet: fn(QueryGapRoot, QueryGapBridge[]): Void = fn(value: QueryGapRoot, links: QueryGapBridge[]): Void do
    value.bridges = links
  end
  let rightGet: fn(QueryGapChild): QueryGapBridge[] = fn(value: QueryGapChild): QueryGapBridge[] do
    return value.bridges
  end
  let rightSet: fn(QueryGapChild, QueryGapBridge[]): Void = fn(value: QueryGapChild, links: QueryGapBridge[]): Void do
    value.bridges = links
  end
  let leftRef: fn(QueryGapBridge): QueryGapRoot? = fn(value: QueryGapBridge): QueryGapRoot? do
    return value.left
  end
  let leftRefSet: fn(QueryGapBridge, QueryGapRoot?): Void = fn(value: QueryGapBridge, left: QueryGapRoot?): Void do
    value.left = left
  end
  let rightRef: fn(QueryGapBridge): QueryGapChild? = fn(value: QueryGapBridge): QueryGapChild? do
    return value.right
  end
  let rightRefSet: fn(QueryGapBridge, QueryGapChild?): Void = fn(value: QueryGapBridge, right: QueryGapChild?): Void do
    value.right = right
  end
  let leftRelation = new CollectionNavigation<QueryGapRoot, QueryGapBridge>(
    leftKey,
    joinKey,
    leftForeign,
    "left_id",
    leftGet,
    leftSet,
    leftRef,
    leftRefSet
  )
  let rightRelation = new CollectionNavigation<QueryGapChild, QueryGapBridge>(
    rightKey,
    joinKey,
    rightForeign,
    "right_id",
    rightGet,
    rightSet,
    rightRef,
    rightRefSet
  )
  let getLeft: fn(QueryGapRoot): QueryGapChild[] = fn(value: QueryGapRoot): QueryGapChild[] do
    return value.skipChildren
  end
  let setLeft: fn(QueryGapRoot, QueryGapChild[]): Void = fn(value: QueryGapRoot, rights: QueryGapChild[]): Void do
    value.skipChildren = rights
  end
  let getRight: fn(QueryGapChild): QueryGapRoot[] = fn(value: QueryGapChild): QueryGapRoot[] do
    return value.skipRoots
  end
  let setRight: fn(QueryGapChild, QueryGapRoot[]): Void = fn(value: QueryGapChild, lefts: QueryGapRoot[]): Void do
    value.skipRoots = lefts
  end
  let create: fn(
    QueryGapRoot,
    QueryGapChild
  ): QueryGapBridge = fn(
    left: QueryGapRoot,
    right: QueryGapChild
  ): QueryGapBridge do
    let value = new QueryGapBridge()

    value.leftId = left.id
    value.rightId = right.id
    return value
  end
  let navigation = new ManyToManyNavigation<QueryGapRoot, QueryGapBridge, QueryGapChild>(
    leftRelation,
    rightRelation,
    getLeft,
    setLeft,
    getRight,
    setRight,
    create
  )

  test::assertTrue(registerNavigation(graph.roots, bridges, leftRelation) == null)
  test::assertTrue(registerNavigation(graph.children, bridges, rightRelation) == null)
  test::assertTrue(navigation.trackCollectionChanges(graph.roots, bridges, graph.children) == null)

  gapRows(bridges.take(1).all())
  let left = gapRows(graph.roots.take(3).all()).first()
  let right = gapRows(graph.children.take(3).all()).first()

  test::assertTrue(left != null && right != null)
  if left != null && right != null
    test::assertEqual(left.value.skipChildren.Length, 1)
    test::assertEqual(right.value.skipRoots.Length, 1)
    test::assertTrue(reference::same(left.value.skipChildren[0], right.value))

    left.value.skipChildren = []
    gapRows(graph.children.take(3).all())

    test::assertEqual(left.value.skipChildren.Length, 0)
  end
  let single = gapRows(graph.roots.take(3).includeStep(navigation.step(
        graph.roots,
        bridges,
        graph.children
      )).asSingleQuery().all())
  let first = single.first()

  test::assertEqual(single.count(), 3)
  test::assertTrue(first != null && first.value.skipChildren.Length == 1)
end

class QueryGapBulk
  public id: Int = 0
  public label: String = ""
  public number: Float = 0.0
  public optional: Float?
  public encoded: String = ""
  public optionalText: String?
end

def gapSaved(result: WriteResult): Int
  match result
    case WriteResult.Saved(count)
      return count
    case WriteResult.SavedWithValues(count, outputs)
      return count
    case WriteResult.Failure(error)
      test::assertTrue(false)
      return -1
  end
end

def verifyQueryGapComputedUpdates(provider: Provider): Void
  gapSaved(provider.executeSet(new SetWritePlan(
        "CREATE TEMP TABLE gap_scalar_updates(id BIGINT PRIMARY KEY, label TEXT NOT NULL, number DOUBLE PRECISION NOT NULL, optional DOUBLE PRECISION, encoded TEXT NOT NULL, optional_text TEXT)",
        new WriteValues()
      )))
  gapSaved(provider.executeSet(new SetWritePlan(
        "INSERT INTO gap_scalar_updates VALUES (1, '  aB  ', -3.9, NULL, 'encoded:old', NULL)",
        new WriteValues()
      )))
  let columns = new ResultColumns([
      new ResultColumn("id", ResultColumnKind.Int()),
      new ResultColumn("label", ResultColumnKind.Text()),
      new ResultColumn("number", ResultColumnKind.Float()),
      new ResultColumn("optional", ResultColumnKind.Float(), true),
      new ResultColumn("encoded", ResultColumnKind.Text()),
      new ResultColumn("optional_text", ResultColumnKind.Text(), true)
    ])
  let mapping = new EntityMapping("neri_data_query_contract.QueryGapBulk", "gap_scalar_updates", [
      new MappingColumn("neri_data_query_contract.QueryGapBulk.id", "Int", "id"),
      new MappingColumn("neri_data_query_contract.QueryGapBulk.label", "String", "label"),
      new MappingColumn("neri_data_query_contract.QueryGapBulk.number", "Float", "number"),
      new MappingColumn("neri_data_query_contract.QueryGapBulk.optional", "Float?", "optional"),
      new MappingColumn("neri_data_query_contract.QueryGapBulk.optionalText", "String?", "optional_text"),
      new MappingColumn(
        "neri_data_query_contract.QueryGapBulk.encoded",
        "String",
        "encoded",
        storageType: "String",
        conversionId: "neri_data_query_contract.queryGapEncodedString"
      )
    ], "id")
  let read: fn(RawRow): DecodeResult<QueryGapBulk> = fn(row: RawRow): DecodeResult<QueryGapBulk> do
    return DecodeResult<QueryGapBulk>.Failure(QueryFailure.UnsupportedCapability("computed update regression uses scalar projection"))
  end
  let query = new Query<QueryGapBulk>(
    "gap_scalar_updates",
    new Decoder<QueryGapBulk>(read, columns),
    mapping: mapping,
    provider: provider
  ).take(1)
  let label = stringField(quote do |row: QueryGapBulk|: String
      return row.label
    end).trim().upper()
  let number = floatField(quote do |row: QueryGapBulk|: Float
      return row.number
    end).toIntTruncated().toFloat()
  let optional = optionalFloatField(quote do |row: QueryGapBulk|: Float?
      return row.optional
    end)
  let setters = updateSet<QueryGapBulk>().setString(quote do |row: QueryGapBulk|: String
      return row.label
    end, label).setNumeric(quote do |row: QueryGapBulk|: Float
      return row.number
    end, number).setOptionalNumeric(quote do |row: QueryGapBulk|: Float?
      return row.optional
    end, optional.toIntTruncated().toFloat()).setConverted(quote do |row: QueryGapBulk|: String
      return row.encoded
    end, "new", queryGapEncodedString, "neri_data_query_contract.queryGapEncodedString").setOptionalString(quote do |row: QueryGapBulk|: String?
      return row.optionalText
    end, optionalStringValue<QueryGapBulk>("  optional  ").trim())
  let count = gapSaved(query.executeUpdateSet(setters))
  let text = gapRows(query.select(textScalar(), quote do |row: QueryGapBulk|: String
        return row.label
      end).all()).first()
  let numeric = gapRows(query.select(floatScalar(), quote do |row: QueryGapBulk|: Float
        return row.number
      end).all()).first()
  let nullable = gapRows(query.select(optionalFloatScalar(), quote do |row: QueryGapBulk|: Float?
        return row.optional
      end).all()).first()
  let optionalText = gapRows(query.select(optionalTextScalar(), quote do |row: QueryGapBulk|: String?
        return row.optionalText
      end).all()).first()
  let encoded = gapRows(query.whereMappedCell(
      "encoded",
      Cell.Text("encoded:new")
    ).select(intScalar(), quote do |row: QueryGapBulk|: Int
        return row.id
      end).all())

  test::assertEqual(count, 1)
  test::assertTrue(text != null && text.value == "AB")
  test::assertTrue(numeric != null && numeric.value == -3.0)
  test::assertTrue(nullable != null && nullable.value == null)
  test::assertTrue(optionalText != null && optionalText.value == "optional")
  test::assertEqual(encoded.count(), 1)

  let implicit = updateSet<QueryGapBulk>().set(quote do |row: QueryGapBulk|: String
      return row.encoded
    end, quote do |row: QueryGapBulk|: String
      return "plain"
    end)

  match query.executeUpdateSet(implicit)
    case WriteResult.Saved(count)
      test::assertTrue(false)
    case WriteResult.SavedWithValues(count, outputs)
      test::assertTrue(false)
    case WriteResult.Failure(error)
      test::assertTrue(true)
  end
  let mapped = gapSaved(query.executeUpdateMappedCell("encoded", Cell.Text("encoded:mapped")))
  let mappedRows = gapRows(query.whereMappedCell(
      "encoded",
      Cell.Text("encoded:mapped")
    ).select(intScalar(), quote do |row: QueryGapBulk|: Int
        return row.id
      end).all())

  test::assertEqual(mapped, 1)
  test::assertEqual(mappedRows.count(), 1)

  gapSaved(provider.executeSet(new SetWritePlan("DROP TABLE gap_scalar_updates", new WriteValues())))
end

def verifyQueryParity(provider: Provider): Void
  verifyQueryGapComputedUpdates(provider)
  verifyQueryGapSkipFixup(provider)
  verifyQueryGapNumeric(provider)
  verifyQueryGapStrings(provider)
  verifyQueryGapConverted(provider)
  verifyQueryGapTime(provider)
  verifyQueryGapDecimals(provider)
  verifyQueryGapCorrelations(provider)
  verifyQueryGapLoading(provider)
  verifyQueryGapJson(provider)
end

def verifyAsyncQueryParity(provider: Provider): resources::Outcome<Int, QueryFailure>
  let graph = new QueryGapGraph(provider)
  let path = graph.roots.take(3).includeStep(collectionStep(
      graph.roots,
      graph.children,
      graph.relation
    )).thenIncludeStep(referenceStep(
      graph.children,
      graph.roots,
      graph.relation
    ))
  var root: QueryGapRoot? = null

  using operation <- path.allAsync()
    var done = false

    while !done
      match operation.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          done = true
          let rows = gapRows(result)
          let first = rows.first()

          test::assertTrue(first != null && first.value.children.Length == 2)
          if first != null
            root = first.value
            let inverse = first.value.children[0].root

            test::assertTrue(inverse != null && reference::same(inverse, first.value))
          end
      end
    end
  end
  using single <- include(graph.roots.take(3), graph.children, graph.relation).asNoTracking().asSingleQuery().allAsync()
    var done = false

    while !done
      match single.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          done = true
          let rows = gapRows(result)
          let first = rows.first()

          test::assertEqual(rows.count(), 3)
          test::assertTrue(first != null && first.value.children.Length == 2)
          if first != null
            test::assertTrue(root != null && !reference::same(first.value, root))
            if root != null
              test::assertTrue(graph.roots.stateOf(root) != null)
            end
          end
      end
    end
  end
  let counting = new QueryGapCountingProvider(provider)
  let pathGraph = new QueryGapGraph(counting)
  let combined = pathGraph.roots.take(3).includeStep(collectionStep(
      pathGraph.roots,
      pathGraph.children,
      pathGraph.relation
    )).thenIncludeStep(referenceStep(
      pathGraph.children,
      pathGraph.roots,
      pathGraph.relation
    )).includeStep(collectionStep(
      pathGraph.roots,
      pathGraph.children,
      pathGraph.relation
    )).asSingleQuery()

  using singlePath <- combined.allAsync()
    var done = false

    while !done
      match singlePath.poll()
        case AsyncQueryPoll.Pending(socket, interest)
          continue
        case AsyncQueryPoll.Completed(result)
          done = true

          test::assertEqual(gapRows(result).count(), 3)
          test::assertEqual(counting.commands, 1)
      end
    end
  end
  if root != null
    let field = lazyCollectionField(graph.roots, graph.children, graph.relation, root)

    using lazy <- field.getAsync()
      var done = false

      while !done
        match lazy.poll()
          case AsyncQueryPoll.Pending(socket, interest)
            continue
          case AsyncQueryPoll.Completed(result)
            done = true

            test::assertEqual(gapRows(result).count(), 2)
        end
      end
    end
  end
  match graph.roots.matching(quote do |row: QueryGapRoot|: Bool
      return row.id >= 1
    end).take(3).compileQuery()
    case CompiledQueryResult.Failure(error)
      return error
    case CompiledQueryResult.Prepared(compiled)
      let parameters: fn(Int): ParameterValues = fn(value: Int): ParameterValues do
        return new ParameterValues(new ParameterNode(Parameter.Int(value)), 1)
      end
      let invoke = compiled.asyncDelegate(parameters)

      using query <- invoke(2, null)
        var done = false

        while !done
          match query.poll()
            case AsyncQueryPoll.Pending(socket, interest)
              continue
            case AsyncQueryPoll.Completed(result)
              done = true

              test::assertEqual(gapRows(result).count(), 2)
          end
        end
      end
  end
  return 0
end
