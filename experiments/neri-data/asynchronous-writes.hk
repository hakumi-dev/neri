use result
namespace neri_data

enum AsyncWritePoll
  case Pending(socket: Int, interest: AsyncInterest)
  case Completed(result: WriteResult)
end

abstract class AsyncWriteDriver
  public abstract def poll(): AsyncWritePoll
  public abstract def cancel(): Void
  public abstract def close(): WriteFailure?
end

enum AsyncWriteStart
  case Started(driver: AsyncWriteDriver)
  case Failure(error: WriteFailure)
end

enum AsyncTransactionAction
  case Begin()
  case Commit(lease: Int)
  case Rollback(lease: Int)
  case Savepoint(lease: Int)
  case RollbackTo(lease: Int, id: Int)
  case Release(lease: Int, id: Int)
end

enum AsyncControlResult
  case Begun(lease: Int)
  case Created(id: Int)
  case Saved()
  case Failure(error: WriteFailure)
end

enum AsyncControlPoll
  case Pending(socket: Int, interest: AsyncInterest)
  case Completed(result: AsyncControlResult)
end

abstract class AsyncControlDriver
  public abstract def poll(): AsyncControlPoll
  public abstract def cancel(): Void
  public abstract def close(): WriteFailure?
end

enum AsyncControlStart
  case Started(driver: AsyncControlDriver)
  case Failure(error: WriteFailure)
end

resource class AsyncWrite
  private driver: AsyncWriteDriver
  private finalize: (fn(WriteResult): WriteResult)?
  private terminal: WriteResult?

  def init(driver: AsyncWriteDriver, finalize: (fn(WriteResult): WriteResult)? = null): Void
    this.driver = driver
    this.finalize = finalize
  end

  private def finish(result: WriteResult): WriteResult
    let finalize = this.finalize
    let terminal = finalize == null ? result : finalize(result)

    this.finalize = null
    this.terminal = terminal
    return terminal
  end

  public def poll(): AsyncWritePoll
    let terminal = this.terminal

    if terminal != null
      return AsyncWritePoll.Completed(terminal)
    end
    match this.driver.poll()
      case AsyncWritePoll.Pending(socket, interest)
        return AsyncWritePoll.Pending(socket, interest)
      case AsyncWritePoll.Completed(result)
        return AsyncWritePoll.Completed(this.finish(result))
    end
  end

  public def cancel(): Void
    this.driver.cancel()
  end

  public def close(): result::Failure?
    let error = this.driver.close()

    if this.terminal == null
      this.finish(WriteResult.Failure(error == null ? WriteFailure.Transaction("asynchronous write disposed before completion") : error))
    end
    return error == null ? null : writeResourceFailure(error, "data.async.write.close")
  end
end

def startWriteAsync(
  provider: Provider,
  batch: readonly WriteBatch,
  options: StreamOptions? = null,
  lease: Int? = null,
  validate: (fn(readonly WriteReturnedRows): WriteFailure?)? = null,
  finalize: (fn(WriteResult): WriteResult)? = null
): result::Result<AsyncWrite, WriteFailure>
  match provider.beginWriteAsync(batch, options, lease, validate)
    case AsyncWriteStart.Failure(error)
      return result::Result<AsyncWrite, WriteFailure>.Error(error)
    case AsyncWriteStart.Started(driver)
      let owned = new AsyncWrite(driver, finalize)

      return result::Result<AsyncWrite, WriteFailure>.Ok(transfer owned)
  end
end

resource class AsyncControl
  private driver: AsyncControlDriver

  def init(driver: AsyncControlDriver): Void
    this.driver = driver
  end

  public def poll(): AsyncControlPoll
    return this.driver.poll()
  end

  public def cancel(): Void
    this.driver.cancel()
  end

  public def close(): result::Failure?
    let error = this.driver.close()

    return error == null ? null : writeResourceFailure(error, "data.async.transaction.close")
  end
end

def startControlAsync(
  provider: Provider,
  action: AsyncTransactionAction,
  options: StreamOptions? = null
): result::Result<AsyncControl, WriteFailure>
  match provider.beginControlAsync(action, options)
    case AsyncControlStart.Failure(error)
      return result::Result<AsyncControl, WriteFailure>.Error(error)
    case AsyncControlStart.Started(driver)
      let owned = new AsyncControl(driver)

      return result::Result<AsyncControl, WriteFailure>.Ok(transfer owned)
  end
end

def writeResourceFailure(error: WriteFailure, operation: String): result::Failure
  match error
    case WriteFailure.Provider(nativeError)
      return providerResourceFailure(nativeError, operation)
    case WriteFailure.Cleanup(cleanup)
      return new result::Failure(
        "cleanup_failed",
        operation,
        cause: writeResourceFailure(cleanup.primary(), operation),
        closeFailure: writeResourceFailure(cleanup.cleanup(), operation)
      )
    case WriteFailure.Validation(message)
    case WriteFailure.Concurrency(message)
    case WriteFailure.Constraint(message)
    case WriteFailure.Unsupported(message)
    case WriteFailure.Transaction(message)
      return new result::Failure("write", operation, writeFailureMessage(error))
  end
end
