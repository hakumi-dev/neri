use host
use test
use console

def contains(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def sourceText(): String
  let source = host.readText("experiments/neri-data/data.hk")

  test.assertTrue(source != null)
  if source != null
    return source
  end
  return ""
end

def completion(source: String, position: Int): String
  let document = new LspDocument()

  document.uri = "untitled:neri-data-verification"
  document.text = source
  document.version = 1
  document.publishDiagnostics = false
  let server = new LspServer()

  server.documents = document
  server.analyze(document)
  return lspCompletion(document, position)
end

def sessionCompletionHas(result: SessionCompletionResult, name: String): Bool
  var item = result.first

  while item != null
    if item.name == name
      return true
    end
    item = item.next
  end
  return false
end

def lspContracts(): Void
  let data = sourceText()
  let activeSource = data + "\n\ndef main(): Void\n  customerActive().\nend\n"
  let active = completion(activeSource, host.stringByteLength(activeSource) - host.stringByteLength("\nend\n"))

  console.println(contains(active, "\"data\"") ? "Bool completion has resolve metadata" : "Observed gap: Bool completion has no documentation resolve metadata")

  test.assertTrue(contains(active, "\"label\":\"eq\""))
  test.assertTrue(!contains(active, "\"label\":\"isNull\""))
  test.assertTrue(!contains(active, "\"label\":\"gt\""))
  test.assertTrue(contains(active, "value: Bool"))

  let nicknameSource = data + "\n\ndef main(): Void\n  customerNickname().\nend\n"
  let nickname = completion(nicknameSource, host.stringByteLength(nicknameSource) - host.stringByteLength("\nend\n"))

  test.assertTrue(contains(nickname, "\"label\":\"isNull\""))
  test.assertTrue(!contains(nickname, "\"label\":\"gt\""))

  let querySource = data + "\n\ndef main(): Void\n  customers().where(customerActive().eq(true)).\nend\n"
  let query = completion(querySource, host.stringByteLength(querySource) - host.stringByteLength("\nend\n"))

  test.assertTrue(contains(query, "\"label\":\"where\""))
  test.assertTrue(contains(query, "Predicate<neri_data.Customer>"))
  test.assertTrue(contains(query, "Query<neri_data.Customer>"))
end

def retainedSessionContract(): Void
  let source = sourceText()
  let tokens = new BootstrapLexer(source).lex()
  let parser = new BootstrapParser(tokens)
  let root = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, root, utf16Length(source))

  binder.requireEntryPoint = false
  let model = binder.bind()
  let retained = new SessionCompilation(model, parser.arena, source)
  let query = "use neri_data\ncustomerActive()."
  let result = sessionCompleteSource(query, host.stringByteLength(query), 0, null,
    retained, null, "", new StringBuffer())


  test.assertEqual(result.status, "complete")
  test.assertTrue(sessionCompletionHas(result, "eq"))
  test.assertTrue(!sessionCompletionHas(result, "isNull"))
  test.assertTrue(!sessionCompletionHas(result, "gt"))
end

def projectLspContract(): Void
  let source = "use neri_data\n\ndef probe(): Void\n  let field = customerActive()\n  field.\nend\n"
  let document = new LspDocument()

  let path = host.pathAbsolute("experiments/neri-data/editor/probe.hk")

  test.assertTrue(path != null)
  if path == null
    return
  end
  document.uri = lspUri(path)
  document.sourcePath = path
  document.text = source
  document.version = 1
  document.publishDiagnostics = false
  let server = new LspServer()

  server.rootPath = "."
  server.documents = document
  server.analyze(document)
  let position = host.stringByteLength(source) - host.stringByteLength("\nend\n")
  let result = lspCompletion(document, position)

  test.assertTrue(contains(result, "\"label\":\"eq\""))
  test.assertTrue(!contains(result, "\"label\":\"isNull\""))
  test.assertTrue(!contains(result, "\"label\":\"gt\""))
end

def main(): Void
  console.println("LSP fixture")
  lspContracts()
  console.println("Retained session")
  retainedSessionContract()
  console.println("LSP project")
  projectLspContract()
  console.println("Diagnostics")
  diagnosticContract("customerActive().eq(1)", "NR112")
  diagnosticContract("customers().where(orderId().eq(1))", "NR112")
  diagnosticContract("customerActive().gt(1)", "NR131")
  diagnosticContract("customerActve().eq(true)", "NR110", "NR104")
  console.println("Neri Data verification passed")
end

def diagnosticContract(expression: String, code: String, sessionCode: String = ""): Void
  let data = sourceText()
  let document = new LspDocument()

  document.uri = "untitled:neri-data-negative"
  document.text = "use neri_data\n\ndef main(): Void\n  let invalid = " + expression + "\nend\n\n" + data
  document.publishDiagnostics = false
  let server = new LspServer()

  server.analyze(document)
  let semantic = document.semantic

  test.assertTrue(semantic != null)
  if semantic != null
    console.println("LSP " + expression + ": " + semantic.diagnostics.codes.get(0))

    test.assertTrue(semantic.diagnostics.count() > 0)
    test.assertEqual(semantic.diagnostics.codes.get(0), code)
  end
  let snapshot = new SessionSourceSnapshot()

  snapshot.add("data.hk", data)
  let session = new SessionEnvironment("neri-data-negative", snapshot)
  let prepared = session.prepare("use neri_data\nlet invalid = " + expression)
  let diagnostic = prepared.diagnostics

  test.assertEqual(prepared.status, "invalid")
  test.assertTrue(diagnostic != null)
  if diagnostic != null
    console.println("Session " + expression + ": " + diagnostic.code + " " + diagnostic.message)

    test.assertEqual(diagnostic.code, sessionCode == "" ? code : sessionCode)
  end
end
