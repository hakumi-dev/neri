namespace neri_data

# Manual source fixture for a future generated data API; no generator or driver is present.

class Customer
  public id: Int
  public name: String
  public active: Bool
  public nickname: String?

  def init(id: Int, name: String, active: Bool, nickname: String? = null): Void
    this.id = id
    this.name = name
    this.active = active
    this.nickname = nickname
  end
end

class Order
  public id: Int
  public customerId: Int
  public total: Int

  def init(id: Int, customerId: Int, total: Int): Void
    this.id = id
    this.customerId = customerId
    this.total = total
  end
end

## A typed value bound to a plan placeholder.
enum Parameter
  case Bool(value: Bool)
  case Int(value: Int)
  case Text(value: String)
end

## A small immutable parameter chain kept separate from the preview expression.
class ParameterList
  private item: Parameter
  private following: ParameterList?

  internal def init(value: Parameter, next: ParameterList? = null): Void
    this.item = value
    this.following = next
  end

  ## Returns this node's typed value without exposing mutable storage.
  public readonly def value(): readonly Parameter
    return this.item
  end

  ## Returns a read-only view of the following parameter node.
  public readonly def next(): readonly ParameterList?
    return this.following
  end

  internal def rawValue(): Parameter
    return this.item
  end

  internal def tail(): ParameterList?
    return this.following
  end

  ## Returns the number of typed values bound by this predicate or plan.
  public readonly def count(): Int
    let following = this.next()

    if following != null
      return 1 + following.count()
    end
    return 1
  end
end

## A predicate tied to one entity type.
class Predicate<T>
  private expression: String
  private parameters: ParameterList?

  internal def init(expression: String, parameters: ParameterList? = null): Void
    this.expression = expression
    this.parameters = parameters
  end

  ## Returns the placeholder expression without interpolating values.
  public readonly def preview(): String
    return this.expression
  end

  internal def parameterList(): ParameterList?
    return this.parameters
  end
end

## An integer field descriptor; its type parameter brands it to one entity.
class IntField<T>
  private name: String

  internal def init(name: String): Void
    this.name = name
  end

  ## Returns the known field name used in a plan preview.
  public readonly def preview(): String
    return this.name
  end

  ## Builds an equality predicate with one typed Int parameter.
  public def eq(value: Int): Predicate<T>
    return new Predicate<T>(this.name + " = ?", new ParameterList(Parameter.Int(value)))
  end

  ## Builds a greater-than predicate with one typed Int parameter.
  public def gt(value: Int): Predicate<T>
    return new Predicate<T>(this.name + " > ?", new ParameterList(Parameter.Int(value)))
  end

  ## Builds a greater-than-or-equal predicate with one typed Int parameter.
  public def gte(value: Int): Predicate<T>
    return new Predicate<T>(this.name + " >= ?", new ParameterList(Parameter.Int(value)))
  end

  ## Builds a less-than predicate with one typed Int parameter.
  public def lt(value: Int): Predicate<T>
    return new Predicate<T>(this.name + " < ?", new ParameterList(Parameter.Int(value)))
  end

  ## Builds a less-than-or-equal predicate with one typed Int parameter.
  public def lte(value: Int): Predicate<T>
    return new Predicate<T>(this.name + " <= ?", new ParameterList(Parameter.Int(value)))
  end
end

## A boolean field descriptor; nullable operators are intentionally absent.
class BoolField<T>
  private name: String

  internal def init(name: String): Void
    this.name = name
  end

  ## Builds an equality predicate with one typed Bool parameter.
  public def eq(value: Bool): Predicate<T>
    return new Predicate<T>(this.name + " = ?", new ParameterList(Parameter.Bool(value)))
  end
end

## A nonnullable text field descriptor.
class StringField<T>
  private name: String

  internal def init(name: String): Void
    this.name = name
  end

  ## Builds an equality predicate with one typed Text parameter.
  public def eq(value: String): Predicate<T>
    return new Predicate<T>(this.name + " = ?", new ParameterList(Parameter.Text(value)))
  end
end

## A nullable text descriptor with explicit null predicates.
class NullableStringField<T>
  private name: String

  internal def init(name: String): Void
    this.name = name
  end

  ## Builds a text equality predicate with one typed Text parameter.
  public def eq(value: String): Predicate<T>
    return new Predicate<T>(this.name + " = ?", new ParameterList(Parameter.Text(value)))
  end

  ## Builds an explicit SQL NULL predicate without a bound value.
  public def isNull(): Predicate<T>
    return new Predicate<T>(this.name + " IS NULL")
  end

  ## Builds an explicit non-NULL predicate without a bound value.
  public def isNotNull(): Predicate<T>
    return new Predicate<T>(this.name + " IS NOT NULL")
  end
end

def appendParameters(left: ParameterList?, right: ParameterList?): ParameterList?
  if left == null
    return right
  end
  return new ParameterList(left.rawValue(), appendParameters(left.tail(), right))
end

## A structured, non-executing plan snapshot; public fields are editable for inspection.
class QueryPlan
  public source: String
  public filter: String?
  public order: String?
  public projection: String?
  public parameters: ParameterList?

  internal def init(source: String, filter: String? = null, order: String? = null, projection: String? = null, parameters: ParameterList? = null): Void
    this.source = source
    this.filter = filter
    this.order = order
    this.projection = projection
    this.parameters = parameters
  end

  ## Returns SQL-shaped text with ? placeholders; it never executes a database call.
  public readonly def preview(): String
    var result = "SELECT * FROM " + this.source
    let projection = this.projection

    if projection != null
      result = "SELECT " + projection + " FROM " + this.source
    end
    let filter = this.filter

    if filter != null
      result = result + " WHERE " + filter
    end
    let order = this.order

    if order != null
      result = result + " ORDER BY " + order
    end
    return result
  end
end

## A typed, immutable-by-chaining query under construction.
class Query<T>
  private source: String
  private filter: String?
  private order: String?
  private parameters: ParameterList?

  internal def init(source: String, filter: String? = null, order: String? = null, parameters: ParameterList? = null): Void
    this.source = source
    this.filter = filter
    this.order = order
    this.parameters = parameters
  end

  ## Adds a typed predicate, conjoining it when where is called repeatedly.
  public def where(predicate: Predicate<T>): Query<T>
    let existing = this.filter
    let merged = appendParameters(this.parameters, predicate.parameterList())

    if existing != null
      return new Query<T>(this.source, existing + " AND " + predicate.preview(), this.order, merged)
    end
    return new Query<T>(this.source, predicate.preview(), this.order, merged)
  end

  ## Adds ordering from a field branded to this query's entity.
  public def orderBy(field: IntField<T>, descending: Bool = false): Query<T>
    var direction = " ASC"

    if descending
      direction = " DESC"
    end
    return new Query<T>(this.source, this.filter, field.preview() + direction, this.parameters)
  end

  ## Builds a plan preview only; this prototype has no database execution.
  public def compile(): QueryPlan
    return new QueryPlan(this.source, this.filter, this.order, null, this.parameters)
  end
end

## A known projection field branded to source and result types.
class ProjectionField<T, R>
  private name: String

  internal def init(name: String): Void
    this.name = name
  end

  ## Returns the known projection name used in a plan preview.
  public readonly def preview(): String
    return this.name
  end
end

## A typed projection produced by the module-level select function.
class Projection<T, R>
  private query: Query<T>
  private field: ProjectionField<T, R>

  internal def init(query: Query<T>, field: ProjectionField<T, R>): Void
    this.query = query
    this.field = field
  end

  ## Builds the projected plan preview without executing it.
  public def compile(): QueryPlan
    let base = this.query.compile()

    return new QueryPlan(base.source, base.filter, base.order, this.field.preview(), base.parameters)
  end
end

## A typed Customer-to-Order key/FK mapping fixture.
class Relation<Principal, Dependent>
  private mapping: String

  internal def init(mapping: String): Void
    this.mapping = mapping
  end

  ## Returns the known key/FK mapping preview.
  public readonly def preview(): String
    return this.mapping
  end
end

## Starts a typed query over Customer rows.
def customers(): Query<Customer>
  return new Query<Customer>("customers")
end

## Starts a typed query over Order rows.
def orders(): Query<Order>
  return new Query<Order>("orders")
end

## Returns the generated-style descriptor for Customer.id.
def customerId(): IntField<Customer>
  return new IntField<Customer>("customers.id")
end

## Returns the generated-style descriptor for nonnullable Customer.name.
def customerName(): StringField<Customer>
  return new StringField<Customer>("customers.name")
end

## Returns the generated-style descriptor for nonnullable Customer.active.
def customerActive(): BoolField<Customer>
  return new BoolField<Customer>("customers.active")
end

## Returns the generated-style descriptor for nullable Customer.nickname.
def customerNickname(): NullableStringField<Customer>
  return new NullableStringField<Customer>("customers.nickname")
end

## Returns the generated-style descriptor for Order.id.
def orderId(): IntField<Order>
  return new IntField<Order>("orders.id")
end

## Returns the generated-style descriptor for Order.customer_id.
def orderCustomerId(): IntField<Order>
  return new IntField<Order>("orders.customer_id")
end

## Returns the known Customer.name projection descriptor.
def customerNameProjection(): ProjectionField<Customer, String>
  return new ProjectionField<Customer, String>("customers.name")
end

## Applies a known typed projection; generic methods are unavailable in this prototype.
def select<T, R>(query: Query<T>, field: ProjectionField<T, R>): Projection<T, R>
  return new Projection<T, R>(query, field)
end

## Returns the Customer primary-key to Order foreign-key mapping fixture.
def customerOrders(): Relation<Customer, Order>
  return new Relation<Customer, Order>("orders.customer_id -> customers.id")
end
