use console

def main(): Void
  console::println("application main must be explicitly invoked")
end

def submission(previous: State?): State
  let counter = new Counter()
  let callback = new Box<fn(): Int>() do
    return counter.increment()
  end
  let state = new State(counter, callback)

  console::println("first: " + (state.callback.value() as String))
  return state
end
