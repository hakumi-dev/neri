{
  "version": 2,
  "defaultUnit": "probe",
  "units": {
    "state": {
      "kind": "library",
      "sources": ["state.hk"]
    },
    "first": {
      "kind": "executable",
      "sources": ["first.hk"],
      "references": ["state"]
    },
    "second": {
      "kind": "library",
