class Box<T>
  public value: T

  def init(value: T): Void
    this.value = value
  end
end

class Counter
  public value: Int = 0

  def increment(): Int
    this.value = this.value + 1
    return this.value
  end
end

class State
  public counter: Counter
  public alias: Counter
  public callback: Box<fn(): Int>

  def init(counter: Counter, callback: Box<fn(): Int>): Void
    this.counter = counter
    this.alias = counter
    this.callback = callback
  end
end
