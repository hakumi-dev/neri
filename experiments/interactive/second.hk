use console
use test

def submission(previous: State?): State
  if previous == null
    test::assertTrue(false)
    let counter = new Counter()
    let callback = new Box<fn(): Int>() do
      return counter.increment()
    end

    return new State(counter, callback)
  end
  let state = previous

  test::assertEqual(state.alias.value, 1)
  test::assertEqual(state.callback.value(), 2)
  test::assertEqual(state.counter.increment(), 3)
  test::assertEqual(state.alias.value, 3)
  console::println("second: same object, generic and closure survived collection")
  return state
end
