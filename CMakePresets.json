{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "native-debug",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "native-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "environment": {
        "PKG_CONFIG_PATH": "",
        "CPPFLAGS": "",
        "LDFLAGS": "",
        "LIBRARY_PATH": "",
        "LD_LIBRARY_PATH": ""
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "LLVM_DIR": "/usr/lib/llvm-22/lib/cmake/llvm",
        "PKG_CONFIG_EXECUTABLE": "/usr/bin/pkg-config",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "linux-debug",
      "inherits": ["linux-base", "native-debug"]
    },
    {
      "name": "linux-release",
      "inherits": ["linux-base", "native-release"]
    },
    {
      "name": "linux-sanitize",
      "inherits": "linux-debug",
      "cacheVariables": { "NERI_SANITIZERS": true }
    },
    {
      "name": "linux-thread-sanitize",
      "inherits": "linux-debug",
      "cacheVariables": { "NERI_THREAD_SANITIZER": true }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" },
    { "name": "linux-thread-sanitize", "configurePreset": "linux-thread-sanitize" }
  ],
  "testPresets": [
    {
      "name": "linux-debug", "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-release", "configurePreset": "linux-release",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-sanitize", "configurePreset": "linux-sanitize",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-thread-sanitize", "configurePreset": "linux-thread-sanitize",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
