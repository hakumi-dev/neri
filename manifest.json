{
  "version": 2,
  "defaultUnit": "compiler",
  "units": {
    "process": {
      "kind": "library",
      "sources": [
        "compiler/ir/process.hk"
      ]
    },
    "compiler-core": {
      "kind": "library",
      "sources": [
        "compiler"
      ],
      "exclude": [
        "compiler/ir/main.hk",
        "compiler/frontend/main.hk",
        "compiler/semantic/main.hk",
        "compiler/session",
        "compiler/ir/process.hk"
      ],
      "references": [
        "process"
      ]
    },
    "session": {
      "kind": "library",
      "sources": [
        "compiler/session"
      ],
      "exclude": [
        "compiler/session/terminal_main.hk"
      ],
      "references": [
        "compiler-core"
      ]
    },
    "compiler": {
      "kind": "executable",
      "sources": [
        "compiler/ir/main.hk"
      ],
      "references": [
        "compiler-core"
      ]
    },
    "session-console": {
      "kind": "executable",
      "sources": [
        "compiler/session/terminal_main.hk"
      ],
      "references": [
        "session"
      ]
    },
    "frontend": {
      "kind": "executable",
      "sources": [
        "compiler/frontend/main.hk"
      ],
      "references": [
        "compiler-core"
      ]
    },
    "semantic": {
      "kind": "executable",
      "sources": [
        "compiler/semantic/main.hk"
      ],
      "references": [
        "compiler-core"
      ]
    },
    "tooling": {
      "kind": "library",
      "sources": [
        "tooling"
      ],
      "exclude": [
        "tooling/build.hk",
        "tooling/install.hk",
        "tooling/seed.hk"
      ],
      "references": [
        "process"
      ]
    },
    "build": {
      "kind": "executable",
      "sources": [
        "tooling/build.hk",
        "tooling/seed.hk"
      ],
      "references": [
        "tooling"
      ]
    },
    "lsp-contracts": {
      "kind": "executable",
      "sources": [
        "tests/lsp-server-manifest-contract.hk"
      ],
      "references": [
        "compiler-core"
      ]
    },
    "session-contracts": {
      "kind": "executable",
      "sources": [
        "tests/session-contracts"
      ],
      "references": [
        "session"
      ]
    },
    "install": {
      "kind": "executable",
      "sources": [
        "tooling/install.hk"
      ],
      "references": [
        "tooling"
      ]
    }
  }
}
