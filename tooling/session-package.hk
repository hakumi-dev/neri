use console
use host

# Publish only the selected library and its same-project library dependencies.
# Definitions are rendered from the validated root manifest without maintaining
# a second copy of their sources, exclusions, or references.
def sessionPackageManifest(path: String, selectedUnit: String): String?
  let text = host::readText(path)

  if text == null
    console::println("Cannot read package source manifest: " + path)
    return null
  end
  let parser = new LspJsonParser(text)
  let project = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(text) || !project.isObject()
    console::println("Package source manifest must contain one JSON object.")
    return null
  end
  let units = project.get("units")

  if !units.isObject() || !project.get("version").isNumber() || project.get("version").scalarText() != "2"
    console::println("Package source manifest must be a version 2 project.")
    return null
  end
  let selected = new StringTable<Bool>()
  let pending = new StringBuffer()

  pending.add(selectedUnit)
  var index = 0

  while index < pending.size
    let name = pending.get(index)

    if selected.find(name) == null
      let definition = units.get(name)

      if !definition.isObject() || !projectUnitIsLibrary(projectUnitKindFromJson(definition.get("kind")))
        console::println("Package unit must be a same-project library: " + name)
        return null
      end
      selected.add(name, true)
      var reference = definition.get("references").first

      while reference != null
        if !reference.isString()
          console::println("Package unit has an external reference: " + name)
          return null
        end
        pending.add(reference.scalarText())
        reference = reference.next
      end
    end
    index = index + 1
  end
  let validated = neriLoadProject(path, selectedUnit)

  if validated.error() != ""
    console::println(validated.error())
    return null
  end
  let output = new StringBuffer()

  output.add("{\"version\":2,\"defaultUnit\":" + lspQuote(selectedUnit) + ",\"units\":{")
  var definition = units.first
  var separator = ""

  while definition != null
    if selected.find(definition.key) != null
      output.add(separator + lspQuote(definition.key) + ":" + lspJsonStringify(definition))
      separator = ","
    end
    definition = definition.next
  end
  output.add("}}\n")
  return output.join()
end

def main(): Void
  let manifest = host::argumentAt(0)
  let unit = host::argumentAt(1)
  let output = host::argumentAt(2)

  if host::argumentCount() != 3 || manifest == null || unit == null || output == null || unit == ""
    console::println("Usage: neri-session-package <manifest.json> <library-unit> <output.json>")
    host::exit(2)
    return
  end
  let generated = sessionPackageManifest(manifest, unit)

  if generated == null || !host::writeText(output, generated)
    console::println("Cannot write package manifest: " + output) if generated != null
    host::exit(2)
  end
end
