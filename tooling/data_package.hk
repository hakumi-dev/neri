use result

def dataPackageField(value: json::Value, key: String): json::Value
  let field = value.get(key)

  if field == null
    fail("Data package manifest is missing " + key)
    return json::Value.nullValue()
  end
  return field
end

def dataPackageUnit(path: String, name: String): json::Value
  match json::parse(requiredText(path))
    case result::Result.Ok(value)
      let unit = dataPackageField(dataPackageField(value, "units"), name)

      if dataPackageField(unit, "kind").text() != "library"
        fail("Data package unit must be a library: " + name)
      end
      return unit
    case result::Result.Error(error)
      fail("Cannot parse Data package manifest: " + path)
  end
  return json::Value.nullValue()
end

def dataPackageSources(unit: json::Value): String[]
  let sources = dataPackageField(unit, "sources")
  var files: String[] = []

  if sources.kind() != "array" || sources.count() == 0
    fail("Data package sources must be a nonempty file inventory")
  end
  var index = 0

  while index < sources.count()
    let entry = sources.at(index)

    if entry != null
      let path = entry.text()

      if entry.kind() != "string" || path == null
        fail("Data package source must be a string")
      else
        if !endsWith(path, ".hk") || bytesEqualAt(path, "/", 0) || bytesEqualAt(path, "./", 0) || contains(
          path,
          "//"
        ) || contains(path, "/./") || contains(path, "\\") || contains(path, ":") || contains(path, "..")
          fail("Data package source must name a relative .hk file: " + path)
        end
        files = host::appendString(files, path)
      end
    end
    index = index + 1
  end
  return files
end

def dataPackageLibrary(unit: json::Value, files: String[], prefix: String, externalRuntime: Bool = false): json::Value
  let value = json::Value.object()
  let sources = json::Value.array()

  for file in files
    sources.add(json::Value.string(prefix + file))
  end
  value.put("sources", sources)
  let references = unit.get("references")
  let provider = prefix != "" || externalRuntime

  if provider
    if references == null || references.kind() != "array" || references.count() != 1
      fail("Data provider package must reference exactly one runtime unit")
    else
      let reference = references.at(0)

      if reference == null || dataPackageField(
        reference,
        "project"
      ).text() != "../../manifest.json" || dataPackageField(
        reference,
        "unit"
      ).text() != "runtime"
        fail("Data package reference must resolve to its runtime unit")
      end
    end
    let local = json::Value.array()

    local.add(json::Value.string("runtime")) if !externalRuntime
    value.put("references", local)
  else
    fail("Data runtime package cannot reference other units") if references != null
  end
  return value
end

def dataPackageJson(value: json::Value): String
  match json::stringify(value)
    case result::Result.Ok(text)
      return text + "\n"
    case result::Result.Error(error)
      fail("Cannot serialize Data package JSON")
  end
  return ""
end

def dataPackageInstalledManifest(name: String, unit: json::Value, runtimeProject: String): String
  let version = json::Value.number("2")
  let manifest = json::Value.object()
  let units = json::Value.object()
  let library = json::Value.object()
  let references = json::Value.array()
  let reference = json::Value.object()

  if version == null
    fail("Cannot encode Data project version")
    return ""
  end
  reference.put("project", json::Value.string(runtimeProject))
  reference.put("unit", json::Value.string("runtime"))
  references.add(reference)
  library.put("kind", dataPackageField(unit, "kind"))
  library.put("sources", dataPackageField(unit, "sources"))
  library.put("references", references)
  units.put(name, library)
  manifest.put("version", version)
  manifest.put("defaultUnit", json::Value.string(name))
  manifest.put("units", units)
  return dataPackageJson(manifest)
end

def dataPackageDocument(
  name: String,
  version: String,
  units: json::Value,
  exports: json::Value,
  dependencies: json::Value
): String
  let package = json::Value.object()
  let neri = json::Value.object()

  neri.put("units", units)
  neri.put("exports", exports)
  package.put("name", json::Value.string(name))
  package.put("version", json::Value.string(version))
  package.put("dependencies", dependencies)
  package.put("neri", neri)
  return dataPackageJson(package)
end

def dataPackageMetadata(version: String, runtime: json::Value, sqlite: json::Value): String
  let units = json::Value.object()
  let exports = json::Value.array()

  units.put("runtime", runtime)
  units.put("sqlite", sqlite)
  exports.add(json::Value.string("runtime"))
  exports.add(json::Value.string("sqlite"))
  return dataPackageDocument("neri-data", version, units, exports, json::Value.object())
end

def dataPackagePostgresqlMetadata(version: String, postgresql: json::Value): String
  let units = json::Value.object()
  let exports = json::Value.array()
  let dependencies = json::Value.object()
  let runtime = json::Value.object()

  units.put("postgresql", postgresql)
  exports.add(json::Value.string("postgresql"))
  runtime.put("path", json::Value.string("../data"))
  dependencies.put("neri-data", runtime)
  return dataPackageDocument("neri-data-postgresql", version, units, exports, dependencies)
end
