{
  "version": 2,
  "defaultUnit": "session",
  "units": {
    "process": {
      "kind": "library",
      "sources": ["compiler/ir/process.hk"]
    },
    "compiler-core": {
      "kind": "library",
      "sources": ["compiler"],
      "exclude": [
        "compiler/ir/main.hk",
        "compiler/ir/batch_cli.hk",
        "compiler/frontend/main.hk",
        "compiler/semantic/main.hk",
        "compiler/session",
        "compiler/ir/process.hk"
      ],
      "references": ["process"]
    },
    "session": {
      "kind": "library",
      "sources": ["compiler/session"],
      "exclude": ["compiler/session/terminal_main.hk"],
      "references": ["compiler-core"]
    }
  }
}
