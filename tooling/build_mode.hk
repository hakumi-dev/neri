sealed class BuildMode
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def release(): BuildMode
    return new BuildMode(0)
  end

  static def debug(): BuildMode
    return new BuildMode(1)
  end

  static def fromOption(option: String): BuildMode?
    return BuildMode.debug() if option == "--debug"
    return new BuildMode(2) if option == "--sanitize"
    return new BuildMode(3) if option == "--thread-sanitize"
    return null
  end

  readonly def isRelease(): Bool
    return this.tag == 0
  end

  readonly def isSanitize(): Bool
    return this.tag == 2
  end

  readonly def isThreadSanitize(): Bool
    return this.tag == 3
  end

  readonly def usesSanitizer(): Bool
    return this.isSanitize() || this.isThreadSanitize()
  end

  readonly def name(): String
    return "release" if this.isRelease()
    return "sanitize" if this.isSanitize()
    return "thread-sanitize" if this.isThreadSanitize()
    return "debug"
  end

  readonly def cmakeBuildType(): String
    return this.isRelease() ? "Release" : "Debug"
  end
end
