def tokenDefinitions(): TokenDefinition[]
  return [
    new TokenDefinition("Invalid"),
    new TokenDefinition("Amp", "&", false, 0, 30),
    new TokenDefinition("AmpAmp", "&&", false, 3),
    new TokenDefinition("As", "as", true, 25),
    new TokenDefinition("At", "@"),
    new TokenDefinition("BadToken"),
    new TokenDefinition("Bang", "!", false, 0, 30),
    new TokenDefinition("BangEqual", "!=", false, 6),
    new TokenDefinition("Borrow", "borrow", true),
    new TokenDefinition("Break", "break", true),
    new TokenDefinition("Case", "case", true),
    new TokenDefinition("Class", "class", true),
    new TokenDefinition("Colon", ":"),
    new TokenDefinition("Comma", ","),
    new TokenDefinition("Continue", "continue", true),
    new TokenDefinition("Def", "def", true),
    new TokenDefinition("Do", "do", true),
    new TokenDefinition("Dot", "."),
    new TokenDefinition("DoubleColon", "::"),
    new TokenDefinition("Else", "else", true),
    new TokenDefinition("End", "end", true),
    new TokenDefinition("EndOfFile"),
    new TokenDefinition("Enum", "enum", true),
    new TokenDefinition("Equal", "="),
    new TokenDefinition("EqualEqual", "==", false, 6),
    new TokenDefinition("False", "false", true),
    new TokenDefinition("FloatLiteral"),
    new TokenDefinition("Fn", "fn", true),
    new TokenDefinition("For", "for", true),
    new TokenDefinition("Greater", ">", false, 5),
    new TokenDefinition("GreaterEqual", ">=", false, 5),
    new TokenDefinition("Identifier"),
    new TokenDefinition("If", "if", true),
    new TokenDefinition("In", "in", true),
    new TokenDefinition("IntLiteral"),
    new TokenDefinition("Internal", "internal", true),
    new TokenDefinition("LBracket", "["),
    new TokenDefinition("LParen", "("),
    new TokenDefinition("Less", "<", false, 5),
    new TokenDefinition("LessEqual", "<=", false, 5),
    new TokenDefinition("Let", "let", true),
    new TokenDefinition("Match", "match", true),
    new TokenDefinition("Minus", "-", false, 10, 30),
    new TokenDefinition("Namespace", "namespace", true),
    new TokenDefinition("Native", "native", true),
    new TokenDefinition("New", "new", true),
    new TokenDefinition("NewLine", "\n"),
    new TokenDefinition("Null", "null", true),
    new TokenDefinition("Pipe", "|"),
    new TokenDefinition("PipePipe", "||", false, 2),
    new TokenDefinition("Plus", "+", false, 10, 30),
    new TokenDefinition("Private", "private", true),
    new TokenDefinition("Protected", "protected", true),
    new TokenDefinition("Public", "public", true),
    new TokenDefinition("Question", "?"),
    new TokenDefinition("RBracket", "]"),
    new TokenDefinition("RParen", ")"),
    new TokenDefinition("Resource", "resource", true),
    new TokenDefinition("Return", "return", true),
    new TokenDefinition("Slash", "/", false, 20),
    new TokenDefinition("Stackalloc", "stackalloc", true),
    new TokenDefinition("Star", "*", false, 20, 30),
    new TokenDefinition("Static", "static", true),
    new TokenDefinition("StringLiteral"),
    new TokenDefinition("Struct", "struct", true),
    new TokenDefinition("Super", "super", true),
    new TokenDefinition("This", "this", true),
    new TokenDefinition("Transfer", "transfer", true),
    new TokenDefinition("True", "true", true),
    new TokenDefinition("Union", "union", true),
    new TokenDefinition("Unsafe", "unsafe", true),
    new TokenDefinition("Use", "use", true),
    new TokenDefinition("Using", "using", true),
    new TokenDefinition("Var", "var", true),
    new TokenDefinition("While", "while", true)
  ]
end
