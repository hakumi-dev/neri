class TokenDefinition
  public name: String
  public spelling: String
  public keyword: Bool
  public binaryPrecedence: Int
  public unaryPrecedence: Int

  def init(name: String, spelling: String = "", keyword: Bool = false, binaryPrecedence: Int = 0, unaryPrecedence: Int = 0): Void
    this.name = name
    this.spelling = spelling
    this.keyword = keyword
    this.binaryPrecedence = binaryPrecedence
    this.unaryPrecedence = unaryPrecedence
  end
end
