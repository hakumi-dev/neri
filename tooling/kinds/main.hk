use host
use console

def tokenKinds(): String[]
  var names: String[] = []

  for token in tokenDefinitions()
    names = host::appendString(names, token.name)
  end
  return names
end

def quoted(value: String): String
  var result = "\""
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    if byte == 10
      result = result + "\\n"
    else if byte == 34
      result = result + "\\\""
    else if byte == 92
      result = result + "\\\\"
    else
      result = result + host::stringSlice(value, index, 1)
    end
    index = index + 1
  end
  return result + "\""
end

def syntaxKinds(): String[]
  return ["Invalid", "AlternativeBinding", "AlternativeCase", "ArrayLiteral", "Assignment", "Binary", "BoolLiteral", "BorrowBlock", "Break", "Call", "Cast", "Class", "Closure", "Continue", "Contract", "ExpressionStatement", "Field", "FloatLiteral", "For", "Function", "FunctionAnnotation", "If", "Index", "IntLiteral", "Let", "Match", "MatchCase", "Member", "Method", "MissingExpression", "Modifier", "Name", "NamedArgument", "Namespace", "NativeField", "NativeIntrinsic", "New", "NullLiteral", "Parameter", "Program", "QualifiedName", "QuoteExpression", "Return", "StackAlloc", "StringLiteral", "Struct", "Super", "SuperConstructorCall", "Ternary", "This", "Transfer", "Type", "Unary", "Union", "UnsafeBlock", "Use", "UsingBlock", "Var", "While"]
end

def boundKinds(): String[]
  return ["Invalid", "AlternativeConstruct", "Argument", "ArrayLiteral", "Assignment", "BaseCall", "Binary", "BoolLiteral", "BorrowBlock", "Break", "CCall", "CFunction", "Call", "Cast", "Closure", "Continue", "ErrorExpression", "ErrorStatement", "ExpressionStatement", "FieldPack", "FieldPackArgument", "FloatLiteral", "For", "Function", "If", "Index", "InstanceCall", "IntLiteral", "IntrinsicMember", "Let", "Match", "MatchBinding", "MatchCase", "Member", "Name", "NativeField", "NativeIndex", "NativeIntrinsic", "New", "NullLiteral", "Quotation", "Return", "StackAlloc", "StringLiteral", "SuperConstructorCall", "TaskGenerate", "Ternary", "This", "Transfer", "Unary", "UnsafeBlock", "UsingBlock", "Var", "While"]
end

def write(path: String, content: String, check: Bool): Void
  let current = host::readText(path)

  if check
    if current == null || current != content
      console::println("Generated kind declaration is stale: " + path)
      host::exit(1)
    end
    return
  end
  if (current == null || current != content) && !host::writeText(path, content)
    console::println("Cannot write " + path)
    host::exit(1)
  end
end

def validate(names: String[], displayNames: String[]): Void
  if names.Length == 0 || (displayNames.Length != 0 && displayNames.Length != names.Length)
    console::println("Kind catalog requires names and matching display metadata.")
    host::exit(1)
  end
  var index = 0

  for name in names
    var position = 0

    if name == ""
      console::println("Kind names must be canonical ASCII identifiers.")
      host::exit(1)
    end
    while position < host::stringByteLength(name)
      let code = host::stringByteAt(name, position) as Int
      let letter = code >= 65 && code <= 90 || code >= 97 && code <= 122

      if (position == 0 && !(code >= 65 && code <= 90)) || (!letter && !(position > 0 && code >= 48 && code <= 57))
        console::println("Invalid kind identifier: " + name)
        host::exit(1)
      end
      position = position + 1
    end
    var previous = 0

    while previous < index
      if names[previous] == name || (displayNames.Length != 0 && displayNames[previous] == displayNames[index])
        console::println("Duplicate kind name or spelling: " + name)
        host::exit(1)
      end
      previous = previous + 1
    end
    index = index + 1
  end
end

def emit(root: String, directory: String, stem: String, typeName: String, names: String[], check: Bool, displayNames: String[] = [], recognizeSource: Bool = false, tokens: TokenDefinition[] = []): Void
  validate(names, displayNames)
  if tokens.Length != 0 && tokens.Length != names.Length
    console::println("Token metadata must cover the entire token domain.")
    host::exit(1)
  end
  var tokenIndex = 0

  for token in tokens
    if token.name != names[tokenIndex] || token.binaryPrecedence < 0 || token.unaryPrecedence < 0 || (token.keyword && token.spelling == "")
      console::println("Invalid token metadata: " + token.name)
      host::exit(1)
    end
    var previous = 0

    while previous < tokenIndex
      if token.spelling != "" && token.spelling == tokens[previous].spelling
        console::println("Duplicate token spelling: " + token.spelling)
        host::exit(1)
      end
      previous = previous + 1
    end
    tokenIndex = tokenIndex + 1
  end
  let header = "# Generated by tooling/kinds/main.hk. Edit the domain catalog there.\n"
  let tokenFields = tokens.Length == 0 ? "" : "  private spelling: String\n  private binaryRank: Int\n  private unaryRank: Int\n"
  let tokenParameters = tokens.Length == 0 ? "" : ", spelling: String, binaryRank: Int, unaryRank: Int"
  let tokenAssignments = tokens.Length == 0 ? "" : "    this.spelling = spelling\n    this.binaryRank = binaryRank\n    this.unaryRank = unaryRank\n"
  var kind = header + "sealed class " + typeName + "\n  private tag: Int\n  private display: String\n" + tokenFields + "\n  private def init(tag: Int, display: String" + tokenParameters + "): Void\n    this.tag = tag\n    this.display = display\n" + tokenAssignments + "  end\n\n  readonly def same(other: readonly " + typeName + "): Bool\n    return this.tag == other.tag\n  end\n\n  readonly def name(): String\n    return this.display\n  end\n\n  static def createCatalog(): " + typeName + "[]\n    return ["
  var catalog = header + "sealed class " + typeName + "Catalog\n  private values: " + typeName + "[] = " + typeName + ".createCatalog()\n"
  var index = 0

  for name in names
    let display = displayNames.Length == 0 ? (name == "Invalid" ? "" : name) : displayNames[index]

    var tokenArguments = ""

    if tokens.Length != 0
      let token = tokens[index]

      tokenArguments = ", " + quoted(token.spelling) + ", " + (token.binaryPrecedence as String) + ", " + (token.unaryPrecedence as String)
    end
    kind = kind + (index == 0 ? "" : ", ") + "new " + typeName + "(" + (index as String) + ", \"" + display + "\"" + tokenArguments + ")"
    catalog = catalog + "\n  readonly def get" + name + "(): readonly " + typeName + "\n    return this.values[" + (index as String) + "]\n  end\n"
    index = index + 1
  end
  kind = kind + "]\n  end\n"
  index = 0
  for name in names
    kind = kind + "\n  readonly def is" + name + "(): Bool\n    return this.tag == " + (index as String) + "\n  end\n"
    index = index + 1
  end
  if recognizeSource
    catalog = catalog + "\n  readonly def recognizeSource(value: String): readonly " + typeName + "\n"
    index = 1
    while index < names.Length
      catalog = catalog + "    if value == \"" + displayNames[index] + "\"\n      return this.get" + names[index] + "()\n    end\n"
      index = index + 1
    end
    catalog = catalog + "    return this.get" + names[0] + "()\n  end\n"
  end
  if tokens.Length != 0
    kind = kind + "\n  readonly def fixedText(): String\n    return this.spelling\n  end\n\n  readonly def binaryPrecedence(): Int\n    return this.binaryRank\n  end\n\n  readonly def unaryPrecedence(): Int\n    return this.unaryRank\n  end\n"
    catalog = catalog + "\n  readonly def recognizeKeyword(value: String): readonly TokenKind\n"
    for token in tokens
      if token.keyword
        catalog = catalog + "    if value == " + quoted(token.spelling) + "\n      return this.get" + token.name + "()\n    end\n"
      end
    end
    catalog = catalog + "    return this.getIdentifier()\n  end\n"
  end
  write(root + "/" + directory + "/" + stem + ".hk", kind + "end\n", check)
  write(root + "/" + directory + "/" + stem + "_catalog.hk", catalog + "end\n", check)
end

def main(): Void
  let mode = host::argumentAt(0)
  let root = host::argumentAt(1)

  if root == null || mode == null || host::argumentCount() != 2 || (mode != "--write" && mode != "--check")
    console::println("usage: kind-generator --write|--check <repository-root>")
    host::exit(1)
    return
  end
  let check = mode == "--check"

  emit(root, "compiler/frontend", "token_kind", "TokenKind", tokenKinds(), check, [], false, tokenDefinitions())
  emit(root, "compiler/frontend", "syntax_kind", "SyntaxKind", syntaxKinds(), check)
  emit(root, "compiler/semantic", "bound_kind", "BoundKind", boundKinds(), check)
  emit(root, "compiler/frontend", "parameter_mode", "ParameterMode", ["Ordinary", "Labels"], check, ["ordinary", "labels"])
  emit(root, "compiler/frontend", "annotation_kind", "AnnotationKind", ["Unknown", "Representation", "Operator", "Conversion", "Intrinsic", "Exact", "CabiImport", "CabiExport", "Library", "Operation"], check, ["", "representation", "operator", "conversion", "intrinsic", "exact", "cabiImport", "cabiExport", "library", "operation"], true)
  emit(root, "compiler/frontend", "modifier_kind", "ModifierKind", ["Unknown", "Public", "Protected", "Internal", "Private", "Abstract", "Sealed", "Override", "Static", "Readonly", "Unsafe", "Resource"], check, ["", "public", "protected", "internal", "private", "abstract", "sealed", "override", "static", "readonly", "unsafe", "resource"], true)
  emit(root, "compiler/frontend", "source_access", "SourceAccess", ["Public", "Protected", "Internal", "Private"], check, ["public", "protected", "internal", "private"])
end
