
def tokenKinds(): String[]
  var names: String[] = []

  for token in tokenDefinitions()
    names = host::appendString(names, token.name)
  end
  return names
end

def quoted(value: String): String
  var result = "\""
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    if byte == 10
      result = result + "\\n"
    else if byte == 34
      result = result + "\\\""
    else if byte == 92
      result = result + "\\\\"
    else
      result = result + host::stringSlice(value, index, 1)
    end
    index = index + 1
  end
  return result + "\""
end

def syntaxKinds(root: String): String[]
  return declaredKinds(root + "/tooling/kinds/syntax_kind_definition.hk", "SyntaxKindDefinition")
end

def boundKinds(root: String): String[]
  return declaredKinds(root + "/tooling/kinds/bound_kind_definition.hk", "BoundKindDefinition")
end

def write(path: String, content: String, check: Bool): Void
  let current = host::readText(path)

  if check
    if current == null || current != content
      console::println("Generated kind declaration is stale: " + path)
      host::exit(1)
    end
    return
  end
  if (current == null || current != content) && !host::writeText(path, content)
    console::println("Cannot write " + path)
    host::exit(1)
  end
end

def validate(names: String[], displayNames: String[]): Void
  if names.Length == 0 || (displayNames.Length != 0 && displayNames.Length != names.Length)
    console::println("Kind catalog requires names and matching display metadata.")
    host::exit(1)
  end
  var index = 0

  for name in names
    var position = 0

    if name == ""
      console::println("Kind names must be canonical ASCII identifiers.")
      host::exit(1)
    end
    while position < host::stringByteLength(name)
      let code = host::stringByteAt(name, position) as Int
      let letter = code >= 65 && code <= 90 || code >= 97 && code <= 122

      if (position == 0 && !(code >= 65 && code <= 90)) || (!letter && !(position > 0 && code >= 48 && code <= 57))
        console::println("Invalid kind identifier: " + name)
        host::exit(1)
      end
      position = position + 1
    end
    var previous = 0

    while previous < index
      if names[previous] == name || (displayNames.Length != 0 && displayNames[previous] == displayNames[index])
        console::println("Duplicate kind name or spelling: " + name)
        host::exit(1)
      end
      previous = previous + 1
    end
    index = index + 1
  end
end

def emit(
  root: String,
  directory: String,
  stem: String,
  typeName: String,
  names: String[],
  check: Bool,
  displayNames: String[] = [],
  recognizeSource: Bool = false,
  tokens: TokenDefinition[] = []
): Void
  validate(names, displayNames)
  if tokens.Length != 0 && tokens.Length != names.Length
    console::println("Token metadata must cover the entire token domain.")
    host::exit(1)
  end
  var tokenIndex = 0

  for token in tokens
    if token.name != names[tokenIndex] || token.binaryPrecedence < 0 || token.unaryPrecedence < 0 || (token.keyword && token.spelling == "")
      console::println("Invalid token metadata: " + token.name)
      host::exit(1)
    end
    var previous = 0

    while previous < tokenIndex
      if token.spelling != "" && token.spelling == tokens[previous].spelling
        console::println("Duplicate token spelling: " + token.spelling)
        host::exit(1)
      end
      previous = previous + 1
    end
    tokenIndex = tokenIndex + 1
  end
  let header = "# Generated by tooling/kinds/main.hk. Edit the domain catalog there.\n"
  let tokenFields = tokens.Length == 0 ? "" : "  private spelling: String\n  private binaryRank: Int\n  private unaryRank: Int\n"
  let tokenParameters = tokens.Length == 0 ? "" : ", spelling: String, binaryRank: Int, unaryRank: Int"
  let tokenAssignments = tokens.Length == 0 ? "" : "    this.spelling = spelling\n    this.binaryRank = binaryRank\n    this.unaryRank = unaryRank\n"
  var kind = header + "sealed class " + typeName + "\n"

  kind = kind + "  private tag: Int\n  private display: String\n" + tokenFields
  kind = kind + "\n  def init(tag: Int, display: String" + tokenParameters + "): Void\n"
  kind = kind + "    this.tag = tag\n    this.display = display\n" + tokenAssignments + "  end\n"
  kind = kind + "\n  readonly def same(other: readonly " + typeName + "): Bool\n"
  kind = kind + "    return this.tag == other.tag\n  end\n"
  kind = kind + "\n  readonly def name(): String\n    return this.display\n  end\n"
  var catalog = header + "sealed class " + typeName + "Catalog\n"

  catalog = catalog + "  static def createCatalog(): " + typeName + "[]\n"
  catalog = catalog + "    return (new " + typeName + "Catalog()).values\n  end\n\n"
  var values = "  private values: " + typeName + "[] = [\n"
  var accessors = ""
  var index = 0

  for name in names
    let display = displayNames.Length == 0 ? (name == "Invalid" ? "" : name) : displayNames[index]

    var tokenArguments = ""

    if tokens.Length != 0
      let token = tokens[index]

      tokenArguments = ", " + quoted(token.spelling) + ", " + (token.binaryPrecedence as String) + ", " + (token.unaryPrecedence as String)
    end
    values = values + "    new " + typeName + "(" + (index as String) + ", " + quoted(display) + tokenArguments + ")"
    values = values + (index + 1 == names.Length ? "\n" : ",\n")
    accessors = accessors + "\n  readonly def get" + name + "(): readonly " + typeName + "\n"
    accessors = accessors + "    return this.values[" + (index as String) + "]\n  end\n"
    index = index + 1
  end
  catalog = catalog + values + "  ]\n" + accessors
  index = 0
  for name in names
    kind = kind + "\n  readonly def is" + name + "(): Bool\n    return this.tag == " + (index as String) + "\n  end\n"
    index = index + 1
  end
  if recognizeSource
    catalog = catalog + "\n  readonly def recognizeSource(value: String): readonly " + typeName + "\n"
    index = 1
    while index < names.Length
      catalog = catalog + "    if value == \"" + displayNames[index] + "\"\n      return this.get" + names[index] + "()\n    end\n"
      index = index + 1
    end
    catalog = catalog + "    return this.get" + names[0] + "()\n  end\n"
  end
  if tokens.Length != 0
    kind = kind + "\n  readonly def fixedText(): String\n    return this.spelling\n  end\n\n  readonly def binaryPrecedence(): Int\n    return this.binaryRank\n  end\n\n  readonly def unaryPrecedence(): Int\n    return this.unaryRank\n  end\n"
    catalog = catalog + "\n  readonly def recognizeKeyword(value: String): readonly TokenKind\n"
    for token in tokens
      if token.keyword
        catalog = catalog + "    if value == " + quoted(token.spelling) + "\n      return this.get" + token.name + "()\n    end\n"
      end
    end
    catalog = catalog + "    return this.getIdentifier()\n  end\n"
  end
  write(root + "/" + directory + "/" + stem + ".hk", kind + "end\n", check)
  write(root + "/" + directory + "/" + stem + "_catalog.hk", catalog + "end\n", check)
end

def main(): Void
  let mode = host::argumentAt(0)
  let root = host::argumentAt(1)

  if root == null || mode == null || host::argumentCount() != 2 || (mode != "--write" && mode != "--check")
    console::println("usage: kind-generator --write|--check <repository-root>")
    host::exit(1)
    return
  end
  let check = mode == "--check"

  emit(root, "compiler/frontend", "token_kind", "TokenKind", tokenKinds(), check, [], false, tokenDefinitions())
  emit(root, "compiler/frontend", "syntax_kind", "SyntaxKind", syntaxKinds(root), check)
  emit(root, "compiler/semantic", "bound_kind", "BoundKind", boundKinds(root), check)
  emit(
    root,
    "compiler/frontend",
    "parameter_mode",
    "ParameterMode",
    ["Ordinary", "Labels"],
    check,
    ["ordinary", "labels"]
  )
  emit(
    root,
    "compiler/frontend",
    "annotation_kind",
    "AnnotationKind",
    [
      "Unknown",
      "Representation",
      "Operator",
      "Conversion",
      "Intrinsic",
      "Exact",
      "CabiImport",
      "CabiExport",
      "Library",
      "Operation",
      "Propagation"
    ],
    check,
    [
      "",
      "representation",
      "operator",
      "conversion",
      "intrinsic",
      "exact",
      "cabiImport",
      "cabiExport",
      "library",
      "operation",
      "propagation"
    ],
    true
  )
  emit(
    root,
    "compiler/frontend",
    "modifier_kind",
    "ModifierKind",
    [
      "Unknown",
      "Public",
      "Protected",
      "Internal",
      "Private",
      "Abstract",
      "Sealed",
      "Override",
      "Static",
      "Readonly",
      "Unsafe",
      "Resource"
    ],
    check,
    [
      "",
      "public",
      "protected",
      "internal",
      "private",
      "abstract",
      "sealed",
      "override",
      "static",
      "readonly",
      "unsafe",
      "resource"
    ],
    true
  )
  emit(
    root,
    "compiler/frontend",
    "contextual_role",
    "ContextualRole",
    ["Unknown", "Readonly", "Fields", "Of", "Shared", "Parallel", "Quote", "Cabi", "Labels", "Contract"],
    check,
    ["", "readonly", "fields", "of", "shared", "parallel", "quote", "cabi", "labels", "contract"],
    true
  )
  emit(
    root,
    "compiler/frontend",
    "block_kind",
    "BlockKind",
    [
      "Function",
      "Type",
      "Contract",
      "NativeRecord",
      "Match",
      "MatchCase",
      "If",
      "Else",
      "While",
      "For",
      "Unsafe",
      "Borrow",
      "Using",
      "Closure"
    ],
    check
  )
  emit(
    root,
    "compiler/frontend",
    "type_syntax_kind",
    "TypeSyntaxKind",
    ["Absent", "Nominal", "Grouped", "Readonly", "Fields", "Function", "Resolved", "Inferred", "Error"],
    check
  )
  emit(
    root,
    "compiler/frontend",
    "function_type_flavor",
    "FunctionTypeFlavor",
    ["Ordinary", "Shared", "Parallel", "Quotation", "CAbi"],
    check
  )
  emit(
    root,
    "compiler/frontend",
    "type_suffix_kind",
    "TypeSuffixKind",
    ["ManagedArray", "FixedArray", "Optional", "Pointer"],
    check
  )
  emit(
    root,
    "compiler/frontend",
    "source_access",
    "SourceAccess",
    ["Public", "Protected", "Internal", "Private"],
    check,
    ["public", "protected", "internal", "private"]
  )
end
