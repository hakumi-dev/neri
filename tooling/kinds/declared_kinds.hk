
def declaredKinds(path: String, name: String): String[]
  let text = host::readText(path)

  if text == null
    console::println("Cannot read kind definition: " + path)
    host::exit(1)
    return []
  end
  let parser = new BootstrapParser(new BootstrapLexer(text).lex())

  parser.parseProgram()
  if parser.diagnostics.count() != 0
    console::println("Invalid kind definition: " + path)
    host::exit(1)
    return []
  end
  var index = 0

  while index < parser.arena.count()
    let declaration = parser.arena.declarationAt(index)

    if declaration != null && declaration.isAlternative && declaration.name == name
      var names: String[] = []

      for child in parser.arena.nodeAt(index).children
        if !parser.arena.kindAt(child).isAlternativeCase() || parser.arena.childCountAt(child) != 0
          console::println("Kind definitions require payload-free enum cases: " + path)
          host::exit(1)
          return []
        end
        names = host::appendString(names, parser.arena.dataAt(child))
      end
      return names
    end
    index = index + 1
  end
  console::println("Missing enum " + name + " in " + path)
  host::exit(1)
  return []
end
