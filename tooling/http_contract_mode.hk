sealed class HttpContractMode
  private tag: Int

  private def init(tag: Int): Void
    this.tag = tag
  end

  static def run(): HttpContractMode
    return new HttpContractMode(0)
  end

  static def executable(): HttpContractMode
    return new HttpContractMode(1)
  end

  static def fixture(): HttpContractMode
    return new HttpContractMode(2)
  end

  readonly def isRun(): Bool
    return this.tag == 0
  end

  readonly def isExecutable(): Bool
    return this.tag == 1
  end

  readonly def isFixture(): Bool
    return this.tag == 2
  end

  readonly def name(): String
    return "run" if this.isRun()
    return "executable" if this.isExecutable()
    return "fixture"
  end
end
