use clock

def packageParentDirectory(path: String): String
  var slash = -1
  var index = 0

  while index < host::stringByteLength(path)
    if host::stringByteAt(path, index) == (47 as Byte)
      slash = index
    end
    index = index + 1
  end
  return slash < 0 ? "." : host::stringSlice(path, 0, slash)
end

class Build
  public root: String = ""
  public seed: String = ""
  public llvm: String = ""
  public target: readonly TargetPlatform
  public mode: readonly BuildMode
  public work: String = ""
  public compiler: String = ""
  public caseNumber: Int = 0
  public lastCase: String = ""
  public packagedTree: String = ""
  public stage: Int = 1
  public preparedStage: Int = 0
  public fullValidation: Bool = false
  public contractsPassed: Bool = false
  public fixedPointVerified: Bool = false
  public nativeReady: Bool = false

  def standardLibrarySources(): String[]
    let directory = this.root + "/stdlib"
    let inventory = this.work + "/standard-library-sources.txt"

    execute(this.nativeDirectory() + "/neri-host", ["list", directory, ".hk", inventory])
    var sources: String[] = []

    for path in lines(requiredText(inventory))
      let relative = host::stringSlice(path, host::stringByteLength(directory) + 1, host::stringByteLength(path) - host::stringByteLength(directory) - 1)

      sources = host::appendString(sources, relative)
    end
    fail("standard-library sources are empty") if sources.Length == 0
    return sources
  end

  def standardLibraryArtifacts(): String[]
    let manifest = this.root + "/stdlib/manifest.json"

    if host::readText(manifest) == null
      fail("standard-library manifest is unavailable: " + manifest)
    end
    return host::appendString(this.standardLibrarySources(), "manifest.json")
  end

  def copyStandardLibrary(destination: String, includeManifest: Bool = true): Void
    execute("mkdir", ["-p", destination])
    let artifacts = includeManifest ? this.standardLibraryArtifacts() : this.standardLibrarySources()

    for artifact in artifacts
      let output = destination + "/" + artifact

      execute("mkdir", ["-p", packageParentDirectory(output)])
      execute("cp", [this.root + "/stdlib/" + artifact, output])
    end
  end

  def templateAssets(): String[]
    let assets = ["declarations.json", "declarations.schema.json"]

    for asset in assets
      let path = this.root + "/share/neri/templates/" + asset

      if host::readText(path) == null
        fail("template asset is unavailable: " + path)
      end
    end
    return assets
  end

  def copyTemplateAssets(tree: String): Void
    execute("mkdir", ["-p", tree + "/share/neri/templates"])

    for asset in this.templateAssets()
      execute("cp", [this.root + "/share/neri/templates/" + asset, tree + "/share/neri/templates/" + asset])
    end
  end

  def init(root: String, seed: String, llvm: String, target: readonly TargetPlatform, mode: readonly BuildMode): Void
    this.root = root
    this.seed = seed
    this.llvm = llvm
    this.target = target
    this.mode = mode
  end

  def nativeDirectory(): String
    return this.root + "/build/native/native-" + this.mode.name()
  end

  def environment(): String[]
    return ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LANG=C", "TZ=UTC",
      "SDKROOT=" + envOr("SDKROOT", ""),
      "DEVELOPER_DIR=" + envOr("DEVELOPER_DIR", ""),
      "NERI_STDLIB=" + this.root + "/stdlib",
      "NERI_LIBRARY_PATH=" + this.nativeDirectory(),
      "NERI_HOST=" + this.nativeDirectory() + "/neri-host",
      "NERI_CODEGEN=" + this.nativeDirectory() + "/neri-codegen",
      "NERI_RUNTIME_MANIFEST=" + this.nativeDirectory() + "/neri-runtime-" + this.target.name() + ".json",
      "NERI_CACHE_DIR=" + this.root + "/build/cache/compiler",
      "NERI_TEMPLATE_CATALOG=" + envOr("NERI_TEMPLATE_CATALOG", this.root + "/share/neri/templates/declarations.json"),
      "NERI_LINKER=" + this.llvm + "/bin/clang++"]
  end

  def seedCompiler(): String
    return this.seed + "/bin/neri"
  end

  def doctor(): Void
    console::println("[doctor] " + this.target.name() + " / " + this.mode.name())
    execute(this.seedCompiler(), ["--help"])
    execute(this.llvm + "/bin/clang++", ["--version"])
    execute("cmake", ["--version"])
    execute("ninja", ["--version"])
    this.configureNative()
  end

  def nativeBuild(): Void
    if this.nativeReady
      return
    end
    let prepared = envOr("NERI_NATIVE_READY", "")

    if prepared == this.root + "|" + this.mode.name()
      let receipt = envOr("NERI_NATIVE_READY_MANIFEST", "")

      if receipt == ""
        fail("prepared native components require a checksum manifest")
      end
      let nativeHashes = requiredText(receipt)

      execute("/usr/bin/env", ["-C", this.nativeDirectory(), "shasum", "-a", "256", "-c", receipt])
      for name in ["neri-codegen", "neri-host", "libneri-runtime.a", "neri-runtime-" + this.target.name() + ".json"]
        if !contains(nativeHashes, "  " + name + "\n")
          fail("prepared native manifest omits " + name)
        end
        execute("test", ["-f", this.nativeDirectory() + "/" + name])
      end
      execute("cmake", ["--build", this.nativeDirectory()])
      this.nativeReady = true
      return
    end
    console::println("[native] Building current checkout (" + this.mode.name() + ")")
    this.configureNative()
    execute("cmake", ["--build", this.nativeDirectory()])
    this.nativeReady = true
  end

  def configureNative(): Void
    let buildType = this.mode.cmakeBuildType()

    execute("cmake", ["-S", this.root, "-B", this.nativeDirectory(), "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=" + buildType, "-DCMAKE_C_COMPILER=" + this.llvm + "/bin/clang",
        "-DCMAKE_CXX_COMPILER=" + this.llvm + "/bin/clang++",
        "-DLLVM_DIR=" + this.llvm + "/lib/cmake/llvm", "-DBUILD_TESTING=ON",
        "-DNERI_SANITIZERS=" + (this.mode.isSanitize() ? "ON" : "OFF"),
        "-DNERI_THREAD_SANITIZER=" + (this.mode.isThreadSanitize() ? "ON" : "OFF")])
  end

  def nativeTest(): Void
    this.nativeBuild()
    execute("ctest", ["--test-dir", this.nativeDirectory(), "--output-on-failure", "--no-tests=error"])
  end

  def startWork(): Void
    if this.work != ""
      return
    end
    execute("mkdir", ["-p", this.root + "/build/tmp"])
    let directory = bootstrapTemporaryDirectory(this.root + "/build/tmp", "work")

    if directory == null
      fail("cannot create isolated build directory")
    else
      this.work = directory
    end
  end

  def finishWork(): Void
    if this.work == ""
      return
    end
    # Only the directory created by this invocation belongs to this driver.
    # Failed commands exit before cleanup so their diagnostics remain available.
    if packageParentDirectory(this.work) != this.root + "/build/tmp" || !contains(this.work, "/work.")
      fail("refusing to remove an unexpected build workspace")
    end
    if files::removeTree(this.work).failure != null
      fail("cannot remove completed build workspace: " + this.work)
    end
    this.work = ""
  end

  def sourceFiles(): String[]
    let inventory = this.work + "/compiler-sources.txt"

    execute(this.nativeDirectory() + "/neri-host", ["list", this.root + "/compiler", ".hk", inventory])
    var sources: String[] = []

    for path in lines(requiredText(inventory))
      if !endsWith(path, "/frontend/main.hk") && !endsWith(path, "/semantic/main.hk") && !contains(path, "/compiler/session/")
        sources = host::appendString(sources, path)
      end
    end
    if sources.Length == 0
      fail("compiler sources are empty")
    end
    return sources
  end

  def compile(compiler: String, emit: String, output: String, saveTemps: Bool = false): Bool
    var arguments = this.environment()

    # The compiler owns dependency discovery, output verification and atomic cache publication.
    # Every stage still runs build and restores into this invocation's isolated workspace.
    toolingPrivateCacheDirectory(this.root + "/build/cache/compiler")

    for option in [compiler, "build", "--project", this.root + "/manifest.json", "--unit", "compiler"]
      arguments = host::appendString(arguments, option)
    end
    let options = ["--source-root", this.root + "/compiler", "--module", "neri-compiler",
      "--target", this.target.name(), "--release", "--timings", "--emit=" + emit, "--output", output]

    for option in options arguments = host::appendString(arguments, option) end
    if saveTemps
      arguments = host::appendString(arguments, "--save-temps")
    end
    let status = this.capture(arguments, "stage-compile", 1800)
    let outputText = requiredText(this.work + "/stage-compile.stdout")
    let errorText = requiredText(this.work + "/stage-compile.stderr")

    console::print(outputText)
    console::print(errorText)
    if status != 0
      fail("compiler stage failed with exit " + (status as String))
    end
    return contains(outputText, "neri timing incremental-hit ") || contains(errorText, "neri timing incremental-hit ")
  end

  def bootstrap(publish: Bool): Void
    this.prepareCompiler()
    if publish
      this.publishCompiler()
    end
  end

  def prepareCompiler(): Void
    this.nativeBuild()
    this.startWork()
    if this.preparedStage >= this.stage
      return
    end
    let stageInputs = seedSourceManifest(this)
    var next = this.preparedStage + 1

    this.fixedPointVerified = false

    while next <= this.stage
      let directory = this.work + "/stage" + (next as String)
      let output = directory + "/neri"
      let original = next == 1 ? this.seedCompiler() : this.compiler
      let hash: fn(String): String = fn(path: String): String
        return this.digest(path)
      end
      let input = toolingCachedProducer(this.root + "/build/cache/producers", original, hash)
      let started = clock::milliseconds()

      execute("mkdir", ["-p", directory])
      console::println("[bootstrap] Building Stage" + (next as String))
      let reused = this.compile(input, "executable", output, next > 1)
      let finished = clock::milliseconds()

      if started != null && finished != null
        console::println("[bootstrap] " + (reused ? "Reused Stage" : "Executed Stage") + (next as String) + " in " + ((finished - started) as String) + " ms")
      end
      this.compiler = output
      this.preparedStage = next
      next = next + 1
    end
    if seedSourceManifest(this) != stageInputs
      fail("compiler inputs changed during staged bootstrap")
    end
    if this.preparedStage == 3
      let stage2 = this.work + "/stage2/neri"
      let stage3 = this.work + "/stage3/neri"

      execute("cmp", [stage2, stage3])
      execute("diff", ["-r", stage2 + ".temps", stage3 + ".temps"])
      this.fixedPointVerified = true
      console::println("[bootstrap] Stage3 fixed point verified against current native components")
    end
    this.checkAbiCatalog()
  end

  def copyRuntimeHeaders(tree: String): Void
    execute("mkdir", ["-p", tree + "/include/neri"])
    for name in ["runtime_abi.h", "abi_catalog.h"]
      execute("cp", [this.root + "/native/include/neri/" + name, tree + "/include/neri/" + name])
    end
  end

  def publishCompiler(): Void
    # Readers resolve one immutable compiler/codegen/runtime tuple.
    let tree = this.work + "/verified-toolchain"

    execute("mkdir", ["-p", tree + "/bin", tree + "/lib", tree + "/stdlib", this.root + "/build/toolchains"])
    this.copyTemplateAssets(tree)
    this.copyStandardLibrary(tree + "/stdlib")
    this.copyRuntimeHeaders(tree)
    this.documentationIndex(tree)
    execute("cp", [this.compiler, tree + "/bin/neri"])
    execute("cp", [this.nativeDirectory() + "/neri-codegen", tree + "/bin/neri-codegen"])
    execute("cp", [this.nativeDirectory() + "/libneri-runtime.a", tree + "/lib/libneri-runtime.a"])
    execute("cp", [this.nativeDirectory() + "/neri-runtime-" + this.target.name() + ".json", tree + "/lib/neri-runtime.json"])
    if this.target.isMacOS()
      execute("cp", [this.nativeDirectory() + "/libneri-session-object-linker.dylib", tree + "/lib/libneri-session-object-linker.dylib"])
    end
    var files = ["bin/neri", "bin/neri-codegen", "lib/libneri-runtime.a", "lib/neri-runtime.json", "include/neri/runtime_abi.h", "include/neri/abi_catalog.h", "stdlib/documentation.json"]

    for asset in this.templateAssets()
      files = host::appendString(files, "share/neri/templates/" + asset)
    end

    if this.target.isMacOS()
      files = host::appendString(files, "lib/libneri-session-object-linker.dylib")
    end
    for artifact in this.standardLibraryArtifacts()
      files = host::appendString(files, "stdlib/" + artifact)
    end
    var paths: String[] = []

    for file in files paths = host::appendString(paths, tree + "/" + file) end
    let manifest = this.fileManifest(paths, tree)

    if !host::writeText(tree + "/ARTIFACTS.sha256", manifest)
      fail("cannot record verified toolchain")
    end
    let id = this.digest(tree + "/ARTIFACTS.sha256")
    let destination = this.root + "/build/toolchains/" + id
    let exists = host::run("test", ["-d", destination])

    if exists == null
      fail("cannot inspect verified toolchain destination")
    else if exists == 0
      for file in files execute("cmp", [tree + "/" + file, destination + "/" + file]) end
    else
      execute(this.nativeDirectory() + "/neri-host", ["replace", tree, destination])
    end
    execute("ln", ["-s", "toolchains/" + id, this.work + "/current"])
    execute(this.nativeDirectory() + "/neri-host", ["replace", this.work + "/current", this.root + "/build/current"])
    execute("ln", ["-s", "current/bin/neri", this.work + "/neri"])
    execute(this.nativeDirectory() + "/neri-host", ["replace", this.work + "/neri", this.root + "/build/neri"])
  end

  def documentationIndex(tree: String): Void
    let versions = lines(requiredText(this.root + "/VERSION"))

    if versions.Length != 1 || versions[0] == ""
      fail("invalid VERSION for documentation index")
    end
    var arguments = ["documentation-index", "--toolchain-version", versions[0], "--output", tree + "/stdlib/documentation.json"]

    for source in this.standardLibrarySources()
      arguments = host::appendString(arguments, tree + "/stdlib/" + source)
    end
    var command = ["NERI_STDLIB=" + tree + "/stdlib", this.compiler]

    for argument in arguments
      command = host::appendString(command, argument)
    end
    execute("/usr/bin/env", command)
  end

  def lspDocumentedStdlib(): String
    let tree = this.work + "/lsp-documented-stdlib"

    execute("rm", ["-rf", tree])
    execute("mkdir", ["-p", tree + "/stdlib"])
    this.copyStandardLibrary(tree + "/stdlib")
    this.copyTemplateAssets(tree)
    this.documentationIndex(tree)
    return tree + "/stdlib"
  end

  def capture(arguments: String[], name: String, seconds: Int): Int
    var command = ["run", seconds as String, this.work + "/" + name + ".stdout",
      this.work + "/" + name + ".stderr", this.work + "/" + name + ".status", "/usr/bin/env"]

    for argument in arguments command = host::appendString(command, argument) end
    execute(this.nativeDirectory() + "/neri-host", command)
    let statuses = lines(requiredText(this.work + "/" + name + ".status"))

    if statuses.Length != 1
      fail("invalid child status") return 1
    end
    let status = host::parseInt(statuses[0])

    if status == null
      fail("invalid child exit code") return 1
    end
    return status
  end

  def captureInput(arguments: String[], name: String, seconds: Int, input: String): Int
    let inputPath = this.work + "/" + name + ".stdin"

    if !host::writeText(inputPath, input)
      fail("cannot write child input") return 1
    end
    var command = ["run", seconds as String, this.work + "/" + name + ".stdout",
      this.work + "/" + name + ".stderr", this.work + "/" + name + ".status",
      "--stdin", inputPath, "/usr/bin/env"]

    for argument in arguments command = host::appendString(command, argument) end
    execute(this.nativeDirectory() + "/neri-host", command)
    let statuses = lines(requiredText(this.work + "/" + name + ".status"))

    if statuses.Length != 1
      fail("invalid child status") return 1
    end
    let status = host::parseInt(statuses[0])

    if status == null
      fail("invalid child exit code") return 1
    end
    return status
  end

  def posixLanguageCase(source: String, expectedStatus: Int, expected: String, exact: Bool): Void
    if this.target.isMacOS() || this.target.isLinux()
      this.languageCase(source, expectedStatus, expected, exact)
    end
  end

  def languageCase(source: String, expectedStatus: Int, expected: String, exact: Bool, sources: String[] = []): Void
    console::println("[test] " + source)
    var arguments = this.environment()

    arguments = host::appendString(arguments, this.compiler)
    arguments = host::appendString(arguments, expectedStatus == 1 ? "check" : "run")
    arguments = host::appendString(arguments, this.root + "/" + source)
    for additional in sources
      arguments = host::appendString(arguments, this.root + "/" + additional)
    end
    arguments = host::appendString(arguments, "--target")
    arguments = host::appendString(arguments, this.target.name())
    if this.mode.isRelease()
      arguments = host::appendString(arguments, "--release")
    end
    this.caseNumber = this.caseNumber + 1
    this.lastCase = "case-" + (this.caseNumber as String)
    if !host::writeText(this.work + "/" + this.lastCase + ".source", source + "\n")
      fail("cannot record test source")
    end
    let status = this.capture(arguments, this.lastCase, 30)
    let stdout = requiredText(this.work + "/" + this.lastCase + ".stdout")
    let stderr = requiredText(this.work + "/" + this.lastCase + ".stderr")

    if status != expectedStatus || (exact ? stdout != expected : !contains(stdout + stderr, expected))
      console::print(stdout)
      console::print(stderr)
      fail(source + " violated its output/exit contract (exit " + (status as String) + ")")
    end
  end

  def genericBudgetCase(name: String, firstCount: Int, secondCount: Int, expectedStatus: Int): Void
    let source = this.work + "/" + name + ".hk"
    var code = "def first<T>(value: T): Int\n  return 1\nend\ndef second<T>(value: T): Int\n  return 2\nend\n"
    var index = 0

    while index < firstCount + secondCount
      code = code + "class BudgetType" + (index as String) + "\nend\n"
      index = index + 1
    end
    code = code + "def main(): Void\n"
    index = 0

    while index < firstCount + secondCount
      let functionName = index < firstCount ? "first" : "second"
      let typeName = "BudgetType" + (index as String)

      code = code + "  let result_" + (index as String) + " = " + functionName + "<" + typeName + ">(new " + typeName + "())\n"
      index = index + 1
    end
    code = code + "end\n"
    if !host::writeText(source, code)
      fail("cannot write generic budget fixture")
    end
    var arguments = this.environment()

    arguments = host::appendString(arguments, this.compiler)
    arguments = host::appendString(arguments, "check")
    arguments = host::appendString(arguments, source)
    arguments = host::appendString(arguments, "--target")
    arguments = host::appendString(arguments, this.target.name())
    let status = this.capture(arguments, name, 30)
    let output = requiredText(this.work + "/" + name + ".stdout") + requiredText(this.work + "/" + name + ".stderr")

    if status != expectedStatus || (expectedStatus == 1 && !contains(output, "error NR222:"))
      console::print(output)
      fail(name + " violated the generic specialization budget")
    end
  end

  def runContract(): Void
    let temporary = this.work + "/run-temporary"

    execute("mkdir", ["-p", temporary])
    var arguments = this.environment()
    let options = ["TMPDIR=" + temporary, this.compiler, "run",
      this.root + "/tests/cli/run-arguments.hk", "--target", this.target.name(),
      "--", "two words", "$(literal)", ""]

    for option in options arguments = host::appendString(arguments, option) end
    let status = this.capture(arguments, "run-arguments", 30)

    if status != 7 || requiredText(this.work + "/run-arguments.stdout") != "[two words]\n[$(literal)]\n[]\n"
      fail("run must preserve argument boundaries and the program exit code")
    end
    execute(this.nativeDirectory() + "/neri-host", ["list", temporary, "/program", this.work + "/leftovers"])
    if requiredText(this.work + "/leftovers") != ""
      fail("run left a temporary executable")
    end
    this.runCacheContract()
  end

  def runCacheContract(): Void
    let source = this.work + "/cached.hk"
    let sourceText = requiredText(this.root + "/tests/cli/run-arguments.hk")

    if !host::writeText(source, sourceText)
      fail("cannot write cache fixture")
    end
    let codegen = this.work + "/cache-codegen"
    let runtime = this.work + "/libneri-runtime.a"
    let manifest = this.work + "/cache-runtime.json"

    execute("cp", [this.nativeDirectory() + "/neri-codegen", codegen])
    execute("cp", [this.nativeDirectory() + "/libneri-runtime.a", runtime])
    execute("cp", [this.nativeDirectory() + "/neri-runtime-" + this.target.name() + ".json", manifest])
    var arguments = this.environment()

    for option in ["NERI_CODEGEN=" + codegen, "NERI_RUNTIME_MANIFEST=" + manifest,
      "NERI_CACHE_DIR=" + this.work + "/run-cache", this.compiler, source, "--timings"]
      arguments = host::appendString(arguments, option)
    end
    for scenario in ["miss", "hit", "arguments", "release", "bypass", "source", "runtime", "codegen", "error"]
      var invocation = arguments
      var expected = "cache-hit"
      var output = "[original]\n"
      var status = 7

      if scenario == "miss" || scenario == "source" || scenario == "release" || scenario == "bypass" || scenario == "runtime" || scenario == "codegen"
        expected = "cache-miss"
      end
      if !this.target.isMacOS()
        expected = "cache-miss"
      end
      if scenario == "release"
        invocation = host::appendString(invocation, "--release")
      end
      if scenario == "bypass"
        invocation = host::appendString(invocation, "--no-cache")
      end
      if scenario == "source"
        if !host::writeText(source, sourceText + "\n# changed source\n")
          fail("cannot change cache fixture")
        end
      else if scenario == "runtime" || scenario == "codegen"
        execute("touch", [scenario == "runtime" ? runtime : codegen])
      else if scenario == "error"
        if !host::writeText(source, "def main(): Void\n  missingFunction()\nend\n")
          fail("cannot change cache fixture")
        end
        expected = "TypeCheck: FAILED"
        status = 1
      end
      invocation = host::appendString(invocation, "--")
      invocation = host::appendString(invocation, scenario == "arguments" ? "different" : "original")
      if scenario == "arguments"
        output = "[different]\n"
      end
      let name = "cache-" + scenario
      let actualStatus = this.capture(invocation, name, 30)
      let stdout = requiredText(this.work + "/" + name + ".stdout")
      let stderr = requiredText(this.work + "/" + name + ".stderr")

      if actualStatus != status || (scenario != "error" && stdout != output) || !contains(stdout + stderr, expected)
        console::print(stdout + stderr)
        fail("run cache contract failed: " + scenario)
      end
    end
  end

  def digest(path: String): String
    if this.capture(["shasum", "-a", "256", path], "digest", 60) != 0
      fail("hash failed: " + path)
    end
    let text = requiredText(this.work + "/digest.stdout")

    if host::stringByteLength(text) < 64
      fail("invalid SHA-256 result")
    end
    return host::stringSlice(text, 0, 64)
  end

  def fileManifest(paths: String[], relativeRoot: String): String
    let result = new ToolingTextBuffer()
    var index = 0

    while index < paths.Length
      var arguments = ["-C", relativeRoot, "shasum", "-a", "256", "--"]
      var names: String[] = []
      var bytes = 256

      while index < paths.Length && names.Length < 128
        let path = paths[index]
        let prefix = relativeRoot + "/"

        if !bytesEqualAt(path, prefix, 0)
          fail("manifest input is outside its relative root: " + path)
        end
        let name = host::stringSlice(path, host::stringByteLength(prefix), host::stringByteLength(path) - host::stringByteLength(prefix))
        let size = host::stringByteLength(name) + 1

        if size > 16384 || name == "" || name == "-" || contains(name, "\n") || contains(name, "\r") || contains(name, "\\")
          fail("manifest input cannot be represented without escaping: " + path)
        end
        if bytes + size > 16384 && names.Length > 0
          break
        end
        arguments = host::appendString(arguments, name)
        names = host::appendString(names, name)
        bytes = bytes + size
        index = index + 1
      end
      if this.capture(arguments, "manifest-hashes", 60) != 0
        fail("manifest hash batch failed")
      end
      let hashes = lines(requiredText(this.work + "/manifest-hashes.stdout"))

      if hashes.Length != names.Length
        fail("manifest hash batch returned an unexpected row count")
      end
      var row = 0

      while row < names.Length
        let line = hashes[row]

        if host::stringByteLength(line) != 66 + host::stringByteLength(names[row]) || !bytesEqualAt(line, "  " + names[row], 64)
          fail("manifest hash batch returned an unexpected path or ordering")
        end
        var digit = 0

        while digit < 64
          let value = host::stringByteAt(line, digit) as Int

          if !((value >= 48 && value <= 57) || (value >= 97 && value <= 102))
            fail("manifest hash batch returned an invalid SHA-256")
          end
          digit = digit + 1
        end
        result.add(line + "\n")
        row = row + 1
      end
    end
    return toolingText(result)
  end

  def sourceManifest(): String
    let files = new ToolingTextBuffer()

    for file in [".editorconfig", "CMakeLists.txt", "CMakePresets.json", "README.md", "VERSION", "manifest.json"]
      files.add(file + "\n")
    end

    for directory in ["bootstrap", "compiler", "docs", "examples", "experiments", "native", "scripts", "tests", "tooling", "benchmarks", ".github", "stdlib", "share"]
      execute(this.nativeDirectory() + "/neri-host", ["list", this.root + "/" + directory, "", this.work + "/inventory"])
      let cursor = new ToolingLineCursor(requiredText(this.work + "/inventory"))
      var path = cursor.next()

      while path != null
        let referenceOutput = bytesEqualAt(path, this.root + "/benchmarks/reference-dotnet/bin/", 0) || bytesEqualAt(path, this.root + "/benchmarks/reference-dotnet/obj/", 0)
        let localLessons = bytesEqualAt(path, this.root + "/docs/lessons/", 0)
        let dataPublicationState = contains(path, "/.neri-data-")
        var generatedExperiment = false

        if directory == "experiments"
          for generated in [".git", ".neri", ".cache", ".idea", ".bootstrap", "build", "out", "dist", "target", "bin", "obj"]
            generatedExperiment = true if contains(path, "/" + generated + "/")
          end
        end
        if !endsWith(path, "/.DS_Store") && !referenceOutput && !localLessons && !generatedExperiment && !dataPublicationState
          files.add(host::stringSlice(path, host::stringByteLength(this.root) + 1, host::stringByteLength(path) - host::stringByteLength(this.root) - 1) + "\n")
        end
        path = cursor.next()
      end
    end
    var paths: String[] = []
    let cursor = new ToolingLineCursor(toolingText(files))
    var file = cursor.next()

    while file != null
      paths = host::appendString(paths, this.root + "/" + file)
      file = cursor.next()
    end
    return this.fileManifest(paths, this.root)
  end

  def copySessionProject(tree: String): Void
    let destination = tree + "/share/neri"

    execute(this.nativeDirectory() + "/neri-host", ["list", this.root + "/compiler", ".hk", this.work + "/session-sources"])
    for source in lines(requiredText(this.work + "/session-sources"))
      let relative = host::stringSlice(source, host::stringByteLength(this.root) + 1, host::stringByteLength(source) - host::stringByteLength(this.root) - 1)
      let output = destination + "/" + relative

      execute("mkdir", ["-p", packageParentDirectory(output)])
      execute("cp", [source, output])
    end
    var arguments = this.environment()

    for argument in [this.work + "/neri-session-package", this.root + "/manifest.json", "session", destination + "/manifest.json"]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
  end

  def copyDataProject(tree: String): Void
    let source = this.root + "/experiments/neri-data"
    let destination = tree + "/share/neri/data"
    let runtimeManifest = this.root + "/tooling/data-package-runtime.json"
    let sqliteManifest = this.root + "/tooling/data-package-sqlite.json"
    let runtime = dataPackageUnit(runtimeManifest, "runtime")
    let sqlite = dataPackageUnit(sqliteManifest, "sqlite")
    let runtimeSources = dataPackageSources(runtime)
    let sqliteSources = dataPackageSources(sqlite)
    let versions = lines(requiredText(this.root + "/VERSION"))

    if versions.Length != 1 || versions[0] == ""
      fail("invalid VERSION for Data package metadata")
    end

    execute("mkdir", ["-p", destination + "/sqlite"])
    for file in runtimeSources
      execute("cp", [source + "/" + file, destination + "/" + file])
    end
    for file in sqliteSources
      execute("cp", [source + "/providers/sqlite/" + file, destination + "/sqlite/" + file])
    end
    execute("cp", [runtimeManifest, destination + "/manifest.json"])
    execute("cp", [sqliteManifest, destination + "/sqlite/manifest.json"])
    let metadata = dataPackageMetadata(versions[0], dataPackageLibrary(runtime, runtimeSources, ""), dataPackageLibrary(sqlite, sqliteSources, "sqlite/"))

    if !host::writeText(destination + "/package.json", metadata)
      fail("Cannot write Data package metadata")
    end
  end

  def artifactDirectoryHashes(tree: String, relative: String): String
    execute(this.nativeDirectory() + "/neri-host", ["list", tree + "/" + relative, "", this.work + "/artifact-inventory"])
    return this.fileManifest(lines(requiredText(this.work + "/artifact-inventory")), tree)
  end

  def packageTree(directory: String, name: String, sources: String): String
    let tree = directory + "/" + name
    let documents = packagedDocumentsVerified(this.root)

    execute("mkdir", ["-p", tree + "/bin", tree + "/lib", tree + "/libexec", tree + "/docs", tree + "/examples/session-consumer", tree + "/examples/data-consumer", tree + "/stdlib", tree + "/share/neri"])
    this.copyTemplateAssets(tree)
    this.copyStandardLibrary(tree + "/stdlib")
    this.copyRuntimeHeaders(tree)
    this.documentationIndex(tree)
    execute("cp", [this.compiler, tree + "/libexec/neri"])
    execute("cp", [this.root + "/tooling/neri-launcher-common.sh", tree + "/bin/neri-launcher-common.sh"])
    execute("cp", [this.root + "/tooling/package-launcher.sh", tree + "/bin/neri"])
    execute("cp", [this.root + "/tooling/session-launcher.sh", tree + "/bin/neri-session"])
    execute("cp", [this.root + "/tooling/data-generate-launcher.sh", tree + "/bin/neri-data-generate"])
    execute("cp", [this.root + "/tooling/data-migration-launcher.sh", tree + "/bin/neri-data-migration"])
    execute("cp", [this.root + "/tooling/install-launcher.sh", tree + "/install.sh"])
    execute("cp", [this.work + "/neri-install", tree + "/libexec/neri-install"])
    execute("cp", [this.nativeDirectory() + "/neri-host", tree + "/libexec/neri-host"])
    execute("cp", [this.work + "/neri-session-console", tree + "/libexec/neri-session-console"])
    execute("cp", [this.work + "/neri-data-generate", tree + "/libexec/neri-data-generate"])
    execute("cp", [this.work + "/neri-data-migration", tree + "/libexec/neri-data-migration"])
    execute("cp", [this.nativeDirectory() + "/neri-codegen", tree + "/bin/neri-codegen"])
    execute("cp", [this.nativeDirectory() + "/libneri-runtime.a", tree + "/lib/libneri-runtime.a"])
    execute("cp", [this.nativeDirectory() + "/neri-runtime-" + this.target.name() + ".json", tree + "/lib/neri-runtime.json"])
    if this.target.isMacOS()
      execute("cp", [this.nativeDirectory() + "/libneri-session-object-linker.dylib", tree + "/lib/libneri-session-object-linker.dylib"])
    end
    this.copySessionProject(tree)
    this.copyDataProject(tree)
    for file in ["manifest.json", "main.hk", "service.hk"]
      execute("cp", [this.root + "/tests/session-package-consumer/" + file, tree + "/examples/session-consumer/" + file])
    end
    for file in ["manifest.json", "entities.hk", "mapping.json", "main.hk"]
      execute("cp", [this.root + "/tests/data-package-consumer/" + file, tree + "/examples/data-consumer/" + file])
    end
    for doc in documents
      execute("cp", [this.root + "/docs/" + doc, tree + "/docs/" + doc])
    end
    if !host::writeText(tree + "/SOURCE-MANIFEST.sha256", sources)
      fail("cannot write source manifest")
    end
    let hashes = new ToolingTextBuffer()
    var paths: String[] = []

    for artifact in this.standardLibraryArtifacts()
      paths = host::appendString(paths, tree + "/stdlib/" + artifact)
    end
    paths = host::appendString(paths, tree + "/stdlib/documentation.json")
    for example in ["README.md", "hello.hk", "functions.hk", "arguments.hk", "http.hk", "generics.hk"]
      execute("cp", [this.root + "/examples/" + example, tree + "/examples/" + example])
      paths = host::appendString(paths, tree + "/examples/" + example)
    end
    hashes.add(this.fileManifest(paths, tree))
    paths = []
    hashes.add(this.artifactDirectoryHashes(tree, "share/neri"))
    hashes.add(this.artifactDirectoryHashes(tree, "include/neri"))
    hashes.add(this.artifactDirectoryHashes(tree, "examples/session-consumer"))
    hashes.add(this.artifactDirectoryHashes(tree, "examples/data-consumer"))
    for doc in documents
      paths = host::appendString(paths, tree + "/docs/" + doc)
    end
    for artifact in ["bin/neri", "bin/neri-launcher-common.sh", "bin/neri-session", "bin/neri-data-generate", "bin/neri-data-migration", "bin/neri-codegen", "libexec/neri", "libexec/neri-session-console", "libexec/neri-data-generate", "libexec/neri-data-migration", "libexec/neri-install", "libexec/neri-host", "install.sh", "lib/libneri-runtime.a", "lib/neri-runtime.json", "SOURCE-MANIFEST.sha256"]
      paths = host::appendString(paths, tree + "/" + artifact)
    end
    if this.target.isMacOS()
      let artifact = "lib/libneri-session-object-linker.dylib"

      paths = host::appendString(paths, tree + "/" + artifact)
    end
    hashes.add(this.fileManifest(paths, tree))
    let artifactHashes = toolingText(hashes)

    if !host::writeText(tree + "/ARTIFACTS.sha256", artifactHashes)
      fail("cannot write artifact manifest")
    end
    let verification = (this.fixedPointVerified ? "fixed-point-and-" : "stage2-and-") + (this.contractsPassed ? "native-language-and-package-installation-contracts" : "package-installation-contracts")

    let provenance = "{\n  \"schemaVersion\": 2,\n  \"target\": \"" + this.target.name() + "\",\n  \"llvmVersion\": \"22.1.8\",\n  \"runtimeManifest\": " + requiredText(tree + "/lib/neri-runtime.json") + ",\n  \"compilerStage\": " + (this.preparedStage as String) + ",\n  \"verification\": \"" + verification + "\",\n  \"sourceManifestSha256\": \"" + this.digest(tree + "/SOURCE-MANIFEST.sha256") + "\",\n  \"artifactManifestSha256\": \"" + this.digest(tree + "/ARTIFACTS.sha256") + "\",\n  \"seedProvenanceSha256\": \"" + this.digest(this.seed + "/PROVENANCE.json") + "\"\n}\n"

    if !host::writeText(tree + "/PROVENANCE.json", provenance)
      fail("cannot write provenance")
    end
    execute("chmod", ["-R", "u=rwX,go=rX", tree])
    execute("chmod", ["755", tree + "/bin/neri", tree + "/bin/neri-session", tree + "/bin/neri-data-generate", tree + "/bin/neri-data-migration", tree + "/bin/neri-codegen", tree + "/libexec/neri", tree + "/libexec/neri-session-console", tree + "/libexec/neri-data-generate", tree + "/libexec/neri-data-migration", tree + "/libexec/neri-install", tree + "/libexec/neri-host", tree + "/install.sh"])
    execute(this.nativeDirectory() + "/neri-host", ["stamp", tree, "0"])
    execute(this.nativeDirectory() + "/neri-host", ["list", tree, "", this.work + "/members"])
    var members = ""

    for file in lines(requiredText(this.work + "/members"))
      members = members + host::stringSlice(file, host::stringByteLength(directory) + 1, host::stringByteLength(file) - host::stringByteLength(directory) - 1) + "\n"
    end
    if !host::writeText(directory + "/members", members)
      fail("cannot write archive members")
    end
    let archive = directory + "/" + name + ".tar"

    execute(this.target.isLinux() ? "bsdtar" : "tar", ["--format=ustar", "--uid", "0", "--gid", "0", "--uname", "root", "--gname", "root", "-cf", archive, "-C", directory, "-T", directory + "/members"])
    execute("gzip", ["-n", archive])
    return archive + ".gz"
  end

  def installedToolchain(prefix: String, name: String): String
    let launcher = prefix + "/bin/neri"

    if this.capture(["readlink", launcher], name, 30) != 0
      fail("cannot resolve installed launcher")
    end
    let links = lines(requiredText(this.work + "/" + name + ".stdout"))

    if links.Length != 1 || !bytesEqualAt(links[0], "../toolchains/", 0) || !endsWith(links[0], "/bin/neri")
      fail("installed launcher has an unsafe target")
    end
    return prefix + "/bin/" + host::stringSlice(links[0], 0, host::stringByteLength(links[0]) - 9)
  end

  def pathMissing(path: String): Bool
    let exists = host::run("test", ["-e", path])

    if exists == null
      fail("cannot inspect expected missing path: " + path)
      return false
    end
    if exists != 1
      fail("cannot inspect expected missing path: " + path)
      return false
    end
    return true
  end

  def package(): Void
    if !this.mode.isRelease()
      fail("packages require Release mode")
    end
    this.nativeBuild()
    this.startWork()
    let sources = this.sourceManifest()

    if this.fullValidation
      this.test()
    else
      this.prepareCompiler()
      this.buildHttpProgram("client", "/tests/http/client.hk")
    end
    var sessionPackage = this.environment()

    for option in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "session-package-generator",
      "--target", this.target.name(), "--release", "--output", this.work + "/neri-session-package"]
      sessionPackage = host::appendString(sessionPackage, option)
    end
    execute("/usr/bin/env", sessionPackage)
    var installer = this.environment()

    for option in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "install",
      "--source-root", this.root, "--module", "neri-install",
      "--target", this.target.name(), "--release", "--output", this.work + "/neri-install"]
      installer = host::appendString(installer, option)
    end
    execute("/usr/bin/env", installer)
    var sessionConsole = this.environment()

    for option in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "session-console",
      "--source-root", this.root, "--module", "neri-session-console",
      "--target", this.target.name(), "--release", "--output", this.work + "/neri-session-console"]
      sessionConsole = host::appendString(sessionConsole, option)
    end
    execute("/usr/bin/env", sessionConsole)
    var dataGenerator = this.environment()

    for option in [this.compiler, "build", "--project", this.root + "/tooling/data/manifest.json", "--unit", "generator",
      "--source-root", this.root, "--module", "neri-data-generate",
      "--target", this.target.name(), "--release", "--output", this.work + "/neri-data-generate"]
      dataGenerator = host::appendString(dataGenerator, option)
    end
    execute("/usr/bin/env", dataGenerator)
    var dataMigration = this.environment()

    for option in [this.compiler, "build", "--project", this.root + "/tooling/data/manifest.json", "--unit", "migration-scaffold",
      "--source-root", this.root, "--module", "neri-data-migration",
      "--target", this.target.name(), "--release", "--output", this.work + "/neri-data-migration"]
      dataMigration = host::appendString(dataMigration, option)
    end
    execute("/usr/bin/env", dataMigration)
    if this.sourceManifest() != sources
      fail("sources changed during package validation")
    end
    let versions = lines(requiredText(this.root + "/VERSION"))

    if versions.Length != 1
      fail("invalid VERSION")
    end
    let version = versions[0]
    var index = 0

    while index < host::stringByteLength(version)
      let byte = host::stringByteAt(version, index) as Int

      if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 122) || byte == 46 || byte == 45)
        fail("VERSION must be a portable package component")
      end
      index = index + 1
    end
    if version == ""
      fail("empty VERSION")
    end
    let name = "neri-" + version + "-" + this.target.name()

    console::println("[package] Creating independent normalized archives")
    let first = this.packageTree(this.work + "/package-a", name, sources)
    let second = this.packageTree(this.work + "/package-b", name, sources)

    execute("cmp", [first, second])
    execute("mkdir", [this.work + "/unpacked"])
    execute("tar", ["-xzf", first, "-C", this.work + "/unpacked"])
    execute("/usr/bin/env", ["-C", this.work + "/unpacked/" + name, "shasum", "-a", "256", "-c", "ARTIFACTS.sha256"])
    this.packagedTree = this.work + "/unpacked/" + name
    let prefix = this.work + "/installed toolchain"

    execute(this.packagedTree + "/install.sh", ["--prefix", prefix])
    let launcher = prefix + "/bin/neri"
    let httpRun = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      this.nativeDirectory() + "/neri-http-process", this.work + "/http-client", launcher,
      this.packagedTree + "/examples/http.hk", "--release"]

    if this.capture(httpRun, "installed-http-run", 60) != 0
      fail("installed package cannot serve HTTP")
    end
    let httpBuild = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      launcher, "build", this.packagedTree + "/examples/http.hk", "--release", "--output", this.work + "/installed-http"]

    if this.capture(httpBuild, "installed-http-build", 30) != 0
      fail("installed package cannot build HTTP")
    end
    if this.capture([this.nativeDirectory() + "/neri-http-process", this.work + "/http-client", this.work + "/installed-http"], "installed-http-program", 60) != 0
      fail("installed HTTP executable failed")
    end
    let run = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "HOME=" + envOr("HOME", ""), "LC_ALL=C", "TZ=UTC", "LLVM_PREFIX=" + this.llvm,
      launcher, this.packagedTree + "/examples/generics.hk", "--release"]

    if this.capture(run, "package-smoke", 30) != 0 || requiredText(this.work + "/package-smoke.stdout") != "The answer is 42\n"
      fail("installed package cannot compile and run the smoke program")
    end
    let build = ["-C", this.work, "-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      launcher, "build", this.packagedTree + "/examples/hello.hk", "--release"]

    if this.capture(build, "installed-build", 30) != 0
      fail("installed build failed")
    end
    if this.capture([this.work + "/hello"], "installed-program", 30) != 0 || requiredText(this.work + "/installed-program.stdout") != "Hello, Neri!\n"
      fail("build must create an executable named after the source in the working directory")
    end
    let arguments = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      launcher, "run", this.packagedTree + "/examples/arguments.hk", "--", "Ada", "Grace Hopper"]

    if this.capture(arguments, "package-arguments", 30) != 0 || requiredText(this.work + "/package-arguments.stdout") != "Hello, Ada!\nHello, Grace Hopper!\n"
      fail("packaged arguments example violated its documented output")
    end
    let documentedToolchain = this.installedToolchain(prefix, "installed-documentation-link")

    execute("test", ["-d", documentedToolchain + "/docs"])
    execute("test", ["-f", documentedToolchain + "/share/neri/templates/declarations.json"])
    execute("test", ["-f", documentedToolchain + "/share/neri/templates/declarations.schema.json"])
    let templateDriver = this.work + "/template-install-contract"
    var templateBuild = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "lsp-template-install-contracts", "--output", templateDriver]
      templateBuild = host::appendString(templateBuild, argument)
    end
    execute("/usr/bin/env", templateBuild)
    if this.capture([templateDriver, launcher, documentedToolchain + "/share/neri/templates/declarations.json", this.work, this.root + "/tests/fixtures/templates/data-only.json"], "installed-template-catalog", 60) != 0
      fail("installed template discovery or data-only restart failed")
    end
    execute("test", ["-x", prefix + "/bin/neri-session"])
    let sessionConsumerProject = documentedToolchain + "/examples/session-consumer/manifest.json"
    let sessionConsumer = this.work + "/installed-session-consumer"
    let sessionBuild = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      launcher, "build", "--project", sessionConsumerProject, "--unit", "consumer", "--release", "--output", sessionConsumer]

    if this.capture(sessionBuild, "installed-session-build", 60) != 0
      fail("installed package session library cannot build an independent consumer")
    end
    let sessionRun = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "TZ=UTC",
      "SDKROOT=" + envOr("SDKROOT", ""),
      "NERI_HOST=" + documentedToolchain + "/libexec/neri-host",
      "NERI_CODEGEN=" + documentedToolchain + "/bin/neri-codegen",
      "NERI_RUNTIME_MANIFEST=" + documentedToolchain + "/lib/neri-runtime.json",
      "NERI_STDLIB=" + documentedToolchain + "/stdlib", "NERI_LIBRARY_PATH=" + documentedToolchain + "/lib",
      "NERI_LINKER=" + this.llvm + "/bin/clang++",
      sessionConsumer, documentedToolchain + "/libexec/neri", this.llvm + "/bin/clang++", this.target.name(),
      this.work, sessionConsumerProject]

    if this.capture(sessionRun, "installed-session-run", 60) != 0 || requiredText(this.work + "/installed-session-run.stdout") != "18\n"
      fail("installed package session library cannot initialize and submit")
    end
    let sessionLauncher = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "TZ=UTC", "LLVM_PREFIX=" + this.llvm,
      "NERI_SESSION_WORK=" + this.work, prefix + "/bin/neri-session"]

    if this.captureInput(sessionLauncher, "installed-session-console", 60, "1 + 2\n.\n") != 0 || !contains(requiredText(this.work + "/installed-session-console.stdout"), "3\n")
      fail("installed session launcher cannot evaluate a submission")
    end
    execute("test", ["-x", prefix + "/bin/neri-data-generate"])
    execute("test", ["-x", prefix + "/bin/neri-data-migration"])
    let dataExample = this.work + "/examples/data-consumer"

    execute("mkdir", ["-p", this.work + "/examples", this.work + "/share/neri"])
    execute("cp", ["-R", documentedToolchain + "/examples/data-consumer", dataExample])
    execute("cp", ["-R", documentedToolchain + "/share/neri/data", this.work + "/share/neri/data"])
    execute("mkdir", ["-p", dataExample + "/scaffold"])
    let dataMapping = dataExample + "/mapping.json"
    let installedEnvironment = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "TZ=UTC", "LLVM_PREFIX=" + this.llvm]
    var generate = installedEnvironment

    for argument in [prefix + "/bin/neri-data-generate", dataMapping]
      generate = host::appendString(generate, argument)
    end
    if this.capture(generate, "installed-data-generate", 60) != 0
      fail("installed Data generator cannot generate a consumer")
    end
    var migration = installedEnvironment

    for argument in [prefix + "/bin/neri-data-migration", dataMapping, "empty", "initial", dataExample + "/scaffold/initial"]
      migration = host::appendString(migration, argument)
    end
    if this.capture(migration, "installed-data-migration", 60) != 0
      fail("installed Data migration tool cannot scaffold a migration")
    end
    for artifact in ["migration.hk", "snapshot.json", "scaffold.json"]
      execute("test", ["-s", dataExample + "/scaffold/initial/" + artifact])
    end
    var dataBuild = installedEnvironment

    for argument in [launcher, "build", "--project", dataExample + "/manifest.json", "--unit", "consumer", "--release", "--output", this.work + "/data-consumer"]
      dataBuild = host::appendString(dataBuild, argument)
    end
    if this.capture(dataBuild, "installed-data-build", 60) != 0
      fail("installed Data libraries cannot build an independent consumer")
    end
    let dataRun = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "TZ=UTC",
      "NERI_HOST=" + documentedToolchain + "/libexec/neri-host",
      "NERI_CODEGEN=" + documentedToolchain + "/bin/neri-codegen",
      "NERI_RUNTIME_MANIFEST=" + documentedToolchain + "/lib/neri-runtime.json",
      "NERI_STDLIB=" + documentedToolchain + "/stdlib", "NERI_LIBRARY_PATH=" + documentedToolchain + "/lib",
      "NERI_LINKER=" + this.llvm + "/bin/clang++",
      this.work + "/data-consumer", this.work + "/data-consumer.sqlite", dataExample + "/scaffold/initial"]

    if this.capture(dataRun, "installed-data-run", 60) != 0 || !contains(requiredText(this.work + "/installed-data-run.stdout"), "Installed Neri Data consumer passed\n")
      fail("installed Data consumer failed")
    end
    execute(this.packagedTree + "/install.sh", ["--no-doc", "--prefix", prefix])
    let noDocumentationToolchain = this.installedToolchain(prefix, "installed-no-documentation-link")

    if documentedToolchain == noDocumentationToolchain
      fail("documentation and --no-doc installations must not share a toolchain")
    end
    let noDocumentationManifest = requiredText(noDocumentationToolchain + "/ARTIFACTS.sha256")

    if contains(noDocumentationManifest, "  docs/") || contains(noDocumentationManifest, "  stdlib/documentation.json\n")
      fail("--no-doc installation retained documentation artifacts")
    end
    if !contains(noDocumentationManifest, "  share/neri/templates/declarations.json\n") || !contains(noDocumentationManifest, "  share/neri/templates/declarations.schema.json\n")
      fail("--no-doc installation omitted template assets")
    end
    if !contains(noDocumentationManifest, "  share/neri/data/manifest.json\n") || !contains(noDocumentationManifest, "  share/neri/data/sqlite/manifest.json\n") || !contains(noDocumentationManifest, "  share/neri/data/package.json\n")
      fail("--no-doc installation omitted Data libraries")
    end
    let packageManifest = requiredText(this.packagedTree + "/ARTIFACTS.sha256")
    let installation = requiredText(noDocumentationToolchain + "/INSTALLATION.json")

    if requiredText(noDocumentationToolchain + "/PACKAGE-ARTIFACTS.sha256") != packageManifest || !contains(installation, "\"packageArtifactManifestSha256\": \"" + this.digest(this.packagedTree + "/ARTIFACTS.sha256") + "\"") || !contains(installation, "\"installedArtifactManifestSha256\": \"" + this.digest(noDocumentationToolchain + "/ARTIFACTS.sha256") + "\"") || !contains(installation, "\"documentationIncluded\": false")
      fail("--no-doc installation metadata is not truthful")
    end
    if !this.pathMissing(noDocumentationToolchain + "/docs") || !this.pathMissing(noDocumentationToolchain + "/stdlib/documentation.json")
      fail("--no-doc installation retained documentation files")
    end
    execute(launcher, ["--version"])
    let noDocumentationCheck = ["-i", "PATH=" + envOr("PATH", "/usr/bin:/bin"), "LC_ALL=C", "LLVM_PREFIX=" + this.llvm,
      launcher, "check", this.packagedTree + "/examples/hello.hk", "--release"]

    if this.capture(noDocumentationCheck, "installed-no-documentation-check", 30) != 0
      fail("--no-doc installation cannot check a program")
    end
    execute(this.packagedTree + "/install.sh", ["--prefix", prefix, "--no-doc"])
    if this.installedToolchain(prefix, "reinstalled-no-documentation-link") != noDocumentationToolchain
      fail("--no-doc reinstallation did not reuse its staged manifest")
    end
    execute(this.packagedTree + "/install.sh", ["--prefix", prefix])
    if this.installedToolchain(prefix, "reinstalled-documentation-link") != documentedToolchain
      fail("documentation reinstallation did not preserve its content address")
    end
    let tampered = this.work + "/tampered-package"

    execute("cp", ["-R", this.packagedTree, tampered])
    if !host::writeText(tampered + "/docs/LANGUAGE.md", requiredText(tampered + "/docs/LANGUAGE.md") + "\n")
      fail("cannot tamper package fixture")
    end
    let tamperedPrefix = this.work + "/tampered-installation"

    if this.capture([tampered + "/install.sh", "--no-doc", "--prefix", tamperedPrefix], "tampered-install", 30) == 0
      fail("installer accepted a tampered package")
    end
    if !this.pathMissing(tamperedPrefix + "/bin/neri")
      fail("tampered package created an installation")
    end
    let hash = this.digest(first)

    if this.sourceManifest() != sources
      fail("sources changed while creating the package")
    end
    let published = this.root + "/build/packages/" + name + "-" + hash + ".tar.gz"

    execute("mkdir", ["-p", this.root + "/build/packages"])
    execute("mv", [first, published])
    console::println("[package] Verified reproducible archive: " + published)
  end

  def install(prefix: String): Void
    this.package()
    if prefix == ""
      execute(this.packagedTree + "/install.sh", [])
    else
      execute(this.packagedTree + "/install.sh", ["--prefix", prefix])
    end
  end

  def benchmark(): Void
    if !this.mode.isRelease()
      fail("benchmarks require Release mode")
    end
    this.prepareCompiler()
    let binary = this.work + "/collections"
    var arguments = this.environment()
    let options = [this.compiler, "build", "--project", this.root + "/manifest.json",
      "--unit", "collections-benchmark", "--source-root", this.root,
      "--module", "collections", "--target", this.target.name(), "--release", "--output", binary]

    for option in options arguments = host::appendString(arguments, option) end
    execute("/usr/bin/env", arguments)
    var report = ""

    for count in [2048, 4096, 8192]
      for mode in ["array", "buffer"]
        var sample = 0

        while sample < 6
          let name = "collections-" + mode + "-" + (count as String) + "-" + (sample as String)

          if this.capture([binary, mode, count as String], name, 30) != 0
            fail("collection benchmark failed")
          end
          let expected = ((count * (count - 1) / 2) * 16) as String

          if requiredText(this.work + "/" + name + ".stdout") != expected + "\n"
            fail("collection benchmark checksum mismatch")
          end
          if sample > 0
            let metrics = lines(requiredText(this.work + "/" + name + ".status.metrics.json"))[0]

            report = report + "{\"mode\":\"" + mode + "\",\"elements\":" + (count as String) + ",\"rounds\":16,\"sample\":" + (sample as String) + ",\"metrics\":" + metrics + "}\n"
          end
          sample = sample + 1
        end
        console::println("[benchmark] " + mode + " / " + (count as String) + " elements: five validated samples")
      end
    end
    if !host::writeText(this.work + "/collections.jsonl", report)
      fail("cannot write collection report")
    end
    if this.capture([this.nativeDirectory() + "/neri_gc_pressure"], "gc-pressure", 30) != 0
      fail("GC pressure budget failed")
    end
    console::println("[benchmark] Measurements: " + this.work)
  end

  def valueContracts(): Void
    let inventory = this.work + "/value-contracts.txt"

    execute(this.nativeDirectory() + "/neri-host", ["list", this.root + "/tests/value-contracts", "/main.hk", inventory])
    let projects = lines(requiredText(inventory))

    fail("value contracts are empty") if projects.Length == 0
    for configuration in [BuildMode.debug(), BuildMode.release()]
      var index = 0

      for source in projects
        let project = host::stringSlice(source, 0, host::stringByteLength(source) - 8)
        let name = "value-contract-" + (index as String)

        index = index + 1
        let output = this.work + "/" + name + "-" + configuration.name()
        var arguments = this.environment()

        for argument in [this.compiler, "build", "--project", project, "--output", output]
          arguments = host::appendString(arguments, argument)
        end
        if configuration.isRelease()
          arguments = host::appendString(arguments, "--release")
        end
        if this.capture(arguments, name + "-build-" + configuration.name(), 30) != 0 || this.capture([output], name + "-run-" + configuration.name(), 30) != 0
          fail(project + " contract failed in " + configuration.name())
        end
      end
    end
  end

  def runtimeContracts(): Void
    let inventory = this.work + "/runtime-contracts.txt"

    execute(this.nativeDirectory() + "/neri-host", ["list", this.root + "/tests/runtime-contracts", "/manifest.json", inventory])
    let projects = lines(requiredText(inventory))

    fail("runtime contracts are empty") if projects.Length == 0
    var index = 0

    for project in projects
      index = index + 1
      for configuration in [BuildMode.debug(), BuildMode.release()]
        let name = "runtime-contract-" + (index as String) + "-" + configuration.name()
        let directory = this.work + "/" + name

        execute("mkdir", ["-p", directory + "/data"])
        for unit in ["fixture", "driver"]
          var arguments = this.environment()

          for argument in [this.compiler, "build", "--project", project, "--unit", unit, "--output", directory + "/" + unit]
            arguments = host::appendString(arguments, argument)
          end
          arguments = host::appendString(arguments, "--release") if configuration.isRelease()
          if this.capture(arguments, name + "-build-" + unit, 30) != 0
            console::print(requiredText(this.work + "/" + name + "-build-" + unit + ".stdout"))
            console::print(requiredText(this.work + "/" + name + "-build-" + unit + ".stderr"))
            fail(project + " " + unit + " build failed in " + configuration.name())
          end
        end
        if this.capture([directory + "/driver", directory + "/data", directory + "/fixture", this.target.name()], name + "-run", 30) != 0
          console::print(requiredText(this.work + "/" + name + "-run.stdout"))
          console::print(requiredText(this.work + "/" + name + "-run.stderr"))
          fail(project + " runtime contract failed in " + configuration.name())
        end
      end
    end
  end

  def dataRuntimeContracts(): Void
    console::println("[test] SQLite lifecycle, persistence and worker isolation")
    for configuration in [BuildMode.debug(), BuildMode.release()]
      for project in ["provider-contract", "providers/sqlite", "concurrency-tokens", "resource-lifetime", "storage-failures"]
        var units = ["sqlite-connection", "persistence", "streaming"]

        units = ["contract", "workers-contract"] if project == "concurrency-tokens"
        units = ["contract"] if project == "resource-lifetime" || project == "storage-failures"
        if project == "providers/sqlite"
          units = ["contract", "configuration-contract", "materialization-contract", "migration-contract", "schema-diff-contract", "schema-rebuild-contract", "schema-inspection-contract"]
        end
        let projectName = project == "providers/sqlite" ? "sqlite-provider" : project
        let name = "data-" + projectName + "-" + configuration.name()
        let directory = this.work + "/" + name

        execute("mkdir", ["-p", directory])
        var arguments = this.environment()

        for argument in [this.compiler, "build-batch", "--project", this.root + "/experiments/neri-data/" + project + "/manifest.json", "--output-dir", directory]
          arguments = host::appendString(arguments, argument)
        end
        for unit in units
          arguments = host::appendString(arguments, "--unit")
          arguments = host::appendString(arguments, unit)
        end
        arguments = host::appendString(arguments, "--release") if configuration.isRelease()
        if this.capture(arguments, name + "-build", 120) != 0
          console::print(requiredText(this.work + "/" + name + "-build.stdout"))
          console::print(requiredText(this.work + "/" + name + "-build.stderr"))
          fail("SQLite contract build failed: " + name)
        end
        for unit in units
          if this.capture([directory + "/" + unit], name + "-" + unit, 30) != 0
            console::print(requiredText(this.work + "/" + name + "-" + unit + ".stdout"))
            console::print(requiredText(this.work + "/" + name + "-" + unit + ".stderr"))
            fail("SQLite contract failed: " + name + "/" + unit)
          end
        end
      end
      this.dataRecoveryContract(configuration)
    end
  end

  def dataRecoveryContract(configuration: BuildMode): Void
    let name = "data-recovery-" + configuration.name()
    let directory = this.work + "/" + name

    execute("mkdir", ["-p", directory])
