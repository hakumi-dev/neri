  def sessionProbe(directory: String, name: String, source: String, module: String): Void
    var arguments = this.environment()

    for argument in [this.compiler, "build", this.root + "/tests/" + source, "--module", module, "--session-module", "--emit=obj", "--release", "--output", directory + "/" + name + ".o"]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    this.sessionLink(directory, name)
  end

  def sessionLink(directory: String, name: String, metadataFixture: Bool = false): Void
    var link = [directory + "/" + name + ".o", "-o", directory + "/" + name + ".module"]

    if this.target.isMacOS()
      link = host::appendString(link, "-dynamiclib")
      link = host::appendString(link, "-Wl,-undefined,dynamic_lookup")
    else
      link = host::appendString(link, "-shared")
      link = host::appendString(link, "-Wl,-Bsymbolic")
    end
    if metadataFixture
      # Neri reserves compiler-owned metadata exports. The fixture aliases its
      # ordinary C exports at the native boundary to test malformed metadata.
      if this.target.isMacOS()
        link = host::appendString(link, "-Wl,-alias,_metadata_fixture_entry,_neri_session_entry_v1")
        link = host::appendString(link, "-Wl,-alias,_metadata_fixture_accessor,_neri_session_module_v1")
      else
        link = host::appendString(link, "-Wl,--defsym,neri_session_entry_v1=metadata_fixture_entry")
        link = host::appendString(link, "-Wl,--defsym,neri_session_module_v1=metadata_fixture_accessor")
      end
    end
    execute(this.llvm + "/bin/clang++", link)
  end

  def sessionMetadataProbes(directory: String): Void
    for name in ["unknown-flags", "oversized-payload"]
      var arguments = this.environment()

      for argument in [this.compiler, "build", "--project", this.root + "/tests/session-metadata/manifest.json",
        "--unit", name, "--target", this.target.name(), "--emit=obj", "--release", "--output", directory + "/" + name + ".o"]
        arguments = host::appendString(arguments, argument)
      end
      execute("/usr/bin/env", arguments)
      this.sessionLink(directory, name, true)
    end
  end

  def sessionContracts(): Void
    let directory = this.work + "/session-contracts"

    execute("mkdir", ["-p", directory])
    this.sessionProbe(directory, "probe", "session-probe.hk", "session-probe")
    this.sessionProbe(directory, "probe-next", "session-probe-next.hk", "session-probe")
    this.sessionProbe(directory, "probe-mismatch", "session-probe-next.hk", "session-other")
    this.sessionProbe(directory, "probe-layout-mismatch", "session-probe-layout-mismatch.hk", "session-probe")
    this.sessionMetadataProbes(directory)
    execute("mkdir", ["-p", directory + "/stdlib"])
    this.copyStandardLibrary(directory + "/stdlib")
    let runtime = directory + "/libneri-runtime.a"
    let runtimeManifest = directory + "/neri-runtime-" + this.target.name() + ".json"

    execute("cp", [this.nativeDirectory() + "/libneri-runtime.a", runtime])
    execute("cp", [this.nativeDirectory() + "/neri-runtime-" + this.target.name() + ".json", runtimeManifest])
    let objectLinker = directory + "/libneri-session-object-linker.dylib"

    if this.target.isMacOS()
      execute("cp", [this.nativeDirectory() + "/libneri-session-object-linker.dylib", objectLinker])
    end
    var arguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "session-contracts", "--output", directory + "/driver"]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    var run = this.environment()

    run = host::appendString(run, "NERI_STDLIB=" + directory + "/stdlib")
    run = host::appendString(run, "NERI_RUNTIME_MANIFEST=" + runtimeManifest)
    run = host::appendString(run, "NERI_SESSION_CACHE_TEST_MANIFEST=" + runtimeManifest)
    if this.target.isMacOS()
      run = host::appendString(run, "NERI_SESSION_OBJECT_LINKER=" + objectLinker)
      run = host::appendString(run, "NERI_SESSION_CACHE_TEST_BRIDGE=" + objectLinker)
    end
    let cacheDirectory = directory + "/code-cache"

    execute("mkdir", ["-m", "700", cacheDirectory])
    run = host::appendString(run, "NERI_CACHE_DIR=" + cacheDirectory)
    run = host::appendString(run, "NERI_SESSION_CACHE_TEST_DIR=" + cacheDirectory)
    for argument in [directory + "/driver", this.compiler, this.llvm + "/bin/clang++", this.target.name(), directory, this.root]
      run = host::appendString(run, argument)
    end
    if this.capture(run, "session-contracts", 180) != 0
      fail("session contracts failed")
    end
    let nativeLibraryDriver = directory + "/native-library-driver"
    var nativeLibraryBuild = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "session-native-library-contracts", "--output", nativeLibraryDriver]
      nativeLibraryBuild = host::appendString(nativeLibraryBuild, argument)
    end
    execute("/usr/bin/env", nativeLibraryBuild)
    var nativeLibraryRun = this.environment()

    nativeLibraryRun = host::appendString(nativeLibraryRun, "NERI_TARGET=" + this.target.name())
    nativeLibraryRun = host::appendString(nativeLibraryRun, "NERI_RUNTIME_MANIFEST=" + runtimeManifest)
    nativeLibraryRun = host::appendString(nativeLibraryRun, "NERI_STDLIB=" + directory + "/stdlib")
    if this.target.isMacOS()
      nativeLibraryRun = host::appendString(nativeLibraryRun, "NERI_SESSION_OBJECT_LINKER=" + objectLinker)
    end
    nativeLibraryRun = host::appendString(nativeLibraryRun, "NERI_CACHE_DIR=" + cacheDirectory)
    for argument in [nativeLibraryDriver, this.compiler, directory]
      nativeLibraryRun = host::appendString(nativeLibraryRun, argument)
    end
    if this.capture(nativeLibraryRun, "session-native-library-contracts", 180) != 0
      fail("session native-library contracts failed")
    end
    this.sessionTerminalContracts()
  end

  def sessionTerminalContracts(): Void
    let directory = this.work + "/session-contracts"
    var readBuild = this.environment()

    for argument in [this.compiler, "build", this.root + "/tests/console-readline-contract.hk", "--output", directory + "/console-readline-contract"]
      readBuild = host::appendString(readBuild, argument)
    end
    execute("/usr/bin/env", readBuild)
    var readRun = this.environment()

    readRun = host::appendString(readRun, directory + "/console-readline-contract")
    if this.captureInput(readRun, "console-readline-contract", 30, "\nvalue\n") != 0
      fail("optional console line contract failed")
    end

    var consoleBuild = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "session-console", "--output", directory + "/session-console"]
      consoleBuild = host::appendString(consoleBuild, argument)
    end
    execute("/usr/bin/env", consoleBuild)
    var consoleRun = this.environment()

    for argument in ["NERI_SESSION_COMPILER=" + this.compiler,
      "NERI_LINKER=" + this.llvm + "/bin/clang++", "NERI_TARGET=" + this.target.name(),
      "NERI_SESSION_WORK=" + directory, directory + "/session-console"]
      consoleRun = host::appendString(consoleRun, argument)
    end
    if this.captureInput(consoleRun, "session-console", 60, "\nlet value = 1\n.\n:reset\n") != 0
      fail("session console failed")
    end
    let output = requiredText(this.work + "/session-console.stdout")

    if !contains(output, "value: Int\n") || !contains(output, "reset\n")
      fail("session console did not format bindings and reset")
    end
  end

  def checkAbiCatalog(): Void
    console::println("[abi] Checking generated compiler and native contracts")
    let generator = this.work + "/abi-catalog-generator"
    var arguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/tooling/abi/manifest.json", "--target", this.target.name(), "--release", "--output", generator]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    var check = this.environment()

    for argument in [generator, "--check", this.root]
      check = host::appendString(check, argument)
    end
    execute("/usr/bin/env", check)
    this.checkKindCatalog()
  end

  def checkKindCatalog(): Void
    console::println("[kinds] Checking generated compiler domains")
    let generator = this.work + "/kind-catalog-generator"
    var arguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/tooling/kinds/manifest.json", "--target", this.target.name(), "--release", "--output", generator]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    var check = this.environment()

    for argument in [generator, "--check", this.root]
      check = host::appendString(check, argument)
    end
    execute("/usr/bin/env", check)
  end

  def abiCatalogContracts(): Void
    let driver = this.work + "/abi-generator-contracts"
    var arguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/tooling/abi/manifest.json", "--unit", "contracts", "--output", driver]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    var run = this.environment()

    for argument in [driver, this.work]
      run = host::appendString(run, argument)
    end
    execute("/usr/bin/env", run)
  end

  def checkCodeStyle(): Void
    console::println("[style] Checking owned project sources and the standard library")
    for project in ["manifest.json", "stdlib/manifest.json", "tooling/abi/manifest.json", "tooling/kinds/manifest.json", "tooling/data/manifest.json", "experiments/neri-data/manifest.json", "experiments/neri-data/verification/manifest.json", "experiments/neri-data/generated-example/manifest.json", "experiments/neri-data/float-values/manifest.json", "experiments/neri-data/providers/sqlite/manifest.json", "experiments/neri-data/provider-contract/manifest.json", "experiments/neri-data/navigation/manifest.json", "experiments/neri-data/reference-navigation/manifest.json", "experiments/neri-data/scalar-relationships/manifest.json"]
      var arguments = this.environment()

      for argument in [this.compiler, "format", "--check", "--project", this.root + "/" + project]
        arguments = host::appendString(arguments, argument)
      end
      execute("/usr/bin/env", arguments)
      var lint = this.environment()

      for argument in [this.compiler, "lint", "--project", this.root + "/" + project]
        lint = host::appendString(lint, argument)
      end
      execute("/usr/bin/env", lint)
    end
  end

  def test(): Void
    this.nativeBuild()
    this.startWork()
    let validationInputs = this.sourceManifest()

    this.prepareCompiler()
    this.checkCodeStyle()
    this.abiCatalogContracts()
    var lspArguments = this.environment()

    lspArguments = host::appendString(lspArguments, "NERI_TEMPLATE_CATALOG=")
    lspArguments = host::appendString(lspArguments, "NERI_LSP_TEST_STDLIB=" + this.lspDocumentedStdlib())

    for argument in [this.nativeDirectory() + "/neri-lsp-test", this.compiler, this.root]
      lspArguments = host::appendString(lspArguments, argument)
    end
    execute("/usr/bin/env", lspArguments)
    var projectArguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/tests/lsp/project/neri.json", "--output", this.work + "/project-contract"]
      projectArguments = host::appendString(projectArguments, argument)
    end
    execute("/usr/bin/env", projectArguments)
    this.unicodeProjectContracts()
    this.projectManifestContracts()
    this.aotCacheContracts()
    this.codegenCacheContracts()
    this.sessionContracts()
    this.standardLibraryContracts()
    this.fileContracts()
    execute("ctest", ["--test-dir", this.nativeDirectory(), "--output-on-failure", "--no-tests=error"])
    this.languageCase("examples/hello.hk", 0, "Hello, Neri!\n", true)
    this.languageCase("examples/functions.hk", 0, "Total: 60\n", true)
    this.languageCase("tests/differential/native/classes.hk", 0, "", true)
    this.languageCase("tests/differential/native/arrays.hk", 0, "typed arrays=326\n", true)
    this.languageCase("tests/neri-tests/unsafe_memory.hk", 0, "", true)
    this.languageCase("tests/neri-tests/floats.hk", 0, "", true)
    this.languageCase("tests/native/cabi.hk", 0, "", true)
    this.languageCase("tests/contracts/optional.hk", 0, "", true)
    this.languageCase("tests/contracts/optional-scalar-arrays.hk", 0, "", true)
    this.languageCase("tests/contracts/method-defaults.hk", 0, "", true)
    this.languageCase("tests/contracts/unsafe-default-errors.hk", 1, "error NR189:", false)
    var rejectedUnsafeDefaults = 0

    for line in lines(requiredText(this.work + "/" + this.lastCase + ".stdout"))
      rejectedUnsafeDefaults = rejectedUnsafeDefaults + 1 if contains(line, "error NR189:")
    end
    fail("unsafe default arguments escaped the call boundary") if rejectedUnsafeDefaults != 2
    this.languageCase("tests/contracts/callbacks.hk", 0, "", true)
    this.languageCase("tests/contracts/quotation-tree.hk", 0, "", true)
    this.languageCase("tests/contracts/typed-quotations.hk", 0, "", true)
    this.languageCase("tests/contracts/ternary-nullable-errors.hk", 1, "error NR124: Ternary branches must have the same or matching optional type", false)
    this.languageCase("tests/contracts/ternary-flow-errors.hk", 1, "error NR169:", false)
    this.languageCase("tests/contracts/member-flow.hk", 0, "", true)
    this.languageCase("tests/contracts/member-flow-errors.hk", 1, "error NR169:", false)
    this.languageCase("tests/contracts/fields.hk", 0, "", true)
    this.effectContracts()
    this.languageCase("tests/contracts/readonly.hk", 0, "", true)
    this.languageCase("tests/contracts/abstract-classes.hk", 0, "", true)
    this.languageCase("tests/contracts/shared-callbacks.hk", 0, "", true)
    this.languageCase("tests/contracts/parallel-callbacks.hk", 0, "", true)
    this.languageCase("tests/contracts/task-generation.hk", 0, "", true)
    this.languageCase("tests/runtime-contracts/workers/fixture.hk", 0, "", true, ["tests/runtime-contracts/workers/entries.hk"])
    this.languageCase("tests/contracts/worker-entry-errors.hk", 1, "error NR249:", false)
    var rejectedWorkerEntries = 0

    for line in lines(requiredText(this.work + "/" + this.lastCase + ".stdout"))
      rejectedWorkerEntries = rejectedWorkerEntries + 1 if contains(line, "error NR249:")
    end
    fail("worker entry binding accepted a capture, indirect callable, or incompatible signature") if rejectedWorkerEntries != 8
    this.languageCase("tests/contracts/worker-ownership-errors.hk", 1, "error NR153:", false)
    let workerOwnershipErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    fail("worker handle construction escaped the unsafe boundary") if !contains(workerOwnershipErrors, "error NR189:")
    this.languageCase("tests/contracts/array-generation.hk", 0, "", true)
    this.languageCase("tests/contracts/array-generation-negative.hk", 70, "invalid sequential array generation contract", false)
    this.languageCase("tests/contracts/gc-roots.hk", 0, "", true)
    this.languageCase("tests/contracts/postfix-if.hk", 0, "", true)
    this.languageCase("tests/contracts/console.hk", 0, "value=42\n", true)
    this.languageCase("tests/contracts/text.hk", 0, "", true)
    this.languageCase("tests/contracts/string-class.hk", 0, "", true)
    this.languageCase("tests/contracts/exact-arguments.hk", 0, "", true)
    this.languageCase("tests/contracts/library-declarations.hk", 0, "", true)
    this.languageCase("tests/contracts/generic-equality.hk", 0, "", true)
    this.languageCase("tests/contracts/generic-equality-mixed-errors.hk", 1, "error NR118:", false)
    this.languageCase("tests/contracts/generic-equality-errors.hk", 1, "error NR250:", false)
    this.languageCase("tests/contracts/reference-identity.hk", 0, "", true)
    this.languageCase("tests/contracts/reference-identity-errors.hk", 1, "error NR220:", false)
    var rejectedReferenceScalars = 0

    for line in lines(requiredText(this.work + "/" + this.lastCase + ".stdout"))
      rejectedReferenceScalars = rejectedReferenceScalars + 1 if contains(line, "error NR220:")
    end
    fail("reference identity accepted scalar specialization or a renamed intrinsic") if rejectedReferenceScalars != 2
    this.languageCase("tests/contracts/source-contracts.hk", 0, "", true)
    this.languageCase("tests/contracts/source-contract-errors.hk", 1, "error NR251:", false)
    this.languageCase("tests/contracts/exact-arguments-errors.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/generic-operation-errors.hk", 1, "error NR249:", false)
    this.languageCase("tests/contracts/library-operators.hk", 0, "", true)
    this.languageCase("tests/contracts/any-class.hk", 0, "", true)
    this.languageCase("tests/contracts/generics.hk", 0, "Generic contracts passed\n", true, ["tests/contracts/generic-library.hk"])
    this.languageCase("tests/contracts/generic-methods.hk", 0, "", true, ["tests/contracts/generic-method-library.hk"])
    this.languageCase("tests/contracts/generic-method-errors.hk", 1, "error NR220:", false)
    let genericMethodErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    if !contains(genericMethodErrors, "error NR221:")
      fail("generic method inference accepted an uninferred method type parameter")
    end
    if !contains(genericMethodErrors, "error NR153:")
      fail("generic method visibility was not preserved")
    end
    if !contains(genericMethodErrors, "error NR112:")
      fail("generic method argument types were not validated")
    end
    this.negativeContracts()
    this.runContract()
    this.httpContracts()
    this.languageCase("tests/http/stop.hk", 0, "", true)
    this.posixLanguageCase("tests/http/interrupts.hk", 0, "", true)
    this.valueContracts()
    this.runtimeContracts()
    this.dataRuntimeContracts()
    this.terminalContracts()
    this.scalarContracts()
    this.cAbiExportContracts()
    if this.capture(["/bin/sleep", "5"], "timeout", 1) != 124
      fail("process deadline was not enforced")
    end
    if this.capture(["/bin/cat"], "stdin", 1) != 0 || requiredText(this.work + "/stdin.stdout") != ""
      fail("test stdin must be EOF")
    end
    if this.sourceManifest() != validationInputs
      fail("sources changed during checkout validation")
    end
    this.contractsPassed = true
    this.publishCompiler()
    console::println("[test] Current native and language contracts passed")
  end

  def buildHttpProgram(name: String, source: String): Void
    var arguments = this.environment()

    for option in [this.compiler, "build", this.root + source, "--output", this.work + "/http-" + name]
      arguments = host::appendString(arguments, option)
    end
    if this.mode.isRelease()
      arguments = host::appendString(arguments, "--release")
    end
    execute("/usr/bin/env", arguments)
  end

  def httpContracts(): Void
    this.buildHttpProgram("client", "/tests/http/client.hk")
    this.buildHttpProgram("example", "/examples/http.hk")
    this.buildHttpProgram("fixture", "/tests/http/server.hk")
    for mode in [HttpContractMode.run(), HttpContractMode.executable(), HttpContractMode.fixture()]
      var arguments = this.environment()

      if mode.isExecutable()
        arguments = host::appendString(arguments, "PORT=18080")
        arguments = host::appendString(arguments, "HTTP_LOG=1")
      end
      if mode.isFixture()
        arguments = host::appendString(arguments, "NERI_HTTP_FIXTURE=1")
      end
      for option in [this.nativeDirectory() + "/neri-http-process", this.work + "/http-client"]
        arguments = host::appendString(arguments, option)
      end
      if mode.isRun()
        arguments = host::appendString(arguments, this.compiler)
        arguments = host::appendString(arguments, this.root + "/examples/http.hk")
        if this.mode.isRelease()
          arguments = host::appendString(arguments, "--release")
        end
      else if mode.isFixture()
        arguments = host::appendString(arguments, this.work + "/http-fixture")
      else
        arguments = host::appendString(arguments, this.work + "/http-example")
      end
      if this.capture(arguments, "http-" + mode.name(), 90) != 0
        fail("HTTP " + mode.name() + " contract failed")
      end
      let output = requiredText(this.work + "/http-" + mode.name() + ".stdout")

      if mode.isExecutable()
        if !contains(output, "Listening on http://127.0.0.1:18080") || !contains(output, "Response 200")
          fail("HTTP configured port and logging contract failed")
        end
      else if mode.isRun()
        if !contains(output, "Listening on http://127.0.0.1:8080") || contains(output, "Response 200")
          fail("HTTP default startup and silent access contract failed")
        end
      end
    end
  end

  def terminalContracts(): Void
    var arguments = this.environment()

    for option in [this.compiler, "build", this.root + "/tests/contracts/terminal.hk", "--output", this.work + "/terminal-client", "--release"]
      arguments = host::appendString(arguments, option)
    end
    execute("/usr/bin/env", arguments)
    if this.capture([this.nativeDirectory() + "/neri-terminal-process", this.work + "/terminal-client"], "terminal", 15) != 0
      fail("terminal session contract failed")
    end
  end

  def negativeContracts(): Void
    this.languageCase("tests/contracts/abstract-errors.hk", 1, "error NR253:", false)
    let abstractErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["error NR254:", "error NR255:", "error NR256:", "error NR177:"]
      if !contains(abstractErrors, diagnostic)
        fail("missing abstract declaration diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/library-operator-errors.hk", 1, "error NR243:", false)
    let operatorErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["error NR244:", "error NR153:", "error NR111A:", "error NR135:", "error NR182:"]
      if !contains(operatorErrors, diagnostic)
        fail("missing library type diagnostic " + diagnostic)
      end
    end
    var privateConstructors = 0
    var misplacedBaseCalls = 0

    for line in lines(operatorErrors)
      privateConstructors = privateConstructors + 1 if contains(line, "error NR153:")
      misplacedBaseCalls = misplacedBaseCalls + 1 if contains(line, "error NR182:")
    end
    if privateConstructors != 6 || misplacedBaseCalls != 3
      fail("constructor access or single initialization contract was weakened")
    end
    this.languageCase("tests/contracts/string-class-errors.hk", 1, "error NR156:", false)
    let stringClassErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["error NR245:", "error NR159:", "error NR247:", "error NR154A:"]
      if !contains(stringClassErrors, diagnostic)
        fail("missing represented String diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/console-int-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/console-byte-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/console-float-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/console-bool-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/assert-equal-mixed-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/assert-equal-unsupported-error.hk", 1, "error NR251:", false)
    this.languageCase("tests/contracts/assert-equal-optional-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/implicit-int-float-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/any-class-argument-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/reserved-type-error.hk", 1, "Type 'Error' is reserved.", false)
    if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "Type 'Null' is reserved.")
      fail("null type marker must be reserved")
    end
    this.languageCase("tests/contracts/reserved-generic-class-error.hk", 1, "error NR156:", false)
    this.languageCase("tests/contracts/reserved-generic-parameter-error.hk", 1, "error NR220:", false)
    this.languageCase("tests/contracts/reserved-native-type-error.hk", 1, "Native type 'Error' is already defined or reserved.", false)
    if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "Native type 'Null' is already defined or reserved.")
      fail("native declarations must preserve the null type marker")
    end
    this.languageCase("tests/contracts/assertion-type-error.hk", 1, "error NR112:", false)
    this.languageCase("tests/contracts/alternatives-default-error.hk", 1, "error NR001:", false)
    this.languageCase("tests/contracts/clock-errors.hk", 1, "error NR153:", false)
    this.languageCase("tests/contracts/shared-callback-errors.hk", 1, "error NR240:", false)
    let sharedErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")
    var rejectedCaptures = 0

    for line in lines(sharedErrors)
      if contains(line, "error NR240:")
        rejectedCaptures = rejectedCaptures + 1
      end
    end
    if rejectedCaptures != 7
      fail("shared callback capture mutation or mutable callback invocation was accepted")
    end
    for diagnostic in ["error NR112:", "error NR125:", "error NR135:"]
      if !contains(sharedErrors, diagnostic)
        fail("missing shared callback diagnostic " + diagnostic)
      end
    end
    for diagnostic in ["error NR125:", "error NR135:"]
      var rejectedUpgrades = 0

      for line in lines(sharedErrors)
        rejectedUpgrades = rejectedUpgrades + 1 if contains(line, diagnostic)
      end
      fail("callback capability upgrade was accepted") if rejectedUpgrades != 2
    end
    this.languageCase("tests/contracts/parallel-callback-errors.hk", 1, "error NR241:", false)
    var rejectedEffects = 0

    for line in lines(requiredText(this.work + "/" + this.lastCase + ".stdout"))
      rejectedEffects = rejectedEffects + 1 if contains(line, "error NR241:")
    end
    fail("parallel callback effect contract was weakened") if rejectedEffects != 5
    this.languageCase("tests/contracts/task-generation-errors.hk", 1, "error NR242:", false)
    let taskErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")
    var taskTypeErrors = 0

    for line in lines(taskErrors)
      taskTypeErrors = taskTypeErrors + 1 if contains(line, "error NR112:") || contains(line, "error NR242:")
    end
    fail("task generation type contracts were weakened") if taskTypeErrors != 5
    this.languageCase("tests/contracts/readonly-errors.hk", 1, "error NR240:", false)
    let readonlyErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")
    var rejectedViews = 0

    for line in lines(readonlyErrors)
      if contains(line, "error NR240:")
        rejectedViews = rejectedViews + 1
      end
    end
    if rejectedViews != 7
      fail("readonly field, nested, array, iteration, method or borrow escape was accepted")
    end
    for diagnostic in ["error NR112:", "error NR125:", "error NR143:"]
      if !contains(readonlyErrors, diagnostic)
        fail("missing readonly conversion diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/native-library.hk", 0, "", true)
    this.languageCase("tests/contracts/cache-metadata.hk", 0, "", true)
    this.languageCase("tests/contracts/native-library-errors.hk", 1, "error NR213:", false)
    this.languageCase("tests/contracts/generic-errors.hk", 1, "error NR221:", false)
    for diagnostic in ["error NR220:", "error NR112:", "error NR142:", "error NR135:", "error NR117:"]
      if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), diagnostic)
        fail("missing generic diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/generic-limit.hk", 1, "error NR222:", false)
    this.genericBudgetCase("generic-budget-across-templates", 70, 70, 0)
    this.genericBudgetCase("generic-budget-one-template", 129, 0, 1)
    this.languageCase("tests/contracts/alternatives-errors.hk", 1, "error NR260:", false)
    if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "error NR261:")
      fail("alternative payload mismatch was not rejected")
    end
    this.languageCase("tests/contracts/propagation.hk", 0, "", true)
    this.languageCase("tests/contracts/propagation-errors.hk", 1, "error NR284:", false)
    let propagationErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    if !contains(propagationErrors, "error NR283:") || !contains(propagationErrors, "error NR245:") || !contains(propagationErrors, "error NR205:")
      fail("malformed propagation declarations were not rejected")
    end
    this.languageCase("tests/contracts/resources-errors.hk", 1, "error NR262:", false)
    let resourceErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["cannot be stored in a field", "cannot be copied;", "cannot capture an owned resource", "cannot be passed to an ordinary call", "cannot be stored in an array", "requires an explicit transfer", "cannot be copied into an alternative payload"]
      fail("missing resource diagnostic: " + diagnostic) if !contains(resourceErrors, diagnostic)
    end
    this.languageCase("tests/contracts/resources-ambiguous-return-errors.hk", 1, "Ambiguous Outcome return", false)
    this.languageCase("tests/contracts/resources-ownership-errors.hk", 1, "Owned resource must be acquired", false)
    let ownershipErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    if !contains(ownershipErrors, "Resource-bearing expressions must be acquired") || !contains(ownershipErrors, "Resource ownership was already transferred or released")
      fail("resource consumption or conditional move checking was weakened")
    end
    this.languageCase("tests/contracts/postfix-if-errors.hk", 1, "error NR007:", false)
    if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "error NR008:")
      fail("inline block if was not rejected")
    end
    this.languageCase("tests/contracts/callback-errors.hk", 1, "error NR212:", false)
    for diagnostic in ["error NR112:", "error NR143:", "error NR108:", "error NR190:", "Cannot capture mutable binding", "cannot capture a raw pointer"]
      if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), diagnostic)
        fail("missing callback diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/quotation-library-error.hk", 1, "Quotation types require 'use quotation'.", false)
    this.languageCase("tests/contracts/field-pack-errors.hk", 1, "error NR277:", false)
    let fieldPackErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["error NR112:", "error NR271:", "error NR278:", "error NR279:"]
      if !contains(fieldPackErrors, diagnostic)
        fail("missing field-pack diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/quotation-errors.hk", 1, "error NR276:", false)
    let quotationErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")

    for diagnostic in ["error NR143:", "error NR212:", "error NR109:", "error NR131:"]
      if !contains(quotationErrors, diagnostic)
        fail("missing quotation diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/quotation-operator-errors.hk", 1, "error NR276:", false)
    let quotationOperatorErrors = requiredText(this.work + "/" + this.lastCase + ".stdout")
    var quotationOperatorRejections = 0

    for line in lines(quotationOperatorErrors)
      quotationOperatorRejections = quotationOperatorRejections + 1 if contains(line, "error NR276:")
    end
    if quotationOperatorRejections != 4 || !contains(quotationOperatorErrors, "quotation-operator-errors.hk:24:27 error NR276: Quoted expression contains unsupported bound operation 'InstanceCall'.") || !contains(quotationOperatorErrors, "quotation-operator-errors.hk:30:26 error NR276: Quoted expression contains unsupported bound operation 'InstanceCall'.")
      fail("quotation accepted a user operator or direct String method call")
    end
    this.languageCase("tests/contracts/inline-callback-error.hk", 1, "Inline fn arguments are not supported", false)
    this.languageCase("tests/contracts/legacy-console-error.hk", 1, "error NR101A:", false)
    this.languageCase("tests/contracts/do-target-error.hk", 1, "A do block must follow a call", false)
    this.languageCase("tests/contracts/do-ending-error.hk", 1, "A do block must finish with end on its own line", false)
    this.languageCase("tests/contracts/top-level-error.hk", 1, "error NR002:", false)
    this.languageCase("tests/golden/frozen-contract-corrections.hk", 1, "error NR127:", false)
    for code in ["NR120", "NR118", "NR113"]
      if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "error " + code + ":")
        fail("missing frozen-contract diagnostic " + code)
      end
    end
    this.languageCase("tests/golden/for-loop-type-mismatch.hk", 1, "error NR148:", false)
    this.languageCase("tests/contracts/optional-error.hk", 1, "error NR169:", false)
    this.languageCase("tests/contracts/overflow.hk", 70, "Neri panic NRP002", false)
    this.languageCase("tests/contracts/bounds.hk", 70, "Neri panic NRP001", false)
  end

  def scalarContracts(): Void
    this.languageCase("tests/contracts/native-pointer-namespaces.hk", 0, "", false)
    this.languageCase("tests/contracts/native-record-errors.hk", 1, "error NR232:", false)
    for diagnostic in ["NR230", "NR231", "NR233", "NR141", "NR142"]
      if !contains(requiredText(this.work + "/" + this.lastCase + ".stdout"), "error " + diagnostic + ":")
        fail("missing native record diagnostic " + diagnostic)
      end
    end
    this.languageCase("tests/contracts/native-scalar-declarations.hk", 0, "", true)
    this.languageCase("tests/contracts/native-scalar-errors.hk", 1, "TypeCheck: FAILED", false)
    for optimization in ["debug", "release"]
      for fixture in ["native-records", "native-scalars", "native-scalar-range"]
        var arguments = this.environment()

        for argument in [this.compiler, "build", this.root + "/tests/contracts/" + fixture + ".hk", "--output", this.work + "/" + fixture]
          arguments = host::appendString(arguments, argument)
        end
        if optimization == "release"
          arguments = host::appendString(arguments, "--release")
        end
        execute("/usr/bin/env", arguments)
      end
      if this.capture([this.work + "/native-scalars"], "native-scalars-" + optimization, 30) != 0
        fail("native scalar representation contract failed")
      end
      if this.capture([this.work + "/native-records"], "native-records-" + optimization, 30) != 0
        fail("native record memory contract failed")
      end
      for index in ["-1", "3"]
        let name = "native-bounds-" + optimization + "-" + index

        if this.capture([this.work + "/native-records", index], name, 30) != 70 || !contains(requiredText(this.work + "/" + name + ".stderr"), "NRP001")
          fail("native array bounds contract failed")
        end
      end
      for failure in ["i32", "u32", "negative", "signed", "float", "nan", "narrow", "add", "subtract", "multiply", "divide", "zero"]
        let name = "scalar-" + optimization + "-" + failure

        if this.capture([this.work + "/native-scalar-range", failure], name, 30) != 70 || !contains(requiredText(this.work + "/" + name + ".stderr"), "NRP002")
          fail("native scalar range check failed: " + name)
        end
      end
    end
  end

  def cAbiExportContracts(): Void
    let directory = this.work + "/cabi-exports"
    let driver = directory + "/driver"
    var arguments = this.environment()

    execute("mkdir", ["-p", directory])
    for argument in [this.compiler, "build", "--project", this.root + "/tests/native/cabi-exports/manifest.json", "--unit", "driver", "--output", driver]
      arguments = host::appendString(arguments, argument)
    end
    execute("/usr/bin/env", arguments)
    var run = this.environment()

    for argument in [driver, this.compiler, this.root, this.nativeDirectory(), this.llvm + "/bin", this.target.name(), directory]
      run = host::appendString(run, argument)
    end
    if this.capture(run, "cabi-exports", 180) != 0
      console::print(requiredText(this.work + "/cabi-exports.stdout"))
      console::print(requiredText(this.work + "/cabi-exports.stderr"))
      fail("C host callback and export contracts failed")
    end
  end

  def selectExistingCompiler(path: String): Void
    this.startWork()
    # Contract drivers need the current native host; runtime contracts also need codegen/runtime.
    this.nativeBuild()
    if this.capture(["realpath", path], "selected-compiler-path", 30) != 0
      fail("cannot resolve selected compiler: " + path)
    end
    let resolved = lines(requiredText(this.work + "/selected-compiler-path.stdout"))

    if resolved.Length != 1
      fail("selected compiler must resolve to one executable path")
    end
    this.compiler = resolved[0]
    execute("test", ["-f", this.compiler])
    execute("test", ["-x", this.compiler])
    var version = this.environment()

    version = host::appendString(version, this.compiler)
    version = host::appendString(version, "--version")
    if this.capture(version, "selected-compiler-version", 30) != 0
      fail("selected compiler version probe failed")
    end
    let expected = lines(requiredText(this.root + "/VERSION"))

    if expected.Length != 1 || requiredText(this.work + "/selected-compiler-version.stdout") != "neri " + expected[0] + "\n"
      fail("selected compiler version does not match this checkout")
    end
    # A successful native compile/run checks the selected target and runtime ABI together.
    this.languageCase("examples/hello.hk", 0, "Hello, Neri!\n", true)
  end

  def selectedTest(command: String, existingCompiler: String = ""): Void
    if existingCompiler == ""
      this.prepareCompiler()
    else
      this.selectExistingCompiler(existingCompiler)
    end
    if command == "smoke-test"
      if existingCompiler == ""
        this.languageCase("examples/hello.hk", 0, "Hello, Neri!\n", true)
      end
      this.runContract()
    else if command == "cabi-test"
      this.cAbiExportContracts()
    else
      this.negativeContracts()
    end
    console::println("[test] Selected contracts passed; published toolchain unchanged")
  end

  def debuggerTest(): Void
    if !this.target.isMacOS()
      fail("debugger-test currently requires macOS LLDB")
    end
    this.prepareCompiler()
    let directory = this.work + "/debugger-contract"
    let source = this.root + "/tests/debugger/fixture.hk"

    execute("mkdir", ["-p", directory])
    var fixture = this.environment()

    for argument in [this.compiler, "build", source, "--target", this.target.name(), "--output", directory + "/fixture"]
      fixture = host::appendString(fixture, argument)
    end
    if this.capture(fixture, "debugger-fixture-build", 30) != 0
      fail("debugger fixture build failed")
    end
    var driver = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "debugger-contracts", "--target", this.target.name(), "--output", directory + "/driver"]
      driver = host::appendString(driver, argument)
    end
    if this.capture(driver, "debugger-driver-build", 30) != 0
      fail("debugger driver build failed")
    end
    if this.capture([directory + "/driver", directory + "/fixture"], "debugger-contract", 60) != 0
      console::print(requiredText(this.work + "/debugger-contract.stdout"))
      console::print(requiredText(this.work + "/debugger-contract.stderr"))
      fail("LLDB source debugging contract failed")
    end
    console::println("[test] LLDB source debugging contract passed; published toolchain unchanged")
  end
end

def main(): Void
  let root = envOr("NERI_ROOT", "")
  let seed = envOr("NERI_SEED_DIR", "")
  let llvm = envOr("LLVM_PREFIX", "")

  if root == "" || seed == "" || llvm == ""
    fail("launcher must set NERI_ROOT, NERI_SEED_DIR, and LLVM_PREFIX")
  end
  var command = "doctor"
  var mode = BuildMode.release()
  var prefix = ""
  var existingCompiler = ""
  var fullValidation = false
  let first = host::argumentAt(0)

  if first != null
    command = first
  end
  var stage = command == "package" || command == "install" ? 2 : 1

  stage = 3 if command == "refresh-seed"
  var stageSpecified = false
  var modeSpecified = false
  var prefixSpecified = false
  var index = 1

  while index < host::argumentCount()
    let option = host::argumentAt(index)

    if option == null
      fail("missing build option")
      return
    end
    if option == "--full-validation"
      if fullValidation || (command != "package" && command != "install")
        fail("--full-validation is only valid once with package or install")
        return
      end
      fullValidation = true
      index = index + 1
    else if option == "--stage" || option == "--prefix" || option == "--compiler"
      let value = host::argumentAt(index + 1)

      if value == null
        fail(option + " requires a value")
        return
      end
      if option == "--stage"
        if stageSpecified || (value != "1" && value != "2" && value != "3")
          fail("--stage requires exactly one value: 1, 2 or 3")
          return
        end
        stage = value == "1" ? 1 : (value == "2" ? 2 : 3)
        stageSpecified = true
      else if option == "--compiler"
        if existingCompiler != "" || value == ""
          fail("--compiler requires exactly one executable path")
          return
        end
        existingCompiler = value
      else
        if command != "install" || prefixSpecified || value == ""
          fail("--prefix requires one directory and the install command")
          return
        end
        prefix = value
        prefixSpecified = true
      end
      index = index + 2
    else
      let selected = BuildMode.fromOption(option)

      if selected == null || modeSpecified
        fail("unknown or duplicate build mode: " + option)
        return
      end
      mode = selected
      modeSpecified = true
      index = index + 1
    end
  end
  if existingCompiler != "" && (stageSpecified || (command != "smoke-test" && command != "negative-test" && command != "cabi-test"))
    fail("--compiler is only valid for smoke-test, negative-test or cabi-test without --stage")
  end
  if (command == "package" || command == "install") && stage < 2
    fail("package and install require --stage 2 or --stage 3")
  end
  if command == "refresh-seed" && stage != 3
    fail("refresh-seed requires --stage 3")
  end
  if stageSpecified && (command == "native" || command == "native-test" || command == "doctor")
    fail("--stage requires a compiler build command")
  end
  let target = TargetPlatform.parse(envOr("NERI_TARGET", "macos-arm64"))

  if target == null
    fail("NERI_TARGET must name a supported native target")
    return
  end
  let build = new Build(root, seed, llvm, target, mode)

  build.stage = stage
  build.fullValidation = fullValidation

  if mode.usesSanitizer() && command != "native" && command != "native-test" && command != "doctor"
    fail("sanitizers instrument native targets; use native-test with the selected sanitizer")
  end
  if command == "doctor"
    build.doctor()
  else if command == "native"
    build.nativeBuild()
  else if command == "native-test"
    build.nativeTest()
  else if command == "bootstrap" || command == "build"
    build.bootstrap(true)
  else if command == "check" || command == "test"
    build.test()
  else if command == "smoke-test" || command == "negative-test" || command == "cabi-test"
    build.selectedTest(command, existingCompiler)
  else if command == "debugger-test"
    build.debuggerTest()
  else if command == "package"
    build.package()
  else if command == "refresh-seed"
    refreshSeed(build)
  else if command == "install"
    build.install(prefix)
  else if command == "benchmark"
    build.benchmark()
  else
    fail("unknown command: " + command)
  end
  if command != "benchmark"
    build.finishWork()
  end
end
