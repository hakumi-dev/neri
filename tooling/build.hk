  def standardLibraryContracts(): Void
    let directory = this.work + "/stdlib-dependencies"

    execute("mkdir", ["-p", directory])
    let firstWritten = host::writeText(directory + "/discovery_alpha.hk", "use discovery_beta\nnamespace discovery_alpha\ndef answer(): Int\n  return discovery_beta::value()\nend\n")
    let secondWritten = host::writeText(directory + "/discovery_beta.hk", "use discovery_alpha\nnamespace discovery_beta\ndef value(): Int\n  return 42\nend\n")
    let mainWritten = host::writeText(directory + "/main.hk", "use discovery_alpha\nuse test\ndef main(): Void\n  test::assertEqual(discovery_alpha::answer(), 42)\nend\n")

    if !firstWritten || !secondWritten || !mainWritten
      fail("cannot prepare standard-library dependency contract")
    end
    var arguments = this.environment()

    for argument in ["NERI_STDLIB=" + directory, this.compiler, "build", directory + "/main.hk", "--output", directory + "/program"]
      arguments = host::appendString(arguments, argument)
    end
    if this.capture(arguments, "stdlib-core-missing", 30) == 0 || !contains(requiredText(this.work + "/stdlib-core-missing.stdout"), "required standard library core is unavailable")
      fail("a missing core library must produce an actionable diagnostic")
    end
    if !host::writeText(directory + "/core.hk", "namespace core\n")
      fail("cannot prepare incomplete core contract")
    end
    if this.capture(arguments, "stdlib-core-incomplete", 30) == 0 || !contains(requiredText(this.work + "/stdlib-core-incomplete.stdout"), "NR245")
      fail("the core library must supply its registered String class")
    end
    this.copyStandardLibrary(directory, false)
    if this.capture(arguments, "stdlib-dependencies-build", 30) != 0 || this.capture([directory + "/program"], "stdlib-dependencies-run", 30) != 0
      fail("standard-library transitive imports must resolve once, including cycles")
    end
  end

  def effectContracts(): Void
    this.languageCase("tests/contracts/effects.hk", 0, "cycle\nvirtual\ncallback\n", true)
    var arguments = this.environment()

    for argument in [this.compiler, "build", this.root + "/tests/contracts/effects.hk", "--emit=neri-ir", "--output", this.work + "/effects.nir"]
      arguments = host::appendString(arguments, argument)
    end
    if this.capture(arguments, "effects-ir", 30) != 0
      fail("cannot inspect inferred effects")
    end
    var checked = 0

    for line in lines(requiredText(this.work + "/effects.nir"))
      if bytesEqualAt(line, "func ", 0)
        for name in ["cycleFirst", "cycleSecond", "dispatch", "invoke", "untouched", "releaseOnly"]
          if contains(line, "function, \"" + name + "\"]")
            var expected = "effects=[write, may-panic, safepoint]"

            if name == "untouched"
              expected = "effects=[]"
            end
            if name == "releaseOnly"
              expected = "effects=[write, unsafe]"
            end

            if !contains(line, expected)
              fail("incorrect transitive effects for " + name)
            end
            checked = checked + 1
          end
        end
      end
    end
    if checked != 6
      fail("effect contract functions were not emitted")
    end
  end

  def unicodeProjectContracts(): Void
    let directory = this.work + "/水"

    execute("mkdir", ["-p", directory, this.work + "/a"])
    let manifest = directory + "/neri.json"

    if !host::writeText(manifest, "{\"version\":2,\"defaultUnit\":\"main\",\"units\":{\"main\":{\"kind\":\"executable\",\"sources\":[\"main.hk\",\"é.hk\"]}}}\n")
      fail("cannot write Unicode project manifest")
    end
    if !host::writeText(directory + "/main.hk", "use console\ndef main(): Void\n  console::println(answer() as String)\nend\n") || !host::writeText(directory + "/é.hk", "def answer(): Int\n  return 42\nend\n")
      fail("cannot write Unicode project sources")
    end
    for command in ["build", "run", "check"]
      var arguments = this.environment()

      for option in [this.compiler, command, "--project", manifest]
        arguments = host::appendString(arguments, option)
      end
      if command != "run"
        arguments = host::appendString(arguments, "--output")
        arguments = host::appendString(arguments, this.work + "/unicode-" + command)
      end
      let name = "unicode-" + command

      if this.capture(arguments, name, 30) != 0
        fail("Unicode project " + command + ": " + requiredText(this.work + "/" + name + ".stdout") + requiredText(this.work + "/" + name + ".stderr"))
      end
      if command == "run" && requiredText(this.work + "/" + name + ".stdout") != "42\n"
        fail("Unicode project did not execute its helper")
      end
    end
    var outside = this.environment()

    for option in [this.compiler, "check", "--project", manifest, "--source-root", this.work + "/a"]
      outside = host::appendString(outside, option)
    end
    if this.capture(outside, "unicode-outside", 30) != 2 || !contains(requiredText(this.work + "/unicode-outside.stdout"), "source is outside source root: " + directory)
      fail("mismatching source-root prefixes must produce a path diagnostic")
    end
    if !host::writeText(directory + "/é.hk", "def answer(): Int\n  return missingValue\nend\n")
      fail("cannot write Unicode diagnostic fixture")
    end
    var invalid = this.environment()

    for option in [this.compiler, "check", "--project", manifest]
      invalid = host::appendString(invalid, option)
    end
    if this.capture(invalid, "unicode-diagnostic", 30) != 1 || !contains(requiredText(this.work + "/unicode-diagnostic.stdout"), "é.hk:2:")
      fail("Unicode source diagnostics must preserve the filename and line")
    end
  end

  def fileContracts(): Void
    let rootFixture = this.work + "/rooted-files"
    let outsideFixture = this.work + "/outside-files"

    execute("mkdir", ["-p", rootFixture + "/nested", outsideFixture])
    fail("cannot create outside file fixture") if !host::writeText(outsideFixture + "/outside.bin", "outside")
    execute("ln", ["-s", outsideFixture, rootFixture + "/escape"])
    execute("ln", ["-s", outsideFixture + "/outside.bin", rootFixture + "/linked.bin"])
    execute("ln", ["-s", "nested", rootFixture + "/root-link"])
    for mode in [BuildMode.debug(), BuildMode.release()]
      var arguments = this.environment()

      for option in [this.compiler, "build", this.root + "/tests/contracts/files.hk", "--output", this.work + "/files-" + mode.name()]
        arguments = host::appendString(arguments, option)
      end
      arguments = host::appendString(arguments, "--release") if mode.isRelease()
      execute("/usr/bin/env", arguments)
      execute(this.work + "/files-" + mode.name(), [this.work + "/水-é.bin"])
      var rootedArguments = this.environment()

      for option in [this.compiler, "build", this.root + "/tests/contracts/files-root.hk", "--output", this.work + "/files-root-" + mode.name()]
        rootedArguments = host::appendString(rootedArguments, option)
      end
      rootedArguments = host::appendString(rootedArguments, "--release") if mode.isRelease()
      execute("/usr/bin/env", rootedArguments)
      execute(this.work + "/files-root-" + mode.name(), [rootFixture])
    end
  end

  def projectManifestContracts(): Void
    let directory = this.work + "/project-manifest-contract"

    execute("mkdir", ["-p", directory])
    var buildArguments = this.environment()

    for argument in [this.compiler, "build", "--project", this.root + "/manifest.json", "--unit", "project-manifest-contracts", "--output", directory + "/driver"]
      buildArguments = host::appendString(buildArguments, argument)
    end
    execute("/usr/bin/env", buildArguments)
    var runArguments = this.environment()

    for argument in [directory + "/driver", this.compiler, directory + "/fixtures", this.target.name(), this.root]
      runArguments = host::appendString(runArguments, argument)
    end
    if this.capture(runArguments, "project-manifest-contract", 60) != 0
      console::print(requiredText(this.work + "/project-manifest-contract.stdout"))
      console::print(requiredText(this.work + "/project-manifest-contract.stderr"))
      fail("project manifest contract failed")
    end
    let manifest = this.root + "/manifest.json"
    var listed = this.environment()

    for argument in [this.compiler, "project-units", "--project", manifest, "--test-suite", this.root + "/tooling/compiler-contracts.json"]
      listed = host::appendString(listed, argument)
    end
    if this.capture(listed, "compiler-tooling-units", 30) != 0
      fail("cannot list compiler tooling tests")
    end
    let records = lines(requiredText(this.work + "/compiler-tooling-units.stdout"))

    if records.Length == 0
      fail("Project manifest must register compiler tooling tests")
    end
    var arguments = this.environment()

    for argument in [this.compiler, "build-batch", "--project", manifest, "--output-dir", directory, "--timings"]
      arguments = host::appendString(arguments, argument)
    end
    for record in records
      let selected = new ToolingTestCase(record)

      arguments = host::appendString(arguments, "--unit")
      arguments = host::appendString(arguments, selected.name)
    end
    execute("/usr/bin/env", arguments)
    for record in records
      let selected = new ToolingTestCase(record)
      var run = this.environment()

      run = host::appendString(run, directory + "/" + selected.name)
      for argument in selected.resolveArguments(this.root, this.compiler, directory)
        run = host::appendString(run, argument)
      end
      # The host capture interface takes whole seconds; round up the declared
      # millisecond budget rather than silently shortening it.
      if this.capture(run, selected.name, (selected.timeoutMs + 999) / 1000) != 0
        console::print(requiredText(this.work + "/" + selected.name + ".stdout"))
        console::print(requiredText(this.work + "/" + selected.name + ".stderr"))
        fail("Compiler tooling contract failed: " + selected.name)
      end
    end
  end

