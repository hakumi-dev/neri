use result

class TestCatalog
  public cases: CatalogCase[] = []
  public digest: String = ""
  public error: String = ""

  def init(path: String): Void
    let read = files::readBytes(path, 4194304)
    let bytes = read.bytes

    if read.failure != null || read.closeFailure != null || bytes == null
      this.error = "cannot read catalog"
      return
    end
    let options = new json::Options()

    options.maxInputBytes = 4194304
    options.maxOutputBytes = 4194304
    options.maxDepth = 16
    options.maxNodes = 200000
    var parsed: json::Value? = null

    match json::parseBytes(bytes, options)
      case result::Result.Ok(value)
        parsed = value
      case result::Result.Error(failure)
        this.error = "catalog is invalid JSON"
        return
    end
    if parsed == null || parsed.kind() != "object" || parsed.count() != 2 || catalogInteger(parsed, "version") != 1
      this.error = "catalog version or root fields are invalid"
      return
    end
    var canonical = ""

    match json::stringify(parsed, options)
      case result::Result.Ok(value)
        canonical = value
      case result::Result.Error(failure)
        this.error = "cannot encode canonical catalog"
        return
    end
    let stable = canonical
    let canonicalBytes = arrays::generate<Byte>(host::stringByteLength(stable)) do |index|
      return host::stringByteAt(stable, index)
    end
    let hash = crypto::sha256(canonicalBytes).bytes()

    if hash == null
      this.error = "cannot fingerprint catalog"
      return
    end
    let encoded = crypto::encodeHex(hash)

    if encoded == null
      this.error = "cannot encode catalog fingerprint"
      return
    end
    this.digest = encoded
    let items = parsed.get("cases")

    if items == null || items.kind() != "array" || items.count() == 0 || items.count() > 10000
      this.error = "catalog cases are missing or oversized"
      return
    end
    let ids = json::Value.object()
    let reader = this

    this.cases = arrays::generate<CatalogCase>(items.count()) do |index|
      let value = items.at(index)

      if value == null
        reader.error = "catalog has a missing case"
        return new CatalogCase(json::Value.object())
      end
      let selected = new CatalogCase(value)

      if selected.error != "" || !ids.put(selected.id, json::Value.boolean(true))
        reader.error = "invalid or duplicate catalog case: " + selected.id + " " + selected.error
      end
      return selected
    end
  end
end
