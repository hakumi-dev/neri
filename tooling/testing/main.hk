
def main(): Void
  let config = new RunnerConfig()

  if config.error != ""
    console::println(config.error)
    host::exit(2)
    return
  end
  let catalog = new TestCatalog(config.catalog)

  if catalog.error != ""
    console::println(catalog.error)
    host::exit(2)
    return
  end
  let runner = new TestRunner(config, catalog)

  host::exit(runner.run() ? 0 : 1)
end
