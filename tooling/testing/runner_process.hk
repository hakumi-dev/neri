
class RunnerProcess
  public exitCode: Int = -1
  public stdout: String = ""
  public stderr: String = ""
  public error: String = ""
  public durationMs: Int = 0

  def init(
    executable: String,
    arguments: String[],
    directory: String,
    environment: process::EnvironmentEntry[],
    timeoutMs: Int
  ): Void
    let startedAt = clock::milliseconds()

    if startedAt == null
      this.error = "monotonic clock unavailable"
      return
    end
    let deadline = startedAt + timeoutMs
    let options = new process::SpawnOptions(executable)

    options.arguments = arguments
    options.workingDirectory = directory
    options.environment = environment
    options.stdoutLimit = 33554432
    options.stderrLimit = 33554432
    let started = process::spawn(options)
    let failure = started.failure()

    if failure != null
      this.error = "spawn failed: " + failure.code()
      return
    end
    let child = started.child()

    if child == null
      this.error = "spawn returned no child"
      return
    end
    var completed = child.wait(timeoutMs > 60000 ? 60000 : timeoutMs)

    while completed.failure == null && completed.running
      let now = clock::milliseconds()

      if now == null
        this.error = "monotonic clock unavailable during wait"
        break
      end
      let remaining = deadline - now

      if remaining <= 0
        break
      end
      completed = child.wait(remaining > 60000 ? 60000 : remaining)
    end
    if this.error != ""
      child.cancel()
      completed = child.wait(5000)
    else if completed.failure != null
      this.error = "wait failed: " + completed.failure.code()
      child.cancel()
      completed = child.wait(5000)
    else if completed.running
      this.error = "timeout"
      child.cancel()
      completed = child.wait(5000)
    end
    let output = host::stringFromBytes(completed.stdout)
    let errors = host::stringFromBytes(completed.stderr)

    this.stdout = output == null ? "<invalid UTF-8>" : output
    this.stderr = errors == null ? "<invalid UTF-8>" : errors
    if output == null || errors == null
      this.error = "process output is not UTF-8" if this.error == ""
    end
    if completed.stdoutTruncated || completed.stderrTruncated
      this.error = "output truncated" if this.error == ""
    end
    let exit = completed.exit

    if exit != null && exit.isExited()
      this.exitCode = exit.value()
    else if this.error == ""
      this.error = "process did not exit normally"
    end
    if !child.dispose()
      this.error = "process disposal failed"
    end
    let endedAt = clock::milliseconds()

    if endedAt != null && endedAt >= startedAt
      this.durationMs = endedAt - startedAt
    end
  end
end
