use json
use host

def catalogField(value: json::Value, name: String): json::Value?
  return value.get(name)
end

def catalogString(value: json::Value, name: String, fallback: String = ""): String
  let item = value.get(name)

  if item == null || item.kind() != "string"
    return fallback
  end
  let text = item.text()

  return text == null ? fallback : text
end

def catalogBoolean(value: json::Value, name: String, fallback: Bool = false): Bool
  let item = value.get(name)

  if item == null || item.kind() != "boolean"
    return fallback
  end
  return item.text() == "true"
end

def catalogInteger(value: json::Value, name: String, fallback: Int = 0): Int
  let item = value.get(name)

  if item == null || item.kind() != "number"
    return fallback
  end
  let text = item.text()
  let parsed = text == null ? null : host::parseInt(text)

  return parsed == null ? fallback : parsed
end

def catalogStrings(value: json::Value, name: String): String[]?
  let item = value.get(name)

  if item == null
    let empty: String[] = []

    return empty
  end
  if item.kind() != "array"
    return null
  end
  var output: String[] = []
  var index = 0

  while index < item.count()
    let entry = item.at(index)

    if entry == null || entry.kind() != "string"
      return null
    end
    let text = entry.text()

    if text == null
      return null
    end
    output = host::appendString(output, text)
    index = index + 1
  end
  return output
end

def catalogIncludes(values: String[], expected: String): Bool
  for value in values
    if value == expected
      return true
    end
  end
  return false
end

def catalogContains(value: String, part: String): Bool
  if part == ""
    return true
  end
  let size = host::stringByteLength(part)
  let length = host::stringByteLength(value)
  var index = 0

  while index + size <= length
    if host::stringSlice(value, index, size) == part
      return true
    end
    index = index + 1
  end
  return false
end

def catalogCount(value: String, part: String): Int
  if part == ""
    return 0
  end
  let size = host::stringByteLength(part)
  let length = host::stringByteLength(value)
  var index = 0
  var count = 0

  while index + size <= length
    if host::stringSlice(value, index, size) == part
      count = count + 1
      index = index + size
    else
      index = index + 1
    end
  end
  return count
end
