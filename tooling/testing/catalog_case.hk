
class CatalogCase
  public id: String = ""
  public kind: String = ""
  public sources: String[] = []
  public unit: String = ""
  public adapter: String = ""
  public arguments: String[] = []
  public command: String = "run"
  public releaseMode: String = "inherit"
  public targets: String[] = []
  public capabilities: String[] = []
  public requiredForRelease: Bool = false
  public requiredTargets: String[] = []
  public timeoutMs: Int = 30000
  public expectedExit: Int = 0
  public stdoutExact: String?
  public stderrExact: String?
  public outputContains: String?
  public assertions: json::Value?
  public error: String = ""

  def init(value: json::Value): Void
    if value.kind() != "object"
      this.error = "case is not an object"
      return
    end
    this.id = catalogString(value, "id")
    this.kind = catalogString(value, "kind")
    this.unit = catalogString(value, "unit")
    this.adapter = catalogString(value, "adapter")
    this.command = catalogString(value, "command", "run")
    this.releaseMode = catalogString(value, "releaseMode", "inherit")
    this.requiredForRelease = catalogBoolean(value, "requiredForRelease")
    this.timeoutMs = catalogInteger(value, "timeoutMs", 30000)
    let sources = catalogStrings(value, "sources")
    let arguments = catalogStrings(value, "args")
    let targets = catalogStrings(value, "targets")
    let capabilities = catalogStrings(value, "capabilities")
    let requiredTargets = catalogStrings(value, "requiredOn")

    if sources == null || arguments == null || targets == null || capabilities == null || requiredTargets == null
      this.error = "case array has a non-string element"
      return
    end
    this.sources = sources
    this.arguments = arguments
    this.targets = targets
    this.capabilities = capabilities
    this.requiredTargets = requiredTargets
    let expected = value.get("expected")

    if expected != null
      if expected.kind() != "object"
        this.error = "expected must be an object"
        return
      end
      this.expectedExit = catalogInteger(expected, "exit")
      let stdout = expected.get("stdoutExact")
      let stderr = expected.get("stderrExact")
      let output = expected.get("outputContains")

      if (stdout != null && stdout.kind() != "string") || (stderr != null && stderr.kind() != "string") || (output != null && output.kind() != "string")
        this.error = "expected output fields must be strings"
        return
      end
      this.stdoutExact = stdout == null ? null : stdout.text()
      this.stderrExact = stderr == null ? null : stderr.text()
      this.outputContains = output == null ? null : output.text()
    end
    this.assertions = value.get("assertions")
    let assertions = this.assertions

    if assertions != null && assertions.kind() != "array"
      this.error = "assertions must be an array"
    end
    if this.id == "" || (this.kind != "language" && this.kind != "unit" && this.kind != "external") || this.timeoutMs < 1 || this.timeoutMs > 3600000
      this.error = "invalid case id, kind or timeout"
    end
    if this.kind == "language" && (this.sources.Length == 0 || (this.command != "run" && this.command != "check") || (this.releaseMode != "inherit" && this.releaseMode != "always" && this.releaseMode != "never"))
      this.error = "invalid language command or sources"
    end
    if this.kind == "unit" && this.unit == ""
      this.error = "unit case lacks unit name"
    end
    if this.kind == "external" && this.adapter == ""
      this.error = "external case lacks adapter"
    end
  end

  def required(target: String, release: Bool): Bool
    return release && (catalogIncludes(
        this.requiredTargets,
        target
      ) || (this.requiredForRelease && this.requiredTargets.Length == 0))
  end
end
