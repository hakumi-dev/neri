use result

class RunnerResult
  public id: String
  public status: String = "pending"
  public reason: String = ""
  public exitCode: Int = -1
  public stdout: String = ""
  public stderr: String = ""
  public executed: Bool = false
  public durationMs: Int = 0

  def init(id: String): Void
    this.id = id
  end

  def jsonLine(): String
    let value = json::Value.object()

    value.put("id", json::Value.string(this.id))
    value.put("status", json::Value.string(this.status))
    value.put("reason", json::Value.string(this.reason))
    let code = json::Value.number(this.exitCode as String)
    let duration = json::Value.number(this.durationMs as String)

    value.put("exit", code) if code != null
    value.put("durationMs", duration) if duration != null
    match json::stringify(value)
      case result::Result.Ok(text)
        return text + "\n"
      case result::Result.Error(failure)
        return ""
    end
  end
end
