use host

class RunnerConfig
  public target: String = ""
  public root: String = ""
  public compiler: String = ""
  public nativeDirectory: String = ""
  public work: String = ""
  public catalog: String = ""
  public release: Bool = false
  public filter: String = ""
  public capabilities: String[] = []
  public adapterNames: String[] = []
  public adapterPaths: String[] = []
  public error: String = ""

  def init(): Void
    var index = 0

    while index < host::argumentCount()
      let key = host::argumentAt(index)

      if key == "--release"
        this.release = true
        index = index + 1
        continue
      end
      let value = host::argumentAt(index + 1)

      if key == null || value == null
        this.error = "missing runner option value"
        return
      end
      if key == "--target"
        this.target = value
      else if key == "--root"
        this.root = value
      else if key == "--compiler"
        this.compiler = value
      else if key == "--native"
        this.nativeDirectory = value
      else if key == "--work"
        this.work = value
      else if key == "--catalog"
        this.catalog = value
      else if key == "--filter"
        this.filter = value
      else if key == "--capability"
        this.capabilities = host::appendString(this.capabilities, value)
      else if key == "--adapter"
        let separator = catalogSeparator(value)

        if separator < 1 || separator + 1 >= host::stringByteLength(value)
          this.error = "--adapter requires name=path"
          return
        end
        this.adapterNames = host::appendString(this.adapterNames, host::stringSlice(value, 0, separator))
        this.adapterPaths = host::appendString(
          this.adapterPaths,
          host::stringSlice(value, separator + 1, host::stringByteLength(value) - separator - 1)
        )
      else
        this.error = "unknown runner option: " + key
        return
      end
      index = index + 2
    end
    if (this.target != "macos-arm64" && this.target != "linux-x86_64" && this.target != "windows-x86_64") || this.root == "" || this.compiler == "" || this.nativeDirectory == "" || this.work == "" || this.catalog == ""
      this.error = "runner requires target, root, compiler, native, work and catalog"
    end
  end

  def adapterPath(name: String): String
    var index = 0

    while index < this.adapterNames.Length
      if this.adapterNames[index] == name
        return this.adapterPaths[index]
      end
      index = index + 1
    end
    return ""
  end
end

def catalogSeparator(text: String): Int
  var index = 0

  while index < host::stringByteLength(text)
    if host::stringByteAt(text, index) == (61 as Byte)
      return index
    end
    index = index + 1
  end
  return -1
end
