use console
use host

# Tooling is compiled by the trusted seed without compiler-internal helpers.
# Keep output fragments linked, then join them as a balanced tree so manifests
# do not repeatedly copy their complete prefix.
class ToolingTextNode
  public value: String
  public next: ToolingTextNode?

  def init(value: String): Void
    this.value = value
  end
end

class ToolingTextBuffer
  public first: ToolingTextNode?
  public last: ToolingTextNode?
  public count: Int = 0

  def add(value: String): Void
    let node = new ToolingTextNode(value)
    let tail = this.last

    if tail == null
      this.first = node
    else
      tail.next = node
    end
    this.last = node
    this.count = this.count + 1
  end
end

def toolingTextJoin(node: ToolingTextNode?, count: Int): String
  if node == null || count == 0
    return ""
  end
  if count == 1
    return node.value
  end
  let leftCount = count / 2
  var right = node
  var index = 0

  while index < leftCount
    let next = right.next

    if next != null
      right = next
    end
    index = index + 1
  end
  return toolingTextJoin(node, leftCount) + toolingTextJoin(right, count - leftCount)
end

def toolingText(buffer: ToolingTextBuffer): String
  return toolingTextJoin(buffer.first, buffer.count)
end

def toolingFind(text: String, part: String, offset: Int): Int
  var index = offset

  while index + host.stringByteLength(part) <= host.stringByteLength(text)
    if bytesEqualAt(text, part, index)
      return index
    end
    index = index + 1
  end
  return -1
end

# Package documentation keeps a deliberate public list. Relative Markdown
# targets must remain within that list; parent-directory and remote links are
# delivered or resolved outside the documentation tree.
def packageDocumentationLinkError(document: String, text: String, documents: String[]): String
  var offset = 0

  while offset < host.stringByteLength(text)
    let open = toolingFind(text, "](", offset)

    if open < 0
      return ""
    end
    let start = open + 2
    let close = toolingFind(text, ")", start)

    if close < 0
      return ""
    end
    let raw = host.stringSlice(text, start, close - start)
    let anchor = toolingFind(raw, "#", 0)
    let target = anchor < 0 ? raw : host.stringSlice(raw, 0, anchor)

    if target != "" && !bytesEqualAt(target, "../", 0) && toolingFind(target, "://", 0) < 0 && endsWith(target, ".md")
      var present = false

      for candidate in documents
        present = true if candidate == target
      end
      if !present
        return "package documentation link is not packaged: " + document + " -> " + target
      end
    end
    offset = close + 1
  end
  return ""
end

def packagedDocuments(): String[]
  return ["LANGUAGE.md", "ABI.md", "ARCHITECTURE.md", "PERFORMANCE.md", "HTTP.md", "TERMINAL.md", "FILES.md", "CLOCK.md", "BUFFERS.md", "CRYPTO.md", "RESULT.md", "PROCESS.md", "CHANGES.md", "SESSIONS.md", "TEXT.md"]
end

def packagedDocumentsVerified(root: String): String[]
  let documents = packagedDocuments()

  for document in documents
    let text = host.readText(root + "/docs/" + document)

    if text == null
      fail("package document is unavailable: " + document)
    else
      let error = packageDocumentationLinkError(document, text, documents)

      fail(error) if error != ""
    end
  end
  return documents
end

# Large filesystem inventories are consumed once. Keep them as source text
# instead of materializing an array through repeated appendString calls.
class ToolingLineCursor
  private text: String
  private position: Int = 0

  def init(text: String): Void
    this.text = text
  end

  def next(): String?
    if this.position >= host.stringByteLength(this.text)
      return null
    end
    let start = this.position

    while this.position < host.stringByteLength(this.text) && (host.stringByteAt(this.text, this.position) as Int) != 10
      this.position = this.position + 1
    end
    let result = host.stringSlice(this.text, start, this.position - start)

    this.position = this.position + 1 if this.position < host.stringByteLength(this.text)
    return result
  end
end

def fail(message: String): Void
  console.println("[neri tooling] ERROR: " + message)
  host.exit(1)
end

def requiredText(path: String): String
  let value = host.readText(path)

  if value == null
    fail("cannot read " + path + ": " + host.errorMessage())
    return ""
  end
  return value
end

def envOr(name: String, fallback: String): String
  let value = host.environment(name)

  if value != null && value != ""
    return value
  end
  return fallback
end

def lines(text: String): String[]
  var result: String[] = []
  var start = 0
  var index = 0

  while index < host.stringByteLength(text)
    if (host.stringByteAt(text, index) as Int) == 10
      result = host.appendString(result, host.stringSlice(text, start, index - start))
      start = index + 1
    end
    index = index + 1
  end
  if start < index
    result = host.appendString(result, host.stringSlice(text, start, index - start))
  end
  return result
end

def bytesEqualAt(text: String, part: String, offset: Int): Bool
  if offset < 0 || offset + host.stringByteLength(part) > host.stringByteLength(text)
    return false
  end
  var index = 0

  while index < host.stringByteLength(part)
    if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
      return false
    end
    index = index + 1
  end
  return true
end

def contains(text: String, part: String): Bool
  var index = 0

  while index + host.stringByteLength(part) <= host.stringByteLength(text)
    if bytesEqualAt(text, part, index)
      return true
    end
    index = index + 1
  end
  return false
end

def endsWith(text: String, suffix: String): Bool
  let offset = host.stringByteLength(text) - host.stringByteLength(suffix)

  return bytesEqualAt(text, suffix, offset)
end

def execute(executable: String, arguments: String[]): Void
  let status = host.run(executable, arguments)

  if status == null
    fail("cannot start " + executable + ": " + host.errorMessage())
  else if status != 0
    fail(executable + " exited " + (status as String))
  end
end
