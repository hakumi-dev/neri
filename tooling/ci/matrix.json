{
  "schemaVersion": 1,
  "name": "Neri local supported-platform CI",
  "sourcePolicy": "one fresh guest checkout per job from the same tracked and untracked working-tree snapshot",
  "schedule": "sequential",
  "jobs": [
    {
      "id": "macos-release-package",
      "provider": "macos-tart",
      "os": "macOS 15",
      "architecture": "arm64",
      "timeoutMinutes": 60,
      "setup": "macos-package",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "macos-release-package"
      ],
      "platform": "macos",
      "runner": "macos-15"
    },
    {
      "id": "macos-native-debug",
      "provider": "macos-tart",
      "os": "macOS 15",
      "architecture": "arm64",
      "timeoutMinutes": 30,
      "setup": "macos-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "macos-native-debug"
      ],
      "platform": "macos",
      "runner": "macos-15"
    },
    {
      "id": "macos-native-sanitize",
      "provider": "macos-tart",
      "os": "macOS 15",
      "architecture": "arm64",
      "timeoutMinutes": 30,
      "setup": "macos-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "macos-native-sanitize"
      ],
      "platform": "macos",
      "runner": "macos-15"
    },
    {
      "id": "macos-native-thread-sanitize",
      "provider": "macos-tart",
      "os": "macOS 15",
      "architecture": "arm64",
      "timeoutMinutes": 30,
      "setup": "macos-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "macos-native-thread-sanitize"
      ],
      "platform": "macos",
      "runner": "macos-15"
    },
    {
      "id": "linux-release-package",
      "provider": "linux-lima-qemu",
      "os": "Ubuntu 24.04",
      "architecture": "x86_64",
      "timeoutMinutes": 60,
      "setup": "linux-package",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "linux-release-package"
      ],
      "platform": "linux",
      "runner": "ubuntu-24.04"
    },
    {
      "id": "linux-native-debug",
      "provider": "linux-lima-qemu",
      "os": "Ubuntu 24.04",
      "architecture": "x86_64",
      "timeoutMinutes": 30,
      "setup": "linux-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "linux-native-debug"
      ],
      "platform": "linux",
      "runner": "ubuntu-24.04"
    },
    {
      "id": "linux-native-sanitize",
      "provider": "linux-lima-qemu",
      "os": "Ubuntu 24.04",
      "architecture": "x86_64",
      "timeoutMinutes": 30,
      "setup": "linux-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "linux-native-sanitize"
      ],
      "platform": "linux",
      "runner": "ubuntu-24.04"
    },
    {
      "id": "linux-native-thread-sanitize",
      "provider": "linux-lima-qemu",
      "os": "Ubuntu 24.04",
      "architecture": "x86_64",
      "timeoutMinutes": 30,
      "setup": "linux-native",
      "argv": [
        "bash",
        "scripts/ci/jobs.sh",
        "run",
        "linux-native-thread-sanitize"
      ],
      "platform": "linux",
      "runner": "ubuntu-24.04"
    },
    {
      "id": "windows-release-install",
      "provider": "windows-qemu-tcg",
      "os": "Windows Server 2025",
      "architecture": "x86_64",
      "timeoutMinutes": 35,
      "setup": "windows-release",
      "argv": [
        "pwsh",
        "-NoProfile",
        "-File",
        "scripts/ci/jobs.ps1",
        "-Action",
        "run",
        "-Job",
        "windows-release-install"
      ],
      "platform": "windows",
      "runner": "windows-2025"
    },
    {
      "id": "windows-native-debug",
      "provider": "windows-qemu-tcg",
      "os": "Windows Server 2025",
      "architecture": "x86_64",
      "timeoutMinutes": 35,
      "setup": "windows-native-debug",
      "argv": [
        "pwsh",
        "-NoProfile",
        "-File",
        "scripts/ci/jobs.ps1",
        "-Action",
        "run",
        "-Job",
        "windows-native-debug"
      ],
      "platform": "windows",
      "runner": "windows-2025"
    }
  ]
}
