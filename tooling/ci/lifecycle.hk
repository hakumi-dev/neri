use console
use files
use host
use json

def containsString(values: String[], expected: String): Bool
  for value in values
    if value == expected
      return true
    end
  end
  return false
end

def cleanupProvider(
  assetDir: String,
  stateDir: String,
  configPath: String,
  provider: String,
  job: json::Value,
  archive: String,
  sourceHash: String,
  instance: String
): Bool
  let stopped = providerRequest(
    assetDir,
    stateDir,
    configPath,
    provider,
    "stop",
    job,
    archive,
    sourceHash,
    60000,
    "",
    instance
  )
  let destroyed = providerRequest(
    assetDir,
    stateDir,
    configPath,
    provider,
    "destroy",
    job,
    archive,
    sourceHash,
    60000,
    "",
    instance
  )

  return actionStatus(stopped) == "completed" && actionStatus(destroyed) == "completed"
end

def runGuestJob(
  assetDir: String,
  stateDir: String,
  configPath: String,
  provider: String,
  job: json::Value,
  archive: String,
  sourceHash: String,
  instance: String,
  startedAt: Int,
  deadline: Int
): String
  let prepared = providerRequest(
    assetDir,
    stateDir,
    configPath,
    provider,
    "exec",
    job,
    archive,
    sourceHash,
    remaining(startedAt, deadline),
    "prepare",
    instance
  )
  let preparation = actionStatus(prepared)

  if preparation != "completed"
    console::println("prepare " + preparation + ": " + actionReason(prepared))
    return preparation == "pending" ? "pending" : "failed"
  end
  let executed = providerRequest(
    assetDir,
    stateDir,
    configPath,
    provider,
    "exec",
    job,
    archive,
    sourceHash,
    remaining(startedAt, deadline),
    "run",
    instance
  )
  let execution = actionStatus(executed)

  if execution != "completed"
    console::println("run " + execution + ": " + actionReason(executed))
    return execution == "pending" ? "pending" : "failed"
  end
  return "passed"
end

def archiveReady(stateDir: String): String?
  let path = host::environment("NERI_CI_SOURCE_ARCHIVE")
  let expected = host::environment("NERI_CI_SOURCE_SHA256")

  if path == null
    let root = host::environment("NERI_CI_SOURCE_ROOT")

    if root == null || !absolute(root)
      return null
    end
    let destination = stateDir + "/source.tar"
    let created = snapshotCreate(root, destination)

    return created == null ? null : destination
  end
  if expected == null || !absolute(path) || expected.byteLength() != 64
    return null
  end
  let result = runProcess("shasum", ["-a", "256", path], 60000)

  if result == null || result.failure != null || result.stdoutTruncated
    return null
  end
  let exit = result.exit
  let stdout = outputText(result.stdout)

  if exit == null || !exit.isExited() || exit.value() != 0 || stdout.byteLength() < 65
    return null
  end
  let actual = host::stringSlice(stdout, 0, 64)

  return actual == expected ? path : null
end
