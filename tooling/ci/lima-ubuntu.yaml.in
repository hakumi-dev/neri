arch: "x86_64"
vmType: "qemu"
cpus: 4
memory: "8GiB"
disk: "80GiB"
mounts: []
images:
  - location: "@UBUNTU_IMAGE_URL@"
    arch: "x86_64"
    digest: "sha256:@UBUNTU_IMAGE_SHA256@"
ssh:
  loadDotSSHPubKeys: false
provision:
  - mode: system
    script: |
      #!/bin/sh
      set -eu
      test "$(uname -m)" = x86_64
      . /etc/os-release
      test "$VERSION_ID" = 24.04
      install -d -m 0755 /etc/apt/sources.list.d
      # Cloud images ship a mutable ubuntu.sources. Replace it so apt never
      # silently combines the pinned snapshot with current archive metadata.
      cat >/etc/apt/sources.list.d/ubuntu.sources <<'EOF'
      Types: deb
      URIs: https://snapshot.ubuntu.com/ubuntu/@APT_SNAPSHOT@/
      Suites: noble noble-updates noble-backports noble-security
      Components: main universe restricted multiverse
      Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
      Check-Valid-Until: no
      EOF
      find /etc/apt/sources.list.d -maxdepth 1 -type f ! -name ubuntu.sources -delete
      rm -f /etc/apt/sources.list
      apt-get update
      DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl gnupg lsb-release software-properties-common cmake ninja-build build-essential zlib1g-dev libzstd-dev libedit-dev libffi-dev libxml2-dev libssl-dev libsqlite3-dev libarchive-tools
