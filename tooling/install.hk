use host
use ConsoleInteraction

def main(): Void
  let package = envOr("NERI_PACKAGE_ROOT", "")
  if package == "" fail("use the package install.sh launcher") end
  let userDirectory = envOr("HOME", "")
  if userDirectory == "" && host.argumentCount() == 0 fail("HOME or --prefix is required") end
  var prefix = userDirectory + "/.neri"
  if host.argumentCount() != 0
    let option = host.argumentAt(0)
    let value = host.argumentAt(1)
    if host.argumentCount() != 2 || option == null || option != "--prefix" || value == null
      fail("usage: install.sh [--prefix <directory>]")
    else prefix = value end
  end
  let absolute = host.pathAbsolute(prefix)
  if absolute == null fail("invalid installation prefix") return end
  prefix = absolute
  execute("mkdir", ["-p", prefix + "/bin", prefix + "/toolchains"])
  let temporary = bootstrapTemporaryDirectory(prefix, ".install")
  if temporary == null fail("cannot create installation staging directory") return end
  let helper = package + "/libexec/neri-host"
  execute(helper, ["run", "30", temporary + "/prefix", temporary + "/prefix.stderr", temporary + "/prefix.status",
    "/usr/bin/env", "-C", prefix, "/bin/pwd", "-P"])
  let resolved = lines(requiredText(temporary + "/prefix"))
  if requiredText(temporary + "/prefix.status") != "0\n" || resolved.Length != 1 fail("cannot resolve installation prefix") end
  prefix = resolved[0]
  if prefix == package || bytesEqualAt(prefix, package + "/", 0)
    fail("installation prefix must be outside the source package")
  end
  execute("/usr/bin/env", ["-C", package, "shasum", "-a", "256", "-c", "ARTIFACTS.sha256"])
  execute(helper, ["run", "30", temporary + "/hash", temporary + "/hash.stderr", temporary + "/hash.status",
    "shasum", "-a", "256", package + "/ARTIFACTS.sha256"])
  if requiredText(temporary + "/hash.status") != "0\n" fail("cannot hash package manifest") end
  let hash = requiredText(temporary + "/hash")
  if host.stringByteLength(hash) < 64 fail("invalid package hash") end
  let id = host.stringSlice(hash, 0, 64)
  let destination = prefix + "/toolchains/" + id
  let current = prefix + "/bin/neri"
  let exists = host.run("test", ["-e", current])
  let link = host.run("test", ["-L", current])
  if exists == null || link == null fail("cannot inspect installation destination") return end
  if exists == 0 || link == 0
    if link != 0 fail("refusing to replace an existing non-symlink: " + current) end
    execute(helper, ["run", "30", temporary + "/link", temporary + "/link.stderr", temporary + "/link.status", "readlink", current])
    if requiredText(temporary + "/link.status") != "0\n" || !bytesEqualAt(requiredText(temporary + "/link"), "../toolchains/", 0)
      fail("refusing to replace an unrelated symlink: " + current)
    end
  end
  execute("cp", ["-R", package, temporary + "/package"])
  execute("/usr/bin/env", ["-C", temporary + "/package", "shasum", "-a", "256", "-c", "ARTIFACTS.sha256"])
  let installed = host.run("test", ["-d", destination])
  if installed == null fail("cannot inspect installed toolchain")
  else if installed == 0
    execute("cmp", [package + "/ARTIFACTS.sha256", destination + "/ARTIFACTS.sha256"])
    execute("/usr/bin/env", ["-C", destination, "shasum", "-a", "256", "-c", "ARTIFACTS.sha256"])
  else
    execute(helper, ["replace", temporary + "/package", destination])
  end
  execute(destination + "/bin/neri", ["--version"])
  execute("ln", ["-s", "../toolchains/" + id + "/bin/neri", temporary + "/neri"])
  execute(helper, ["replace", temporary + "/neri", current])
  execute("rm", ["-r", temporary])
  ConsoleInteraction.println("[install] Installed " + current)
  ConsoleInteraction.println("[install] Add " + prefix + "/bin to PATH. Shell configuration was not changed.")
end
