class DataEntity
  public typeName: String = ""
  public generatedName: String = ""
  public setName: String = ""
  public tableName: String = ""
  public keyless: Bool = false
  public view: Bool = false
  public readView: String = ""
  public snapshotEqual: String = ""
  public syntheticJoin: Bool = false
  public queryFilter: String = ""
  public firstQueryFilter: DataQueryFilter?
  public lastQueryFilter: DataQueryFilter?
  public discriminatorColumn: String = ""
  public hierarchyStrategy: String = ""
  public hierarchyParent: String = ""
  public hierarchyLocalMembers: StringBuffer = new StringBuffer()
  public discriminatorValue: String = ""
  public firstDerived: DataDerived?
  public lastDerived: DataDerived?
  public firstSeed: DataSeed?
  public lastSeed: DataSeed?
  public keyMember: String = ""
  public keyMembers: StringBuffer = new StringBuffer()
  public generatedKey: Bool = false
  public concurrencyColumns: StringBuffer?
  public initializeWithFields: Bool = true
  public symbol: SemanticClass?
  public initializer: SemanticCallable?
  public declaration: SemanticDeclaration?
  public origin: DataOrigin = new DataOrigin()
  public firstField: DataField?
  public lastField: DataField?
  public firstComplex: DataComplex?
  public lastComplex: DataComplex?
  public firstIndex: DataIndex?
  public lastIndex: DataIndex?
  public nextEntity: DataEntity?

  def isKeyMember(member: String): Bool
    if this.keyMembers.size == 0
      return member == this.keyMember
    end
    var index = 0

    while index < this.keyMembers.size
      return true if this.keyMembers.get(index) == member
      index = index + 1
    end
    return false
  end

  def addSeed(seed: DataSeed): Void
    let last = this.lastSeed

    if last == null
      this.firstSeed = seed
    else
      last.nextSeed = seed
    end
    this.lastSeed = seed
  end

  def addQueryFilter(filter: DataQueryFilter): Void
    let last = this.lastQueryFilter

    if last == null
      this.firstQueryFilter = filter
    else
      last.nextFilter = filter
    end
    this.lastQueryFilter = filter
  end

  def addField(field: DataField): Void
    let last = this.lastField

    if last == null
      this.firstField = field
    else
      last.nextField = field
    end
    this.lastField = field
  end

  def complex(member: String): DataComplex?
    var current = this.firstComplex

    while current != null
      return current if current.memberName == member
      current = current.nextComplex
    end
    return null
  end

  def addComplex(value: DataComplex): Void
    let last = this.lastComplex

    if last == null
      this.firstComplex = value
    else
      last.nextComplex = value
    end
    this.lastComplex = value
  end

  def addDerived(value: DataDerived): Void
    let last = this.lastDerived

    if last == null
      this.firstDerived = value
    else
      last.nextDerived = value
    end
    this.lastDerived = value
  end

  def field(member: String): DataField?
    var current = this.firstField

    while current != null
      if current.memberName == member
        return current
      end
      current = current.nextField
    end
    return null
  end

  def addIndex(index: DataIndex): Void
    let last = this.lastIndex

    if last == null
      this.firstIndex = index
    else
      last.nextIndex = index
    end
    this.lastIndex = index
  end
end
