class DataEntity
  public typeName: String = ""
  public generatedName: String = ""
  public setName: String = ""
  public tableName: String = ""
  public keyMember: String = ""
  public initializeWithFields: Bool = true
  public symbol: SemanticClass?
  public initializer: SemanticCallable?
  public declaration: SemanticDeclaration?
  public origin: DataOrigin = new DataOrigin()
  public firstField: DataField?
  public lastField: DataField?
  public nextEntity: DataEntity?

  def addField(field: DataField): Void
    let last = this.lastField

    if last == null
      this.firstField = field
    else
      last.nextField = field
    end
    this.lastField = field
  end

  def field(member: String): DataField?
    var current = this.firstField

    while current != null
      if current.memberName == member
        return current
      end
      current = current.nextField
    end
    return null
  end
end
