def dataParseIndexFacets(
  mapping: DataMapping,
  entity: DataEntity,
  index: DataIndex,
  node: LspJson,
  context: String
): Bool
  index.predicate = dataSqlFacet(mapping, node, "predicate", context)
  let expressions = node.get("expressions")
  let descending = node.get("descending")
  let included = node.get("include")

  for key in ["expressions", "descending", "include"]
    let values = node.get(key)

    if !values.isMissing() && !values.isArray()
      return mapping.fail(context + "." + key + " must be an array.")
    end
  end
  var expression = expressions.first

  while expression != null
    if !expression.isString() || expression.scalarText() == ""
      return mapping.fail(context + ".expressions requires trusted nonempty SQL expressions.")
    end
    index.expressions.add(expression.scalarText())
    expression = expression.next
  end
  var direction = descending.first

  while direction != null
    if !direction.isBoolean()
      return mapping.fail(context + ".descending requires Boolean values.")
    end
    index.descending.add(direction.isTrue() ? "true" : "false")
    direction = direction.next
  end
  var member = included.first

  while member != null
    if !member.isString()
      return mapping.fail(context + ".include requires mapped member names.")
    end
    let field = entity.field(member.scalarText())

    if field == null
      return mapping.fail(context + ".include contains an unknown mapped member.")
    end
    index.included.add(dataFieldIdentity(field))
    member = member.next
  end
  let count = index.fields.size + index.expressions.size

  if count == 0 || (index.descending.size > 0 && index.descending.size != count)
    return mapping.fail(context + " requires at least one member or expression and one direction per indexed term when descending is supplied.")
  end
  return mapping.error == ""
end

def dataIndexFacetsCode(index: DataIndex): String
  var result = ""

  if index.descending.size > 0
    result = result + ", descending: ["
    var position = 0

    while position < index.descending.size
      result = result + (position == 0 ? "" : ", ") + index.descending.get(position)
      position = position + 1
    end
    result = result + "]"
  end
  if index.predicate != ""
    result = result + ", predicate: " + lspQuote(index.predicate)
  end
  if index.expressions.size > 0
    result = result + ", expressions: " + dataStringArrayCode(index.expressions)
  end
  if index.included.size > 0
    result = result + ", include: " + dataStringArrayCode(index.included)
  end
  return result
end

def dataStringArrayCode(values: StringBuffer): String
  var result = "["
  var position = 0

  while position < values.size
    result = result + (position == 0 ? "" : ", ") + lspQuote(values.get(position))
    position = position + 1
  end
  return result + "]"
end
