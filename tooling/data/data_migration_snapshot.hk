class DataMigrationSnapshot
  public model: neri_data::SchemaModel?
  public error: String = ""
  public sourcePath: String = ""
  public sourceText: String = ""
  public markerText: String = ""

  def init(): Void
  end

  def fail(message: String): Void
    if this.error == ""
      this.error = message
    end
  end
end
