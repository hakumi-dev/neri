class DataMapping
  public error: String = ""
  public version: Int = 0
  public mappingPath: String = ""
  public mappingText: String = ""
  public mappingRoot: String = ""
  public projectRoot: String = ""
  public projectPath: String = ""
  public projectText: String = ""
  public unit: String = ""
  public namespaceName: String = ""
  public contextName: String = ""
  public outputPath: String = ""
  public semantic: SemanticModel?
  public firstSource: DataSource?
  public lastSource: DataSource?
  public firstEntity: DataEntity?
  public lastEntity: DataEntity?
  public firstRelation: DataRelation?
  public lastRelation: DataRelation?

  def fail(message: String): Bool
    if this.error == ""
      this.error = message
    end
    return false
  end

  def addSource(source: DataSource): Void
    let last = this.lastSource

    if last == null
      this.firstSource = source
    else
      last.nextSource = source
    end
    this.lastSource = source
  end

  def addEntity(entity: DataEntity): Void
    let last = this.lastEntity

    if last == null
      this.firstEntity = entity
    else
      last.nextEntity = entity
    end
    this.lastEntity = entity
  end

  def addRelation(relation: DataRelation): Void
    let last = this.lastRelation

    if last == null
      this.firstRelation = relation
    else
      last.nextRelation = relation
    end
    this.lastRelation = relation
  end

  def entity(typeName: String): DataEntity?
    var current = this.firstEntity

    while current != null
      if current.typeName == typeName
        return current
      end
      current = current.nextEntity
    end
    return null
  end
end
