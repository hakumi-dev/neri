class DataIndex
  public name: String = ""
  public unique: Bool = false
  public alternateKey: Bool = false
  public fields: StringBuffer = new StringBuffer()
  public descending: StringBuffer = new StringBuffer()
  public expressions: StringBuffer = new StringBuffer()
  public included: StringBuffer = new StringBuffer()
  public predicate: String = ""
  public nextIndex: DataIndex?
end
