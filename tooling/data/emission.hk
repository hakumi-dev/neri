use host

def dataEmissionNamePresent(names: StringBuffer, name: String): Bool
  var index = 0

  while index < names.size
    if names.get(index) == name
      return true
    end
    index = index + 1
  end
  return false
end

def dataEmissionAddName(emission: DataEmission, names: StringBuffer, name: String, kind: String): Bool
  if dataEmissionNamePresent(names, name)
    emission.error = "Generated " + kind + " name '" + name + "' collides with another generated declaration. Rename the mapped type, set, field, relation, or context."
    return false
  end
  names.add(name)
  return true
end

def dataEmissionExistingName(mapping: DataMapping, fullName: String): Bool
  let semantic = mapping.semantic

  if semantic == null
    return false
  end
  var classSymbol = semantic.firstClass

  while classSymbol != null
    if classSymbol.genericOrigin < 0 && classSymbol.fullName == fullName
      return true
    end
    classSymbol = classSymbol.nextClass
  end
  var callable = semantic.firstFunction

  while callable != null
    if callable.genericOrigin < 0 && callable.fullName == fullName
      return true
    end
    callable = callable.nextCallable
  end
  return false
end

def dataEmissionPublicNames(mapping: DataMapping, emission: DataEmission): Bool
  let declarations = new StringBuffer()

  if !dataNavigationPublicNames(mapping, emission, declarations)
    return false
  end

  if !dataEmissionAddName(emission, declarations, mapping.contextName, "type")
    return false
  end
  if !dataEmissionAddName(emission, declarations, "schema_" + mapping.contextName, "schema factory")
    return false
  end
  if !dataEmissionAddName(emission, declarations, "GraphTraversal_" + mapping.contextName, "graph traversal")
    return false
  end
  var entity = mapping.firstEntity

  while entity != null
    if !dataJsonPublicNames(
      mapping,
      emission,
      declarations,
      entity
    ) || !dataTPTPublicNames(
      emission,
      declarations,
      entity
    )
      return false
    end
    if (entity.hierarchyStrategy == "tpc" || entity.hierarchyStrategy == "tpt") && !dataEmissionAddName(
      emission,
      declarations,
      "layout_" + entity.generatedName,
      "physical layout selector"
    )
      return false
    end
    if !dataEmissionAddName(
      emission,
      declarations,
      dataEntityMappingName(entity),
      "mapping factory"
    ) || !dataEmissionAddName(
      emission,
      declarations,
      dataEntityDecoderName(entity),
      "decoder"
    ) || !dataEmissionAddName(
      emission,
      declarations,
      "capture_" + entity.generatedName,
      "persistence capture"
    ) || !dataEmissionAddName(
      emission,
      declarations,
      "apply_" + entity.generatedName,
      "persistence apply"
    ) || !dataEmissionAddName(
      emission,
      declarations,
      "key_" + entity.generatedName,
      "key accessor"
    ) || !dataEmissionAddName(
      emission,
      declarations,
      "snapshot_" + entity.generatedName,
      "snapshot"
    )
      return false
    end
    if entity.generatedKey && !dataEmissionAddName(
      emission,
      declarations,
      "set_generated_key_" + entity.generatedName,
      "generated key setter"
    )
      return false
    end
    if dataHasGeneratedFields(entity) && !dataEmissionAddName(
      emission,
      declarations,
      "apply_generated_" + entity.generatedName,
      "generated value setter"
    )
      return false
    end
    var derived = entity.firstDerived

    while derived != null
      let child = derived.entity

      if entity.hierarchyStrategy == "tpt" && (!dataEmissionAddName(
          emission,
          declarations,
          "capture_" + child.generatedName,
          "table segment capture"
        ) || !dataEmissionAddName(
          emission,
          declarations,
          "apply_" + child.generatedName,
          "table segment apply"
        ))
        return false
      end

      if !dataEmissionAddName(
        emission,
        declarations,
        dataEntityDecoderName(child),
        "hierarchy decoder"
      ) || !dataEmissionAddName(
        emission,
        declarations,
        dataEntityMappingName(child),
        "hierarchy mapping"
      ) || !dataEmissionAddName(
        emission,
        declarations,
        "upcast_" + child.generatedName,
        "hierarchy cast"
      ) || !dataEmissionAddName(
        emission,
        declarations,
        "downcast_" + child.generatedName,
        "hierarchy cast"
      )
        return false
      end
      derived = derived.nextDerived
    end
    entity = entity.nextEntity
  end
  let contextMembers = new StringBuffer()

  contextMembers.add("navigation")

  if !dataEmissionAddName(emission, contextMembers, "init", "context member")
    return false
  end
  if !dataEmissionAddName(
    emission,
    contextMembers,
    "saveChanges",
    "context member"
  ) || !dataEmissionAddName(
    emission,
    contextMembers,
    "changes",
    "context member"
  )
    return false
  end
  for name in [
    "clear",
    "resetForPool",
    "addSaveInterceptor",
    "beginTransaction",
    "commitTransaction",
    "rollbackTransaction",
    "saveChangesAsync",
    "pollSaveCleanup",
    "beginTransactionAsync",
    "commitTransactionAsync",
    "rollbackTransactionAsync",
    "pollTransactionCleanup"
  ]
    if !dataEmissionAddName(emission, contextMembers, name, "context member")
      return false
    end
  end
  entity = mapping.firstEntity
  while entity != null
    var derived = entity.firstDerived

    while derived != null
      if entity.hierarchyStrategy == "tpt" && !dataEmissionAddName(
        emission,
        contextMembers,
        "tableTracker_" + derived.entity.generatedName,
        "table segment tracker"
      )
        return false
      end
      if !dataEmissionAddName(emission, contextMembers, "ofType_" + derived.entity.generatedName, "hierarchy query")
        return false
      end
      derived = derived.nextDerived
    end
    if !dataEmissionAddName(
      emission,
      contextMembers,
      entity.setName,
      "context member"
    ) || !dataEmissionAddName(
      emission,
      contextMembers,
      "tracker_" + entity.generatedName,
      "context member"
    ) || !dataEmissionAddName(
      emission,
      contextMembers,
      "removeCascade_" + entity.setName,
      "context member"
    ) || !dataEmissionAddName(
      emission,
      contextMembers,
      "addGraph_" + entity.setName,
      "context member"
    )
      return false
    end
    entity = entity.nextEntity
  end
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null
      let name = dataRelationName(relation, principal, dependent, foreignKey)

      if !dataEmissionAddName(emission, contextMembers, name, "context member")
        return false
      end
      if dependent.keyless && relation.referenceMember != "" && !dataEmissionAddName(
        emission,
        contextMembers,
        "includeReference_" + name,
        "keyless reference loader"
      )
        return false
      end
      if dependent.keyless && relation.referenceMember != "" && !dataEmissionAddName(
        emission,
        contextMembers,
        "keylessReferenceStep_" + name,
        "keyless reference descriptor"
      )
        return false
      end
      if dataRelationSupportsLink(relation)
        if !dataEmissionAddName(
          emission,
          contextMembers,
          dataRelationLinkName(relation, principal, dependent, foreignKey),
          "context member"
        )
          return false
        end
        if !dataEmissionAddName(
          emission,
          contextMembers,
          dataRelationReassignName(relation, principal, dependent, foreignKey),
          "context member"
        )
          return false
        end
        if (foreignKey.optional || relation.deleteBehavior == "clientCascade") && !dataEmissionAddName(
          emission,
          contextMembers,
          dataRelationUnlinkName(relation, principal, dependent, foreignKey),
          "context member"
        )
          return false
        end
        if !dataEmissionAddName(
          emission,
          declarations,
          dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey),
          "relationship foreign-key getter"
        ) || !dataEmissionAddName(
          emission,
          declarations,
          dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey),
          "relationship foreign-key setter"
        )
          return false
        end
        if !dataEmissionAddName(emission, declarations, "edge_" + name, "relationship edge factory")
          return false
        end
        if !dataRelationUsesLegacyIntLink(relation) && !dataEmissionAddName(
          emission,
          declarations,
          dataRelationPrincipalCellGetterName(relation, principal, dependent, foreignKey),
          "relationship principal-key getter"
        )
          return false
        end
      end
      if relation.collectionMember != ""
        for prefix in ["navigation_", "lazy_", "lazyReference_", "collectionState_", "referenceState_"]
          if !dataEmissionAddName(emission, contextMembers, prefix + name, "context member")
            return false
          end
        end
        if !dataEmissionAddName(emission, contextMembers, "include_" + name, "context member")
          return false
        end
        if !dataEmissionAddName(emission, contextMembers, "includeReference_" + name, "context member")
          return false
        end
        if !dataEmissionAddName(
          emission,
          contextMembers,
          "collectionStep_" + name,
          "context member"
        ) || !dataEmissionAddName(
          emission,
          contextMembers,
          "referenceStep_" + name,
          "context member"
        )
          return false
        end
        for prefix in [
          "nav_principal_key_",
          "nav_dependent_key_",
          "nav_foreign_key_",
          "nav_get_collection_",
          "nav_set_collection_",
          "nav_get_reference_",
          "nav_set_reference_"
        ]
          if !dataEmissionAddName(emission, declarations, prefix + name, "navigation callback")
            return false
          end
        end
      end
    end
    relation = relation.nextRelation
  end
  let graphMembers = new StringBuffer()
  var many = mapping.firstMany

  while many != null
    for prefix in ["skip_get_left_", "skip_get_right_", "skip_set_left_", "skip_set_right_", "skip_create_"]
      if !dataEmissionAddName(emission, declarations, prefix + many.name, "skip navigation callback")
        return false
      end
    end
    for prefix in ["skip_", "include_", "link_", "unlink_", "skipStep_", "inverseSkipStep_"]
      if !dataEmissionAddName(emission, contextMembers, prefix + many.name, "skip navigation member")
        return false
      end
    end
    if !dataEmissionAddName(emission, contextMembers, "include_" + many.name + "Async", "skip navigation member")
      return false
    end
    many = many.nextMany
  end

  if !dataEmissionAddName(
    emission,
    graphMembers,
    "init",
    "graph traversal member"
  ) || !dataEmissionAddName(
    emission,
    graphMembers,
    "graph",
    "graph traversal member"
  )
    return false
  end
  entity = mapping.firstEntity
  while entity != null
    if !dataEmissionAddName(
      emission,
      graphMembers,
      "tracker_" + entity.generatedName,
      "graph traversal member"
    ) || !dataEmissionAddName(
      emission,
      graphMembers,
      "visits_" + entity.generatedName,
      "graph traversal member"
    ) || !dataEmissionAddName(
      emission,
      graphMembers,
      "discover_" + entity.setName,
      "graph traversal member"
    ) || !dataEmissionAddName(
      emission,
      graphMembers,
      "scan_" + entity.setName,
      "graph traversal member"
    ) || !dataEmissionAddName(
      emission,
      graphMembers,
      "add_" + entity.setName,
      "graph traversal member"
    )
      return false
    end
    entity = entity.nextEntity
  end
  relation = mapping.firstRelation
  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      if !dataEmissionAddName(
        emission,
        graphMembers,
        "link_" + dataRelationName(relation, principal, dependent, foreignKey),
        "graph traversal member"
      )
        return false
      end
    end
    relation = relation.nextRelation
  end
  var index = 0

  while index < declarations.size
    let name = declarations.get(index)

    if dataEmissionExistingName(mapping, mapping.namespaceName + "." + name)
      emission.error = "Generated declaration '" + mapping.namespaceName + "." + name + "' already exists in the mapped project. Change the generated namespace or mapped name."
      return false
    end
    index = index + 1
  end
  return true
end

def dataInitialValue(field: DataField): String
  if dataFieldStorageOptional(field)
    return "null"
  end
  if field.conversionInitial != ""
    return semanticNamespaceDisplay(field.conversionInitial) + "()"
  end
  if field.optional
    return "null"
  end
  return dataScalarInitialValue(field.domain)
end

def dataResultColumn(field: DataField): String
  let kind = dataStorageColumn(field)

  return "new neri_data::ResultColumn(" + lspQuote(field.columnName) + ", neri_data::ResultColumnKind." + kind + "(), " + (dataFieldStorageOptional(field) || field.hierarchyType != "" ? "true" : "false") + ")"
end

def dataStorageColumn(field: DataField): String
  return field.boolToInt ? "Int" : dataScalarColumn(field.domain)
end

def dataDecoderKind(field: DataField): String
  return field.boolToInt ? "BoolToInt" : dataScalarName(field.domain)
end

def dataResultColumns(entity: DataEntity): String
  var result = "new neri_data::ResultColumns(["
  var separator = ""
  var field = entity.firstField

  while field != null
    result = result + separator + dataResultColumn(field)
    separator = ", "
    field = field.nextField
  end
  if entity.discriminatorColumn != ""
    result = result + separator + "new neri_data::ResultColumn(" + lspQuote(entity.discriminatorColumn) + ", neri_data::ResultColumnKind.Text())"
  end
  return result + "])"
end

def dataOriginDoc(origin: DataOrigin): String
  return "## Source: " + origin.identity + ".\n"
end

def dataEntityMappingName(entity: DataEntity): String
  return "mappingEntity_" + (host::stringByteLength(entity.generatedName) as String) + "_" + entity.generatedName
end

def dataEntityDecoderName(entity: DataEntity): String
  return "decodeEntity_" + (host::stringByteLength(entity.generatedName) as String) + "_" + entity.generatedName
end

def dataEntityArtifactName(entity: DataEntity): String
  return entity.generatedName + ".entity.hk"
end

def dataPrivateLocal(entity: DataEntity, requested: String): String
  var result = requested
  var collision = true

  while collision
    collision = false
    var field = entity.firstField

    while field != null
      collision = true if field.memberName == result
      field = field.nextField
    end
    result = result + "_internal" if collision
  end
  return result
end

def dataFieldIdentity(field: DataField): String
  if field.schemaIdentity != ""
    return field.schemaIdentity
  end
  let symbol = field.symbol

  if symbol != null
    return symbol.owner + "." + symbol.name
  end
  return ""
end

def dataFieldLocal(field: DataField): String
  return "value_" + field.columnName
end

def dataRelationName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  var members = foreignKey.memberName
  var position = 1

  while position < relation.foreignKeyMembers.size
    members = members + "_" + relation.foreignKeyMembers.get(position)
    position = position + 1
  end
  return dependent.setName + "For_" + principal.generatedName + "_by_" + members
end

def dataRelationSupportsLink(relation: DataRelation): Bool
  let key = relation.key
  let foreignKey = relation.foreignKey

  let dependent = relation.dependent

  return dependent != null && !dependent.keyless && key != null && foreignKey != null && dataScalarSupportsKey(key.domain) && key.typeName == (foreignKey.optional ? semanticInnerType(foreignKey.typeName) : foreignKey.typeName)
end

def dataRelationUsesLegacyIntLink(relation: DataRelation): Bool
  let key = relation.key
  let foreignKey = relation.foreignKey

  let principal = relation.principal

  return !relation.forceScalar && principal != null && relation.keyMembers.size == 1 && principal.keyMembers.size == 1 && relation.keyMember == principal.keyMember && key != null && foreignKey != null && key.typeName == "Int" && foreignKey.typeName == "Int"
end

def dataRelationPolicyArgument(relation: DataRelation): String
  if relation.deleteBehavior == "clientCascade"
    return ", neri_data::RelationshipDeletePolicy.ClientCascade()"
  end
  if relation.deleteBehavior == "clientSetNull"
    return ", neri_data::RelationshipDeletePolicy.ClientSetNull()"
  end
  return ""
end

def dataRelationLinkName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "link_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationReassignName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "reassign_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationUnlinkName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "unlink_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationForeignKeyGetterName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "get_fk_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationForeignKeySetterName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "set_fk_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationPrincipalCellGetterName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "get_pk_cell_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationEdgeFactoryName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  return "edge_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationNavigationName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField,
  prefix: String
): String
  return "nav_" + prefix + "_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataOwnField(first: DataField?): DataField?
  var field = first

  while field != null && field.hierarchyType != ""
    field = field.nextField
  end
  return field
end

def dataEmitDecoder(output: DataArtifact, entity: DataEntity): Void
  var field = entity.firstField

  output.write(dataOriginDoc(entity.origin))
  output.write("def ")
  output.write(dataEntityDecoderName(entity), entity.origin)
  output.write("(row: neri_data::RawRow): neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
  let entitySymbol = entity.symbol

  if entitySymbol != null && entitySymbol.isAbstract && entity.firstDerived == null
    output.write("  return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(neri_data::QueryFailure.TypeMismatch(" + lspQuote(entity.discriminatorColumn) + ", \"concrete hierarchy discriminator\", \"abstract type\"))\nend\n\n")
    return
  end
  if entity.firstDerived != null
    output.write("  var discriminator = \"\"\n\n  match neri_data::decodeString(row, " + lspQuote(entity.discriminatorColumn) + ")\n    case neri_data::DecodeResult.Value(value)\n      discriminator = value\n    case neri_data::DecodeResult.Failure(error)\n      return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(error)\n  end\n")
    var derived = entity.firstDerived

    while derived != null
      output.write("  if discriminator == " + lspQuote(derived.discriminator) + "\n    match " + dataEntityDecoderName(derived.entity) + "(row)\n      case neri_data::DecodeResult.Value(value)\n        return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Value(value)\n      case neri_data::DecodeResult.Failure(error)\n        return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(error)\n    end\n  end\n")
      derived = derived.nextDerived
    end
    output.write("  if discriminator != " + lspQuote(entity.discriminatorValue) + "\n    return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(neri_data::QueryFailure.TypeMismatch(" + lspQuote(entity.discriminatorColumn) + ", \"mapped hierarchy discriminator\", discriminator))\n  end\n")
    let symbol = entity.symbol

    if symbol != null && symbol.isAbstract
      output.write("  return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(neri_data::QueryFailure.TypeMismatch(" + lspQuote(entity.discriminatorColumn) + ", \"concrete hierarchy discriminator\", discriminator))\nend\n\n")
      return
    end
  end
  field = dataOwnField(entity.firstField)

  while field != null
    let local = dataFieldLocal(field)

    let localType = field.optionalParents.size > 0 && !field.optional ? field.typeName + "?" : field.typeName

    output.write("  var " + local + ": " + semanticNamespaceDisplay(localType) + " = " + dataInitialValue(field) + "\n")
    let decode = dataComplexFieldDecoder(field)

    output.write("\n  match " + decode + "(row, ")
    output.write(lspQuote(field.columnName), field.origin)
    output.write(")\n    case neri_data::DecodeResult.Value(value)\n      " + local + " = value\n    case neri_data::DecodeResult.Failure(error)\n      return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(error)\n  end\n")
    field = dataOwnField(field.nextField)
  end
  let decodedEntity = dataPrivateLocal(entity, "decodedEntity")

  dataEmitComplexPresenceValidation(output, entity)

  output.write("  let " + decodedEntity + " = new " + semanticNamespaceDisplay(entity.typeName) + "(")
  if !entity.initializeWithFields
    field = dataOwnField(entity.firstField)
    var first = true

    while field != null
      output.write((first ? "" : ", ") + field.memberName + ": " + dataFieldLocal(field))
      first = false
      field = dataOwnField(field.nextField)
    end
  end
  output.write(")\n")
  if entity.initializeWithFields
    var complex = entity.firstComplex

    while complex != null
      dataEmitComplexConstruction(output, entity, complex, decodedEntity)
      complex = complex.nextComplex
    end
    field = dataOwnField(entity.firstField)

    while field != null
      dataEmitComplexFieldAssignment(output, entity, field, decodedEntity)
      field = dataOwnField(field.nextField)
    end
  end
  output.write("\n  return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Value(" + decodedEntity + ")\nend\n\n")
end

def dataEmitMapping(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def ")
  output.write(dataEntityMappingName(entity), entity.origin)
  output.write("(): neri_data::EntityMapping\n  return new neri_data::EntityMapping(" + lspQuote(entity.typeName) + ", " + lspQuote(entity.tableName) + ", [")
  var field = entity.firstField
  var separator = ""

  while field != null
    output.write(separator + "new neri_data::MappingColumn(")
    output.write(lspQuote(dataFieldIdentity(field)), field.origin)
    output.write(", " + lspQuote(field.typeName) + ", " + lspQuote(field.columnName))
    if field.pathCode != ""
      output.write(", " + field.pathCode)
    end
    if field.boolToInt
      output.write(", boolToInt: true")
    end
    if field.conversionEncode != ""
      output.write(", storageType: " + lspQuote(field.conversionStorageType) + ", conversionId: " + lspQuote(field.conversionEncode))
    end
    output.write(")")
    separator = ", "
    field = field.nextField
  end
  if entity.discriminatorColumn != ""
    output.write(separator + "new neri_data::MappingColumn(" + lspQuote(entity.typeName + ".__discriminator") + ", \"String\", " + lspQuote(entity.discriminatorColumn) + ")")
  end
  let key = entity.field(entity.keyMember)

  if key != null
    output.write("], " + lspQuote(key.columnName) + (entity.keyMembers.size > 1 ? ", primaryKeyColumns: " + dataEntityKeyColumns(entity) : "") + dataComplexPresenceCode(entity) + ")\nend\n\n")
  else
    output.write("], readOnly: true" + dataComplexPresenceCode(entity) + ")\nend\n\n")
  end
end

def dataTrackedEntity(first: DataEntity?): DataEntity?
  var entity = first

  while entity != null && entity.keyless
    entity = entity.nextEntity
  end
  return entity
end

def dataEmitSchema(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "schema.hk"
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  output.write("## Describes the mapped tables and columns for schema comparison.\ndef schema_" + mapping.contextName + "(): neri_data::SchemaModel\n  return new neri_data::SchemaModel([")
  var entity = dataSchemaEntity(mapping.firstEntity)
  var tableSeparator = ""

  while entity != null
    if entity.hierarchyStrategy == "tpc"
      let symbol = entity.symbol

      if symbol == null || !symbol.isAbstract
        output.write(tableSeparator)
        dataEmitSchemaTable(output, mapping, dataTPCSchemaEntity(entity, entity))
        tableSeparator = ","
      end
      var concrete = entity.firstDerived

      while concrete != null
        let concreteSymbol = concrete.entity.symbol

        if concreteSymbol == null || !concreteSymbol.isAbstract
          output.write(tableSeparator)
          dataEmitSchemaTable(output, mapping, dataTPCSchemaEntity(entity, concrete.entity))
          tableSeparator = ","
        end
        concrete = concrete.nextDerived
      end
    else if entity.hierarchyStrategy == "tpt"
      output.write(tableSeparator)
      dataEmitSchemaTable(output, mapping, dataTPTPhysical(entity, entity))
      tableSeparator = ","
      var segment = entity.firstDerived

      while segment != null
        output.write(tableSeparator)
        dataEmitSchemaTable(output, mapping, dataTPTPhysical(entity, segment.entity))
        tableSeparator = ","
        segment = segment.nextDerived
      end
    else
      output.write(tableSeparator)
      dataEmitSchemaTable(output, mapping, entity)
    end
    tableSeparator = ","
    entity = dataSchemaEntity(entity.nextEntity)
  end
  output.write("\n    ])\nend\n")
  return output
end

def dataSchemaEntity(first: DataEntity?): DataEntity?
  var entity = first

  while entity != null && (entity.keyless || entity.view)
    entity = entity.nextEntity
  end
  return entity
end

def dataEmitSnapshot(output: DataArtifact, entity: DataEntity): Void
  output.write("## Captures the mapped scalar values.\ndef ")
  output.write("snapshot_" + entity.generatedName, entity.origin)
  if dataEntityHasExtendedScalars(entity)
    output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): neri_data::RawRow\n  return capture_" + entity.generatedName + "(entity)\nend\n\n")
  else
    output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): fields of " + semanticNamespaceDisplay(entity.typeName) + "\n  return neri_data::snapshot<" + semanticNamespaceDisplay(entity.typeName) + ">(")
    var field = entity.firstField
    var separator = ""

    while field != null
      output.write(separator)
      output.write(field.memberName, field.origin)
      output.write(": entity.")
      output.write(field.memberName, field.origin)
      separator = ", "
      field = field.nextField
    end
    output.write(")\nend\n\n")
  end
  let key = entity.field(entity.keyMember)

  if key != null
    output.write(dataOriginDoc(key.origin))
    output.write("def ")
    output.write("key_" + entity.generatedName, key.origin)
    output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): " + semanticNamespaceDisplay(key.typeName) + "\n  return entity." + key.memberName + "\nend\n")
  end
end

def dataCaptureCell(field: DataField, receiver: String = "entity"): String
  let guard = dataOptionalParentGuard(field, receiver)

  return guard == "" ? dataCapturePresentCell(
    field,
    receiver
  ) : "(" + guard + " ? " + dataCapturePresentCell(
    field,
    receiver
  ) + " : neri_data::Cell.Null())"
end

def dataCapturePresentCell(field: DataField, receiver: String): String
  let member = dataFieldRead(field, receiver)

  if field.conversionEncode != ""
    return semanticNamespaceDisplay(field.conversionEncode) + "(" + member + ")"
  end
  if field.boolToInt
    return "neri_data::cell" + (field.optional ? "Optional" : "") + "BoolToInt(" + member + ")"
  end
  if field.optional
    return "neri_data::cellOptional" + dataScalarName(field.domain) + "(" + member + ")"
  end
  match field.domain
    case DataScalarKind.Binary()
      return "neri_data::cellByteBuffer(" + member + ")"
    case DataScalarKind.Decimal()
      return "neri_data::cellDecimal(" + member + ")"
    case DataScalarKind.Int()
    case DataScalarKind.Bool()
    case DataScalarKind.Float()
    case DataScalarKind.String()
  end
  return "neri_data::Cell." + dataScalarColumn(field.domain) + "(" + member + ")"
end

def dataEmitCapture(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def capture_" + entity.generatedName, entity.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): neri_data::RawRow\n")
  var derived = entity.firstDerived

  while derived != null
    output.write("  let subtype_" + derived.entity.generatedName + " = reference::cast<" + semanticNamespaceDisplay(derived.entity.typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(entity)\n")
    derived = derived.nextDerived
  end
  output.write("  return new neri_data::RawRow([")
  var field = entity.firstField
  var separator = ""

  while field != null
    output.write(separator + "new neri_data::RawColumn(")
    output.write(lspQuote(field.columnName), field.origin)
    output.write(", ")
    if field.hierarchyType == ""
      output.write(dataCaptureCell(field), field.origin)
    else
      derived = entity.firstDerived
      while derived != null && derived.entity.typeName != field.hierarchyType
        derived = derived.nextDerived
      end
      if derived != null
        let receiver = "subtype_" + derived.entity.generatedName

        output.write(receiver + " == null ? neri_data::Cell.Null() : " + dataCaptureCell(field, receiver), field.origin)
      end
    end
    output.write(")")
    separator = ", "
    field = field.nextField
  end
  if entity.discriminatorColumn != ""
    output.write(separator + "new neri_data::RawColumn(" + lspQuote(entity.discriminatorColumn) + ", neri_data::Cell.Text(")
    derived = entity.firstDerived
    while derived != null
      output.write("subtype_" + derived.entity.generatedName + " != null ? " + lspQuote(derived.discriminator) + " : ")
      derived = derived.nextDerived
    end
    output.write(lspQuote(entity.discriminatorValue) + "))")
  end
  output.write("])\nend\n\n")
end

def dataEmitApply(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def apply_" + entity.generatedName, entity.origin)
  output.write("(target: " + semanticNamespaceDisplay(entity.typeName) + ", source: " + semanticNamespaceDisplay(entity.typeName) + "): Void\n")
  var field = entity.firstField
  var complex = entity.firstComplex

  while complex != null
    if complex.optional && dataComplexGuard(entity, complex, "source") == ""
      output.write("  target." + complex.memberName + " = source." + complex.memberName + "\n")
    end
    complex = complex.nextComplex
  end

  while field != null
    if field.hierarchyType == "" && field.optionalParents.size == 0
      output.write("  " + dataFieldWrite(field, "target", dataFieldRead(field, "source")) + "\n", field.origin)
    end
    field = field.nextField
  end
  var derived = entity.firstDerived

  while derived != null
    let suffix = derived.entity.generatedName

    output.write("  let target_" + suffix + " = reference::cast<" + semanticNamespaceDisplay(derived.entity.typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(target)\n")
    output.write("  let source_" + suffix + " = reference::cast<" + semanticNamespaceDisplay(derived.entity.typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(source)\n")
    output.write("\n  if target_" + suffix + " != null && source_" + suffix + " != null\n")
    field = entity.firstField
    while field != null
      if field.hierarchyType == derived.entity.typeName
        output.write("    " + dataFieldWrite(
            field,
            "target_" + suffix,
            dataFieldRead(field, "source_" + suffix)
          ) + "\n")
      end
      field = field.nextField
    end
    output.write("  end\n")
    derived = derived.nextDerived
  end
  output.write("end\n\n")
end

def dataHasGeneratedFields(entity: DataEntity): Bool
  var field = entity.firstField

  while field != null
    if field.generatedOnAdd
      return true
    end
    field = field.nextField
  end
  return false
end

def dataEmitGeneratedFieldsSetter(output: DataArtifact, entity: DataEntity): Void
  output.write(
    "## Applies validated returned values without changing other mapped fields.\ndef apply_generated_" + entity.generatedName,
    entity.origin
  )
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + ", row: readonly neri_data::RawRow): Void\n")
  var field = entity.firstField

  while field != null
    if field.generatedOnAdd
      output.write("  match row.value(" + lspQuote(field.columnName) + ")\n    case neri_data::CellLookup.Missing()\n    case neri_data::CellLookup.Found(cell)\n      match cell\n        case neri_data::Cell.Null()\n")
      if field.optional
        output.write("          entity." + field.memberName + " = null\n", field.origin)
      end
      for kind in ["Bool", "Int", "Float", "Text", "Binary"]
        output.write("        case neri_data::Cell." + kind + "(value)\n")
        if kind == dataStorageColumn(field)
          if field.boolToInt
            output.write(
              "          if value == 0 || value == 1\n            entity." + field.memberName + " = value == 1\n          end\n",
              field.origin
            )
          else if dataScalarName(field.domain) == "Decimal"
            output.write(
              "          let decimal = neri_data::Decimal.parse(value)\n\n          if decimal != null\n            entity." + field.memberName + " = decimal\n          end\n",
              field.origin
            )
          else if dataScalarName(field.domain) == "ByteBuffer"
            output.write("          entity." + field.memberName + " = neri_data::copyBinary(value)\n", field.origin)
          else
            output.write("          entity." + field.memberName + " = value\n", field.origin)
          end
        end
      end
      output.write("      end\n  end\n")
    end
    field = field.nextField
  end
  output.write("end\n\n")
end

def dataEmitGeneratedFieldsMetadata(output: DataArtifact, entity: DataEntity): Void
  output.write(", generatedColumns: [")
  var field = entity.firstField
  var separator = ""

  while field != null
    if field.generatedOnAdd
      output.write(separator + "new neri_data::GeneratedValueColumn(new neri_data::ResultColumn(" + lspQuote(field.columnName) + ", neri_data::ResultColumnKind." + dataStorageColumn(field) + "(), " + (field.optional ? "true" : "false") + "), neri_data::GeneratedValueTiming." + (field.generatedOnUpdate ? "OnAddOrUpdate" : "OnAdd") + "()" + (dataScalarName(field.domain) == "Decimal" ? ", canonicalDecimal: true" : "") + ")")
      separator = ", "
    end
    field = field.nextField
  end
  output.write("], applyGenerated: apply_generated_" + entity.generatedName)
end

def dataEmitGeneratedKeySetter(output: DataArtifact, entity: DataEntity): Void
  let key = entity.field(entity.keyMember)

  if key == null
    return
  end
  output.write(dataOriginDoc(key.origin))
  output.write("def set_generated_key_" + entity.generatedName, key.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + ", value: Int): Void\n  entity.")
  output.write(key.memberName, key.origin)
  output.write(" = value\nend\n\n")
end

def dataEmitScalarForeignKeySetter(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  if relation.keyMembers.size > 1
    dataEmitCompositeForeignKeySetter(output, relation, principal, dependent, foreignKey)
    return
  end
  if foreignKey.conversionDecode != ""
    output.write("def " + dataRelationForeignKeySetterName(
        relation,
        principal,
        dependent,
        foreignKey
      ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: neri_data::Cell): Void\n  let row = new neri_data::RawRow([new neri_data::RawColumn(" + lspQuote(foreignKey.columnName) + ", value)])\n\n  match " + semanticNamespaceDisplay(foreignKey.conversionDecode) + "(row, " + lspQuote(foreignKey.columnName) + ")\n    case neri_data::DecodeResult.Failure(error)\n      return\n    case neri_data::DecodeResult.Value(decoded)\n      entity." + foreignKey.memberName + " = decoded\n  end\nend\n\n")
    return
  end
  output.write(dataOriginDoc(foreignKey.origin))
  output.write("def " + dataRelationForeignKeySetterName(
      relation,
      principal,
      dependent,
      foreignKey
    ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: neri_data::Cell): Void\n  match value\n")
  let actualType = foreignKey.optional ? semanticInnerType(foreignKey.typeName) : foreignKey.typeName

  if actualType == "Int"
    output.write("    case neri_data::Cell.Int(number)\n      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = number\n    case neri_data::Cell.Text(text)\n    case neri_data::Cell.Bool(boolean)\n")
  else
    output.write("    case neri_data::Cell.Text(text)\n      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = text\n    case neri_data::Cell.Int(number)\n    case neri_data::Cell.Bool(boolean)\n")
  end
  output.write("    case neri_data::Cell.Float(real)\n    case neri_data::Cell.Binary(bytes)\n")
  output.write("    case neri_data::Cell.Null()\n")
  if foreignKey.optional
    output.write("      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = null\n")
  end
  output.write("  end\nend\n\n")
end

def dataEmitRelationEdgeFactory(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)

  output.write(dataOriginDoc(foreignKey.origin))
  output.write("def " + dataRelationEdgeFactoryName(
      relation,
      principal,
      dependent,
      foreignKey
    ) + "(principal: neri_data::TrackedHandle<" + p + ">, dependent: neri_data::TrackedHandle<" + d + ">): neri_data::RelationshipEdge\n")
  if dataRelationUsesLegacyIntLink(relation)
    output.write("  let link = new neri_data::RelationshipLink<" + p + ", " + d + ">(principal, dependent, key_" + principal.generatedName + ", " + dataRelationForeignKeyGetterName(
        relation,
        principal,
        dependent,
        foreignKey
      ) + ", " + dataRelationForeignKeySetterName(
        relation,
        principal,
        dependent,
        foreignKey
      ) + ", " + lspQuote(foreignKey.columnName) + dataRelationPolicyArgument(relation) + ")\n")
  else
    let key = relation.key

    if key != null
      let kind = relation.keyMembers.size > 1 ? "Text" : (key.typeName == "Int" ? "Int" : "Text")

      output.write("  let link = new neri_data::ScalarRelationshipLink<" + p + ", " + d + ">(principal, dependent, " + dataRelationPrincipalCellGetterName(
          relation,
          principal,
          dependent,
          foreignKey
        ) + ", " + dataRelationForeignKeyGetterName(
          relation,
          principal,
          dependent,
          foreignKey
        ) + ", " + dataRelationForeignKeySetterName(
          relation,
          principal,
          dependent,
          foreignKey
        ) + ", neri_data::ResultColumnKind." + kind + "(), " + (foreignKey.optional ? "true" : "false") + ", " + lspQuote(foreignKey.columnName) + dataRelationPolicyArgument(relation) + dataRelationTupleMetadata(
          relation,
          dependent
        ) + ")\n")
    end
  end
  output.write("\n  return link.edge()\nend\n\n")
end

def dataEmitGraphVisit(output: DataArtifact, entity: DataEntity): Void
  let typeName = semanticNamespaceDisplay(entity.typeName)
  let name = entity.setName

  output.write("\n  private def discover_" + name + "(entity: " + typeName + "): neri_data::GraphVisitResult<" + typeName + ">\n")
  output.write("    match this.visits_" + entity.generatedName + ".visit(entity)\n")
  output.write("      case neri_data::GraphVisitResult.Failure(error)\n        return neri_data::GraphVisitResult<" + typeName + ">.Failure(error)\n")
  output.write("      case neri_data::GraphVisitResult.Existing(slot)\n        return neri_data::GraphVisitResult<" + typeName + ">.Existing(slot)\n")
  output.write("      case neri_data::GraphVisitResult.New(slot)\n")
  output.write("        let staged = this.graph.stageNode(slot, this.tracker_" + entity.generatedName + ")\n\n        if staged != null\n          return neri_data::GraphVisitResult<" + typeName + ">.Failure(staged)\n        end\n")
  output.write("        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure? do\n          return this.scan_" + name + "(entity, slot)\n        end\n")
  output.write("        let queued = this.graph.enqueue(scan)\n\n        if queued != null\n          return neri_data::GraphVisitResult<" + typeName + ">.Failure(queued)\n        end\n")
  output.write("        return neri_data::GraphVisitResult<" + typeName + ">.New(slot)\n    end\n  end\n")
end

def dataEmitGraphLink(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("\n  private def link_" + name + "(principal: neri_data::GraphSlot<" + p + ">, dependent: neri_data::GraphSlot<" + d + ">, entity: " + d + "): neri_data::QueryFailure?\n")
  output.write("    let previous = entity.")
  output.write(foreignKey.memberName, foreignKey.origin)
  output.write("\n    let restore: fn(): Void = fn(): Void do\n      entity.")
  output.write(foreignKey.memberName, foreignKey.origin)
  output.write(" = previous\n    end\n\n    return this.graph.stageLink(principal, dependent, " + dataRelationEdgeFactoryName(
      relation,
      principal,
      dependent,
      foreignKey
    ) + ", restore)\n  end\n")
end

def dataEmitGraphCollectionScan(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("    for child in entity.")
  output.write(relation.collectionMember, relation.collectionOrigin)
  output.write("\n      let inverse = child.")
  output.write(relation.referenceMember, relation.referenceOrigin)
  output.write("\n\n      if inverse != null && !reference::same(inverse, entity)\n        return neri_data::QueryFailure.Provider(neri_data::ProviderFailure.State(" + lspQuote("graph navigation inverse disagrees with collection: " + name) + "))\n      end\n")
  output.write("      var related: neri_data::GraphSlot<" + d + ">? = null\n\n      match this.discover_" + dependent.setName + "(child)\n")
  output.write("        case neri_data::GraphVisitResult.New(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Existing(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Failure(error)\n          return error\n      end\n")
  output.write("      if related != null\n        let failure = this.link_" + name + "(owner, related, child)\n\n        if failure != null\n          return failure\n        end\n      end\n    end\n")
end

def dataEmitGraphReferenceScan(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)
  let local = "principal_" + name

  output.write("    let " + local + " = entity.")
  output.write(relation.referenceMember, relation.referenceOrigin)
  output.write("\n\n    if " + local + " != null\n      var related: neri_data::GraphSlot<" + p + ">? = null\n\n      match this.discover_" + principal.setName + "(" + local + ")\n")
  output.write("        case neri_data::GraphVisitResult.New(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Existing(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Failure(error)\n          return error\n      end\n")
  output.write("      if related != null\n        let failure = this.link_" + name + "(related, owner, entity)\n\n        if failure != null\n          return failure\n        end\n      end\n    end\n")
end

def dataEmitGraph(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "graph.hk"
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  output.write("## Collects one reachable mapped graph before atomic enrollment.\nclass GraphTraversal_" + mapping.contextName + "\n  private graph: neri_data::GraphRegistration\n")
  var entity = dataTrackedEntity(mapping.firstEntity)

  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("  private tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + typeName + ">\n")
    output.write("  private visits_" + entity.generatedName + ": neri_data::GraphVisitList<" + typeName + ">\n")
    entity = dataTrackedEntity(entity.nextEntity)
  end
  output.write("\n  def init(changes: neri_data::ChangeContext")
  entity = dataTrackedEntity(mapping.firstEntity)
  while entity != null
    output.write(", tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">")
    entity = dataTrackedEntity(entity.nextEntity)
  end
  output.write("): Void\n    this.graph = new neri_data::GraphRegistration(changes)\n")
  entity = dataTrackedEntity(mapping.firstEntity)
  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("    this.tracker_" + entity.generatedName + " = tracker_" + entity.generatedName + "\n")
    output.write("    this.visits_" + entity.generatedName + " = new neri_data::GraphVisitList<" + typeName + ">(this.graph)\n")
    entity = dataTrackedEntity(entity.nextEntity)
  end
  output.write("  end\n")
  entity = dataTrackedEntity(mapping.firstEntity)
  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("\n  def add_" + entity.setName + "(root: " + typeName + "): neri_data::TrackHandleResult<" + typeName + ">\n")
    output.write("    match this.discover_" + entity.setName + "(root)\n")
    output.write("      case neri_data::GraphVisitResult.New(slot)\n        return this.graph.enroll(slot)\n      case neri_data::GraphVisitResult.Existing(slot)\n        return this.graph.enroll(slot)\n      case neri_data::GraphVisitResult.Failure(error)\n        return neri_data::TrackHandleResult<" + typeName + ">.Failure(error)\n    end\n  end\n")
    dataEmitGraphVisit(output, entity)
    output.write("\n  private def scan_" + entity.setName + "(entity: " + typeName + ", owner: neri_data::GraphSlot<" + typeName + ">): neri_data::QueryFailure?\n")
    var relation = mapping.firstRelation

    while relation != null
      let principal = relation.principal
      let dependent = relation.dependent
      let foreignKey = relation.foreignKey

      if principal != null && dependent != null && foreignKey != null && relation.collectionMember != "" && dataRelationSupportsLink(relation)
        if principal.typeName == entity.typeName && !relation.implicitJoin
          dataEmitGraphCollectionScan(output, relation, principal, dependent, foreignKey)
        end
        if dependent.typeName == entity.typeName
          dataEmitGraphReferenceScan(output, relation, principal, dependent, foreignKey)
        end
      end
      relation = relation.nextRelation
    end
    output.write("    return null\n  end\n")
    entity = dataTrackedEntity(entity.nextEntity)
  end
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != "" && dataRelationSupportsLink(relation)
      dataEmitGraphLink(output, relation, principal, dependent, foreignKey)
    end
    relation = relation.nextRelation
  end
  output.write("end\n")
  return output
end

def dataEmitContext(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "context.hk"
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && dataRelationSupportsLink(relation)
      if dataRelationUsesLegacyIntLink(relation)
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeyGetterName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + "): Int\n  return entity.")
        output.write(foreignKey.memberName, foreignKey.origin)
        output.write("\nend\n\n")
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeySetterName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: Int): Void\n  entity.")
        output.write(foreignKey.memberName, foreignKey.origin)
        output.write(" = value\nend\n\n")
      else
        let key = relation.key

        if key != null
          output.write(dataOriginDoc(key.origin))
          output.write("def " + dataRelationPrincipalCellGetterName(
              relation,
              principal,
              dependent,
              foreignKey
            ) + "(entity: " + semanticNamespaceDisplay(principal.typeName) + "): neri_data::Cell\n  return " + dataRelationKeyCell(
              principal,
              relation.keyMembers,
              key
            ) + "\nend\n\n")
        end
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeyGetterName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + "): neri_data::Cell\n  return " + dataRelationKeyCell(
            dependent,
            relation.foreignKeyMembers,
            foreignKey
          ) + "\nend\n\n")
        dataEmitScalarForeignKeySetter(output, relation, principal, dependent, foreignKey)
      end
      dataEmitRelationEdgeFactory(output, relation, principal, dependent, foreignKey)
    end
    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      let principalKey = relation.key
      let dependentKey = dependent.field(dependent.keyMember)

      if principalKey != null && dependentKey != null
        let p = semanticNamespaceDisplay(principal.typeName)
        let d = semanticNamespaceDisplay(dependent.typeName)

        output.write("def " + dataRelationNavigationName(
            relation,
            principal,
            dependent,
            foreignKey,
            "principal_key"
          ) + "(entity: " + p + "): neri_data::Cell\n  return " + dataRelationKeyCell(
            principal,
            relation.keyMembers,
            principalKey
          ) + "\nend\n\n")
        output.write("def " + dataRelationNavigationName(
            relation,
            principal,
            dependent,
            foreignKey,
            "dependent_key"
          ) + "(entity: " + d + "): neri_data::Cell\n  return " + dataRelationKeyCell(
            dependent,
            dependent.keyMembers,
            dependentKey
          ) + "\nend\n\n")
        output.write("def " + dataRelationNavigationName(
            relation,
            principal,
            dependent,
            foreignKey,
            "foreign_key"
          ) + "(entity: " + d + "): neri_data::Cell\n  return " + dataRelationKeyCell(
            dependent,
            relation.foreignKeyMembers,
            foreignKey
          ) + "\nend\n\n")
        if !relation.implicitJoin
          output.write("def " + dataRelationNavigationName(
              relation,
              principal,
              dependent,
              foreignKey,
              "get_collection"
            ) + "(entity: " + p + "): " + d + "[]\n  return entity.")
          output.write(relation.collectionMember, relation.collectionOrigin)
          output.write("\nend\n\n")
          output.write("def " + dataRelationNavigationName(
              relation,
              principal,
              dependent,
              foreignKey,
              "set_collection"
            ) + "(entity: " + p + ", values: " + d + "[]): Void\n  entity.")
          output.write(relation.collectionMember, relation.collectionOrigin)
          output.write(" = values\nend\n\n")
        end
        output.write("def " + dataRelationNavigationName(
            relation,
            principal,
            dependent,
            foreignKey,
            "get_reference"
          ) + "(entity: " + d + "): " + p + "?\n  return entity.")
        output.write(relation.referenceMember, relation.referenceOrigin)
        output.write("\nend\n\n")
        output.write("def " + dataRelationNavigationName(
            relation,
            principal,
            dependent,
            foreignKey,
            "set_reference"
          ) + "(entity: " + d + ", value: " + p + "?): Void\n  entity.")
        output.write(relation.referenceMember, relation.referenceOrigin)
        output.write(" = value\nend\n\n")
      end
    end
    relation = relation.nextRelation
  end
  var hierarchyRoot = mapping.firstEntity

  while hierarchyRoot != null
    dataEmitTPTCallbacks(output, hierarchyRoot)
    hierarchyRoot = hierarchyRoot.nextEntity
  end
  dataEmitManyCallbacks(output, mapping)
  output.write("## Entry point for the mapped entity query surfaces.\nclass " + mapping.contextName + "\n")
  output.write("  private changes: neri_data::ChangeContext\n")
  output.write("  public navigation: Navigation_" + mapping.contextName + "\n")
  dataEmitManyFields(output, mapping)
  dataEmitImplicitFields(output, mapping)
  relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      output.write("  private navigation_" + dataRelationName(
          relation,
          principal,
          dependent,
          foreignKey
        ) + ": neri_data::CollectionNavigation<" + semanticNamespaceDisplay(principal.typeName) + ", " + semanticNamespaceDisplay(dependent.typeName) + ">\n")
    end
    relation = relation.nextRelation
  end
  var entity = mapping.firstEntity

  while entity != null
    dataEmitTPTFields(output, entity)
    if !entity.keyless
      output.write("  private tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    end
    output.write("  " + dataOriginDoc(entity.origin))
    output.write("  public ")
    output.write(entity.setName, entity.origin)
    output.write(": neri_data::Query<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    entity = entity.nextEntity
  end
  output.write("\n  ## Borrows a provider for query execution and saving; the caller owns its lifetime.\n  def init(provider: neri_data::Provider? = null): Void\n    this.changes = new neri_data::ChangeContext(provider)\n")
  entity = mapping.firstEntity

  while entity != null
    let key = entity.field(entity.keyMember)

    if key != null
      let concurrency = entity.concurrencyColumns

      if concurrency != null
        output.write("    let concurrency_" + entity.generatedName + ": String[] = [")
        var token = 0

        while token < concurrency.size
          output.write((token == 0 ? "" : ", ") + lspQuote(concurrency.get(token)))
          token = token + 1
        end
        output.write("]\n\n")
      end
      output.write("    this.tracker_" + entity.generatedName + " = new neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">(" + lspQuote(entity.tableName) + ", " + lspQuote(key.columnName) + ", " + dataResultColumns(entity) + ", capture_" + entity.generatedName + ", apply_" + entity.generatedName)
      if entity.generatedKey
        output.write(", true, set_generated_key_" + entity.generatedName)
      end
      if dataHasGeneratedFields(entity)
        dataEmitGeneratedFieldsMetadata(output, entity)
      end
      if concurrency != null
        output.write(", concurrencyColumns: concurrency_" + entity.generatedName)
      end
      if entity.keyMembers.size > 1
        output.write(", keyColumns: " + dataEntityKeyColumns(entity))
      end
      let alternateKeys = dataAlternateKeyColumns(entity)
      let foreignKeys = dataForeignKeyColumns(mapping, entity)

      if alternateKeys != "[]"
        output.write(", alternateKeyColumns: " + alternateKeys)
      end
      if foreignKeys != "[]"
        output.write(", foreignKeyColumns: " + foreignKeys)
      end
      if entity.discriminatorColumn != ""
        output.write(", hierarchyColumn: " + lspQuote(entity.discriminatorColumn))
      end
      if entity.snapshotEqual != ""
        output.write(", snapshotEqual: " + semanticNamespaceDisplay(entity.snapshotEqual))
      end
      if entity.hierarchyStrategy == "tpc" || entity.hierarchyStrategy == "tpt"
        output.write(", writeLayout: layout_" + entity.generatedName)
      end
      if entity.hierarchyStrategy == "tpt"
        output.write(", setWriteLayout: new neri_data::TrackedWriteLayout(" + lspQuote(entity.tableName) + ", " + dataResultColumns(dataTPTPhysical(
              entity,
              entity
            )) + "), tableSegments: true")
      end
      output.write(")\n")
      output.write("    this.changes.register(this.tracker_" + entity.generatedName + ".changeSet())\n")
    end
    output.write("    this." + entity.setName + " = new neri_data::Query<" + semanticNamespaceDisplay(entity.typeName) + ">(" + lspQuote(entity.tableName) + ", new neri_data::Decoder<" + semanticNamespaceDisplay(entity.typeName) + ">(" + dataEntityDecoderName(entity) + ", " + dataResultColumns(entity) + "), mapping: " + dataEntityMappingName(entity) + "(), provider: provider")
    if !entity.keyless
      output.write(", tracker: this.tracker_" + entity.generatedName + ", changes: this.changes")
    else
      output.write(", changes: this.changes")
    end
    output.write(")")
    if entity.hierarchyStrategy == "tpc"
      output.write(".fromMappedSql(" + lspQuote(dataTPCSourceSql(entity)) + ", new neri_data::ParameterValues())")
    else if entity.hierarchyStrategy == "tpt"
      output.write(".fromMappedSql(" + lspQuote(dataTPTSourceSql(entity)) + ", new neri_data::ParameterValues())")
    else if entity.readView != ""
      output.write(".fromMappedSql(" + lspQuote("SELECT * FROM \"" + entity.readView + "\"") + ", new neri_data::ParameterValues())")
    end
    if entity.queryFilter != ""
      output.write(".withGlobalFilter(" + semanticNamespaceDisplay(entity.queryFilter) + "())")
    end
    var filter = entity.firstQueryFilter

    while filter != null
      output.write(".withNamedGlobalFilter(" + lspQuote(filter.name) + ", " + semanticNamespaceDisplay(filter.factory) + "())")
      filter = filter.nextFilter
    end
    output.write("\n")
    entity = entity.nextEntity
  end
  entity = mapping.firstEntity
  dataEmitOwnedStores(output, mapping)

  while entity != null
    dataEmitTPTInit(output, entity)
    dataEmitOwnedInit(output, mapping, entity)
    entity = entity.nextEntity
  end
  relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      let name = "navigation_" + dataRelationName(relation, principal, dependent, foreignKey)

      dataEmitImplicitNavigationInit(output, relation, principal, dependent, foreignKey)

      output.write("    this." + name + " = " + dataNavigationConstructor(
          relation,
          principal,
          dependent,
          foreignKey
        ) + "\n")
      output.write("    neri_data::registerNavigation(this." + principal.setName + ", this." + dependent.setName + ", this." + name + ")\n")
      dataEmitNavigationChangeInit(output, relation, principal, dependent, foreignKey)
    end
    relation = relation.nextRelation
  end
  dataEmitManyInit(output, mapping)
  output.write("    this.navigation = new Navigation_" + mapping.contextName + "(this)\n")
  dataEmitNavigationSelectorRegistrations(output, mapping)
  output.write("  end\n")
  entity = mapping.firstEntity

  while entity != null
    var derived = entity.firstDerived

    while derived != null
      let child = derived.entity

      output.write("\n  ## Selects a mapped subtype and descendants through the root identity tracker.\n  public def ofType_" + child.generatedName + "(): neri_data::Relation<" + semanticNamespaceDisplay(child.typeName) + ">\n    return neri_data::hierarchyOfTypes<" + semanticNamespaceDisplay(entity.typeName) + ", " + semanticNamespaceDisplay(child.typeName) + ">(this." + entity.setName + ", " + dataEntityMappingName(child) + "(), " + lspQuote(entity.discriminatorColumn) + ", " + dataHierarchyDiscriminators(
          mapping,
          entity,
          child
        ) + ", upcast_" + child.generatedName + ", downcast_" + child.generatedName + ")\n  end\n")
      derived = derived.nextDerived
    end
    entity = entity.nextEntity
  end
  dataEmitManyMethods(output, mapping)
  output.write("\n  ## Saves tracked inserts, changes, and removals as one atomic batch.\n  public def saveChanges(): neri_data::WriteResult\n    return this.changes.saveChanges()\n  end\n")
  output.write("\n  ## Starts an owned asynchronous tracked save.\n  public def saveChangesAsync(options: neri_data::StreamOptions? = null): result::Result<neri_data::AsyncSave, neri_data::WriteFailure>\n    match this.changes.beginSaveAsync(options)\n      case neri_data::AsyncSaveStart.Failure(error)\n        return result::Result<neri_data::AsyncSave, neri_data::WriteFailure>.Error(error)\n      case neri_data::AsyncSaveStart.Started(driver)\n        let owned = new neri_data::AsyncSave(driver)\n\n        return result::Result<neri_data::AsyncSave, neri_data::WriteFailure>.Ok(transfer owned)\n    end\n  end\n")
  output.write("\n  ## Finishes rollback retained after an unfinished save is disposed.\n  public def pollSaveCleanup(): neri_data::AsyncWritePoll\n    return this.changes.pollSaveCleanup()\n  end\n")
  output.write("\n  ## Registers an interceptor for synchronous and asynchronous saves.\n  public def addSaveInterceptor(interceptor: neri_data::SaveInterceptor): neri_data::WriteFailure?\n    return this.changes.addSaveInterceptor(interceptor)\n  end\n")
  entity = dataTrackedEntity(mapping.firstEntity)

  while entity != null
    output.write("\n  ## Marks a tracked root and its explicitly linked client-cascade descendants for removal.\n  public def removeCascade_" + entity.setName + "(handle: neri_data::TrackedHandle<" + semanticNamespaceDisplay(entity.typeName) + ">): neri_data::QueryFailure?\n    return neri_data::removeCascade(this.changes, handle)\n  end\n")
    output.write("\n  ## Enrolls a reachable graph through mapped navigation members.\n  public def addGraph_" + entity.setName + "(root: " + semanticNamespaceDisplay(entity.typeName) + "): neri_data::TrackHandleResult<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    output.write("    let traversal = new GraphTraversal_" + mapping.contextName + "(this.changes")
    var tracked = dataTrackedEntity(mapping.firstEntity)

    while tracked != null
      output.write(", this.tracker_" + tracked.generatedName)
      tracked = dataTrackedEntity(tracked.nextEntity)
    end
    output.write(")\n\n    return traversal.add_" + entity.setName + "(root)\n  end\n")
    entity = dataTrackedEntity(entity.nextEntity)
  end
  output.write("\n  ## Detaches tracked entities without writing to the database.\n  public def clear(): Void\n    this.changes.clear()\n")
  dataEmitImplicitClear(output, mapping)
  output.write("  end\n")
  output.write("\n  ## Resets an idle context before its next pool lease.\n  public def resetForPool(): neri_data::WriteFailure?\n    let failure = this.changes.resetForPool()\n\n    if failure != null\n      return failure\n    end\n")
  relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      output.write("    this.navigation_" + dataRelationName(
          relation,
          principal,
          dependent,
          foreignKey
        ) + ".clearLoadedStates()\n")
    end
    relation = relation.nextRelation
  end
  dataEmitImplicitClear(output, mapping)
  output.write("    return null\n  end\n")
  output.write("\n  public def enlistTransaction(lease: Int): neri_data::WriteResult\n    return this.changes.enlistTransaction(lease)\n  end\n\n  public def synchronizeTransaction(): neri_data::WriteResult\n    return this.changes.synchronizeTransaction()\n  end\n")
  for name in ["beginTransaction", "commitTransaction", "rollbackTransaction"]
    output.write("\n  public def " + name + "(): neri_data::WriteResult\n    return this.changes." + name + "()\n  end\n")
    let driverName = name + "DriverAsync"

    output.write("\n  public def " + name + "Async(options: neri_data::StreamOptions? = null): result::Result<neri_data::AsyncContextTransaction, neri_data::WriteFailure>\n    match this.changes." + driverName + "(options)\n      case neri_data::AsyncContextTransactionStart.Failure(error)\n        return result::Result<neri_data::AsyncContextTransaction, neri_data::WriteFailure>.Error(error)\n      case neri_data::AsyncContextTransactionStart.Started(driver)\n        let owned = new neri_data::AsyncContextTransaction(driver)\n\n        return result::Result<neri_data::AsyncContextTransaction, neri_data::WriteFailure>.Ok(transfer owned)\n    end\n  end\n")
  end
  output.write("\n  ## Finishes recovery retained after an unfinished transaction operation is disposed.\n  public def pollTransactionCleanup(): neri_data::AsyncControlPoll\n    return this.changes.pollTransactionCleanup()\n  end\n")
  relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let key = relation.key
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && key != null && foreignKey != null
      if dependent.keyless && relation.referenceMember != ""
        dataEmitKeylessReferenceMethod(output, relation, principal, dependent, foreignKey)
      end
      output.write("\n  ## Queries the dependent rows through the mapped foreign key.\n")
      output.write("  public def ")
      output.write(dataRelationName(relation, principal, dependent, foreignKey), foreignKey.origin)
      output.write("(entity: " + semanticNamespaceDisplay(principal.typeName) + "): neri_data::Query<" + semanticNamespaceDisplay(dependent.typeName) + ">\n")
      output.write("    return this." + dependent.setName)
      var component = 0

      while component < relation.keyMembers.size
        output.write(".where(" + relation.foreignKeyMembers.get(component) + ": entity." + relation.keyMembers.get(component) + ")")
        component = component + 1
      end
      output.write("\n  end\n")
      if dataRelationSupportsLink(relation)
        output.write("\n  ## Links tracked entities through the mapped foreign key.\n  public def ")
        output.write(dataRelationLinkName(relation, principal, dependent, foreignKey), foreignKey.origin)
        output.write("(principal: neri_data::TrackedHandle<" + semanticNamespaceDisplay(principal.typeName) + ">, dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
        output.write("    return this.changes.registerRelation(" + dataRelationEdgeFactoryName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(principal, dependent))\n  end\n")
        output.write("\n  ## Reassigns an explicitly linked dependent to another principal.\n  public def ")
        output.write(dataRelationReassignName(relation, principal, dependent, foreignKey), foreignKey.origin)
        output.write("(newPrincipal: neri_data::TrackedHandle<" + semanticNamespaceDisplay(principal.typeName) + ">, dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
        output.write("    return this.changes.reassignRelation(" + dataRelationEdgeFactoryName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(newPrincipal, dependent))\n  end\n")
        if foreignKey.optional || relation.deleteBehavior == "clientCascade"
          output.write(relation.deleteBehavior == "clientCascade" && !foreignKey.optional ? "\n  ## Removes an explicitly linked required dependent through client cascade.\n  public def " : "\n  ## Clears the optional foreign key of an explicitly linked dependent.\n  public def ")
          output.write(dataRelationUnlinkName(relation, principal, dependent, foreignKey), foreignKey.origin)
          output.write("(dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
          output.write("    return neri_data::unlinkRelation(this.changes, dependent, " + lspQuote(dataRelationSlotName(
                relation,
                dependent,
                foreignKey
              )) + ")\n  end\n")
        end
      end
      if relation.collectionMember != ""
        let p = semanticNamespaceDisplay(principal.typeName)
        let d = semanticNamespaceDisplay(dependent.typeName)
        let name = dataRelationName(relation, principal, dependent, foreignKey)

        output.write("\n  ## Loads the complete collection on access and reuses its loaded state.\n  public def lazy_" + name + "(entity: " + p + "): neri_data::QueryResult<" + d + ">\n    return neri_data::lazyCollection(this." + principal.setName + ", this." + dependent.setName + ", this.navigation_" + name + ", entity)\n  end\n")
        output.write("\n  ## Loads the principal reference on access and reuses its loaded state.\n  public def lazyReference_" + name + "(entity: " + d + "): neri_data::QueryResult<" + p + ">\n    return neri_data::lazyReference(this." + dependent.setName + ", this." + principal.setName + ", this.navigation_" + name + ", entity)\n  end\n")
        output.write("\n  public def collectionState_" + name + "(entity: " + p + "): neri_data::NavigationLoadState\n    return this.navigation_" + name + ".collectionState(entity)\n  end\n")
        output.write("\n  public def referenceState_" + name + "(entity: " + d + "): neri_data::NavigationLoadState\n    return this.navigation_" + name + ".referenceState(entity)\n  end\n")

        output.write("\n  ## Loads collection and inverse reference navigations.\n  public def include_" + dataRelationName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(principals: neri_data::Query<" + p + ">): neri_data::IncludedQuery<" + p + ", " + d + ">\n")
        output.write("    let navigation = this.navigation_" + name + "\n")
        output.write("\n    return neri_data::include(principals, this." + dependent.setName + ", navigation)\n  end\n")
        output.write("\n  ## Loads the principal reference for dependent rows.\n  public def includeReference_" + dataRelationName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(dependents: neri_data::Query<" + d + ">): neri_data::ReferencedQuery<" + p + ", " + d + ">\n")
        output.write("    let navigation = this.navigation_" + name + "\n")
        output.write("\n    return neri_data::includeReference(dependents, this." + principal.setName + ", navigation)\n  end\n")
        output.write("\n  ## Builds a deferred collection step for a typed navigation path.\n  public def collectionStep_" + dataRelationName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(maximum: Int = 10000, children: neri_data::Query<" + d + ">? = null): neri_data::NavigationStep<" + p + ", " + d + ">\n")
        output.write("    let navigation = this.navigation_" + name + "\n")
        output.write("\n    return neri_data::collectionStep(this." + principal.setName + ", this." + dependent.setName + ", navigation, maximum, children)\n  end\n")
        output.write("\n  ## Builds a deferred reference step for a typed navigation path.\n  public def referenceStep_" + dataRelationName(
            relation,
            principal,
            dependent,
            foreignKey
          ) + "(): neri_data::NavigationStep<" + d + ", " + p + ">\n")
        output.write("    let navigation = this.navigation_" + name + "\n")
        output.write("\n    return neri_data::referenceStep(this." + dependent.setName + ", this." + principal.setName + ", navigation)\n  end\n")
      end
    end
    relation = relation.nextRelation
  end
  output.write("end\n")
  return output
end

def dataNavigationConstructor(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): String
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)

  return "new neri_data::CollectionNavigation<" + p + ", " + d + ">(" + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    "principal_key"
  ) + ", " + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    "dependent_key"
  ) + ", " + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    "foreign_key"
  ) + ", " + lspQuote(foreignKey.columnName) + ", " + dataNavigationCallbackName(
    relation,
    principal,
    dependent,
    foreignKey,
    "get_collection"
  ) + ", " + dataNavigationCallbackName(
    relation,
    principal,
    dependent,
    foreignKey,
    "set_collection"
  ) + ", " + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    "get_reference"
  ) + ", " + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    "set_reference"
  ) + ", foreignKeyColumns: " + dataMemberColumns(
    dependent,
    relation.foreignKeyMembers
  ) + ", principalKeyColumns: " + dataMemberColumns(
    principal,
    relation.keyMembers
  ) + ")"
end

def dataEmit(mapping: DataMapping): DataEmission
  let emission = new DataEmission()

  emission.outputPath = mapping.outputPath

  if mapping.error != ""
    emission.error = mapping.error
    return emission
  end
  if !dataEmissionPublicNames(mapping, emission)
    return emission
  end
  var entity = mapping.firstEntity

  while entity != null
    let name = dataEntityArtifactName(entity)

    if !dataArtifactName(name)
      emission.error = "Mapped entity '" + entity.typeName + "' cannot produce a safe generated source filename. Use an ASCII identifier for the type name."
      return emission
    end
    var prior = mapping.firstEntity

    while prior != null && prior.typeName != entity.typeName
      if dataSqlSameIdentifier(dataEntityArtifactName(prior), name)
        emission.error = "Mapped entities '" + prior.typeName + "' and '" + entity.typeName + "' produce the same generated source filename without regard to ASCII case: " + name
        return emission
      end
      prior = prior.nextEntity
    end
    entity = entity.nextEntity
  end
  entity = mapping.firstEntity

  while entity != null
    let output = new DataArtifact()

    output.name = dataEntityArtifactName(entity)
    output.write((entity.firstDerived == null ? "" : "use reference\n\n") + "use json\nuse result\nnamespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
    dataEmitSyntheticJoin(output, mapping, entity)
    dataEmitJsonModels(output, mapping, entity)
    dataEmitMapping(output, entity)
    dataEmitDecoder(output, entity)
    var derived = entity.firstDerived

    while derived != null
      dataEmitMapping(output, derived.entity)
      dataEmitDecoder(output, derived.entity)
      if entity.hierarchyStrategy == "tpt"
        dataEmitCapture(output, derived.entity)
        dataEmitApply(output, derived.entity)
      end
      output.write("def upcast_" + derived.entity.generatedName + "(entity: " + semanticNamespaceDisplay(derived.entity.typeName) + "): " + semanticNamespaceDisplay(entity.typeName) + "\n  return entity\nend\n\n")
      output.write("def downcast_" + derived.entity.generatedName + "(entity: " + semanticNamespaceDisplay(entity.typeName) + "): " + semanticNamespaceDisplay(derived.entity.typeName) + "?\n  return reference::cast<" + semanticNamespaceDisplay(derived.entity.typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(entity)\nend\n\n")
      derived = derived.nextDerived
    end
    dataEmitCapture(output, entity)
    dataEmitTPCLayout(output, entity)
    if !entity.keyless
      dataEmitApply(output, entity)
      if entity.generatedKey
        dataEmitGeneratedKeySetter(output, entity)
      end
      if dataHasGeneratedFields(entity)
        dataEmitGeneratedFieldsSetter(output, entity)
      end
      dataEmitSnapshot(output, entity)
    end
    emission.add(output)
    entity = entity.nextEntity
  end
  emission.add(dataEmitContext(mapping))
  emission.add(dataEmitGraph(mapping))
  emission.add(dataEmitSchema(mapping))
  dataEmitNavigationFacades(mapping, emission)
  return emission
end

def dataEntityKeyColumns(entity: DataEntity): String
  var result = "["
  var index = 0

  while index < entity.keyMembers.size
    let field = entity.field(entity.keyMembers.get(index))

    if field != null
      result = result + (index == 0 ? "" : ", ") + lspQuote(field.columnName)
    end
    index = index + 1
  end
  return result + "]"
end

def dataMemberColumns(entity: DataEntity, members: StringBuffer): String
  var result = "["
  var index = 0

  while index < members.size
    let field = entity.field(members.get(index))

    if field != null
      result = result + (index == 0 ? "" : ", ") + lspQuote(field.columnName)
    end
    index = index + 1
  end
  return result + "]"
end

def dataSchemaReferenceCode(mapping: DataMapping, entity: DataEntity, field: DataField): String
  var relation = mapping.firstRelation
  let owner = dataTPCSchemaOwner(mapping, entity)

  if entity.hierarchyParent != "" && field.memberName == entity.keyMember
    var root = mapping.firstEntity

    while root != null
      if root.hierarchyStrategy == "tpt"
        let parent = dataHierarchyEntity(root, entity.hierarchyParent)

        if parent != null
          return ", reference: new neri_data::SchemaReference(" + lspQuote(parent.tableName) + ", " + dataEntityKeyColumns(parent) + ", " + dataEntityKeyColumns(entity) + ")"
        end
      end
      root = root.nextEntity
    end
  end

  while relation != null
    let principal = relation.principal

    if relation.dependentType == owner.typeName && dataReferenceAnchor(relation) == field.memberName && principal != null
      if principal.hierarchyStrategy == "tpc"
        return ""
      end
      return ", reference: new neri_data::SchemaReference(" + lspQuote(principal.tableName) + ", " + dataMemberColumns(
        principal,
        relation.keyMembers
      ) + ", " + dataMemberColumns(
        entity,
        relation.foreignKeyMembers
      ) + (relation.databaseOnDelete == "NO ACTION" ? "" : ", onDelete: " + lspQuote(relation.databaseOnDelete)) + (relation.deferred ? ", deferred: true" : "") + ")"
    end
    relation = relation.nextRelation
  end
  return ""
end

def dataRelationKeyCell(entity: DataEntity, members: StringBuffer, first: DataField): String
  if members.size == 1
    return dataCaptureCell(first)
  end
  return "neri_data::compositeKeyCell(capture_" + entity.generatedName + "(entity), " + dataMemberColumns(
    entity,
    members
  ) + ")"
end

def dataRelationTupleMetadata(relation: DataRelation, dependent: DataEntity): String
  if relation.keyMembers.size == 1
    return ""
  end
  var result = ", tupleColumns: new neri_data::ResultColumns(["
  var index = 0

  while index < relation.foreignKeyMembers.size
    let field = dependent.field(relation.foreignKeyMembers.get(index))

    if field != null
      result = result + (index == 0 ? "" : ", ") + dataResultColumn(field)
    end
    index = index + 1
  end
  return result + "])"
end

def dataEmitCompositeForeignKeySetter(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  output.write("def " + dataRelationForeignKeySetterName(
      relation,
      principal,
      dependent,
      foreignKey
    ) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: neri_data::Cell): Void\n  match value\n    case neri_data::Cell.Null()\n")
  var index = 0

  if foreignKey.optional
    while index < relation.foreignKeyMembers.size
      output.write("      entity." + relation.foreignKeyMembers.get(index) + " = null\n")
      index = index + 1
    end
  end
  output.write("      return\n    case neri_data::Cell.Int(unused)\n      return\n    case neri_data::Cell.Bool(unused)\n      return\n    case neri_data::Cell.Float(unused)\n      return\n    case neri_data::Cell.Binary(unused)\n      return\n    case neri_data::Cell.Text(unused)\n  end\n  let row = neri_data::compositeKeyRow(value, " + dataMemberColumns(
      dependent,
      relation.foreignKeyMembers
    ) + ")\n\n  if row == null\n    return\n  end\n")
  index = 0
  while index < relation.foreignKeyMembers.size
    let field = dependent.field(relation.foreignKeyMembers.get(index))

    if field != null
      let decode = field.conversionDecode == "" ? "neri_data::decode" + (field.optional ? "Nullable" : "") + dataScalarName(field.domain) : semanticNamespaceDisplay(field.conversionDecode)

      output.write("  var value_" + field.memberName + ": " + semanticNamespaceDisplay(field.typeName) + " = " + dataInitialValue(field) + "\n  match " + decode + "(row, " + lspQuote(field.columnName) + ")\n    case neri_data::DecodeResult.Failure(error)\n      return\n    case neri_data::DecodeResult.Value(decoded)\n      value_" + field.memberName + " = decoded\n  end\n")
    end
    index = index + 1
  end
  index = 0
  while index < relation.foreignKeyMembers.size
    let member = relation.foreignKeyMembers.get(index)

    output.write("  entity." + member + " = value_" + member + "\n")
    index = index + 1
  end
  output.write("end\n\n")
end

def dataEntityHasExtendedScalars(entity: DataEntity): Bool
  if entity.firstComplex != null || entity.discriminatorColumn != ""
    return true
  end
  var field = entity.firstField

  while field != null
    if field.getter != "" || field.conversionEncode != "" || field.boolToInt || dataScalarName(field.domain) == "ByteBuffer" || dataScalarName(field.domain) == "Decimal"
      return true
    end
    field = field.nextField
  end
  return false
end


def dataAlternateKeyColumns(entity: DataEntity): String
  var result = "["
  var definition = entity.firstIndex

  while definition != null
    if definition.alternateKey
      result = result + (result == "[" ? "" : ", ") + "["
      var position = 0

      while position < definition.fields.size
        var field = entity.firstField

        while field != null
          if dataFieldIdentity(field) == definition.fields.get(position)
            result = result + (position == 0 ? "" : ", ") + lspQuote(field.columnName)
          end
          field = field.nextField
        end
        position = position + 1
      end
      result = result + "]"
    end
    definition = definition.nextIndex
  end
  return result + "]"
end

def dataForeignKeyColumns(mapping: DataMapping, entity: DataEntity): String
  var result = "["
  var relation = mapping.firstRelation

  while relation != null
    if relation.dependentType == entity.typeName
      result = result + (result == "[" ? "" : ", ") + dataMemberColumns(entity, relation.foreignKeyMembers)
    end
    relation = relation.nextRelation
  end
  return result + "]"
end


def dataRelationSlotName(relation: DataRelation, dependent: DataEntity, first: DataField): String
  if relation.foreignKeyMembers.size == 1
    return first.columnName
  end
  var result = "tuple:"
  var position = 0

  while position < relation.foreignKeyMembers.size
    let field = dependent.field(relation.foreignKeyMembers.get(position))

    if field != null
      result = result + (host::stringByteLength(field.columnName) as String) + ":" + field.columnName
    end
    position = position + 1
  end
  return result
end
