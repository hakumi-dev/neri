use host

def dataEmissionNamePresent(names: StringBuffer, name: String): Bool
  var index = 0

  while index < names.size
    if names.get(index) == name
      return true
    end
    index = index + 1
  end
  return false
end

def dataEmissionAddName(emission: DataEmission, names: StringBuffer, name: String, kind: String): Bool
  if dataEmissionNamePresent(names, name)
    emission.error = "Generated " + kind + " name '" + name + "' collides with another generated declaration. Rename the mapped type, set, field, relation, or context."
    return false
  end
  names.add(name)
  return true
end

def dataEmissionExistingName(mapping: DataMapping, fullName: String): Bool
  let semantic = mapping.semantic

  if semantic == null
    return false
  end
  var classSymbol = semantic.firstClass

  while classSymbol != null
    if classSymbol.genericOrigin < 0 && classSymbol.fullName == fullName
      return true
    end
    classSymbol = classSymbol.nextClass
  end
  var callable = semantic.firstFunction

  while callable != null
    if callable.genericOrigin < 0 && callable.fullName == fullName
      return true
    end
    callable = callable.nextCallable
  end
  return false
end

def dataEmissionPublicNames(mapping: DataMapping, emission: DataEmission): Bool
  let declarations = new StringBuffer()

  if !dataEmissionAddName(emission, declarations, mapping.contextName, "type")
    return false
  end
  if !dataEmissionAddName(emission, declarations, "schema_" + mapping.contextName, "schema factory")
    return false
  end
  if !dataEmissionAddName(emission, declarations, "GraphTraversal_" + mapping.contextName, "graph traversal")
    return false
  end
  var entity = mapping.firstEntity

  while entity != null
    if !dataEmissionAddName(emission, declarations, dataEntityMappingName(entity), "mapping factory") || !dataEmissionAddName(emission, declarations, dataEntityDecoderName(entity), "decoder") || !dataEmissionAddName(emission, declarations, "capture_" + entity.generatedName, "persistence capture") || !dataEmissionAddName(emission, declarations, "apply_" + entity.generatedName, "persistence apply") || !dataEmissionAddName(emission, declarations, "key_" + entity.generatedName, "key accessor") || !dataEmissionAddName(emission, declarations, "snapshot_" + entity.generatedName, "snapshot")
      return false
    end
    if entity.generatedKey && !dataEmissionAddName(emission, declarations, "set_generated_key_" + entity.generatedName, "generated key setter")
      return false
    end
    if dataHasGeneratedFields(entity) && !dataEmissionAddName(emission, declarations, "apply_generated_" + entity.generatedName, "generated value setter")
      return false
    end
    entity = entity.nextEntity
  end
  let contextMembers = new StringBuffer()

  if !dataEmissionAddName(emission, contextMembers, "init", "context member")
    return false
  end
  if !dataEmissionAddName(emission, contextMembers, "saveChanges", "context member") || !dataEmissionAddName(emission, contextMembers, "changes", "context member")
    return false
  end
  for name in ["clear", "beginTransaction", "commitTransaction", "rollbackTransaction"]
    if !dataEmissionAddName(emission, contextMembers, name, "context member")
      return false
    end
  end
  entity = mapping.firstEntity
  while entity != null
    if !dataEmissionAddName(emission, contextMembers, entity.setName, "context member") || !dataEmissionAddName(emission, contextMembers, "tracker_" + entity.generatedName, "context member") || !dataEmissionAddName(emission, contextMembers, "removeCascade_" + entity.setName, "context member") || !dataEmissionAddName(emission, contextMembers, "addGraph_" + entity.setName, "context member")
      return false
    end
    entity = entity.nextEntity
  end
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null
      let name = dataRelationName(relation, principal, dependent, foreignKey)

      if !dataEmissionAddName(emission, contextMembers, name, "context member")
        return false
      end
      if dataRelationSupportsLink(relation)
        if !dataEmissionAddName(emission, contextMembers, dataRelationLinkName(relation, principal, dependent, foreignKey), "context member")
          return false
        end
        if !dataEmissionAddName(emission, contextMembers, dataRelationReassignName(relation, principal, dependent, foreignKey), "context member")
          return false
        end
        if (foreignKey.optional || relation.deleteBehavior == "clientCascade") && !dataEmissionAddName(emission, contextMembers, dataRelationUnlinkName(relation, principal, dependent, foreignKey), "context member")
          return false
        end
        if !dataEmissionAddName(emission, declarations, dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey), "relationship foreign-key getter") || !dataEmissionAddName(emission, declarations, dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey), "relationship foreign-key setter")
          return false
        end
        if !dataEmissionAddName(emission, declarations, "edge_" + name, "relationship edge factory")
          return false
        end
        if !dataRelationUsesLegacyIntLink(relation) && !dataEmissionAddName(emission, declarations, dataRelationPrincipalCellGetterName(relation, principal, dependent, foreignKey), "relationship principal-key getter")
          return false
        end
      end
      if relation.collectionMember != ""
        if !dataEmissionAddName(emission, contextMembers, "include_" + name, "context member")
          return false
        end
        if !dataEmissionAddName(emission, contextMembers, "includeReference_" + name, "context member")
          return false
        end
        if !dataEmissionAddName(emission, contextMembers, "collectionStep_" + name, "context member") || !dataEmissionAddName(emission, contextMembers, "referenceStep_" + name, "context member")
          return false
        end
        for prefix in ["nav_principal_key_", "nav_dependent_key_", "nav_foreign_key_", "nav_get_collection_", "nav_set_collection_", "nav_get_reference_", "nav_set_reference_"]
          if !dataEmissionAddName(emission, declarations, prefix + name, "navigation callback")
            return false
          end
        end
      end
    end
    relation = relation.nextRelation
  end
  let graphMembers = new StringBuffer()

  if !dataEmissionAddName(emission, graphMembers, "init", "graph traversal member") || !dataEmissionAddName(emission, graphMembers, "graph", "graph traversal member")
    return false
  end
  entity = mapping.firstEntity
  while entity != null
    if !dataEmissionAddName(emission, graphMembers, "tracker_" + entity.generatedName, "graph traversal member") || !dataEmissionAddName(emission, graphMembers, "visits_" + entity.generatedName, "graph traversal member") || !dataEmissionAddName(emission, graphMembers, "discover_" + entity.setName, "graph traversal member") || !dataEmissionAddName(emission, graphMembers, "scan_" + entity.setName, "graph traversal member") || !dataEmissionAddName(emission, graphMembers, "add_" + entity.setName, "graph traversal member")
      return false
    end
    entity = entity.nextEntity
  end
  relation = mapping.firstRelation
  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      if !dataEmissionAddName(emission, graphMembers, "link_" + dataRelationName(relation, principal, dependent, foreignKey), "graph traversal member")
        return false
      end
    end
    relation = relation.nextRelation
  end
  var index = 0

  while index < declarations.size
    let name = declarations.get(index)

    if dataEmissionExistingName(mapping, mapping.namespaceName + "." + name)
      emission.error = "Generated declaration '" + mapping.namespaceName + "." + name + "' already exists in the mapped project. Change the generated namespace or mapped name."
      return false
    end
    index = index + 1
  end
  return true
end

def dataInitialValue(field: DataField): String
  if field.optional
    return "null"
  end
  return dataScalarInitialValue(field.domain)
end

def dataResultColumn(field: DataField): String
  let kind = dataScalarColumn(field.domain)

  return "new neri_data::ResultColumn(" + lspQuote(field.columnName) + ", neri_data::ResultColumnKind." + kind + "(), " + (field.optional ? "true" : "false") + ")"
end

def dataResultColumns(entity: DataEntity): String
  var result = "new neri_data::ResultColumns(["
  var separator = ""
  var field = entity.firstField

  while field != null
    result = result + separator + dataResultColumn(field)
    separator = ", "
    field = field.nextField
  end
  return result + "])"
end

def dataOriginDoc(origin: DataOrigin): String
  return "## Source: " + origin.identity + ".\n"
end

def dataEntityMappingName(entity: DataEntity): String
  return "mappingEntity_" + (host::stringByteLength(entity.generatedName) as String) + "_" + entity.generatedName
end

def dataEntityDecoderName(entity: DataEntity): String
  return "decodeEntity_" + (host::stringByteLength(entity.generatedName) as String) + "_" + entity.generatedName
end

def dataEntityArtifactName(entity: DataEntity): String
  return entity.generatedName + ".entity.hk"
end

def dataPrivateLocal(entity: DataEntity, requested: String): String
  var result = requested
  var collision = true

  while collision
    collision = false
    var field = entity.firstField

    while field != null
      collision = true if field.memberName == result
      field = field.nextField
    end
    result = result + "_internal" if collision
  end
  return result
end

def dataFieldIdentity(field: DataField): String
  let symbol = field.symbol

  if symbol != null
    return symbol.owner + "." + symbol.name
  end
  return ""
end

def dataRelationName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return dependent.setName + "For_" + principal.generatedName + "_by_" + foreignKey.memberName
end

def dataRelationSupportsLink(relation: DataRelation): Bool
  let key = relation.key
  let foreignKey = relation.foreignKey

  return key != null && foreignKey != null && (key.typeName == "Int" || key.typeName == "String") && key.typeName == (foreignKey.optional ? semanticInnerType(foreignKey.typeName) : foreignKey.typeName)
end

def dataRelationUsesLegacyIntLink(relation: DataRelation): Bool
  let key = relation.key
  let foreignKey = relation.foreignKey

  return key != null && foreignKey != null && key.typeName == "Int" && foreignKey.typeName == "Int"
end

def dataRelationPolicyArgument(relation: DataRelation): String
  if relation.deleteBehavior == "clientCascade"
    return ", neri_data::RelationshipDeletePolicy.ClientCascade()"
  end
  if relation.deleteBehavior == "clientSetNull"
    return ", neri_data::RelationshipDeletePolicy.ClientSetNull()"
  end
  return ""
end

def dataRelationLinkName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "link_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationReassignName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "reassign_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationUnlinkName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "unlink_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationForeignKeyGetterName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "get_fk_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationForeignKeySetterName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "set_fk_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationPrincipalCellGetterName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "get_pk_cell_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationEdgeFactoryName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): String
  return "edge_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataRelationNavigationName(relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField, prefix: String): String
  return "nav_" + prefix + "_" + dataRelationName(relation, principal, dependent, foreignKey)
end

def dataEmitDecoder(output: DataArtifact, entity: DataEntity): Void
  var field = entity.firstField

  output.write(dataOriginDoc(entity.origin))
  output.write("def ")
  output.write(dataEntityDecoderName(entity), entity.origin)
  output.write("(row: neri_data::RawRow): neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
  field = entity.firstField

  while field != null
    let local = "value_" + field.memberName

    output.write("  var " + local + ": " + semanticNamespaceDisplay(field.typeName) + " = " + dataInitialValue(field) + "\n")
    output.write("\n  match neri_data::decode" + (field.optional ? "Nullable" : "") + dataScalarName(field.domain) + "(row, ")
    output.write(lspQuote(field.columnName), field.origin)
    output.write(")\n    case neri_data::DecodeResult.Value(value)\n      " + local + " = value\n    case neri_data::DecodeResult.Failure(error)\n      return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(error)\n  end\n")
    field = field.nextField
  end
  let decodedEntity = dataPrivateLocal(entity, "decodedEntity")

  output.write("  let " + decodedEntity + " = new " + semanticNamespaceDisplay(entity.typeName) + "(")
  if !entity.initializeWithFields
    field = entity.firstField
    var first = true

    while field != null
      output.write((first ? "" : ", ") + field.memberName + ": value_" + field.memberName)
      first = false
      field = field.nextField
    end
  end
  output.write(")\n")
  if entity.initializeWithFields
    field = entity.firstField

    while field != null
      output.write("  " + decodedEntity + "." + field.memberName + " = value_" + field.memberName + "\n")
      field = field.nextField
    end
  end
  output.write("\n  return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Value(" + decodedEntity + ")\nend\n\n")
end

def dataEmitMapping(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def ")
  output.write(dataEntityMappingName(entity), entity.origin)
  output.write("(): neri_data::EntityMapping\n  return new neri_data::EntityMapping(" + lspQuote(entity.typeName) + ", " + lspQuote(entity.tableName) + ", [")
  var field = entity.firstField
  var separator = ""

  while field != null
    output.write(separator + "new neri_data::MappingColumn(")
    output.write(lspQuote(dataFieldIdentity(field)), field.origin)
    output.write(", " + lspQuote(field.typeName) + ", " + lspQuote(field.columnName) + ")")
    separator = ", "
    field = field.nextField
  end
  let key = entity.field(entity.keyMember)

  if key != null
    output.write("], " + lspQuote(key.columnName) + ")\nend\n\n")
  else
    output.write("])\nend\n\n")
  end
end

def dataEmitSchema(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "schema.hk"
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  output.write("## Describes the mapped tables and columns for schema comparison.\ndef schema_" + mapping.contextName + "(): neri_data::SchemaModel\n  return new neri_data::SchemaModel([")
  var entity = mapping.firstEntity
  var tableSeparator = ""

  while entity != null
    output.write(tableSeparator + "\n      new neri_data::SchemaTable(")
    output.write(lspQuote(entity.typeName), entity.origin)
    output.write(", ")
    output.write(lspQuote(entity.tableName), entity.origin)
    output.write(", [")
    var field = entity.firstField
    var fieldSeparator = ""

    while field != null
      output.write(fieldSeparator + "\n          new neri_data::SchemaField(")
      output.write(lspQuote(dataFieldIdentity(field)), field.origin)
      output.write(", new neri_data::SchemaColumn(")
      output.write(lspQuote(field.columnName), field.origin)
      output.write(", neri_data::SchemaType." + dataScalarColumn(field.domain) + "(), nullable: " + (field.optional ? "true" : "false") + ", primaryKey: " + (field.memberName == entity.keyMember ? "true" : "false"))
      if field.defaultCode != ""
        output.write(", defaultValue: " + field.defaultCode)
      end
      output.write("))")
      fieldSeparator = ","
      field = field.nextField
    end
    output.write("\n        ]")
    var index = entity.firstIndex
    var indexSeparator = ""

    if index != null
      output.write(", [")
    end
    while index != null
      output.write(indexSeparator + "\n          new neri_data::SchemaIndex(" + lspQuote(index.name) + ", [")
      var member = 0
      var memberSeparator = ""

      while member < index.fields.size
        output.write(memberSeparator + lspQuote(index.fields.get(member)))
        memberSeparator = ", "
        member = member + 1
      end
      output.write("], " + (index.unique ? "true" : "false") + ")")
      indexSeparator = ","
      index = index.nextIndex
    end
    if entity.firstIndex != null
      output.write("\n        ]")
    end
    output.write(")")
    tableSeparator = ","
    entity = entity.nextEntity
  end
  output.write("\n    ])\nend\n")
  return output
end

def dataEmitSnapshot(output: DataArtifact, entity: DataEntity): Void
  output.write("## Captures the mapped scalar values.\ndef ")
  output.write("snapshot_" + entity.generatedName, entity.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): fields of " + semanticNamespaceDisplay(entity.typeName) + "\n  return neri_data::snapshot<" + semanticNamespaceDisplay(entity.typeName) + ">(")
  var field = entity.firstField
  var separator = ""

  while field != null
    output.write(separator)
    output.write(field.memberName, field.origin)
    output.write(": entity.")
    output.write(field.memberName, field.origin)
    separator = ", "
    field = field.nextField
  end
  output.write(")\nend\n\n")
  let key = entity.field(entity.keyMember)

  if key != null
    output.write(dataOriginDoc(key.origin))
    output.write("def ")
    output.write("key_" + entity.generatedName, key.origin)
    output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): " + semanticNamespaceDisplay(key.typeName) + "\n  return entity." + key.memberName + "\nend\n")
  end
end

def dataCaptureCell(field: DataField): String
  let member = "entity." + field.memberName

  if field.optional
    return "neri_data::cellOptional" + dataScalarName(field.domain) + "(" + member + ")"
  end
  return "neri_data::Cell." + dataScalarColumn(field.domain) + "(" + member + ")"
end

def dataEmitCapture(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def capture_" + entity.generatedName, entity.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + "): neri_data::RawRow\n  return new neri_data::RawRow([")
  var field = entity.firstField
  var separator = ""

  while field != null
    output.write(separator + "new neri_data::RawColumn(")
    output.write(lspQuote(field.columnName), field.origin)
    output.write(", ")
    output.write(dataCaptureCell(field), field.origin)
    output.write(")")
    separator = ", "
    field = field.nextField
  end
  output.write("])\nend\n\n")
end

def dataEmitApply(output: DataArtifact, entity: DataEntity): Void
  output.write(dataOriginDoc(entity.origin))
  output.write("def apply_" + entity.generatedName, entity.origin)
  output.write("(target: " + semanticNamespaceDisplay(entity.typeName) + ", source: " + semanticNamespaceDisplay(entity.typeName) + "): Void\n")
  var field = entity.firstField

  while field != null
    output.write("  target.")
    output.write(field.memberName, field.origin)
    output.write(" = source.")
    output.write(field.memberName, field.origin)
    output.write("\n")
    field = field.nextField
  end
  output.write("end\n\n")
end

def dataHasGeneratedFields(entity: DataEntity): Bool
  var field = entity.firstField

  while field != null
    if field.generatedOnAdd
      return true
    end
    field = field.nextField
  end
  return false
end

def dataEmitGeneratedFieldsSetter(output: DataArtifact, entity: DataEntity): Void
  output.write("## Applies validated returned values without changing other mapped fields.\ndef apply_generated_" + entity.generatedName, entity.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + ", row: readonly neri_data::RawRow): Void\n")
  var field = entity.firstField

  while field != null
    if field.generatedOnAdd
      output.write("  match row.value(" + lspQuote(field.columnName) + ")\n    case neri_data::CellLookup.Missing()\n    case neri_data::CellLookup.Found(cell)\n      match cell\n        case neri_data::Cell.Null()\n")
      if field.optional
        output.write("          entity." + field.memberName + " = null\n", field.origin)
      end
      for kind in ["Bool", "Int", "Float", "Text"]
        output.write("        case neri_data::Cell." + kind + "(value)\n")
        if kind == dataScalarColumn(field.domain)
          output.write("          entity." + field.memberName + " = value\n", field.origin)
        end
      end
      output.write("      end\n  end\n")
    end
    field = field.nextField
  end
  output.write("end\n\n")
end

def dataEmitGeneratedFieldsMetadata(output: DataArtifact, entity: DataEntity): Void
  output.write(", generatedColumns: [")
  var field = entity.firstField
  var separator = ""

  while field != null
    if field.generatedOnAdd
      output.write(separator + "new neri_data::GeneratedValueColumn(new neri_data::ResultColumn(" + lspQuote(field.columnName) + ", neri_data::ResultColumnKind." + dataScalarColumn(field.domain) + "(), " + (field.optional ? "true" : "false") + "), neri_data::GeneratedValueTiming." + (field.generatedOnUpdate ? "OnAddOrUpdate" : "OnAdd") + "())")
      separator = ", "
    end
    field = field.nextField
  end
  output.write("], applyGenerated: apply_generated_" + entity.generatedName)
end

def dataEmitGeneratedKeySetter(output: DataArtifact, entity: DataEntity): Void
  let key = entity.field(entity.keyMember)

  if key == null
    return
  end
  output.write(dataOriginDoc(key.origin))
  output.write("def set_generated_key_" + entity.generatedName, key.origin)
  output.write("(entity: " + semanticNamespaceDisplay(entity.typeName) + ", value: Int): Void\n  entity.")
  output.write(key.memberName, key.origin)
  output.write(" = value\nend\n\n")
end

def dataEmitScalarForeignKeySetter(output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): Void
  output.write(dataOriginDoc(foreignKey.origin))
  output.write("def " + dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: neri_data::Cell): Void\n  match value\n")
  let actualType = foreignKey.optional ? semanticInnerType(foreignKey.typeName) : foreignKey.typeName

  if actualType == "Int"
    output.write("    case neri_data::Cell.Int(number)\n      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = number\n    case neri_data::Cell.Text(text)\n    case neri_data::Cell.Bool(boolean)\n")
  else
    output.write("    case neri_data::Cell.Text(text)\n      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = text\n    case neri_data::Cell.Int(number)\n    case neri_data::Cell.Bool(boolean)\n")
  end
  output.write("    case neri_data::Cell.Float(real)\n")
  output.write("    case neri_data::Cell.Null()\n")
  if foreignKey.optional
    output.write("      entity.")
    output.write(foreignKey.memberName, foreignKey.origin)
    output.write(" = null\n")
  end
  output.write("  end\nend\n\n")
end

def dataEmitRelationEdgeFactory(output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)

  output.write(dataOriginDoc(foreignKey.origin))
  output.write("def " + dataRelationEdgeFactoryName(relation, principal, dependent, foreignKey) + "(principal: neri_data::TrackedHandle<" + p + ">, dependent: neri_data::TrackedHandle<" + d + ">): neri_data::RelationshipEdge\n")
  if dataRelationUsesLegacyIntLink(relation)
    output.write("  let link = new neri_data::RelationshipLink<" + p + ", " + d + ">(principal, dependent, key_" + principal.generatedName + ", " + dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey) + ", " + dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey) + ", " + lspQuote(foreignKey.columnName) + dataRelationPolicyArgument(relation) + ")\n")
  else
    let key = relation.key

    if key != null
      let kind = key.typeName == "Int" ? "Int" : "Text"

      output.write("  let link = new neri_data::ScalarRelationshipLink<" + p + ", " + d + ">(principal, dependent, " + dataRelationPrincipalCellGetterName(relation, principal, dependent, foreignKey) + ", " + dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey) + ", " + dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey) + ", neri_data::ResultColumnKind." + kind + "(), " + (foreignKey.optional ? "true" : "false") + ", " + lspQuote(foreignKey.columnName) + dataRelationPolicyArgument(relation) + ")\n")
    end
  end
  output.write("\n  return link.edge()\nend\n\n")
end

def dataEmitGraphVisit(output: DataArtifact, entity: DataEntity): Void
  let typeName = semanticNamespaceDisplay(entity.typeName)
  let name = entity.setName

  output.write("\n  private def discover_" + name + "(entity: " + typeName + "): neri_data::GraphVisitResult<" + typeName + ">\n")
  output.write("    match this.visits_" + entity.generatedName + ".visit(entity)\n")
  output.write("      case neri_data::GraphVisitResult.Failure(error)\n        return neri_data::GraphVisitResult<" + typeName + ">.Failure(error)\n")
  output.write("      case neri_data::GraphVisitResult.Existing(slot)\n        return neri_data::GraphVisitResult<" + typeName + ">.Existing(slot)\n")
  output.write("      case neri_data::GraphVisitResult.New(slot)\n")
  output.write("        let staged = this.graph.stageNode(slot, this.tracker_" + entity.generatedName + ")\n\n        if staged != null\n          return neri_data::GraphVisitResult<" + typeName + ">.Failure(staged)\n        end\n")
  output.write("        let scan: fn(): neri_data::QueryFailure? = fn(): neri_data::QueryFailure?\n          return this.scan_" + name + "(entity, slot)\n        end\n")
  output.write("        let queued = this.graph.enqueue(scan)\n\n        if queued != null\n          return neri_data::GraphVisitResult<" + typeName + ">.Failure(queued)\n        end\n")
  output.write("        return neri_data::GraphVisitResult<" + typeName + ">.New(slot)\n    end\n  end\n")
end

def dataEmitGraphLink(output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("\n  private def link_" + name + "(principal: neri_data::GraphSlot<" + p + ">, dependent: neri_data::GraphSlot<" + d + ">, entity: " + d + "): neri_data::QueryFailure?\n")
  output.write("    let previous = entity.")
  output.write(foreignKey.memberName, foreignKey.origin)
  output.write("\n    let restore: fn(): Void = fn(): Void\n      entity.")
  output.write(foreignKey.memberName, foreignKey.origin)
  output.write(" = previous\n    end\n\n    return this.graph.stageLink(principal, dependent, " + dataRelationEdgeFactoryName(relation, principal, dependent, foreignKey) + ", restore)\n  end\n")
end

def dataEmitGraphCollectionScan(output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): Void
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("    for child in entity.")
  output.write(relation.collectionMember, relation.collectionOrigin)
  output.write("\n      let inverse = child.")
  output.write(relation.referenceMember, relation.referenceOrigin)
  output.write("\n\n      if inverse != null && !reference::same(inverse, entity)\n        return neri_data::QueryFailure.Provider(" + lspQuote("graph navigation inverse disagrees with collection: " + name) + ")\n      end\n")
  output.write("      var related: neri_data::GraphSlot<" + d + ">? = null\n\n      match this.discover_" + dependent.setName + "(child)\n")
  output.write("        case neri_data::GraphVisitResult.New(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Existing(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Failure(error)\n          return error\n      end\n")
  output.write("      if related != null\n        let failure = this.link_" + name + "(owner, related, child)\n\n        if failure != null\n          return failure\n        end\n      end\n    end\n")
end

def dataEmitGraphReferenceScan(output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)
  let local = "principal_" + name

  output.write("    let " + local + " = entity.")
  output.write(relation.referenceMember, relation.referenceOrigin)
  output.write("\n\n    if " + local + " != null\n      var related: neri_data::GraphSlot<" + p + ">? = null\n\n      match this.discover_" + principal.setName + "(" + local + ")\n")
  output.write("        case neri_data::GraphVisitResult.New(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Existing(slot)\n          related = slot\n        case neri_data::GraphVisitResult.Failure(error)\n          return error\n      end\n")
  output.write("      if related != null\n        let failure = this.link_" + name + "(related, owner, entity)\n\n        if failure != null\n          return failure\n        end\n      end\n    end\n")
end

def dataEmitGraph(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "graph.hk"
  output.write("use reference\nnamespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  output.write("## Collects one reachable mapped graph before atomic enrollment.\nclass GraphTraversal_" + mapping.contextName + "\n  private graph: neri_data::GraphRegistration\n")
  var entity = mapping.firstEntity

  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("  private tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + typeName + ">\n")
    output.write("  private visits_" + entity.generatedName + ": neri_data::GraphVisitList<" + typeName + ">\n")
    entity = entity.nextEntity
  end
  output.write("\n  def init(changes: neri_data::ChangeContext")
  entity = mapping.firstEntity
  while entity != null
    output.write(", tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">")
    entity = entity.nextEntity
  end
  output.write("): Void\n    this.graph = new neri_data::GraphRegistration(changes)\n")
  entity = mapping.firstEntity
  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("    this.tracker_" + entity.generatedName + " = tracker_" + entity.generatedName + "\n")
    output.write("    this.visits_" + entity.generatedName + " = new neri_data::GraphVisitList<" + typeName + ">(this.graph)\n")
    entity = entity.nextEntity
  end
  output.write("  end\n")
  entity = mapping.firstEntity
  while entity != null
    let typeName = semanticNamespaceDisplay(entity.typeName)

    output.write("\n  def add_" + entity.setName + "(root: " + typeName + "): neri_data::TrackHandleResult<" + typeName + ">\n")
    output.write("    match this.discover_" + entity.setName + "(root)\n")
    output.write("      case neri_data::GraphVisitResult.New(slot)\n        return this.graph.enroll(slot)\n      case neri_data::GraphVisitResult.Existing(slot)\n        return this.graph.enroll(slot)\n      case neri_data::GraphVisitResult.Failure(error)\n        return neri_data::TrackHandleResult<" + typeName + ">.Failure(error)\n    end\n  end\n")
    dataEmitGraphVisit(output, entity)
    output.write("\n  private def scan_" + entity.setName + "(entity: " + typeName + ", owner: neri_data::GraphSlot<" + typeName + ">): neri_data::QueryFailure?\n")
    var relation = mapping.firstRelation

    while relation != null
      let principal = relation.principal
      let dependent = relation.dependent
      let foreignKey = relation.foreignKey

      if principal != null && dependent != null && foreignKey != null && relation.collectionMember != "" && dataRelationSupportsLink(relation)
        if principal.typeName == entity.typeName
          dataEmitGraphCollectionScan(output, relation, principal, dependent, foreignKey)
        end
        if dependent.typeName == entity.typeName
          dataEmitGraphReferenceScan(output, relation, principal, dependent, foreignKey)
        end
      end
      relation = relation.nextRelation
    end
    output.write("    return null\n  end\n")
    entity = entity.nextEntity
  end
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != "" && dataRelationSupportsLink(relation)
      dataEmitGraphLink(output, relation, principal, dependent, foreignKey)
    end
    relation = relation.nextRelation
  end
  output.write("end\n")
  return output
end

def dataEmitContext(mapping: DataMapping): DataArtifact
  let output = new DataArtifact()

  output.name = "context.hk"
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && foreignKey != null && dataRelationSupportsLink(relation)
      if dataRelationUsesLegacyIntLink(relation)
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + "): Int\n  return entity.")
        output.write(foreignKey.memberName, foreignKey.origin)
        output.write("\nend\n\n")
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeySetterName(relation, principal, dependent, foreignKey) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + ", value: Int): Void\n  entity.")
        output.write(foreignKey.memberName, foreignKey.origin)
        output.write(" = value\nend\n\n")
      else
        let key = relation.key

        if key != null
          output.write(dataOriginDoc(key.origin))
          output.write("def " + dataRelationPrincipalCellGetterName(relation, principal, dependent, foreignKey) + "(entity: " + semanticNamespaceDisplay(principal.typeName) + "): neri_data::Cell\n  return " + dataCaptureCell(key) + "\nend\n\n")
        end
        output.write(dataOriginDoc(foreignKey.origin))
        output.write("def " + dataRelationForeignKeyGetterName(relation, principal, dependent, foreignKey) + "(entity: " + semanticNamespaceDisplay(dependent.typeName) + "): neri_data::Cell\n  return " + dataCaptureCell(foreignKey) + "\nend\n\n")
        dataEmitScalarForeignKeySetter(output, relation, principal, dependent, foreignKey)
      end
      dataEmitRelationEdgeFactory(output, relation, principal, dependent, foreignKey)
    end
    if principal != null && dependent != null && foreignKey != null && relation.collectionMember != ""
      let principalKey = relation.key
      let dependentKey = dependent.field(dependent.keyMember)

      if principalKey != null && dependentKey != null
        let p = semanticNamespaceDisplay(principal.typeName)
        let d = semanticNamespaceDisplay(dependent.typeName)

        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "principal_key") + "(entity: " + p + "): neri_data::Cell\n  return " + dataCaptureCell(principalKey) + "\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "dependent_key") + "(entity: " + d + "): neri_data::Cell\n  return " + dataCaptureCell(dependentKey) + "\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "foreign_key") + "(entity: " + d + "): neri_data::Cell\n  return " + dataCaptureCell(foreignKey) + "\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_collection") + "(entity: " + p + "): " + d + "[]\n  return entity.")
        output.write(relation.collectionMember, relation.collectionOrigin)
        output.write("\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_collection") + "(entity: " + p + ", values: " + d + "[]): Void\n  entity.")
        output.write(relation.collectionMember, relation.collectionOrigin)
        output.write(" = values\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_reference") + "(entity: " + d + "): " + p + "?\n  return entity.")
        output.write(relation.referenceMember, relation.referenceOrigin)
        output.write("\nend\n\n")
        output.write("def " + dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_reference") + "(entity: " + d + ", value: " + p + "?): Void\n  entity.")
        output.write(relation.referenceMember, relation.referenceOrigin)
        output.write(" = value\nend\n\n")
      end
    end
    relation = relation.nextRelation
  end
  output.write("## Entry point for the mapped entity query surfaces.\nclass " + mapping.contextName + "\n")
  output.write("  private changes: neri_data::ChangeContext\n")
  var entity = mapping.firstEntity

  while entity != null
    output.write("  private tracker_" + entity.generatedName + ": neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    output.write("  " + dataOriginDoc(entity.origin))
    output.write("  public ")
    output.write(entity.setName, entity.origin)
    output.write(": neri_data::Query<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    entity = entity.nextEntity
  end
  output.write("\n  ## Borrows a provider for query execution and saving; the caller owns its lifetime.\n  def init(provider: neri_data::Provider? = null): Void\n    this.changes = new neri_data::ChangeContext(provider)\n")
  entity = mapping.firstEntity

  while entity != null
    let key = entity.field(entity.keyMember)

    if key != null
      let concurrency = entity.concurrencyColumns

      if concurrency != null
        output.write("    let concurrency_" + entity.generatedName + ": String[] = [")
        var token = 0

        while token < concurrency.size
          output.write((token == 0 ? "" : ", ") + lspQuote(concurrency.get(token)))
          token = token + 1
        end
        output.write("]\n\n")
      end
      output.write("    this.tracker_" + entity.generatedName + " = new neri_data::EntityTracker<" + semanticNamespaceDisplay(entity.typeName) + ">(" + lspQuote(entity.tableName) + ", " + lspQuote(key.columnName) + ", " + dataResultColumns(entity) + ", capture_" + entity.generatedName + ", apply_" + entity.generatedName)
      if entity.generatedKey
        output.write(", true, set_generated_key_" + entity.generatedName)
      end
      if dataHasGeneratedFields(entity)
        dataEmitGeneratedFieldsMetadata(output, entity)
      end
      if concurrency != null
        output.write(", concurrencyColumns: concurrency_" + entity.generatedName)
      end
      output.write(")\n")
      output.write("    this.changes.register(this.tracker_" + entity.generatedName + ".changeSet())\n")
    end
    output.write("    this." + entity.setName + " = new neri_data::Query<" + semanticNamespaceDisplay(entity.typeName) + ">(" + lspQuote(entity.tableName) + ", new neri_data::Decoder<" + semanticNamespaceDisplay(entity.typeName) + ">(" + dataEntityDecoderName(entity) + ", " + dataResultColumns(entity) + "), mapping: " + dataEntityMappingName(entity) + "(), provider: provider, tracker: this.tracker_" + entity.generatedName + ", changes: this.changes)\n")
    entity = entity.nextEntity
  end
  output.write("  end\n\n  ## Saves tracked inserts, changes, and removals as one atomic batch.\n  public def saveChanges(): neri_data::WriteResult\n    return this.changes.saveChanges()\n  end\n")
  entity = mapping.firstEntity

  while entity != null
    output.write("\n  ## Marks a tracked root and its explicitly linked client-cascade descendants for removal.\n  public def removeCascade_" + entity.setName + "(handle: neri_data::TrackedHandle<" + semanticNamespaceDisplay(entity.typeName) + ">): neri_data::QueryFailure?\n    return neri_data::removeCascade(this.changes, handle)\n  end\n")
    output.write("\n  ## Enrolls a reachable graph through mapped navigation members.\n  public def addGraph_" + entity.setName + "(root: " + semanticNamespaceDisplay(entity.typeName) + "): neri_data::TrackHandleResult<" + semanticNamespaceDisplay(entity.typeName) + ">\n")
    output.write("    let traversal = new GraphTraversal_" + mapping.contextName + "(this.changes")
    var tracked = mapping.firstEntity

    while tracked != null
      output.write(", this.tracker_" + tracked.generatedName)
      tracked = tracked.nextEntity
    end
    output.write(")\n\n    return traversal.add_" + entity.setName + "(root)\n  end\n")
    entity = entity.nextEntity
  end
  output.write("\n  ## Detaches tracked entities without writing to the database.\n  public def clear(): Void\n    this.changes.clear()\n  end\n")
  for name in ["beginTransaction", "commitTransaction", "rollbackTransaction"]
    output.write("\n  public def " + name + "(): neri_data::WriteResult\n    return this.changes." + name + "()\n  end\n")
  end
  relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let key = relation.key
    let foreignKey = relation.foreignKey

    if principal != null && dependent != null && key != null && foreignKey != null
      output.write("\n  ## Queries the dependent rows through the mapped foreign key.\n")
      output.write("  public def ")
      output.write(dataRelationName(relation, principal, dependent, foreignKey), foreignKey.origin)
      output.write("(entity: " + semanticNamespaceDisplay(principal.typeName) + "): neri_data::Query<" + semanticNamespaceDisplay(dependent.typeName) + ">\n")
      output.write("    return this." + dependent.setName + ".where(" + foreignKey.memberName + ": entity." + key.memberName + ")\n  end\n")
      if dataRelationSupportsLink(relation)
        output.write("\n  ## Links tracked entities through the mapped foreign key.\n  public def ")
        output.write(dataRelationLinkName(relation, principal, dependent, foreignKey), foreignKey.origin)
        output.write("(principal: neri_data::TrackedHandle<" + semanticNamespaceDisplay(principal.typeName) + ">, dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
        output.write("    return this.changes.registerRelation(" + dataRelationEdgeFactoryName(relation, principal, dependent, foreignKey) + "(principal, dependent))\n  end\n")
        output.write("\n  ## Reassigns an explicitly linked dependent to another principal.\n  public def ")
        output.write(dataRelationReassignName(relation, principal, dependent, foreignKey), foreignKey.origin)
        output.write("(newPrincipal: neri_data::TrackedHandle<" + semanticNamespaceDisplay(principal.typeName) + ">, dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
        output.write("    return this.changes.reassignRelation(" + dataRelationEdgeFactoryName(relation, principal, dependent, foreignKey) + "(newPrincipal, dependent))\n  end\n")
        if foreignKey.optional || relation.deleteBehavior == "clientCascade"
          output.write(relation.deleteBehavior == "clientCascade" && !foreignKey.optional ? "\n  ## Removes an explicitly linked required dependent through client cascade.\n  public def " : "\n  ## Clears the optional foreign key of an explicitly linked dependent.\n  public def ")
          output.write(dataRelationUnlinkName(relation, principal, dependent, foreignKey), foreignKey.origin)
          output.write("(dependent: neri_data::TrackedHandle<" + semanticNamespaceDisplay(dependent.typeName) + ">): neri_data::QueryFailure?\n")
          output.write("    return neri_data::unlinkRelation(this.changes, dependent, " + lspQuote(foreignKey.columnName) + ")\n  end\n")
        end
      end
      if relation.collectionMember != ""
        let p = semanticNamespaceDisplay(principal.typeName)
        let d = semanticNamespaceDisplay(dependent.typeName)

        output.write("\n  ## Loads collection and inverse reference navigations.\n  public def include_" + dataRelationName(relation, principal, dependent, foreignKey) + "(principals: neri_data::Query<" + p + ">): neri_data::IncludedQuery<" + p + ", " + d + ">\n")
        output.write("    let navigation = new neri_data::CollectionNavigation<" + p + ", " + d + ">(")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "principal_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "dependent_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "foreign_key") + ", " + lspQuote(foreignKey.columnName) + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_reference") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_reference") + ")\n")
        output.write("\n    return neri_data::include(principals, this." + dependent.setName + ", navigation)\n  end\n")
        output.write("\n  ## Loads the principal reference for dependent rows.\n  public def includeReference_" + dataRelationName(relation, principal, dependent, foreignKey) + "(dependents: neri_data::Query<" + d + ">): neri_data::ReferencedQuery<" + p + ", " + d + ">\n")
        output.write("    let navigation = new neri_data::CollectionNavigation<" + p + ", " + d + ">(")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "principal_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "dependent_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "foreign_key") + ", " + lspQuote(foreignKey.columnName) + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_reference") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_reference") + ")\n")
        output.write("\n    return neri_data::includeReference(dependents, this." + principal.setName + ", navigation)\n  end\n")
        output.write("\n  ## Builds a deferred collection step for a typed navigation path.\n  public def collectionStep_" + dataRelationName(relation, principal, dependent, foreignKey) + "(maximum: Int = 10000, children: neri_data::Query<" + d + ">? = null): neri_data::NavigationStep<" + p + ", " + d + ">\n")
        output.write("    let navigation = new neri_data::CollectionNavigation<" + p + ", " + d + ">(")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "principal_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "dependent_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "foreign_key") + ", " + lspQuote(foreignKey.columnName) + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_reference") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_reference") + ")\n")
        output.write("\n    return neri_data::collectionStep(this." + principal.setName + ", this." + dependent.setName + ", navigation, maximum, children)\n  end\n")
        output.write("\n  ## Builds a deferred reference step for a typed navigation path.\n  public def referenceStep_" + dataRelationName(relation, principal, dependent, foreignKey) + "(): neri_data::NavigationStep<" + d + ", " + p + ">\n")
        output.write("    let navigation = new neri_data::CollectionNavigation<" + p + ", " + d + ">(")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "principal_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "dependent_key") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "foreign_key") + ", " + lspQuote(foreignKey.columnName) + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_collection") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "get_reference") + ", ")
        output.write(dataRelationNavigationName(relation, principal, dependent, foreignKey, "set_reference") + ")\n")
        output.write("\n    return neri_data::referenceStep(this." + dependent.setName + ", this." + principal.setName + ", navigation)\n  end\n")
      end
    end
    relation = relation.nextRelation
  end
  output.write("end\n")
  return output
end

def dataEmit(mapping: DataMapping): DataEmission
  let emission = new DataEmission()

  if mapping.error != ""
    emission.error = mapping.error
    return emission
  end
  if !dataEmissionPublicNames(mapping, emission)
    return emission
  end
  var entity = mapping.firstEntity

  while entity != null
    let name = dataEntityArtifactName(entity)

    if !dataArtifactName(name)
      emission.error = "Mapped entity '" + entity.typeName + "' cannot produce a safe generated source filename. Use an ASCII identifier for the type name."
      return emission
    end
    var prior = mapping.firstEntity

    while prior != null && prior.typeName != entity.typeName
      if dataSqlSameIdentifier(dataEntityArtifactName(prior), name)
        emission.error = "Mapped entities '" + prior.typeName + "' and '" + entity.typeName + "' produce the same generated source filename without regard to ASCII case: " + name
        return emission
      end
      prior = prior.nextEntity
    end
    entity = entity.nextEntity
  end
  entity = mapping.firstEntity

  while entity != null
    let output = new DataArtifact()

    output.name = dataEntityArtifactName(entity)
    output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\n")
    dataEmitMapping(output, entity)
    dataEmitDecoder(output, entity)
    dataEmitCapture(output, entity)
    dataEmitApply(output, entity)
    if entity.generatedKey
      dataEmitGeneratedKeySetter(output, entity)
    end
    if dataHasGeneratedFields(entity)
      dataEmitGeneratedFieldsSetter(output, entity)
    end
    dataEmitSnapshot(output, entity)
    emission.add(output)
    entity = entity.nextEntity
  end
  emission.add(dataEmitContext(mapping))
  emission.add(dataEmitGraph(mapping))
  emission.add(dataEmitSchema(mapping))
  return emission
end
