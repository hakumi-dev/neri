def dataFieldRead(field: DataField, receiver: String): String
  return field.getter == "" ? receiver + "." + field.memberName : semanticNamespaceDisplay(field.getter) + "(" + receiver + ")"
end

def dataFieldWrite(field: DataField, receiver: String, value: String): String
  return field.setter == "" ? receiver + "." + field.memberName + " = " + value : semanticNamespaceDisplay(field.setter) + "(" + receiver + ", " + value + ")"
end
