use host
use neri_data

## Neri source strings require a distinct escape for an embedded NUL byte.
def dataMigrationLiteral(value: String): String
  var output = "\""
  var start = 0
  var index = 0

  while index < host::stringByteLength(value)
    let byte = host::stringByteAt(value, index) as Int

    if byte == 0 || byte == 34 || byte == 92 || byte == 10 || byte == 13 || byte == 9
      output = output + host::stringSlice(value, start, index - start)
      if byte == 0
        output = output + "\\0"
      else if byte == 34 || byte == 92
        output = output + "\\" + host::stringSlice(value, index, 1)
      else if byte == 10
        output = output + "\\n"
      else if byte == 13
        output = output + "\\r"
      else
        output = output + "\\t"
      end
      start = index + 1
    end
    index = index + 1
  end
  return output + host::stringSlice(value, start, host::stringByteLength(value) - start) + "\""
end

def dataMigrationSourceType(kind: readonly SchemaType): String
  return "neri_data::SchemaType." + dataMigrationTypeName(kind) + "()"
end

def dataMigrationSourceDefault(value: readonly SchemaDefault?): String
  if value == null
    return "null"
  end
  match value
    case SchemaDefault.Null()
      return "neri_data::SchemaDefault.Null()"
    case SchemaDefault.Bool(item)
      return "neri_data::SchemaDefault.Bool(" + (item ? "true" : "false") + ")"
    case SchemaDefault.Int(item)
      return "neri_data::SchemaDefault.Int(" + (item as String) + ")"
    case SchemaDefault.Float(item)
      let literal = dataFloatLiteral(item as String)

      return literal == null ? "" : "neri_data::SchemaDefault.Float(" + literal + ")"
    case SchemaDefault.Text(item)
      return "neri_data::SchemaDefault.Text(" + dataMigrationLiteral(item) + ")"
  end
end

def dataMigrationSourceColumn(column: readonly SchemaColumn): String
  let defaultValue = dataMigrationSourceDefault(column.defaultValue())

  if defaultValue == ""
    return ""
  end
  return "new neri_data::SchemaColumn(" + dataMigrationLiteral(column.name()) + ", " + dataMigrationSourceType(column.type()) + ", nullable: " + (column.nullable() ? "true" : "false") + ", primaryKey: " + (column.primaryKey() ? "true" : "false") + ", defaultValue: " + defaultValue + ")"
end

def dataMigrationSourceTable(table: readonly SchemaTable): String
  var output = "new neri_data::SchemaTable(" + dataMigrationLiteral(table.identity()) + ", " + dataMigrationLiteral(table.name()) + ", ["
  var index = 0

  while index < table.count()
    let field = table.at(index)

    if field == null
      return ""
    end
    let column = dataMigrationSourceColumn(field.column())

    if column == ""
      return ""
    end
    output = output + (index == 0 ? "" : ", ") + "new neri_data::SchemaField(" + dataMigrationLiteral(field.identity()) + ", " + column + ")"
    index = index + 1
  end
  output = output + "], ["
  index = 0

  while index < table.indexCount()
    let definition = table.indexAt(index)

    if definition == null
      return ""
    end
    output = output + (index == 0 ? "" : ", ") + "new neri_data::SchemaIndex(" + dataMigrationLiteral(definition.name()) + ", ["
    var fieldIndex = 0

    while fieldIndex < definition.count()
      let identity = definition.at(fieldIndex)

      if identity == null
        return ""
      end
      output = output + (fieldIndex == 0 ? "" : ", ") + dataMigrationLiteral(identity)
      fieldIndex = fieldIndex + 1
    end
    output = output + "], " + (definition.unique() ? "true" : "false") + ")"
    index = index + 1
  end
  return output + "])"
end

def dataMigrationSourceModel(model: readonly SchemaModel): String
  var output = "new neri_data::SchemaModel(["
  var index = 0

  while index < model.count()
    let table = model.at(index)

    if table == null
      return ""
    end
    let code = dataMigrationSourceTable(table)

    if code == ""
      return ""
    end
    output = output + (index == 0 ? "" : ", ") + code
    index = index + 1
  end
  return output + "])"
end

def dataMigrationSourceOp(operation: readonly SchemaOp): String
  match operation
    case SchemaOp.CreateTable(table, columns)
      var values = "["
      var index = 0

      while index < columns.Length
        let column = dataMigrationSourceColumn(columns[index])

        if column == ""
          return ""
        end
        values = values + (index == 0 ? "" : ", ") + column
        index = index + 1
      end
      return "neri_data::SchemaOp.CreateTable(" + dataMigrationLiteral(table) + ", " + values + "])"
    case SchemaOp.DropTable(table)
      return "neri_data::SchemaOp.DropTable(" + dataMigrationLiteral(table) + ")"
    case SchemaOp.AddColumn(table, column)
      let value = dataMigrationSourceColumn(column)

      return value == "" ? "" : "neri_data::SchemaOp.AddColumn(" + dataMigrationLiteral(table) + ", " + value + ")"
    case SchemaOp.DropColumn(table, column)
      return "neri_data::SchemaOp.DropColumn(" + dataMigrationLiteral(table) + ", " + dataMigrationLiteral(column) + ")"
    case SchemaOp.RenameTable(from, to)
      return "neri_data::SchemaOp.RenameTable(" + dataMigrationLiteral(from) + ", " + dataMigrationLiteral(to) + ")"
    case SchemaOp.RenameColumn(table, from, to)
      return "neri_data::SchemaOp.RenameColumn(" + dataMigrationLiteral(table) + ", " + dataMigrationLiteral(from) + ", " + dataMigrationLiteral(to) + ")"
    case SchemaOp.CreateIndex(name, table, columns, unique)
      var values = "["
      var index = 0

      while index < columns.Length
        values = values + (index == 0 ? "" : ", ") + dataMigrationLiteral(columns[index])
        index = index + 1
      end
      return "neri_data::SchemaOp.CreateIndex(" + dataMigrationLiteral(name) + ", " + dataMigrationLiteral(table) + ", " + values + "], " + (unique ? "true" : "false") + ")"
    case SchemaOp.DropIndex(name)
      return "neri_data::SchemaOp.DropIndex(" + dataMigrationLiteral(name) + ")"
    case SchemaOp.RebuildTable(before, after)
      let first = dataMigrationSourceTable(before)
      let second = dataMigrationSourceTable(after)

      return first == "" || second == "" ? "" : "neri_data::SchemaOp.RebuildTable(" + first + ", " + second + ")"
  end
end

def dataMigrationSourceOps(migration: readonly Migration, forward: Bool): String
  let count = forward ? migration.upCount() : migration.downCount()
  var output = "["
  var index = 0

  while index < count
    let operation = forward ? migration.upAt(index) : migration.downAt(index)

    if operation == null
      return ""
    end
    let code = dataMigrationSourceOp(operation)

    if code == ""
      return ""
    end
    output = output + (index == 0 ? "" : ", ") + code
    index = index + 1
  end
  return output + "]"
end

## Emits a self-contained migration and desired-schema factory.
def dataMigrationSource(id: String, namespaceName: String, plan: readonly SchemaMigrationPlan, after: readonly SchemaModel): String
  if !dataIdentifier(namespaceName, true) || !dataIdentifier("migration_" + id) || after.validate() != null || plan.afterSignature() != after.signature()
    return ""
  end
  let migration = plan.migration()
  let valid = (new MigrationSet([migration])).validate()

  if valid != null || migration.id() != id
    return ""
  end
  let up = dataMigrationSourceOps(migration, true)
  let down = dataMigrationSourceOps(migration, false)
  let model = dataMigrationSourceModel(after)

  if up == "" || down == "" || model == ""
    return ""
  end
  return "namespace " + semanticNamespaceDisplay(namespaceName) + "\n\n## Generated migration. Up data loss: " + (plan.upDataLoss() ? "true" : "false") + "; down data loss: " + (plan.downDataLoss() ? "true" : "false") + ".\n## Before signature: " + lspQuote(plan.beforeSignature()) + "\n## After signature: " + lspQuote(plan.afterSignature()) + "\n## Migration signature: " + lspQuote(migration.signature()) + "\ndef migration_" + id + "(): neri_data::Migration\n  return new neri_data::Migration(" + dataMigrationLiteral(id) + ", " + up + ", " + down + ")\nend\n\ndef snapshot_" + id + "(): neri_data::SchemaModel\n  return " + model + "\nend\n"
end
