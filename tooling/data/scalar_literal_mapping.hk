use json
use result

def dataLiteralDigits(text: String, start: Int, length: Int): Int
  var value = 0
  var index = start

  while index < start + length
    let byte = host::stringByteAt(text, index) as Int

    return -1 if byte < 48 || byte > 57
    value = value * 10 + byte - 48
    index = index + 1
  end
  return value
end

def dataLiteralDate(text: String): Bool
  if host::stringByteLength(text) != 10 || host::stringByteAt(
    text,
    4
  ) as Int != 45 || host::stringByteAt(
    text,
    7
  ) as Int != 45
    return false
  end
  let year = dataLiteralDigits(text, 0, 4)
  let month = dataLiteralDigits(text, 5, 2)
  let day = dataLiteralDigits(text, 8, 2)
  let leap = year - year / 4 * 4 == 0 && (year - year / 100 * 100 != 0 || year - year / 400 * 400 == 0)
  let maximum = month == 2 ? (leap ? 29 : 28) : (month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31)

  return year >= 1 && year <= 9999 && month >= 1 && month <= 12 && day >= 1 && day <= maximum
end

def dataLiteralTime(text: String): Bool
  return host::stringByteLength(text) == 16 && host::stringByteAt(
    text,
    2
  ) as Int == 58 && host::stringByteAt(
    text,
    5
  ) as Int == 58 && host::stringByteAt(
    text,
    8
  ) as Int == 46 && dataLiteralDigits(
    text,
    0,
    2
  ) >= 0 && dataLiteralDigits(
    text,
    0,
    2
  ) <= 23 && dataLiteralDigits(
    text,
    3,
    2
  ) >= 0 && dataLiteralDigits(
    text,
    3,
    2
  ) <= 59 && dataLiteralDigits(
    text,
    6,
    2
  ) >= 0 && dataLiteralDigits(
    text,
    6,
    2
  ) <= 59 && dataLiteralDigits(
    text,
    9,
    7
  ) >= 0
end

def dataCanonicalScalarText(family: String, text: String): Bool
  if family == "Guid"
    if host::stringByteLength(text) != 36
      return false
    end
    var index = 0

    while index < 36
      let byte = host::stringByteAt(text, index) as Int
      let separator = index == 8 || index == 13 || index == 18 || index == 23

      if separator ? byte != 45 : !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102))
        return false
      end
      index = index + 1
    end
    return true
  else if family == "DateOnly"
    return dataLiteralDate(text)
  else if family == "TimeOnly"
    return dataLiteralTime(text)
  else if family == "DateTime"
    return host::stringByteLength(text) == 28 && host::stringByteAt(
      text,
      10
    ) as Int == 84 && host::stringByteAt(
      text,
      27
    ) as Int == 90 && dataLiteralDate(host::stringSlice(
        text,
        0,
        10
      )) && dataLiteralTime(host::stringSlice(
        text,
        11,
        16
      ))
  else if family == "DateTimeOffset"
    return false
  end
  match json::parse(text)
    case result::Result.Error(error)
      return false
    case result::Result.Ok(value)
      match json::stringify(value)
        case result::Result.Error(error)
          return false
        case result::Result.Ok(canonical)
          if canonical != text
            return false
          end
      end
      if family == "JsonDocument"
        return true
      end
      if value.kind() != "array"
        return false
      end
      var index = 0

      while index < value.count()
        let item = value.at(index)
        let content = item == null ? null : item.text()

        if item == null || (family == "Strings" && item.kind() != "string") || (family == "Bools" && item.kind() != "boolean") || (family == "Ints" && (item.kind() != "number" || content == null || host::parseInt(content) == null))
          return false
        end
        index = index + 1
      end
      return true
  end
end

def dataValidateConvertedLiteral(mapping: DataMapping, field: DataField, value: LspJson, context: String): Bool
  if value.isMissing() || value.isNull()
    return true
  end
  let family = dataTextScalarFamily(field.optional ? semanticInnerType(field.typeName) : field.typeName)
  let builtinEncoder = "neri_data.cell" + (field.optional ? "Optional" : "") + family

  if family != "" && family != "TimeSpan" && field.conversionEncode == builtinEncoder
    if !value.isString() || !dataCanonicalScalarText(family, value.scalarText())
      return mapping.fail(context + " requires canonical validated storage text; DateTimeOffset literal defaults and seeds require an explicit authored converter.")
    end
  end
  return true
end
