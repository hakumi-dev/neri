class DataPublishOutputs
  public first: DataOldOutput?
  private last: DataOldOutput?
  private byPath: StringTable<DataOldOutput> = new StringTable<DataOldOutput>()
  private byIdentifier: StringTable<DataOldOutput> = new StringTable<DataOldOutput>()

  def find(path: String): DataOldOutput?
    let found = this.byPath.find(path)

    if found == null
      return null
    end
    return found.value
  end

  def findIdentifier(path: String): DataOldOutput?
    let found = this.byIdentifier.find(dataPublishIdentifierKey(path))

    if found == null
      return null
    end
    return found.value
  end

  def add(path: String): Bool
    if this.find(path) != null || this.findIdentifier(path) != null
      return false
    end
    let output = new DataOldOutput()

    output.relativePath = path
    let last = this.last

    if last == null
      this.first = output
    else
      last.next = output
    end
    this.last = output
    this.byPath.add(path, output)
    this.byIdentifier.add(dataPublishIdentifierKey(path), output)
    return true
  end
end
