def dataEmitSyntheticJoin(output: DataArtifact, mapping: DataMapping, entity: DataEntity): Void
  if !entity.syntheticJoin
    return
  end
  output.write("## Synthesized join row for mapped skip navigations.\nclass " + entity.generatedName + "\n")
  var field = entity.firstField

  while field != null
    output.write("  public " + field.memberName + ": " + semanticNamespaceDisplay(field.typeName) + " = " + dataInitialValue(field) + "\n")
    field = field.nextField
  end
  var relation = mapping.firstRelation

  while relation != null
    if relation.dependentType == entity.typeName
      output.write("  public " + relation.referenceMember + ": " + semanticNamespaceDisplay(relation.principalType) + "?\n")
    end
    relation = relation.nextRelation
  end
  output.write("end\n\n")
end

def dataImplicitStoreName(relation: DataRelation): String
  return "implicit_" + relation.collectionMember
end

def dataEmitImplicitFields(output: DataArtifact, mapping: DataMapping): Void
  var relation = mapping.firstRelation

  while relation != null
    if relation.implicitJoin
      output.write("  private " + dataImplicitStoreName(relation) + ": neri_data::ImplicitJoinCollections<" + semanticNamespaceDisplay(relation.principalType) + ", " + semanticNamespaceDisplay(relation.dependentType) + ">\n")
    end
    relation = relation.nextRelation
  end
end

def dataEmitImplicitNavigationInit(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  if !relation.implicitJoin
    return
  end
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let store = "this." + dataImplicitStoreName(relation)

  output.write("    " + store + " = new neri_data::ImplicitJoinCollections<" + p + ", " + d + ">()\n")
  output.write("    let " + dataNavigationCallbackName(
      relation,
      principal,
      dependent,
      foreignKey,
      "get_collection"
    ) + ": fn(" + p + "): " + d + "[] = fn(entity: " + p + "): " + d + "[] do\n      return " + store + ".get(entity)\n    end\n")
  output.write("    let " + dataNavigationCallbackName(
      relation,
      principal,
      dependent,
      foreignKey,
      "set_collection"
    ) + ": fn(" + p + ", " + d + "[]): Void = fn(entity: " + p + ", values: " + d + "[]): Void do\n      " + store + ".set(entity, values)\n    end\n")
end

def dataNavigationCallbackName(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField,
  kind: String
): String
  return (relation.implicitJoin ? "implicit_callback_" : "") + dataRelationNavigationName(
    relation,
    principal,
    dependent,
    foreignKey,
    kind
  )
end

def dataEmitImplicitClear(output: DataArtifact, mapping: DataMapping): Void
  var relation = mapping.firstRelation

  while relation != null
    output.write("    this." + dataImplicitStoreName(relation) + ".clear()\n") if relation.implicitJoin
    relation = relation.nextRelation
  end
end
