def dataEmitNavigationChangeInit(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  if relation.implicitJoin || !dataRelationSupportsLink(relation)
    return
  end
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("    let detect_link_" + name + ": fn(" + p + ", " + d + "): neri_data::QueryFailure? = fn(parent: " + p + ", child: " + d + "): neri_data::QueryFailure? do\n      var childHandle: neri_data::TrackedHandle<" + d + ">? = null\n\n      match this." + dependent.setName + ".handle(child)\n        case neri_data::TrackHandleResult.Tracked(handle)\n          childHandle = handle\n        case neri_data::TrackHandleResult.Failure(error)\n          match this.addGraph_" + dependent.setName + "(child)\n            case neri_data::TrackHandleResult.Tracked(handle)\n              childHandle = handle\n            case neri_data::TrackHandleResult.Failure(failure)\n              return failure\n          end\n      end\n      if childHandle == null\n        return neri_data::QueryFailure.Provider(neri_data::ProviderFailure.State(\"relationship detector could not enroll dependent\"))\n      end\n      match this." + principal.setName + ".handle(parent)\n        case neri_data::TrackHandleResult.Failure(error)\n          return error\n        case neri_data::TrackHandleResult.Tracked(parentHandle)\n          let edge = " + dataRelationEdgeFactoryName(
      relation,
      principal,
      dependent,
      foreignKey
    ) + "(parentHandle, childHandle)\n          let failure = this.changes.registerRelation(edge)\n\n          return failure == null ? null : this.changes.reassignRelation(edge)\n      end\n    end\n")
  output.write("    let detect_unlink_" + name + ": fn(" + d + "): neri_data::QueryFailure? = fn(child: " + d + "): neri_data::QueryFailure? do\n      match this." + dependent.setName + ".handle(child)\n        case neri_data::TrackHandleResult.Failure(error)\n          return error\n        case neri_data::TrackHandleResult.Tracked(handle)\n          return neri_data::unlinkRelation(this.changes, handle, " + lspQuote(dataRelationSlotName(
        relation,
        dependent,
        foreignKey
      )) + ")\n      end\n    end\n")
  output.write("    let detect_snapshot_" + name + ": fn(" + d + "): fn(): Void = fn(child: " + d + "): fn(): Void do\n")
  var position = 0

  while position < relation.foreignKeyMembers.size
    let field = dependent.field(relation.foreignKeyMembers.get(position))

    if field != null
      output.write("      let before_" + (position as String) + " = " + dataFieldRead(field, "child") + "\n")
    end
    position = position + 1
  end
  output.write("      let restore: fn(): Void = fn(): Void do\n")
  position = 0
  while position < relation.foreignKeyMembers.size
    let field = dependent.field(relation.foreignKeyMembers.get(position))

    if field != null
      output.write("        " + dataFieldWrite(field, "child", "before_" + (position as String)) + "\n")
    end
    position = position + 1
  end
  output.write("      end\n\n      return restore\n    end\n    neri_data::registerCollectionChanges(this." + principal.setName + ", this." + dependent.setName + ", this.navigation_" + name + ", detect_link_" + name + ", detect_unlink_" + name + ", detect_snapshot_" + name + ")\n")
  if relation.ownership
    output.write("    neri_data::registerOwnedCollectionDelete(this." + principal.setName + ", this." + dependent.setName + ", this.navigation_" + name + ", " + dataRelationEdgeFactoryName(
        relation,
        principal,
        dependent,
        foreignKey
      ) + ")\n")
  end
end
