def dataFilterFieldsName(entity: DataEntity): String
  return "FilterFields_" + entity.generatedName
end

def dataMappedQueryType(entity: DataEntity): String
  return "neri_data::MappedQuery<" + semanticNamespaceDisplay(entity.typeName) + ", " + dataFilterFieldsName(entity) + ">"
end

def dataEmitFilterFields(output: DataArtifact, entity: DataEntity): Void
  output.write("## Directly mapped filter fields for " + entity.typeName + ".\nclass " + dataFilterFieldsName(entity) + "\n")
  var parameters = ""
  var assignments = ""
  var field = entity.firstField

  while field != null
    if field.pathCode == "" && (field.hierarchyType == "" || field.hierarchyType == entity.typeName) && dataIdentifier(field.memberName)
      let typeName = semanticNamespaceDisplay(field.typeName)
      let name = field.memberName

      output.write("  public ")
      output.write(name, field.origin)
      output.write(": " + typeName + "\n")
      parameters = parameters + (parameters == "" ? "" : ", ") + name + ": " + typeName
      assignments = assignments + "    this." + name + " = " + name + "\n"
    end
    field = field.nextField
  end
  if parameters != ""
    output.write("\n  def init(" + parameters + "): Void\n" + assignments + "  end\n")
  end
  output.write("end\n\n")
end
