## Navigation descriptors use the member names declared on each entity set.
def dataNavigationSetName(mapping: DataMapping, entity: DataEntity): String
  return "NavigationSet_" + mapping.contextName + "_" + entity.generatedName
end

def dataHasNavigationMembers(mapping: DataMapping, entity: DataEntity): Bool
  var relation = mapping.firstRelation

  while relation != null
    if !relation.implicitJoin && ((relation.collectionMember != "" && relation.principalType == entity.typeName) || (relation.referenceMember != "" && relation.dependentType == entity.typeName))
      return true
    end
    relation = relation.nextRelation
  end
  var many = mapping.firstMany

  while many != null
    if many.left.typeName == entity.typeName || many.right.typeName == entity.typeName
      return true
    end
    many = many.nextMany
  end
  return false
end

def dataNavigationPublicNames(mapping: DataMapping, emission: DataEmission, declarations: StringBuffer): Bool
  if !dataEmissionAddName(emission, declarations, "Navigation_" + mapping.contextName, "navigation facade")
    return false
  end
  var entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      if !dataEmissionAddName(emission, declarations, dataNavigationSetName(mapping, entity), "navigation set facade")
        return false
      end
      let members = new StringBuffer()

      members.add("init")
      var relation = mapping.firstRelation

      while relation != null
        if !relation.implicitJoin
          if relation.collectionMember != "" && relation.principalType == entity.typeName && !dataEmissionAddName(
            emission,
            members,
            relation.collectionMember,
            "navigation member"
          )
            return false
          end
          if relation.referenceMember != "" && relation.dependentType == entity.typeName && !dataEmissionAddName(
            emission,
            members,
            relation.referenceMember,
            "navigation member"
          )
            return false
          end
        end
        relation = relation.nextRelation
      end
      var many = mapping.firstMany

      while many != null
        if many.left.typeName == entity.typeName && !dataEmissionAddName(
          emission,
          members,
          many.leftCollection,
          "skip navigation member"
        )
          return false
        end
        if many.right.typeName == entity.typeName && !dataEmissionAddName(
          emission,
          members,
          many.rightCollection,
          "skip navigation member"
        )
          return false
        end
        many = many.nextMany
      end
    end
    entity = entity.nextEntity
  end
  return true
end

class NavigationFacadeParts
  public declarations: String = ""
  public parameters: String = ""
  public assignments: String = ""
  public arguments: String = ""

  def add(member: String, typeName: String, argument: String): Void
    let parameter = "value_" + member
    let separator = this.parameters == "" ? "" : ", "

    this.declarations = this.declarations + "  public " + member + ": " + typeName + "\n"
    this.parameters = this.parameters + separator + parameter + ": " + typeName
    this.assignments = this.assignments + "    this." + member + " = " + parameter + "\n"
    this.arguments = this.arguments + separator + argument
  end
end

def dataNavigationStepType(source: DataEntity, target: DataEntity): String
  return "neri_data::NavigationStep<" + semanticNamespaceDisplay(source.typeName) + ", " + semanticNamespaceDisplay(target.typeName) + ">"
end

def dataNavigationRelationStep(
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField,
  collection: Bool
): String
  let name = dataRelationName(relation, principal, dependent, foreignKey)
  let principals = "this." + dataNavigationQueryField(principal) + ".query()"
  let dependents = "this." + dataNavigationQueryField(dependent) + ".query()"

  if collection
    return "neri_data::collectionStep(" + principals + ", " + dependents + ", this.navigation_" + name + ")"
  end
  if dependent.keyless
    return dataKeylessReferenceStepName(name) + "(" + dependents + ", " + principals + ")"
  end
  return "neri_data::referenceStep(" + dependents + ", " + principals + ", this.navigation_" + name + ")"
end

def dataNavigationSkipStep(many: DataMany, inverse: Bool): String
  let method = inverse ? ".inverseStep(" : ".step("
  let queries = "this." + dataNavigationQueryField(many.left) + ".query(), this." + many.join.setName + ".query(), this." + dataNavigationQueryField(many.right) + ".query()"

  return "this.skip_" + many.name + method + queries + ")"
end

def dataNavigationSetParts(mapping: DataMapping, entity: DataEntity): NavigationFacadeParts
  let parts = new NavigationFacadeParts()
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if !relation.implicitJoin && principal != null && dependent != null && foreignKey != null
      if relation.collectionMember != "" && relation.principalType == entity.typeName
        parts.add(
          relation.collectionMember,
          dataNavigationStepType(principal, dependent),
          dataNavigationRelationStep(relation, principal, dependent, foreignKey, true)
        )
      end
      if relation.referenceMember != "" && relation.dependentType == entity.typeName
        parts.add(
          relation.referenceMember,
          dataNavigationStepType(dependent, principal),
          dataNavigationRelationStep(relation, principal, dependent, foreignKey, false)
        )
      end
    end
    relation = relation.nextRelation
  end
  var many = mapping.firstMany

  while many != null
    if many.left.typeName == entity.typeName
      parts.add(many.leftCollection, dataNavigationStepType(many.left, many.right), dataNavigationSkipStep(many, false))
    end
    if many.right.typeName == entity.typeName
      parts.add(many.rightCollection, dataNavigationStepType(many.right, many.left), dataNavigationSkipStep(many, true))
    end
    many = many.nextMany
  end
  return parts
end

def dataNavigationRootParts(mapping: DataMapping): NavigationFacadeParts
  let parts = new NavigationFacadeParts()
  var entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      let typeName = dataNavigationSetName(mapping, entity)
      let steps = dataNavigationSetParts(mapping, entity)

      parts.add(entity.setName, typeName, "new " + typeName + "(" + steps.arguments + ")")
    end
    entity = entity.nextEntity
  end
  return parts
end

def dataWriteNavigationFacade(
  output: DataArtifact,
  mapping: DataMapping,
  typeName: String,
  parts: NavigationFacadeParts
): Void
  output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\nclass " + typeName + "\n")
  output.write(parts.declarations + "\n  def init(" + parts.parameters + "): Void\n")
  output.write(parts.assignments + "  end\nend\n")
end

def dataEmitNavigationFacades(mapping: DataMapping, emission: DataEmission): Void
  let root = new DataArtifact()

  root.name = "navigation.hk"
  dataWriteNavigationFacade(root, mapping, "Navigation_" + mapping.contextName, dataNavigationRootParts(mapping))
  emission.add(root)
  var entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      let output = new DataArtifact()

      output.name = "navigation_" + entity.generatedName + ".hk"
      dataWriteNavigationFacade(
        output,
        mapping,
        dataNavigationSetName(mapping, entity),
        dataNavigationSetParts(mapping, entity)
      )
      emission.add(output)
    end
    entity = entity.nextEntity
  end
end

def dataEmitNavigationSelectorRegistration(
  output: DataArtifact,
  mapping: DataMapping,
  source: DataEntity,
  target: DataEntity,
  member: String,
  scopedStep: String = ""
): Void
  let symbol = source.symbol

  if symbol == null || member == ""
    return
  end
  let field = dataFindField(mapping.semantic, symbol, member)

  if field == null
    return
  end
  let step = scopedStep == "" ? "this.navigation." + source.setName + "." + member : scopedStep

  output.write("    this.changes.registerNavigation<" + semanticNamespaceDisplay(source.typeName) + ", " + semanticNamespaceDisplay(target.typeName) + ">(" + lspQuote(source.typeName) + ", " + lspQuote(field.owner + "." + field.name) + ", " + lspQuote(field.typeName) + ", " + step + ")\n")
end

def dataEmitNavigationSelectorRegistrations(output: DataArtifact, mapping: DataMapping): Void
  var relation = mapping.firstRelation

  while relation != null
    let principal = relation.principal
    let dependent = relation.dependent
    let foreignKey = relation.foreignKey

    if !relation.implicitJoin && principal != null && dependent != null && foreignKey != null
      let collection = principal.hierarchyParent == null ? "" : dataNavigationRelationStep(
        relation,
        principal,
        dependent,
        foreignKey,
        true
      )
      let reference = dependent.hierarchyParent == null ? "" : dataNavigationRelationStep(
        relation,
        principal,
        dependent,
        foreignKey,
        false
      )

      dataEmitNavigationSelectorRegistration(
        output,
        mapping,
        principal,
        dependent,
        relation.collectionMember,
        collection
      )
      dataEmitNavigationSelectorRegistration(output, mapping, dependent, principal, relation.referenceMember, reference)
    end
    relation = relation.nextRelation
  end
  var many = mapping.firstMany

  while many != null
    let left = many.left.hierarchyParent == null ? "" : dataNavigationSkipStep(many, false)
    let right = many.right.hierarchyParent == null ? "" : dataNavigationSkipStep(many, true)

    dataEmitNavigationSelectorRegistration(output, mapping, many.left, many.right, many.leftCollection, left)
    dataEmitNavigationSelectorRegistration(output, mapping, many.right, many.left, many.rightCollection, right)
    many = many.nextMany
  end
end
