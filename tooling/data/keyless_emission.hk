def dataEmitKeylessReferenceMethod(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let key = relation.key

  if key == null
    return
  end
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("\n  ## Loads a detached reference from keyless rows to keyed principals.\n  public def includeReference_" + name + "(dependents: " + dataMappedQueryType(dependent) + "): neri_data::KeylessReferencedQuery<" + d + ", " + p + ">\n    let foreignKey = fn(entity: " + d + "): neri_data::Cell do\n      return " + dataRelationKeyCell(
      dependent,
      relation.foreignKeyMembers,
      foreignKey
    ) + "\n    end\n    let principalKey = fn(entity: " + p + "): neri_data::Cell do\n      return " + dataRelationKeyCell(
      principal,
      relation.keyMembers,
      key
    ) + "\n    end\n    let setReference = fn(entity: " + d + ", value: " + p + "?): Void do\n      entity." + relation.referenceMember + " = value\n    end\n\n    return neri_data::includeKeylessReference(dependents.query(), this." + dataNavigationQueryField(principal) + ".query(), foreignKey, principalKey, setReference)\n  end\n")
  output.write("\n  public def keylessReferenceStep_" + name + "(): neri_data::NavigationStep<" + d + ", " + p + ">\n")
  output.write("    return " + dataKeylessReferenceStepName(name) + "(this." + dataNavigationQueryField(dependent) + ".query(), this." + dataNavigationQueryField(principal) + ".query())\n  end\n")
end

def dataKeylessReferenceStepName(name: String): String
  return "build_keyless_reference_step_" + name
end

def dataEmitKeylessReferenceStepFactory(
  output: DataArtifact,
  relation: DataRelation,
  principal: DataEntity,
  dependent: DataEntity,
  foreignKey: DataField
): Void
  let key = relation.key

  if key == null
    return
  end
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let name = dataRelationName(relation, principal, dependent, foreignKey)

  output.write("def " + dataKeylessReferenceStepName(name) + "(dependents: neri_data::Query<" + d + ">, principals: neri_data::Query<" + p + ">): neri_data::NavigationStep<" + d + ", " + p + ">\n  let foreignKey = fn(entity: " + d + "): neri_data::Cell do\n    return " + dataRelationKeyCell(
      dependent,
      relation.foreignKeyMembers,
      foreignKey
    ) + "\n  end\n  let principalKey = fn(entity: " + p + "): neri_data::Cell do\n    return " + dataRelationKeyCell(
      principal,
      relation.keyMembers,
      key
    ) + "\n  end\n  let getReference = fn(entity: " + d + "): " + p + "? do\n    return entity." + relation.referenceMember + "\n  end\n  let setReference = fn(entity: " + d + ", value: " + p + "?): Void do\n    entity." + relation.referenceMember + " = value\n  end\n\n  return neri_data::keylessReferenceStep(dependents, principals, foreignKey, principalKey, getReference, setReference, foreignKeyColumns: " + dataMemberColumns(
      dependent,
      relation.foreignKeyMembers
    ) + ")\nend\n\n")
end
