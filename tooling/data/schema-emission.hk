def dataEmitSchemaTable(output: DataArtifact, mapping: DataMapping, entity: DataEntity): Void
  output.write("\n      new neri_data::SchemaTable(")
  output.write(lspQuote(entity.typeName), entity.origin)
  output.write(", ")
  output.write(lspQuote(entity.tableName), entity.origin)
  output.write(", [")
  var field = entity.firstField
  var fieldSeparator = ""

  while field != null
    output.write(fieldSeparator + "\n          new neri_data::SchemaField(")
    output.write(lspQuote(dataFieldIdentity(field)), field.origin)
    output.write(", new neri_data::SchemaColumn(")
    output.write(lspQuote(field.columnName), field.origin)
    output.write(", neri_data::SchemaType." + dataStorageColumn(field) + "(), nullable: " + (dataFieldStorageOptional(field) || field.hierarchyType != "" ? "true" : "false") + ", primaryKey: " + (field.hierarchyType == "" && entity.isKeyMember(field.memberName) ? "true" : "false"))
    if field.defaultCode != ""
      output.write(", defaultValue: " + field.defaultCode)
    end
    if field.defaultSql != ""
      output.write(", defaultSql: " + lspQuote(field.defaultSql))
    end
    if field.computedSql != ""
      output.write(", computedSql: " + lspQuote(field.computedSql) + ", computedStored: " + (field.computedStored ? "true" : "false"))
    end
    if field.checkSql != ""
      output.write(", checkSql: " + lspQuote(field.checkSql))
    end
    if field.collation != ""
      output.write(", collation: " + lspQuote(field.collation))
    end
    if entity.keyMembers.size > 1 && entity.isKeyMember(field.memberName)
      output.write(", keyPosition: " + (dataKeyPosition(entity, field.memberName) as String))
    end
    output.write(dataSchemaReferenceCode(mapping, entity, field))
    output.write("))")
    fieldSeparator = ","
    field = field.nextField
  end
  if entity.discriminatorColumn != ""
    output.write(fieldSeparator + "\n          new neri_data::SchemaField(" + lspQuote(entity.typeName + ".__discriminator") + ", new neri_data::SchemaColumn(" + lspQuote(entity.discriminatorColumn) + ", neri_data::SchemaType.Text()))")
  end
  output.write("\n        ]")
  var index = entity.firstIndex
  var indexSeparator = ""

  if index != null
    output.write(", [")
  end
  while index != null
    output.write(indexSeparator + "\n          new neri_data::SchemaIndex(" + lspQuote(index.name) + ", [")
    var member = 0
    var memberSeparator = ""

    while member < index.fields.size
      output.write(memberSeparator + lspQuote(index.fields.get(member)))
      memberSeparator = ", "
      member = member + 1
    end
    output.write("], " + (index.unique ? "true" : "false") + dataIndexFacetsCode(index) + ")")
    indexSeparator = ","
    index = index.nextIndex
  end
  if entity.firstIndex != null
    output.write("\n        ]")
  end
  if entity.firstSeed != null
    output.write(", []") if entity.firstIndex == null
    output.write(", [")
    var seed = entity.firstSeed
    var seedSeparator = ""

    while seed != null
      output.write(seedSeparator + "\n          " + seed.code)
      seedSeparator = ","
      seed = seed.nextSeed
    end
    output.write("\n        ]")
  end
  output.write(")")
end
