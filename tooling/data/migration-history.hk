use files
use host
use neri_data

def dataMigrationReadLimited(path: String, maximum: Int): String?
  let read = files::readBytes(path, maximum)
  let bytes = read.bytes

  if read.failure != null || read.closeFailure != null || bytes == null
    return null
  end
  return host::stringFromBytes(bytes)
end

def dataMigrationHistorical(mapping: DataMapping, requested: String): DataMigrationSnapshot
  var result = new DataMigrationSnapshot()

  if requested == "empty"
    result.model = new neri_data::SchemaModel([])
    return result
  end
  let path = bootstrapStartsWith(requested, "/") ? requested : mapping.mappingRoot + "/" + requested
  let resolved = neriCanonicalPath(path)

  if resolved == null || host::pathFileName(resolved) != "snapshot.json"
    result.error = "historical snapshot must be an existing snapshot.json"
    return result
  end
  let snapshotStatus = files::status(path)
  let snapshotFile = snapshotStatus.status
  let markerPath = bootstrapDirectory(resolved) + "/scaffold.json"
  let markerStatus = files::status(markerPath)
  let markerFile = markerStatus.status

  if snapshotStatus.failure != null || snapshotFile == null || !snapshotFile.exists || snapshotFile.symlink || !snapshotFile.kind.isFile() || markerStatus.failure != null || markerFile == null || !markerFile.exists || markerFile.symlink || !markerFile.kind.isFile()
    result.error = "historical snapshot and scaffold marker must be regular files without symlinks"
    return result
  end
  let snapshotText = dataMigrationReadLimited(resolved, 4194304)
  let markerText = dataMigrationReadLimited(markerPath, 16777216)

  if snapshotText == null || markerText == null
    result.error = "cannot read historical snapshot and scaffold marker"
    return result
  end
  let parser = new LspJsonParser(markerText)
  let marker = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(markerText) || !dataMigrationJsonObject(result, marker, "scaffold marker", ["version", "generator", "beforeSignature", "afterSignature", "snapshotSha256", "sourceSha256", "mappingSha256", "upDataLoss", "downDataLoss"]) || !marker.get("version").isNumber() || marker.get("version").scalarText() != "1" || !marker.get("generator").isString() || marker.get("generator").scalarText() != "neri-data-migration" || !marker.get("beforeSignature").isString() || !marker.get("afterSignature").isString() || !marker.get("snapshotSha256").isString() || !neriGenerationDigest(marker.get("snapshotSha256")) || marker.get("snapshotSha256").scalarText() != sha256Text(snapshotText) || !marker.get("sourceSha256").isString() || !neriGenerationDigest(marker.get("sourceSha256")) || !marker.get("mappingSha256").isString() || !neriGenerationDigest(marker.get("mappingSha256")) || !marker.get("upDataLoss").isBoolean() || !marker.get("downDataLoss").isBoolean()
    result.error = "historical scaffold marker is invalid or snapshot digest differs"
    return result
  end
  result = dataMigrationReadSnapshot(snapshotText)
  let model = result.model

  if result.error != "" || model == null
    return result
  end
  if marker.get("afterSignature").scalarText() != model.signature()
    result.model = null
    result.error = "historical scaffold marker schema signature differs"
    return result
  end
  result.sourcePath = resolved
  result.sourceText = snapshotText
  result.markerText = markerText
  return result
end
