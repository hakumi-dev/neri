def dataHierarchyEntity(root: DataEntity, typeName: String): DataEntity?
  if root.typeName == typeName
    return root
  end
  var derived = root.firstDerived

  while derived != null
    if derived.entity.typeName == typeName
      return derived.entity
    end
    derived = derived.nextDerived
  end
  return null
end

def dataTPTLocalField(root: DataEntity, concrete: DataEntity, field: DataField): Bool
  if root.typeName == concrete.typeName
    return field.hierarchyType == ""
  end
  if root.isKeyMember(field.memberName)
    return true
  end
  var index = 0

  while index < concrete.hierarchyLocalMembers.size
    if concrete.hierarchyLocalMembers.get(index) == field.memberName
      return true
    end
    index = index + 1
  end
  return false
end

def dataTPTPhysical(root: DataEntity, concrete: DataEntity): DataEntity
  let physical = new DataEntity()

  physical.typeName = concrete.typeName
  physical.generatedName = concrete.generatedName
  physical.setName = "tableRows_" + concrete.generatedName
  physical.tableName = concrete.tableName
  physical.keyMember = root.keyMember
  physical.keyMembers = root.keyMembers
  physical.hierarchyParent = concrete.hierarchyParent
  physical.origin = concrete.origin
  var field = concrete.firstField

  while field != null
    if dataTPTLocalField(root, concrete, field)
      physical.addField(dataCopyField(field))
    end
    field = field.nextField
  end
  if root.typeName == concrete.typeName
    physical.firstIndex = root.firstIndex
    physical.lastIndex = root.lastIndex
  end
  return physical
end

def dataTPTSourceSql(root: DataEntity): String
  var output = "SELECT "
  var field = root.firstField

  while field != null
    let owner = field.hierarchyType == "" ? root : dataHierarchyEntity(root, field.hierarchyType)

    if owner != null
      output = output + (output == "SELECT " ? "" : ", ") + "\"" + owner.tableName + "\".\"" + field.columnName + "\" AS \"" + field.columnName + "\""
    end
    field = field.nextField
  end
  output = output + ", CASE "
  var derived = root.firstDerived
  let key = root.field(root.keyMember)

  var depth = 256

  while depth > 0
    derived = root.firstDerived
    while derived != null
      let symbol = derived.entity.symbol

      if key != null && symbol != null && !symbol.isAbstract && dataHierarchyDepth(root, derived.entity) == depth
        output = output + "WHEN \"" + derived.entity.tableName + "\".\"" + key.columnName + "\" IS NOT NULL THEN " + dataSqlStringLiteral(derived.discriminator) + " "
      end
      derived = derived.nextDerived
    end
    depth = depth - 1
  end
  output = output + "ELSE " + dataSqlStringLiteral(root.discriminatorValue) + " END AS \"" + root.discriminatorColumn + "\" FROM \"" + root.tableName + "\""
  derived = root.firstDerived
  while derived != null
    output = output + " LEFT JOIN \"" + derived.entity.tableName + "\" ON "
    var index = 0

    while index < root.keyMembers.size
      let member = root.field(root.keyMembers.get(index))

      if member != null
        output = output + (index == 0 ? "" : " AND ") + "\"" + root.tableName + "\".\"" + member.columnName + "\" = \"" + derived.entity.tableName + "\".\"" + member.columnName + "\""
      end
      index = index + 1
    end
    derived = derived.nextDerived
  end
  return output
end

def dataHierarchyDepth(root: DataEntity, child: DataEntity): Int
  var current: DataEntity? = child
  var depth = 0

  while current != null && current.typeName != root.typeName && depth < 256
    depth = depth + 1
    current = dataHierarchyEntity(root, current.hierarchyParent)
  end
  return depth
end

def dataTPTPublicNames(emission: DataEmission, names: StringBuffer, root: DataEntity): Bool
  if root.hierarchyStrategy != "tpt"
    return true
  end
  var derived = root.firstDerived

  while derived != null
    let relation = dataTPTRelation(root, derived.entity)
    let parent = relation == null ? null : relation.principal
    let child = relation == null ? null : relation.dependent
    let key = relation == null ? null : relation.foreignKey

    if relation != null && parent != null && child != null && key != null
      for name in [
        dataRelationPrincipalCellGetterName(relation, parent, child, key),
        dataRelationForeignKeyGetterName(relation, parent, child, key),
        dataRelationForeignKeySetterName(relation, parent, child, key),
        dataRelationEdgeFactoryName(relation, parent, child, key)
      ]
        if !dataEmissionAddName(emission, names, name, "table segment relationship helper")
          return false
        end
      end
    end
    derived = derived.nextDerived
  end
  return true
end

def dataTPTRelation(root: DataEntity, child: DataEntity): DataRelation?
  let parent = dataHierarchyEntity(root, child.hierarchyParent)

  if parent == null
    return null
  end
  let relation = new DataRelation()

  relation.principal = parent
  relation.dependent = dataTPTPhysical(root, child)
  relation.principalType = parent.typeName
  relation.dependentType = child.typeName
  relation.keyMember = root.keyMember
  relation.foreignKeyMember = root.keyMember
  relation.keyMembers = root.keyMembers
  relation.foreignKeyMembers = root.keyMembers
  relation.key = parent.field(root.keyMember)
  relation.foreignKey = child.field(root.keyMember)
  relation.deleteBehavior = "clientCascade"
  relation.forceScalar = true
  return relation
end

def dataEmitTPTCallbacks(output: DataArtifact, root: DataEntity): Void
  if root.hierarchyStrategy != "tpt"
    return
  end
  var derived = root.firstDerived

  while derived != null
    let relation = dataTPTRelation(root, derived.entity)
    let parent = relation == null ? null : relation.principal
    let child = relation == null ? null : relation.dependent
    let key = relation == null ? null : relation.key
    let foreignKey = relation == null ? null : relation.foreignKey

    if relation != null && parent != null && child != null && key != null && foreignKey != null
      output.write("def " + dataRelationPrincipalCellGetterName(
          relation,
          parent,
          child,
          foreignKey
        ) + "(entity: " + semanticNamespaceDisplay(parent.typeName) + "): neri_data::Cell\n  return " + dataRelationKeyCell(
          parent,
          root.keyMembers,
          key
        ) + "\nend\n\n")
      output.write("def " + dataRelationForeignKeyGetterName(
          relation,
          parent,
          child,
          foreignKey
        ) + "(entity: " + semanticNamespaceDisplay(child.typeName) + "): neri_data::Cell\n  return " + dataRelationKeyCell(
          child,
          root.keyMembers,
          foreignKey
        ) + "\nend\n\n")
      dataEmitScalarForeignKeySetter(output, relation, parent, child, foreignKey)
      dataEmitRelationEdgeFactory(output, relation, parent, child, foreignKey)
    end
    derived = derived.nextDerived
  end
end

def dataEmitTPTFields(output: DataArtifact, root: DataEntity): Void
  if root.hierarchyStrategy != "tpt"
    return
  end
  var derived = root.firstDerived

  while derived != null
    output.write("  private tableTracker_" + derived.entity.generatedName + ": neri_data::EntityTracker<" + semanticNamespaceDisplay(derived.entity.typeName) + ">\n")
    derived = derived.nextDerived
  end
end

def dataEmitTPTInit(output: DataArtifact, root: DataEntity): Void
  if root.hierarchyStrategy != "tpt"
    return
  end
  let b = semanticNamespaceDisplay(root.typeName)
  let key = root.field(root.keyMember)

  if key == null
    return
  end
  var derived = root.firstDerived

  while derived != null
    let child = derived.entity
    let physical = dataTPTPhysical(root, child)
    let d = semanticNamespaceDisplay(child.typeName)

    let comparer = root.snapshotEqual == "" ? "" : ", snapshotEqual: neri_data::tableSegmentComparer(this.tracker_" + root.generatedName + ", " + dataEntityKeyColumns(root) + ", " + semanticNamespaceDisplay(root.snapshotEqual) + ")"

    output.write("    this.tableTracker_" + child.generatedName + " = new neri_data::EntityTracker<" + d + ">(" + lspQuote(child.tableName) + ", " + lspQuote(key.columnName) + ", " + dataResultColumns(physical) + ", capture_" + child.generatedName + ", apply_" + child.generatedName + (root.keyMembers.size > 1 ? ", keyColumns: " + dataEntityKeyColumns(root) : "") + comparer + ")\n    this.changes.register(this.tableTracker_" + child.generatedName + ".changeSet())\n")
    derived = derived.nextDerived
  end
  derived = root.firstDerived
  while derived != null
    let child = derived.entity
    let relation = dataTPTRelation(root, child)
    let parent = relation == null ? null : relation.principal
    let dependent = relation == null ? null : relation.dependent
    let foreignKey = relation == null ? null : relation.foreignKey

    if relation != null && parent != null && dependent != null && foreignKey != null
      let p = semanticNamespaceDisplay(parent.typeName)
      let d = semanticNamespaceDisplay(child.typeName)
      let parentTracker = parent.typeName == root.typeName ? "tracker_" + root.generatedName : "tableTracker_" + parent.generatedName

      output.write("    let tableParent_" + child.generatedName + ": fn(" + b + "): " + p + "? = fn(entity: " + b + "): " + p + "? do\n      return " + (parent.typeName == root.typeName ? "entity" : "downcast_" + parent.generatedName + "(entity)") + "\n    end\n    let tableSegment_" + child.generatedName + " = new neri_data::TableSegment<" + b + ", " + p + ", " + d + ">(this.changes, this.tracker_" + root.generatedName + ", this." + parentTracker + ", this.tableTracker_" + child.generatedName + ", tableParent_" + child.generatedName + ", downcast_" + child.generatedName + ", upcast_" + child.generatedName + ", " + dataRelationEdgeFactoryName(
          relation,
          parent,
          dependent,
          foreignKey
        ) + ")\n    tableSegment_" + child.generatedName + ".register()\n")
    end
    derived = derived.nextDerived
  end
end
