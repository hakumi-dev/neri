def dataSqlStringLiteral(value: String): String
  var output = "'"
  var index = 0

  while index < host::stringByteLength(value)
    let character = host::stringSlice(value, index, 1)

    output = output + (character == "'" ? "''" : character)
    index = index + 1
  end
  return output + "'"
end

def dataTPCConcreteColumns(entity: DataEntity): String
  var output = "new neri_data::ResultColumns(["
  var field = dataOwnField(entity.firstField)

  while field != null
    output = output + (output == "new neri_data::ResultColumns([" ? "" : ", ") + dataResultColumn(field)
    field = dataOwnField(field.nextField)
  end
  return output + "])"
end

def dataTPCBranchSql(root: DataEntity, concrete: DataEntity): String
  var output = "SELECT "
  var field = root.firstField

  while field != null
    var present = false
    var candidate = dataOwnField(concrete.firstField)

    while candidate != null
      present = true if candidate.columnName == field.columnName
      candidate = dataOwnField(candidate.nextField)
    end
    output = output + (output == "SELECT " ? "" : ", ") + (present ? "\"" + field.columnName + "\"" : "NULL") + " AS \"" + field.columnName + "\""
    field = field.nextField
  end
  return output + ", " + dataSqlStringLiteral(concrete.discriminatorValue) + " AS \"" + root.discriminatorColumn + "\" FROM \"" + concrete.tableName + "\""
end

def dataTPCSourceSql(root: DataEntity): String
  let symbol = root.symbol
  var output = symbol != null && symbol.isAbstract ? "" : dataTPCBranchSql(root, root)
  var derived = root.firstDerived

  while derived != null
    let derivedSymbol = derived.entity.symbol

    if derivedSymbol == null || !derivedSymbol.isAbstract
      output = output + (output == "" ? "" : " UNION ALL ") + dataTPCBranchSql(root, derived.entity)
    end
    derived = derived.nextDerived
  end
  return output
end

def dataEmitTPCLayout(output: DataArtifact, entity: DataEntity): Void
  if entity.hierarchyStrategy != "tpc" && entity.hierarchyStrategy != "tpt"
    return
  end
  if entity.hierarchyStrategy == "tpt"
    output.write("def layout_" + entity.generatedName + "(row: neri_data::RawRow): neri_data::TrackedWriteLayout\n  return new neri_data::TrackedWriteLayout(" + lspQuote(entity.tableName) + ", " + dataTPCConcreteColumns(entity) + ")\nend\n\n")
    return
  end
  output.write("def layout_" + entity.generatedName + "(row: neri_data::RawRow): neri_data::TrackedWriteLayout\n  var discriminator = \"\"\n\n  match neri_data::decodeString(row, " + lspQuote(entity.discriminatorColumn) + ")\n    case neri_data::DecodeResult.Value(value)\n      discriminator = value\n    case neri_data::DecodeResult.Failure(error)\n  end\n")
  let symbol = entity.symbol

  if symbol == null || !symbol.isAbstract
    output.write("  if discriminator == " + lspQuote(entity.discriminatorValue) + "\n    return new neri_data::TrackedWriteLayout(" + lspQuote(entity.tableName) + ", " + dataTPCConcreteColumns(entity) + ")\n  end\n")
  end
  var derived = entity.firstDerived

  while derived != null
    let derivedSymbol = derived.entity.symbol

    if derivedSymbol == null || !derivedSymbol.isAbstract
      output.write("  if discriminator == " + lspQuote(derived.discriminator) + "\n    return new neri_data::TrackedWriteLayout(" + lspQuote(derived.entity.tableName) + ", " + dataTPCConcreteColumns(derived.entity) + ")\n  end\n")
    end
    derived = derived.nextDerived
  end
  output.write("  return new neri_data::TrackedWriteLayout(\"\", " + dataTPCConcreteColumns(entity) + ")\nend\n\n")
end

def dataTPCSchemaEntity(root: DataEntity, concrete: DataEntity): DataEntity
  let physical = new DataEntity()

  physical.typeName = concrete.typeName
  physical.tableName = concrete.tableName
  physical.keyMember = root.keyMember
  physical.keyMembers = root.keyMembers
  physical.origin = concrete.origin
  var field = dataOwnField(concrete.firstField)

  while field != null
    physical.addField(dataCopyField(field))
    field = dataOwnField(field.nextField)
  end
  var definition = root.firstIndex

  while definition != null
    let index = new DataIndex()

    index.name = concrete.tableName + "_" + definition.name
    index.fields = definition.fields
    index.unique = definition.unique
    index.alternateKey = definition.alternateKey
    index.descending = definition.descending
    index.expressions = definition.expressions
    index.included = definition.included
    index.predicate = definition.predicate
    physical.addIndex(index)
    definition = definition.nextIndex
  end
  return physical
end

def dataTPCSchemaOwner(mapping: DataMapping, physical: DataEntity): DataEntity
  var root = mapping.firstEntity

  while root != null
    if root.hierarchyStrategy == "tpc"
      var derived = root.firstDerived

      while derived != null
        if derived.entity.typeName == physical.typeName
          return root
        end
        derived = derived.nextDerived
      end
    end
    root = root.nextEntity
  end
  return physical
end
