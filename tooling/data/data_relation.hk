class DataRelation
  public principalType: String = ""
  public dependentType: String = ""
  public keyMember: String = ""
  public keyMembers: StringBuffer = new StringBuffer()
  public foreignKeyMember: String = ""
  public foreignKeyMembers: StringBuffer = new StringBuffer()
  public referenceAnchor: String = ""
  public anchorVisit: Int = 0
  public deleteBehavior: String = "restrict"
  public collectionMember: String = ""
  public referenceMember: String = ""
  public collectionOrigin: DataOrigin = new DataOrigin()
  public referenceOrigin: DataOrigin = new DataOrigin()
  public principal: DataEntity?
  public dependent: DataEntity?
  public key: DataField?
  public foreignKey: DataField?
  public nextRelation: DataRelation?
end
