use host

class DataEmission
  public error: String = ""
  public firstArtifact: DataArtifact?
  public lastArtifact: DataArtifact?

  def add(artifact: DataArtifact): Void
    artifact.finish()
    let last = this.lastArtifact

    if last == null
      this.firstArtifact = artifact
    else
      last.nextArtifact = artifact
    end
    this.lastArtifact = artifact
  end
end
