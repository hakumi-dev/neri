use host

class DataEmission
  public error: String = ""
  public outputPath: String = ""
  private configurationFiles: StringTable<String> = new StringTable<String>()
  public firstArtifact: DataArtifact?
  public lastArtifact: DataArtifact?

  def add(artifact: DataArtifact): Void
    artifact.finish()
    let configured = codeStyleOptionsFor(this.outputPath + "/" + artifact.name, this.configurationFiles)

    if configured.error != ""
      this.error = configured.error
      return
    end
    let error = artifact.format(configured.options)

    if error != ""
      this.error = error
      return
    end
    let last = this.lastArtifact

    if last == null
      this.firstArtifact = artifact
    else
      last.nextArtifact = artifact
    end
    this.lastArtifact = artifact
  end
end
