class DataField
  public memberName: String = ""
  public getter: String = ""
  public setter: String = ""
  public columnName: String = ""
  public typeName: String = ""
  public pathCode: String = ""
  public schemaIdentity: String = ""
  public boolToInt: Bool = false
  public conversionEncode: String = ""
  public conversionDecode: String = ""
  public conversionInitial: String = ""
  public conversionStorageType: String = ""
  public jsonSymbol: SemanticClass?
  public jsonPrefix: String = ""
  public defaultSql: String = ""
  public computedSql: String = ""
  public computedStored: Bool = true
  public checkSql: String = ""
  public collation: String = ""
  public hierarchyType: String = ""
  public domain: DataScalarKind
  public optional: Bool = false
  public optionalParents: StringBuffer = new StringBuffer()
  public defaultCode: String = ""
  public defaultNode: LspJson?
  public generatedOnAdd: Bool = false
  public generatedOnUpdate: Bool = false
  public symbol: SemanticField?
  public declaration: SemanticDeclaration?
  public origin: DataOrigin = new DataOrigin()
  public nextField: DataField?

  def init(domain: DataScalarKind): Void
    this.domain = domain
  end
end
