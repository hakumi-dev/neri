use host
use test

def main(): Void
  test::assertEqual(dataRelativePath("/workspace/project", "/workspace/project/generated/item.hk"), "generated/item.hk")
  test::assertEqual(dataRelativePath("/workspace/project", "/workspace/shared/schema.hk"), "../shared/schema.hk")
  test::assertEqual(
    dataRelativePath("/workspace/project/app", "/toolchain/stdlib/core.hk"),
    "../../../toolchain/stdlib/core.hk"
  )
  test::assertTrue(dataArtifactName("Account.entity.hk"))
  test::assertTrue(!dataArtifactName("../entity.hk"))
  test::assertTrue(!dataArtifactName("manifest.json"))

  let firstMapping = new DataMapping()
  let secondMapping = new DataMapping()
  let firstInputs = new DataPublishInputs()
  let secondInputs = new DataPublishInputs()
  let firstEmission = new DataEmission()
  let secondEmission = new DataEmission()
  let firstArtifact = new DataArtifact()
  let secondArtifact = new DataArtifact()

  firstMapping.projectRoot = "/first/project"
  secondMapping.projectRoot = "/relocated/project"
  firstInputs.add("/first/project/entities.hk", "source")
  secondInputs.add("/relocated/project/entities.hk", "source")
  firstArtifact.name = "entity.hk"
  secondArtifact.name = "entity.hk"
  firstArtifact.text = "class Entity\nend\n"
  secondArtifact.text = firstArtifact.text
  firstEmission.firstArtifact = firstArtifact
  secondEmission.firstArtifact = secondArtifact

  test::assertEqual(
    dataPublishRevision(firstMapping, firstInputs, firstEmission),
    dataPublishRevision(secondMapping, secondInputs, secondEmission)
  )

  let standardLibrary = host::environment("NERI_STDLIB")

  if standardLibrary != null
    test::assertEqual(dataPublishInputPath(firstMapping, standardLibrary + "/core.hk"), "@stdlib/core.hk")
  end
end
