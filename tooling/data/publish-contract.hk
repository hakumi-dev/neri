use test

def main(): Void
  let generated = new DataArtifact()
  let generatedOrigin = new DataOrigin()

  generatedOrigin.identity = "Entity.label"
  generated.write("class Entity\npublic label:String=\"")
  generated.write("café 😀", generatedOrigin)
  generated.write("\"\nend\n")
  generated.finish()
  let formattingError = generated.format(new NeriCodeStyleOptions())
  let span = generated.firstOrigin

  test::assertEqual(formattingError, "")
  test::assertTrue(span != null)
  if span != null
    let map = new IrSourceMap(generated.text)
    let start = map.offsetAt(span.start)
    let finish = map.offsetAt(span.start + span.length)

    test::assertEqual(host::stringSlice(generated.text, start, finish - start), "café 😀")
    test::assertEqual(span.origin.identity, "Entity.label")
    let text = generated.text
    let originalStart = span.start
    let repeatedError = generated.format(new NeriCodeStyleOptions())

    test::assertEqual(repeatedError, "")
    test::assertEqual(generated.text, text)
    test::assertEqual(span.start, originalStart)
  end

  test::assertEqual(dataRelativePath("/workspace/project", "/workspace/project/generated/item.hk"), "generated/item.hk")
  test::assertEqual(dataRelativePath("/workspace/project", "/workspace/shared/schema.hk"), "../shared/schema.hk")
  test::assertEqual(
    dataRelativePath("/workspace/project/app", "/toolchain/stdlib/core.hk"),
    "../../../toolchain/stdlib/core.hk"
  )
  test::assertTrue(dataArtifactName("Account.entity.hk"))
  test::assertTrue(!dataArtifactName("../entity.hk"))
  test::assertTrue(!dataArtifactName("manifest.json"))

  let crossing = new DataArtifact()

  crossing.write("class Entity\n  ")
  crossing.write(" ", generatedOrigin)
  crossing.write(" public label:String=\"")
  crossing.write("café 😀", generatedOrigin)
  crossing.write("\"\nend\n")
  crossing.finish()
  let originalText = crossing.text
  let originalSpan = crossing.firstOrigin

  test::assertTrue(originalSpan != null)
  if originalSpan != null
    let crossingSpan = originalSpan.nextOrigin
    let control = new DataArtifact()
    let validSpan = new DataEmittedOrigin()

    validSpan.start = originalSpan.start
    validSpan.length = originalSpan.length
    validSpan.origin = generatedOrigin
    control.text = originalText
    control.firstOrigin = validSpan
    let controlError = control.format(new NeriCodeStyleOptions())

    test::assertEqual(controlError, "")
    test::assertTrue(validSpan.start != originalSpan.start)
    test::assertTrue(crossingSpan != null)
    if crossingSpan != null
      let originalPosition = originalSpan.start
      let crossingPosition = crossingSpan.start
      let originalLength = originalSpan.length
      let crossingLength = crossingSpan.length
      let crossingError = crossing.format(new NeriCodeStyleOptions())

      test::assertTrue(crossingError != "")
      test::assertEqual(crossing.text, originalText)
      test::assertEqual(originalSpan.start, originalPosition)
      test::assertEqual(originalSpan.length, originalLength)
      test::assertEqual(crossingSpan.start, crossingPosition)
      test::assertEqual(crossingSpan.length, crossingLength)
    end
  end

  let firstMapping = new DataMapping()
  let secondMapping = new DataMapping()
  let firstInputs = new DataPublishInputs()
  let secondInputs = new DataPublishInputs()
  let firstEmission = new DataEmission()
  let secondEmission = new DataEmission()
  let firstArtifact = new DataArtifact()
  let secondArtifact = new DataArtifact()

  firstMapping.projectRoot = "/first/project"
  secondMapping.projectRoot = "/relocated/project"
  firstInputs.add("/first/project/entities.hk", "source")
  secondInputs.add("/relocated/project/entities.hk", "source")
  firstArtifact.name = "entity.hk"
  secondArtifact.name = "entity.hk"
  firstArtifact.text = "class Entity\nend\n"
  secondArtifact.text = firstArtifact.text
  firstEmission.firstArtifact = firstArtifact
  secondEmission.firstArtifact = secondArtifact

  test::assertEqual(
    dataPublishRevision(firstMapping, firstInputs, firstEmission),
    dataPublishRevision(secondMapping, secondInputs, secondEmission)
  )

  let standardLibrary = host::environment("NERI_STDLIB")

  if standardLibrary != null
    test::assertEqual(dataPublishInputPath(firstMapping, standardLibrary + "/core.hk"), "@stdlib/core.hk")
  end
end
