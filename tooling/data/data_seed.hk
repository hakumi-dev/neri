class DataSeed
  public node: LspJson
  public owner: DataEntity
  public cellCodes: StringTable<String>
  public keyCode: String
  public nextSeed: DataSeed?

  def init(node: LspJson, owner: DataEntity, cellCodes: StringTable<String>, keyCode: String = ""): Void
    this.node = node
    this.owner = owner
    this.cellCodes = cellCodes
    this.keyCode = keyCode
  end
end
