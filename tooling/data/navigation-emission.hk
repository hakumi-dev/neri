## Navigation descriptors use the member names declared on each entity set.
def dataNavigationSetName(mapping: DataMapping, entity: DataEntity): String
  return "NavigationSet_" + mapping.contextName + "_" + entity.generatedName
end

def dataHasNavigationMembers(mapping: DataMapping, entity: DataEntity): Bool
  var relation = mapping.firstRelation

  while relation != null
    if !relation.implicitJoin && ((relation.collectionMember != "" && relation.principalType == entity.typeName) || (relation.referenceMember != "" && relation.dependentType == entity.typeName))
      return true
    end
    relation = relation.nextRelation
  end
  var many = mapping.firstMany

  while many != null
    if many.left.typeName == entity.typeName || many.right.typeName == entity.typeName
      return true
    end
    many = many.nextMany
  end
  return false
end

def dataNavigationPublicNames(mapping: DataMapping, emission: DataEmission, declarations: StringBuffer): Bool
  if !dataEmissionAddName(emission, declarations, "Navigation_" + mapping.contextName, "navigation facade")
    return false
  end
  var entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      if !dataEmissionAddName(emission, declarations, dataNavigationSetName(mapping, entity), "navigation set facade")
        return false
      end
      let members = new StringBuffer()

      members.add("init")
      var relation = mapping.firstRelation

      while relation != null
        if !relation.implicitJoin
          if relation.collectionMember != "" && relation.principalType == entity.typeName && !dataEmissionAddName(
            emission,
            members,
            relation.collectionMember,
            "navigation member"
          )
            return false
          end
          if relation.referenceMember != "" && relation.dependentType == entity.typeName && !dataEmissionAddName(
            emission,
            members,
            relation.referenceMember,
            "navigation member"
          )
            return false
          end
        end
        relation = relation.nextRelation
      end
      var many = mapping.firstMany

      while many != null
        if many.left.typeName == entity.typeName && !dataEmissionAddName(
          emission,
          members,
          many.leftCollection,
          "skip navigation member"
        )
          return false
        end
        if many.right.typeName == entity.typeName && !dataEmissionAddName(
          emission,
          members,
          many.rightCollection,
          "skip navigation member"
        )
          return false
        end
        many = many.nextMany
      end
    end
    entity = entity.nextEntity
  end
  return true
end

def dataEmitNavigationFacades(mapping: DataMapping, emission: DataEmission): Void
  let root = new DataArtifact()

  root.name = "navigation.hk"
  root.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\nclass Navigation_" + mapping.contextName + "\n")
  var entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      root.write("  public " + entity.setName + ": " + dataNavigationSetName(mapping, entity) + "\n")
    end
    entity = entity.nextEntity
  end
  root.write("\n  def init(context: " + mapping.contextName + "): Void\n")
  entity = mapping.firstEntity
  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      root.write("    this." + entity.setName + " = new " + dataNavigationSetName(mapping, entity) + "(context)\n")
    end
    entity = entity.nextEntity
  end
  root.write("  end\nend\n")
  emission.add(root)
  entity = mapping.firstEntity

  while entity != null
    if dataHasNavigationMembers(mapping, entity)
      let output = new DataArtifact()

      output.name = "navigation_" + entity.generatedName + ".hk"
      output.write("namespace " + semanticNamespaceDisplay(mapping.namespaceName) + "\n\nclass " + dataNavigationSetName(
          mapping,
          entity
        ) + "\n")
      var relation = mapping.firstRelation

      while relation != null
        let principal = relation.principal
        let dependent = relation.dependent

        if !relation.implicitJoin && principal != null && dependent != null
          if relation.collectionMember != "" && relation.principalType == entity.typeName
            output.write("  public " + relation.collectionMember + ": neri_data::NavigationStep<" + semanticNamespaceDisplay(principal.typeName) + ", " + semanticNamespaceDisplay(dependent.typeName) + ">\n")
          end
          if relation.referenceMember != "" && relation.dependentType == entity.typeName
            output.write("  public " + relation.referenceMember + ": neri_data::NavigationStep<" + semanticNamespaceDisplay(dependent.typeName) + ", " + semanticNamespaceDisplay(principal.typeName) + ">\n")
          end
        end
        relation = relation.nextRelation
      end
      dataEmitSkipNavigationFacadeMembers(output, mapping, entity, false)
      output.write("\n  def init(context: " + mapping.contextName + "): Void\n")
      relation = mapping.firstRelation

      while relation != null
        let principal = relation.principal
        let dependent = relation.dependent
        let foreignKey = relation.foreignKey

        if !relation.implicitJoin && principal != null && dependent != null && foreignKey != null
          let name = dataRelationName(relation, principal, dependent, foreignKey)

          if relation.collectionMember != "" && relation.principalType == entity.typeName
            output.write("    this." + relation.collectionMember + " = context.collectionStep_" + name + "()\n")
          end
          if relation.referenceMember != "" && relation.dependentType == entity.typeName
            output.write("    this." + relation.referenceMember + " = context." + (dependent.keyless ? "keylessReferenceStep_" : "referenceStep_") + name + "()\n")
          end
        end
        relation = relation.nextRelation
      end
      dataEmitSkipNavigationFacadeMembers(output, mapping, entity, true)
      output.write("  end\nend\n")
      emission.add(output)
    end
    entity = entity.nextEntity
  end
end

def dataEmitSkipNavigationFacadeMembers(
  output: DataArtifact,
  mapping: DataMapping,
  entity: DataEntity,
  initialize: Bool
): Void
  var many = mapping.firstMany

  while many != null
    if many.left.typeName == entity.typeName
      output.write(initialize ? "    this." + many.leftCollection + " = context.skipStep_" + many.name + "()\n" : "  public " + many.leftCollection + ": neri_data::NavigationStep<" + semanticNamespaceDisplay(many.left.typeName) + ", " + semanticNamespaceDisplay(many.right.typeName) + ">\n")
    end
    if many.right.typeName == entity.typeName
      output.write(initialize ? "    this." + many.rightCollection + " = context.inverseSkipStep_" + many.name + "()\n" : "  public " + many.rightCollection + ": neri_data::NavigationStep<" + semanticNamespaceDisplay(many.right.typeName) + ", " + semanticNamespaceDisplay(many.left.typeName) + ">\n")
    end
    many = many.nextMany
  end
end
