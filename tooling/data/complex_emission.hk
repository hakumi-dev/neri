def dataComplexFieldDecoder(field: DataField): String
  if field.conversionDecode != ""
    if field.optionalParents.size > 0 && !field.optional
      let family = dataTextScalarFamily(field.typeName)

      return "neri_data::decodeNullable" + family
    end
    return semanticNamespaceDisplay(field.conversionDecode)
  end
  return "neri_data::decode" + (dataFieldStorageOptional(field) ? "Nullable" : "") + dataDecoderKind(field)
end

def dataEmitComplexPresenceValidation(output: DataArtifact, entity: DataEntity): Void
  var field = dataOwnField(entity.firstField)

  while field != null
    var index = 0

    while index < field.optionalParents.size
      let parent = entity.complex(field.optionalParents.get(index))
      let presence = parent == null ? null : entity.field(parent.presenceMember)

      if presence != null && presence.memberName != field.memberName
        output.write("  if " + dataFieldLocal(presence) + " == null && " + dataFieldLocal(field) + " != null\n    return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(neri_data::QueryFailure.TypeMismatch(" + lspQuote(field.columnName) + ", \"absent complex value\", \"non-null dependent scalar\"))\n  end\n")
      end
      index = index + 1
    end
    field = dataOwnField(field.nextField)
  end
end

def dataEmitComplexConstruction(output: DataArtifact, entity: DataEntity, complex: DataComplex, receiver: String): Void
  let guard = dataComplexGuard(entity, complex, receiver)
  var indent = "  "

  if guard != ""
    output.write(indent + "if " + guard + "\n")
    indent = indent + "  "
  end
  let presence = entity.field(complex.presenceMember)

  if complex.optional && presence != null
    output.write(indent + receiver + "." + complex.memberName + " = null\n" + indent + "if " + dataFieldLocal(presence) + " != null\n")
    indent = indent + "  "
  end
  output.write(indent + receiver + "." + complex.memberName + " = new " + semanticNamespaceDisplay(complex.typeName) + "()\n")
  if complex.optional && presence != null
    indent = guard == "" ? "  " : "    "
    output.write(indent + "end\n")
  end
  output.write("  end\n") if guard != ""
end

def dataEmitComplexFieldAssignment(output: DataArtifact, entity: DataEntity, field: DataField, receiver: String): Void
  let guard = dataOptionalParentGuard(field, receiver)
  var indent = "  "

  if guard != ""
    output.write(indent + "if " + guard + "\n")
    indent = indent + "  "
  end
  if field.optionalParents.size > 0 && !field.optional
    output.write(indent + "if " + dataFieldLocal(field) + " == null\n" + indent + "  return neri_data::DecodeResult<" + semanticNamespaceDisplay(entity.typeName) + ">.Failure(neri_data::QueryFailure.TypeMismatch(" + lspQuote(field.columnName) + ", \"required complex scalar\", \"null\"))\n" + indent + "end\n")
  end
  output.write(indent + dataFieldWrite(field, receiver, dataFieldLocal(field)) + "\n")
  output.write("  end\n") if guard != ""
end

def dataComplexPresenceCode(entity: DataEntity): String
  var complex = entity.firstComplex
  var result = ""

  while complex != null
    let field = entity.field(complex.presenceMember)

    if complex.optional && field != null
      result = result + (result == "" ? ", presences: [" : ", ") + "new neri_data::MappingPresence(" + complex.pathCode + ", " + lspQuote(field.columnName) + ")"
    end
    complex = complex.nextComplex
  end
  return result == "" ? "" : result + "]"
end
