def dataManyRelation(
  mapping: DataMapping,
  principal: DataEntity,
  join: DataEntity,
  foreignKeys: StringBuffer
): DataRelation?
  var relation = mapping.firstRelation

  while relation != null
    if relation.principalType == principal.typeName && relation.dependentType == join.typeName && dataMembersEqual(
      relation.foreignKeyMembers,
      foreignKeys
    ) && relation.collectionMember != "" && relation.referenceMember != ""
      return relation
    end
    relation = relation.nextRelation
  end
  return null
end

def dataParseMany(mapping: DataMapping, node: LspJson): Bool
  if node.isMissing()
    return true
  end
  if !node.isArray()
    return mapping.fail("mapping.manyToMany must be an array.")
  end
  var definition = node.first

  while definition != null
    let context = "mapping.manyToMany"

    if !dataObject(
      mapping,
      definition,
      context,
      ["name", "left", "right", "join", "leftForeignKey", "rightForeignKey", "leftCollection", "rightCollection"]
    )
      return false
    end
    let name = dataString(mapping, definition, "name", context)
    let left = mapping.entity(dataString(mapping, definition, "left", context))
    let right = mapping.entity(dataString(mapping, definition, "right", context))
    let join = mapping.entity(dataString(mapping, definition, "join", context))
    let leftKeys = new StringBuffer()
    let rightKeys = new StringBuffer()

    if !dataIdentifier(name) || left == null || right == null || join == null || left.keyless || right.keyless || join.keyless || !join.initializeWithFields || join.firstComplex != null || join.firstDerived != null
      return mapping.fail(context + " requires distinct mapped keyed endpoints and a join with zero-argument construction and flat fields.")
    end
    if left.typeName == join.typeName || right.typeName == join.typeName
      return mapping.fail(context + " join entity must differ from both endpoints.")
    end
    if left.typeName == right.typeName
      return mapping.fail(context + " self-referencing skip navigations require a separate direction contract.")
    end
    if !dataParseMembers(
      mapping,
      definition.get("leftForeignKey"),
      leftKeys,
      context
    ) || !dataParseMembers(
      mapping,
      definition.get("rightForeignKey"),
      rightKeys,
      context
    )
      return false
    end
    let leftRelation = dataManyRelation(mapping, left, join, leftKeys)
    let rightRelation = dataManyRelation(mapping, right, join, rightKeys)

    if leftRelation == null || rightRelation == null || leftRelation.foreignKeyMember == rightRelation.foreignKeyMember
      return mapping.fail(context + " requires two existing collection/reference relations through distinct join foreign-key tuples.")
    end
    if !join.generatedKey
      var keyIndex = 0

      while keyIndex < join.keyMembers.size
        let key = join.keyMembers.get(keyIndex)
        var found = false
        var component = 0

        while component < leftKeys.size
          found = found || key == leftKeys.get(component)
          component = component + 1
        end
        component = 0
        while component < rightKeys.size
          found = found || key == rightKeys.get(component)
          component = component + 1
        end
        if !found
          return mapping.fail(context + " join primary keys must come from endpoint foreign keys or store generation.")
        end
        keyIndex = keyIndex + 1
      end
    end
    let many = new DataMany(name, left, join, right, leftRelation, rightRelation)

    many.leftCollection = dataString(mapping, definition, "leftCollection", context)
    many.rightCollection = dataString(mapping, definition, "rightCollection", context)
    let leftSymbol = left.symbol
    let rightSymbol = right.symbol

    if leftSymbol == null || rightSymbol == null || !dataIdentifier(many.leftCollection) || !dataIdentifier(many.rightCollection)
      return mapping.fail(context + " requires public array navigation members.")
    end
    let leftField = dataFindField(mapping.semantic, leftSymbol, many.leftCollection)
    let rightField = dataFindField(mapping.semantic, rightSymbol, many.rightCollection)

    if leftField == null || rightField == null || !leftField.access.isPublic() || !rightField.access.isPublic() || leftField.typeName != right.typeName + "[]" || rightField.typeName != left.typeName + "[]"
      return mapping.fail(context + " skip and inverse navigation fields must be public arrays of the opposite endpoint.")
    end
    var relation = mapping.firstRelation

    while relation != null
      if (relation.principalType == left.typeName && relation.collectionMember == many.leftCollection) || (relation.principalType == right.typeName && relation.collectionMember == many.rightCollection)
        return mapping.fail(context + " skip navigation members cannot replace ordinary relation members.")
      end
      relation = relation.nextRelation
    end
    var previous = mapping.firstMany

    while previous != null
      if previous.name == name || (previous.left.typeName == left.typeName && previous.leftCollection == many.leftCollection) || (previous.right.typeName == right.typeName && previous.rightCollection == many.rightCollection)
        return mapping.fail(context + " repeats a navigation name or member.")
      end
      previous = previous.nextMany
    end
    mapping.addMany(many)
    definition = definition.next
  end
  return true
end

def dataManyNavigationName(relation: DataRelation): String
  let principal = relation.principal
  let dependent = relation.dependent
  let foreignKey = relation.foreignKey

  return principal == null || dependent == null || foreignKey == null ? "" : "navigation_" + dataRelationName(
    relation,
    principal,
    dependent,
    foreignKey
  )
end

def dataManyType(many: DataMany): String
  return "neri_data::ManyToManyNavigation<" + semanticNamespaceDisplay(many.left.typeName) + ", " + semanticNamespaceDisplay(many.join.typeName) + ", " + semanticNamespaceDisplay(many.right.typeName) + ">"
end

def dataEmitManyCallbacks(output: DataArtifact, mapping: DataMapping): Void
  var many = mapping.firstMany

  while many != null
    let left = semanticNamespaceDisplay(many.left.typeName)
    let right = semanticNamespaceDisplay(many.right.typeName)
    let join = semanticNamespaceDisplay(many.join.typeName)

    output.write("def skip_get_left_" + many.name + "(entity: " + left + "): " + right + "[]\n  return entity." + many.leftCollection + "\nend\n\n")
    output.write("def skip_set_left_" + many.name + "(entity: " + left + ", values: " + right + "[]): Void\n  entity." + many.leftCollection + " = values\nend\n\n")
    output.write("def skip_get_right_" + many.name + "(entity: " + right + "): " + left + "[]\n  return entity." + many.rightCollection + "\nend\n\n")
    output.write("def skip_set_right_" + many.name + "(entity: " + right + ", values: " + left + "[]): Void\n  entity." + many.rightCollection + " = values\nend\n\n")
    output.write("def skip_create_" + many.name + "(left: " + left + ", right: " + right + "): " + join + "\n  let entity = new " + join + "()\n")
    var index = 0

    while index < many.leftRelation.keyMembers.size
      output.write("  entity." + many.leftRelation.foreignKeyMembers.get(index) + " = left." + many.leftRelation.keyMembers.get(index) + "\n")
      index = index + 1
    end
    index = 0
    while index < many.rightRelation.keyMembers.size
      output.write("  entity." + many.rightRelation.foreignKeyMembers.get(index) + " = right." + many.rightRelation.keyMembers.get(index) + "\n")
      index = index + 1
    end
    output.write("  entity." + many.leftRelation.referenceMember + " = left\n  entity." + many.rightRelation.referenceMember + " = right\n\n  return entity\nend\n\n")
    many = many.nextMany
  end
end

def dataEmitManyFields(output: DataArtifact, mapping: DataMapping): Void
  var many = mapping.firstMany

  while many != null
    output.write("  private skip_" + many.name + ": " + dataManyType(many) + "\n")
    many = many.nextMany
  end
end

def dataEmitManyInit(output: DataArtifact, mapping: DataMapping): Void
  var many = mapping.firstMany

  while many != null
    output.write("    let enroll_" + many.name + ": fn(" + semanticNamespaceDisplay(many.join.typeName) + "): neri_data::QueryFailure? = fn(root: " + semanticNamespaceDisplay(many.join.typeName) + "): neri_data::QueryFailure? do\n      match this.addGraph_" + many.join.setName + "(root)\n        case neri_data::TrackHandleResult.Tracked(handle)\n          return null\n        case neri_data::TrackHandleResult.Failure(error)\n          return error\n      end\n    end\n")
    output.write("    this.skip_" + many.name + " = new " + dataManyType(many) + "(this." + dataManyNavigationName(many.leftRelation) + ", this." + dataManyNavigationName(many.rightRelation) + ", skip_get_left_" + many.name + ", skip_set_left_" + many.name + ", skip_get_right_" + many.name + ", skip_set_right_" + many.name + ", skip_create_" + many.name + ", enroll_" + many.name + ")\n")
    many = many.nextMany
  end
end

def dataEmitManyMethods(output: DataArtifact, mapping: DataMapping): Void
  var many = mapping.firstMany

  while many != null
    let left = semanticNamespaceDisplay(many.left.typeName)
    let right = semanticNamespaceDisplay(many.right.typeName)
    let queries = "this." + many.left.setName + ", this." + many.join.setName + ", this." + many.right.setName

    output.write("\n  public def include_" + many.name + "(maximum: Int = 10000): neri_data::QueryResult<" + left + ">\n    return this.skip_" + many.name + ".all(" + queries + ", maximum)\n  end\n")
    output.write("\n  public def include_" + many.name + "Async(maximum: Int = 10000, options: neri_data::StreamOptions? = null): result::Result<neri_data::AsyncLoad<" + left + ">, neri_data::QueryFailure>\n    match this.skip_" + many.name + ".allAsync(" + queries + ", maximum, options)\n      case result::Result.Error(error)\n        return result::Result<neri_data::AsyncLoad<" + left + ">, neri_data::QueryFailure>.Error(error)\n      case result::Result.Ok(operation)\n        return result::Result<neri_data::AsyncLoad<" + left + ">, neri_data::QueryFailure>.Ok(transfer operation)\n    end\n  end\n")
    for action in ["link", "unlink"]
      output.write("\n  public def " + action + "_" + many.name + "(left: " + left + ", right: " + right + "): neri_data::QueryFailure?\n    return this.skip_" + many.name + "." + action + "(this." + many.join.setName + ", left, right)\n  end\n")
    end
    many = many.nextMany
  end
end
