use host
use neri_data

def dataMigrationType(kind: DataScalarKind): neri_data::SchemaType
  match kind
    case DataScalarKind.Bool()
      return neri_data::SchemaType.Bool()
    case DataScalarKind.Int()
      return neri_data::SchemaType.Int()
    case DataScalarKind.Float()
      return neri_data::SchemaType.Float()
    case DataScalarKind.String()
      return neri_data::SchemaType.Text()
    case DataScalarKind.Binary()
      return neri_data::SchemaType.Binary()
    case DataScalarKind.Decimal()
      return neri_data::SchemaType.Text()
  end
end

def dataMigrationDefault(field: DataField): neri_data::SchemaDefault?
  let node = field.defaultNode

  if node == null
    return null
  end
  if node.isNull()
    return neri_data::SchemaDefault.Null()
  end
  match field.domain
    case DataScalarKind.Bool()
      return field.boolToInt ? neri_data::SchemaDefault.Int(node.isTrue() ? 1 : 0) : neri_data::SchemaDefault.Bool(node.isTrue())
    case DataScalarKind.Int()
      let value = host::parseInt(node.scalarText())

      return value == null ? null : neri_data::SchemaDefault.Int(value)
    case DataScalarKind.Float()
      let value = host::parseFloat(node.scalarText())

      return value == null ? null : neri_data::SchemaDefault.Float(value)
    case DataScalarKind.String()
      return neri_data::SchemaDefault.Text(node.scalarText())
    case DataScalarKind.Binary()
      return null
    case DataScalarKind.Decimal()
      let text = dataDecimalLiteral(node.scalarText())

      return text == null ? null : neri_data::SchemaDefault.Text(text)
  end
end

def dataMigrationFieldAt(entity: DataEntity, position: Int): DataField?
  var field = entity.firstField
  var index = 0

  while field != null
    if index == position
      return field
    end
    field = field.nextField
    index = index + 1
  end
  return null
end

def dataMigrationIndexAt(entity: DataEntity, position: Int): DataIndex?
  var item = entity.firstIndex
  var index = 0

  while item != null
    if index == position
      return item
    end
    item = item.nextIndex
    index = index + 1
  end
  return null
end

def dataMigrationModel(mapping: DataMapping): DataMigrationSnapshot
  let result = new DataMigrationSnapshot()

  if mapping.error != ""
    result.error = mapping.error
    return result
  end
  var capacity = 0
  var entity = mapping.firstEntity

  while entity != null
    capacity = capacity + 1
    var derived = entity.firstDerived

    while derived != null
      capacity = capacity + 1
      derived = derived.nextDerived
    end
    entity = entity.nextEntity
  end
  let physical = arrays::generate<DataEntity?>(capacity) do |index|
    return null
  end
  let collectTable: fn(DataEntity, Int): Void = fn(table: DataEntity, index: Int): Void do
    physical[index] = table
  end

  let tableCount = dataVisitSchemaTables(mapping, collectTable)
  let tables: neri_data::SchemaTable[] = arrays::generate(tableCount) do |tableIndex|
    let current = physical[tableIndex]

    if current == null
      return new neri_data::SchemaTable("", "", [])
    end
    var fieldCount = 0
    var field = current.firstField

    while field != null
      fieldCount = fieldCount + 1
      field = field.nextField
    end
    fieldCount = fieldCount + 1 if current.discriminatorColumn != ""
    let fields: neri_data::SchemaField[] = arrays::generate(fieldCount) do |fieldIndex|
      let member = dataMigrationFieldAt(current, fieldIndex)

      if member == null
        if current.discriminatorColumn != ""
          return new neri_data::SchemaField(
            current.typeName + ".__discriminator",
            new neri_data::SchemaColumn(current.discriminatorColumn, neri_data::SchemaType.Text())
          )
        end
        return new neri_data::SchemaField("", new neri_data::SchemaColumn("", neri_data::SchemaType.Int()))
      end
      let column = new neri_data::SchemaColumn(
        member.columnName,
        member.boolToInt ? neri_data::SchemaType.Int() : dataMigrationType(member.domain),
        nullable: dataFieldStorageOptional(member) || member.hierarchyType != "",
        primaryKey: member.hierarchyType == "" && current.isKeyMember(member.memberName),
        defaultValue: dataMigrationDefault(member),
        reference: dataMigrationReference(mapping, current, member),
        keyPosition: dataKeyPosition(current, member.memberName),
        defaultSql: member.defaultSql == "" ? null : member.defaultSql,
        computedSql: member.computedSql == "" ? null : member.computedSql,
        computedStored: member.computedStored,
        checkSql: member.checkSql == "" ? null : member.checkSql,
        collation: member.collation == "" ? null : member.collation,
        postgresqlType: member.postgresqlType == "" ? null : member.postgresqlType
      )

      return new neri_data::SchemaField(dataFieldIdentity(member), column)
    end
    var indexCount = 0
    var item = current.firstIndex

    while item != null
      indexCount = indexCount + 1
      item = item.nextIndex
    end
    let indexes: neri_data::SchemaIndex[] = arrays::generate(indexCount) do |indexPosition|
      let definition = dataMigrationIndexAt(current, indexPosition)

      if definition == null
        return new neri_data::SchemaIndex("", [])
      end
      let identities: String[] = arrays::generate(definition.fields.size) do |memberIndex|
        return definition.fields.get(memberIndex)
      end

      let descending = arrays::generate<Bool>(definition.descending.size) do |position|
        return definition.descending.get(position) == "true"
      end
      let expressions = arrays::generate<String>(definition.expressions.size) do |position|
        return definition.expressions.get(position)
      end
      let included = arrays::generate<String>(definition.included.size) do |position|
        return definition.included.get(position)
      end

      return new neri_data::SchemaIndex(
        definition.name,
        identities,
        definition.unique,
        descending,
        definition.predicate == "" ? null : definition.predicate,
        expressions,
        included
      )
    end

    var seedCount = 0
    var seed = current.firstSeed

    while seed != null
      seedCount = seedCount + 1
      seed = seed.nextSeed
    end
    let seeds = arrays::generate<neri_data::SchemaSeed>(seedCount) do |position|
      var item = current.firstSeed
      var index = 0

      while item != null
        if index == position
          return dataMigrationMappedSeed(current, item)
        end
        item = item.nextSeed
        index = index + 1
      end
      return new neri_data::SchemaSeed([], [], [], [])
    end

    return new neri_data::SchemaTable(current.typeName, current.tableName, fields, indexes, seeds)
  end
  let model = new neri_data::SchemaModel(tables)
  let invalid = model.validate()

  if invalid != null
    result.error = invalid
  else
    result.model = model
  end
  return result
end

def dataMigrationMappedSeed(entity: DataEntity, seed: DataSeed): neri_data::SchemaSeed
  var count = entity.discriminatorColumn == "" ? 0 : 1
  var field = entity.firstField

  while field != null
    count = count + 1 if !entity.isKeyMember(field.memberName) && dataSeedFieldCode(seed, field) != null
    field = field.nextField
  end
  let keys = arrays::generate<String>(entity.keyMembers.size) do |index|
    let key = entity.field(entity.keyMembers.get(index))

    return key == null ? "" : dataFieldIdentity(key)
  end
  let keyValues = arrays::generate<neri_data::Cell>(entity.keyMembers.size) do |index|
    let key = entity.field(entity.keyMembers.get(index))

    return key == null ? neri_data::Cell.Null() : dataMigrationMappedSeedValue(key, seed.node.get(key.memberName))
  end
  let fields = arrays::generate<String>(count) do |index|
    let member = dataMigrationSeedFieldAt(entity, seed, index)

    return member == null ? entity.typeName + ".__discriminator" : dataFieldIdentity(member)
  end
  let values = arrays::generate<neri_data::Cell>(count) do |index|
    let member = dataMigrationSeedFieldAt(entity, seed, index)

    if member == null
      return neri_data::Cell.Text(seed.owner.discriminatorValue)
    end
    return dataSeedSibling(seed, member) ? neri_data::Cell.Null() : dataMigrationMappedSeedValue(
      member,
      seed.node.get(member.memberName)
    )
  end

  return new neri_data::SchemaSeed(keys, keyValues, fields, values)
end

def dataMigrationSeedFieldAt(entity: DataEntity, seed: DataSeed, position: Int): DataField?
  var index = 0
  var field = entity.firstField

  while field != null
    if !entity.isKeyMember(field.memberName) && dataSeedFieldCode(seed, field) != null
      if index == position
        return field
      end
      index = index + 1
    end
    field = field.nextField
  end
  return null
end

def dataMigrationMappedSeedValue(field: DataField, node: LspJson): neri_data::Cell
  if node.isNull()
    return neri_data::Cell.Null()
  end
  if field.boolToInt
    return neri_data::Cell.Int(node.isTrue() ? 1 : 0)
  end
  match field.domain
    case DataScalarKind.Bool()
      return neri_data::Cell.Bool(node.isTrue())
    case DataScalarKind.Int()
      let value = host::parseInt(node.scalarText())

      return neri_data::Cell.Int(value == null ? 0 : value)
    case DataScalarKind.Float()
      let value = host::parseFloat(node.scalarText())

      return neri_data::Cell.Float(value == null ? 0.0 : value)
    case DataScalarKind.String()
      return neri_data::Cell.Text(node.scalarText())
    case DataScalarKind.Decimal()
      let value = dataDecimalLiteral(node.scalarText())

      return neri_data::Cell.Text(value == null ? "" : value)
    case DataScalarKind.Binary()
      let bytes = crypto::decodeHex(node.get("hex").scalarText(), 1048576).bytes()

      return bytes == null ? neri_data::Cell.Null() : neri_data::cellBinaryBytes(bytes)
  end
end

def dataMigrationMemberColumns(entity: DataEntity, members: StringBuffer): String[]
  return arrays::generate<String>(members.size) do |index|
    let member = entity.field(members.get(index))

    return member == null ? "" : member.columnName
  end
end

def dataMigrationReference(mapping: DataMapping, entity: DataEntity, field: DataField): neri_data::SchemaReference?
  let parent = dataSchemaParent(entity, field)
  let owner = dataTPCSchemaOwner(mapping, entity)
  var relation = mapping.firstRelation

  if parent != null
    return new neri_data::SchemaReference(
      parent.tableName,
      dataMigrationMemberColumns(parent, parent.keyMembers),
      dataMigrationMemberColumns(entity, entity.keyMembers)
    )
  end
  while relation != null
    let principal = relation.principal

    if relation.dependentType == owner.typeName && dataReferenceAnchor(relation) == field.memberName && principal != null
      if principal.hierarchyStrategy == "tpc"
        return null
      end
      return new neri_data::SchemaReference(
        principal.tableName,
        dataMigrationMemberColumns(principal, relation.keyMembers),
        dataMigrationMemberColumns(entity, relation.foreignKeyMembers),
        onDelete: relation.databaseOnDelete,
        deferred: relation.deferred
      )
    end
    relation = relation.nextRelation
  end
  return null
end
