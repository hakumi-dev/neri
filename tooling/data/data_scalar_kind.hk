enum DataScalarKind
  case Int()
  case Bool()
  case Float()
  case String()
  case Binary()
  case Decimal()
end

def dataScalarName(kind: DataScalarKind): String
  match kind
    case DataScalarKind.Int()
      return "Int"
    case DataScalarKind.Bool()
      return "Bool"
    case DataScalarKind.Float()
      return "Float"
    case DataScalarKind.String()
      return "String"
    case DataScalarKind.Binary()
      return "ByteBuffer"
    case DataScalarKind.Decimal()
      return "Decimal"
  end
end

def dataScalarColumn(kind: DataScalarKind): String
  match kind
    case DataScalarKind.Int()
      return "Int"
    case DataScalarKind.Bool()
      return "Bool"
    case DataScalarKind.Float()
      return "Float"
    case DataScalarKind.String()
      return "Text"
    case DataScalarKind.Binary()
      return "Binary"
    case DataScalarKind.Decimal()
      return "Text"
  end
end

def dataScalarInitialValue(kind: DataScalarKind): String
  match kind
    case DataScalarKind.Int()
      return "0"
    case DataScalarKind.Bool()
      return "false"
    case DataScalarKind.Float()
      return "0.0"
    case DataScalarKind.String()
      return "\"\""
    case DataScalarKind.Binary()
      return "new buffers::ByteBuffer(134217728, 0)"
    case DataScalarKind.Decimal()
      return "neri_data::Decimal.zero()"
  end
end

def dataScalarSupportsKey(kind: DataScalarKind): Bool
  match kind
    case DataScalarKind.Int()
      return true
    case DataScalarKind.Bool()
      return false
    case DataScalarKind.Float()
      return false
    case DataScalarKind.String()
      return true
    case DataScalarKind.Binary()
      return false
    case DataScalarKind.Decimal()
      return false
  end
end
