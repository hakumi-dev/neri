class DataSource
  public path: String = ""
  public text: String = ""
  public start: Int = 0
  public nextSource: DataSource?
end

class DataOrigin
  public identity: String = ""
  public sourcePath: String = ""
  public start: Int = 0
  public length: Int = 0
end

class DataField
  public memberName: String = ""
  public columnName: String = ""
  public typeName: String = ""
  public domain: String = ""
  public optional: Bool = false
  public symbol: SemanticField?
  public declaration: SemanticDeclaration?
  public origin: DataOrigin = new DataOrigin()
  public nextField: DataField?
end

class DataEntity
  public typeName: String = ""
  public generatedName: String = ""
  public setName: String = ""
  public tableName: String = ""
  public keyMember: String = ""
  public construction: String = ""
  public symbol: SemanticClass?
  public initializer: SemanticCallable?
  public declaration: SemanticDeclaration?
  public origin: DataOrigin = new DataOrigin()
  public firstField: DataField?
  public lastField: DataField?
  public nextEntity: DataEntity?

  def addField(field: DataField): Void
    let last = this.lastField

    if last == null
      this.firstField = field
    else
      last.nextField = field
    end
    this.lastField = field
  end

  def field(member: String): DataField?
    var current = this.firstField

    while current != null
      if current.memberName == member
        return current
      end
      current = current.nextField
    end
    return null
  end
end

class DataRelation
  public principalType: String = ""
  public dependentType: String = ""
  public keyMember: String = ""
  public foreignKeyMember: String = ""
  public principal: DataEntity?
  public dependent: DataEntity?
  public key: DataField?
  public foreignKey: DataField?
  public nextRelation: DataRelation?
end

class DataMapping
  public error: String = ""
  public version: Int = 0
  public mappingPath: String = ""
  public mappingText: String = ""
  public mappingRoot: String = ""
  public projectRoot: String = ""
  public projectPath: String = ""
  public projectText: String = ""
  public unit: String = ""
  public namespaceName: String = ""
  public contextName: String = ""
  public outputPath: String = ""
  public semantic: SemanticModel?
  public firstSource: DataSource?
  public lastSource: DataSource?
  public firstEntity: DataEntity?
  public lastEntity: DataEntity?
  public firstRelation: DataRelation?
  public lastRelation: DataRelation?

  def fail(message: String): Bool
    if this.error == ""
      this.error = message
    end
    return false
  end

  def addSource(source: DataSource): Void
    let last = this.lastSource

    if last == null
      this.firstSource = source
    else
      last.nextSource = source
    end
    this.lastSource = source
  end

  def addEntity(entity: DataEntity): Void
    let last = this.lastEntity

    if last == null
      this.firstEntity = entity
    else
      last.nextEntity = entity
    end
    this.lastEntity = entity
  end

  def addRelation(relation: DataRelation): Void
    let last = this.lastRelation

    if last == null
      this.firstRelation = relation
    else
      last.nextRelation = relation
    end
    this.lastRelation = relation
  end

  def entity(typeName: String): DataEntity?
    var current = this.firstEntity

    while current != null
      if current.typeName == typeName
        return current
      end
      current = current.nextEntity
    end
    return null
  end
end
