use host
use crypto

def dataSeedCellCode(mapping: DataMapping, field: DataField, value: LspJson, context: String): String
  if dataScalarName(field.domain) == "String" && !value.isNull()
    if !value.isString()
      mapping.fail(context + " seed text values require a JSON string.")
      return ""
    end
    return "neri_data::Cell.Text(" + dataStringLiteral(value.scalarText()) + ")"
  end
  if dataScalarName(field.domain) == "ByteBuffer" && !value.isNull()
    if !dataObject(mapping, value, context, ["hex"]) || !value.get("hex").isString()
      mapping.fail(context + " binary seed values require {hex: String}.")
      return ""
    end
    let bytes = crypto::decodeHex(value.get("hex").scalarText(), 1048576).bytes()

    if bytes == null
      mapping.fail(context + " binary seed hex is invalid or exceeds 1048576 bytes.")
      return ""
    end
    var code = "neri_data::cellBinaryBytes(["
    var index = 0

    while index < bytes.Length
      code = code + (index == 0 ? "" : ", ") + ((bytes[index] as Int) as String) + " as Byte"
      index = index + 1
    end
    return code + "])"
  end
  let copy = dataCopyField(field)

  if !dataParseDefault(mapping, copy, value, context)
    return ""
  end
  let prefix = "neri_data::SchemaDefault."

  return "neri_data::Cell." + host::stringSlice(
    copy.defaultCode,
    host::stringByteLength(prefix),
    host::stringByteLength(copy.defaultCode) - host::stringByteLength(prefix)
  )
end

def dataParseSeeds(mapping: DataMapping, entity: DataEntity, node: LspJson, context: String): Bool
  if node.isMissing()
    return true
  end
  if !node.isArray() || entity.keyless || entity.discriminatorColumn != ""
    return mapping.fail(context + " requires a seed array on a keyed non-hierarchy entity.")
  end
  var count = 0
  var field = entity.firstField

  while field != null
    count = count + 1
    field = field.nextField
  end
  let members = arrays::generate<String>(count) do |index|
    var current = entity.firstField
    var position = 0

    while current != null
      if position == index
        return current.memberName
      end
      current = current.nextField
      position = position + 1
    end
    return ""
  end
  var row = node.first
  var rowCount = 0

  while row != null
    if rowCount >= 1000 || !dataObject(mapping, row, context, members)
      return mapping.fail(context + " seed rows must be objects, bounded to 1000 entries.")
    end
    let seed = new DataSeed(row)
    var keys = "["
    var keyValues = "["
    var fields = "["
    var values = "["

    field = entity.firstField
    while field != null
      let value = row.get(field.memberName)

      if value.isMissing()
        if entity.isKeyMember(field.memberName) || (!field.optional && field.defaultCode == "")
          return mapping.fail(context + " seed rows require assigned keys and values for every required field without a default.")
        end
      else
        let code = dataSeedCellCode(mapping, field, value, context + "." + field.memberName)

        if code == ""
          return false
        end
        if entity.isKeyMember(field.memberName)
          keys = keys + (keys == "[" ? "" : ", ") + lspQuote(dataFieldIdentity(field))
          keyValues = keyValues + (keyValues == "[" ? "" : ", ") + code
        else
          fields = fields + (fields == "[" ? "" : ", ") + lspQuote(dataFieldIdentity(field))
          values = values + (values == "[" ? "" : ", ") + code
        end
      end
      field = field.nextField
    end
    seed.code = "new neri_data::SchemaSeed(" + keys + "], " + keyValues + "], " + fields + "], " + values + "])"
    seed.keyCode = keyValues
    var previous = entity.firstSeed

    while previous != null
      if previous.keyCode == seed.keyCode
        return mapping.fail(context + " repeats an assigned primary-key tuple.")
      end
      previous = previous.nextSeed
    end
    entity.addSeed(seed)
    row = row.next
    rowCount = rowCount + 1
  end
  return true
end
