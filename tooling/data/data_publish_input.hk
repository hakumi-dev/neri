use files
use host

## Publication stages all artifacts and their manifest before replacing the
## generated directory atomically. An old-manifest reader can fail content checks
## and retry, but cannot accept a mixture of generations.

class DataPublishInput
  public path: String = ""
  public text: String = ""
  public digest: String = ""
  public utf16Length: Int = 0
  public next: DataPublishInput?
end
