def dataCopyField(source: DataField): DataField
  let field = new DataField(source.domain)

  field.memberName = source.memberName
  field.getter = source.getter
  field.setter = source.setter
  field.columnName = source.columnName
  field.typeName = source.typeName
  field.pathCode = source.pathCode
  field.schemaIdentity = source.schemaIdentity
  field.boolToInt = source.boolToInt
  field.conversionEncode = source.conversionEncode
  field.conversionDecode = source.conversionDecode
  field.conversionInitial = source.conversionInitial
  field.conversionStorageType = source.conversionStorageType
  field.jsonSymbol = source.jsonSymbol
  field.jsonPrefix = source.jsonPrefix
  field.defaultSql = source.defaultSql
  field.computedSql = source.computedSql
  field.computedStored = source.computedStored
  field.checkSql = source.checkSql
  field.collation = source.collation
  field.optional = source.optional
  field.optionalParents = source.optionalParents
  field.defaultCode = source.defaultCode
  field.defaultNode = source.defaultNode
  field.generatedOnAdd = source.generatedOnAdd
  field.generatedOnUpdate = source.generatedOnUpdate
  field.symbol = source.symbol
  field.declaration = source.declaration
  field.origin = source.origin
  return field
end

def dataHierarchyDiscriminators(mapping: DataMapping, root: DataEntity, selected: DataEntity): String
  var result = "[" + lspQuote(selected.discriminatorValue)
  var derived = root.firstDerived
  let semantic = mapping.semantic

  while derived != null
    var symbol = derived.entity.symbol
    var depth = 0

    while symbol != null && semantic != null && depth < 256
      if symbol.baseName == selected.typeName
        result = result + ", " + lspQuote(derived.discriminator)
        break
      end
      symbol = semantic.findClass(symbol.baseName)
      depth = depth + 1
    end
    derived = derived.nextDerived
  end
  return result + "]"
end

def dataParseHierarchy(mapping: DataMapping, entity: DataEntity, node: LspJson, context: String): Bool
  if node.isMissing()
    return true
  end
  if entity.keyless
    return mapping.fail(context + " requires a keyed hierarchy root.")
  end
  if !dataObject(mapping, node, context, ["strategy", "discriminatorColumn", "value", "derivedTypes"])
    return false
  end
  entity.hierarchyStrategy = dataString(mapping, node, "strategy", context)
  if entity.hierarchyStrategy != "tph" && entity.hierarchyStrategy != "tpc" && entity.hierarchyStrategy != "tpt"
    return mapping.fail(context + ".strategy must be 'tph', 'tpt', or 'tpc'.")
  end
  if entity.hierarchyStrategy == "tpc" && (entity.generatedKey || entity.view)
    return mapping.fail(context + " TPC requires assigned globally unique keys and managed concrete tables.")
  end
  if entity.hierarchyStrategy == "tpt" && entity.view
    return mapping.fail(context + " TPT requires managed physical tables.")
  end
  if entity.readView != "" && entity.hierarchyStrategy != "tph"
    return mapping.fail(context + " readView is supported for ordinary entities and TPH roots.")
  end
  entity.discriminatorColumn = dataString(mapping, node, "discriminatorColumn", context)
  entity.discriminatorValue = dataString(mapping, node, "value", context)
  if !dataSqlIdentifier(entity.discriminatorColumn) || entity.discriminatorValue == ""
    return mapping.fail(context + " requires a valid discriminatorColumn and nonempty root value.")
  end
  var field = entity.firstField

  while field != null
    if dataSqlSameIdentifier(field.columnName, entity.discriminatorColumn)
      return mapping.fail(context + ".discriminatorColumn collides with a mapped scalar column.")
    end
    field = field.nextField
  end
  let derivedTypes = dataRequired(mapping, node, "derivedTypes", LspJsonType.Array(), context)

  if derivedTypes == null || derivedTypes.first == null
    return mapping.fail(context + ".derivedTypes requires at least one derived type.")
  end
  var definition: LspJson? = derivedTypes.first

  while definition != null
    if !dataObject(mapping, definition, context + ".derivedTypes", ["type", "value", "columns", "table"])
      return false
    end
    let child = new DataEntity()

    child.typeName = dataString(mapping, definition, "type", context)
    child.discriminatorValue = dataString(mapping, definition, "value", context)
    child.discriminatorColumn = entity.discriminatorColumn
    child.tableName = entity.tableName
    if entity.hierarchyStrategy == "tpc" || entity.hierarchyStrategy == "tpt"
      let tableSemantic = mapping.semantic
      let tableSymbol = tableSemantic == null ? null : dataFindClass(tableSemantic, child.typeName)

      if entity.hierarchyStrategy == "tpc" && definition.get("table").isMissing() && tableSymbol != null && tableSymbol.isAbstract
        child.tableName = entity.tableName + "_abstract_" + tableSymbol.name
      else
        child.tableName = dataString(mapping, definition, "table", context)
      end
      if !dataSqlIdentifier(child.tableName) || dataSqlReserved(child.tableName) || dataSqlSameIdentifier(
        child.tableName,
        entity.tableName
      )
        return mapping.fail(context + " TPC descendants require distinct valid physical table names.")
      end
      var mappedTable = mapping.firstEntity

      while mappedTable != null
        if dataSqlSameIdentifier(mappedTable.tableName, child.tableName)
          return mapping.fail(context + " TPC table collides with an existing mapped table.")
        end
        mappedTable = mappedTable.nextEntity
      end
      var concrete = entity.firstDerived

      while concrete != null
        if dataSqlSameIdentifier(concrete.entity.tableName, child.tableName)
          return mapping.fail(context + " TPC concrete table names must be distinct.")
        end
        concrete = concrete.nextDerived
      end
    else if !definition.get("table").isMissing()
      return mapping.fail(context + " TPH descendants share the root table.")
    end
    child.keyMember = entity.keyMember
    child.keyMembers = entity.keyMembers
    child.generatedKey = entity.generatedKey
    let semantic = mapping.semantic

    if semantic == null
      return false
    end
    let symbol = dataFindClass(semantic, child.typeName)

    if symbol == null || (!symbol.access.isPublic() && !symbol.access.isInternal())
      return mapping.fail(context + ".derivedTypes requires accessible subclasses of the root.")
    end
    var parent: DataEntity? = symbol.baseName == entity.typeName ? entity : null
    var ancestor = entity.firstDerived

    while ancestor != null
      parent = ancestor.entity if ancestor.entity.typeName == symbol.baseName
      ancestor = ancestor.nextDerived
    end
    if parent == null
      return mapping.fail(context + ".derivedTypes must register each mapped base before its nested subclasses.")
    end
    child.hierarchyParent = parent.typeName
    if child.discriminatorValue == "" || child.discriminatorValue == entity.discriminatorValue
      return mapping.fail(context + ".derivedTypes requires distinct nonempty discriminator values.")
    end
    var prior = entity.firstDerived

    while prior != null
      if prior.entity.typeName == child.typeName || prior.discriminator == child.discriminatorValue || prior.entity.generatedName == symbol.name
        return mapping.fail(context + ".derivedTypes repeats a type, generated name, or discriminator value.")
      end
      prior = prior.nextDerived
    end
    if mapping.entity(child.typeName) != null
      return mapping.fail(context + ".derivedTypes must use one hierarchy root set for shared identity tracking.")
    end
    child.symbol = symbol
    child.generatedName = symbol.name
    child.origin = dataOrigin(mapping, dataDeclaration(semantic, "type:" + child.typeName))
    var complex = parent.firstComplex

    while complex != null
      let copied = new DataComplex()

      copied.memberName = complex.memberName
      copied.typeName = complex.typeName
      copied.pathCode = complex.pathCode
      copied.optional = complex.optional
      copied.presenceMember = complex.presenceMember
      child.addComplex(copied)
      complex = complex.nextComplex
    end
    field = parent.firstField
    while field != null
      child.addField(dataCopyField(field)) if field.hierarchyType == ""
      field = field.nextField
    end
    let columns = dataRequired(mapping, definition, "columns", LspJsonType.Array(), context)

    if columns == null
      return false
    end
    var column = columns.first
    var columnIndex = 0

    while column != null
      if !dataParseField(mapping, child, column, columnIndex)
        return false
      end
      let added = child.lastField

      if added != null
        child.hierarchyLocalMembers.add(added.memberName)
        if added.generatedOnAdd || added.generatedOnUpdate
          return mapping.fail(context + " derived generated values require a subtype readback contract.")
        end
        if dataSqlSameIdentifier(added.columnName, entity.discriminatorColumn)
          return mapping.fail(context + " derived scalar columns cannot replace the discriminator.")
        end
        var existing = entity.firstField

        while existing != null
          if dataSqlSameIdentifier(existing.columnName, added.columnName)
            return mapping.fail(context + " derived scalar columns must have distinct column names.")
          end
          existing = existing.nextField
        end
        let storage = dataCopyField(added)

        storage.hierarchyType = child.typeName
        entity.addField(storage)
      end
      column = column.next
      columnIndex = columnIndex + 1
    end
    if !dataValidateOptionalComplex(mapping, child) || !dataInitializer(child)
      return mapping.fail(context + " derived types require construction matching their mapped scalar columns.")
    end
    let derived = new DataDerived(child, child.discriminatorValue)

    if parent.typeName != entity.typeName
      derived.nextDerived = entity.firstDerived
      entity.firstDerived = derived
    else
      entity.addDerived(derived)
    end
    definition = definition.next
  end
  let rootSymbol = entity.symbol
  var concreteCount = rootSymbol != null && rootSymbol.isAbstract ? 0 : 1
  var concrete = entity.firstDerived

  while concrete != null
    let concreteSymbol = concrete.entity.symbol

    if concreteSymbol != null && !concreteSymbol.isAbstract
      concreteCount = concreteCount + 1
    end
    concrete = concrete.nextDerived
  end
  if concreteCount == 0
    return mapping.fail(context + " requires at least one concrete mapped type.")
  end
  return true
end
