use files
use host
use arrays

def dataRelativePath(root: String, path: String): String
  if path == root
    return "."
  end
  if bootstrapStartsWith(path, root + "/")
    return host::stringSlice(path, host::stringByteLength(root) + 1, host::stringByteLength(path) - host::stringByteLength(root) - 1)
  end
  let rootLength = host::stringByteLength(root)
  let pathLength = host::stringByteLength(path)
  let sharedLength = rootLength < pathLength ? rootLength : pathLength
  var index = 0
  var slash = 0

  while index < sharedLength && host::stringByteAt(root, index) == host::stringByteAt(path, index)
    if host::stringByteAt(root, index) == (47 as Byte)
      slash = index
    end
    index = index + 1
  end
  if index == rootLength && index < pathLength && host::stringByteAt(path, index) == (47 as Byte)
    return host::stringSlice(path, index + 1, pathLength - index - 1)
  end
  var result = ""

  index = slash + 1
  while index <= rootLength
    if index == rootLength || host::stringByteAt(root, index) == (47 as Byte)
      result = result + "../"
    end
    index = index + 1
  end
  return result + host::stringSlice(path, slash + 1, pathLength - slash - 1)
end

def dataPublishInputPath(mapping: DataMapping, path: String): String
  let standardLibrary = host::environment("NERI_STDLIB")

  if standardLibrary != null
    let prefix = standardLibrary + "/"

    if bootstrapStartsWith(path, prefix)
      return "@stdlib/" + host::stringSlice(path, host::stringByteLength(prefix), host::stringByteLength(path) - host::stringByteLength(prefix))
    end
  end
  return dataRelativePath(mapping.projectRoot, path)
end

def dataArtifactName(name: String): Bool
  let length = host::stringByteLength(name)

  if length < 4 || !semanticEndsWith(name, ".hk") || host::stringByteAt(name, 0) == (46 as Byte)
    return false
  end
  var index = 0

  while index < length
    let value = host::stringByteAt(name, index) as Int
    let valid = (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || (value >= 48 && value <= 57) || value == 95 || value == 45 || value == 46

    if !valid
      return false
    end
    index = index + 1
  end
  return true
end

def dataPublishIdentifierKey(value: String): String
  let length = host::stringByteLength(value)
  let bytes: Byte[] = arrays::generate(length) do |index|
    var byte = host::stringByteAt(value, index) as Int

    if byte >= 65 && byte <= 90
      byte = byte + 32
    end
    return byte as Byte
  end
  let key = host::stringFromBytes(bytes)

  if key == null
    return value
  end
  return key
end

def dataPublishInputs(mapping: DataMapping): DataPublishInputs?
  let mappingText = host::readText(mapping.mappingPath)
  let projectText = host::readText(mapping.projectPath)

  if mappingText == null || projectText == null
    mapping.fail("Cannot re-read the mapping and project manifests before publication.")
    return null
  end
  if mappingText != mapping.mappingText
    mapping.fail("Mapping changed while neri-data was generating: " + mapping.mappingPath)
    return null
  end
  if projectText != mapping.projectText
    mapping.fail("Project manifest changed while neri-data was generating: " + mapping.projectPath)
    return null
  end
  let inputs = new DataPublishInputs()

  inputs.add(mapping.mappingPath, mapping.mappingText)
  inputs.add(mapping.projectPath, mapping.projectText)
  var source = mapping.firstSource

  while source != null
    let current = host::readText(source.path)

    if current == null || current != source.text
      mapping.fail("Source changed while neri-data was generating: " + source.path)
      return null
    end
    inputs.add(source.path, source.text)
    source = source.nextSource
  end
  return inputs
end

def dataPublishRevision(mapping: DataMapping, inputs: DataPublishInputs, emission: DataEmission): String
  let parts = new StringBuffer()

  parts.add("neri-data\n2\n")
  var input = inputs.first

  while input != null
    parts.add(dataPublishInputPath(mapping, input.path) + "\n" + input.digest + "\n")
    input = input.next
  end
  var artifact = emission.firstArtifact

  while artifact != null
    parts.add(artifact.name + "\n" + sha256FastText(artifact.text) + "\n")
    artifact = artifact.nextArtifact
  end
  return sha256FastText(parts.join())
end

def dataPublishVerifyInputs(mapping: DataMapping, inputs: DataPublishInputs): Bool
  var input = inputs.first

  while input != null
    let current = host::readText(input.path)

    if current == null || current != input.text
      return mapping.fail("Input changed before publication: " + input.path)
    end
    input = input.next
  end
  return true
end

def dataPublishValidateOrigins(mapping: DataMapping, emission: DataEmission, inputs: DataPublishInputs): Bool
  var artifact = emission.firstArtifact

  while artifact != null
    let outputLength = (new IrSourceMap(artifact.text)).utf16Length()
    var emitted = artifact.firstOrigin

    while emitted != null
      let origin = emitted.origin
      let input = inputs.find(origin.sourcePath)

      if emitted.start < 0 || emitted.length < 1 || emitted.start > outputLength || emitted.length > outputLength - emitted.start || origin.identity == "" || input == null
        return mapping.fail("Generated origin is invalid for artifact: " + artifact.name)
      end
      if origin.start < 0 || origin.length < 1 || origin.start > input.utf16Length || origin.length > input.utf16Length - origin.start
        return mapping.fail("Generated origin exceeds its source for artifact: " + artifact.name)
      end
      emitted = emitted.nextOrigin
    end
    artifact = artifact.nextArtifact
  end
  return true
end

def dataPublishOwnedContents(mapping: DataMapping, old: DataPublishOutputs): Bool
  let opened = files::Root.open(mapping.outputPath)
  let root = opened.root

  if opened.failure != null || root == null
    return mapping.fail("Cannot inspect the existing generated output root.")
  end
  let listed = root.list("")

  root.close()
  if listed.failure != null || listed.closeFailure != null
    return mapping.fail("Cannot list the existing generated output root.")
  end
  var manifestSeen = false

  for entry in listed.entries
    if entry.name == "manifest.json"
      manifestSeen = true
      if !entry.kind.isFile()
        return mapping.fail("Existing generation manifest is not a regular file.")
      end
    else if !entry.kind.isFile() || old.find(entry.name) == null
      return mapping.fail("Existing generated output contains an unowned entry: " + entry.name)
    end
  end
  if !manifestSeen
    return mapping.fail("Existing generated output root has no ownership manifest.")
  end
  return true
end

def dataPublishEmptyRoot(mapping: DataMapping): Bool
  let opened = files::Root.open(mapping.outputPath)
  let root = opened.root

  if opened.failure != null || root == null
    return mapping.fail("Cannot inspect the existing generated output root.")
  end
  let listed = root.list("")

  root.close()
  if listed.failure != null || listed.closeFailure != null
    return mapping.fail("Cannot list the existing generated output root.")
  end
  if listed.entries.Length != 0
    return mapping.fail("Existing generated output root has no ownership manifest.")
  end
  return true
end

def dataPublishOldOutputs(mapping: DataMapping): DataPublishOutputs?
  let manifestPath = mapping.outputPath + "/manifest.json"
  let statusResult = files::status(manifestPath)

  if statusResult.failure != null
    mapping.fail("Cannot inspect the previous generation manifest.")
    return null
  end
  let manifestStatus = statusResult.status

  if manifestStatus == null || !manifestStatus.exists
    dataPublishEmptyRoot(mapping)
    return null
  end
  if !manifestStatus.kind.isFile() || manifestStatus.symlink
    mapping.fail("Previous generation manifest is not a regular file.")
    return null
  end
  let text = host::readText(manifestPath)

  if text == null
    mapping.fail("Cannot read the previous generation manifest.")
    return null
  end
  let parser = new LspJsonParser(text)
  let document = parser.parse()

  parser.spaces()
  if parser.failed || parser.position != host::stringByteLength(text) || !dataObject(mapping, document, "existing generation manifest", ["version", "generator", "generatorVersion", "inputs", "outputs", "origins"]) || !document.get("version").isNumber() || document.get("version").scalarText() != "1" || !document.get("generator").isString() || document.get("generator").scalarText() != "neri-data" || !document.get("generatorVersion").isString() || !document.get("inputs").isArray() || !document.get("origins").isArray()
    mapping.fail("Existing output is not owned by a valid neri-data manifest.")
    return null
  end
  if document.get("generatorVersion").scalarText() != "2"
    mapping.fail("Existing neri-data output uses an unsupported generator version.")
    return null
  end
  let outputs = document.get("outputs")

  if !outputs.isArray()
    mapping.fail("Existing neri-data manifest has invalid outputs.")
    return null
  end
  let old = new DataPublishOutputs()
  var entry = outputs.first

  while entry != null
    let path = entry.get("path")
    let digest = entry.get("sha256")

    if !dataObject(mapping, entry, "existing generation output", ["path", "sha256"]) || !path.isString() || !digest.isString() || !neriGenerationDigest(digest) || !neriRelativeProjectPath(path.scalarText()) || !semanticEndsWith(path.scalarText(), ".hk")
      mapping.fail("Existing neri-data manifest has an invalid output path.")
      return null
    end
    let absolute = mapping.projectRoot + "/" + path.scalarText()
    let relative = dataRelativePath(mapping.outputPath, absolute)
    let filename = host::pathFileName(absolute)

    if !dataPathWithin(mapping.outputPath, absolute) || filename == null || !dataArtifactName(filename) || bootstrapDirectory(absolute) != mapping.outputPath
      mapping.fail("Existing neri-data manifest does not own its declared output.")
      return null
    end
    if old.find(relative) != null
      mapping.fail("Existing neri-data manifest declares an output more than once: " + path.scalarText())
      return null
    end
    if old.findIdentifier(relative) != null
      mapping.fail("Existing neri-data manifest declares case-conflicting outputs: " + path.scalarText())
      return null
    end
    let outputStatus = files::status(absolute)
    let priorStatus = outputStatus.status

    if outputStatus.failure != null || priorStatus == null || (priorStatus.exists && (!priorStatus.kind.isFile() || priorStatus.symlink))
      mapping.fail("Existing neri-data output is not a regular file: " + path.scalarText())
      return null
    end
    if !old.add(relative)
      mapping.fail("Existing neri-data manifest declares a case-conflicting output: " + path.scalarText())
      return null
    end
    entry = entry.next
  end
  if old.first == null || !dataPublishOwnedContents(mapping, old)
    mapping.fail("Existing neri-data manifest has no owned outputs.") if old.first == null
    return null
  end
  return old
end

def dataPublishStagingContainsOnly(directory: String, artifactNames: StringTable<DataArtifact>): Bool
  let opened = files::Root.open(directory)

  if opened.failure != null
    return false
  end
  let root = opened.root

  if root == null
    return false
  end
  let listed = root.list("")

  root.close()
  if listed.failure != null || listed.closeFailure != null
    return false
  end
  for entry in listed.entries
    let known = entry.name == "manifest.json" || artifactNames.find(entry.name) != null

    if !known || !entry.kind.isFile()
      return false
    end
  end
  return true
end

def dataPublishWriteArtifact(directory: String, artifact: DataArtifact): Bool
  let path = directory + "/" + artifact.name

  if !host::writeText(path, artifact.text)
    return false
  end
  let written = host::readText(path)

  if written == null || written != artifact.text
    return false
  end
  return true
end

def dataPublishVerifyStaging(mapping: DataMapping, emission: DataEmission, artifactNames: StringTable<DataArtifact>, manifest: String, directory: String): Bool
  if !dataPublishStagingContainsOnly(directory, artifactNames) || host::readText(directory + "/manifest.json") != manifest
    return mapping.fail("Generated staging root changed before publication.")
  end
  var artifact = emission.firstArtifact

  while artifact != null
    let value = host::readText(directory + "/" + artifact.name)

    if value == null || value != artifact.text
      return mapping.fail("Generated revision changed before publication: " + artifact.name)
    end
    artifact = artifact.nextArtifact
  end
  return true
end

def dataPublishCleanupOld(directory: String, old: DataOldOutput?): Void
  var current = old

  while current != null
    let path = directory + "/" + current.relativePath
    let parent = bootstrapDirectory(path)

    files::removeFile(path)
    if parent != directory
      files::removeDirectory(parent)
    end
    current = current.next
  end
  files::removeFile(directory + "/manifest.json")
  files::removeDirectory(directory)
end

def dataPublishStaging(mapping: DataMapping, emission: DataEmission, artifactNames: StringTable<DataArtifact>, manifest: String, revision: String): String?
  let parent = bootstrapDirectory(mapping.outputPath)
  let staging = parent + "/.neri-data-" + sha256FastText(mapping.outputPath + "\n" + revision)
  let stageStatus = files::status(staging)

  if stageStatus.failure != null
    mapping.fail("Cannot inspect generation staging root.")
    return null
  end
  let status = stageStatus.status

  if status != null && status.exists
    if !status.kind.isDirectory() || status.symlink
      mapping.fail("Generation staging path is not a private directory.")
      return null
    end
    if !dataPublishStagingContainsOnly(staging, artifactNames)
      mapping.fail("Generation staging root contains unowned data.")
      return null
    end
  else if files::createDirectory(staging).failure != null
    mapping.fail("Cannot create generation staging root.")
    return null
  end
  var artifact = emission.firstArtifact

  while artifact != null
    if !dataPublishWriteArtifact(staging, artifact)
      mapping.fail("Cannot stage generated artifact: " + artifact.name)
      return null
    end
    artifact = artifact.nextArtifact
  end
  if !host::writeText(staging + "/manifest.json", manifest) || !dataPublishVerifyStaging(mapping, emission, artifactNames, manifest, staging)
    mapping.fail("Cannot stage generation manifest.") if mapping.error == ""
    return null
  end
  return staging
end

def dataPublishSame(mapping: DataMapping, emission: DataEmission, manifest: String): Bool
  if host::readText(mapping.outputPath + "/manifest.json") != manifest
    return false
  end
  var artifact = emission.firstArtifact

  while artifact != null
    if host::readText(mapping.outputPath + "/" + artifact.name) != artifact.text
      return false
    end
    artifact = artifact.nextArtifact
  end
  return true
end

def dataPublishManifest(mapping: DataMapping, emission: DataEmission, inputs: DataPublishInputs): String
  let parts = new StringBuffer()

  parts.add("{\n  \"version\": 1,\n  \"generator\": \"neri-data\",\n  \"generatorVersion\": \"2\",\n  \"inputs\": [")
  var input = inputs.first
  var separator = "\n"

  while input != null
    parts.add(separator + "    {\"path\": " + lspQuote(dataPublishInputPath(mapping, input.path)) + ", \"sha256\": \"" + input.digest + "\"}")
    separator = ",\n"
    input = input.next
  end
  parts.add("\n  ],\n  \"outputs\": [")
  var artifact = emission.firstArtifact

  separator = "\n"
  while artifact != null
    let output = mapping.outputPath + "/" + artifact.name

    parts.add(separator + "    {\"path\": " + lspQuote(dataRelativePath(mapping.projectRoot, output)) + ", \"sha256\": \"" + sha256FastText(artifact.text) + "\"}")
    separator = ",\n"
    artifact = artifact.nextArtifact
  end
  parts.add("\n  ],\n  \"origins\": [")
  artifact = emission.firstArtifact
  separator = "\n"
  while artifact != null
    var emitted = artifact.firstOrigin

    while emitted != null
      let origin = emitted.origin
      let output = mapping.outputPath + "/" + artifact.name

      parts.add(separator + "    {\"path\": " + lspQuote(dataRelativePath(mapping.projectRoot, output)) + ", \"start\": " + (emitted.start as String) + ", \"length\": " + (emitted.length as String) + ", \"source\": " + lspQuote(dataPublishInputPath(mapping, origin.sourcePath)) + ", \"sourceStart\": " + (origin.start as String) + ", \"sourceLength\": " + (origin.length as String) + ", \"identity\": " + lspQuote(origin.identity) + "}")
      separator = ",\n"
      emitted = emitted.nextOrigin
    end
    artifact = artifact.nextArtifact
  end
  parts.add("\n  ]\n}\n")
  return parts.join()
end

def dataPublishLocked(mapping: DataMapping, emission: DataEmission): Bool
  if mapping.error != ""
    return false
  end
  if emission.error != ""
    return mapping.fail(emission.error)
  end
  if emission.firstArtifact == null
    return mapping.fail("Generator produced no artifacts.")
  end
  if !dataPathWithin(mapping.projectRoot, mapping.outputPath)
    return mapping.fail("Generated output must remain within the mapped project.")
  end
  let artifactNames = new StringTable<DataArtifact>()
  let foldedArtifactNames = new StringTable<DataArtifact>()
  var artifact = emission.firstArtifact

  while artifact != null
    if !dataArtifactName(artifact.name)
      return mapping.fail("Generated artifact name must be a safe .hk basename: " + artifact.name)
    end
    let foldedName = dataPublishIdentifierKey(artifact.name)

    if foldedArtifactNames.find(foldedName) != null
      return mapping.fail("Generated artifact name is duplicated: " + artifact.name)
    end
    artifactNames.add(artifact.name, artifact)
    foldedArtifactNames.add(foldedName, artifact)
    artifact = artifact.nextArtifact
  end
  let outputStatus = files::status(mapping.outputPath)

  if outputStatus.failure != null
    return mapping.fail("Cannot inspect generated output directory.")
  end
  let status = outputStatus.status
  let existing = status != null && status.exists

  if status != null && status.exists && (!status.kind.isDirectory() || status.symlink)
    return mapping.fail("Generated output path must be a directory without symlinks.")
  end
  let inputs = dataPublishInputs(mapping)

  if inputs == null
    return false
  end
  if !dataPublishValidateOrigins(mapping, emission, inputs)
    return false
  end
  let revision = dataPublishRevision(mapping, inputs, emission)
  var oldOutputs: DataPublishOutputs? = null
  var oldManifest: String? = null

  if existing
    oldOutputs = dataPublishOldOutputs(mapping)
    if mapping.error != ""
      return false
    end
    oldManifest = host::readText(mapping.outputPath + "/manifest.json")
  end
  let manifest = dataPublishManifest(mapping, emission, inputs)

  if existing && dataPublishSame(mapping, emission, manifest)
    return dataPublishVerifyInputs(mapping, inputs)
  end
  let staging = dataPublishStaging(mapping, emission, artifactNames, manifest, revision)

  if staging == null || !dataPublishVerifyInputs(mapping, inputs) || !dataPublishVerifyStaging(mapping, emission, artifactNames, manifest, staging)
    return false
  end
  if existing
    let current = dataPublishOldOutputs(mapping)

    if mapping.error != "" || ((current == null) != (oldOutputs == null)) || host::readText(mapping.outputPath + "/manifest.json") != oldManifest
      return mapping.fail("Existing generated output changed before publication.")
    end
    let helper = host::environment("NERI_HOST")

    if helper == null || host::run(helper, ["exchange-directories", staging, mapping.outputPath]) != 0
      return mapping.fail("Cannot atomically exchange generated output directories.")
    end
    dataPublishCleanupOld(staging, oldOutputs == null ? null : oldOutputs.first)
  else
    let current = files::status(mapping.outputPath)
    let currentStatus = current.status

    if current.failure != null || currentStatus == null || currentStatus.exists
      return mapping.fail("Generated output path appeared before publication.")
    end
    if files::move(staging, mapping.outputPath).failure != null
      return mapping.fail("Cannot atomically publish generated output directory.")
    end
  end
  return true
end

def dataPublish(mapping: DataMapping, emission: DataEmission): Bool
  if mapping.error != ""
    return false
  end
  if !dataPathWithin(mapping.projectRoot, mapping.outputPath)
    return mapping.fail("Generated output must remain within the mapped project.")
  end
  let parent = bootstrapDirectory(mapping.outputPath)

  if files::createDirectory(parent, true).failure != null
    return mapping.fail("Cannot create generated output parent directory.")
  end
  let lock = parent + "/.neri-data-lock-" + sha256FastText(mapping.outputPath)

  if files::createDirectory(lock).failure != null
    return mapping.fail("Generated output is locked by another publication or a stale lock: " + lock)
  end
  let published = dataPublishLocked(mapping, emission)

  if files::removeDirectory(lock).failure != null
    return mapping.fail((published ? "Generation was published, but its publication lock could not be released: " : "Cannot release generated output publication lock: ") + lock)
  end
  return published
end
