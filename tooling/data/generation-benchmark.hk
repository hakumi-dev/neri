use clock
use console
use files
use host

def dataScaleNow(): Int
  let value = clock::milliseconds()

  if value != null
    return value
  end
  return 0
end

def dataScaleEntities(count: Int): String
  var result = "namespace scale_model\n"
  var index = 0

  while index < count
    result = result + "\nclass Entity" + (index as String) + "\n  public id: Int\n  public name: String\n  public active: Bool\n  public nickname: String?\n\n  def init(id: Int, name: String, active: Bool, nickname: String?): Void\n    this.id = id\n    this.name = name\n    this.active = active\n    this.nickname = nickname\n  end\nend\n"
    index = index + 1
  end
  return result
end

def dataScaleMapping(count: Int): String
  var result = "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"scale_data\",\"context\":\"ScaleDatabase\",\"output\":\"generated\",\"entities\":["
  var index = 0

  while index < count
    result = result + (index == 0 ? "" : ",") + "{\"type\":\"scale_model.Entity" + (index as String) + "\",\"set\":\"entities" + (index as String) + "\",\"table\":\"entities_" + (index as String) + "\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"active\",\"column\":\"active\"},{\"member\":\"nickname\",\"column\":\"nickname\"}]}"
    index = index + 1
  end
  return result + "]}\n"
end

def dataScaleProject(root: String, directory: String): String
  let runtimeProject = dataRelativePath(directory, root + "/experiments/neri-data/manifest.json")

  return "{\"version\":2,\"defaultUnit\":\"data\",\"units\":{\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]},\"data\":{\"kind\":\"library\",\"sources\":[\"bridge.hk\"],\"generated\":[\"generated/manifest.json\"],\"references\":[\"entities\",{\"project\":" + lspQuote(runtimeProject) + ",\"unit\":\"runtime\"}]}}}\n"
end

def dataScaleBind(project: String): DataMapping
  let binding = new DataMapping()

  binding.projectPath = project
  binding.unit = "data"
  dataBindProject(binding)
  return binding
end

def dataScaleBytes(emission: DataEmission): Int
  var result = 0
  var artifact = emission.firstArtifact

  while artifact != null
    result = result + host::stringByteLength(artifact.text)
    artifact = artifact.nextArtifact
  end
  return result
end

def dataScaleGenericInventory(model: SemanticModel, count: Int, enabled: Bool): Void
  if !enabled || (count != 2 && count != 8)
    return
  end
  var symbol = model.firstClass

  while symbol != null
    if symbol.genericOrigin >= 0
      console::println("generic-inventory," + (count as String) + ",class," + symbol.fullName)
    end
    symbol = symbol.nextClass
  end
  var callable = model.firstFunction

  while callable != null
    if callable.genericOrigin >= 0
      console::println("generic-inventory," + (count as String) + ",function," + callable.fullName)
    end
    callable = callable.nextCallable
  end
end

def dataScaleNative(compiler: String, project: String, directory: String): Int
  let status = host::run(
    compiler,
    ["check", "--project", project, "--unit", "data", "--emit=obj", "--output", directory + "/data.o"]
  )

  if status != null
    return status
  end
  return -2
end

def dataScaleCase(root: String, compiler: String, parent: String, count: Int, inventory: Bool): Void
  let directory = parent + "/case-" + (count as String)

  if files::createDirectory(directory + "/generated", true).failure != null
    console::println("cannot create benchmark case")
    return
  end
  let entities = dataScaleEntities(count)

  host::writeText(directory + "/entities.hk", entities)
  host::writeText(directory + "/bridge.hk", "namespace scale_data\n")
  host::writeText(directory + "/mapping.json", dataScaleMapping(count))
  host::writeText(directory + "/manifest.json", dataScaleProject(root, directory))
  let generationStarted = dataScaleNow()
  let mapping = dataLoadMapping(directory + "/mapping.json")
  let emission = dataEmit(mapping)
  let generationElapsed = dataScaleNow() - generationStarted
  var published = false

  if mapping.error == "" && emission.error == ""
    published = dataPublish(mapping, emission)
  end
  let bindingStarted = dataScaleNow()
  let binding = published ? dataScaleBind(directory + "/manifest.json") : new DataMapping()
  let bindingElapsed = dataScaleNow() - bindingStarted
  let model = binding.semantic
  var genericInstances = -1

  if model != null
    genericInstances = model.genericInstances
    dataScaleGenericInventory(model, count, inventory)
  end
  let diagnosticCount = model != null ? model.diagnostics.count() : -1
  let firstCode = model != null && diagnosticCount > 0 ? model.diagnostics.codes.get(0) : ""
  let nativeStatus = published ? dataScaleNative(compiler, directory + "/manifest.json", directory) : -3

  console::println("{\"entities\":" + (count as String) + ",\"generatedBytes\":" + (dataScaleBytes(emission) as String) + ",\"genericInstances\":" + (genericInstances as String) + ",\"diagnostics\":" + (diagnosticCount as String) + ",\"firstCode\":" + lspQuote(firstCode) + ",\"generationMs\":" + (generationElapsed as String) + ",\"bindingMs\":" + (bindingElapsed as String) + ",\"nativeStatus\":" + (nativeStatus as String) + ",\"mappingError\":" + lspQuote(mapping.error) + ",\"emissionError\":" + lspQuote(emission.error) + ",\"bindingError\":" + lspQuote(binding.error) + "}")
end

def main(): Void
  let root = host::argumentAt(0)
  let compiler = host::argumentAt(1)
  let inventoryArgument = host::argumentAt(2)
  var inventory = false

  if inventoryArgument != null
    inventory = inventoryArgument == "--inventory"
  end

  if root == null || compiler == null
    console::println("usage: generation-benchmark <repository-root> <compiler> [--inventory]")
    host::exit(2)
    return
  end
  let standardLibrary = host::environment("NERI_STDLIB")

  if standardLibrary == null
    console::println("NERI_STDLIB is required")
    host::exit(2)
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "data-generation-scale")

  if temporary == null
    console::println("cannot create benchmark workspace")
    host::exit(2)
    return
  end
  for count in [2, 3, 4, 8, 16, 32, 33]
    dataScaleCase(root, compiler, temporary, count, inventory)
  end
  files::removeTree(temporary)
end
