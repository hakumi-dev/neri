def dataSynthesizeJoin(
  mapping: DataMapping,
  node: LspJson,
  name: String,
  left: DataEntity?,
  right: DataEntity?,
  context: String
): DataEntity?
  if left == null || right == null || left.keyless || right.keyless || !dataIdentifier(name)
    mapping.fail(context + " implicit joins require keyed endpoints and a valid navigation name.")
    return null
  end
  if !node.get("leftForeignKey").isMissing() || !node.get("rightForeignKey").isMissing()
    mapping.fail(context + " implicit join keys are synthesized from endpoint primary keys.")
    return null
  end
  let join = new DataEntity()

  join.syntheticJoin = true
  join.generatedName = "SkipJoin_" + name
  join.typeName = mapping.namespaceName + "." + join.generatedName
  join.setName = "skipJoins_" + name
  join.tableName = dataString(mapping, node, "joinTable", context)
  let semantic = mapping.semantic

  if !dataSqlIdentifier(join.tableName) || dataSqlReserved(join.tableName) || (semantic != null && dataFindClass(
      semantic,
      join.typeName
    ) != null)
    mapping.fail(context + " implicit join requires an unreserved table and generated class name.")
    return null
  end
  var existing = mapping.firstEntity

  while existing != null
    if existing.typeName == join.typeName || existing.generatedName == join.generatedName || existing.setName == join.setName || dataSqlSameIdentifier(
      existing.tableName,
      join.tableName
    )
      mapping.fail(context + " synthesized join type, query set, or table collides with an existing mapping.")
      return null
    end
    existing = existing.nextEntity
  end
  if !dataSynthesizeJoinRelation(
    mapping,
    left,
    join,
    "left"
  ) || !dataSynthesizeJoinRelation(
    mapping,
    right,
    join,
    "right"
  )
    return null
  end
  join.keyMember = join.keyMembers.get(0)
  mapping.addEntity(join)
  return join
end

def dataSynthesizeJoinRelation(mapping: DataMapping, endpoint: DataEntity, join: DataEntity, side: String): Bool
  let relation = new DataRelation()

  relation.implicitJoin = true
  relation.principalType = endpoint.typeName
  relation.dependentType = join.typeName
  relation.principal = endpoint
  relation.dependent = join
  relation.keyMembers = endpoint.keyMembers
  relation.keyMember = endpoint.keyMember
  relation.collectionMember = "implicit_" + join.generatedName + "_" + side
  relation.referenceMember = side
  relation.deleteBehavior = "clientCascade"
  var position = 0

  while position < endpoint.keyMembers.size
    let key = endpoint.field(endpoint.keyMembers.get(position))

    if key == null
      return mapping.fail("Implicit join endpoint primary key is missing from mapped columns.")
    end
    let field = dataCopyField(key)

    field.memberName = side + "_" + (position as String)
    field.columnName = field.memberName
    field.schemaIdentity = join.typeName + "." + field.memberName
    field.pathCode = ""
    field.getter = ""
    field.setter = ""
    join.addField(field)
    join.keyMembers.add(field.memberName)
    relation.foreignKeyMembers.add(field.memberName)
    position = position + 1
  end
  relation.foreignKeyMember = relation.foreignKeyMembers.get(0)
  relation.key = endpoint.field(endpoint.keyMember)
  relation.foreignKey = join.field(relation.foreignKeyMember)
  mapping.addRelation(relation)
  return true
end
