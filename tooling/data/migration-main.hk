use console
use files
use host
use neri_data

def main(): Void
  let mappingPath = host::argumentAt(0)
  let historicalPath = host::argumentAt(1)
  let id = host::argumentAt(2)
  let outputArgument = host::argumentAt(3)

  if host::argumentCount() != 4 || mappingPath == null || historicalPath == null || id == null || outputArgument == null
    console::println("usage: neri-data-migration <mapping.json> <before.snapshot.json|empty> <id> <output-directory>")
    host::exit(2)
    return
  end
  let mapping = dataLoadMapping(mappingPath)

  if mapping.error != ""
    console::println(mapping.error)
    host::exit(1)
    return
  end
  if !dataIdentifier(id)
    console::println("migration id must be one Neri identifier")
    host::exit(2)
    return
  end
  let before = dataMigrationHistorical(mapping, historicalPath)
  let model = before.model

  if before.error != "" || model == null
    console::println(before.error != "" ? before.error : "historical snapshot is missing")
    host::exit(1)
    return
  end
  let draft = dataMigrationPrepare(mapping, model, id)

  if draft.error != ""
    console::println(draft.error)
    host::exit(1)
    return
  end
  if draft.unchanged
    console::println("Schema is unchanged; no migration was written")
    return
  end
  draft.historicalPath = before.sourcePath
  draft.historicalSnapshotText = before.sourceText
  draft.historicalMarkerText = before.markerText
  if !bootstrapStartsWith(outputArgument, "/") && !neriRelativeProjectPath(outputArgument)
    console::println("output directory must be an absolute path or a safe mapping-root-relative path")
    host::exit(2)
    return
  end
  let output = bootstrapStartsWith(outputArgument, "/") ? outputArgument : mapping.mappingRoot + "/" + outputArgument

  if !dataMigrationPublish(mapping, draft, output)
    console::println(mapping.error)
    host::exit(1)
    return
  end
  console::println("Migration scaffold written at " + output)
  console::println("Data loss: up=" + (draft.upDataLoss ? "true" : "false") + ", down=" + (draft.downDataLoss ? "true" : "false"))
end
