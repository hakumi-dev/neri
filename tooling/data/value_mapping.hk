## Validates explicit model-to-storage codecs against their public callable contracts.
def dataTextScalarFamily(typeName: String): String
  if typeName == "String[]"
    return "Strings"
  else if typeName == "Int[]"
    return "Ints"
  else if typeName == "Bool[]"
    return "Bools"
  end
  for family in ["Guid", "DateOnly", "TimeOnly", "DateTime", "DateTimeOffset", "JsonDocument", "TimeSpan"]
    if typeName == family || typeName == "neri_data." + family
      return family
    end
  end
  return ""
end

def dataNormalizeDateTimeOffsetField(field: DataField): Void
  if dataTextScalarFamily(field.optional ? semanticInnerType(field.typeName) : field.typeName) == "DateTimeOffset" && (field.conversionEncode == "neri_data.cellDateTimeOffset" || field.conversionEncode == "neri_data.cellOptionalDateTimeOffset")
    field.conversionEncode = "neri_data.cell" + (field.optional ? "Optional" : "") + "DateTimeOffsetKey"
    field.conversionDecode = "neri_data.decode" + (field.optional ? "Nullable" : "") + "DateTimeOffsetKey"
  end
end

def dataNormalizeEntityDateTimeOffsetKeys(entity: DataEntity): Void
  var field = entity.firstField

  while field != null
    var key = entity.isKeyMember(field.memberName)
    var index = entity.firstIndex

    while index != null
      if index.unique && index.predicate == "" && index.expressions.size == 0
        var position = 0

        while position < index.fields.size
          key = true if index.fields.get(position) == dataFieldIdentity(field)
          position = position + 1
        end
      end
      index = index.nextIndex
    end
    dataNormalizeDateTimeOffsetField(field) if key
    field = field.nextField
  end
end

def dataNormalizeDateTimeOffsetKeys(mapping: DataMapping): Void
  var entity = mapping.firstEntity

  while entity != null
    dataNormalizeEntityDateTimeOffsetKeys(entity)
    var derived = entity.firstDerived

    while derived != null
      dataNormalizeEntityDateTimeOffsetKeys(derived.entity)
      derived = derived.nextDerived
    end
    entity = entity.nextEntity
  end
  var relation = mapping.firstRelation

  while relation != null
    let dependent = relation.dependent

    if dependent != null
      var position = 0

      while position < relation.foreignKeyMembers.size
        let field = dependent.field(relation.foreignKeyMembers.get(position))

        dataNormalizeDateTimeOffsetField(field) if field != null
        position = position + 1
      end
    end
    relation = relation.nextRelation
  end
  entity = mapping.firstEntity
  while entity != null
    var derived = entity.firstDerived

    while derived != null
      var field = derived.entity.firstField

      while field != null
        let rootField = entity.field(field.memberName)

        if rootField != null && (rootField.conversionEncode == "neri_data.cellDateTimeOffsetKey" || rootField.conversionEncode == "neri_data.cellOptionalDateTimeOffsetKey")
          dataNormalizeDateTimeOffsetField(field)
        end
        field = field.nextField
      end
      derived = derived.nextDerived
    end
    entity = entity.nextEntity
  end
end

def dataConversionFunction(
  mapping: DataMapping,
  node: LspJson,
  key: String,
  resultType: String,
  arguments: String[],
  context: String
): String
  let name = dataString(mapping, node, key, context)
  let semantic = mapping.semantic

  if semantic == null || !dataIdentifier(name, true)
    mapping.fail(context + "." + key + " requires a qualified accessible function.")
    return ""
  end
  let function = semantic.findFunction(name)

  if function == null || (!function.access.isPublic() && !function.access.isInternal()) || function.returnType != resultType || function.parameterCount != arguments.Length
    mapping.fail(context + "." + key + " has an incompatible conversion signature.")
    return ""
  end
  var parameter = function.firstParameter
  var index = 0

  while parameter != null
    if parameter.typeName != arguments[index]
      mapping.fail(context + "." + key + " has an incompatible conversion parameter.")
      return ""
    end
    index = index + 1
    parameter = parameter.nextParameter
  end
  return function.fullName
end

def dataParseValueConversion(mapping: DataMapping, field: DataField, node: LspJson, context: String): Bool
  if !dataObject(mapping, node, context, ["storageType", "encode", "decode", "initial"])
    return false
  end
  let storage = dataString(mapping, node, "storageType", context)

  field.conversionStorageType = storage

  if semanticIsOptional(storage) != field.optional
    return mapping.fail(context + ".storageType must share the model field's nullability.")
  end
  field.conversionEncode = dataConversionFunction(mapping, node, "encode", "neri_data.Cell", [field.typeName], context)
  field.conversionDecode = dataConversionFunction(
    mapping,
    node,
    "decode",
    "neri_data.DecodeResult<" + field.typeName + ">",
    ["neri_data.RawRow", "String"],
    context
  )
  field.conversionInitial = dataConversionFunction(mapping, node, "initial", field.typeName, [], context)
  return mapping.error == ""
end
