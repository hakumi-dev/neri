class DataMigrationCatalog
  public path: String = ""
  public entries: DataMigrationEntry[] = []
  public error: String = ""

  def fail(message: String): Void
    this.error = message if this.error == ""
  end

  def model(): neri_data::SchemaModel?
    return this.entries.Length == 0 ? new neri_data::SchemaModel([]) : this.entries[this.entries.Length - 1].snapshot.model
  end

  def migrations(): neri_data::MigrationSet
    let values: neri_data::Migration[] = arrays::generate(this.entries.Length) do |index|
      let value = this.entries[index].migration

      return value == null ? new neri_data::Migration("", [], []) : value
    end

    return new neri_data::MigrationSet(values)
  end
end
