use host

class DataArtifact
  public name: String = ""
  public text: String = ""
  public firstOrigin: DataEmittedOrigin?
  public nextArtifact: DataArtifact?
  private pieces: StringBuffer = new StringBuffer()
  private position: Int = 0

  def write(text: String, origin: DataOrigin? = null): Void
    let length = (new IrSourceMap(text)).utf16Length()

    if origin != null && origin.identity != "" && length > 0
      let emitted = new DataEmittedOrigin()

      emitted.start = this.position
      emitted.length = length
      emitted.origin = origin
      emitted.nextOrigin = this.firstOrigin
      this.firstOrigin = emitted
    end
    this.pieces.add(text)
    this.position = this.position + length
  end

  def finish(): Void
    this.text = this.pieces.join()
  end

  def format(options: NeriCodeStyleOptions): String
    let result = neriCodeStyleAnalyzeText(this.text, options)
    let applied = neriCodeStyleApplyChecked(this.text, result.edits)

    if !applied.valid
      return "Generated artifact '" + this.name + "': " + applied.error
    end
    var origin = this.firstOrigin

    while origin != null
      let start = origin.start
      let finish = start + origin.length
      var edit = result.edits

      while edit != null
        let editFinish = edit.start + edit.length

        if (edit.start < start && editFinish > start) || (edit.start < finish && editFinish > finish)
          return "Generated code formatting crosses a source origin boundary."
        end
        edit = edit.next
      end
      origin = origin.nextOrigin
    end
    origin = this.firstOrigin
    while origin != null
      let start = origin.start
      let finish = start + origin.length
      var shiftedStart = start
      var shiftedFinish = finish
      var edit = result.edits

      while edit != null
        let editFinish = edit.start + edit.length
        let delta = (new IrSourceMap(edit.replacement)).utf16Length() - edit.length

        shiftedStart = shiftedStart + delta if editFinish <= start
        shiftedFinish = shiftedFinish + delta if editFinish < finish || (edit.length > 0 && editFinish == finish)
        edit = edit.next
      end
      origin.start = shiftedStart
      origin.length = shiftedFinish - shiftedStart
      origin = origin.nextOrigin
    end
    this.text = applied.text
    return ""
  end

end
