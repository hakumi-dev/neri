class DataMany
  public name: String
  public left: DataEntity
  public right: DataEntity
  public join: DataEntity
  public leftRelation: DataRelation
  public rightRelation: DataRelation
  public leftCollection: String = ""
  public rightCollection: String = ""
  public nextMany: DataMany?

  def init(
    name: String,
    left: DataEntity,
    join: DataEntity,
    right: DataEntity,
    leftRelation: DataRelation,
    rightRelation: DataRelation
  ): Void
    this.name = name
    this.left = left
    this.join = join
    this.right = right
    this.leftRelation = leftRelation
    this.rightRelation = rightRelation
  end
end
