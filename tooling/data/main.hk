
def main(): Void
  let first = host::argumentAt(0)
  var path = first
  var check = false
  var valid = host::argumentCount() == 1

  if first == "--check" || first == "--ensure"
    check = first == "--check"
    path = host::argumentAt(1)
    valid = host::argumentCount() == 2
  end
  if !valid || path == null || path == ""
    console::println("usage: neri-data-generate [--check | --ensure] <mapping.json>")
    host::exit(2)
    return
  end
  let mapping = dataLoadMapping(path)

  if mapping.error != ""
    console::println(mapping.error)
    host::exit(1)
    return
  end
  let emission = dataEmit(mapping)

  if check
    if !dataGenerationCurrent(mapping, emission)
      let error = emission.error != "" ? emission.error : mapping.error

      console::println(error != "" ? error : "Generated Data sources are missing or stale: " + mapping.outputPath)
      host::exit(1)
      return
    end
    console::println("Generated Data sources are current: " + mapping.outputPath)
    return
  end
  if emission.error != "" || !dataPublish(mapping, emission)
    console::println(emission.error != "" ? emission.error : mapping.error)
    host::exit(1)
    return
  end
  console::println("Generated " + mapping.contextName + " at " + mapping.outputPath)
end
