use console
use host

def main(): Void
  let path = host.argumentAt(0)

  if host.argumentCount() != 1 || path == null
    console.println("usage: neri-data-generate <mapping.json>")
    host.exit(2)
    return
  end
  let mapping = dataLoadMapping(path)

  if mapping.error != ""
    console.println(mapping.error)
    host.exit(1)
    return
  end
  let emission = dataEmit(mapping)

  if emission.error != "" || !dataPublish(mapping, emission)
    console.println(emission.error != "" ? emission.error : mapping.error)
    host.exit(1)
    return
  end
  console.println("Generated " + mapping.contextName + " at " + mapping.outputPath)
end
