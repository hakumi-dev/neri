def dataJsonScalar(typeName: String): DataField?
  let domain = dataTypeDomain(typeName)

  if domain == null
    return null
  end
  let family = dataTextScalarFamily(semanticIsOptional(typeName) ? semanticInnerType(typeName) : typeName)
  let kind = dataScalarName(domain)

  if family == "" && kind != "Int" && kind != "Bool" && kind != "String" && kind != "Float"
    return null
  end
  let field = new DataField(domain)

  field.typeName = typeName
  field.optional = semanticIsOptional(typeName)
  if family != ""
    field.conversionEncode = "neri_data.cell" + (field.optional ? "Optional" : "") + family
    field.conversionDecode = "neri_data.decode" + (field.optional ? "Nullable" : "") + family
    field.conversionInitial = "neri_data.initial" + family if !field.optional
  end
  return field
end

def dataJsonClass(model: SemanticModel, typeName: String): SemanticClass?
  return dataFindClass(model, semanticIsOptional(typeName) ? semanticInnerType(typeName) : typeName)
end

def dataJsonClassFields(model: SemanticModel, symbol: SemanticClass): SemanticField[]?
  let owners = new ValueBuffer<SemanticClass>(symbol)
  var owner: SemanticClass? = symbol

  while owner != null
    owners.add(owner)
    owner = owner.baseName == "" ? null : model.findClass(owner.baseName)
  end
  let fields = new ValueBuffer<SemanticField?>(null)
  var position = owners.size - 1

  while position >= 0
    var field = owners.get(position).firstField

    while field != null
      if fields.size == 256
        return null
      end
      fields.add(field)
      field = field.nextField
    end
    position = position - 1
  end
  let first = fields.get(0)

  if first == null
    let empty: SemanticField[] = []

    return empty
  end
  return arrays::generate<SemanticField>(fields.size) do |index|
    let field = fields.get(index)

    return field == null ? first : field
  end
end

def dataJsonZeroArgumentConstruction(model: SemanticModel, symbol: SemanticClass): Bool
  var owner: SemanticClass? = symbol
  var depth = 0

  while owner != null && depth <= 256
    var method = owner.firstMethod

    while method != null
      if method.name == "init"
        var parameter = method.firstParameter

        while parameter != null
          if !parameter.hasDefault
            return false
          end
          parameter = parameter.nextParameter
        end
        return method.access.isPublic() && !method.isUnsafe
      end
      method = method.nextCallable
    end
    owner = owner.baseName == "" ? null : model.findClass(owner.baseName)
    depth = depth + 1
  end
  return true
end

def dataValidateJsonClass(mapping: DataMapping, symbol: SemanticClass, ancestors: String, depth: Int): Bool
  if depth > 16 || dataJsonContains(
    ancestors,
    "|" + symbol.fullName + "|"
  ) || symbol.isAbstract || symbol.isResource
    return mapping.fail("Complex JSON requires an acyclic tree of concrete, non-resource classes with depth at most 16.")
  end
  let model = mapping.semantic

  if model == null
    return mapping.fail("Complex JSON requires a bound class model.")
  end
  if !dataJsonZeroArgumentConstruction(model, symbol)
    return mapping.fail("Complex JSON type '" + symbol.fullName + "' requires accessible zero-argument construction.")
  end
  let fields = dataJsonClassFields(model, symbol)

  if fields == null
    return mapping.fail("Complex JSON requires at most 256 public fields per object.")
  end
  for member in fields
    if !member.access.isPublic()
      return mapping.fail("Complex JSON field '" + member.owner + "." + member.name + "' must be public.")
    end
    if dataJsonScalar(member.typeName) == null
      let nested = dataJsonClass(model, member.typeName)

      if nested == null || !dataValidateJsonClass(mapping, nested, ancestors + "|" + symbol.fullName + "|", depth + 1)
        return mapping.fail("Complex JSON field '" + symbol.fullName + "." + member.name + "' requires a supported scalar or constructible complex class.")
      end
    end
  end
  return true
end

def dataJsonContains(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    if host::stringSlice(text, offset, host::stringByteLength(part)) == part
      return true
    end
    offset = offset + 1
  end
  return false
end

def dataParseJsonModel(mapping: DataMapping, entity: DataEntity, field: DataField): Bool
  let model = mapping.semantic
  let symbol = model == null ? null : dataJsonClass(model, field.typeName)

  if symbol == null || !dataValidateJsonClass(mapping, symbol, "", 1)
    return mapping.fail("Mapped JSON member requires a validated complex class.")
  end
  field.jsonSymbol = symbol
  field.jsonPrefix = "json_" + entity.generatedName + "_" + field.columnName
  field.conversionStorageType = "String" + (field.optional ? "?" : "")
  field.conversionEncode = mapping.namespaceName + ".encode_" + field.jsonPrefix
  field.conversionDecode = mapping.namespaceName + ".decode_" + field.jsonPrefix
  field.conversionInitial = mapping.namespaceName + ".initial_" + field.jsonPrefix if !field.optional
  return true
end
