class DataPublishInputs
  public first: DataPublishInput?
  private last: DataPublishInput?
  private byPath: StringTable<DataPublishInput> = new StringTable<DataPublishInput>()

  def add(path: String, value: String): DataPublishInput
    let found = this.byPath.find(path)

    if found != null
      return found.value
    end
    let input = new DataPublishInput()

    input.path = path
    input.text = value
    input.digest = sha256FastText(value)
    input.utf16Length = (new IrSourceMap(value)).utf16Length()
    let last = this.last

    if last == null
      this.first = input
    else
      last.next = input
    end
    this.last = input
    this.byPath.add(path, input)
    return input
  end

  def find(path: String): DataPublishInput?
    let found = this.byPath.find(path)

    if found == null
      return null
    end
    return found.value
  end
end
