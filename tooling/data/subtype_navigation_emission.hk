def dataNavigationQueryField(entity: DataEntity): String
  return entity.hierarchyParent == null ? entity.setName : "navigationQuery_" + entity.generatedName
end

def dataNavigationRoot(entity: DataEntity): DataEntity
  var root = entity
  var parent = root.hierarchyParent

  while parent != null
    root = parent
    parent = root.hierarchyParent
  end
  return root
end

def dataSubtypeRelation(principal: DataEntity, dependent: DataEntity): Bool
  return principal.hierarchyParent != null || dependent.hierarchyParent != null
end

def dataSubtypeRelationshipCallback(entity: DataEntity, callback: String, writer: Bool = false): String
  if entity.hierarchyParent == null
    return callback
  end
  let bridge = writer ? "hierarchyRelationshipWrite" : "hierarchyRelationshipRead"

  return "neri_data::" + bridge + "<" + semanticNamespaceDisplay(dataNavigationRoot(entity).typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(downcast_" + entity.generatedName + ", " + callback + ")"
end

def dataSubtypeRelationshipScope(entity: DataEntity): String
  if entity.hierarchyParent == null
    return ""
  end
  return ", dependentScope: neri_data::hierarchyRelationshipApplies<" + semanticNamespaceDisplay(dataNavigationRoot(entity).typeName) + ", " + semanticNamespaceDisplay(entity.typeName) + ">(downcast_" + entity.generatedName + ")"
end

def dataEmitNavigationUpcast(output: DataArtifact, entity: DataEntity, name: String): String
  if entity.hierarchyParent != null
    return "upcast_" + entity.generatedName
  end
  let typeName = semanticNamespaceDisplay(entity.typeName)

  output.write("    let " + name + ": fn(" + typeName + "): " + typeName + " = fn(value: " + typeName + "): " + typeName + " do\n      return value\n    end\n")
  return name
end

def dataEmitGraphApplicable(output: DataArtifact, entity: DataEntity, name: String): String
  if entity.hierarchyParent == null
    return "entity"
  end
  output.write("    let " + name + " = downcast_" + entity.generatedName + "(entity)\n\n    if " + name + " != null\n")
  return name
end

def dataEmitSubtypeRelationWrites(
  output: DataArtifact, relation: DataRelation, principal: DataEntity, dependent: DataEntity, foreignKey: DataField
): Void
  let p = semanticNamespaceDisplay(principal.typeName)
  let d = semanticNamespaceDisplay(dependent.typeName)
  let rootP = dataNavigationRoot(principal).setName
  let rootD = dataNavigationRoot(dependent).setName
  let edge = dataRelationEdgeFactoryName(relation, principal, dependent, foreignKey)

  for reassign in [false, true]
    let name = reassign ? dataRelationReassignName(
      relation,
      principal,
      dependent,
      foreignKey
    ) : dataRelationLinkName(
      relation,
      principal,
      dependent,
      foreignKey
    )
    let change = reassign ? "reassignRelation" : "registerRelation"

    output.write("\n  public def " + name + "(principal: " + p + ", dependent: " + d + "): neri_data::QueryFailure?\n    match this." + rootP + ".handle(principal)\n      case neri_data::TrackHandleResult.Failure(error)\n        return error\n      case neri_data::TrackHandleResult.Tracked(parent)\n        match this." + rootD + ".handle(dependent)\n          case neri_data::TrackHandleResult.Failure(error)\n            return error\n          case neri_data::TrackHandleResult.Tracked(child)\n            return this.changes." + change + "(" + edge + "(parent, child))\n        end\n    end\n  end\n")
  end
  if foreignKey.optional || relation.deleteBehavior == "clientCascade"
    let name = dataRelationUnlinkName(relation, principal, dependent, foreignKey)
    let slot = lspQuote(dataRelationSlotName(relation, dependent, foreignKey))

    output.write("\n  public def " + name + "(dependent: " + d + "): neri_data::QueryFailure?\n    match this." + rootD + ".handle(dependent)\n      case neri_data::TrackHandleResult.Failure(error)\n        return error\n      case neri_data::TrackHandleResult.Tracked(child)\n        return neri_data::unlinkRelation(this.changes, child, " + slot + ")\n    end\n  end\n")
  end
end

def dataUsesSubtypeNavigation(mapping: DataMapping, entity: DataEntity): Bool
  var relation = mapping.firstRelation

  while relation != null
    if relation.principalType == entity.typeName || relation.dependentType == entity.typeName
      return true
    end
    relation = relation.nextRelation
  end
  return false
end

def dataEmitSubtypeNavigationShape(output: DataArtifact, mapping: DataMapping, root: DataEntity): Void
  var derived = root.firstDerived

  while derived != null
    let child = derived.entity

    if dataUsesSubtypeNavigation(mapping, child)
      dataEmitFilterFields(output, child)
    end
    derived = derived.nextDerived
  end
end

def dataEmitSubtypeNavigationFields(output: DataArtifact, mapping: DataMapping, root: DataEntity): Void
  var derived = root.firstDerived

  while derived != null
    let child = derived.entity

    if dataUsesSubtypeNavigation(mapping, child)
      output.write("  private " + dataNavigationQueryField(child) + ": " + dataMappedQueryType(child) + "\n")
    end
    derived = derived.nextDerived
  end
end

def dataEmitSubtypeNavigationInit(output: DataArtifact, mapping: DataMapping, root: DataEntity): Void
  var derived = root.firstDerived

  while derived != null
    let child = derived.entity

    if dataUsesSubtypeNavigation(mapping, child)
      output.write("    this." + dataNavigationQueryField(child) + " = new " + dataMappedQueryType(child) + "(neri_data::hierarchyNavigationQuery<" + semanticNamespaceDisplay(root.typeName) + ", " + semanticNamespaceDisplay(child.typeName) + ">(this." + root.setName + ".query(), " + dataEntityMappingName(child) + "(" + lspQuote(root.tableName) + "), " + lspQuote(root.discriminatorColumn) + ", " + dataHierarchyDiscriminators(
          mapping,
          root,
          child
        ) + ", upcast_" + child.generatedName + ", downcast_" + child.generatedName + "))\n")
    end
    derived = derived.nextDerived
  end
end

def dataEmitSubtypeNavigationAccessors(output: DataArtifact, mapping: DataMapping, child: DataEntity): Void
  if dataUsesSubtypeNavigation(mapping, child)
    output.write("\n  ## Queries a subtype navigation endpoint using the hierarchy's shared identity tracker.\n  public def query_" + child.generatedName + "(): " + dataMappedQueryType(child) + "\n    return this." + dataNavigationQueryField(child) + "\n  end\n")
  end
end
