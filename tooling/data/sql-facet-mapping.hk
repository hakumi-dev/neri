use host

def dataSqlFacet(mapping: DataMapping, node: LspJson, key: String, context: String): String
  if node.get(key).isMissing()
    return ""
  end
  let value = dataString(mapping, node, key, context)

  if host::stringByteLength(value) > 65536
    mapping.fail(context + "." + key + " exceeds the SQL facet size bound.")
  end
  return value
end

def dataParseFieldSqlFacets(
  mapping: DataMapping,
  entity: DataEntity,
  field: DataField,
  node: LspJson,
  context: String
): Bool
  field.defaultSql = dataSqlFacet(mapping, node, "defaultSql", context)
  field.computedSql = dataSqlFacet(mapping, node, "computedSql", context)
  field.checkSql = dataSqlFacet(mapping, node, "checkSql", context)
  field.collation = dataSqlFacet(mapping, node, "collation", context)
  let stored = node.get("computedStored")

  if !stored.isMissing()
    if !stored.isBoolean() || field.computedSql == ""
      return mapping.fail(context + ".computedStored requires a computed SQL column and a Boolean value.")
    end
    field.computedStored = stored.isTrue()
  end
  if field.defaultSql != "" && field.defaultCode != ""
    return mapping.fail(context + " accepts one literal default or SQL default expression.")
  end
  if field.computedSql != ""
    if entity.keyless || entity.isKeyMember(field.memberName) || field.defaultSql != "" || field.defaultCode != "" || field.conversionEncode != ""
      return mapping.fail(context + ".computedSql requires a built-in non-key scalar without a separate default.")
    end
    field.generatedOnAdd = true
    field.generatedOnUpdate = true
  end
  return mapping.error == ""
end
