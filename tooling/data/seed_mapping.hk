use host
use crypto

def dataSeedCellCode(mapping: DataMapping, field: DataField, value: LspJson, context: String): String
  if !dataValidateConvertedLiteral(mapping, field, value, context)
    return ""
  end
  if dataScalarName(field.domain) == "String" && !value.isNull()
    if !value.isString()
      mapping.fail(context + " seed text values require a JSON string.")
      return ""
    end
    return "neri_data::Cell.Text(" + dataStringLiteral(value.scalarText()) + ")"
  end
  if dataScalarName(field.domain) == "ByteBuffer" && !value.isNull()
    if !dataObject(mapping, value, context, ["hex"]) || !value.get("hex").isString()
      mapping.fail(context + " binary seed values require {hex: String}.")
      return ""
    end
    let bytes = crypto::decodeHex(value.get("hex").scalarText(), 1048576).bytes()

    if bytes == null
      mapping.fail(context + " binary seed hex is invalid or exceeds 1048576 bytes.")
      return ""
    end
    var code = "neri_data::cellBinaryBytes(["
    var index = 0

    while index < bytes.Length
      code = code + (index == 0 ? "" : ", ") + ((bytes[index] as Int) as String) + " as Byte"
      index = index + 1
    end
    return code + "])"
  end
  let copy = dataCopyField(field)

  if !dataParseDefault(mapping, copy, value, context)
    return ""
  end
  let prefix = "neri_data::SchemaDefault."

  return "neri_data::Cell." + host::stringSlice(
    copy.defaultCode,
    host::stringByteLength(prefix),
    host::stringByteLength(copy.defaultCode) - host::stringByteLength(prefix)
  )
end

def dataParseSeeds(mapping: DataMapping, entity: DataEntity, node: LspJson, context: String): Bool
  if node.isMissing()
    return true
  end
  let symbol = entity.symbol

  if !node.isArray() || entity.keyless || entity.view || (node.first != null && symbol != null && symbol.isAbstract)
    return mapping.fail(context + " requires a seed array on a concrete keyed entity with a managed table.")
  end
  var count = 0
  var field = entity.firstField

  while field != null
    count = count + 1 if field.hierarchyType == ""
    field = field.nextField
  end
  let members = arrays::generate<String>(count) do |index|
    var current = entity.firstField
    var position = 0

    while current != null
      if current.hierarchyType == ""
        if position == index
          return current.memberName
        end
        position = position + 1
      end
      current = current.nextField
    end
    return ""
  end
  var row = node.first
  var rowCount = 0
  let keys = new StringTable<Bool>()

  while row != null
    if rowCount >= 1000 || !dataObject(mapping, row, context, members)
      return mapping.fail(context + " seed rows must be objects, bounded to 1000 entries.")
    end
    let seed = new DataSeed(row, entity, new StringTable<String>())

    field = entity.firstField
    while field != null
      if field.hierarchyType == ""
        let value = row.get(field.memberName)

        if value.isMissing()
          if entity.isKeyMember(field.memberName) || (!field.optional && field.defaultCode == "" && field.defaultSql == "" && field.computedSql == "")
            return mapping.fail(context + " seed rows require assigned keys and values for every required field without a default.")
          end
        else
          if field.computedSql != ""
            return mapping.fail(context + " seed rows omit computed fields.")
          end
          let code = dataSeedCellCode(mapping, field, value, context + "." + field.memberName)

          if code == ""
            return false
          end
          seed.cellCodes.add(field.memberName, code)
        end
      end
      field = field.nextField
    end
    var keyIndex = 0

    while keyIndex < entity.keyMembers.size
      let value = seed.cellCodes.find(entity.keyMembers.get(keyIndex))

      if value == null
        return mapping.fail(context + " seed rows require assigned keys.")
      end
      seed.keyCode = seed.keyCode + (keyIndex == 0 ? "" : ", ") + value.value
      keyIndex = keyIndex + 1
    end
    if keys.find(seed.keyCode) != null
      return mapping.fail(context + " repeats an assigned primary-key tuple.")
    end
    keys.add(seed.keyCode, true)
    entity.addSeed(seed)
    row = row.next
    rowCount = rowCount + 1
  end
  return true
end

def dataAppendSeeds(target: DataEntity, source: DataEntity): Void
  var seed = source.firstSeed

  # Declared rows precede rows projected from descendants.
  while seed != null && seed.owner.typeName == source.typeName
    target.addSeed(new DataSeed(seed.node, seed.owner, seed.cellCodes, seed.keyCode))
    seed = seed.nextSeed
  end
end

def dataHierarchySeeds(mapping: DataMapping, root: DataEntity, context: String): Bool
  if root.hierarchyStrategy == ""
    return true
  end
  let keys = new StringTable<Bool>()
  var seed = root.firstSeed

  while seed != null
    keys.add(seed.keyCode, true)
    seed = seed.nextSeed
  end
  var derived = root.firstDerived

  while derived != null
    seed = derived.entity.firstSeed
    while seed != null
      if keys.find(seed.keyCode) != null
        return mapping.fail(context + " repeats an assigned primary-key tuple across the hierarchy.")
      end
      keys.add(seed.keyCode, true)
      seed = seed.nextSeed
    end
    derived = derived.nextDerived
  end
  if root.hierarchyStrategy == "tpc"
    return true
  end
  derived = root.firstDerived
  while derived != null
    let source = derived.entity
    let first = source.firstSeed

    if first != null && first.owner.typeName == source.typeName
      var table: DataEntity? = root.hierarchyStrategy == "tph" ? root : source.hierarchyParent

      while table != null
        dataAppendSeeds(table, source)
        table = table.hierarchyParent
      end
    end
    derived = derived.nextDerived
  end
  return true
end

def dataSeedSibling(seed: DataSeed, field: DataField): Bool
  if field.hierarchyType == ""
    return false
  end
  var owner: DataEntity? = seed.owner

  while owner != null
    if owner.typeName == field.hierarchyType
      return false
    end
    owner = owner.hierarchyParent
  end
  return true
end

def dataSeedFieldCode(seed: DataSeed, field: DataField): String?
  if field.computedSql != ""
    return null
  end
  if dataSeedSibling(seed, field)
    return "neri_data::Cell.Null()"
  end
  let code = seed.cellCodes.find(field.memberName)

  return code == null ? null : code.value
end

def dataSeedSource(entity: DataEntity, seed: DataSeed): String
  var keys = "["
  var fields = "["
  var values = "["
  var keyIndex = 0

  while keyIndex < entity.keyMembers.size
    let key = entity.field(entity.keyMembers.get(keyIndex))

    if key != null
      keys = keys + (keyIndex == 0 ? "" : ", ") + lspQuote(dataFieldIdentity(key))
    end
    keyIndex = keyIndex + 1
  end
  var field = entity.firstField

  while field != null
    if !entity.isKeyMember(field.memberName)
      let code = dataSeedFieldCode(seed, field)

      if code != null
        fields = fields + (fields == "[" ? "" : ", ") + lspQuote(dataFieldIdentity(field))
        values = values + (values == "[" ? "" : ", ") + code
      end
    end
    field = field.nextField
  end
  if entity.discriminatorColumn != ""
    fields = fields + (fields == "[" ? "" : ", ") + lspQuote(entity.typeName + ".__discriminator")
    values = values + (values == "[" ? "" : ", ") + "neri_data::Cell.Text(" + dataStringLiteral(seed.owner.discriminatorValue) + ")"
  end
  return "new neri_data::SchemaSeed(" + keys + "], [" + seed.keyCode + "], " + fields + "], " + values + "])"
end
