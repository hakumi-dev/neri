use host

## Checks the complete generated revision without creating or replacing files.
def dataGenerationCurrent(mapping: DataMapping, emission: DataEmission): Bool
  if mapping.error != "" || emission.error != ""
    return false
  end
  let inspected = files::status(mapping.outputPath)
  let status = inspected.status

  if inspected.failure != null || status == null
    return mapping.fail("Cannot inspect generated output directory.")
  end
  if !status.exists
    return false
  end
  if !status.kind.isDirectory() || status.symlink
    return mapping.fail("Generated output path must be a directory without symlinks.")
  end
  let previous = dataPublishOldOutputs(mapping)

  if previous == null || mapping.error != ""
    return false
  end
  let inputs = dataPublishInputs(mapping)

  if inputs == null || !dataPublishValidateOrigins(mapping, emission, inputs)
    return false
  end
  return dataPublishSame(
    mapping,
    emission,
    dataPublishManifest(mapping, emission, inputs)
  ) && dataPublishVerifyInputs(
    mapping,
    inputs
  )
end
