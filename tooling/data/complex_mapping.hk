def dataValidateOptionalComplex(mapping: DataMapping, entity: DataEntity): Bool
  var complex = entity.firstComplex

  while complex != null
    if complex.optional
      var field = entity.firstField

      while field != null
        if !field.optional && field.optionalParents.size > 0 && field.optionalParents.get(field.optionalParents.size - 1) == complex.memberName
          complex.presenceMember = field.memberName
          break
        end
        field = field.nextField
      end
      if complex.presenceMember == ""
        return mapping.fail("Optional complex member '" + entity.typeName + "." + complex.memberName + "' requires one non-optional scalar leaf to distinguish absence from an object containing null fields.")
      end
    end
    complex = complex.nextComplex
  end
  return true
end

def dataFieldStorageOptional(field: DataField): Bool
  return field.optional || field.optionalParents.size > 0
end

def dataOptionalParentGuard(field: DataField, receiver: String): String
  var result = ""
  var index = 0

  while index < field.optionalParents.size
    result = result + (result == "" ? "" : " && ") + receiver + "." + field.optionalParents.get(index) + " != null"
    index = index + 1
  end
  return result
end

def dataComplexGuard(entity: DataEntity, value: DataComplex, receiver: String): String
  var result = ""
  var parent = entity.firstComplex

  while parent != null
    if parent.optional && bootstrapStartsWith(value.memberName, parent.memberName + ".")
      result = result + (result == "" ? "" : " && ") + receiver + "." + parent.memberName + " != null"
    end
    parent = parent.nextComplex
  end
  return result
end
