use reference

def dataParseOwned(mapping: DataMapping, entity: DataEntity, node: LspJson, context: String): Bool
  if node.isMissing()
    return true
  end
  if !node.isArray() || entity.keyless
    return mapping.fail(context + ".owned requires an array on a tracked owner.")
  end
  var member = node.first

  while member != null
    let complex = member.isString() ? entity.complex(member.scalarText()) : null

    if complex == null || complex.owned
      return mapping.fail(context + ".owned requires distinct mapped complex member paths.")
    end
    complex.owned = true
    member = member.next
  end
  return true
end

def dataValidateOwnership(mapping: DataMapping): Bool
  var entity = mapping.firstEntity

  while entity != null
    var complex = entity.firstComplex

    while complex != null
      if complex.owned && mapping.entity(complex.typeName) != null
        return mapping.fail("A same-table owned complex type cannot also be mapped as an independent entity.")
      end
      complex = complex.nextComplex
    end
    entity = entity.nextEntity
  end
  var relation = mapping.firstRelation

  while relation != null
    if relation.ownership
      var other = mapping.firstRelation

      while other != null
        if other.ownership && !reference::same(other, relation) && other.dependentType == relation.dependentType
          return mapping.fail("An owned collection dependent type requires exactly one defining ownership relation.")
        end
        if other.principalType == relation.dependentType && !other.ownership
          return mapping.fail("An owned collection dependent can be a principal only for its nested ownership relation.")
        end
        other = other.nextRelation
      end
      var ownerType = relation.principalType
      var depth = 0

      while depth < 256
        if ownerType == relation.dependentType
          return mapping.fail("Owned collection ownership must form an acyclic owner tree.")
        end
        var parent = mapping.firstRelation
        var found = false

        while parent != null
          if parent.ownership && parent.dependentType == ownerType
            ownerType = parent.principalType
            found = true
            break
          end
          parent = parent.nextRelation
        end
        break if !found
        depth = depth + 1
      end
      if depth >= 256
        return mapping.fail("Owned collection ownership exceeds 256 levels.")
      end
    end
    relation = relation.nextRelation
  end
  return true
end

def dataOwnedStoreIndex(mapping: DataMapping, typeName: String): Int
  var entity = mapping.firstEntity
  var index = 0

  while entity != null
    var owned = entity.firstComplex

    while owned != null
      if owned.owned
        return index if owned.typeName == typeName
        index = index + 1
      end
      owned = owned.nextComplex
    end
    entity = entity.nextEntity
  end
  return index
end

def dataEmitOwnedStores(output: DataArtifact, mapping: DataMapping): Void
  let seen = new StringBuffer()
  var entity = mapping.firstEntity

  while entity != null
    var owned = entity.firstComplex

    while owned != null
      if owned.owned && !dataEmissionNamePresent(seen, owned.typeName)
        seen.add(owned.typeName)
        let index = dataOwnedStoreIndex(mapping, owned.typeName)

        output.write("    let owned_store_" + (index as String) + " = new neri_data::OwnedClaimStore<" + semanticNamespaceDisplay(owned.typeName) + ">()\n    owned_store_" + (index as String) + ".register(this.changes)\n")
      end
      owned = owned.nextComplex
    end
    entity = entity.nextEntity
  end
end

def dataEmitOwnedInit(output: DataArtifact, mapping: DataMapping, entity: DataEntity): Void
  var owned = entity.firstComplex
  var index = 0

  while owned != null
    if owned.owned
      let ownerType = semanticNamespaceDisplay(entity.typeName)
      let valueType = semanticNamespaceDisplay(owned.typeName)
      let guard = dataComplexGuard(entity, owned, "entity")

      let selector = "owned_select_" + (index as String) + "_" + entity.generatedName

      output.write("    let " + selector + ": fn(" + ownerType + "): " + valueType + "? = fn(entity: " + ownerType + "): " + valueType + "? do\n")
      output.write("      return null if !(" + guard + ")\n") if guard != ""
      output.write("      return entity." + owned.memberName + "\n    end\n    let owned_" + (index as String) + "_" + entity.generatedName + " = new neri_data::OwnedValues<" + ownerType + ", " + valueType + ">(this.tracker_" + entity.generatedName + ", " + selector + ", owned_store_" + (dataOwnedStoreIndex(
            mapping,
            owned.typeName
          ) as String) + ")\n    owned_" + (index as String) + "_" + entity.generatedName + ".register(this.changes)\n")
    end
    owned = owned.nextComplex
    index = index + 1
  end
end
