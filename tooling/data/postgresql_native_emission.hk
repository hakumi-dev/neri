use neri_data

def dataEmitGeneratedPostgresqlScalar(output: DataArtifact, field: DataField, target: String, indent: String): Bool
  let logical = postgresNativeLogicalType(field.postgresqlType)

  if logical == "" || logical == "Decimal"
    return false
  end
  if logical == "TimeSpan"
    output.write(indent + target + " = neri_data::TimeSpan.fromTicks(value)\n", field.origin)
  else
    output.write(
      indent + "let nativeValue = neri_data::" + logical + ".parse(value)\n\n" + indent + "if nativeValue != null\n" + indent + "  " + target + " = nativeValue\n" + indent + "end\n",
      field.origin
    )
  end
  return true
end
