class DataMigrationDraft
  public source: String = ""
  public snapshot: String = ""
  public error: String = ""
  public unchanged: Bool = false
  public upDataLoss: Bool = false
  public downDataLoss: Bool = false
  public beforeSignature: String = ""
  public afterSignature: String = ""
  public historicalPath: String = ""
  public historicalSnapshotText: String = ""
  public historicalMarkerText: String = ""
end
