use host
use crypto

# project-units encodes each argument as UTF-8 hex so empty arguments and
# control characters remain unambiguous in the tab-separated inventory.
class ToolingTestCase
  public name: String = ""
  public timeoutMs: Int = 0
  public arguments: String[] = []

  def init(record: String): Void
    let first = toolingFind(record, "\t", 0)
    let second = first < 0 ? -1 : toolingFind(record, "\t", first + 1)
    let length = host::stringByteLength(record)

    if first < 1
      fail("invalid test inventory record")
      return
    end
    this.name = host::stringSlice(record, 0, first)
    let timeoutEnd = second < 0 ? length : second
    let timeout = host::parseInt(host::stringSlice(record, first + 1, timeoutEnd - first - 1))

    if timeout == null || timeout < 1 || timeout > 600000
      fail("invalid test timeout: " + this.name)
      return
    end
    this.timeoutMs = timeout
    var start = second

    while start >= 0
      start = start + 1
      let separator = toolingFind(record, "\t", start)
      let finish = separator < 0 ? length : separator
      let encoded = host::stringSlice(record, start, finish - start)
      let bytes = crypto::decodeHex(encoded, 4096).bytes()

      if bytes == null
        fail("invalid encoded test argument: " + this.name)
        return
      end
      let argument = host::stringFromBytes(bytes)

      if argument == null
        fail("invalid UTF-8 test argument: " + this.name)
        return
      end
      this.arguments = host::appendString(this.arguments, argument)
      start = separator
    end
  end

  def resolveArguments(project: String, compiler: String, work: String): String[]
    var resolved: String[] = []

    for argument in this.arguments
      let value = argument == "{project}" ? project : (argument == "{compiler}" ? compiler : (argument == "{work}" ? work : argument))

      resolved = host::appendString(resolved, value)
    end
    return resolved
  end
end
