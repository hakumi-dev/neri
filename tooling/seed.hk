use crypto
use files
use json
use result

# The producer inventory includes compiler and standard-library inputs.
# Generated bootstrap artifacts belong to the separate validation inventory.
def seedSourceManifest(build: Build): String
  var paths: String[] = build.sourceFiles()

  for source in build.standardLibrarySources()
    paths = host::appendString(paths, build.root + "/stdlib/" + source)
  end
  for name in ["manifest.json", "stdlib/manifest.json"]
    paths = host::appendString(paths, build.root + "/" + name)
  end
  for asset in build.templateAssets()
    paths = host::appendString(paths, build.root + "/share/neri/templates/" + asset)
  end
  return build.fileManifest(paths, build.root)
end

# Each replacement is atomic; the metadata pin is published last. A launcher
# rejects mixed generations, and detected publication failures restore backups.
def seedPublish(build: Build, directory: String, inputs: String, validationInputs: String, metadata: json::Value, metadataText: String): Void
  let names = ["compiler.nir.tar.gz", "SOURCE-MANIFEST.sha256", "VALIDATION-SOURCE-MANIFEST.sha256", "seed.json"]
  let lock = build.root + "/build/seed-refresh.lock"

  if files::createDirectory(lock).failure != null
    fail("seed publication is already active; inspect build/seed-refresh.lock before retrying")
    return
  end
  if build.sourceManifest() != validationInputs
    files::removeDirectory(lock)
    fail("source tree changed before seed publication")
    return
  end
  var existed: Bool[] = [false, false, false, false]
  var index = 0

  while index < names.Length
    let path = build.root + "/bootstrap/" + names[index]
    let inspected = files::status(path)
    let state = inspected.status

    if inspected.failure != null || state == null
      files::removeDirectory(lock)
      fail("cannot inspect previous seed generation")
      return
    end
    existed[index] = state.exists
    if state.exists
      let copied = host::run("cp", [path, directory + "/previous-" + names[index]])

      if copied == null || copied != 0
        files::removeDirectory(lock)
        fail("cannot back up previous seed generation")
        return
      end
    end
    index = index + 1
  end
  # Validate the exact generation under the publication lock, after backups
  # and immediately before the first promotion. Hash failures reject it.
  let artifactDigest = seedBundleString(metadata, "artifactSha256")
  let sourceDigest = seedBundleString(metadata, "sourceManifestSha256")
  let validationDigest = seedBundleString(metadata, "validationSourceManifestSha256")
  let unitDigest = seedBundleString(metadata, "unitManifestSha256")

  if artifactDigest == null || !seedBundleDigestValid(artifactDigest) || sourceDigest == null || !seedBundleDigestValid(sourceDigest) || validationDigest == null || !seedBundleDigestValid(validationDigest) || unitDigest == null || !seedBundleDigestValid(unitDigest)
    files::removeDirectory(lock)
    fail("staged seed metadata contains an invalid digest")
    return
  end
  let archiveMatches = seedPublicationDigest(build, directory + "/compiler.nir.tar.gz") == artifactDigest && seedPublicationDigest(build, directory + "/compiler.repeat.tar.gz") == artifactDigest
  let sourceMatches = seedPublicationDigest(build, directory + "/SOURCE-MANIFEST.sha256") == sourceDigest && seedPublicationDigest(build, directory + "/VALIDATION-SOURCE-MANIFEST.sha256") == validationDigest && seedPublicationDigest(build, directory + "/units/UNITS.sha256") == unitDigest
  let textMatches = seedPublicationText(directory + "/SOURCE-MANIFEST.sha256", inputs) && seedPublicationText(directory + "/VALIDATION-SOURCE-MANIFEST.sha256", validationInputs) && seedPublicationText(directory + "/seed.json", metadataText)

  if !archiveMatches || !sourceMatches || !textMatches || build.sourceManifest() != validationInputs
    files::removeDirectory(lock)
    fail("staged seed generation changed before publication")
    return
  end
  index = 0
  while index < names.Length
    let name = names[index]
    let promoted = files::move(directory + "/" + name, build.root + "/bootstrap/" + name)

    if promoted.failure != null
      var restored = true
      var rollback = 0

      while rollback < index
        let previousName = names[rollback]
        let destination = build.root + "/bootstrap/" + previousName

        if existed[rollback]
          restored = false if files::move(directory + "/previous-" + previousName, destination).failure != null
        else
          restored = false if files::removeFile(destination).failure != null
        end
        rollback = rollback + 1
      end
      files::removeDirectory(lock)
      fail(restored ? "seed publication failed; previous generation restored" : "seed publication failed; restore backups from " + directory)
      return
    end
    index = index + 1
  end
  if files::removeDirectory(lock).failure != null
    fail("seed published but publication lock cleanup failed")
  end
end

# Call only after the captured source tree completed Build.test successfully.
def seedFromValidatedBuild(build: Build, inputs: String, validationInputs: String): Void
  if seedSourceManifest(build) != inputs || build.sourceManifest() != validationInputs
    fail("source tree changed during seed validation")
  end
  let directory = build.work + "/seed-refresh"

  if !build.fixedPointVerified || !build.contractsPassed || build.preparedStage != 3
    fail("seed refresh requires the validated Stage3 fixed point")
    return
  end
  let producerDigest = build.digest(build.work + "/stage2/neri")
  let compilerDigest = build.digest(build.work + "/stage3/neri")
  let workingDirectory = host::pathAbsolute(".")

  if workingDirectory == null || !seedBundleDigestValid(producerDigest) || !seedBundleDigestValid(compilerDigest) || producerDigest != compilerDigest
    fail("validated compiler executables no longer match")
    return
  end
  execute("mkdir", ["-p", directory])
  let stage2 = new SeedBundle(build.work + "/stage2/neri.temps")
  let stage3 = new SeedBundle(build.work + "/stage3/neri.temps")

  if !stage2.load() || !stage3.load() || stage2.manifest != stage3.manifest
    fail("retained Stage2 and Stage3 artifacts do not match")
    return
  end
  let payload = directory + "/units"

  if files::createDirectory(payload).failure != null || !stage3.copyBinary(payload)
    fail("cannot prepare canonical seed units from retained IR")
    return
  end
  if !stage3.archive(payload, directory + "/compiler.nir.tar", build.target)
    fail("cannot archive canonical seed units")
  end
  if !stage3.verifyBinary(payload) || !stage2.verify() || !stage3.verify()
    fail("retained seed artifacts changed during archive creation")
  end
  if !stage3.archive(payload, directory + "/compiler.repeat.tar", build.target)
    fail("cannot reproduce canonical seed archive")
  end
  execute("/usr/bin/env", ["-i", "PATH=/usr/bin:/bin", "LC_ALL=C", "TZ=UTC", "gzip", "-n", "-f", directory + "/compiler.nir.tar"])
  execute("/usr/bin/env", ["-i", "PATH=/usr/bin:/bin", "LC_ALL=C", "TZ=UTC", "gzip", "-n", "-f", directory + "/compiler.repeat.tar"])
  execute("cmp", [directory + "/compiler.nir.tar.gz", directory + "/compiler.repeat.tar.gz"])
  if !stage3.verifyBinary(payload) || !stage2.verify() || !stage3.verify()
    fail("retained seed artifacts changed during compression")
  end
  if seedSourceManifest(build) != inputs || build.sourceManifest() != validationInputs
    fail("compiler inputs changed during seed generation")
  end
  if !host::writeText(directory + "/SOURCE-MANIFEST.sha256", inputs) || !host::writeText(directory + "/VALIDATION-SOURCE-MANIFEST.sha256", validationInputs)
    fail("cannot record canonical seed source hashes")
  end
  let artifactDigest = seedPublicationDigest(build, directory + "/compiler.nir.tar.gz")

  if !seedBundleDigestValid(artifactDigest)
    fail("cannot hash canonical seed archive")
  end
  let metadata = json::Value.object()

  metadata.put("schemaVersion", seedNumber(2))
  metadata.put("format", json::Value.string("neri-ir-bundle-gzip"))
  metadata.put("artifact", json::Value.string("compiler.nir.tar.gz"))
  metadata.put("artifactSha256", json::Value.string(artifactDigest))
  metadata.put("unitManifestSha256", json::Value.string(build.digest(payload + "/UNITS.sha256")))
  metadata.put("unitCount", seedNumber(stage3.count))
  metadata.put("sourceManifest", json::Value.string("SOURCE-MANIFEST.sha256"))
  metadata.put("sourceManifestSha256", json::Value.string(build.digest(directory + "/SOURCE-MANIFEST.sha256")))
  metadata.put("validationSourceManifestSha256", json::Value.string(build.digest(directory + "/VALIDATION-SOURCE-MANIFEST.sha256")))
  metadata.put("producerCompilerSha256", json::Value.string(producerDigest))
  metadata.put("compilerSha256", json::Value.string(compilerDigest))
  metadata.put("workingDirectory", json::Value.string(workingDirectory))
  metadata.put("consumedArtifacts", json::Value.string(build.work + "/stage3/neri.temps"))
  metadata.put("retainedManifestSha256", json::Value.string(build.digest(build.work + "/stage3/neri.temps/manifest.json")))
  let arguments = json::Value.array()

  for argument in ["build", "--project", build.root + "/manifest.json", "--unit", "compiler", "--source-root", build.root + "/compiler", "--module", "neri-compiler", "--target", build.target.name(), "--release", "--timings", "--emit=executable", "--output", build.work + "/stage3/neri", "--save-temps"]
    arguments.add(json::Value.string(argument))
  end
  metadata.put("compilerArguments", arguments)
  metadata.put("binaryDecoding", json::Value.string("crypto.decodeHex of retained per-unit transport"))
  metadata.put("archiveFormat", json::Value.string("ustar: ordinal files, mode 0644, epoch mtime, uid/gid 0, empty owner names"))
  let compression = json::Value.array()

  for argument in ["gzip", "-n", "-f", directory + "/compiler.nir.tar"]
    compression.add(json::Value.string(argument))
  end
  metadata.put("compressionArguments", compression)
  let verification = json::Value.object()

  verification.put("fixedPoint", json::Value.boolean(true))
  verification.put("languageContracts", json::Value.boolean(true))
  verification.put("testSuite", json::Value.string("tooling/build.hk:Build.test"))
  verification.put("reproducibleCompression", json::Value.boolean(true))
  metadata.put("verification", verification)
  let encoded = new ToolingTextBuffer()

  encoded.add("{\n")
  metadata.each() do |key, value|
    if key == null
      fail("canonical seed metadata must contain named fields")
      return
    end
    encoded.add("  " + seedJson(json::Value.string(key)) + ": " + seedJson(value) + (encoded.count < metadata.count() ? ",\n" : "\n"))
  end
  encoded.add("}\n")
  let metadataText = toolingText(encoded)

  if !host::writeText(directory + "/seed.json", metadataText)
    fail("cannot record canonical seed provenance")
  end
  if build.digest(build.work + "/stage2/neri") != producerDigest || build.digest(build.work + "/stage3/neri") != compilerDigest || !stage2.verify() || !stage3.verify() || !stage3.verifyBinary(payload)
    fail("validated compiler artifacts changed before seed publication")
  end
  seedPublish(build, directory, inputs, validationInputs, metadata, metadataText)
  console::println("[seed] Refreshed canonical compiler IR with verified source and artifact hashes")
end

def refreshSeed(build: Build): Void
  build.nativeBuild()
  build.startWork()
  let inputs = seedSourceManifest(build)
  let validationInputs = build.sourceManifest()

  build.test()
  seedFromValidatedBuild(build, inputs, validationInputs)
end

def seedNumber(value: Int): json::Value
  let number = json::Value.number(value as String)

  if number == null
    fail("cannot encode canonical seed integer")
    return json::Value.nullValue()
  end
  return number
end

def seedJson(value: json::Value): String
  match json::stringify(value)
    case result::Result.Ok(text)
      return text
    case result::Result.Error(error)
      fail("cannot encode canonical seed provenance")
  end
  return ""
end

def seedPublicationText(path: String, expected: String): Bool
  let bytes = seedBundleRead(path, host::stringByteLength(expected))

  return bytes != null && host::stringFromBytes(bytes) == expected
end

def seedPublicationDigest(build: Build, path: String): String
  let inspected = files::status(path)
  let state = inspected.status

  if inspected.failure != null || state == null || state.symlink || !state.kind.isFile() || build.capture(["shasum", "-a", "256", "--", path], "seed-publication-hash", 60) != 0
    return ""
  end
  let bytes = seedBundleRead(build.work + "/seed-publication-hash.stdout", 65536)
  let text = bytes == null ? null : host::stringFromBytes(bytes)

  if text == null || host::stringByteLength(text) != 67 + host::stringByteLength(path) || !bytesEqualAt(text, "  " + path + "\n", 64)
    return ""
  end
  let digest = host::stringSlice(text, 0, 64)

  return seedBundleDigestValid(digest) ? digest : ""
end
