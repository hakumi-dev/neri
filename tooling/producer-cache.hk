use files

# Callers provide their existing digest implementation; no dependency solver is duplicated.
def toolingPrivateCacheDirectory(path: String): Void
  execute("/bin/sh", ["-c", "umask 077; mkdir -p \"$1\"; test -d \"$1\" && test ! -L \"$1\" && test -O \"$1\" && test \"$(find \"$1\" -prune -perm 0700)\" = \"$1\"", "neri-cache", path])
end

def toolingCachedProducer(root: String, source: String, digest: fn(String): String): String
  toolingPrivateCacheDirectory(root)
  let identity = digest(source)
  let directory = root + "/" + identity
  let output = directory + "/neri"
  let existing = files::status(directory).status

  if existing == null || !existing.exists
    let staging = bootstrapTemporaryDirectory(root, "producer")

    if staging == null
      fail("cannot create producer cache staging directory")
      return source
    end
    execute("cp", [source, staging + "/neri"])
    execute("chmod", ["700", staging + "/neri"])
    if digest(staging + "/neri") != identity
      fail("producer changed while copying")
    end
    let publication = files::move(staging, directory)

    if publication.failure != null
      # Another invocation may have published the identical content first.
      execute("rm", ["-rf", staging])
    end
  end
  toolingPrivateCacheDirectory(directory)
  execute("test", ["!", "-L", output])
  execute("test", ["-x", output])
  if digest(output) != identity || digest(source) != identity
    fail("producer cache integrity check failed")
  end
  return output
end
