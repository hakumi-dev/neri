use reference

class AbiCatalog
  public effects: AbiEffects = new AbiEffects()
  public features: AbiFeatures = new AbiFeatures()
  public registrationError: String = ""
  public major: Int = 1
  public minor: Int = 34
  public firstEffect: AbiEffect?
  public lastEffect: AbiEffect?
  public firstFeature: AbiFeature?
  public lastFeature: AbiFeature?
  public firstIntrinsic: AbiIntrinsic?
  public lastIntrinsic: AbiIntrinsic?
  public firstRuntimeImport: AbiRuntimeImport?
  public lastRuntimeImport: AbiRuntimeImport?
  public firstRequirement: AbiRequirementRule?
  public lastRequirement: AbiRequirementRule?

  def addEffect(value: AbiEffect): Void
    var current = this.firstEffect

    while current != null
      if reference::same(current, value)
        this.registrationError = "Effect '" + value.name + "' is registered more than once."
        return
      end
      current = current.next
    end
    current = this.firstEffect
    var previous: AbiEffect? = null

    while current != null && current.value < value.value
      previous = current
      current = current.next
    end
    value.next = current
    if previous == null
      this.firstEffect = value
    else
      previous.next = value
    end
    if current == null
      this.lastEffect = value
    end
  end

  def addFeature(value: AbiFeature): Void
    var current = this.firstFeature

    while current != null
      if reference::same(current, value)
        this.registrationError = "Runtime feature '" + value.name + "' is registered more than once."
        return
      end
      current = current.next
    end
    current = this.firstFeature
    var previous: AbiFeature? = null

    while current != null && current.value < value.value
      previous = current
      current = current.next
    end
    value.next = current
    if previous == null
      this.firstFeature = value
    else
      previous.next = value
    end
    if current == null
      this.lastFeature = value
    end
  end

  def addIntrinsic(value: AbiIntrinsic): Void
    let last = this.lastIntrinsic

    if last == null
      this.firstIntrinsic = value
    else
      last.next = value
    end
    this.lastIntrinsic = value
  end

  def addRuntimeImport(value: AbiRuntimeImport): Void
    let last = this.lastRuntimeImport

    if last == null
      this.firstRuntimeImport = value
    else
      last.next = value
    end
    this.lastRuntimeImport = value
  end

  def addRequirement(value: AbiRequirementRule): Void
    let last = this.lastRequirement

    if last == null
      this.firstRequirement = value
    else
      last.next = value
    end
    this.lastRequirement = value
  end

  def effect(value: AbiEffect): AbiEffect?
    var current = this.firstEffect

    while current != null
      if reference::same(current, value)
        return current
      end
      current = current.next
    end
    return null
  end

  def feature(value: AbiFeature?): AbiFeature?
    if value == null
      return null
    end
    var current = this.firstFeature

    while current != null
      if reference::same(current, value)
        return current
      end
      current = current.next
    end
    return null
  end

end
