class AbiRequirementRule
  public name: String = ""
  public matchKind: AbiRequirementMatch
  public linkName: String = ""
  public minimumMinor: Int
  public feature: AbiFeature?
  public next: AbiRequirementRule?

  def init(matchKind: AbiRequirementMatch, minimumMinor: Int, feature: AbiFeature? = null): Void
    this.matchKind = matchKind
    this.minimumMinor = minimumMinor
    this.feature = feature
  end

  def define(name: String): Void
    this.name = name
    this.linkName = "neri_rt_v1_" + abiSeparatedName(name, "_", false)
    if this.isPrefix()
      this.linkName = this.linkName + "_"
    end
  end

  def isPrefix(): Bool
    match this.matchKind
      case AbiRequirementMatch.Exact()
        return false
      case AbiRequirementMatch.Prefix()
        return true
    end
  end
end
