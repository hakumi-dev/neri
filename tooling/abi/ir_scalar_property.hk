enum IrScalarProperty
  case IntegerRepresentation()
  case ArithmeticInteger()
  case Floating()
  case Unsigned()
  case Extended()
  case SemanticBits()
  case CBits()
  case CName()
end

def irScalarPropertyName(property: IrScalarProperty): String
  match property
    case IrScalarProperty.IntegerRepresentation()
      return "hasIntegerRepresentation"
    case IrScalarProperty.ArithmeticInteger()
      return "isArithmeticInteger"
    case IrScalarProperty.Floating()
      return "isFloatingScalar"
    case IrScalarProperty.Unsigned()
      return "isUnsignedScalar"
    case IrScalarProperty.Extended()
      return "isExtendedScalar"
    case IrScalarProperty.SemanticBits()
      return "semanticScalarBits"
    case IrScalarProperty.CBits()
      return "cScalarBits"
    case IrScalarProperty.CName()
      return "cScalarName"
  end
end

def irScalarPropertyValue(scalar: IrScalarMetadata, property: IrScalarProperty): String
  match property
    case IrScalarProperty.IntegerRepresentation()
      return scalar.integerRepresentation ? "true" : "false"
    case IrScalarProperty.ArithmeticInteger()
      return scalar.arithmeticInteger ? "true" : "false"
    case IrScalarProperty.Floating()
      return scalar.floating ? "true" : "false"
    case IrScalarProperty.Unsigned()
      return scalar.unsigned ? "true" : "false"
    case IrScalarProperty.Extended()
      return scalar.extended ? "true" : "false"
    case IrScalarProperty.SemanticBits()
      return scalar.semanticBits as String
    case IrScalarProperty.CBits()
      return scalar.cBits as String
    case IrScalarProperty.CName()
      return abiNeriString(scalar.cName)
  end
end

def irScalarPropertyType(property: IrScalarProperty): String
  match property
    case IrScalarProperty.IntegerRepresentation()
      return "Bool"
    case IrScalarProperty.ArithmeticInteger()
      return "Bool"
    case IrScalarProperty.Floating()
      return "Bool"
    case IrScalarProperty.Unsigned()
      return "Bool"
    case IrScalarProperty.Extended()
      return "Bool"
    case IrScalarProperty.SemanticBits()
      return "Int"
    case IrScalarProperty.CBits()
      return "Int"
    case IrScalarProperty.CName()
      return "String"
  end
end

def irScalarPropertyDefault(property: IrScalarProperty): String
  match property
    case IrScalarProperty.IntegerRepresentation()
      return "false"
    case IrScalarProperty.ArithmeticInteger()
      return "false"
    case IrScalarProperty.Floating()
      return "false"
    case IrScalarProperty.Unsigned()
      return "false"
    case IrScalarProperty.Extended()
      return "false"
    case IrScalarProperty.SemanticBits()
      return "0"
    case IrScalarProperty.CBits()
      return "0"
    case IrScalarProperty.CName()
      return "\"\""
  end
end
