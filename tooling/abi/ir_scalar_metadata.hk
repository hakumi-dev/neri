class IrScalarMetadata
  public integerRepresentation: Bool
  public arithmeticInteger: Bool
  public floating: Bool
  public unsigned: Bool
  public extended: Bool
  public semanticBits: Int
  public cBits: Int
  public cName: String
  public runtimeKind: String

  def init(
    integerRepresentation: Bool,
    arithmeticInteger: Bool,
    floating: Bool,
    unsigned: Bool,
    extended: Bool,
    semanticBits: Int,
    cBits: Int,
    cName: String,
    runtimeKind: String
  ): Void
    this.integerRepresentation = integerRepresentation
    this.arithmeticInteger = arithmeticInteger
    this.floating = floating
    this.unsigned = unsigned
    this.extended = extended
    this.semanticBits = semanticBits
    this.cBits = cBits
    this.cName = cName
    this.runtimeKind = runtimeKind
  end
end
