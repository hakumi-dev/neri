use host

def abiPowerOfTwo(value: Int): Bool
  if value <= 0
    return false
  end
  var current = 1

  while current < value && current <= 1152921504606846976
    current = current * 2
  end
  return current == value
end

def abiCatalogIdentifier(value: String): Bool
  if value == ""
    return false
  end
  let first = host.stringByteAt(value, 0) as Int

  if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95)
    return false
  end
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int

    if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95)
      return false
    end
    index = index + 1
  end
  return true
end

def abiNamesUnique(values: String[]): Bool
  var index = 0

  while index < values.Length
    var other = index + 1

    while other < values.Length
      if values[index] == values[other]
        return false
      end
      other = other + 1
    end
    index = index + 1
  end
  return true
end

def abiLeafTypeValid(value: String): Bool
  return value == "Bool" || value == "Byte" || value == "Int" || value == "Float" || value == "String"
end

def abiTypeValid(value: String, allowVoid: Bool = true): Bool
  if value == "Void"
    return allowVoid
  end
  if abiLeafTypeValid(value)
    return true
  end
  let length = host.stringByteLength(value)

  if length > 1 && host.stringSlice(value, length - 1, 1) == "?"
    return abiLeafTypeValid(host.stringSlice(value, 0, length - 1))
  end
  if length > 2 && host.stringSlice(value, length - 2, 2) == "[]"
    return abiLeafTypeValid(host.stringSlice(value, 0, length - 2))
  end
  return false
end

def abiSignatureTypesValid(resultType: String, parameterTypes: String[]): Bool
  if !abiTypeValid(resultType)
    return false
  end
  for parameterType in parameterTypes
    if !abiTypeValid(parameterType, false)
      return false
    end
  end
  return true
end

def abiMaximumEffect(catalog: AbiCatalog): Int
  var result = 0
  var effect = catalog.firstEffect

  while effect != null
    result = effect.value
    effect = effect.next
  end
  return result
end

def abiMaximumFeature(catalog: AbiCatalog): Int
  var result = 0
  var feature = catalog.firstFeature

  while feature != null
    result = feature.value
    feature = feature.next
  end
  return result
end

def abiCatalogValidate(catalog: AbiCatalog): String
  if catalog.major != 1 || catalog.minor < 0 || catalog.minor > 65535
    return "ABI version is invalid."
  end
  if catalog.firstEffect == null || catalog.firstFeature == null || catalog.firstIntrinsic == null || catalog.firstRuntimeImport == null || catalog.firstRequirement == null
    return "ABI catalog sections cannot be empty."
  end
  var effect = catalog.firstEffect
  var expectedEffect = 1

  while effect != null
    if !abiCatalogIdentifier(effect.name) || effect.display == "" || !abiCatalogIdentifier(effect.cName) || effect.value != expectedEffect || !abiPowerOfTwo(effect.value) || effect.value > 128
      return "Effect '" + effect.name + "' has an invalid canonical value or name."
    end
    var otherEffect = effect.next

    while otherEffect != null
      if otherEffect.name == effect.name || otherEffect.display == effect.display || otherEffect.cName == effect.cName || otherEffect.value == effect.value
        return "Effect '" + effect.name + "' is duplicated."
      end
      otherEffect = otherEffect.next
    end
    expectedEffect = expectedEffect * 2
    effect = effect.next
  end
  if expectedEffect != 256
    return "Effect catalog must define the eight IR v1 effect bits."
  end
  var feature = catalog.firstFeature
  var expectedFeature = 1

  while feature != null
    if !abiCatalogIdentifier(feature.name) || !abiCatalogIdentifier(feature.cName) || feature.value != expectedFeature || !abiPowerOfTwo(feature.value) || feature.value > 1152921504606846976 || feature.minimumMinor < 0 || feature.minimumMinor > catalog.minor
      return "Runtime feature '" + feature.name + "' has invalid metadata."
    end
    var otherFeature = feature.next

    while otherFeature != null
      if otherFeature.name == feature.name || otherFeature.cName == feature.cName || otherFeature.value == feature.value
        return "Runtime feature '" + feature.name + "' is duplicated."
      end
      otherFeature = otherFeature.next
    end
    expectedFeature = expectedFeature * 2
    feature = feature.next
  end
  var intrinsic = catalog.firstIntrinsic

  while intrinsic != null
    if intrinsic.name == "" || !abiCatalogIdentifier(intrinsic.linkName) || !abiSignatureTypesValid(intrinsic.resultType, intrinsic.parameterTypes) || intrinsic.minimumMinor < 0 || intrinsic.minimumMinor > catalog.minor
      return "Intrinsic '" + intrinsic.name + "' has invalid metadata."
    end
    var otherIntrinsic = intrinsic.next

    while otherIntrinsic != null
      if otherIntrinsic.name == intrinsic.name || otherIntrinsic.linkName == intrinsic.linkName
        return "Intrinsic '" + intrinsic.name + "' is duplicated."
      end
      otherIntrinsic = otherIntrinsic.next
    end
    for effectName in intrinsic.effects
      if catalog.effect(effectName) == null
        return "Intrinsic '" + intrinsic.name + "' references unknown effect '" + effectName + "'."
      end
    end
    if !abiNamesUnique(intrinsic.effects) || !abiNamesUnique(intrinsic.features)
      return "Intrinsic '" + intrinsic.name + "' repeats an effect or runtime feature."
    end
    for featureName in intrinsic.features
      let requiredFeature = catalog.feature(featureName)

      if requiredFeature == null
        return "Intrinsic '" + intrinsic.name + "' references unknown runtime feature '" + featureName + "'."
      end
      if requiredFeature.minimumMinor > intrinsic.minimumMinor
        return "Intrinsic '" + intrinsic.name + "' predates required runtime feature '" + featureName + "'."
      end
    end
    intrinsic = intrinsic.next
  end
  var runtimeImport = catalog.firstRuntimeImport

  while runtimeImport != null
    if !abiCatalogIdentifier(runtimeImport.name) || !abiCatalogIdentifier(runtimeImport.linkName) || !abiSignatureTypesValid(runtimeImport.resultType, runtimeImport.parameterTypes) || runtimeImport.minimumMinor < 0 || runtimeImport.minimumMinor > catalog.minor || runtimeImport.symbolKind <= 0
      return "Runtime import '" + runtimeImport.name + "' has invalid metadata."
    end
    var otherRuntimeImport = runtimeImport.next

    while otherRuntimeImport != null
      if otherRuntimeImport.name == runtimeImport.name || otherRuntimeImport.linkName == runtimeImport.linkName
        return "Runtime import '" + runtimeImport.name + "' is duplicated."
      end
      otherRuntimeImport = otherRuntimeImport.next
    end
    intrinsic = catalog.firstIntrinsic
    while intrinsic != null
      if intrinsic.linkName == runtimeImport.linkName
        return "Runtime import '" + runtimeImport.name + "' duplicates intrinsic link name '" + runtimeImport.linkName + "'."
      end
      intrinsic = intrinsic.next
    end
    for effectName in runtimeImport.effects
      if catalog.effect(effectName) == null
        return "Runtime import '" + runtimeImport.name + "' references unknown effect '" + effectName + "'."
      end
    end
    if !abiNamesUnique(runtimeImport.effects) || !abiNamesUnique(runtimeImport.features)
      return "Runtime import '" + runtimeImport.name + "' repeats an effect or runtime feature."
    end
    for featureName in runtimeImport.features
      let requiredFeature = catalog.feature(featureName)

      if requiredFeature == null
        return "Runtime import '" + runtimeImport.name + "' references unknown runtime feature '" + featureName + "'."
      end
      if requiredFeature.minimumMinor > runtimeImport.minimumMinor
        return "Runtime import '" + runtimeImport.name + "' predates required runtime feature '" + featureName + "'."
      end
    end
    runtimeImport = runtimeImport.next
  end
  var requirement = catalog.firstRequirement

  while requirement != null
    if requirement.linkName == "" || requirement.minimumMinor < 0 || requirement.minimumMinor > catalog.minor
      return "Runtime requirement rule has invalid metadata."
    end
    if requirement.feature != ""
      let requiredFeature = catalog.feature(requirement.feature)

      if requiredFeature == null
        return "Runtime requirement rule references unknown feature '" + requirement.feature + "'."
      end
      if requiredFeature.minimumMinor > requirement.minimumMinor
        return "Runtime requirement rule predates feature '" + requirement.feature + "'."
      end
    end
    var otherRequirement = requirement.next

    while otherRequirement != null
      if otherRequirement.prefix == requirement.prefix && otherRequirement.linkName == requirement.linkName
        return "Runtime requirement rule '" + requirement.linkName + "' is duplicated."
      end
      otherRequirement = otherRequirement.next
    end
    requirement = requirement.next
  end
  return ""
end

def abiAdvertisedFeatureBits(catalog: AbiCatalog): Int
  var result = 0
  var feature = catalog.firstFeature

  while feature != null
    result = result + feature.value if feature.advertised
    feature = feature.next
  end
  return result
end
