enum AbiOutputKind
  case Effects()
  case Features()
  case Intrinsics()
  case RuntimeImports()
  case RuntimeRequirements()
  case Header()
  case CRuntimeImports()
  case IrFeatureSet()
  case CIrFeatures()
  case IrProtocol()
  case CIrProtocol()
end

def abiOutputPath(root: String, kind: AbiOutputKind): String
  match kind
    case AbiOutputKind.Effects()
      return root + "/compiler/abi/effects.hk"
    case AbiOutputKind.Features()
      return root + "/compiler/abi/features.hk"
    case AbiOutputKind.Intrinsics()
      return root + "/compiler/abi/intrinsics.hk"
    case AbiOutputKind.RuntimeImports()
      return root + "/compiler/abi/runtime_imports.hk"
    case AbiOutputKind.RuntimeRequirements()
      return root + "/compiler/abi/runtime_requirements.hk"
    case AbiOutputKind.Header()
      return root + "/native/include/neri/abi_catalog.h"
    case AbiOutputKind.CRuntimeImports()
      return root + "/native/include/neri/abi_runtime_imports.h"
    case AbiOutputKind.IrFeatureSet()
      return root + "/compiler/ir/ir_feature_set.hk"
    case AbiOutputKind.CIrFeatures()
      return root + "/native/include/neri/ir_features.h"
    case AbiOutputKind.IrProtocol()
      return root + "/compiler/ir/ir_protocol.hk"
    case AbiOutputKind.CIrProtocol()
      return root + "/native/include/neri/ir_protocol.h"
  end
end
