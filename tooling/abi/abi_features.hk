class AbiFeatures
  public PreciseGc: AbiFeature = new AbiFeature(1, 0, true)
  public NonmovingGc: AbiFeature = new AbiFeature(2, 0, true)
  public ScopedBorrows: AbiFeature = new AbiFeature(4, 0, true)
  public NativeMemory: AbiFeature = new AbiFeature(8, 0, true)
  public RootFrames: AbiFeature = new AbiFeature(16, 0, true)
  public SourceLocations: AbiFeature = new AbiFeature(32, 1, true)
  public NativeStrings: AbiFeature = new AbiFeature(64, 2, true)
  public ConsoleIo: AbiFeature = new AbiFeature(128, 3, true)
  public InlineAggregates: AbiFeature = new AbiFeature(256, 4, false)
  public ExtendedScalars: AbiFeature = new AbiFeature(512, 9, true)
  public MultipleMutators: AbiFeature = new AbiFeature(1024, 4, false)
  public BootstrapHost: AbiFeature = new AbiFeature(2048, 6, true)
  public Sockets: AbiFeature = new AbiFeature(4096, 7, true)
  public InteractiveIo: AbiFeature = new AbiFeature(8192, 8, true)
  public ScopedTasks: AbiFeature = new AbiFeature(16384, 10, true)
  public Files: AbiFeature = new AbiFeature(32768, 11, true)
  public Interrupts: AbiFeature = new AbiFeature(65536, 12, true)
  public WallClock: AbiFeature = new AbiFeature(131072, 13, true)
  public Crypto: AbiFeature = new AbiFeature(262144, 14, true)
  public RootedFiles: AbiFeature = new AbiFeature(524288, 15, true)
  public Process: AbiFeature = new AbiFeature(1048576, 16, true)
  public Directory: AbiFeature = new AbiFeature(2097152, 17, true)
  public SocketCloseResult: AbiFeature = new AbiFeature(4194304, 18, true)
  public SessionModules: AbiFeature = new AbiFeature(8388608, 19, true)
  public Drain: AbiFeature = new AbiFeature(16777216, 20, true)
  public OptionalConsoleRead: AbiFeature = new AbiFeature(33554432, 21, true)
  public ProcessIo: AbiFeature = new AbiFeature(67108864, 22, true)
  public FilesystemMutation: AbiFeature = new AbiFeature(134217728, 22, true)
  public SocketEndpoints: AbiFeature = new AbiFeature(268435456, 22, true)
  public SequentialArrays: AbiFeature = new AbiFeature(536870912, 29, true)
  public IsolatedWorkers: AbiFeature = new AbiFeature(1073741824, 32, true)
  public MultiplexedIo: AbiFeature = new AbiFeature(2147483648, 33, true)

  def init(): Void
    compile for field in reflect.fields<AbiFeatures>()
      field.read(this).define(field.name)
    end
  end
end
