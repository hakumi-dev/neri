use host

def abiNeriString(value: String): String
  var result = "\""
  var start = 0
  var index = 0

  while index < host.stringByteLength(value)
    let byte = host.stringByteAt(value, index) as Int
    var escaped = ""

    if byte == 0
      escaped = "\\0"
    else if byte == 9
      escaped = "\\t"
    else if byte == 10
      escaped = "\\n"
    else if byte == 13
      escaped = "\\r"
    else if byte == 34
      escaped = "\\\""
    else if byte == 92
      escaped = "\\\\"
    end
    if escaped != ""
      result = result + host.stringSlice(value, start, index - start) + escaped
      start = index + 1
    end
    index = index + 1
  end
  return result + host.stringSlice(value, start, index - start) + "\""
end
