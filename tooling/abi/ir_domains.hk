# Canonical internal IR domains and their explicit transport values.
# Generated Neri classes and C enum declarations share this catalog.
def irDomainDefinitions(): IrDomainDefinition
  let symbolKind = new IrDomainDefinition("IrSymbolKind", "ir_symbol_kind", "neri_ir_symbol_kind_v1", IrDomainWireKind.Byte(), true)

  symbolKind.add(new IrDomainEntry("Class", "NERI_IR_SYMBOL_CLASS_V1", 1, "class"))
  symbolKind.add(new IrDomainEntry("Field", "NERI_IR_SYMBOL_FIELD_V1", 2, "field"))
  symbolKind.add(new IrDomainEntry("Method", "NERI_IR_SYMBOL_METHOD_V1", 3, "method"))
  symbolKind.add(new IrDomainEntry("Function", "NERI_IR_SYMBOL_FUNCTION_V1", 4, "function"))
  symbolKind.add(new IrDomainEntry("Parameter", "NERI_IR_SYMBOL_PARAMETER_V1", 5, "parameter"))
  symbolKind.add(new IrDomainEntry("Local", "NERI_IR_SYMBOL_LOCAL_V1", 6, "local"))
  symbolKind.add(new IrDomainEntry("LibraryFunction", "NERI_IR_SYMBOL_LIBRARY_FUNCTION_V1", 7, "library-function"))
  symbolKind.add(new IrDomainEntry("Intrinsic", "NERI_IR_SYMBOL_INTRINSIC_V1", 8, "intrinsic"))
  symbolKind.add(new IrDomainEntry("Global", "NERI_IR_SYMBOL_GLOBAL_V1", 9, "global"))
  symbolKind.add(new IrDomainEntry("NativeRecord", "NERI_IR_SYMBOL_NATIVE_RECORD_V1", 10, "native-record"))

  let access = new IrDomainDefinition("IrAccess", "ir_access", "neri_ir_access_v1")

  access.add(new IrDomainEntry("Public", "NERI_IR_ACCESS_PUBLIC_V1", 1, "public"))
  access.add(new IrDomainEntry("Private", "NERI_IR_ACCESS_PRIVATE_V1", 2, "private"))
  access.add(new IrDomainEntry("Protected", "NERI_IR_ACCESS_PROTECTED_V1", 3, "protected"))
  access.add(new IrDomainEntry("Internal", "NERI_IR_ACCESS_INTERNAL_V1", 4, "internal"))
  symbolKind.next = access

  let globalLinkage = new IrDomainDefinition("IrGlobalLinkage", "ir_global_linkage", "neri_ir_global_linkage_v1")

  globalLinkage.add(new IrDomainEntry("Internal", "NERI_IR_GLOBAL_INTERNAL_V1", 1, "internal"))
  globalLinkage.add(new IrDomainEntry("Exported", "NERI_IR_GLOBAL_EXPORTED_V1", 2, "exported"))
  access.next = globalLinkage

  let importKind = new IrDomainDefinition("IrImportKind", "ir_import_kind", "neri_ir_import_kind_v1")

  importKind.add(new IrDomainEntry("Runtime", "NERI_IR_IMPORT_RUNTIME_V1", 1, "runtime"))
  importKind.add(new IrDomainEntry("CAbi", "NERI_IR_IMPORT_C_ABI_V1", 2, "cabi"))
  globalLinkage.next = importKind

  let functionKind = new IrDomainDefinition("IrFunctionKind", "ir_function_kind", "neri_ir_function_kind_v1")

  functionKind.add(new IrDomainEntry("Function", "NERI_IR_FUNCTION_V1", 1, "function"))
  functionKind.add(new IrDomainEntry("StaticMethod", "NERI_IR_STATIC_METHOD_V1", 2, "static-method"))
  functionKind.add(new IrDomainEntry("InstanceMethod", "NERI_IR_INSTANCE_METHOD_V1", 3, "instance-method"))
  functionKind.add(new IrDomainEntry("Constructor", "NERI_IR_CONSTRUCTOR_V1", 4, "constructor"))
  functionKind.add(new IrDomainEntry("DefaultAdapter", "NERI_IR_DEFAULT_ADAPTER_V1", 5, "default-adapter"))
  importKind.next = functionKind

  let dispatchKind = new IrDomainDefinition("IrDispatchKind", "ir_dispatch_kind", "neri_ir_dispatch_kind_v1")

  dispatchKind.add(new IrDomainEntry("Static", "NERI_IR_DISPATCH_STATIC_V1", 1, "static"))
  dispatchKind.add(new IrDomainEntry("Direct", "NERI_IR_DISPATCH_DIRECT_V1", 2, "direct"))
  dispatchKind.add(new IrDomainEntry("Virtual", "NERI_IR_DISPATCH_VIRTUAL_V1", 3, "virtual"))
  functionKind.next = dispatchKind

  let comparison = new IrDomainDefinition("IrComparison", "ir_comparison", "neri_ir_comparison_v1")

  comparison.add(new IrDomainEntry("Equal", "NERI_IR_COMPARISON_EQUAL_V1", 1, "eq"))
  comparison.add(new IrDomainEntry("NotEqual", "NERI_IR_COMPARISON_NOT_EQUAL_V1", 2, "ne"))
  comparison.add(new IrDomainEntry("Less", "NERI_IR_COMPARISON_LESS_V1", 3, "lt"))
  comparison.add(new IrDomainEntry("LessOrEqual", "NERI_IR_COMPARISON_LESS_OR_EQUAL_V1", 4, "le"))
  comparison.add(new IrDomainEntry("Greater", "NERI_IR_COMPARISON_GREATER_V1", 5, "gt"))
  comparison.add(new IrDomainEntry("GreaterOrEqual", "NERI_IR_COMPARISON_GREATER_OR_EQUAL_V1", 6, "ge"))
  dispatchKind.next = comparison

  let typeKind = new IrDomainDefinition("IrTypeKind", "ir_type_kind", "neri_ir_type_tag_v1")

  typeKind.add(new IrDomainEntry("Void", "NERI_IR_TYPE_VOID_V1", 1, "void"))
  typeKind.add(new IrDomainEntry("Bool", "NERI_IR_TYPE_BOOL_V1", 2, "bool"))
  typeKind.add(new IrDomainEntry("Byte", "NERI_IR_TYPE_BYTE_V1", 3, "byte"))
  typeKind.add(new IrDomainEntry("Int", "NERI_IR_TYPE_INT_V1", 4, "int"))
  typeKind.add(new IrDomainEntry("Float", "NERI_IR_TYPE_FLOAT_V1", 5, "float"))
  typeKind.add(new IrDomainEntry("String", "NERI_IR_TYPE_STRING_V1", 6, "string"))
  typeKind.add(new IrDomainEntry("Int32", "NERI_IR_TYPE_INT32_V1", 7, "int32"))
  typeKind.add(new IrDomainEntry("Uint32", "NERI_IR_TYPE_UINT32_V1", 8, "uint32"))
  typeKind.add(new IrDomainEntry("Uint64", "NERI_IR_TYPE_UINT64_V1", 9, "uint64"))
  typeKind.add(new IrDomainEntry("Float32", "NERI_IR_TYPE_FLOAT32_V1", 10, "float32"))
  typeKind.add(new IrDomainEntry("Array", "NERI_IR_TYPE_ARRAY_V1", 16, "array"))
  typeKind.add(new IrDomainEntry("Class", "NERI_IR_TYPE_CLASS_V1", 17, "class"))
  typeKind.add(new IrDomainEntry("Optional", "NERI_IR_TYPE_OPTIONAL_V1", 18, "optional"))
  typeKind.add(new IrDomainEntry("Pointer", "NERI_IR_TYPE_POINTER_V1", 19, "pointer"))
  typeKind.add(new IrDomainEntry("NativeRecord", "NERI_IR_TYPE_NATIVE_RECORD_V1", 20, "native-record"))
  typeKind.add(new IrDomainEntry("FixedArray", "NERI_IR_TYPE_FIXED_ARRAY_V1", 21, "fixed-array"))
  typeKind.add(new IrDomainEntry("CFunction", "NERI_IR_TYPE_C_FUNCTION_V1", 22, "c-function"))
  typeKind.add(new IrDomainEntry("UnsafeCapability", "NERI_IR_TYPE_UNSAFE_CAPABILITY_V1", 32, "unsafe-capability"))
  typeKind.add(new IrDomainEntry("BorrowCapability", "NERI_IR_TYPE_BORROW_CAPABILITY_V1", 33, "borrow-capability"))
  comparison.next = typeKind

  let constantKind = new IrDomainDefinition("IrConstantKind", "ir_constant_kind", "neri_ir_constant_tag_v1")

  constantKind.add(new IrDomainEntry("Bool", "NERI_IR_CONSTANT_BOOL_V1", 1, "bool"))
  constantKind.add(new IrDomainEntry("Byte", "NERI_IR_CONSTANT_BYTE_V1", 2, "byte"))
  constantKind.add(new IrDomainEntry("Int", "NERI_IR_CONSTANT_INT_V1", 3, "int"))
  constantKind.add(new IrDomainEntry("Float", "NERI_IR_CONSTANT_FLOAT_V1", 4, "float"))
  constantKind.add(new IrDomainEntry("OptionalNone", "NERI_IR_CONSTANT_OPTIONAL_NONE_V1", 5, "optional-none"))
  constantKind.add(new IrDomainEntry("OptionalSome", "NERI_IR_CONSTANT_OPTIONAL_SOME_V1", 6, "optional-some"))
  constantKind.add(new IrDomainEntry("StringGlobal", "NERI_IR_CONSTANT_STRING_GLOBAL_V1", 7, "string-global"))
  constantKind.add(new IrDomainEntry("StringUtf8", "NERI_IR_CONSTANT_STRING_UTF8_V1", 8, "string-utf8"))
  typeKind.next = constantKind

  let terminatorKind = new IrDomainDefinition("IrTerminatorKind", "ir_terminator_kind", "neri_ir_terminator_tag_v1")

  terminatorKind.add(new IrDomainEntry("Branch", "NERI_IR_TERMINATOR_BRANCH_V1", 1, "branch"))
  terminatorKind.add(new IrDomainEntry("ConditionalBranch", "NERI_IR_TERMINATOR_CONDITIONAL_BRANCH_V1", 2, "conditional-branch"))
  terminatorKind.add(new IrDomainEntry("Return", "NERI_IR_TERMINATOR_RETURN_V1", 3, "return"))
  terminatorKind.add(new IrDomainEntry("Panic", "NERI_IR_TERMINATOR_PANIC_V1", 4, "panic"))
  constantKind.next = terminatorKind

  let opcode = new IrDomainDefinition("IrOpcode", "ir_opcode", "neri_ir_opcode_v1", IrDomainWireKind.UInt16())

  opcode.add(new IrDomainEntry("Constant", "NERI_IR_OPCODE_CONSTANT_V1", 1, "constant"))
  opcode.add(new IrDomainEntry("IntNegChecked", "NERI_IR_OPCODE_INT_NEG_CHECKED_V1", 2, "int.neg.checked"))
  opcode.add(new IrDomainEntry("IntAddChecked", "NERI_IR_OPCODE_INT_ADD_CHECKED_V1", 3, "int.add.checked"))
  opcode.add(new IrDomainEntry("IntSubChecked", "NERI_IR_OPCODE_INT_SUB_CHECKED_V1", 4, "int.sub.checked"))
  opcode.add(new IrDomainEntry("IntMulChecked", "NERI_IR_OPCODE_INT_MUL_CHECKED_V1", 5, "int.mul.checked"))
  opcode.add(new IrDomainEntry("IntDivChecked", "NERI_IR_OPCODE_INT_DIV_CHECKED_V1", 6, "int.div.checked"))
  opcode.add(new IrDomainEntry("FloatNeg", "NERI_IR_OPCODE_FLOAT_NEG_V1", 7, "float.neg"))
  opcode.add(new IrDomainEntry("FloatAdd", "NERI_IR_OPCODE_FLOAT_ADD_V1", 8, "float.add"))
  opcode.add(new IrDomainEntry("FloatSub", "NERI_IR_OPCODE_FLOAT_SUB_V1", 9, "float.sub"))
  opcode.add(new IrDomainEntry("FloatMul", "NERI_IR_OPCODE_FLOAT_MUL_V1", 10, "float.mul"))
  opcode.add(new IrDomainEntry("FloatDiv", "NERI_IR_OPCODE_FLOAT_DIV_V1", 11, "float.div"))
  opcode.add(new IrDomainEntry("BoolNot", "NERI_IR_OPCODE_BOOL_NOT_V1", 12, "bool.not"))
  opcode.add(new IrDomainEntry("BoolAnd", "NERI_IR_OPCODE_BOOL_AND_V1", 13, "bool.and"))
  opcode.add(new IrDomainEntry("BoolOr", "NERI_IR_OPCODE_BOOL_OR_V1", 14, "bool.or"))
  opcode.add(new IrDomainEntry("Compare", "NERI_IR_OPCODE_COMPARE_V1", 15, "compare"))
  opcode.add(new IrDomainEntry("CastIntToFloat", "NERI_IR_OPCODE_CAST_INT_TO_FLOAT_V1", 16, "cast.int-to-float"))
  opcode.add(new IrDomainEntry("CastFloatToIntChecked", "NERI_IR_OPCODE_CAST_FLOAT_TO_INT_CHECKED_V1", 17, "cast.float-to-int.checked"))
  opcode.add(new IrDomainEntry("CastIntToByteChecked", "NERI_IR_OPCODE_CAST_INT_TO_BYTE_CHECKED_V1", 18, "cast.int-to-byte.checked"))
  opcode.add(new IrDomainEntry("CastByteToInt", "NERI_IR_OPCODE_CAST_BYTE_TO_INT_V1", 19, "cast.byte-to-int"))
  opcode.add(new IrDomainEntry("ClassUpcast", "NERI_IR_OPCODE_CLASS_UPCAST_V1", 20, "class.upcast"))
  opcode.add(new IrDomainEntry("OptionalNone", "NERI_IR_OPCODE_OPTIONAL_NONE_V1", 21, "optional.none"))
  opcode.add(new IrDomainEntry("OptionalSome", "NERI_IR_OPCODE_OPTIONAL_SOME_V1", 22, "optional.some"))
  opcode.add(new IrDomainEntry("OptionalIsSome", "NERI_IR_OPCODE_OPTIONAL_IS_SOME_V1", 23, "optional.is-some"))
  opcode.add(new IrDomainEntry("OptionalGetChecked", "NERI_IR_OPCODE_OPTIONAL_GET_CHECKED_V1", 24, "optional.get.checked"))
  opcode.add(new IrDomainEntry("StringConcat", "NERI_IR_OPCODE_STRING_CONCAT_V1", 25, "string.concat"))
  opcode.add(new IrDomainEntry("StringEqual", "NERI_IR_OPCODE_STRING_EQUAL_V1", 26, "string.equal"))
  opcode.add(new IrDomainEntry("StringNotEqual", "NERI_IR_OPCODE_STRING_NOT_EQUAL_V1", 27, "string.not-equal"))
  opcode.add(new IrDomainEntry("Call", "NERI_IR_OPCODE_CALL_V1", 28, "call"))
  opcode.add(new IrDomainEntry("CallDirect", "NERI_IR_OPCODE_CALL_DIRECT_V1", 29, "call.direct"))
  opcode.add(new IrDomainEntry("CallVirtual", "NERI_IR_OPCODE_CALL_VIRTUAL_V1", 30, "call.virtual"))
  opcode.add(new IrDomainEntry("CallImport", "NERI_IR_OPCODE_CALL_IMPORT_V1", 31, "call.import"))
  opcode.add(new IrDomainEntry("CallUnsafe", "NERI_IR_OPCODE_CALL_UNSAFE_V1", 32, "call.unsafe", true))
  opcode.add(new IrDomainEntry("CallCAbi", "NERI_IR_OPCODE_CALL_C_ABI_V1", 33, "call.cabi", true))
  opcode.add(new IrDomainEntry("ArrayNew", "NERI_IR_OPCODE_ARRAY_NEW_V1", 34, "array.new"))
  opcode.add(new IrDomainEntry("ArrayLength", "NERI_IR_OPCODE_ARRAY_LENGTH_V1", 35, "array.length"))
  opcode.add(new IrDomainEntry("ArrayLoadChecked", "NERI_IR_OPCODE_ARRAY_LOAD_CHECKED_V1", 36, "array.load.checked"))
  opcode.add(new IrDomainEntry("ArrayStoreChecked", "NERI_IR_OPCODE_ARRAY_STORE_CHECKED_V1", 37, "array.store.checked"))
  opcode.add(new IrDomainEntry("ObjectAlloc", "NERI_IR_OPCODE_OBJECT_ALLOC_V1", 38, "object.alloc"))
  opcode.add(new IrDomainEntry("FieldLoad", "NERI_IR_OPCODE_FIELD_LOAD_V1", 39, "field.load"))
  opcode.add(new IrDomainEntry("FieldStore", "NERI_IR_OPCODE_FIELD_STORE_V1", 40, "field.store"))
  opcode.add(new IrDomainEntry("UnsafeBegin", "NERI_IR_OPCODE_UNSAFE_BEGIN_V1", 41, "unsafe.begin"))
  opcode.add(new IrDomainEntry("UnsafeEnd", "NERI_IR_OPCODE_UNSAFE_END_V1", 42, "unsafe.end", true))
  opcode.add(new IrDomainEntry("StackAlloc", "NERI_IR_OPCODE_STACK_ALLOC_V1", 43, "stack.alloc", true))
  opcode.add(new IrDomainEntry("PointerLoad", "NERI_IR_OPCODE_POINTER_LOAD_V1", 44, "pointer.load", true))
  opcode.add(new IrDomainEntry("PointerStore", "NERI_IR_OPCODE_POINTER_STORE_V1", 45, "pointer.store", true))
  opcode.add(new IrDomainEntry("PointerOffset", "NERI_IR_OPCODE_POINTER_OFFSET_V1", 46, "pointer.offset", true))
  opcode.add(new IrDomainEntry("PointerDifference", "NERI_IR_OPCODE_POINTER_DIFFERENCE_V1", 47, "pointer.difference", true))
  opcode.add(new IrDomainEntry("PointerCompare", "NERI_IR_OPCODE_POINTER_COMPARE_V1", 48, "pointer.compare", true))
  opcode.add(new IrDomainEntry("PointerCast", "NERI_IR_OPCODE_POINTER_CAST_V1", 49, "pointer.cast", true))
  opcode.add(new IrDomainEntry("NativeAlloc", "NERI_IR_OPCODE_NATIVE_ALLOC_V1", 50, "native.alloc", true))
  opcode.add(new IrDomainEntry("NativeRealloc", "NERI_IR_OPCODE_NATIVE_REALLOC_V1", 51, "native.realloc", true))
  opcode.add(new IrDomainEntry("NativeFree", "NERI_IR_OPCODE_NATIVE_FREE_V1", 52, "native.free", true))
  opcode.add(new IrDomainEntry("BorrowBegin", "NERI_IR_OPCODE_BORROW_BEGIN_V1", 53, "borrow.begin", true))
  opcode.add(new IrDomainEntry("BorrowEnd", "NERI_IR_OPCODE_BORROW_END_V1", 54, "borrow.end", true))
  opcode.add(new IrDomainEntry("StringFromInt", "NERI_IR_OPCODE_STRING_FROM_INT_V1", 55, "string.from-int"))
  opcode.add(new IrDomainEntry("StringFromByte", "NERI_IR_OPCODE_STRING_FROM_BYTE_V1", 56, "string.from-byte"))
  opcode.add(new IrDomainEntry("StringFromFloat", "NERI_IR_OPCODE_STRING_FROM_FLOAT_V1", 57, "string.from-float"))
  opcode.add(new IrDomainEntry("NumericCastChecked", "NERI_IR_OPCODE_NUMERIC_CAST_CHECKED_V1", 58, "numeric.cast.checked"))
  opcode.add(new IrDomainEntry("NativeFieldAddress", "NERI_IR_OPCODE_NATIVE_FIELD_ADDRESS_V1", 59, "native.field.address", true))
  opcode.add(new IrDomainEntry("NativeIndexAddressChecked", "NERI_IR_OPCODE_NATIVE_INDEX_ADDRESS_CHECKED_V1", 60, "native.index.address.checked", true))
  opcode.add(new IrDomainEntry("TaskGenerate", "NERI_IR_OPCODE_TASK_GENERATE_V1", 61, "task.generate", true))
  opcode.add(new IrDomainEntry("CFunctionAddress", "NERI_IR_OPCODE_C_FUNCTION_ADDRESS_V1", 62, "cabi.address"))
  opcode.add(new IrDomainEntry("CallCIndirect", "NERI_IR_OPCODE_CALL_C_INDIRECT_V1", 63, "call.cabi.indirect", true))
  terminatorKind.next = opcode

  let cleanupKind = new IrDomainDefinition("IrCleanupKind", "ir_cleanup_kind", "", IrDomainWireKind.Internal())

  cleanupKind.add(new IrDomainEntry("EndUnsafe", "", 1, "end-unsafe"))
  cleanupKind.add(new IrDomainEntry("EndBorrow", "", 2, "end-borrow"))
  cleanupKind.add(new IrDomainEntry("CloseResource", "", 3, "close-resource"))
  opcode.next = cleanupKind
  return symbolKind
end
