use host

def abiGeneratedNotice(): String
  return "# Generated by tooling/abi from the declarative ABI catalog. Do not edit.\n"
end

def abiEffectExpression(catalog: AbiCatalog, names: String[]): String
  var result = "new EffectSet()"

  for name in names
    let effect = catalog.effect(name)

    if effect != null
      result = result + ".with" + effect.name + "()"
    end
  end
  return result
end

def abiFeatureExpression(catalog: AbiCatalog, names: String[]): String
  var result = "new RuntimeFeatures()"

  for name in names
    let feature = catalog.feature(name)

    if feature != null
      result = result + ".with" + feature.name + "()"
    end
  end
  return result
end

def abiParameterTypes(types: String[]): String
  var result = "["
  var separator = ""

  for typeName in types
    result = result + separator + "\"" + typeName + "\""
    separator = ", "
  end
  return result + "]"
end

def abiIrTypeExpression(typeName: String): String
  return "irType(\"" + typeName + "\")"
end

def abiIrParameterTypes(types: String[]): String
  var result = "["
  var separator = ""

  for typeName in types
    result = result + separator + abiIrTypeExpression(typeName)
    separator = ", "
  end
  return result + "]"
end

def abiEffectBits(catalog: AbiCatalog, names: String[]): Int
  var result = 0

  for name in names
    let effect = catalog.effect(name)

    if effect != null
      result = result + effect.value
    end
  end
  return result
end

def abiFeatureBits(catalog: AbiCatalog, names: String[]): Int
  var result = 0

  for name in names
    let feature = catalog.feature(name)

    if feature != null
      result = result + feature.value
    end
  end
  return result
end

def abiEmitEffects(catalog: AbiCatalog): String
  var result = abiGeneratedNotice() + "class EffectSet\n  private value: Int = 0\n\n  def bits(): Int\n    return this.value\n  end\n\n  def mergedWith(other: EffectSet): EffectSet\n    var value = this.value\n    var effect = 1\n\n    while effect <= " + (abiMaximumEffect(catalog) as String) + "\n      if other.has(effect) && !this.has(effect)\n        value = value + effect\n      end\n      effect = effect * 2\n    end\n    if value == this.value\n      return this\n    end\n    return this.create(value)\n  end\n\n  def sameAs(other: EffectSet): Bool\n    return this.value == other.value\n  end\n"
  var effect = catalog.firstEffect

  effect = catalog.firstEffect
  while effect != null
    result = result + "\n  def has" + effect.name + "(): Bool\n    return this.has(" + (effect.value as String) + ")\n  end\n\n  def with" + effect.name + "(): EffectSet\n    return this.with(" + (effect.value as String) + ")\n  end\n\n  def without" + effect.name + "(): EffectSet\n    return this.without(" + (effect.value as String) + ")\n  end\n"
    effect = effect.next
  end
  result = result + "\n  def render(): String\n    var result = \"[\"\n    var separator = \"\"\n\n"
  effect = catalog.firstEffect
  while effect != null
    result = result + "    if this.has" + effect.name + "()\n      result = result + separator + \"" + effect.display + "\"\n      separator = \", \"\n    end\n"
    effect = effect.next
  end
  return result + "    return result + \"]\"\n  end\n\n  private def has(effect: Int): Bool\n    let bucket = this.value / effect\n\n    return bucket - (bucket / 2) * 2 == 1\n  end\n\n  private def with(effect: Int): EffectSet\n    if this.has(effect)\n      return this\n    end\n    return this.create(this.value + effect)\n  end\n\n  private def without(effect: Int): EffectSet\n    if !this.has(effect)\n      return this\n    end\n    return this.create(this.value - effect)\n  end\n\n  private def create(value: Int): EffectSet\n    let result = new EffectSet()\n\n    result.value = value\n    return result\n  end\nend\n"
end

def abiEmitFeatures(catalog: AbiCatalog): String
  var result = abiGeneratedNotice() + "class RuntimeFeatures\n  private value: Int = 0\n\n  def bits(): Int\n    return this.value\n  end\n\n  def mergedWith(other: RuntimeFeatures): RuntimeFeatures\n    var value = this.value\n    var feature = 1\n\n    while feature <= " + (abiMaximumFeature(catalog) as String) + "\n      if other.has(feature) && !this.has(feature)\n        value = value + feature\n      end\n      feature = feature * 2\n    end\n    if value == this.value\n      return this\n    end\n    return this.create(value)\n  end\n\n  def sameAs(other: RuntimeFeatures): Bool\n    return this.value == other.value\n  end\n\n  def isSatisfiedByBits(available: Int): Bool\n    var feature = 1\n\n    while feature <= this.value && feature <= 1152921504606846976\n      if this.has(feature) && !this.bitPresent(available, feature)\n        return false\n      end\n      feature = feature * 2\n    end\n    return true\n  end\n"
  var feature = catalog.firstFeature

  feature = catalog.firstFeature
  while feature != null
    result = result + "\n  def has" + feature.name + "(): Bool\n    return this.has(" + (feature.value as String) + ")\n  end\n\n  def with" + feature.name + "(): RuntimeFeatures\n    return this.with(" + (feature.value as String) + ")\n  end\n\n  def without" + feature.name + "(): RuntimeFeatures\n    return this.without(" + (feature.value as String) + ")\n  end\n"
    feature = feature.next
  end
  result = result + "\n  private def has(feature: Int): Bool\n    return this.bitPresent(this.value, feature)\n  end\n\n  private def bitPresent(bits: Int, feature: Int): Bool\n    let bucket = bits / feature\n\n    return bucket - (bucket / 2) * 2 == 1\n  end\n\n  private def with(feature: Int): RuntimeFeatures\n    if this.has(feature)\n      return this\n    end\n    return this.create(this.value + feature)\n  end\n\n  private def without(feature: Int): RuntimeFeatures\n    if !this.has(feature)\n      return this\n    end\n    return this.create(this.value - feature)\n  end\n\n  private def create(value: Int): RuntimeFeatures\n    let result = new RuntimeFeatures()\n\n    result.value = value\n    return result\n  end\nend\n\ndef runtimeAdvertisedFeatures(): RuntimeFeatures\n  return new RuntimeFeatures()"
  feature = catalog.firstFeature
  while feature != null
    if feature.advertised
      result = result + ".with" + feature.name + "()"
    end
    feature = feature.next
  end
  return result + "\nend\n"
end

def abiEmitIntrinsics(catalog: AbiCatalog): String
  var result = abiGeneratedNotice() + "def abiAddSemanticIntrinsics(registry: SemanticIntrinsicRegistry): Void\n"
  var intrinsic = catalog.firstIntrinsic

  while intrinsic != null
    result = result + "  registry.add(new SemanticNativeIntrinsic(\"" + intrinsic.name + "\", \"" + intrinsic.linkName + "\", \"" + intrinsic.resultType + "\", " + abiParameterTypes(intrinsic.parameterTypes) + ", " + abiEffectExpression(catalog, intrinsic.effects) + ", " + (intrinsic.minimumMinor as String) + ", " + abiFeatureExpression(catalog, intrinsic.features)
    if !intrinsic.parallelSafe
      result = result + ", false"
    end
    result = result + "))\n"
    intrinsic = intrinsic.next
  end
  return result + "end\n"
end

def abiEmitRuntimeImports(catalog: AbiCatalog): String
  var result = abiGeneratedNotice() + "class IrRuntimeContract\n  public name: String = \"\"\n  public linkName: String = \"\"\n  public resultType: String = \"void\"\n  public parameterTypes: String[] = []\n  public effects: EffectSet = new EffectSet()\n  public runtimeMinor: Int = 0\n  public runtimeFeatures: RuntimeFeatures = new RuntimeFeatures()\n  public symbolKind: Int = 7\n  public parallelSafe: Bool = false\n\n  def init(name: String, linkName: String, resultType: String, parameterTypes: String[], effects: EffectSet, runtimeMinor: Int, runtimeFeatures: RuntimeFeatures, symbolKind: Int, parallelSafe: Bool = false): Void\n    this.name = name\n    this.linkName = linkName\n    this.resultType = resultType\n    this.parameterTypes = parameterTypes\n    this.effects = effects\n    this.runtimeMinor = runtimeMinor\n    this.runtimeFeatures = runtimeFeatures\n    this.symbolKind = symbolKind\n    this.parallelSafe = parallelSafe\n  end\nend\n\ndef abiRuntimeContract(name: String): IrRuntimeContract?\n"
  var runtimeImport = catalog.firstRuntimeImport

  while runtimeImport != null
    result = result + "  if name == \"" + runtimeImport.name + "\" || name == \"" + runtimeImport.linkName + "\"\n    return new IrRuntimeContract(name, \"" + runtimeImport.linkName + "\", " + abiIrTypeExpression(runtimeImport.resultType) + ", " + abiIrParameterTypes(runtimeImport.parameterTypes) + ", " + abiEffectExpression(catalog, runtimeImport.effects) + ", " + (runtimeImport.minimumMinor as String) + ", " + abiFeatureExpression(catalog, runtimeImport.features) + ", " + (runtimeImport.symbolKind as String)
    if runtimeImport.parallelSafe
      result = result + ", true"
    end
    result = result + ")\n  end\n"
    runtimeImport = runtimeImport.next
  end
  return result + "  return null\nend\n"
end

def abiRequirementCondition(rule: AbiRequirementRule): String
  if rule.prefix
    return "abiRuntimeStartsWith(linkName, \"" + rule.linkName + "\")"
  end
  return "linkName == \"" + rule.linkName + "\""
end

def abiEmitRuntimeRequirements(catalog: AbiCatalog): String
  var result = abiGeneratedNotice() + "use host\n\ndef abiRuntimeStartsWith(text: String, prefix: String): Bool\n  let prefixLength = host.stringByteLength(prefix)\n\n  return host.stringByteLength(text) >= prefixLength && host.stringSlice(text, 0, prefixLength) == prefix\nend\n\ndef abiRuntimeSymbolMinimumMinor(linkName: String): Int\n  var result = 0\n"
  var rule = catalog.firstRequirement

  while rule != null
    if rule.minimumMinor > 0
      result = result + "\n  if " + abiRequirementCondition(rule) + " && result < " + (rule.minimumMinor as String) + "\n    result = " + (rule.minimumMinor as String) + "\n  end"
    end
    rule = rule.next
  end
  result = result + "\n  return result\nend\n\ndef abiRuntimeSymbolFeatures(linkName: String): RuntimeFeatures\n  var result = new RuntimeFeatures()\n"
  rule = catalog.firstRequirement
  while rule != null
    if rule.feature != ""
      let feature = catalog.feature(rule.feature)

      if feature != null
        result = result + "\n  if " + abiRequirementCondition(rule) + "\n    result = result.with" + feature.name + "()\n  end"
      end
    end
    rule = rule.next
  end
  return result + "\n  return result\nend\n"
end

def abiCFeatureValue(feature: AbiFeature): String
  if feature.value == 1
    return "UINT64_C(1)"
  end
  var bit = 0
  var value = feature.value

  while value > 1
    value = value / 2
    bit = bit + 1
  end
  return "(UINT64_C(1) << " + (bit as String) + ")"
end

def abiCCondition(rule: AbiRequirementRule): String
  if rule.prefix
    return "strncmp(link_name, \"" + rule.linkName + "\", sizeof(\"" + rule.linkName + "\") - 1U) == 0"
  end
  return "strcmp(link_name, \"" + rule.linkName + "\") == 0"
end

def abiEmitCHeader(catalog: AbiCatalog): String
  var result = "/* Generated by tooling/abi from the declarative ABI catalog. Do not edit. */\n#ifndef NERI_ABI_CATALOG_H\n#define NERI_ABI_CATALOG_H\n\n#include <stdint.h>\n#include <string.h>\n\n#define NERI_RUNTIME_ABI_MAJOR UINT16_C(" + (catalog.major as String) + ")\n#define NERI_RUNTIME_ABI_MINOR UINT16_C(" + (catalog.minor as String) + ")\n\nenum neri_ir_effect_v1 {\n"
  var effect = catalog.firstEffect
  var separator = ""

  while effect != null
    result = result + separator + "  " + effect.cName + " = UINT32_C(" + (effect.value as String) + ")"
    separator = ",\n"
    effect = effect.next
  end
  result = result + "\n};\n\n"
  var feature = catalog.firstFeature

  while feature != null
    result = result + "#define " + feature.cName + " " + abiCFeatureValue(feature) + "\n"
    feature = feature.next
  end
  result = result + "#define NERI_RT_ADVERTISED_FEATURES UINT64_C(" + (abiAdvertisedFeatureBits(catalog) as String) + ")\n\nstatic inline uint16_t neri_abi_symbol_minimum_minor(const char *link_name) {\n  uint16_t result = UINT16_C(0);\n  if (link_name == NULL) return result;\n"
  var rule = catalog.firstRequirement

  while rule != null
    if rule.minimumMinor > 0
      result = result + "  if (" + abiCCondition(rule) + " && result < UINT16_C(" + (rule.minimumMinor as String) + ")) result = UINT16_C(" + (rule.minimumMinor as String) + ");\n"
    end
    rule = rule.next
  end
  result = result + "  return result;\n}\n\nstatic inline uint64_t neri_abi_symbol_features(const char *link_name) {\n  uint64_t result = UINT64_C(0);\n  if (link_name == NULL) return result;\n"
  rule = catalog.firstRequirement
  while rule != null
    if rule.feature != ""
      let feature = catalog.feature(rule.feature)

      if feature != null
        result = result + "  if (" + abiCCondition(rule) + ") result |= " + feature.cName + ";\n"
      end
    end
    rule = rule.next
  end
  return result + "  return result;\n}\n\n#endif\n"
end

def abiCTypeName(typeName: String): String
  if typeName == "Void"
    return "void"
  end
  if typeName == "Bool"
    return "bool"
  end
  if typeName == "Byte"
    return "byte"
  end
  if typeName == "Int"
    return "int"
  end
  if typeName == "Float"
    return "float"
  end
  return "string"
end

def abiCTypeExpression(typeName: String): String
  let length = host.stringByteLength(typeName)

  if length > 1 && host.stringSlice(typeName, length - 1, 1) == "?"
    return "{ NERI_IR_TYPE_OPTIONAL_V1, &neri_abi_type_" + abiCTypeName(host.stringSlice(typeName, 0, length - 1)) + "_v1 }"
  end
  if length > 2 && host.stringSlice(typeName, length - 2, 2) == "[]"
    return "{ NERI_IR_TYPE_ARRAY_V1, &neri_abi_type_" + abiCTypeName(host.stringSlice(typeName, 0, length - 2)) + "_v1 }"
  end
  return "{ NERI_IR_TYPE_" + (typeName == "Int" ? "INT" : typeName == "Bool" ? "BOOL" : typeName == "Byte" ? "BYTE" : typeName == "Float" ? "FLOAT" : typeName == "String" ? "STRING" : "VOID") + "_V1, NULL }"
end

def abiCParameters(linkName: String, parameterTypes: String[]): String
  if parameterTypes.Length == 0
    return ""
  end
  var result = "static const struct neri_abi_type_v1 neri_abi_parameters_" + linkName + "[] = {\n"

  for typeName in parameterTypes
    result = result + "  " + abiCTypeExpression(typeName) + ",\n"
  end
  return result + "};\n"
end

def abiCImportEntry(catalog: AbiCatalog, linkName: String, resultType: String, parameterTypes: String[], effects: String[], minimumMinor: Int, features: String[]): String
  let parameters = parameterTypes.Length == 0 ? "NULL" : "neri_abi_parameters_" + linkName

  return "  { \"" + linkName + "\", " + parameters + ", UINT32_C(" + (parameterTypes.Length as String) + "), " + abiCTypeExpression(resultType) + ", UINT32_C(" + (abiEffectBits(catalog, effects) as String) + "), UINT16_C(" + (minimumMinor as String) + "), UINT64_C(" + (abiFeatureBits(catalog, features) as String) + ") },\n"
end

def abiEmitCRuntimeImports(catalog: AbiCatalog): String
  var result = "/* Generated by tooling/abi from the declarative ABI catalog. Do not edit. */\n#ifndef NERI_ABI_RUNTIME_IMPORTS_H\n#define NERI_ABI_RUNTIME_IMPORTS_H\n\n#include <stddef.h>\n#include <stdint.h>\n#include <string.h>\n\n#include \"neri/abi_catalog.h\"\n#include \"neri/ir_transport.h\"\n\nstruct neri_abi_type_v1 {\n  uint8_t tag;\n  const struct neri_abi_type_v1 *argument;\n};\n\nstruct neri_abi_runtime_import_v1 {\n  const char *link_name;\n  const struct neri_abi_type_v1 *parameter_types;\n  uint32_t parameter_count;\n  struct neri_abi_type_v1 result_type;\n  uint32_t effects;\n  uint16_t minimum_minor;\n  uint64_t feature_bits;\n};\n\nstatic const struct neri_abi_type_v1 neri_abi_type_bool_v1 = { NERI_IR_TYPE_BOOL_V1, NULL };\nstatic const struct neri_abi_type_v1 neri_abi_type_byte_v1 = { NERI_IR_TYPE_BYTE_V1, NULL };\nstatic const struct neri_abi_type_v1 neri_abi_type_int_v1 = { NERI_IR_TYPE_INT_V1, NULL };\nstatic const struct neri_abi_type_v1 neri_abi_type_float_v1 = { NERI_IR_TYPE_FLOAT_V1, NULL };\nstatic const struct neri_abi_type_v1 neri_abi_type_string_v1 = { NERI_IR_TYPE_STRING_V1, NULL };\n\n"
  var intrinsic = catalog.firstIntrinsic

  while intrinsic != null
    result = result + abiCParameters(intrinsic.linkName, intrinsic.parameterTypes)
    intrinsic = intrinsic.next
  end
  var runtimeImport = catalog.firstRuntimeImport

  while runtimeImport != null
    result = result + abiCParameters(runtimeImport.linkName, runtimeImport.parameterTypes)
    runtimeImport = runtimeImport.next
  end
  result = result + "\nstatic const struct neri_abi_runtime_import_v1 neri_abi_runtime_imports_v1[] = {\n"
  intrinsic = catalog.firstIntrinsic
  while intrinsic != null
    result = result + abiCImportEntry(catalog, intrinsic.linkName, intrinsic.resultType, intrinsic.parameterTypes, intrinsic.effects, intrinsic.minimumMinor, intrinsic.features)
    intrinsic = intrinsic.next
  end
  runtimeImport = catalog.firstRuntimeImport
  while runtimeImport != null
    result = result + abiCImportEntry(catalog, runtimeImport.linkName, runtimeImport.resultType, runtimeImport.parameterTypes, runtimeImport.effects, runtimeImport.minimumMinor, runtimeImport.features)
    runtimeImport = runtimeImport.next
  end
  return result + "};\n\nstatic inline const struct neri_abi_runtime_import_v1 *neri_abi_runtime_import(const char *link_name) {\n  if (link_name == NULL) return NULL;\n  for (size_t index = 0; index < sizeof(neri_abi_runtime_imports_v1) / sizeof(neri_abi_runtime_imports_v1[0]); ++index) {\n    if (strcmp(link_name, neri_abi_runtime_imports_v1[index].link_name) == 0) return &neri_abi_runtime_imports_v1[index];\n  }\n  return NULL;\n}\n\n#endif\n"
end

def abiOutputPath(root: String, name: String): String
  if name == "effects"
    return root + "/compiler/abi/effects.hk"
  end
  if name == "features"
    return root + "/compiler/abi/features.hk"
  end
  if name == "intrinsics"
    return root + "/compiler/abi/intrinsics.hk"
  end
  if name == "runtime-requirements"
    return root + "/compiler/abi/runtime_requirements.hk"
  end
  if name == "runtime-imports"
    return root + "/compiler/abi/runtime_imports.hk"
  end
  if name == "c-runtime-imports"
    return root + "/native/include/neri/abi_runtime_imports.h"
  end
  return root + "/native/include/neri/abi_catalog.h"
end

def abiPublishOutput(root: String, name: String, value: String, write: Bool): String
  let path = abiOutputPath(root, name)

  if write
    if !host.writeText(path, value)
      return "Cannot write generated ABI catalog output: " + path
    end
  else
    let current = host.readText(path)

    if current == null || current != value
      return "Generated ABI catalog output is stale: " + path
    end
  end
  return ""
end

def abiGenerate(root: String, write: Bool): String
  let catalog = abiCatalog()
  let validation = abiCatalogValidate(catalog)

  if validation != ""
    return validation
  end
  var error = abiPublishOutput(root, "effects", abiEmitEffects(catalog), write)

  error = abiPublishOutput(root, "features", abiEmitFeatures(catalog), write) if error == ""
  error = abiPublishOutput(root, "intrinsics", abiEmitIntrinsics(catalog), write) if error == ""
  error = abiPublishOutput(root, "runtime-imports", abiEmitRuntimeImports(catalog), write) if error == ""
  error = abiPublishOutput(root, "runtime-requirements", abiEmitRuntimeRequirements(catalog), write) if error == ""
  error = abiPublishOutput(root, "header", abiEmitCHeader(catalog), write) if error == ""
  error = abiPublishOutput(root, "c-runtime-imports", abiEmitCRuntimeImports(catalog), write) if error == ""
  return error
end
