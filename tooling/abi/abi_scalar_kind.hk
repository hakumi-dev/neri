enum AbiScalarKind
  case Bool()
  case Byte()
  case Int()
  case Float()
  case String()
end

def abiScalarName(kind: AbiScalarKind): String
  match kind
    case AbiScalarKind.Bool()
      return "Bool"
    case AbiScalarKind.Byte()
      return "Byte"
    case AbiScalarKind.Int()
      return "Int"
    case AbiScalarKind.Float()
      return "Float"
    case AbiScalarKind.String()
      return "String"
  end
end

def abiScalarCName(kind: AbiScalarKind): String
  match kind
    case AbiScalarKind.Bool()
      return "bool"
    case AbiScalarKind.Byte()
      return "byte"
    case AbiScalarKind.Int()
      return "int"
    case AbiScalarKind.Float()
      return "float"
    case AbiScalarKind.String()
      return "string"
  end
end

def abiScalarCTag(kind: AbiScalarKind): String
  match kind
    case AbiScalarKind.Bool()
      return "BOOL"
    case AbiScalarKind.Byte()
      return "BYTE"
    case AbiScalarKind.Int()
      return "INT"
    case AbiScalarKind.Float()
      return "FLOAT"
    case AbiScalarKind.String()
      return "STRING"
  end
end
