use console
use host

def main(): Void
  let mode = host.argumentAt(0)
  let root = host.argumentAt(1)

  if host.argumentCount() != 2 || mode == null || root == null || (mode != "--write" && mode != "--check")
    console.println("usage: neri-abi-catalog (--write|--check) <repository-root>")
    host.exit(2)
    return
  end
  let error = abiGenerate(root, mode == "--write")

  if error != ""
    console.println(error)
    host.exit(1)
    return
  end
end
