class AbiFeature
  public name: String = ""
  public cName: String = ""
  public value: Int
  public minimumMinor: Int
  public advertised: Bool
  public next: AbiFeature?

  def init(value: Int, minimumMinor: Int, advertised: Bool = true): Void
    this.value = value
    this.minimumMinor = minimumMinor
    this.advertised = advertised
  end

  def define(name: String): Void
    this.name = name
    this.cName = "NERI_RT_FEATURE_" + abiSeparatedName(name, "_", true)
  end
end
