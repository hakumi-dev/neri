class AbiIrFeature
  public name: String
  public wireName: String
  public transportMinor: Int
  public runtimeMinor: Int
  public runtimeFeatures: String[]
  public transportDiagnostic: String

  def init(name: String, wireName: String, transportMinor: Int, runtimeMinor: Int, transportDiagnostic: String, runtimeFeatures: String[] = []): Void
    this.name = name
    this.wireName = wireName
    this.transportMinor = transportMinor
    this.runtimeMinor = runtimeMinor
    this.runtimeFeatures = runtimeFeatures
    this.transportDiagnostic = transportDiagnostic
  end
end
