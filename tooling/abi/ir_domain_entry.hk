class IrDomainEntry
  public name: String
  public cName: String
  public code: Int
  public display: String
  public requiresUnsafe: Bool
  public next: IrDomainEntry?

  def init(name: String, cName: String, code: Int, display: String, requiresUnsafe: Bool = false): Void
    this.name = name
    this.cName = cName
    this.code = code
    this.display = display
    this.requiresUnsafe = requiresUnsafe
  end
end
