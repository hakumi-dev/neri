class IrDomainDefinition
  public name: String
  public file: String
  public cName: String
  public wireKind: IrDomainWireKind
  public ordered: Bool
  public first: IrDomainEntry?
  public last: IrDomainEntry?
  public next: IrDomainDefinition?

  def init(name: String, file: String, cName: String, wireKind: IrDomainWireKind = IrDomainWireKind.Byte(), ordered: Bool = false): Void
    this.name = name
    this.file = file
    this.cName = cName
    this.wireKind = wireKind
    this.ordered = ordered
  end

  def add(entry: IrDomainEntry): Void
    let last = this.last

    if last == null
      this.first = entry
    else
      last.next = entry
    end
    this.last = entry
  end
end
