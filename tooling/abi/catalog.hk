def abiCatalog(): AbiCatalog
  let catalog = new AbiCatalog()
  let effects = catalog.effects
  let features = catalog.features

  compile for field in reflect.fields<AbiEffects>()
    catalog.addEffect(field.read(effects))
  end
  compile for field in reflect.fields<AbiFeatures>()
    catalog.addFeature(field.read(features))
  end

