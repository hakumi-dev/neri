class AbiIntrinsic
  public name: String
  public linkName: String
  public resultType: AbiType
  public parameterTypes: AbiType[]
  public effects: String[]
  public minimumMinor: Int
  public features: String[]
  public parallelSafe: Bool
  public next: AbiIntrinsic?

  def init(name: String, linkName: String, resultType: AbiType, parameterTypes: AbiType[], effects: String[], minimumMinor: Int, features: String[], parallelSafe: Bool = true): Void
    this.name = name
    this.linkName = linkName
    this.resultType = resultType
    this.parameterTypes = parameterTypes
    this.effects = effects
    this.minimumMinor = minimumMinor
    this.features = features
    this.parallelSafe = parallelSafe
  end
end
