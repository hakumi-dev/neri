enum IrDomainWireKind
  case Internal()
  case Byte()
  case UInt16()
end

def irDomainMaximumCode(kind: IrDomainWireKind): Int
  match kind
    case IrDomainWireKind.Internal()
      return 9223372036854775807
    case IrDomainWireKind.Byte()
      return 255
    case IrDomainWireKind.UInt16()
      return 65535
  end
end

def irDomainTransported(kind: IrDomainWireKind): Bool
  match kind
    case IrDomainWireKind.Internal()
      return false
    case IrDomainWireKind.Byte()
      return true
    case IrDomainWireKind.UInt16()
      return true
  end
end
