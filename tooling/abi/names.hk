
def abiSeparatedName(name: String, separator: String, uppercase: Bool): String
  var result = ""
  var index = 0
  let length = host::stringByteLength(name)

  while index < length
    let byte = host::stringByteAt(name, index) as Int
    let upper = byte >= 65 && byte <= 90

    if upper && index > 0
      let previous = host::stringByteAt(name, index - 1) as Int
      let next = index + 1 < length ? host::stringByteAt(name, index + 1) as Int : 0

      if (previous >= 97 && previous <= 122) || (previous >= 48 && previous <= 57) || (next >= 97 && next <= 122)
        result = result + separator
      end
    end
    if uppercase && byte >= 97 && byte <= 122
      result = result + host::stringSlice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", byte - 97, 1)
    else if !uppercase && upper
      result = result + host::stringSlice("abcdefghijklmnopqrstuvwxyz", byte - 65, 1)
    else
      result = result + host::stringSlice(name, index, 1)
    end
    index = index + 1
  end
  return result
end
