class AbiEffects
  public Read: AbiEffect = new AbiEffect(1)
  public Write: AbiEffect = new AbiEffect(2)
  public MayPanic: AbiEffect = new AbiEffect(4)
  public ManagedAllocate: AbiEffect = new AbiEffect(8, "managed-alloc")
  public NativeAllocate: AbiEffect = new AbiEffect(16, "native-alloc")
  public Safepoint: AbiEffect = new AbiEffect(32)
  public Unsafe: AbiEffect = new AbiEffect(64)
  public NoReturn: AbiEffect = new AbiEffect(128, "noreturn")

  def init(): Void
    compile for field in reflect.fields<AbiEffects>()
      field.read(this).define(field.name)
    end
  end
end
