use host
use process

def irDomainField(domain: IrDomainDefinition): String
  return process.asciiLower(host.stringSlice(domain.name, 2, 1)) + host.stringSlice(domain.name, 3, host.stringByteLength(domain.name) - 3)
end

def irDomainIdentifier(value: String, prefix: String): Bool
  return abiCatalogIdentifier(value) && host.stringByteLength(value) > host.stringByteLength(prefix) && host.stringSlice(value, 0, host.stringByteLength(prefix)) == prefix
end

def irDomainValidate(first: IrDomainDefinition): String
  var domain: IrDomainDefinition? = first

  while domain != null
    let transported = irDomainTransported(domain.wireKind)

    if !irDomainIdentifier(domain.name, "Ir") || !irDomainIdentifier(domain.file, "ir_") || (transported && !irDomainIdentifier(domain.cName, "neri_ir_")) || (!transported && domain.cName != "")
      return "Invalid IR domain identifier: " + domain.name
    end
    if domain.first == null
      return "IR domain has no entries: " + domain.name
    end
    var entry = domain.first

    while entry != null
      if entry.code < 1 || entry.code > irDomainMaximumCode(domain.wireKind) || !abiCatalogIdentifier(entry.name) || (transported && !irDomainIdentifier(entry.cName, "NERI_IR_")) || (!transported && entry.cName != "") || (entry.requiresUnsafe && domain.name != "IrOpcode")
        return "Invalid IR domain entry: " + domain.name + "." + entry.name
      end
      var other = entry.next

      while other != null
        if entry.name == other.name || entry.code == other.code || (domain.cName != "" && entry.cName == other.cName)
          return "Duplicate IR domain entry: " + domain.name + "." + entry.name
        end
        other = other.next
      end
      entry = entry.next
    end
    var otherDomain = domain.next

    while otherDomain != null
      if domain.name == otherDomain.name || domain.name + "Catalog" == otherDomain.name || domain.name == otherDomain.name + "Catalog" || domain.file == otherDomain.file || domain.file + "_catalog" == otherDomain.file || domain.file == otherDomain.file + "_catalog" || (domain.cName != "" && domain.cName == otherDomain.cName)
        return "Duplicate IR domain: " + domain.name
      end
      var left = domain.first

      while left != null
        var right = otherDomain.first

        while right != null
          if left.cName != "" && left.cName == right.cName
            return "Duplicate IR domain C identifier: " + left.cName
          end
          right = right.next
        end
        left = left.next
      end
      otherDomain = otherDomain.next
    end
    domain = domain.next
  end
  return ""
end

def irDomainHeader(): String
  return "# Generated by tooling/abi from ir_domains.hk. Do not edit.\n"
end

def irEmitDomain(domain: IrDomainDefinition): String
  let name = domain.name
  var result = irDomainHeader() + "sealed class " + name + "\n  private tag: Int\n  private display: String\n\n  private def init(tag: Int, display: String): Void\n    this.tag = tag\n    this.display = display\n  end\n\n  readonly def same(other: readonly " + name + "): Bool\n    return this.tag == other.tag\n  end\n\n  readonly def displayName(): String\n    return this.display\n  end\n"

  if domain.ordered
    result = result + "\n  readonly def precedes(other: readonly " + name + "): Bool\n    return this.tag < other.tag\n  end\n"
  end
  if domain.cName != ""
    result = result + "\n  readonly def wireCode(): Int\n    return this.tag\n  end\n"
  end
  result = result + "\n  static def createCatalog(): " + name + "[]\n    return ["
  var entry = domain.first
  var first = true

  while entry != null
    result = result + (first ? "" : ", ") + "new " + name + "(" + (entry.code as String) + ", " + abiNeriString(entry.display) + ")"
    first = false
    entry = entry.next
  end
  result = result + "]\n  end\n"
  entry = domain.first
  while entry != null
    result = result + "\n  readonly def is" + entry.name + "(): Bool\n    return this.tag == " + (entry.code as String) + "\n  end\n"
    entry = entry.next
  end
  if domain.name == "IrOpcode"
    result = result + "\n  readonly def requiresUnsafeCapability(): Bool\n    return "
    entry = domain.first
    first = true
    while entry != null
      if entry.requiresUnsafe
        result = result + (first ? "" : " || ") + "this.is" + entry.name + "()"
        first = false
      end
      entry = entry.next
    end
    result = result + "\n  end\n"
  end
  return result + "end\n"
end

def irEmitDomainCatalog(domain: IrDomainDefinition): String
  var result = irDomainHeader() + "sealed class " + domain.name + "Catalog\n  private values: " + domain.name + "[] = " + domain.name + ".createCatalog()\n"
  var entry = domain.first
  var index = 0

  while entry != null
    result = result + "\n  readonly def get" + entry.name + "(): readonly " + domain.name + "\n    return this.values[" + (index as String) + "]\n  end\n"
    index = index + 1
    entry = entry.next
  end
  return result + "end\n"
end

def irEmitDomainRegistry(first: IrDomainDefinition): String
  var result = irDomainHeader() + "sealed class IrDomainCatalog\n"
  var domain: IrDomainDefinition? = first

  while domain != null
    result = result + "  public " + irDomainField(domain) + ": " + domain.name + "Catalog = new " + domain.name + "Catalog()\n"
    domain = domain.next
  end
  return result + "end\n"
end

def irEmitNativeDomains(first: IrDomainDefinition): String
  var result = "/* Generated by tooling/abi from ir_domains.hk. Do not edit. */\n#ifndef NERI_IR_DOMAINS_H\n#define NERI_IR_DOMAINS_H\n"
  var domain: IrDomainDefinition? = first

  while domain != null
    if domain.cName != ""
      result = result + "\nenum " + domain.cName + " {\n"
      var entry = domain.first

      while entry != null
        result = result + "  " + entry.cName + " = " + (entry.code as String) + ",\n"
        entry = entry.next
      end
      result = result + "};\n"
    end
    domain = domain.next
  end
  return result + "\n#endif\n"
end

def irPublishDomain(path: String, value: String, write: Bool): String
  if write
    if !host.writeText(path, value)
      return "Cannot write generated IR domain: " + path
    end
  else
    let current = host.readText(path)

    if current == null || current != value
      return "Generated IR domain is stale: " + path
    end
  end
  return ""
end

def irGenerateDomains(root: String, write: Bool): String
  let first = irDomainDefinitions()
  var error = irDomainValidate(first)
  var domain: IrDomainDefinition? = first

  while domain != null && error == ""
    error = irPublishDomain(root + "/compiler/ir/" + domain.file + ".hk", irEmitDomain(domain), write)
    error = irPublishDomain(root + "/compiler/ir/" + domain.file + "_catalog.hk", irEmitDomainCatalog(domain), write) if error == ""
    domain = domain.next
  end
  error = irPublishDomain(root + "/compiler/ir/ir_domain_catalog.hk", irEmitDomainRegistry(first), write) if error == ""
  error = irPublishDomain(root + "/native/include/neri/ir_domains.h", irEmitNativeDomains(first), write) if error == ""
  return error
end
