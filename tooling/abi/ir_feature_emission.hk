def abiEmitIrFeatureSet(catalog: AbiCatalog, features: AbiIrFeature[]): String
  var result = abiGeneratedNotice() + "use host\n\nclass IrFeatureSet\n"

  for feature in features
    result = result + "  private requires" + feature.name + ": Bool = false\n"
  end
  for feature in features
    result = result + "\n  def has" + feature.name + "(): Bool\n    return this.requires" + feature.name + "\n  end\n\n  def require" + feature.name + "(): Void\n    this.requires" + feature.name + " = true\n  end\n"
  end
  result = result + "\n  def merge(other: IrFeatureSet): Void\n"
  for feature in features
    result = result + "    this.requires" + feature.name + " = true if other.has" + feature.name + "()\n"
  end
  result = result + "  end\n\n  def orderedNames(): String[]\n    var result: String[] = []\n\n"
  for feature in features
    result = result + "    result = host::appendString(result, \"" + feature.wireName + "\") if this.requires" + feature.name + "\n"
  end
  result = result + "    return result\n  end\n\n  def minimumTransportMinor(): Int\n    var result = 1\n\n"
  for feature in features
    result = result + "    result = " + (feature.transportMinor as String) + " if this.requires" + feature.name + " && result < " + (feature.transportMinor as String) + "\n"
  end
  result = result + "    return result\n  end\n\n  def minimumRuntimeMinor(): Int\n    var result = 1\n\n"
  for feature in features
    result = result + "    result = " + (feature.runtimeMinor as String) + " if this.requires" + feature.name + " && result < " + (feature.runtimeMinor as String) + "\n"
  end
  result = result + "    return result\n  end\n\n  def runtimeFeatures(): RuntimeFeatures\n    var result = new RuntimeFeatures()\n\n"
  for feature in features
    if feature.runtimeFeatures.Length != 0
      result = result + "    result = result.mergedWith(" + abiFeatureExpression(catalog, feature.runtimeFeatures) + ") if this.requires" + feature.name + "\n"
    end
  end
  return result + "    return result\n  end\nend\n"
end

def abiEmitCIrFeatures(catalog: AbiCatalog, features: AbiIrFeature[]): String
  var result = "/* Generated by tooling/abi. Do not edit. */\n#ifndef NERI_IR_FEATURES_H\n#define NERI_IR_FEATURES_H\n\n#include <array>\n#include <cstdint>\n#include <optional>\n#include <stdexcept>\n#include <string_view>\n\nnamespace neri::codegen {\n\nenum class ir_feature : std::uint8_t {\n"

  for feature in features
    result = result + "  " + feature.name + ",\n"
  end
  result = result + "};\n\nstruct ir_feature_contract final {\n  ir_feature feature;\n  std::string_view name;\n  std::uint16_t transport_minor;\n  std::uint16_t runtime_minor;\n  std::uint64_t runtime_features;\n  std::string_view transport_diagnostic;\n};\n\ninline constexpr std::array<ir_feature_contract, " + (features.Length as String) + "> ir_feature_contracts{{\n"
  for feature in features
    result = result + "  {ir_feature::" + feature.name + ", \"" + feature.wireName + "\", " + (feature.transportMinor as String) + ", " + (feature.runtimeMinor as String) + ", UINT64_C(" + (abiFeatureBits(catalog, feature.runtimeFeatures) as String) + "), " + abiLiteral(feature.transportDiagnostic) + "},\n"
  end
  result = result + "}};\n\ninline constexpr std::optional<ir_feature> ir_feature_from_name(std::string_view name) {\n  for (const auto &contract : ir_feature_contracts) {\n    if (contract.name == name) return contract.feature;\n  }\n  return std::nullopt;\n}\n\ninline constexpr const ir_feature_contract &ir_feature_metadata(ir_feature feature) {\n  switch (feature) {\n"
  var index = 0

  for feature in features
    result = result + "  case ir_feature::" + feature.name + ": return ir_feature_contracts[" + (index as String) + "];\n"
    index = index + 1
  end
  return result + "  }\n  throw std::invalid_argument(\"Unknown IR feature.\");\n}\n\ninline constexpr std::string_view ir_feature_name(ir_feature feature) {\n  return ir_feature_metadata(feature).name;\n}\n\n} // namespace neri::codegen\n\n#endif\n"
end
