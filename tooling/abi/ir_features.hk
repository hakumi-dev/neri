use host

def abiIrFeatures(): AbiIrFeature[]
  return [
    new AbiIrFeature("CInterop", "c-interop-v1", 8, 27, "C interoperability requires IR transport 1.8."),
    new AbiIrFeature("DebugScopes", "debug-scopes-v1", 6, 1, "Debug scopes require IR transport 1.6."),
    new AbiIrFeature("ExtendedScalars", "extended-scalars-v1", 2, 9, "Extended scalars require transport 1.2.", ["ExtendedScalars"]),
    new AbiIrFeature("IsolatedWorkers", "isolated-workers-v1", 9, 32, "Isolated workers require IR transport 1.9.", ["IsolatedWorkers"]),
    new AbiIrFeature("NativeLibraries", "native-libraries-v1", 2, 1, "Native libraries require IR transport 1.2."),
    new AbiIrFeature("NativeRecords", "native-records-v1", 3, 1, "Native records require transport 1.3."),
    new AbiIrFeature("NativeStrings", "native-strings-v1", 1, 2, "Native strings require IR transport 1.1.", ["NativeStrings"]),
    new AbiIrFeature("RetainedModules", "retained-modules-v1", 7, 1, "Retained modules require IR transport 1.7."),
    new AbiIrFeature("ScopedTasks", "scoped-tasks-v1", 4, 10, "Scoped tasks require IR transport 1.4.", ["ScopedTasks"]),
    new AbiIrFeature("SequentialArrays", "sequential-arrays-v1", 8, 29, "Sequential array generation requires IR transport 1.8.", ["SequentialArrays"]),
    new AbiIrFeature("SessionModule", "session-module-v1", 5, 19, "Session modules require transport 1.5.", ["SessionModules"]),
    new AbiIrFeature("StringData", "string-data-v1", 1, 1, "String data require IR transport 1.1.")
  ]
end

def abiIrFeatureNameBefore(left: String, right: String): Bool
  var index = 0
  let leftLength = host::stringByteLength(left)
  let rightLength = host::stringByteLength(right)

  while index < leftLength && index < rightLength
    let leftByte = host::stringByteAt(left, index) as Int
    let rightByte = host::stringByteAt(right, index) as Int

    if leftByte != rightByte
      return leftByte < rightByte
    end
    index = index + 1
  end
  return leftLength < rightLength
end

def abiIrFeaturesValidate(catalog: AbiCatalog, features: AbiIrFeature[]): String
  var previous = ""
  var names: String[] = []

  if features.Length == 0
    return "IR feature catalog cannot be empty."
  end
  for feature in features
    if !abiCatalogIdentifier(feature.name) || !abiCatalogSeparatedIdentifier(feature.wireName, 45) || feature.transportMinor < 1 || feature.transportMinor > abiIrTransportMinor() || feature.runtimeMinor < 1 || feature.runtimeMinor > catalog.minor
      return "IR feature '" + feature.name + "' has invalid metadata."
    end
    var offset = 0

    if feature.transportDiagnostic == ""
      return "IR feature '" + feature.name + "' has an empty transport diagnostic."
    end
    while offset < host::stringByteLength(feature.transportDiagnostic)
      let byte = host::stringByteAt(feature.transportDiagnostic, offset) as Int

      if byte < 32 && byte != 9 && byte != 10 && byte != 13
        return "IR feature '" + feature.name + "' has an invalid transport diagnostic."
      end
      offset = offset + 1
    end
    if previous != "" && !abiIrFeatureNameBefore(previous, feature.wireName)
      return "IR feature wire names must be unique and in canonical order."
    end
    for name in names
      if name == feature.name
        return "IR feature '" + feature.name + "' is duplicated."
      end
    end
    names = host::appendString(names, feature.name)
    previous = feature.wireName
    if !abiNamesUnique(feature.runtimeFeatures)
      return "IR feature '" + feature.name + "' repeats a runtime feature."
    end
    for name in feature.runtimeFeatures
      let required = catalog.feature(name)

      if required == null || required.minimumMinor > feature.runtimeMinor
        return "IR feature '" + feature.name + "' has an invalid runtime requirement."
      end
    end
  end
  return ""
end
