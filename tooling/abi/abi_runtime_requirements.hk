class AbiRuntimeRequirements
  public File: AbiRequirementRule
  public FileIdentity: AbiRequirementRule
  public ArrayAllocUninitialized: AbiRequirementRule
  public Region: AbiRequirementRule
  public FileWaitReadable: AbiRequirementRule
  public Interrupt: AbiRequirementRule
  public ClockWall: AbiRequirementRule
  public Crypto: AbiRequirementRule
  public CryptoSha256Begin: AbiRequirementRule
  public CryptoSha256Update: AbiRequirementRule
  public CryptoSha256Finish: AbiRequirementRule
  public CryptoSha256Dispose: AbiRequirementRule
  public FileRoot: AbiRequirementRule
  public Process: AbiRequirementRule
  public ProcessSpawnInput: AbiRequirementRule
  public ProcessInterrupt: AbiRequirementRule
  public FileMutation: AbiRequirementRule
  public NetConnectTimeout: AbiRequirementRule
  public NetLocalPort: AbiRequirementRule
  public NetPollMany: AbiRequirementRule
  public WorkerPoolReadiness: AbiRequirementRule
  public FileDirectory: AbiRequirementRule
  public NetCloseResult: AbiRequirementRule
  public Drain: AbiRequirementRule
  public Session: AbiRequirementRule
  public StdinReadLineOptional: AbiRequirementRule
  public HostCanonicalPath: AbiRequirementRule
  public HostExecutablePath: AbiRequirementRule
  public Foreign: AbiRequirementRule
  public Cache: AbiRequirementRule
  public CacheMetadata: AbiRequirementRule
  public StderrWriteBytes: AbiRequirementRule
  public Terminal: AbiRequirementRule
  public Clock: AbiRequirementRule
  public Net: AbiRequirementRule
  public Worker: AbiRequirementRule

  def init(features: AbiFeatures): Void
    this.File = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 11, features.Files)
    this.FileIdentity = new AbiRequirementRule(AbiRequirementMatch.Exact(), 34)
    this.ArrayAllocUninitialized = new AbiRequirementRule(AbiRequirementMatch.Exact(), 35)
    this.Region = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 36)
    this.FileWaitReadable = new AbiRequirementRule(AbiRequirementMatch.Exact(), 25)
    this.Interrupt = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 12, features.Interrupts)
    this.ClockWall = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 13, features.WallClock)
    this.Crypto = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 14, features.Crypto)
    this.CryptoSha256Begin = new AbiRequirementRule(AbiRequirementMatch.Exact(), 34)
    this.CryptoSha256Update = new AbiRequirementRule(AbiRequirementMatch.Exact(), 34)
    this.CryptoSha256Finish = new AbiRequirementRule(AbiRequirementMatch.Exact(), 34)
    this.CryptoSha256Dispose = new AbiRequirementRule(AbiRequirementMatch.Exact(), 34)
    this.FileRoot = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 15, features.RootedFiles)
    this.Process = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 16, features.Process)
    this.ProcessSpawnInput = new AbiRequirementRule(AbiRequirementMatch.Exact(), 22, features.ProcessIo)
    this.ProcessInterrupt = new AbiRequirementRule(AbiRequirementMatch.Exact(), 22, features.ProcessIo)
    this.FileMutation = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 22, features.FilesystemMutation)
    this.NetConnectTimeout = new AbiRequirementRule(AbiRequirementMatch.Exact(), 22, features.SocketEndpoints)
    this.NetLocalPort = new AbiRequirementRule(AbiRequirementMatch.Exact(), 22, features.SocketEndpoints)
    this.NetPollMany = new AbiRequirementRule(AbiRequirementMatch.Exact(), 33, features.MultiplexedIo)
    this.WorkerPoolReadiness = new AbiRequirementRule(AbiRequirementMatch.Exact(), 33, features.MultiplexedIo)
    this.FileDirectory = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 17, features.Directory)
    this.NetCloseResult = new AbiRequirementRule(AbiRequirementMatch.Exact(), 18, features.SocketCloseResult)
    this.Drain = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 20, features.Drain)
    this.Session = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 19, features.SessionModules)
    this.StdinReadLineOptional = new AbiRequirementRule(AbiRequirementMatch.Exact(), 21, features.OptionalConsoleRead)
    this.HostCanonicalPath = new AbiRequirementRule(AbiRequirementMatch.Exact(), 23, features.BootstrapHost)
    this.HostExecutablePath = new AbiRequirementRule(AbiRequirementMatch.Exact(), 26, features.BootstrapHost)
    this.Foreign = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 27)
    this.Cache = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 28)
    this.CacheMetadata = new AbiRequirementRule(AbiRequirementMatch.Exact(), 28, features.Crypto)
    this.StderrWriteBytes = new AbiRequirementRule(AbiRequirementMatch.Exact(), 28)
    this.Terminal = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 8, features.InteractiveIo)
    this.Clock = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 8, features.InteractiveIo)
    this.Net = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 7, features.Sockets)
    this.Worker = new AbiRequirementRule(AbiRequirementMatch.Prefix(), 32, features.IsolatedWorkers)
    compile for field in reflect.fields<AbiRuntimeRequirements>()
      field.read(this).define(field.name)
    end
  end
end
