enum AbiType
  case Void()
  case Scalar(kind: AbiScalarKind)
  case Optional(kind: AbiScalarKind)
  case Array(kind: AbiScalarKind)
end

def abiTypeName(value: AbiType): String
  match value
    case AbiType.Void()
      return "Void"
    case AbiType.Scalar(kind)
      return abiScalarName(kind)
    case AbiType.Optional(kind)
      return abiScalarName(kind) + "?"
    case AbiType.Array(kind)
      return abiScalarName(kind) + "[]"
  end
end

def abiParameterTypeValid(value: AbiType): Bool
  match value
    case AbiType.Void()
      return false
    case AbiType.Scalar(kind)
      return true
    case AbiType.Optional(kind)
      return true
    case AbiType.Array(kind)
      return true
  end
end

def abiCTypeExpression(value: AbiType): String
  match value
    case AbiType.Void()
      return "{ NERI_IR_TYPE_VOID_V1, NULL }"
    case AbiType.Scalar(kind)
      return "{ NERI_IR_TYPE_" + abiScalarCTag(kind) + "_V1, NULL }"
    case AbiType.Optional(kind)
      return "{ NERI_IR_TYPE_OPTIONAL_V1, &neri_abi_type_" + abiScalarCName(kind) + "_v1 }"
    case AbiType.Array(kind)
      return "{ NERI_IR_TYPE_ARRAY_V1, &neri_abi_type_" + abiScalarCName(kind) + "_v1 }"
  end
end
