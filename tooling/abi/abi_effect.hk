class AbiEffect
  public name: String = ""
  public display: String = ""
  public cName: String = ""
  public value: Int
  public next: AbiEffect?

  def init(value: Int, display: String = ""): Void
    this.display = display
    this.value = value
  end

  def define(name: String): Void
    this.name = name
    this.cName = "NERI_IR_EFFECT_" + abiSeparatedName(name, "_", true) + "_V1"
    if this.display == ""
      this.display = abiSeparatedName(name, "-", false)
    end
  end
end
