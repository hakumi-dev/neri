use host
use test

def abiContainsText(text: String, part: String): Bool
  var offset = 0

  while offset + host.stringByteLength(part) <= host.stringByteLength(text)
    var equal = true
    var index = 0

    while index < host.stringByteLength(part)
      if host.stringByteAt(text, offset + index) != host.stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def main(): Void
  let scratch = host.argumentAt(0)

  test.assertTrue(scratch != null)
  if scratch == null
    return
  end

  let duplicate = abiCatalog()

  duplicate.addEffect(new AbiEffect("Read", "duplicate-read", "NERI_IR_EFFECT_DUPLICATE_READ_V1", 256))

  test.assertEqual(abiCatalogValidate(duplicate), "Effect 'Read' is duplicated.")

  let invalidCName = abiCatalog()
  let invalidCNameEffect = invalidCName.firstEffect

  test.assertTrue(invalidCNameEffect != null)
  if invalidCNameEffect != null
    invalidCNameEffect.cName = "1_INVALID_EFFECT"
  end

  test.assertEqual(abiCatalogValidate(invalidCName), "Effect 'Read' has an invalid canonical value or name.")

  let emptyFeatures = abiCatalog()

  emptyFeatures.firstFeature = null

  test.assertEqual(abiCatalogValidate(emptyFeatures), "ABI catalog sections cannot be empty.")

  let unknownEffect = abiCatalog()
  let intrinsic = unknownEffect.firstIntrinsic

  test.assertTrue(intrinsic != null)
  if intrinsic != null
    intrinsic.effects = ["MissingEffect"]
  end

  test.assertEqual(abiCatalogValidate(unknownEffect), "Intrinsic 'string.concat' references unknown effect 'MissingEffect'.")

  let unknownFeature = abiCatalog()
  let requirement = unknownFeature.firstRequirement

  test.assertTrue(requirement != null)
  if requirement != null
    requirement.feature = "MissingFeature"
  end

  test.assertEqual(abiCatalogValidate(unknownFeature), "Runtime requirement rule references unknown feature 'MissingFeature'.")

  let invalidRuntimeType = abiCatalog()
  let runtimeImport = invalidRuntimeType.firstRuntimeImport

  test.assertTrue(runtimeImport != null)
  if runtimeImport != null
    runtimeImport.parameterTypes = ["String[][]"]
  end

  test.assertEqual(abiCatalogValidate(invalidRuntimeType), "Runtime import 'sessionEnvironmentIdentity' has invalid metadata.")

  let header = abiEmitCRuntimeImports(abiCatalog())

  test.assertTrue(abiContainsText(header, "{ NERI_IR_TYPE_OPTIONAL_V1, &neri_abi_type_string_v1 }"))
  test.assertTrue(abiContainsText(header, "{ NERI_IR_TYPE_ARRAY_V1, &neri_abi_type_byte_v1 }"))
  test.assertTrue(abiContainsText(header, "\"neri_rt_v1_host_exit\""))
  test.assertTrue(abiContainsText(header, "UINT32_C(134)"))

  let root = scratch + "/abi-catalog-contract"
  let created = host.run("mkdir", ["-p", root + "/compiler/abi", root + "/native/include/neri"])

  test.assertTrue(created != null && created == 0)
  test.assertEqual(abiPublishOutput(root, "effects", "current", true), "")
  test.assertEqual(abiPublishOutput(root, "effects", "current", false), "")
  test.assertEqual(abiPublishOutput(root, "effects", "changed", false), "Generated ABI catalog output is stale: " + root + "/compiler/abi/effects.hk")
  test.assertEqual(abiPublishOutput(root, "header", "missing", false), "Generated ABI catalog output is stale: " + root + "/native/include/neri/abi_catalog.h")
  test.assertEqual(abiPublishOutput(root, "c-runtime-imports", "missing", false), "Generated ABI catalog output is stale: " + root + "/native/include/neri/abi_runtime_imports.h")
end
