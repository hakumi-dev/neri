use host
use test

def abiContainsText(text: String, part: String): Bool
  var offset = 0

  while offset + host::stringByteLength(part) <= host::stringByteLength(text)
    var equal = true
    var index = 0

    while index < host::stringByteLength(part)
      if host::stringByteAt(text, offset + index) != host::stringByteAt(part, index)
        equal = false
      end
      index = index + 1
    end
    if equal
      return true
    end
    offset = offset + 1
  end
  return false
end

def irDomainCatalogContracts(): Void
  let domain = new IrDomainDefinition("IrProbe", "ir_probe", "neri_ir_probe", IrDomainWireKind.UInt16())
  let entry = new IrDomainEntry("Probe", "NERI_IR_PROBE", 65535, "line\n\"\\\t\r\0é")

  domain.add(entry)

  test::assertEqual(irDomainValidate(domain), "")
  test::assertTrue(abiContainsText(irEmitDomain(domain), "\"line\\n\\\"\\\\\\t\\r\\0é\""))
  entry.code = 65536

  test::assertEqual(irDomainValidate(domain), "Invalid IR domain entry: IrProbe.Probe")
  domain.wireKind = IrDomainWireKind.Byte()
  entry.code = 256

  test::assertEqual(irDomainValidate(domain), "Invalid IR domain entry: IrProbe.Probe")
  entry.code = 1
  entry.cName = "NERI_IR_PROBE;invalid"

  test::assertEqual(irDomainValidate(domain), "Invalid IR domain entry: IrProbe.Probe")
  entry.cName = "NERI_IR_PROBE"
  domain.file = "../ir_probe"

  test::assertEqual(irDomainValidate(domain), "Invalid IR domain identifier: IrProbe")
end

def main(): Void
  let scratch = host::argumentAt(0)

  test::assertTrue(scratch != null)
  if scratch == null
    return
  end
  irDomainCatalogContracts()

  let duplicate = abiCatalog()

  duplicate.addEffect(new AbiEffect("Read", "duplicate-read", "NERI_IR_EFFECT_DUPLICATE_READ_V1", 256))

  test::assertEqual(abiCatalogValidate(duplicate), "Effect 'Read' is duplicated.")

  let invalidCName = abiCatalog()
  let invalidCNameEffect = invalidCName.firstEffect

  test::assertTrue(invalidCNameEffect != null)
  if invalidCNameEffect != null
    invalidCNameEffect.cName = "1_INVALID_EFFECT"
  end

  test::assertEqual(abiCatalogValidate(invalidCName), "Effect 'Read' has an invalid canonical value or name.")

  let emptyFeatures = abiCatalog()

  emptyFeatures.firstFeature = null

  test::assertEqual(abiCatalogValidate(emptyFeatures), "ABI catalog sections cannot be empty.")

  let unknownEffect = abiCatalog()
  let intrinsic = unknownEffect.firstIntrinsic

  test::assertTrue(intrinsic != null)
  if intrinsic != null
    intrinsic.effects = ["MissingEffect"]
  end

  test::assertEqual(abiCatalogValidate(unknownEffect), "Intrinsic 'string.concat' references unknown effect 'MissingEffect'.")

  let unknownFeature = abiCatalog()
  let requirement = unknownFeature.firstRequirement

  test::assertTrue(requirement != null)
  if requirement != null
    requirement.feature = "MissingFeature"
  end

  test::assertEqual(abiCatalogValidate(unknownFeature), "Runtime requirement rule references unknown feature 'MissingFeature'.")

  let invalidRuntimeType = abiCatalog()
  let runtimeImport = invalidRuntimeType.firstRuntimeImport

  test::assertTrue(runtimeImport != null)
  if runtimeImport != null
    runtimeImport.parameterTypes = [AbiType.Void()]
  end

  test::assertEqual(abiCatalogValidate(invalidRuntimeType), "Runtime import 'sessionEnvironmentIdentity' has invalid metadata.")

  let aliasCollision = abiCatalog()
  let firstImport = aliasCollision.firstRuntimeImport

  test::assertTrue(firstImport != null)
  if firstImport != null
    let secondImport = firstImport.next

    test::assertTrue(secondImport != null)
    if secondImport != null
      secondImport.name = firstImport.linkName
    end
  end

  test::assertEqual(abiCatalogValidate(aliasCollision), "Runtime import 'sessionEnvironmentIdentity' is duplicated.")

  let invalidRuleName = abiCatalog()
  let invalidRule = invalidRuleName.firstRequirement

  test::assertTrue(invalidRule != null)
  if invalidRule != null
    invalidRule.linkName = "bad\\\"name"
  end

  test::assertEqual(abiCatalogValidate(invalidRuleName), "Runtime requirement rule has invalid metadata.")

  let cNameCollision = abiCatalog()
  let firstFeature = cNameCollision.firstFeature
  let firstEffect = cNameCollision.firstEffect

  test::assertTrue(firstFeature != null && firstEffect != null)
  if firstFeature != null && firstEffect != null
    firstFeature.cName = firstEffect.cName
  end

  test::assertEqual(abiCatalogValidate(cNameCollision), "Runtime feature 'PreciseGc' duplicates effect C name 'NERI_IR_EFFECT_READ_V1'.")

  let insufficientVersion = abiCatalog()

  insufficientVersion.addRequirement(new AbiRequirementRule(false, "neri_rt_v1_string_concat", 3))

  test::assertEqual(abiCatalogValidate(insufficientVersion), "Intrinsic 'string.concat' does not satisfy its runtime requirement rules.")

  let insufficientFeatures = abiCatalog()

  insufficientFeatures.addRequirement(new AbiRequirementRule(false, "neri_rt_v1_string_concat", 2, "NativeStrings"))

  test::assertEqual(abiCatalogValidate(insufficientFeatures), "Intrinsic 'string.concat' does not satisfy its runtime requirement rules.")

  let header = abiEmitCRuntimeImports(abiCatalog())

  test::assertTrue(abiContainsText(header, "{ NERI_IR_TYPE_OPTIONAL_V1, &neri_abi_type_string_v1 }"))
  test::assertTrue(abiContainsText(header, "{ NERI_IR_TYPE_ARRAY_V1, &neri_abi_type_byte_v1 }"))
  test::assertTrue(abiContainsText(header, "\"neri_rt_v1_host_exit\""))
  test::assertTrue(abiContainsText(header, "UINT32_C(134)"))

  let root = scratch + "/abi-catalog-contract"
  let created = host::run("mkdir", ["-p", root + "/compiler/abi", root + "/native/include/neri"])

  test::assertTrue(created != null && created == 0)
  test::assertEqual(abiPublishOutput(root, AbiOutputKind.Effects(), "current", true), "")
  test::assertEqual(abiPublishOutput(root, AbiOutputKind.Effects(), "current", false), "")
  test::assertEqual(abiPublishOutput(root, AbiOutputKind.Effects(), "changed", false), "Generated ABI catalog output is stale: " + root + "/compiler/abi/effects.hk")
  test::assertEqual(abiPublishOutput(root, AbiOutputKind.Header(), "missing", false), "Generated ABI catalog output is stale: " + root + "/native/include/neri/abi_catalog.h")
  test::assertEqual(abiPublishOutput(root, AbiOutputKind.CRuntimeImports(), "missing", false), "Generated ABI catalog output is stale: " + root + "/native/include/neri/abi_runtime_imports.h")
end
