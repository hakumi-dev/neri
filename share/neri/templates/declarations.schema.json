{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neri:declaration-templates:v1",
  "title": "Neri declaration template catalog",
  "description": "Runtime validation also enforces unique template ids, one Neri-token prefix, contiguous ${N:default} fields, at most one $0, supported template escapes, parser-valid provider headers, and editable fields that do not cross continuation boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "version": { "const": 1 },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefix", "label", "detail", "context", "provider", "header", "body"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "prefix": { "type": "string", "minLength": 1, "pattern": "^[^\\s/]+$", "not": { "pattern": "\\s" } },
        "label": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "context": { "enum": ["global", "class"] },
        "provider": { "enum": ["classDeclaration", "functionDeclaration", "staticDeclaration"] },
        "header": { "type": "string", "minLength": 1, "not": { "pattern": "[\\r\\n]" }, "description": "Single-line Neri source using contiguous ${N:default} fields and optional $0. Quote literal $, backslash, and } as \\$, \\\\, and \\}." },
        "body": { "$ref": "#/$defs/body" }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "classDeclaration" } }, "required": ["provider"] },
          "then": { "properties": { "context": { "const": "global" }, "body": { "properties": { "kind": { "const": "block" } } } } }
        },
        {
          "if": { "properties": { "provider": { "const": "functionDeclaration" } }, "required": ["provider"] },
          "then": { "properties": { "body": { "properties": { "kind": { "const": "block" } } } } }
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lines"],
      "properties": {
        "kind": { "enum": ["block", "none"] },
        "lines": { "type": "array", "description": "Logical interior lines. Leading tabs are indentation levels rendered with the document's configured indentation.", "items": { "type": "string", "pattern": "^(?:\\t*[^ \\r\\n].*|)$", "not": { "pattern": "[\\r\\n]" } } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "none" } }, "required": ["kind"] },
          "then": { "properties": { "lines": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
