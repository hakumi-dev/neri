use clock
use console
use host
use tasks

class ComputeNode
  public value: Int = 0
  public next: ComputeNode?

  def init(value: Int, next: ComputeNode?): Void
    this.value = value
    this.next = next
  end
end

def residue(value: Int): Int
  return value - (value / 1000003) * 1000003
end

def integerKernel(count: Int): Int
  var value = 1
  var index = 0
  while index < count
    value = residue(value * 17 + 23)
    index = index + 1
  end
  return value
end

# Independent logarithmic oracle for x[n] = 17*x[n-1] + 23 (mod 1000003).
# 312501 is the multiplicative inverse of 16 modulo 1000003.
def integerExpected(count: Int): Int
  var power = 1
  var base = 17
  var exponent = count
  while exponent > 0
    if exponent - (exponent / 2) * 2 == 1
      power = residue(power * base)
    end
    base = residue(base * base)
    exponent = exponent / 2
  end
  return residue(power + 23 * (power - 1) * 312501)
end

def batchKernel(size: Int, jobs: Int, workers: Int): Int
  var sum = 0
  if workers > 1
    let results: Int[] = tasks.generate(jobs, workers) do |job|
      return integerKernel(size + job)
    end
    for value in results
      sum = sum + value
    end
    return sum
  end
  var job = 0
  while job < jobs
    sum = sum + integerKernel(size + job)
    job = job + 1
  end
  return sum
end

def batchExpected(size: Int, jobs: Int): Int
  var sum = 0
  var job = 0
  while job < jobs
    sum = sum + integerExpected(size + job)
    job = job + 1
  end
  return sum
end

def arrayKernel(values: Int[], rounds: Int): Int
  var sum = 0
  var round = 0
  while round < rounds
    var index = 0
    while index < values.Length
      values[index] = values[index] + 1
      sum = sum + values[index]
      index = index + 1
    end
    round = round + 1
  end
  return sum
end

def allocationKernel(count: Int, rounds: Int): Int
  var sum = 0
  var round = 0
  while round < rounds
    var head: ComputeNode? = null
    var index = 0
    while index < count
      head = new ComputeNode(index, head)
      index = index + 1
    end
    while head != null
      sum = sum + head.value
      head = head.next
    end
    round = round + 1
  end
  return sum
end

def computeTime(): Int
  let value = clock.milliseconds()
  if value == null
    host.exit(2)
    return 0
  end
  return value
end

def main(): Void
  let mode = host.argumentAt(0)
  let sizeText = host.argumentAt(1)
  let roundsText = host.argumentAt(2)
  if mode == null || sizeText == null || roundsText == null
    console.println("usage: compute <integer|array|allocation|batch> <size> <rounds-or-jobs> [workers]")
    host.exit(2)
    return
  end
  let size = host.parseInt(sizeText)
  let rounds = host.parseInt(roundsText)
  let workersText = host.argumentAt(3)
  var workers = 1
  if workersText != null
    let parsed = host.parseInt(workersText)
    if parsed == null || parsed < 1 || parsed > 64 || mode != "batch"
      host.exit(2)
      return
    end
    workers = parsed
  end
  if size == null || rounds == null || size < 1 || size > 200000000 || rounds < 1 || rounds > 10000
    host.exit(2)
    return
  end
  if (mode != "integer" && mode != "array" && mode != "allocation" && mode != "batch") || (mode == "array" && size > 8192) || (mode == "allocation" && size > 1000000)
    host.exit(2)
    return
  end
  let expected = mode == "batch" ? batchExpected(size, rounds) : (mode == "integer" ? integerExpected(size) : (mode == "array" ? rounds * size * (size - 1) / 2 + size * rounds * (rounds + 1) / 2 : rounds * size * (size - 1) / 2))
  var sample = -1
  while sample < 7
    # Array construction is excluded: this kernel measures indexed reads/writes,
    # not the separate quadratic flat-append construction workload.
    var values: Int[] = []
    if mode == "array"
      var index = 0
      while index < size
        values = host.appendInt(values, index)
        index = index + 1
      end
    end
    let started = computeTime()
    let checksum = mode == "batch" ? batchKernel(size, rounds, workers) : (mode == "integer" ? integerKernel(size) : (mode == "array" ? arrayKernel(values, rounds) : allocationKernel(size, rounds)))
    let elapsed = computeTime() - started
    if checksum != expected
      console.println("incorrect kernel result")
      host.exit(1)
      return
    end
    if sample >= 0
      console.println("{\"language\":\"neri\",\"kernel\":\"" + mode + "\",\"size\":" + (size as String) + ",\"rounds\":" + (rounds as String) + ",\"workers\":" + (workers as String) + ",\"sample\":" + (sample as String) + ",\"milliseconds\":" + (elapsed as String) + ",\"checksum\":" + (checksum as String) + "}")
    end
    sample = sample + 1
  end
end
