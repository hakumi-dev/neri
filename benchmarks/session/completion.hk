use console
use host
use test

def benchmarkSource(functionCount: Int): String
  var source = "class CompletionService\n  public value: Int\n\n  def init(value: Int): Void\n    this.value = value\n  end\n\n  def read(): Int\n    return this.value\n  end\nend\n"
  var index = 0

  while index < functionCount
    source = source + "\ndef generated" + (index as String) + "(): Int\n  return " + (index as String) + "\nend\n"
    index = index + 1
  end
  return source
end

def benchmarkUsage(): Void
  console.println("usage: session-completion-benchmark <function-count: 10|100|500> <history-count: 0|25|100> [iterations]")
end

def benchmarkInput(value: String?, fallback: Int): Int
  if value == null
    return fallback
  end
  let parsed = host.parseInt(value)

  if parsed == null
    return -1
  end
  return parsed
end

def benchmarkJson(functionCount: Int, historyCount: Int, iterations: Int, query: String,
  elapsed: Int, count: Int, truncated: Bool): String
  var result = "{\"functionCount\":" + (functionCount as String) + ",\"historyCount\":" + (historyCount as String)

  result = result + ",\"iterations\":" + (iterations as String) + ",\"query\":\"" + query + "\",\"milliseconds\":" + (elapsed as String)
  return result + ",\"count\":" + (count as String) + ",\"truncated\":" + (truncated ? "true" : "false") + "}"
end

def benchmarkCompletion(environment: SessionEnvironment, functionCount: Int, historyCount: Int,
  iterations: Int, query: String, cursor: Int, expectedCount: Int, expectedTruncated: Bool): Void
  let warmup = environment.complete(query, cursor)

  test.assertTrue(warmup.status.isComplete())
  test.assertEqual(warmup.count, expectedCount)
  test.assertEqual(warmup.truncated, expectedTruncated)
  let started = runCacheTime()
  var index = 0
  var result = warmup

  while index < iterations
    result = environment.complete(query, cursor)
    index = index + 1
  end
  let elapsed = runCacheTime() - started

  test.assertTrue(result.status.isComplete())
  test.assertEqual(result.count, expectedCount)
  test.assertEqual(result.truncated, expectedTruncated)
  console.println(benchmarkJson(functionCount, historyCount, iterations, query, elapsed,
      result.count, result.truncated))
end

def main(): Void
  let functionCount = benchmarkInput(host.argumentAt(0), -1)
  let historyCount = benchmarkInput(host.argumentAt(1), -1)
  let iterations = benchmarkInput(host.argumentAt(2), 100)

  if !(functionCount == 10 || functionCount == 100 || functionCount == 500) || !(historyCount == 0 || historyCount == 25 || historyCount == 100) || iterations <= 0
    benchmarkUsage()
    host.exit(2)
    return
  end
  let snapshot = new SessionSourceSnapshot()

  snapshot.add("completion-project.hk", benchmarkSource(functionCount))
  let environment = new SessionEnvironment("session-completion-benchmark", snapshot)
  let initializer = environment.prepare("let service = new CompletionService(1)\n")

  test.assertTrue(initializer.status.isComplete())
  test.assertTrue(environment.commit(initializer))
  var history = 0

  while history < historyCount
    let prepared = environment.prepare("let retainedHistory" + (history as String) + " = service.value + " + (history as String) + "\n")

    test.assertTrue(prepared.status.isComplete())
    test.assertTrue(environment.commit(prepared))
    history = history + 1
  end
  let expectedNames = functionCount < 128 ? functionCount : 128

  benchmarkCompletion(environment, functionCount, historyCount, iterations, "generated", 9,
    expectedNames, functionCount > 128)
  benchmarkCompletion(environment, functionCount, historyCount, iterations, "service.", 8,
    2, false)

  environment.dispose()
end
