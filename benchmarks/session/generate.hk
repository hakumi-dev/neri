use console
use host

def generatedSource(functionCount: Int): String
  var source = "namespace sessionmatrix\n\nclass Service\n  public value: Int\n\n  def init(value: Int): Void\n    this.value = value\n  end\nend\n\ndef createService(): Service\n  return new Service(17)\nend\n"
  var index = 0

  while index < functionCount
    source = source + "\ndef generated" + (index as String) + "(input: Int): Int\n  return input + " + (index as String) + "\nend\n"
    if index - (index / 10) * 10 == 0
      source = source + "\nclass GeneratedBox" + (index as String) + "\n  public value: Int\n\n  def init(value: Int): Void\n    this.value = value\n  end\nend\n"
    end
    index = index + 1
  end
  return source
end

def main(): Void
  let root = host::argumentAt(0)

  if root == null
    console::println("usage: session-project-generator <output-directory>")
    host::exit(2)
    return
  end
  var inventory = "function_count,class_count,source_bytes,manifest\n"

  for functionCount in [10, 100, 500, 900]
    let directory = bootstrapTemporaryDirectory(root, "functions-" + (functionCount as String))

    if directory == null
      host::exit(2)
      return
    end
    let source = generatedSource(functionCount)
    let manifest = "{\n  \"version\": 2,\n  \"defaultUnit\": \"fixture\",\n  \"units\": {\n    \"fixture\": {\"kind\": \"library\", \"sources\": [\"service.hk\"]}\n  }\n}\n"
    let manifestPath = directory + "/manifest.json"

    if !host::writeText(directory + "/service.hk", source) || !host::writeText(manifestPath, manifest)
      host::exit(2)
      return
    end
    inventory = inventory + (functionCount as String) + "," + ((functionCount / 10 + 1) as String) + "," + (host::stringByteLength(source) as String) + "," + manifestPath + "\n"
  end
  let inventoryPath = root + "/inventory.csv"

  if !host::writeText(inventoryPath, inventory)
    host::exit(2)
    return
  end
  console::println(inventoryPath)
end
