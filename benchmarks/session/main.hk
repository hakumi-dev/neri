use clock
use console
use host
use test

def now(): Int
  let value = clock.milliseconds()

  if value == null
    host.exit(2)
    return 0
  end
  return value
end

def appendRecord(records: String[], format: String, repetition: Int, orderLabel: String,
  operation: String, phase: String, milliseconds: Int, position: Int = 0, cacheHit: String = ""): Void
  let csv = (repetition as String) + "," + orderLabel + "," + operation + "," + phase + "," + (position as String) + "," + (milliseconds as String) + "," + cacheHit + "\n"
  let json = "{\"repetition\":" + (repetition as String) + ",\"repetitionOrder\":\"" + orderLabel + "\",\"operation\":\"" + operation + "\",\"phase\":\"" + phase + "\",\"position\":" + (position as String) + ",\"milliseconds\":" + (milliseconds as String) + ",\"cacheHit\":" + (cacheHit == "" ? "null" : cacheHit) + "}\n"

  records[0] = records[0] + (format == "csv" ? csv : json)
end

def prepareAndExecute(session: ExecutableSession, source: String, operation: String,
  repetition: Int, orderLabel: String, csv: String[], json: String[], position: Int = 0): Void
  let prepareStarted = now()
  let prepared = session.prepare(source)
  let prepareMilliseconds = now() - prepareStarted

  if prepared.status != "complete"
    console.println(operation + " preparation failed with status " + prepared.status)
  end

  test.assertEqual(prepared.status, "complete")
  appendRecord(csv, "csv", repetition, orderLabel, operation, "prepare", prepareMilliseconds, position)
  appendRecord(json, "json", repetition, orderLabel, operation, "prepare", prepareMilliseconds, position)

  let executionStarted = now()
  let execution = session.execute(prepared)
  let executionMilliseconds = now() - executionStarted

  if !execution.succeeded
    console.println(operation + " execution failed: " + execution.message)
  end

  test.assertTrue(execution.succeeded)
  let cacheHit = execution.cacheHit ? "true" : "false"

  appendRecord(csv, "csv", repetition, orderLabel, operation, "compile-link-execute", executionMilliseconds, position, cacheHit)
  appendRecord(json, "json", repetition, orderLabel, operation, "compile-link-execute", executionMilliseconds, position, cacheHit)
end

def main(): Void
  let compiler = host.argumentAt(0)
  let linker = host.argumentAt(1)
  let target = host.argumentAt(2)
  let work = host.argumentAt(3)
  let fixtureProject = host.argumentAt(4)
  let csvPath = host.argumentAt(5)
  let jsonPath = host.argumentAt(6)
  let repetitionsText = host.argumentAt(7)
  let revision = host.argumentAt(8)
  let environment = host.argumentAt(9)
  let fingerprint = host.argumentAt(10)
  var initializerUnit = "fixture"
  let configuredUnit = host.argumentAt(11)

  initializerUnit = configuredUnit if configuredUnit != null
  var initializerFunction = "sessionbenchmark.createService"
  let configuredFunction = host.argumentAt(12)

  initializerFunction = configuredFunction if configuredFunction != null
  var bindingName = "service"
  let configuredBinding = host.argumentAt(13)

  bindingName = configuredBinding if configuredBinding != null
  var initializerImports = ""
  let configuredImports = host.argumentAt(14)

  initializerImports = configuredImports if configuredImports != null
  var applicationSize = 0
  let configuredSize = host.argumentAt(15)

  if configuredSize != null
    let parsedSize = host.parseInt(configuredSize)

    applicationSize = parsedSize if parsedSize != null
  end
  var applicationSourceBytes = 0
  let configuredBytes = host.argumentAt(16)

  if configuredBytes != null
    let parsedBytes = host.parseInt(configuredBytes)

    applicationSourceBytes = parsedBytes if parsedBytes != null
  end
  var initializerProfile = false
  let configuredProfile = host.argumentAt(17)

  initializerProfile = configuredProfile == "profile-initializer" if configuredProfile != null
  if compiler == null || linker == null || target == null || work == null || fixtureProject == null || csvPath == null || jsonPath == null || repetitionsText == null || revision == null || environment == null || fingerprint == null
    console.println("usage: session-benchmark <compiler> <linker> <target> <work> <fixture-project> <report.csv> <report.jsonl> <repetitions> <revision> <environment> <fingerprint>")
    host.exit(2)
    return
  end
  let parsedRepetitions = host.parseInt(repetitionsText)

  if parsedRepetitions == null || parsedRepetitions < 2
    console.println("repetitions must be at least 2")
    host.exit(2)
    return
  end
  let repetitions = parsedRepetitions
  let csv = ["repetition,repetition_order,operation,phase,position,milliseconds,cache_hit\n"]
  let metadata = "{\"schemaVersion\":2,\"revision\":\"" + revision + "\",\"environment\":\"" + environment + "\",\"fingerprint\":\"" + fingerprint + "\",\"target\":\"" + target + "\",\"repetitions\":" + (repetitions as String) + ",\"cachePolicy\":\"not-cleared\",\"initializerProject\":\"" + fixtureProject + "\",\"initializerUnit\":\"" + initializerUnit + "\",\"initializerFunction\":\"" + initializerFunction + "\",\"bindingName\":\"" + bindingName + "\",\"applicationFunctions\":" + (applicationSize as String) + ",\"applicationSourceBytes\":" + (applicationSourceBytes as String) + "}\n"
  let json = [metadata]
  var repetition = 0

  while repetition < repetitions
    let orderLabel = repetition == 0 ? "first-repetition" : "later-repetition"
    let cacheCase = repetition == 0 ? "compile-cache-prime" : "compile-cache-reuse-candidate"
    let session = new ExecutableSession(new SessionToolchain(compiler, linker, target, work))
    let initializeStarted = now()
    let initialized = session.initializeProject(fixtureProject, initializerUnit, initializerFunction, bindingName, initializerImports)
    let initializeMilliseconds = now() - initializeStarted

    if !initialized.succeeded
      console.println("initializer failed: " + initialized.message)
    end

    test.assertTrue(initialized.succeeded)
    let initializerCacheHit = initialized.cacheHit ? "true" : "false"

    appendRecord(csv, "csv", repetition, orderLabel, "initializer", "prepare-compile-link-execute", initializeMilliseconds, 0, initializerCacheHit)
    appendRecord(json, "json", repetition, orderLabel, "initializer", "prepare-compile-link-execute", initializeMilliseconds, 0, initializerCacheHit)
    if initializerProfile
      let loadStarted = now()
      let profiledProject = neriLoadProject(fixtureProject, initializerUnit)
      let loadMilliseconds = now() - loadStarted

      test.assertEqual(profiledProject.error, "")
      appendRecord(csv, "csv", repetition, orderLabel, "initializer-profile", "load-project", loadMilliseconds)
      appendRecord(json, "json", repetition, orderLabel, "initializer-profile", "load-project", loadMilliseconds)
      let snapshotStarted = now()
      let profiledSnapshot = sessionSnapshotFromProject(profiledProject)
      let snapshotMilliseconds = now() - snapshotStarted

      test.assertEqual(profiledSnapshot.error, "")
      appendRecord(csv, "csv", repetition, orderLabel, "initializer-profile", "snapshot", snapshotMilliseconds)
      appendRecord(json, "json", repetition, orderLabel, "initializer-profile", "snapshot", snapshotMilliseconds)
      let profileEnvironment = new SessionEnvironment("benchmark-initializer-profile-" + (repetition as String))
      let validationStarted = now()
      let profiledInitializer = profileEnvironment.validateInitializer(profiledSnapshot, initializerFunction, bindingName, initializerImports)
      let validationMilliseconds = now() - validationStarted

      test.assertEqual(profiledInitializer.status, "complete")
      appendRecord(csv, "csv", repetition, orderLabel, "initializer-profile", "validate-initializer", validationMilliseconds)
      appendRecord(json, "json", repetition, orderLabel, "initializer-profile", "validate-initializer", validationMilliseconds)
      profileEnvironment.discard(profiledInitializer)
      profileEnvironment.dispose()
    end
    prepareAndExecute(session, "let value = 123\n", cacheCase + "-let-variable", repetition, orderLabel, csv, json)
    prepareAndExecute(session, "var changing = value\n", "mutable-variable", repetition, orderLabel, csv, json)
    prepareAndExecute(session, "changing = 124\n", "reassignment", repetition, orderLabel, csv, json)
    prepareAndExecute(session, "use console\nconsole.println(changing as String)\n", "call-with-variable", repetition, orderLabel, csv, json)
    prepareAndExecute(session, "let retainedInitializer = " + bindingName + "\n", "initializer-binding-use", repetition, orderLabel, csv, json)

    test.assertTrue(session.dispose().succeeded)
    let scaling = new ExecutableSession(new SessionToolchain(compiler, linker, target, work))
    let scalingInitialized = scaling.initializeProject(fixtureProject, initializerUnit, initializerFunction, bindingName, initializerImports)

    test.assertTrue(scalingInitialized.succeeded)
    var position = 1

    while position <= 25
      let source = "let accumulated" + (position as String) + " = " + (position as String) + "\n"

      prepareAndExecute(scaling, source, "accumulated-context", repetition, orderLabel, csv, json, position)
      position = position + 1
    end

    test.assertTrue(scaling.dispose().succeeded)
    repetition = repetition + 1
  end
  if !host.writeText(csvPath, csv[0]) || !host.writeText(jsonPath, json[0])
    host.exit(2)
    return
  end
  console.println(csvPath)
  console.println(jsonPath)
end
