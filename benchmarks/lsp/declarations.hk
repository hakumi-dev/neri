use console
use host

def main(): Void
  let loadStarted = runCacheTime()
  let catalog = lspConfiguredDeclarationCatalog()

  if catalog.error != ""
    console.println(catalog.error)
    host.exit(1)
    return
  end
  console.println("{\"catalogLoadMilliseconds\":" + ((runCacheTime() - loadStarted) as String) + "}")
  let cases = ["cl", "class Box<T>", "de", "def run(value: String)", "class Box\n  def run()\nend", "# 🙂\r\nclass Box\r\n\tdef run()\r\nend"]
  let positions = [2, 12, 2, 22, 21, 27]
  var caseIndex = 0

  for source in cases
    let document = new LspDocument()

    document.uri = "untitled:template-benchmark"
    document.text = source
    document.publishDiagnostics = false
    var iteration = 0
    var bytes = 0
    let started = runCacheTime()

    while iteration < 1000
      let result = lspDeclarationCompletion(document, positions[caseIndex], true, catalog)

      if result != null
        bytes = bytes + host.stringByteLength(result)
      end
      iteration = iteration + 1
    end
    console.println("{\"case\":" + (caseIndex as String) + ",\"requests\":1000,\"milliseconds\":" + ((runCacheTime() - started) as String) + ",\"responseBytes\":" + (bytes as String) + "}")
    caseIndex = caseIndex + 1
  end
end
