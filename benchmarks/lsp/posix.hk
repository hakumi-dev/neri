@cabiImport("pipe")
unsafe def benchmarkPipe(fds: Int32*): Int32
end
@cabiImport("fork")
unsafe def benchmarkFork(): Int32
end
@cabiImport("dup2")
unsafe def benchmarkDup(source: Int32, target: Int32): Int32
end
@cabiImport("close")
unsafe def benchmarkClose(fd: Int32): Int32
end
@cabiImport("execv")
unsafe def benchmarkExec(path: Byte*, arguments: (Byte*?)*): Int32
end
@cabiImport("_exit")
unsafe def benchmarkExit(status: Int32): Void
end
@cabiImport("read")
unsafe def benchmarkRead(fd: Int32, bytes: Byte*, count: UInt64): Int
end
@cabiImport("write")
unsafe def benchmarkWrite(fd: Int32, bytes: Byte*, count: UInt64): Int
end
@cabiImport("poll")
unsafe def benchmarkPoll(fds: BenchmarkPollDescriptor*?, count: UInt32, milliseconds: Int32): Int32
end
@cabiImport("kill")
unsafe def benchmarkKill(pid: Int32, signal: Int32): Int32
end
@cabiImport("waitpid")
unsafe def benchmarkWait(pid: Int32, status: Int32*, options: Int32): Int32
end
