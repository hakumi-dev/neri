use console
use host
use test

def main(): Void
  let argument = host::argumentAt(0)
  var count: Int? = null

  if argument != null
    count = host::parseInt(argument)
  end
  if count == null || count <= 0 || count > 1000000
    console::println("usage: lsp-query-index-benchmark <symbol-count: 1..1000000>")
    host::exit(2)
    return
  end
  let semantic = new SemanticModel()
  let snapshot = new LspSemanticSnapshot()
  let index = new LspSemanticIndex()
  var position = 0

  snapshot.projectKey = "benchmark"
  snapshot.projectRevision = 1
  snapshot.semantic = semantic
  snapshot.sourceUris.add("file:///benchmark.hk")
  snapshot.sourceStarts.add(0)
  while position < count
    let identity = "local:" + (position as String)
    let declaration = new SemanticDeclaration()
    let occurrence = new SemanticOccurrence()

    declaration.identity = identity
    declaration.name = "value" + (position as String)
    declaration.symbolKind = 13
    declaration.start = position * 2
    declaration.length = 1
    declaration.next = semantic.declarations
    semantic.declarations = declaration
    occurrence.identity = identity
    occurrence.start = position * 2 + 1
    occurrence.length = 1
    occurrence.next = semantic.occurrences
    semantic.occurrences = occurrence
    position = position + 1
  end
  let started = runCacheTime()

  index.begin(snapshot.projectKey, snapshot.projectRevision)
  index.addSnapshot(snapshot)
  let elapsed = runCacheTime() - started
  var actual = 0
  var entry = index.first

  while entry != null
    actual = actual + 1
    entry = entry.next
  end

  test::assertEqual(actual, count * 2)
  console::println("{\"symbols\":" + (count as String) + ",\"entries\":" + (actual as String) + ",\"milliseconds\":" + (elapsed as String) + "}")
end
