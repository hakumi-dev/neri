use buffers
use clock
use console
use host
use test
use text

def main(): Void
  let mode = host::argumentAt(0)
  let supplied = host::argumentAt(1)

  if mode == null || supplied == null
    host::exit(2)
    return
  end
  let count = host::parseInt(supplied)

  if count == null || count < 1 || count > 100000 || !(mode == "concat" || mode == "library" || mode == "builder")
    host::exit(2)
    return
  end
  let started = clock::milliseconds()
  let part = "abcdé😀"
  var value = ""
  var index = 0

  if mode == "builder"
    let builder = buffers::TextBuffer.create(count * 10, 16)

    test::assertTrue(builder != null)
    if builder == null
      return
    end
    while index < count
      test::assertTrue(builder.append(part))
      index = index + 1
    end
    let built = builder.snapshot()

    test::assertTrue(built != null)
    if built == null
      return
    end
    value = built
  else
    while index < count
      value = mode == "concat" ? value + part : text::concat(value, part)
      index = index + 1
    end
  end
  let finished = clock::milliseconds()

  test::assertTrue(started != null && finished != null)
  test::assertEqual(text::byteLength(value), count * 10)
  test::assertEqual(text::scalarCount(value), count * 6)
  if started == null || finished == null
    return
  end
  console::println("{\"mode\":\"" + mode + "\",\"iterations\":" + (count as String) + ",\"bytes\":" + (text::byteLength(value) as String) + ",\"milliseconds\":" + ((finished - started) as String) + "}")
end
