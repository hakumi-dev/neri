use console
use host

def functionName(index: Int): String
  var value = index as String
  while host.stringByteLength(value) < 4
    value = "0" + value
  end
  return "effect" + value
end

def main(): Void
  let helper = host.argumentAt(0)
  let before = host.argumentAt(1)
  let after = host.argumentAt(2)
  let output = host.argumentAt(3)
  if helper == null || before == null || after == null || output == null
    console.println("usage: compiler-effects <neri-host> <before-compiler> <after-compiler> <existing-output-directory>")
    host.exit(2)
    return
  end
  for count in [128, 256, 512, 1024]
    var source = "use console\n\ndef main(): Void\n  effect0000()\nend\n"
    var index = 0
    while index < count
      source = source + "\ndef " + functionName(index) + "(): Void\n"
      source = source + (index + 1 < count ? "  " + functionName(index + 1) + "()\n" : "  console.println(\"last\")\n") + "end\n"
      index = index + 1
    end
    let path = output + "/chain-" + (count as String) + ".hk"
    if !host.writeText(path, source)
      host.exit(2)
      return
    end
    # One warmup pair and four independent process pairs, in balanced order.
    var repetition = -1
    while repetition < 4
      let prefix = output + "/chain-" + (count as String) + "-r" + (repetition as String)
      let order = repetition == 1 || repetition == 3 ? ["after", "before"] : ["before", "after"]
      for variant in order
        let capture = prefix + "-" + variant
        console.println(capture)
        let compiler = variant == "before" ? before : after
        let status = host.run(helper, ["run", "120", capture + ".stdout", capture + ".stderr", capture + ".status",
          compiler, "build", path, "--emit=neri-ir", "--output", capture + ".nir"])
        let child = host.readText(capture + ".status")
        if status == null || status != 0 || child == null || child != "0\n"
          host.exit(1)
          return
        end
      end
      let expected = host.readText(prefix + "-before.nir")
      let actual = host.readText(prefix + "-after.nir")
      if expected == null || actual == null || expected != actual
        console.println("canonical IR differs: " + prefix)
        host.exit(1)
        return
      end
      repetition = repetition + 1
    end
  end
end
