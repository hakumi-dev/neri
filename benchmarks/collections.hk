use console
use host

def arrayTotal(count: Int): Int
  var values: Int[] = []
  var index = 0
  while index < count
    values = host.appendInt(values, index)
    index = index + 1
  end
  var total = 0
  for value in values total = total + value end
  return total
end

def bufferTotal(count: Int): Int
  let values = new IntBuffer()
  var index = 0
  while index < count
    values.add(index)
    index = index + 1
  end
  var total = 0
  index = 0
  while index < count
    total = total + values.get(index)
    index = index + 1
  end
  return total
end

def main(): Void
  let mode = host.argumentAt(0)
  let size = host.argumentAt(1)
  if mode == null || size == null
    host.exit(2) return
  end
  let count = host.parseInt(size)
  if count == null || count < 1 || count > 32768
    host.exit(2) return
  end
  if mode != "array" && mode != "buffer"
    host.exit(2) return
  end
  var total = 0
  var round = 0
  while round < 16
    total = total + (mode == "array" ? arrayTotal(count) : bufferTotal(count))
    round = round + 1
  end
  console.println(total as String)
end
