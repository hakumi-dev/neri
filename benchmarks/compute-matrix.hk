use console
use host

class ComputeMatrix
  public helper: String
  public neri: String
  public reference: String
  public aot: String
  public output: String
  public maximumWorkers: Int
  public order: String = "process\tconfiguration\tkernel\tworkers\trepetition\n"
  public process: Int = 0

  def init(helper: String, neri: String, reference: String, aot: String, output: String, maximumWorkers: Int): Void
    this.helper = helper
    this.neri = neri
    this.reference = reference
    this.aot = aot
    this.output = output
    this.maximumWorkers = maximumWorkers
  end

  def runCase(configuration: String, kernel: String, workers: Int, repetition: Int): Void
    let name = configuration + "-" + kernel + "-p" + (workers as String) + "-r" + (repetition as String)
    let prefix = this.output + "/" + name
    var command = ["run", "120", prefix + ".jsonl", prefix + ".stderr", prefix + ".status", "/usr/bin/env",
      "-u", "DOTNET_TieredCompilation", "-u", "COMPlus_TieredCompilation",
      "-u", "DOTNET_TieredPGO", "-u", "COMPlus_TieredPGO"]
    if configuration == "neri"
      command = host.appendString(command, this.neri)
    else if configuration == "native-aot"
      command = host.appendString(command, this.aot)
    else
      if configuration == "optimized-jit"
        command = host.appendString(command, "DOTNET_TieredCompilation=0")
      end
      command = host.appendString(command, "dotnet")
      command = host.appendString(command, this.reference)
    end
    command = host.appendString(command, kernel)
    command = host.appendString(command, kernel == "integer" ? "20000000" : (kernel == "array" ? "4096" : (kernel == "allocation" ? "100000" : "2000000")))
    command = host.appendString(command, kernel == "integer" ? "1" : (kernel == "array" ? "10000" : (kernel == "allocation" ? "16" : "64")))
    if kernel == "batch"
      command = host.appendString(command, workers as String)
    end
    console.println(name)
    this.order = this.order + (this.process as String) + "\t" + configuration + "\t" + kernel + "\t" + (workers as String) + "\t" + (repetition as String) + "\n"
    if !host.writeText(this.output + "/order.tsv", this.order)
      host.exit(2)
      return
    end
    let status = host.run(this.helper, command)
    let childStatus = host.readText(prefix + ".status")
    if status == null || status != 0 || childStatus == null || childStatus != "0\n"
      console.println("Benchmark failed; inspect " + prefix + ".stderr and .status")
      host.exit(1)
      return
    end
    this.process = this.process + 1
  end

  def run(): Void
    let configurations = ["neri", "default-jit", "optimized-jit", "native-aot"]
    # Four cyclic orders put each configuration in every position once.
    # Reverse worker order in alternate repetitions to expose order effects.
    var repetition = 0
    while repetition < 4
      for kernel in ["integer", "array", "allocation", "batch"]
        var slot = 0
        while slot < configurations.Length
          let index = repetition + slot
          let configuration = configurations[index - (index / configurations.Length) * configurations.Length]
          var workers = [1]
          if kernel == "batch"
            var count = 2
            while count <= this.maximumWorkers
              workers = host.appendInt(workers, count)
              count = count * 2
            end
            if workers[workers.Length - 1] != this.maximumWorkers
              workers = host.appendInt(workers, this.maximumWorkers)
            end
          end
          var workerIndex = 0
          while workerIndex < workers.Length
            let position = repetition - (repetition / 2) * 2 == 0 ? workerIndex : workers.Length - workerIndex - 1
            this.runCase(configuration, kernel, workers[position], repetition)
            workerIndex = workerIndex + 1
          end
          slot = slot + 1
        end
      end
      repetition = repetition + 1
    end
  end
end

def main(): Void
  let helper = host.argumentAt(0)
  let neri = host.argumentAt(1)
  let reference = host.argumentAt(2)
  let aot = host.argumentAt(3)
  let output = host.argumentAt(4)
  let workersText = host.argumentAt(5)
  if helper == null || neri == null || reference == null || aot == null || output == null || workersText == null
    console.println("usage: compute-matrix <neri-host> <neri-compute> <Compute.dll> <native-aot-compute> <existing-output-directory> <maximum-workers>")
    host.exit(2)
    return
  end
  let workers = host.parseInt(workersText)
  if workers == null || workers < 1 || workers > 64
    host.exit(2)
    return
  end
  let matrix = new ComputeMatrix(helper, neri, reference, aot, output, workers)
  matrix.run()
end
