use buffers
use console
use host

def appendedArray(count: Int): Int
  var values: Byte[] = []
  var index = 0
  while index < count
    values = host.appendByte(values, (index - (index / 256) * 256) as Byte)
    index = index + 1
  end
  return values.Length
end

class Growth
  public length: Int
  public changes: Int

  def init(length: Int, changes: Int): Void
    this.length = length
    this.changes = changes
  end
end

def grownBuffer(count: Int): Growth?
  let values: ByteBuffer? = ByteBuffer.create(count)
  if values == null
    return null
  end
  var index = 0
  var capacity = values.capacity()
  var growths = 0
  while index < count
    values.append((index - (index / 256) * 256) as Byte)
    if values.capacity() != capacity
      capacity = values.capacity()
      growths = growths + 1
    end
    index = index + 1
  end
  return new Growth(values.length(), growths)
end

def main(): Void
  let mode = host.argumentAt(0)
  let raw = host.argumentAt(1)
  if mode == null || raw == null
    host.exit(2) return
  end
  let count = host.parseInt(raw)
  if count == null || count < 1 || count > 1048576
    host.exit(2) return
  end
  if mode == "array"
    console.println("length=" + (appendedArray(count) as String))
  else if mode == "buffer"
    let growth = grownBuffer(count)
    if growth == null
      host.exit(1) return
    end
    console.println("length=" + (growth.length as String))
    console.println("growths=" + (growth.changes as String))
  else
    host.exit(2) return
  end
end
