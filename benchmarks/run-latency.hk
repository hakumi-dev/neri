use clock
use console
use host

def now(): Int
  let value = clock.milliseconds()
  if value == null
    host.exit(2)
    return 0
  end
  return value
end

def measure(compiler: String, source: String, cache: String, bypass: Bool): Int
  var arguments = ["NERI_CACHE_DIR=" + cache, compiler, source, "--timings"]
  if bypass
    arguments = host.appendString(arguments, "--no-cache")
  end
  let started = now()
  let result = host.run("/usr/bin/env", arguments)
  if result == null || result != 0
    console.println("Benchmark program must exit successfully.")
    host.exit(2)
  end
  return now() - started
end

def main(): Void
  let compiler = host.argumentAt(0)
  let source = host.argumentAt(1)
  let report = host.argumentAt(2)
  if compiler == null || source == null || report == null
    console.println("usage: run-latency <compiler-or-launcher> <source.hk> <report.jsonl>")
    host.exit(2)
    return
  end
  let directory = bootstrapTemporaryDirectory("build", "run-benchmark")
  if directory == null
    host.exit(2)
    return
  end
  let cache = host.pathAbsolute(directory)
  if cache == null
    host.exit(2)
    return
  end
  let cold = measure(compiler, source, cache, false)
  var records = "{\"case\":\"empty-cache\",\"milliseconds\":" + (cold as String) + "}\n"
  measure(compiler, source, cache, false)
  measure(compiler, source, cache, true)
  var sample = 0
  while sample < 10
    # Alternating order reduces systematic drift between the two cases.
    for slot in [0, 1]
      let order = sample + slot
      let bypass = order - (order / 2) * 2 == 0
      let elapsed = measure(compiler, source, cache, bypass)
      records = records + "{\"case\":\"" + (bypass ? "no-cache" : "warm-cache") + "\",\"sample\":" + (sample as String) + ",\"milliseconds\":" + (elapsed as String) + "}\n"
    end
    sample = sample + 1
  end
  if !host.writeText(report, records)
    host.exit(2)
    return
  end
  console.println(report)
end
