use clock
use console
use files
use host

class DataScaleSource
  public id: String = ""
  public text: String = ""
  public next: DataScaleSource?
end

def dataScaleNow(): Int
  let value = clock.milliseconds()

  if value != null
    return value
  end
  return 0
end

def dataScaleEntities(count: Int): String
  var result = "namespace scale_model\n"
  var index = 0

  while index < count
    result = result + "\nclass Entity" + (index as String) + "\n  public id: Int\n  public name: String\n  public active: Bool\n  public nickname: String?\n\n  def init(id: Int, name: String, active: Bool, nickname: String?): Void\n    this.id = id\n    this.name = name\n    this.active = active\n    this.nickname = nickname\n  end\nend\n"
    index = index + 1
  end
  return result
end

def dataScaleMapping(count: Int): String
  var result = "{\"version\":1,\"project\":\"manifest.json\",\"unit\":\"entities\",\"namespace\":\"scale_data\",\"context\":\"ScaleDatabase\",\"output\":\"generated\",\"entities\":["
  var index = 0

  while index < count
    result = result + (index == 0 ? "" : ",") + "{\"type\":\"scale_model.Entity" + (index as String) + "\",\"set\":\"entities" + (index as String) + "\",\"table\":\"entities_" + (index as String) + "\",\"key\":\"id\",\"columns\":[{\"member\":\"id\",\"column\":\"id\"},{\"member\":\"name\",\"column\":\"name\"},{\"member\":\"active\",\"column\":\"active\"},{\"member\":\"nickname\",\"column\":\"nickname\"}]}"
    index = index + 1
  end
  return result + "]}\n"
end

def dataScaleProject(root: String, directory: String): String
  let runtimeProject = dataRelativePath(directory, root + "/experiments/neri-data/manifest.json")

  return "{\"version\":2,\"defaultUnit\":\"data\",\"units\":{\"entities\":{\"kind\":\"library\",\"sources\":[\"entities.hk\"]},\"data\":{\"kind\":\"library\",\"sources\":[\"bridge.hk\"],\"generated\":[\"generated/manifest.json\"],\"references\":[\"entities\",{\"project\":" + lspQuote(runtimeProject) + ",\"unit\":\"runtime\"}]}}}\n"
end

def dataScaleAppend(first: DataScaleSource?, last: DataScaleSource?, id: String, value: String): DataScaleSource
  let source = new DataScaleSource()

  source.id = id
  source.text = value
  if last != null
    last.next = source
  end
  return source
end

def dataScaleBind(core: String, hostSource: String, quotationSource: String, fieldsSource: String, runtime: String, translation: String, scalars: String, entities: String, emission: DataEmission): SemanticModel
  let first = dataScaleAppend(null, null, "@stdlib/core.hk", core)
  var last = first

  last = dataScaleAppend(first, last, "@stdlib/host.hk", hostSource)
  last = dataScaleAppend(first, last, "@stdlib/quotation.hk", quotationSource)
  last = dataScaleAppend(first, last, "@stdlib/fields.hk", fieldsSource)
  last = dataScaleAppend(first, last, "runtime.hk", runtime)
  last = dataScaleAppend(first, last, "translation.hk", translation)
  last = dataScaleAppend(first, last, "scalars.hk", scalars)
  last = dataScaleAppend(first, last, "entities.hk", entities)
  var artifact = emission.firstArtifact

  while artifact != null
    last = dataScaleAppend(first, last, artifact.name, artifact.text)
    artifact = artifact.nextArtifact
  end
  var combined = ""
  var combinedLength = 0
  var source: DataScaleSource? = first
  let starts = new IntBuffer()

  while source != null
    starts.add(combinedLength)
    combined = combined + source.text + "\n"
    combinedLength = combinedLength + (new IrSourceMap(source.text)).utf16Length() + 1
    source = source.next
  end
  let tokens = (new BootstrapLexer(combined)).lex()
  let parser = new BootstrapParser(tokens)
  var index = 0

  while index < starts.size
    parser.addSourceBoundary(starts.get(index))
    index = index + 1
  end
  let syntax = parser.parseProgram()
  let binder = new BootstrapBinder(parser.arena, syntax, tokens.startAt(tokens.count() - 1))

  binder.requireEntryPoint = false
  binder.clearSources()
  source = first
  index = 0
  while source != null
    binder.addSource(source.id, starts.get(index))
    source = source.next
    index = index + 1
  end
  return binder.bind()
end

def dataScaleBytes(emission: DataEmission): Int
  var result = 0
  var artifact = emission.firstArtifact

  while artifact != null
    result = result + host.stringByteLength(artifact.text)
    artifact = artifact.nextArtifact
  end
  return result
end

def dataScaleGenericInventory(model: SemanticModel, count: Int, enabled: Bool): Void
  if !enabled || (count != 2 && count != 8)
    return
  end
  var symbol = model.firstClass

  while symbol != null
    if symbol.genericOrigin >= 0
      console.println("generic-inventory," + (count as String) + ",class," + symbol.fullName)
    end
    symbol = symbol.nextClass
  end
  var callable = model.firstFunction

  while callable != null
    if callable.genericOrigin >= 0
      console.println("generic-inventory," + (count as String) + ",function," + callable.fullName)
    end
    callable = callable.nextCallable
  end
end

def dataScaleNative(compiler: String, project: String, directory: String, count: Int): Int
  if count != 2 && count != 32
    return -1
  end
  let status = host.run(compiler, ["check", "--project", project, "--unit", "data", "--emit=obj", "--output", directory + "/data.o"])

  if status != null
    return status
  end
  return -2
end

def dataScaleCase(root: String, compiler: String, parent: String, count: Int, core: String, hostSource: String, quotationSource: String, fieldsSource: String, runtime: String, translation: String, scalars: String, inventory: Bool): Void
  let directory = parent + "/case-" + (count as String)

  if files.createDirectory(directory + "/generated", true).failure != null
    console.println("cannot create benchmark case")
    return
  end
  let entities = dataScaleEntities(count)

  host.writeText(directory + "/entities.hk", entities)
  host.writeText(directory + "/bridge.hk", "namespace scale_data\n")
  host.writeText(directory + "/mapping.json", dataScaleMapping(count))
  host.writeText(directory + "/manifest.json", dataScaleProject(root, directory))
  let generationStarted = dataScaleNow()
  let mapping = dataLoadMapping(directory + "/mapping.json")
  let emission = dataEmit(mapping)
  let generationElapsed = dataScaleNow() - generationStarted
  let bindingStarted = dataScaleNow()
  let model = dataScaleBind(core, hostSource, quotationSource, fieldsSource, runtime, translation, scalars, entities, emission)
  let bindingElapsed = dataScaleNow() - bindingStarted

  dataScaleGenericInventory(model, count, inventory)
  let diagnosticCount = model.diagnostics.count()
  let firstCode = diagnosticCount > 0 ? model.diagnostics.codes.get(0) : ""
  var published = false

  if mapping.error == "" && emission.error == ""
    published = dataPublish(mapping, emission)
  end
  let nativeStatus = published ? dataScaleNative(compiler, directory + "/manifest.json", directory, count) : -3

  console.println("{\"entities\":" + (count as String) + ",\"generatedBytes\":" + (dataScaleBytes(emission) as String) + ",\"genericInstances\":" + (model.genericInstances as String) + ",\"diagnostics\":" + (diagnosticCount as String) + ",\"firstCode\":" + lspQuote(firstCode) + ",\"generationMs\":" + (generationElapsed as String) + ",\"bindingMs\":" + (bindingElapsed as String) + ",\"nativeStatus\":" + (nativeStatus as String) + ",\"mappingError\":" + lspQuote(mapping.error) + ",\"emissionError\":" + lspQuote(emission.error) + "}")
end

def main(): Void
  let root = host.argumentAt(0)
  let compiler = host.argumentAt(1)
  let inventoryArgument = host.argumentAt(2)
  var inventory = false

  if inventoryArgument != null
    inventory = inventoryArgument == "--inventory"
  end

  if root == null || compiler == null
    console.println("usage: data-generation-scale <repository-root> <compiler>")
    host.exit(2)
    return
  end
  let standardLibrary = host.environment("NERI_STDLIB")

  if standardLibrary == null
    console.println("NERI_STDLIB is required")
    host.exit(2)
    return
  end
  let core = host.readText(standardLibrary + "/core.hk")
  let hostSource = host.readText(standardLibrary + "/host.hk")
  let quotationSource = host.readText(standardLibrary + "/quotation.hk")
  let fieldsSource = host.readText(standardLibrary + "/fields.hk")
  let runtime = host.readText(root + "/experiments/neri-data/runtime.hk")
  let translation = host.readText(root + "/experiments/neri-data/translation.hk")
  let scalars = host.readText(root + "/experiments/neri-data/scalars.hk")

  if core == null || hostSource == null || quotationSource == null || fieldsSource == null || runtime == null || translation == null || scalars == null
    console.println("cannot read benchmark sources")
    host.exit(2)
    return
  end
  let temporary = bootstrapTemporaryDirectory(root + "/build", "data-generation-scale")

  if temporary == null
    console.println("cannot create benchmark workspace")
    host.exit(2)
    return
  end
  for count in [2, 3, 4, 8, 16, 32]
    dataScaleCase(root, compiler, temporary, count, core, hostSource, quotationSource, fieldsSource, runtime, translation, scalars, inventory)
  end
  files.removeTree(temporary)
end
